                arg2
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b0000110 #b0011000011100011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b0111000001011110)
                expect
                (fp #b1 #b0011010 #b0101001111100000)))
(assert (fp.leq (fp #b1 #b0011010 #b0101001111100000)
                expect
                (fp #b0 #b1110010 #b1000100010111101)))

(assert (= expect result))

(check-sat)
(exit)
