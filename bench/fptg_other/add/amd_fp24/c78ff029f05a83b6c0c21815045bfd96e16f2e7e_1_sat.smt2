(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100001 #b1000110001001110)
                arg1
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b0000011 #b1010011010001101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0110011111101111)
                arg2
                (fp #b1 #b1101100 #b1011000110011001)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                arg2
                (fp #b0 #b1111001 #b0110001001001001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1000110111110010)
                expect
                (fp #b1 #b1101100 #b1011000110011001)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                expect
                (fp #b0 #b1101000 #b1111001100001100)))

(assert (= expect result))

(check-sat)
(exit)
