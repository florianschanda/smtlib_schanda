                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1100100 #b0001100000011000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010100 #b1000010011010100)
                expect
                (fp #b0 #b1001111 #b1111001011101111)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011101111)
                expect
                (fp #b0 #b1110010 #b0110110110100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
