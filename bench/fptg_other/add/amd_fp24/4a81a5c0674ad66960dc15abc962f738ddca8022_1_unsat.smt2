(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1000101 #b0110111111000111)
                arg1
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1101101 #b0001010011110101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010110 #b1110011101011011)
                arg2
                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                arg2
                (fp #b0 #b1001001 #b1101101111111010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010101 #b0000100011001010)
                expect
                (fp #b0 #b0110101 #b1101010110011001)))
(assert (fp.leq (fp #b0 #b0110101 #b1101010110011001)
                expect
                (fp #b0 #b1111100 #b0100111110001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
