                arg2
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b1100111 #b0000101110100110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000111 #b0111001010001000)
                expect
                (fp #b0 #b0010111 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0010111 #b1111111111111111)
                expect
                (fp #b0 #b0110000 #b1001010101010101)))

(assert (= expect result))

(check-sat)
(exit)
