; Format: AMD_FP24
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b1100101011001100)
                arg1
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg1
                (fp #b0 #b1000111 #b1100111110010011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000011 #b0110000010000001)
                arg2
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b1000100 #b1101100001011001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101100 #b0001100010101010)
                expect
                (fp #b1 #b0000001 #b0011111111111111)))
(assert (fp.leq (fp #b1 #b0000001 #b0011111111111111)
                expect
                (fp #b0 #b0101110 #b1000010001000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
