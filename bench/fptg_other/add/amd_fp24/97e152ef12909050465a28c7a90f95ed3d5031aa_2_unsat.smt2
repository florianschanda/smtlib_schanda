                arg2
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b0000100 #b0100000101000001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110110 #b0110101011001111)
                expect
                (fp #b0 #b1101001 #b0010001000011000)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011000)
                expect
                (fp #b0 #b1111001 #b1111001101110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
