(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110010 #b0010110101101000)
                arg1
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg1
                (fp #b0 #b0101100 #b0001010000000111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b1101010010111110)
                arg2
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b0011111 #b1111010111100000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100011 #b0011111011100000)
                expect
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                expect
                (fp #b1 #b0011011 #b0001011001100000)))

(assert (= expect result))

(check-sat)
(exit)
