; Format: AMD_FP24
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b1110000001011011)
                arg1
                (fp #b0 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg1
                (fp #b0 #b0111010 #b1101110110101101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110111 #b1001001100001011)
                arg2
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b0100000 #b0011110110001000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1000011011101111)
                expect
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                expect
                (fp #b0 #b0101011 #b1001111100010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
