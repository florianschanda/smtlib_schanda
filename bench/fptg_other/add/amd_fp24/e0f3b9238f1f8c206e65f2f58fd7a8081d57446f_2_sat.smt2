(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000111 #b0110110110000100)
                arg1
                (fp #b0 #b0001001 #b1011101001010011)))
(assert (fp.leq (fp #b0 #b0001001 #b1011101001010011)
                arg1
                (fp #b0 #b1111000 #b1111110000010000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b0011010011110100)
                arg2
                (fp #b1 #b0110011 #b0110100101010001)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010001)
                arg2
                (fp #b1 #b0011110 #b0011001100011011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b0101001100010110)
                expect
                (fp #b1 #b0110011 #b0110100101010001)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010001)
                expect
                (fp #b1 #b0001100 #b1100100001001011)))

(assert (= expect result))

(check-sat)
(exit)
