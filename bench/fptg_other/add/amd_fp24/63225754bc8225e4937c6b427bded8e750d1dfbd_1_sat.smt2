; Format: AMD_FP24
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011010 #b0100000100100101)
                arg1
                (fp #b1 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0011000 #b0000000000000000)
                arg1
                (fp #b0 #b1111000 #b0111101010000100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0111011 #b0000010111111111)
                arg2
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b0010011 #b1101010101011100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101001 #b1001011011101011)
                expect
                (fp #b1 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0011000 #b0000000000000000)
                expect
                (fp #b0 #b0010100 #b0010000110001110)))

(assert (= expect result))

(check-sat)
(exit)
