                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b1111000 #b0001110000111000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010010 #b1001001101001110)
                arg2
                (fp #b0 #b0000000 #b0100100111101010)))
(assert (fp.leq (fp #b0 #b0000000 #b0100100111101010)
                arg2
                (fp #b0 #b1001110 #b0100101001000101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001101 #b1100011111000001)
                expect
                (fp #b0 #b0100000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000001)
                expect
                (fp #b0 #b1000101 #b0101001000101111)))

(assert (= expect result))

(check-sat)
(exit)
