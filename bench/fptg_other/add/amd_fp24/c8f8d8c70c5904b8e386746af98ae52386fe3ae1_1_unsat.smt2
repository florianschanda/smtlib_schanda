                arg2
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b0101000 #b0100010000101010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101000 #b0101000110111001)
                expect
                (fp #b0 #b0000001 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000001 #b1111111111111111)
                expect
                (fp #b0 #b1110001 #b0100100011101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
