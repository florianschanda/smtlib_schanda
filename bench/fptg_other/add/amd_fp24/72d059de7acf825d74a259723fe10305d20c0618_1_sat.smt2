                arg2
                (fp #b0 #b1101011 #b1001001100111111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b0010111110100011)
                expect
                (fp #b1 #b1010110 #b1010010100010101)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010101)
                expect
                (fp #b0 #b1110111 #b0100101010001010)))

(assert (= expect result))

(check-sat)
