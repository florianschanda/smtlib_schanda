                arg2
                (fp #b0 #b0111111 #b0000001011100101)))
(assert (fp.leq (fp #b0 #b0111111 #b0000001011100101)
                arg2
                (fp #b0 #b1110100 #b1010100101110110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011111 #b0011101001110000)
                expect
                (fp #b0 #b1000000 #b0001001001000111)))
(assert (fp.leq (fp #b0 #b1000000 #b0001001001000111)
                expect
                (fp #b0 #b1010001 #b0111000011101000)))

(assert (= expect result))

(check-sat)
(exit)
