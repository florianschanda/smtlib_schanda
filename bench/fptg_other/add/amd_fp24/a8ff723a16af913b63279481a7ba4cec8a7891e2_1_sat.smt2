(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1101001 #b1110110101100100)
                arg1
                (fp #b0 #b1101100 #b1010100100110011)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110011)
                arg1
                (fp #b0 #b1101100 #b1010101000011101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010011 #b1100111100010011)
                arg2
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b0010001 #b0110110101000111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000101 #b1100010110110001)
                expect
                (fp #b0 #b1101100 #b1010100100110010)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110010)
                expect
                (fp #b0 #b1111001 #b0110111011000110)))

(assert (= expect result))

(check-sat)
(exit)
