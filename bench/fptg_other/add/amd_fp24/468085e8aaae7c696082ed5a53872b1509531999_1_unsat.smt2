;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110011 #b0101111111000010)
                arg1
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b0000011 #b0110110001011011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b0001101100011011)
                arg2
                (fp #b1 #b1011100 #b1111011010001110)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001110)
                arg2
                (fp #b0 #b1001111 #b1011011001001110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0000000101010110)
                expect
                (fp #b1 #b1011100 #b1111011010001101)))
(assert (fp.leq (fp #b1 #b1011100 #b1111011010001101)
                expect
                (fp #b0 #b0010000 #b0000110011000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
