                arg2
                (fp #b0 #b1011000 #b0000000110100000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111111 #b0001100010100101)
                expect
                (fp #b1 #b0000000 #b1100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b1100000000000000)
                expect
                (fp #b0 #b0110111 #b1110011001101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
