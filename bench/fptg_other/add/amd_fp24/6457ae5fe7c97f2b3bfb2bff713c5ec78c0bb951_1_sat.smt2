(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111010 #b1101000001010000)
                arg1
                (fp #b1 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0011000 #b0000000000000000)
                arg1
                (fp #b0 #b0001010 #b1101011011100111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011101 #b0011010010101100)
                arg2
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                arg2
                (fp #b0 #b1111111 #b0000000000000000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0010110100001011)
                expect
                (fp #b0 #b1111110 #b1111111111111110)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111110)
                expect
                (fp #b0 #b1111111 #b0000000000000000)))

(assert (= expect result))

(check-sat)
(exit)
