;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b1110111111001111)
                arg1
                (fp #b0 #b0100001 #b0110000110111010)))
(assert (fp.leq (fp #b0 #b0100001 #b0110000110111010)
