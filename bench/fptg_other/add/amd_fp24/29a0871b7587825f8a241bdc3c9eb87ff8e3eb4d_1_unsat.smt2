(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b1110001001001000)
                arg1
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg1
                (fp #b0 #b1001110 #b0101010011111101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1111111111001000)
                arg2
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                arg2
                (fp #b1 #b0011100 #b0010100100010010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b0001000100110101)
                expect
                (fp #b1 #b1111010 #b0011111011010111)))
(assert (fp.leq (fp #b1 #b1111010 #b0011111011010111)
                expect
                (fp #b0 #b0001001 #b1000110101011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
