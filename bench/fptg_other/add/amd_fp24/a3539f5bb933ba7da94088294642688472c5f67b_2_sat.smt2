;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000011 #b0010011011110111)
                arg1
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                arg1
                (fp #b0 #b1011011 #b1000000110001000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011011 #b0111001000000011)
                arg2
                (fp #b1 #b0000000 #b1010101111010010)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101111010010)
                arg2
                (fp #b0 #b1111110 #b1111010101001001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b1000011001000011)
                expect
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                expect
                (fp #b0 #b1010110 #b0010000010111101)))

(assert (= expect result))

(check-sat)
(exit)
