                arg2
                (fp #b0 #b1101011 #b0000110101110101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010101 #b0110110111101101)
                expect
                (fp #b1 #b0000001 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000001)
                expect
                (fp #b0 #b0000010 #b1001010001001010)))

(assert (= expect result))

(check-sat)
(exit)
