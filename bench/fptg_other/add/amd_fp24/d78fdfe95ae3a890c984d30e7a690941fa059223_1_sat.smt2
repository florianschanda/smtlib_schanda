(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010000 #b0111010011111111)
                arg1
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
                arg1
                (fp #b0 #b1101011 #b0001011110100011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000011 #b0101100111111110)
                arg2
                (fp #b0 #b0000000 #b0010100100110000)))
(assert (fp.leq (fp #b0 #b0000000 #b0010100100110000)
                arg2
                (fp #b0 #b0000101 #b0100011001100101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101010 #b0000010111111000)
                expect
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
                expect
                (fp #b0 #b1000001 #b0111000011110011)))

(assert (= expect result))

(check-sat)
(exit)
