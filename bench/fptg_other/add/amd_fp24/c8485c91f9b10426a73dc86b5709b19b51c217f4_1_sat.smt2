(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011111 #b1000010001010100)
                arg1
                (fp #b1 #b0011010 #b0101001111100000)))
(assert (fp.leq (fp #b1 #b0011010 #b0101001111100000)
                arg1
                (fp #b0 #b1100100 #b1101000010100000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001101 #b1111100000110001)
                arg2
                (fp #b0 #b0000010 #b1101101001101011)))
(assert (fp.leq (fp #b0 #b0000010 #b1101101001101011)
                arg2
                (fp #b0 #b0011000 #b1111100000101010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100111 #b1101010101010001)
                expect
                (fp #b1 #b0011010 #b0101001111011111)))
(assert (fp.leq (fp #b1 #b0011010 #b0101001111011111)
                expect
                (fp #b0 #b1100011 #b1111010100101111)))

(assert (= expect result))

(check-sat)
(exit)
