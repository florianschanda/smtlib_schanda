                arg2
                (fp #b0 #b0111000 #b0101000101100111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000100 #b1101000001110010)
                expect
                (fp #b1 #b0000000 #b0110101111010010)))
(assert (fp.leq (fp #b1 #b0000000 #b0110101111010010)
                expect
                (fp #b0 #b0000011 #b1011011000101010)))

(assert (not (= expect result)))

(check-sat)
