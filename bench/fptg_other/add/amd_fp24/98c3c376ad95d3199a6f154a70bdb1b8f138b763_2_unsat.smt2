(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b1011110011110101)
                expect
                (fp #b1 #b0110111 #b1011000001001101)))
(assert (fp.leq (fp #b1 #b0110111 #b1011000001001101)
                expect
                (fp #b0 #b0010100 #b0011110100000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
