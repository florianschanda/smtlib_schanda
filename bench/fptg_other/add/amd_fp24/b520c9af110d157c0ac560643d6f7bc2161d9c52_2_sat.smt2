(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b1001111010010101)
                arg1
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                arg1
                (fp #b0 #b1100111 #b0100001100101101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b0101011010101111)
                arg2
                (fp #b0 #b0000010 #b1101101001101011)))
(assert (fp.leq (fp #b0 #b0000010 #b1101101001101011)
                arg2
                (fp #b0 #b1111010 #b0001100010100000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b0100100101000101)
                expect
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                expect
                (fp #b1 #b1010000 #b0101111010001000)))

(assert (= expect result))

(check-sat)
(exit)
