(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b1011001000101100)
                arg1
                (fp #b1 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0011000 #b0000000000000000)
                arg1
                (fp #b0 #b1000010 #b1011000011100101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000111 #b0001111011101010)
                arg2
                (fp #b0 #b0111111 #b0000001011100101)))
(assert (fp.leq (fp #b0 #b0111111 #b0000001011100101)
                arg2
                (fp #b0 #b1111110 #b1111011000000100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b0100000000111010)
                expect
                (fp #b0 #b0111111 #b0000001011100100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000001011100100)
                expect
                (fp #b0 #b1100110 #b0010111110100011)))

(assert (= expect result))

(check-sat)
(exit)
