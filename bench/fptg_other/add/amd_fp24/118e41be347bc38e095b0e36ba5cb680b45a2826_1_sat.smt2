                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b1011101 #b1000110100010011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b1010001100001010)
                expect
                (fp #b1 #b0000000 #b1111111111111110)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111110)
                expect
                (fp #b0 #b0011101 #b1111110110101100)))

(assert (= expect result))

(check-sat)
(exit)
