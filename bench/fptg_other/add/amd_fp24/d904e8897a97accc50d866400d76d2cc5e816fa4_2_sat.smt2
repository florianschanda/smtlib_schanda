; Format: AMD_FP24
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b0100010101011100)
                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b0101000 #b0100111001111011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111011 #b1010111010011000)
                arg2
                (fp #b0 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b1010101 #b1110011001101111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001110 #b1100011100111001)
                expect
                (fp #b0 #b0100000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000001)
                expect
                (fp #b0 #b0100101 #b1111011011000110)))

(assert (= expect result))

(check-sat)
(exit)
