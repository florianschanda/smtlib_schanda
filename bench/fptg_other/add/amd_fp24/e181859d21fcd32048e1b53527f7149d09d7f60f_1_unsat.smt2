                arg2
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b1110001 #b0101000011100001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011001 #b0011010011000101)
                expect
                (fp #b1 #b0000001 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000001 #b1111111111111111)
                expect
                (fp #b0 #b0100001 #b0001100011101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
