;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b0110111000011100)
                arg1
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                arg1
                (fp #b1 #b0010001 #b1001000000101010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010000 #b0000011110000010)
                arg2
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                arg2
                (fp #b0 #b1001111 #b1110111010000011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b1011111111000101)
                expect
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                expect
                (fp #b1 #b0000010 #b1110111011111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
