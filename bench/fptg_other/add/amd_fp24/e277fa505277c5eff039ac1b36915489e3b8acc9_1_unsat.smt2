; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000100 #b0011001110001000)
                arg1
                (fp #b0 #b0001001 #b1011101001010011)))
(assert (fp.leq (fp #b0 #b0001001 #b1011101001010011)
                arg1
                (fp #b0 #b1110010 #b1000001111011100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011110 #b1110111111101001)
                arg2
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg2
                (fp #b0 #b1100010 #b1101011111010011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011111 #b0001101001011000)
                expect
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                expect
                (fp #b0 #b1101001 #b1100111101000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
