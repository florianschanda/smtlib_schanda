; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111110 #b1010001011011011)
                arg1
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                arg1
                (fp #b0 #b1111010 #b0100111100111101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011000 #b0011010101110000)
                arg2
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b1010101 #b0101101001100100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010010 #b1111111011111001)
                expect
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                expect
                (fp #b0 #b1111101 #b0000110001000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
