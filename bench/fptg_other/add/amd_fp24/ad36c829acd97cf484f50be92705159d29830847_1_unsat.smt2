(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011010 #b1010100010000100)
                expect
                (fp #b0 #b1100010 #b0010111010110111)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110111)
                expect
                (fp #b0 #b1100010 #b1000100100010101)))

(assert (not (= expect result)))

(check-sat)
