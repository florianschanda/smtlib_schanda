;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000100 #b1001011111101101)
                arg1
                (fp #b1 #b0000000 #b1111110111101011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111110111101011)
                arg1
                (fp #b0 #b1011000 #b0110011010100001)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b0001010110110010)
                arg2
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b0 #b0000100 #b1100101110111001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010000 #b0100000100100010)
                expect
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                expect
                (fp #b1 #b1000011 #b1010100010011010)))

(assert (= expect result))

(check-sat)
(exit)
