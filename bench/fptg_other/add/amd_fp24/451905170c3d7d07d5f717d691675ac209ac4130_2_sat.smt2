;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1011010111011000)
                arg1
                (fp #b1 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000000)
                arg1
                (fp #b0 #b1010110 #b1011100001011111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000011 #b1010100100100010)
                arg2
                (fp #b1 #b0000000 #b1010101111010010)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101111010010)
                arg2
                (fp #b0 #b0011001 #b1100000101001110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b1010101011011101)
                expect
                (fp #b1 #b1111101 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000001)
                expect
                (fp #b0 #b1011010 #b1111001000100111)))

(assert (= expect result))

(check-sat)
(exit)
