                arg2
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b0110100 #b1100011011001011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111110 #b1000100110010000)
                expect
                (fp #b0 #b0100000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000001)
                expect
                (fp #b0 #b1011011 #b0000110111110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
