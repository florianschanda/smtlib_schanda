(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1111010 #b1100101000100000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110011 #b0111111100101001)
                expect
                (fp #b0 #b1001101 #b1001011101111111)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111111)
                expect
                (fp #b0 #b1100101 #b0011111100001010)))

(assert (= expect result))

(check-sat)
