                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b1010011 #b1100001100011110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000001 #b1011100111001010)
                expect
                (fp #b0 #b1001111 #b0111000001001101)))
(assert (fp.leq (fp #b0 #b1001111 #b0111000001001101)
                expect
                (fp #b0 #b1001111 #b1000110110000010)))

(assert (= expect result))

(check-sat)
(exit)
