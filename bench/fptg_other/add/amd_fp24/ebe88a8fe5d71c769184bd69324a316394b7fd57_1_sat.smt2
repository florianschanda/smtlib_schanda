(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b0110110101001111)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
