(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b1111010 #b0000010010110110)
                arg2
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b1110100 #b0100110000101110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b1011100110010110)
                expect
                (fp #b0 #b0000000 #b1010110011010011)))
(assert (fp.leq (fp #b0 #b0000000 #b1010110011010011)
                expect
                (fp #b0 #b0010101 #b1101010001000010)))

(assert (= expect result))

(check-sat)
(exit)
