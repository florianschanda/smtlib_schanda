(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b1110100 #b1001001000111010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b1100110001101001)
                expect
                (fp #b1 #b1001110 #b0001111101100111)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100111)
                expect
                (fp #b0 #b1110111 #b0001011010111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
