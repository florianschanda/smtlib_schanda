(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001111 #b1001100101011111)
                arg1
                (fp #b1 #b0011010 #b0101001111100000)))
(assert (fp.leq (fp #b1 #b0011010 #b0101001111100000)
                arg1
                (fp #b0 #b0111011 #b1010110111000011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010010 #b0101000101011110)
                arg2
                (fp #b0 #b0111111 #b1010001011000100)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000100)
                arg2
                (fp #b0 #b1101101 #b0000010111001001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010100 #b1101101110110001)
                expect
                (fp #b0 #b0111111 #b1010001011000011)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000011)
                expect
                (fp #b0 #b1101101 #b1100111110001100)))

(assert (= expect result))

(check-sat)
(exit)
