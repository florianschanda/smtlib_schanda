                arg1
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b1110010 #b1111100000100000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110010 #b0101111001110010)
                arg2
                (fp #b0 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b0011110 #b0111100111111010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b0011111001110101)
                expect
                (fp #b0 #b1011111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1011111 #b0000000000000000)
                expect
                (fp #b0 #b1111110 #b1001011011011100)))

(assert (= expect result))

(check-sat)
(exit)
