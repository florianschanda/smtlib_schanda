(assert (fp.leq (fp #b0 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b1011000 #b0111000000001000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010111 #b0110010101000011)
                expect
                (fp #b0 #b0000001 #b0011111111111111)))
(assert (fp.leq (fp #b0 #b0000001 #b0011111111111111)
                expect
                (fp #b0 #b1001100 #b0100111011011001)))

(assert (not (= expect result)))

(check-sat)
