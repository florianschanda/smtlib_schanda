                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg2
                (fp #b0 #b1111010 #b1101111110100011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110100 #b0011011010001011)
                expect
                (fp #b0 #b0111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0111110 #b1111111111111111)
                expect
                (fp #b0 #b1111010 #b0000010001000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
