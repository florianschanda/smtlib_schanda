; Format: AMD_FP24
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011110 #b0001010011110101)
                arg1
                (fp #b0 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000001 #b0000000000000000)
                arg1
                (fp #b0 #b0110100 #b1101110100101110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010010 #b0111000101001000)
                arg2
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                arg2
                (fp #b0 #b1010000 #b0110101010111011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001001 #b0110010000001010)
                expect
                (fp #b0 #b1000000 #b0101110000100110)))
(assert (fp.leq (fp #b0 #b1000000 #b0101110000100110)
                expect
                (fp #b0 #b1011101 #b0111111000011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
