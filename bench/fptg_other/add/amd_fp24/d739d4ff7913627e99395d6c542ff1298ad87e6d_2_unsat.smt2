(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001111 #b1110010011100110)
                expect
                (fp #b0 #b0100000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000001)
                expect
                (fp #b0 #b1001101 #b0111100000101100)))

(assert (not (= expect result)))

(check-sat)
