; Format: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000001 #b1011111101001000)
                arg1
                (fp #b0 #b1101100 #b1010100100110011)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110011)
                arg1
                (fp #b0 #b1111000 #b1101011000100010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000001 #b1111010000011111)
                arg2
                (fp #b0 #b1001101 #b0110101110101100)))
(assert (fp.leq (fp #b0 #b1001101 #b0110101110101100)
                arg2
                (fp #b0 #b1101001 #b0100101101110111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100001 #b0110011100010111)
                expect
                (fp #b0 #b1101100 #b1010100100110011)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110011)
                expect
                (fp #b0 #b1101110 #b0000100010011010)))

(assert (= expect result))

(check-sat)
(exit)
