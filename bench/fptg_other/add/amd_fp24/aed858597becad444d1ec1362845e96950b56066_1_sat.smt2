(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0111101010011010)
                arg1
                (fp #b1 #b0110111 #b1011000001001100)))
(assert (fp.leq (fp #b1 #b0110111 #b1011000001001100)
                arg1
                (fp #b0 #b1100111 #b0011000110100111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b1110011100011000)
                arg2
                (fp #b0 #b1100010 #b0010111010110111)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110111)
                arg2
                (fp #b0 #b1110011 #b1011110111101010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1011110 #b0100111010101001)
                expect
                (fp #b0 #b1100010 #b0010111010110110)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110110)
                expect
                (fp #b0 #b1100101 #b0110110010011001)))

(assert (= expect result))

(check-sat)
(exit)
