; Format: AMD_FP24
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111010 #b0010010101110000)
                arg1
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b1101111 #b0000101101101001)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b0000101100000111)
                arg2
                (fp #b1 #b0000000 #b1010101111010010)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101111010010)
                arg2
                (fp #b0 #b1101100 #b0011010101001011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011001 #b1100111111001000)
                expect
                (fp #b1 #b0000001 #b1010101111010001)))
(assert (fp.leq (fp #b1 #b0000001 #b1010101111010001)
                expect
                (fp #b0 #b1111101 #b0100100101000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
