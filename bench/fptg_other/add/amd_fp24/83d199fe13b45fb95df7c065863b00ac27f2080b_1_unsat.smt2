(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100000 #b0101101001111100)
                arg1
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b1011010 #b0001100010100110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011001 #b0000110110011111)
                arg2
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b1011000 #b1100111101111110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101100 #b0111111110010101)
                expect
                (fp #b0 #b1001111 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1001111 #b1111111111111111)
                expect
                (fp #b0 #b1111011 #b1111111011000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
