; Format: AMD_FP24
; Arg1: +ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1100111 #b1000011001011110)
                arg1
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1111011 #b0010110101001110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100100 #b0001011010000001)
                arg2
                (fp #b0 #b1100010 #b0010111010110111)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110111)
                arg2
                (fp #b0 #b1101010 #b0011110111100111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110001 #b1101001000100110)
                expect
                (fp #b0 #b1100010 #b0010111010110111)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110111)
                expect
                (fp #b0 #b1101111 #b0100110101010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
