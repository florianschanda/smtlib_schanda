(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000111 #b1100100011111010)
                expect
                (fp #b0 #b1010000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000001)
                expect
                (fp #b0 #b1101011 #b1001001001111100)))

(assert (not (= expect result)))

(check-sat)
