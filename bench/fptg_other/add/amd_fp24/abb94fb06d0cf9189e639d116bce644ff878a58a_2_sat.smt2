(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010100 #b0110001111001100)
                arg1
                (fp #b0 #b0001001 #b1011101001010011)))
(assert (fp.leq (fp #b0 #b0001001 #b1011101001010011)
                arg1
                (fp #b0 #b1000111 #b1000010000101010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100100 #b0110110110110001)
                arg2
                (fp #b1 #b0000000 #b1010101111010010)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101111010010)
                arg2
                (fp #b0 #b0010010 #b1010111000000001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000110 #b0110000101101000)
                expect
                (fp #b0 #b0001001 #b1011100110101000)))
(assert (fp.leq (fp #b0 #b0001001 #b1011100110101000)
                expect
                (fp #b0 #b0011000 #b1000110000000110)))

(assert (= expect result))

(check-sat)
(exit)
