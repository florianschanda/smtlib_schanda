                (fp #b1 #b0110011 #b0110100101010001)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010001)
                arg2
                (fp #b0 #b1000111 #b0110010110100100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000010 #b1101001011110010)
                expect
                (fp #b1 #b0110011 #b0110100101010000)))
(assert (fp.leq (fp #b1 #b0110011 #b0110100101010000)
                expect
                (fp #b0 #b1100000 #b1101110011001000)))

(assert (= expect result))

(check-sat)
(exit)
