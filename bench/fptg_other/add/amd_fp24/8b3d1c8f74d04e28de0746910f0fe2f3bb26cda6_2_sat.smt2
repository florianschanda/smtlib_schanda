(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011001 #b0011011100100111)
                expect
                (fp #b0 #b0111111 #b1010001011000101)))
(assert (fp.leq (fp #b0 #b0111111 #b1010001011000101)
                expect
                (fp #b0 #b1011001 #b0101011101011000)))

(assert (= expect result))

(check-sat)
(exit)
