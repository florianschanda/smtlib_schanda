; Format: AMD_FP24
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0100010011000000)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg1
                (fp #b1 #b0110100 #b1000101110010011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010110 #b0001000011001010)
                arg2
                (fp #b1 #b0000000 #b1010101111010010)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101111010010)
                arg2
                (fp #b0 #b0100010 #b1010000001010101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b0000111100111000)
                expect
                (fp #b1 #b1010000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000001)
                expect
                (fp #b1 #b0011010 #b0010100000000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
