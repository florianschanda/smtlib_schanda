(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1101110110111110)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg1
                (fp #b1 #b0001000 #b1101010000000001)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0010111000100000)
                expect
                (fp #b1 #b1001111 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001111 #b0001111101100110)
                expect
                (fp #b1 #b0001011 #b1011001011101100)))

(assert (= expect result))

(check-sat)
(exit)
