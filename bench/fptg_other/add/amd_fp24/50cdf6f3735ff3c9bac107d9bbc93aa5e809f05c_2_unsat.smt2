                arg1
                (fp #b1 #b0110111 #b1011000001001100)))
(assert (fp.leq (fp #b1 #b0110111 #b1011000001001100)
                arg1
                (fp #b1 #b0001111 #b0010011111000110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111110 #b1001111100001101)
                arg2
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg2
                (fp #b0 #b0000110 #b0101011001000100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101001 #b1000010010010000)
                expect
                (fp #b1 #b0110111 #b1011000001001101)))
(assert (fp.leq (fp #b1 #b0110111 #b1011000001001101)
                expect
                (fp #b1 #b0101011 #b0110110000000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
