(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100100 #b0101101001010101)
                expect
                (fp #b0 #b1100010 #b0010111010110111)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110111)
                expect
                (fp #b0 #b1101001 #b1111001100101110)))

(assert (not (= expect result)))

(check-sat)
