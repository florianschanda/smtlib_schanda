;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011010 #b1111000101011011)
                arg1
                (fp #b1 #b0000000 #b1010101010101000)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101010101000)
                arg1
                (fp #b0 #b1110001 #b0000001110001001)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b0101000010111011)
                arg2
                (fp #b1 #b0001001 #b0010000001100101)))
(assert (fp.leq (fp #b1 #b0001001 #b0010000001100101)
                arg2
                (fp #b1 #b0000111 #b0000001100011011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110101 #b1011001101101010)
                expect
                (fp #b1 #b0001001 #b0010000100010000)))
(assert (fp.leq (fp #b1 #b0001001 #b0010000100010000)
                expect
                (fp #b0 #b1111110 #b1111010001100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
