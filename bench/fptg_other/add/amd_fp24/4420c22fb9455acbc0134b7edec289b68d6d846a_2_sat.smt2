                arg1
                (fp #b0 #b1101100 #b1010100100110011)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110011)
                arg1
                (fp #b0 #b1111000 #b0010100100110101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b0100000011110111)
                arg2
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                arg2
                (fp #b0 #b1100111 #b1011011001110000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100101 #b1110110010100110)
                expect
                (fp #b0 #b1101100 #b1010100100110100)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110100)
                expect
                (fp #b0 #b1111110 #b1000011101011110)))

(assert (= expect result))

(check-sat)
(exit)
