(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1111001 #b0101000101011000)
                arg1
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1011100 #b1010111110101100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b0000111000110100)
                arg2
                (fp #b1 #b1101100 #b1011000110011001)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                arg2
                (fp #b0 #b0111110 #b1011100111110011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110000 #b1001110101010001)
                expect
                (fp #b1 #b1101100 #b1011000110011001)))
(assert (fp.leq (fp #b1 #b1101100 #b1011000110011001)
                expect
                (fp #b0 #b1001110 #b0000010110100111)))

(assert (= expect result))

(check-sat)
(exit)
