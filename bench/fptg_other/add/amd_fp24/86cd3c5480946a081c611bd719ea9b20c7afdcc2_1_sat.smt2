(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001011 #b0000100101101010)
                arg1
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg1
                (fp #b0 #b0101011 #b0110111010011100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100100 #b1100100000110001)
                arg2
                (fp #b0 #b1010110 #b0010110110100100)))
(assert (fp.leq (fp #b0 #b1010110 #b0010110110100100)
                arg2
                (fp #b0 #b1011101 #b1110100010000010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011011 #b1000101110001011)
                expect
                (fp #b0 #b1010110 #b0010110110100100)))
(assert (fp.leq (fp #b0 #b1010110 #b0010110110100100)
                expect
                (fp #b0 #b1100110 #b0100100001100110)))

(assert (= expect result))

(check-sat)
(exit)
