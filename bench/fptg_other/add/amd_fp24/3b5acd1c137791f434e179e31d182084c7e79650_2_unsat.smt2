; Format: AMD_FP24
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101101 #b0011101010001111)
                arg1
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg1
                (fp #b0 #b1010100 #b1110011000111111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b1010100110000011)
                arg2
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                arg2
                (fp #b0 #b1101110 #b1010101000010110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1100110011110111)
                expect
                (fp #b1 #b1010110 #b1010010100010110)))
(assert (fp.leq (fp #b1 #b1010110 #b1010010100010110)
                expect
                (fp #b0 #b1100000 #b1110001101011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
