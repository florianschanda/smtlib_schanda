; Format: AMD_FP24
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011111 #b1001111001010101)
                arg1
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg1
                (fp #b1 #b0000011 #b0100000111101011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b0001110110001110)
                arg2
                (fp #b1 #b0000000 #b1111000111010011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111000111010011)
                arg2
                (fp #b0 #b0011001 #b1001111100110101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111010 #b0100010000001000)
                expect
                (fp #b1 #b0100000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000001)
                expect
                (fp #b1 #b0011101 #b1001111111011100)))

(assert (= expect result))

(check-sat)
(exit)
