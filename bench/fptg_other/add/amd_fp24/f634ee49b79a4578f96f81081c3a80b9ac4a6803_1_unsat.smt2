(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001100 #b0010101011000111)
                expect
                (fp #b0 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010000 #b0000000000000000)
                expect
                (fp #b0 #b1011100 #b1001000100000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
