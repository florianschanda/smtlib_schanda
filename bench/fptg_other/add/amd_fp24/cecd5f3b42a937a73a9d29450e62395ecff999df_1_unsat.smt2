(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -INFINITY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010110 #b1000011100111101)
                arg2
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b0101110 #b1000110001111000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
