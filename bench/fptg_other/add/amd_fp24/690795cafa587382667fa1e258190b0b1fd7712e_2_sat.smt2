; Format: AMD_FP24
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110111 #b0000011111010001)
                arg1
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b0111110 #b0001010010001010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011110 #b1101110110110000)
                arg2
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg2
                (fp #b0 #b0000110 #b0100111000001101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101111 #b1010100110111101)
                expect
                (fp #b1 #b1010000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000001)
                expect
                (fp #b0 #b1010110 #b1110100011010101)))

(assert (= expect result))

(check-sat)
(exit)
