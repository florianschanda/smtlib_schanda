; Format: AMD_FP24
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010100 #b0111001101111100)
                arg1
                (fp #b1 #b0000000 #b1010101010101000)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101010101000)
                arg1
                (fp #b0 #b1110010 #b0100011001001100)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b1110000 #b0010011011110110)
                arg2
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b0000101 #b1101101101001111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010000 #b0010001000010001)
                expect
                (fp #b1 #b0000000 #b1010101010101000)))
(assert (fp.leq (fp #b1 #b0000000 #b1010101010101000)
                expect
                (fp #b0 #b1010100 #b1100111101100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
