; Format: AMD_FP24
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1101011 #b1110100111000101)
                arg1
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1000111 #b0100011001011110)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b0010100110011001)
                arg2
                (fp #b1 #b0001001 #b0010000001100101)))
(assert (fp.leq (fp #b1 #b0001001 #b0010000001100101)
                arg2
                (fp #b0 #b1111101 #b1100000001111111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110011 #b0000110001001010)
                expect
                (fp #b1 #b0001001 #b0010000001100101)))
(assert (fp.leq (fp #b1 #b0001001 #b0010000001100101)
                expect
                (fp #b0 #b1010101 #b1000110100101111)))

(assert (= expect result))

(check-sat)
(exit)
