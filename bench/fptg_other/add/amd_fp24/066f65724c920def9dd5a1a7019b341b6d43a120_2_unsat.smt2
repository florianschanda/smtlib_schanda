(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b0110101101001000)
                arg1
                (fp #b1 #b0110111 #b1011000001001100)))
(assert (fp.leq (fp #b1 #b0110111 #b1011000001001100)
                arg1
                (fp #b0 #b0100000 #b1100111011100000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110101 #b0000100100000100)
                arg2
                (fp #b0 #b0000000 #b0100100111101010)))
(assert (fp.leq (fp #b0 #b0000000 #b0100100111101010)
                arg2
                (fp #b0 #b0110101 #b1000001101101000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b1000001100110100)
                expect
                (fp #b1 #b0110111 #b1011000001001100)))
(assert (fp.leq (fp #b1 #b0110111 #b1011000001001100)
                expect
                (fp #b1 #b0000010 #b1010101010110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
