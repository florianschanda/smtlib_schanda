; Format: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
