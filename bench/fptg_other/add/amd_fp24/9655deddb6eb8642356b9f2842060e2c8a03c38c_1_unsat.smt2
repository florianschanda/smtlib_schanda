;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b1110101110010101)
                arg1
                (fp #b1 #b0111111 #b1111001000110010)))
(assert (fp.leq (fp #b1 #b0111111 #b1111001000110010)
                arg1
                (fp #b0 #b0000001 #b1101101010011111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000000 #b1000000111100001)
                arg2
                (fp #b0 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111111)
                arg2
                (fp #b0 #b1111111 #b0000000000000000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101001 #b1111111101101011)
                expect
                (fp #b0 #b1111110 #b1111111111111110)))
(assert (fp.leq (fp #b0 #b1111110 #b1111111111111110)
                expect
                (fp #b0 #b1111110 #b1111111111111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
