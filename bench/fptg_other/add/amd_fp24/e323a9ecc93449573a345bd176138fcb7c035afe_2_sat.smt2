;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100111 #b1001010101100100)
                arg1
                (fp #b0 #b1000100 #b0100110011010001)))
(assert (fp.leq (fp #b0 #b1000100 #b0100110011010001)
                arg1
                (fp #b0 #b1001110 #b1000001111110011)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101000 #b1100001010111011)
                arg2
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b0011110 #b1100011110100100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b1100110000111010)
                expect
                (fp #b0 #b1000100 #b0100110011010001)))
(assert (fp.leq (fp #b0 #b1000100 #b0100110011010001)
                expect
                (fp #b0 #b1111001 #b1011101011111111)))

(assert (= expect result))

(check-sat)
(exit)
