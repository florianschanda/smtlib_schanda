; Format: AMD_FP24
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011011 #b1110111100001101)
                arg1
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                arg1
                (fp #b0 #b0110001 #b0001011100101010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001111 #b1111011001001101)
                arg2
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b1010000 #b0100001101011100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0110110110010111)
                expect
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                expect
                (fp #b0 #b1111011 #b0110011110110110)))

(assert (= expect result))

(check-sat)
(exit)
