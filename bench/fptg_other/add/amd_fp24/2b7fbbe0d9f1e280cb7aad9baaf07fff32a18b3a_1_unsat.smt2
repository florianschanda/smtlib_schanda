                (fp #b0 #b0000000 #b0010100100110000)))
(assert (fp.leq (fp #b0 #b0000000 #b0010100100110000)
                arg2
                (fp #b0 #b0111011 #b1100010100011101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010000 #b1000100010111010)
                expect
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                expect
                (fp #b0 #b1110110 #b0110001101001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
