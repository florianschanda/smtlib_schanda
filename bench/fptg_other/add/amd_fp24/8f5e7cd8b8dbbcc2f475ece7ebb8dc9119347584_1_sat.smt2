;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b0000111000000001)
                arg1
                (fp #b1 #b0100000 #b0000000000000000)))
