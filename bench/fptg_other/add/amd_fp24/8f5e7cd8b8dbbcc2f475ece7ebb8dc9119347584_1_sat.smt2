(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                arg2
                (fp #b1 #b0101000 #b0000001110110101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010101 #b1101101110000110)
                expect
                (fp #b1 #b1001110 #b0100010010110000)))
(assert (fp.leq (fp #b1 #b1001110 #b0100010010110000)
                expect
                (fp #b0 #b0001001 #b1110110001001010)))

(assert (= expect result))

(check-sat)
(exit)
