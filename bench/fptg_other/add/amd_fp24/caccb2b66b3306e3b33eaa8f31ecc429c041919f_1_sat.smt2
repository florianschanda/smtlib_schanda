; Format: AMD_FP24
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b0110011011110100)
                arg1
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg1
                (fp #b0 #b1010010 #b1100011001101101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101001 #b0110010111010110)
                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1100000 #b0101111011011000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1001000 #b1011111011110000)
                expect
                (fp #b0 #b1001111 #b1111001011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110000)
                expect
                (fp #b0 #b1110000 #b1011100101001011)))

(assert (= expect result))

(check-sat)
(exit)
