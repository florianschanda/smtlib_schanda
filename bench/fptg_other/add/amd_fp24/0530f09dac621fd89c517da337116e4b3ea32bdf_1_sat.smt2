(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b1011101101100110)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b1001100 #b0111010101001010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110011 #b0110010011111010)
                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b0 #b0011101 #b0100110010001101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011111 #b1010101000000001)
                expect
                (fp #b1 #b1011111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1011111 #b0000000000000000)
                expect
                (fp #b1 #b0010101 #b1010001101100100)))

(assert (= expect result))

(check-sat)
(exit)
