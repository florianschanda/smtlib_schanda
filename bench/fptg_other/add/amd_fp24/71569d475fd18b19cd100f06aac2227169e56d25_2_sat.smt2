                arg2
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b1111110 #b0101100001011111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b0011110100110001)
                expect
                (fp #b1 #b1010101 #b0001001101010101)))
(assert (fp.leq (fp #b1 #b1010101 #b0001001101010101)
                expect
                (fp #b1 #b0111011 #b0000011111000000)))

(assert (= expect result))

(check-sat)
(exit)
