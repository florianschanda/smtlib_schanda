; Format: AMD_FP24
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b1001101110001110)
                arg1
                (fp #b0 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000000000000000)
                arg1
                (fp #b0 #b1111110 #b1000000010010111)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b0110111000011000)
                arg2
                (fp #b1 #b1001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001100010111110)
                arg2
                (fp #b0 #b0101101 #b1001110011111111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1100110 #b1011001001001101)
                expect
                (fp #b0 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1111101 #b0000000000000000)
                expect
                (fp #b0 #b1111110 #b1110111111100111)))

(assert (= expect result))

(check-sat)
(exit)
