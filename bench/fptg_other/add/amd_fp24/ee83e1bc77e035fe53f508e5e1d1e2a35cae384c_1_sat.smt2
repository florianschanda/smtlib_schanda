; Format: AMD_FP24
; Arg1: -ONE
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0000000100111011)
                arg1
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                arg1
                (fp #b0 #b1000110 #b1011100001011001)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0100101 #b0001111011100100)
                arg2
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg2
                (fp #b0 #b1011000 #b0000000010100001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010000 #b0110111000001110)
                expect
                (fp #b1 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b1001111 #b1001001100110111)))

(assert (= expect result))

(check-sat)
(exit)
