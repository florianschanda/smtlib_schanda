(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000110 #b1011101010001101)
                expect
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b1111010 #b1110001101110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
