; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1000110010010101)
                arg1
                (fp #b0 #b0000000 #b1010110011010011)))
(assert (fp.leq (fp #b0 #b0000000 #b1010110011010011)
