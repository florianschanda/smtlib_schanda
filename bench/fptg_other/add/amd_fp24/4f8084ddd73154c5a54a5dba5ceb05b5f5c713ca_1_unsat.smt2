(assert (fp.leq (fp #b1 #b0101001 #b0110111110100000)
                arg2
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg2
                (fp #b0 #b0011001 #b1011000010100000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b0000100010001000)
                expect
                (fp #b0 #b0000000 #b0110110011010011)))
(assert (fp.leq (fp #b0 #b0000000 #b0110110011010011)
                expect
                (fp #b0 #b0010000 #b1101001011110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
