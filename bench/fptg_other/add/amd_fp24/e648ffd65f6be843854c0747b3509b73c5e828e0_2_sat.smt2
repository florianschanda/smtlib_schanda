                arg1
                (fp #b0 #b0000000 #b1010110011010011)))
(assert (fp.leq (fp #b0 #b0000000 #b1010110011010011)
                arg1
                (fp #b0 #b1100010 #b0011101100110000)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101110 #b0101101000111000)
                arg2
                (fp #b0 #b1100010 #b0010111010110111)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010110111)
                arg2
                (fp #b0 #b1100100 #b0110000111000000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001000 #b0110110011001101)
                expect
                (fp #b0 #b1100010 #b0010111010111000)))
(assert (fp.leq (fp #b0 #b1100010 #b0010111010111000)
                expect
                (fp #b0 #b1111101 #b1111000111000110)))

(assert (= expect result))

(check-sat)
(exit)
