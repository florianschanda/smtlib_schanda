;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1000010111010001)
                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
