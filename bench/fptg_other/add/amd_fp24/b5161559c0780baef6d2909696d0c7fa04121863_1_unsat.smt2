                arg2
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                arg2
                (fp #b0 #b1111000 #b1111000100001111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101011 #b1111110000001011)
                expect
                (fp #b0 #b0011111 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b0011111 #b1111111111111111)
                expect
                (fp #b0 #b1011001 #b1100000001010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
