; Format: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011000 #b0011100010101001)
                arg1
                (fp #b0 #b0001001 #b1011101001010011)))
(assert (fp.leq (fp #b0 #b0001001 #b1011101001010011)
                arg1
                (fp #b0 #b1100000 #b0000011101010101)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000000 #b1001001111110111)
                arg2
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                arg2
                (fp #b0 #b1010100 #b1110000110001001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001010 #b1110100101010111)
                expect
                (fp #b0 #b1001111 #b1111001011110001)))
(assert (fp.leq (fp #b0 #b1001111 #b1111001011110001)
                expect
                (fp #b0 #b1010111 #b0010000001111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
