                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg2
                (fp #b0 #b1010011 #b0111010100011011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011001 #b0100111001001011)
                expect
                (fp #b1 #b1001111 #b1111110001110110)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110110)
                expect
                (fp #b1 #b0111001 #b0100110101101011)))

(assert (= expect result))

(check-sat)
(exit)
