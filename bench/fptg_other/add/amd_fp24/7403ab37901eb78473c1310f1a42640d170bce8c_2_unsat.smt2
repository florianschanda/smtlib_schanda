; Format: AMD_FP24
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010101 #b0000110110001110)
                arg1
                (fp #b1 #b0000000 #b1111110111101011)))
(assert (fp.leq (fp #b1 #b0000000 #b1111110111101011)
                arg1
                (fp #b0 #b0110100 #b1110110000001010)))

(declare-const arg2 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011101 #b0001011100100100)
                arg2
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg2
                (fp #b0 #b1010111 #b0001011010101101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110110 #b1011100010010000)
                expect
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                expect
                (fp #b0 #b1101101 #b1001001110010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
