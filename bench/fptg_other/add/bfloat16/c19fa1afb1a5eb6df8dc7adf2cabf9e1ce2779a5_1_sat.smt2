(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1111011)
                arg1
                (fp #b1 #b11111100 #b1010011)))
(assert (fp.leq (fp #b1 #b11111100 #b1010011)
                arg1
                (fp #b0 #b01000011 #b1100000)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111111 #b1111111)
                arg2
                (fp #b1 #b00000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000)
                arg2
                (fp #b0 #b11001001 #b1100110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0000000)
                expect
                (fp #b1 #b11111100 #b1010011)))
(assert (fp.leq (fp #b1 #b11111100 #b1010011)
                expect
                (fp #b1 #b11100101 #b1011010)))

(assert (= expect result))

(check-sat)
(exit)
