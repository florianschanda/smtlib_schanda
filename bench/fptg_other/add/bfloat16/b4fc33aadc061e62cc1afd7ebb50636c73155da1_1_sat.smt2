(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001010 #b0101010)
                arg1
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg1
                (fp #b0 #b01010010 #b1111110)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100100 #b0001100)
                arg2
                (fp #b1 #b10000110 #b1010010)))
(assert (fp.leq (fp #b1 #b10000110 #b1010010)
                arg2
                (fp #b0 #b10010010 #b0101000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010011 #b1010001)
                expect
                (fp #b1 #b10000110 #b1010001)))
(assert (fp.leq (fp #b1 #b10000110 #b1010001)
                expect
                (fp #b1 #b00101101 #b0111010)))

(assert (= expect result))

(check-sat)
(exit)
