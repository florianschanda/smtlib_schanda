; Format: BFLOAT16
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01001010 #b0100111)
                arg1
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg1
                (fp #b0 #b11001100 #b1001110)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101111 #b0000111)
                arg2
                (fp #b0 #b00000000 #b1100000)))
(assert (fp.leq (fp #b0 #b00000000 #b1100000)
                arg2
                (fp #b0 #b11110000 #b0101010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00111000 #b1001100)
                expect
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                expect
                (fp #b0 #b11111000 #b1110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
