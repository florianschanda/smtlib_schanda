(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010101 #b0110000)
                arg1
                (fp #b0 #b01111111 #b1011110)))
(assert (fp.leq (fp #b0 #b01111111 #b1011110)
                arg1
                (fp #b0 #b10001110 #b0001001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111001 #b1011111)
                arg2
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                arg2
                (fp #b1 #b01011111 #b1110000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001000 #b0100010)
                expect
                (fp #b1 #b10111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111)
                expect
                (fp #b1 #b00110111 #b0111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
