                arg2
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg2
                (fp #b0 #b00101010 #b1100011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011010 #b1110010)
                expect
                (fp #b1 #b00000001 #b0111101)))
(assert (fp.leq (fp #b1 #b00000001 #b0111101)
                expect
                (fp #b0 #b10111111 #b1010101)))

(assert (= expect result))

(check-sat)
(exit)
