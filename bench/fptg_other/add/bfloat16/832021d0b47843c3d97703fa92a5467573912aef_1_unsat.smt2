(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000101 #b1000010)
                expect
                (fp #b0 #b00111100 #b0110100)))
(assert (fp.leq (fp #b0 #b00111100 #b0110100)
                expect
                (fp #b0 #b10110100 #b1000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
