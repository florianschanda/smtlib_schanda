(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100001 #b1101001)
                arg1
                (fp #b0 #b01000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000)
                arg1
                (fp #b0 #b11011010 #b1011001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10101000 #b1001110)
                arg2
                (fp #b0 #b11010100 #b1011100)))
(assert (fp.leq (fp #b0 #b11010100 #b1011100)
                arg2
                (fp #b0 #b11100001 #b1011010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111110 #b1101101)
                expect
                (fp #b0 #b11010100 #b1011100)))
(assert (fp.leq (fp #b0 #b11010100 #b1011100)
                expect
                (fp #b0 #b11110000 #b0111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
