(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b11000000 #b0001001)
                arg1
                (fp #b0 #b11111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000)
                arg1
                (fp #b0 #b11111110 #b1110111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111011 #b1100001)
                arg2
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                arg2
                (fp #b0 #b11101111 #b1011100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010011 #b0100111)
                expect
                (fp #b0 #b11111101 #b0000001)))
(assert (fp.leq (fp #b0 #b11111101 #b0000001)
                expect
                (fp #b0 #b11111101 #b1101100)))

(assert (= expect result))

(check-sat)
(exit)
