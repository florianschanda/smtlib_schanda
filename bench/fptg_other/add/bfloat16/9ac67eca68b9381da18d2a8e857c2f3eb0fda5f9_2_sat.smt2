; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000111 #b0000011)
                arg1
                (fp #b0 #b01100011 #b1110000)))
(assert (fp.leq (fp #b0 #b01100011 #b1110000)
                arg1
                (fp #b0 #b11100101 #b0011000)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b1110000)
                arg2
                (fp #b1 #b00111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg2
                (fp #b0 #b01010100 #b1011011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01010011 #b0100100)
                expect
                (fp #b0 #b01100011 #b1110000)))
(assert (fp.leq (fp #b0 #b01100011 #b1110000)
                expect
                (fp #b0 #b10100001 #b1111110)))

(assert (= expect result))

(check-sat)
(exit)
