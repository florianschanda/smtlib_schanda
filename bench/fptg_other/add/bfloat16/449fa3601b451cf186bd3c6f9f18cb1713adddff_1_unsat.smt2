(assert (fp.leq (fp #b1 #b11110000 #b0000011)
                arg2
                (fp #b0 #b01101100 #b0001010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0110101)
                expect
                (fp #b1 #b11110000 #b0000011)))
(assert (fp.leq (fp #b1 #b11110000 #b0000011)
                expect
                (fp #b1 #b11101001 #b0111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
