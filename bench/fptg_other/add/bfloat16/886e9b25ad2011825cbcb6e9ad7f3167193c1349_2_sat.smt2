(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000101 #b1111101)
                arg1
                (fp #b0 #b00010000 #b0111101)))
(assert (fp.leq (fp #b0 #b00010000 #b0111101)
                arg1
                (fp #b0 #b11111011 #b1100001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100010 #b1000011)
                arg2
                (fp #b0 #b00000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000)
                arg2
                (fp #b0 #b11011100 #b0011110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100010 #b0010101)
                expect
                (fp #b0 #b00010000 #b0111110)))
(assert (fp.leq (fp #b0 #b00010000 #b0111110)
                expect
                (fp #b0 #b10000101 #b0101111)))

(assert (= expect result))

(check-sat)
(exit)
