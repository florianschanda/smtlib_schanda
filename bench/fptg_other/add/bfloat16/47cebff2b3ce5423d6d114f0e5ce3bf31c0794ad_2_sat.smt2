(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110100 #b1100011)
                arg1
                (fp #b1 #b01100001 #b1110011)))
(assert (fp.leq (fp #b1 #b01100001 #b1110011)
                arg1
                (fp #b0 #b10110001 #b0010111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b1010010)
                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b0 #b01101111 #b1000001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101111 #b0001101)
                expect
                (fp #b1 #b11101011 #b1001111)))
(assert (fp.leq (fp #b1 #b11101011 #b1001111)
                expect
                (fp #b0 #b00110100 #b1001111)))

(assert (= expect result))

(check-sat)
(exit)
