(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101011 #b1100100)
                arg1
                (fp #b1 #b01100001 #b1110011)))
(assert (fp.leq (fp #b1 #b01100001 #b1110011)
                arg1
                (fp #b0 #b01111101 #b0010010)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001011 #b0101000)
                arg2
                (fp #b1 #b00011111 #b1001011)))
(assert (fp.leq (fp #b1 #b00011111 #b1001011)
                arg2
                (fp #b1 #b00011100 #b1010001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111000 #b1111001)
                expect
                (fp #b1 #b01100001 #b1110100)))
(assert (fp.leq (fp #b1 #b01100001 #b1110100)
                expect
                (fp #b1 #b00010111 #b1000101)))

(assert (= expect result))

(check-sat)
(exit)
