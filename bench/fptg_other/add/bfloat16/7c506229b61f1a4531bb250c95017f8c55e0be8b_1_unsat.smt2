                arg2
                (fp #b0 #b00000000 #b1011101)))
(assert (fp.leq (fp #b0 #b00000000 #b1011101)
                arg2
                (fp #b0 #b00010101 #b0110000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b0111111)
                expect
                (fp #b1 #b01100001 #b1110010)))
(assert (fp.leq (fp #b1 #b01100001 #b1110010)
                expect
                (fp #b0 #b11010110 #b0101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
