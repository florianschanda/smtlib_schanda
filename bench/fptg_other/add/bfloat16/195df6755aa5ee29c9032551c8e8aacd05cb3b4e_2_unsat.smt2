; Format: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000110 #b0110001)
                arg1
                (fp #b0 #b10101100 #b0000010)))
(assert (fp.leq (fp #b0 #b10101100 #b0000010)
                arg1
                (fp #b0 #b11000001 #b1011100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                arg2
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                arg2
                (fp #b0 #b01011110 #b1110011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111111 #b0000000)
                expect
                (fp #b1 #b11111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                expect
                (fp #b0 #b00101101 #b1011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
