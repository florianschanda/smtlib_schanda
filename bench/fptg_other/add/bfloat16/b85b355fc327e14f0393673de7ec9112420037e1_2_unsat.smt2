(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011001 #b0011001)
                expect
                (fp #b0 #b11101011 #b0101000)))
(assert (fp.leq (fp #b0 #b11101011 #b0101000)
                expect
                (fp #b0 #b11101011 #b0101010)))

(assert (not (= expect result)))

(check-sat)
