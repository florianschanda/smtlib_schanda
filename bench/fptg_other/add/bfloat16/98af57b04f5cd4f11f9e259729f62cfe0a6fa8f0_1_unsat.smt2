(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110110 #b0101001)
                expect
                (fp #b0 #b01111111 #b1011110)))
(assert (fp.leq (fp #b0 #b01111111 #b1011110)
                expect
                (fp #b0 #b10000100 #b1110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
