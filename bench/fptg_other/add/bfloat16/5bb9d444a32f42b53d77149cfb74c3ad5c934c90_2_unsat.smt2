                (fp #b0 #b11101011 #b0100111)))
(assert (fp.leq (fp #b0 #b11101011 #b0100111)
                arg2
                (fp #b0 #b11110011 #b1001101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010000 #b0010010)
                expect
                (fp #b0 #b11101011 #b0101000)))
(assert (fp.leq (fp #b0 #b11101011 #b0101000)
                expect
                (fp #b0 #b11110110 #b1001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
