(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1111111)
                arg1
                (fp #b1 #b11111100 #b1010011)))
(assert (fp.leq (fp #b1 #b11111100 #b1010011)
                arg1
                (fp #b1 #b11001110 #b0101101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100111 #b1101000)
                arg2
                (fp #b1 #b11010010 #b1100000)))
(assert (fp.leq (fp #b1 #b11010010 #b1100000)
                arg2
                (fp #b0 #b10110111 #b1110010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0011110)
                expect
                (fp #b1 #b11111100 #b1010100)))
(assert (fp.leq (fp #b1 #b11111100 #b1010100)
                expect
                (fp #b0 #b11110001 #b0000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
