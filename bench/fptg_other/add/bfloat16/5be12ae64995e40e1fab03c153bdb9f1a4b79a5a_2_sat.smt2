(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101111 #b0010100)
                arg1
                (fp #b0 #b00010000 #b0111101)))
(assert (fp.leq (fp #b0 #b00010000 #b0111101)
                arg1
                (fp #b0 #b11111100 #b0010100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101000 #b0101100)
                arg2
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b0 #b00111011 #b0011010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101110 #b0011010)
                expect
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                expect
                (fp #b0 #b01111100 #b1111101)))

(assert (= expect result))

(check-sat)
(exit)
