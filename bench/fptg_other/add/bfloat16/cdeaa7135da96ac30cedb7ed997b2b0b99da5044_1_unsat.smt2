; Format: BFLOAT16
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b1100000)
                arg1
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                arg1
                (fp #b0 #b00011100 #b1110111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011100 #b1000000)
                arg2
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                arg2
                (fp #b0 #b10010000 #b1100000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101011 #b1011101)
                expect
                (fp #b0 #b10000110 #b0000001)))
(assert (fp.leq (fp #b0 #b10000110 #b0000001)
                expect
                (fp #b0 #b10001111 #b0011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
