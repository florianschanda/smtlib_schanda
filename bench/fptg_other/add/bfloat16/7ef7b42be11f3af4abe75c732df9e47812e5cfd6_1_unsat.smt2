                (fp #b1 #b00000000 #b0000011)))
(assert (fp.leq (fp #b1 #b00000000 #b0000011)
                arg2
                (fp #b0 #b11001101 #b0110100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011010 #b1010100)
                expect
                (fp #b1 #b00000001 #b0000010)))
(assert (fp.leq (fp #b1 #b00000001 #b0000010)
                expect
                (fp #b0 #b10001111 #b0000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
