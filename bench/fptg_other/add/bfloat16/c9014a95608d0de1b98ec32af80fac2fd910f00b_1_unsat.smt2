(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110000 #b0110100)
                arg1
                (fp #b1 #b11101100 #b1110011)))
(assert (fp.leq (fp #b1 #b11101100 #b1110011)
                arg1
                (fp #b0 #b00001001 #b0100111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011001 #b0101011)
                arg2
                (fp #b0 #b00000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000)
                arg2
                (fp #b0 #b10001001 #b1000100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111001 #b1010011)
                expect
                (fp #b1 #b11101100 #b1110010)))
(assert (fp.leq (fp #b1 #b11101100 #b1110010)
                expect
                (fp #b0 #b11010001 #b0110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
