                arg2
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                arg2
                (fp #b1 #b00000010 #b0111101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110011 #b0110101)
                expect
                (fp #b1 #b10000000 #b0111111)))
(assert (fp.leq (fp #b1 #b10000000 #b0111111)
                expect
                (fp #b1 #b01011111 #b0011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
