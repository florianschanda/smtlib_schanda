(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01001100 #b1100110)
                arg1
                (fp #b0 #b00000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000)
                arg1
                (fp #b0 #b01110100 #b0100101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000110 #b0101110)
                arg2
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                arg2
                (fp #b0 #b10110011 #b0000010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100110 #b1110100)
                expect
                (fp #b0 #b01111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000)
                expect
                (fp #b0 #b10000010 #b1010100)))

(assert (= expect result))

(check-sat)
(exit)
