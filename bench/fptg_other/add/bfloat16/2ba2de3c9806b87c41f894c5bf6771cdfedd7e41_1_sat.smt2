                arg2
                (fp #b1 #b10000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000101 #b1100000)
                arg2
                (fp #b0 #b00101010 #b0010111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001011 #b1000011)
                expect
                (fp #b1 #b10000111 #b0111000)))
(assert (fp.leq (fp #b1 #b10000111 #b0111000)
                expect
                (fp #b1 #b01001000 #b1001111)))

(assert (= expect result))

(check-sat)
(exit)
