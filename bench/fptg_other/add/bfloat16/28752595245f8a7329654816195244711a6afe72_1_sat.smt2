(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100000 #b1111000)
                arg1
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg1
                (fp #b0 #b11011011 #b0111000)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01000110 #b0101110)
                arg2
                (fp #b0 #b10000110 #b1110011)))
(assert (fp.leq (fp #b0 #b10000110 #b1110011)
                arg2
                (fp #b0 #b11110111 #b1000100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110001 #b1000001)
                expect
                (fp #b0 #b10000111 #b1111001)))
(assert (fp.leq (fp #b0 #b10000111 #b1111001)
                expect
                (fp #b0 #b11110111 #b0100101)))

(assert (= expect result))

(check-sat)
(exit)
