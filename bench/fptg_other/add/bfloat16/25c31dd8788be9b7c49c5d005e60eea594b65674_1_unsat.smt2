                arg2
                (fp #b0 #b11101011 #b0100111)))
(assert (fp.leq (fp #b0 #b11101011 #b0100111)
                arg2
                (fp #b0 #b11110000 #b1100111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b11011011 #b1011101)
                expect
                (fp #b0 #b11101011 #b0100110)))
(assert (fp.leq (fp #b0 #b11101011 #b0100110)
                expect
                (fp #b0 #b11111000 #b0111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
