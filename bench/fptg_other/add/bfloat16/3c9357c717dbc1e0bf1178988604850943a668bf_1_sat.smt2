(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111010 #b0001110)
                arg1
                (fp #b1 #b11101100 #b1110011)))
(assert (fp.leq (fp #b1 #b11101100 #b1110011)
                arg1
                (fp #b1 #b01100001 #b1010111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101011 #b1011010)
                arg2
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg2
                (fp #b0 #b10111000 #b1111000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110011 #b0010001)
                expect
                (fp #b1 #b11101100 #b1110011)))
(assert (fp.leq (fp #b1 #b11101100 #b1110011)
                expect
                (fp #b1 #b11001010 #b0000101)))

(assert (= expect result))

(check-sat)
(exit)
