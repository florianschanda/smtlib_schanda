(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100011 #b0111110)
                arg1
                (fp #b0 #b00000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111)
                arg1
                (fp #b0 #b11000000 #b1010110)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1010000)
                arg2
                (fp #b1 #b11110000 #b0000011)))
(assert (fp.leq (fp #b1 #b11110000 #b0000011)
                arg2
                (fp #b0 #b00010101 #b1001011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1011001)
                expect
                (fp #b1 #b11110000 #b0000010)))
(assert (fp.leq (fp #b1 #b11110000 #b0000010)
                expect
                (fp #b1 #b01001101 #b0110110)))

(assert (= expect result))

(check-sat)
(exit)
