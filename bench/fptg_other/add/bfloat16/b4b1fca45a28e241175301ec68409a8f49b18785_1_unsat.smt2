; Format: BFLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101110 #b1100001)
                arg1
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                arg1
                (fp #b0 #b10100100 #b0001111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110100 #b1011100)
                arg2
                (fp #b1 #b00000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000)
                arg2
                (fp #b0 #b01100101 #b0011111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101111 #b0101111)
                expect
                (fp #b1 #b01000000 #b0000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000)
                expect
                (fp #b0 #b01110100 #b1100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
