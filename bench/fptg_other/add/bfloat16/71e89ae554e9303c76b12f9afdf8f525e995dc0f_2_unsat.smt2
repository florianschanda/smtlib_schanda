(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg2
                (fp #b0 #b10101000 #b0111001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111011 #b0111011)
                expect
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                expect
                (fp #b0 #b01001001 #b1100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
