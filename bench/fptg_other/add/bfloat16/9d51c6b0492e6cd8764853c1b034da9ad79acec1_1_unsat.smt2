(assert (fp.leq (fp #b1 #b10100001 #b1110010)
                arg2
                (fp #b1 #b00000000 #b0000011)))
(assert (fp.leq (fp #b1 #b00000000 #b0000011)
                arg2
                (fp #b0 #b00110110 #b0001111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010000 #b1111001)
                expect
                (fp #b0 #b01111111 #b1011101)))
(assert (fp.leq (fp #b0 #b01111111 #b1011101)
                expect
                (fp #b0 #b11000111 #b1101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
