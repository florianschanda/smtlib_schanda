(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101110 #b0010110)
                arg1
                (fp #b0 #b01111111 #b1011110)))
(assert (fp.leq (fp #b0 #b01111111 #b1011110)
                arg1
                (fp #b0 #b11110011 #b0010110)))

