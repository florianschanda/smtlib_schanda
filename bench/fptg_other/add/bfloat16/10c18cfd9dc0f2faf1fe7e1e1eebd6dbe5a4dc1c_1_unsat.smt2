(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg2
                (fp #b0 #b10110110 #b1100100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000001 #b1100110)
                expect
                (fp #b1 #b10111110 #b1111110)))
(assert (fp.leq (fp #b1 #b10111110 #b1111110)
                expect
                (fp #b0 #b10001110 #b1011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
