(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000111 #b0010111)
                expect
                (fp #b1 #b00111100 #b0110100)))
(assert (fp.leq (fp #b1 #b00111100 #b0110100)
                expect
                (fp #b0 #b10100010 #b0011110)))

(assert (not (= expect result)))

(check-sat)
