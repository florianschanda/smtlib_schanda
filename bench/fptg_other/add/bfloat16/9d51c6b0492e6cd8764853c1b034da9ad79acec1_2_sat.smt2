; Format: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101110 #b0010110)
                arg1
                (fp #b0 #b01111111 #b1011110)))
(assert (fp.leq (fp #b0 #b01111111 #b1011110)
                arg1
                (fp #b0 #b11110011 #b0010110)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100001 #b1110010)
                arg2
                (fp #b1 #b00000000 #b0000011)))
(assert (fp.leq (fp #b1 #b00000000 #b0000011)
                arg2
                (fp #b0 #b00110110 #b0001111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101111 #b0111100)
                expect
                (fp #b0 #b01111111 #b1011110)))
(assert (fp.leq (fp #b0 #b01111111 #b1011110)
                expect
                (fp #b0 #b10011001 #b1011111)))

(assert (= expect result))

(check-sat)
(exit)
