(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg2
                (fp #b1 #b00101010 #b1101101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1010101)
                expect
                (fp #b1 #b11111100 #b1010011)))
(assert (fp.leq (fp #b1 #b11111100 #b1010011)
                expect
                (fp #b1 #b11001100 #b1000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
