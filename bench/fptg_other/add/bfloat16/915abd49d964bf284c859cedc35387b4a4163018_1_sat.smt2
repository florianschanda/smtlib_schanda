(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000100 #b1111100)
                arg1
                (fp #b0 #b10101100 #b0000010)))
(assert (fp.leq (fp #b0 #b10101100 #b0000010)
                arg1
                (fp #b0 #b11011000 #b1000111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111011 #b1111011)
                arg2
                (fp #b0 #b01011000 #b1111000)))
(assert (fp.leq (fp #b0 #b01011000 #b1111000)
                arg2
                (fp #b0 #b01011101 #b1111000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111101 #b0011010)
                expect
                (fp #b0 #b10101100 #b0000010)))
(assert (fp.leq (fp #b0 #b10101100 #b0000010)
                expect
                (fp #b0 #b10101111 #b0101111)))

(assert (= expect result))

(check-sat)
(exit)
