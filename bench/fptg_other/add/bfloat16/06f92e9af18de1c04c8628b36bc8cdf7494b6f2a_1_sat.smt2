(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111110 #b0010111)
                arg1
                (fp #b1 #b00111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                arg1
                (fp #b0 #b01100100 #b1010000)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110100 #b0001110)
                arg2
                (fp #b1 #b00011111 #b1001011)))
(assert (fp.leq (fp #b1 #b00011111 #b1001011)
                arg2
                (fp #b0 #b00110110 #b1110111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011011 #b1000101)
                expect
                (fp #b1 #b00111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111100 #b0110101)
                expect
                (fp #b0 #b10100001 #b1110110)))

(assert (= expect result))

(check-sat)
(exit)
