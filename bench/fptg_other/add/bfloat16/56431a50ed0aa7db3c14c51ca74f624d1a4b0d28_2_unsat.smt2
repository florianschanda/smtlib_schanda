(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00111111 #b1100010)
                arg1
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg1
                (fp #b0 #b11010111 #b1011100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111000 #b0101010)
                arg2
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                arg2
                (fp #b0 #b10101000 #b0101110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111000 #b1111000)
                expect
                (fp #b1 #b11101011 #b1001110)))
(assert (fp.leq (fp #b1 #b11101011 #b1001110)
                expect
                (fp #b0 #b01011000 #b0001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
