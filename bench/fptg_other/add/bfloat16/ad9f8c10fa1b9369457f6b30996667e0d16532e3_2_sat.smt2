(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010010 #b1011001)
                arg1
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                arg1
                (fp #b0 #b01000101 #b0011011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111100 #b0001010)
                arg2
                (fp #b1 #b00000000 #b0000011)))
(assert (fp.leq (fp #b1 #b00000000 #b0000011)
                arg2
                (fp #b0 #b11011011 #b1100100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011110 #b1000000)
                expect
                (fp #b1 #b10000110 #b0110010)))
(assert (fp.leq (fp #b1 #b10000110 #b0110010)
                expect
                (fp #b0 #b00011111 #b0000101)))

(assert (= expect result))

(check-sat)
(exit)
