; Format: BFLOAT16
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0111100)
                arg1
                (fp #b1 #b11111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000)
                arg1
                (fp #b1 #b00011000 #b0011001)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010011 #b1110101)
                arg2
                (fp #b0 #b00111110 #b0111101)))
(assert (fp.leq (fp #b0 #b00111110 #b0111101)
                arg2
                (fp #b0 #b11100000 #b0110101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b0010110)
                expect
                (fp #b1 #b11111100 #b1111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111)
                expect
                (fp #b1 #b10111010 #b1100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
