(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1011110)
                arg1
                (fp #b1 #b11111100 #b1010011)))
(assert (fp.leq (fp #b1 #b11111100 #b1010011)
                arg1
                (fp #b0 #b10011110 #b0011100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00110110 #b0110110)
                arg2
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg2
                (fp #b0 #b10010010 #b1000001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1010101)
                expect
                (fp #b1 #b11111100 #b1010010)))
(assert (fp.leq (fp #b1 #b11111100 #b1010010)
                expect
                (fp #b1 #b11000110 #b1001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
