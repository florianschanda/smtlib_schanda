(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000100 #b1110000)
                expect
                (fp #b0 #b00010000 #b0111110)))
(assert (fp.leq (fp #b0 #b00010000 #b0111110)
                expect
                (fp #b0 #b00101100 #b0110100)))

(assert (not (= expect result)))

