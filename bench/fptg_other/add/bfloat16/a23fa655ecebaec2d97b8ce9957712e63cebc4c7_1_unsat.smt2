(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011001 #b1111100)
                arg1
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                arg1
                (fp #b1 #b01000111 #b1111100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100100 #b1001001)
                arg2
                (fp #b0 #b10010001 #b1101001)))
(assert (fp.leq (fp #b0 #b10010001 #b1101001)
                arg2
                (fp #b0 #b10011110 #b1000001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01001001 #b0000110)
                expect
                (fp #b0 #b10010001 #b1101000)))
(assert (fp.leq (fp #b0 #b10010001 #b1101000)
                expect
                (fp #b0 #b11011000 #b0011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
