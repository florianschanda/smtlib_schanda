(assert (fp.leq (fp #b0 #b00000000 #b1011101)
                arg2
                (fp #b0 #b11011001 #b1110001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001011 #b0111110)
                expect
                (fp #b0 #b01100011 #b1110001)))
(assert (fp.leq (fp #b0 #b01100011 #b1110001)
                expect
                (fp #b0 #b11000001 #b0000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
