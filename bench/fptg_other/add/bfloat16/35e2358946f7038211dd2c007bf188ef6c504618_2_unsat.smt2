                (fp #b0 #b11001001 #b0100010)))
(assert (fp.leq (fp #b0 #b11001001 #b0100010)
                arg1
                (fp #b0 #b11110110 #b0100100)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111111 #b0011100)
                arg2
                (fp #b0 #b00000000 #b1011101)))
(assert (fp.leq (fp #b0 #b00000000 #b1011101)
                arg2
                (fp #b0 #b00000000 #b1101010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01110100 #b0100000)
                expect
                (fp #b0 #b11001001 #b0100011)))
(assert (fp.leq (fp #b0 #b11001001 #b0100011)
                expect
                (fp #b0 #b11101100 #b1101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
