; Format: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101100 #b1110111)
                arg1
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg1
                (fp #b0 #b11100010 #b1100011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000000 #b1001000)
                arg2
                (fp #b0 #b00111110 #b0111101)))
(assert (fp.leq (fp #b0 #b00111110 #b0111101)
                arg2
                (fp #b0 #b11111010 #b0010001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111100 #b0001110)
                expect
                (fp #b0 #b10000011 #b1110001)))
(assert (fp.leq (fp #b0 #b10000011 #b1110001)
                expect
                (fp #b0 #b11001111 #b1111100)))

(assert (= expect result))

(check-sat)
(exit)
