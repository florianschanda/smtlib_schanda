(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010001 #b1100001)
                arg1
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                arg1
                (fp #b0 #b10101101 #b0111110)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101000 #b0011111)
                arg2
                (fp #b1 #b11010010 #b1100000)))
(assert (fp.leq (fp #b1 #b11010010 #b1100000)
                arg2
                (fp #b1 #b10101000 #b1111101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100110 #b0011100)
                expect
                (fp #b1 #b11010010 #b1100001)))
(assert (fp.leq (fp #b1 #b11010010 #b1100001)
                expect
                (fp #b1 #b10100000 #b1011000)))

(assert (= expect result))

(check-sat)
(exit)
