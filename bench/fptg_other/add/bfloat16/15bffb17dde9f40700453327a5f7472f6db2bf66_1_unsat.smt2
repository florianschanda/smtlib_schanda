(set-info :category "random")
(set-info :status unsat)

; Format: BFLOAT16
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10010111 #b1000001)
                arg1
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg1
                (fp #b0 #b01000001 #b1111101)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111001 #b0001100)
                arg2
                (fp #b1 #b00011111 #b1001011)))
(assert (fp.leq (fp #b1 #b00011111 #b1001011)
                arg2
                (fp #b0 #b11001101 #b1110100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101000 #b0101101)
                expect
                (fp #b1 #b00011111 #b1001011)))
(assert (fp.leq (fp #b1 #b00011111 #b1001011)
                expect
                (fp #b0 #b01000010 #b1010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
