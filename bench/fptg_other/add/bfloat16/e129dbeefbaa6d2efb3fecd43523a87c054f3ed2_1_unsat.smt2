; Format: BFLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011111 #b1011001)
                arg1
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg1
                (fp #b0 #b01111011 #b1001010)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101100 #b0100000)
                arg2
                (fp #b0 #b00000000 #b1100000)))
(assert (fp.leq (fp #b0 #b00000000 #b1100000)
                arg2
                (fp #b0 #b10000011 #b0011010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101000 #b1101010)
                expect
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                expect
                (fp #b0 #b11101111 #b0100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
