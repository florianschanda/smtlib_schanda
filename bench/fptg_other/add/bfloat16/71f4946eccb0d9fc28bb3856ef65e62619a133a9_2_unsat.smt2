                (fp #b1 #b00000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000001)
                arg2
                (fp #b0 #b01100101 #b0111110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011111 #b1001101)
                expect
                (fp #b0 #b10111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111)
                expect
                (fp #b0 #b11101010 #b1010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
