; Format: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000100 #b1010010)
                arg1
                (fp #b1 #b00000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000 #b1111010)
                arg1
                (fp #b0 #b00101101 #b0011010)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00001000 #b1000011)
                arg2
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg2
                (fp #b0 #b01001011 #b0110100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110101 #b1000001)
                expect
                (fp #b1 #b00000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000 #b1111010)
                expect
                (fp #b0 #b10100100 #b0001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
