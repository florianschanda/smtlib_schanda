                arg2
                (fp #b0 #b10000011 #b1000011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110110 #b1010010)
                expect
                (fp #b0 #b00000000 #b1111110)))
(assert (fp.leq (fp #b0 #b00000000 #b1111110)
                expect
                (fp #b0 #b11101100 #b1111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
