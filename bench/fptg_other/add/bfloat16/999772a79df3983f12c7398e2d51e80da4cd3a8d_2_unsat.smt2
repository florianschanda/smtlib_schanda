; Format: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b0010000)
                arg1
                (fp #b1 #b01101101 #b1000001)))
(assert (fp.leq (fp #b1 #b01101101 #b1000001)
                arg1
                (fp #b0 #b10010010 #b1110110)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b1011011)
                arg2
                (fp #b0 #b00000000 #b1100000)))
(assert (fp.leq (fp #b0 #b00000000 #b1100000)
                arg2
                (fp #b0 #b10011010 #b1001101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b1000011)
                expect
                (fp #b1 #b01101101 #b1000001)))
(assert (fp.leq (fp #b1 #b01101101 #b1000001)
                expect
                (fp #b1 #b00110010 #b0011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
