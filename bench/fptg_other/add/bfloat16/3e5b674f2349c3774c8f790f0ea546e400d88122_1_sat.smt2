(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1010101)
                arg1
                (fp #b1 #b11111100 #b1010011)))
(assert (fp.leq (fp #b1 #b11111100 #b1010011)
                arg1
                (fp #b1 #b10110011 #b0111011)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0011000)
                arg2
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                arg2
                (fp #b0 #b00110001 #b0100111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b1000001)
                expect
                (fp #b1 #b11111100 #b1010010)))
(assert (fp.leq (fp #b1 #b11111100 #b1010010)
                expect
                (fp #b0 #b10010110 #b1111000)))

(assert (= expect result))

(check-sat)
(exit)
