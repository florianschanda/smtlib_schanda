; Format: BFLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00100100 #b1011010)
                arg1
                (fp #b0 #b00111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111100 #b0110101)
                arg1
                (fp #b0 #b01010111 #b1101111)))

(declare-const arg2 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111100 #b1111111)
                arg2
                (fp #b0 #b01000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000)
                arg2
                (fp #b0 #b01110111 #b1101010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010011 #b0110100)
                expect
                (fp #b0 #b01000000 #b0001011)))
(assert (fp.leq (fp #b0 #b01000000 #b0001011)
                expect
                (fp #b0 #b11101101 #b1110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
