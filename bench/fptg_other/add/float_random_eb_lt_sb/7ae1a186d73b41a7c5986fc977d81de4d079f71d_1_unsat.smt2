(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 5))
(assert (fp.leq (fp #b1 #b0011 #b1110)
                arg1
                (fp #b0 #b0001 #b0000)))
(assert (fp.leq (fp #b0 #b0001 #b0000)
                arg1
                (fp #b0 #b1001 #b1110)))

(declare-const arg2 (_ FloatingPoint 4 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0110 #b1010)
                arg2
                (fp #b0 #b0000 #b0000)))
(assert (fp.leq (fp #b0 #b0000 #b0000)
                arg2
                (fp #b0 #b1010 #b1000)))

(declare-const result (_ FloatingPoint 4 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 5))
(assert (fp.leq (fp #b1 #b1011 #b1000)
                expect
                (fp #b0 #b0001 #b0000)))
(assert (fp.leq (fp #b0 #b0001 #b0000)
                expect
                (fp #b0 #b0011 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
