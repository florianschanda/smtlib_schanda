(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 14))
(assert (fp.leq (fp #b1 #b11111010 #b1100000110000)
                arg1
                (fp #b1 #b11111001 #b1101001110110)))
(assert (fp.leq (fp #b1 #b11111001 #b1101001110110)
                arg1
                (fp #b1 #b01000111 #b1111101011000)))

(declare-const arg2 (_ FloatingPoint 8 14))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 8 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11101000 #b1000110000100)
                expect
                (fp #b0 #b00000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000000)
                expect
                (fp #b0 #b00100011 #b0100111111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
