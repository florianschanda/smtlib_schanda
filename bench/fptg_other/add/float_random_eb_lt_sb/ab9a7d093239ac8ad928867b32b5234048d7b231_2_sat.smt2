(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 13))
(assert (fp.leq (fp #b1 #b10010000 #b101010000110)
                arg1
                (fp #b0 #b10111110 #b111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111)
                arg1
                (fp #b0 #b11010000 #b101001111011)))

(declare-const arg2 (_ FloatingPoint 8 13))
(assert (fp.leq (fp #b1 #b01100001 #b111111111111)
                arg2
                (fp #b1 #b00000000 #b000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000001)
                arg2
                (fp #b0 #b10100011 #b010001000111)))

(declare-const result (_ FloatingPoint 8 13))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 13))
(assert (fp.leq (fp #b1 #b00000010 #b010000101001)
                expect
                (fp #b0 #b10111110 #b111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111)
                expect
                (fp #b0 #b11001000 #b001011100010)))

(assert (= expect result))

(check-sat)
(exit)
