(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 12))
(assert (fp.leq (fp #b1 #b0101001 #b11110110101)
                arg1
                (fp #b0 #b0100101 #b01110100010)))
(assert (fp.leq (fp #b0 #b0100101 #b01110100010)
                arg1
                (fp #b0 #b1010000 #b00110001000)))

(declare-const arg2 (_ FloatingPoint 7 12))
(assert (fp.leq (fp #b1 #b1110101 #b10101100110)
                arg2
                (fp #b1 #b0000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b00000000000)
                arg2
                (fp #b0 #b0000100 #b10111001100)))

(declare-const result (_ FloatingPoint 7 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 12))
(assert (fp.leq (fp #b1 #b0000001 #b11110101001)
                expect
                (fp #b0 #b0100101 #b01110100010)))
(assert (fp.leq (fp #b0 #b0100101 #b01110100010)
                expect
                (fp #b0 #b1111000 #b01111010111)))

(assert (= expect result))

(check-sat)
(exit)
