(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 11))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1000010101 #b0110110101)
                arg2
                (fp #b0 #b0000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000000)
                arg2
                (fp #b0 #b0110000011 #b0110100000)))

(declare-const result (_ FloatingPoint 10 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 11))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
