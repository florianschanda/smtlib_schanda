; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b010 #b10111011011)
                arg1
                (fp #b0 #b110 #b11110101101)))
(assert (fp.leq (fp #b0 #b110 #b11110101101)
                arg1
                (fp #b0 #b110 #b11110111101)))

(declare-const arg2 (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b110 #b01111001100)
                arg2
                (fp #b0 #b000 #b00001011011)))
(assert (fp.leq (fp #b0 #b000 #b00001011011)
                arg2
                (fp #b0 #b101 #b11101100111)))

(declare-const result (_ FloatingPoint 3 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b0 #b100 #b11010110110)
                expect
                (fp #b0 #b110 #b11110110000)))
(assert (fp.leq (fp #b0 #b110 #b11110110000)
                expect
                (fp #b0 #b110 #b11110110101)))

(assert (= expect result))

(check-sat)
(exit)
