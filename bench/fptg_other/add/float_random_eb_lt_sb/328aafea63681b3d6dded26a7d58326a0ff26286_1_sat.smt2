; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 18))
(assert (fp.leq (fp #b1 #b11001110 #b00010101000010111)
                arg1
                (fp #b0 #b00000000 #b10000010011110001)))
(assert (fp.leq (fp #b0 #b00000000 #b10000010011110001)
                arg1
                (fp #b0 #b10000000 #b11011001010100111)))

(declare-const arg2 (_ FloatingPoint 8 18))
(assert (fp.leq (fp #b1 #b11010001 #b11010000000000011)
                arg2
                (fp #b0 #b01000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000)
                arg2
                (fp #b0 #b11001111 #b01000100111101010)))

(declare-const result (_ FloatingPoint 8 18))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 18))
(assert (fp.leq (fp #b1 #b01100100 #b01001010010100110)
                expect
                (fp #b0 #b01000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000)
                expect
                (fp #b0 #b11100111 #b01100101001001110)))

(assert (= expect result))

(check-sat)
(exit)
