(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 10))
(assert (fp.leq (fp #b1 #b10110000 #b110011111)
                arg1
                (fp #b0 #b00000000 #b011110111)))
(assert (fp.leq (fp #b0 #b00000000 #b011110111)
                arg1
                (fp #b0 #b00011010 #b110101000)))

(declare-const arg2 (_ FloatingPoint 8 10))
(assert (fp.leq (fp #b0 #b00000101 #b101101010)
                arg2
                (fp #b0 #b10111110 #b111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111)
                arg2
                (fp #b0 #b11111100 #b011110000)))

(declare-const result (_ FloatingPoint 8 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 10))
(assert (fp.leq (fp #b0 #b00111011 #b010000001)
                expect
                (fp #b0 #b10111110 #b111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111)
                expect
                (fp #b0 #b11110101 #b011101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
