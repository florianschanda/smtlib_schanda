;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 35))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 7 35))
(assert (fp.leq (fp #b1 #b1111001 #b1001010101110001010110000011100110)
                arg2
                (fp #b1 #b1111001 #b0000110111110001101111111111001110)))
(assert (fp.leq (fp #b1 #b1111001 #b0000110111110001101111111111001110)
                arg2
                (fp #b0 #b0010011 #b0001001111100111010000011110011110)))

(declare-const result (_ FloatingPoint 7 35))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 35))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
