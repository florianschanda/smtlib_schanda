(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 9))
(assert (fp.leq (fp #b1 #b10111000 #b01011100)
                arg1
                (fp #b0 #b00000000 #b11111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111)
                arg1
                (fp #b0 #b10010111 #b01110001)))

(declare-const arg2 (_ FloatingPoint 8 9))
(assert (fp.leq (fp #b1 #b11011101 #b01101111)
                arg2
                (fp #b1 #b10001000 #b00000000)))
(assert (fp.leq (fp #b1 #b10001000 #b00000000)
                arg2
                (fp #b0 #b00010101 #b00100001)))

(declare-const result (_ FloatingPoint 8 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 9))
(assert (fp.leq (fp #b1 #b10001101 #b10101001)
                expect
                (fp #b1 #b10000111 #b11111111)))
(assert (fp.leq (fp #b1 #b10000111 #b11111111)
                expect
                (fp #b0 #b00010011 #b00100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
