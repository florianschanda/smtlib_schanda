(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 10))
(assert (fp.leq (fp #b1 #b1011010 #b010001000)
                arg1
                (fp #b0 #b0000000 #b011110111)))
(assert (fp.leq (fp #b0 #b0000000 #b011110111)
                arg1
                (fp #b0 #b0100101 #b111111101)))

(declare-const arg2 (_ FloatingPoint 7 10))
(assert (fp.leq (fp #b1 #b1001111 #b101110111)
                arg2
                (fp #b0 #b0100000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b000000000)
                arg2
                (fp #b0 #b1011000 #b110111101)))

(declare-const result (_ FloatingPoint 7 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 10))
(assert (fp.leq (fp #b0 #b0001111 #b111100000)
                expect
                (fp #b0 #b0100000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b000000000)
                expect
                (fp #b0 #b1100111 #b111011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
