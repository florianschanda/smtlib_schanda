(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b100 #b1100011)
                arg1
                (fp #b1 #b000 #b0000000)))
(assert (fp.leq (fp #b1 #b000 #b0000000)
                arg1
                (fp #b0 #b001 #b1100100)))

(declare-const arg2 (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b1 #b101 #b1010010)
                arg2
                (fp #b1 #b001 #b0110110)))
(assert (fp.leq (fp #b1 #b001 #b0110110)
                arg2
                (fp #b0 #b101 #b0110001)))

(declare-const result (_ FloatingPoint 3 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 8))
(assert (fp.leq (fp #b1 #b110 #b0101100)
                expect
                (fp #b1 #b001 #b0110110)))
(assert (fp.leq (fp #b1 #b001 #b0110110)
                expect
                (fp #b1 #b001 #b0101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
