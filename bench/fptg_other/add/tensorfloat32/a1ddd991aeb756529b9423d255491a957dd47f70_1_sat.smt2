(assert (fp.leq (fp #b1 #b10011000 #b1110111110)
                arg2
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b00110001 #b1110100111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000010 #b1001011111)
                expect
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                expect
                (fp #b0 #b00001011 #b1000000011)))

(assert (= expect result))

(check-sat)
(exit)
