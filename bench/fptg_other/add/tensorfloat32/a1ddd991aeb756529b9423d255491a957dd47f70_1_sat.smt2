;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011111 #b1111010000)
                arg1
                (fp #b1 #b00010000 #b1001010100)))
(assert (fp.leq (fp #b1 #b00010000 #b1001010100)
                arg1
                (fp #b0 #b01101101 #b1000001000)))

