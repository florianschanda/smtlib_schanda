(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000101 #b1100100101)
                expect
                (fp #b0 #b00000000 #b1111111110)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111110)
                expect
                (fp #b0 #b01011101 #b1111100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
