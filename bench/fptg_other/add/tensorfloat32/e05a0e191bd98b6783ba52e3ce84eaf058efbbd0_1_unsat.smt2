(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010011 #b1101101000)
                arg1
                (fp #b1 #b00000000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000000 #b1010010101)
                arg1
                (fp #b0 #b01000100 #b1001000000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00101110 #b0101111010)
                arg2
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                arg2
                (fp #b0 #b11111111 #b0000000000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001110 #b0111111110)
                expect
                (fp #b0 #b11111110 #b1111111110)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111110)
                expect
                (fp #b0 #b11111111 #b0000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
