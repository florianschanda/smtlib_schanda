(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100100 #b0110111010)
                arg1
                (fp #b1 #b10011100 #b0001111011)))
(assert (fp.leq (fp #b1 #b10011100 #b0001111011)
                arg1
                (fp #b1 #b00101000 #b0101101011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010110 #b0011010001)
                arg2
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b10011011 #b0100010110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001101 #b0111011001)
                expect
                (fp #b1 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b0000000000)
                expect
                (fp #b0 #b00111001 #b1100000100)))

(assert (= expect result))

(check-sat)
(exit)
