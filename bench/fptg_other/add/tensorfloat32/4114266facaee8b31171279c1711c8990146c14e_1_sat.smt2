(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b1101111100)
                arg1
                (fp #b1 #b11100110 #b0100111100)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111100)
                arg1
                (fp #b0 #b00101101 #b0010110111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000001 #b1100110000)
                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b10011011 #b1101001001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110000 #b0111011010)
                expect
                (fp #b1 #b11100110 #b0100111011)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111011)
                expect
                (fp #b0 #b00110000 #b1010111100)))

(assert (= expect result))

(check-sat)
(exit)
