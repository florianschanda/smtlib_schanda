(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b01000010 #b0000101010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001100 #b0001111110)
                expect
                (fp #b0 #b01111111 #b0000000001)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000001)
                expect
                (fp #b0 #b10101000 #b0101000000)))

(assert (= expect result))

(check-sat)
(exit)
