                arg2
                (fp #b0 #b00000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b01011110 #b1000111101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001001 #b1000010110)
                expect
                (fp #b1 #b00000000 #b0001011001)))
(assert (fp.leq (fp #b1 #b00000000 #b0001011001)
                expect
                (fp #b0 #b10110011 #b0100101000)))

(assert (= expect result))

(check-sat)
(exit)
