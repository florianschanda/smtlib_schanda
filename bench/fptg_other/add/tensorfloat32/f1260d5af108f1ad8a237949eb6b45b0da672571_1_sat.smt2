(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010101 #b0110101100)
                arg1
                (fp #b0 #b00000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111000)
                arg1
                (fp #b0 #b00111111 #b1101110110)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010001 #b0000110100)
                arg2
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                arg2
                (fp #b0 #b11011010 #b1011011111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101001 #b1011010001)
                expect
                (fp #b0 #b10000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000111 #b1011011100)
                expect
                (fp #b0 #b10010000 #b1010110001)))

(assert (= expect result))

(check-sat)
(exit)
