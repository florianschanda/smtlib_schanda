;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1111111010)
                arg1
                (fp #b0 #b01111111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101111011)
                arg1
                (fp #b0 #b10111010 #b1011001100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010101 #b0101000000)
                arg2
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b10110111 #b1110000010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000111 #b0010000111)
                expect
                (fp #b0 #b01111111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101111011)
                expect
                (fp #b0 #b11111000 #b1101000111)))

(assert (= expect result))

(check-sat)
(exit)
