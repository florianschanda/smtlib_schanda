; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111111 #b1001010000)
                arg1
                (fp #b0 #b00000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111000)
                arg1
                (fp #b0 #b00111100 #b0111001011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1110111100)
                arg2
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                arg2
                (fp #b0 #b10010100 #b1011000100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1110011010)
                expect
                (fp #b1 #b11111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111111)
                expect
                (fp #b0 #b00100010 #b1101001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
