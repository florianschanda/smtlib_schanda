(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01010110 #b1111111111)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b10101111 #b1110110101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111001 #b1000011110)
                arg2
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                arg2
                (fp #b0 #b11111100 #b1001111101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b11011010 #b1011000100)
                expect
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                expect
                (fp #b0 #b11111110 #b0010010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
