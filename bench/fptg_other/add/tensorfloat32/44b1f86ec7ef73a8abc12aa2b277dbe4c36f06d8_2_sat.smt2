                arg2
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b11010100 #b1000111101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01011100 #b1100110001)
                expect
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                expect
                (fp #b0 #b01110101 #b1110100100)))

(assert (= expect result))

(check-sat)
(exit)
