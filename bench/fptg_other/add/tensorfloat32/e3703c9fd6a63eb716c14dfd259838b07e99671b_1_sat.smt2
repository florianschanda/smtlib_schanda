; Format: TENSORFLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1000010111)
                arg1
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg1
                (fp #b0 #b01001100 #b0010010010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111101 #b0111010001)
                arg2
                (fp #b1 #b00111100 #b1100110010)))
(assert (fp.leq (fp #b1 #b00111100 #b1100110010)
                arg2
                (fp #b1 #b00011110 #b1110011000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110111 #b0001011101)
                expect
                (fp #b1 #b00111100 #b1100110001)))
(assert (fp.leq (fp #b1 #b00111100 #b1100110001)
                expect
                (fp #b0 #b01111011 #b0000011111)))

(assert (= expect result))

(check-sat)
(exit)
