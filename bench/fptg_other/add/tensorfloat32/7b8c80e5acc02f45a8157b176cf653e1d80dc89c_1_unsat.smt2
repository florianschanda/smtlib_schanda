; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01100011 #b0000000111)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b11011110 #b0111110100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000010 #b1111101000)
                arg2
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b10110110 #b0101110010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010001 #b1001001101)
                expect
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                expect
                (fp #b0 #b11010011 #b0000100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
