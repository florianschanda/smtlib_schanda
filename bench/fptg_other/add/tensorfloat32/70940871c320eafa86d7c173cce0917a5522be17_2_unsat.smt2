; Format: TENSORFLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001011 #b0110100011)
                arg1
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg1
                (fp #b0 #b10110000 #b1111011110)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100101 #b0110011100)
                arg2
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                arg2
                (fp #b1 #b01001111 #b1001111001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001100 #b0011010010)
                expect
                (fp #b1 #b01111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0000100111)
                expect
                (fp #b1 #b01001010 #b0111000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
