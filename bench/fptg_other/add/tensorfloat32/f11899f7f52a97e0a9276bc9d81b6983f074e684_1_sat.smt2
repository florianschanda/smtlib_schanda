(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111101 #b1010000110)
                expect
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                expect
                (fp #b0 #b00010100 #b0110011111)))

(assert (= expect result))

(check-sat)
(exit)
