(assert (fp.leq (fp #b1 #b00000001 #b0000000000)
                arg2
                (fp #b0 #b11100100 #b0000000101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00110010 #b1101011001)
                expect
                (fp #b0 #b11100011 #b1000010101)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010101)
                expect
                (fp #b0 #b11101100 #b0001110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
