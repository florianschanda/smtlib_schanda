(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111001 #b0001011110)
                expect
                (fp #b0 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000000)
                expect
                (fp #b0 #b11011101 #b0000111100)))

(assert (= expect result))

(check-sat)
(exit)
