(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b1110001000)
                arg1
                (fp #b1 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000000)
                arg1
                (fp #b0 #b01010011 #b0011101101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01011110 #b1110100111)
                arg2
                (fp #b0 #b00010010 #b1011100000)))
(assert (fp.leq (fp #b0 #b00010010 #b1011100000)
                arg2
                (fp #b0 #b00101100 #b1101001110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010100 #b1000001111)
                expect
                (fp #b0 #b00010010 #b1011011111)))
(assert (fp.leq (fp #b0 #b00010010 #b1011011111)
                expect
                (fp #b0 #b10000110 #b1111100010)))

(assert (= expect result))

(check-sat)
(exit)
