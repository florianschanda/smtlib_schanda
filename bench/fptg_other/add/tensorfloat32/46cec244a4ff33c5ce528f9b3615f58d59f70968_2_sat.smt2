(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010101 #b0100000111)
                arg1
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg1
                (fp #b0 #b00011010 #b0101010011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000101 #b1011111001)
                arg2
                (fp #b0 #b00000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000 #b0001110101)
                arg2
                (fp #b0 #b10010101 #b1010011001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100110 #b1101011001)
                expect
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                expect
                (fp #b0 #b10011000 #b0111111100)))

(assert (= expect result))

(check-sat)
(exit)
