                arg2
                (fp #b0 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11100011 #b1010010110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000011 #b0001010000)
                expect
                (fp #b0 #b11000101 #b0000100010)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                expect
                (fp #b0 #b11001010 #b0110101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
