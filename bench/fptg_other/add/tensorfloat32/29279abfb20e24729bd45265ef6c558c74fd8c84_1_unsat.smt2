; Format: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b0010001111)
                arg1
                (fp #b1 #b00000000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000000 #b1010010101)
                arg1
                (fp #b0 #b11100111 #b0100101111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001100 #b1111111100)
                arg2
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b00000001 #b0011001111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110110 #b1001001100)
                expect
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                expect
                (fp #b0 #b01100010 #b0000100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
