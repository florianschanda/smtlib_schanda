(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b0100000101)
                arg1
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                arg1
                (fp #b0 #b01111001 #b1000111111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000001 #b0110111110)
                arg2
                (fp #b0 #b00000100 #b0101100010)))
(assert (fp.leq (fp #b0 #b00000100 #b0101100010)
                arg2
                (fp #b0 #b10011001 #b1001100011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1001111111)
                expect
                (fp #b1 #b11111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111100 #b1111111111)
                expect
                (fp #b0 #b11101011 #b0101101110)))

(assert (= expect result))

(check-sat)
(exit)
