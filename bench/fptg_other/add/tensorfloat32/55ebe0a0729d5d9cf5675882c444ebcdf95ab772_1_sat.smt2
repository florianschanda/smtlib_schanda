; Format: TENSORFLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010110 #b1111101011)
                arg1
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b00101111 #b1001011000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b10000111 #b0111111101)
                arg2
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg2
                (fp #b0 #b11011111 #b1000001010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111000 #b0001100010)
                expect
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                expect
                (fp #b0 #b11111011 #b1000000100)))

(assert (= expect result))

(check-sat)
(exit)
