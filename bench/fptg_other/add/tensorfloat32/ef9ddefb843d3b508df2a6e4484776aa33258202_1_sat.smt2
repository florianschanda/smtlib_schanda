                arg2
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b01111111 #b0010110001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010000 #b0010110111)
                expect
                (fp #b1 #b00000001 #b1111111110)))
(assert (fp.leq (fp #b1 #b00000001 #b1111111110)
                expect
                (fp #b0 #b10100101 #b1010010111)))

(assert (= expect result))

(check-sat)
(exit)
