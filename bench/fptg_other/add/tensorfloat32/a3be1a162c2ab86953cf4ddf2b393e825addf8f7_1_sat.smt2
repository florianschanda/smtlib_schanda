; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110001 #b1001000110)
                arg1
                (fp #b0 #b11100011 #b1000010110)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010110)
                arg1
                (fp #b0 #b11110100 #b0110001100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11110110 #b1010111000)
                arg2
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg2
                (fp #b0 #b01011001 #b1010000011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10110111 #b0010000000)
                expect
                (fp #b0 #b11100011 #b1000010110)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010110)
                expect
                (fp #b0 #b11110110 #b0110111011)))

(assert (= expect result))

(check-sat)
(exit)
