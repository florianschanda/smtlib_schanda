;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01000011 #b0110111100)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b11111010 #b0101100100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b1010010011)
                arg2
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b1 #b01011010 #b1101110000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101110 #b1010001011)
                expect
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                expect
                (fp #b1 #b10001101 #b0100110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
