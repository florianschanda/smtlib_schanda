; Format: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100110 #b1101111001)
                arg1
                (fp #b1 #b00000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000 #b1110100001)
                arg1
                (fp #b0 #b11001110 #b1010100000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111011 #b1001111001)
                arg2
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b0 #b10111001 #b0011000110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111100 #b1101100100)
                expect
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                expect
                (fp #b1 #b00111100 #b1111111110)))

(assert (= expect result))

(check-sat)
(exit)
