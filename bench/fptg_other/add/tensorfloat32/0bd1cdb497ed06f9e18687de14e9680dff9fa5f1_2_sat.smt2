                arg2
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b11101011 #b1000111000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01010011 #b0000001001)
                expect
                (fp #b0 #b10001001 #b1101010001)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010001)
                expect
                (fp #b0 #b11101100 #b1000010011)))

(assert (= expect result))

(check-sat)
(exit)
