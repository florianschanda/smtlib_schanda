; Format: TENSORFLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b1111100111)
                arg1
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg1
                (fp #b0 #b11110111 #b0100000101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1000101000)
                arg2
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                arg2
                (fp #b1 #b01000011 #b0100101101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b0001000000)
                expect
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                expect
                (fp #b0 #b00111011 #b1100110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
