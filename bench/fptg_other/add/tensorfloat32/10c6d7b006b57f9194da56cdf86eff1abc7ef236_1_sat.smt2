; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110010 #b0111011011)
                arg1
                (fp #b0 #b01111111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101111011)
                arg1
                (fp #b0 #b10001101 #b0001011111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111101 #b1111010000)
                arg2
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                arg2
                (fp #b0 #b00000010 #b1001101111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010101 #b0010110110)
                expect
                (fp #b0 #b01111111 #b0101111010)))
(assert (fp.leq (fp #b0 #b01111111 #b0101111010)
                expect
                (fp #b0 #b10011001 #b0101000101)))

(assert (= expect result))

(check-sat)
(exit)
