(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1011001101)
                arg1
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                arg1
                (fp #b1 #b01011011 #b0101111001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100000 #b0101101010)
                arg2
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b00000100 #b0110110111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0111011000)
                expect
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                expect
                (fp #b0 #b11100011 #b0101111101)))

(assert (= expect result))

(check-sat)
(exit)
