;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b0110111101)
                arg1
                (fp #b0 #b10100111 #b1001010010)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010010)
                arg1
                (fp #b0 #b11111010 #b1100011010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001100 #b1011011010)
                arg2
                (fp #b1 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000000)
                arg2
                (fp #b0 #b01111001 #b0100101011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01111110 #b0100011001)
                expect
                (fp #b0 #b10100111 #b1001010010)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010010)
                expect
                (fp #b0 #b11011111 #b1001100001)))

(assert (= expect result))

(check-sat)
(exit)
