; Format: TENSORFLOAT32
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011011 #b0111110011)
                arg1
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                arg1
                (fp #b0 #b11111111 #b0000000000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010101 #b0001010111)
                arg2
                (fp #b1 #b00000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000 #b0101011111)
                arg2
                (fp #b0 #b00100101 #b1001001011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10000110 #b1111100001)
                expect
                (fp #b0 #b11111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111)
                expect
                (fp #b0 #b11111111 #b0000000000)))

(assert (= expect result))

(check-sat)
(exit)
