(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11101011 #b0001010010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10110000 #b1011010101)
                expect
                (fp #b0 #b11000101 #b1000010100)))
(assert (fp.leq (fp #b0 #b11000101 #b1000010100)
                expect
                (fp #b0 #b11101111 #b1010101110)))

(assert (= expect result))

(check-sat)
