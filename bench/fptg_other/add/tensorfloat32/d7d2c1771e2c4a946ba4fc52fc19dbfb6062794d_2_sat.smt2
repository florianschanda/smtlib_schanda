(assert (fp.leq (fp #b1 #b10001001 #b1011001101)
                arg2
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b10011000 #b0010011011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010100 #b0110010101)
                expect
                (fp #b0 #b10001001 #b1101010001)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010001)
                expect
                (fp #b0 #b11111110 #b0110010100)))

(assert (= expect result))

(check-sat)
(exit)
