;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001100 #b0010011011)
                arg1
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                arg1
                (fp #b0 #b11011100 #b1011111111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111111 #b0000101000)
                arg2
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b00111110 #b1111100111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111101 #b1100000001)
                expect
                (fp #b0 #b10111110 #b1111111110)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111110)
                expect
                (fp #b0 #b11101000 #b0011110111)))

(assert (= expect result))

(check-sat)
(exit)
