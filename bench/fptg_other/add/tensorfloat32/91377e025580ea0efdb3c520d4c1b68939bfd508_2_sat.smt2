                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b10111101 #b0101101011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101010 #b0100011101)
                expect
                (fp #b1 #b11100110 #b1110111100)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111100)
                expect
                (fp #b1 #b10110011 #b0110001110)))

(assert (= expect result))

(check-sat)
(exit)
