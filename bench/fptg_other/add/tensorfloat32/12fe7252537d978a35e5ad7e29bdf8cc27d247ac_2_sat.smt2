; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010000 #b1011110001)
                arg1
                (fp #b0 #b00101101 #b1010110100)))
(assert (fp.leq (fp #b0 #b00101101 #b1010110100)
                arg1
                (fp #b0 #b10111100 #b1000000010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001010 #b0100100001)
                arg2
                (fp #b0 #b11111100 #b0110111000)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111000)
                arg2
                (fp #b0 #b11111101 #b0100000001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000000 #b1011001110)
                expect
                (fp #b0 #b11111100 #b0110111001)))
(assert (fp.leq (fp #b0 #b11111100 #b0110111001)
                expect
                (fp #b0 #b11111101 #b0110110101)))

(assert (= expect result))

(check-sat)
(exit)
