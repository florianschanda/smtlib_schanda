; Format: TENSORFLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010001 #b1100000101)
                arg1
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg1
                (fp #b0 #b10111001 #b1010110001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100001 #b1111001111)
                arg2
                (fp #b0 #b00010010 #b1011100000)))
(assert (fp.leq (fp #b0 #b00010010 #b1011100000)
                arg2
                (fp #b0 #b10111110 #b0100110011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101111 #b0110001111)
                expect
                (fp #b0 #b00010010 #b1011100001)))
(assert (fp.leq (fp #b0 #b00010010 #b1011100001)
                expect
                (fp #b0 #b10100100 #b1000000000)))

(assert (= expect result))

(check-sat)
(exit)
