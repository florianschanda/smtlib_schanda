(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b1101101100)
                arg1
                (fp #b0 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000)
                arg1
                (fp #b0 #b11111110 #b1100001000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110000 #b0111010011)
                arg2
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                arg2
                (fp #b0 #b00001110 #b0001011110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00111010 #b1101100011)
                expect
                (fp #b0 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000)
                expect
                (fp #b0 #b11111110 #b1010001011)))

(assert (= expect result))

(check-sat)
(exit)
