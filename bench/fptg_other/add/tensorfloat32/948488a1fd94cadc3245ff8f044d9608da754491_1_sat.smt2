; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100001 #b1111000111)
                arg1
                (fp #b0 #b00000000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000000 #b0001001100)
                arg1
                (fp #b0 #b11010010 #b1101011000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101110 #b1011111000)
                arg2
                (fp #b0 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111011 #b0000000000)
                arg2
                (fp #b0 #b10110110 #b0001101001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010001 #b0111100001)
                expect
                (fp #b0 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111011 #b0000000000)
                expect
                (fp #b0 #b11011100 #b0111110110)))

(assert (= expect result))

(check-sat)
(exit)
