(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b1001110011)
                arg1
                (fp #b1 #b11100110 #b0100111100)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111100)
                arg1
                (fp #b0 #b01011101 #b0010111100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01011110 #b0100111101)
                arg2
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b11110101 #b1111110010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b1100001001)
                expect
                (fp #b1 #b11100110 #b0100111100)))
(assert (fp.leq (fp #b1 #b11100110 #b0100111100)
                expect
                (fp #b1 #b01010010 #b1001100100)))

(assert (= expect result))

(check-sat)
(exit)
