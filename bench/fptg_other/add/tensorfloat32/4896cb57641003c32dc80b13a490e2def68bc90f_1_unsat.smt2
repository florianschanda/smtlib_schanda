(assert (fp.leq (fp #b1 #b11010001 #b0011000110)
                arg2
                (fp #b0 #b00000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000 #b0001110101)
                arg2
                (fp #b0 #b01011001 #b0000111111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101110 #b0000000111)
                expect
                (fp #b0 #b01111111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101111011)
                expect
                (fp #b0 #b10001011 #b1000001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
