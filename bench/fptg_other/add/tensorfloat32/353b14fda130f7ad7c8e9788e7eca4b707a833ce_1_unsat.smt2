; Format: TENSORFLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b1101000110)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b10101100 #b1011111111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00100001 #b1000100010)
                arg2
                (fp #b0 #b00000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000 #b0001110101)
                arg2
                (fp #b0 #b10010001 #b1111010110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001110 #b1100011100)
                expect
                (fp #b1 #b10001001 #b1111111111)))
(assert (fp.leq (fp #b1 #b10001001 #b1111111111)
                expect
                (fp #b1 #b01111110 #b1110011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
