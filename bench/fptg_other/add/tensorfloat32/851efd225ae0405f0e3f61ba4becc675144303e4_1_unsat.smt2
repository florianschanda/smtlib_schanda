; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00001011 #b0111100101)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b00110000 #b1111000111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101011 #b0010111110)
                arg2
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                arg2
                (fp #b0 #b10100010 #b0111101101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010101 #b0000000000)
                expect
                (fp #b1 #b00010010 #b0011010010)))
(assert (fp.leq (fp #b1 #b00010010 #b0011010010)
                expect
                (fp #b0 #b01110101 #b1101111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
