(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011101 #b0000000100)
                arg1
                (fp #b0 #b00101101 #b1010110100)))
(assert (fp.leq (fp #b0 #b00101101 #b1010110100)
                arg1
                (fp #b0 #b10100111 #b0111111101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110010 #b0101011101)
                arg2
                (fp #b1 #b11010010 #b0101100110)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100110)
                arg2
                (fp #b0 #b10000011 #b1101000101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b0101101110)
                expect
                (fp #b1 #b11010010 #b0101100101)))
(assert (fp.leq (fp #b1 #b11010010 #b0101100101)
                expect
                (fp #b1 #b01111010 #b1011010011)))

(assert (= expect result))

(check-sat)
(exit)
