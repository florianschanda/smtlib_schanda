(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b0110111010)
                arg1
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b11000101 #b1011010000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01010011 #b0111100000)
                arg2
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg2
                (fp #b0 #b10000011 #b0100000100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010010 #b0010000100)
                expect
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                expect
                (fp #b0 #b11010001 #b1111011011)))

(assert (= expect result))

(check-sat)
(exit)
