                arg2
                (fp #b1 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b10001011 #b1000001100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110100 #b0011100011)
                expect
                (fp #b1 #b01000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b01000000 #b0000000001)
                expect
                (fp #b0 #b11110011 #b0011101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
