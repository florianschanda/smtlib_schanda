                arg2
                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b00010111 #b1010110101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010000 #b1100010011)
                expect
                (fp #b0 #b11000011 #b1111001001)))
(assert (fp.leq (fp #b0 #b11000011 #b1111001001)
                expect
                (fp #b0 #b11010100 #b1010001001)))

(assert (= expect result))

(check-sat)
(exit)
