(assert (fp.leq (fp #b0 #b11000101 #b0000100010)
                arg2
                (fp #b0 #b11010100 #b1010011111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10001011 #b0110100100)
                expect
                (fp #b0 #b11000101 #b0000100011)))
(assert (fp.leq (fp #b0 #b11000101 #b0000100011)
                expect
                (fp #b0 #b11110010 #b1110000110)))

(assert (= expect result))

(check-sat)
(exit)
