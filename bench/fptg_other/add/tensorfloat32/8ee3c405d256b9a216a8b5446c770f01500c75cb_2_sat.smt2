(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001100 #b1001111011)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b10101010 #b1001111011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000001 #b1101000101)
                arg2
                (fp #b0 #b01111111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111111 #b0100011010)
                arg2
                (fp #b0 #b11101001 #b1001011111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001110 #b0111111101)
                expect
                (fp #b1 #b10001001 #b1111111111)))
(assert (fp.leq (fp #b1 #b10001001 #b1111111111)
                expect
                (fp #b1 #b00001111 #b0011101001)))

(assert (= expect result))

(check-sat)
(exit)
