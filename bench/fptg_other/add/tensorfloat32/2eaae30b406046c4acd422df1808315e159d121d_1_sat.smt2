(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110100 #b0000111110)
                expect
                (fp #b0 #b00000000 #b1100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b1100000000)
                expect
                (fp #b0 #b01011100 #b1111111001)))

(assert (= expect result))

(check-sat)
