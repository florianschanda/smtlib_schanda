                arg2
                (fp #b0 #b10100101 #b0001111000)))
(assert (fp.leq (fp #b0 #b10100101 #b0001111000)
                arg2
                (fp #b0 #b10101010 #b1010101011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000111 #b1000101110)
                expect
                (fp #b0 #b10100101 #b0001110111)))
(assert (fp.leq (fp #b0 #b10100101 #b0001110111)
                expect
                (fp #b0 #b11001110 #b1011110110)))

(assert (= expect result))

(check-sat)
(exit)
