(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110011 #b0011011101)
                expect
                (fp #b0 #b00000000 #b0100010010)))
(assert (fp.leq (fp #b0 #b00000000 #b0100010010)
                expect
                (fp #b0 #b11001001 #b1000111010)))

(assert (= expect result))

(check-sat)
