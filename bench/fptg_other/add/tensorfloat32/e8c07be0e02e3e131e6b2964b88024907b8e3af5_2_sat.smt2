;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111000 #b1100000101)
                arg1
                (fp #b1 #b11100110 #b1110111011)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111011)
                arg1
                (fp #b0 #b00110100 #b0010000010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001101 #b1011000111)
                arg2
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b1 #b00011011 #b0100000001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110010 #b1010110000)
                expect
                (fp #b1 #b11100110 #b1110111100)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111100)
                expect
                (fp #b0 #b10001001 #b1101110110)))

(assert (= expect result))

(check-sat)
(exit)
