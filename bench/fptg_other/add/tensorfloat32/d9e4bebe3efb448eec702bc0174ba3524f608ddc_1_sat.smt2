; Format: TENSORFLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011110 #b1000100101)
                arg1
                (fp #b1 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b00000000 #b0011010001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010111 #b1101101010)
                arg2
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                arg2
                (fp #b0 #b00100111 #b0101110001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010000 #b1000010010)
                expect
                (fp #b1 #b00000000 #b1111111110)))
(assert (fp.leq (fp #b1 #b00000000 #b1111111110)
                expect
                (fp #b0 #b01100100 #b1000101101)))

(assert (= expect result))

(check-sat)
(exit)
