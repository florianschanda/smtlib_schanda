(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011111 #b0000101111)
                expect
                (fp #b1 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b0000000000)
                expect
                (fp #b0 #b10101101 #b0010100100)))

(assert (not (= expect result)))

(check-sat)
