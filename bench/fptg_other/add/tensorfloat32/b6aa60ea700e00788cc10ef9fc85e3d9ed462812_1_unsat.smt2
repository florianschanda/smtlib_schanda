(assert (fp.leq (fp #b1 #b00000111 #b1111001100)
                arg2
                (fp #b0 #b01111111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111111 #b0100011010)
                arg2
                (fp #b0 #b11010001 #b1111111100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110111 #b0100111110)
                expect
                (fp #b0 #b01111111 #b0100011001)))
(assert (fp.leq (fp #b0 #b01111111 #b0100011001)
                expect
                (fp #b0 #b11111110 #b0101000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
