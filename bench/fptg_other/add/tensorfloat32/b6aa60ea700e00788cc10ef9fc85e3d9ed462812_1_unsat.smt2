;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010000 #b0101000010)
                arg1
                (fp #b1 #b00011010 #b1100101000)))
(assert (fp.leq (fp #b1 #b00011010 #b1100101000)
                arg1
                (fp #b0 #b11001100 #b0001111101)))

