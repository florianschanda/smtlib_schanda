; Format: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011111 #b1101001111)
                arg1
                (fp #b0 #b11100011 #b1000010110)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010110)
                arg1
                (fp #b0 #b11111100 #b1000100001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001011 #b0011010011)
                arg2
                (fp #b1 #b10001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10001000 #b0100001100)
                arg2
                (fp #b1 #b01000110 #b1111111100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001010 #b0011100010)
                expect
                (fp #b0 #b11100011 #b1000010110)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010110)
                expect
                (fp #b0 #b11101101 #b0010001101)))

(assert (= expect result))

(check-sat)
(exit)
