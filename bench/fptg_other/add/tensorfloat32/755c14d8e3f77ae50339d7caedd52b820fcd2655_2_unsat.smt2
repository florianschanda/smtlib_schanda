(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001111 #b0101110010)
                arg1
                (fp #b1 #b00000000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000000 #b1010010101)
                arg1
                (fp #b0 #b10100110 #b0111100110)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011000 #b0001110101)
                arg2
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                arg2
                (fp #b0 #b11001111 #b1110011010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000011 #b0000010101)
                expect
                (fp #b0 #b10001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10001001 #b0100111000)
                expect
                (fp #b0 #b11010011 #b0100011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
