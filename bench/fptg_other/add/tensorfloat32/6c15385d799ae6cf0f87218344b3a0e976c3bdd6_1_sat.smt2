; Format: TENSORFLOAT32
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010111 #b1010011000)
                arg1
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg1
                (fp #b0 #b10111010 #b1010000011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100011 #b0111100010)
                arg2
                (fp #b1 #b01111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111110)
                arg2
                (fp #b0 #b10101111 #b1110001000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b1111110111)
                expect
                (fp #b1 #b01111111 #b0011111101)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111101)
                expect
                (fp #b1 #b00011000 #b0001010110)))

(assert (= expect result))

(check-sat)
(exit)
