(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101101 #b0000000011)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b1 #b00100000 #b1110111111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00111101 #b1010110110)
                arg2
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b01100100 #b0000101110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011110 #b0100100000)
                expect
                (fp #b1 #b10001001 #b1111111111)))
(assert (fp.leq (fp #b1 #b10001001 #b1111111111)
                expect
                (fp #b0 #b01110011 #b0011001001)))

(assert (= expect result))

(check-sat)
(exit)
