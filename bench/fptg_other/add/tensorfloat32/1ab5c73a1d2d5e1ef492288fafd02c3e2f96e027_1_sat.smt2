                arg2
                (fp #b0 #b01010101 #b1001000001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110111 #b1111001100)
                expect
                (fp #b1 #b01111111 #b0011111101)))
(assert (fp.leq (fp #b1 #b01111111 #b0011111101)
                expect
                (fp #b1 #b01100100 #b1001011010)))

(assert (= expect result))

(check-sat)
