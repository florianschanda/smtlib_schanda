                arg2
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b01110111 #b1111011100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010011 #b1101010011)
                expect
                (fp #b1 #b10111110 #b1111111110)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111110)
                expect
                (fp #b0 #b11001000 #b1000010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
