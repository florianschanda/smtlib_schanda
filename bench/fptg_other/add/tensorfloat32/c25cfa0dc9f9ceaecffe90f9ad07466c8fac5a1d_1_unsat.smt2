                arg2
                (fp #b1 #b01100100 #b1010100011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110010 #b1111011010)
                expect
                (fp #b1 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                expect
                (fp #b1 #b10111011 #b0000000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
