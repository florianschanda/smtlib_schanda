(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b1101101000)
                arg1
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                arg1
                (fp #b1 #b11010011 #b0110001011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101100 #b1001000000)
                arg2
                (fp #b1 #b00111100 #b1100110010)))
(assert (fp.leq (fp #b1 #b00111100 #b1100110010)
                arg2
                (fp #b0 #b11110011 #b1001011000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0111001010)
                expect
                (fp #b1 #b11111101 #b0000000001)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000001)
                expect
                (fp #b1 #b10011001 #b1111101111)))

(assert (= expect result))

(check-sat)
(exit)
