;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b11010110 #b0010110001)
                arg1
                (fp #b0 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000)
                arg1
                (fp #b0 #b11111101 #b1100110011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100111 #b1011100101)
                arg2
                (fp #b0 #b00010010 #b1011100000)))
(assert (fp.leq (fp #b0 #b00010010 #b1011100000)
                arg2
                (fp #b0 #b11111000 #b0110010001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010000 #b0110010010)
                expect
                (fp #b0 #b11111101 #b0000000001)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000001)
                expect
                (fp #b0 #b11111110 #b1110011001)))

(assert (= expect result))

(check-sat)
(exit)
