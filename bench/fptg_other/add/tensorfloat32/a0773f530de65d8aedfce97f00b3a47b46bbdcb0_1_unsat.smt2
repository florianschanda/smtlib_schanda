(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                arg2
                (fp #b0 #b11010000 #b1100101010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010000 #b1000110010)
                expect
                (fp #b0 #b10001001 #b1010000110)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000110)
                expect
                (fp #b0 #b11111110 #b0001100100)))

(assert (not (= expect result)))

(check-sat)
