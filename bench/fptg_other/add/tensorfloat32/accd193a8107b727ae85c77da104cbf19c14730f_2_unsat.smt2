(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001000 #b1100100011)
                arg1
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                arg1
                (fp #b0 #b10001101 #b0111001001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110101 #b1010011110)
                arg2
                (fp #b1 #b11110100 #b1110010100)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010100)
                arg2
                (fp #b0 #b01111100 #b1011011000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111001 #b1111011010)
                expect
                (fp #b1 #b11110100 #b1110010101)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010101)
                expect
                (fp #b0 #b01001111 #b0011010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
