(assert (fp.leq (fp #b0 #b01111111 #b0100011010)
                arg2
                (fp #b0 #b10011110 #b1110001100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110101 #b1111001110)
                expect
                (fp #b0 #b01111111 #b0100011011)))
(assert (fp.leq (fp #b0 #b01111111 #b0100011011)
                expect
                (fp #b0 #b11001100 #b0100110110)))

(assert (= expect result))

(check-sat)
