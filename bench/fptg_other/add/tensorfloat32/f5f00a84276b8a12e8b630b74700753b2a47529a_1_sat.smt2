(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001110 #b1100001000)
                arg1
                (fp #b1 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000000)
                arg1
                (fp #b0 #b10111001 #b1011100010)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00110000 #b0100111111)
                arg2
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg2
                (fp #b0 #b00000111 #b0100000111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101010 #b0110101000)
                expect
                (fp #b1 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0100000000)
                expect
                (fp #b0 #b10010100 #b0000000011)))

(assert (= expect result))

(check-sat)
(exit)
