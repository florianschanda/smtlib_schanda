; Format: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110111 #b1010001011)
                arg1
                (fp #b1 #b00011010 #b1100101000)))
(assert (fp.leq (fp #b1 #b00011010 #b1100101000)
                arg1
                (fp #b0 #b10011101 #b1100110100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100100 #b0101010000)
                arg2
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b10001110 #b0001010110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111101 #b0111101000)
                expect
                (fp #b1 #b00011010 #b1100101000)))
(assert (fp.leq (fp #b1 #b00011010 #b1100101000)
                expect
                (fp #b0 #b11110101 #b1100111011)))

(assert (= expect result))

(check-sat)
(exit)
