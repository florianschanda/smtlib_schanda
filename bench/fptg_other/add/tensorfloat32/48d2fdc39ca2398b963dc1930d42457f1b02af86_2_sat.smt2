; Format: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010111 #b0100110011)
                arg1
                (fp #b0 #b00000000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000000 #b0001001100)
                arg1
                (fp #b0 #b10101101 #b1110000000)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01011111 #b1000001011)
                arg2
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg2
                (fp #b0 #b11011011 #b1010101101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00011101 #b0111110001)
                expect
                (fp #b0 #b10001010 #b0000000001)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000001)
                expect
                (fp #b0 #b10001010 #b1001001101)))

(assert (= expect result))

(check-sat)
(exit)
