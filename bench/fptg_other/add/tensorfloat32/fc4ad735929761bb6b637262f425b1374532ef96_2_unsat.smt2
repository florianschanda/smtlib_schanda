(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111100 #b1111011101)
                arg1
                (fp #b0 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b0000000000)
                arg1
                (fp #b0 #b10100001 #b1011110111)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10010000 #b0000010001)
                arg2
                (fp #b0 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000)
                arg2
                (fp #b0 #b11111101 #b0110111011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101011 #b0110011001)
                expect
                (fp #b0 #b11111101 #b0000000001)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000001)
                expect
                (fp #b0 #b11111101 #b0110101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
