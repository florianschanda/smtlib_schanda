(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: TENSORFLOAT32
; Arg1: -ZERO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01000011 #b0111001001)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b01100111 #b0111111011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110110 #b1010100001)
                arg2
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b00101011 #b0011101000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110111 #b1010000001)
                expect
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                expect
                (fp #b0 #b10101110 #b0111010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
