(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001111 #b1110101110)
                arg1
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                arg1
                (fp #b1 #b00100011 #b0111000100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110100 #b1110111111)
                arg2
                (fp #b0 #b00000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b10010111 #b0011000110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110001 #b0100001100)
                expect
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                expect
                (fp #b0 #b10001010 #b0001101000)))

(assert (= expect result))

(check-sat)
(exit)
