(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000100 #b1101111110)
                arg1
                (fp #b0 #b11000011 #b1111001010)))
(assert (fp.leq (fp #b0 #b11000011 #b1111001010)
                arg1
                (fp #b0 #b11100111 #b0000010011)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10111010 #b1100101000)
                arg2
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b11001011 #b0011100001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10010100 #b1001000001)
                expect
                (fp #b0 #b11000100 #b0000000100)))
(assert (fp.leq (fp #b0 #b11000100 #b0000000100)
                expect
                (fp #b0 #b11010111 #b0100011000)))

(assert (= expect result))

(check-sat)
(exit)
