; Format: TENSORFLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b0111100110)
                arg1
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b01101100 #b0011111101)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111011 #b0111110000)
                arg2
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                arg2
                (fp #b1 #b00110101 #b1101010000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010100 #b1011000011)
                expect
                (fp #b1 #b00111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111011 #b0000000000)
                expect
                (fp #b0 #b10101011 #b1000111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
