(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0010111011)
                expect
                (fp #b1 #b11110100 #b1110010101)))
(assert (fp.leq (fp #b1 #b11110100 #b1110010101)
                expect
                (fp #b0 #b10111101 #b0000100111)))

(assert (= expect result))

(check-sat)
(exit)
