(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: TENSORFLOAT32
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110111 #b0110111011)
                arg1
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg1
                (fp #b0 #b01000110 #b0010000100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101001 #b1010011100)
                arg2
                (fp #b0 #b10111011 #b1010010010)))
(assert (fp.leq (fp #b0 #b10111011 #b1010010010)
                arg2
                (fp #b0 #b11010011 #b1111111011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100001 #b1001001111)
                expect
                (fp #b0 #b10111011 #b1010010010)))
(assert (fp.leq (fp #b0 #b10111011 #b1010010010)
                expect
                (fp #b0 #b11110100 #b1100110011)))

(assert (= expect result))

(check-sat)
(exit)
