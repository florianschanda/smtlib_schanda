(assert (fp.leq (fp #b1 #b11010110 #b0001001001)
                arg2
                (fp #b0 #b10001100 #b0100100001)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011000 #b0110000100)
                expect
                (fp #b1 #b11010110 #b0001001000)))
(assert (fp.leq (fp #b1 #b11010110 #b0001001000)
                expect
                (fp #b0 #b11000101 #b0100110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
