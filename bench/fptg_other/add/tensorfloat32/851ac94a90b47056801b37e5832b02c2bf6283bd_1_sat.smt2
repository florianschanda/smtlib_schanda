                (fp #b1 #b00000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1000101100)
                arg2
                (fp #b0 #b10010011 #b1110101101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010011 #b0111001110)
                expect
                (fp #b1 #b00000001 #b1000101011)))
(assert (fp.leq (fp #b1 #b00000001 #b1000101011)
                expect
                (fp #b0 #b00100110 #b1001100011)))

(assert (= expect result))

(check-sat)
(exit)
