                (fp #b1 #b10000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000111 #b0011100100)
                arg2
                (fp #b1 #b00011010 #b0000011011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101000 #b0101001000)
                expect
                (fp #b1 #b10000111 #b0011101011)))
(assert (fp.leq (fp #b1 #b10000111 #b0011101011)
                expect
                (fp #b0 #b11101111 #b0100110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
