(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011110 #b0101101000)
                arg1
                (fp #b0 #b11100011 #b1000010110)))
