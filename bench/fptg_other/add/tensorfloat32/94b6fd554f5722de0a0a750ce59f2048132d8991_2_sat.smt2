(assert (fp.leq (fp #b1 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b10111111 #b0000101111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010000 #b1101010000)
                expect
                (fp #b1 #b10111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b0000000000)
                expect
                (fp #b0 #b01111010 #b1100110001)))

(assert (= expect result))

(check-sat)
(exit)
