(assert (fp.leq (fp #b0 #b00011111 #b1001100100)
                expect
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                expect
                (fp #b0 #b11000001 #b1100000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
