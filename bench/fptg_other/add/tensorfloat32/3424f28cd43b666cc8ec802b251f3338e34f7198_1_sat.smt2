; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010111 #b0100011101)
                arg1
                (fp #b0 #b00100111 #b1011110101)))
(assert (fp.leq (fp #b0 #b00100111 #b1011110101)
                arg1
                (fp #b0 #b10100110 #b1110111100)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00111100 #b1101100100)
                arg2
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg2
                (fp #b0 #b01010011 #b0100101010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000011 #b0011111111)
                expect
                (fp #b0 #b00100111 #b1011110101)))
(assert (fp.leq (fp #b0 #b00100111 #b1011110101)
                expect
                (fp #b0 #b10000000 #b1011100111)))

(assert (= expect result))

(check-sat)
(exit)
