                (fp #b0 #b00000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000 #b0001110101)
                arg2
                (fp #b0 #b11100111 #b0100101111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001000 #b1101100100)
                expect
                (fp #b0 #b10100111 #b1001010011)))
(assert (fp.leq (fp #b0 #b10100111 #b1001010011)
                expect
                (fp #b0 #b11000101 #b1101110101)))

(assert (= expect result))

(check-sat)
(exit)
