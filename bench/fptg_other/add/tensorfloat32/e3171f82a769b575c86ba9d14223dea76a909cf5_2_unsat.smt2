;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000110 #b1110011110)
                arg1
                (fp #b1 #b00000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000000000)
                arg1
                (fp #b0 #b01101110 #b0101111001)))

(declare-const arg2 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100011 #b1001000111)
                arg2
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                arg2
                (fp #b0 #b11011001 #b1011001101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110011 #b0010010011)
                expect
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                expect
                (fp #b0 #b11001011 #b1101011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
