                arg2
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg2
                (fp #b0 #b01010010 #b0011000100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10101110 #b0010111010)
                expect
                (fp #b0 #b11100011 #b1000010111)))
(assert (fp.leq (fp #b0 #b11100011 #b1000010111)
                expect
                (fp #b0 #b11101011 #b0101000000)))

(assert (= expect result))

(check-sat)
(exit)
