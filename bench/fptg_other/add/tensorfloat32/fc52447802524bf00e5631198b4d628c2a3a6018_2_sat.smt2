                arg2
                (fp #b0 #b01000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000000)
                arg2
                (fp #b0 #b10110111 #b1001111010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101010 #b0001011010)
                expect
                (fp #b1 #b11100110 #b1110111011)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111011)
                expect
                (fp #b0 #b01011100 #b1110100010)))

(assert (= expect result))

(check-sat)
(exit)
