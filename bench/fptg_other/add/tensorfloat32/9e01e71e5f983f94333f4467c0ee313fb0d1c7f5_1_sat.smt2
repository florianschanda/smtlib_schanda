(assert (fp.leq (fp #b0 #b00000000 #b1110100111)
                arg2
                (fp #b0 #b00011110 #b0100100100)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100001 #b1111011010)
                expect
                (fp #b1 #b01111111 #b1111110011)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110011)
                expect
                (fp #b0 #b10010011 #b1001001000)))

(assert (= expect result))

(check-sat)
