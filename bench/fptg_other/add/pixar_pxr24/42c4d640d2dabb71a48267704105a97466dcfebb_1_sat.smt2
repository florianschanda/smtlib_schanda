                arg2
                (fp #b1 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b111111111111111)
                arg2
                (fp #b0 #b01001000 #b001011011100111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000011 #b100011110111110)
                expect
                (fp #b0 #b00111000 #b011010100000100)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000100)
                expect
                (fp #b0 #b01110101 #b110000100010100)))

(assert (= expect result))

(check-sat)
(exit)
