;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000000 #b001000111100000)
                arg1
                (fp #b0 #b01000000 #b000000000000000)))
