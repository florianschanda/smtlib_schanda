(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                arg2
                (fp #b0 #b10011110 #b110111101001010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001110 #b001110110001111)
                expect
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                expect
                (fp #b0 #b01111111 #b101100100001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
