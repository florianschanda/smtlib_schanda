                arg2
                (fp #b0 #b11100100 #b110011101011101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01000111 #b111111101000100)
                expect
                (fp #b0 #b01100010 #b101101001011100)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011100)
                expect
                (fp #b0 #b10101000 #b011110111010011)))

(assert (= expect result))

(check-sat)
(exit)
