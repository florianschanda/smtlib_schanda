                arg2
                (fp #b1 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b000000000000000)
                arg2
                (fp #b0 #b01111110 #b010000101001000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001000 #b011011001111101)
                expect
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                expect
                (fp #b1 #b00001111 #b110011111111011)))

(assert (= expect result))

(check-sat)
(exit)
