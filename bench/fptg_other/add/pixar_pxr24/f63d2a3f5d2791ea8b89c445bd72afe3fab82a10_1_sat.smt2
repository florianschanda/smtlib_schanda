; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000010 #b111000010000110)
                arg1
                (fp #b0 #b11010001 #b100110011001001)))
(assert (fp.leq (fp #b0 #b11010001 #b100110011001001)
                arg1
                (fp #b0 #b11010101 #b000111100001100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110111 #b101101100010110)
                arg2
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b10101111 #b101001100010111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100111 #b010001101010100)
                expect
                (fp #b0 #b11010001 #b100110011001000)))
(assert (fp.leq (fp #b0 #b11010001 #b100110011001000)
                expect
                (fp #b0 #b11100011 #b001110100110111)))

(assert (= expect result))

(check-sat)
(exit)
