                arg2
                (fp #b0 #b10100010 #b001101111101010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011100 #b100001101100001)
                expect
                (fp #b1 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b000000000000000)
                expect
                (fp #b0 #b10011010 #b001000100101111)))

(assert (not (= expect result)))

(check-sat)
