;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01101001 #b001110000110100)
                arg1
                (fp #b0 #b01011100 #b011101001001101)))
(assert (fp.leq (fp #b0 #b01011100 #b011101001001101)
                arg1
                (fp #b0 #b11000000 #b110000100100001)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001110 #b001001000101000)
                arg2
                (fp #b0 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b010000000000000)
                arg2
                (fp #b0 #b01011111 #b110100110111100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000001 #b101000011111001)
                expect
                (fp #b0 #b01011100 #b011101001001101)))
(assert (fp.leq (fp #b0 #b01011100 #b011101001001101)
                expect
                (fp #b0 #b11100011 #b100010010111101)))

(assert (= expect result))

(check-sat)
(exit)
