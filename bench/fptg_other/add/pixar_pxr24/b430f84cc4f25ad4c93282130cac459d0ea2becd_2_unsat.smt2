;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010010 #b001010001110111)
                arg1
                (fp #b0 #b00000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b00000000 #b111110010011101)
                arg1
                (fp #b0 #b01011111 #b011111100011101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b011010110001111)
                arg2
                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b11011000 #b011101110111110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111101 #b100111111001000)
                expect
                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                expect
                (fp #b1 #b00000110 #b110000111100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
