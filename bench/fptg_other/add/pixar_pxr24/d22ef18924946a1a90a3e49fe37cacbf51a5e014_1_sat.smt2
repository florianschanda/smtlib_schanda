; Format: PIXAR_PXR24
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111111 #b110111010101101)
                arg1
                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg1
                (fp #b0 #b11001100 #b110110010100111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011001 #b111100000110110)
                arg2
                (fp #b0 #b00011100 #b101010110010010)))
(assert (fp.leq (fp #b0 #b00011100 #b101010110010010)
                arg2
                (fp #b0 #b01001111 #b100110101100010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011010 #b000111000101011)
                expect
                (fp #b0 #b00011100 #b101010110010010)))
(assert (fp.leq (fp #b0 #b00011100 #b101010110010010)
                expect
                (fp #b0 #b01001101 #b011010110101110)))

(assert (= expect result))

(check-sat)
(exit)
