(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101011 #b001111110110111)
                arg1
                (fp #b0 #b11100101 #b010000111011001)))
(assert (fp.leq (fp #b0 #b11100101 #b010000111011001)
                arg1
                (fp #b0 #b11111110 #b010011101111000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
