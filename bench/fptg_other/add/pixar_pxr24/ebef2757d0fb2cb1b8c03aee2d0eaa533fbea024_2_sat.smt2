;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010110 #b011101100011010)
                arg1
                (fp #b0 #b00000000 #b101011011111011)))
(assert (fp.leq (fp #b0 #b00000000 #b101011011111011)
                arg1
                (fp #b0 #b01000101 #b011100111010010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011110 #b010111110111011)
                arg2
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b10011110 #b000110001100100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110100 #b110101011100000)
                expect
                (fp #b1 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b00111000 #b011010100000101)
                expect
                (fp #b0 #b11111101 #b100111100100111)))

(assert (= expect result))

(check-sat)
(exit)
