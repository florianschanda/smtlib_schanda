; Format: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111000 #b100111110000101)
                arg1
                (fp #b1 #b10001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001010 #b001010101000000)
                arg1
                (fp #b0 #b00101100 #b010100100010100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101010 #b110001000011110)
                expect
                (fp #b1 #b10001011 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10001011 #b001010101000000)
                expect
                (fp #b0 #b11101110 #b101011001111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
