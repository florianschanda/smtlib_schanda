(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10101111 #b010101101001111)
                expect
                (fp #b0 #b11100101 #b010000100110100)))
(assert (fp.leq (fp #b0 #b11100101 #b010000100110100)
                expect
                (fp #b0 #b11101011 #b000011001001001)))

(assert (= expect result))

(check-sat)
