(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                arg2
                (fp #b1 #b00110111 #b111100000010010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b000001100100101)
                expect
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                expect
                (fp #b0 #b01110110 #b001010001101111)))

(assert (= expect result))

(check-sat)
(exit)
