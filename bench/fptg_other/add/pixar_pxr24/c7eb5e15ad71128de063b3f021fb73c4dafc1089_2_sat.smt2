(assert (fp.leq (fp #b1 #b01000000 #b101111110101110)
                arg2
                (fp #b0 #b00100011 #b110110111011101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010001 #b100101111101111)
                expect
                (fp #b1 #b01000000 #b101111110101110)))
(assert (fp.leq (fp #b1 #b01000000 #b101111110101110)
                expect
                (fp #b0 #b01111101 #b000011101011001)))

(assert (= expect result))

(check-sat)
(exit)
