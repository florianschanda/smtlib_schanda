(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b01111101 #b011011101101010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011000 #b100000001001100)
                expect
                (fp #b1 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b000000000000000)
                expect
                (fp #b0 #b11110011 #b000101110000011)))

(assert (= expect result))

(check-sat)
