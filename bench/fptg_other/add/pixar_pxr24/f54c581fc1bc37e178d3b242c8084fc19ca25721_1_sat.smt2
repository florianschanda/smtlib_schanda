                (fp #b0 #b01100010 #b101101001011100)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011100)
                arg2
                (fp #b0 #b10110000 #b001110010001110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111001 #b110111100110000)
                expect
                (fp #b0 #b01100010 #b101110101000101)))
(assert (fp.leq (fp #b0 #b01100010 #b101110101000101)
                expect
                (fp #b0 #b10000111 #b011000111110001)))

(assert (= expect result))

(check-sat)
(exit)
