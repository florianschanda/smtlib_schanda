                arg2
                (fp #b1 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b000000000000000)
                arg2
                (fp #b0 #b00000000 #b001110111100100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110110 #b000001001100011)
                expect
                (fp #b1 #b11010110 #b100101000001010)))
(assert (fp.leq (fp #b1 #b11010110 #b100101000001010)
                expect
                (fp #b1 #b10110001 #b001111110001100)))

(assert (= expect result))

(check-sat)
(exit)
