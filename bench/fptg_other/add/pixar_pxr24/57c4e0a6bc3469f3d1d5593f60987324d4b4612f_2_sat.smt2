; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001111 #b100111110101101)
                arg1
                (fp #b0 #b01011100 #b011101001001101)))
(assert (fp.leq (fp #b0 #b01011100 #b011101001001101)
                arg1
                (fp #b0 #b11100001 #b100101110011110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111010 #b011011110011111)
                arg2
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b01111001 #b011100001100010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000011 #b101011011101010)
                expect
                (fp #b0 #b01011100 #b011101001001101)))
(assert (fp.leq (fp #b0 #b01011100 #b011101001001101)
                expect
                (fp #b0 #b11101110 #b111101010100111)))

(assert (= expect result))

(check-sat)
(exit)
