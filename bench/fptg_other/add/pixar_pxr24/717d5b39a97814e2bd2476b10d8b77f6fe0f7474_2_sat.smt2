;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001101 #b111010001100101)
                arg1
                (fp #b0 #b10100010 #b010100010011111)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010011111)
                arg1
                (fp #b0 #b11100001 #b111001011111011)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01100100 #b011011111111000)
                arg2
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b10010110 #b101000100101000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101101 #b110011110011101)
                expect
                (fp #b0 #b10100010 #b010100010011111)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010011111)
                expect
                (fp #b0 #b11100011 #b010110001100100)))

(assert (= expect result))

(check-sat)
(exit)
