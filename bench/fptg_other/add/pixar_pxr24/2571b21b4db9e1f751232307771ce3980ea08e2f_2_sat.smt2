(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000101 #b110111010010011)
                arg1
                (fp #b1 #b10111110 #b001001101001111)))
(assert (fp.leq (fp #b1 #b10111110 #b001001101001111)
                arg1
                (fp #b0 #b11001110 #b101000011110010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00100010 #b101100001000000)
                arg2
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                arg2
                (fp #b0 #b11001100 #b111011000000010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011111 #b010001000110111)
                expect
                (fp #b1 #b10111110 #b001001101001010)))
(assert (fp.leq (fp #b1 #b10111110 #b001001101001010)
                expect
                (fp #b1 #b10010111 #b111100010111100)))

(assert (= expect result))

(check-sat)
(exit)
