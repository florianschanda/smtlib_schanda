                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b10001101 #b010011111010001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000010 #b101110110000001)
                expect
                (fp #b1 #b10111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b000000000000000)
                expect
                (fp #b0 #b10110101 #b110010111111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
