                arg2
                (fp #b0 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b111111111111111)
                arg2
                (fp #b0 #b11111111 #b000000000000000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01101111 #b010111100101110)
                expect
                (fp #b0 #b11111110 #b111111101001001)))
(assert (fp.leq (fp #b0 #b11111110 #b111111101001001)
                expect
                (fp #b0 #b11111110 #b111111111110011)))

(assert (= expect result))

(check-sat)
(exit)
