(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                arg2
                (fp #b0 #b00001101 #b110000100100110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101100 #b100011000010001)
                expect
                (fp #b1 #b00111000 #b011000001000011)))
(assert (fp.leq (fp #b1 #b00111000 #b011000001000011)
                expect
                (fp #b0 #b10110010 #b001100010110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
