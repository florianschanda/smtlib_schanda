; Format: PIXAR_PXR24
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000000 #b010101101101101)
                arg1
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                arg1
                (fp #b0 #b10010100 #b001110111010000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01000101 #b001110101011011)
                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b11001101 #b001001111011110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000011 #b000111110100110)
                expect
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                expect
                (fp #b0 #b11001000 #b111011010001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
