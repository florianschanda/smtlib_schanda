; Format: PIXAR_PXR24
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010000 #b100000111010100)
                arg1
                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg1
                (fp #b0 #b10110011 #b011111000110101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000011 #b100110001010010)
                arg2
                (fp #b1 #b10111010 #b111010111001000)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111001000)
                arg2
                (fp #b0 #b11010000 #b011111111110011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000001 #b100010011100100)
                expect
                (fp #b1 #b10111010 #b111010111001000)))
(assert (fp.leq (fp #b1 #b10111010 #b111010111001000)
                expect
                (fp #b0 #b00101010 #b100010011110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
