; Format: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10110000 #b011111001000100)
                arg1
                (fp #b0 #b11100101 #b010000111011001)))
(assert (fp.leq (fp #b0 #b11100101 #b010000111011001)
                arg1
                (fp #b0 #b11110111 #b001100100010011)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10110101 #b001000101100100)
                expect
                (fp #b0 #b11100110 #b010000111011001)))
(assert (fp.leq (fp #b0 #b11100110 #b010000111011001)
                expect
                (fp #b0 #b11110111 #b111011110000110)))

(assert (= expect result))

(check-sat)
(exit)
