(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000001 #b111011001011001)
                arg1
                (fp #b1 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b111111111111111)
                arg1
                (fp #b0 #b11110011 #b000000011010010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000000 #b011111001000010)
                arg2
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b11010100 #b011011001111111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110100 #b110111011101000)
                expect
                (fp #b0 #b00111000 #b011010100000100)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000100)
                expect
                (fp #b0 #b11110011 #b010010011001011)))

(assert (= expect result))

(check-sat)
(exit)
