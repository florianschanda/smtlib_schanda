; Format: PIXAR_PXR24
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111111 #b001010111101110)
                arg1
                (fp #b1 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b010000000000000)
                arg1
                (fp #b0 #b01100111 #b010000001010101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110111 #b111110101101111)
                arg2
                (fp #b1 #b10100010 #b011111011010000)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010000)
                arg2
                (fp #b1 #b01110011 #b011001010111011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010111 #b011101100011101)
                expect
                (fp #b1 #b10100010 #b011111011010001)))
(assert (fp.leq (fp #b1 #b10100010 #b011111011010001)
                expect
                (fp #b0 #b01110010 #b001011011101111)))

(assert (= expect result))

(check-sat)
(exit)
