(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000001 #b011111000010111)
                expect
                (fp #b0 #b10111110 #b111111111111110)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111110)
                expect
                (fp #b0 #b11111010 #b100011011111110)))

(assert (= expect result))

(check-sat)
