                arg2
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                arg2
                (fp #b0 #b10110100 #b011100010000001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000000 #b010111010100111)
                expect
                (fp #b1 #b10111110 #b001001101001111)))
(assert (fp.leq (fp #b1 #b10111110 #b001001101001111)
                expect
                (fp #b0 #b10101010 #b001111110101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
