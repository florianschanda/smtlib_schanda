                arg2
                (fp #b0 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b000000000000000)
                arg2
                (fp #b0 #b11010011 #b001010111100011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010011 #b010111110110110)
                expect
                (fp #b0 #b10001111 #b000000000000001)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000001)
                expect
                (fp #b0 #b11110000 #b101101011000110)))

(assert (= expect result))

(check-sat)
(exit)
