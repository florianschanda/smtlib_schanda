; Format: PIXAR_PXR24
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111100 #b101101100001001)
                arg1
                (fp #b1 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b010000000000000)
                arg1
                (fp #b0 #b00000110 #b011101110001110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00100110 #b111100000011110)
                arg2
                (fp #b0 #b01100010 #b101101001011100)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011100)
                arg2
                (fp #b0 #b01111111 #b010111001100111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10000101 #b011011101000001)
                expect
                (fp #b0 #b01100010 #b101101001011100)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011100)
                expect
                (fp #b0 #b11010111 #b010101000111000)))

(assert (= expect result))

(check-sat)
(exit)
