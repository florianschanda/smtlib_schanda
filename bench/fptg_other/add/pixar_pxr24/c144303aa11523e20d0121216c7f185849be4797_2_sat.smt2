(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101010 #b011101001110000)
                arg1
                (fp #b1 #b01111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111010)
                arg1
                (fp #b0 #b00000010 #b000111001011000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110010 #b100011000000100)
                arg2
                (fp #b0 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b010000000000000)
                arg2
                (fp #b0 #b10100110 #b110010101111001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010011 #b001010000111010)
                expect
                (fp #b1 #b01111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111010)
                expect
                (fp #b1 #b00000100 #b010111110110101)))

(assert (= expect result))

(check-sat)
(exit)
