                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b11010101 #b001011010001100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100001 #b111110110001010)
                expect
                (fp #b1 #b01011111 #b101001111011010)))
(assert (fp.leq (fp #b1 #b01011111 #b101001111011010)
                expect
                (fp #b0 #b01101010 #b000000011010111)))

(assert (= expect result))

(check-sat)
(exit)
