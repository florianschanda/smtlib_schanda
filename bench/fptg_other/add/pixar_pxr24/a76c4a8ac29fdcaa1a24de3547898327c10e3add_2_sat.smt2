; Format: PIXAR_PXR24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111111 #b011100010010111)
                arg1
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                arg1
                (fp #b1 #b01100111 #b001110000000101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001001 #b110011101010101)
                arg2
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b11111101 #b011000011101111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00100010 #b000110011011001)
                expect
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                expect
                (fp #b0 #b11111101 #b011011010000000)))

(assert (= expect result))

(check-sat)
(exit)
