; Format: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011000 #b011100011000101)
                arg1
                (fp #b1 #b10111110 #b001001101001111)))
(assert (fp.leq (fp #b1 #b10111110 #b001001101001111)
                arg1
                (fp #b1 #b10100000 #b110111110000100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010011 #b111100001010110)
                arg2
                (fp #b0 #b00000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                arg2
                (fp #b0 #b00100000 #b000011100001010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001100 #b100010110110101)
                expect
                (fp #b1 #b10111110 #b001001101001111)))
(assert (fp.leq (fp #b1 #b10111110 #b001001101001111)
                expect
                (fp #b0 #b11110111 #b010011000100000)))

(assert (= expect result))

(check-sat)
(exit)
