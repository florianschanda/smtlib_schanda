; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011111 #b011101111111100)
                arg1
                (fp #b0 #b01111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b01111111 #b010001110000010)
                arg1
                (fp #b0 #b10010010 #b111000000110000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101001 #b001100011100011)
                arg2
                (fp #b1 #b10001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                arg2
                (fp #b0 #b11000011 #b001000100000000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010110 #b000101111001010)
                expect
                (fp #b1 #b10001110 #b110110100010100)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010100)
                expect
                (fp #b0 #b01111010 #b010101101010010)))

(assert (= expect result))

(check-sat)
(exit)
