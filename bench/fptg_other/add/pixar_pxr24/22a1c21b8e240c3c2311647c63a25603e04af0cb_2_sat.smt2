                arg2
                (fp #b1 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b01010010 #b010111101101000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101011 #b000110101101000)
                expect
                (fp #b1 #b01111111 #b011000110111011)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111011)
                expect
                (fp #b0 #b01001000 #b001111010110110)))

(assert (= expect result))

(check-sat)
(exit)
