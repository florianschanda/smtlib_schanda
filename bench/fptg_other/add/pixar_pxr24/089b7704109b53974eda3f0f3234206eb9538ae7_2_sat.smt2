(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b11010110 #b110010101100000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b001010000110101)
                expect
                (fp #b1 #b11111101 #b000000000000001)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000001)
                expect
                (fp #b1 #b01110100 #b100001001010100)))

(assert (= expect result))

(check-sat)
(exit)
