(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b111111110011000)
                expect
                (fp #b1 #b11110010 #b010000110111101)))
(assert (fp.leq (fp #b1 #b11110010 #b010000110111101)
                expect
                (fp #b1 #b00000101 #b001101101110011)))

(assert (= expect result))

(check-sat)
