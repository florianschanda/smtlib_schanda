(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01100111 #b110110001111100)
                arg1
                (fp #b1 #b00000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b00000000 #b010010100000101)
                arg1
                (fp #b0 #b10100010 #b011011010000000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00110101 #b101101000110101)
                arg2
                (fp #b0 #b10110001 #b010111010101010)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101010)
                arg2
                (fp #b0 #b11110000 #b100101111110011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010001 #b110000001001100)
                expect
                (fp #b0 #b10110001 #b010111010101001)))
(assert (fp.leq (fp #b0 #b10110001 #b010111010101001)
                expect
                (fp #b0 #b10111011 #b000111001011110)))

(assert (= expect result))

(check-sat)
(exit)
