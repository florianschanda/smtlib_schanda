; Format: PIXAR_PXR24
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000100 #b000011011001110)
                arg1
                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg1
                (fp #b0 #b00101000 #b110110010000101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101001 #b011001101010010)
                arg2
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                arg2
                (fp #b0 #b10011110 #b011010010000111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00100110 #b000100010111010)
                expect
                (fp #b0 #b10010101 #b010110101010000)))
(assert (fp.leq (fp #b0 #b10010101 #b010110101010000)
                expect
                (fp #b0 #b10111010 #b111110110110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
