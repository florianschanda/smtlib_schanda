(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                arg2
                (fp #b0 #b10111100 #b000110100011101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110101 #b110110110111101)
                expect
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                expect
                (fp #b0 #b10010100 #b011011101110100)))

(assert (= expect result))

(check-sat)
