                arg2
                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                arg2
                (fp #b0 #b01111111 #b100110100000100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00110000 #b100100100100100)
                expect
                (fp #b0 #b10111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b000000000000000)
                expect
                (fp #b0 #b11001101 #b111110011100001)))

(assert (= expect result))

(check-sat)
(exit)
