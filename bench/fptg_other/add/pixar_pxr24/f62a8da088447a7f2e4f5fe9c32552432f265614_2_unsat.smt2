                (fp #b1 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b01011010 #b110100100000001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111110 #b110111110100001)
                expect
                (fp #b1 #b11111101 #b000000000000001)))
(assert (fp.leq (fp #b1 #b11111101 #b000000000000001)
                expect
                (fp #b0 #b10010101 #b010111000110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
