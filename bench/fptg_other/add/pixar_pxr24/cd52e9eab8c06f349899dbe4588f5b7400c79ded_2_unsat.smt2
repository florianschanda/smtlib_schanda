(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                arg2
                (fp #b0 #b01011111 #b011010101001100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101111 #b011110010000011)
                expect
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                expect
                (fp #b0 #b10110100 #b111000001101100)))

(assert (not (= expect result)))

(check-sat)
