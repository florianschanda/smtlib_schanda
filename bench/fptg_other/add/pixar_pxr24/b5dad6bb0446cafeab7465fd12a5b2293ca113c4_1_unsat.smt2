;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100111 #b000000010100000)
                arg1
                (fp #b1 #b01111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111010)
                arg1
                (fp #b0 #b11001010 #b100010000111010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00010001 #b101111010011000)
                arg2
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg2
                (fp #b0 #b00000101 #b000110000111010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001100 #b010111001001101)
                expect
                (fp #b1 #b01111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111010)
                expect
                (fp #b1 #b01001000 #b101101001100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
