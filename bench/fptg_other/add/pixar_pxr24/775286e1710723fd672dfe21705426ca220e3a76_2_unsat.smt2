                expect
                (fp #b1 #b11000110 #b011000101111010)))
(assert (fp.leq (fp #b1 #b11000110 #b011000101111010)
                expect
                (fp #b0 #b00001010 #b110101100001101)))

(assert (not (= expect result)))

