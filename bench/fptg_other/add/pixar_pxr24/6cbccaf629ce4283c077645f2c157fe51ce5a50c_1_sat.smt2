; Format: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011100 #b010001011101011)
                arg1
                (fp #b0 #b10100010 #b010100010011111)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010011111)
                arg1
                (fp #b0 #b11001010 #b100101111100011)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01000101 #b110101100111000)
                arg2
                (fp #b1 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b111111111111111)
                arg2
                (fp #b0 #b01111101 #b110010100000110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100111 #b110111100000100)
                expect
                (fp #b0 #b10100010 #b010100010011110)))
(assert (fp.leq (fp #b0 #b10100010 #b010100010011110)
                expect
                (fp #b0 #b11111001 #b001010000100010)))

(assert (= expect result))

(check-sat)
(exit)
