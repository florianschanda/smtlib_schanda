;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101001 #b101111001101101)
                arg1
                (fp #b1 #b00000000 #b100101111110110)))
(assert (fp.leq (fp #b1 #b00000000 #b100101111110110)
                arg1
                (fp #b0 #b00000000 #b000001010111010)))

