                arg2
                (fp #b0 #b01111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100111000)
                arg2
                (fp #b0 #b10101001 #b100000111010001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001010 #b111100010111010)
                expect
                (fp #b0 #b01111111 #b000010100110111)))
(assert (fp.leq (fp #b0 #b01111111 #b000010100110111)
                expect
                (fp #b0 #b10010110 #b110000110001110)))

(assert (= expect result))

(check-sat)
(exit)
