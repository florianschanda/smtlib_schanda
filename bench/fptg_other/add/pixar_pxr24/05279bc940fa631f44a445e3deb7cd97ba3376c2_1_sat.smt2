                arg2
                (fp #b1 #b01011000 #b110010000011010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110001 #b110000001101110)
                expect
                (fp #b1 #b01011111 #b010000001010111)))
(assert (fp.leq (fp #b1 #b01011111 #b010000001010111)
                expect
                (fp #b1 #b01001111 #b010110000000101)))

(assert (= expect result))

(check-sat)
