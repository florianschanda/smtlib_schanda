(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10011100 #b000010110111010)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b10011111 #b010110110100110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110001 #b001001010111011)
                arg2
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                arg2
                (fp #b0 #b11101000 #b101110100110111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100101 #b001100001011111)
                expect
                (fp #b0 #b10001100 #b101110000100011)))
(assert (fp.leq (fp #b0 #b10001100 #b101110000100011)
                expect
                (fp #b0 #b10110011 #b001010101011001)))

(assert (= expect result))

(check-sat)
(exit)
