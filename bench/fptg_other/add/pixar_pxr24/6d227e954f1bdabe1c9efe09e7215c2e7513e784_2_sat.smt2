(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111100 #b001100001100110)
                arg1
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                arg1
                (fp #b0 #b10101010 #b111100011111000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011100 #b100011001011010)
                arg2
                (fp #b0 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b111111111111111)
                arg2
                (fp #b0 #b11011010 #b101100101100010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01110000 #b000000100111101)
                expect
                (fp #b0 #b10111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b000000000000000)
                expect
                (fp #b0 #b11100101 #b010111100001010)))

(assert (= expect result))

(check-sat)
(exit)
