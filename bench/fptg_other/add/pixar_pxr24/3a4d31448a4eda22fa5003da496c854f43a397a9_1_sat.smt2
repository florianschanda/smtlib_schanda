; Format: PIXAR_PXR24
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10111011 #b000100001101001)
                arg1
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                arg1
                (fp #b0 #b11111110 #b000000010111000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111100 #b110101010100001)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b00010101 #b101000100011001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001000 #b001001111000111)
                expect
                (fp #b0 #b11111100 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b111111111111111)
                expect
                (fp #b0 #b11111110 #b111000010110011)))

(assert (= expect result))

(check-sat)
(exit)
