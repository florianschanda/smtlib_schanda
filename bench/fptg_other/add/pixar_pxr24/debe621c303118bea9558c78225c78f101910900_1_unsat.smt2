(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                arg2
                (fp #b0 #b10100101 #b110101101100001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100101 #b101011001010110)
                expect
                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                expect
                (fp #b1 #b01101000 #b101001011101000)))

(assert (not (= expect result)))

(check-sat)
