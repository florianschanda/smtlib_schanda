;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110011 #b111011100011010)
                arg1
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                arg1
                (fp #b1 #b00000001 #b011011010101000)))

(declare-const arg2 (_ FloatingPoint 8 16))
