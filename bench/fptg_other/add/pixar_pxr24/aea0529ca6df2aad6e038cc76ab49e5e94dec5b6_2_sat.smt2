; Format: PIXAR_PXR24
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001101 #b011001101010011)
                arg1
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                arg1
                (fp #b0 #b11111110 #b011100001010010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001111 #b001000100000110)
                arg2
                (fp #b0 #b00011100 #b101010110010010)))
(assert (fp.leq (fp #b0 #b00011100 #b101010110010010)
                arg2
                (fp #b0 #b01011111 #b111111100100110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101001 #b001101011101000)
                expect
                (fp #b1 #b10111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111111111111)
                expect
                (fp #b0 #b00000100 #b000001111101110)))

(assert (= expect result))

(check-sat)
(exit)
