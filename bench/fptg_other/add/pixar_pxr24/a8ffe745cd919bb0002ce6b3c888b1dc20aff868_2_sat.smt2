; Format: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110011 #b010110110000001)
                arg1
                (fp #b1 #b01011111 #b101001111011010)))
(assert (fp.leq (fp #b1 #b01011111 #b101001111011010)
                arg1
                (fp #b0 #b10100000 #b010100110001000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101001 #b100010101100101)
                arg2
                (fp #b1 #b10001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101100)
                arg2
                (fp #b1 #b01110101 #b111000011110010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011100 #b101110111110011)
                expect
                (fp #b1 #b10001110 #b100101100101101)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101101)
                expect
                (fp #b0 #b11000110 #b001101001000100)))

(assert (= expect result))

(check-sat)
(exit)
