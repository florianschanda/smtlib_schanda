; Format: PIXAR_PXR24
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001100 #b011100101100100)
                arg1
                (fp #b1 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg1
                (fp #b0 #b11110011 #b111001000011110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00100010 #b101011011110110)
                arg2
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b10110001 #b100110111011100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010011 #b001010000001000)
                expect
                (fp #b0 #b00111000 #b011010100000100)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000100)
                expect
                (fp #b0 #b10100101 #b000011001000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
