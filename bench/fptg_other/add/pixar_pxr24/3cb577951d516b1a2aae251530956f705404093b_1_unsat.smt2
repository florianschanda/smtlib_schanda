(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: -ZERO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11110100 #b111111111100110)
                arg1
                (fp #b1 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b11011100 #b110110001100100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00010111 #b100001101111101)
                arg2
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b11111110 #b001111100101011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111011 #b110000111010010)
                expect
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                expect
                (fp #b0 #b01010110 #b100000000101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
