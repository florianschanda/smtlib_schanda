(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01101111 #b101100010000101)
                expect
                (fp #b0 #b01111111 #b010001110000001)))
(assert (fp.leq (fp #b0 #b01111111 #b010001110000001)
                expect
                (fp #b0 #b10011110 #b000010010111011)))

(assert (= expect result))

(check-sat)
