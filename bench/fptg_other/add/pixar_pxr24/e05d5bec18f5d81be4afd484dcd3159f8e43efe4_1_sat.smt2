(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b10101000 #b111010111101001)
                arg1
                (fp #b0 #b11100101 #b010000111011001)))
(assert (fp.leq (fp #b0 #b11100101 #b010000111011001)
                arg1
                (fp #b0 #b11111001 #b001010011000010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010110 #b010010101011100)
                arg2
                (fp #b1 #b00000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b00000000 #b110111110100111)
                arg2
                (fp #b0 #b01011101 #b110110111111101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111100 #b110010000001000)
                expect
                (fp #b0 #b11100101 #b010000111011000)))
(assert (fp.leq (fp #b0 #b11100101 #b010000111011000)
                expect
                (fp #b0 #b11111001 #b010010110011001)))

(assert (= expect result))

(check-sat)
(exit)
