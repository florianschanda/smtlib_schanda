(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110011 #b101111000101110)
                arg1
                (fp #b1 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b111111111111111)
                arg1
                (fp #b0 #b10010100 #b100110110100101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010011 #b001011010101011)
                arg2
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                arg2
                (fp #b0 #b11111101 #b000010101011101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101011 #b100010001111001)
                expect
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                expect
                (fp #b0 #b11111101 #b001011000110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
