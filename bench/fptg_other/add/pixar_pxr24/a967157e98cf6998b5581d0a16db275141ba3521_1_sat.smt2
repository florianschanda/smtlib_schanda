                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                arg2
                (fp #b1 #b10100111 #b011100100011001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11111111 #b000000000000000)
                expect
                (fp #b1 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b111111111111111)
                expect
                (fp #b1 #b11001010 #b111011001110111)))

(assert (= expect result))

(check-sat)
(exit)
