(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b01111001 #b011010111000010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110001 #b000100011110000)
                expect
                (fp #b0 #b11111100 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b111111111111111)
                expect
                (fp #b0 #b11111101 #b011010100111001)))

(assert (= expect result))

(check-sat)
(exit)
