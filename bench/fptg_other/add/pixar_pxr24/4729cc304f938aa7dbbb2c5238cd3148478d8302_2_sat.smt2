;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110011 #b000011100110101)
                arg1
                (fp #b1 #b00000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b00000000 #b010010100000101)
                arg1
                (fp #b0 #b00100000 #b110110101001110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110110 #b001111110000010)
                arg2
                (fp #b1 #b11011101 #b010010100010011)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010011)
                arg2
                (fp #b0 #b00100001 #b011110000110101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100010 #b110010111011100)
                expect
                (fp #b1 #b11011101 #b010010100010100)))
(assert (fp.leq (fp #b1 #b11011101 #b010010100010100)
                expect
                (fp #b1 #b00001100 #b111100001010000)))

(assert (= expect result))

(check-sat)
(exit)
