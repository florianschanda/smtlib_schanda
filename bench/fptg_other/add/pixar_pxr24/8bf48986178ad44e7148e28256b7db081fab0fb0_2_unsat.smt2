;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110101 #b101101001110111)
                arg1
                (fp #b0 #b00000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b00000000 #b111110010011101)
                arg1
                (fp #b0 #b01110001 #b100001000100100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110010 #b110000000110010)
                arg2
                (fp #b1 #b10001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                arg2
                (fp #b0 #b10011010 #b010001000010010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010011 #b111000000001110)
                expect
                (fp #b1 #b10001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                expect
                (fp #b0 #b10001110 #b100100111001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
