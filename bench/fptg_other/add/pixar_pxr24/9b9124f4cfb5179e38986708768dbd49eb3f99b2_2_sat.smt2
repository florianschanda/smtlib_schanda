(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00011110 #b100101010011000)
                expect
                (fp #b0 #b11111101 #b000000000000001)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000001)
                expect
                (fp #b0 #b11111101 #b001100110010111)))

(assert (= expect result))

(check-sat)
