; Format: PIXAR_PXR24
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00110100 #b111011001000110)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b00110001 #b100011110001010)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110000 #b000100010010110)
                arg2
                (fp #b0 #b01100010 #b101101001011100)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011100)
                arg2
                (fp #b0 #b11111010 #b000111001101010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010000 #b000010001101110)
                expect
                (fp #b0 #b01100010 #b101101001011100)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011100)
                expect
                (fp #b0 #b10101000 #b111011010000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
