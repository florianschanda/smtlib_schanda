(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: PIXAR_PXR24
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01011000 #b110100011000000)
                arg1
                (fp #b1 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b000000000000001)
                arg1
                (fp #b0 #b01110001 #b111000101111011)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001100 #b100000001110001)
                arg2
                (fp #b0 #b01100010 #b101101001011100)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011100)
                arg2
                (fp #b0 #b01111000 #b001000011001111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110011 #b111010110001101)
                expect
                (fp #b0 #b01100010 #b101101001011011)))
(assert (fp.leq (fp #b0 #b01100010 #b101101001011011)
                expect
                (fp #b0 #b10110101 #b000001111001011)))

(assert (= expect result))

(check-sat)
(exit)
