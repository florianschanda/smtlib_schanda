(assert (fp.leq (fp #b1 #b10001111 #b000000000000000)
                arg2
                (fp #b0 #b10111000 #b001010110101000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000010 #b001111101101000)
                expect
                (fp #b1 #b10001111 #b000000000000001)))
(assert (fp.leq (fp #b1 #b10001111 #b000000000000001)
                expect
                (fp #b0 #b00101111 #b000100111001010)))

(assert (not (= expect result)))

(check-sat)
