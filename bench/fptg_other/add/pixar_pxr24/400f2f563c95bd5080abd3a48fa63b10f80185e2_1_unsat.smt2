                arg2
                (fp #b0 #b00011001 #b011010010110100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000010 #b011001000100010)
                expect
                (fp #b1 #b00000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b00000000 #b010010100000101)
                expect
                (fp #b0 #b10110000 #b110111000101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
