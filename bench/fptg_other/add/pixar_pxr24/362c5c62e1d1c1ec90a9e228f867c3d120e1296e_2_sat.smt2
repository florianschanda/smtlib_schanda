(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                arg2
                (fp #b0 #b01001000 #b010001110000110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001111 #b100001111101111)
                expect
                (fp #b0 #b01000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000001)
                expect
                (fp #b0 #b01100110 #b010111000001100)))

(assert (= expect result))

(check-sat)
(exit)
