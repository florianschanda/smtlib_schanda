                arg2
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                arg2
                (fp #b0 #b01100110 #b011111000100111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001111 #b001110001110011)
                expect
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                expect
                (fp #b0 #b10001110 #b011000010111000)))

(assert (= expect result))

(check-sat)
(exit)
