; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01000010 #b011010100010001)
                arg1
                (fp #b0 #b01111111 #b100001110001010)))
(assert (fp.leq (fp #b0 #b01111111 #b100001110001010)
                arg1
                (fp #b0 #b11110001 #b110111001000100)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100000 #b000110111010100)
                expect
                (fp #b0 #b10000000 #b100001110001010)))
(assert (fp.leq (fp #b0 #b10000000 #b100001110001010)
                expect
                (fp #b0 #b10110010 #b001000110000010)))

(assert (= expect result))

(check-sat)
(exit)
