; Format: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110101 #b111110101110011)
                arg1
                (fp #b0 #b01011100 #b011101001001101)))
(assert (fp.leq (fp #b0 #b01011100 #b011101001001101)
                arg1
                (fp #b0 #b10111001 #b000011110001111)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111001 #b111101100000001)
                arg2
                (fp #b0 #b00000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                arg2
                (fp #b0 #b11111010 #b010110000101111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00110111 #b111111001000110)
                expect
                (fp #b0 #b01011100 #b011101001001101)))
(assert (fp.leq (fp #b0 #b01011100 #b011101001001101)
                expect
                (fp #b0 #b10001010 #b110000101001111)))

(assert (= expect result))

(check-sat)
(exit)
