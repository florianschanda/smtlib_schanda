; Format: PIXAR_PXR24
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100000 #b011011101010001)
                arg1
                (fp #b0 #b00000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg1
                (fp #b0 #b10001101 #b011001101011000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010011 #b000000011100000)
                arg2
                (fp #b1 #b01111111 #b010100010011001)))
(assert (fp.leq (fp #b1 #b01111111 #b010100010011001)
                arg2
                (fp #b1 #b01110001 #b011010110001001)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110101 #b010110110111000)
                expect
                (fp #b1 #b01111111 #b010100010011001)))
(assert (fp.leq (fp #b1 #b01111111 #b010100010011001)
                expect
                (fp #b0 #b11011111 #b111111010110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
