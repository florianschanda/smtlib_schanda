(assert (fp.leq (fp #b1 #b00000000 #b001010111010001)
                arg2
                (fp #b0 #b00101001 #b101100100100011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01111001 #b101000000100110)
                expect
                (fp #b0 #b01000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000000000000)
                expect
                (fp #b0 #b10001000 #b111010001000011)))

(assert (not (= expect result)))

(check-sat)
