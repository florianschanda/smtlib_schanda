(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: PIXAR_PXR24
; Arg1: -SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b010011110011001)
                arg1
                (fp #b1 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b000000000000000)
                arg1
                (fp #b0 #b10010111 #b100001001000110)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01011001 #b100100011101010)
                arg2
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                arg2
                (fp #b0 #b11011100 #b010011101101100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010010 #b001101110110001)
                expect
                (fp #b0 #b00111000 #b011010100000100)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000100)
                expect
                (fp #b0 #b11000000 #b101110000111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
