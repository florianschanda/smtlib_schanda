(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101100 #b001111001011011)
                expect
                (fp #b1 #b10001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b10001110 #b110110100010101)
                expect
                (fp #b1 #b00011101 #b110001010111010)))

(assert (= expect result))

(check-sat)
