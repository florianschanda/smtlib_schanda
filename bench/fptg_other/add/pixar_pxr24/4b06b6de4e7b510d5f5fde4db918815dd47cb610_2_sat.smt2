(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101100 #b100110011010001)
                expect
                (fp #b0 #b00111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b00111000 #b011010100000101)
                expect
                (fp #b0 #b01110101 #b101011110111010)))

(assert (= expect result))

(check-sat)
