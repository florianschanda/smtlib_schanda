                arg2
                (fp #b0 #b11110001 #b001101011010100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111010 #b000111010011010)
                expect
                (fp #b0 #b00111111 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00111111 #b111111111111111)
                expect
                (fp #b0 #b01010100 #b000001000000110)))

(assert (not (= expect result)))

