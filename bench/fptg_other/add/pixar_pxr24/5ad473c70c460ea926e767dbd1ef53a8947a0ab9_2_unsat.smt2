; Format: PIXAR_PXR24
; Arg1: +LARGEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001001 #b011001010100100)
                arg1
                (fp #b0 #b11111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b111111111111111)
                arg1
                (fp #b0 #b11111111 #b000000000000000)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011111 #b100001011100111)
                arg2
                (fp #b0 #b00000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b010000000000000)
                arg2
                (fp #b0 #b01011001 #b100111001101101)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
