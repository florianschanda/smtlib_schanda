                arg2
                (fp #b0 #b10111100 #b011001000000010)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000001 #b101111001011000)
                expect
                (fp #b0 #b00111111 #b111111111111111)))
(assert (fp.leq (fp #b0 #b00111111 #b111111111111111)
                expect
                (fp #b0 #b01111100 #b010000110110100)))

(assert (not (= expect result)))

