(assert (fp.leq (fp #b0 #b00000000 #b111111111111111)
                arg2
                (fp #b0 #b00101010 #b100110010100011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110110 #b110000010111110)
                expect
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                expect
                (fp #b0 #b10101000 #b011101111101011)))

(assert (= expect result))

(check-sat)
(exit)
