(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010011 #b101111100101001)
                expect
                (fp #b0 #b01011100 #b011101001001101)))
(assert (fp.leq (fp #b0 #b01011100 #b011101001001101)
                expect
                (fp #b0 #b10110110 #b000000111001101)))

(assert (not (= expect result)))

(check-sat)
