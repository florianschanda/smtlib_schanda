;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011011 #b000110111101111)
                arg1
                (fp #b1 #b01111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b01111111 #b110100000111010)
                arg1
                (fp #b0 #b10010001 #b111100001101101)))

(declare-const arg2 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001111 #b010000110010001)
                arg2
                (fp #b0 #b00000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b00000000 #b010000010001101)
                arg2
                (fp #b0 #b11101111 #b001101001111000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111110 #b101010010100101)
                expect
                (fp #b1 #b01111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b01111111 #b110100000111010)
                expect
                (fp #b0 #b00111111 #b100101010101101)))

(assert (= expect result))

(check-sat)
(exit)
