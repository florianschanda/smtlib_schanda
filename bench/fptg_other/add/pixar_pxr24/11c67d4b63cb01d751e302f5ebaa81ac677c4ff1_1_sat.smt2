                arg2
                (fp #b1 #b00011000 #b111111100101111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101100 #b010000101111111)
                expect
                (fp #b1 #b10001110 #b100101100101011)))
(assert (fp.leq (fp #b1 #b10001110 #b100101100101011)
                expect
                (fp #b0 #b10010111 #b000110001110101)))

(assert (= expect result))

(check-sat)
