(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010010 #b001011011010100)
                expect
                (fp #b0 #b11111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000000000000)
                expect
                (fp #b0 #b11111101 #b110000010011000)))

(assert (not (= expect result)))

(check-sat)
