(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00111)
                arg1
                (fp #b1 #b100100 #b10101)))
(assert (fp.leq (fp #b1 #b100100 #b10101)
                arg1
                (fp #b0 #b001101 #b10101)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b11010)
                arg2
                (fp #b1 #b011111 #b00110)))
(assert (fp.leq (fp #b1 #b011111 #b00110)
                arg2
                (fp #b0 #b110011 #b00011)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b00001)
                expect
                (fp #b1 #b100100 #b10110)))
(assert (fp.leq (fp #b1 #b100100 #b10110)
                expect
                (fp #b0 #b011111 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
