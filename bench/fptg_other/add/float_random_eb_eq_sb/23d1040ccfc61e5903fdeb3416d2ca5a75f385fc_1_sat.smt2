(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110000 #b011100)
                arg1
                (fp #b1 #b0011101 #b000000)))
(assert (fp.leq (fp #b1 #b0011101 #b000000)
                arg1
                (fp #b1 #b0001100 #b010001)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110001 #b011100)
                arg2
                (fp #b0 #b0011101 #b000000)))
(assert (fp.leq (fp #b0 #b0011101 #b000000)
                arg2
                (fp #b0 #b1000111 #b110110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0100000 #b101101)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b1100000 #b110010)))

(assert (= expect result))

(check-sat)
(exit)
