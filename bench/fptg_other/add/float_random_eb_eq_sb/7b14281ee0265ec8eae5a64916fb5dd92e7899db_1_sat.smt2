; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011000100 #b1110011000)
                arg1
                (fp #b1 #b10011101010 #b1110101001)))
(assert (fp.leq (fp #b1 #b10011101010 #b1110101001)
                arg1
                (fp #b0 #b01011011000 #b1010100110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100010001 #b1111111110)
                arg2
                (fp #b0 #b10110000110 #b0001100011)))
(assert (fp.leq (fp #b0 #b10110000110 #b0001100011)
                arg2
                (fp #b0 #b10111010011 #b0101010100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00010010000 #b1111010011)
                expect
                (fp #b0 #b10110000110 #b0001100010)))
(assert (fp.leq (fp #b0 #b10110000110 #b0001100010)
                expect
                (fp #b0 #b11001000100 #b0001010100)))

(assert (= expect result))

(check-sat)
(exit)
