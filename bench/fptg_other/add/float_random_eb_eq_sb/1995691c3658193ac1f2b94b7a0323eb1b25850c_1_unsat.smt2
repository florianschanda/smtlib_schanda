(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00111)
                arg1
                (fp #b1 #b000000 #b00111)))
(assert (fp.leq (fp #b1 #b000000 #b00111)
                arg1
                (fp #b0 #b111101 #b10001)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b01001)
                arg2
                (fp #b1 #b100111 #b01000)))
(assert (fp.leq (fp #b1 #b100111 #b01000)
                arg2
                (fp #b1 #b011101 #b10100)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110100 #b01000)
                expect
                (fp #b1 #b100111 #b01000)))
(assert (fp.leq (fp #b1 #b100111 #b01000)
                expect
                (fp #b0 #b000000 #b11001)))

(assert (not (= expect result)))

(check-sat)
(exit)
