(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0110)
                arg1
                (fp #b1 #b10001 #b1000)))
(assert (fp.leq (fp #b1 #b10001 #b1000)
                arg1
                (fp #b1 #b01101 #b1100)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01100 #b1010)
                arg2
                (fp #b0 #b10001 #b1000)))
(assert (fp.leq (fp #b0 #b10001 #b1000)
                arg2
                (fp #b0 #b11101 #b0001)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00111 #b1000)
                expect
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                expect
                (fp #b0 #b10011 #b0100)))

(assert (not (= expect result)))

(check-sat)
(exit)
