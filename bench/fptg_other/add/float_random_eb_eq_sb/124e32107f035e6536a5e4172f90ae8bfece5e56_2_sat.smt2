(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b00111)
                arg1
                (fp #b1 #b001101 #b01101)))
(assert (fp.leq (fp #b1 #b001101 #b01101)
                arg1
                (fp #b0 #b101010 #b10001)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b100001 #b10000)
                arg2
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg2
                (fp #b0 #b111101 #b01110)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001101 #b11000)
                expect
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                expect
                (fp #b0 #b111110 #b11111)))

(assert (= expect result))

(check-sat)
(exit)
