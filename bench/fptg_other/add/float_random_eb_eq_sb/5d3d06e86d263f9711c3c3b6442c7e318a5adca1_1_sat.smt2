(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0101111 #b101000)
                arg1
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg1
                (fp #b0 #b0011000 #b111010)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0110010 #b000001)
                arg2
                (fp #b0 #b1111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111101 #b000000)
                arg2
                (fp #b0 #b1111101 #b010100)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000011 #b110010)
                expect
                (fp #b0 #b1111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111101 #b000000)
                expect
                (fp #b0 #b1111101 #b001111)))

(assert (= expect result))

(check-sat)
(exit)
