(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b001)
                arg1
                (fp #b0 #b0111 #b000)))
(assert (fp.leq (fp #b0 #b0111 #b000)
                arg1
                (fp #b0 #b1101 #b111)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b111)
                arg2
                (fp #b1 #b1100 #b101)))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg2
                (fp #b1 #b0110 #b010)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b110)
                expect
                (fp #b1 #b1100 #b101)))
(assert (fp.leq (fp #b1 #b1100 #b101)
                expect
                (fp #b0 #b1001 #b101)))

(assert (= expect result))

(check-sat)
(exit)
