(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01000 #b0111)
                arg1
                (fp #b0 #b00101 #b1101)))
(assert (fp.leq (fp #b0 #b00101 #b1101)
                arg1
                (fp #b0 #b11011 #b0101)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00110 #b0001)
                arg2
                (fp #b0 #b01000 #b0000)))
(assert (fp.leq (fp #b0 #b01000 #b0000)
                arg2
                (fp #b0 #b11001 #b1001)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01010 #b0100)
                expect
                (fp #b0 #b01000 #b0011)))
(assert (fp.leq (fp #b0 #b01000 #b0011)
                expect
                (fp #b0 #b10011 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
