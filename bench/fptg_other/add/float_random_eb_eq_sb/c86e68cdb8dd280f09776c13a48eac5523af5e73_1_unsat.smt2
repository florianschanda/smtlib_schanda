; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110110 #b101111)
                arg1
                (fp #b0 #b0001000 #b100110)))
(assert (fp.leq (fp #b0 #b0001000 #b100110)
                arg1
                (fp #b0 #b0101100 #b100011)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0110100 #b000000)
                arg2
                (fp #b1 #b0000000 #b101100)))
(assert (fp.leq (fp #b1 #b0000000 #b101100)
                arg2
                (fp #b0 #b1011101 #b011111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100110 #b010110)
                expect
                (fp #b0 #b0001000 #b100101)))
(assert (fp.leq (fp #b0 #b0001000 #b100101)
                expect
                (fp #b0 #b1001100 #b100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
