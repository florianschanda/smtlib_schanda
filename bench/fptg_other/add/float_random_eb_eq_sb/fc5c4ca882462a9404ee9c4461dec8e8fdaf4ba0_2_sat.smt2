(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001001 #b010100)
                arg1
                (fp #b1 #b0000000 #b100100)))
(assert (fp.leq (fp #b1 #b0000000 #b100100)
                arg1
                (fp #b0 #b1111000 #b000001)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010000 #b010100)
                arg2
                (fp #b0 #b1000001 #b100000)))
(assert (fp.leq (fp #b0 #b1000001 #b100000)
                arg2
                (fp #b0 #b1111010 #b111100)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011001 #b010110)
                expect
                (fp #b0 #b1000001 #b100000)))
(assert (fp.leq (fp #b0 #b1000001 #b100000)
                expect
                (fp #b0 #b1111100 #b010110)))

(assert (= expect result))

(check-sat)
(exit)
