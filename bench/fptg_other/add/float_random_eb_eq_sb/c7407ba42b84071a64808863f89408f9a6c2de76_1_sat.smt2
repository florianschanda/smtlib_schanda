(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001011 #b101100)
                arg1
                (fp #b0 #b0000001 #b000000)))
(assert (fp.leq (fp #b0 #b0000001 #b000000)
                arg1
                (fp #b0 #b0110100 #b110000)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0111100 #b011011)
                arg2
                (fp #b1 #b0101000 #b111001)))
(assert (fp.leq (fp #b1 #b0101000 #b111001)
                arg2
                (fp #b1 #b0000010 #b000000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101010 #b100100)
                expect
                (fp #b1 #b0101000 #b111000)))
(assert (fp.leq (fp #b1 #b0101000 #b111000)
                expect
                (fp #b0 #b0010001 #b011011)))

(assert (= expect result))

(check-sat)
(exit)
