(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111111 #b00000)
                arg1
                (fp #b1 #b111110 #b11111)))
(assert (fp.leq (fp #b1 #b111110 #b11111)
                arg1
                (fp #b0 #b001100 #b10000)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000111 #b10111)
                arg2
                (fp #b0 #b100011 #b00110)))
(assert (fp.leq (fp #b0 #b100011 #b00110)
                arg2
                (fp #b0 #b101010 #b01010)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111111 #b00000)
                expect
                (fp #b1 #b111110 #b11111)))
(assert (fp.leq (fp #b1 #b111110 #b11111)
                expect
                (fp #b0 #b110110 #b10011)))

(assert (not (= expect result)))

(check-sat)
(exit)
