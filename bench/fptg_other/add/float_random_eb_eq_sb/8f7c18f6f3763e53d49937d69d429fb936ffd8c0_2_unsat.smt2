                (fp #b0 #b011111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111 #b00000000)
                arg2
                (fp #b0 #b101001000 #b00110110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101111 #b11111100)
                expect
                (fp #b0 #b101111111 #b00000000)))
(assert (fp.leq (fp #b0 #b101111111 #b00000000)
                expect
                (fp #b0 #b110011011 #b11011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
