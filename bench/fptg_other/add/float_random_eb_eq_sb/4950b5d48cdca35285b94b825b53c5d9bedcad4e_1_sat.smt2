                arg2
                (fp #b1 #b001101111111011001 #b01101011100010110)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b011100111110110101 #b01010110001001111)
                expect
                (fp #b1 #b001111111111110111 #b01101010000010100)))
(assert (fp.leq (fp #b1 #b001111111111110111 #b01101010000010100)
                expect
                (fp #b0 #b110100011100000101 #b11101011011010111)))

(assert (= expect result))

(check-sat)
