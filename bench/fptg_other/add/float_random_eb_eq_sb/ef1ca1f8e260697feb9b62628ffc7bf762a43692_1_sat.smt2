(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01001 #b0011)
                arg1
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                arg1
                (fp #b0 #b11101 #b1100)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00011 #b1001)
                arg2
                (fp #b0 #b10011 #b0001)))
(assert (fp.leq (fp #b0 #b10011 #b0001)
                arg2
                (fp #b0 #b11101 #b1100)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01110 #b1010)
                expect
                (fp #b0 #b10011 #b0001)))
(assert (fp.leq (fp #b0 #b10011 #b0001)
                expect
                (fp #b0 #b11110 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
