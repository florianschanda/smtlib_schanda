; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0111111 #b100001)
                arg1
                (fp #b1 #b0000000 #b011011)))
(assert (fp.leq (fp #b1 #b0000000 #b011011)
                arg1
                (fp #b0 #b1100011 #b001001)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0001011 #b100100)
                arg2
                (fp #b0 #b1000101 #b101000)))
(assert (fp.leq (fp #b0 #b1000101 #b101000)
                arg2
                (fp #b0 #b1001111 #b111110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b000001)
                expect
                (fp #b0 #b1000101 #b101000)))
(assert (fp.leq (fp #b0 #b1000101 #b101000)
                expect
                (fp #b0 #b1111010 #b110100)))

(assert (= expect result))

(check-sat)
(exit)
