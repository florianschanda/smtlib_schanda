(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0011001 #b000101)
                arg1
                (fp #b0 #b0100000 #b000000)))
(assert (fp.leq (fp #b0 #b0100000 #b000000)
                arg1
                (fp #b0 #b1100011 #b010101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101110 #b011001)
                arg2
                (fp #b0 #b0000000 #b110000)))
(assert (fp.leq (fp #b0 #b0000000 #b110000)
                arg2
                (fp #b0 #b0101110 #b101100)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0111110 #b100100)
                expect
                (fp #b0 #b0100000 #b000000)))
(assert (fp.leq (fp #b0 #b0100000 #b000000)
                expect
                (fp #b0 #b1100101 #b110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
