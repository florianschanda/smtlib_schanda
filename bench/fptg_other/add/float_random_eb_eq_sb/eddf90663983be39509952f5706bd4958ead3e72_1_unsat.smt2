; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101110100 #b111110010)
                arg1
                (fp #b1 #b0000000000 #b100100111)))
(assert (fp.leq (fp #b1 #b0000000000 #b100100111)
                arg1
                (fp #b0 #b1000001010 #b000000011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100000000 #b111010001)
                arg2
                (fp #b0 #b1000000111 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b000000000)
                arg2
                (fp #b0 #b1100110011 #b111110001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110100110 #b100010011)
                expect
                (fp #b0 #b1000000110 #b111111111)))
(assert (fp.leq (fp #b0 #b1000000110 #b111111111)
                expect
                (fp #b0 #b1111111100 #b001111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
