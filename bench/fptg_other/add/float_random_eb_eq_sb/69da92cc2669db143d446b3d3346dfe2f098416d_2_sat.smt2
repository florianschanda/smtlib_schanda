                (fp #b0 #b1100000 #b111100)))
(assert (fp.leq (fp #b0 #b1100000 #b111100)
                arg2
                (fp #b0 #b1100001 #b001111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110010 #b010101)
                expect
                (fp #b0 #b1100000 #b111101)))
(assert (fp.leq (fp #b0 #b1100000 #b111101)
                expect
                (fp #b0 #b1111110 #b110100)))

(assert (= expect result))

(check-sat)
(exit)
