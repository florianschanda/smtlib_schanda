; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11111 #b0000)
                arg1
                (fp #b1 #b11110 #b1100)))
(assert (fp.leq (fp #b1 #b11110 #b1100)
                arg1
                (fp #b1 #b10110 #b0011)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10111 #b1011)
                arg2
                (fp #b1 #b10011 #b0001)))
(assert (fp.leq (fp #b1 #b10011 #b0001)
                arg2
                (fp #b0 #b01100 #b0111)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1110)
                expect
                (fp #b1 #b11110 #b1101)))
(assert (fp.leq (fp #b1 #b11110 #b1101)
                expect
                (fp #b0 #b01010 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
