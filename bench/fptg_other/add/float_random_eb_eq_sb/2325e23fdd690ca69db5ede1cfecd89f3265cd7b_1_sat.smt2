(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10100 #b1011)
                arg1
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                arg1
                (fp #b0 #b01100 #b0111)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1000)
                arg2
                (fp #b0 #b11001 #b1101)))
(assert (fp.leq (fp #b0 #b11001 #b1101)
                arg2
                (fp #b0 #b11100 #b1101)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b10110 #b1000)
                expect
                (fp #b0 #b11001 #b1101)))
(assert (fp.leq (fp #b0 #b11001 #b1101)
                expect
                (fp #b0 #b11110 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
