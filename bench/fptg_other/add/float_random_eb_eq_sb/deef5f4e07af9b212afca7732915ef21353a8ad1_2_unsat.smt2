(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101111110 #b00011101)
                arg1
                (fp #b1 #b010000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000 #b00000000)
                arg1
                (fp #b1 #b000100010 #b11011001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001010 #b10101011)
                arg2
                (fp #b1 #b100000111 #b10010100)))
(assert (fp.leq (fp #b1 #b100000111 #b10010100)
                arg2
                (fp #b1 #b000100011 #b01100100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001100 #b11110001)
                expect
                (fp #b1 #b100000111 #b10010101)))
(assert (fp.leq (fp #b1 #b100000111 #b10010101)
                expect
                (fp #b0 #b101111101 #b10100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
