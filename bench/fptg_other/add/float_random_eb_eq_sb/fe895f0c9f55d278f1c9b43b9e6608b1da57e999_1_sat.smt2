(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0011001 #b011110)
                arg1
                (fp #b1 #b0001110 #b111010)))
(assert (fp.leq (fp #b1 #b0001110 #b111010)
                arg1
                (fp #b0 #b1011101 #b011110)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100001 #b001100)
                arg2
                (fp #b0 #b0100000 #b000000)))
(assert (fp.leq (fp #b0 #b0100000 #b000000)
                arg2
                (fp #b0 #b0100100 #b100010)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b101110)
                expect
                (fp #b0 #b0011111 #b111111)))
(assert (fp.leq (fp #b0 #b0011111 #b111111)
                expect
                (fp #b0 #b1100010 #b101011)))

(assert (= expect result))

(check-sat)
(exit)
