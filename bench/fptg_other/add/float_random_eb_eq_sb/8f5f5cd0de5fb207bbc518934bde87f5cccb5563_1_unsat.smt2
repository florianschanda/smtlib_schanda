                arg2
                (fp #b0 #b1000010 #b100001)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0001101 #b101111)
                expect
                (fp #b0 #b1011110 #b111111)))
(assert (fp.leq (fp #b0 #b1011110 #b111111)
                expect
                (fp #b0 #b1101010 #b100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
