(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101111 #b101011)
                arg1
                (fp #b1 #b0101001 #b011010)))
(assert (fp.leq (fp #b1 #b0101001 #b011010)
                arg1
                (fp #b1 #b0010101 #b110011)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010100 #b101001)
                arg2
                (fp #b1 #b0100000 #b000000)))
(assert (fp.leq (fp #b1 #b0100000 #b000000)
                arg2
                (fp #b0 #b0000110 #b001000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1100000 #b011110)
                expect
                (fp #b1 #b0101001 #b011010)))
(assert (fp.leq (fp #b1 #b0101001 #b011010)
                expect
                (fp #b1 #b0001010 #b010000)))

(assert (= expect result))

(check-sat)
(exit)
