                (fp #b0 #b0000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000 #b000001)
                arg2
                (fp #b0 #b0010100 #b000001)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101101 #b001001)
                expect
                (fp #b0 #b1000101 #b001000)))
(assert (fp.leq (fp #b0 #b1000101 #b001000)
                expect
                (fp #b0 #b1011010 #b011111)))

(assert (not (= expect result)))

