(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                arg1
                (fp #b0 #b011 #b01)))

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b01)
                arg2
                (fp #b1 #b011 #b10)))
(assert (fp.leq (fp #b1 #b011 #b10)
                arg2
                (fp #b0 #b110 #b11)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                expect
                (fp #b1 #b011 #b10)))
(assert (fp.leq (fp #b1 #b011 #b10)
                expect
                (fp #b1 #b011 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
