; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b110)
                arg1
                (fp #b1 #b0111 #b000)))
(assert (fp.leq (fp #b1 #b0111 #b000)
                arg1
                (fp #b0 #b1011 #b001)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b011)
                arg2
                (fp #b0 #b1001 #b000)))
(assert (fp.leq (fp #b0 #b1001 #b000)
                arg2
                (fp #b0 #b1001 #b110)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                expect
                (fp #b0 #b1000 #b100)))
(assert (fp.leq (fp #b0 #b1000 #b100)
                expect
                (fp #b0 #b1000 #b111)))

(assert (= expect result))

(check-sat)
(exit)
