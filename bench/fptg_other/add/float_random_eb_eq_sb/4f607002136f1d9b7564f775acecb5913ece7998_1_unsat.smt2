; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1001)
                arg1
                (fp #b1 #b10011 #b1110)))
(assert (fp.leq (fp #b1 #b10011 #b1110)
                arg1
                (fp #b0 #b00010 #b1111)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11010 #b1100)
                arg2
                (fp #b0 #b00000 #b0111)))
(assert (fp.leq (fp #b0 #b00000 #b0111)
                arg2
                (fp #b0 #b11111 #b0000)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0111)
                expect
                (fp #b1 #b10011 #b1101)))
(assert (fp.leq (fp #b1 #b10011 #b1101)
                expect
                (fp #b0 #b10111 #b1010)))

(assert (not (= expect result)))

(check-sat)
(exit)
