                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg2
                (fp #b0 #b0000101101 #b101011000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b010001111)
                expect
                (fp #b1 #b1111111100 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111100 #b111111111)
                expect
                (fp #b1 #b1100010010 #b010011110)))

(assert (= expect result))

(check-sat)
