; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100110 #b101101)
                arg1
                (fp #b1 #b0000000 #b010000)))
(assert (fp.leq (fp #b1 #b0000000 #b010000)
                arg1
                (fp #b0 #b1001000 #b101011)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010011 #b000010)
                arg2
                (fp #b1 #b0000000 #b111110)))
(assert (fp.leq (fp #b1 #b0000000 #b111110)
                arg2
                (fp #b0 #b1111000 #b010100)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011100 #b001101)
                expect
                (fp #b1 #b0000001 #b001110)))
(assert (fp.leq (fp #b1 #b0000001 #b001110)
                expect
                (fp #b0 #b1001000 #b110110)))

(assert (= expect result))

(check-sat)
(exit)
