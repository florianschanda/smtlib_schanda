; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101110100101101 #b110010110001001)
                arg1
                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg1
                (fp #b0 #b1011111110000111 #b010010100100010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110011000110111 #b010010011000001)
                arg2
                (fp #b1 #b1101111001100001 #b011101100001111)))
(assert (fp.leq (fp #b1 #b1101111001100001 #b011101100001111)
                arg2
                (fp #b1 #b0001000000110110 #b001000110101111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110000000010101 #b011000111000010)
                expect
                (fp #b1 #b1101111001100001 #b011101100001111)))
(assert (fp.leq (fp #b1 #b1101111001100001 #b011101100001111)
                expect
                (fp #b0 #b0001011001001010 #b110011101101100)))

(assert (= expect result))

(check-sat)
(exit)
