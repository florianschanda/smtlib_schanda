;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0100001 #b111011)
                arg1
                (fp #b0 #b0100100 #b100111)))
(assert (fp.leq (fp #b0 #b0100100 #b100111)
                arg1
                (fp #b0 #b0101001 #b011101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b000100)
                arg2
                (fp #b1 #b1011110 #b111111)))
(assert (fp.leq (fp #b1 #b1011110 #b111111)
                arg2
                (fp #b1 #b0010111 #b000000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111100 #b100101)
                expect
                (fp #b1 #b1011110 #b111111)))
(assert (fp.leq (fp #b1 #b1011110 #b111111)
                expect
                (fp #b0 #b1101010 #b110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
