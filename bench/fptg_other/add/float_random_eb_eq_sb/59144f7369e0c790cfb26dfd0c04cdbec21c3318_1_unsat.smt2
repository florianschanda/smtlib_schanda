                (fp #b0 #b1100000 #b111100)))
(assert (fp.leq (fp #b0 #b1100000 #b111100)
                arg2
                (fp #b0 #b1101100 #b100001)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1010100 #b001010)
                expect
                (fp #b0 #b1100000 #b111011)))
(assert (fp.leq (fp #b0 #b1100000 #b111011)
                expect
                (fp #b0 #b1101101 #b111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
