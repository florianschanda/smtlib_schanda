(assert (fp.leq (fp #b1 #b0011101 #b000000)
                arg2
                (fp #b0 #b0100100 #b000110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010011 #b101011)
                expect
                (fp #b1 #b0011101 #b000001)))
(assert (fp.leq (fp #b1 #b0011101 #b000001)
                expect
                (fp #b0 #b0001011 #b110101)))

(assert (not (= expect result)))

