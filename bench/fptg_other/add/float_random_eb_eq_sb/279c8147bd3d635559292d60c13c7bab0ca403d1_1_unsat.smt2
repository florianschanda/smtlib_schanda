;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b001101001111110011 #b00111100000000010)
                arg2
                (fp #b0 #b100111011110011010 #b01110011001101110)))
(assert (fp.leq (fp #b0 #b100111011110011010 #b01110011001101110)
                arg2
                (fp #b0 #b101010011010101000 #b10010010001000010)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
