; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010100000100 #b0000000011100)
                arg1
                (fp #b1 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b1111111111111)
                arg1
                (fp #b1 #b10000011010010 #b1001101101010)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00011101000110 #b0010110110010)
                arg2
                (fp #b0 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b1111111111111)
                arg2
                (fp #b0 #b11110100011101 #b1010000100000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10001010010001 #b0011000101011)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b01100010110000 #b1011111110010)))

(assert (= expect result))

(check-sat)
(exit)
