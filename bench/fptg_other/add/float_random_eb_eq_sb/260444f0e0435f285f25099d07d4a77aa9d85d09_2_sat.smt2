(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b010)
                arg1
                (fp #b1 #b0111 #b000)))
(assert (fp.leq (fp #b1 #b0111 #b000)
                arg1
                (fp #b1 #b0000 #b101)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b110)
                arg2
                (fp #b1 #b0011 #b000)))
(assert (fp.leq (fp #b1 #b0011 #b000)
                arg2
                (fp #b1 #b0001 #b111)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1111 #b000)
                expect
                (fp #b1 #b0111 #b001)))
(assert (fp.leq (fp #b1 #b0111 #b001)
                expect
                (fp #b0 #b0010 #b111)))

(assert (= expect result))

(check-sat)
(exit)
