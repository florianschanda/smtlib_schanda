;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110111011110010 #b00100011011000)
                arg1
                (fp #b1 #b011111111111111 #b11000011001101)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11000011001101)
                arg1
                (fp #b0 #b101000110010101 #b11101101101010)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111000010101100 #b11011010100000)
                arg2
                (fp #b0 #b000000000000000 #b00000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000001)
                arg2
                (fp #b0 #b001010100010011 #b10001101000100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101000011111000 #b10001111010000)
                expect
                (fp #b1 #b011111111111111 #b11000011001101)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11000011001101)
                expect
                (fp #b1 #b011110011101101 #b10101000110001)))

(assert (= expect result))

(check-sat)
(exit)
