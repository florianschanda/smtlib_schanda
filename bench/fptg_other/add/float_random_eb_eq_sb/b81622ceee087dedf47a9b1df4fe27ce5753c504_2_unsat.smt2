; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b1001100 #b000010)
                arg1
                (fp #b0 #b1011000 #b111000)))
(assert (fp.leq (fp #b0 #b1011000 #b111000)
                arg1
                (fp #b0 #b1111101 #b001000)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001111 #b000000)
                arg2
                (fp #b0 #b0100111 #b011101)))
(assert (fp.leq (fp #b0 #b0100111 #b011101)
                arg2
                (fp #b0 #b1010010 #b010110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001001 #b010001)
                expect
                (fp #b0 #b1011000 #b111001)))
(assert (fp.leq (fp #b0 #b1011000 #b111001)
                expect
                (fp #b0 #b1011011 #b001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
