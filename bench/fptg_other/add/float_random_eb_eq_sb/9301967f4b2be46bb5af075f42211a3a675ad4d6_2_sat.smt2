;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010110000000001 #b011111001110010)
                arg1
                (fp #b0 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000000000000000)
                arg1
                (fp #b0 #b1110000011000001 #b001100110000101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100111010101000 #b101110001010111)
                arg2
                (fp #b1 #b1100010001011010 #b111000111000010)))
(assert (fp.leq (fp #b1 #b1100010001011010 #b111000111000010)
                arg2
                (fp #b1 #b0101001000011111 #b011110110110101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110010000101000 #b011000101010011)
                expect
                (fp #b1 #b1100010001011010 #b111000111000010)))
(assert (fp.leq (fp #b1 #b1100010001011010 #b111000111000010)
                expect
                (fp #b0 #b0101111100010010 #b100000001001000)))

(assert (= expect result))

(check-sat)
(exit)
