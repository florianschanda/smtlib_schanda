(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001010 #b10100)
                arg1
                (fp #b1 #b000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000 #b00001)
                arg1
                (fp #b0 #b010111 #b00010)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b010100 #b11110)
                arg2
                (fp #b0 #b011111 #b11010)))
(assert (fp.leq (fp #b0 #b011111 #b11010)
                arg2
                (fp #b0 #b011111 #b11100)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001001 #b00101)
                expect
                (fp #b0 #b011111 #b11001)))
(assert (fp.leq (fp #b0 #b011111 #b11001)
                expect
                (fp #b0 #b110100 #b01110)))

(assert (not (= expect result)))

(check-sat)
(exit)
