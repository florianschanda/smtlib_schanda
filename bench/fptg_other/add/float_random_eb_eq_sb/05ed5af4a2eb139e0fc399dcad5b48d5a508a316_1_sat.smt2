(assert (fp.leq (fp #b0 #b11110111001 #b1110000101)
                arg2
                (fp #b0 #b11111101010 #b1100010001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111100001 #b1101000100)
                expect
                (fp #b0 #b11110111001 #b1110000100)))
(assert (fp.leq (fp #b0 #b11110111001 #b1110000100)
                expect
                (fp #b0 #b11111110100 #b1000011001)))

(assert (= expect result))

(check-sat)
