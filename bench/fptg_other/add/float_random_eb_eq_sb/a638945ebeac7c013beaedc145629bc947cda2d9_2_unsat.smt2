(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1000000 #b101100)
                arg1
                (fp #b0 #b0000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000 #b010000)
                arg1
                (fp #b0 #b0101100 #b110011)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101101 #b111000)
                arg2
                (fp #b0 #b1011111 #b011000)))
(assert (fp.leq (fp #b0 #b1011111 #b011000)
                arg2
                (fp #b0 #b1110100 #b111001)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0111101 #b011001)
                expect
                (fp #b0 #b1011111 #b011001)))
(assert (fp.leq (fp #b0 #b1011111 #b011001)
                expect
                (fp #b0 #b1101000 #b101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
