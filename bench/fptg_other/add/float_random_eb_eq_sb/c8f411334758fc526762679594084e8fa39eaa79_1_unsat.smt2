; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101001 #b000111)
                arg1
                (fp #b0 #b0111111 #b000100)))
(assert (fp.leq (fp #b0 #b0111111 #b000100)
                arg1
                (fp #b0 #b1100110 #b000101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011111 #b011111)
                arg2
                (fp #b0 #b1011100 #b001010)))
(assert (fp.leq (fp #b0 #b1011100 #b001010)
                arg2
                (fp #b0 #b1101110 #b110110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101010 #b010011)
                expect
                (fp #b0 #b1011100 #b001010)))
(assert (fp.leq (fp #b0 #b1011100 #b001010)
                expect
                (fp #b0 #b1110011 #b000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
