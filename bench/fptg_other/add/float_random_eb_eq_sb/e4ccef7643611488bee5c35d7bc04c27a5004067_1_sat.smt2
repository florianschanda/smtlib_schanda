(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001000010 #b001001011)
                arg1
                (fp #b0 #b1001110010 #b011011010)))
(assert (fp.leq (fp #b0 #b1001110010 #b011011010)
                arg1
                (fp #b0 #b1111001101 #b001100010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111100011 #b011101100)
                arg2
                (fp #b1 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0100000000 #b000000000)
                arg2
                (fp #b0 #b0001111101 #b101110010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010011101 #b110110101)
                expect
                (fp #b0 #b1001110010 #b011011001)))
(assert (fp.leq (fp #b0 #b1001110010 #b011011001)
                expect
                (fp #b0 #b1011010010 #b101101010)))

(assert (= expect result))

(check-sat)
(exit)
