; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0011001 #b001000)
                arg1
                (fp #b1 #b0001110 #b111010)))
(assert (fp.leq (fp #b1 #b0001110 #b111010)
                arg1
                (fp #b0 #b1000111 #b011101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0110000 #b001000)
                arg2
                (fp #b1 #b0000000 #b000001)))
(assert (fp.leq (fp #b1 #b0000000 #b000001)
                arg2
                (fp #b0 #b0001110 #b000001)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b011110)
                expect
                (fp #b1 #b0001110 #b111010)))
(assert (fp.leq (fp #b1 #b0001110 #b111010)
                expect
                (fp #b0 #b0101100 #b000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
