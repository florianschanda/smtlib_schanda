(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10100 #b0011)
                arg1
                (fp #b1 #b10001 #b1000)))
(assert (fp.leq (fp #b1 #b10001 #b1000)
                arg1
                (fp #b1 #b00010 #b1001)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1110)
                arg2
                (fp #b0 #b00001 #b0000)))
(assert (fp.leq (fp #b0 #b00001 #b0000)
                arg2
                (fp #b0 #b01000 #b0000)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10010 #b0000)
                expect
                (fp #b1 #b10001 #b1000)))
(assert (fp.leq (fp #b1 #b10001 #b1000)
                expect
                (fp #b0 #b00001 #b0010)))

(assert (not (= expect result)))

(check-sat)
(exit)
