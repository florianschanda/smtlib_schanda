(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0110 #b110)
                arg1
                (fp #b1 #b0110 #b101)))
(assert (fp.leq (fp #b1 #b0110 #b101)
                arg1
                (fp #b0 #b0101 #b010)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b110)
                arg2
                (fp #b0 #b0100 #b011)))
(assert (fp.leq (fp #b0 #b0100 #b011)
                arg2
                (fp #b0 #b0100 #b101)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b111)
                expect
                (fp #b1 #b0110 #b011)))
(assert (fp.leq (fp #b1 #b0110 #b011)
                expect
                (fp #b0 #b1110 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
