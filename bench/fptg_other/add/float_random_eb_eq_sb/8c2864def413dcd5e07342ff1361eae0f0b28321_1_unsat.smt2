(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b100 #b11)
                arg1
                (fp #b0 #b101 #b11)))
(assert (fp.leq (fp #b0 #b101 #b11)
                arg1
                (fp #b0 #b110 #b10)))

(declare-const arg2 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b01)
                arg2
                (fp #b0 #b001 #b00)))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg2
                (fp #b0 #b100 #b00)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b000 #b01)
                expect
                (fp #b0 #b101 #b11)))
(assert (fp.leq (fp #b0 #b101 #b11)
                expect
                (fp #b0 #b110 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
