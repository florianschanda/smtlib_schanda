(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011101001110 #b01010010110)
                arg1
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                arg1
                (fp #b0 #b011011011010 #b00110110000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011100001011 #b11011110100)
                arg2
                (fp #b0 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b11111111111)
                arg2
                (fp #b0 #b000110100101 #b11001010110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111011010101 #b11010000110)
                expect
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                expect
                (fp #b0 #b010101011000 #b10001000100)))

(assert (= expect result))

(check-sat)
(exit)
