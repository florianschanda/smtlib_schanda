; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110110 #b100000011)
                arg1
                (fp #b1 #b0000000000 #b110111001)))
(assert (fp.leq (fp #b1 #b0000000000 #b110111001)
                arg1
                (fp #b0 #b0011101100 #b100011111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010011110 #b101011110)
                arg2
                (fp #b1 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b1 #b0011111011 #b011010100)
                arg2
                (fp #b0 #b0000000000 #b100001001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110001010 #b011101100)
                expect
                (fp #b1 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b1 #b0011111011 #b011010100)
                expect
                (fp #b1 #b0001101010 #b111111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
