; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001001010 #b111100010)
                arg1
                (fp #b0 #b0000000000 #b011110111)))
(assert (fp.leq (fp #b0 #b0000000000 #b011110111)
                arg1
                (fp #b0 #b0001101010 #b110111111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011100101 #b010000010)
                expect
                (fp #b0 #b0000000000 #b111101110)))
(assert (fp.leq (fp #b0 #b0000000000 #b111101110)
                expect
                (fp #b0 #b1110110100 #b100001010)))

(assert (= expect result))

(check-sat)
(exit)
