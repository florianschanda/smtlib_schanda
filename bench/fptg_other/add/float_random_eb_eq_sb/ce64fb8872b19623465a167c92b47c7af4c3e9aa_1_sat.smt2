(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0111111110 #b001110000)
                arg1
                (fp #b0 #b1101001001 #b011010100)))
(assert (fp.leq (fp #b0 #b1101001001 #b011010100)
                arg1
                (fp #b0 #b1110000011 #b011111110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101100100 #b111011101)
                arg2
                (fp #b0 #b1000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b1000001000 #b001010110)
                arg2
                (fp #b0 #b1010100011 #b100101000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011110110 #b001011000)
                expect
                (fp #b0 #b1101001001 #b011010100)))
(assert (fp.leq (fp #b0 #b1101001001 #b011010100)
                expect
                (fp #b0 #b1101100111 #b110100000)))

(assert (= expect result))

(check-sat)
(exit)
