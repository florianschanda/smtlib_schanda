(assert (fp.leq (fp #b1 #b0000001 #b000000)
                arg2
                (fp #b0 #b1001100 #b001001)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010100 #b011110)
                expect
                (fp #b0 #b1000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000110 #b000000)
                expect
                (fp #b0 #b1111000 #b101010)))

(assert (= expect result))

(check-sat)
(exit)
