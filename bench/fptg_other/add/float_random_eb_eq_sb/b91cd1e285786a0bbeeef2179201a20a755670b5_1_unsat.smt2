; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101011 #b01111)
                arg1
                (fp #b0 #b011111 #b00111)))
(assert (fp.leq (fp #b0 #b011111 #b00111)
                arg1
                (fp #b0 #b111011 #b01101)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b101101 #b10110)
                arg2
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                arg2
                (fp #b0 #b010001 #b00001)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010011 #b00110)
                expect
                (fp #b0 #b011111 #b00111)))
(assert (fp.leq (fp #b0 #b011111 #b00111)
                expect
                (fp #b0 #b111011 #b10100)))

(assert (not (= expect result)))

(check-sat)
(exit)
