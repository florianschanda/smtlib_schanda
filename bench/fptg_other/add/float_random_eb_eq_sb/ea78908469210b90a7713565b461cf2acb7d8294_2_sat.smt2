; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10001101111001 #b0001001100101)
                arg1
                (fp #b1 #b01111111111111 #b0111100000110)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0111100000110)
                arg1
                (fp #b0 #b00100100010010 #b1101100100100)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111110000001 #b0101101110000)
                arg2
                (fp #b1 #b11110011011010 #b1000011100000)))
(assert (fp.leq (fp #b1 #b11110011011010 #b1000011100000)
                arg2
                (fp #b0 #b10100010110000 #b1011101100011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110100101010 #b1011111001110)
                expect
                (fp #b1 #b11110011011010 #b1000011100001)))
(assert (fp.leq (fp #b1 #b11110011011010 #b1000011100001)
                expect
                (fp #b1 #b01101000000101 #b0111100000101)))

(assert (= expect result))

(check-sat)
(exit)
