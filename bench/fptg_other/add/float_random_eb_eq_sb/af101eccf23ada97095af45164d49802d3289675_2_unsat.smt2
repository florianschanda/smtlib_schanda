                (fp #b0 #b0111111 #b000110)))
(assert (fp.leq (fp #b0 #b0111111 #b000110)
                arg2
                (fp #b0 #b1010101 #b111110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011010 #b010101)
                expect
                (fp #b0 #b0111111 #b000110)))
(assert (fp.leq (fp #b0 #b0111111 #b000110)
                expect
                (fp #b0 #b1011001 #b011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
