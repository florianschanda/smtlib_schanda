; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b010110)
                arg1
                (fp #b1 #b0111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111 #b000000)
                arg1
                (fp #b0 #b0010010 #b000000)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010000 #b011100)
                arg2
                (fp #b0 #b0000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000 #b111111)
                arg2
                (fp #b0 #b0110111 #b010000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101110 #b100110)
                expect
                (fp #b1 #b0111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111 #b000000)
                expect
                (fp #b0 #b1101100 #b001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
