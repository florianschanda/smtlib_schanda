; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000010111 #b001001110)
                arg1
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b1000010100 #b000001110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011110001 #b001010000)
                arg2
                (fp #b0 #b1100101101 #b000000001)))
(assert (fp.leq (fp #b0 #b1100101101 #b000000001)
                arg2
                (fp #b0 #b1110111011 #b100100101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1010001100 #b111000100)
                expect
                (fp #b0 #b1100101101 #b000000001)))
(assert (fp.leq (fp #b0 #b1100101101 #b000000001)
                expect
                (fp #b0 #b1101110110 #b000011111)))

(assert (= expect result))

(check-sat)
(exit)
