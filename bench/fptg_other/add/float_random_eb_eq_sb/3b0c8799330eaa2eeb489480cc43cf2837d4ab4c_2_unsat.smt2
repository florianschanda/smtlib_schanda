; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b010)
                arg1
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg1
                (fp #b0 #b0010 #b010)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b1010 #b000)
                arg2
                (fp #b0 #b1110 #b001)))
(assert (fp.leq (fp #b0 #b1110 #b001)
                arg2
                (fp #b0 #b1110 #b111)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b0 #b0011 #b010)
                expect
                (fp #b0 #b1110 #b010)))
(assert (fp.leq (fp #b0 #b1110 #b010)
                expect
                (fp #b0 #b1111 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
