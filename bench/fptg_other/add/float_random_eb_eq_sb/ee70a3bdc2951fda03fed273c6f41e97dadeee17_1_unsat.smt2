(assert (fp.leq (fp #b0 #b011111 #b00000)
                arg2
                (fp #b0 #b100100 #b10111)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110110 #b01101)
                expect
                (fp #b1 #b100100 #b10100)))
(assert (fp.leq (fp #b1 #b100100 #b10100)
                expect
                (fp #b1 #b011111 #b00001)))

(assert (not (= expect result)))

