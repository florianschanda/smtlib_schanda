;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b000)
                arg1
                (fp #b1 #b0100 #b110)))
(assert (fp.leq (fp #b1 #b0100 #b110)
                arg1
                (fp #b0 #b0111 #b001)))

(declare-const arg2 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b101)
                arg2
                (fp #b0 #b0111 #b110)))
(assert (fp.leq (fp #b0 #b0111 #b110)
                arg2
                (fp #b0 #b1011 #b100)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b110)
                expect
                (fp #b0 #b0111 #b101)))
(assert (fp.leq (fp #b0 #b0111 #b101)
                expect
                (fp #b0 #b1001 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
