; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101011010 #b11001001100)
                arg1
                (fp #b1 #b011111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b011111111111 #b01100111111)
                arg1
                (fp #b0 #b010101001100 #b01011111101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100011101000 #b00000011011)
                arg2
                (fp #b1 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b00000000000)
                arg2
                (fp #b0 #b100000111110 #b01100001010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110000001 #b10100000111)
                expect
                (fp #b1 #b011111111111 #b01101000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b01101000000)
                expect
                (fp #b0 #b101011000011 #b01010101110)))

(assert (= expect result))

(check-sat)
(exit)
