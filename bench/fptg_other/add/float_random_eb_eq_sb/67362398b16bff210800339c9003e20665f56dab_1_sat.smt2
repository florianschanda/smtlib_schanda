(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111001011 #b0011010000)
                arg1
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                arg1
                (fp #b0 #b11110001001 #b1000011000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101110000 #b0011001010)
                arg2
                (fp #b0 #b00000000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001110101)
                arg2
                (fp #b0 #b11110000001 #b0000111111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b10000100100 #b1001001010)
                expect
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                expect
                (fp #b0 #b11100100000 #b1100111011)))

(assert (= expect result))

(check-sat)
(exit)
