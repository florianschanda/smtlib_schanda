; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001010001 #b100110110)
                arg1
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                arg1
                (fp #b0 #b1011001111 #b001101101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010000110 #b011001010)
                arg2
                (fp #b1 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b1 #b0011111011 #b011010100)
                arg2
                (fp #b0 #b0101101100 #b101001101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110001001 #b101111111)
                expect
                (fp #b0 #b0111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b0111111110 #b111111111)
                expect
                (fp #b0 #b1011010101 #b001000100)))

(assert (= expect result))

(check-sat)
(exit)
