(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b100101)
                arg1
                (fp #b0 #b0000001 #b000000)))
(assert (fp.leq (fp #b0 #b0000001 #b000000)
                arg1
                (fp #b0 #b0010110 #b111001)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010101 #b000101)
                arg2
                (fp #b0 #b1011100 #b001010)))
(assert (fp.leq (fp #b0 #b1011100 #b001010)
                arg2
                (fp #b0 #b1101111 #b110110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010000 #b101101)
                expect
                (fp #b0 #b1011100 #b001011)))
(assert (fp.leq (fp #b0 #b1011100 #b001011)
                expect
                (fp #b0 #b1101001 #b111101)))

(assert (= expect result))

(check-sat)
(exit)
