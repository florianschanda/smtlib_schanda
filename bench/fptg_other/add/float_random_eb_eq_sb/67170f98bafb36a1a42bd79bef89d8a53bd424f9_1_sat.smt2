(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010001100001 #b0011010011011)
                arg1
                (fp #b0 #b11111010101101 #b1000111001100)))
(assert (fp.leq (fp #b0 #b11111010101101 #b1000111001100)
                arg1
                (fp #b0 #b11111111010011 #b1000000001000)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11011101011001 #b0010111111111)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b00100110110011 #b1011101110101)))

(assert (= expect result))

(check-sat)
(exit)
