(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111011 #b010100)
                arg1
                (fp #b1 #b1101101 #b011111)))
(assert (fp.leq (fp #b1 #b1101101 #b011111)
                arg1
                (fp #b0 #b0010111 #b101100)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001011 #b111000)
                arg2
                (fp #b1 #b0000000 #b111111)))
(assert (fp.leq (fp #b1 #b0000000 #b111111)
                arg2
                (fp #b0 #b0110101 #b000110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110011 #b100000)
                expect
                (fp #b1 #b1101101 #b011111)))
(assert (fp.leq (fp #b1 #b1101101 #b011111)
                expect
                (fp #b0 #b0100001 #b000110)))

(assert (= expect result))

(check-sat)
(exit)
