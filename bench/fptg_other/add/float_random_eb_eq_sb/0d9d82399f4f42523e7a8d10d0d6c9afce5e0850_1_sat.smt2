(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110101 #b011001)
                arg1
                (fp #b1 #b1110101 #b010100)))
(assert (fp.leq (fp #b1 #b1110101 #b010100)
                arg1
                (fp #b0 #b0011111 #b111101)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111000 #b011100)
                arg2
                (fp #b0 #b0000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000 #b111111)
                arg2
                (fp #b0 #b1110010 #b000111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111000 #b101101)
                expect
                (fp #b1 #b1110101 #b010011)))
(assert (fp.leq (fp #b1 #b1110101 #b010011)
                expect
                (fp #b0 #b0101100 #b010100)))

(assert (= expect result))

(check-sat)
(exit)
