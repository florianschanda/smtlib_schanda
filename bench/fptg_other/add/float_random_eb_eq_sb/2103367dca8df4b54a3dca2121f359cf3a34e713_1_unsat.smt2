; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0110001 #b010001)
                arg1
                (fp #b1 #b0000000 #b011011)))
(assert (fp.leq (fp #b1 #b0000000 #b011011)
                arg1
                (fp #b0 #b0100001 #b101000)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101001 #b101011)
                arg2
                (fp #b1 #b1011110 #b111111)))
(assert (fp.leq (fp #b1 #b1011110 #b111111)
                arg2
                (fp #b1 #b0101101 #b111010)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111110 #b000011)
                expect
                (fp #b1 #b1011110 #b111111)))
(assert (fp.leq (fp #b1 #b1011110 #b111111)
                expect
                (fp #b0 #b0000110 #b110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
