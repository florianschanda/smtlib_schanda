(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111001 #b100011)
                arg1
                (fp #b1 #b1110101 #b010100)))
(assert (fp.leq (fp #b1 #b1110101 #b010100)
                arg1
                (fp #b1 #b0000010 #b000010)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b001101)
                arg2
                (fp #b1 #b0000000 #b101100)))
(assert (fp.leq (fp #b1 #b0000000 #b101100)
                arg2
                (fp #b0 #b0110111 #b001010)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111011 #b101011)
                expect
                (fp #b1 #b1110101 #b010101)))
(assert (fp.leq (fp #b1 #b1110101 #b010101)
                expect
                (fp #b1 #b0000011 #b100110)))

(assert (= expect result))

(check-sat)
(exit)
