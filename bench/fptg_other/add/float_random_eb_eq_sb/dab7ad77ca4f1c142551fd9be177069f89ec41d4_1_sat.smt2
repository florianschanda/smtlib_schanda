(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0101010 #b001010)
                arg1
                (fp #b0 #b1000011 #b011000)))
(assert (fp.leq (fp #b0 #b1000011 #b011000)
                arg1
                (fp #b0 #b1110000 #b000100)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111010 #b011110)
                arg2
                (fp #b0 #b1111000 #b100111)))
(assert (fp.leq (fp #b0 #b1111000 #b100111)
                arg2
                (fp #b0 #b1111001 #b001101)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0111110 #b010110)
                expect
                (fp #b0 #b1111000 #b100111)))
(assert (fp.leq (fp #b0 #b1111000 #b100111)
                expect
                (fp #b0 #b1111101 #b110000)))

(assert (= expect result))

(check-sat)
(exit)
