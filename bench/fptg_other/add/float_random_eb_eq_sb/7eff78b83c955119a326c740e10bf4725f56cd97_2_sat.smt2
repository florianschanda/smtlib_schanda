(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010101 #b010111)
                arg1
                (fp #b1 #b0111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111 #b000000)
                arg1
                (fp #b0 #b0111100 #b111111)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110001 #b100011)
                arg2
                (fp #b1 #b1100100 #b101000)))
(assert (fp.leq (fp #b1 #b1100100 #b101000)
                arg2
                (fp #b1 #b0001011 #b001000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111001 #b010100)
                expect
                (fp #b1 #b1100100 #b101001)))
(assert (fp.leq (fp #b1 #b1100100 #b101001)
                expect
                (fp #b0 #b1100111 #b110010)))

(assert (= expect result))

(check-sat)
(exit)
