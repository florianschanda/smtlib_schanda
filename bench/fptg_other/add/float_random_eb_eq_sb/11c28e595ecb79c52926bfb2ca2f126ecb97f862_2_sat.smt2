(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011001000 #b001000110)
                arg1
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg1
                (fp #b0 #b1111111110 #b100110111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100001 #b110100111)
                arg2
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                arg2
                (fp #b0 #b1111110010 #b111011110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1110010000 #b011001000)
                expect
                (fp #b0 #b1111111101 #b000000001)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000001)
                expect
                (fp #b0 #b1111111101 #b001100010)))

(assert (= expect result))

(check-sat)
(exit)
