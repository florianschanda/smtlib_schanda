(assert (fp.leq (fp #b1 #b00010101100 #b0100111000)
                arg2
                (fp #b0 #b01001010010 #b0100110111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010101000 #b1101000101)
                expect
                (fp #b0 #b11010100000 #b0100011000)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011000)
                expect
                (fp #b0 #b11101101111 #b0111111111)))

(assert (not (= expect result)))

