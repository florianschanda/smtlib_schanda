; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b10111100111 #b1101001100)
                arg1
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                arg1
                (fp #b0 #b11010100101 #b1011011010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01010011011 #b1110011100)
                arg2
                (fp #b0 #b11110111001 #b1110000101)))
(assert (fp.leq (fp #b0 #b11110111001 #b1110000101)
                arg2
                (fp #b0 #b11111000100 #b1111110100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01010111111 #b1000111010)
                expect
                (fp #b0 #b11110111001 #b1110000101)))
(assert (fp.leq (fp #b0 #b11110111001 #b1110000101)
                expect
                (fp #b0 #b11111111000 #b0011111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
