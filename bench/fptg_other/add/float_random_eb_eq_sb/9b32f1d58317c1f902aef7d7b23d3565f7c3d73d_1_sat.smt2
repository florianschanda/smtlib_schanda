                arg2
                (fp #b0 #b000000 #b00001)))
(assert (fp.leq (fp #b0 #b000000 #b00001)
                arg2
                (fp #b0 #b010110 #b11000)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b011110 #b11011)
                expect
                (fp #b0 #b000000 #b00010)))
(assert (fp.leq (fp #b0 #b000000 #b00010)
                expect
                (fp #b0 #b011010 #b00100)))

(assert (= expect result))

(check-sat)
(exit)
