(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b10010)
                arg1
                (fp #b1 #b011111 #b10110)))
(assert (fp.leq (fp #b1 #b011111 #b10110)
                arg1
                (fp #b0 #b110111 #b11110)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b101110 #b01111)
                arg2
                (fp #b1 #b000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000 #b00000)
                arg2
                (fp #b0 #b100001 #b11001)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100111 #b01001)
                expect
                (fp #b1 #b011111 #b10110)))
(assert (fp.leq (fp #b1 #b011111 #b10110)
                expect
                (fp #b0 #b011011 #b01010)))

(assert (not (= expect result)))

(check-sat)
(exit)
