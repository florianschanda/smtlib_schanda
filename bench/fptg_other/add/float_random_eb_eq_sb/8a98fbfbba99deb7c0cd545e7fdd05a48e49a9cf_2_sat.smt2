;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010110010 #b00000110)
                arg1
                (fp #b1 #b000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111111)
                arg1
                (fp #b0 #b000110010 #b10110110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111010101 #b00100110)
                arg2
                (fp #b1 #b110000111 #b00001010)))
(assert (fp.leq (fp #b1 #b110000111 #b00001010)
                arg2
                (fp #b1 #b010111101 #b01000110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000000 #b11100101)
                expect
                (fp #b1 #b110000111 #b00001011)))
(assert (fp.leq (fp #b1 #b110000111 #b00001011)
                expect
                (fp #b0 #b001000010 #b10101000)))

(assert (= expect result))

(check-sat)
(exit)
