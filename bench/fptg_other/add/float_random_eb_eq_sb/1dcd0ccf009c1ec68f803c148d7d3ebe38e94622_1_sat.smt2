(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011100 #b100100)
                arg1
                (fp #b1 #b0011101 #b000000)))
(assert (fp.leq (fp #b1 #b0011101 #b000000)
                arg1
                (fp #b1 #b0000100 #b010000)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b110001)
                arg2
                (fp #b1 #b1111101 #b010111)))
(assert (fp.leq (fp #b1 #b1111101 #b010111)
                arg2
                (fp #b0 #b0011011 #b010000)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b111010)
                expect
                (fp #b1 #b1111101 #b010111)))
(assert (fp.leq (fp #b1 #b1111101 #b010111)
                expect
                (fp #b1 #b0111000 #b110110)))

(assert (= expect result))

(check-sat)
(exit)
