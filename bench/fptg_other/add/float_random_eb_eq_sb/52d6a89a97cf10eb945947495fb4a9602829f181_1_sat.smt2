(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111010 #b10010)
                arg1
                (fp #b0 #b000000 #b11101)))
(assert (fp.leq (fp #b0 #b000000 #b11101)
                arg1
                (fp #b0 #b000010 #b01111)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110001 #b00111)
                arg2
                (fp #b1 #b100100 #b11110)))
(assert (fp.leq (fp #b1 #b100100 #b11110)
                arg2
                (fp #b1 #b100010 #b00100)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110000 #b01101)
                expect
                (fp #b1 #b100100 #b11101)))
(assert (fp.leq (fp #b1 #b100100 #b11101)
                expect
                (fp #b0 #b110101 #b10101)))

(assert (= expect result))

(check-sat)
(exit)
