(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000101 #b01010000)
                arg1
                (fp #b1 #b011111111 #b01010101)))
(assert (fp.leq (fp #b1 #b011111111 #b01010101)
                arg1
                (fp #b0 #b110000011 #b01111011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b110001110 #b00101010)
                arg2
                (fp #b0 #b000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000)
                arg2
                (fp #b0 #b101000011 #b10010100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010100 #b01001111)
                expect
                (fp #b1 #b011111111 #b01010101)))
(assert (fp.leq (fp #b1 #b011111111 #b01010101)
                expect
                (fp #b1 #b011000000 #b00010100)))

(assert (= expect result))

(check-sat)
(exit)
