; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01100 #b0100)
                arg1
                (fp #b0 #b11100 #b1111)))
(assert (fp.leq (fp #b0 #b11100 #b1111)
                arg1
                (fp #b0 #b11101 #b0010)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00110 #b1101)
                arg2
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                arg2
                (fp #b0 #b11101 #b1110)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1000)
                expect
                (fp #b0 #b11100 #b1111)))
(assert (fp.leq (fp #b0 #b11100 #b1111)
                expect
                (fp #b0 #b11101 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
