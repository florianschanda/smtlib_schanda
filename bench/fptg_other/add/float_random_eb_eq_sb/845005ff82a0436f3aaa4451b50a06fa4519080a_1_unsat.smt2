; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0111110011101110 #b000000100110101)
                arg1
                (fp #b1 #b0010110010100101 #b101001001111101)))
(assert (fp.leq (fp #b1 #b0010110010100101 #b101001001111101)
                arg1
                (fp #b0 #b1111010111010011 #b011011100100011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0010010111000010 #b000101011000110)
                arg2
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                arg2
                (fp #b0 #b1111000100001101 #b001001110111000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010110111010010 #b101011011101010)
                expect
                (fp #b1 #b0010110010100101 #b101001001111101)))
(assert (fp.leq (fp #b1 #b0010110010100101 #b101001001111101)
                expect
                (fp #b0 #b1100001011011010 #b101111111101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
