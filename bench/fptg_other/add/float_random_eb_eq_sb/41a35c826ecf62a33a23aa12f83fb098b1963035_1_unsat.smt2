                arg2
                (fp #b0 #b0111111 #b111101)))
(assert (fp.leq (fp #b0 #b0111111 #b111101)
                arg2
                (fp #b0 #b1001010 #b001110)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0001110 #b110001)
                expect
                (fp #b0 #b1000000 #b100000)))
(assert (fp.leq (fp #b0 #b1000000 #b100000)
                expect
                (fp #b0 #b1011011 #b000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
