(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1000)
                arg1
                (fp #b1 #b00000 #b0011)))
(assert (fp.leq (fp #b1 #b00000 #b0011)
                arg1
