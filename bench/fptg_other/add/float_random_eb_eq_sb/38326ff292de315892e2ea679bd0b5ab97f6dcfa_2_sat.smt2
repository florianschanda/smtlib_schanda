(assert (fp.leq (fp #b0 #b10000001010 #b0000000000)
                arg2
                (fp #b0 #b10000101001 #b0100110000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100011000 #b1011110110)
                expect
                (fp #b1 #b10011101010 #b1110101001)))
(assert (fp.leq (fp #b1 #b10011101010 #b1110101001)
                expect
                (fp #b0 #b00111000001 #b1001001010)))

(assert (= expect result))

(check-sat)
