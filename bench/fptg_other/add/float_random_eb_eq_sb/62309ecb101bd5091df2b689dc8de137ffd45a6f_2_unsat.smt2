; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001011 #b01010)
                arg1
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                arg1
                (fp #b0 #b110110 #b00011)))

(declare-const arg2 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000010 #b11010)
                arg2
                (fp #b0 #b100011 #b00110)))
(assert (fp.leq (fp #b0 #b100011 #b00110)
                arg2
                (fp #b0 #b100100 #b10000)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000110 #b10010)
                expect
                (fp #b0 #b100101 #b01010)))
(assert (fp.leq (fp #b0 #b100101 #b01010)
                expect
                (fp #b0 #b111000 #b11110)))

(assert (not (= expect result)))

(check-sat)
(exit)
