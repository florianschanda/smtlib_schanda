(assert (fp.leq (fp #b1 #b00111111011 #b0000000000)
                arg2
                (fp #b0 #b00010110101 #b1110111110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011110100 #b1110000111)
                expect
                (fp #b0 #b11010100000 #b0100011001)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011001)
                expect
                (fp #b0 #b11100001011 #b0100111111)))

(assert (= expect result))

(check-sat)
