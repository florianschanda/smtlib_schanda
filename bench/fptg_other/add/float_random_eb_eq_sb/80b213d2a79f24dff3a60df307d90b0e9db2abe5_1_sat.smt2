; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001101 #b00010100)
                arg1
                (fp #b1 #b001111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111100 #b00000000)
                arg1
                (fp #b0 #b011101101 #b10000111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110000 #b10111111)
                arg2
                (fp #b0 #b111011111 #b11011111)))
(assert (fp.leq (fp #b0 #b111011111 #b11011111)
                arg2
                (fp #b0 #b111101110 #b11110111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101111 #b11001010)
                expect
                (fp #b0 #b111011111 #b11011110)))
(assert (fp.leq (fp #b0 #b111011111 #b11011110)
                expect
                (fp #b0 #b111101110 #b00001111)))

(assert (= expect result))

(check-sat)
(exit)
