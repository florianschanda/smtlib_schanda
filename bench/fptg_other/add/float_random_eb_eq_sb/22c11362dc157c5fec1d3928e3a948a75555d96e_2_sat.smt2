;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101110011 #b111000011)
                arg1
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b1011100100 #b001000000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001100100 #b100110101)
                arg2
                (fp #b0 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1011111110 #b111111111)
                arg2
                (fp #b0 #b1101000010 #b101111110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011010 #b001101001)
                expect
                (fp #b0 #b1011111111 #b000000000)))
(assert (fp.leq (fp #b0 #b1011111111 #b000000000)
                expect
                (fp #b0 #b1100110111 #b010100000)))

(assert (= expect result))

(check-sat)
(exit)
