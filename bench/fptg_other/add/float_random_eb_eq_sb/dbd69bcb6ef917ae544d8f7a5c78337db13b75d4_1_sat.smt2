(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00001 #b1110)
                arg1
                (fp #b0 #b10100 #b0000)))
(assert (fp.leq (fp #b0 #b10100 #b0000)
                arg1
                (fp #b0 #b11001 #b1001)))

(declare-const arg2 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0111)
                arg2
                (fp #b0 #b01111 #b1101)))
(assert (fp.leq (fp #b0 #b01111 #b1101)
                arg2
                (fp #b0 #b10101 #b1100)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00000 #b1000)
                expect
                (fp #b0 #b10100 #b0000)))
(assert (fp.leq (fp #b0 #b10100 #b0000)
                expect
                (fp #b0 #b11101 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
