                arg2
                (fp #b0 #b10011 #b0001)))
(assert (fp.leq (fp #b0 #b10011 #b0001)
                arg2
                (fp #b0 #b11101 #b0000)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01110 #b1001)
                expect
                (fp #b0 #b10011 #b0010)))
(assert (fp.leq (fp #b0 #b10011 #b0010)
                expect
                (fp #b0 #b11011 #b0111)))

(assert (not (= expect result)))

(check-sat)
(exit)
