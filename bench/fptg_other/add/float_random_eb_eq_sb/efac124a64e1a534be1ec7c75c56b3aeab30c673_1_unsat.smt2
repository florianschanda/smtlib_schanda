(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0101001 #b110111)
                arg1
                (fp #b0 #b0100100 #b100111)))
(assert (fp.leq (fp #b0 #b0100100 #b100111)
                arg1
                (fp #b0 #b1001010 #b111000)))

(declare-const arg2 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011011 #b101111)
                arg2
                (fp #b0 #b1000101 #b101000)))
(assert (fp.leq (fp #b0 #b1000101 #b101000)
                arg2
                (fp #b0 #b1001111 #b000010)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0111011 #b100111)
                expect
                (fp #b0 #b1000101 #b101000)))
(assert (fp.leq (fp #b0 #b1000101 #b101000)
                expect
                (fp #b0 #b1111101 #b000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
