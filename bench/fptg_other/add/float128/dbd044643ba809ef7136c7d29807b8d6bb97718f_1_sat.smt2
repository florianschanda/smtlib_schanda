; Format: FLOAT128
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.leq (fp #b1 #b101011110011110 #b1100101001000000001110000101101001001111010010010110011100010011111110001100110100101101100110110110111101101011)
                arg1
                (fp #b0 #b010100101010000 #b0101110001111110110001001011000011010010010101000110011000110010100000101000000001011110100101100001110110001001)))
(assert (fp.leq (fp #b0 #b010100101010000 #b0101110001111110110001001011000011010010010101000110011000110010100000101000000001011110100101100001110110001001)
                arg1
                (fp #b0 #b100000110000000 #b1100101011110010100101101000111110101011101000011110110000111011100010100101010100010101000011001001101000000001)))

(declare-const arg2 Float128)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
