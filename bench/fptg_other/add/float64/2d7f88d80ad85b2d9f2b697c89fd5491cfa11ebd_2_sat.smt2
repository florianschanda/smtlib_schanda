(assert (fp.leq (fp #b1 #b11000001101 #b1000011101100111100001110101101100110111111010111011)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b1 #b01101100001 #b1011010100000110100111110111010110111011000101100100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101100110 #b0101111100110010111100010001010011010011001010011011)
                expect
