                arg2
                (fp #b0 #b01010111011 #b0001000110101110010001001010011011000100111001101111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110011110 #b1101010001000110000010010111010110111100001010111010)
                expect
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111111101 #b0011001010000101010101111110001000111101000000010101)))

(assert (= expect result))

(check-sat)
(exit)
