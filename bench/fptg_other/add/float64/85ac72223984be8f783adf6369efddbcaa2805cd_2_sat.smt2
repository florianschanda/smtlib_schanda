(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011101010 #b0101111011000011100111001101101101111100010101001100)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b00110101011 #b0010101010111110101000101010110110011001110001111000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01110011110 #b1001010000011011101000011001000111000001010110000000)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111101 #b1011110110111100000000010001100010111110000001111101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01011100001 #b0001110100110101110101011000001110100000000010010011)
                expect
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111111110 #b1001101011000010101001110101110010010110100111100101)))

(assert (= expect result))

(check-sat)
(exit)
