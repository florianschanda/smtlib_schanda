                arg1
                (fp #b0 #b10101011110 #b1111001101011001100100111000101001001101100011001100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111101000 #b1101010100110000001001110101010110101110100000110000)
                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b11010110101 #b0011111110111101100111011000000000110010010000111000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110000010 #b1101101010001100100110100100010101010010101100010100)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011001)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011001)
                expect
                (fp #b0 #b11000010101 #b0100011011110110010011000010000110000011011100111100)))

(assert (= expect result))

(check-sat)
(exit)
