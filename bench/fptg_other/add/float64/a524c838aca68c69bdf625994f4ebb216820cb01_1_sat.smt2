                arg2
                (fp #b0 #b11111110100 #b1010010010101001100010110100111010100100101100100111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111111000 #b0101101000111101011011010001110100100010101111000011)
                expect
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110100)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110100)
                expect
                (fp #b0 #b10110110011 #b0101111011010011001111010001011100000000101110001001)))

(assert (= expect result))

(check-sat)
(exit)
