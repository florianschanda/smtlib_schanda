(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INFINITY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001011000 #b1101011111110110001001101000110011101010010010011001)
                arg1
                (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)))
(assert (fp.leq (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)
                arg1
                (fp #b0 #b10111001000 #b1100111101000000111010111001001001000100010011101001)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
