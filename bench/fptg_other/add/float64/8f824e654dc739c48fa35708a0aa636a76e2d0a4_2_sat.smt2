                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11101000110 #b1000001100001010000110011001101100001010001010000010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000101110 #b1010000110111100100101010101000110011011011100010000)
                expect
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11000111010 #b0010101111111100011001011010110110110100101101000010)))

(assert (= expect result))

(check-sat)
(exit)
