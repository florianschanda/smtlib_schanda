                (fp #b0 #b11011011001 #b0110101110010111001010101101110100001010110101000000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001111001 #b1111101000010101000001010010110011101100001011100100)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b10001110010 #b0100100000001010110110001010000111100011010010011111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01001101100 #b1110011100111110110010100111111010110011010000010010)
                expect
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b1 #b00110000000 #b1010001100011010011011100101001110001110010101111110)))

(assert (= expect result))

(check-sat)
(exit)
