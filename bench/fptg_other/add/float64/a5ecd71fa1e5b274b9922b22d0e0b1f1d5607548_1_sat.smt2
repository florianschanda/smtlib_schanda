; Format: FLOAT64
; Arg1: -NAN
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110000011 #b0101010100010111001101001010011010010011011111110100)
                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b11001111111 #b1101010000010001010100101011110010110011101110111010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
