; Format: FLOAT64
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00111011101 #b1011111000101101001010011111011010010110111010000101)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111011101 #b1011111011011011001000100101100001011010111010101011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01101011001 #b1001100011000111100010101110010110111000100100010011)
                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b11000000110 #b0111010101001100110101000011000111111001010000101000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100101010 #b1000011110001000010010100111001011010110111111000001)
                expect
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                expect
                (fp #b0 #b11110010100 #b0101001010010100001101101001011001000110010000101110)))

(assert (= expect result))

(check-sat)
(exit)
