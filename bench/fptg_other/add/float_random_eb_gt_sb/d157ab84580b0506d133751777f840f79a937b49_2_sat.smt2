; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10110010111 #b00010)
                arg1
                (fp #b0 #b11110010110 #b00010)))
(assert (fp.leq (fp #b0 #b11110010110 #b00010)
                arg1
                (fp #b0 #b11110101100 #b10011)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01100000011 #b10100)
                arg2
                (fp #b0 #b10000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000101 #b00000)
                arg2
                (fp #b0 #b11111111100 #b10111)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b11001001011 #b10011)
                expect
                (fp #b0 #b11110010110 #b00011)))
(assert (fp.leq (fp #b0 #b11110010110 #b00011)
                expect
                (fp #b0 #b11111111100 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
