(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010100 #b011)
                arg1
                (fp #b0 #b000000 #b110)))
(assert (fp.leq (fp #b0 #b000000 #b110)
                arg1
                (fp #b0 #b110001 #b000)))

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110101 #b111)
                arg2
                (fp #b1 #b100010 #b001)))
(assert (fp.leq (fp #b1 #b100010 #b001)
                arg2
                (fp #b0 #b101000 #b011)))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100101 #b010)
                expect
                (fp #b1 #b100010 #b001)))
(assert (fp.leq (fp #b1 #b100010 #b001)
                expect
                (fp #b1 #b010101 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
