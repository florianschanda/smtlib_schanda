; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1100010 #b0110)
                arg1
                (fp #b0 #b1000010 #b0000)))
(assert (fp.leq (fp #b0 #b1000010 #b0000)
                arg1
                (fp #b0 #b1010110 #b0010)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0101010 #b0111)
                arg2
                (fp #b1 #b0010111 #b0010)))
(assert (fp.leq (fp #b1 #b0010111 #b0010)
                arg2
                (fp #b0 #b1110011 #b1011)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1000101 #b1011)
                expect
                (fp #b0 #b1000001 #b1111)))
(assert (fp.leq (fp #b0 #b1000001 #b1111)
                expect
                (fp #b0 #b1110010 #b1010)))

(assert (not (= expect result)))

(check-sat)
(exit)
