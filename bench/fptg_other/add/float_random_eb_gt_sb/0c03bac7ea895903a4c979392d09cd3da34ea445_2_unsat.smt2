(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11011100101 #b10)
                arg1
                (fp #b1 #b10000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000010 #b00)
                arg1
                (fp #b0 #b11101110111 #b00)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b00111111111 #b01)
                arg2
                (fp #b0 #b01000000000 #b00)))
(assert (fp.leq (fp #b0 #b01000000000 #b00)
                arg2
                (fp #b0 #b11001001011 #b11)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10001100010 #b11)
                expect
                (fp #b1 #b10000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000010 #b00)
                expect
                (fp #b0 #b11010111001 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
