; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0000101111011 #b00111)
                arg1
                (fp #b0 #b0000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00001)
                arg1
                (fp #b0 #b1110110111011 #b10000)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0111101000100 #b11111)
                arg2
                (fp #b0 #b1100110101010 #b11111)))
(assert (fp.leq (fp #b0 #b1100110101010 #b11111)
                arg2
                (fp #b0 #b1101010100000 #b10101)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1111100111010 #b11011)
                expect
                (fp #b0 #b1100110101010 #b11111)))
(assert (fp.leq (fp #b0 #b1100110101010 #b11111)
                expect
                (fp #b0 #b1110111110100 #b11111)))

(assert (= expect result))

(check-sat)
(exit)
