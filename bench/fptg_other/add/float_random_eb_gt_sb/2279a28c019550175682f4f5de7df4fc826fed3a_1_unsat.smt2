(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11101001 #b1)
                arg1
                (fp #b1 #b00111111 #b1)))
(assert (fp.leq (fp #b1 #b00111111 #b1)
                arg1
                (fp #b0 #b11001001 #b0)))

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b01101111 #b1)
                arg2
                (fp #b0 #b01111111 #b1)))
(assert (fp.leq (fp #b0 #b01111111 #b1)
                arg2
                (fp #b0 #b10101101 #b1)))

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11000110 #b1)
                expect
                (fp #b0 #b01111111 #b0)))
(assert (fp.leq (fp #b0 #b01111111 #b0)
                expect
                (fp #b0 #b11110011 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
