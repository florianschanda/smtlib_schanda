; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000110011001 #b0111111)
                arg1
                (fp #b0 #b000000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000001 #b0000000)
                arg1
                (fp #b0 #b111011111000 #b1100001)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111011 #b0110100)
                arg2
                (fp #b1 #b111111110100 #b1001101)))
(assert (fp.leq (fp #b1 #b111111110100 #b1001101)
                arg2
                (fp #b0 #b000010000110 #b0111100)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111011 #b1001001)
                expect
                (fp #b1 #b111111110100 #b1001101)))
(assert (fp.leq (fp #b1 #b111111110100 #b1001101)
                expect
                (fp #b0 #b000111100101 #b0100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
