(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101001 #b11001)
                arg1
                (fp #b1 #b0011101 #b01101)))
(assert (fp.leq (fp #b1 #b0011101 #b01101)
                arg1
                (fp #b1 #b0010011 #b10101)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b0000111 #b10100)
                arg2
                (fp #b0 #b1100001 #b00010)))
(assert (fp.leq (fp #b0 #b1100001 #b00010)
                arg2
                (fp #b0 #b1100111 #b10110)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b0 #b1010011 #b10011)
                expect
                (fp #b0 #b1100001 #b00010)))
(assert (fp.leq (fp #b0 #b1100001 #b00010)
                expect
                (fp #b0 #b1111011 #b01101)))

(assert (not (= expect result)))

(check-sat)
(exit)
