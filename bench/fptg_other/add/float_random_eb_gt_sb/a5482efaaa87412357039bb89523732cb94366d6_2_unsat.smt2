(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010011 #b011)
                arg1
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                arg1
                (fp #b0 #b100111 #b111)))

(declare-const arg2 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010101 #b111)
                arg2
                (fp #b1 #b010000 #b000)))
(assert (fp.leq (fp #b1 #b010000 #b000)
                arg2
                (fp #b1 #b000111 #b100)))

(declare-const result (_ FloatingPoint 6 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110110 #b001)
                expect
                (fp #b0 #b100011 #b000)))
(assert (fp.leq (fp #b0 #b100011 #b000)
                expect
                (fp #b0 #b101100 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
