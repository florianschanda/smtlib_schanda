(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111110010 #b011)
                arg1
                (fp #b1 #b1111011010 #b011)))
(assert (fp.leq (fp #b1 #b1111011010 #b011)
                arg1
                (fp #b1 #b1010101100 #b110)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0001010110 #b110)
                arg2
                (fp #b0 #b0001100101 #b111)))
(assert (fp.leq (fp #b0 #b0001100101 #b111)
                arg2
                (fp #b0 #b1100000101 #b001)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111100010 #b001)
                expect
                (fp #b1 #b1111011010 #b011)))
(assert (fp.leq (fp #b1 #b1111011010 #b011)
                expect
                (fp #b0 #b1010001110 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
