(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b00000100 #b01100)
                arg1
                (fp #b0 #b01111111 #b00111)))
(assert (fp.leq (fp #b0 #b01111111 #b00111)
                arg1
                (fp #b0 #b11101101 #b00000)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b01101001 #b01100)
                arg2
                (fp #b0 #b10101101 #b01011)))
(assert (fp.leq (fp #b0 #b10101101 #b01011)
                arg2
                (fp #b0 #b10110100 #b11010)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10110100 #b00011)
                expect
                (fp #b0 #b10101101 #b01100)))
(assert (fp.leq (fp #b0 #b10101101 #b01100)
                expect
                (fp #b0 #b11000000 #b10101)))

(assert (= expect result))

(check-sat)
(exit)
