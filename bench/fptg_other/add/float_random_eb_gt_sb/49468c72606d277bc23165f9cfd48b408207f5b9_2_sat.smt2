(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1010000 #b00100)
                arg1
                (fp #b1 #b1000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000101 #b00000)
                arg1
                (fp #b0 #b0110111 #b11000)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1000101 #b00100)
                arg2
                (fp #b1 #b0000000 #b10001)))
(assert (fp.leq (fp #b1 #b0000000 #b10001)
                arg2
                (fp #b0 #b1000100 #b00100)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1100100 #b10000)
                expect
                (fp #b1 #b1000101 #b00001)))
(assert (fp.leq (fp #b1 #b1000101 #b00001)
                expect
                (fp #b0 #b1001001 #b10111)))

(assert (= expect result))

(check-sat)
(exit)
