; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1011000 #b1011)
                arg1
                (fp #b1 #b0111111 #b1010)))
(assert (fp.leq (fp #b1 #b0111111 #b1010)
                arg1
                (fp #b1 #b0011011 #b0011)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1101111 #b0011)
                arg2
                (fp #b1 #b1011010 #b1100)))
(assert (fp.leq (fp #b1 #b1011010 #b1100)
                arg2
                (fp #b1 #b0111111 #b0010)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110110 #b1001)
                expect
                (fp #b1 #b1011010 #b1101)))
(assert (fp.leq (fp #b1 #b1011010 #b1101)
                expect
                (fp #b1 #b0001010 #b0010)))

(assert (not (= expect result)))

(check-sat)
(exit)
