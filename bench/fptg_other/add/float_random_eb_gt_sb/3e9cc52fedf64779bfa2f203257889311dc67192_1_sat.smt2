(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b01011000 #b111110)
                arg1
                (fp #b0 #b00000000 #b010000)))
(assert (fp.leq (fp #b0 #b00000000 #b010000)
                arg1
                (fp #b0 #b10011000 #b110010)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10011011 #b101001)
                arg2
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                arg2
                (fp #b0 #b11111001 #b101010)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10001000 #b010000)
                expect
                (fp #b0 #b10000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000110 #b000000)
                expect
                (fp #b0 #b10111001 #b110100)))

(assert (= expect result))

(check-sat)
(exit)
