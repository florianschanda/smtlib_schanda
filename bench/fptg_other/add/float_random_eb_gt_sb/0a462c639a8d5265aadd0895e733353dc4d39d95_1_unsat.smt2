(assert (fp.leq (fp #b1 #b10000001001 #b000000000)
                arg2
                (fp #b1 #b00111011111 #b100000110)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10000101100 #b101110001)
                expect
                (fp #b1 #b10000001000 #b111111111)))
(assert (fp.leq (fp #b1 #b10000001000 #b111111111)
                expect
                (fp #b0 #b10101011000 #b110000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
