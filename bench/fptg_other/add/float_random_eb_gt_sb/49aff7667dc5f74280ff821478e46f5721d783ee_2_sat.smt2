;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b00111111101101 #b011111000001)
                arg1
                (fp #b1 #b00010101101100 #b001010100111)))
(assert (fp.leq (fp #b1 #b00010101101100 #b001010100111)
                arg1
                (fp #b0 #b10011010111100 #b100001001001)))

(declare-const arg2 (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b10010001011000 #b011100001010)
                arg2
                (fp #b0 #b10001100101110 #b101111001001)))
(assert (fp.leq (fp #b0 #b10001100101110 #b101111001001)
                arg2
                (fp #b0 #b10110100111000 #b110000110000)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b01110011001001 #b110010001000)
                expect
                (fp #b0 #b10001100101110 #b101111001001)))
(assert (fp.leq (fp #b0 #b10001100101110 #b101111001001)
                expect
                (fp #b0 #b11010101010111 #b000111001011)))

(assert (= expect result))

(check-sat)
(exit)
