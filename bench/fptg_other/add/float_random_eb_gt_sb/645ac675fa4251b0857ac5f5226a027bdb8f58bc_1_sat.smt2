(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01001111 #b0101)
                arg1
                (fp #b0 #b00000000 #b1111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111)
                arg1
                (fp #b0 #b01010001 #b1001)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01000101 #b0100)
                arg2
                (fp #b1 #b00000001 #b0000)))
(assert (fp.leq (fp #b1 #b00000001 #b0000)
                arg2
                (fp #b0 #b10010101 #b1011)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00110000 #b0100)
                expect
                (fp #b1 #b00000000 #b0001)))
(assert (fp.leq (fp #b1 #b00000000 #b0001)
                expect
                (fp #b0 #b00110111 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
