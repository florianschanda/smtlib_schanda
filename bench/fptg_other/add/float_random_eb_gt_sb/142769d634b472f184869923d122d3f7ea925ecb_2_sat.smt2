(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111001 #b100)
                arg1
                (fp #b1 #b1011110 #b111)))
(assert (fp.leq (fp #b1 #b1011110 #b111)
                arg1
                (fp #b1 #b0110111 #b111)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0110011 #b010)
                arg2
                (fp #b1 #b0011100 #b011)))
(assert (fp.leq (fp #b1 #b0011100 #b011)
                arg2
                (fp #b0 #b1110111 #b110)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1100111 #b000)
                expect
                (fp #b1 #b1011111 #b000)))
(assert (fp.leq (fp #b1 #b1011111 #b000)
                expect
                (fp #b0 #b0000001 #b111)))

(assert (= expect result))

(check-sat)
(exit)
