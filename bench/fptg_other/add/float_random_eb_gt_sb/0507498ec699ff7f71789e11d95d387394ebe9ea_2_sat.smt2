(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10110110 #b00001)
                arg1
                (fp #b0 #b00000000 #b11101)))
(assert (fp.leq (fp #b0 #b00000000 #b11101)
                arg1
                (fp #b0 #b10000011 #b11011)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111001 #b11001)
                arg2
                (fp #b1 #b01111111 #b00110)))
(assert (fp.leq (fp #b1 #b01111111 #b00110)
                arg2
                (fp #b0 #b01000001 #b10011)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10101001 #b00111)
                expect
                (fp #b1 #b01111111 #b00110)))
(assert (fp.leq (fp #b1 #b01111111 #b00110)
                expect
                (fp #b0 #b01001011 #b11100)))

(assert (= expect result))

(check-sat)
(exit)
