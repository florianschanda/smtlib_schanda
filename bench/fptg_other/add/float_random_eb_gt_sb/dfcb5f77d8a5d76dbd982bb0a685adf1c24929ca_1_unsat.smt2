(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111111110 #b0011)
                arg1
                (fp #b1 #b111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111101 #b0000)
                arg1
                (fp #b1 #b001110010 #b1100)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111001100 #b0001)
                arg2
                (fp #b1 #b111000101 #b0010)))
(assert (fp.leq (fp #b1 #b111000101 #b0010)
                arg2
                (fp #b0 #b000110000 #b0011)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111111101 #b0010)
                expect
                (fp #b1 #b111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111101 #b0000)
                expect
                (fp #b1 #b001000010 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
