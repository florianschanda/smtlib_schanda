; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b01011011011 #b000111)
                arg1
                (fp #b0 #b10000000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000000110 #b000000)
                arg1
                (fp #b0 #b10100011000 #b110000)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11101011000 #b000101)
                arg2
                (fp #b1 #b01111111111 #b100001)))
(assert (fp.leq (fp #b1 #b01111111111 #b100001)
                arg2
                (fp #b1 #b00110001111 #b110011)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11100001100 #b100001)
                expect
                (fp #b0 #b10000000101 #b111110)))
(assert (fp.leq (fp #b0 #b10000000101 #b111110)
                expect
                (fp #b0 #b10000110111 #b101001)))

(assert (= expect result))

(check-sat)
(exit)
