(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b110)
                arg1
                (fp #b1 #b11110 #b100)))
(assert (fp.leq (fp #b1 #b11110 #b100)
                arg1
                (fp #b0 #b11010 #b010)))

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01000 #b000)
                arg2
                (fp #b1 #b00000 #b010)))
(assert (fp.leq (fp #b1 #b00000 #b010)
                arg2
                (fp #b0 #b01000 #b000)))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                expect
                (fp #b1 #b11110 #b101)))
(assert (fp.leq (fp #b1 #b11110 #b101)
                expect
                (fp #b1 #b01111 #b011)))

(assert (= expect result))

(check-sat)
(exit)
