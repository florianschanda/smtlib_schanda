(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0011101 #b111)
                arg1
                (fp #b0 #b1010101 #b110)))
(assert (fp.leq (fp #b0 #b1010101 #b110)
                arg1
                (fp #b0 #b1010110 #b001)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0011110 #b010)
                arg2
                (fp #b0 #b0000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000 #b110)
                arg2
                (fp #b0 #b1101000 #b000)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1000011 #b110)
                expect
                (fp #b0 #b1010101 #b110)))
(assert (fp.leq (fp #b0 #b1010101 #b110)
                expect
                (fp #b0 #b1111010 #b010)))

(assert (= expect result))

(check-sat)
(exit)
