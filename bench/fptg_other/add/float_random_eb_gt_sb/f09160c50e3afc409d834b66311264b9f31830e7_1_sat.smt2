(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110101 #b110)
                arg1
                (fp #b1 #b10000010 #b001)))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg1
                (fp #b1 #b00000111 #b100)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11101100 #b011)
                arg2
                (fp #b1 #b10000010 #b100)))
(assert (fp.leq (fp #b1 #b10000010 #b100)
                arg2
                (fp #b1 #b01111100 #b000)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10111110 #b000)
                expect
                (fp #b1 #b10000011 #b010)))
(assert (fp.leq (fp #b1 #b10000011 #b010)
                expect
                (fp #b0 #b00000010 #b011)))

(assert (= expect result))

(check-sat)
(exit)
