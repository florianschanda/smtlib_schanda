; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01000011 #b110)
                arg1
                (fp #b0 #b00000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000 #b110)
                arg1
                (fp #b0 #b10011000 #b000)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01001001 #b111)
                arg2
                (fp #b0 #b00000000 #b001)))
(assert (fp.leq (fp #b0 #b00000000 #b001)
                arg2
                (fp #b0 #b00100100 #b010)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01100001 #b000)
                expect
                (fp #b0 #b00000000 #b111)))
(assert (fp.leq (fp #b0 #b00000000 #b111)
                expect
                (fp #b0 #b01010011 #b111)))

(assert (= expect result))

(check-sat)
(exit)
