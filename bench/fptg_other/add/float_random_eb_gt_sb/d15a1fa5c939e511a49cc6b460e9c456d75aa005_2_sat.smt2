(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0010110 #b01)
                arg1
                (fp #b1 #b0000000 #b01)))
(assert (fp.leq (fp #b1 #b0000000 #b01)
                arg1
                (fp #b0 #b1000110 #b10)))

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1010101 #b10)
                arg2
                (fp #b1 #b1000001 #b10)))
(assert (fp.leq (fp #b1 #b1000001 #b10)
                arg2
                (fp #b1 #b0011111 #b01)))

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1110011 #b01)
                expect
                (fp #b1 #b1000001 #b11)))
(assert (fp.leq (fp #b1 #b1000001 #b11)
                expect
                (fp #b1 #b0000110 #b10)))

(assert (= expect result))

(check-sat)
(exit)
