                arg2
                (fp #b0 #b000000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b000000000000 #b00111011)
                arg2
                (fp #b0 #b001111101100 #b00110010)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110111001111 #b00011000)
                expect
                (fp #b1 #b100000000111 #b10110011)))
(assert (fp.leq (fp #b1 #b100000000111 #b10110011)
                expect
                (fp #b0 #b000111111001 #b11011000)))

(assert (= expect result))

(check-sat)
(exit)
