(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01101101 #b11111)
                arg1
                (fp #b1 #b00000001 #b00000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000)
                arg1
                (fp #b0 #b11110001 #b10001)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10001100 #b01010)
                arg2
                (fp #b1 #b10000110 #b11000)))
(assert (fp.leq (fp #b1 #b10000110 #b11000)
                arg2
                (fp #b1 #b00001001 #b01001)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11001011 #b01011)
                expect
                (fp #b1 #b10000110 #b11000)))
(assert (fp.leq (fp #b1 #b10000110 #b11000)
                expect
                (fp #b1 #b00101011 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
