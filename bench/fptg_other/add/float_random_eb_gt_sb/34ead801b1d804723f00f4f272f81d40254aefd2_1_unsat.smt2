(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b011)
                arg1
                (fp #b1 #b10101 #b110)))
(assert (fp.leq (fp #b1 #b10101 #b110)
                arg1
                (fp #b1 #b00001 #b111)))

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11001 #b010)
                expect
                (fp #b1 #b10110 #b110)))
(assert (fp.leq (fp #b1 #b10110 #b110)
                expect
                (fp #b0 #b11000 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
