(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00111110010010 #b11000)
                arg1
                (fp #b1 #b00000000000000 #b00111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00111)
                arg1
                (fp #b0 #b11100000101100 #b00101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11101111000111 #b00101)
                arg2
                (fp #b1 #b01111111111111 #b00000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00000)
                arg2
                (fp #b0 #b10010000100011 #b11001)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11101111111011 #b00111)
                expect
                (fp #b1 #b01111111111111 #b00000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00000)
                expect
                (fp #b0 #b10111110010000 #b00010)))

(assert (= expect result))

(check-sat)
(exit)
