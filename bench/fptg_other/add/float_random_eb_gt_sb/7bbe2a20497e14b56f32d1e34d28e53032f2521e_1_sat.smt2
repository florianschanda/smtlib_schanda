(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b011101111110 #b1000000111)
                arg1
                (fp #b0 #b110010010101 #b0001100011)))
(assert (fp.leq (fp #b0 #b110010010101 #b0001100011)
                arg1
                (fp #b0 #b110100001011 #b0101010111)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b000110101001 #b0011011011)
                arg2
                (fp #b1 #b000000000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b0000000000)
                arg2
                (fp #b0 #b101101101011 #b1111010001)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101100101100 #b0001001101)
                expect
                (fp #b0 #b110010010101 #b0001100010)))
(assert (fp.leq (fp #b0 #b110010010101 #b0001100010)
                expect
                (fp #b0 #b111111010000 #b1101011100)))

(assert (= expect result))

(check-sat)
(exit)
