                (fp #b0 #b1111111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000)
                arg2
                (fp #b0 #b1111111111111101 #b111011)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b0 #b0011101011000110 #b101110)
                expect
                (fp #b0 #b1111111111111101 #b000001)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000001)
                expect
                (fp #b0 #b1111111111111101 #b101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
