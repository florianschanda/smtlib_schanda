(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1110001 #b11111)
                arg1
                (fp #b1 #b0000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000 #b00000)
                arg1
                (fp #b0 #b1110101 #b00010)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0010011 #b11001)
                arg2
                (fp #b1 #b0001000 #b10101)))
(assert (fp.leq (fp #b1 #b0001000 #b10101)
                arg2
                (fp #b0 #b0111011 #b11101)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1010001 #b10010)
                expect
                (fp #b1 #b0001000 #b10101)))
(assert (fp.leq (fp #b1 #b0001000 #b10101)
                expect
                (fp #b0 #b0001111 #b11000)))

(assert (not (= expect result)))

(check-sat)
(exit)
