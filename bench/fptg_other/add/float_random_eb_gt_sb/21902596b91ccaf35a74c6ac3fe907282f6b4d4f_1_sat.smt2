; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b0010111110001001 #b00001111110)
                arg1
                (fp #b0 #b1011111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b11111111111)
                arg1
                (fp #b0 #b1110111111100001 #b00101101010)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0011100100000011 #b10001011110)
                arg2
                (fp #b0 #b0000000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000001)
                arg2
                (fp #b0 #b0101011001000111 #b11100101111)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0101001101110001 #b10000010010)
                expect
                (fp #b0 #b1011111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b11111111111)
                expect
                (fp #b0 #b1101001110011111 #b11001110011)))

(assert (= expect result))

(check-sat)
(exit)
