(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0100111 #b00)
                arg1
                (fp #b0 #b0000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000 #b00)
                arg1
                (fp #b0 #b0110101 #b11)))

(declare-const arg2 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0000100 #b00)
                arg2
                (fp #b0 #b0100000 #b00)))
(assert (fp.leq (fp #b0 #b0100000 #b00)
                arg2
                (fp #b0 #b1001000 #b00)))

(declare-const result (_ FloatingPoint 7 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1010001 #b00)
                expect
                (fp #b0 #b0100000 #b00)))
(assert (fp.leq (fp #b0 #b0100000 #b00)
                expect
                (fp #b0 #b1111100 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
