(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b100001110101101 #b0011)
                arg1
                (fp #b1 #b000000000000000 #b0011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0011)
                arg1
                (fp #b0 #b000111100101001 #b1000)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110011110011100 #b0110)
                arg2
                (fp #b0 #b011111111111111 #b0000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b0000)
                arg2
                (fp #b0 #b100010100010100 #b0011)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b010010100000001 #b1111)
                expect
                (fp #b0 #b011111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b011111111111110 #b1111)
                expect
                (fp #b0 #b101001010111101 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
