(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0010111 #b0011)
                arg1
                (fp #b0 #b0000001 #b0000)))
(assert (fp.leq (fp #b0 #b0000001 #b0000)
                arg1
                (fp #b0 #b1011011 #b0001)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0111101 #b1001)
                arg2
                (fp #b0 #b1111100 #b0101)))
(assert (fp.leq (fp #b0 #b1111100 #b0101)
                arg2
                (fp #b0 #b1111110 #b0011)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0101100 #b1001)
                expect
                (fp #b0 #b1111100 #b0101)))
(assert (fp.leq (fp #b0 #b1111100 #b0101)
                expect
                (fp #b0 #b1111110 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
