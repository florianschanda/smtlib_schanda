(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10111011010 #b010)
                arg1
                (fp #b1 #b01111111111 #b101)))
(assert (fp.leq (fp #b1 #b01111111111 #b101)
                arg1
                (fp #b0 #b10001110000 #b101)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111110000 #b001)
                arg2
                (fp #b1 #b10000000010 #b001)))
(assert (fp.leq (fp #b1 #b10000000010 #b001)
                arg2
                (fp #b1 #b01011001111 #b100)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11110100111 #b011)
                expect
                (fp #b1 #b10000000010 #b011)))
(assert (fp.leq (fp #b1 #b10000000010 #b011)
                expect
                (fp #b0 #b11111101101 #b110)))

(assert (= expect result))

(check-sat)
(exit)
