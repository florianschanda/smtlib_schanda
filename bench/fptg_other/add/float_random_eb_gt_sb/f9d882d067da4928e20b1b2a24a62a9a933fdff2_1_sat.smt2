(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11000100 #b011)
                arg1
                (fp #b1 #b10111110 #b111)))
(assert (fp.leq (fp #b1 #b10111110 #b111)
                arg1
                (fp #b0 #b00011010 #b101)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111000 #b100)
                arg2
                (fp #b0 #b01111111 #b110)))
(assert (fp.leq (fp #b0 #b01111111 #b110)
                arg2
                (fp #b0 #b10011010 #b110)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110010 #b001)
                expect
                (fp #b1 #b10111110 #b110)))
(assert (fp.leq (fp #b1 #b10111110 #b110)
                expect
                (fp #b0 #b00011010 #b110)))

(assert (= expect result))

(check-sat)
(exit)
