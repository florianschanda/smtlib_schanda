(assert (fp.leq (fp #b1 #b1110010 #b01111)
                expect
                (fp #b1 #b1110001 #b11100)))
(assert (fp.leq (fp #b1 #b1110001 #b11100)
                expect
                (fp #b0 #b0011011 #b00011)))

