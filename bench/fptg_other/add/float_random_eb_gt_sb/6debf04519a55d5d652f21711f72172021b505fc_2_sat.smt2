(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11011 #b011)
                arg1
                (fp #b1 #b10110 #b111)))
(assert (fp.leq (fp #b1 #b10110 #b111)
                arg1
                (fp #b1 #b10011 #b101)))

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10010 #b001)
                arg2
                (fp #b1 #b10000 #b000)))
(assert (fp.leq (fp #b1 #b10000 #b000)
                arg2
                (fp #b0 #b00111 #b111)))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11000 #b000)
                expect
                (fp #b1 #b10111 #b000)))
(assert (fp.leq (fp #b1 #b10111 #b000)
                expect
                (fp #b0 #b10001 #b000)))

(assert (= expect result))

(check-sat)
(exit)
