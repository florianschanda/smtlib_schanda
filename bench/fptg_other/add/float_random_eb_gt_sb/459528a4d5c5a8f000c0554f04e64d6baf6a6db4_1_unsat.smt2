; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01010111 #b01111)
                arg1
                (fp #b1 #b00000000 #b11111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111)
                arg1
                (fp #b0 #b00010110 #b11101)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00100011 #b00000)
                arg2
                (fp #b0 #b00000000 #b00001)))
(assert (fp.leq (fp #b0 #b00000000 #b00001)
                arg2
                (fp #b0 #b01001110 #b00011)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11111001 #b10000)
                expect
                (fp #b1 #b00000000 #b11110)))
(assert (fp.leq (fp #b1 #b00000000 #b11110)
                expect
                (fp #b0 #b10111001 #b10101)))

(assert (not (= expect result)))

(check-sat)
(exit)
