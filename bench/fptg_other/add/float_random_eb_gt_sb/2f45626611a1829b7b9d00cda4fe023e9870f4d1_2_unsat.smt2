(assert (fp.leq (fp #b1 #b01111111111111111 #b00000)
                arg2
                (fp #b0 #b01000001011011000 #b10000)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b0 #b10110010001010111 #b11101)
                expect
                (fp #b0 #b11010110100100100 #b00100)))
(assert (fp.leq (fp #b0 #b11010110100100100 #b00100)
                expect
                (fp #b0 #b11010111011111100 #b11100)))

(assert (not (= expect result)))

(check-sat)
