(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b010011001 #b0)
                arg1
                (fp #b0 #b011111100 #b0)))
(assert (fp.leq (fp #b0 #b011111100 #b0)
                arg1
                (fp #b0 #b110110010 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111110101 #b0)
                arg2
                (fp #b1 #b111110100 #b0)))
(assert (fp.leq (fp #b1 #b111110100 #b0)
                arg2
                (fp #b0 #b001100101 #b0)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111111001 #b1)
                expect
                (fp #b1 #b111110100 #b0)))
(assert (fp.leq (fp #b1 #b111110100 #b0)
                expect
                (fp #b0 #b001001010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
