(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11001001 #b01)
                arg1
                (fp #b1 #b10111011 #b10)))
(assert (fp.leq (fp #b1 #b10111011 #b10)
                arg1
                (fp #b0 #b11000011 #b00)))

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b00001100 #b01)
                arg2
                (fp #b0 #b11111110 #b11)))
(assert (fp.leq (fp #b0 #b11111110 #b11)
                arg2
                (fp #b0 #b11111111 #b00)))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b00110100 #b00)
                expect
                (fp #b0 #b11111110 #b10)))
(assert (fp.leq (fp #b0 #b11111110 #b10)
                expect
                (fp #b0 #b11111110 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
