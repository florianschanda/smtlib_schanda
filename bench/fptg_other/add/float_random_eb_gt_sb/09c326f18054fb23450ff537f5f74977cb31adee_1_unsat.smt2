(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b01001001 #b000110)
                arg1
                (fp #b0 #b11111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111101 #b000000)
                arg1
                (fp #b0 #b11111110 #b010010)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11010111 #b101101)
                arg2
                (fp #b1 #b01000000 #b000000)))
(assert (fp.leq (fp #b1 #b01000000 #b000000)
                arg2
                (fp #b1 #b00100011 #b000000)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10010100 #b011011)
                expect
                (fp #b0 #b11111100 #b111111)))
(assert (fp.leq (fp #b0 #b11111100 #b111111)
                expect
                (fp #b0 #b11111101 #b111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
