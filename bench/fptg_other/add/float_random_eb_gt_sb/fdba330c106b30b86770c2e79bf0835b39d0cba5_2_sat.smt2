(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b01111110 #b0010)
                arg1
                (fp #b0 #b11000101 #b1100)))
(assert (fp.leq (fp #b0 #b11000101 #b1100)
                arg1
                (fp #b0 #b11100110 #b1100)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11001101 #b1010)
                arg2
                (fp #b1 #b10111110 #b1111)))
(assert (fp.leq (fp #b1 #b10111110 #b1111)
                arg2
                (fp #b1 #b00011100 #b1011)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11101111 #b1011)
                expect
                (fp #b0 #b11000101 #b1100)))
(assert (fp.leq (fp #b0 #b11000101 #b1100)
                expect
                (fp #b0 #b11111110 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
