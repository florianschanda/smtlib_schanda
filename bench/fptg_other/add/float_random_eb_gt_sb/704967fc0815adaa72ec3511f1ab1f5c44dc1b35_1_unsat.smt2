; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101101011001 #b000011)
                arg1
                (fp #b1 #b011111111111 #b101110)))
(assert (fp.leq (fp #b1 #b011111111111 #b101110)
                arg1
                (fp #b0 #b011111101001 #b000011)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b010010100000 #b000010)
                arg2
                (fp #b1 #b000000000001 #b000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b000000)
                arg2
                (fp #b0 #b000101111101 #b001111)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101000111010 #b000101)
                expect
                (fp #b1 #b011111111111 #b101110)))
(assert (fp.leq (fp #b1 #b011111111111 #b101110)
                expect
                (fp #b0 #b011011101001 #b011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
