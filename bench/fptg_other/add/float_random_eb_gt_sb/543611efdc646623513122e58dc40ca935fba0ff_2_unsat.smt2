(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011100101 #b00001)
                arg1
                (fp #b1 #b000000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000)
                arg1
                (fp #b0 #b001001110 #b00111)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b001100011 #b00001)
                arg2
                (fp #b0 #b010000000 #b00000)))
(assert (fp.leq (fp #b0 #b010000000 #b00000)
                arg2
                (fp #b0 #b101001011 #b00010)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b010111101 #b11101)
                expect
                (fp #b0 #b010000000 #b00000)))
(assert (fp.leq (fp #b0 #b010000000 #b00000)
                expect
                (fp #b0 #b010111100 #b00001)))

(assert (not (= expect result)))

(check-sat)
(exit)
