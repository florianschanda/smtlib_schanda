(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b000111100 #b01111)
                arg1
                (fp #b0 #b101001100 #b00000)))
(assert (fp.leq (fp #b0 #b101001100 #b00000)
                arg1
                (fp #b0 #b110010111 #b11110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111110100 #b11000)
                arg2
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg2
                (fp #b0 #b100111111 #b11011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b011001110 #b01100)
                expect
                (fp #b0 #b101001100 #b00000)))
(assert (fp.leq (fp #b0 #b101001100 #b00000)
                expect
                (fp #b0 #b101111001 #b01000)))

(assert (not (= expect result)))

(check-sat)
(exit)
