                arg2
                (fp #b0 #b000000000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1110100111)
                arg2
                (fp #b0 #b000011000110110 #b1100110100)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b111101000000000 #b1100101000)
                expect
                (fp #b1 #b111010001111010 #b1100111100)))
(assert (fp.leq (fp #b1 #b111010001111010 #b1100111100)
                expect
                (fp #b0 #b000110111010100 #b1011001011)))

(assert (= expect result))

(check-sat)
(exit)
