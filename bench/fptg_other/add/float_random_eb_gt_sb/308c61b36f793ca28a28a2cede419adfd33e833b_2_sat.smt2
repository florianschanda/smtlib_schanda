(assert (fp.leq (fp #b1 #b111110110110000 #b0111010011)
                arg1
                (fp #b1 #b111010001111010 #b1100111100)))
(assert (fp.leq (fp #b1 #b111010001111010 #b1100111100)
                arg1
                (fp #b0 #b101000011111011 #b0000100111)))

