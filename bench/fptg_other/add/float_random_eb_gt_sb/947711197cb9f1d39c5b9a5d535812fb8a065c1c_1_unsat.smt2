(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111101 #b001)
                arg1
                (fp #b1 #b1111101 #b000)))
(assert (fp.leq (fp #b1 #b1111101 #b000)
                arg1
                (fp #b1 #b0111000 #b001)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1010111 #b010)
                arg2
                (fp #b1 #b0111111 #b101)))
(assert (fp.leq (fp #b1 #b0111111 #b101)
                arg2
                (fp #b0 #b1100110 #b001)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111110 #b101)
                expect
                (fp #b1 #b1111101 #b000)))
(assert (fp.leq (fp #b1 #b1111101 #b000)
                expect
                (fp #b1 #b1000001 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
