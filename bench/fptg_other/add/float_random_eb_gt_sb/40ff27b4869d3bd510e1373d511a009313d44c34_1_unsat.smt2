(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101110111 #b11101)
                arg1
                (fp #b1 #b101101100 #b11000)))
(assert (fp.leq (fp #b1 #b101101100 #b11000)
                arg1
                (fp #b0 #b110011001 #b01001)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110101111 #b01011)
                arg2
                (fp #b1 #b011111111 #b00110)))
(assert (fp.leq (fp #b1 #b011111111 #b00110)
                arg2
                (fp #b0 #b000010010 #b00110)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100101 #b11001)
                expect
                (fp #b1 #b101101100 #b11000)))
(assert (fp.leq (fp #b1 #b101101100 #b11000)
                expect
                (fp #b0 #b100010011 #b01000)))

(assert (not (= expect result)))

(check-sat)
(exit)
