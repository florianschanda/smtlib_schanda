(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0101 #b10)
                arg1
                (fp #b1 #b0000 #b00)))
(assert (fp.leq (fp #b1 #b0000 #b00)
                arg1
                (fp #b0 #b1011 #b01)))

(declare-const arg2 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                arg2
                (fp #b1 #b1101 #b00)))
(assert (fp.leq (fp #b1 #b1101 #b00)
                arg2
                (fp #b0 #b1101 #b00)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b10)
                expect
                (fp #b1 #b1101 #b00)))
(assert (fp.leq (fp #b1 #b1101 #b00)
                expect
                (fp #b1 #b0111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
