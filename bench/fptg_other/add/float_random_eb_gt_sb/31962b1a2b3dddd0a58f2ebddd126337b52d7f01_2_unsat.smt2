; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1010100011000001 #b00)
                arg1
                (fp #b1 #b0000000000000000 #b11)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b11)
                arg1
                (fp #b0 #b1111011001010111 #b10)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1001001110111011 #b00)
                arg2
                (fp #b1 #b0011111111111111 #b00)))
(assert (fp.leq (fp #b1 #b0011111111111111 #b00)
                arg2
                (fp #b0 #b0101100001001000 #b10)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1111101001110011 #b01)
                expect
                (fp #b1 #b0011111111111111 #b01)))
(assert (fp.leq (fp #b1 #b0011111111111111 #b01)
                expect
                (fp #b0 #b1010000001100100 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
