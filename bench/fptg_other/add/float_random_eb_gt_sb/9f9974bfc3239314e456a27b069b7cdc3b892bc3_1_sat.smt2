; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011111011111 #b1101001001)
                arg1
                (fp #b0 #b000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000000000)
                arg1
                (fp #b0 #b110100001101 #b1000111001)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110101111001 #b0011111001)
                arg2
                (fp #b0 #b000000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0100000000)
                arg2
                (fp #b0 #b110011001000 #b1001101011)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110111000100 #b0010011110)
                expect
                (fp #b0 #b000000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0100000000)
                expect
                (fp #b0 #b000011001100 #b0010011101)))

(assert (= expect result))

(check-sat)
(exit)
