; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b10111011000 #b0)
                arg1
                (fp #b0 #b10111111110 #b1)))
(assert (fp.leq (fp #b0 #b10111111110 #b1)
                arg1
                (fp #b0 #b11101000111 #b0)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11000010000 #b0)
                arg2
                (fp #b0 #b10000000000 #b1)))
(assert (fp.leq (fp #b0 #b10000000000 #b1)
                arg2
                (fp #b0 #b11010011111 #b0)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01110101010 #b1)
                expect
                (fp #b0 #b10111111111 #b0)))
(assert (fp.leq (fp #b0 #b10111111111 #b0)
                expect
                (fp #b0 #b11001100010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
