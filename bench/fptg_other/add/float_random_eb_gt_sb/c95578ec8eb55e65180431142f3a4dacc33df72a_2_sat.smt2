(assert (fp.leq (fp #b0 #b0001001001011 #b0011100)
                arg2
                (fp #b0 #b1011000101110 #b1101001)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1100110110001 #b1101011)
                expect
                (fp #b0 #b0001001001011 #b0011100)))
(assert (fp.leq (fp #b0 #b0001001001011 #b0011100)
                expect
                (fp #b0 #b1000101010100 #b1001101)))

(assert (= expect result))

(check-sat)
(exit)
