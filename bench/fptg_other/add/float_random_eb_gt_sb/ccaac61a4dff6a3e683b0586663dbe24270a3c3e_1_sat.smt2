(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100000 #b1110)
                arg1
                (fp #b0 #b011111 #b0110)))
(assert (fp.leq (fp #b0 #b011111 #b0110)
                arg1
                (fp #b0 #b111101 #b1110)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b010010 #b0001)
                arg2
                (fp #b1 #b001110 #b0000)))
(assert (fp.leq (fp #b1 #b001110 #b0000)
                arg2
                (fp #b0 #b100111 #b1111)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b010001 #b1100)
                expect
                (fp #b0 #b011111 #b0101)))
(assert (fp.leq (fp #b0 #b011111 #b0101)
                expect
                (fp #b0 #b110000 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
