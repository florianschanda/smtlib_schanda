; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01000001110 #b01)
                arg1
                (fp #b0 #b11100001110 #b01)))
(assert (fp.leq (fp #b0 #b11100001110 #b01)
                arg1
                (fp #b0 #b11111011110 #b10)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10101000010 #b00)
                arg2
                (fp #b1 #b00000000000 #b01)))
(assert (fp.leq (fp #b1 #b00000000000 #b01)
                arg2
                (fp #b0 #b00001011000 #b00)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10001110010 #b00)
                expect
                (fp #b0 #b11100001110 #b00)))
(assert (fp.leq (fp #b0 #b11100001110 #b00)
                expect
                (fp #b0 #b11101001110 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
