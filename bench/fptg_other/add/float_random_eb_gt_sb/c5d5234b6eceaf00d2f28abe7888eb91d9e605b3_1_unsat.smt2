(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1001110 #b0011)
                arg1
                (fp #b0 #b0011110 #b0000)))
(assert (fp.leq (fp #b0 #b0011110 #b0000)
                arg1
                (fp #b0 #b0110011 #b0000)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1100000 #b0011)
                arg2
                (fp #b0 #b1000110 #b1110)))
(assert (fp.leq (fp #b0 #b1000110 #b1110)
                arg2
                (fp #b0 #b1010001 #b0000)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0010100 #b1000)
                expect
                (fp #b0 #b1000110 #b1110)))
(assert (fp.leq (fp #b0 #b1000110 #b1110)
                expect
                (fp #b0 #b1111011 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
