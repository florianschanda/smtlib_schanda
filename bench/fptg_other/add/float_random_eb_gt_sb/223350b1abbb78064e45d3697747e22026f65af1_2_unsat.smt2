(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                arg1
                (fp #b1 #b11110 #b1)))
(assert (fp.leq (fp #b1 #b11110 #b1)
                arg1
                (fp #b1 #b11011 #b0)))

(declare-const arg2 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11011 #b0)
                arg2
                (fp #b0 #b00111 #b0)))
(assert (fp.leq (fp #b0 #b00111 #b0)
                arg2
                (fp #b0 #b10010 #b0)))

(declare-const result (_ FloatingPoint 5 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                expect
                (fp #b1 #b11110 #b1)))
(assert (fp.leq (fp #b1 #b11110 #b1)
                expect
                (fp #b0 #b01111 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
