;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b01001110010 #b0100)
                arg1
                (fp #b0 #b10100101101 #b1011)))
(assert (fp.leq (fp #b0 #b10100101101 #b1011)
                arg1
                (fp #b0 #b11001010111 #b0011)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000011010 #b1010)
                arg2
                (fp #b1 #b10000000011 #b0001)))
(assert (fp.leq (fp #b1 #b10000000011 #b0001)
                arg2
                (fp #b0 #b01000100111 #b0000)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01110001110 #b1111)
                expect
                (fp #b0 #b10100101101 #b1010)))
(assert (fp.leq (fp #b0 #b10100101101 #b1010)
                expect
                (fp #b0 #b11011111010 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
