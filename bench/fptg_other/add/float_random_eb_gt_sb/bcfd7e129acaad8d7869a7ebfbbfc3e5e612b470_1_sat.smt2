; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10101011 #b111)
                arg1
                (fp #b1 #b00000000 #b111)))
(assert (fp.leq (fp #b1 #b00000000 #b111)
                arg1
                (fp #b0 #b10101011 #b011)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01000111 #b010)
                arg2
                (fp #b1 #b00000000 #b101)))
(assert (fp.leq (fp #b1 #b00000000 #b101)
                arg2
                (fp #b0 #b10011110 #b011)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10111000 #b000)
                expect
                (fp #b1 #b00000001 #b100)))
(assert (fp.leq (fp #b1 #b00000001 #b100)
                expect
                (fp #b0 #b10000100 #b000)))

(assert (= expect result))

(check-sat)
(exit)
