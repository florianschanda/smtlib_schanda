(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b100010010010001000 #b0)
                arg1
                (fp #b0 #b111011110100011000 #b0)))
(assert (fp.leq (fp #b0 #b111011110100011000 #b0)
                arg1
                (fp #b0 #b111110110100010101 #b0)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1)
                arg2
                (fp #b1 #b111111111111111101 #b0)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0)
                arg2
                (fp #b0 #b111001011101000100 #b0)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111110 #b0)
                expect
                (fp #b1 #b111111111111111101 #b0)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0)
                expect
                (fp #b1 #b000010111110101101 #b1)))

(assert (= expect result))

(check-sat)
(exit)
