;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10010100101 #b101)
                arg1
                (fp #b1 #b10000101001 #b011)))
(assert (fp.leq (fp #b1 #b10000101001 #b011)
                arg1
                (fp #b0 #b10000000000 #b011)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11011000001 #b110)
                arg2
                (fp #b0 #b00000000001 #b000)))
(assert (fp.leq (fp #b0 #b00000000001 #b000)
                arg2
                (fp #b0 #b01010010100 #b100)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111111010 #b110)
                expect
                (fp #b1 #b10000101001 #b010)))
(assert (fp.leq (fp #b1 #b10000101001 #b010)
                expect
                (fp #b0 #b00010001010 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
