(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0111101 #b111)
                arg1
                (fp #b1 #b0101111 #b111)))
(assert (fp.leq (fp #b1 #b0101111 #b111)
                arg1
                (fp #b0 #b0111010 #b011)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0001100 #b111)
                arg2
                (fp #b0 #b0000000 #b001)))
(assert (fp.leq (fp #b0 #b0000000 #b001)
                arg2
                (fp #b0 #b1000001 #b110)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1010000 #b001)
                expect
                (fp #b1 #b0101111 #b110)))
(assert (fp.leq (fp #b1 #b0101111 #b110)
                expect
                (fp #b1 #b0100001 #b000)))

(assert (= expect result))

(check-sat)
(exit)
