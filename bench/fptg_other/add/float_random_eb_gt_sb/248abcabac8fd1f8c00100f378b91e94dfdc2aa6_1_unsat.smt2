(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111101011 #b10)
                arg1
                (fp #b0 #b0000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000 #b10)
                arg1
                (fp #b0 #b1001100110 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1100010011 #b11)
                arg2
                (fp #b1 #b1001001010 #b11)))
(assert (fp.leq (fp #b1 #b1001001010 #b11)
                arg2
                (fp #b0 #b0011110111 #b00)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111010100 #b00)
                expect
                (fp #b1 #b1001001010 #b10)))
(assert (fp.leq (fp #b1 #b1001001010 #b10)
                expect
                (fp #b1 #b0010100111 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
