(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1010011 #b011)
                arg1
                (fp #b0 #b1111101 #b000)))
(assert (fp.leq (fp #b0 #b1111101 #b000)
                arg1
                (fp #b0 #b1111111 #b000)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0001110 #b001)
                arg2
                (fp #b1 #b0000000 #b101)))
(assert (fp.leq (fp #b1 #b0000000 #b101)
                arg2
                (fp #b0 #b0110000 #b001)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0001001 #b101)
                expect
                (fp #b0 #b1111100 #b111)))
(assert (fp.leq (fp #b0 #b1111100 #b111)
                expect
                (fp #b0 #b1111101 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
