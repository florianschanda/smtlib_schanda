(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1111101011110110 #b10011000)
                arg1
                (fp #b1 #b0000000000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000001)
                arg1
                (fp #b0 #b0011011101111101 #b11110111)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1111011001101010 #b00000110)
                arg2
                (fp #b1 #b0111111111111111 #b00010001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b00010001)
                arg2
                (fp #b1 #b0000011110111100 #b00010001)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1101101101111000 #b01100110)
                expect
                (fp #b1 #b0111111111111111 #b00010010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b00010010)
                expect
                (fp #b1 #b0101010001110011 #b10110010)))

(assert (= expect result))

(check-sat)
(exit)
