(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10010110 #b0001)
                arg1
                (fp #b0 #b01111111 #b0100)))
(assert (fp.leq (fp #b0 #b01111111 #b0100)
                arg1
                (fp #b0 #b10011101 #b0000)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11000110 #b1110)
                arg2
                (fp #b0 #b01000000 #b0000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000)
                arg2
                (fp #b0 #b11001001 #b0001)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00101010 #b0101)
                expect
                (fp #b0 #b01111111 #b0101)))
(assert (fp.leq (fp #b0 #b01111111 #b0101)
                expect
                (fp #b0 #b10100000 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
