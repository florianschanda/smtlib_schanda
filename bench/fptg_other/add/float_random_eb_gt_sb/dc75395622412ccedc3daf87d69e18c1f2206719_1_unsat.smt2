(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111010 #b0001101)
                arg1
                (fp #b1 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100000)
                arg1
                (fp #b0 #b1110111010 #b0001010)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0111011000 #b0001000)
                arg2
                (fp #b0 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000)
                arg2
                (fp #b0 #b1100000011 #b0101111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0100011101 #b1100010)
                expect
                (fp #b1 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100000)
                expect
                (fp #b0 #b0110001100 #b1001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
