(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0111111101100010 #b1110111011)
                arg1
                (fp #b1 #b0000000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000000)
                arg1
                (fp #b0 #b1101001100000111 #b1000010101)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1011010101001101 #b0011001010)
                arg2
                (fp #b0 #b0000000000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100000000)
                arg2
                (fp #b0 #b1100110110111000 #b1011100001)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1010110101000010 #b0110110111)
                expect
                (fp #b0 #b0000000000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100000000)
                expect
                (fp #b0 #b0010001000000101 #b1111011110)))

(assert (= expect result))

(check-sat)
(exit)
