(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0001100 #b111)
                arg1
                (fp #b0 #b1000011 #b000)))
(assert (fp.leq (fp #b0 #b1000011 #b000)
                arg1
                (fp #b0 #b1011010 #b000)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1110110 #b101)
                arg2
                (fp #b1 #b1110110 #b100)))
(assert (fp.leq (fp #b1 #b1110110 #b100)
                arg2
                (fp #b1 #b1010100 #b100)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1110111 #b101)
                expect
                (fp #b1 #b1110110 #b011)))
(assert (fp.leq (fp #b1 #b1110110 #b011)
                expect
                (fp #b1 #b0000010 #b101)))

(assert (= expect result))

(check-sat)
(exit)
