                (fp #b1 #b011111111 #b0000000)))
(assert (fp.leq (fp #b1 #b011111111 #b0000000)
                arg2
                (fp #b1 #b011100101 #b1011001)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111000010 #b0001011)
                expect
                (fp #b1 #b011111110 #b1111111)))
(assert (fp.leq (fp #b1 #b011111110 #b1111111)
                expect
                (fp #b1 #b010011100 #b0001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
