(assert (fp.leq (fp #b1 #b000000000000000 #b0101011111)
                arg2
                (fp #b0 #b000000100110001 #b0110001000)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b001001000100001 #b0100101001)
                expect
                (fp #b1 #b000000000000001 #b0101011110)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0101011110)
                expect
                (fp #b0 #b000101111010100 #b1100010110)))

(assert (= expect result))

(check-sat)
(exit)
