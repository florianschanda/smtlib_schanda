; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01101110001110 #b0001)
                arg1
                (fp #b0 #b10011111011000 #b1110)))
(assert (fp.leq (fp #b0 #b10011111011000 #b1110)
                arg1
                (fp #b0 #b11110111100001 #b1001)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10011000011011 #b0001)
                arg2
                (fp #b1 #b01111111111111 #b0010)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0010)
                arg2
                (fp #b1 #b00000001000001 #b1110)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b0 #b01100111000001 #b1110)
                expect
                (fp #b0 #b10011111011000 #b1101)))
(assert (fp.leq (fp #b0 #b10011111011000 #b1101)
                expect
                (fp #b0 #b11001001110000 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
