(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00101000 #b000)
                arg1
                (fp #b0 #b00000000 #b111)))
(assert (fp.leq (fp #b0 #b00000000 #b111)
                arg1
                (fp #b0 #b11001001 #b000)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00101001 #b110)
                arg2
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                arg2
                (fp #b0 #b10111100 #b111)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01001000 #b111)
                expect
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                expect
                (fp #b0 #b10100000 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
