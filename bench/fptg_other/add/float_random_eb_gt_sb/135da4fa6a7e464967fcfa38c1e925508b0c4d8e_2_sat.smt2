(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01110010 #b1000)
                arg1
                (fp #b1 #b00000000 #b1000)))
(assert (fp.leq (fp #b1 #b00000000 #b1000)
                arg1
                (fp #b0 #b00110111 #b1101)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11111111 #b0000)
                arg2
                (fp #b1 #b11111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111110 #b1111)
                arg2
                (fp #b1 #b00001010 #b1000)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
