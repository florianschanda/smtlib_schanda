(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11011010 #b000)
                arg1
                (fp #b1 #b01110010 #b110)))
(assert (fp.leq (fp #b1 #b01110010 #b110)
                arg1
                (fp #b1 #b01001100 #b111)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111010 #b101)
                arg2
                (fp #b0 #b01111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111 #b000)
                arg2
                (fp #b0 #b10110010 #b010)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10000100 #b011)
                expect
                (fp #b0 #b01111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111 #b000)
                expect
                (fp #b0 #b11000000 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
