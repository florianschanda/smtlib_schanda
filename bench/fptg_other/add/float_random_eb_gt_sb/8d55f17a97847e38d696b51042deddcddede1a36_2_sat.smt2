(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b0 #b011000001010 #b001110101)
                arg1
                (fp #b0 #b011111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b000000000)
                arg1
                (fp #b0 #b110110000110 #b100000100)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110101011000 #b101000100)
                arg2
                (fp #b1 #b010000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b000000000)
                arg2
                (fp #b0 #b110110100011 #b011000101)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111001011101 #b010101110)
                expect
                (fp #b0 #b011111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b000000000)
                expect
                (fp #b0 #b110111110101 #b000000100)))

(assert (= expect result))

(check-sat)
(exit)
