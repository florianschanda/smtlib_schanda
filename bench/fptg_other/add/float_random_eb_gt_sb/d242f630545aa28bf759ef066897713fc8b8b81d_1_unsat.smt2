; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b000010101 #b01)
                arg1
                (fp #b0 #b000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000 #b10)
                arg1
                (fp #b0 #b011110011 #b10)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b100011011 #b11)
                arg2
                (fp #b0 #b000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000 #b00)
                arg2
                (fp #b0 #b010001101 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011110010 #b00)
                expect
                (fp #b0 #b000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000 #b10)
                expect
                (fp #b0 #b100011100 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
