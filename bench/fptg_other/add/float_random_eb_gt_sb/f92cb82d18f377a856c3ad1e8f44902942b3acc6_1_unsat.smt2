(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11110010011 #b101)
                arg1
                (fp #b1 #b10110111010 #b001)))
(assert (fp.leq (fp #b1 #b10110111010 #b001)
                arg1
                (fp #b0 #b00000011111 #b001)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111001001 #b110)
                expect
                (fp #b1 #b10110111011 #b001)))
(assert (fp.leq (fp #b1 #b10110111011 #b001)
                expect
                (fp #b0 #b10000101001 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
