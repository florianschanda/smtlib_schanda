(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01011010 #b0001)
                arg1
                (fp #b0 #b01000000 #b0000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000)
                arg1
                (fp #b0 #b01110001 #b0101)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b01001110 #b1010)
                arg2
                (fp #b0 #b01111111 #b0110)))
(assert (fp.leq (fp #b0 #b01111111 #b0110)
                arg2
                (fp #b0 #b11111101 #b0000)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b01100111 #b0001)
                expect
                (fp #b0 #b01111111 #b0110)))
(assert (fp.leq (fp #b0 #b01111111 #b0110)
                expect
                (fp #b0 #b11101110 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
