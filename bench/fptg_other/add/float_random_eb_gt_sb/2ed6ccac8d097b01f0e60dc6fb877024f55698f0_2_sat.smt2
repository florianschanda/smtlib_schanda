(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b011)
                arg1
                (fp #b1 #b00000 #b010)))
(assert (fp.leq (fp #b1 #b00000 #b010)
                arg1
                (fp #b0 #b11011 #b000)))

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b01110 #b101)
                arg2
                (fp #b0 #b10001 #b000)))
(assert (fp.leq (fp #b0 #b10001 #b000)
                arg2
                (fp #b0 #b10111 #b110)))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01110 #b100)
                expect
                (fp #b0 #b10001 #b000)))
(assert (fp.leq (fp #b0 #b10001 #b000)
                expect
                (fp #b0 #b11000 #b101)))

(assert (= expect result))

(check-sat)
(exit)
