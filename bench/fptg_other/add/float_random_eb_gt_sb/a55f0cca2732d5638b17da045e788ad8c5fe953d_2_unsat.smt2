;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000101111 #b11011100)
                arg1
                (fp #b0 #b1000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b1000000010 #b00100000)
                arg1
                (fp #b0 #b1001011001 #b01100110)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110001001 #b00101101)
                arg2
                (fp #b0 #b0011111100 #b00000000)))
(assert (fp.leq (fp #b0 #b0011111100 #b00000000)
                arg2
                (fp #b0 #b1100000011 #b01111011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1100110110 #b10010111)
                expect
                (fp #b0 #b1000000010 #b00100001)))
(assert (fp.leq (fp #b0 #b1000000010 #b00100001)
                expect
                (fp #b0 #b1110001111 #b00111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
