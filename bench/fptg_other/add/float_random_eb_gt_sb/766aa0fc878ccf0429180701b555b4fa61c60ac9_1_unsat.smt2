(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1010 #b0)
                arg1
                (fp #b1 #b0111 #b1)))
(assert (fp.leq (fp #b1 #b0111 #b1)
                arg1
                (fp #b1 #b0100 #b1)))

(declare-const arg2 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1111 #b0)
                arg2
                (fp #b1 #b0111 #b0)))
(assert (fp.leq (fp #b1 #b0111 #b0)
                arg2
                (fp #b1 #b0010 #b0)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b0)
                expect
                (fp #b1 #b1000 #b0)))
(assert (fp.leq (fp #b1 #b1000 #b0)
                expect
                (fp #b1 #b0000 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
