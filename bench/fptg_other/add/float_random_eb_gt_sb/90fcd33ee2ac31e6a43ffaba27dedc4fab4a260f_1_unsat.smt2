(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b001101011011101 #b1000)
                arg1
                (fp #b0 #b111111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111)
                arg1
                (fp #b0 #b111111111111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b100010100100010 #b1010)
                arg2
                (fp #b1 #b000000000000000 #b1110)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1110)
                arg2
                (fp #b0 #b111001001010000 #b0010)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b110101111110010 #b1100)
                expect
                (fp #b0 #b111111111111110 #b1110)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1110)
                expect
                (fp #b0 #b111111111111110 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
