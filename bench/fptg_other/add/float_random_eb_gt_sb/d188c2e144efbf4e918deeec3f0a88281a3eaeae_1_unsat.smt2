(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b100000 #b0101)
                arg1
                (fp #b0 #b111101 #b0000)))
(assert (fp.leq (fp #b0 #b111101 #b0000)
                arg1
                (fp #b0 #b111101 #b1010)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110010 #b1101)
                arg2
                (fp #b0 #b000001 #b0000)))
(assert (fp.leq (fp #b0 #b000001 #b0000)
                arg2
                (fp #b0 #b101111 #b0011)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b0 #b001111 #b1000)
                expect
                (fp #b0 #b111101 #b0000)))
(assert (fp.leq (fp #b0 #b111101 #b0000)
                expect
                (fp #b0 #b111111 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
