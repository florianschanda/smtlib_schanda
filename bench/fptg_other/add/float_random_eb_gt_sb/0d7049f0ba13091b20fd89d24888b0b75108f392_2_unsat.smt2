(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0001111 #b010)
                arg1
                (fp #b0 #b0111111 #b100)))
(assert (fp.leq (fp #b0 #b0111111 #b100)
                arg1
                (fp #b0 #b1101010 #b101)))

(declare-const arg2 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1001011 #b111)
                arg2
                (fp #b1 #b0000000 #b011)))
(assert (fp.leq (fp #b1 #b0000000 #b011)
                arg2
                (fp #b0 #b0000111 #b000)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b0 #b0101001 #b100)
                expect
                (fp #b0 #b0111111 #b100)))
(assert (fp.leq (fp #b0 #b0111111 #b100)
                expect
                (fp #b0 #b1100100 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
