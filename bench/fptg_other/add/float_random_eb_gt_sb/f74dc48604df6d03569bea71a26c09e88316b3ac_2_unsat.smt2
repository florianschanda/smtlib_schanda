(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11100111 #b011)
                arg1
                (fp #b1 #b10111110 #b111)))
(assert (fp.leq (fp #b1 #b10111110 #b111)
                arg1
                (fp #b1 #b00111000 #b011)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10111000 #b111)
                arg2
                (fp #b1 #b01111111 #b101)))
(assert (fp.leq (fp #b1 #b01111111 #b101)
                arg2
                (fp #b0 #b01011101 #b111)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11011010 #b101)
                expect
                (fp #b1 #b10111111 #b000)))
(assert (fp.leq (fp #b1 #b10111111 #b000)
                expect
                (fp #b1 #b00001010 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
