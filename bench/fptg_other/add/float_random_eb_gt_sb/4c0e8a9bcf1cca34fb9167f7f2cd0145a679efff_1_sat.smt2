(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00110001 #b10110)
                arg1
                (fp #b0 #b00000001 #b00000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000)
                arg1
                (fp #b0 #b10101011 #b10110)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01101100 #b01110)
                arg2
                (fp #b0 #b11011101 #b10111)))
(assert (fp.leq (fp #b0 #b11011101 #b10111)
                arg2
                (fp #b0 #b11111010 #b01001)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10001111 #b11111)
                expect
                (fp #b0 #b11011101 #b10111)))
(assert (fp.leq (fp #b0 #b11011101 #b10111)
                expect
                (fp #b0 #b11100001 #b11010)))

(assert (= expect result))

(check-sat)
(exit)
