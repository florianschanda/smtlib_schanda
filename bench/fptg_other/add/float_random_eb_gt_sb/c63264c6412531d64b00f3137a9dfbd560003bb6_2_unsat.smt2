(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11111111 #b0)
                arg1
                (fp #b1 #b11111110 #b1)))
(assert (fp.leq (fp #b1 #b11111110 #b1)
                arg1
                (fp #b0 #b00101111 #b1)))

(declare-const arg2 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b00111101 #b0)
                arg2
                (fp #b1 #b00000000 #b1)))
(assert (fp.leq (fp #b1 #b00000000 #b1)
                arg2
                (fp #b0 #b00100111 #b0)))

(declare-const result (_ FloatingPoint 8 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
