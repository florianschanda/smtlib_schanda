(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b010010 #b01)
                arg1
                (fp #b0 #b000000 #b01)))
(assert (fp.leq (fp #b0 #b000000 #b01)
                arg1
                (fp #b0 #b001011 #b10)))

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111010 #b01)
                arg2
                (fp #b1 #b100110 #b00)))
(assert (fp.leq (fp #b1 #b100110 #b00)
                arg2
                (fp #b0 #b110111 #b10)))

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111010 #b00)
                expect
                (fp #b1 #b100110 #b00)))
(assert (fp.leq (fp #b1 #b100110 #b00)
                expect
                (fp #b0 #b000101 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
