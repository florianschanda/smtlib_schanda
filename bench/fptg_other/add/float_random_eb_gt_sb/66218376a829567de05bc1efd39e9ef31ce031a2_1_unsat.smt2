(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110100111101 #b111)
                arg1
                (fp #b0 #b000000000000 #b001)))
(assert (fp.leq (fp #b0 #b000000000000 #b001)
                arg1
                (fp #b0 #b001101101011 #b010)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100000000100 #b100)
                arg2
                (fp #b1 #b100000000011 #b000)))
(assert (fp.leq (fp #b1 #b100000000011 #b000)
                arg2
                (fp #b0 #b110011110111 #b000)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100000100010 #b000)
                expect
                (fp #b1 #b100000000010 #b111)))
(assert (fp.leq (fp #b1 #b100000000010 #b111)
                expect
                (fp #b0 #b101001001110 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
