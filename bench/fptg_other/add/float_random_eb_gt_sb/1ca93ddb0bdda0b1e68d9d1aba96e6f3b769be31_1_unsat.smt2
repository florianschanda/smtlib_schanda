(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b001111101 #b11011)
                arg1
                (fp #b0 #b101001100 #b00000)))
(assert (fp.leq (fp #b0 #b101001100 #b00000)
                arg1
                (fp #b0 #b101011111 #b01011)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011010011 #b11011)
                arg2
                (fp #b0 #b000101011 #b10011)))
(assert (fp.leq (fp #b0 #b000101011 #b10011)
                arg2
                (fp #b0 #b010000101 #b10000)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111110010 #b10000)
                expect
                (fp #b0 #b101001100 #b00000)))
(assert (fp.leq (fp #b0 #b101001100 #b00000)
                expect
                (fp #b0 #b101100000 #b01101)))

(assert (not (= expect result)))

(check-sat)
(exit)
