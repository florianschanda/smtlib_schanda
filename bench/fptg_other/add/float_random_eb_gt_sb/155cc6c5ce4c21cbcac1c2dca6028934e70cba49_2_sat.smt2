; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1000011100101101 #b1011100100)
                arg1
                (fp #b1 #b0000000000000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b0000000000)
                arg1
                (fp #b0 #b1101000101010011 #b0001011110)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0111111011000111 #b0110010111)
                arg2
                (fp #b1 #b0100000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0000000000)
                arg2
                (fp #b0 #b1010001000100010 #b1101000110)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1111101011111100 #b0100111010)
                expect
                (fp #b1 #b0100000000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0000000001)
                expect
                (fp #b0 #b0010110001011111 #b1111111001)))

(assert (= expect result))

(check-sat)
(exit)
