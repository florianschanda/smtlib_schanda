                arg2
                (fp #b1 #b01111111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000)
                arg2
                (fp #b1 #b00010010111 #b0101111)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01001110111 #b0110101)
                expect
                (fp #b1 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000)
                expect
                (fp #b0 #b11001111001 #b1111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
