(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11110011 #b100)
                arg1
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                arg1
                (fp #b0 #b11101111 #b111)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111011 #b111)
                arg2
                (fp #b0 #b01111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111 #b101)
                arg2
                (fp #b0 #b11111100 #b001)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b0 #b00011100 #b110)
                expect
                (fp #b0 #b10000011 #b001)))
(assert (fp.leq (fp #b0 #b10000011 #b001)
                expect
                (fp #b0 #b10101000 #b110)))

(assert (= expect result))

(check-sat)
(exit)
