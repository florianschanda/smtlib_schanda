                arg2
                (fp #b0 #b1111111111110 #b10)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0001110010011 #b11)
                expect
                (fp #b0 #b1111111111100 #b11)))
(assert (fp.leq (fp #b0 #b1111111111100 #b11)
                expect
                (fp #b0 #b1111111111101 #b10)))

(assert (not (= expect result)))

