; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b0 #b00001100110010 #b01110011010)
                arg1
                (fp #b0 #b10001110010001 #b01000001010)))
(assert (fp.leq (fp #b0 #b10001110010001 #b01000001010)
                arg1
                (fp #b0 #b10101100000010 #b00001010000)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11111100001111 #b11001110011)
                arg2
                (fp #b1 #b01111111111111 #b00110001010)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00110001010)
                arg2
                (fp #b0 #b10101000101101 #b00000101001)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b0 #b01110100001101 #b10110000110)
                expect
                (fp #b0 #b10001110010001 #b01000001001)))
(assert (fp.leq (fp #b0 #b10001110010001 #b01000001001)
                expect
                (fp #b0 #b11000110001111 #b01111010011)))

(assert (= expect result))

(check-sat)
(exit)
