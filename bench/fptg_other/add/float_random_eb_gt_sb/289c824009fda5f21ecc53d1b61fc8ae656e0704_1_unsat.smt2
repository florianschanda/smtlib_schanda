; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00011000 #b100)
                arg1
                (fp #b0 #b00000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000 #b010)
                arg1
                (fp #b0 #b10000111 #b000)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111101 #b110)
                arg2
                (fp #b1 #b00000000 #b101)))
(assert (fp.leq (fp #b1 #b00000000 #b101)
                arg2
                (fp #b0 #b00111011 #b001)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01100010 #b001)
                expect
                (fp #b1 #b00000000 #b011)))
(assert (fp.leq (fp #b1 #b00000000 #b011)
                expect
                (fp #b0 #b11100100 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
