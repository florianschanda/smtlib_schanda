(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001001011 #b1)
                arg1
                (fp #b1 #b000000000 #b1)))
(assert (fp.leq (fp #b1 #b000000000 #b1)
                arg1
                (fp #b0 #b010011011 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111110100 #b0)
                arg2
                (fp #b1 #b101111110 #b1)))
(assert (fp.leq (fp #b1 #b101111110 #b1)
                arg2
                (fp #b0 #b011110000 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b110101010 #b0)
                expect
                (fp #b1 #b101111111 #b0)))
(assert (fp.leq (fp #b1 #b101111111 #b0)
                expect
                (fp #b0 #b111011010 #b0)))

(assert (= expect result))

(check-sat)
(exit)
