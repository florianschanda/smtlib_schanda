(assert (fp.leq (fp #b0 #b111000101011011100 #b00001)
                arg2
                (fp #b0 #b111111111000111111 #b00011)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b0 #b100010111100110101 #b11001)
                expect
                (fp #b0 #b111000101011011100 #b00001)))
(assert (fp.leq (fp #b0 #b111000101011011100 #b00001)
                expect
                (fp #b0 #b111010011100110111 #b11100)))

(assert (= expect result))

(check-sat)
