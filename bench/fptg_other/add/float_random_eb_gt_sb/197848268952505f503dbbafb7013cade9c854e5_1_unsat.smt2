(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11110 #b101)
                arg1
                (fp #b1 #b00110 #b011)))
(assert (fp.leq (fp #b1 #b00110 #b011)
                arg1
                (fp #b0 #b01001 #b100)))

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00100 #b001)
                arg2
                (fp #b0 #b00110 #b011)))
(assert (fp.leq (fp #b0 #b00110 #b011)
                arg2
                (fp #b0 #b10111 #b000)))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10001 #b100)
                expect
                (fp #b0 #b00000 #b000)))
(assert (fp.leq (fp #b0 #b00000 #b000)
                expect
                (fp #b0 #b10100 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
