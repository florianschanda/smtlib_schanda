                (fp #b0 #b111011101101100 #b000011)))
(assert (fp.leq (fp #b0 #b111011101101100 #b000011)
                arg2
                (fp #b0 #b111100011100001 #b001101)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b010011001010100 #b100001)
                expect
                (fp #b0 #b111011101101100 #b000010)))
(assert (fp.leq (fp #b0 #b111011101101100 #b000010)
                expect
                (fp #b0 #b111101100011000 #b111101)))

(assert (= expect result))

(check-sat)
(exit)
