; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b01101 #b111)
                arg1
                (fp #b0 #b11100 #b110)))
(assert (fp.leq (fp #b0 #b11100 #b110)
                arg1
                (fp #b0 #b11110 #b011)))

(declare-const arg2 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b01001 #b110)
                arg2
                (fp #b0 #b01111 #b110)))
(assert (fp.leq (fp #b0 #b01111 #b110)
                arg2
                (fp #b0 #b10111 #b100)))

(declare-const result (_ FloatingPoint 5 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00010 #b000)
                expect
                (fp #b0 #b11100 #b111)))
(assert (fp.leq (fp #b0 #b11100 #b111)
                expect
                (fp #b0 #b11110 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
