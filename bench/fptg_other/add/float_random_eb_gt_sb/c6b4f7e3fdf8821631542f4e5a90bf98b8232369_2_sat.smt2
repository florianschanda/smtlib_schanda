; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11111010100111100 #b1010)
                arg1
                (fp #b1 #b00000000000000000 #b1111)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1111)
                arg1
                (fp #b0 #b00110110001111100 #b1110)))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11011001101100111 #b1100)
                arg2
                (fp #b1 #b11001111110101110 #b1001)))
(assert (fp.leq (fp #b1 #b11001111110101110 #b1001)
                arg2
                (fp #b0 #b01001010100011001 #b1111)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11010111000111000 #b0100)
                expect
                (fp #b1 #b11001111110101110 #b1010)))
(assert (fp.leq (fp #b1 #b11001111110101110 #b1010)
                expect
                (fp #b1 #b10101011111101000 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
