(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01101111 #b100)
                arg1
                (fp #b0 #b00000000 #b111)))
(assert (fp.leq (fp #b0 #b00000000 #b111)
                arg1
                (fp #b0 #b00111001 #b011)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01010110 #b101)
                arg2
                (fp #b1 #b00000000 #b111)))
(assert (fp.leq (fp #b1 #b00000000 #b111)
                arg2
                (fp #b0 #b11100000 #b010)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000010 #b101)
                expect
                (fp #b1 #b00000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000 #b000)
                expect
                (fp #b0 #b00010011 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
