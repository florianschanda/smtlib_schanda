(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11011100100 #b10)
                arg1
                (fp #b1 #b10000000001 #b00)))
(assert (fp.leq (fp #b1 #b10000000001 #b00)
                arg1
                (fp #b0 #b10100011000 #b00)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b01101111011 #b00)
                arg2
                (fp #b0 #b11111111101 #b00)))
(assert (fp.leq (fp #b0 #b11111111101 #b00)
                arg2
                (fp #b0 #b11111111101 #b11)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b00011001101 #b11)
                expect
                (fp #b0 #b11111111100 #b11)))
(assert (fp.leq (fp #b0 #b11111111100 #b11)
                expect
                (fp #b0 #b11111111110 #b00)))

(assert (= expect result))

(check-sat)
(exit)
