(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b11001101 #b0110)
                arg1
                (fp #b0 #b11110001 #b0100)))
(assert (fp.leq (fp #b0 #b11110001 #b0100)
                arg1
                (fp #b0 #b11111011 #b1100)))

(declare-const arg2 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11110000 #b1001)
                arg2
                (fp #b0 #b00000000 #b0100)))
(assert (fp.leq (fp #b0 #b00000000 #b0100)
                arg2
                (fp #b0 #b11010000 #b1111)))

(declare-const result (_ FloatingPoint 8 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b0 #b01001100 #b1111)
                expect
                (fp #b0 #b11110001 #b0100)))
(assert (fp.leq (fp #b0 #b11110001 #b0100)
                expect
                (fp #b0 #b11111110 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
