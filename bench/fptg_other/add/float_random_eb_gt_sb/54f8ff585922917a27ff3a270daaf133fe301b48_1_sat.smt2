(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01000111 #b000)
                arg1
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                arg1
                (fp #b0 #b11010000 #b101)))

(declare-const arg2 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b00101100 #b011)
                arg2
                (fp #b0 #b00010000 #b011)))
(assert (fp.leq (fp #b0 #b00010000 #b011)
                arg2
                (fp #b0 #b10011011 #b010)))

(declare-const result (_ FloatingPoint 8 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01000010 #b101)
                expect
                (fp #b0 #b10000011 #b000)))
(assert (fp.leq (fp #b0 #b10000011 #b000)
                expect
                (fp #b0 #b11011011 #b101)))

(assert (= expect result))

(check-sat)
(exit)
