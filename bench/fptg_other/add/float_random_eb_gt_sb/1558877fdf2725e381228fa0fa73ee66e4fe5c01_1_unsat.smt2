(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0100001 #b01000)
                expect
                (fp #b1 #b0000000 #b10101)))
(assert (fp.leq (fp #b1 #b0000000 #b10101)
                expect
                (fp #b0 #b0011110 #b00111)))

(assert (not (= expect result)))

