(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101101001 #b0011)
                arg1
                (fp #b1 #b011100100 #b1101)))
(assert (fp.leq (fp #b1 #b011100100 #b1101)
                arg1
                (fp #b1 #b011011100 #b0000)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101011010 #b0001)
                arg2
                (fp #b0 #b100110111 #b1100)))
(assert (fp.leq (fp #b0 #b100110111 #b1100)
                arg2
                (fp #b0 #b100111101 #b0101)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b100110000 #b0100)
                expect
                (fp #b0 #b100110111 #b1100)))
(assert (fp.leq (fp #b0 #b100110111 #b1100)
                expect
                (fp #b0 #b111010011 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
