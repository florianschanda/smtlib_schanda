(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001100001 #b011)
                arg1
                (fp #b1 #b1001000000 #b001)))
(assert (fp.leq (fp #b1 #b1001000000 #b001)
                arg1
                (fp #b0 #b0111011100 #b010)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b1100000011 #b110)
                arg2
                (fp #b0 #b1110000011 #b101)))
(assert (fp.leq (fp #b0 #b1110000011 #b101)
                arg2
                (fp #b0 #b1110010001 #b110)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100010111 #b101)
                expect
                (fp #b0 #b1110000011 #b100)))
(assert (fp.leq (fp #b0 #b1110000011 #b100)
                expect
                (fp #b0 #b1111101010 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
