(assert (fp.leq (fp #b1 #b01100111 #b10)
                arg2
                (fp #b0 #b01010101 #b01)))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10111101 #b10)
                expect
                (fp #b1 #b01101001 #b00)))
(assert (fp.leq (fp #b1 #b01101001 #b00)
                expect
                (fp #b1 #b00101010 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
