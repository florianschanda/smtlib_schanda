                arg1
                (fp #b0 #b011111111111 #b1011110)))
(assert (fp.leq (fp #b0 #b011111111111 #b1011110)
                arg1
                (fp #b0 #b110011011110 #b1101010)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110100001110 #b1101111)
                arg2
                (fp #b0 #b000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0100000)
                arg2
                (fp #b0 #b110100111111 #b1010010)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000101100100 #b0101111)
                expect
                (fp #b0 #b011111111111 #b1011111)))
(assert (fp.leq (fp #b0 #b011111111111 #b1011111)
                expect
                (fp #b0 #b111110111011 #b1111001)))

(assert (= expect result))

(check-sat)
(exit)
