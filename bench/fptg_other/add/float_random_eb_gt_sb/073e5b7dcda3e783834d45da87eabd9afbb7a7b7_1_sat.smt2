(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100111 #b0100)
                arg1
                (fp #b1 #b011111 #b1010)))
(assert (fp.leq (fp #b1 #b011111 #b1010)
                arg1
                (fp #b0 #b001101 #b1001)))

(declare-const arg2 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b011111 #b0000)
                arg2
                (fp #b1 #b001101 #b1100)))
(assert (fp.leq (fp #b1 #b001101 #b1100)
                arg2
                (fp #b0 #b101011 #b1100)))

(declare-const result (_ FloatingPoint 6 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100110 #b0001)
                expect
                (fp #b1 #b011111 #b1010)))
(assert (fp.leq (fp #b1 #b011111 #b1010)
                expect
                (fp #b0 #b000001 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
