(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00001101 #b100101)
                arg1
                (fp #b0 #b00000011 #b111010)))
(assert (fp.leq (fp #b0 #b00000011 #b111010)
                arg1
                (fp #b0 #b01100011 #b011010)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b00001101 #b111011)
                arg2
                (fp #b0 #b01000000 #b000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000)
                arg2
                (fp #b0 #b01101010 #b101111)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10001111 #b011000)
                expect
                (fp #b0 #b01000000 #b000000)))
(assert (fp.leq (fp #b0 #b01000000 #b000000)
                expect
                (fp #b0 #b01100100 #b110010)))

(assert (= expect result))

(check-sat)
(exit)
