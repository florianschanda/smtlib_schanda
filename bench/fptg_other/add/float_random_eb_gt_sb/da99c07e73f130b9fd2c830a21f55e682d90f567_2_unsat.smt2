(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b010101001 #b01)
                arg1
                (fp #b1 #b000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000 #b01)
                arg1
                (fp #b0 #b000111101 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110000001 #b01)
                arg2
                (fp #b1 #b010000000 #b00)))
(assert (fp.leq (fp #b1 #b010000000 #b00)
                arg2
                (fp #b0 #b001010110 #b01)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011110101 #b01)
                expect
                (fp #b1 #b010000000 #b01)))
(assert (fp.leq (fp #b1 #b010000000 #b01)
                expect
                (fp #b0 #b010101111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
