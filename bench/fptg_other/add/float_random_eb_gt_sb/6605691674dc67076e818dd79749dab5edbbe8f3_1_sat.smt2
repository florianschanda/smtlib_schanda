                (fp #b0 #b0000000000000001 #b1011100)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b1011100)
                expect
                (fp #b0 #b1101010100011000 #b1011001)))

(assert (= expect result))

(check-sat)
