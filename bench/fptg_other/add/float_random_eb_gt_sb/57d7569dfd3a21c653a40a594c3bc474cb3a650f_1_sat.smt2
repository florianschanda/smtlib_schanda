(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0100010 #b00101)
                arg1
                (fp #b1 #b0000000 #b01000)))
(assert (fp.leq (fp #b1 #b0000000 #b01000)
                arg1
                (fp #b0 #b0001010 #b01111)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0101100 #b01111)
                arg2
                (fp #b1 #b0100000 #b00000)))
(assert (fp.leq (fp #b1 #b0100000 #b00000)
                arg2
                (fp #b0 #b0101010 #b11011)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111001 #b11000)
                expect
                (fp #b1 #b0100000 #b00000)))
(assert (fp.leq (fp #b1 #b0100000 #b00000)
                expect
                (fp #b0 #b0011000 #b11100)))

(assert (= expect result))

(check-sat)
(exit)
