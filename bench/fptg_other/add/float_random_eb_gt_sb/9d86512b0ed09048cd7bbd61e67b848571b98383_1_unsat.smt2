(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1101100110101110 #b000011001)
                expect
                (fp #b0 #b0011111111111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111111111011 #b011010100)
                expect
                (fp #b0 #b1011001001100011 #b100000000)))

(assert (not (= expect result)))

(check-sat)
