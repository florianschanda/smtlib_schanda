(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111101 #b101100)
                arg1
                (fp #b1 #b11111101 #b000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000)
                arg1
                (fp #b0 #b11011001 #b010111)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11101110 #b101110)
                arg2
                (fp #b1 #b00000000 #b101100)))
(assert (fp.leq (fp #b1 #b00000000 #b101100)
                arg2
                (fp #b0 #b01111011 #b010110)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111101 #b111010)
                expect
                (fp #b1 #b11111101 #b000000)))
(assert (fp.leq (fp #b1 #b11111101 #b000000)
                expect
                (fp #b0 #b00111110 #b010100)))

(assert (= expect result))

(check-sat)
(exit)
