(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100011 #b11)
                arg1
                (fp #b1 #b100001 #b00)))
(assert (fp.leq (fp #b1 #b100001 #b00)
                arg1
                (fp #b0 #b110110 #b10)))

(declare-const arg2 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100011 #b01)
                arg2
                (fp #b1 #b001110 #b10)))
(assert (fp.leq (fp #b1 #b001110 #b10)
                arg2
                (fp #b0 #b110010 #b00)))

(declare-const result (_ FloatingPoint 6 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b100010 #b00)
                expect
                (fp #b1 #b100001 #b00)))
(assert (fp.leq (fp #b1 #b100001 #b00)
                expect
                (fp #b1 #b011010 #b10)))

(assert (= expect result))

(check-sat)
(exit)
