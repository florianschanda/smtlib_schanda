; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111101 #b1010)
                arg1
                (fp #b1 #b0001010 #b0001)))
(assert (fp.leq (fp #b1 #b0001010 #b0001)
                arg1
                (fp #b0 #b0111011 #b0111)))

(declare-const arg2 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0111010 #b0100)
                arg2
                (fp #b1 #b0110101 #b1110)))
(assert (fp.leq (fp #b1 #b0110101 #b1110)
                arg2
                (fp #b1 #b0011010 #b0010)))

(declare-const result (_ FloatingPoint 7 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1000110 #b1100)
                expect
                (fp #b1 #b0110101 #b1110)))
(assert (fp.leq (fp #b1 #b0110101 #b1110)
                expect
                (fp #b0 #b0110101 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
