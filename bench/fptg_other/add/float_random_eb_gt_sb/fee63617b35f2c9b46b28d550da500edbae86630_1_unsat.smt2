(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10010010 #b01011)
                arg1
                (fp #b1 #b00111101 #b01101)))
(assert (fp.leq (fp #b1 #b00111101 #b01101)
                arg1
                (fp #b0 #b00100101 #b10111)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01001001 #b10101)
                arg2
                (fp #b1 #b00000000 #b10110)))
(assert (fp.leq (fp #b1 #b00000000 #b10110)
                arg2
                (fp #b0 #b00111111 #b10110)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10111001 #b11001)
                expect
                (fp #b1 #b00111101 #b01101)))
(assert (fp.leq (fp #b1 #b00111101 #b01101)
                expect
                (fp #b0 #b01000010 #b11001)))

(assert (not (= expect result)))

(check-sat)
(exit)
