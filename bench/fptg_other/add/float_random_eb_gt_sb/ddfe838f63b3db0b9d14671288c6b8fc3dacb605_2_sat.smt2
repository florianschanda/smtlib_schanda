(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11101011 #b100111)
                arg1
                (fp #b1 #b10111110 #b111111)))
(assert (fp.leq (fp #b1 #b10111110 #b111111)
                arg1
                (fp #b0 #b01111101 #b100001)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11010110 #b010001)
                arg2
                (fp #b0 #b11111010 #b011101)))
(assert (fp.leq (fp #b0 #b11111010 #b011101)
                arg2
                (fp #b0 #b11111010 #b100000)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b0 #b11111010 #b001010)
                expect
                (fp #b0 #b11111010 #b011101)))
(assert (fp.leq (fp #b0 #b11111010 #b011101)
                expect
                (fp #b0 #b11111011 #b001000)))

(assert (= expect result))

(check-sat)
(exit)
