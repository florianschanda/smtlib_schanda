(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b0 #b0011100101110101 #b1000101001)
                expect
                (fp #b0 #b1110111001010011 #b0010110101)))
(assert (fp.leq (fp #b0 #b1110111001010011 #b0010110101)
                expect
                (fp #b0 #b1111010010100110 #b0000110000)))

(assert (= expect result))

(check-sat)
