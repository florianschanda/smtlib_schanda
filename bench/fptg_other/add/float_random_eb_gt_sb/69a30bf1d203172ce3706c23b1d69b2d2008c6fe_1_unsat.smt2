(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1011011111111110 #b1001)
                arg1
                (fp #b0 #b0111111111111111 #b0110)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b0110)
                arg1
                (fp #b0 #b1111001111110100 #b0000)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1010011001110110 #b1010)
                arg2
                (fp #b1 #b0000000000000000 #b0001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0001)
                arg2
                (fp #b0 #b1101011010110101 #b1100)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1001101000110000 #b0111)
                expect
                (fp #b0 #b0111111111111111 #b0101)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b0101)
                expect
                (fp #b0 #b1000000111101111 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
