(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00110000 #b101000)
                arg1
                (fp #b0 #b00000001 #b000000)))
(assert (fp.leq (fp #b0 #b00000001 #b000000)
                arg1
                (fp #b0 #b10100011 #b111011)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11011011 #b011111)
                arg2
                (fp #b1 #b11010110 #b010011)))
(assert (fp.leq (fp #b1 #b11010110 #b010011)
                arg2
                (fp #b0 #b11111010 #b000110)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11110100 #b111101)
                expect
                (fp #b1 #b11010110 #b010010)))
(assert (fp.leq (fp #b1 #b11010110 #b010010)
                expect
                (fp #b1 #b10000110 #b110100)))

(assert (= expect result))

(check-sat)
(exit)
