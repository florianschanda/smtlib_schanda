(assert (fp.leq (fp #b1 #b0000000000000001 #b00000000)
                arg2
                (fp #b0 #b1100101110110011 #b00101000)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0010111001001100 #b00000001)
                expect
                (fp #b0 #b0010000000000100 #b10100011)))
(assert (fp.leq (fp #b0 #b0010000000000100 #b10100011)
                expect
                (fp #b0 #b0010101000110011 #b01100101)))

(assert (not (= expect result)))

(check-sat)
