; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b0 #b0010001110101 #b01000001)
                arg1
                (fp #b0 #b0100100010011 #b00101000)))
(assert (fp.leq (fp #b0 #b0100100010011 #b00101000)
                arg1
                (fp #b0 #b0110100001001 #b00110001)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1111111000110 #b00001111)
                arg2
                (fp #b1 #b0000000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00000001)
                arg2
                (fp #b0 #b1110011001110 #b11010011)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0111011000101 #b01100010)
                expect
                (fp #b0 #b0100100010011 #b00100111)))
(assert (fp.leq (fp #b0 #b0100100010011 #b00100111)
                expect
                (fp #b0 #b1100001011000 #b10101000)))

(assert (= expect result))

(check-sat)
(exit)
