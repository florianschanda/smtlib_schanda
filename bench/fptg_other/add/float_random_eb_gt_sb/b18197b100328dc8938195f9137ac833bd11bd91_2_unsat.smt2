; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b100111100 #b0000010)
                arg1
                (fp #b0 #b110111110 #b0101110)))
(assert (fp.leq (fp #b0 #b110111110 #b0101110)
                arg1
                (fp #b0 #b111010110 #b1100001)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110000111 #b1101001)
                arg2
                (fp #b1 #b101111110 #b1111111)))
(assert (fp.leq (fp #b1 #b101111110 #b1111111)
                arg2
                (fp #b1 #b011000000 #b0101011)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000100111 #b0000011)
                expect
                (fp #b0 #b110111110 #b0101110)))
(assert (fp.leq (fp #b0 #b110111110 #b0101110)
                expect
                (fp #b0 #b111110001 #b0000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
