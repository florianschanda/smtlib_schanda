(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111110 #b10110)
                arg1
                (fp #b1 #b111100000 #b00011)))
(assert (fp.leq (fp #b1 #b111100000 #b00011)
                arg1
                (fp #b0 #b001000101 #b01111)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100101 #b01111)
                expect
                (fp #b1 #b111100001 #b00011)))
(assert (fp.leq (fp #b1 #b111100001 #b00011)
                expect
                (fp #b1 #b010100111 #b11101)))

(assert (= expect result))

(check-sat)
(exit)
