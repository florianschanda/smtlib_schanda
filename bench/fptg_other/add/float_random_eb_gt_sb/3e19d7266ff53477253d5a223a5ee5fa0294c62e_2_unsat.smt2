(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b0110111 #b10111)
                arg1
                (fp #b1 #b0000001 #b00000)))
(assert (fp.leq (fp #b1 #b0000001 #b00000)
                arg1
                (fp #b0 #b1111010 #b11010)))

(declare-const arg2 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110101 #b10000)
                arg2
                (fp #b1 #b0111111 #b01000)))
(assert (fp.leq (fp #b1 #b0111111 #b01000)
                arg2
                (fp #b0 #b1010000 #b00000)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1101100 #b00000)
                expect
                (fp #b1 #b0111111 #b01001)))
(assert (fp.leq (fp #b1 #b0111111 #b01001)
                expect
                (fp #b1 #b0011010 #b01000)))

(assert (not (= expect result)))

(check-sat)
(exit)
