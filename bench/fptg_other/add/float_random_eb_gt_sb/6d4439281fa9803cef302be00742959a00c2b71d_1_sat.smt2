(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b101100011100 #b1100)
                arg1
                (fp #b1 #b000000000000 #b0011)))
(assert (fp.leq (fp #b1 #b000000000000 #b0011)
                arg1
                (fp #b0 #b000111001001 #b1001)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b100011101110 #b0001)
                arg2
                (fp #b0 #b111111111101 #b0000)))
(assert (fp.leq (fp #b0 #b111111111101 #b0000)
                arg2
                (fp #b0 #b111111111110 #b1111)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100101011001 #b0011)
                expect
                (fp #b0 #b111111111100 #b1111)))
(assert (fp.leq (fp #b0 #b111111111100 #b1111)
                expect
                (fp #b0 #b111111111110 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
