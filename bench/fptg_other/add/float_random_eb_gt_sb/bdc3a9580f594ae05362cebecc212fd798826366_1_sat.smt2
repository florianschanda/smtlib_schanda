(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10011001 #b011010)
                arg1
                (fp #b1 #b10001100 #b011011)))
(assert (fp.leq (fp #b1 #b10001100 #b011011)
                arg1
                (fp #b0 #b11001100 #b100100)))

(declare-const arg2 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10010010 #b110100)
                arg2
                (fp #b1 #b01111111 #b001000)))
(assert (fp.leq (fp #b1 #b01111111 #b001000)
                arg2
                (fp #b0 #b11001111 #b011001)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10011001 #b000001)
                expect
                (fp #b1 #b10001100 #b011011)))
(assert (fp.leq (fp #b1 #b10001100 #b011011)
                expect
                (fp #b1 #b01001011 #b011010)))

(assert (= expect result))

(check-sat)
(exit)
