(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10100000 #b00010)
                arg1
                (fp #b0 #b10000100 #b01100)))
(assert (fp.leq (fp #b0 #b10000100 #b01100)
                arg1
                (fp #b0 #b11001011 #b11111)))

(declare-const arg2 (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11011111 #b10110)
                arg2
                (fp #b0 #b00000001 #b00000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000)
                arg2
                (fp #b0 #b01100001 #b10111)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b00110010 #b11100)
                expect
                (fp #b0 #b10000100 #b01100)))
(assert (fp.leq (fp #b0 #b10000100 #b01100)
                expect
                (fp #b0 #b10001011 #b01010)))

(assert (not (= expect result)))

(check-sat)
(exit)
