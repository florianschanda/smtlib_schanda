                arg2
                (fp #b1 #b00000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000011)
                arg2
                (fp #b0 #b11010101010 #b1000110)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11101111011 #b1011110)
                expect
                (fp #b1 #b00111111100 #b0110110)))
(assert (fp.leq (fp #b1 #b00111111100 #b0110110)
                expect
                (fp #b1 #b00001000110 #b1100110)))

(assert (= expect result))

(check-sat)
(exit)
