(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b00100100101 #b111)
                arg1
                (fp #b0 #b10000000010 #b111)))
(assert (fp.leq (fp #b0 #b10000000010 #b111)
                arg1
                (fp #b0 #b10010011100 #b100)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11000011001 #b010)
                arg2
                (fp #b0 #b10111111110 #b111)))
(assert (fp.leq (fp #b0 #b10111111110 #b111)
                arg2
                (fp #b0 #b11111110101 #b111)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b00000110000 #b001)
                expect
                (fp #b0 #b10111111110 #b111)))
(assert (fp.leq (fp #b0 #b10111111110 #b111)
                expect
                (fp #b0 #b11010100110 #b000)))

(assert (= expect result))

(check-sat)
(exit)
