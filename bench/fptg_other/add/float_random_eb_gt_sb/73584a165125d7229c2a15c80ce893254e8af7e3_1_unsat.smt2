; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b100100110111000 #b10)
                arg1
                (fp #b1 #b001011011011101 #b00)))
(assert (fp.leq (fp #b1 #b001011011011101 #b00)
                arg1
                (fp #b0 #b000010000111000 #b11)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b010101010111111 #b00)
                arg2
                (fp #b0 #b111110000101010 #b11)))
(assert (fp.leq (fp #b0 #b111110000101010 #b11)
                arg2
                (fp #b0 #b111110110010000 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b001011110010011 #b00)
                expect
                (fp #b0 #b111110000101010 #b10)))
(assert (fp.leq (fp #b0 #b111110000101010 #b10)
                expect
                (fp #b0 #b111111011101100 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
