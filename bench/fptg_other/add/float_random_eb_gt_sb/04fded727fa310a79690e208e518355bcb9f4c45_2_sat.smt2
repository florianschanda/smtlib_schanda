(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11010000 #b01)
                arg1
                (fp #b0 #b00000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000 #b01)
                arg1
                (fp #b0 #b01000001 #b01)))

(declare-const arg2 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b01110110 #b10)
                arg2
                (fp #b0 #b01000000 #b00)))
(assert (fp.leq (fp #b0 #b01000000 #b00)
                arg2
                (fp #b0 #b10111011 #b00)))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10001111 #b00)
                expect
                (fp #b0 #b01000000 #b01)))
(assert (fp.leq (fp #b0 #b01000000 #b01)
                expect
                (fp #b0 #b11100010 #b00)))

(assert (= expect result))

(check-sat)
(exit)
