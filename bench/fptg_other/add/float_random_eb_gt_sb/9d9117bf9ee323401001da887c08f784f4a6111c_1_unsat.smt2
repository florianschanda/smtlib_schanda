;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1001111110111100 #b001000)
                arg1
                (fp #b1 #b0111111111111111 #b101110)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b101110)
                arg1
                (fp #b1 #b0100110000011101 #b001000)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0001111110111001 #b010001)
                arg2
                (fp #b0 #b0000000000000001 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b000000)
                arg2
                (fp #b0 #b0000001000001101 #b101000)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1000101110011010 #b110001)
                expect
                (fp #b1 #b0111111111111111 #b101101)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b101101)
                expect
                (fp #b1 #b0100101001111111 #b011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
