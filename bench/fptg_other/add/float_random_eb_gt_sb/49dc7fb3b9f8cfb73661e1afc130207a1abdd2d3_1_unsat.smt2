(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1011100100 #b01011100)
                arg1
                (fp #b0 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000000)
                arg1
                (fp #b0 #b1101110011 #b01110011)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0010010110 #b01100011)
                arg2
                (fp #b0 #b0000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000001)
                arg2
                (fp #b0 #b1101100110 #b01101011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001100011 #b11100101)
                expect
                (fp #b0 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000000)
                expect
                (fp #b0 #b1001101000 #b01000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
