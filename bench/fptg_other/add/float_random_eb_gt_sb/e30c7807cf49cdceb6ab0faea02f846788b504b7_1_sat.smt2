(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11001001111 #b0)
                arg1
                (fp #b1 #b10000000001 #b0)))
(assert (fp.leq (fp #b1 #b10000000001 #b0)
                arg1
                (fp #b1 #b00111000001 #b0)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01010110101 #b1)
                arg2
                (fp #b0 #b00000000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000000 #b1)
                arg2
                (fp #b0 #b11100101100 #b1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11100011100 #b0)
                expect
                (fp #b1 #b10000000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000000 #b1)
                expect
                (fp #b0 #b10011000110 #b0)))

(assert (= expect result))

(check-sat)
(exit)
