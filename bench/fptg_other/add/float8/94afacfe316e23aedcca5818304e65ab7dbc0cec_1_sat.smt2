(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0011)
                arg1
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                arg1
                (fp #b0 #b110 #b0000)))

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0101)
                arg2
                (fp #b0 #b010 #b0000)))
(assert (fp.leq (fp #b0 #b010 #b0000)
                arg2
                (fp #b0 #b011 #b1110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0010)
                expect
                (fp #b0 #b001 #b1101)))
(assert (fp.leq (fp #b0 #b001 #b1101)
                expect
                (fp #b0 #b110 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
