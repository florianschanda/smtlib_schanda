(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0010)
                arg1
                (fp #b0 #b101 #b1000)))
(assert (fp.leq (fp #b0 #b101 #b1000)
                arg1
                (fp #b0 #b111 #b0000)))

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1111)
                arg2
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                arg2
                (fp #b0 #b110 #b1111)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
