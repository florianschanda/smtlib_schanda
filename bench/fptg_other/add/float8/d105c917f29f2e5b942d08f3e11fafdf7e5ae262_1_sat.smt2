(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1010)
                arg1
                (fp #b1 #b001 #b0110)))
(assert (fp.leq (fp #b1 #b001 #b0110)
                arg1
                (fp #b0 #b010 #b1100)))

(declare-const arg2 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b001 #b0011)
                arg2
                (fp #b0 #b101 #b0011)))
(assert (fp.leq (fp #b0 #b101 #b0011)
                arg2
                (fp #b0 #b110 #b0000)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0100)
                expect
                (fp #b0 #b101 #b0001)))
(assert (fp.leq (fp #b0 #b101 #b0001)
                expect
                (fp #b0 #b101 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
