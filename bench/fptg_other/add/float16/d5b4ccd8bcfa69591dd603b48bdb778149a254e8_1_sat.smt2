(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01111 #b0101111000)
                arg1
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg1
                (fp #b0 #b01110 #b1001111011)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00010 #b0100011111)
                arg2
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                arg2
                (fp #b0 #b11010 #b0001111010)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1110100000)
                expect
                (fp #b0 #b11010 #b0000000001)))
(assert (fp.leq (fp #b0 #b11010 #b0000000001)
                expect
                (fp #b0 #b11011 #b1000010010)))

(assert (= expect result))

(check-sat)
(exit)
