(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01110 #b0001111100)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11011 #b1000010111)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg2
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg2
                (fp #b0 #b00110 #b1000000010)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111111000)
                expect
                (fp #b1 #b11110 #b1111101101)))
(assert (fp.leq (fp #b1 #b11110 #b1111101101)
                expect
                (fp #b0 #b00011 #b0100101011)))

(assert (= expect result))

(check-sat)
(exit)
