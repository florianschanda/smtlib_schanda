(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1111001100)
                arg1
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                arg1
                (fp #b0 #b11010 #b0101010101)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00110 #b0000110011)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b0 #b00110 #b1100100000)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b1110100111)
                expect
                (fp #b1 #b00110 #b0100111010)))
(assert (fp.leq (fp #b1 #b00110 #b0100111010)
                expect
                (fp #b0 #b01001 #b0010101011)))

(assert (= expect result))

(check-sat)
(exit)
