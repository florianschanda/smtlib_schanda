; Format: FLOAT16
; Arg1: +ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1100111001)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b11101 #b0010011011)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1001001100)
                arg2
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg2
                (fp #b0 #b01000 #b0010110010)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0101000110)
                expect
                (fp #b0 #b01110 #b1111110000)))
(assert (fp.leq (fp #b0 #b01110 #b1111110000)
                expect
                (fp #b0 #b10110 #b0111111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
