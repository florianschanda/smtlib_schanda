(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1011110001)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11110 #b1010111111)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0010001100)
                arg2
                (fp #b1 #b11000 #b0100001100)))
(assert (fp.leq (fp #b1 #b11000 #b0100001100)
                arg2
                (fp #b1 #b10101 #b0100100101)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b1100100010)
                expect
                (fp #b1 #b10101 #b0111101000)))
(assert (fp.leq (fp #b1 #b10101 #b0111101000)
                expect
                (fp #b1 #b10000 #b0100101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
