(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01101 #b1110010100)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b00111 #b1110101111)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1000101001)
                arg2
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg2
                (fp #b1 #b00000 #b1111100011)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b1011110001)
                expect
                (fp #b1 #b00001 #b1010010100)))
(assert (fp.leq (fp #b1 #b00001 #b1010010100)
                expect
                (fp #b0 #b10001 #b1111101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
