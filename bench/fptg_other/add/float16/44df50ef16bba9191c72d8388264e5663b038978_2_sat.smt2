(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01011 #b1001000111)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b11000 #b0111110100)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b00011 #b0100000001)
                arg2
                (fp #b0 #b01011 #b0000100001)))
(assert (fp.leq (fp #b0 #b01011 #b0000100001)
                arg2
                (fp #b0 #b11100 #b0101010011)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00010 #b0111110101)
                expect
                (fp #b0 #b10010 #b1101110100)))
(assert (fp.leq (fp #b0 #b10010 #b1101110100)
                expect
                (fp #b0 #b11001 #b1001110110)))

(assert (= expect result))

(check-sat)
(exit)
