; Format: FLOAT16
; Arg1: +ONE
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01001 #b0100000111)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b11110 #b0111110110)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b0 #b01101 #b1101011101)
                arg2
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg2
                (fp #b0 #b10100 #b0010101101)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01111 #b1111101010)
                expect
                (fp #b0 #b10000 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000 #b0000000000)
                expect
                (fp #b0 #b10110 #b1001011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
