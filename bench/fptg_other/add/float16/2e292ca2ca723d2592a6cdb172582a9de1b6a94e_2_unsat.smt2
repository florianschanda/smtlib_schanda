(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01001 #b1110011010)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b10011 #b1101111010)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0111101111)
                arg2
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg2
                (fp #b0 #b11110 #b1100011100)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0011111011)
                expect
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                expect
                (fp #b0 #b10000 #b0011111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
