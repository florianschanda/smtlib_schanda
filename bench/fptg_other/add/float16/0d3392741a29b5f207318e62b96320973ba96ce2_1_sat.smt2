; Format: FLOAT16
; Arg1: -ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0010101110)
                arg1
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg1
                (fp #b1 #b01011 #b1111010001)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b00111 #b0111010100)
                arg2
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg2
                (fp #b0 #b10110 #b1111100100)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1100011111)
                expect
                (fp #b1 #b01110 #b1111110000)))
(assert (fp.leq (fp #b1 #b01110 #b1111110000)
                expect
                (fp #b0 #b10111 #b1001000111)))

(assert (= expect result))

(check-sat)
(exit)
