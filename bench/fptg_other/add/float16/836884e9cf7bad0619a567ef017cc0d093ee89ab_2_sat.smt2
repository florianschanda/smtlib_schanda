(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110100000)
                arg1
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                arg1
                (fp #b1 #b00011 #b0001000011)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0111100110)
                arg2
                (fp #b1 #b01111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111 #b0011111110)
                arg2
                (fp #b1 #b01010 #b0011000000)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0100110110)
                expect
                (fp #b1 #b11010 #b1101100111)))
(assert (fp.leq (fp #b1 #b11010 #b1101100111)
                expect
                (fp #b0 #b01110 #b0010110110)))

(assert (= expect result))

(check-sat)
(exit)
