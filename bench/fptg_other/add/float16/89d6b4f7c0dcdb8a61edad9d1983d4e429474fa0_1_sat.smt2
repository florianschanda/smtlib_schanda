(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT16
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111101011)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b10110 #b1010100000)))

(declare-const arg2 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0110010101)
                arg2
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg2
                (fp #b0 #b11101 #b1100011100)))

(declare-const result Float16)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b11000 #b1101010010)
                expect
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                expect
                (fp #b0 #b11110 #b1001110011)))

(assert (= expect result))

(check-sat)
(exit)
