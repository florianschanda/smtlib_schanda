; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101001 #b01010010001101001000011)
                arg1
                (fp #b1 #b01111111 #b01000101000011100000101)))
(assert (fp.leq (fp #b1 #b01111111 #b01000101000011100000101)
                arg1
                (fp #b1 #b01011111 #b11100010001010011110000)))
; arg1 = -1.26974546909332275390625

(declare-const result Float32)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
