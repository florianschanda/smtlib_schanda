; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b10011011001011111111011)
                arg1
                (fp #b1 #b10000110 #b01010010101110101101100)))
(assert (fp.leq (fp #b1 #b10000110 #b01010010101110101101100)
                arg1
                (fp #b0 #b11101001 #b10011010000011111101000)))
; arg1 = -169.36492919921875

(declare-const result Float32)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
