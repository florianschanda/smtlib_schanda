                expect
                (fp #b0 #b10001000 #b11011001010001011010101)))
(assert (fp.leq (fp #b0 #b10001000 #b11011001010001011010101)
                expect
                (fp #b0 #b10111001 #b11001011110111100101011)))
; expect = 946.54425048828125

(assert (= expect result))

(check-sat)
