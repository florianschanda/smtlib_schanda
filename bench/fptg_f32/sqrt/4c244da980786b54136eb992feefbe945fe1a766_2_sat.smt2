                arg1
                (fp #b0 #b11100000 #b11111010011110101011101)))
; arg1 = 55651713024.0

(declare-const result Float32)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010101 #b01000101101111011011001)
                expect
                (fp #b0 #b10010000 #b11001100110000010001010)))
(assert (fp.leq (fp #b0 #b10010000 #b11001100110000010001010)
                expect
                (fp #b0 #b11000001 #b11111001010000100000110)))
; expect = 235906.15625

(assert (= expect result))

(check-sat)
(exit)
