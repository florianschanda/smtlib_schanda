; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100101 #b00000010111110100100011)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11111000 #b00101110100100011110111)))
; arg1 = 1.76562607288360595703125

(declare-const result Float32)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101110 #b00101001011000001010000)
                expect
                (fp #b0 #b01111111 #b01010100001010100010111)))
(assert (fp.leq (fp #b0 #b01111111 #b01010100001010100010111)
                expect
                (fp #b0 #b10011111 #b11011001000001101111010)))
; expect = 1.32876861095428466796875

(assert (= expect result))

(check-sat)
(exit)
