;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00101101111011110101000)
                arg1
                (fp #b1 #b01111111 #b10010010111110011011111)))
(assert (fp.leq (fp #b1 #b01111111 #b10010010111110011011111)
                arg1
                (fp #b0 #b11110000 #b01011011000101111111000)))
; arg1 = -1.57412326335906982421875

(declare-const result Float32)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
