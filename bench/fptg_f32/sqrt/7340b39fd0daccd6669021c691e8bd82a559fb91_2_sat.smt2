                expect
                (fp #b0 #b01111111 #b01100001110000011010011)))
(assert (fp.leq (fp #b0 #b01111111 #b01100001110000011010011)
                expect
                (fp #b0 #b11101001 #b10011010101001010111101)))
; expect = 1.38186109066009521484375

(assert (= expect result))

