                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11111110 #b11001010000010010111110)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11101101 #b00110101000101001100000)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11011001 #b11101000110001110010000)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111000 #b10000100110001100011101)
                expect
                (fp #b0 #b11001110 #b10011110101101010110111)))
(assert (fp.leq (fp #b0 #b11001110 #b10011110101101010110111)
                expect
                (fp #b0 #b11111001 #b00110010110111011110011)))
; expect = 979203255460359359692800.0

(assert (= expect result))

(check-sat)
(exit)
