; Format: FLOAT32
; Arg1: +LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b11000110 #b11001001011111101110011)
                arg1
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg1 = 340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01111111011010011010000)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b1 #b10110101 #b10000011110101010010111)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11010110 #b11110111000011111101100)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b10111001 #b11001111111011110100011)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                expect
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b10011101 #b01111101101001111001110)))
; expect = -340282346638528859811704183484516925440.0

(assert (not (= expect result)))

(check-sat)
(exit)
