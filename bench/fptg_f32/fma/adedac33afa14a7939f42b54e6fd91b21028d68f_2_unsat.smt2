(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110001 #b11011011001111101110000)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111011 #b01100101110110101111110)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b10111101011110101010010)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b10001000 #b00011001111001101111101)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00000100101110010110110)
                arg3
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b0 #b00110101 #b01110100111101101000110)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
