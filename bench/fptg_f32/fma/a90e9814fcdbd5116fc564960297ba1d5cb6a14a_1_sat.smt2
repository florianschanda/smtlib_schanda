; Format: FLOAT32
; Arg1: +ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00001000 #b10000111100100001011101)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b01010010 #b11011000001011111011101)))
; arg1 = 0.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b00001011 #b01011011001000000111001)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11110111 #b00100010111100000010110)
                arg3
                (fp #b0 #b00001101 #b10111100100001001001110)))
(assert (fp.leq (fp #b0 #b00001101 #b10111100100001001001110)
                arg3
                (fp #b0 #b10110010 #b10000000011001000000101)))
; arg3 = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101100 #b10001011101010000100010)
                expect
                (fp #b0 #b00001101 #b10111100100001001001110)))
(assert (fp.leq (fp #b0 #b00001101 #b10111100100001001001110)
                expect
                (fp #b0 #b01110000 #b10111111110110011111111)))
; expect = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(assert (= expect result))

(check-sat)
(exit)
