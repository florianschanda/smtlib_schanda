                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b11100001 #b10100010100010011011110)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00100001 #b01100101110010000000111)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10011010 #b10100111100000000111010)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001100 #b00000111001111001111111)
                expect
                (fp #b0 #b00110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b0 #b00110000 #b11011100001000011101111)
                expect
                (fp #b0 #b11010001 #b11101111100100000000110)))
; expect = 0.000000000000000000000003076932830937604937472166034467799581274272124886692836298607289791107177734375

(assert (= expect result))

(check-sat)
(exit)
