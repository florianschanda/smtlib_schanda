; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
