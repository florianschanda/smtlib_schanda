                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b01111100 #b01011011000110000111010)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11011100 #b10011001110011100110101)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b0 #b01111110 #b11011001001000110011000)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001111 #b00011000111100000111001)
                expect
                (fp #b0 #b11101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b11101011 #b11101001101001110111010)
                expect
                (fp #b0 #b11111011 #b10001010011111111010001)))
; expect = 620710331224168016107268737073152.0

(assert (= expect result))

(check-sat)
(exit)
