; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00000100 #b10011011000100111110110)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11011000 #b10010101011110010101110)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000010 #b00010110001001001011101)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b10000110 #b01000010101100011000110)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11001111 #b01010110011010000101110)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b0 #b10001011 #b01011000111100001101001)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111101 #b00100010000001001100111)
                expect
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                expect
                (fp #b0 #b00010111 #b01110110000101101101000)))
; expect = -2648606.25

(assert (= expect result))

(check-sat)
(exit)
