; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110100 #b10111011000101100010101)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b01000000 #b10100011110011000010111)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101000 #b11000111000001011000101)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b10000101 #b11010110101100101011101)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10111000 #b10011010010010101001100)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b1 #b00100001 #b11010110000010100011000)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110010 #b11011010100001010011110)
                expect
                (fp #b0 #b10111101 #b00010011010001111001001)))
(assert (fp.leq (fp #b0 #b10111101 #b00010011010001111001001)
                expect
                (fp #b0 #b11110001 #b11100111100111110110110)))
; expect = 4958995903118573568.0

(assert (not (= expect result)))

(check-sat)
(exit)
