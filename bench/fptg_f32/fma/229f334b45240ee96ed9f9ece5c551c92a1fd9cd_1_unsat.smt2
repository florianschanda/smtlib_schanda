                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b11001000 #b01100111000110010011111)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b01110101 #b11011111101101111111111)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00011111 #b10110000000100001100101)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001010 #b10101010110001101011001)
                expect
                (fp #b1 #b01101100 #b00011100101100101100101)))
(assert (fp.leq (fp #b1 #b01101100 #b00011100101100101100101)
                expect
                (fp #b0 #b01110011 #b11110010000101011010010)))
; expect = -0.000002121168336088885553181171417236328125

(assert (not (= expect result)))

(check-sat)
(exit)
