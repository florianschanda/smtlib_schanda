(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00010101 #b00111001110001011010101)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11001001 #b00111101111001011111111)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010001 #b11011110111111000111100)
                expect
                (fp #b0 #b10010110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10010110 #b11111111111111111111111)
                expect
                (fp #b0 #b10011111 #b11101110110111011101111)))
; expect = 16777215.0

(assert (= expect result))

(check-sat)
(exit)
