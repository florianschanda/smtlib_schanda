; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: +REFERENCE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110001 #b11010111111000111001110)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b01100111 #b11110000001010110000100)))
; arg1 = -0.0000000000000000000000000000000000000078390906197842473151128329331162838047950527052918132227640646251414814627000993141336948610842227935791015625

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111000 #b11101010101000010101001)
                expect
                (fp #b1 #b00000000 #b10101010101110000110001)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110001)
                expect
                (fp #b0 #b10001101 #b01110001101001100000111)))
; expect = -0.00000000000000000000000000000000000000783908921848578299029576200938670051487892142502987134624829286807319757290901662827309337444603443145751953125

(assert (not (= expect result)))

(check-sat)
(exit)
