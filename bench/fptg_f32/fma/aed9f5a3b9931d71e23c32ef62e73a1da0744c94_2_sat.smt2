(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b10100100 #b00110010011010100001001)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100001 #b00100001001111110111001)
                expect
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b11110111 #b01100011111011110110111)))
; expect = 16777216.0

(assert (= expect result))

(check-sat)
(exit)
