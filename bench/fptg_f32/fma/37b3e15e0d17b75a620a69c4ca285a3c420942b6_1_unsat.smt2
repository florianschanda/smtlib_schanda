; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00011111 #b10010111101111001011100)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11010100 #b01010101000100000111010)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01110010 #b10101100010101100000010)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10100101 #b10110110111100101000000)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10110101 #b10101111101011011010111)
                expect
                (fp #b0 #b11001110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b11001110 #b10011110101101010110110)
                expect
                (fp #b0 #b11010010 #b01000011101111000111011)))
; expect = 979203183402765321764864.0

(assert (not (= expect result)))

(check-sat)
(exit)
