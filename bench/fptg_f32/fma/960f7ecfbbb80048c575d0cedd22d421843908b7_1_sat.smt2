(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00001100 #b10100001101001010110001)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10000110 #b00000101110000000010100)))
; arg1 = 0.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101001 #b00001010000001001011111)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b01010011 #b10110111101011111101010)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10001110 #b10001011100000101010001)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111011 #b10101111100101111001011)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01101101 #b00010101100011110001001)
                expect
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                expect
                (fp #b0 #b11110110 #b00111000100111001111110)))
; expect = 296994115596793067486711299035889664.0

(assert (= expect result))

(check-sat)
(exit)
