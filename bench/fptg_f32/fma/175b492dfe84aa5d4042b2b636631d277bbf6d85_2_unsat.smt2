                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11000000 #b01001100001001000010001)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10111111 #b00101001010100001001100)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b01010000 #b01101000110000010111000)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011011 #b01100101110001101000000)
                expect
                (fp #b1 #b10101111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b10101111 #b00000000000000000000001)
                expect
                (fp #b1 #b01010110 #b11111110000101100111110)))
; expect = -281475010265088.0

(assert (not (= expect result)))

(check-sat)
(exit)
