(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -INFINITY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b11011111110011100001001)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b01011000 #b00010010010111011010101)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b11010000000010011000100)
                arg3
                (fp #b1 #b00010011 #b10110001011100101011000)))
(assert (fp.leq (fp #b1 #b00010011 #b10110001011100101011000)
                arg3
                (fp #b0 #b10101001 #b11100000011101111001101)))
; arg3 = -0.00000000000000000000000000000000521744049233235427127554688598496660784073071372458625487300576395455209421925246715545654296875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
