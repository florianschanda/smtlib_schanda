(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +ZERO
; Arg2: +INT_BOUNDARY
; Arg3: +ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00001000 #b00101011110000110001110)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10010110 #b10011100111000011111001)))
; arg1 = 0.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b11100011111000000001110)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10011000 #b11110111010011010000001)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11011010 #b01100111001100101101110)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10101100 #b00000001101101100011101)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01001011 #b10000101111101111001101)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11001010 #b00011110100011111011100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
