                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b00000001 #b01001101111101110000011)))
; arg2 = -16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00011001 #b11100100010111110101000)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b10010111 #b11111010010100101111011)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10001010 #b01011000011001010001111)
                expect
                (fp #b0 #b11001000 #b11011100001000011110000)))
(assert (fp.leq (fp #b0 #b11001000 #b11011100001000011110000)
                expect
                (fp #b0 #b11001100 #b11001110001001111100100)))
; expect = 17566182260167562756096.0

(assert (not (= expect result)))

(check-sat)
(exit)
