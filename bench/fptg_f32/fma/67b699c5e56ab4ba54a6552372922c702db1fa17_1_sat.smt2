; arg3 = -0.0000000000000000000000000000000000000002852399076071738140548088515969955881866224393167322914042382774589025340450376688750111497938632965087890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111111 #b11011100101000001101110)
                expect
                (fp #b1 #b00000000 #b00000110001101100100001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000110001101100100001)
                expect
                (fp #b0 #b11101101 #b10011010111010101100100)))
; expect = -0.00000000000000000000000000000000000000028523850630870948923773792786741229827049115905479041488846652039061864425395498301440966315567493438720703125

(assert (= expect result))

(check-sat)
