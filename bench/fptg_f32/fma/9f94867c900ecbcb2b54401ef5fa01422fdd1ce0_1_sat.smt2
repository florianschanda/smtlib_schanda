                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b00111010 #b01101000010001000000011)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00111101 #b11000100111000110000000)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00000010 #b10110001011111010010011)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100100 #b10010110111000011111100)
                expect
                (fp #b0 #b01111101 #b00111010011110010010100)))
(assert (fp.leq (fp #b0 #b01111101 #b00111010011110010010100)
                expect
                (fp #b0 #b11110011 #b10001101001100000101010)))
; expect = 0.30710279941558837890625

(assert (= expect result))

(check-sat)
(exit)
