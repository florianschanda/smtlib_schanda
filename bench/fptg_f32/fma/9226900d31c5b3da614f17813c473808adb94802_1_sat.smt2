(assert (fp.leq (fp #b1 #b10100111 #b11100101001001110000001)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00001100 #b10011100000010100010001)))
