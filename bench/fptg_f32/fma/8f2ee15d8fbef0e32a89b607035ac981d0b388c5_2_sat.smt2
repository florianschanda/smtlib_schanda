                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10101111 #b00001010101100001110010)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b1 #b00010011 #b01001110111111101010011)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110001 #b01101100001101010001011)
                expect
                (fp #b1 #b10010100 #b01000011010100010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100010000100)
                expect
                (fp #b1 #b00001001 #b10101011011111111000001)))
; expect = -2648609.0

(assert (= expect result))

(check-sat)
(exit)
