(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100000 #b00011110000011000111010)
                expect
                (fp #b0 #b11100010 #b10111010110001101111110)))
(assert (fp.leq (fp #b0 #b11100010 #b10111010110001101111110)
                expect
                (fp #b0 #b11110100 #b10010101111100100010001)))
; expect = 1096263453517375200828311207936.0

(assert (not (= expect result)))

(check-sat)
(exit)
