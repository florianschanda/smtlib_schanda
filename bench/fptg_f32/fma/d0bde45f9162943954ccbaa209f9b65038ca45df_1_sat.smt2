(assert (fp.leq (fp #b1 #b10100000 #b00100101001011110001111)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10111011 #b10001000101011111101110)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011001 #b10010101001000101111110)
                expect
                (fp #b1 #b11000100 #b00001000110000100101100)))
(assert (fp.leq (fp #b1 #b11000100 #b00001000110000100101100)
                expect
                (fp #b0 #b10011111 #b00111100111111101100101)))
; expect = -610493047312578772992.0

(assert (= expect result))

(check-sat)
(exit)
