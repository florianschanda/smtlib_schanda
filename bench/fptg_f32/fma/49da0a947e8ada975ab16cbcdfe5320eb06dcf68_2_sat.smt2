(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b11000010 #b10110100011101100100010)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11000101 #b11100011111001011100000)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b1 #b01101010 #b10010001001111010011100)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b11000010001001011001000)
                expect
                (fp #b1 #b10010100 #b01000011010100001111101)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111101)
                expect
                (fp #b0 #b10101000 #b11010001101101111000000)))
; expect = -2648607.25

(assert (= expect result))

(check-sat)
(exit)
