(assert (fp.leq (fp #b1 #b10111101 #b01111010000100110001110)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00010100 #b10011101000111001000101)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100101 #b10110110101101011011001)
                expect
                (fp #b1 #b01111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111101 #b00000000000000000000000)
                expect
                (fp #b1 #b00101000 #b00000111000011001101110)))
; expect = -0.25

(assert (= expect result))

(check-sat)
(exit)
