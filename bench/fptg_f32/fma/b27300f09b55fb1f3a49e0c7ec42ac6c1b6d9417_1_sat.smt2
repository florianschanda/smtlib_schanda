(assert (fp.leq (fp #b1 #b10101110 #b01001100110000010110010)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00001011 #b10110110101000000001110)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001010 #b01110110101011100110110)
                expect
                (fp #b1 #b01111110 #b01010101011100001100100)))
(assert (fp.leq (fp #b1 #b01111110 #b01010101011100001100100)
                expect
                (fp #b0 #b00010001 #b00110111001110011100101)))
; expect = -0.6668760776519775390625

(assert (= expect result))

(check-sat)
(exit)
