; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101110 #b10001001000101100010110)
                expect
                (fp #b0 #b01111101 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b01111101 #b00000000000000000000001)
                expect
                (fp #b0 #b11010111 #b10111011110010000000111)))
; expect = 0.2500000298023223876953125

(assert (= expect result))

(check-sat)
(exit)
