                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111001 #b10010101010111001010110)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b11100010 #b01110110100100100111010)
                expect
                (fp #b0 #b11110100 #b11001001100101111000100)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000100)
                expect
                (fp #b0 #b11111000 #b10010000110100101100111)))
; expect = 296994135403833696052795697421877248.0

(assert (= expect result))

(check-sat)
(exit)
