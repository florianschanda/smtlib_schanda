                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11101010 #b10010011001100011000111)))
; arg2 = -16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10011110 #b01100000000010110001011)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b1 #b00001011 #b10100111101000000100011)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101010 #b00101011000000111110010)
                expect
                (fp #b0 #b10101110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10101110 #b11111111111111111111111)
                expect
                (fp #b0 #b11111100 #b11111110010010101010000)))
; expect = 281474959933440.0

(assert (= expect result))

(check-sat)
(exit)
