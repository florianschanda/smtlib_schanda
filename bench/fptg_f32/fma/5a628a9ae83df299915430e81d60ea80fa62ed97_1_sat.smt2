;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111110 #b11101101110110000010111)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
