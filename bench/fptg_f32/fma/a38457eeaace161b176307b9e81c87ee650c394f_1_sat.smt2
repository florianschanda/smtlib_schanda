                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b11011000 #b01101110101011110010110)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01011011 #b10100011111110101011000)
                arg3
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b01110000 #b01001010011111101110010)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100011 #b10001111110000100000111)
                expect
                (fp #b1 #b10111101 #b00010011010001111001001)))
(assert (fp.leq (fp #b1 #b10111101 #b00010011010001111001001)
                expect
                (fp #b0 #b00010110 #b01010011110100101001010)))
; expect = -4958995903118573568.0

(assert (= expect result))

(check-sat)
(exit)
