(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01100011 #b00001000101110000110000)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11110110 #b00101100100110000110110)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010000 #b00110100001111111010111)
                expect
                (fp #b0 #b11110100 #b11001001100101111000010)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000010)
                expect
                (fp #b0 #b11111001 #b01111000001011101001011)))
; expect = 296994095789752438920626900649902080.0

(assert (= expect result))

(check-sat)
(exit)
