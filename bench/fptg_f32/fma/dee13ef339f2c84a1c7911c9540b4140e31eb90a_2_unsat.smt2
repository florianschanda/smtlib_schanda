; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111011 #b00001111001011010111001)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b1 #b10000111 #b01001101110011101110011)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00100101 #b00010010101101110111101)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111101 #b01110000101001010011001)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10101101 #b10101000000011111010111)
                arg3
                (fp #b1 #b00000000 #b00000110001101100100010)))
(assert (fp.leq (fp #b1 #b00000000 #b00000110001101100100010)
                arg3
                (fp #b0 #b11110101 #b00100100100011100111101)))
; arg3 = -0.0000000000000000000000000000000000000002852399076071738140548088515969955881866224393167322914042382774589025340450376688750111497938632965087890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
