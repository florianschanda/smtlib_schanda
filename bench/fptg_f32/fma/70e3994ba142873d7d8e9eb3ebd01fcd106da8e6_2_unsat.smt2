                (fp #b0 #b01110111 #b11100100010101001110010)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100011 #b01010001011011000100111)
                expect
                (fp #b0 #b10011101 #b01100100001110100011110)))
(assert (fp.leq (fp #b0 #b10011101 #b01100100001110100011110)
                expect
                (fp #b0 #b11101100 #b10111111100100100000110)))
; expect = 1494126336.0

(assert (not (= expect result)))

(check-sat)
