(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001011 #b11011110011111101010100)
                arg1
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b00011101 #b10110101100010010101010)))
; arg1 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00010101 #b10001100000100011111010)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11010110 #b00011100100011101001010)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001110 #b00001101101001110010101)
                expect
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                expect
                (fp #b0 #b11101100 #b01010110100000110011000)))
; expect = 58365057909653504.0

(assert (= expect result))

(check-sat)
(exit)
