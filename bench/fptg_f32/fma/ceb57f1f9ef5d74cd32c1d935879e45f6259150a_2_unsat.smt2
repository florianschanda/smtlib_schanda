                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b11101001 #b11100101001011010100111)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11000000 #b11111100110011101111110)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b00110000 #b11101010011011011111101)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110010 #b11111111011000000011000)
                expect
                (fp #b1 #b10011101 #b11001011010110100001001)))
(assert (fp.leq (fp #b1 #b10011101 #b11001011010110100001001)
                expect
                (fp #b0 #b10001100 #b11011011011000101010010)))
; expect = -1926661248.0

(assert (not (= expect result)))

(check-sat)
(exit)
