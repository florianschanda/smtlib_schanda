(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b11000111001011111100110)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b11000000 #b00011110101010010010110)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110000 #b10110101101011011111000)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b01100011 #b01011101101000100111000)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01110000 #b11011000111010001001100)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00011101 #b00011110000110011011011)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011110 #b00011101111111101001110)
                expect
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b11111111 #b00000000000000000000000)))
; expect = 340282346638528859811704183484516925440.0

(assert (not (= expect result)))

(check-sat)
(exit)
