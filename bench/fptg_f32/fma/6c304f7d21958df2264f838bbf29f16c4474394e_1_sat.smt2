(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010101 #b10101001011100111011110)
                expect
                (fp #b0 #b01111101 #b00111010011110010010011)))
(assert (fp.leq (fp #b0 #b01111101 #b00111010011110010010011)
                expect
                (fp #b0 #b10111111 #b11110110010100001001010)))
; expect = 0.3071027696132659912109375

(assert (= expect result))

(check-sat)
