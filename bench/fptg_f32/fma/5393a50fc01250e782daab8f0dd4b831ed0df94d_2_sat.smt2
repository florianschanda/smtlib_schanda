                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11100111 #b00001010100101011011010)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b01111110001001110000001)
                arg3
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b10001101 #b00010000001100000111111)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001111 #b01101010111110011100101)
                expect
                (fp #b1 #b11001110 #b10011110101101010110110)))
(assert (fp.leq (fp #b1 #b11001110 #b10011110101101010110110)
                expect
                (fp #b0 #b11111101 #b10010010100001100100110)))
; expect = -979203183402765321764864.0

(assert (= expect result))

(check-sat)
(exit)
