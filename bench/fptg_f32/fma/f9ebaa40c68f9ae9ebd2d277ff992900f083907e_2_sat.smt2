(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101010 #b11001001111011101011101)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111110 #b11010000111101111011100)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10100001 #b01000011111011101110101)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b1 #b00100001 #b01001111010101011011000)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101101 #b00000010101000110011111)
                expect
                (fp #b1 #b10010100 #b01000011010100001110110)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001110110)
                expect
                (fp #b0 #b00001011 #b01101111010110000100010)))
; expect = -2648605.5

(assert (= expect result))

(check-sat)
(exit)
