                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10011011 #b01111000001110100001001)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00000001 #b01111111001001011001110)
                arg3
                (fp #b0 #b00001101 #b10111100100001001001110)))
(assert (fp.leq (fp #b0 #b00001101 #b10111100100001001001110)
                arg3
                (fp #b0 #b01100010 #b00011011011010111111001)))
; arg3 = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001110 #b01011011111110011010010)
                expect
                (fp #b1 #b11001000 #b11011100001000011101110)))
(assert (fp.leq (fp #b1 #b11001000 #b11011100001000011101110)
                expect
                (fp #b0 #b00101011 #b00000001100101101011011)))
; expect = -17566180008367749070848.0

(assert (= expect result))

(check-sat)
(exit)
