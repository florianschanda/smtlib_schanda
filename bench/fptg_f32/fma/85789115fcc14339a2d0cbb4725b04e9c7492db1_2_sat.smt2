                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10011000 #b00001000111111111111010)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111010 #b11010001010110000001111)
                expect
                (fp #b1 #b00110000 #b00000001011001110010100)))
(assert (fp.leq (fp #b1 #b00110000 #b00000001011001110010100)
                expect
                (fp #b1 #b00000101 #b10001101101001010101101)))
; expect = -0.0000000000000000000000016634276034897604384224143805407207692692583833604658138938248157501220703125

(assert (= expect result))

(check-sat)
(exit)
