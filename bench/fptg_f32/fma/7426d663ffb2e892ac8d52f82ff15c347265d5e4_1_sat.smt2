(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00111101 #b10010100010011010111100)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10110100 #b00000101010010111000000)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010011 #b00011101100111101111110)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10100010 #b11100110001110010111011)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01000010 #b10101010100001000110011)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11110101 #b00100011111001100111001)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10000110 #b00001001100101011100010)
                expect
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                expect
                (fp #b0 #b11111000 #b10011000110100000111101)))
; expect = 296994115596793067486711299035889664.0

(assert (= expect result))

(check-sat)
(exit)
