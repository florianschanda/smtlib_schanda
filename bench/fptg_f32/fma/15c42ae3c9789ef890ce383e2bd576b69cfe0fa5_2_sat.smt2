                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b01001101 #b01001011100101010100010)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b01100001 #b10111000001101000100000)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10101100 #b00000101000100010110110)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000101 #b00001011111011101000110)
                expect
                (fp #b0 #b00110001 #b00100100011100010111001)))
(assert (fp.leq (fp #b0 #b00110001 #b00100100011100010111001)
                expect
                (fp #b0 #b10100000 #b10100110011100110010000)))
; expect = 0.00000000000000000000000377973906937554592281399401281744118881456007130736907129175961017608642578125

(assert (= expect result))

(check-sat)
(exit)
