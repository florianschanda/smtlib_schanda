; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100010 #b01101100001001010110110)
                expect
                (fp #b0 #b00110111 #b01100100001110100011101)))
(assert (fp.leq (fp #b0 #b00110111 #b01100100001110100011101)
                expect
                (fp #b0 #b01011011 #b00101111110110010101011)))
; expect = 0.00000000000000000000029466443823932944268576496999281245925406125252266065217554569244384765625

(assert (= expect result))

(check-sat)
(exit)
