; Format: FLOAT32
; Arg1: +ZERO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10000011 #b10011100101110010001111)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b11110010 #b10001000001111111010010)))
; arg1 = 0.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00010100 #b10100000101100001101100)
                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b01100011 #b11100101010000010001110)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b00100111 #b10100001100011110111011)
                arg3
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b0 #b11111110 #b11000101000000000100111)))
; arg3 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111001 #b01000001101010000100111)
                expect
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11111110 #b10111101101111011010101)))
; expect = 85070591730234615865843651857942052864.0

(assert (not (= expect result)))

(check-sat)
(exit)
