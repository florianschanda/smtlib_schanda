                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b10101001 #b01001011011000010100110)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11101101 #b01111011111001111111111)
                arg3
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b10000011 #b11000100000110110010001)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101100 #b11010100100100111000111)
                expect
                (fp #b0 #b00000000 #b01000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000001)
                expect
                (fp #b0 #b11111101 #b11010110011111001011110)))
; expect = 0.00000000000000000000000000000000000000293873727835418309473891226678519748446279517219216068028765102276432703842790061798950773663818836212158203125

(assert (= expect result))

(check-sat)
