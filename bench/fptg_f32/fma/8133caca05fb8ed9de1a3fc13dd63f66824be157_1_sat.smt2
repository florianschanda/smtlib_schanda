; arg3 = -0.00000000000000000000000000000000521744049233235427127554688598496660784073071372458625487300576395455209421925246715545654296875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000010 #b00100000101011111101101)
                expect
                (fp #b1 #b00010011 #b10110001011100101010111)))
(assert (fp.leq (fp #b1 #b00010011 #b10110001011100101010111)
                expect
                (fp #b0 #b11111001 #b00011110110001110100001)))
; expect = -0.00000000000000000000000000000000521744012499036963931070064575479872588895639539159976359565529246964388221385888755321502685546875

(assert (= expect result))

(check-sat)
