(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111010 #b11010000001000000101010)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b00010000 #b11001111000000101110000)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101001 #b10001001111100100010001)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b10111011 #b11101011000011010101110)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101110 #b10000001111000010101101)
                expect
                (fp #b0 #b00010111 #b00111010011110010010100)))
(assert (fp.leq (fp #b0 #b00010111 #b00111010011110010010100)
                expect
                (fp #b0 #b01001111 #b11000011111011100000111)))
; expect = 0.00000000000000000000000000000006056534808572196595932560322826293073195445108123529699695186678809477598406374454498291015625

(assert (= expect result))

(check-sat)
(exit)
