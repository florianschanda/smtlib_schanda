(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +NAN
; Arg2: -INFINITY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01011101 #b01010000100100000111110)
                arg3
                (fp #b1 #b00010011 #b10110001011100101011000)))
(assert (fp.leq (fp #b1 #b00010011 #b10110001011100101011000)
                arg3
                (fp #b0 #b01110100 #b11000010100010101001110)))
; arg3 = -0.00000000000000000000000000000000521744049233235427127554688598496660784073071372458625487300576395455209421925246715545654296875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
