(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b10010111101111011000011)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b11101111 #b00010010000110001011001)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00111001010100010101001)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b1 #b00011111 #b10001110111010110010010)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01010010 #b00000000011010101110100)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11000000 #b00100010001000010111001)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
