(assert (fp.leq (fp #b0 #b00100101 #b10000000100001010010000)
                expect
                (fp #b0 #b01111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b0 #b01111110 #b11111111111111111111110)
                expect
                (fp #b0 #b11011111 #b10000001100010011001000)))
; expect = 0.99999988079071044921875

(assert (= expect result))

(check-sat)
