                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b11111101 #b01110111101001101101011)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00000010 #b01100100000010010011000)
                arg3
                (fp #b1 #b00000000 #b00000110001101100100010)))
(assert (fp.leq (fp #b1 #b00000000 #b00000110001101100100010)
                arg3
                (fp #b0 #b00111110 #b10001001101001111000011)))
; arg3 = -0.0000000000000000000000000000000000000002852399076071738140548088515969955881866224393167322914042382774589025340450376688750111497938632965087890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01101001 #b10100111101101011100110)
                expect
                (fp #b0 #b10000011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b10000011 #b11101001101001110111010)
                expect
                (fp #b0 #b11000001 #b01010100011000110101110)))
; expect = 30.603382110595703125

(assert (= expect result))

(check-sat)
(exit)
