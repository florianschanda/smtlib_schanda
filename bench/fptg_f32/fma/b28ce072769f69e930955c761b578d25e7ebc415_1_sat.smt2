                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11010010 #b11000001010110110101100)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b11000011 #b01000011000101100010101)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111110 #b01111010110110100010011)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110101 #b00111010011101011100001)
                expect
                (fp #b0 #b11110100 #b11001001100101111000010)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000010)
                expect
                (fp #b0 #b11111011 #b11111000111001100001100)))
; expect = 296994095789752438920626900649902080.0

(assert (= expect result))

(check-sat)
(exit)
