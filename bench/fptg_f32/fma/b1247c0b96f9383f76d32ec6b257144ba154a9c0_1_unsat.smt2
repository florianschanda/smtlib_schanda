; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +INFINITY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100001 #b00100011001011011010110)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b01000010 #b11111110111001111101001)))
; arg1 = -0.0000000000000000000000000000000000000078390906197842473151128329331162838047950527052918132227640646251414814627000993141336948610842227935791015625

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00011101 #b01001111110101011111011)
                arg3
                (fp #b1 #b00010011 #b10110001011100101011000)))
(assert (fp.leq (fp #b1 #b00010011 #b10110001011100101011000)
                arg3
                (fp #b0 #b01110010 #b01010001010001110110111)))
; arg3 = -0.00000000000000000000000000000000521744049233235427127554688598496660784073071372458625487300576395455209421925246715545654296875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
