(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110011 #b00101110110001101110111)
                expect
                (fp #b1 #b00010111 #b00111010011110010010011)))
(assert (fp.leq (fp #b1 #b00010111 #b00111010011110010010011)
                expect
                (fp #b0 #b10101100 #b00111011010110000110110)))
; expect = -0.0000000000000000000000000000000605653422082502118478880633845802446207260619879075131365142592443362445919774472713470458984375

(assert (= expect result))

(check-sat)
