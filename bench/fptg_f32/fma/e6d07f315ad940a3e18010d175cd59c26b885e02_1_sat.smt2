(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000010 #b11110111100011111011011)
                expect
                (fp #b1 #b00000000 #b00000110001101100100001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000110001101100100001)
                expect
                (fp #b0 #b00110010 #b01001011101011000110100)))
