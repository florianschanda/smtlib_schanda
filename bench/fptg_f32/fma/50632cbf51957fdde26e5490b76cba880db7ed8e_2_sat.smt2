(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100100 #b11011100110110100000111)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b01010000 #b01111010110111110110110)))
; arg1 = 0.00000000000000000000000000000000000000976888739863070481951837620501440851507153415828511504132353945523202336242984955561041715554893016815185546875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001011 #b01111010111101110110111)
                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b01110110 #b10011110111001111111011)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00011010 #b01000101111100011111110)
                arg3
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b0 #b11111110 #b01001001110010010010011)))
; arg3 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000101 #b10111100000010000100010)
                expect
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11111101 #b10100011010110101101010)))
; expect = 85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
