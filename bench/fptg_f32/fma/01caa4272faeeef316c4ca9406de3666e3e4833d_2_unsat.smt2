(assert (fp.leq (fp #b0 #b10100101 #b00100101010110111111100)
                expect
                (fp #b0 #b11100110 #b01111100000010011000001)))
; expect = 314992099328.0

(assert (not (= expect result)))

(check-sat)
(exit)
