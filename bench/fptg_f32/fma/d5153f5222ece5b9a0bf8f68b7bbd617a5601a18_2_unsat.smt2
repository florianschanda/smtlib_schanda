                arg3
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b1 #b00100110 #b00010110011010100101001)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00101000000110010110111)
                expect
                (fp #b1 #b11111101 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000001)
                expect
                (fp #b1 #b00010010 #b10000010110010000011011)))
; expect = -85070601871439417691678863831567695872.0

(assert (not (= expect result)))

(check-sat)
(exit)
