                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b01101000 #b10010000000101010011101)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11011111 #b11000101111001010111000)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10000100 #b01000110100110000110010)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00100101010100010110110)
                expect
                (fp #b1 #b11000110 #b00001000110000100101011)))
(assert (fp.leq (fp #b1 #b11000110 #b00001000110000100101011)
                expect
                (fp #b0 #b01010110 #b11100001011000110000001)))
; expect = -2441971907775338381312.0

(assert (= expect result))

(check-sat)
(exit)
