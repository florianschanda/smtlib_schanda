(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b11001001 #b10100110001010110111001)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111010 #b01010011011010101011010)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b11011101 #b10100001011001011010100)
                expect
                (fp #b0 #b11110100 #b11001001100101111000100)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000100)
                expect
                (fp #b0 #b11111100 #b11101101010101010011001)))
; expect = 296994135403833696052795697421877248.0

(assert (= expect result))

(check-sat)
(exit)
