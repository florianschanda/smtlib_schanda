;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00110101 #b00110110001101000111101)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
