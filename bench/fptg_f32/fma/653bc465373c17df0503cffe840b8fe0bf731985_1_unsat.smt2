; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01000100 #b10011011110000011100010)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b11001001 #b01110011001111001110010)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01010000 #b00011100110000101011011)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11100100 #b01000010011001000110110)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11000010 #b00011110100000000111010)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111000 #b01111000000110010001110)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b11010110 #b00111000001011011110011)
                expect
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                expect
                (fp #b0 #b11111010 #b01001000000101000001101)))
; expect = 296994115596793067486711299035889664.0

(assert (not (= expect result)))

(check-sat)
(exit)
