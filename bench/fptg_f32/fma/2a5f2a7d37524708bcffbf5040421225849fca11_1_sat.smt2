(assert (fp.leq (fp #b1 #b11111000 #b01000000101101010100011)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b11010100 #b10011011000010101110011)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001011 #b11011001011110011010110)
                expect
                (fp #b0 #b10111010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10111010 #b10011110101000110011100)
                expect
                (fp #b0 #b11000010 #b10001101010101010011010)))
; expect = 933680810173661184.0

(assert (= expect result))

(check-sat)
(exit)
