                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b11100011 #b01000101000000001110001)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00100100 #b10100000001000000010110)
                arg3
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b11011000 #b01001100011110110000110)))
; arg3 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011001 #b11010001111101001110100)
                expect
                (fp #b0 #b01111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11011110 #b11011101101100101011110)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
