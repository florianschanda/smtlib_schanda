(assert (fp.leq (fp #b1 #b10111111 #b10101101101110101101000)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b01000011 #b01111100011111010100010)))
