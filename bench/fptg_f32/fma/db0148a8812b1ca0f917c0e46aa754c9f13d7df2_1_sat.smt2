; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b10000110011111000000011)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b10111010 #b11010110010101011011111)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01011110 #b00011111110111001100010)
                arg3
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b00111011 #b00100011100111001111001)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000100 #b00111011110111001101101)
                expect
                (fp #b0 #b11000110 #b01001111110010100010100)))
(assert (fp.leq (fp #b0 #b11000110 #b01001111110010100010100)
                expect
                (fp #b0 #b11100100 #b11010101101001001000111)))
; expect = 3097113078843714830336.0

(assert (= expect result))

(check-sat)
(exit)
