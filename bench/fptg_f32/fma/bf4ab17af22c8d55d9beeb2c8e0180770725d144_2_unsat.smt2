; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000011 #b11111010110111111011000)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b10011101 #b01010010000010010101011)))
; arg1 = -0.0000000000000000000000000000000000000078390906197842473151128329331162838047950527052918132227640646251414814627000993141336948610842227935791015625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b10110011 #b10000000101010001010000)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01010101 #b11101101100110110101101)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00101110 #b01011000101001111111000)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001010 #b00011100010111110110010)
                expect
                (fp #b0 #b10000000 #b01010101011100001100100)))
(assert (fp.leq (fp #b0 #b10000000 #b01010101011100001100100)
                expect
                (fp #b0 #b10110010 #b01001000100001000111100)))
; expect = 2.66750431060791015625

(assert (not (= expect result)))

(check-sat)
(exit)
