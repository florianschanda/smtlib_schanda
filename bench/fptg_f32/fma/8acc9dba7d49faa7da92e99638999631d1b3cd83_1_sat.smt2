; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011110 #b11111101100100111110011)
                expect
                (fp #b0 #b10000000 #b01010101011100001100011)))
(assert (fp.leq (fp #b0 #b10000000 #b01010101011100001100011)
                expect
                (fp #b0 #b10101110 #b01100101000111111010110)))
; expect = 2.6675040721893310546875

(assert (= expect result))

(check-sat)
(exit)
