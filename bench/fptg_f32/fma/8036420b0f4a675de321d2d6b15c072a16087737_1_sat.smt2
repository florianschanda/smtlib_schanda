; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY
; Arg3: -NAN

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01010001 #b10101110110011101100100)
                arg1
                (fp #b1 #b00100101 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b00100101 #b00100101010110111111100)
                arg1
                (fp #b0 #b11010100 #b10010100110010001101101)))
; arg1 = -0.000000000000000000000000000925678583284292162965654627128430949396689468577914539082485134713351726531982421875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01001110 #b10011011110101100100010)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11010110 #b11001111011001101000111)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
