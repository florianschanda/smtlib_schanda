(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10011010 #b10111001011010100010010)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b11001001 #b00001100111101011011010)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111010 #b10011100000010011001011)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b01011100 #b00111111001001100101010)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b11010111010101110101000)
                arg3
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b0 #b10000000 #b01111011001100011110101)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00100100001101001101011)
                expect
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                expect
                (fp #b0 #b00100111 #b00011010100001010100110)))
; expect = -85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
