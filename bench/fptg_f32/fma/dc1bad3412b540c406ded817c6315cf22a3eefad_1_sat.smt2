                arg3
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b0 #b11111101 #b11011011011001000110111)))
; arg3 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010010 #b00101110100101011000000)
                expect
                (fp #b0 #b11111100 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b11111111111111111111111)
                expect
                (fp #b0 #b11111101 #b10110111110111101011011)))
; expect = 85070586659632214952926045871129231360.0

(assert (= expect result))

(check-sat)
(exit)
