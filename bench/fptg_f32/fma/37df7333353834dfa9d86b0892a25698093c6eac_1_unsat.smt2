; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00101000001001011001000)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b00111110 #b00001001111100011111000)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110111 #b01011100110010111110100)
                arg2
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b11110011 #b10100100001010110010111)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01011110 #b11001100101110001100100)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00000010 #b11111010100001111010010)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111010 #b01000110101001110011001)
                expect
                (fp #b1 #b01111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11000000 #b00110101001010101011000)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
