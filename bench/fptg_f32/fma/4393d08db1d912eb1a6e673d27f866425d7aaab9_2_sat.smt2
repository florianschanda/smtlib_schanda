(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +LARGEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110000 #b01100001000110000000011)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b01100100 #b10101110000001110011010)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100010 #b10000010111000001100001)
                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10010111 #b11001000101010010110101)
                arg3
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b01010111 #b11101010101101110001010)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
