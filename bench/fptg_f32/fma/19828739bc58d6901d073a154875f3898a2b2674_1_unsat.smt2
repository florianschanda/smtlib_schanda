(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010001 #b11110101110011100000110)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b11111011 #b00100010110111100101110)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11011111 #b00101101001110100010010)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11000010 #b00000111001110010100100)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
