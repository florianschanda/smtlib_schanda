(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b00101101111100110001001)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b0 #b10100001 #b10101011100000011011110)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100000 #b01001111001110101110010)
                expect
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                expect
                (fp #b1 #b01001010 #b10011111101010000110101)))
; expect = -2648606.25

(assert (= expect result))

(check-sat)
(exit)
