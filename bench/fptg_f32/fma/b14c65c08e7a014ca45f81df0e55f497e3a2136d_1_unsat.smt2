; Format: FLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: -INFINITY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b01011101 #b11001010010111011001000)))
; arg1 = -340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))
; arg2 = -Infinity

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b01001000 #b10011000010011111011100)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111011 #b01010100100101111010111)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
