(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +ZERO
; Arg3: +INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b11010101001000011010010)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b01110000 #b00101101000001110111111)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00000111 #b11110010101001000100010)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11011100 #b11110111011001000101111)))
; arg2 = 0.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b00010010 #b01111011000000100101101)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b10110011 #b00111001110010101100011)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010100 #b10010000111101100101011)
                expect
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b11111011 #b01111001111011010011111)))
; expect = 16777216.0

(assert (= expect result))

(check-sat)
(exit)
