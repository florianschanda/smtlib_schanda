; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111001 #b10001011010101010111010)
                expect
                (fp #b1 #b01111110 #b10101001011111101011101)))
(assert (fp.leq (fp #b1 #b01111110 #b10101001011111101011101)
                expect
                (fp #b0 #b01001001 #b11111110110111000110100)))
; expect = -0.831044971942901611328125

(assert (not (= expect result)))

(check-sat)
(exit)
