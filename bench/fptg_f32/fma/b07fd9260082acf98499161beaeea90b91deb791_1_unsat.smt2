                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b10110100 #b01101100011001101001111)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10111010 #b11001011110010111100100)
                arg3
                (fp #b0 #b00000000 #b01010110111101010000111)))
(assert (fp.leq (fp #b0 #b00000000 #b01010110111101010000111)
                arg3
                (fp #b0 #b00010101 #b10101000010001010110001)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10011010 #b01001111011101101101101)
                expect
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b11111111 #b00000000000000000000000)))
; expect = 340282346638528859811704183484516925440.0

(assert (not (= expect result)))

(check-sat)
(exit)
