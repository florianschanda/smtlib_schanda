(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01010010101000100000010)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b10001010 #b00001010111001000100010)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01111010111110100011110)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b01000111 #b10100111000110110010111)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b00100100 #b10111111001110110110101)
                arg3
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b0 #b11111110 #b01100101100001101000000)))
; arg3 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
