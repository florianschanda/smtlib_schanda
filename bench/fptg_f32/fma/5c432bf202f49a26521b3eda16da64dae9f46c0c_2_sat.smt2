; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01111011 #b10001000000111001110100)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b10011000 #b00011110011011011011011)))
; arg1 = 0.00000000000000000000000000000000000000976888739863070481951837620501440851507153415828511504132353945523202336242984955561041715554893016815185546875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01011000 #b01101000000110111000001)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b01100000 #b11100000000111011000111)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10010100 #b00010100100111111011011)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10011011 #b01010000111001110100110)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111010 #b00000011001001000101001)
                expect
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b11111010 #b00001101110011100011000)))
; expect = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(assert (= expect result))

(check-sat)
