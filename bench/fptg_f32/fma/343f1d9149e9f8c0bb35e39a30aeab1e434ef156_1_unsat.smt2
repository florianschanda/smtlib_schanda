; Format: FLOAT32
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101111 #b00000101110010011010011)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b10001010 #b11110010100101011011000)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01100111 #b01110111111011010011001)
                arg3
                (fp #b1 #b00000000 #b00000110001101100100010)))
(assert (fp.leq (fp #b1 #b00000000 #b00000110001101100100010)
                arg3
                (fp #b0 #b11011001 #b10011110110110001001001)))
; arg3 = -0.0000000000000000000000000000000000000002852399076071738140548088515969955881866224393167322914042382774589025340450376688750111497938632965087890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
