(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11110110 #b00011001110010000011010)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011001 #b00000100101010001010101)
                expect
                (fp #b0 #b11110100 #b11001001100101111000010)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000010)
                expect
                (fp #b0 #b11111101 #b11010000100001000101010)))
; expect = 296994095789752438920626900649902080.0

(assert (= expect result))

(check-sat)
