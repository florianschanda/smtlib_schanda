(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01101000 #b01101001010000100000001)
                expect
                (fp #b0 #b01111101 #b00111010011110010010100)))
(assert (fp.leq (fp #b0 #b01111101 #b00111010011110010010100)
                expect
                (fp #b0 #b11100010 #b11011110100000000101011)))
; expect = 0.30710279941558837890625

