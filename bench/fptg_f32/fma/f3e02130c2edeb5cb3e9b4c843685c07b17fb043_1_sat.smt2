                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00010010 #b10001010000101011011011)
                arg3
                (fp #b0 #b00000000 #b01010110111101010000111)))
(assert (fp.leq (fp #b0 #b00000000 #b01010110111101010000111)
                arg3
                (fp #b0 #b01011010 #b00100011000001111100100)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110100 #b01011111001001010111000)
                expect
                (fp #b0 #b10000000 #b10101001011111101011101)))
(assert (fp.leq (fp #b0 #b10000000 #b10101001011111101011101)
                expect
                (fp #b0 #b10100011 #b11101010011101001000011)))
; expect = 3.3241798877716064453125

(assert (= expect result))

(check-sat)
(exit)
