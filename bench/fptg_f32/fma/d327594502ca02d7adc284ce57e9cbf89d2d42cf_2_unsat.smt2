;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010001 #b01110000011100100111100)
                arg1
                (fp #b0 #b00000000 #b01000000000000000000000)))
