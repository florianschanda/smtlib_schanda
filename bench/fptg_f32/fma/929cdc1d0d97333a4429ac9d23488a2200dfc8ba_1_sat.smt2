(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101110 #b10110011011010001001000)
                expect
                (fp #b1 #b00011000 #b10101001011111101011101)))
(assert (fp.leq (fp #b1 #b00011000 #b10101001011111101011101)
                expect
                (fp #b1 #b00001011 #b00100110101010101110011)))
; expect = -0.000000000000000000000000000000163894722211561930766425733873421642547137605838271996912258732237432923284359276294708251953125

(assert (= expect result))

(check-sat)
