; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01110001 #b01110110111010100001010)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b11001000 #b11101000100111101100011)))
; arg1 = 0.00000000000000000000000000000000000000976888739863070481951837620501440851507153415828511504132353945523202336242984955561041715554893016815185546875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011111 #b11001000001011010101100)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11010010 #b00100110110010111010110)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b00111100010100000100010)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b1 #b01101010 #b01001100011010010010000)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100000 #b11100101001001110111111)
                expect
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                expect
                (fp #b1 #b00000111 #b11000010110010100001111)))
; expect = -16777216.0

(assert (not (= expect result)))

(check-sat)
(exit)
