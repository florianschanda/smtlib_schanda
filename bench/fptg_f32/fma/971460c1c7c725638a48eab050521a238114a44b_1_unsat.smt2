(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INFINITY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00100111 #b11100000000011010011100)
                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b00000110 #b11101111011001110100110)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00111111 #b01111011001001001100100)
                arg3
                (fp #b1 #b00010011 #b10110001011100101011000)))
(assert (fp.leq (fp #b1 #b00010011 #b10110001011100101011000)
                arg3
                (fp #b0 #b01000101 #b11010001011011011110111)))
; arg3 = -0.00000000000000000000000000000000521744049233235427127554688598496660784073071372458625487300576395455209421925246715545654296875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
