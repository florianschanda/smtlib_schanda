(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101111 #b00110100010000101101110)
                expect
                (fp #b0 #b11111100 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b11111111111111111111111)
                expect
                (fp #b0 #b11111101 #b00010111000100100101001)))
; expect = 85070586659632214952926045871129231360.0

(assert (not (= expect result)))

(check-sat)
