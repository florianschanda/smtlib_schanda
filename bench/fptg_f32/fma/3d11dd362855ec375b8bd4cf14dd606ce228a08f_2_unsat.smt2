(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b10001000 #b00001111110001001001000)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110111 #b11111010100011010010010)
                expect
                (fp #b1 #b10100101 #b00010011010001111001011)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001011)
                expect
                (fp #b0 #b00000011 #b01010000010111001000001)))
; expect = -295579254784.0

(assert (not (= expect result)))

(check-sat)
(exit)
