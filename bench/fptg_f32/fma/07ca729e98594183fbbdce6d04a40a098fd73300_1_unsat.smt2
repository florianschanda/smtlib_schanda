                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001100 #b10101100011101011111010)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10101100 #b01001100101000010001101)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b0 #b11010100 #b10010111110000100010100)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001111 #b11001010010100000011001)
                expect
                (fp #b0 #b10101110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10101110 #b11111111111111111111111)
                expect
                (fp #b0 #b11010110 #b11010000000101111111101)))
; expect = 281474959933440.0

(assert (not (= expect result)))

(check-sat)
(exit)
