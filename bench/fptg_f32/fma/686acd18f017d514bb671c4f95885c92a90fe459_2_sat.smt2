                (fp #b0 #b10111101 #b00010011010001111001011)))
(assert (fp.leq (fp #b0 #b10111101 #b00010011010001111001011)
                expect
                (fp #b0 #b11011000 #b11000110010001010111000)))
; expect = 4958997002630201344.0

