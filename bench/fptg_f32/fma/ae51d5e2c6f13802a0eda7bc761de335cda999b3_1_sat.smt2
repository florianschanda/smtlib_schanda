(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +LARGEST_NORMAL
; Arg2: +INFINITY
; Arg3: +ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00101101 #b11100010110111011001110)
                arg1
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg1 = 340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11110000 #b11100011001110111000010)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b01110111 #b11010110011001010010000)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
