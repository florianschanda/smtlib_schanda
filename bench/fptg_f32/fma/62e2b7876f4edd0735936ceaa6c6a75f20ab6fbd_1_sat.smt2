                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10101100 #b01000000110001110101011)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b01011101 #b00100111111011101010000)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10000001 #b01001110011110100110001)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111000 #b00111010000100000000000)
                expect
                (fp #b1 #b00000000 #b00000000000000000000011)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000011)
                expect
                (fp #b0 #b01101110 #b11000011010110101101000)))
; expect = -0.00000000000000000000000000000000000000000000420389539297445121277118874986974839384078582562954731527120485166937324805758180445991456508636474609375

(assert (= expect result))

(check-sat)
