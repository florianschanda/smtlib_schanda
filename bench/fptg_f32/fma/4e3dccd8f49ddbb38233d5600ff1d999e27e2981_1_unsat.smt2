(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +INFINITY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11010100 #b00101110001011011111001)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b01010110 #b11100110011100001011011)))
; arg1 = 0.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101111 #b10111001010110011001110)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b10111000 #b01010110011100101010011)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))
; arg3 = Infinity

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
