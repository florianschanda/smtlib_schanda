(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: -INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010011 #b11001101001110010101110)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b1 #b00000001 #b00000101000100011101001)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11100001 #b11111100010111011110101)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11010011 #b00110001001010110110010)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010111 #b10110101101100010110011)
                expect
                (fp #b0 #b11100010 #b10111010110001101111110)))
(assert (fp.leq (fp #b0 #b11100010 #b10111010110001101111110)
                expect
                (fp #b0 #b11111001 #b00111100011000110111111)))
; expect = 1096263453517375200828311207936.0

(assert (= expect result))

(check-sat)
(exit)
