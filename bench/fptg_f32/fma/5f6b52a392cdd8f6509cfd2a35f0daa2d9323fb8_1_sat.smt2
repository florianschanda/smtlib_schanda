                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b01001010 #b00110011110101000111100)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10110101 #b00111000000101011010010)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b11110001 #b10101101100000001101010)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101001 #b00100111000111101011001)
                expect
                (fp #b0 #b01111110 #b01010101011100001100100)))
(assert (fp.leq (fp #b0 #b01111110 #b01010101011100001100100)
                expect
                (fp #b0 #b10110010 #b11111000101010110101101)))
; expect = 0.6668760776519775390625

(assert (= expect result))

(check-sat)
(exit)
