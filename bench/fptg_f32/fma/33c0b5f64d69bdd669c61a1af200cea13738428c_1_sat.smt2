(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INFINITY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001100 #b10110100110000010111100)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b00110000 #b00011110110010011110101)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10011001 #b11001111110011001110101)
                arg3
                (fp #b0 #b00001101 #b10111100100001001001110)))
(assert (fp.leq (fp #b0 #b00001101 #b10111100100001001001110)
                arg3
                (fp #b0 #b10110000 #b01010001010101011000100)))
; arg3 = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
