                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b00100101 #b00010010000010010110111)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10111011 #b00110000110100010010001)
                arg3
                (fp #b0 #b00001101 #b10111100100001001001110)))
(assert (fp.leq (fp #b0 #b00001101 #b10111100100001001001110)
                arg3
                (fp #b0 #b11011111 #b11011110010000111111111)))
; arg3 = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
