(assert (fp.leq (fp #b0 #b00110111 #b01100100001110100011101)
                expect
                (fp #b0 #b01001011 #b11010101110000010001100)))
; expect = 0.00000000000000000000029466443823932944268576496999281245925406125252266065217554569244384765625

(assert (= expect result))

