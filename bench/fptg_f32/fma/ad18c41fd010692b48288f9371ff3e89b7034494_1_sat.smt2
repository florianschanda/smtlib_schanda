(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b01000000010100001000110)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b1 #b10100111 #b00011001010001101101000)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111011 #b00011010111001110000000)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b10011110 #b01011010000110010000000)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10100001 #b00010100111101110010100)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b11010100 #b11000101111010010011010)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10010010 #b10010010011010000011101)
                expect
                (fp #b0 #b11010110 #b11111111111111011000001)))
(assert (fp.leq (fp #b0 #b11010110 #b11111111111111011000001)
                expect
                (fp #b0 #b11101111 #b11010101000001111001110)))
; expect = 309479125309985555377815552.0

(assert (= expect result))

(check-sat)
(exit)
