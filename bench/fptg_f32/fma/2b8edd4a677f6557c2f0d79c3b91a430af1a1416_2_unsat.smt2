(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +LARGEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00111101 #b00000000001001111110100)
                arg1
                (fp #b1 #b00100101 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b00100101 #b00100101010110111111100)
                arg1
                (fp #b0 #b01110011 #b01110101111110001010001)))
; arg1 = -0.000000000000000000000000000925678583284292162965654627128430949396689468577914539082485134713351726531982421875

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01010010 #b10100100011111001011101)
                arg3
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg3
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg3 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
