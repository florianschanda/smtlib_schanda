(assert (fp.leq (fp #b1 #b10010110 #b11111111111111111111111)
                expect
                (fp #b1 #b00110000 #b10100101100101001110000)))
; expect = -16777215.0

(assert (not (= expect result)))

(check-sat)
(exit)
