(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101101 #b00111110011101100001110)
                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b10011110 #b00101011111111001010100)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10100011 #b01010010110101000100100)
                arg3
                (fp #b1 #b00000000 #b00000110001101100100010)))
(assert (fp.leq (fp #b1 #b00000000 #b00000110001101100100010)
                arg3
                (fp #b0 #b01010100 #b01010001000010110010111)))
; arg3 = -0.0000000000000000000000000000000000000002852399076071738140548088515969955881866224393167322914042382774589025340450376688750111497938632965087890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101100 #b11010100110001111100111)
                expect
                (fp #b1 #b00000000 #b00000110001101100100001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000110001101100100001)
                expect
                (fp #b0 #b11110110 #b00011010111010101111000)))
; expect = -0.00000000000000000000000000000000000000028523850630870948923773792786741229827049115905479041488846652039061864425395498301440966315567493438720703125

(assert (= expect result))

(check-sat)
