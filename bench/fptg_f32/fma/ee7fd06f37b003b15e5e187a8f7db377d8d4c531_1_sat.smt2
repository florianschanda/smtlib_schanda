; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY
; Arg3: +INFINITY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010111 #b11110011000111110010010)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b11110111 #b00010101000110011101001)))
; arg1 = 0.000000000000000007176311283322198380889289648365547691355459392070770263671875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01101111 #b11101111010001011110011)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001010 #b11010011111100000110101)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))
; arg3 = Infinity

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
