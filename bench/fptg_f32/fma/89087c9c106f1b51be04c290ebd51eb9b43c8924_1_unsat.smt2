(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10101011 #b10000110010010111000001)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b01011100 #b01010100010001100101100)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000100 #b00110111100100110000011)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10100001 #b00100101100101010010110)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10100000 #b00101110011111101000111)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b0 #b10111100 #b00011011001111101111101)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b01011111110100110000011)
                expect
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                expect
                (fp #b1 #b01001110 #b10001111111010111110110)))
; expect = -2648606.25

(assert (not (= expect result)))

(check-sat)
(exit)
