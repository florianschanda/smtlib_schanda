(assert (= arg2 arg1))

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b00001110 #b10111101110101100101111)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11110101 #b11001101101111110100100)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b01010001110010101100001)
                expect
                (fp #b0 #b11110100 #b11001001100101111000100)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000100)
                expect
                (fp #b0 #b11111001 #b11110000000110101011111)))
; expect = 296994135403833696052795697421877248.0

(assert (= expect result))

(check-sat)
(exit)
