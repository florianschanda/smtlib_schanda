(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00100111 #b10110011110000110111011)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b01011000 #b11101001011001101110001)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b10101111101001001001011)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b1 #b01011100 #b00000110100011000000101)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
