(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b00010011 #b00100101000101101001111)))
; arg1 = -340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111011 #b01111101001100001101010)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11101000 #b11101000001000110000001)))
; arg2 = -16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10110001 #b10000011000011001011101)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111001 #b01011011100001011110110)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
