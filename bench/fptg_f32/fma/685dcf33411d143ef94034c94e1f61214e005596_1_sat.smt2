(assert (fp.leq (fp #b1 #b11001001 #b10101101011001110111111)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b01011100 #b01101010011010110111101)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111111 #b10110111000011000000111)
                expect
                (fp #b0 #b00100001 #b11000000010100001111011)))
(assert (fp.leq (fp #b0 #b00100001 #b11000000010100001111011)
                expect
                (fp #b0 #b10000000 #b11001100110011110101101)))
; expect = 0.000000000000000000000000000088414791422296087597192408997356456479030403067774501746356463627307675778865814208984375

(assert (= expect result))

(check-sat)
