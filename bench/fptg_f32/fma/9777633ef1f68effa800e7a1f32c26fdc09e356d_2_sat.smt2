(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100001 #b10111000011111011001111)
                expect
                (fp #b0 #b01111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11101110 #b01011001011011001111101)))
; expect = 0.25

(assert (= expect result))

(check-sat)
