                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10100111 #b10111110110000110101000)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000110 #b00100110001110001111011)
                expect
                (fp #b1 #b10111101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10111101 #b00010011010001111001010)
                expect
                (fp #b0 #b01101011 #b11111010110101110011010)))
; expect = -4958996452874387456.0

(assert (not (= expect result)))

(check-sat)
(exit)
