; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001100 #b00010110001001110010010)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11101101 #b00111101011110101001010)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b10001000 #b00111101011011000110100)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b00110010011010010010010)
                arg3
                (fp #b0 #b00000000 #b01010110111101010000111)))
(assert (fp.leq (fp #b0 #b00000000 #b01010110111101010000111)
                arg3
                (fp #b0 #b11010011 #b10110010011000010110100)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                expect
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b01010000 #b00111100101000000011000)))
; expect = -340282346638528859811704183484516925440.0

(assert (not (= expect result)))

(check-sat)
(exit)
