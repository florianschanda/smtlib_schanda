(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -NAN

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01111110 #b00101100100111101001000)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11001110 #b01010010000110110000010)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b11000000 #b00111111011111110101001)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111101 #b11101000101100101011100)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
