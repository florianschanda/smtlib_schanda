(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b11111011010011000010010)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b01001000 #b11000010110011010101110)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100011 #b01000110000001011011110)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b1 #b00111000 #b10111011001011000101001)))
; arg2 = -16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b01011110101110111110011)
                arg3
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b1 #b10011010 #b11010010001011010100100)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00010100000101011111011)
                expect
                (fp #b1 #b11111100 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111100 #b11111111111111111111111)
                expect
                (fp #b1 #b00011000 #b00100010010000100001010)))
; expect = -85070586659632214952926045871129231360.0

(assert (not (= expect result)))

(check-sat)
(exit)
