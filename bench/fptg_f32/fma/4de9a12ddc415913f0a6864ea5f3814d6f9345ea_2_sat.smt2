                arg3
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b00011000 #b10110101000111101000000)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100110 #b00001100000000000000000)
                expect
                (fp #b0 #b00000000 #b01000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000001)
