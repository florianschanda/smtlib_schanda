(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +LARGEST_NORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110011 #b01011010001100011100110)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01100011 #b01010000100111001110011)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01010011 #b01101000100010100010000)
                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10100000 #b10000001111010101000101)
                arg3
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b10011100 #b10000101101100001101000)))
; arg3 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
