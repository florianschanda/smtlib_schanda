; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
