(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01101101 #b11100110100001111001110)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b00101010 #b10000001111010001011011)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b01111000 #b01011110000000100010010)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11110111 #b11011000111100111100101)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100100 #b10001011111110001111000)
                expect
                (fp #b0 #b11110100 #b11001001100101111000100)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000100)
                expect
                (fp #b0 #b11111100 #b01001000010010000100010)))
; expect = 296994135403833696052795697421877248.0

(assert (= expect result))

(check-sat)
(exit)
