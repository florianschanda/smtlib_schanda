(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001110 #b00010111000111101101011)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10010110 #b10101001111111100100001)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11010001 #b01101000011011110010011)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b1 #b00010011 #b00101101111011101010110)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
