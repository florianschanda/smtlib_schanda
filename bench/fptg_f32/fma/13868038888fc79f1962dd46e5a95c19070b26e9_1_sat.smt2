                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10001110 #b11001111111111101010000)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b10111000 #b01110100000110000101100)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10011110 #b00110100110010110111100)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111101 #b01010010000010011000110)
                expect
                (fp #b0 #b00000000 #b00000000000000000001100)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000001100)
                expect
                (fp #b0 #b10010000 #b10000101001111001001101)))
; expect = 0.000000000000000000000000000000000000000000016815581571897804851084754999478993575363143302518189261084819406677492992230327217839658260345458984375

(assert (= expect result))

(check-sat)
(exit)
