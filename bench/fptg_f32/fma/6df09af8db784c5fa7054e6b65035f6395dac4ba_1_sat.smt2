(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b00110011 #b10000011010010101011100)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01001000 #b00000001001111100110011)
                arg3
                (fp #b0 #b00001101 #b10111100100001001001110)))
(assert (fp.leq (fp #b0 #b00001101 #b10111100100001001001110)
                arg3
                (fp #b0 #b10100001 #b00011000111001111010011)))
; arg3 = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011010 #b10110000010110011010010)
                expect
                (fp #b0 #b10111101 #b00010011010001111001010)))
(assert (fp.leq (fp #b0 #b10111101 #b00010011010001111001010)
                expect
                (fp #b0 #b11111010 #b10000000101000101011101)))
; expect = 4958996452874387456.0

(assert (= expect result))

(check-sat)
(exit)
