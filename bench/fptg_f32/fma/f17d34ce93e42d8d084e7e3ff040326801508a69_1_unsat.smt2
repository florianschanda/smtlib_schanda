(assert (fp.leq (fp #b1 #b11011110 #b00010010011000101010111)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b10110101 #b10010010101101001100010)))
