                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b00011000 #b10010100100011001001011)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b00101011 #b01000001000001000110111)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b00111001 #b11011110010100100110100)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b00010100100111010100011)
                expect
                (fp #b1 #b01111110 #b10101001011111101011110)))
(assert (fp.leq (fp #b1 #b01111110 #b10101001011111101011110)
                expect
                (fp #b0 #b11110110 #b00000101010101111010000)))
; expect = -0.83104503154754638671875

(assert (= expect result))

(check-sat)
(exit)
