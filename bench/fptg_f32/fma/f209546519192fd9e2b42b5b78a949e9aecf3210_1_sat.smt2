(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b11111010010010010110110)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01011000 #b01010110101011101000100)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01100010 #b01101110110001110100011)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b11010011 #b01001000101101000011000)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00011010 #b01010010010101100011011)
                arg3
                (fp #b0 #b00000000 #b01010110111101010000111)))
(assert (fp.leq (fp #b0 #b00000000 #b01010110111101010000111)
                arg3
                (fp #b0 #b00111100 #b11101011100101010111010)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011110 #b10010010010000110010000)
                expect
                (fp #b1 #b10000011 #b11101001101001110111001)))
(assert (fp.leq (fp #b1 #b10000011 #b11101001101001110111001)
                expect
                (fp #b0 #b01011011 #b10111111001110111101110)))
; expect = -30.6033802032470703125

(assert (= expect result))

(check-sat)
(exit)
