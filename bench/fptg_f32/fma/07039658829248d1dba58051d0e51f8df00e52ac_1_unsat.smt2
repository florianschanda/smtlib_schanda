; Format: FLOAT32
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00000101 #b01110110011110001110110)
                arg1
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b01100111 #b00110101011001011111101)))
; arg1 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101111 #b01000100110101111101111)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b1 #b00000101 #b01000010101000000110010)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b01100001 #b00010000101011100110001)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b11111001 #b01101110100010100100110)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01001010 #b00110000111011100101001)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10010000 #b10001000100101000000000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
