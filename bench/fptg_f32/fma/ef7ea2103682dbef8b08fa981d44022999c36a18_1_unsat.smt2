(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00110010 #b00010111100001110011000)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b00100010 #b00101100101100111000010)))
; arg1 = 0.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110110 #b10000011010010000000001)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11000110 #b11010000100110001010100)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b10100110101010101101111)
                arg3
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b0 #b01001011 #b00011010010111111100100)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b11111111000111100110110)
                expect
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11101110 #b10101110101010011100110)))
; expect = -85070591730234615865843651857942052864.0

(assert (not (= expect result)))

(check-sat)
(exit)
