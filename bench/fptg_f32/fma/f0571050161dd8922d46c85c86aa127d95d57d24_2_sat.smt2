                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11000101 #b01100101010111111010100)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11010110 #b10111000111011011000001)
                arg3
                (fp #b1 #b10010100 #b01000011010100001111001)))
(assert (fp.leq (fp #b1 #b10010100 #b01000011010100001111001)
                arg3
                (fp #b0 #b11001101 #b10111101110011101010100)))
; arg3 = -2648606.25

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010000 #b00010001010011110000000)
                expect
                (fp #b1 #b11001110 #b10011110101101010110111)))
(assert (fp.leq (fp #b1 #b11001110 #b10011110101101010110111)
                expect
                (fp #b1 #b01110011 #b00100001011111100101111)))
; expect = -979203255460359359692800.0

(assert (= expect result))

(check-sat)
(exit)
