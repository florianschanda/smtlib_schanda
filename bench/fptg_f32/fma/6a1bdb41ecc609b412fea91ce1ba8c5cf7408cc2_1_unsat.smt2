; Format: FLOAT32
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111001 #b00000011100110001011011)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11100111 #b00100110111101011000111)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11011101 #b01000001111100110001101)
                arg3
                (fp #b0 #b00000000 #b01010110111101010000111)))
(assert (fp.leq (fp #b0 #b00000000 #b01010110111101010000111)
                arg3
                (fp #b0 #b00000100 #b01001001110000010110100)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
