                (fp #b0 #b11110011 #b01110111111101110000010)))
; arg3 = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101010 #b00110010110000001011111)
                expect
                (fp #b1 #b01111110 #b01010101011100001100100)))
(assert (fp.leq (fp #b1 #b01111110 #b01010101011100001100100)
                expect
                (fp #b0 #b00111010 #b00110000010101011100001)))
; expect = -0.6668760776519775390625

(assert (= expect result))

(check-sat)
(exit)
