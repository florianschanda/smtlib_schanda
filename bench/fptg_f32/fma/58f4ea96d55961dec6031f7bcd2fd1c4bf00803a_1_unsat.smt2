;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100101 #b01000111101011100110110)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
