(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +NAN
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00011100 #b00101100010001101010101)
                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b10100111 #b01011100100101010010000)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b11011110 #b11110100010111000110000)
                arg3
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b0 #b11111110 #b11111100110101111101000)))
; arg3 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
