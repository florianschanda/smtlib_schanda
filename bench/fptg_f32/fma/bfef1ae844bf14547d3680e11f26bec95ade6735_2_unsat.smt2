; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00011101 #b11101110011001101010101)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11011100 #b00011101111110100011101)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111010 #b10100111010110010111111)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b01000010 #b11010010100111101010000)))
; arg2 = -295579222016.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b01101101 #b10110100100010001111000)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b10100110 #b01001110000111110100111)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000011 #b10010100110100100000110)
                expect
                (fp #b1 #b10111101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10111101 #b00010011010001111001010)
                expect
                (fp #b0 #b01111011 #b11101110111110110100010)))
; expect = -4958996452874387456.0

(assert (not (= expect result)))

(check-sat)
(exit)
