(assert (fp.leq (fp #b1 #b00101000 #b00001101110101101010100)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b01110111 #b00111011100111001101111)))
; arg2 = -0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b10010001 #b10010001101100000110000)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11101101 #b00010001010111111100110)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b10011100001101100010110)
                expect
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b11011011 #b11111001100011001010101)))
; expect = 16777216.0

(assert (= expect result))

(check-sat)
(exit)
