; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01001110 #b01110010010011101100001)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11110011 #b01001001110110001000100)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011101 #b10110010010010101110001)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11100011 #b10000101010011101000010)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100100 #b01110000000011010100011)
                expect
                (fp #b0 #b11001110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b11001110 #b10011110101101010110110)
                expect
                (fp #b0 #b11110101 #b11111010111010101101100)))
; expect = 979203183402765321764864.0

(assert (not (= expect result)))

(check-sat)
(exit)
