; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INFINITY
; Arg3: +LARGEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00111111 #b00111011001111111000100)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b10100001 #b10001011110001100110110)))
; arg1 = 0.000000000000000007176311283322198380889289648365547691355459392070770263671875

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b11011111 #b10000110000000001001110)
                arg3
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg3
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg3 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
