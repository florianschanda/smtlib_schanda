; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
