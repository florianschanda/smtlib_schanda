(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00101011 #b10101010100011100011001)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b01000100 #b01011111000000010111000)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01001100 #b01010011101001000101001)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11000000 #b00001110000101011001011)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10010011 #b01011000010011101011001)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10001110 #b00011110011010101010001)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11100111 #b01100011101010011110010)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11011111 #b11111100110101110011001)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
