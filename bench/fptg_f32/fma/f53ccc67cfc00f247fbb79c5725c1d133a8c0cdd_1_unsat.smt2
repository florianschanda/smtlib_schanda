; Format: FLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INFINITY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11000100 #b00101111111000100100011)))
; arg1 = -340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100000 #b01101011110001001010110)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111110 #b10000100001001001111011)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))
; arg3 = Infinity

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
