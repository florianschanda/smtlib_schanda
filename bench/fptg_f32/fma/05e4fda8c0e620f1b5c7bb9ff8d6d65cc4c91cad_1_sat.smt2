                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b1 #b00011110 #b00000011010110010110001)))
; arg2 = -16777216.0

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00101011 #b10111000010101000110111)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b11100001 #b01110101101110110111101)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101000 #b10011000001011000001111)
                expect
                (fp #b1 #b10111010 #b10011110101000110011100)))
(assert (fp.leq (fp #b1 #b10111010 #b10011110101000110011100)
                expect
                (fp #b1 #b01101010 #b10100100001000100011001)))
; expect = -933680810173661184.0

(assert (= expect result))

(check-sat)
(exit)
