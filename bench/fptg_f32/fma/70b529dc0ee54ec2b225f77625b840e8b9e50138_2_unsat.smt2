(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011001 #b10000100000101111110001)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11000011 #b00000101100101000000110)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00011110 #b10100011111111011110100)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11101011 #b10110000001111101000110)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b01000110 #b11101110100001101001110)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b11001111 #b00011011101000011000110)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101010 #b00100111010011101000011)
                expect
                (fp #b0 #b11011010 #b01001111110110001110100)))
(assert (fp.leq (fp #b0 #b11011010 #b01001111110110001110100)
                expect
                (fp #b0 #b11101100 #b11001000101101011000000)))
; expect = 3248115683006605740069617664.0

(assert (not (= expect result)))

(check-sat)
(exit)
