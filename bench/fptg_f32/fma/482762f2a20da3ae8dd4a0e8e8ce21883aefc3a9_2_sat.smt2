(assert (fp.leq (fp #b1 #b10101000 #b01011001001010000011001)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b11101010 #b01100000100001010110011)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110011 #b10010011110010010010100)
                expect
                (fp #b0 #b01111111 #b00111010011110010010100)))
(assert (fp.leq (fp #b0 #b01111111 #b00111010011110010010100)
                expect
                (fp #b0 #b10000111 #b01000111101000111100110)))
; expect = 1.228411197662353515625

(assert (= expect result))

(check-sat)
(exit)
