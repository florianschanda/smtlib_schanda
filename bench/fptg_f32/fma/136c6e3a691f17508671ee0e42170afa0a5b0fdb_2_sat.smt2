; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001011 #b01000010110010111101001)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b01100010 #b00001011000110111101010)))
; arg1 = 0.000000000000000007176311283322198380889289648365547691355459392070770263671875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000111 #b00101111111010100000110)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11111000 #b01011100111010111001000)))
; arg2 = 58365057909653504.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01011011000011111100011)
                arg3
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b1 #b01010101 #b10110001011110101000111)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b01111110110101010001100)
                expect
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                expect
                (fp #b0 #b01011101 #b01010010101100111101000)))
; expect = -85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
