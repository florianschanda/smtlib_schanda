; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
