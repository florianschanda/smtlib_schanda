                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10011111 #b01000010100100010110111)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00111000 #b11101101000011001100101)
                arg3
                (fp #b0 #b00000000 #b01010110111101010000111)))
(assert (fp.leq (fp #b0 #b00000000 #b01010110111101010000111)
                arg3
                (fp #b0 #b00100010 #b01010000011001111010111)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100001 #b10110101000100110010001)
                expect
                (fp #b0 #b10000011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b10000011 #b11101001101001110111010)
                expect
                (fp #b0 #b11111011 #b01011001000100101010010)))
; expect = 30.603382110595703125

(assert (= expect result))

(check-sat)
(exit)
