                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b01000000 #b11100101001000011001001)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01010110 #b11001111000010100100000)
                arg3
                (fp #b0 #b00000000 #b01010110111101010000111)))
(assert (fp.leq (fp #b0 #b00000000 #b01010110111101010000111)
                arg3
                (fp #b0 #b10101101 #b00001010001100101000000)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101001 #b01110010010111011110100)
                expect
                (fp #b0 #b01010001 #b01001011010001011011001)))
(assert (fp.leq (fp #b0 #b01010001 #b01001011010001011011001)
                expect
                (fp #b0 #b10111100 #b00101100111010000000101)))
; expect = 0.000000000000018389303819391251970660761116960202343761920928955078125

(assert (= expect result))

(check-sat)
(exit)
