                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b00111001 #b01101011011111001001011)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100010 #b01100010111001010101010)
                expect
                (fp #b1 #b00110111 #b01100100001110100011110)))
(assert (fp.leq (fp #b1 #b00110111 #b01100100001110100011110)
                expect
                (fp #b0 #b00101111 #b01100011000000010010000)))
; expect = -0.0000000000000000000002946644634828784097581427431681265483032206020652665756642818450927734375

(assert (not (= expect result)))

(check-sat)
(exit)
