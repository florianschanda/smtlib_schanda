                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b00101010 #b01011010111100100011001)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b10111100101101110000100)
                arg3
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b00010101 #b00011110000110000000010)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000010 #b01010001110110000010001)
                expect
                (fp #b0 #b01111101 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b01111101 #b00000000000000000000001)
                expect
                (fp #b0 #b11010111 #b01010110010000110011110)))
; expect = 0.2500000298023223876953125

(assert (= expect result))

(check-sat)
(exit)
