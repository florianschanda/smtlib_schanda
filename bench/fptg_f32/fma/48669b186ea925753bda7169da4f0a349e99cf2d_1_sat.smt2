; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +NAN
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110100 #b00010111000100100100110)
                arg1
                (fp #b1 #b00100101 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b00100101 #b00100101010110111111100)
                arg1
                (fp #b0 #b10000001 #b01100110001010010010110)))
