                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b00010110 #b10110011111000011010000)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b10101100100101111000100)
                expect
                (fp #b1 #b11001000 #b11011100001000011110000)))
(assert (fp.leq (fp #b1 #b11001000 #b11011100001000011110000)
                expect
                (fp #b0 #b00101001 #b01011111010001010001001)))
; expect = -17566182260167562756096.0

(assert (= expect result))

(check-sat)
(exit)
