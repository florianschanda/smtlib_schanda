                arg2
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b11000011 #b11111111010011011010100)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11111011 #b11111101100110111000011)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11000000 #b10001101101001011001000)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01111100 #b11010110000100110000011)
                expect
                (fp #b0 #b10010110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10010110 #b11111111111111111111111)
                expect
                (fp #b0 #b10111100 #b10000100100101101011101)))
; expect = 16777215.0

(assert (not (= expect result)))

(check-sat)
(exit)
