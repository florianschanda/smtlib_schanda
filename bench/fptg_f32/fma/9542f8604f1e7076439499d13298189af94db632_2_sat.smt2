(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01001111 #b11100110001111000100101)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11011101 #b11111110101111101111110)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011010 #b00011011010011011000111)
                expect
                (fp #b0 #b10010110 #b11111111111111111111101)))
(assert (fp.leq (fp #b0 #b10010110 #b11111111111111111111101)
                expect
                (fp #b0 #b10101100 #b10011001011000000010100)))
; expect = 16777213.0

(assert (= expect result))

(check-sat)
(exit)
