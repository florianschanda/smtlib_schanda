; Format: FLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -INT_BOUNDARY

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b1 #b00001100 #b00111011011000101100011)))
; arg1 = -340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00000010 #b01010001011101111100110)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10100101 #b11011000001100000111000)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10100111 #b10001101110010100001001)
                arg3
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b1 #b00111000 #b11000100010000001110001)))
; arg3 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                expect
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b10110000 #b10001100110010011101010)))
; expect = -340282346638528859811704183484516925440.0

(assert (= expect result))

(check-sat)
(exit)
