; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b10100111101010011010001)
                arg1
                (fp #b1 #b00100101 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b00100101 #b00100101010110111111100)
                arg1
                (fp #b0 #b10101111 #b00000000011001110000001)))
; arg1 = -0.000000000000000000000000000925678583284292162965654627128430949396689468577914539082485134713351726531982421875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011000 #b01101101111001100111110)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10110100 #b10101000101000000000000)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg3
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg3
                (fp #b0 #b01111011 #b10000010000110000111101)))
; arg3 = -340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
