(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))
; arg1 = Infinity

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00110111 #b11001000000010100011011)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10101101 #b01001100000010101100100)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10001000 #b11001011100011010010010)
                arg3
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b11101011 #b11100101011111101101111)))
; arg3 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
