                arg2
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b01100010 #b01000011000110110011101)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01101110 #b01101101011001110100000)
                arg3
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg3
                (fp #b0 #b11010001 #b01000011101100010011001)))
; arg3 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101101 #b11100110111010000100011)
                expect
                (fp #b0 #b01111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11110100 #b00101000000111100001110)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
