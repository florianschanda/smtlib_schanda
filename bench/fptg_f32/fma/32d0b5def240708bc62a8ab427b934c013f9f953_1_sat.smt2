(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +ZERO
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11110001 #b11100100111001001101100)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b00110000 #b01001101001000111001111)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11001101 #b01110110110010010010010)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11100010 #b10001100111001101000011)))
; arg2 = 0.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00001000 #b11000101001011111010010)
                arg3
                (fp #b0 #b00001101 #b10111100100001001001110)))
(assert (fp.leq (fp #b0 #b00001101 #b10111100100001001001110)
                arg3
                (fp #b0 #b00010101 #b00001101011011001001101)))
; arg3 = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100111 #b10000110010011100101001)
                expect
                (fp #b0 #b00001101 #b10111100100001001001110)))
(assert (fp.leq (fp #b0 #b00001101 #b10111100100001001001110)
                expect
                (fp #b0 #b11001010 #b10111100011011000101000)))
; expect = 0.0000000000000000000000000000000000836045446644019134926628196491062743493829915298500809927770803520186149171422584913671016693115234375

(assert (= expect result))

(check-sat)
(exit)
