; arg3 = -0.00000000000000000000000000000000521744049233235427127554688598496660784073071372458625487300576395455209421925246715545654296875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001011 #b00110001111111001111100)
                expect
                (fp #b1 #b00010111 #b01010101100100000101001)))
(assert (fp.leq (fp #b1 #b00010111 #b01010101100100000101001)
                expect
                (fp #b0 #b11111100 #b10001100000111000000111)))
; expect = -0.0000000000000000000000000000000657827856393184431748823801924065542841809872482959913216060687801700623822398483753204345703125

