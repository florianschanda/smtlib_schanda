                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b11111010 #b01000010101010101011100)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b10011110 #b10100101011101111000011)
                arg3
                (fp #b1 #b00000000 #b00000110001101100100010)))
(assert (fp.leq (fp #b1 #b00000000 #b00000110001101100100010)
                arg3
                (fp #b0 #b11111101 #b10000100110100101011011)))
; arg3 = -0.0000000000000000000000000000000000000002852399076071738140548088515969955881866224393167322914042382774589025340450376688750111497938632965087890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b01110101111000111111011)
                expect
                (fp #b0 #b10001111 #b10001100100010101000000)))
(assert (fp.leq (fp #b0 #b10001111 #b10001100100010101000000)
                expect
                (fp #b0 #b11111011 #b01110000100001111000000)))
; expect = 101514.5

(assert (= expect result))

(check-sat)
(exit)
