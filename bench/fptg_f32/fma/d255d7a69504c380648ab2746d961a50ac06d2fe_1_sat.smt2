(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001010 #b01000111000011000101101)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111000 #b01111011011111010101010)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10000100 #b01111110011010011000101)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10110110 #b11110010111000110110010)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10000000 #b00001100010001110101110)
                arg3
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10100101 #b00110011110011111110011)))
; arg3 = -0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b00100011101101111101110)
                expect
                (fp #b1 #b10101111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10101111 #b00000000000000000000000)
                expect
                (fp #b1 #b00101101 #b01000110001111111111011)))
; expect = -281474976710656.0

(assert (= expect result))

(check-sat)
(exit)
