(assert (fp.leq (fp #b0 #b01111110 #b00010100110010110001111)
                expect
                (fp #b0 #b11010111 #b11100100000011010001110)))
; expect = 0.540612161159515380859375

(assert (not (= expect result)))

(check-sat)
