(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01010000 #b11011000111110011100111)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b1 #b00001101 #b10011110100001011011000)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111101 #b01010000010011011011001)
                expect
                (fp #b1 #b00011111 #b01100100001110100011100)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011100)
                expect
                (fp #b0 #b00000111 #b00010111101111101001110)))
; expect = -0.000000000000000000000000000017563367664562492109142970849126480233961457191708965819287868725950829684734344482421875

(assert (= expect result))

(check-sat)
(exit)
