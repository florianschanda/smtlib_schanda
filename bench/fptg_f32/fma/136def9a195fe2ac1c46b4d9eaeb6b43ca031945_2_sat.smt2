                (fp #b0 #b01100111 #b10111111011001111100111)))
; arg3 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001100 #b11101001100111110010101)
                expect
                (fp #b0 #b00110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b0 #b00110000 #b11011100001000011101111)
                expect
                (fp #b0 #b01111100 #b01010101110011000011101)))
; expect = 0.000000000000000000000003076932830937604937472166034467799581274272124886692836298607289791107177734375

(assert (= expect result))

(check-sat)
(exit)
