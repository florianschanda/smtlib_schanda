(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: +NAN

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111101 #b11111101011001100100010)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b00000001 #b00010110001010001110000)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011010 #b01111011000101111101101)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b1 #b01111001 #b01100010011000111110000)))
; arg2 = -16777216.0

(declare-const arg3 Float32)
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
