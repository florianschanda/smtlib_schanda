                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10011100 #b10010110000101110111010)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01000000 #b01101100111001101001100)
                arg3
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg3
                (fp #b0 #b11001110 #b10000001100111111101100)))
; arg3 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001010 #b00000001110100101100000)
                expect
                (fp #b0 #b10101111 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b10101111 #b00000000000000000000001)
                expect
                (fp #b0 #b11100011 #b11111101010111000101011)))
; expect = 281475010265088.0

(assert (= expect result))

(check-sat)
(exit)
