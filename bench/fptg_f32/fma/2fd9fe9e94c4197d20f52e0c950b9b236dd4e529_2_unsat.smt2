                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10010001 #b00110000110111100011111)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const arg3 Float32)
(assert (= arg3 arg2))

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b10010101010111111101000)
                expect
                (fp #b1 #b11101001 #b11101001101001110111010)))
(assert (fp.leq (fp #b1 #b11101001 #b11101001101001110111010)
                expect
                (fp #b0 #b00101010 #b10111011110011001001111)))
; expect = -155177582806042004026817184268288.0

(assert (not (= expect result)))

(check-sat)
(exit)
