(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011000 #b11111111000100101001100)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b10001101 #b00010111101000110110100)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011010 #b11111100001101011101111)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111110 #b00100100111111100111111)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b11110111000101111011010)
                arg3
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg3
                (fp #b1 #b01000011 #b10010110000100001101011)))
; arg3 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                expect
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b00101101 #b11100011110010101011101)))
; expect = -340282346638528859811704183484516925440.0

(assert (not (= expect result)))

(check-sat)
(exit)
