(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010011 #b11101100110101111111110)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11110111 #b11001101011110000010110)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b01000111 #b01010000111111101000010)
                arg3
                (fp #b0 #b00000000 #b01010110111101010000111)))
(assert (fp.leq (fp #b0 #b00000000 #b01010110111101010000111)
                arg3
                (fp #b0 #b01010101 #b10101000101100100001010)))
; arg3 = 0.00000000000000000000000000000000000000399288086372409863414613893057003637321194758111207218778116672413982905787133148578504915349185466766357421875

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
