(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +INFINITY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110010 #b00110010100000010101000)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b11110010 #b00011110011110000100100)))
; arg1 = -0.0000000000000000000000000000000000000078390906197842473151128329331162838047950527052918132227640646251414814627000993141336948610842227935791015625

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))
; arg2 = Infinity

(declare-const arg3 Float32)
(assert (fp.leq (fp #b0 #b11100111 #b01100110010010000000110)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111010 #b01000011001100011001111)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
