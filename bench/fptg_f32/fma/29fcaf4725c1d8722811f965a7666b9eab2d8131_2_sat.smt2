                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10111101 #b01101101001100110110111)))
; arg2 = 16777216.0

(declare-const arg3 Float32)
(assert (fp.leq (fp #b1 #b00100111 #b00110011101010010110101)
                arg3
                (fp #b0 #b11110100 #b11001001100101111000011)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000011)
                arg3
                (fp #b0 #b11111001 #b11011101000010011000011)))
; arg3 = 296994115596793067486711299035889664.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011110 #b11001011111011110101101)
                expect
                (fp #b0 #b11110100 #b11001001100101111000100)))
(assert (fp.leq (fp #b0 #b11110100 #b11001001100101111000100)
                expect
                (fp #b0 #b11111110 #b01010111100010001101001)))
; expect = 296994135403833696052795697421877248.0

(assert (= expect result))

(check-sat)
(exit)
