(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +ZERO
; Arg3: +NAN

; Redundancy: True
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10111000 #b00000010111011110100100)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b00000110 #b00111110000001111000110)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00111001 #b01011001000010010000000)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b01010100 #b11100110101111010000110)))
; arg2 = 0.0

(declare-const arg3 Float32)
(assert (fp.isNaN arg3))
; arg3 = NaN

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
