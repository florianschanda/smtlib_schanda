(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b11110111 #b11011011000010011110101)))
; expect = 16777216.0

(assert (not (= expect result)))

(check-sat)
(exit)
