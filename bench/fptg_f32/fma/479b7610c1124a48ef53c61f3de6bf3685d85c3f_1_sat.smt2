; arg3 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001111 #b11110010010100000110010)
                expect
                (fp #b1 #b00000000 #b00111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b00111111111111111111111)
                expect
                (fp #b0 #b00111000 #b10110010001011011001010)))
; expect = -0.00000000000000000000000000000000000000293873447575725444510477041932603090463053261166827692725610750862775925884573524626830476336181163787841796875

(assert (= expect result))

(check-sat)
