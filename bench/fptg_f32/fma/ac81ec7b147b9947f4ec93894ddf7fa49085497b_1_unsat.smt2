(assert (fp.leq (fp #b1 #b10101111 #b11100101110000000011001)
                arg3
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg3
                (fp #b0 #b10001011 #b00101001111000001100110)))
; arg3 = 0.0

(declare-const result Float32)
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101111 #b00010011000000110110101)
                expect
                (fp #b1 #b11001110 #b10011110101101010110110)))
(assert (fp.leq (fp #b1 #b11001110 #b10011110101101010110110)
                expect
                (fp #b0 #b01010100 #b00011110101111100111100)))
; expect = -979203183402765321764864.0

(assert (not (= expect result)))

(check-sat)
(exit)
