; Format: FLOAT32
; Target: bv43
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11011110 #b10111000000111110100001)
                arg
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg
                (fp #b1 #b00101101 #b00000000010100101010001)))
; arg = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ BitVec 43))
(assert (= result ((_ fp.to_ubv 43) rm arg)))

(declare-const expect (_ BitVec 43))
(assert (not (bvule expect #b0100011111111011100010001011100110100101100)))
(assert (not (bvule #b0100011111111011100010001011100110100101110 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
