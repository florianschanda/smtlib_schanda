; Format: FLOAT32
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11011011 #b11001100111000000010110)
                arg
                (fp #b1 #b10010011 #b01111001100110011100000)))
(assert (fp.leq (fp #b1 #b10010011 #b01111001100110011100000)
                arg
                (fp #b1 #b01000011 #b01000010011001101001111)))
; arg = -1546652.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b01110011))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
