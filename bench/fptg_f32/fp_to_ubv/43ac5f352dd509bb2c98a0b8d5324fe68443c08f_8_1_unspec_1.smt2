(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv8
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11100010 #b10000101111010111001011)
                arg
                (fp #b1 #b11011011 #b11100111001001101100011)))
(assert (fp.leq (fp #b1 #b11011011 #b11100111001001101100011)
                arg
                (fp #b1 #b10011101 #b11101011111111111001100)))
; arg = -9422879624544000785459970048.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00111000)))
(assert (not (bvule #b00111010 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
