(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv27
; Arg1: -ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11101100 #b11011110101010011110010)
                arg
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg
                (fp #b1 #b01111100 #b11100010001011001101111)))
; arg = -1.0

(declare-const result (_ BitVec 27))
(assert (= result ((_ fp.to_ubv 27) rm arg)))

(declare-const expect (_ BitVec 27))
(assert (not (bvule expect #b110001000000011001011011011)))
(assert (not (bvule #b110001000000011001011011101 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
