; Format: FLOAT32
; Target: bv6
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b10000101 #b11101100101101000000110)
                arg
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                arg
                (fp #b0 #b11111100 #b10111011101100111010110)))
; arg = 22559420300669994798153728.0

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_ubv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b111110)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
