; Format: FLOAT32
; Target: bv15
; Arg1: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11110110 #b01000000100011010100010)
                arg
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg
                (fp #b0 #b11001001 #b10100100001111010000000)))
; arg = -19824648192.0

(declare-const result (_ BitVec 15))
(assert (= result ((_ fp.to_ubv 15) rm arg)))

(declare-const expect (_ BitVec 15))
(assert (= expect #b001111000111001))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
