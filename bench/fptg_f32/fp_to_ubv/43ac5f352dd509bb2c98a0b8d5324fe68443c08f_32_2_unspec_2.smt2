; Format: FLOAT32
; Target: bv32
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11100010 #b10000101111010111001011)
                arg
                (fp #b1 #b11011011 #b11100111001001101100011)))
(assert (fp.leq (fp #b1 #b11011011 #b11100111001001101100011)
                arg
                (fp #b1 #b10011101 #b11101011111111111001100)))
; arg = -9422879624544000785459970048.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b10111010001111001011101010100110)))
(assert (not (bvule #b10111010001111001011101010101000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
