(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv5
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b01100101 #b00000010111110100100011)
                arg
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg
                (fp #b0 #b11111000 #b00101110100100011110111)))
; arg = 1.76562607288360595703125

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_ubv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b00000)))
(assert (not (bvule #b00010 expect)))

(assert (= expect result))

(check-sat)
(exit)
