(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv58
; Arg1: -INFINITY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.isNegative arg))
(assert (fp.isInfinite arg))
; arg = -Infinity

(declare-const result (_ BitVec 58))
(assert (= result ((_ fp.to_ubv 58) rm arg)))

(declare-const expect (_ BitVec 58))
(assert (not (bvule expect #b0101011011011001011110111100011011111010001111101010001000)))
(assert (not (bvule #b0101011011011001011110111100011011111010001111101010001010 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
