; Format: FLOAT32
; Target: bv29
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b00101101 #b00110100110101110011011)
                arg
                (fp #b0 #b10011110 #b11110001001010000001001)))
(assert (fp.leq (fp #b0 #b10011110 #b11110001001010000001001)
                arg
                (fp #b0 #b11110011 #b10011001111110110010010)))
; arg = 4170451200.0

(declare-const result (_ BitVec 29))
(assert (= result ((_ fp.to_ubv 29) rm arg)))

(declare-const expect (_ BitVec 29))
(assert (not (bvule expect #b00101110101001110010111001101)))
(assert (not (bvule #b00101110101001110010111001111 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
