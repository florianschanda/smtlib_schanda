; Format: FLOAT32
; Target: bv10
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00001110101100001000111)
                arg
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg
                (fp #b0 #b10110100 #b10111011001101011111110)))
; arg = 2562247297597440.0

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_ubv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (not (bvule expect #b0100101010)))
(assert (not (bvule #b0100101100 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
