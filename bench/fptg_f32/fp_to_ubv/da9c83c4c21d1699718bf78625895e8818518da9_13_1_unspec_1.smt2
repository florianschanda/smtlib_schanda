; Format: FLOAT32
; Target: bv13
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b10100110 #b00011100001110000101010)
                arg
                (fp #b1 #b01111111 #b11110100011000110101101)))
(assert (fp.leq (fp #b1 #b01111111 #b11110100011000110101101)
                arg
                (fp #b1 #b01010000 #b01111110010010000001111)))
; arg = -1.95464098453521728515625

(declare-const result (_ BitVec 13))
(assert (= result ((_ fp.to_ubv 13) rm arg)))

(declare-const expect (_ BitVec 13))
(assert (not (bvule expect #b1101110001011)))
(assert (not (bvule #b1101110001101 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
