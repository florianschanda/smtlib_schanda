(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00101101111011110101000)
                arg
                (fp #b1 #b01111111 #b10010010111110011011111)))
(assert (fp.leq (fp #b1 #b01111111 #b10010010111110011011111)
                arg
                (fp #b0 #b11110000 #b01011011000101111111000)))
