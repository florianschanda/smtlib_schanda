; Format: FLOAT32
; Target: bv44
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11011100 #b10001010111010110001001)
                arg
                (fp #b1 #b10011011 #b11111010101001101111100)))
(assert (fp.leq (fp #b1 #b10011011 #b11111010101001101111100)
                arg
                (fp #b0 #b00101100 #b01001011011000111100011)))
; arg = -531263360.0

(declare-const result (_ BitVec 44))
(assert (= result ((_ fp.to_ubv 44) rm arg)))

(declare-const expect (_ BitVec 44))
(assert (not (bvule expect #b11101100101110100001001111110110001101101001)))
(assert (not (bvule #b11101100101110100001001111110110001101101011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

