; Format: FLOAT32
; Target: bv64
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg
                (fp #b1 #b10101001 #b00101010101101001010101)))
; arg = -340282346638528859811704183484516925440.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0100001011001001011110110111101111101101100011111101010101100001)))
(assert (not (bvule #b0100001011001001011110110111101111101101100011111101010101100011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
