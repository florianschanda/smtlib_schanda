; Format: FLOAT32
; Target: bv37
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b10111000 #b01101000101110110101111)
                arg
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg
                (fp #b0 #b00101010 #b01000110111001010100111)))
; arg = -1047025986568192.0

(declare-const result (_ BitVec 37))
(assert (= result ((_ fp.to_ubv 37) rm arg)))

(declare-const expect (_ BitVec 37))
(assert (not (bvule expect #b1001010000000111101111010101001111111)))
(assert (not (bvule #b1001010000000111101111010101010000001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
