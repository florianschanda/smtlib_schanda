; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010010 #b01100100100000110001011)
                arg1
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10000010 #b00110011010010010110111)))
; arg1 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010100 #b10101010011111101001100)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10001100 #b10111100000000101101111)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
