(assert (fp.leq (fp #b1 #b10100001 #b10010111001011000100011)
                expect
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b11110100 #b11100000101111010011110)))
; expect = 16777216.0

(assert (= expect result))

(check-sat)
(exit)
