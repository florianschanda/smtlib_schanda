(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b01010100101100011001000)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b10000110 #b00001010001111111111110)))
; arg1 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b01011011111101111111111)
                expect
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b11001111 #b11101111100001110000010)))
; expect = -16777216.0

(assert (= expect result))

(check-sat)
(exit)
