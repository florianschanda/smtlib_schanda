(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: FULL
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00101101111011110101000)
                arg1
                (fp #b1 #b01111111 #b10010010111110011011111)))
(assert (fp.leq (fp #b1 #b01111111 #b10010010111110011011111)
                arg1
                (fp #b0 #b11110000 #b01011011000101111111000)))
; arg1 = -1.57412326335906982421875

(declare-const result Float32)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b01000011100100100000011)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11101111 #b10111011100111011101001)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
