; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001010 #b11110011011001100001000)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b1 #b00101100 #b10010100011010110100011)))
; arg1 = -1.040654659271240234375

(declare-const result Float32)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010000 #b00101000110000111010110)
                expect
                (fp #b1 #b10000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10010111 #b01100001111101111110010)))
; expect = -2.0

(assert (= expect result))

(check-sat)
(exit)
