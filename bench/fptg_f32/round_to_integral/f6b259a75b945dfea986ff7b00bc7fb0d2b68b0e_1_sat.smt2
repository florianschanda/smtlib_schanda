(declare-const result Float32)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b00100111011000100010100)
                expect
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                expect
                (fp #b0 #b10111000 #b11011111110010001000000)))
; expect = -19824648192.0

(assert (= expect result))

(check-sat)
(exit)
