; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11111001010110101100000)
                arg1
                (fp #b0 #b01111111 #b00010001000010101011100)))
(assert (fp.leq (fp #b0 #b01111111 #b00010001000010101011100)
                arg1
                (fp #b0 #b11010000 #b00110101100001110001101)))
; arg1 = 1.066569805145263671875

(declare-const result Float32)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110110 #b00010111001000100011100)
                expect
                (fp #b0 #b10000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10101001 #b10000010001000100111011)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
