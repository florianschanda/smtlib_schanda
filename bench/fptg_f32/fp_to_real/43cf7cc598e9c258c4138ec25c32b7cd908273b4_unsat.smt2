; Format: FLOAT32
; Arg1: +ONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00000101111111011001110)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11100000 #b10001010101011001011001)))
; arg1 = 1.0

(declare-const result Real)
(assert (= result (fp.to_real arg1)))

(declare-const expect Real)
(assert (not (< (/ 16777215.0 16777216.0)
                expect
                (/ 8388609.0 8388608.0))))

(assert (= expect result))

(check-sat)
(exit)
