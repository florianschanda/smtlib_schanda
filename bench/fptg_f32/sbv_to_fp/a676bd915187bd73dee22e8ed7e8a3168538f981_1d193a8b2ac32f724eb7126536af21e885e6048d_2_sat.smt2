; Format: FLOAT32
; Arg1: 4294967295

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ BitVec 33))
(assert (not (bvule arg1 #b011111111111111111111111111111110)))
(assert (not (bvule #b100000000000000000000000000000000 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101001 #b11100101011001101001000)
                expect
                (fp #b0 #b10011111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10011111 #b00000000000000000000000)
                expect
                (fp #b0 #b10111111 #b00110011011000100110100)))
; expect = 4294967296.0

(assert (= expect result))

(check-sat)
(exit)
