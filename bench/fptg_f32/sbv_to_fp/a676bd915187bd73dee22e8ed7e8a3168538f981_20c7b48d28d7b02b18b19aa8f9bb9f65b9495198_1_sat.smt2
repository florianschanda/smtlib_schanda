; Format: FLOAT32
; Arg1: -256

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 10))
(assert (not (bvule arg1 #b1011111111)))
(assert (not (bvule #b1100000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011111 #b01011110101001001100110)
                expect
                (fp #b1 #b10000111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000111 #b00000000000000000000000)
                expect
                (fp #b1 #b00110000 #b10110110011110111100101)))
; expect = -256.0

(assert (= expect result))

(check-sat)
(exit)
