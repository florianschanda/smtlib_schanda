; Format: FLOAT32
; Arg1: 256

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 10))
(assert (not (bvule arg1 #b0011111111)))
(assert (not (bvule #b0100000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010010 #b10101101011001101001101)
                expect
                (fp #b0 #b10000111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000111 #b00000000000000000000000)
                expect
                (fp #b0 #b10110010 #b00011100101010001111111)))
; expect = 256.0

(assert (= expect result))

(check-sat)
(exit)
