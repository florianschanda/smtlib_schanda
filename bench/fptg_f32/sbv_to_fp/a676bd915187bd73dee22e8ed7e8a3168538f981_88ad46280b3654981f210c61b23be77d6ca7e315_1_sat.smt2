;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ BitVec 26))
(assert (not (bvule arg1 #b10111111111111111111111110)))
(assert (not (bvule #b11000000000000000000000000 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100001 #b01101001010011110110011)
                expect
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                expect
                (fp #b1 #b00001110 #b00110001101000111101010)))
; expect = -16777216.0

(assert (= expect result))

(check-sat)
(exit)
