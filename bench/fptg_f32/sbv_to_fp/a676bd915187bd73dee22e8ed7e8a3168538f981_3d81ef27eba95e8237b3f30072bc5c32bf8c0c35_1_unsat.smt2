(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -2

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 3))
(assert (not (bvule arg1 #b101)))
(assert (not (bvule #b111 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111101 #b00101010101001010010101)
                expect
                (fp #b1 #b10000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11010111 #b11001111000000100110001)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
