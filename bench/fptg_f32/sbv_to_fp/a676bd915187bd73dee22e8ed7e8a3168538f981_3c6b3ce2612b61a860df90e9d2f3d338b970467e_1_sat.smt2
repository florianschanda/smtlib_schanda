; Format: FLOAT32
; Arg1: -32767

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1000000000000000)))
(assert (not (bvule #b1000000000000010 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b11011100111100111110010)
                expect
                (fp #b1 #b10001101 #b11111111111111000000000)))
(assert (fp.leq (fp #b1 #b10001101 #b11111111111111000000000)
                expect
                (fp #b1 #b10001101 #b10100111000001000011110)))
; expect = -32767.0

(assert (= expect result))

(check-sat)
(exit)
