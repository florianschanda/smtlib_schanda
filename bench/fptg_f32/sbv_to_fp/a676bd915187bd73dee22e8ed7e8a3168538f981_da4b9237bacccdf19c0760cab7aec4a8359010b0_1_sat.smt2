(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: 2

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 3))
(assert (not (bvule arg1 #b001)))
(assert (not (bvule #b011 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01100011 #b00010000101100010111101)
                expect
                (fp #b0 #b10000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11101111 #b00110101001000001110100)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
