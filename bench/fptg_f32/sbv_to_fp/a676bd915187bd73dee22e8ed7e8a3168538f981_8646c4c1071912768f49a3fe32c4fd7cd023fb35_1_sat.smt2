(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 9))
(assert (not (bvule arg1 #b100000000)))
(assert (not (bvule #b100000010 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010001 #b00011001101011010010100)
                expect
                (fp #b1 #b10000110 #b11111110000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b11111110000000000000000)
                expect
                (fp #b0 #b01010111 #b00101110001101010000010)))
; expect = -255.0

(assert (= expect result))

(check-sat)
