(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 9))
(assert (not (bvule arg1 #b101111111)))
(assert (not (bvule #b110000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001001 #b00101101011011001111101)
                expect
                (fp #b1 #b10000110 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b00000000000000000000000)
                expect
                (fp #b1 #b00111001 #b10110010011110011101110)))
; expect = -128.0

(assert (= expect result))

(check-sat)
