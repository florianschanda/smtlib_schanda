; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b10001111000010110010100)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b00101100 #b00010000110111100011100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111010 #b10010101100110101110000)
                arg2
                (fp #b0 #b00000000 #b00110101011010011001010)))
(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b01010000 #b00110110100001110101000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111011 #b00000100111010110000101)
                expect
                (fp #b0 #b00000001 #b00001010001010001111001)))
(assert (fp.leq (fp #b0 #b00000001 #b00001010001010001111001)
                expect
                (fp #b0 #b01001110 #b01011100010001000111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
