; Format: FLOAT32
; Arg1: +ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000000 #b01011000000000011110011)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11010110 #b00001110101110101101010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100011 #b10010110101101001001110)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b01100110 #b11011111011000101000010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101000 #b11100011111011011011010)
                expect
                (fp #b0 #b01111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b01111110 #b11111111111111111111111)
                expect
                (fp #b0 #b11010011 #b01000111000100010111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
