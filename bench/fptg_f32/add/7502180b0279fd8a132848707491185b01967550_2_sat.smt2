(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b00100110110011100110110)
                arg1
                (fp #b1 #b00101111 #b10100010101001001111101)))
(assert (fp.leq (fp #b1 #b00101111 #b10100010101001001111101)
                arg1
                (fp #b0 #b00010110 #b00101000011001101100010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100100 #b11010101110100111100000)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b10111000 #b01100001000010010001100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000011 #b00010111000010111001000)
                expect
                (fp #b1 #b01000000 #b00000000000000001101001)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000001101001)
                expect
                (fp #b0 #b01000010 #b11110101001011000101010)))

(assert (= expect result))

(check-sat)
(exit)
