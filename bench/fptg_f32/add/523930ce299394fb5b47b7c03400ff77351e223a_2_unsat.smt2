                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b01001110 #b00111010111101111111101)))
; arg2 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111001 #b10100010100001110101101)
                expect
                (fp #b1 #b10110000 #b11011100001000011110000)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011110000)
                expect
                (fp #b0 #b00100011 #b01100001011111110100101)))
; expect = -1047026053677056.0

(assert (not (= expect result)))

(check-sat)
(exit)
