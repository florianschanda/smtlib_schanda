(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101011 #b01010100101110111010011)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b0 #b11111000 #b01100011101100100010000)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00111010 #b10100111000000101110110)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111101 #b10110011010010101000000)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101011 #b11100111010101111111100)
                expect
                (fp #b0 #b11111100 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b11111111111111111111111)
                expect
                (fp #b0 #b11111110 #b11110001100000111011001)))
; expect = 85070586659632214952926045871129231360.0

(assert (= expect result))

(check-sat)
(exit)
