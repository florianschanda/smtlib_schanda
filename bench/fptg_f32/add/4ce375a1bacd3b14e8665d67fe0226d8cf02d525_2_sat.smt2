; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010011 #b00111000010010101011011)
                arg1
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b11100011 #b11100101100111101101101)))
; arg1 = 0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10011010 #b00100011000000111011100)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11001111 #b10111001010110101011001)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000100 #b01111000010011101111011)
                expect
                (fp #b0 #b10110110 #b10011110101101010110111)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110111)
                expect
                (fp #b0 #b11010000 #b11111000101101001101101)))
; expect = 58365062204620800.0

(assert (= expect result))

(check-sat)
(exit)
