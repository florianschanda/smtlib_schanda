(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00110011 #b01001101101000101100101)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b11100110 #b10000110101011000000100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b00011010111010011110101)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b1 #b10000000 #b10000111111010010000101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000110 #b01011111110110010111111)
                expect
                (fp #b1 #b10010110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10010110 #b11111111111111111111111)
                expect
                (fp #b1 #b01110001 #b11110010111000010010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
