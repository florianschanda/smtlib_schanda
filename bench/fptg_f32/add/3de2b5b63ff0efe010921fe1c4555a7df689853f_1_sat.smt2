; Format: FLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00100000 #b11100110101000100100110)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b11010110 #b10110101000000111111111)))
; arg1 = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010000 #b10100110111010001001100)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b1 #b00110001 #b10010011011110100110000)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100111 #b00010001110010001001010)
                expect
                (fp #b1 #b00111111 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00111111 #b11111111111111111111111)
                expect
                (fp #b0 #b00110000 #b10111110001001101001000)))
; expect = -0.000000000000000000108420210786201907830216570154113764345993331517092883586883544921875

(assert (= expect result))

(check-sat)
(exit)
