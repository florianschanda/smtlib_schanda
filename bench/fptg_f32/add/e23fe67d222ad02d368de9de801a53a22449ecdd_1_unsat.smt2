; Format: FLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101011 #b01111000001111011000001)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b01111111 #b10100101011111110000101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01111101 #b11001011011001101010110)
                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b00010011 #b11000011110110110010011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111100 #b01110001011100111111101)
                expect
                (fp #b1 #b00110100 #b01101010000010011110010)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110010)
                expect
                (fp #b0 #b00100110 #b01100111110010100001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
