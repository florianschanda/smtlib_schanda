; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110011 #b10010001011001111001111)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b00111111 #b01111010101011101101000)))
; arg1 = 0.00000000000000000000000000801344552008936541742935047589268618360692185420557365205240785144269466400146484375

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100110 #b10111010011111001111000)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b10111100 #b00011010111000000011110)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000011 #b01110100110111001011110)
                expect
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                expect
                (fp #b0 #b10110001 #b10100111101011110001010)))
; expect = 2987951.0

(assert (= expect result))

(check-sat)
(exit)
