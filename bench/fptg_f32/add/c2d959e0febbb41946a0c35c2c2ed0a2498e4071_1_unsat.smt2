; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000011 #b00110010011001110001111)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b10010011 #b11011000110110000010011)))
; arg1 = 838177.0

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110000 #b11010111110000100011111)
                expect
                (fp #b0 #b10010011 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010011 #b10011001010001000010000)
                expect
                (fp #b0 #b11110110 #b01111001111100100101100)))
; expect = 1676354.0

(assert (not (= expect result)))

(check-sat)
(exit)
