(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101000 #b00001111011100000011110)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b00001100 #b01110111101010101101010)))
; arg1 = -0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b11001001 #b11100000010011011110101)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                expect
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                expect
                (fp #b1 #b00111101 #b00000001110011110010010)))
; expect = -340282346638528859811704183484516925440.0

(assert (= expect result))

(check-sat)
(exit)
