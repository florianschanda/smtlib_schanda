(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01100001 #b01001011110000011101110)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b11100011 #b10000010011111001000100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100010 #b11101000010100111101111)
                arg2
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                arg2
                (fp #b0 #b10010011 #b11011101001010011101110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011011 #b00111110000111010000101)
                expect
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                expect
                (fp #b0 #b11000000 #b00110000111000011001110)))

(assert (= expect result))

(check-sat)
(exit)
