; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01011011 #b10110101000001011000001)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11010100 #b11111101100101000010010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101110 #b01000100010110001110010)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b01110101 #b10100000000111001100010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b10010101111011001000110)
                expect
                (fp #b1 #b01111010 #b11010110110100100100000)))
(assert (fp.leq (fp #b1 #b01111010 #b11010110110100100100000)
                expect
                (fp #b0 #b01011111 #b10111111100111100101011)))

(assert (= expect result))

(check-sat)
(exit)
