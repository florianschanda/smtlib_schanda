(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01000111 #b10001000000110011100001)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11100001 #b00110001111000100111010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01010011 #b00000110110001111110001)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b01110111 #b01110011111111100010101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10011111 #b10000100000011011110001)
                expect
                (fp #b0 #b10111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111110)
                expect
                (fp #b0 #b11000110 #b01101010111101000100111)))

(assert (= expect result))

(check-sat)
(exit)
