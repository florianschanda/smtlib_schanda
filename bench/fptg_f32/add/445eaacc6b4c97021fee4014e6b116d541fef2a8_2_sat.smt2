(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001011 #b11100000101111000111111)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11001111 #b00111111111110111110111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000010 #b01110011101010100010000)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b11101001 #b10110101001010001110010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010010 #b11001010000010011100100)
                expect
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                expect
                (fp #b0 #b11011001 #b01110001001010010101110)))

(assert (= expect result))

(check-sat)
(exit)
