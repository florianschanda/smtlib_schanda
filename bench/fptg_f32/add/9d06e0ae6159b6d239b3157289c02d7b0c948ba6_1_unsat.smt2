; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111000 #b00111110010001110011101)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b0 #b11110000 #b01111010000110000110111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001001 #b00111010010100010011011)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11001111 #b10111010010011000001011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000000 #b11001101000111010111110)
                expect
                (fp #b0 #b10010011 #b10011000000010100111000)))
(assert (fp.leq (fp #b0 #b10010011 #b10011000000010100111000)
                expect
                (fp #b0 #b10010100 #b11001111001011010011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
