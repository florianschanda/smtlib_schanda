; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00000010 #b10001011001111100100100)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b10110001 #b10111101101011110110011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11001100010100000100110)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b1 #b00010010 #b11101001101001101010110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11100011010100100101100)
                expect
                (fp #b1 #b11100001 #b01011110011101100001110)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001110)
                expect
                (fp #b1 #b00011101 #b00010001110011111000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
