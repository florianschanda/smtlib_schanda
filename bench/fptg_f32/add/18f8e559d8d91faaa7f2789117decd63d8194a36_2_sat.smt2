(assert (fp.leq (fp #b1 #b10101011 #b01101001101101111100011)
                arg2
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b01101001 #b11100010001010000111001)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100101 #b11011011111110011001011)
                expect
                (fp #b0 #b00110100 #b01101010000010011110100)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110100)
                expect
                (fp #b0 #b10010100 #b00000000100011011100100)))
; expect = 0.000000000000000000000037433923820535783259808291603448933415609900521303643472492694854736328125

(assert (= expect result))

(check-sat)
(exit)
