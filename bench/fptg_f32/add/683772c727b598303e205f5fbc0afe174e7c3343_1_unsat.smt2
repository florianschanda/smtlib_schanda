(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b00001100010101011101111)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01010101 #b10010011000011100111000)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001110 #b01101101000000000001011)
                arg2
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b00100000 #b01100110100011011011010)))
; arg2 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010101 #b10011011011110101111001)
                expect
                (fp #b1 #b10010110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10010110 #b11111111111111111111111)
                expect
                (fp #b1 #b00010100 #b01011000100001100111111)))
; expect = -16777215.0

(assert (not (= expect result)))

(check-sat)
(exit)
