                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b00000000 #b01110001100001001011110)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101011 #b00111001010111011100011)
                expect
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                expect
                (fp #b0 #b10110010 #b10101100001101110100010)))
; expect = -1.8230993747711181640625

(assert (not (= expect result)))

(check-sat)
(exit)
