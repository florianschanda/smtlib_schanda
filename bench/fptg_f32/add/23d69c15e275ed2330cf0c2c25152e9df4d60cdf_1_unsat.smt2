(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001011 #b01111010110001001111000)
                arg1
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b01010000 #b00001111101000100010010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01110110 #b01111101001000100110000)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b10011100 #b00010101100100010101010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001111 #b10100000100011000000110)
                expect
                (fp #b0 #b00000000 #b10110001011000011011010)))
(assert (fp.leq (fp #b0 #b00000000 #b10110001011000011011010)
                expect
                (fp #b0 #b01110001 #b01111111110110110001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
