; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101110 #b01111000110010010101010)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b01001001 #b11101010100011011011000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110100 #b00001010010100001100001)
                arg2
                (fp #b0 #b00000000 #b00110101011010011001010)))
(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b11001011 #b11000100100010011110100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b10011100101000100110111)
                expect
                (fp #b0 #b00000000 #b10111100101011001011111)))
(assert (fp.leq (fp #b0 #b00000000 #b10111100101011001011111)
                expect
                (fp #b0 #b00101010 #b01011110100001100001100)))

(assert (= expect result))

(check-sat)
(exit)
