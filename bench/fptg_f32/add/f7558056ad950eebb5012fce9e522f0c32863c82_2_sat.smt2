(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111010 #b11011011101011000111111)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b0 #b01101001 #b10110111010111101001100)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000001 #b11010010011111100011000)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111110 #b10111000111100000000000)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10001001 #b00110110100101111000110)
                expect
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                expect
                (fp #b0 #b11111011 #b01000101001000101100001)))
; expect = 5645418813174416085171547869806592.0

(assert (= expect result))

(check-sat)
(exit)
