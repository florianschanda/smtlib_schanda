(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011000 #b00100101100010001001001)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00001011 #b11101111000011111010000)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01101110 #b11100101100110111011110)
                arg2
                (fp #b0 #b00000000 #b00110101011010011001010)))
(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b01010010 #b00100101011110010110100)))
; arg2 = 0.0000000000000000000000000000000000000024525777956336526842379881438065104314570774953872316810131125376930223691562815702127409167587757110595703125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b10011110111100010110010)
                expect
                (fp #b1 #b10010110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10010110 #b11111111111111111111111)
                expect
                (fp #b1 #b00100001 #b10011011010100001010011)))
; expect = -16777215.0

(assert (= expect result))

(check-sat)
(exit)
