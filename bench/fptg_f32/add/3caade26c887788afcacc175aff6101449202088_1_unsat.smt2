(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00111110 #b10011100001001001011101)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10001111 #b10111001110100101011011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b00011010111110010010011)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10011000 #b11011011100101000100111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101011 #b00100101101010000100011)
                expect
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                expect
                (fp #b0 #b11111101 #b01011110010101011001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
