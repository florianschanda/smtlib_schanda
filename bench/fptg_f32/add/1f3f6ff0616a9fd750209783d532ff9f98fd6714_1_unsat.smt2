; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000001 #b11110010000010101011111)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b0 #b10110000 #b00101001000101011000101)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00010001 #b10111010111110101110111)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11010001 #b11011000010110100010110)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10010001 #b11000111001110011001111)
                expect
                (fp #b0 #b10010011 #b00011000000011001110000)))
(assert (fp.leq (fp #b0 #b10010011 #b00011000000011001110000)
                expect
                (fp #b0 #b11110100 #b11000011010010000101110)))
; expect = 1147086.0

(assert (not (= expect result)))

(check-sat)
(exit)
