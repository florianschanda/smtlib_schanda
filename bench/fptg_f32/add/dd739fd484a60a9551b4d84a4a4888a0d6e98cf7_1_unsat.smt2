(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11001010 #b00001101010000100111100)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b1 #b00000110 #b01001010001010100100001)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110001 #b00101110101011010100101)
                expect
                (fp #b1 #b10010100 #b00001001011100110110011)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110011)
                expect
                (fp #b0 #b00110111 #b01111101110010101001001)))
; expect = -2174572.75

(assert (not (= expect result)))

(check-sat)
(exit)
