(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b01100000011110011100101)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11010010 #b10111000101110001011111)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101011 #b00010011110000111111000)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b11111011 #b11011000001110010011011)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011110 #b11000011001101001111100)
                expect
                (fp #b1 #b11011110 #b00010111011000011011001)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011001)
                expect
                (fp #b1 #b01100000 #b01110000000100000011101)))
; expect = -43232212062945922000504225792.0

(assert (not (= expect result)))

(check-sat)
(exit)
