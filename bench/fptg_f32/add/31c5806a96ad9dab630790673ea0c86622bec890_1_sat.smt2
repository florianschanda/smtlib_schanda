; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101011 #b01100000010111111010110)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b11010010 #b11110110101110111101001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001001 #b01011101100101001111011)
                arg2
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b00110101 #b10110000011110111101000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100001 #b11010100101100001000101)
                expect
                (fp #b0 #b00000000 #b11000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b11000111010000110010101)
                expect
                (fp #b0 #b11111001 #b11100111110100010100110)))

(assert (= expect result))

(check-sat)
(exit)
