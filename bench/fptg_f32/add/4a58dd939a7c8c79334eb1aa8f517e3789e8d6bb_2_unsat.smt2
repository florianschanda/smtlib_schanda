; Format: FLOAT32
; Arg1: -ONE
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
