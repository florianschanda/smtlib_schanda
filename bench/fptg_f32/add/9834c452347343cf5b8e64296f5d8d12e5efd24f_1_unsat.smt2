; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110100 #b10011010011111110100010)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b10011000 #b10001111101100010101000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110011 #b10111110101111010011010)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b10100010 #b10100101010101110111100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101010 #b01101011100001100110001)
                expect
                (fp #b1 #b00111111 #b11111111111111111111110)))
(assert (fp.leq (fp #b1 #b00111111 #b11111111111111111111110)
                expect
                (fp #b0 #b11000110 #b00011101101110011001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
