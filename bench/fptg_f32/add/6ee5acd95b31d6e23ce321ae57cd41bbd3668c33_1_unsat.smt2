; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b00111110100000101011101)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b1 #b10111000 #b01011111010110110000010)))
; arg1 = -1698008524581344716521472.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111010 #b01011111101000100110100)
                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b0 #b01010010 #b10011110100110010000111)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011100 #b00110001111100001001001)
                expect
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                expect
                (fp #b0 #b00011010 #b01001010110101111101100)))
; expect = -1698008524581344716521472.0

(assert (not (= expect result)))

(check-sat)
(exit)
