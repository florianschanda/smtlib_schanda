; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00111111 #b10110011010110101010000)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b11001010 #b10001010111001000000011)))
; arg1 = 2562247297597440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101001 #b00101111101101110001110)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b0 #b00101001 #b11001110101000001111110)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b11010010111000011111010)
                expect
                (fp #b1 #b11100001 #b01011110011101100001110)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001110)
                expect
                (fp #b0 #b01100100 #b00000100010001110001011)))
; expect = -433850155641787282585418727424.0

(assert (= expect result))

(check-sat)
(exit)
