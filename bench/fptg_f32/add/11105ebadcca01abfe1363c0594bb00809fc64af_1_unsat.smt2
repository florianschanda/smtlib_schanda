                (fp #b0 #b10001000 #b10011111111110101000000)))
; arg2 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000010 #b00111000000010111101110)
                expect
                (fp #b0 #b01111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b01111110 #b11111111111111111111111)
                expect
                (fp #b0 #b10111111 #b10000100111001110110001)))
; expect = 0.999999940395355224609375

(assert (not (= expect result)))

