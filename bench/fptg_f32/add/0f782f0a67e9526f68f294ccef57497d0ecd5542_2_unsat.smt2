(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b00110000110000110000100)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b0 #b00011011 #b10101111101101000010101)))
; arg1 = -1698008524581344716521472.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00011010 #b10000101110001001101110)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11011111 #b01100110110111011110011)))
; arg2 = 1.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100111 #b00011110010100100001101)
                expect
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                expect
                (fp #b1 #b01101011 #b00011100001001100011111)))
; expect = -1698008524581344716521472.0

(assert (not (= expect result)))

(check-sat)
(exit)
