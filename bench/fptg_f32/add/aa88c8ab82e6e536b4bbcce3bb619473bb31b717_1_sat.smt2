(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000101 #b11110010001000011000101)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b01001001 #b01000110010101011100101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01111001 #b00111011110100111011110)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b10101010 #b11000111010110000100100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b10011111101000000011001)
                expect
                (fp #b0 #b00000000 #b00111000101001001110000)))
(assert (fp.leq (fp #b0 #b00000000 #b00111000101001001110000)
                expect
                (fp #b0 #b11110110 #b11011111100100101011010)))

(assert (= expect result))

(check-sat)
(exit)
