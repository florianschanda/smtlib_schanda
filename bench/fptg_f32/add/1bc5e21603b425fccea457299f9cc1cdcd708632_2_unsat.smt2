                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10110000 #b01100111110101100010011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001110 #b00001110000101111010101)
                expect
                (fp #b0 #b01101011 #b11101001101001110111011)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111011)
                expect
                (fp #b0 #b10110111 #b01010110111011111010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
