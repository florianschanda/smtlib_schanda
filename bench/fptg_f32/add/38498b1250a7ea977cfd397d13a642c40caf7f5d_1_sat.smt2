(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010011 #b01100100000100010000001)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b11101011 #b10111011001011001000111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110100 #b11011100010001100000111)
                arg2
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                arg2
                (fp #b0 #b11110110 #b00110000001011011010110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000110 #b01011101100010000000101)
                expect
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                expect
                (fp #b0 #b10011010 #b00000010110011011101011)))

(assert (= expect result))

(check-sat)
(exit)
