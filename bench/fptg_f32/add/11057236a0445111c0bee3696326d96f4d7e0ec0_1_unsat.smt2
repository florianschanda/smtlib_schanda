; Format: FLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100000 #b11000001010000100011111)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b10101100 #b01000001011111101100000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101100 #b01110101101001111100100)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b1 #b11000011 #b01000001100000010010000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101011 #b10110110001110000110010)
                expect
                (fp #b1 #b11011110 #b00010111011000011010111)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011010111)
                expect
                (fp #b0 #b10010001 #b01001111100101011001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
