; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101110 #b01101101110110111010111)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b10111110 #b11010000100010110010110)))
; arg1 = -0.0000000000000000000000000000000000000078390906197842473151128329331162838047950527052918132227640646251414814627000993141336948610842227935791015625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01100011 #b00100110000100011010100)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10110010 #b00110111001101100000110)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010001 #b01000010010000110011001)
                expect
                (fp #b0 #b10010110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10010110 #b11111111111111111111111)
                expect
                (fp #b0 #b10100011 #b00111101001100111001000)))
; expect = 16777215.0

(assert (= expect result))

(check-sat)
(exit)
