(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001100 #b10010000000000101001010)
                arg1
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b00000000 #b10010111111111010001011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001100 #b10011100101000011001010)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b10101101 #b11101110101110100001010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000110 #b11001010101110001001110)
                expect
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                expect
                (fp #b0 #b11001101 #b01000010111001010111110)))

(assert (= expect result))

(check-sat)
(exit)
