; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01001011 #b11001011000000011011110)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b10110000 #b01011110111101001101100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111010 #b00000111010011110101110)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b01101101 #b00011101111101101010010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101101 #b01100110011001101100011)
                expect
                (fp #b0 #b01111111 #b11101000110101111010000)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111010000)
                expect
                (fp #b0 #b10111010 #b00110011000111010001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
