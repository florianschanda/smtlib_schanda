; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b01010000110100101001101)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b1 #b00001100 #b10110110111011000010010)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01110011 #b01001100110111011001000)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111110 #b01011001010110000011110)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b11011000 #b11001000010011001111010)
                expect
                (fp #b0 #b11111100 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111100 #b11111111111111111111111)
                expect
                (fp #b0 #b11111101 #b01110111110101010000111)))
; expect = 85070586659632214952926045871129231360.0

(assert (not (= expect result)))

(check-sat)
(exit)
