(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01110101 #b10110111100111001001110)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b10110101 #b11101111011000011011010)))
; arg1 = 2562247297597440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01001000 #b00001100100000010111000)
                arg2
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001000 #b01010011110011100100001)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001011 #b10111111010111100000010)
                expect
                (fp #b0 #b10110010 #b00100011010010110011100)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011100)
                expect
                (fp #b0 #b11010110 #b10110011110000011101010)))
; expect = 2562247566032896.0

(assert (= expect result))

(check-sat)
(exit)
