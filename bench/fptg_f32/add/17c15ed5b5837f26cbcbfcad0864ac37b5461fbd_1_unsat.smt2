; Format: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101110 #b00001110100110000010110)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11000100 #b00101000100000101000011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000000 #b01010011010011101011010)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11010100 #b11011100000001110010101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100010 #b10100100101000100100010)
                expect
                (fp #b0 #b10111111 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111 #b11111111111111111111111)
                expect
                (fp #b0 #b11010010 #b10111010001111111010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
