(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111011 #b10100000100000110011010)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00110110 #b10000111101100111001001)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001010 #b01100110101011100110010)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b10111010 #b11001101000011101100110)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101110 #b00111011000011001010110)
                expect
                (fp #b1 #b01111111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000001)
                expect
                (fp #b0 #b00111000 #b11011100010001001011011)))
; expect = -1.00000011920928955078125

(assert (= expect result))

(check-sat)
(exit)
