                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11110110 #b11110111010011011001111)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000011 #b00001101000011110101101)
                expect
                (fp #b0 #b10010101 #b00101010111110011011111)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011111)
                expect
                (fp #b0 #b11000001 #b01101110101111100010110)))
; expect = 4898415.5

(assert (not (= expect result)))

(check-sat)
(exit)
