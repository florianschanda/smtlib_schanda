; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100111 #b10101011000000101101101)
                arg1
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111111 #b00000010100001000110011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01110011 #b10010110001101110110010)
                arg2
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b01100111 #b00001111111110010111100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100100 #b11110010101100100101011)
                expect
                (fp #b0 #b01000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000001 #b00000000000000000000000)
                expect
                (fp #b0 #b11100100 #b11001111101011101011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
