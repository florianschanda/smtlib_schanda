; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111110 #b01001111100011001011011)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b11011101 #b00101010110111100111110)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100001 #b11000101001110110110000)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11100100 #b00110011110000111111010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001011 #b00100011100011010111000)
                expect
                (fp #b0 #b01111111 #b10100011000000110011000)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110011000)
                expect
                (fp #b0 #b10000110 #b10100000010110010111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
