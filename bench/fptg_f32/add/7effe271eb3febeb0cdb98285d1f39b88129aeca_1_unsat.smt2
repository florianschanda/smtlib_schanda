; Format: FLOAT32
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b10010111011100000111011)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01100101 #b10010101011111001011000)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00011010 #b00101111101100110000001)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11100100 #b00100100010101000111010)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101110 #b00010010001000101111100)
                expect
                (fp #b0 #b01111110 #b01000110000001100101110)))
(assert (fp.leq (fp #b0 #b01111110 #b01000110000001100101110)
                expect
                (fp #b0 #b10110011 #b01100100101100100011011)))
; expect = 0.63676726818084716796875

(assert (not (= expect result)))

(check-sat)
(exit)
