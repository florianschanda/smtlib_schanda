(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001111 #b11110111100101000011011)
                arg1
                (fp #b1 #b00101111 #b10100010101001001111101)))
(assert (fp.leq (fp #b1 #b00101111 #b10100010101001001111101)
                arg1
                (fp #b0 #b11100001 #b11010110011011011000000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001010 #b11000111110000110111011)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11001100 #b01010110010000010111010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001110 #b01101100010011010001011)
                expect
                (fp #b0 #b10111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111110)
                expect
                (fp #b0 #b11011100 #b00111110001100101100101)))

(assert (= expect result))

(check-sat)
(exit)
