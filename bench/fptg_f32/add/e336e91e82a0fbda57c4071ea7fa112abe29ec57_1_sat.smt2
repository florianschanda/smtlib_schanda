; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100110 #b01010011100000000010011)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b00010011 #b00100011110001110100011)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b01100001010010100110111)
                arg2
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                arg2
                (fp #b0 #b11110011 #b01100011110101010101011)))
; arg2 = 0.0000000000000000000016797691600640013028400516158743227546068510491750203073024749755859375

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010001 #b00110001111010010011110)
                expect
                (fp #b1 #b10010100 #b11001001111011010000011)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000011)
                expect
                (fp #b1 #b00001101 #b00111000010100101011100)))
; expect = -3751328.75

(assert (= expect result))

(check-sat)
(exit)
