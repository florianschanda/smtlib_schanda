                arg2
                (fp #b0 #b10000011 #b00110001000000011110000)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101110 #b01100101100100111100110)
                expect
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                expect
                (fp #b0 #b10010011 #b10000010000110110101010)))
; expect = 1.63676726818084716796875

(assert (not (= expect result)))

