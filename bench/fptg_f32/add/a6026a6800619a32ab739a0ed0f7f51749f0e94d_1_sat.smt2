; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00001101 #b01011101110110110100110)
                arg1
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b11000011 #b01011100011101100101010)))
; arg1 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110111 #b10111100000001000101111)
                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b10001101 #b11011000000111101011110)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011100 #b11010100110101100010000)
                expect
                (fp #b1 #b10111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111110)
                expect
                (fp #b1 #b00011000 #b10001010000100000001101)))
; expect = -18446741874686296064.0

(assert (= expect result))

(check-sat)
(exit)
