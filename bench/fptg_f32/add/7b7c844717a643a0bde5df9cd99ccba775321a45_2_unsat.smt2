(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b00111101100001111101100)
                arg1
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b01011100 #b11010111101000010011000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011010 #b10010101101000000111000)
                arg2
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                arg2
                (fp #b0 #b11000111 #b11001000101011010000000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101101 #b01111111101110100110001)
                expect
                (fp #b0 #b00111010 #b00000011011111110001010)))
(assert (fp.leq (fp #b0 #b00111010 #b00000011011111110001010)
                expect
                (fp #b0 #b11010111 #b00000110000101101011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
