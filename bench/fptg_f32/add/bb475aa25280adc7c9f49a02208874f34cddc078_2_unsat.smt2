(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101101 #b00001011010100000010101)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b11111101 #b11110001010010000001010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00100101 #b01011001101010110000101)
                arg2
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                arg2
                (fp #b0 #b11111001 #b01100001110010000100100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000000 #b10110110101000100000001)
                expect
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                expect
                (fp #b0 #b11011101 #b11000100101101100011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
