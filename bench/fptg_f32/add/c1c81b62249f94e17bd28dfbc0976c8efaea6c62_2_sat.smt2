;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00111000 #b10110100011110101110101)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11001010 #b11101001100011101101100)))
; arg1 = 18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110101 #b10111100010101010010111)
                arg2
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b11110101 #b10010101000001111001001)))
; arg2 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011000 #b10101101111111101000010)
                expect
                (fp #b0 #b10111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11110001 #b11000011000111010100111)))
; expect = 18446744073709551616.0

(assert (= expect result))

(check-sat)
(exit)
