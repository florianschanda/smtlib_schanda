;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100000 #b11010101011001100111011)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b00000001 #b00101100011111000001011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000111 #b00011101001000111000100)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b11111011 #b11110100110000011110111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000011 #b11000101000011010111110)
                expect
                (fp #b0 #b01101011 #b11101001101001110111001)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111001)
                expect
                (fp #b0 #b10101110 #b00100100100000001011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
