(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01000010 #b10001000111001001101010)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11101001 #b00001111010000011011010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111010 #b00101111100011001001100)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b1 #b01100111 #b01101110010010010000101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100010 #b11010001110100000001011)
                expect
                (fp #b0 #b10010110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10010110 #b11111111111111111111111)
                expect
                (fp #b0 #b10101000 #b00011001111001010010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
