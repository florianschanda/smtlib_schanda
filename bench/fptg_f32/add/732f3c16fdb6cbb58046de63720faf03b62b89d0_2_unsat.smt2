                (fp #b0 #b11001000 #b10011000101001010010100)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101110 #b11110101001111011000101)
                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b00000100 #b10101010010111101000000)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010110 #b00111010101100100001111)
                expect
                (fp #b1 #b10010011 #b01000001011100001000001)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000001)
                expect
                (fp #b0 #b11111011 #b00000111110111101101011)))
; expect = -1316616.125

(assert (not (= expect result)))

(check-sat)
(exit)
