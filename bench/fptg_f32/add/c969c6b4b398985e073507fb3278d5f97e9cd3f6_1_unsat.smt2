                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b10000000 #b11111010010101000000110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101111 #b00000111100011011101001)
                expect
                (fp #b0 #b01111111 #b10100011000000110010110)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010110)
                expect
                (fp #b0 #b10110111 #b10101110001001110010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
