(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01011000 #b01010100010110000011110)
                arg1
                (fp #b1 #b00100101 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b00100101 #b00100101010110111111100)
                arg1
                (fp #b0 #b00100011 #b00000101001111110011110)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b10101100101110011001011)
                arg2
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b01110110 #b10101010001111101100111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001100 #b10011011110111101011000)
                expect
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11100001 #b00001011110101111000000)))

(assert (= expect result))

(check-sat)
(exit)
