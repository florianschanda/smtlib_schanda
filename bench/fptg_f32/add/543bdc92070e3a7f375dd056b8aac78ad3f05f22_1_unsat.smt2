; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01011100 #b00100000011000000110011)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b11101000 #b00000000111110101000111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111100 #b01001101110100110101101)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10000001 #b00001011111111111000011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100101 #b00101111010000101010000)
                expect
                (fp #b1 #b00000000 #b10001000000111110000000)))
(assert (fp.leq (fp #b1 #b00000000 #b10001000000111110000000)
                expect
                (fp #b0 #b01100101 #b01110011110011100011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
