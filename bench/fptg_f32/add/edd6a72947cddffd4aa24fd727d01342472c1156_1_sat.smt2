; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011001 #b10111101101001110010100)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b0 #b10011000 #b10101011001111000010111)))
; arg1 = -14198738255872.0

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110101 #b01111111111100100000100)
                expect
                (fp #b1 #b10101011 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101011 #b10011101001111001101100)
                expect
                (fp #b1 #b01000111 #b01101010001011010111001)))
; expect = -28397476511744.0

(assert (= expect result))

(check-sat)
(exit)
