(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00110010 #b01011101001100001100001)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b11110101 #b11110010101001010011110)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000100 #b00000000111101111010101)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b01000110 #b10100110010000011001001)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011011 #b01110001000010110011011)
                expect
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                expect
                (fp #b1 #b01000010 #b01010010001000011001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
