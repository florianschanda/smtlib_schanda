(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010010 #b01011001000000100010101)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b11101001 #b00111011000001000011010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111011 #b00010000000111010111011)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b00001111 #b11001111010010011001010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011010 #b00100101001101001001010)
                expect
                (fp #b1 #b01111111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000001)
                expect
                (fp #b0 #b11100010 #b01111100110011001111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
