                arg2
                (fp #b0 #b11001101 #b00011111101001000010100)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010011 #b10100010000101100000011)
                expect
                (fp #b1 #b01111111 #b00001010011010000011100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000011100)
                expect
                (fp #b0 #b01010001 #b10001110001011111001110)))
; expect = -1.040652751922607421875

(assert (not (= expect result)))

