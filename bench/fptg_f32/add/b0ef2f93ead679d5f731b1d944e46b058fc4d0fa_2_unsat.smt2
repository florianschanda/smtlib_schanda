; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b10100110111001000010100)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11110011 #b10000000010101000101100)))
; arg1 = -18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111100 #b10011101100000110000100)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b11000010 #b10111011001100111010110)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111001 #b11010011110011111101001)
                expect
                (fp #b1 #b10111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b00000000000000000000000)
                expect
                (fp #b1 #b10101100 #b00000101000101001011000)))
; expect = -18446744073709551616.0

(assert (not (= expect result)))

(check-sat)
(exit)
