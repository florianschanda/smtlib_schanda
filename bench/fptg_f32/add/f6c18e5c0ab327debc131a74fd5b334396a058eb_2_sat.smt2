(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111100 #b00011100111011001110010)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b0 #b10110001 #b11110100000000000001100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100000 #b00011100100011100110110)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b00101001 #b01010000101001001010111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b10001000001010001101010)
                expect
                (fp #b1 #b01111111 #b00001010011010000101101)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101101)
                expect
                (fp #b0 #b01011110 #b10110001011110001000011)))

(assert (= expect result))

(check-sat)
(exit)
