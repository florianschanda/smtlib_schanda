; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110111 #b11110001110001110011111)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b0 #b01001001 #b10010010000000110011000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101010 #b00010000001100000110100)
                arg2
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                arg2
                (fp #b0 #b11001100 #b00101001010110100110100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b01101011001110010111010)
                expect
                (fp #b1 #b11001111 #b01100111100100010011100)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011100)
                expect
                (fp #b0 #b10101011 #b11001011111110001110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
