(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110110 #b00001111111111110111110)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b00110111 #b00010101001001111010010)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001110 #b01011000100010000011010)
                expect
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                expect
                (fp #b0 #b11000101 #b10111101001101110111110)))
; expect = -295579222016.0

(assert (= expect result))

(check-sat)
(exit)
