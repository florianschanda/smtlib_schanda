(assert (fp.leq (fp #b1 #b00011011 #b10001111111111111100110)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b10001111 #b10100000000111110001011)))
