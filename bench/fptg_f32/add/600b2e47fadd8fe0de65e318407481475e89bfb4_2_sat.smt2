                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b1 #b00011011 #b11111001101100100110100)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b11011101010000010111010)
                expect
                (fp #b1 #b10100001 #b00100111011010010000101)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000101)
                expect
                (fp #b1 #b10000100 #b00101111101111000010101)))
; expect = -19824650240.0

(assert (= expect result))

(check-sat)
(exit)
