; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b10101110001001000010111)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b10101101 #b00110110011001111010101)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100000 #b10011010010000100100110)
                expect
                (fp #b0 #b10000000 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b10000000 #b11000100000000000001001)
                expect
                (fp #b0 #b10000010 #b00110011000101101000110)))
; expect = 3.5312521457672119140625

(assert (not (= expect result)))

(check-sat)
(exit)
