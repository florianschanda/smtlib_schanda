; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010000 #b00010000000001101100100)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b10111100 #b00111111111110010100011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10101111 #b00101111001101010000100)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11111011 #b11010001001010001101110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110001 #b01001000110011101000100)
                expect
                (fp #b0 #b10110110 #b10110000111010100001111)))
(assert (fp.leq (fp #b0 #b10110110 #b10110000111010100001111)
                expect
                (fp #b0 #b11000000 #b10011100001101001000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
