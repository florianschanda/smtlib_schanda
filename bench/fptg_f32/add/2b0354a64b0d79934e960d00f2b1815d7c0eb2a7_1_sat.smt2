(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110100 #b01010011011010001011100)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b1 #b01100000 #b01010010010001011110100)))
; arg1 = -1.040654659271240234375

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01010001 #b00111001101001010001110)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10111010 #b10011011100010011011101)))
; arg2 = 1.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001001 #b00100011010100111110010)
                expect
                (fp #b1 #b01111010 #b01001101000010110000000)))
(assert (fp.leq (fp #b1 #b01111010 #b01001101000010110000000)
                expect
                (fp #b1 #b01010110 #b11001011100110101011011)))
; expect = -0.040654659271240234375

(assert (= expect result))

(check-sat)
(exit)
