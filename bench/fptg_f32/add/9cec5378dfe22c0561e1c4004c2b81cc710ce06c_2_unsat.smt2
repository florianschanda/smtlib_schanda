; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000011 #b11011000010011101010101)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b1 #b00000111 #b01000100010011111111111)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00100110 #b11111101101000010001110)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b10011111 #b10110001100101010101101)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100101 #b10101101110110011011000)
                expect
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                expect
                (fp #b0 #b11000001 #b10000011110110100100011)))
; expect = 494130912.0

(assert (not (= expect result)))

(check-sat)
(exit)
