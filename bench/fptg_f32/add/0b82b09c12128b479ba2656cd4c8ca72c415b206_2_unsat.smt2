(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010011 #b10110110111001101001100)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b1 #b00110101 #b00101100101100111001001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000011 #b10011001101100100110100)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b1 #b01001000 #b10111101111101101000000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b10110011001001100000011)
                expect
                (fp #b1 #b10110011 #b00000001110101100011010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001110101100011010)
                expect
                (fp #b1 #b00010111 #b01010000101001111000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
