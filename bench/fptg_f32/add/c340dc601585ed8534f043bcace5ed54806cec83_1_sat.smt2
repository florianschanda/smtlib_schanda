(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000001 #b10000010000000111000101)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b01110111 #b11111110101011000101011)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01001010 #b01001100000000111100110)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b01010000 #b10101110101011100000100)))
; arg2 = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100100 #b11111011100000010101100)
                expect
                (fp #b1 #b01111111 #b10011010110111110010101)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010101)
                expect
                (fp #b1 #b00010000 #b10010101111011001011000)))
; expect = -1.60496771335601806640625

(assert (= expect result))

(check-sat)
(exit)
