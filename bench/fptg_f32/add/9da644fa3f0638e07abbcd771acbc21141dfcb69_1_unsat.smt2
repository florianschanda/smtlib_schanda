                arg2
                (fp #b1 #b01110101 #b11110111111110010011101)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011111 #b10100000110001110100100)
                expect
