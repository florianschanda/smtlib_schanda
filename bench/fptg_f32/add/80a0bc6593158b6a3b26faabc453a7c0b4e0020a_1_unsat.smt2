; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10011110 #b10000101100001000010101)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b10101110 #b00101010011011011101010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101001 #b11111100000101011111101)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b01110000 #b11001001001100110011000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111000 #b01100001011101000010101)
                expect
                (fp #b1 #b10100100 #b10111110111001100101101)))
(assert (fp.leq (fp #b1 #b10100100 #b10111110111001100101101)
                expect
                (fp #b0 #b10101000 #b01101100001001101011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
