                arg2
                (fp #b1 #b00010001 #b10110000001101001100000)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101110 #b10101010110001101010111)
                expect
                (fp #b1 #b11011110 #b00010111011000011010111)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011010111)
                expect
                (fp #b1 #b10000101 #b01001111010010010100101)))
; expect = -43232202618212956261213798400.0

(assert (not (= expect result)))

