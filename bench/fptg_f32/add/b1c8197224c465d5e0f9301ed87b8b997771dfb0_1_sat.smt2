(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b11011011111101000011010)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b1 #b10101010 #b11010011000111101100011)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b11110010011101011011110)
                expect
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                expect
                (fp #b0 #b01101011 #b01100000110011000110111)))
; expect = -4521712578199552.0

(assert (= expect result))

(check-sat)
(exit)
