; Format: FLOAT32
; Arg1: -ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001110 #b00101011010001111000011)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01001101 #b10111011000010111000010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000001 #b01100010111100001000010)
                arg2
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b10000100 #b01001001011000100001111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001110 #b10101101001111011111111)
                expect
                (fp #b1 #b01111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b01111110 #b11111111111111111111111)
                expect
                (fp #b0 #b00000111 #b10011011101001100001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
