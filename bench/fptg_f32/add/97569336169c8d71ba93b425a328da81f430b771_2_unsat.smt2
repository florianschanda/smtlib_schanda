; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00111010 #b01011111110001011101101)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b10100010 #b11110100000100000011011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01101001 #b10001111101000000100011)
                arg2
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b11111110 #b01001000111011001110100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011111 #b11000100001100010100010)
                expect
                (fp #b0 #b01000110 #b00001000110000101011010)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000101011010)
                expect
                (fp #b0 #b01010110 #b11001010000011001101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
