; Format: FLOAT32
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001100 #b01001110001011101110100)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b00100101 #b10011111110010011010010)))
; arg1 = -0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b10001010010010110101100)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b01110010 #b00010011101011001100111)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001011 #b00001100111000110001110)
                expect
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                expect
                (fp #b0 #b11111001 #b01011110100111000111110)))
; expect = 0.000001824103719627601094543933868408203125

(assert (not (= expect result)))

(check-sat)
(exit)
