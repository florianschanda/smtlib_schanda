(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101110 #b00001111011000001111101)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11011110 #b11101010100101011111011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00011101 #b01010000110101100110001)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11111011 #b11111100000000001000111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011001 #b10011110000001110000100)
                expect
                (fp #b0 #b10010111 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000001)
                expect
                (fp #b0 #b11110001 #b00000001011010100001100)))

(assert (= expect result))

(check-sat)
(exit)
