(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b00110100 #b11001111001000110101010)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011101 #b00100100110111001001110)
                expect
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                expect
                (fp #b0 #b11110101 #b01010011011111100001000)))
; expect = -1.4478752613067626953125

(assert (= expect result))

(check-sat)
(exit)
