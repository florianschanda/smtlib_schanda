; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00000110 #b00110010011010111110101)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101111 #b01010010110001111001111)))
; arg1 = 11601303.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101001 #b10001111100101000001000)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b10010000 #b11000000101110011011100)))
; arg2 = -0.0000000000000000000000000000000000000059164194436288815055129368261491883180461313842729534869039744872745191506258066738155321218073368072509765625

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001101 #b10101010101011110001111)
                expect
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                expect
                (fp #b0 #b11110010 #b10010011000000001111100)))
; expect = 11601303.0

(assert (not (= expect result)))

(check-sat)
(exit)
