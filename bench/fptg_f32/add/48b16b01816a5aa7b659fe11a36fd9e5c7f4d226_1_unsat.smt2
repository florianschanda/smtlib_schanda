                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b1 #b10001000 #b00101011111010101110010)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b10111011001111100100110)
                expect
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                expect
                (fp #b1 #b11101110 #b10001100110110111010110)))
; expect = -85070591730234615865843651857942052864.0

(assert (not (= expect result)))

(check-sat)
(exit)
