(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01111011 #b00100000011000111000001)
                arg1
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                arg1
                (fp #b0 #b11100001 #b10110101101110111011000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110001 #b10000010110101110011010)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b01011010 #b01111011100011010000100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010001 #b11010001101001011101111)
                expect
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                expect
                (fp #b0 #b11010101 #b10100011011011111111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
