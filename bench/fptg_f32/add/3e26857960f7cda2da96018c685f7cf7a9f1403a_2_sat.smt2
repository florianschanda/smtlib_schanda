(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00001100 #b01111100111111000100111)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11100101 #b00100101000100101100010)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100010 #b01100101000010101001110)
                arg2
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b10101000 #b10101001010101100000100)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110001 #b11001001000110010101111)
                expect
                (fp #b0 #b01111111 #b11000100000000000001010)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001010)
                expect
                (fp #b0 #b11000011 #b10110001111101010000000)))
; expect = 1.7656261920928955078125

(assert (= expect result))

(check-sat)
(exit)
