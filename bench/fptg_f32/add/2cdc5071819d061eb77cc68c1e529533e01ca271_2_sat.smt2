(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011000 #b11000101101011110100010)
                arg1
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b01101100 #b11100010111010001010011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011000 #b10111101011001100101000)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10011001 #b11011110001010001000001)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b01000011110100111101101)
                expect
                (fp #b1 #b01111111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000001)
                expect
                (fp #b0 #b10001011 #b10100011101111000100101)))

(assert (= expect result))

(check-sat)
(exit)
