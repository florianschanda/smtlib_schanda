(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00011000 #b10011110010111010100011)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10110110 #b00111001111110111010010)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00011000 #b00011101111011000010111)
                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11111001 #b11011000000111000010110)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000011 #b11111111000010011000001)
                expect
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                expect
                (fp #b0 #b11010110 #b10111001111100110010100)))
; expect = 16971621252202496.0

(assert (= expect result))

(check-sat)
(exit)
