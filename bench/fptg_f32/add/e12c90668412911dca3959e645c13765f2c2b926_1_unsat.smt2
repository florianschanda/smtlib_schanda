                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b11000011 #b11100100101000111011011)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b00100111100010010001101)
                expect
                (fp #b0 #b10011011 #b11010101111110111111110)))
(assert (fp.leq (fp #b0 #b10011011 #b11010101111110111111110)
                expect
                (fp #b0 #b11011111 #b01010111010001110110010)))
; expect = 492814272.0

(assert (not (= expect result)))

(check-sat)
(exit)
