(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00011000 #b00101101010101001110100)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b11001001 #b10101111110010110000101)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01110000 #b01011111111000011000000)
                expect
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                expect
                (fp #b0 #b10110011 #b00100101100100110111010)))
; expect = 494130912.0

(assert (not (= expect result)))

(check-sat)
(exit)
