(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b01001000 #b00101100001100010110110)))
; arg2 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011011 #b00110100010001101111011)
                expect
                (fp #b1 #b10100001 #b00100111011010010000101)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000101)
                expect
                (fp #b0 #b00011101 #b00011011101101111001000)))
; expect = -19824650240.0

(assert (not (= expect result)))

(check-sat)
