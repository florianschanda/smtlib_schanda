(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b10011000011011010011110)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b0 #b00000000 #b10011011001000010010011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101000 #b10000100111000010100000)
                arg2
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b10100111 #b00000001111101000100011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010000 #b11111011100101001010111)
                expect
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                expect
                (fp #b0 #b11100100 #b11010000111111011111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
