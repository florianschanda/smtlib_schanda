(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011010 #b10101110001100011111100)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b01101110 #b11110110010001100000011)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101111 #b11000001001101000111110)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10100001 #b11100101010011000000011)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10001001 #b00001100111100100010010)
                expect
                (fp #b0 #b10010110 #b11111111111111111111110)))
(assert (fp.leq (fp #b0 #b10010110 #b11111111111111111111110)
                expect
                (fp #b0 #b11100011 #b00111000001011010101000)))
; expect = 16777214.0

(assert (= expect result))

(check-sat)
(exit)
