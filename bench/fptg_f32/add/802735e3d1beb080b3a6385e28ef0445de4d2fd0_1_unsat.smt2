; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00011010 #b11000000010010011101010)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b00011101 #b10111110100110111010000)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110110 #b11000110011101101000001)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b00011000 #b00100110010000010010010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010000 #b00110101100000101111010)
                expect
                (fp #b1 #b00000000 #b10101010111100100111010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010111100100111010)
                expect
                (fp #b0 #b10000111 #b11101010000101100010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
