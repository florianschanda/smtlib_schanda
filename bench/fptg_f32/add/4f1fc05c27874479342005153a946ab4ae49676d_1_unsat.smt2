; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011011 #b00110100010001010010011)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b01001100 #b01101110100100010111111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010001 #b11101010000111100010110)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b01011111 #b11000100101001010000111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001001 #b01011001110110001010000)
                expect
                (fp #b0 #b00101000 #b00111101011100011111110)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111110)
                expect
                (fp #b0 #b10001111 #b10001110110010000011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
