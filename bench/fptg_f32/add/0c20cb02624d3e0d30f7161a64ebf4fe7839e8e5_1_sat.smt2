(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01001001 #b10111001110001000010100)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b10000100 #b00010101001101111001111)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b01101100010100010000111)
                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b10111000 #b11110100110010010111001)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001010 #b01000101001001001010011)
                expect
                (fp #b1 #b10111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111110)
                expect
                (fp #b0 #b11010000 #b10101011011100011001001)))

(assert (= expect result))

(check-sat)
(exit)
