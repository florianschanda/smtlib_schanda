(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10110000 #b01111010101100000100001)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b01100101 #b01010110001001000010101)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b01100111101011110010001)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b0 #b10011010 #b00111010101110011100010)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b00011100010101100101101)
                expect
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                expect
                (fp #b1 #b01000110 #b00011000110001110001001)))
; expect = -433850193420719145542580436992.0

(assert (= expect result))

(check-sat)
(exit)
