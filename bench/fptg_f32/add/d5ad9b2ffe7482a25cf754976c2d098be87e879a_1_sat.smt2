                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b1 #b00011110 #b01001100000110011111011)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000110 #b00010111111101101100111)
                expect
                (fp #b1 #b01111111 #b01110010101001111111001)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111001)
                expect
                (fp #b0 #b00011111 #b11000001110000001110111)))
; expect = -1.44787514209747314453125

(assert (= expect result))

(check-sat)
(exit)
