; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101100 #b10011101101111110010011)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b1 #b00101100 #b00000000011011001001011)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01101001 #b10101010101110100110111)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b10010011 #b10100101101101000000101)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001010 #b10100010000111101001111)
                expect
                (fp #b0 #b01111010 #b00000100100000000100000)))
(assert (fp.leq (fp #b0 #b01111010 #b00000100100000000100000)
                expect
                (fp #b0 #b11101100 #b01101000101101101110001)))
; expect = 0.03179943561553955078125

(assert (= expect result))

(check-sat)
(exit)
