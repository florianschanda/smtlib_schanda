(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01010101 #b11011111001010011111111)
                arg1
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10101001 #b00110000000110001100010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101111 #b11010110001100000111000)
                arg2
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                arg2
                (fp #b0 #b01011001 #b10101001101111001110111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111011 #b01011100110000000011000)
                expect
                (fp #b0 #b01000000 #b00000011111101110101110)))
(assert (fp.leq (fp #b0 #b01000000 #b00000011111101110101110)
                expect
                (fp #b0 #b10001010 #b00010010000110101110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
