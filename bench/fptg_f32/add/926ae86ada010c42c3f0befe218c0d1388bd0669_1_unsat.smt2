                arg2
                (fp #b1 #b00110110 #b10011110100101111111001)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100010 #b11000000001111100011001)
                expect
                (fp #b1 #b10110011 #b00000001000001111001001)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001001)
                expect
                (fp #b1 #b01000111 #b11011000000100111110111)))

(assert (not (= expect result)))

(check-sat)
