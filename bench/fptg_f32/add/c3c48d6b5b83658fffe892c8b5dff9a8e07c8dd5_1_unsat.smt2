(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01111101 #b11101001001110101100011)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11101011 #b10001000010010010111010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01001110 #b11001111110101000100101)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b01111001 #b10000000110101010111111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111110 #b10000100100010010000001)
                expect
                (fp #b0 #b01111111 #b00000000000000000001111)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000001111)
                expect
                (fp #b0 #b11100011 #b00110111111101011001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
