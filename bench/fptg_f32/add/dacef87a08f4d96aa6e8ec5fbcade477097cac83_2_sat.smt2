(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001000 #b11000000100110000100101)
                arg1
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b10000010 #b00111111011111110011110)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111001 #b01100010001101100101111)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111001 #b10101011001111110111111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100011 #b01101111000010011101101)
                expect
                (fp #b0 #b11101111 #b00010110010101110011011)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011011)
                expect
                (fp #b0 #b11111000 #b00010100000000000110110)))

(assert (= expect result))

(check-sat)
(exit)
