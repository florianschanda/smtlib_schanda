                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11010001 #b11100010010101101101101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110000 #b10000110101010110010000)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11110010 #b00111000011100100110000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111110 #b00011110111110001011010)
                expect
                (fp #b0 #b11101111 #b00010110010101110011011)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011011)
                expect
                (fp #b0 #b11110011 #b00110000011110000010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
