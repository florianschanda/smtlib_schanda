(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001110 #b00010101110000110101010)
                arg1
                (fp #b1 #b00101111 #b10100010101001001111101)))
(assert (fp.leq (fp #b1 #b00101111 #b10100010101001001111101)
                arg1
                (fp #b0 #b10000110 #b11100111011000110000001)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01010111 #b01010101000101101000111)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b10010110 #b10100111001110011110110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001110 #b00111101011101111001111)
                expect
                (fp #b1 #b00101111 #b10100010101001001111100)))
(assert (fp.leq (fp #b1 #b00101111 #b10100010101001001111100)
                expect
                (fp #b0 #b00111010 #b10000011111101100101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
