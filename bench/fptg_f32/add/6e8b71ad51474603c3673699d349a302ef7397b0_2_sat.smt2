(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +ONE
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01011101 #b11110111100000011000110)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10010000 #b11111111001101000101110)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00000000 #b10000110111101101110001)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001011 #b01100010101111000111011)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10001101 #b01111011011001100111111)
                expect
                (fp #b0 #b10010111 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000001)
                expect
                (fp #b0 #b11001011 #b01011110111011110111000)))
; expect = 16777218.0

(assert (= expect result))

(check-sat)
(exit)
