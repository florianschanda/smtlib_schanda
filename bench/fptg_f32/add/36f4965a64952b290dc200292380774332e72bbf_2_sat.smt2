(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00001010 #b11100110000110100001001)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11010011 #b01000101010001100000110)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00010011 #b11111110101010101011001)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10111001 #b00011010101101100110100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010010 #b01111010111111100000110)
                expect
                (fp #b0 #b10111110 #b01100110010000010010100)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010100)
                expect
                (fp #b0 #b11111011 #b00011100010111000001011)))

(assert (= expect result))

(check-sat)
(exit)
