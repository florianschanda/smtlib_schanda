(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b10010111 #b01101111000011011110111)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011110 #b11011000000011111101001)
                expect
                (fp #b1 #b01000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000001)
                expect
                (fp #b0 #b00010000 #b10101000101011001001111)))
; expect = -0.00000000000000000010842023017324751454180269995275498473574771196581423282623291015625

(assert (= expect result))

(check-sat)
(exit)
