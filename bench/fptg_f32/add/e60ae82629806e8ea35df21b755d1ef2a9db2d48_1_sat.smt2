(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000100 #b10001010001111000101111)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b11111110 #b11010110010011111111110)))
; arg1 = 0.00000000000000000000000000000000000000976888739863070481951837620501440851507153415828511504132353945523202336242984955561041715554893016815185546875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00110110110111011101111)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b11010110 #b11110001100010000000000)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101110 #b10011101101101110110110)
                expect
                (fp #b1 #b10110011 #b00000001000001111001001)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001001)
                expect
                (fp #b1 #b10001101 #b01110000111000100000101)))
; expect = -4521712041328640.0

(assert (= expect result))

(check-sat)
(exit)
