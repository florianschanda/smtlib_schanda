(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00011000 #b11010100011011100110010)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b10110001 #b10111110011100100010010)))
; arg1 = 838177.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101101 #b11010010100100011111011)
                arg2
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b10111010 #b00101111001000110010001)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010011 #b11101100010111101110000)
                expect
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                expect
                (fp #b0 #b11111101 #b01110110000010101111110)))
; expect = 838177.0

(assert (not (= expect result)))

(check-sat)
(exit)
