(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00011111 #b01110100101010000001000)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b10101000 #b10001100000110001100101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001100 #b01110110101000001101100)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b11100101 #b10000111110001000010011)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110010 #b10001101000010101110011)
                expect
                (fp #b0 #b01111111 #b11000100000000000011000)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000011000)
                expect
                (fp #b0 #b10001111 #b10011011000110000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
