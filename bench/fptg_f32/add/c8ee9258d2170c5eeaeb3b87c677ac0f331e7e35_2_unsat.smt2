; Format: FLOAT32
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000010 #b00110110111101011010100)
                arg1
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b01001101 #b00011100010110100000001)))
; arg1 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011010 #b10111101110110010001000)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b1 #b10011101 #b00101101110100010101110)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b10110110110101010010110)
                expect
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                expect
                (fp #b1 #b01111001 #b10001001010111001110000)))
; expect = -4521712578199552.0

(assert (not (= expect result)))

(check-sat)
(exit)
