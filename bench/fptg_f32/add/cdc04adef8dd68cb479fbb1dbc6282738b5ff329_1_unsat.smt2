(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SMALLEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101110 #b10101010111000110110100)
                arg1
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b00000110 #b00000011011110100101101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01011000 #b11111011001001110101011)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b11101010 #b01100011010111001110100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011111 #b01110110011000010100011)
                expect
                (fp #b1 #b00000001 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000001)
                expect
                (fp #b0 #b10111100 #b11010001001111111010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
