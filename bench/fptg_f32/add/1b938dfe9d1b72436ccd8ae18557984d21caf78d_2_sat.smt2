(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010001 #b10000100001011000110101)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b01011110 #b00110101110110101101101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110001 #b10110100111101011011101)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b11011010 #b11010000011110101011100)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011010 #b00111001010100111010010)
                expect
                (fp #b0 #b00101000 #b00110011110001000010100)))
(assert (fp.leq (fp #b0 #b00101000 #b00110011110001000010100)
                expect
                (fp #b0 #b11100110 #b11001110100101001010110)))

(assert (= expect result))

(check-sat)
(exit)
