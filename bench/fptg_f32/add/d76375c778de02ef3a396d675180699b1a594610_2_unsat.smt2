(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101000 #b00001110010001001110101)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b11011101 #b11001001010101001011110)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01001010 #b01111000111000001110001)
                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b10000000 #b00110011110000010011111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110001 #b11011110111011110110010)
                expect
                (fp #b1 #b00110100 #b01101010000010011110100)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110100)
                expect
                (fp #b0 #b10011011 #b10010110110001101100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
