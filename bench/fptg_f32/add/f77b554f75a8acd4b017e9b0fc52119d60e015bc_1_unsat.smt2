(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01110111 #b11010011011010010010100)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111101 #b11000111000100000001010)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100010 #b00100100010111100000100)
                arg2
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b00101000 #b00111100001100100010011)))
; arg2 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011010 #b00010010010111110100010)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11011101 #b10011000111101011010010)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
