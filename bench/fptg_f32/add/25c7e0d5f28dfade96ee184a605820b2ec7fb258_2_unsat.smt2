                arg2
                (fp #b0 #b11100000 #b11101010001101110011101)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101110 #b00000100001111010110010)
                expect
                (fp #b1 #b11100001 #b01011110011101100010000)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100010000)
                expect
                (fp #b0 #b00011100 #b10001101111111110100101)))
; expect = -433850231199651008499742146560.0

(assert (not (= expect result)))

