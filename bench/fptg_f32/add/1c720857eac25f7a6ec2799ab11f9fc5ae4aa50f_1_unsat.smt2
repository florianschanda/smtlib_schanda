; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00111110 #b11000111010001111000100)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b00111110 #b11000011000001110000010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11001111 #b00010010101111101000000)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b11111001 #b01011100011101011000110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100001 #b01100001110110110001110)
                expect
                (fp #b1 #b01111111 #b11010010101101101010001)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010001)
                expect
                (fp #b0 #b00010010 #b11111000000000000101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
