(assert (fp.leq (fp #b0 #b01000110 #b11100001000011010111000)
                expect
                (fp #b0 #b10111110 #b01100110010000010010100)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010100)
                expect
