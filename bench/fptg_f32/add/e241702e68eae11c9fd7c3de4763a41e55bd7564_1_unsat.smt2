(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b11100000111000100101011)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11000101 #b01101111110010000011101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00100010 #b01111111010000110001100)
                arg2
                (fp #b0 #b00000000 #b00110101011010011001010)))
(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b00111011 #b00111101001010101101101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111010 #b00111111000000000100001)
                expect
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                expect
                (fp #b0 #b10011111 #b10101100011100010111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
