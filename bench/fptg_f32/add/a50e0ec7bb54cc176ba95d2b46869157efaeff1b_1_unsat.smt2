(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010010 #b01011101011100110000001)
                arg1
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b01111000 #b10101111000000011001101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110001 #b00111110011110000110001)
                arg2
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b10010010 #b11100111010110110101000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001110 #b11010000011001010001011)
                expect
                (fp #b0 #b00111111 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00111111 #b11111111111111111111111)
                expect
                (fp #b0 #b10110010 #b11111011100111000001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
