; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011000 #b00000001111110110001011)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b11100111 #b00001110000111001011110)))
; arg1 = 0.00000000000000000000000000000000000000621094295356220723266261538623547960060248555895461769529610334211419155059363816917539224959909915924072265625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b01100001010010110100100)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b10110000 #b11111111100110111011111)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b11111010111001100011100)
                expect
                (fp #b1 #b11011110 #b00010111011000011010111)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011010111)
                expect
                (fp #b1 #b01001001 #b00101000101010011000000)))
; expect = -43232202618212956261213798400.0

(assert (= expect result))

(check-sat)
(exit)
