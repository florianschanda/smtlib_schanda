; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00000001 #b00000010110101011100001)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10101000 #b10101010100000011011011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111111 #b01011010001011100101110)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11011111 #b10010010001001100110000)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01110011 #b01011011100111010001010)
                expect
                (fp #b0 #b10010111 #b00101101100101111010111)))
(assert (fp.leq (fp #b0 #b10010111 #b00101101100101111010111)
                expect
                (fp #b0 #b10110110 #b11110011001001001101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
