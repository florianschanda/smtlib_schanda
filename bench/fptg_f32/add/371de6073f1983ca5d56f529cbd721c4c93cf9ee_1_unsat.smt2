                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11010001 #b00111100001111100100110)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101101 #b10010100000011011010100)
                expect
                (fp #b0 #b10110100 #b11100010010111001100101)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100101)
                expect
                (fp #b0 #b11110011 #b01101101110100010100011)))
; expect = 16971620178460672.0

(assert (not (= expect result)))

(check-sat)
(exit)
