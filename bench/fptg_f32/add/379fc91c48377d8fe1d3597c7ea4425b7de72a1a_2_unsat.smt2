; Format: FLOAT32
; Arg1: -ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000001 #b01000101001100110000001)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10010000 #b11111101010011110000000)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000101 #b01010001010010110011101)
                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b00110011 #b01110100010000011100001)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b10001000010110100101110)
                expect
                (fp #b1 #b10111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b00000000000000000000000)
                expect
                (fp #b1 #b10110011 #b10100010011100001010001)))
; expect = -18446744073709551616.0

(assert (not (= expect result)))

(check-sat)
(exit)
