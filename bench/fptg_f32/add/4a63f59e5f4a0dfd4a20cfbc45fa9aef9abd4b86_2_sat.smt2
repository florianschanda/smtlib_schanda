(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000100 #b00110010011110010001000)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111110 #b10101011101011100000110)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111101 #b00010010000101111111000)
                expect
                (fp #b1 #b01000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000001)
                expect
                (fp #b0 #b11011100 #b01111110111011001000101)))
; expect = -0.00000000000000000010842023017324751454180269995275498473574771196581423282623291015625

(assert (= expect result))

(check-sat)
(exit)
