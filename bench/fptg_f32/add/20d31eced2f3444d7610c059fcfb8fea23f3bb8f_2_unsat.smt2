(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000001 #b00011001110000000101111)
                arg1
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b11111110 #b10000110110101110010100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01000000 #b10001110100110111011111)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11000001 #b11110100010010001000010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100101 #b10000101000110111100111)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11001110 #b10011010101000101000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
