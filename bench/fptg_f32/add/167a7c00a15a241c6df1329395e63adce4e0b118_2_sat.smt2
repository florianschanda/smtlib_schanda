(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100001 #b11000101001110110110000)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11100100 #b00110011110000111111010)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001011 #b00100011100011010111000)
                expect
                (fp #b0 #b01111111 #b10100011000000110011000)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110011000)
                expect
                (fp #b0 #b10000110 #b10100000010110010111110)))
; expect = 1.63676738739013671875

(assert (= expect result))

(check-sat)
(exit)
