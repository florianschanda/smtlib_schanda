(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11110111 #b01111111011110000000011)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100100 #b00101110010011011111001)
                expect
                (fp #b0 #b11111101 #b00000000000001000101100)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000001000101100)
                expect
                (fp #b0 #b11111101 #b01011011000111000011000)))
; expect = 85076230240104431030221509193799565312.0

(assert (= expect result))

(check-sat)
