                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b11000010 #b00010001000111101010000)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10000011 #b11011110110000101000110)
                expect
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                expect
                (fp #b0 #b11000001 #b01100101111010000010110)))
; expect = 18446742974197923840.0

(assert (= expect result))

(check-sat)
(exit)
