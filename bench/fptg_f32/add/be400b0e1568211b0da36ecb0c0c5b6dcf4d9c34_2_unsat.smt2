(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00111011 #b00101111001111001100001)
                arg1
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b10110101 #b10011111110111110111010)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01000001 #b01110110111010100001110)
                arg2
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b00111001 #b11010011101000011011010)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b10110110100001111011000)
                expect
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                expect
                (fp #b0 #b01010110 #b01001010011001101100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
