(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b11101111 #b11000100111011010100100)))
; arg2 = 0.0000000000000000000000000000000000000024525777956336526842379881438065104314570774953872316810131125376930223691562815702127409167587757110595703125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b11000011 #b00100001011111001100111)
                expect
                (fp #b0 #b11010011 #b00101010100100100100110)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100110)
                expect
                (fp #b0 #b11011000 #b11111000011111101101100)))
; expect = 22559422606513004011847680.0

(assert (not (= expect result)))

(check-sat)
(exit)
