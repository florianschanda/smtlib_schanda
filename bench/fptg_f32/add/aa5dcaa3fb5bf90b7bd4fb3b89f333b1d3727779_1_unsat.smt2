(assert (fp.leq (fp #b0 #b00110101 #b01001110110111100010001)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11010101 #b01111000010111010011010)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b10101010001100110000100)
                expect
                (fp #b0 #b10010101 #b00101010111110011011101)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011101)
                expect
                (fp #b0 #b10011110 #b10111110000110100100000)))
; expect = 4898414.5

(assert (not (= expect result)))

(check-sat)
(exit)
