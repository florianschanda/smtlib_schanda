(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01110101 #b10110011000011110001001)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111011 #b11000110101101100110010)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01110001 #b10011110011000001101100)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11010111 #b01110101011111101011111)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001101 #b10001101000101100100001)
                expect
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                expect
                (fp #b0 #b11101100 #b00001011010001101100000)))
; expect = 18446742974197923840.0

(assert (= expect result))

(check-sat)
(exit)
