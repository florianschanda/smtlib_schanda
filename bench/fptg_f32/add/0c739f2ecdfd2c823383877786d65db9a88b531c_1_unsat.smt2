(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111011 #b11100110010010111101101)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b01101111 #b11110101001101111000011)))

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011101 #b11100010000111011100010)
                expect
                (fp #b0 #b00000001 #b10101001011111101011110)))
(assert (fp.leq (fp #b0 #b00000001 #b10101001011111101011110)
                expect
                (fp #b0 #b11011100 #b00111011000001110010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
