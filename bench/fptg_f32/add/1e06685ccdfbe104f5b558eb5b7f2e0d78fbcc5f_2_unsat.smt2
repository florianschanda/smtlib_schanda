(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b10010010111011011010110)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b00111101 #b01010110011010010001011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100011 #b00101001111011110111101)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11100001 #b01110001001100000101101)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110111 #b11101100000010001011000)
                expect
                (fp #b1 #b10100001 #b00100111011010010000101)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000101)
                expect
                (fp #b1 #b00110110 #b00100011101110101011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
