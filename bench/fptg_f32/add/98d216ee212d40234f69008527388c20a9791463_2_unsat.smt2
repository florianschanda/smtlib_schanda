(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100001 #b00010011000000111001000)
                arg1
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b11011010 #b00111110110111110100011)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000010 #b00111101110110010000010)
                arg2
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b01100111 #b01001010111011111111111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110011 #b01011101000011011010001)
                expect
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                expect
                (fp #b0 #b01011000 #b00101010110000111000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
