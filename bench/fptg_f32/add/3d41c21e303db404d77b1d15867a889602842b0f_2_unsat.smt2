(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11010101 #b00110101100111001100110)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011100 #b01111110000100000110001)
                expect
                (fp #b0 #b11010011 #b00101010100100100100110)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100110)
                expect
                (fp #b0 #b11111110 #b00110011101111110001111)))
; expect = 22559422606513004011847680.0

(assert (not (= expect result)))

