(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011000 #b11100100010010100100011)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b10101100 #b11101000010101100000100)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000001 #b00011101011010010110100)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b11010000 #b10111101001011101001110)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001011 #b01001010011011110100011)
                expect
                (fp #b0 #b00000000 #b11010100101111110101110)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101110)
                expect
                (fp #b0 #b10100110 #b00111001010001011100001)))

(assert (= expect result))

(check-sat)
(exit)
