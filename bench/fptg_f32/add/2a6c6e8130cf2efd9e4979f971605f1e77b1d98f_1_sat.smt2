(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b11101011001110001101101)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b0 #b00010100 #b10011011101011000101011)))
; arg1 = -14198738255872.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100000 #b00100110101011110110011)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001010 #b01000100111100111111001)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100000 #b11111000101100100000000)
                expect
                (fp #b1 #b10101010 #b10011101001111001111100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001111100)
                expect
                (fp #b0 #b11110111 #b10010010001110101100101)))
; expect = -14198755033088.0

(assert (= expect result))

(check-sat)
(exit)
