(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01001111011101111010000)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b1 #b00110111 #b01101111000101011001110)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111100 #b11111101111100001001000)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b1 #b00110100 #b10011101011001100001001)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00001000011010100111101)
                expect
                (fp #b1 #b11111101 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000001)
                expect
                (fp #b0 #b10001110 #b11000111010000000011010)))
; expect = -85070601871439417691678863831567695872.0

(assert (= expect result))

(check-sat)
(exit)
