(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010111 #b10111011110110010000001)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b11110001 #b11011101101001000000101)))

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010000 #b10111000111000101010100)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111000 #b11100100110010111010111)))

(declare-const result Float32)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111001 #b00001110001101110111011)
                expect
                (fp #b0 #b11101111 #b00010110010101110011001)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011001)
                expect
                (fp #b0 #b11111001 #b01000000101110101001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
