(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00111101 #b10111100000011111101101)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11011011 #b00011001010110101101000)))
; arg1 = 11601303.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110010 #b11100000111010000101101)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b0 #b00111001 #b00011111111111001010001)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111010 #b01101011010000100100000)
                expect
                (fp #b1 #b11111000 #b11100100101011101010010)))
(assert (fp.leq (fp #b1 #b11111000 #b11100100101011101010010)
                expect
                (fp #b1 #b00100101 #b01000000110111111011110)))
; expect = -5033227624441088604427784772548296704.0

(assert (= expect result))

(check-sat)
(exit)
