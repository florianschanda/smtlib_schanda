                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b01110011 #b01000000100000110110100)))
; arg2 = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001000 #b10101010010110110110011)
                expect
                (fp #b0 #b00111110 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b00111110 #b00101010100100100100101)
                expect
                (fp #b0 #b10010101 #b00100010000000100100000)))
; expect = 0.0000000000000000000316124810233869667053417597431252961115433208760805428028106689453125

(assert (= expect result))

(check-sat)
