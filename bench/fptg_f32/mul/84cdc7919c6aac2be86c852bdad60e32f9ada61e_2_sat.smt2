; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01110100 #b00111101100101010101001)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b01010101 #b10111011010111100101111)))
; arg1 = -0.00000000000000000000000000000000000000193308562634222785007100126523010614343659622777088600107578866935283123940081395630841143429279327392578125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010111 #b01101111001010000101110)
                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b0 #b11000000 #b00001000000100100110011)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010110 #b00101111010100001110010)
                expect
                (fp #b0 #b00010100 #b00101001001100100101000)))
(assert (fp.leq (fp #b0 #b00010100 #b00101001001100100101000)
                expect
                (fp #b0 #b00101110 #b11100001000011100110011)))
; expect = 0.0000000000000000000000000000000071547462832996728116898922764088622089259224978656363271023455041586203151382505893707275390625

(assert (= expect result))

(check-sat)
(exit)
