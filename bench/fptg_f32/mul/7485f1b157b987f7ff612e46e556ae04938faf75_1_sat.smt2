(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01100101 #b11110101010010000110001)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10110001 #b11011110000010010000000)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000111 #b01110100011111010001000)
                expect
                (fp #b1 #b00010111 #b00101010111110011011100)))
(assert (fp.leq (fp #b1 #b00010111 #b00101010111110011011100)
                expect
                (fp #b0 #b00001001 #b00101011111101011001110)))
; expect = -0.00000000000000000000000000000005758057984988804641059170616240969339666440824610188324583770480558087001554667949676513671875

(assert (= expect result))

(check-sat)
(exit)
