                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b10100001 #b00101110010110001010001)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111100 #b11011011101011101000010)
                expect
                (fp #b1 #b01101100 #b00011100101100101100110)))
(assert (fp.leq (fp #b1 #b01101100 #b00011100101100101100110)
                expect
                (fp #b1 #b00011010 #b01000100000010000000111)))
; expect = -0.00000212116856346256099641323089599609375

(assert (= expect result))

(check-sat)
(exit)
