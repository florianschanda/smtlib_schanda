; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011111 #b11001110100111011110011)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11011101 #b11011011110010100010111)))
; arg1 = 12907478160253124608.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10000010 #b11000110111000000110001)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111010 #b10001100011010010001110)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101000 #b01011110111001011100011)
                expect
                (fp #b0 #b11010110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b11010110 #b01100110010000010010011)
                expect
                (fp #b0 #b11110111 #b01111101010010101111001)))
; expect = 216551549109849286223331328.0

(assert (= expect result))

(check-sat)
(exit)
