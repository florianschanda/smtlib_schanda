                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11001101 #b01100010011000011000001)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b11110101001101011010011)
                expect
                (fp #b1 #b11010111 #b00010110010011110110110)))
(assert (fp.leq (fp #b1 #b11010111 #b00010110010011110110110)
                expect
                (fp #b1 #b10101110 #b10001000000111011011101)))
; expect = -336456437053373573171773440.0

(assert (not (= expect result)))

(check-sat)
(exit)
