(assert (fp.leq (fp #b1 #b01110110 #b00000000000001011000110)
                arg2
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b01101011 #b11000100010010101110100)))
; arg2 = 0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110010 #b11111101111110010110101)
                expect
                (fp #b0 #b01110011 #b11111010101001011111100)))
(assert (fp.leq (fp #b0 #b01110011 #b11111010101001011111100)
                expect
                (fp #b0 #b11011111 #b00001100101001100111011)))
; expect = 0.000483177485875785350799560546875

(assert (= expect result))

(check-sat)
(exit)
