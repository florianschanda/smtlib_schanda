; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001100 #b10011110010001000001010)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b10000000 #b11000100101101101010111)))
; arg1 = -19824648192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11001110 #b01000101110011100101100)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11000011 #b10010111010100011000011)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110010 #b01001110110000101001011)
                expect
                (fp #b1 #b11100001 #b00100111011010010000011)))
(assert (fp.leq (fp #b1 #b11100001 #b00100111011010010000011)
                expect
                (fp #b1 #b11000011 #b00000100100111110010111)))
; expect = -365700173770220914220103368704.0

(assert (= expect result))

(check-sat)
(exit)
