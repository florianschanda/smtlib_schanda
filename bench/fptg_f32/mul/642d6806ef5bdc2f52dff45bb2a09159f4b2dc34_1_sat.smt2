                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b01110001 #b01001100001011010011100)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010100 #b01110100101111010111000)
                expect
                (fp #b0 #b11111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111110)
                expect
                (fp #b0 #b11111110 #b11111111111111111111111)))
; expect = 340282326356119256160033759537265639424.0

(assert (= expect result))

(check-sat)
(exit)
