; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100110 #b01001110100111011001001)
                arg1
                (fp #b1 #b00100101 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b00100101 #b00100101010110111111100)
                arg1
                (fp #b0 #b01101111 #b11000100010011010001010)))
; arg1 = -0.000000000000000000000000000925678583284292162965654627128430949396689468577914539082485134713351726531982421875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100001 #b10000101110100110001111)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b01111011 #b00111111011001100000000)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01111110 #b10010110001111101010101)
                expect
                (fp #b0 #b10000100 #b01000000001001110010111)))
(assert (fp.leq (fp #b0 #b10000100 #b01000000001001110010111)
                expect
                (fp #b0 #b11110110 #b10011001111001001101100)))
; expect = 40.019130706787109375

(assert (= expect result))

(check-sat)
(exit)
