(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010010 #b10111110001011100001010)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b10111110 #b00111010110000100110011)))
; arg1 = 838177.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01101101 #b01110010001010000111000)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10100011 #b11000010100110101110010)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111110 #b00101001001101111000101)
                expect
                (fp #b0 #b10101010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10101010 #b10011001010001000010000)
                expect
                (fp #b0 #b11110111 #b00011001000110010011010)))
; expect = 14062276575232.0

(assert (= expect result))

(check-sat)
(exit)
