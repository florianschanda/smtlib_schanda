; Format: FLOAT32
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010011 #b11010001000101110101100)
                arg1
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b01010111 #b11110110010100110100111)))
; arg1 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101000 #b01100101110100110100111)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b10000010 #b11111110011000100000010)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100011 #b10001000000011010100110)
                expect
                (fp #b0 #b00010110 #b00001001011100110110011)))
(assert (fp.leq (fp #b0 #b00010110 #b00001001011100110110011)
                expect
                (fp #b0 #b00101100 #b10111010001110010001111)))
; expect = 0.00000000000000000000000000000002556197983077086507494222325772856144789749561120159484887970346989050085539929568767547607421875

(assert (= expect result))

(check-sat)
(exit)
