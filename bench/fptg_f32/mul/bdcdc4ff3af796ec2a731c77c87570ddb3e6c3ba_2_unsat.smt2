;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01001011 #b00010011000110011111111)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11111101 #b11110011001101101000010)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000001 #b10101111010110111010001)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b00011011 #b10100011100111101100000)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010001 #b00110011100100000000000)
                expect
                (fp #b1 #b10010100 #b11010100101011111101100)))
(assert (fp.leq (fp #b1 #b10010100 #b11010100101011111101100)
                expect
                (fp #b1 #b01011000 #b11011000100101000111010)))
; expect = -3839483.0

(assert (not (= expect result)))

(check-sat)
(exit)
