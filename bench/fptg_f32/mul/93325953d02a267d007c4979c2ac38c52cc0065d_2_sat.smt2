; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111011 #b10110110100100111100011)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b11110110 #b00101000000000000111111)))
; arg1 = 1.90954005718231201171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01001101 #b00001010110100011001100)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b10010111 #b01011001100100100100011)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110010 #b01110100001001000000100)
                expect
                (fp #b0 #b10000000 #b10010000000011110111111)))
(assert (fp.leq (fp #b0 #b10000000 #b10010000000011110111111)
                expect
                (fp #b0 #b10001110 #b01101100010000110110110)))
; expect = 3.1254727840423583984375

(assert (= expect result))

(check-sat)
(exit)
