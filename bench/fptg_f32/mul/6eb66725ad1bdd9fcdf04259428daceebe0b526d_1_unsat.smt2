; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100101 #b10111000100110100000110)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b11001100 #b00101011010100110100010)))
; arg1 = 2562247297597440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110001 #b11110001000101001110011)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b11000000 #b00110110100001110110111)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                expect
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b10010110 #b10100110111100011101010)))
; expect = -340282346638528859811704183484516925440.0

(assert (not (= expect result)))

(check-sat)
(exit)
