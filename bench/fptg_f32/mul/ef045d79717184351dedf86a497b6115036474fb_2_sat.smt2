(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00101111 #b10001011110111100101000)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b11011011 #b01000110001101000100000)))
; arg1 = 838177.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00110100 #b11110001110110010111000)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11001011 #b00111000010101001101010)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b11001110110010101110010)
                expect
                (fp #b0 #b11010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b11010010 #b10011001010001000010000)
                expect
                (fp #b0 #b11100011 #b10001010101101101100000)))
; expect = 15461636607469650844844032.0

(assert (= expect result))

(check-sat)
(exit)
