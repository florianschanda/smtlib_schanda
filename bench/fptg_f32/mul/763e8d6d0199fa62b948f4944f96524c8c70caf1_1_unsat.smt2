(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b10111001111010100101100)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b01111111 #b00000110000011100000110)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b11001011 #b11011000001011001011100)
                expect
                (fp #b0 #b11100010 #b10111010110001101111101)))
(assert (fp.leq (fp #b0 #b11100010 #b10111010110001101111101)
                expect
                (fp #b0 #b11100011 #b10110101110101000010111)))
; expect = 1096263377959511474913987788800.0

(assert (not (= expect result)))

(check-sat)
(exit)
