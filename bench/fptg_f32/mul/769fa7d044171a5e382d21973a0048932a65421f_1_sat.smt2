; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10100111 #b01111011000110111110111)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11001111 #b01010001101111000101010)))
; arg1 = 12907478160253124608.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01110000 #b01111110001001000011000)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11101000 #b01111101110110110001100)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01101111 #b11001111000001110010100)
                expect
                (fp #b0 #b11110110 #b00100010001011011001111)))
(assert (fp.leq (fp #b0 #b11110110 #b00100010001011011001111)
                expect
                (fp #b0 #b11111100 #b11011000011011000100011)))
; expect = 753345657728470795604130670862925824.0

(assert (= expect result))

(check-sat)
(exit)
