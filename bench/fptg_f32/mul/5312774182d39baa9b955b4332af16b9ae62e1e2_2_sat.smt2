                arg2
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b00110011 #b11000001101011100100011)))
; arg2 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110010 #b10111000001110101100010)
                expect
                (fp #b0 #b00010100 #b10011001010001000001111)))
(assert (fp.leq (fp #b0 #b00010100 #b10011001010001000001111)
                expect
                (fp #b0 #b11111000 #b10100000111101010101001)))
; expect = 0.0000000000000000000000000000000098527225502077555017374243651329663910666077671196070426017088461634330087690614163875579833984375

(assert (= expect result))

(check-sat)
