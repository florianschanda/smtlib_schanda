(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b1 #b00001111 #b01110010101001100111011)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011000 #b00111110111010111110000)
                expect
                (fp #b0 #b00010110 #b00101101010011001010100)))
(assert (fp.leq (fp #b0 #b00010110 #b00101101010011001010100)
                expect
                (fp #b0 #b11010111 #b11000100010101101010110)))
; expect = 0.000000000000000000000000000000029014080539453570301062941143161217830475321671749211645263688552631720085628330707550048828125

(assert (= expect result))

(check-sat)
