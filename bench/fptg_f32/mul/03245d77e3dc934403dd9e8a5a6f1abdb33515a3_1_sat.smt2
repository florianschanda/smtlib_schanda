(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b1 #b00000011 #b01101101011001010100001)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110100 #b01011110100101010001001)
                expect
                (fp #b0 #b00010110 #b01010000110010101000000)))
(assert (fp.leq (fp #b0 #b00010110 #b01010000110010101000000)
                expect
                (fp #b0 #b01100001 #b01001011100101011101001)))
; expect = 0.00000000000000000000000000000003243179509963884656185680356303878047136275721809735295142473887608502991497516632080078125

(assert (= expect result))

(check-sat)
(exit)
