; Format: FLOAT32
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00100101 #b10010001110001001110000)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11011100 #b00110101001010011111101)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10000111 #b10001010110100111001101)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b10100100 #b10100111000110101000101)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110110 #b11011001111100100011111)
                expect
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                expect
                (fp #b0 #b11000110 #b00111011110011100100011)))
; expect = 494130912.0

(assert (not (= expect result)))

(check-sat)
(exit)
