                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b11101110 #b10110011010111001010100)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001000 #b01010010110010100000000)
                expect
                (fp #b0 #b10110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b10110100 #b01101010000010011110011)
                expect
                (fp #b0 #b11010000 #b00001000110010001011000)))
; expect = 12738103127048192.0

(assert (not (= expect result)))

(check-sat)
(exit)
