                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b00010110 #b10000111010111111011011)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001000 #b01111101111000000001101)
                expect
                (fp #b0 #b00000000 #b00000000000000000000010)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000010)
                expect
                (fp #b0 #b11011100 #b11000110011101000101111)))
; expect = 0.0000000000000000000000000000000000000000000028025969286496341418474591665798322625605238837530315435141365677795821653717212029732763767242431640625

(assert (= expect result))

(check-sat)
