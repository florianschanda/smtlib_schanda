; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00000000 #b10100011100100000001110)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11001111 #b00100010011100011011101)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b11000000000111011101111)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10110110 #b01110110111011110100000)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011011 #b11110101101010100110010)
                expect
                (fp #b0 #b10101101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10101101 #b00101010111110011011110)
                expect
                (fp #b0 #b11011011 #b01000111011110001110111)))
; expect = 82181766512640.0

(assert (not (= expect result)))

(check-sat)
(exit)
