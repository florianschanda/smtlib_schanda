                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b01000110 #b11101010010000101010010)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111111 #b10111010011110111100001)
                expect
                (fp #b0 #b01001111 #b10111001101100100100111)))
(assert (fp.leq (fp #b0 #b01001111 #b10111001101100100100111)
                expect
                (fp #b0 #b10001000 #b10011101111000101011011)))
; expect = 0.00000000000000612977033972376787740454773256715270690619945526123046875

(assert (= expect result))

(check-sat)
(exit)
