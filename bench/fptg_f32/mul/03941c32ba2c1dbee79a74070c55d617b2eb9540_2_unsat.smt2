(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b1 #b10110000 #b11011000100101000110110)))
; arg1 = -340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00111110 #b11001000011011101000101)
                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11001011 #b10111001000011011110110)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
