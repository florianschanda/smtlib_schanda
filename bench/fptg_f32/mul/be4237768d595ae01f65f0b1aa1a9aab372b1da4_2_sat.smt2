                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b0 #b10111110 #b00010101001000000111100)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100011 #b01111110111100010111011)
                expect
                (fp #b0 #b01001010 #b00111111011110011101101)))
(assert (fp.leq (fp #b0 #b01001010 #b00111111011110011101101)
                expect
                (fp #b0 #b10000101 #b00101111111110110110011)))
; expect = 0.0000000000000001385506217853741989416704871729280057479627430438995361328125

(assert (= expect result))

(check-sat)
(exit)
