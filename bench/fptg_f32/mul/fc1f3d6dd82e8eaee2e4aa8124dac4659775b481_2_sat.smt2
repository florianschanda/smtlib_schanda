(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b00001101010011010110101)
                arg1
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b01011100 #b00110011000100000110010)))
; arg1 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001001 #b00111111011011100100001)
                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11000100 #b11001001001100110101101)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011111 #b00000110100110101100010)
                expect
                (fp #b1 #b01101010 #b01010101000101001111000)))
(assert (fp.leq (fp #b1 #b01101010 #b01010101000101001111000)
                expect
                (fp #b0 #b00011011 #b10000110101111101111000)))
; expect = -0.00000063531433625030331313610076904296875

(assert (= expect result))

(check-sat)
(exit)
