; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00110111111100100100100)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b1 #b00100001 #b00001110011110100101111)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010110 #b00010000110111001100101)
                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b01010111 #b01001010000100110001011)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101100 #b00100010000010001101000)
                expect
                (fp #b0 #b10110010 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b10110010 #b01101010000010011110011)
                expect
                (fp #b0 #b11001111 #b00000011101111111011010)))
; expect = 3184525781762048.0

(assert (= expect result))

(check-sat)
(exit)
