(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b01000000 #b01100010001000000000111)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110000 #b00001111101010010000010)
                expect
                (fp #b0 #b00100011 #b00100111011010010000100)))
(assert (fp.leq (fp #b0 #b00100011 #b00100111011010010000100)
                expect
                (fp #b0 #b11010101 #b00001011101100000011100)))
; expect = 0.00000000000000000000000000023303761956735275758156598385167333478947622633914438239344235626049339771270751953125

(assert (= expect result))

