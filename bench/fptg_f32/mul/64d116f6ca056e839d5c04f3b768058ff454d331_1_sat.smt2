                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11110111 #b01111100011010010010101)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101110 #b11110111111100000010110)
                expect
                (fp #b1 #b10000110 #b00001000110000100101011)))
(assert (fp.leq (fp #b1 #b10000110 #b00001000110000100101011)
                expect
                (fp #b1 #b01000000 #b01000010101000100100110)))
; expect = -132.3795623779296875

(assert (= expect result))

(check-sat)
(exit)
