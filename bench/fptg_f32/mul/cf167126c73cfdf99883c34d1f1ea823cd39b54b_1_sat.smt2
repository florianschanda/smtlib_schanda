(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -NAN
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b00110100011100101101101)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b00001111 #b10100011100100111011111)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
