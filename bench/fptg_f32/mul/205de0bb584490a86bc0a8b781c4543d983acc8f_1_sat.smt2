(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b10011100 #b00001000111001100111001)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01110010001001111101011)
                expect
                (fp #b1 #b01011100 #b11010111001111010110111)))
(assert (fp.leq (fp #b1 #b01011100 #b11010111001111010110111)
                expect
                (fp #b0 #b01011011 #b10100010100100001100011)))
; expect = -0.0000000000535737808282643612756146467290818691253662109375

(assert (= expect result))

(check-sat)
(exit)
