                arg2
                (fp #b1 #b00010110 #b10111111001110001011000)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b10001110100100110111101)
                expect
                (fp #b1 #b11011000 #b00111001001110110011111)))
