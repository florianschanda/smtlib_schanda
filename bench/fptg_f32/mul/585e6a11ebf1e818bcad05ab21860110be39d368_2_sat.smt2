                (fp #b0 #b01000010 #b00111001000100001111011)))
; arg1 = 0.00000000000000000000000000801344552008936541742935047589268618360692185420557365205240785144269466400146484375

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01110001 #b01100010000010100100100)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b10111000 #b11010000111111100011010)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011000 #b10101001011011100100100)
                expect
                (fp #b0 #b01000101 #b00100100001011000111010)))
(assert (fp.leq (fp #b0 #b01000101 #b00100100001011000111010)
                expect
                (fp #b0 #b01100111 #b00110111010011110110000)))
; expect = 0.00000000000000000395969125841480454786221188090422629102249629795551300048828125

(assert (= expect result))

(check-sat)
(exit)
