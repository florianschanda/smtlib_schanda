                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b10111000 #b10101111111110111111010)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100010 #b01011101001101010001101)
                expect
                (fp #b0 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b0 #b00000000 #b01001110100111100100101)
                expect
                (fp #b0 #b10100110 #b10100010100101100010001)))
; expect = 0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(assert (= expect result))

