; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111111 #b00110001100111001111110)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11101111 #b00011101001000011110100)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01101001 #b10100101100110110110100)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b11011000 #b10110001000111100011000)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111001 #b00001111101101110011010)
                expect
                (fp #b0 #b10001111 #b10001100100010101000000)))
(assert (fp.leq (fp #b0 #b10001111 #b10001100100010101000000)
                expect
                (fp #b0 #b10101101 #b11001001100000001010100)))
; expect = 101514.5

(assert (not (= expect result)))

(check-sat)
(exit)
