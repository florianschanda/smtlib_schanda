; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110100 #b11011001101000010001000)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01111111 #b00011010000101010100100)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101001 #b01000010000010101101101)
                arg2
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11101011 #b00111000110011111110001)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100001 #b01110110111100011110101)
                expect
                (fp #b1 #b01011000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01011000 #b00000000000000000000000)
                expect
                (fp #b0 #b01100000 #b00010000011110111110110)))
; expect = -0.000000000001818989403545856475830078125

(assert (not (= expect result)))

(check-sat)
(exit)
