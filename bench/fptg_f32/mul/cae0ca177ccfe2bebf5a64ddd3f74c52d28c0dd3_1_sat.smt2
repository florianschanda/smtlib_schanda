                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b10101110 #b00100010010101110100110)))
; arg2 = -0.0000000000000000000000000000000000000059164194436288815055129368261491883180461313842729534869039744872745191506258066738155321218073368072509765625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111000 #b00100011111111011001110)
                expect
                (fp #b0 #b01010000 #b01101001111100110011001)))
(assert (fp.leq (fp #b0 #b01010000 #b01101001111100110011001)
                expect
                (fp #b0 #b10100100 #b01100100110011111101000)))
; expect = 0.0000000000000100461300858571168925781336156433098949491977691650390625

(assert (= expect result))

(check-sat)
(exit)
