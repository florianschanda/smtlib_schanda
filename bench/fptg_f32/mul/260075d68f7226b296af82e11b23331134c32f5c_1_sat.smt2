(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11110100 #b11001110010010001101101)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011111 #b10111001011011101111011)
                expect
                (fp #b1 #b00000000 #b01101000110000001100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01101000110000001100101)
                expect
                (fp #b0 #b00110100 #b00010011110111001110101)))
; expect = -0.00000000000000000000000000000000000000481002564241968651198217705739221832650993184832629233582895298079761849108226812177235842682421207427978515625

(assert (= expect result))

