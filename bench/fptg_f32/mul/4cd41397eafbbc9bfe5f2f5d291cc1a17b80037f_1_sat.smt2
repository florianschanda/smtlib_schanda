; arg1 = 0.000000000000000007176311283322198380889289648365547691355459392070770263671875

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001101 #b00001011100000111110111)
                expect
                (fp #b0 #b00001101 #b00010001110100010110100)))
(assert (fp.leq (fp #b0 #b00001101 #b00010001110100010110100)
                expect
                (fp #b0 #b11111000 #b00111110000110010011001)))
; expect = 0.000000000000000000000000000000000051499440658856193125240398343053751134601008353709661034846613303361806401881040073931217193603515625

(assert (= expect result))

(check-sat)
