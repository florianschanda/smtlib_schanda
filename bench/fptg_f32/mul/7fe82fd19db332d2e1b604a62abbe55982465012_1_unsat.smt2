(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010001 #b10111001011000111101110)
                expect
                (fp #b1 #b00000001 #b01100010000010110010111)))
(assert (fp.leq (fp #b1 #b00000001 #b01100010000010110010111)
                expect
                (fp #b0 #b10101010 #b01000001001010110101111)))
; expect = -0.00000000000000000000000000000000000001625688807806689325935867678581005388357009670707784805243259155309548495693672265360874007456004619598388671875

