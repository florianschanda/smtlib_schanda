                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b00101011 #b10110001100011101000010)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110001 #b00100100100100001011111)
                expect
                (fp #b0 #b00111110 #b00010100110010110010000)))
(assert (fp.leq (fp #b0 #b00111110 #b00010100110010110010000)
                expect
                (fp #b0 #b10000101 #b01001101001101110000111)))
; expect = 0.000000000000000000029306647211235778571086253718736003293088288046419620513916015625

(assert (= expect result))

(check-sat)
(exit)
