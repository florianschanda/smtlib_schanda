(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b10111001010100010111111)
                expect
                (fp #b1 #b11111101 #b01110010101001111111010)))
