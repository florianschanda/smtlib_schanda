; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001111 #b11000100001011100101000)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b0 #b00101000 #b10001011000011110010011)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101100 #b01001100110000011111010)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b0 #b11011110 #b11001110000101111101101)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001001 #b00001100001000010000110)
                expect
                (fp #b0 #b11110101 #b10111000000011000010000)))
(assert (fp.leq (fp #b0 #b11110101 #b10111000000011000010000)
                expect
                (fp #b0 #b11110111 #b10100011110010011001101)))
; expect = 571214135492942108264327186319671296.0

(assert (not (= expect result)))

(check-sat)
(exit)
