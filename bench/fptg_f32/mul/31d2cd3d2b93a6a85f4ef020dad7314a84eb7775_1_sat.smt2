(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010111 #b00100010111101000110100)
                expect
                (fp #b0 #b00001100 #b00100111011010010000100)))
(assert (fp.leq (fp #b0 #b00001100 #b00100111011010010000100)
                expect
                (fp #b0 #b10011010 #b01000101001000011011101)))
; expect = 0.0000000000000000000000000000000000277802490672293612458188514532653492438168795513086774818232484174362895146259688772261142730712890625

(assert (= expect result))

