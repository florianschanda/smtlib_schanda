                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b10100111 #b01011110011101001000110)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b11011010110000000110100)
                expect
                (fp #b1 #b01100000 #b00010111011000011010110)))
(assert (fp.leq (fp #b1 #b01100000 #b00010111011000011010110)
                expect
                (fp #b0 #b10011001 #b00111111010100010111010)))
; expect = -0.00000000050819204400198714211001060903072357177734375

(assert (not (= expect result)))

(check-sat)
(exit)
