; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b00011110100110100000111)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b1 #b01100001 #b00101100101011010111010)))
; arg1 = -18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000111 #b01011110001110001001101)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10111110 #b11011100000100010010101)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110010 #b00101000000101001011001)
                expect
                (fp #b1 #b11010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b1 #b11010101 #b00101010111110011011110)
                expect
                (fp #b0 #b01100011 #b01000001010000100101101)))
; expect = -90359807871819973279088640.0

(assert (= expect result))

(check-sat)
(exit)
