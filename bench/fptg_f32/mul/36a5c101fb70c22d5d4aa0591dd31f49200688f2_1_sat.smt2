                arg2
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b11000001 #b10100110100100000110011)))
; arg2 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111111 #b11011011100101111110101)
                expect
                (fp #b0 #b00100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b0 #b00100001 #b00100111011010010000100)
                expect
                (fp #b0 #b10110110 #b00001010100111011010110)))
; expect = 0.0000000000000000000000000000582594048918381893953914959629183336973690565847860955983605890651233494281768798828125

(assert (= expect result))

(check-sat)
