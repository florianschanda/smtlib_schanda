(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b10001011 #b10110001010111101000010)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110011 #b10011101001100000010110)
                expect
                (fp #b0 #b11011110 #b00100010101111010110001)))
(assert (fp.leq (fp #b0 #b11011110 #b00100010101111010110001)
                expect
                (fp #b0 #b11111011 #b00101010101001111010010)))
; expect = 44989801310006278034718457856.0

(assert (= expect result))

