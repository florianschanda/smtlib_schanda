(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100111 #b01100011011101100010010)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b10010011 #b00101011111100100100100)))
; arg1 = 838177.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00101110 #b10000110100101111101000)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11000010 #b11110110000110100101000)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000000 #b01010111010110111010100)
                expect
                (fp #b0 #b10101000 #b00100011100011011110010)))
(assert (fp.leq (fp #b0 #b10101000 #b00100011100011011110010)
                expect
                (fp #b0 #b10110010 #b00001100010000001110010)))
; expect = 2504432025600.0

(assert (not (= expect result)))

(check-sat)
(exit)
