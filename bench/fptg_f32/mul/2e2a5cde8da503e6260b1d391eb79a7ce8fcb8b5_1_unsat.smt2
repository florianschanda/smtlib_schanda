; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101000 #b01110111011100011101000)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b11010101 #b01101001000110110001010)))
; arg1 = 2562247297597440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110001 #b11010101010010100110100)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b1 #b01000100 #b01110101010110101011100)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111010 #b00010000001000011101011)
                expect
                (fp #b1 #b11001010 #b00100011010010110011011)))
(assert (fp.leq (fp #b1 #b11001010 #b00100011010010110011011)
                expect
                (fp #b0 #b10100111 #b11011111001111010011010)))
; expect = -42987376357208531927040.0

(assert (not (= expect result)))

(check-sat)
(exit)
