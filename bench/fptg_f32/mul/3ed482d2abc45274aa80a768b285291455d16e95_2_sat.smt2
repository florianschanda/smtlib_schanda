(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b11110110 #b11011101110100111011101)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100001 #b11101100111101000111011)
                expect
                (fp #b0 #b11110000 #b00010010110011010110011)))
