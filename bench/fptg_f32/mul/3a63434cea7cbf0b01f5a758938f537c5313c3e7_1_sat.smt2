(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001111 #b00001101111101101011000)
                expect
                (fp #b1 #b00000000 #b00011001100101000100001)))
(assert (fp.leq (fp #b1 #b00000000 #b00011001100101000100001)
                expect
                (fp #b0 #b11100011 #b10011110100100011100111)))
; expect = -0.00000000000000000000000000000000000000117453614293238219805563889093319203316809611365623236002402422298589342031238658137226593680679798126220703125

(assert (= expect result))

