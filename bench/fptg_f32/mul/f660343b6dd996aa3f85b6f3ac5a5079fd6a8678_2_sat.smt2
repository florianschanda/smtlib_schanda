                arg2
                (fp #b0 #b11010110 #b11011001010010100101000)))
; arg2 = 0.0000000000000000000000000000000000000024525777956336526842379881438065104314570774953872316810131125376930223691562815702127409167587757110595703125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011100 #b01011000010100010001011)
                expect
                (fp #b0 #b00000000 #b01100101111111100100000)))
(assert (fp.leq (fp #b0 #b00000000 #b01100101111111100100000)
                expect
                (fp #b0 #b00111101 #b10001001110001100100110)))
; expect = 0.000000000000000000000000000000000000004683296413201543030539047725068228181345338799088805878978558996407477454937406946555711328983306884765625

(assert (= expect result))

