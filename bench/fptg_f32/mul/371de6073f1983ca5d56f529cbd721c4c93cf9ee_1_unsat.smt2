(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b11101101001010101100011)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b0 #b10110001 #b01011000111110111100001)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01010001 #b00110111011101110001001)
                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11010001 #b00111100001111100100110)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001101 #b10011011001010111110011)
                expect
                (fp #b1 #b11001010 #b10101111011010110010001)))
(assert (fp.leq (fp #b1 #b11001010 #b10101111011010110010001)
                expect
                (fp #b0 #b10100001 #b00010001011111101111001)))
; expect = -63666131427840665583616.0

(assert (not (= expect result)))

(check-sat)
(exit)
