(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011111 #b11000011110100111101110)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01010100 #b00111000001101011100110)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00100000 #b11001111110110001111101)
                arg2
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                arg2
                (fp #b0 #b10110100 #b01000011111111011111110)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011110 #b01000110001010111100100)
                expect
                (fp #b1 #b10010100 #b00001111011010010000000)))
(assert (fp.leq (fp #b1 #b10010100 #b00001111011010010000000)
                expect
                (fp #b0 #b11000000 #b11110000110001111010011)))
; expect = -2223392.0

(assert (= expect result))

(check-sat)
(exit)
