                arg2
                (fp #b0 #b00000000 #b00110101011010011001010)))
(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b11101111 #b11000100111011010100100)))
; arg2 = 0.0000000000000000000000000000000000000024525777956336526842379881438065104314570774953872316810131125376930223691562815702127409167587757110595703125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001110 #b10011000101001111010001)
                expect
                (fp #b0 #b01010010 #b11110010010110110101111)))
(assert (fp.leq (fp #b0 #b01010010 #b11110010010110110101111)
                expect
                (fp #b0 #b01011111 #b01010000011011000100011)))
; expect = 0.00000000000005532873082760535188295847319750464521348476409912109375

(assert (= expect result))

(check-sat)
(exit)
