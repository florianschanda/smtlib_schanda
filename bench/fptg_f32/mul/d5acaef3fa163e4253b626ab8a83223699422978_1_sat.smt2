(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11001101 #b01110010000100001010000)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111111 #b01010110010001001100001)
                expect
                (fp #b1 #b01100111 #b01010011000101111011110)))
