; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011100 #b10110001000000001010111)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b00000101 #b01001001110110011110101)))
; arg1 = -18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100100 #b10101111000101011000000)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b1 #b00010111 #b01111010011011101110111)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101100 #b10100010001000101000100)
                expect
                (fp #b0 #b01011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b0 #b01011111 #b01100100001110100011101)
                expect
                (fp #b0 #b01100010 #b00110010011101101101110)))
; expect = 0.0000000003239869761362257349901483394205570220947265625

(assert (= expect result))

(check-sat)
(exit)
