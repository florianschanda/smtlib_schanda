                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b11010110 #b11110001100010000000000)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010110 #b10011111110001101001000)
                expect
                (fp #b1 #b00110100 #b10101011001101001101010)))
(assert (fp.leq (fp #b1 #b00110100 #b10101011001101001101010)
                expect
                (fp #b0 #b01101111 #b00111010110000110111000)))
; expect = -0.0000000000000000000000441721023047822700735742153734680361110154223069912404753267765045166015625

(assert (= expect result))

(check-sat)
(exit)
