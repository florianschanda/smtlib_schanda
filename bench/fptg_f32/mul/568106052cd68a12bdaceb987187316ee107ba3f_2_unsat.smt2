                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b1 #b01010000 #b10001000100110101001010)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b11100101010100000101100)
                expect
                (fp #b1 #b11010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b11010100 #b11000011110011101010100)
                expect
                (fp #b0 #b10000111 #b00011000101111110001010)))
; expect = -68275181399334160988897280.0

(assert (not (= expect result)))

(check-sat)
(exit)
