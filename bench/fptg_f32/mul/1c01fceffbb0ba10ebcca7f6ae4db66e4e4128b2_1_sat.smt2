                arg2
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b10011110 #b01101100000011110001111)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b01110111101010100000100)
                expect
                (fp #b1 #b00010100 #b10011001010001000010000)))
(assert (fp.leq (fp #b1 #b00010100 #b10011001010001000010000)
                expect
                (fp #b0 #b10010011 #b11101111010001101100100)))
; expect = -0.000000000000000000000000000000009852723284891724765667116845593302154970156403785580025156409789133249432779848575592041015625

(assert (= expect result))

(check-sat)
