; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001011 #b11111111001101111111000)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b10001000 #b00000000110100001001100)))
; arg1 = -18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111000 #b10011110110010000110011)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b1 #b01010010 #b11111000111000000110100)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011011 #b10100111010111000010001)
                expect
                (fp #b0 #b11010110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11010110 #b11111111111111111111111)
                expect
                (fp #b0 #b11110010 #b11010110010011000101101)))
; expect = 309484991374600995015229440.0

(assert (= expect result))

(check-sat)
(exit)
