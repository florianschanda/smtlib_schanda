                (fp #b0 #b10101010 #b11010000100110101011011)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010000 #b01100010100010010111010)
                expect
                (fp #b0 #b01110001 #b11011100001000011101111)))
(assert (fp.leq (fp #b0 #b01110001 #b11011100001000011101111)
                expect
                (fp #b0 #b11000011 #b10111011000110010000000)))
; expect = 0.0001135187849286012351512908935546875

(assert (not (= expect result)))

