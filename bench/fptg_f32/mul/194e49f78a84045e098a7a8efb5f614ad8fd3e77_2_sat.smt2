                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b10111001 #b00111001000001110111001)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101110 #b00110101011000000110110)
                expect
                (fp #b1 #b00100100 #b00010001011011101111110)))
(assert (fp.leq (fp #b1 #b00100100 #b00010001011011101111110)
                expect
                (fp #b0 #b01000000 #b10011101011000000100111)))
; expect = -0.00000000000000000000000000043140204827042157256801662721071031833874952036989025572211176040582358837127685546875

(assert (= expect result))

(check-sat)
