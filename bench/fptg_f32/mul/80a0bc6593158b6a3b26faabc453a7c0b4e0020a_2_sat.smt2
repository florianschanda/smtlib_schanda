                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b01110000 #b11001001001100110011000)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101111 #b00101010111101111001010)
                expect
                (fp #b1 #b11001000 #b10111101110111010100011)))
(assert (fp.leq (fp #b1 #b11001000 #b10111101110111010100011)
                expect
                (fp #b0 #b11011010 #b10101001101111111011100)))
; expect = -16449491088663004577792.0

(assert (= expect result))

(check-sat)
(exit)
