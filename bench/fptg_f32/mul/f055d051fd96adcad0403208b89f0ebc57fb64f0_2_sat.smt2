(assert (fp.leq (fp #b1 #b01100001 #b01110000001111011011011)
                expect
                (fp #b1 #b00101001 #b10111110110011010111110)))
(assert (fp.leq (fp #b1 #b00101001 #b10111110110011010111110)
                expect
                (fp #b0 #b01100110 #b01000001001001011010100)))
; expect = -0.000000000000000000000000022557770326146379435598042832908545146457755803393041560411802493035793304443359375

