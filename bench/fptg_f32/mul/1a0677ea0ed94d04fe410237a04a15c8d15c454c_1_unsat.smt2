                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10101100 #b11011101011010110000110)))
; arg2 = 1.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011001 #b00001000001001100001100)
                expect
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                expect
                (fp #b0 #b10100000 #b00010111111000110111001)))
; expect = 1.90954005718231201171875

(assert (not (= expect result)))

(check-sat)
(exit)
