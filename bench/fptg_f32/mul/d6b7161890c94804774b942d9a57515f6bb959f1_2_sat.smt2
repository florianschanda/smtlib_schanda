(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100110 #b11100110010011010001000)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b01001001 #b11011100111111010010001)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001010 #b01000001011010000111100)
                expect
                (fp #b1 #b00110101 #b00000001000001111001001)))
(assert (fp.leq (fp #b1 #b00110101 #b00000001000001111001001)
                expect
                (fp #b0 #b01010110 #b00101101100001011001000)))
; expect = -0.0000000000000000000000531524696062693013940035601853331855004558548216664348728954792022705078125

(assert (= expect result))

(check-sat)
(exit)
