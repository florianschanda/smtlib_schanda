; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b10010001100101010101110)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b01100000 #b01010110010000011000000)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100000 #b01101011110001101101011)
                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b1 #b00000100 #b11101101010101000000101)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011100 #b10111111100001001101111)
                expect
                (fp #b0 #b01001010 #b01000011110011010111001)))
(assert (fp.leq (fp #b0 #b01001010 #b01000011110011010111001)
                expect
                (fp #b0 #b11011000 #b01111100100001010100101)))
; expect = 0.0000000000000001404269585822200843740203968224022901267744600772857666015625

(assert (= expect result))

(check-sat)
(exit)
