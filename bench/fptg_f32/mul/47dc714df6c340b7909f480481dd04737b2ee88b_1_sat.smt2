; Format: FLOAT32
; Arg1: +LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001001 #b11001000100110101011000)
                arg1
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg1 = 340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01101111 #b11101101000100111110110)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b10100010 #b00110010100101011010010)))
; arg2 = -0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111101 #b01010110011101101101001)
                expect
                (fp #b1 #b01101001 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b01101001 #b11111111111111111111111)
                expect
                (fp #b1 #b01011010 #b00001000101110101001010)))
; expect = -0.000000476837129781415569595992565155029296875

(assert (= expect result))

(check-sat)
(exit)
