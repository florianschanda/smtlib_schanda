                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b10110000 #b11111111100110111011111)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110010 #b00101001101010011001010)
                expect
                (fp #b1 #b01011111 #b00100111001110111010001)))
(assert (fp.leq (fp #b1 #b01011111 #b00100111001110111010001)
                expect
                (fp #b0 #b10110100 #b10110111101000101001011)))
; expect = -0.0000000002685127953316879256817628629505634307861328125

(assert (= expect result))

(check-sat)
