(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100010 #b01010001101010111100100)
                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b01100100 #b11011100101111100110100)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011010 #b11101001000111111111100)
                expect
                (fp #b0 #b01001100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b01001100 #b01101010000010011110011)
                expect
                (fp #b0 #b11010011 #b00110000011011111001010)))
; expect = 0.00000000000000062803697272511486808521663505189280840568244457244873046875

(assert (= expect result))

(check-sat)
(exit)
