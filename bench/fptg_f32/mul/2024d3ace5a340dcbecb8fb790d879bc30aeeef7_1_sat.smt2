(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101000 #b01110110001110000010001)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11100010 #b10010100001101101110111)))
; arg1 = 12907478160253124608.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011111 #b00100011101011000110000)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11010010 #b11111101010010101110111)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011010 #b00100111110000111001000)
                expect
                (fp #b0 #b11010011 #b11111110011011011100100)))
(assert (fp.leq (fp #b0 #b11010011 #b11111110011011011100100)
                expect
                (fp #b0 #b11101100 #b10101111111101000111100)))
; expect = 38566912206181775771172864.0

(assert (= expect result))

(check-sat)
(exit)
