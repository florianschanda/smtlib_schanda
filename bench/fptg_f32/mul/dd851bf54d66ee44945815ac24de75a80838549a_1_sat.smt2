(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110011 #b00000110011001100110001)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b00000100 #b01100001011100010011100)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100110 #b00110000001110100011100)
                expect
                (fp #b1 #b00010110 #b00010100110010110010000)))
(assert (fp.leq (fp #b1 #b00010110 #b00010100110010110010000)
                expect
                (fp #b0 #b11111001 #b11001011010010011101001)))
; expect = -0.0000000000000000000000000000000266542403653473034601904634825914429648840160065625427832092242397266090847551822662353515625

(assert (= expect result))

(check-sat)
