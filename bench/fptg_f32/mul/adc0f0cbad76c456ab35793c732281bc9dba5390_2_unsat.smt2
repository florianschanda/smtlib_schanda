                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b11010110 #b01100011100111011010000)))
; arg2 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111010 #b00110101101100111011011)
                expect
                (fp #b1 #b00011000 #b01100010000010110010110)))
(assert (fp.leq (fp #b1 #b00011000 #b01100010000010110010110)
                expect
                (fp #b0 #b00010010 #b00010010001101010010101)))
; expect = -0.00000000000000000000000000000013637264963183305710772719126749513226569040361111132507454524187551214708946645259857177734375

(assert (not (= expect result)))

(check-sat)
