                arg2
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b00011011 #b11100110111101110010010)))
; arg2 = -0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001100 #b10111111010100100110000)
                expect
                (fp #b1 #b00000000 #b00000000000000000000010)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000010)
                expect
                (fp #b0 #b01001110 #b00101110111111110101110)))
; expect = -0.0000000000000000000000000000000000000000000028025969286496341418474591665798322625605238837530315435141365677795821653717212029732763767242431640625

(assert (= expect result))

(check-sat)
