; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000010 #b01110001010000111010011)
                arg1
                (fp #b1 #b00100101 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b00100101 #b00100101010110111111100)
                arg1
                (fp #b0 #b10000110 #b01000110110010000010001)))
; arg1 = -0.000000000000000000000000000925678583284292162965654627128430949396689468577914539082485134713351726531982421875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00011100 #b10110001100010001011010)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111110 #b00010101001110100001001)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000110 #b10111111110101110011001)
                expect
                (fp #b1 #b10010101 #b00111110111101011100110)))
(assert (fp.leq (fp #b1 #b10010101 #b00111110111101011100110)
                expect
                (fp #b0 #b10001010 #b01011110100101010101011)))
; expect = -5225843.0

(assert (= expect result))

(check-sat)
(exit)
