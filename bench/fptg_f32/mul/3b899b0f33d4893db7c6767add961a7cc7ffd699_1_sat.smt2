                arg2
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b00100100 #b10001010010000000010000)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100000 #b10001000010100101000010)
                expect
                (fp #b1 #b00010101 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b00010101 #b01000001011100001000000)
                expect
                (fp #b0 #b00110110 #b11100110011011010011001)))
; expect = -0.000000000000000000000000000000015476746702022368895917660246914042153469001706950387842187666365134646184742450714111328125

(assert (= expect result))

(check-sat)
