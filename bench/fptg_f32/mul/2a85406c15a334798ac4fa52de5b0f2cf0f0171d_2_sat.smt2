(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100010 #b00111100010100100101001)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b1 #b00111101 #b11000001100000111000010)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101011 #b00001000000000011011011)
                expect
                (fp #b1 #b00110101 #b01001010000001000010100)))
(assert (fp.leq (fp #b1 #b00110101 #b01001010000001000010100)
                expect
                (fp #b1 #b00100100 #b01111110010000001110101)))
; expect = -0.00000000000000000000006824575792763740380313504941254577895737298831591033376753330230712890625

(assert (= expect result))

(check-sat)
(exit)
