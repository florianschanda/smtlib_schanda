; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b11100111101010011010110)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b1 #b01101011 #b00010010100001101101010)))
; arg1 = -1698008524581344716521472.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011001 #b11011010110110101010010)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11000000 #b10100010101000110110001)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111100 #b11111101111101110101001)
                expect
                (fp #b1 #b11100101 #b10100011111011011101000)))
(assert (fp.leq (fp #b1 #b11100101 #b10100011111011011101000)
                expect
                (fp #b0 #b10011100 #b01000111011010000101110)))
; expect = -8317549874343724018962756796416.0

(assert (not (= expect result)))

(check-sat)
(exit)
