                arg2
                (fp #b1 #b00010001 #b10011110010110111000100)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001001 #b11110101010011101011000)
                expect
                (fp #b0 #b10111111 #b00001010011010000101011)))
(assert (fp.leq (fp #b0 #b10111111 #b00001010011010000101011)
                expect
                (fp #b0 #b11101111 #b11111001110111011001111)))
; expect = 19196687969666727936.0

(assert (not (= expect result)))

