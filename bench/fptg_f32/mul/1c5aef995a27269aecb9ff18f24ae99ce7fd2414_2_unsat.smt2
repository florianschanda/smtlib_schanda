(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101001 #b11001101011000011010001)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b1 #b10000001 #b11011011011010111110100)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111001 #b00001101100101110111001)
                expect
                (fp #b0 #b10000111 #b10010001100110110001100)))
(assert (fp.leq (fp #b0 #b10000111 #b10010001100110110001100)
                expect
                (fp #b0 #b11101110 #b11010000111011000001010)))
; expect = 401.6058349609375

(assert (not (= expect result)))

(check-sat)
(exit)
