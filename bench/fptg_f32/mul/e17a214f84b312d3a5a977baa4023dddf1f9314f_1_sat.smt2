                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b10011000 #b00100100000110001110011)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011101 #b11010001100111001010011)
                expect
                (fp #b1 #b11010000 #b00100110010000111001010)))
(assert (fp.leq (fp #b1 #b11010000 #b00100110010000111001010)
                expect
                (fp #b0 #b11000010 #b01110100001001111000011)))
; expect = -2779244684681063692238848.0

(assert (= expect result))

(check-sat)
(exit)
