; arg2 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000011 #b10001111111010000001010)
                expect
                (fp #b0 #b00010101 #b01000001011100000111111)))
(assert (fp.leq (fp #b0 #b00010101 #b01000001011100000111111)
                expect
                (fp #b0 #b11001100 #b01000110000010101111011)))
; expect = 0.000000000000000000000000000000015476745232654430368058275285993370625661904433618441877078264479195013336720876395702362060546875

(assert (= expect result))

(check-sat)
