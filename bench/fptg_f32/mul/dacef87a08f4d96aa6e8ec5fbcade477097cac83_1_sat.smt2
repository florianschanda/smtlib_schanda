(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111001 #b01100010001101100101111)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111001 #b10101011001111110111111)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100011 #b01101111000010011101101)
                expect
                (fp #b0 #b10100100 #b10001001101000100001001)))
(assert (fp.leq (fp #b0 #b10100100 #b10001001101000100001001)
                expect
                (fp #b0 #b10101101 #b10000111010010110100100)))
; expect = 211330154496.0

(assert (= expect result))

(check-sat)
(exit)
