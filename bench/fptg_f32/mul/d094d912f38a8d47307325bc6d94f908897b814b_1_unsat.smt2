; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110001 #b11101011010101100011011)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b0 #b10010001 #b01100010100100001100001)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00101100 #b11110011100110010101111)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11100100 #b11101000011110110111111)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101110 #b10101101000110001100000)
                expect
                (fp #b1 #b11010100 #b11001001111011010000011)))
(assert (fp.leq (fp #b1 #b11010100 #b11001001111011010000011)
                expect
                (fp #b0 #b01100101 #b01010010110000110110110)))
; expect = -69199801387598760126709760.0

(assert (not (= expect result)))

(check-sat)
(exit)
