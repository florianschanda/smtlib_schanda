(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001011 #b11101011001000100011101)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000111 #b11100001001001010000011)
                expect
                (fp #b1 #b00000010 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000010 #b00000000000000000000000)
                expect
                (fp #b0 #b00001100 #b10111011110100010101001)))
; expect = -0.00000000000000000000000000000000000002350988701644575015937473074444491355637331113544175043017503412556834518909454345703125

(assert (not (= expect result)))

