(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00101001 #b11010001000010000100011)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11101111 #b00111001110010111010010)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01111100 #b10111011101100010110001)
                expect
                (fp #b0 #b11110000 #b00001001110000000101010)))
(assert (fp.leq (fp #b0 #b11110000 #b00001001110000000101010)
                expect
                (fp #b0 #b11110101 #b11000100111001100010100)))
; expect = 10780152697822512816299509821734912.0

(assert (= expect result))

(check-sat)
(exit)
