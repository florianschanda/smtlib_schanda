                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11100011 #b10011111110101111010101)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010000 #b01110101010010101111110)
                expect
                (fp #b0 #b10110010 #b11011100110001111011100)))
(assert (fp.leq (fp #b0 #b10110010 #b11011100110001111011100)
                expect
                (fp #b0 #b11101101 #b00010000110101001110110)))
; expect = 4193802562568192.0

(assert (= expect result))

(check-sat)
(exit)
