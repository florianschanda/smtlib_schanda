(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001001 #b01010101100101111101101)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b1 #b00101010 #b01011000100010011100111)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000000 #b10100101111010011100010)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b00011011 #b11000111001100011000010)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10010111 #b00011100100111000100010)
                expect
                (fp #b0 #b10110001 #b10110010000001001010110)))
(assert (fp.leq (fp #b0 #b10110001 #b10110010000001001010110)
                expect
                (fp #b0 #b11111000 #b01111011100110101111010)))
; expect = 1908832448020480.0

(assert (not (= expect result)))

(check-sat)
(exit)
