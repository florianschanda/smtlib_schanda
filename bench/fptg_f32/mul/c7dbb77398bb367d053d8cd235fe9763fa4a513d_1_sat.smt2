(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b00001110111001010100000)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b00111001 #b10010011000110100010011)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001110 #b00010010000001110011011)
                expect
                (fp #b0 #b10000000 #b01001001101101111100110)))
(assert (fp.leq (fp #b0 #b10000000 #b01001001101101111100110)
                expect
                (fp #b0 #b11001010 #b00001011001110101000000)))
; expect = 2.575921535491943359375

(assert (= expect result))

(check-sat)
(exit)
