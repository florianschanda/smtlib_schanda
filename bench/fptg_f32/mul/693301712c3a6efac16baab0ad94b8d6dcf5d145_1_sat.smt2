(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -ZERO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001011 #b01111100110100110111011)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11000111 #b10111111011000000110100)))
; arg1 = 12907478160253124608.0

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01101111 #b10111110001011011001101)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11110010 #b01101110100001101000111)))
; arg2 = -0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001010 #b10100001111011100000101)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b00100111 #b00101100111001011111110)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
