(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b1 #b00100010 #b11011010111010010010100)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b11011011010011001011001)
                expect
                (fp #b1 #b01001000 #b00100001011001010001010)))
(assert (fp.leq (fp #b1 #b01001000 #b00100001011001010001010)
                expect
                (fp #b0 #b10110111 #b00000100110011100101010)))
; expect = -0.00000000000000003137625103589192243104533108777332017780281603336334228515625

(assert (= expect result))

(check-sat)
(exit)
