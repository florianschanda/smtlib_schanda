                arg2
                (fp #b0 #b11000110 #b01001000111001011011100)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01001110010100010000000)
                expect
                (fp #b0 #b10110111 #b10001011111100111001000)))
