                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                arg1
                (fp #b0 #b11010100 #b01110011110100110101100)))
; arg1 = 22559420300669994798153728.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01111110 #b11001011100101011001100)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b11010100 #b00000011100100100111010)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110110 #b10000001110101100101010)
                expect
                (fp #b0 #b01010010 #b01000010110100101001111)))
(assert (fp.leq (fp #b0 #b01010010 #b01000010110100101001111)
                expect
                (fp #b0 #b10010110 #b00110100011110000001101)))
; expect = 0.00000000000003584052203783015533300471133770770393311977386474609375

(assert (= expect result))

(check-sat)
(exit)
