                arg2
                (fp #b0 #b11110010 #b10111010101101101010000)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011100 #b11100011101111110010001)
