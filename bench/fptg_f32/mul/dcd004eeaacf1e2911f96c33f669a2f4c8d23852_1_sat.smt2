(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11110010 #b11001011111100110000000)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000011 #b01101110001011000000100)
                expect
                (fp #b0 #b01111111 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b01111111 #b11111111111111111111111)
                expect
                (fp #b0 #b11000000 #b10101111011000000001010)))
; expect = 1.99999988079071044921875

(assert (= expect result))

(check-sat)
