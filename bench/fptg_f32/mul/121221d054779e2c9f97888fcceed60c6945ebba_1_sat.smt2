(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -ZERO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000001 #b10011000000001001100100)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b01101110 #b01010000010000101110100)))
; arg1 = -18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11011011 #b11001000110011000011011)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b00101010 #b00011111011001001000100)))
; arg2 = -0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10110010 #b00011101001001110110100)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10111001 #b10111001001010010110101)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
