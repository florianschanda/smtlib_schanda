                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b11011111 #b10111100100100010011101)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01010110011000001110001)
                expect
                (fp #b1 #b10111111 #b01110010101001111111001)))
(assert (fp.leq (fp #b1 #b10111111 #b01110010101001111111001)
                expect
                (fp #b0 #b00011111 #b10001001010011110100100)))
; expect = -26708582196957937664.0

(assert (= expect result))

(check-sat)
(exit)
