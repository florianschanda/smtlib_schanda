                arg2
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b10111000 #b01101100011011010000011)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011001 #b01001001001001111110111)
                expect
                (fp #b1 #b00011000 #b01100010000010110010111)))
(assert (fp.leq (fp #b1 #b00011000 #b01100010000010110010111)
                expect
                (fp #b0 #b10000010 #b01000000100101001111000)))
; expect = -0.000000000000000000000000000000136372661386776565330602270954860504488147181797766892795420456963029209873639047145843505859375

(assert (= expect result))

(check-sat)
