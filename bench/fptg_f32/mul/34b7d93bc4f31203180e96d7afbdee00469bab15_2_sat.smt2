(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111100 #b00010100101101011010111)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b00001111 #b00010010100101111101010)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001000 #b11011111011011101110010)
                expect
                (fp #b0 #b00000000 #b00000000000101101010001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000101101010001)
                expect
                (fp #b0 #b00010011 #b10111111110100111011000)))
; expect = 0.00000000000000000000000000000000000000000405956165114899505446604460279088703231891884561626619078022681842872476654093816250679083168506622314453125

(assert (= expect result))

(check-sat)
(exit)
