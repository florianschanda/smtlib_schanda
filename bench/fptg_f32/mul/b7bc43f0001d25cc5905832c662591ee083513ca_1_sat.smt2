(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010100 #b11000010110111111000000)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11100101 #b11101111000110110111101)))
; arg1 = 11601303.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001111 #b01011011111010100101010)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11110110 #b01000010111001111101001)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011110 #b10100100011010100010011)
                expect
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b11111111 #b00000000000000000000000)))
; expect = 340282346638528859811704183484516925440.0

(assert (= expect result))

(check-sat)
(exit)
