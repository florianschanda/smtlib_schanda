; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b01100010001101000101101)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b1 #b00011100 #b11110111011010001001111)))
; arg1 = -14198738255872.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b00100010110011100010100)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b00001100 #b11100110000100101111110)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01101010 #b01000101110001100111000)
                expect
                (fp #b0 #b10101011 #b00101011001010001000100)))
(assert (fp.leq (fp #b0 #b10101011 #b00101011001010001000100)
                expect
                (fp #b0 #b11000110 #b10111111010001000010100)))
; expect = 20558003568640.0

(assert (= expect result))

(check-sat)
(exit)
