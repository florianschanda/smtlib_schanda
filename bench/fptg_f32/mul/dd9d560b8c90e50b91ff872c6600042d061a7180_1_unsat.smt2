                arg2
                (fp #b0 #b11100010 #b00111010100100101000000)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111101 #b11001101110010010111010)
                expect
                (fp #b0 #b11010000 #b10111100010110111110011)))
