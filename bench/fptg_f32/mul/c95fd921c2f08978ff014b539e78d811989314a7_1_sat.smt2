(assert (fp.leq (fp #b1 #b01101001 #b11101000100010000010100)
                arg2
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b10110001 #b11110100110111111000011)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011101 #b10111010000101001111001)
                expect
                (fp #b1 #b10010000 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b10010000 #b01100111100100010011101)
                expect
                (fp #b1 #b10001111 #b00010001110100111001110)))
; expect = -184098.453125

(assert (= expect result))

(check-sat)
(exit)
