(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111101 #b10010010010001001111101)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000101 #b00000111101011010100011)
                expect
                (fp #b1 #b10100011 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b10100011 #b00100101010110111111100)
                expect
                (fp #b0 #b11000010 #b11000111011110010001011)))
; expect = -78748024832.0

(assert (= expect result))

