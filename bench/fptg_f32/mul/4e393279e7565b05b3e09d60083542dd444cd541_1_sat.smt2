(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11000100 #b01001010001011100110111)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100010 #b11000101000011010110110)
                expect
                (fp #b0 #b11111110 #b01100110010000010010010)))
(assert (fp.leq (fp #b0 #b11111110 #b01100110010000010010010)
                expect
                (fp #b0 #b11111110 #b01110111000100010100010)))
; expect = 238100925976775188877776335971404480512.0

(assert (= expect result))

(check-sat)
