; arg2 = 0.0000000000000000000000000000000000000024525777956336526842379881438065104314570774953872316810131125376930223691562815702127409167587757110595703125

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011111 #b10011010100101001001100)
                expect
                (fp #b1 #b00010110 #b10101011010011001010000)))
(assert (fp.leq (fp #b1 #b00010110 #b10101011010011001010000)
                expect
                (fp #b1 #b00001111 #b10010100011111000000001)))
; expect = -0.0000000000000000000000000000000411474274341496479524405224940808877148085838688505895544000878771839779801666736602783203125

