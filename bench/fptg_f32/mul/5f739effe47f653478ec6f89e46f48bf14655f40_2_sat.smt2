(assert (fp.leq (fp #b1 #b00001011 #b10010000111100111011010)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11010101 #b01001100000110001011011)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110111 #b11100001100101100000001)
                expect
                (fp #b0 #b01110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b01110100 #b01101010000010011110011)
                expect
                (fp #b0 #b10000000 #b10000110111011001001011)))
; expect = 0.0006905339541845023632049560546875

(assert (= expect result))

(check-sat)
(exit)
