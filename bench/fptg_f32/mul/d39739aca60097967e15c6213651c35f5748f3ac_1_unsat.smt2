                arg2
                (fp #b0 #b10110101 #b01011011101111001111010)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011001 #b00110000110011010100000)
                expect
                (fp #b1 #b11001010 #b01100011011101111011010)))
(assert (fp.leq (fp #b1 #b11001010 #b01100011011101111011010)
                expect
                (fp #b1 #b01100111 #b01110000100101001001100)))
; expect = -52457757322825697329152.0

(assert (not (= expect result)))

