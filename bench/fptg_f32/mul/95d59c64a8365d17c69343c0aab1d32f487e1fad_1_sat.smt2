                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b01100001 #b01011100111001000110111)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010101 #b10010110101001001001001)
                expect
                (fp #b1 #b00010101 #b10111001001101000000000)))
(assert (fp.leq (fp #b1 #b00010101 #b10111001001101000000000)
                expect
                (fp #b0 #b11101001 #b01010011111010010010010)))
; expect = -0.000000000000000000000000000000021243157749868116712008456704988512770922021969006998620699278035317547619342803955078125

(assert (= expect result))

(check-sat)
(exit)
