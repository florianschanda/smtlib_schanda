; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00101000 #b11100100100011100000101)
                arg1
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg1
                (fp #b0 #b11000010 #b10011001001100110100100)))
; arg1 = 0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110100 #b00000111001110111100010)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b0 #b00001100 #b10001100010000000011010)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000000 #b10000110101110000010111)
                expect
                (fp #b1 #b10010110 #b11101111101000001001010)))
(assert (fp.leq (fp #b1 #b10010110 #b11101111101000001001010)
                expect
                (fp #b1 #b01101110 #b01100111011110011111001)))
; expect = -16240714.0

(assert (= expect result))

(check-sat)
(exit)
