                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11011000 #b00001100010100001111110)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110111 #b00110001011101101111100)
                expect
                (fp #b0 #b10000000 #b01110001111010001101110)))
(assert (fp.leq (fp #b0 #b10000000 #b01110001111010001101110)
                expect
                (fp #b0 #b11011110 #b10010111010000011000000)))
; expect = 2.889918804168701171875

(assert (not (= expect result)))

(check-sat)
(exit)
