; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00100100 #b00100110110001010010001)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b01110001 #b01110000110000101010001)))
; arg1 = -0.0000000000000000000000000000000000000078390906197842473151128329331162838047950527052918132227640646251414814627000993141336948610842227935791015625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100001 #b00100111000011001100110)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b01000111 #b11000011011111110001010)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101111 #b10110101011000010000010)
                expect
                (fp #b0 #b00011000 #b01010101011100001100100)))
(assert (fp.leq (fp #b0 #b00011000 #b01010101011100001100100)
                expect
                (fp #b0 #b10000011 #b10000011111000001110101)))
; expect = 0.0000000000000000000000000000001315181165716941906030680624908054465103484349680650934699688292539576650597155094146728515625

(assert (= expect result))

(check-sat)
(exit)
