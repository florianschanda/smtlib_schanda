(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010000 #b00001100111000001101110)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b01111101 #b10100001001111110001100)))
; arg1 = -0.00000000000000000000000000000000000000193308562634222785007100126523010614343659622777088600107578866935283123940081395630841143429279327392578125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100111 #b11101110000001000010110)
                arg2
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b01110011 #b10101101101110101110010)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10111010 #b00001011011100000100100)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b01100011 #b00001111001001011111111)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
