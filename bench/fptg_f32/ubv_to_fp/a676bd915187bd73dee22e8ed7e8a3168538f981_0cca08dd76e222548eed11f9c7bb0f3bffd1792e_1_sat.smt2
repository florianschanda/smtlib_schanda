; Format: FLOAT32
; Arg1: 65535

; Redundancy: False
; Validation for: UBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1111111111111110)))

(declare-const result Float32)
(assert (= result ((_ to_fp_unsigned 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001100 #b11010010000100010010101)
                expect
                (fp #b0 #b10001110 #b11111111111111100000000)))
(assert (fp.leq (fp #b0 #b10001110 #b11111111111111100000000)
                expect
                (fp #b0 #b10011011 #b10111011110001100001100)))
; expect = 65535.0

(assert (= expect result))

(check-sat)
(exit)
