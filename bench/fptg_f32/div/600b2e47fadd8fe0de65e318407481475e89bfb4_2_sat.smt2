                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b1 #b00011011 #b11111001101100100110100)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111100 #b10111010100000101110011)
                expect
                (fp #b0 #b11111100 #b11101000010101000011110)))
(assert (fp.leq (fp #b0 #b11111100 #b11101000010101000011110)
                expect
                (fp #b0 #b11111110 #b01110001111101110000000)))
; expect = 81137578977966511324759980492942475264.0

(assert (= expect result))

(check-sat)
(exit)
