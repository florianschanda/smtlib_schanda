;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101101 #b00100111000010101001111)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
