(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00000110 #b10001011001101001001010)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11110100 #b00111100100110101110111)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00110101 #b00000110101001101101001)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b10100100 #b11101111000111100111001)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001010 #b01110101101100111111100)
                expect
                (fp #b0 #b10000101 #b11000010100000000111010)))
(assert (fp.leq (fp #b0 #b10000101 #b11000010100000000111010)
                expect
                (fp #b0 #b11101001 #b00100001001100001001001)))
; expect = 112.6254425048828125

(assert (= expect result))

(check-sat)
(exit)
