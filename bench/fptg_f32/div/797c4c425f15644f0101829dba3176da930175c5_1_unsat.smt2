; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100010 #b01010110111110111111000)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b00110000 #b00101101111011100111101)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b01101011 #b00100111000010100010100)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100110 #b01101111111011000110000)
                expect
                (fp #b0 #b00000000 #b01100110101101111100101)))
(assert (fp.leq (fp #b0 #b00000000 #b01100110101101111100101)
                expect
                (fp #b0 #b01001101 #b01010101001000100011101)))
; expect = 0.00000000000000000000000000000000000000471657585043079311115641537894178039954711373994643125204201761108157610336011344998041749931871891021728515625

(assert (not (= expect result)))

(check-sat)
(exit)
