; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00011010 #b10000100110111011110011)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b10110011 #b01000100011011100011111)))
; arg1 = 11601303.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10001100 #b01011100010100101011101)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b11100000 #b01101101000100001100011)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010011 #b11100011001011101000011)
                expect
                (fp #b0 #b01111001 #b10000000101010101011010)))
(assert (fp.leq (fp #b0 #b01111001 #b10000000101010101011010)
                expect
                (fp #b0 #b11101011 #b01001010100011011110101)))
; expect = 0.0234781987965106964111328125

(assert (not (= expect result)))

(check-sat)
(exit)
