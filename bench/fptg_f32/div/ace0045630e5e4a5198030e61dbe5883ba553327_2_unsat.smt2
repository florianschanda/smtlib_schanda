                arg2
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b11100011 #b11110001101111010101011)))
; arg2 = 0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110100 #b01101101000110000111100)
                expect
                (fp #b1 #b11001001 #b01101010000010011110100)))
(assert (fp.leq (fp #b1 #b11001001 #b01101010000010011110100)
                expect
                (fp #b0 #b00110000 #b01011101101000101101101)))
; expect = -26713740700895183634432.0

(assert (not (= expect result)))

(check-sat)
(exit)
