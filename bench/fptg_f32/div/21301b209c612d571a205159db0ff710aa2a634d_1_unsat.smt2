(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b00111100 #b01000011111000001101011)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b11000100011101111100111)
                expect
                (fp #b1 #b11111110 #b10100000110011000110110)))
(assert (fp.leq (fp #b1 #b11111110 #b10100000110011000110110)
                expect
                (fp #b0 #b01011010 #b10010111011110011011110)))
; expect = -277010132652951651172304872315461566464.0

(assert (not (= expect result)))

(check-sat)
(exit)
