                (fp #b0 #b01001110 #b10110110010100101011010)))
; arg1 = -1698008524581344716521472.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100101 #b01101011001000000100000)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b01101100 #b00000100001100110100111)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10100100 #b11000001000110010101010)
                expect
                (fp #b0 #b10111010 #b01011010110001000000010)))
(assert (fp.leq (fp #b0 #b10111010 #b01011010110001000000010)
                expect
                (fp #b0 #b11100010 #b10100010111011011000110)))
; expect = 780846907206402048.0

(assert (not (= expect result)))

(check-sat)
(exit)
