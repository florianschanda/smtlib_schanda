; arg1 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010001 #b00101111111101111000110)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b00000111 #b01101011001101100101110)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111001 #b01101110100001111111101)
                expect
                (fp #b1 #b10011111 #b01101111111100011101011)))
(assert (fp.leq (fp #b1 #b10011111 #b01101111111100011101011)
                expect
                (fp #b0 #b10111010 #b01010011000111110001100)))
; expect = -6173087232.0

(assert (= expect result))

(check-sat)
(exit)
