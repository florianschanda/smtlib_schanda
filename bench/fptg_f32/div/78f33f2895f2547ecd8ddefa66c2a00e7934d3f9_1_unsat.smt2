                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b11011001 #b10111110100111011000001)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100011 #b10100110101110100100101)
                expect
                (fp #b1 #b10001101 #b11000000111110110001010)))
(assert (fp.leq (fp #b1 #b10001101 #b11000000111110110001010)
                expect
                (fp #b1 #b01001111 #b00010110110110010000000)))
; expect = -28734.76953125

(assert (not (= expect result)))

(check-sat)
