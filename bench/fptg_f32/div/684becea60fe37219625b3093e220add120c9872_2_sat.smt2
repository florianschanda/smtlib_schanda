(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010011 #b00110111000110111000011)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b0 #b11001000 #b01010001001011001010111)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100010 #b11011010010011011010100)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b1 #b11000111 #b10001101001011101000010)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000100 #b01100110000101001110111)
                expect
                (fp #b0 #b00110100 #b00100110100010011011110)))
(assert (fp.leq (fp #b0 #b00110100 #b00100110100010011011110)
                expect
                (fp #b0 #b01100000 #b11010110011000110011100)))
; expect = 0.0000000000000000000000304545179823599528040419045319948769534601495934111881069839000701904296875

(assert (= expect result))

(check-sat)
(exit)
