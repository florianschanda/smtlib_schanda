; Format: FLOAT32
; Arg1: +ONE
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010101 #b10100111011111111100010)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11011101 #b10001000100111101000010)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000111 #b01111100001010010110010)
                arg2
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b10001000 #b10011111111110101000000)))
; arg2 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01100011111101110101011)
                expect
                (fp #b1 #b11111101 #b00000000000000000000010)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000010)
                expect
                (fp #b0 #b11000111 #b01011010001100100100110)))
; expect = -85070612012644219517514075805193338880.0

(assert (= expect result))

(check-sat)
(exit)
