(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000110 #b11010001001001100111010)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00100101 #b10000110001100001001010)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100101 #b11111111000101110001011)
                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b0 #b11011010 #b10110001000101111101000)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010010 #b11110000000000010101001)
                expect
                (fp #b0 #b01101001 #b00100010000110110010001)))
(assert (fp.leq (fp #b0 #b01101001 #b00100010000110110010001)
                expect
                (fp #b0 #b10001001 #b01110010010111110110010)))
; expect = 0.000000270182255235340562649071216583251953125

(assert (not (= expect result)))

(check-sat)
(exit)
