                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b10011111 #b00111110110010001000010)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b10111111010001010110110)
                expect
                (fp #b1 #b10111110 #b00011000110101110010010)))
(assert (fp.leq (fp #b1 #b10111110 #b00011000110101110010010)
                expect
                (fp #b1 #b01011100 #b11111100011011010101000)))
; expect = -10118341516515606528.0

(assert (= expect result))

(check-sat)
(exit)
