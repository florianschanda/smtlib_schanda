                arg2
                (fp #b0 #b11001000 #b01110001101000011010100)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101101 #b00001001101100101010010)
                expect
                (fp #b0 #b11000111 #b00001111101110101011001)))
