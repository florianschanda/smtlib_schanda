(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b11100001 #b11111000011100001110110)
                arg1
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg1 = 340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10000000 #b01011001000111001100011)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11010010 #b11001011110100111111111)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011001 #b10111000100100011101000)
                expect
                (fp #b0 #b11101000 #b10110110011001110101110)))
(assert (fp.leq (fp #b0 #b11101000 #b10110110011001110101110)
                expect
                (fp #b0 #b11101010 #b10011110111000100111010)))
; expect = 69467846716869565907869951328256.0

(assert (= expect result))

(check-sat)
(exit)
