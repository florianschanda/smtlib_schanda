(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010111 #b10000001010101011001010)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b1 #b01100110 #b00111101001011111010010)))
; arg1 = -14198738255872.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01100111 #b10000110111000010011101)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11010000 #b01111010100101110111100)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b01000001110100100001101)
                expect
                (fp #b1 #b10010101 #b00100010000010011111100)))
(assert (fp.leq (fp #b1 #b10010101 #b00100010000010011111100)
                expect
                (fp #b1 #b00001101 #b11010101010100101101011)))
; expect = -4751998.0

(assert (= expect result))

(check-sat)
(exit)
