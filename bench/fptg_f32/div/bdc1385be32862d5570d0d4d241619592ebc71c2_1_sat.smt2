                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b1 #b00010001 #b00101001001010010001101)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101000 #b00011000101010101101111)
                expect
                (fp #b0 #b00011101 #b00101100001000001011000)))
(assert (fp.leq (fp #b0 #b00011101 #b00101100001000001011000)
                expect
                (fp #b0 #b10001010 #b11110010010110110001100)))
; expect = 0.0000000000000000000000000000036993593390999217821661468317380165718862730195141963474014801249722950160503387451171875

(assert (= expect result))

(check-sat)
