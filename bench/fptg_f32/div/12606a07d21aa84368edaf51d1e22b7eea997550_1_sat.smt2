                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100101 #b11101011001101010000010)
                expect
                (fp #b0 #b00000000 #b01111010001101011110011)))
(assert (fp.leq (fp #b0 #b00000000 #b01111010001101011110011)
                expect
                (fp #b0 #b10010100 #b01101101000011010100100)))
; expect = 0.00000000000000000000000000000000000000561163282374284081813581287059488168974428057112898567699949686432363792076838393541038385592401027679443359375

(assert (= expect result))

