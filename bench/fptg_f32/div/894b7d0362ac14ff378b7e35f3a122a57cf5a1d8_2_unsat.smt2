; Format: FLOAT32
; Arg1: -ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100001 #b01101000011000000001011)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10101001 #b10111011001011111111111)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b10100010010011000000001)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b1 #b00111001 #b10100100000010110010010)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111110 #b11111011000000001000000)
                expect
                (fp #b0 #b01001010 #b11111101111100101111011)))
(assert (fp.leq (fp #b0 #b01001010 #b11111101111100101111011)
                expect
                (fp #b0 #b11110001 #b11100000111111101111010)))
; expect = 0.0000000000000002211551541559652884864906052797550728428177535533905029296875

(assert (not (= expect result)))

(check-sat)
(exit)
