; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001010 #b01100110010101110110100)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b10000000 #b01001110011000101011001)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111011 #b00100101111100100100010)
                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b00110001 #b10000000100110001100110)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000011 #b11100110001011100010000)
                expect
                (fp #b0 #b11001010 #b00100010100001111011111)))
(assert (fp.leq (fp #b0 #b11001010 #b00100010100001111011111)
                expect
                (fp #b0 #b11100100 #b00000100101100010111110)))
; expect = 42874696294531722117120.0

(assert (= expect result))

(check-sat)
(exit)
