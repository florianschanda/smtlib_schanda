(assert (fp.leq (fp #b0 #b00101110 #b01000110100101011011010)
                arg2
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                arg2
                (fp #b0 #b11010011 #b11111001000110111111101)))
; arg2 = 0.0000000000000000000016797691600640013028400516158743227546068510491750203073024749755859375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00010011111001001100101)
                expect
                (fp #b1 #b11101111 #b10100000110000010011100)))
(assert (fp.leq (fp #b1 #b11101111 #b10100000110000010011100)
                expect
                (fp #b0 #b01111000 #b11101111000010110010111)))
; expect = -8452790761644897908841459105136640.0

(assert (= expect result))

(check-sat)
(exit)
