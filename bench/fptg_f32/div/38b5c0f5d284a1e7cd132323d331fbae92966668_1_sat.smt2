(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01001110 #b00010111110111110100000)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10010001 #b00110011000010110111011)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01011111 #b01111011010000110010110)
                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b10110101 #b01111111110101000010111)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001001 #b01111100011001010110011)
                expect
                (fp #b0 #b01001001 #b00001111101110101011000)))
(assert (fp.leq (fp #b0 #b01001001 #b00001111101110101011000)
                expect
                (fp #b0 #b01011011 #b00000000111101001111011)))
; expect = 0.00000000000000005892188821205487751775375926399647141806781291961669921875

(assert (= expect result))

(check-sat)
(exit)
