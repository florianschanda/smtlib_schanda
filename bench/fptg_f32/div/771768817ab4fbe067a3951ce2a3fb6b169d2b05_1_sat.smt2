                arg2
                (fp #b0 #b00111001 #b11111011101011011101100)))
(assert (fp.leq (fp #b0 #b00111001 #b11111011101011011101100)
                arg2
                (fp #b0 #b10100110 #b10111100110010010011100)))
; arg2 = 0.0000000000000000000016797691600640013028400516158743227546068510491750203073024749755859375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111001 #b01111000111111110011000)
                expect
                (fp #b0 #b11011100 #b00000010001011011100100)))
(assert (fp.leq (fp #b0 #b11011100 #b00000010001011011100100)
                expect
                (fp #b0 #b11101110 #b01001011111011010111000)))
; expect = 9987809833635782496612253696.0

(assert (= expect result))

(check-sat)
(exit)
