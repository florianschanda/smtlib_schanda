; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010000 #b10010011110111101111000)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11110000 #b10000001101010011110011)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00101011 #b00100001010111010110111)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b11100000 #b11000111011001111110010)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010110 #b00111100101010010010010)
                expect
                (fp #b0 #b01100010 #b11101011000110001001111)))
(assert (fp.leq (fp #b0 #b01100010 #b11101011000110001001111)
                expect
                (fp #b0 #b01111000 #b10001100000111001110001)))
; expect = 0.0000000035731948511141808921820484101772308349609375

(assert (= expect result))

(check-sat)
(exit)
