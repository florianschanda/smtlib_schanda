; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000011 #b11011000010011101010101)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b1 #b00000111 #b01000100010011111111111)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00100110 #b11111101101000010001110)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b10011111 #b10110001100101010101101)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01101110011111000001100)
                expect
                (fp #b1 #b01100010 #b10111110011010010000010)))
(assert (fp.leq (fp #b1 #b01100010 #b10111110011010010000010)
                expect
                (fp #b0 #b10101000 #b11011001100000110111110)))
; expect = -0.000000003248061819505210223724134266376495361328125

(assert (= expect result))

(check-sat)
(exit)
