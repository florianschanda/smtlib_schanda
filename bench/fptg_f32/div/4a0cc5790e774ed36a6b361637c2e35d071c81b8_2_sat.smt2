; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010010 #b01001011110100001010111)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
