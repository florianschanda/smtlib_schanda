                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b1 #b01010000 #b10011010010010001010001)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b11010011111101111001000)
                expect
                (fp #b1 #b10110001 #b10010010010111111100101)))
(assert (fp.leq (fp #b1 #b10110001 #b10010010010111111100101)
                expect
                (fp #b1 #b01101100 #b10000111100110010000001)))
; expect = -1769660341026816.0

(assert (= expect result))

(check-sat)
(exit)
