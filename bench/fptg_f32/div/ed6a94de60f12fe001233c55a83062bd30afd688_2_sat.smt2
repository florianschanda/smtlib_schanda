                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b00000001 #b00001100111000100111110)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100011 #b11010000111111000000101)
                expect
                (fp #b0 #b01001011 #b01101010000010011110010)))
(assert (fp.leq (fp #b0 #b01001011 #b01101010000010011110010)
                expect
                (fp #b0 #b10000001 #b11110010010110000100111)))
; expect = 0.00000000000000031401845989277783234572272164086825796402990818023681640625

(assert (= expect result))

(check-sat)
(exit)
