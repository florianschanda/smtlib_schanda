; Format: FLOAT32
; Arg1: -ONE
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010011 #b10100111100010000000101)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11011110 #b10110010010110001000110)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00000011 #b00001010011110110110010)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11000000 #b00110101001001000011101)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b01101111111100110111100)
                expect
                (fp #b1 #b01100111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01100111 #b00000000000000000000000)
                expect
                (fp #b0 #b01110101 #b11100110010000010111010)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
