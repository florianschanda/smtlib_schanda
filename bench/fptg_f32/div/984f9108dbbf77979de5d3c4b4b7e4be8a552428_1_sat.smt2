                arg2
                (fp #b0 #b10100100 #b01110001000100111011001)))
; arg2 = 0.0000000000000000000016797691600640013028400516158743227546068510491750203073024749755859375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001100 #b11101111010111000111010)
                expect
