(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110101 #b10110111001001101000111)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b01001100 #b00000000011101110100100)))
; arg1 = -19824648192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00101110 #b10001101111000000001001)
                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110000 #b01010011001111110101010)
                expect
                (fp #b1 #b00100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b00100001 #b00100111011010010000100)
                expect
                (fp #b0 #b00001011 #b11111010001101111001011)))
; expect = -0.0000000000000000000000000000582594048918381893953914959629183336973690565847860955983605890651233494281768798828125

(assert (not (= expect result)))

(check-sat)
(exit)
