                arg2
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b00100000 #b10000110111010001011010)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111111 #b11001110011000000111111)
                expect
                (fp #b1 #b01111100 #b01010000110010101000000)))
(assert (fp.leq (fp #b1 #b01111100 #b01010000110010101000000)
                expect
                (fp #b0 #b01000001 #b11000100010111011001101)))
; expect = -0.16444873809814453125

(assert (= expect result))

