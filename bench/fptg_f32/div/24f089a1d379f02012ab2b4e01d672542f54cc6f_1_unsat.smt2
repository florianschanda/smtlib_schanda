;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101110 #b10101110011011101110101)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10110100 #b10111000010000001100001)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b10110101001110100011101)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b1 #b10011010 #b10010000110111001011000)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101100 #b10001100001001100010101)
                expect
                (fp #b0 #b00011001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00011001 #b00000000000000000000000)
                expect
                (fp #b0 #b01010001 #b01100110111011100110011)))
; expect = 0.000000000000000000000000000000197215226305252951352932141320696557418301608777255751192569732666015625

(assert (not (= expect result)))

(check-sat)
(exit)
