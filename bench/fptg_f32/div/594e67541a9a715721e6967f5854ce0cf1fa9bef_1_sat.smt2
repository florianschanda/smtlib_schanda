; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011011 #b10110101110110110011100)
                expect
                (fp #b0 #b00100011 #b00100111011010010000100)))
(assert (fp.leq (fp #b0 #b00100011 #b00100111011010010000100)
                expect
                (fp #b0 #b01110001 #b10011110100010110100001)))
; expect = 0.00000000000000000000000000023303761956735275758156598385167333478947622633914438239344235626049339771270751953125

(assert (= expect result))

