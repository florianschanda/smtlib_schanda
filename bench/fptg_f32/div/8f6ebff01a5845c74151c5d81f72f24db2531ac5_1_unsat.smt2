                arg2
                (fp #b0 #b10100100 #b10100111000110101000101)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111101 #b00011000110110010101111)
                expect
                (fp #b0 #b01100010 #b00010110001001001000111)))
(assert (fp.leq (fp #b0 #b01100010 #b00010110001001001000111)
                expect
                (fp #b0 #b01111100 #b00100001010001100011100)))
; expect = 0.0000000020237551634494366226135753095149993896484375

(assert (not (= expect result)))

(check-sat)
