(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b01101010 #b10110000101110110100010)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100101 #b10111110000010111100100)
                expect
                (fp #b1 #b01111111 #b00001100001000110101011)))
(assert (fp.leq (fp #b1 #b01111111 #b00001100001000110101011)
                expect
                (fp #b1 #b00001100 #b01001010110000010010001)))
; expect = -1.04741418361663818359375

(assert (not (= expect result)))

