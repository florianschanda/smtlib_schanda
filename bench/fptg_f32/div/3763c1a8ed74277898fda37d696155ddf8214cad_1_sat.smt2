; Format: FLOAT32
; Arg1: +ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001000 #b01100011011111111000000)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111000 #b00101100011110001100000)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111100 #b00100011100011001100101)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b00001101 #b10100100001011111010110)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100010 #b11101010111011000110110)
                expect
                (fp #b1 #b01001010 #b11111101111100101111010)))
(assert (fp.leq (fp #b1 #b01001010 #b11111101111100101111010)
                expect
                (fp #b0 #b01001011 #b00011101100010011000000)))
; expect = -0.000000000000000221155140921075487638047807337215999723412096500396728515625

(assert (= expect result))

(check-sat)
(exit)
