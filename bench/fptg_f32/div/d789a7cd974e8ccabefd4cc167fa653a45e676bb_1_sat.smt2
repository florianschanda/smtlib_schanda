(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10101000 #b00100001101100011100010)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010110 #b00011010111011010000011)
                expect
                (fp #b0 #b10110101 #b01001110110101110110001)))
(assert (fp.leq (fp #b0 #b10110101 #b01001110110101110110001)
                expect
                (fp #b0 #b11011001 #b00000001101010010000101)))
