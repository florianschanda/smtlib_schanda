(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101011 #b01111001100111010101101)
                expect
                (fp #b1 #b01111110 #b11100110100110111010111)))
(assert (fp.leq (fp #b1 #b01111110 #b11100110100110111010111)
