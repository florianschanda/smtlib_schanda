(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110001 #b01100110100011010001110)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b0 #b10000010 #b11101110001011011001101)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000000 #b01000010100000101001101)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b11011000 #b11011000101100010000000)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111111 #b01111110000011000011000)
                expect
                (fp #b0 #b11101111 #b00001001101011011010100)))
(assert (fp.leq (fp #b0 #b11101111 #b00001001101011011010100)
                expect
                (fp #b0 #b11110000 #b01000110110111011111000)))
; expect = 5388597010564310378721250457419776.0

(assert (= expect result))

(check-sat)
(exit)
