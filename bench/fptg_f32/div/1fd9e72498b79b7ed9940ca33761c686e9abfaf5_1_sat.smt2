; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001111 #b10110011101110111100110)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b10110111 #b01111111001110010011110)))
; arg1 = 838177.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100101 #b11011101001011010111111)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b0 #b00110110 #b10100100111000100111000)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111000 #b10011101100110111101011)
                expect
                (fp #b1 #b00110000 #b00101010111101000110111)))
(assert (fp.leq (fp #b1 #b00110000 #b00101010111101000110111)
                expect
                (fp #b0 #b01100011 #b01111011111010101111100)))
; expect = -0.000000000000000000000001931950136385430004648977549130882901649852723124922704300843179225921630859375

(assert (= expect result))

(check-sat)
(exit)
