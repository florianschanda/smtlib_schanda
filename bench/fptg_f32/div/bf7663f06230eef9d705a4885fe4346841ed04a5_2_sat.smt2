                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b11111011 #b00111101010101110010001)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b10100010010000001111011)
                expect
                (fp #b1 #b11111110 #b01010110101101011000011)))
(assert (fp.leq (fp #b1 #b11111110 #b01010110101101011000011)
                expect
                (fp #b0 #b01100101 #b10110111101000101111111)))
; expect = -227769249066361460828851421691569504256.0

(assert (= expect result))

(check-sat)
(exit)
