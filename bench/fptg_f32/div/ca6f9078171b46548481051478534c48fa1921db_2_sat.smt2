                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b00100001 #b01001110000001100110011)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001111 #b00001100110011011100011)
                expect
                (fp #b0 #b01001111 #b01100111100100010011110)))
(assert (fp.leq (fp #b0 #b01001111 #b01100111100100010011110)
                expect
                (fp #b0 #b11100110 #b00001110000110110001011)))
; expect = 0.0000000000000049899989942501186968026871682013734243810176849365234375

(assert (= expect result))

(check-sat)
(exit)
