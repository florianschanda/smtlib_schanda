(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001101 #b00011011001001101011101)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11111000 #b01101000000001010110111)))
; arg1 = 18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111101 #b11111110011100000110101)
                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b1 #b01010000 #b10001000100110101001010)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011111 #b00010101110101101110001)
                expect
                (fp #b1 #b10101001 #b00100010000110110010001)))
(assert (fp.leq (fp #b1 #b10101001 #b00100010000110110010001)
                expect
                (fp #b0 #b11011110 #b01011100001001100010000)))
; expect = -4983982915584.0

(assert (= expect result))

(check-sat)
(exit)
