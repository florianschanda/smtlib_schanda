(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b10111001111010100101100)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b01111111 #b00000110000011100000110)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110010 #b00100111110100110100100)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10011001 #b00011110010010001010011)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
