; Format: FLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01000000100010101111011)
                arg1
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b11100000 #b01100000000000001000100)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001111 #b01101101100011010111000)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b1 #b01001011 #b01100001010001110000011)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011001 #b00000100010101000011111)
                expect
                (fp #b1 #b00000000 #b10001100011010111001010)))
(assert (fp.leq (fp #b1 #b00000000 #b10001100011010111001010)
                expect
                (fp #b0 #b10010110 #b11001110010101000111100)))
; expect = -0.0000000000000000000000000000000000000064477806109131375402706476942960581956985564705369932554280807239792568108516235270144534297287464141845703125

(assert (= expect result))

(check-sat)
(exit)
