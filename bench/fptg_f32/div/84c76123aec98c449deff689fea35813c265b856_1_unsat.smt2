; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010001 #b00111001001101100001001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101110 #b10001000000100110110001)))
; arg1 = 11601303.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011110 #b11011101010000000001010)
                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b1 #b00100011 #b11111101110000101111100)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001001 #b01010000110011000011110)
                expect
                (fp #b1 #b10000000 #b10010001001101100011001)))
(assert (fp.leq (fp #b1 #b10000000 #b10010001001101100011001)
                expect
                (fp #b0 #b01101100 #b11100001001010001000000)))
; expect = -3.1344664096832275390625

(assert (not (= expect result)))

(check-sat)
(exit)
