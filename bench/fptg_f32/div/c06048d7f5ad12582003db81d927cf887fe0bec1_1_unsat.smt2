                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000101 #b00101011111101000010110)
                expect
                (fp #b1 #b00110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b00110000 #b11011100001000011101111)
                expect
                (fp #b0 #b00100111 #b00101110111010011100111)))
; expect = -0.000000000000000000000003076932830937604937472166034467799581274272124886692836298607289791107177734375

(assert (not (= expect result)))

(check-sat)
(exit)
