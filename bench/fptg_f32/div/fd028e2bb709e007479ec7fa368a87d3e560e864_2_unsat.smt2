                arg2
                (fp #b0 #b01111000 #b01000000100101110011010)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001100 #b00011000110011011110001)
                expect
                (fp #b0 #b11001110 #b11110000101011101100011)))
