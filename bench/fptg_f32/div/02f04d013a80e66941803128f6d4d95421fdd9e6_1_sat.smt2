                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b0 #b11100111 #b01111111011000110101010)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010011 #b11010111111111011111010)
                expect
                (fp #b0 #b00101010 #b00100010000110110010001)))
(assert (fp.leq (fp #b0 #b00101010 #b00100010000110110010001)
                expect
                (fp #b0 #b10110000 #b01000010101000000000011)))
; expect = 0.000000000000000000000000029293218809318929209071625801528380769593075394485737206196063198149204254150390625

(assert (= expect result))

(check-sat)
(exit)
