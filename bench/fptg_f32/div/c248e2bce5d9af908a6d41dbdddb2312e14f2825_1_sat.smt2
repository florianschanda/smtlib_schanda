(assert (fp.leq (fp #b1 #b10001101 #b11110110000101110101110)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b11010010 #b10101000001000110100110)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b11110000101010100101001)
                expect
                (fp #b1 #b11011011 #b10010100000010101000110)))
(assert (fp.leq (fp #b1 #b11011011 #b10010100000010101000110)
                expect
                (fp #b1 #b00011011 #b00101001010010001001101)))
; expect = -7815293397332947237930532864.0

(assert (= expect result))

(check-sat)
(exit)
