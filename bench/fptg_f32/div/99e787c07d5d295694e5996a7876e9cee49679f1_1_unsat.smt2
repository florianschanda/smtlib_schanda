; Format: FLOAT32
; Arg1: +ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b10111011011101011110011)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10110010 #b00100011010011001000010)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000011 #b01101010000110011011010)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b10000110 #b10000111100001010001110)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001100 #b00100000100110110001001)
                expect
                (fp #b1 #b01101001 #b11101101110001010111011)))
(assert (fp.leq (fp #b1 #b01101001 #b11101101110001010111011)
                expect
                (fp #b0 #b10110000 #b01110101111110110000010)))
; expect = -0.000000459860387991284369491040706634521484375

(assert (not (= expect result)))

(check-sat)
(exit)
