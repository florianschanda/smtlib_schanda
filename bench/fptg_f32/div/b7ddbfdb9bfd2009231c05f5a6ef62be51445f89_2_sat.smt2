(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110100 #b00001010010100001100001)
                arg2
                (fp #b0 #b00000000 #b00110101011010011001010)))
(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b11001011 #b11000100100010011110100)))
; arg2 = 0.0000000000000000000000000000000000000024525777956336526842379881438065104314570774953872316810131125376930223691562815702127409167587757110595703125

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b10011100101000100110111)
                expect
                (fp #b0 #b10000000 #b01000100001001100010100)))
(assert (fp.leq (fp #b0 #b10000000 #b01000100001001100010100)
                expect
                (fp #b0 #b10101100 #b01001000110111100011100)))
; expect = 2.53241443634033203125

(assert (= expect result))

(check-sat)
(exit)
