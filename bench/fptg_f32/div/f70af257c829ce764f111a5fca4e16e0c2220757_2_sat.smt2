(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100001 #b01100000010000110011010)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b00111111 #b01101000010001000111010)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b00101111010001011001110)
                expect
                (fp #b1 #b01101001 #b10100000110011000110111)))
(assert (fp.leq (fp #b1 #b01101001 #b10100000110011000110111)
                expect
                (fp #b0 #b01100001 #b11000111010111100101000)))
; expect = -0.000000388173901910704444162547588348388671875

(assert (= expect result))

(check-sat)
(exit)
