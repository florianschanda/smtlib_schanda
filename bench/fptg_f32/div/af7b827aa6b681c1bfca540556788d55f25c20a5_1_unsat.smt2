                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111001 #b00010111100010101001011)
                expect
                (fp #b1 #b00010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b00010100 #b11001001111011010000100)
                expect
                (fp #b0 #b01110001 #b11110000110001001011001)))
