(assert (fp.leq (fp #b1 #b10111100 #b11011111110110001011010)
                expect
                (fp #b0 #b10110011 #b01100111101001111100011)))
(assert (fp.leq (fp #b0 #b10110011 #b01100111101001111100011)
                expect
                (fp #b0 #b11110111 #b01101111011010111100111)))
; expect = 6327124092780544.0

(assert (= expect result))

