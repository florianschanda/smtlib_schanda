(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b00100110 #b11111101001111111001110)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101101 #b01100001101100001010111)
                expect
                (fp #b1 #b00111111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00111111 #b00000000000000000000001)
                expect
                (fp #b0 #b11110001 #b01111011101001000000000)))
; expect = -0.000000000000000000054210115086623757270901349976377492367873855982907116413116455078125

(assert (not (= expect result)))

(check-sat)
