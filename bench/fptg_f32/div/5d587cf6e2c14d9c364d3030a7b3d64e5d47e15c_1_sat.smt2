                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10101011 #b11111111100000101100101)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000011 #b10010001001110001010111)
                expect
                (fp #b0 #b01101001 #b10100010100100110010010)))
(assert (fp.leq (fp #b0 #b01101001 #b10100010100100110010010)
                expect
                (fp #b0 #b10101100 #b10100110100000001111001)))
; expect = 0.00000038982813066468224860727787017822265625

(assert (= expect result))

(check-sat)
(exit)
