; Format: FLOAT32
; Arg1: -ONE
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b01011110100111111000100)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10000001 #b11000000110100100111101)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b01011010 #b10010011111110011100110)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000111 #b01100100010010101010001)
                expect
                (fp #b0 #b00000000 #b01000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000001)
                expect
                (fp #b0 #b10001111 #b01110010100100101101001)))
; expect = 0.00000000000000000000000000000000000000293873727835418309473891226678519748446279517219216068028765102276432703842790061798950773663818836212158203125

(assert (not (= expect result)))

(check-sat)
(exit)
