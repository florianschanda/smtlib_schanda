                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b10100100 #b01110010010001111111010)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111010 #b10101010011110101101000)
                expect
                (fp #b0 #b10111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11000110 #b10010001101010101100100)))
; expect = 4611686018427387904.0

(assert (not (= expect result)))

(check-sat)
(exit)
