; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101000 #b11000110101100111001011)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b01010101 #b11111101110001100111111)))
; arg1 = -19824648192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000010 #b10110011100110101101001)
                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11001101 #b01100010011000011000001)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010010 #b01000001100000101001001)
                expect
                (fp #b1 #b01101011 #b00111001100011111001110)))
(assert (fp.leq (fp #b1 #b01101011 #b00111001100011111001110)
                expect
                (fp #b0 #b00101001 #b00110001011000011110010)))
; expect = -0.000001168105654869577847421169281005859375

(assert (not (= expect result)))

(check-sat)
(exit)
