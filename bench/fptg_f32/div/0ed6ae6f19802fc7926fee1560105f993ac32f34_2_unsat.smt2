                arg2
                (fp #b0 #b11110111 #b10011000001010100010001)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b10010101101011011111010)
                expect
                (fp #b1 #b11000111 #b00001111101110101011001)))
(assert (fp.leq (fp #b1 #b11000111 #b00001111101110101011001)
                expect
                (fp #b0 #b10111001 #b11001111000101101101110)))
; expect = -5012520459012197580800.0

(assert (not (= expect result)))

