(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011100 #b01110000110110110011011)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b00111001 #b11011000111101011000110)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101001 #b01000010001100110100000)
                expect
                (fp #b0 #b00000000 #b10110000110011111001000)))
(assert (fp.leq (fp #b0 #b00000000 #b10110000110011111001000)
                expect
                (fp #b0 #b00111010 #b11111100011111011100110)))
; expect = 0.00000000000000000000000000000000000000811875335950340835722536534097178552677917970207987698139670977083050262823604725781478919088840484619140625

(assert (= expect result))

(check-sat)
(exit)
