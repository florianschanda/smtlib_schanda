                arg2
                (fp #b0 #b11000101 #b11101011110111100100000)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010000 #b10111100010000110001000)
                expect
                (fp #b0 #b00000000 #b10010111100110000010011)))
