                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110000 #b01010011001111110101010)
                expect
                (fp #b1 #b00100001 #b00100111011010010000101)))
(assert (fp.leq (fp #b1 #b00100001 #b00100111011010010000101)
                expect
                (fp #b0 #b00001011 #b11111010001101111001000)))
; expect = -0.000000000000000000000000000058259410910369265605503536762849404275266927016353746271448699189932085573673248291015625

(assert (not (= expect result)))

(check-sat)
