; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000101 #b00001111100010101111010)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11100000 #b11110110101111110111101)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b11101101000100000101000)
                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111000 #b01000011100001101110000)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011101 #b01001110010000001110001)
                expect
                (fp #b1 #b01010111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b01010111 #b00000000000000000000001)
                expect
                (fp #b0 #b11111011 #b11001110011100001001110)))
; expect = -0.000000000000909494810193145486465482463245280086994171142578125

(assert (= expect result))

(check-sat)
(exit)
