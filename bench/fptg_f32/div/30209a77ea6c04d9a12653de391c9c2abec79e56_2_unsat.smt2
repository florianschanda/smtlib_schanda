                arg2
                (fp #b0 #b00110010 #b00111001001110111000101)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111011 #b10001101100010111100000)
                expect
                (fp #b1 #b11110101 #b11111100110111000111111)))
(assert (fp.leq (fp #b1 #b11110101 #b11111100110111000111111)
                expect
                (fp #b1 #b10101011 #b10100100001011000110001)))
; expect = -660539729249243150023324329266118656.0

(assert (not (= expect result)))

(check-sat)
(exit)
