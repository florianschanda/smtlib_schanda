                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11100011 #b01011111101011001001110)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111011 #b11110111001011111010100)
                expect
                (fp #b1 #b01110000 #b11011100001000011110000)))
(assert (fp.leq (fp #b1 #b01110000 #b11011100001000011110000)
                expect
                (fp #b0 #b11110001 #b00111000000111000011100)))
; expect = -0.0000567593961022794246673583984375

(assert (not (= expect result)))

(check-sat)
(exit)
