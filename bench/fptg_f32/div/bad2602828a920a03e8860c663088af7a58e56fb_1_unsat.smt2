                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b11010110 #b00010101100010100101010)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010001 #b10100010001111001100100)
                expect
                (fp #b0 #b01111110 #b00100100010000100000010)))
(assert (fp.leq (fp #b0 #b01111110 #b00100100010000100000010)
                expect
                (fp #b0 #b11010010 #b01101010111001110100011)))
; expect = 0.57081615924835205078125

(assert (not (= expect result)))

(check-sat)
(exit)
