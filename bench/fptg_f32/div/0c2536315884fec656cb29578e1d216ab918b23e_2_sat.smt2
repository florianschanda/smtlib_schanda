                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11101111 #b10110111111101011001110)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010111 #b01101101011101110011011)
                expect
                (fp #b1 #b00100011 #b00100111101000111011101)))
(assert (fp.leq (fp #b1 #b00100011 #b00100111101000111011101)
                expect
                (fp #b0 #b01001011 #b10000111101000110010100)))
; expect = -0.0000000000000000000000000002332184884632550238686161033802063417762784358101824100373278270126320421695709228515625

(assert (= expect result))

(check-sat)
