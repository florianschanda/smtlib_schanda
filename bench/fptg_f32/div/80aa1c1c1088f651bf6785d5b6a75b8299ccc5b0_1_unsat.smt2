                arg2
                (fp #b1 #b00001100 #b01110110111010001001000)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101110 #b01100000000111111010011)
                expect
                (fp #b0 #b01101010 #b10001100001111100101100)))
