(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110011 #b11101011010010010100001)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b0 #b11010101 #b10001000101111110111101)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010010 #b11101100001010100000111)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b01111110 #b00101110100010101111111)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100011 #b10110000011100001111010)
                expect
                (fp #b0 #b01111011 #b01000001011100001000000)))
(assert (fp.leq (fp #b0 #b01111011 #b01000001011100001000000)
                expect
                (fp #b0 #b11101011 #b00100010011010000111010)))
; expect = 0.078476428985595703125

(assert (not (= expect result)))

(check-sat)
(exit)
