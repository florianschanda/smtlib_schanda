(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +ONE
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00101100 #b11100110101111011001011)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111110 #b00011000111110110011001)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111100 #b00101011110111101000001)
                arg2
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b11011101 #b11011101010010000011111)))
; arg2 = 0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001010 #b01100100001110101001110)
                expect
                (fp #b0 #b11001001 #b01101010000010011110100)))
(assert (fp.leq (fp #b0 #b11001001 #b01101010000010011110100)
                expect
                (fp #b0 #b11010001 #b01100100011101110011100)))
; expect = 26713740700895183634432.0

(assert (= expect result))

(check-sat)
(exit)
