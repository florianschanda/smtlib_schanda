(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000111 #b11110011010010101001100)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b01100110 #b11110010101000001011001)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b11001000 #b00100110100010011110011)
                expect
                (fp #b0 #b11011010 #b10100111001011101000010)))
(assert (fp.leq (fp #b0 #b11011010 #b10100111001011101000010)
                expect
                (fp #b0 #b11101001 #b10111100011011111100100)))
; expect = 4092762284203342993930846208.0

(assert (not (= expect result)))

(check-sat)
(exit)
