                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b00101101 #b11001100110011101011100)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b00100111011101101001000)
                expect
                (fp #b0 #b10011000 #b11011100001001000010111)))
(assert (fp.leq (fp #b0 #b10011000 #b11011100001001000010111)
                expect
                (fp #b0 #b11111001 #b11011110010010011010010)))
; expect = 62408796.0

(assert (not (= expect result)))

(check-sat)
(exit)
