(assert (fp.leq (fp #b1 #b11101110 #b00110101110001101110110)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b10101110 #b10100111010011001110010)))
