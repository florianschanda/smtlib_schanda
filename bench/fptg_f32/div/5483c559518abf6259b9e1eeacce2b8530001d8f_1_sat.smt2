(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01101011 #b00100100110101111011001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11001100 #b00100001010101001100111)))
; arg1 = 11601303.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b00110110000000111111111)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b1 #b01001110 #b10111101011011011010110)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010111 #b10010111011010111101101)
                expect
                (fp #b1 #b00110111 #b01000100011010011101111)))
(assert (fp.leq (fp #b1 #b00110111 #b01000100011010011101111)
                expect
                (fp #b1 #b00000000 #b00100001111000000000111)))
; expect = -0.00000000000000000000026834859379923376444954071491188866971366877578475396148860454559326171875

(assert (= expect result))

(check-sat)
(exit)
