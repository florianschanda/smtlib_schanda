; Format: FLOAT32
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000101 #b11011101000010101011010)
                arg1
                (fp #b1 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b11101100 #b00110111111101000000001)))
; arg1 = -0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001110 #b10110111101110001011100)
                arg2
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b00010000 #b10110001001000001110011)))
; arg2 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011000 #b01100101010000101001110)
                expect
                (fp #b0 #b01111101 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b01111101 #b00000000000000000000001)
                expect
                (fp #b0 #b10101111 #b11011110100110001011110)))
; expect = 0.2500000298023223876953125

(assert (= expect result))

(check-sat)
(exit)
