                arg2
                (fp #b0 #b10110001 #b11000011001000011100000)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100010 #b10101011110010011110111)
                expect
                (fp #b0 #b11111011 #b01010000101011010010011)))
