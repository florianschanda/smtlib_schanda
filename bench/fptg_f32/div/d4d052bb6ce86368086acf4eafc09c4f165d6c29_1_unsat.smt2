; Format: FLOAT32
; Arg1: -ONE
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011111 #b10110001001000000010001)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10000100 #b00000111001011010000101)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00001010 #b01111011011101100100111)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11000011 #b11110010100101000100111)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000100 #b01011011010000001011000)
                expect
                (fp #b1 #b00111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11101010 #b01110001110111110011011)))
; expect = -0.0000000000000000000542101086242752217003726400434970855712890625

(assert (not (= expect result)))

(check-sat)
(exit)
