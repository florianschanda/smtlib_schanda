                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11100100 #b10110110110011001100001)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000001 #b01110000110100000001000)
                expect
                (fp #b0 #b10111101 #b10100011000111011100111)))
(assert (fp.leq (fp #b0 #b10111101 #b10100011000111011100111)
                expect
                (fp #b0 #b11111101 #b10011011110011110101100)))
; expect = 7550130293902934016.0

(assert (not (= expect result)))

(check-sat)
(exit)
