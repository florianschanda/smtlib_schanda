                arg2
                (fp #b1 #b00000000 #b11100100101000000010101)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011011 #b11000100111001111111010)
                expect
                (fp #b1 #b00010111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00010111 #b00000000000000000000001)
                expect
                (fp #b0 #b10001000 #b11010000000010011000100)))
; expect = -0.0000000000000000000000000000000493038124537849919496705751738568254658037912876417216585800407102624376420862972736358642578125

(assert (not (= expect result)))

