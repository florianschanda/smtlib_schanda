(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b10111011 #b11110010111110100010111)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111001 #b01111100010011111100101)
                expect
                (fp #b1 #b00000000 #b00000000000000000100111)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000100111)
                expect
                (fp #b0 #b01111001 #b00110000110011010010110)))
; expect = -0.00000000000000000000000000000000000000000005465064010866786576602545374830672911993021573318411509852566307170185222474856345797888934612274169921875

(assert (= expect result))

