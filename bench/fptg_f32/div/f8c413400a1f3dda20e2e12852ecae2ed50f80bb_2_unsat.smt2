                arg2
                (fp #b0 #b10001100 #b11001010101000100001101)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010010 #b10111110010001101001000)
                expect
                (fp #b0 #b00110100 #b01110101111111111001100)))
(assert (fp.leq (fp #b0 #b00110100 #b01110101111111111001100)
                expect
                (fp #b0 #b01110001 #b00101111100111111100100)))
; expect = 0.000000000000000000000038670529553785757829782830714729184584665944157677586190402507781982421875

(assert (not (= expect result)))

