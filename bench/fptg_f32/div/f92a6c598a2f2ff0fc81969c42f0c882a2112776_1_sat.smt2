                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b00000000 #b01000010101010011011000)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b00010010011011001001000)
                expect
                (fp #b1 #b00110011 #b01110111000000111011000)))
(assert (fp.leq (fp #b1 #b00110011 #b01110111000000111011000)
                expect
                (fp #b0 #b00011000 #b10100011000100001001000)))
; expect = -0.000000000000000000000019387790291406114764942949892155381330649532856114092282950878143310546875

(assert (= expect result))

(check-sat)
(exit)
