                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11000110 #b01001000111001011011100)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01001110010100010000000)
                expect
                (fp #b0 #b01001000 #b00101101110000110100000)))
(assert (fp.leq (fp #b0 #b01001000 #b00101101110000110100000)
                expect
                (fp #b0 #b01101110 #b11000101010111101110100)))
; expect = 0.0000000000000000327171769832893845342258742903140955604612827301025390625

(assert (= expect result))

(check-sat)
(exit)
