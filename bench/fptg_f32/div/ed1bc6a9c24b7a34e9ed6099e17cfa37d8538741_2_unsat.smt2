; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010001 #b01011110001011011001011)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111100 #b01111100111110010010010)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10001110 #b01110110011110100000100)
                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11000011 #b00101101001100000111000)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011001 #b11000111100111110111111)
                expect
                (fp #b0 #b01100001 #b00001111101110101011001)))
(assert (fp.leq (fp #b0 #b01100001 #b00001111101110101011001)
                expect
                (fp #b0 #b10001011 #b11011110100110000001101)))
; expect = 0.00000000098854535668380094648455269634723663330078125

(assert (not (= expect result)))

(check-sat)
(exit)
