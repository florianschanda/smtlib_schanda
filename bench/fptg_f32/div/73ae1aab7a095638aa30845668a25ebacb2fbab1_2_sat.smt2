(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101000 #b01111011001110111010011)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11001011 #b10001100110110111110110)))
; arg1 = 18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111100 #b11001001101110111011100)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10111001 #b01110011111001001000001)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100011 #b01101010001111110010010)
                expect
                (fp #b0 #b10101000 #b10110110011001110101111)))
(assert (fp.leq (fp #b0 #b10101000 #b10110110011001110101111)
                expect
                (fp #b0 #b10111001 #b00000111110001111011001)))
; expect = 3765859778560.0

(assert (= expect result))

(check-sat)
(exit)
