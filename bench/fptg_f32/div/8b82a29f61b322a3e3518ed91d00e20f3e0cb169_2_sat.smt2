                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b11100101 #b01011111110001001111001)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111011 #b00110011000111110000101)
                expect
                (fp #b0 #b01001011 #b01101010000010011110100)))
(assert (fp.leq (fp #b0 #b01001011 #b01101010000010011110100)
                expect
                (fp #b0 #b11010011 #b01101011001100010010000)))
; expect = 0.0000000000000003140185128323370357394939134110245504416525363922119140625

(assert (= expect result))

(check-sat)
(exit)
