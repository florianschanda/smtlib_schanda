                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10000101 #b11110101001101110110100)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100111 #b01000010001000010011101)
                expect
                (fp #b1 #b01111111 #b11011001100010011000100)))
(assert (fp.leq (fp #b1 #b01111111 #b11011001100010011000100)
                expect
                (fp #b0 #b00011101 #b01010001101001000101111)))
; expect = -1.849754810333251953125

(assert (= expect result))

(check-sat)
(exit)
