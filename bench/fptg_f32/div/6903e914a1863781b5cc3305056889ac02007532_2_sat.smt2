(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b10011011 #b10001011011000100011001)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100101 #b00010101011010001000100)
                expect
                (fp #b0 #b00000000 #b10000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b10000000000000000000001)
                expect
                (fp #b0 #b11101111 #b10001100000111111101101)))
; expect = 0.00000000000000000000000000000000000000587747315540990186466075360984081167900945906412237948405953028846037018706471855011841398663818836212158203125

(assert (= expect result))

(check-sat)
