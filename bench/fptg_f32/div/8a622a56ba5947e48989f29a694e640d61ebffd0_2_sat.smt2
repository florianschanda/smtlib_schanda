; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b00100010101111101011110)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b1 #b01011010 #b11101110000011110100101)))
; arg1 = -1.040654659271240234375

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110001 #b00001001100111000011000)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b11110000 #b01000001010010111010011)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000101 #b11010010100101111110001)
                expect
                (fp #b0 #b01101010 #b00000000111011000011100)))
(assert (fp.leq (fp #b0 #b01101010 #b00000000111011000011100)
                expect
                (fp #b0 #b11011011 #b00100101110010111110010)))
; expect = 0.000000478555875815800391137599945068359375

(assert (= expect result))

(check-sat)
(exit)
