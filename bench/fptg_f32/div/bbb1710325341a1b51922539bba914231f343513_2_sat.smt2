(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011010 #b11001011101010100110110)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b0 #b11001010 #b00100010000111101101011)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00010100 #b10011011111111010101010)
                arg2
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                arg2
                (fp #b0 #b10111111 #b10101110110111011011011)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101101 #b10100100000010110001000)
                expect
                (fp #b1 #b10010100 #b00001111001010101111110)))
(assert (fp.leq (fp #b1 #b10010100 #b00001111001010101111110)
                expect
                (fp #b0 #b10001100 #b11011010101011011110001)))
; expect = -2221407.5

(assert (= expect result))

(check-sat)
(exit)
