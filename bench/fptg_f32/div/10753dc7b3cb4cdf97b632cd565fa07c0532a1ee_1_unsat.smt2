; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100011 #b01010011000110001000000)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b11001111 #b10000000100010011110111)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010000 #b11111101100101100111011)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b1 #b00111000 #b00000000111101011001000)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000001 #b10011001110011100101110)
                expect
                (fp #b0 #b10110000 #b01001000110110010101011)))
(assert (fp.leq (fp #b0 #b10110000 #b01001000110110010101011)
                expect
                (fp #b0 #b11100111 #b11100110101100100110010)))
; expect = 723146529308672.0

(assert (not (= expect result)))

(check-sat)
(exit)
