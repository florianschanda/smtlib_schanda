                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b01100100 #b11100010101101110110001)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111100 #b00000010110101110101110)
                expect
                (fp #b1 #b11101111 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b11101111 #b11011100001000011101111)
                expect
                (fp #b1 #b00111101 #b00011101100111000011110)))
; expect = -9657110206373346183544735463899136.0

(assert (= expect result))

