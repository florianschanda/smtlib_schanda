                arg2
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b01110010 #b01100010001111010100000)))
; arg2 = 0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b11101001110101001000101)
                expect
                (fp #b1 #b11100001 #b01101010000010011110100)))
(assert (fp.leq (fp #b1 #b11100001 #b01101010000010011110100)
                expect
                (fp #b1 #b01101100 #b11000111011011111111000)))
; expect = -448182197906909889194530701312.0

(assert (not (= expect result)))

(check-sat)
(exit)
