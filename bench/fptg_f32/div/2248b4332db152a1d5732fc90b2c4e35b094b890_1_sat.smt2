;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110101 #b01000011000001110011001)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
