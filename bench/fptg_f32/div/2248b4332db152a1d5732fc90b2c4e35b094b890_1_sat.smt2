                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11111101 #b01001001110110110100010)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100010 #b11001100110000011000011)
                expect
                (fp #b1 #b01111001 #b00100101111010101011011)))
(assert (fp.leq (fp #b1 #b01111001 #b00100101111010101011011)
                expect
                (fp #b1 #b00001100 #b00011101011000011100000)))
; expect = -0.01793926022946834564208984375

(assert (= expect result))

(check-sat)
(exit)
