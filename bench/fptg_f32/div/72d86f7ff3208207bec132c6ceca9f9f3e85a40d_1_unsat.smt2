(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11111100 #b10111111110001111000101)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110010 #b00111000100100111000111)
                expect
                (fp #b1 #b01000111 #b00111100000011101101100)))
(assert (fp.leq (fp #b1 #b01000111 #b00111100000011101101100)
                expect
                (fp #b0 #b01010001 #b01000101001001101000001)))
; expect = -0.00000000000000001713353761159867156248226560677494489937089383602142333984375

(assert (not (= expect result)))

(check-sat)
(exit)
