; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010001 #b10010001101101001000101)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b00001011 #b01110111000101011110100)))
; arg1 = 0.00000000000000000000000000000000000000976888739863070481951837620501440851507153415828511504132353945523202336242984955561041715554893016815185546875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001100 #b01111101011100100110001)
                arg2
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b11010110 #b11101011110110110111100)))
; arg2 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110111 #b00100010011110000100010)
                expect
                (fp #b0 #b01111110 #b10101001011111101100000)))
(assert (fp.leq (fp #b0 #b01111110 #b10101001011111101100000)
                expect
                (fp #b0 #b11010001 #b11111111011111111000010)))
; expect = 0.8310451507568359375

(assert (= expect result))

(check-sat)
(exit)
