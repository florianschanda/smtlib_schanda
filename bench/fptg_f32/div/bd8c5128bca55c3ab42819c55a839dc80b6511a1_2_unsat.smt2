; Format: FLOAT32
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010010 #b00110000101000001011000)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01101111 #b00101001101000111100110)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01000001 #b11000000011011101111110)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b11110100 #b10110101101111100011110)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b01100010001110001100101)
                expect
                (fp #b1 #b01100010 #b00010110001001001001000)))
(assert (fp.leq (fp #b1 #b01100010 #b00010110001001001001000)
                expect
                (fp #b0 #b01001011 #b01101011011001000110101)))
; expect = -0.0000000020237553854940415476448833942413330078125

(assert (not (= expect result)))

(check-sat)
(exit)
