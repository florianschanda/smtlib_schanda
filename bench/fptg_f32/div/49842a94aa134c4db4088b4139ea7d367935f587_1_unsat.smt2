; Format: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10001101 #b00000111011010100110110)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11110110 #b00001101010010001011110)))
; arg1 = 18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010111 #b11101101101010110110101)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b11011111 #b10111100100100010011101)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b10111100100101011100111)
                expect
                (fp #b1 #b10111110 #b01100001100111110010000)))
(assert (fp.leq (fp #b1 #b10111110 #b01100001100111110010000)
                expect
                (fp #b0 #b00100000 #b10011010010110000001101)))
; expect = -12740560200528822272.0

(assert (not (= expect result)))

(check-sat)
(exit)
