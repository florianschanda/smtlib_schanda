; Format: FLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000100 #b00110001101111000011011)
                arg1
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b00100011 #b00111100100100001010001)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110010 #b10010100100001110100000)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b11110000 #b01011100101110001111010)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000011 #b00110000000001111101100)
                expect
                (fp #b1 #b01100000 #b01101111111100011101100)))
(assert (fp.leq (fp #b1 #b01100000 #b01101111111100011101100)
                expect
                (fp #b0 #b11101010 #b11111001011110011000001)))
; expect = -0.0000000006692875142988441439229063689708709716796875

(assert (= expect result))

(check-sat)
(exit)
