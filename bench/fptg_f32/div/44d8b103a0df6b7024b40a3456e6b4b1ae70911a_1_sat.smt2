                arg2
                (fp #b1 #b10000111 #b01100010111010001010100)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011110 #b00100101000010011010011)
                expect
                (fp #b1 #b00101010 #b00100010000110110010001)))
(assert (fp.leq (fp #b1 #b00101010 #b00100010000110110010001)
                expect
