                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b01110101 #b10100000000111001100010)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b01111100111000101101101)
                expect
                (fp #b1 #b01111110 #b11101111110110111111001)))
(assert (fp.leq (fp #b1 #b01111110 #b11101111110110111111001)
                expect
                (fp #b0 #b01011011 #b10100110100101001010010)))
; expect = -0.968474924564361572265625

(assert (= expect result))

(check-sat)
(exit)
