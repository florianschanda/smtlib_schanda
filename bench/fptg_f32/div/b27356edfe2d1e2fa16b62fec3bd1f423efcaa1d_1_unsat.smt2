                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b01110010 #b01101000110010010011011)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110001 #b10111111110011111111001)
                expect
                (fp #b1 #b10011000 #b01001101001010011110001)))
(assert (fp.leq (fp #b1 #b10011000 #b01001101001010011110001)
                expect
                (fp #b0 #b10110001 #b01000111000010100010001)))
; expect = -43668420.0

(assert (not (= expect result)))

(check-sat)
(exit)
