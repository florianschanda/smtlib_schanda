(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b10000101011010110000100)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b0 #b00111001 #b11110101001110101110111)))
; arg1 = -14198738255872.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11001101 #b01010101001100110011000)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b11001101 #b11011011011100001011100)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101111 #b10010011000000001101110)
                expect
                (fp #b0 #b10101001 #b11000101010101011101100)))
(assert (fp.leq (fp #b0 #b10101001 #b11000101010101011101100)
                expect
                (fp #b0 #b10111011 #b11010100000101111100000)))
; expect = 7788241616896.0

(assert (= expect result))

(check-sat)
(exit)
