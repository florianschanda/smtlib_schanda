(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000000 #b01111101101111111101100)
                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b11011101 #b01000100011000000100001)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10001001 #b00001000010101001011101)
                expect
                (fp #b0 #b10111111 #b10100000110011000110110)))
(assert (fp.leq (fp #b0 #b10111111 #b10100000110011000110110)
                expect
                (fp #b0 #b11111101 #b10010010010110101110001)))
; expect = 30033498762282795008.0

(assert (= expect result))

(check-sat)
(exit)
