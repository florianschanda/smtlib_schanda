                arg2
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b00111001 #b00101010010111010101001)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000100 #b00011000110100000101010)
                expect
                (fp #b0 #b11111101 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b11111101 #b11000100000000000001001)
                expect
                (fp #b0 #b11111110 #b01010010001001110011011)))
; expect = 150202854794538710070647105574309724160.0

(assert (= expect result))

(check-sat)
