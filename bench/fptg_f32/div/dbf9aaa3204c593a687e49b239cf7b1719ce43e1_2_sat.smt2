(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00000010 #b11011001100100001000100)
                arg1
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b01101101 #b10011000100001110001111)))
; arg1 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000110 #b01100111100101100110100)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b11001110 #b10011110000011100111101)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101100 #b00001100011001000000001)
                expect
                (fp #b0 #b00000000 #b10001100011010111001010)))
(assert (fp.leq (fp #b0 #b00000000 #b10001100011010111001010)
                expect
                (fp #b0 #b10001111 #b00011000000000000111101)))
; expect = 0.0000000000000000000000000000000000000064477806109131375402706476942960581956985564705369932554280807239792568108516235270144534297287464141845703125

(assert (= expect result))

(check-sat)
(exit)
