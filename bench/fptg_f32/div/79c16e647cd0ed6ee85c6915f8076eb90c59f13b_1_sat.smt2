                expect
                (fp #b1 #b01111110 #b00111011100000111100011)))
(assert (fp.leq (fp #b1 #b01111110 #b00111011100000111100011)
                expect
                (fp #b0 #b10010001 #b00011101011110000000000)))
; expect = -0.616239726543426513671875

(assert (= expect result))

