                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b11000001 #b10010001000001001011011)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101101 #b01110000010011111100100)
                expect
                (fp #b0 #b01000010 #b00001110101011111110111)))
(assert (fp.leq (fp #b0 #b01000010 #b00001110101011111110111)
                expect
                (fp #b0 #b11100100 #b10110000101010101111111)))
; expect = 0.000000000000000000458561996530702284985045978638051877851466997526586055755615234375

(assert (= expect result))

(check-sat)
(exit)
