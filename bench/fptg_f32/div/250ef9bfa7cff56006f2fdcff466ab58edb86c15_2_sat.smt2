                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110000 #b01110100001011101001110)
                expect
                (fp #b1 #b00101010 #b10011101001111001101101)))
(assert (fp.leq (fp #b1 #b00101010 #b10011101001111001101101)
                expect
                (fp #b0 #b01101001 #b11111010001101100101100)))
; expect = -0.000000000000000000000000041726344602942499569380743694620881643658934223584111578020383603870868682861328125

(assert (= expect result))

(check-sat)
(exit)
