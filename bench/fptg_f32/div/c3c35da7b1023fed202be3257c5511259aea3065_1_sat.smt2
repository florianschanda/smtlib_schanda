(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b00100010100111101000010)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b0 #b00111000 #b11000001011110110000011)))
; arg1 = -1.040654659271240234375

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100010 #b11001000101110010111100)
                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b10100001 #b01010011101010001100100)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10011001 #b00110101110111101001011)
                expect
                (fp #b0 #b11001001 #b01111000110000011101101)))
(assert (fp.leq (fp #b0 #b11001001 #b01111000110000011101101)
                expect
                (fp #b0 #b11001111 #b10110101011001010001001)))
; expect = 27799776995636137689088.0

(assert (= expect result))

(check-sat)
(exit)
