; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101101 #b10011100001010110101101)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b1 #b01100111 #b10011000001111011100111)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011011 #b01101100001011111100111)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b10110001 #b00101001010010101110000)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000000 #b01111101100011000101001)
                expect
                (fp #b0 #b10011011 #b11001011001011100011110)))
(assert (fp.leq (fp #b0 #b10011011 #b11001011001011100011110)
                expect
                (fp #b0 #b11101001 #b00011000100110001101010)))
; expect = 481485760.0

(assert (not (= expect result)))

(check-sat)
(exit)
