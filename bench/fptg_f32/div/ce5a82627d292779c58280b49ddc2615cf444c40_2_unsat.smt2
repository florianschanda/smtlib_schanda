; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01101100 #b10100001101111111011001)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10100111 #b10000011000110001010011)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110110 #b10110011101011010001001)
                arg2
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                arg2
                (fp #b0 #b11110001 #b10001001100011100100010)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010001 #b10101011100001111000001)
                expect
                (fp #b0 #b10010110 #b00101111001100000101000)))
(assert (fp.leq (fp #b0 #b10010110 #b00101111001100000101000)
                expect
                (fp #b0 #b11010100 #b01101000100100111000111)))
; expect = 9934888.0

(assert (not (= expect result)))

(check-sat)
(exit)
