; Format: FLOAT32
; Arg1: -ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101011 #b00001000111010111100100)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b00100001 #b10111111010101100110011)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011111 #b00110111101100101111100)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10110011 #b10011111011101110010011)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011111 #b10111110001110000110110)
                expect
                (fp #b1 #b01101000 #b10110110011001110101111)))
(assert (fp.leq (fp #b1 #b01101000 #b10110110011001110101111)
                expect
                (fp #b0 #b01000000 #b01000110100011000000111)))
; expect = -0.0000002041476676595266326330602169036865234375

(assert (not (= expect result)))

(check-sat)
(exit)
