(set-info :smt-lib-version 2.6)
(set-logic QF_FPLRA)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target class: +ONE

; Redundancy: False
; Validation for: REAL_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Real)
(assert (<= arg1 1.0))
(assert (<= 1.0 arg1))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00000101111111011001110)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11100000 #b10001010101011001011001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
