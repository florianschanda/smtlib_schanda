; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b01001010110001001000000100110111)))
(assert (not (bvule #b01001010110001001000000100111001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010100 #b10101011010000010000110)
                expect
                (fp #b0 #b10010101 #b10001001000000100111000)))
(assert (fp.leq (fp #b0 #b10010101 #b10001001000000100111000)
                expect
                (fp #b0 #b10110011 #b10010000101000110111101)))
; expect = 6439068.0

(assert (= expect result))

(check-sat)
(exit)
