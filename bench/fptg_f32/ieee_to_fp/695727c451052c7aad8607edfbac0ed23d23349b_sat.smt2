; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b01101001100101010100100100100100)))
(assert (not (bvule #b01101001100101010100100100100110 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011110 #b10001111001001100000001)
                expect
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                expect
                (fp #b0 #b11011000 #b01011001110011101001111)))
; expect = 22559420300669994798153728.0

(assert (= expect result))

(check-sat)
(exit)
