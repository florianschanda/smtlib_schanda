(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +ONE

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b00111111011111111111111111111111)))
(assert (not (bvule #b00111111100000000000000000000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000100 #b01000000110000000111100)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11001100 #b00011010010010010111000)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
