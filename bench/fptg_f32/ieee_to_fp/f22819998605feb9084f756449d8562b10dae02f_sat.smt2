(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b01001011011111111111111111111111)))
(assert (not (bvule #b01001011100000000000000000000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100001 #b10010111001011000100011)
                expect
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b11110100 #b11100000101111010011110)))
; expect = 16777216.0

(assert (= expect result))

(check-sat)
(exit)
