; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b11001010011001001111011010000011)))
(assert (not (bvule #b11001010011001001111011010000101 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111011 #b11110100011111110011010)
                expect
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                expect
                (fp #b0 #b01100000 #b11011010111110110010011)))
; expect = -3751329.0

(assert (= expect result))

(check-sat)
(exit)
