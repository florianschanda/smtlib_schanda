; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b11111110011111111111111111111111)))
(assert (not (bvule #b11111110100000000000000000000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00000001000011001010001)
                expect
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                expect
                (fp #b1 #b00001100 #b11111100000001001011101)))
; expect = -85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
