; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b11001011000110101100000100101100)))
(assert (not (bvule #b11001011000110101100000100101110 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100100 #b10010011010000100110111)
                expect
                (fp #b1 #b10010110 #b00110101100000100101101)))
(assert (fp.leq (fp #b1 #b10010110 #b00110101100000100101101)
                expect
                (fp #b1 #b01000001 #b10100010000100000111101)))
; expect = -10141997.0

(assert (= expect result))

(check-sat)
(exit)
