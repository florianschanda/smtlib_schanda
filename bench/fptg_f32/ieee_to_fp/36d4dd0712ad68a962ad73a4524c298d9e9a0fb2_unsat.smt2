(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -ZERO

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b01111111111111111111111111111111)))
(assert (not (bvule #b10000000000000000000000000000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11101110 #b11110001101001000110011)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10111101 #b00010111000111101011110)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
