(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b11001001101000001011100000111111)))
(assert (not (bvule #b11001001101000001011100001000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b00110111101111011011000)
                expect
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                expect
                (fp #b0 #b01011110 #b01001011100110110110000)))
; expect = -1316616.0

(assert (= expect result))

(check-sat)
(exit)
