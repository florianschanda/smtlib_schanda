; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b11001001101000001011100000111111)))
(assert (not (bvule #b11001001101000001011100001000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01100010111111001000111)
                expect
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                expect
                (fp #b1 #b01111111 #b01001010111001100111110)))
; expect = -1316616.0

(assert (not (= expect result)))

(check-sat)
(exit)
