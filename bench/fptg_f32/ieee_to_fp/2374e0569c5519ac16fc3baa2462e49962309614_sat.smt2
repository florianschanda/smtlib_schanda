(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b01001011001100010000010110010110)))
(assert (not (bvule #b01001011001100010000010110011000 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011111 #b01110001000111001000011)
                expect
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                expect
                (fp #b0 #b11011110 #b01011110000000010101001)))
; expect = 11601303.0

(assert (= expect result))

(check-sat)
(exit)
