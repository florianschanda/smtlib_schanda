; Format: FLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b00011111111111111111111111111111)))
(assert (not (bvule #b00100000000000000000000000000001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010100 #b10101010011111101001100)
                expect
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10010000 #b10111100000000101101111)))
; expect = 0.000000000000000000108420217248550443400745280086994171142578125

(assert (= expect result))

(check-sat)
(exit)
