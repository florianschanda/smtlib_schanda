(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const arg1 (_ BitVec 32))
(assert (not (bvule arg1 #b01001001010011001010001000001111)))
(assert (not (bvule #b01001001010011001010001000010001 arg1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010101 #b00110010111110011100000)
                expect
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                expect
                (fp #b0 #b11111100 #b10101101001110100100101)))
; expect = 838177.0

(assert (= expect result))

(check-sat)
(exit)
