(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv64
; Arg1: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b01000010 #b00001011010011101100011)
                arg
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg = 340282346638528859811704183484516925440.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1101010100010100000101001001011011010101100110110111110001001001)))
(assert (not (bvule #b1101010100010100000101001001011011010101100110110111110001001011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
