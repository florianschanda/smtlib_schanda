; Format: FLOAT32
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b10100110 #b00011100001110000101010)
                arg
                (fp #b1 #b01111111 #b11110100011000110101101)))
(assert (fp.leq (fp #b1 #b01111111 #b11110100011000110101101)
                arg
                (fp #b1 #b01010000 #b01111110010010000001111)))
; arg = -1.95464098453521728515625

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
