; Format: FLOAT32
; Target: bv7
; Arg1: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b0 #b11111000 #b10110010010110011010000)
                arg
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg
                (fp #b0 #b11111101 #b00011110000100100001101)))
; arg = 85070591730234615865843651857942052864.0

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (= expect #b0101101))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
