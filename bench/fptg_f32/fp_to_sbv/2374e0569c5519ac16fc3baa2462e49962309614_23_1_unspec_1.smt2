; Format: FLOAT32
; Target: bv23
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg = 11601303.0

(declare-const result (_ BitVec 23))
(assert (= result ((_ fp.to_sbv 23) rm arg)))

(declare-const expect (_ BitVec 23))
(assert (not (bvule expect #b00111000100011100100001)))
(assert (not (bvule #b00111000100011100100011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
