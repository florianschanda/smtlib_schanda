; Format: FLOAT32
; Target: bv42
; Arg1: +RANDOM_SUBNORMAL(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b10101100 #b10011000100111010011010)
                arg
                (fp #b0 #b00000000 #b10001100001001000101000)))
(assert (fp.leq (fp #b0 #b00000000 #b10001100001001000101000)
                arg
                (fp #b0 #b01010110 #b01111110001111000100000)))
; arg = 0.00000000000000000000000000000000000000643499796632156655894968143303728758074901792110319567855811274709361413659536310660769231617450714111328125

(declare-const result (_ BitVec 42))
(assert (= result ((_ fp.to_sbv 42) rm arg)))

(declare-const expect (_ BitVec 42))
(assert (not (bvule expect #b000000000000000000000000000000000000000000)))
(assert (not (bvule #b000000000000000000000000000000000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
