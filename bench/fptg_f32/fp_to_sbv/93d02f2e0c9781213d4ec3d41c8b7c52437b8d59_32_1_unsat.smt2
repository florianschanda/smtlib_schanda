; Format: FLOAT32
; Target: bv32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01011001110001011000100)
                arg
                (fp #b1 #b10010110 #b11111101100111110110000)))
(assert (fp.leq (fp #b1 #b10010110 #b11111101100111110110000)
                arg
                (fp #b1 #b10000010 #b11100101010111000100101)))
; arg = -16699312.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111000000010011000001001111)))
(assert (not (bvule #b11111111000000010011000001010001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
