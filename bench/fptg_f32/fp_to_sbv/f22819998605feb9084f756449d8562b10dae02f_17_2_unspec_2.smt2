(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv17
; Arg1: +INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b0 #b10001101 #b01110010000111101010111)
                arg
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg
                (fp #b0 #b10100001 #b11010101001111011001010)))
; arg = 16777216.0

(declare-const result (_ BitVec 17))
(assert (= result ((_ fp.to_sbv 17) rm arg)))

(declare-const expect (_ BitVec 17))
(assert (not (bvule expect #b00011010011101101)))
(assert (not (bvule #b00011010011101111 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
