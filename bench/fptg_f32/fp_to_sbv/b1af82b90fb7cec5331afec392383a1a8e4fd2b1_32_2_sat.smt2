; Format: FLOAT32
; Target: bv32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11001000 #b00100010011001100000000)
                arg
                (fp #b0 #b10010101 #b10001001000000100111000)))
(assert (fp.leq (fp #b0 #b10010101 #b10001001000000100111000)
                arg
                (fp #b0 #b10010101 #b10001010111100001010010)))
; arg = 6439068.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000011000100100000010011100))

(assert (= expect result))

(check-sat)
(exit)
