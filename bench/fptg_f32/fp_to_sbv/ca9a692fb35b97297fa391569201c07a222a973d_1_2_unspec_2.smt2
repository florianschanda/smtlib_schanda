; Format: FLOAT32
; Target: bv1
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b10101010 #b10010010001011001010001)
                arg
                (fp #b0 #b11010101 #b00100111011100011000100)))
(assert (fp.leq (fp #b0 #b11010101 #b00100111011100011000100)
                arg
                (fp #b0 #b11011001 #b01010101001001000010101)))
; arg = 89292313239018475236622336.0

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
