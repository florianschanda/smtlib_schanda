(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv8
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b0 #b00111101 #b11111010101100011110011)
                arg
                (fp #b0 #b11100110 #b10100101110011100101010)))
(assert (fp.leq (fp #b0 #b11100110 #b10100101110011100101010)
                arg
                (fp #b0 #b11111010 #b10011100111110110101100)))
; arg = 16709455940148665419944991653888.0

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b01101101)))
(assert (not (bvule #b01101111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
