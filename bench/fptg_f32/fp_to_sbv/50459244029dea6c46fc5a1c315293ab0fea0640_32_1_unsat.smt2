; Format: FLOAT32
; Target: bv32
; Arg1: -INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11001000 #b01010100101100011001000)
                arg
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg
                (fp #b1 #b10000110 #b00001010001111111111110)))
; arg = -16777216.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111110111111111111111111111111)))
(assert (not (bvule #b11111111000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
