; Format: FLOAT32
; Target: bv15
; Arg1: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b00111110 #b10100011101011011010110)
                arg
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg
                (fp #b0 #b11001001 #b11011011110001101011010)))
; arg = 18446742974197923840.0

(declare-const result (_ BitVec 15))
(assert (= result ((_ fp.to_sbv 15) rm arg)))

(declare-const expect (_ BitVec 15))
(assert (not (bvule expect #b010001111000100)))
(assert (not (bvule #b010001111000110 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
