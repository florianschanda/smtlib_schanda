; Format: FLOAT32
; Target: bv1
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01011001110001011000100)
                arg
                (fp #b1 #b10010110 #b11111101100111110110000)))
(assert (fp.leq (fp #b1 #b10010110 #b11111101100111110110000)
                arg
                (fp #b1 #b10000010 #b11100101010111000100101)))
; arg = -16699312.0

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
