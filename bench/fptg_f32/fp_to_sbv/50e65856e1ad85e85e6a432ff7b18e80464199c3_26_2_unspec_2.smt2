; Format: FLOAT32
; Target: bv26
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b0 #b01111011 #b10111000011000001010001)
                arg
                (fp #b0 #b10011101 #b00000111101001011001111)))
(assert (fp.leq (fp #b0 #b10011101 #b00000111101001011001111)
                arg
                (fp #b0 #b10101011 #b01110011101010100110101)))
; arg = 1105815424.0

(declare-const result (_ BitVec 26))
(assert (= result ((_ fp.to_sbv 26) rm arg)))

(declare-const expect (_ BitVec 26))
(assert (not (bvule expect #b01101111011000001111001000)))
(assert (not (bvule #b01101111011000001111001010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
