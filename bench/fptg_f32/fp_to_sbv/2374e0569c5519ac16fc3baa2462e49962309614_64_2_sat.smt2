(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv64
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg = 11601303.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0000000000000000000000000000000000000000101100010000010110010110)))
(assert (not (bvule #b0000000000000000000000000000000000000000101100010000010110011000 expect)))

(assert (= expect result))

(check-sat)
(exit)
