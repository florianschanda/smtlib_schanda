; Format: FLOAT32
; Target: bv32
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b10111000 #b01101000101110110101111)
                arg
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg
                (fp #b0 #b00101010 #b01000110111001010100111)))
; arg = -1047025986568192.0

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b10010100000001111011110101010100))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
