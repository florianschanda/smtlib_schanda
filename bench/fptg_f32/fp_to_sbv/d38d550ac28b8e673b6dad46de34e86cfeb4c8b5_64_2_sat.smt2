(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv64
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b0 #b10000000 #b01001001101100011101000)
                arg
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg
                (fp #b0 #b11110100 #b11011100111100100110010)))
; arg = 838177.0

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0000000000000000000000000000000000000000000011001100101000100000)))
(assert (not (bvule #b0000000000000000000000000000000000000000000011001100101000100010 expect)))

(assert (= expect result))

(check-sat)
(exit)
