; Format: FLOAT32
; Target: bv3
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b01101100 #b01100111001110001001010)
                arg
                (fp #b0 #b10010010 #b10110101011110010100000)))
(assert (fp.leq (fp #b0 #b10010010 #b10110101011110010100000)
                arg
                (fp #b0 #b11000001 #b11000001000101101011100)))
; arg = 895946.0

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_sbv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b011)))
(assert (not (bvule #b101 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
