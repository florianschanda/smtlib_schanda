(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Target: bv2
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg Float32)
(assert (fp.leq (fp #b1 #b11010010 #b01100100100000110001011)
                arg
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg
                (fp #b0 #b10000010 #b00110011010010010110111)))
; arg = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_sbv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule #b01 expect)))

(assert (= expect result))

(check-sat)
(exit)
