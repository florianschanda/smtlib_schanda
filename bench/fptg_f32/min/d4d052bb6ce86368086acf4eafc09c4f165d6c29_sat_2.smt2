(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11000011 #b11110010100101000100111)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000100 #b01011011010000001011000)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b1 #b01010110 #b00011110111101111010110)))
; expect = -1.0

(assert (= expect result))

(check-sat)
