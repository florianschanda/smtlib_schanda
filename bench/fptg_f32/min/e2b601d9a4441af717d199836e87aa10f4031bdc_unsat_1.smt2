; Format: FLOAT32
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10101100 #b01101000110101011101000)
                arg1
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111101 #b10101110111011011100011)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101100 #b01000110100101001110100)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10100100 #b10011001101110010001100)))
; arg2 = 1.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101100 #b01110100101000100001110)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10100010 #b10101001010011011100001)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
