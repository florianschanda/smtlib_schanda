(assert (fp.leq (fp #b1 #b00110000 #b01110100110101010000011)
                arg1
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b00011110 #b01000111101010100101010)))
