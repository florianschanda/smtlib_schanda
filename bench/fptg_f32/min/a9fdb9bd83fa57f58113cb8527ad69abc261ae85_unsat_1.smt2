; Format: FLOAT32
; Arg1: -ONE
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101111 #b00001000110000010100001)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01010101 #b11100100100101110001011)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01001100 #b11101000011110111011011)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111101 #b11011011101010011111110)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110000 #b00101110110101111000110)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b00001001 #b11001001100100001000011)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
