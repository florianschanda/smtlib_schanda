(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000111 #b01001110111010010001100)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11110010 #b00010010001101010101011)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b11010110111101011101011)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b10100100 #b10101001000011100011010)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011100 #b11110011111100100100011)
                expect
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                expect
                (fp #b1 #b01111000 #b01011011101111100011001)))
; expect = -295579222016.0

(assert (= expect result))

(check-sat)
(exit)
