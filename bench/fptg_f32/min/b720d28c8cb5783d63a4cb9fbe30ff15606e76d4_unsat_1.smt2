(assert (fp.leq (fp #b1 #b11110111 #b00110100000011110001100)
                expect
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                expect
                (fp #b0 #b01000010 #b00110101010000110000101)))
