(assert (fp.leq (fp #b1 #b01101110 #b01110010100111011101000)
                expect
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                expect
                (fp #b0 #b00111000 #b10010110000011001111010)))
