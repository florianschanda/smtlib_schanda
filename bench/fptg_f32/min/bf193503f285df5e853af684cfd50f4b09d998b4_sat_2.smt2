; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011101 #b10001001010001001100100)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b11001101 #b10000010000101100100000)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00010101 #b01111001010001100101101)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111101 #b11010100001110110110110)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010101 #b00111111001011110011110)
                expect
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                expect
                (fp #b0 #b11110011 #b10100011101000010100010)))
; expect = -1.6049678325653076171875

(assert (= expect result))

(check-sat)
(exit)
