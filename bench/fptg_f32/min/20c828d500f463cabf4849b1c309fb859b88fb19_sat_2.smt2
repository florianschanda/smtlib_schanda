; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101011 #b00011000110111010010101)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11011111 #b11010110001110010000010)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01001010 #b11011011000110011110010)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b10111001 #b10010111110100000101011)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011111 #b10111101110000100101000)
                expect
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                expect
                (fp #b0 #b10110100 #b00010110010001111000101)))
; expect = 2987951.0

(assert (= expect result))

(check-sat)
(exit)
