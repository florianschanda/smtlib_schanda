; Format: FLOAT32
; Arg1: +ONE
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00100000 #b10011010010011110111000)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10110001 #b01001010101111000011111)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00111110110111111000100)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11100110 #b10110001101000000001110)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b01010011011101110111111)
                expect
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                expect
                (fp #b1 #b11010111 #b00001000001111000000101)))
; expect = -85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
