; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011000 #b01110001000100111100111)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11110101 #b11010011101011001001001)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110010 #b00111101000100101111001)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b01100101 #b10111010101011100111000)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b01100000110010110000010)
                expect
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                expect
                (fp #b1 #b10000100 #b10000011110100001100001)))
; expect = -43232207340579439130859012096.0

(assert (= expect result))

(check-sat)
(exit)
