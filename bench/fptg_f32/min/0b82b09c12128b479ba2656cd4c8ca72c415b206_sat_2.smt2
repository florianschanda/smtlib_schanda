; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010011 #b10110110111001101001100)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b1 #b00110101 #b00101100101100111001001)))
; arg1 = -14198738255872.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000011 #b10011001101100100110100)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b1 #b01001000 #b10111101111101101000000)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b10110110011000001000011)
                expect
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                expect
                (fp #b1 #b00010111 #b01001111000010100100011)))
; expect = -4521712578199552.0

(assert (= expect result))

(check-sat)
(exit)
