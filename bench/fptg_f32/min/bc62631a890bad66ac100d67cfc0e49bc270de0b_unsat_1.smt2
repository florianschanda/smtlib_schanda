(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010001 #b11111111100110001110101)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b0 #b11001000 #b01111011001100000100000)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01001001100011110010001)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b01011000 #b00100001110101011010000)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101000 #b10110010111110111101011)
                expect
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                expect
                (fp #b0 #b10101001 #b11110111101010000001100)))
; expect = -1316616.0

(assert (not (= expect result)))

(check-sat)
(exit)
