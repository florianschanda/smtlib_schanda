(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001110 #b01011010001001010100000)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b1 #b00010111 #b11001010000110101101110)))
; arg1 = -19824648192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100100 #b10001011101100101111001)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b1 #b10000001 #b00011000000011011001111)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b11001100110101000100010)
                expect
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                expect
                (fp #b0 #b00101011 #b01111111011101000101011)))
; expect = -19824648192.0

(assert (not (= expect result)))

(check-sat)
(exit)
