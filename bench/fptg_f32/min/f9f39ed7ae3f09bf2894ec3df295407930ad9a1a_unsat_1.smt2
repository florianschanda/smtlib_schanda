; Format: FLOAT32
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111100 #b00001110100101100001101)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b10011011 #b11011101011000101010010)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001111 #b00000011100000110101101)
                expect
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                expect
                (fp #b0 #b10101000 #b00001101001011111100101)))
; expect = 1.63676726818084716796875

(assert (not (= expect result)))

(check-sat)
(exit)
