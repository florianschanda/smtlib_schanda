(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11110101 #b00001101001011111111011)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001011 #b00101011111000100101111)
                expect
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                expect
