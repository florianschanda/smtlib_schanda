(assert (fp.leq (fp #b1 #b11000011 #b00001010000101110100111)
                expect
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                expect
                (fp #b1 #b10000010 #b01101000011111111001001)))
; expect = -18446742974197923840.0

(assert (= expect result))

(check-sat)
