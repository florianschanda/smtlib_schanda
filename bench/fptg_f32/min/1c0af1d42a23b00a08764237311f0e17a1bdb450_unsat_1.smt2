(assert (fp.leq (fp #b1 #b11000011 #b10000001101101100111011)
                expect
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                expect
                (fp #b0 #b01110010 #b11010001100110110011100)))
; expect = -1316616.0

(assert (not (= expect result)))

