; Format: FLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101101 #b11101111101101001111111)
                arg1
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b00010100 #b00100101100011111111000)))
; arg1 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11001101 #b10000010011010111001100)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b01111011 #b10111000011110111001100)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011101 #b01100011000000110000001)
                expect
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                expect
                (fp #b1 #b01011001 #b01001101001101111110101)))
; expect = -2174573.0

(assert (= expect result))

(check-sat)
(exit)
