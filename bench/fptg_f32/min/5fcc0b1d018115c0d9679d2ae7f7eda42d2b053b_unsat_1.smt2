(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -NAN
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00100110 #b01110010001100010100110)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11110010 #b00010000111011011000100)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101010 #b10101001110011111101000)
                expect
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                expect
                (fp #b0 #b11011011 #b00110011001001011011100)))
; expect = 2987951.0

(assert (not (= expect result)))

(check-sat)
(exit)
