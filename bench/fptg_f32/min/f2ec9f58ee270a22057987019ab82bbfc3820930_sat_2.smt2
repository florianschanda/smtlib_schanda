(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ONE
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001111 #b10001011011010000111111)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00100010 #b11010111110010000101011)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01111101 #b00100101100001101011000)
                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110000 #b00011011010101110001001)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b00111111 #b11000001000001010000111)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
