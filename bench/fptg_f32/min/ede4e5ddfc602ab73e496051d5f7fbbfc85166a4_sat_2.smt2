(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -ZERO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100010 #b11011111010111010100110)
                arg1
                (fp #b0 #b00000000 #b11010100101111110101111)))
(assert (fp.leq (fp #b0 #b00000000 #b11010100101111110101111)
                arg1
                (fp #b0 #b10001001 #b10111011101010100110000)))
; arg1 = 0.00000000000000000000000000000000000000976888739863070481951837620501440851507153415828511504132353945523202336242984955561041715554893016815185546875

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10111100 #b10000110101000111110110)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11011011 #b00001000001010011000110)))
; arg2 = -0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11110100 #b11111110010100001111001)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11001010 #b01110001000000110101111)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
