; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010110 #b10110011010111110100000)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b0 #b10110010 #b01001111111011001110110)))
; arg1 = -1.040654659271240234375

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111100 #b01110011101100100101110)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10001101 #b10111000100101101000001)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001010 #b11111010110100010001011)
                expect
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                expect
                (fp #b0 #b11101100 #b10011010001000001010000)))
; expect = -1.040654659271240234375

(assert (not (= expect result)))

(check-sat)
(exit)
