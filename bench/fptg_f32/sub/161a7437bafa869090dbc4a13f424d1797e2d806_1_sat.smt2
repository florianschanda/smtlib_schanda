(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100101 #b10010001111001011000001)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10010010 #b11001000111111010011010)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100001 #b10111111100000111000010)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b1 #b01101100 #b00001011111101001110101)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111000 #b10010011101110000100011)
                expect
                (fp #b0 #b11100001 #b01011110011101100001110)))
(assert (fp.leq (fp #b0 #b11100001 #b01011110011101100001110)
                expect
                (fp #b0 #b11100010 #b00101110000110100101001)))
; expect = 433850155641787282585418727424.0

(assert (= expect result))

(check-sat)
(exit)
