                arg2
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b00011011 #b11100110111101110010010)))
; arg2 = -0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011011 #b01100111011111000110100)
                expect
                (fp #b0 #b01111111 #b11101000110101111010000)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111010000)
                expect
                (fp #b0 #b11100110 #b11100010101000000100011)))
; expect = 1.9095401763916015625

(assert (= expect result))

(check-sat)
(exit)
