; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011000 #b01110001000100111100111)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11110101 #b11010011101011001001001)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110010 #b00111101000100101111001)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b01100101 #b10111010101011100111000)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001010 #b01111101110101100001101)
                expect
                (fp #b0 #b11011110 #b00010111011000011011001)))
(assert (fp.leq (fp #b0 #b11011110 #b00010111011000011011001)
                expect
                (fp #b0 #b11101011 #b10001111000110110001111)))
; expect = 43232212062945922000504225792.0

(assert (not (= expect result)))

(check-sat)
(exit)
