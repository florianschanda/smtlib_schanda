; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11100100111011111000000)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b10011101 #b00011001110100001101010)))
; arg1 = 838177.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01000010 #b00111110101100010010111)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b11110101 #b11101011010011100101001)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000000 #b11111000101000101111111)
                expect
                (fp #b0 #b10010010 #b10011001010001000001111)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000001111)
                expect
                (fp #b0 #b11101010 #b01010010101110010011100)))
; expect = 838176.9375

(assert (not (= expect result)))

(check-sat)
(exit)
