; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010101 #b10110011111110101000000)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b10100011 #b01111101011110110111101)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b01011010 #b11100010100011011011101)))
; arg2 = -340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10001110 #b10011000110011010011110)
                expect
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                expect
                (fp #b0 #b11111111 #b00000000000000000000000)))
; expect = 340282346638528859811704183484516925440.0

(assert (not (= expect result)))

(check-sat)
(exit)
