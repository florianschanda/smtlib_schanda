(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b11111101000000101100110)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b01011110 #b00001100110001100011010)))
; arg1 = -19824648192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01011000 #b11111100111100010011000)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b10110111 #b10101011011010101100100)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101011 #b10000011111000000100111)
                expect
                (fp #b1 #b10100001 #b00100111011010010000101)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000101)
                expect
                (fp #b0 #b10101110 #b01110011101010111011001)))
; expect = -19824650240.0

(assert (not (= expect result)))

(check-sat)
(exit)
