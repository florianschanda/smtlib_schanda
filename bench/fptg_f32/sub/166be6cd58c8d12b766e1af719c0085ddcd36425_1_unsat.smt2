                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11010111 #b01110101011111101011111)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b01000110100010110010011)
                expect
                (fp #b1 #b10111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111110)
                expect
                (fp #b0 #b11001001 #b11000011101011111001001)))
; expect = -18446741874686296064.0

(assert (not (= expect result)))

(check-sat)
(exit)
