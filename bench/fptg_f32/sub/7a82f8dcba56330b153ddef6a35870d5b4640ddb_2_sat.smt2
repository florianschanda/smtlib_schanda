; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110101 #b10101011111111111010011)
                arg1
                (fp #b1 #b00000000 #b10101010101110000110010)))
(assert (fp.leq (fp #b1 #b00000000 #b10101010101110000110010)
                arg1
                (fp #b0 #b00111100 #b10001000011101011010100)))
; arg1 = -0.0000000000000000000000000000000000000078390906197842473151128329331162838047950527052918132227640646251414814627000993141336948610842227935791015625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101001 #b01100111010001100011110)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b1 #b00101101 #b11010000111000111110101)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101100 #b11001010011111101100101)
                expect
                (fp #b0 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b0 #b11100001 #b01011110011101100001111)
                expect
                (fp #b0 #b11100101 #b10101111100001010011100)))
; expect = 433850193420719145542580436992.0

(assert (= expect result))

(check-sat)
(exit)
