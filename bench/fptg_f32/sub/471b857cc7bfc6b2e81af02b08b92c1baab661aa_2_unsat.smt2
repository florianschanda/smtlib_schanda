(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b01101110000101110110110)
                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b0 #b01110001 #b10000010010011111010000)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000010 #b10101100010011111101101)
                expect
                (fp #b0 #b11011110 #b00010111011000011011001)))
(assert (fp.leq (fp #b0 #b11011110 #b00010111011000011011001)
                expect
                (fp #b0 #b11110101 #b00001011110110110001101)))
; expect = 43232212062945922000504225792.0

(assert (not (= expect result)))

(check-sat)
(exit)
