                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b01000110 #b10100110010000011001001)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10001110 #b00010010100101100011010)
                expect
                (fp #b0 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b0 #b10110011 #b00000001000001111001010)
                expect
                (fp #b0 #b11111000 #b10011111011100010000111)))
; expect = 4521712578199552.0

(assert (= expect result))

