                arg2
                (fp #b1 #b01110000 #b11001001001100110011000)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000111 #b01111100100101011001010)
                expect
                (fp #b0 #b10100101 #b01000111000110111111101)))
