                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11010010 #b10010110010100100011100)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000111 #b10100110101110010000011)
                expect
                (fp #b1 #b10110100 #b11100010010111001100101)))
(assert (fp.leq (fp #b1 #b10110100 #b11100010010111001100101)
                expect
                (fp #b0 #b01110010 #b10111011100101101011010)))
; expect = -16971620178460672.0

(assert (not (= expect result)))

(check-sat)
(exit)
