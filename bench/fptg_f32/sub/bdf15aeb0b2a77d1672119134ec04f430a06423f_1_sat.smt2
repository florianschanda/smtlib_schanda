(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110111 #b00100101110110001000001)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b0 #b10011111 #b01101111001010001001001)))
; arg1 = -1698008524581344716521472.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110010 #b11100101001001110111011)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b01010000 #b01001101001000100100111)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b10000010100100001011111)
                expect
                (fp #b1 #b11001111 #b01100111100100010011100)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011100)
                expect
                (fp #b1 #b10001100 #b11101010100001100100001)))
; expect = -1698008380466156640665600.0

(assert (= expect result))

(check-sat)
(exit)
