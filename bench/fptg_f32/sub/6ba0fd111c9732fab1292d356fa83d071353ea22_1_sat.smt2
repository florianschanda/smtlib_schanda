                arg2
                (fp #b0 #b00000000 #b00110101011010011001010)))
(assert (fp.leq (fp #b0 #b00000000 #b00110101011010011001010)
                arg2
                (fp #b0 #b11011000 #b10011000110111010111101)))
; arg2 = 0.0000000000000000000000000000000000000024525777956336526842379881438065104314570774953872316810131125376930223691562815702127409167587757110595703125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001011 #b10110111010000000010010)
                expect
                (fp #b0 #b01111111 #b11000100000000000001000)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001000)
                expect
                (fp #b0 #b11110110 #b00000000110110111111010)))
; expect = 1.76562595367431640625

(assert (= expect result))

(check-sat)
(exit)
