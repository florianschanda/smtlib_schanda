                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b01111010 #b01011100011110001011000)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010000 #b01110011010101011111010)
                expect
                (fp #b0 #b10100101 #b00010011010001111001001)))
(assert (fp.leq (fp #b0 #b10100101 #b00010011010001111001001)
                expect
                (fp #b0 #b10110111 #b10100011011100100110100)))
; expect = 295579189248.0

(assert (not (= expect result)))

(check-sat)
(exit)
