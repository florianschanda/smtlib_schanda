; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110100 #b11011111100000100111010)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b1 #b00001001 #b00001011010010000010101)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b00000101101010000110011)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10101111 #b11100010101010010010010)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001111 #b11010111000100111110100)
                expect
                (fp #b1 #b01111110 #b00110101101111100101100)))
(assert (fp.leq (fp #b1 #b01111110 #b00110101101111100101100)
                expect
                (fp #b0 #b11101001 #b11100011001010001110001)))
; expect = -0.6049678325653076171875

(assert (not (= expect result)))

(check-sat)
(exit)
