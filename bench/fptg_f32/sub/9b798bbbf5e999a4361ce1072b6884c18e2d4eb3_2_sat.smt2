                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11001000 #b10110000010001011111111)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001000 #b10100110010010110011110)
                expect
                (fp #b1 #b10110100 #b11100010010111001100111)))
(assert (fp.leq (fp #b1 #b10110100 #b11100010010111001100111)
                expect
                (fp #b1 #b01000101 #b01100100101000011010010)))
; expect = -16971622325944320.0

(assert (= expect result))

(check-sat)
(exit)
