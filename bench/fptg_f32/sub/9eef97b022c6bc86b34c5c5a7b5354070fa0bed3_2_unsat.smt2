                arg2
                (fp #b0 #b10111101 #b00111111000101110010011)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011101 #b11011100100001000010010)
                expect
                (fp #b0 #b10110011 #b00000001000010000110010)))
