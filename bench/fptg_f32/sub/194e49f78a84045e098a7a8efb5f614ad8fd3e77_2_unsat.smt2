                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b10111001 #b00111001000001110111001)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b00000011110000011100111)
                expect
                (fp #b0 #b01111111 #b11000100000000000001010)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001010)
                expect
                (fp #b0 #b10100110 #b11011011110001000000111)))
; expect = 1.7656261920928955078125

(assert (not (= expect result)))

(check-sat)
(exit)
