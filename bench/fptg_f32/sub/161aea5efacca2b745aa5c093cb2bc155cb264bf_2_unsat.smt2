(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101101 #b00100000111010110110001)
                arg1
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10100111 #b10101010010000101100110)))
; arg1 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b00011010101010000110111)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b1 #b00101111 #b00111111011111110011111)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110111 #b10101001010100100000010)
                expect
                (fp #b0 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b0 #b01111111 #b01110010101001111111010)
                expect
                (fp #b0 #b11000100 #b01101011111000111011010)))
; expect = 1.4478752613067626953125

(assert (not (= expect result)))

(check-sat)
(exit)
