; Format: FLOAT32
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00100000 #b11100110101000100100110)
                arg1
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg1
                (fp #b0 #b11010110 #b10110101000000111111111)))
; arg1 = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010000 #b10100110111010001001100)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b1 #b00110001 #b10010011011110100110000)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010000 #b00100011100100010010011)
                expect
                (fp #b0 #b01000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000001)
                expect
                (fp #b0 #b11000111 #b11011011111110011101101)))
; expect = 0.00000000000000000010842023017324751454180269995275498473574771196581423282623291015625

(assert (not (= expect result)))

(check-sat)
(exit)
