(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000000 #b01100111110110011100111)
                arg1
                (fp #b1 #b00100101 #b00100101010110111111100)))
(assert (fp.leq (fp #b1 #b00100101 #b00100101010110111111100)
                arg1
                (fp #b0 #b01100010 #b11011010110101101100010)))
; arg1 = -0.000000000000000000000000000925678583284292162965654627128430949396689468577914539082485134713351726531982421875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010110 #b11000100111010011110100)
                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b0 #b00100110 #b00111111011000000001101)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011000 #b01100110011011001011010)
                expect
                (fp #b0 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b0 #b10010100 #b11000011110011101010100)
                expect
                (fp #b0 #b11101100 #b01101100000100100001001)))
; expect = 3701205.0

(assert (= expect result))

(check-sat)
(exit)
