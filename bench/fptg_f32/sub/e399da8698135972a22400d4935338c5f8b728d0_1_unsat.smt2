                arg2
                (fp #b0 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b0 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b10000110 #b11110001111110111110000)))
; arg2 = 0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111110 #b11111110111110110001001)
                expect
                (fp #b0 #b10010110 #b01100010000010110010110)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010110)
                expect
                (fp #b0 #b11011000 #b10000011110101001010101)))
; expect = 11601302.0

(assert (not (= expect result)))

(check-sat)
(exit)
