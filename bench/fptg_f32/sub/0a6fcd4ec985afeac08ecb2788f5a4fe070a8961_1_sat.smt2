(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01111000 #b00111011000000101111111)
                arg1
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b01010001 #b10010010011101000010011)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111000 #b00111110111110101101000)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b10111111 #b00101001101100001001000)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b01100100100000101101100)
                expect
                (fp #b1 #b01111111 #b10100011000000110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10100011000000110010110)
                expect
                (fp #b1 #b00011100 #b01100011110001110101110)))
; expect = -1.6367671489715576171875

(assert (= expect result))

(check-sat)
(exit)
