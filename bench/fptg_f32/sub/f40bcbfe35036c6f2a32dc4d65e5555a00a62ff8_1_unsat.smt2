                arg2
                (fp #b1 #b10001111 #b11001110011011100000011)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01111011 #b10111010100101100111010)
