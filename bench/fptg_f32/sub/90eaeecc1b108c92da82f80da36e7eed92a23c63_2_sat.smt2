(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                arg2
                (fp #b0 #b10001001 #b01001101001011000001011)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010110 #b11001100011001000101100)
                expect
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                expect
                (fp #b0 #b11100100 #b10101000011011001100111)))
; expect = 12907478160253124608.0

(assert (= expect result))

