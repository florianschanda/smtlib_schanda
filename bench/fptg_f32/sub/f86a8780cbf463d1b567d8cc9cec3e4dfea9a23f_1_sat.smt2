(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11001011 #b00110000100000111111001)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b01100100 #b11101100110100100110000)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111110 #b00001100010110110111101)
                expect
                (fp #b0 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b0 #b01111111 #b01110010101001111111010)
                expect
                (fp #b0 #b10111000 #b00101110111011101110011)))
; expect = 1.4478752613067626953125

(assert (= expect result))

(check-sat)
(exit)
