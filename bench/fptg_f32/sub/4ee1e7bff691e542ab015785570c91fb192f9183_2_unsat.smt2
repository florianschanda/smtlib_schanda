; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01011101 #b11101100000001011100111)
                arg1
                (fp #b1 #b00101111 #b10100010101001001111101)))
(assert (fp.leq (fp #b1 #b00101111 #b10100010101001001111101)
                arg1
                (fp #b0 #b00010110 #b10100100100111100011000)))
; arg1 = -0.0000000000000000000000013527131409011845136628319390346207964394287248666159939602948725223541259765625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111110 #b00010010101101001110100)
                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b1 #b00000011 #b10110000011011111001111)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010011 #b11010001011100100011111)
                expect
                (fp #b0 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b0 #b10010100 #b11000011110011101010100)
                expect
                (fp #b0 #b11010100 #b11000011001000001000001)))
; expect = 3701205.0

(assert (not (= expect result)))

(check-sat)
(exit)
