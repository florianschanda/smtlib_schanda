(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00001110 #b00100011110101101111010)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b10111100 #b00111110100101111010000)))
; arg1 = 11601303.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101100 #b00000110000111000111110)
                arg2
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b10111000 #b01101100011011010000011)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000100 #b01000111100011101001100)
                expect
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                expect
                (fp #b0 #b11111010 #b00011111010011100000100)))
; expect = 11601303.0

(assert (= expect result))

(check-sat)
(exit)
