(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00100111 #b00010010000011111010011)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b11101000 #b01011100111110111110110)))
; arg1 = 1.90954005718231201171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b10000111001100100001000)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001111 #b10001011110111110011100)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10110001 #b10010110000010001000110)
                expect
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11111101 #b11100000001110110110011)))
; expect = 85070591730234615865843651857942052864.0

(assert (= expect result))

(check-sat)
(exit)
