(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100011 #b00111010011111111101011)
                arg2
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10010111 #b11000101001100010101000)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011011 #b00001010001101011011100)
                expect
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b11101010 #b01111001110111010011000)))
; expect = -16777216.0

(assert (= expect result))

(check-sat)
(exit)
