(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: -ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01111010 #b00001101100101110110111)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10011001 #b11111101101111100001001)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010101 #b11111110011111011001100)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b00111110 #b00111100010000000001110)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001010 #b00111101010100011001111)
                expect
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b10101010 #b11010001011100001010000)))
; expect = 16777216.0

(assert (not (= expect result)))

(check-sat)
(exit)
