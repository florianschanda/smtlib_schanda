; Format: FLOAT32
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00010001 #b11110011111100000101010)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111011 #b01011000000000011000110)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01101011 #b01111100111011001000111)
                arg2
                (fp #b1 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b1 #b00100011 #b00110101101110101101011)
                arg2
                (fp #b0 #b10111000 #b11100010111110110010110)))
; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110100 #b11101100010000011101011)
                expect
                (fp #b0 #b00100011 #b00110101101110101101011)))
(assert (fp.leq (fp #b0 #b00100011 #b00110101101110101101011)
                expect
                (fp #b0 #b10010011 #b10101001110000000100011)))
; expect = 0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(assert (not (= expect result)))

(check-sat)
(exit)
