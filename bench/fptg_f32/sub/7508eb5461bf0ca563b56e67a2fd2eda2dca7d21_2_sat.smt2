(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00011101 #b11000100010100100101000)
                arg1
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111110 #b00011100011101001011011)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010010 #b00101111111001010101001)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11010001 #b10100100101000100000100)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001110 #b00000100111110011101011)
                expect
                (fp #b0 #b11111101 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000001)
                expect
                (fp #b0 #b11111101 #b01011000111010100001110)))
; expect = 85070601871439417691678863831567695872.0

(assert (= expect result))

(check-sat)
(exit)
