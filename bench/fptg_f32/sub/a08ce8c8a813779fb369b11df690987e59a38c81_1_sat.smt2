; Format: FLOAT32
; Arg1: +SMALLEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100000 #b11001000101011101011001)
                arg1
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111001 #b01100101100000110011000)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01011010 #b10010000010010110001010)
                arg2
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b00000001 #b10110010001000111100101)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011001 #b00100001010100100111000)
                expect
                (fp #b0 #b00000010 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000010 #b00000000000000000000000)
                expect
                (fp #b0 #b11010000 #b01100100000010010010110)))
; expect = 0.00000000000000000000000000000000000002350988701644575015937473074444491355637331113544175043017503412556834518909454345703125

(assert (= expect result))

(check-sat)
(exit)
