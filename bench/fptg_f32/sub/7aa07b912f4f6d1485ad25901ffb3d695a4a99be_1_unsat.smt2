                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b1 #b00111000 #b11000111001110011101100)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010100 #b00001100000000000000010)
                expect
                (fp #b0 #b11011110 #b00010111011000011010111)))
(assert (fp.leq (fp #b0 #b11011110 #b00010111011000011010111)
                expect
                (fp #b0 #b11110001 #b11011101010001011010101)))
; expect = 43232202618212956261213798400.0

(assert (not (= expect result)))

(check-sat)
(exit)
