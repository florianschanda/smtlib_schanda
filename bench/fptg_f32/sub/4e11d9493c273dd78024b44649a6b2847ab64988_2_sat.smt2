; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010110 #b11100100011001000011001)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b0 #b01000100 #b01111100100000001111011)))
; arg1 = -14198738255872.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000111 #b10110111111110000110000)
                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b1 #b10011011 #b11001010010111010101101)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110001 #b01001000111111010011011)
                expect
                (fp #b0 #b10111110 #b11111111111111111110011)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111110011)
                expect
                (fp #b0 #b11011010 #b11111111000111000010101)))
; expect = 18446729780058390528.0

(assert (= expect result))

(check-sat)
(exit)
