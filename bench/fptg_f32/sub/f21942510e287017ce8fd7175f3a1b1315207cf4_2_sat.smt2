                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b10010111 #b00110100000001100110001)))
; arg2 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011110 #b00000010010001100011011)
                expect
                (fp #b1 #b01000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000001)
                expect
                (fp #b0 #b00000001 #b10110010111100100101001)))
; expect = -0.00000000000000000010842023017324751454180269995275498473574771196581423282623291015625

(assert (= expect result))

(check-sat)
