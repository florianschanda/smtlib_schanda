; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001110 #b11111001001010001111100)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01000100 #b00100001001100111010111)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00100011 #b01011001100011100010010)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b10010010 #b11100111000010000011001)))
; arg2 = -0.0000000000000000000000000000000000000059164194436288815055129368261491883180461313842729534869039744872745191506258066738155321218073368072509765625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111011 #b11001110000010010001011)
                expect
                (fp #b1 #b10010011 #b01000001011100000111111)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100000111111)
                expect
                (fp #b0 #b00000110 #b11111000001100011010010)))
; expect = -1316615.875

(assert (not (= expect result)))

(check-sat)
(exit)
