                arg2
                (fp #b1 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b1 #b11011110 #b00010111011000011011000)
                arg2
                (fp #b1 #b11000011 #b01000001100000010010000)))
; arg2 = -43232207340579439130859012096.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110110 #b10010100001011001000010)
                expect
                (fp #b0 #b11011110 #b00010111011000011011000)))
(assert (fp.leq (fp #b0 #b11011110 #b00010111011000011011000)
                expect
                (fp #b0 #b11111011 #b00101110010010101110100)))
; expect = 43232207340579439130859012096.0

(assert (not (= expect result)))

(check-sat)
(exit)
