(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b10001011 #b11011110110001000100010)))
; arg2 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011001 #b10101110100110100100011)
                expect
                (fp #b0 #b10010010 #b10011001010001000001111)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000001111)
                expect
                (fp #b0 #b10011011 #b01101001011110011100011)))
; expect = 838176.9375

(assert (not (= expect result)))

