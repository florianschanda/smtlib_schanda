                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b0 #b10100100 #b11111011011100000010101)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10010000 #b01010101101000011001100)
                expect
                (fp #b0 #b10100101 #b00010011010001111001001)))
(assert (fp.leq (fp #b0 #b10100101 #b00010011010001111001001)
                expect
                (fp #b0 #b11010010 #b10110001010111000001111)))
; expect = 295579189248.0

(assert (not (= expect result)))

(check-sat)
(exit)
