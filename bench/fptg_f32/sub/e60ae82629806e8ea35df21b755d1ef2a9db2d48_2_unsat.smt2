                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b11010110 #b11110001100010000000000)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010001 #b11000000011100101101111)
                expect
                (fp #b0 #b10110011 #b00000001000001111001011)))
(assert (fp.leq (fp #b0 #b10110011 #b00000001000001111001011)
                expect
                (fp #b0 #b11001010 #b11011001101011100111111)))
; expect = 4521713115070464.0

(assert (not (= expect result)))

(check-sat)
(exit)
