; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111000 #b10110011010110101011110)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b1 #b00010001 #b01010011111110011011100)))
; arg1 = -1.6049678325653076171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111101 #b11010111110010010111101)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b11100101 #b10011001011110011000100)))
; arg2 = -0.0000000000000000000000000000000000000059164194436288815055129368261491883180461313842729534869039744872745191506258066738155321218073368072509765625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100011 #b11101111111101111010100)
                expect
                (fp #b1 #b01111111 #b10011010110111110010101)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010101)
                expect
                (fp #b0 #b11010100 #b00010010010101000100011)))
; expect = -1.60496771335601806640625

(assert (= expect result))

(check-sat)
(exit)
