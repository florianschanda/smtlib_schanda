; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b11001111101000001001001)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11011100 #b01011010001001011101110)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b10000001101000000010101)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b00010100 #b01011000110001111011110)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010000 #b01100011101000011100000)
                expect
                (fp #b0 #b10100010 #b10011110101001110101111)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101001110101111)
                expect
                (fp #b0 #b11010000 #b11001100011001001100100)))
; expect = 55653888000.0

(assert (not (= expect result)))

(check-sat)
(exit)
