                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b01100001 #b01011100111001000110111)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101100 #b10101001001001001000111)
                expect
                (fp #b0 #b10010100 #b00001001011100110110101)))
(assert (fp.leq (fp #b0 #b10010100 #b00001001011100110110101)
                expect
                (fp #b0 #b10101100 #b11010000011111010111100)))
; expect = 2174573.25

(assert (not (= expect result)))

