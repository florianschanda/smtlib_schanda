                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111000 #b00110001100010101110010)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110000 #b11000010101101001001100)
                expect
                (fp #b1 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b1 #b11101111 #b00010110010101110011010)
                expect
                (fp #b0 #b11001001 #b11001101100000001000100)))
; expect = -5645418813174416085171547869806592.0

(assert (= expect result))

(check-sat)
(exit)
