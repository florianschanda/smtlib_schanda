; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010101 #b10111100011101111111101)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b11001111 #b11010101010100011011001)))
; arg1 = 0.00000000000000000000000000000000000000621094295356220723266261538623547960060248555895461769529610334211419155059363816917539224959909915924072265625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001001 #b11100000110110111110000)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11110001 #b01101110110110100111010)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011111 #b10100111100001101001010)
                expect
                (fp #b1 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b1 #b10010100 #b01101100101111010111100)
                expect
                (fp #b1 #b00101010 #b11111101101111001010110)))
; expect = -2987951.0

(assert (not (= expect result)))

(check-sat)
(exit)
