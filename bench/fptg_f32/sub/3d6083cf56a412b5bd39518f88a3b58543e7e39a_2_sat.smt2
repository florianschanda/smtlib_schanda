(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100110 #b10011101111111100010110)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b1 #b00111010 #b11001101110110001100010)))
; arg1 = -18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001011 #b11010000011100010101100)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b00011000 #b00011011111001001001011)))
; arg2 = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b00010111011111110110001)
                expect
                (fp #b1 #b10111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11110000 #b11001000011111001001100)))
; expect = -18446744073709551616.0

(assert (= expect result))

(check-sat)
(exit)
