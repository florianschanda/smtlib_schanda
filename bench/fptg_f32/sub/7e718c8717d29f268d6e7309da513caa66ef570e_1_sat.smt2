; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010010 #b00111111110110101001001)
                arg1
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                arg1
                (fp #b0 #b11010011 #b11110001000000001001001)))
; arg1 = 22559420300669994798153728.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101111 #b11101100110001101001000)
                arg2
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg2
                (fp #b0 #b01001111 #b01101100010000011101110)))
; arg2 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111100 #b00110000011110001011111)
                expect
                (fp #b0 #b11010011 #b00101010100100100100100)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100100)
                expect
                (fp #b0 #b11100110 #b01000010110011100011101)))
; expect = 22559417994826985584459776.0

(assert (= expect result))

(check-sat)
(exit)
