; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01110000 #b10100000111101000010000)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11011001 #b10110111000101101111101)))
; arg1 = 12907478160253124608.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b10100000100110111001000)
                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b0 #b11111100 #b11010101000110101111001)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101101 #b10100001011101011110101)
                expect
                (fp #b0 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b0 #b11100001 #b01011110011101100001111)
                expect
                (fp #b0 #b11100011 #b10100101001000110010100)))
; expect = 433850193420719145542580436992.0

(assert (not (= expect result)))

(check-sat)
(exit)
