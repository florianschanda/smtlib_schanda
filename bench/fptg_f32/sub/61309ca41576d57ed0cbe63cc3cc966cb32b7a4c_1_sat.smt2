(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001010 #b01110000100100101000111)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b1 #b01100001 #b00101111101111110000010)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01101001 #b10100011000000100011101)
                expect
                (fp #b0 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b0 #b01111111 #b01110010101001111111010)
                expect
                (fp #b0 #b10110101 #b10001001111101111111010)))
; expect = 1.4478752613067626953125

(assert (= expect result))

(check-sat)
(exit)
