(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000001 #b11110010001010001001011)
                expect
                (fp #b1 #b10000000 #b01010110101101011100010)))
