                arg2
                (fp #b0 #b11111100 #b11110110011101011010000)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010000 #b00110100100010110111101)
                expect
                (fp #b0 #b01111011 #b00111011000001001100000)))
(assert (fp.leq (fp #b0 #b01111011 #b00111011000001001100000)
                expect
                (fp #b0 #b10011000 #b11101000100011100001101)))
; expect = 0.0769088268280029296875

(assert (= expect result))

