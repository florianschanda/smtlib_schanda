                arg2
                (fp #b0 #b11111010 #b00100000101010001111111)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001111 #b10011001001000100000010)
                expect
                (fp #b1 #b01111111 #b10100011000000110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10100011000000110010110)
                expect
                (fp #b0 #b10100100 #b00111100010110110011000)))
; expect = -1.6367671489715576171875

(assert (not (= expect result)))

