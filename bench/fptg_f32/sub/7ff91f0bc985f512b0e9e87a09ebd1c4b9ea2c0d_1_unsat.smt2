                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111110 #b10000110011100100001010)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b11010000000000110001001)
                expect
                (fp #b1 #b11111101 #b00000000000001000101100)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000001000101100)
                expect
                (fp #b1 #b01011011 #b11011011001001110000110)))
; expect = -85076230240104431030221509193799565312.0

(assert (not (= expect result)))

(check-sat)
(exit)
