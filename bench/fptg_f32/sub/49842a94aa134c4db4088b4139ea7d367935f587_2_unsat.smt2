                arg2
                (fp #b0 #b11011111 #b10111100100100010011101)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011010 #b11110011010111101110000)
                expect
                (fp #b0 #b10111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11111101 #b00010011110001100000100)))
; expect = 18446744073709551616.0

(assert (not (= expect result)))

