(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11111000 #b11100100110010111010111)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111011 #b10101101101111101110010)
                expect
                (fp #b1 #b11101111 #b00010110010101110011011)))
(assert (fp.leq (fp #b1 #b11101111 #b00010110010101110011011)
                expect
                (fp #b0 #b10101110 #b00110000001100010011100)))
; expect = -5645419432144435727861685319368704.0

(assert (= expect result))

