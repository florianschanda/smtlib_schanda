(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000110 #b00000011100101000100100)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b10101011 #b11010111010100101001010)))
; arg1 = 1.90954005718231201171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01111011 #b11011010001000111100100)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11001111 #b00000110011001001000110)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010101 #b10000110100110110101010)
                expect
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                expect
                (fp #b1 #b00101011 #b01100111111110101000000)))
; expect = -18446742974197923840.0

(assert (= expect result))

(check-sat)
(exit)
