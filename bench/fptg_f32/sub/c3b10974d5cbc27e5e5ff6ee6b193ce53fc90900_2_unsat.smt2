(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11010000 #b10000011111111101111100)))
; arg2 = 16777216.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010000 #b11000111010110010100001)
                expect
                (fp #b1 #b10010111 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000001)
                expect
                (fp #b1 #b00001111 #b10011110101101011110001)))
; expect = -16777218.0

(assert (not (= expect result)))

