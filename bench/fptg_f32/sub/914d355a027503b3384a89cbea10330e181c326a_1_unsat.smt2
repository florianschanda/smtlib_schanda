                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b01010001 #b10101011001110110101110)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101111 #b00011100100100010001011)
                expect
                (fp #b0 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b0 #b10110011 #b00000001000001111001010)
                expect
                (fp #b0 #b11100100 #b10000000100000010101010)))
; expect = 4521712578199552.0

(assert (not (= expect result)))

