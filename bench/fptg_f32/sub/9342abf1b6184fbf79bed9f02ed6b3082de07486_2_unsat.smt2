(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11011110 #b00110011100010000011100)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001011 #b01000100011111001101100)
                expect
                (fp #b1 #b10111110 #b11111111111011011100101)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111011011100101)
                expect
                (fp #b1 #b01100000 #b10110110110111010010101)))
; expect = -18444181112105205760.0

(assert (not (= expect result)))

