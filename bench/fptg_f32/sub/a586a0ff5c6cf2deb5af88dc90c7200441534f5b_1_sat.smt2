(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000010 #b00001011010100111010001)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b1 #b01100000 #b01111110110100111101110)))
; arg1 = -18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01110000 #b11001111011111000011001)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11000100 #b10111100111001110000111)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110001 #b10100000101010101001010)
                expect
                (fp #b1 #b10111111 #b00000000110011110101100)))
(assert (fp.leq (fp #b1 #b10111111 #b00000000110011110101100)
                expect
                (fp #b0 #b11110100 #b10010000100100111100100)))
; expect = -18505106150911901696.0

(assert (= expect result))

(check-sat)
(exit)
