; Format: FLOAT32
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001010 #b11010000101000111110101)
                arg1
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111101 #b10000110001110010110101)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b01000100000001000101011)
                arg2
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg2 = 340282346638528859811704183484516925440.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b10011000100101101110000)
                expect
                (fp #b1 #b11111110 #b01111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b01111111111111111111111)
                expect
                (fp #b0 #b01001101 #b11110011101001111110001)))
; expect = -255211754908294243945860531626574872576.0

(assert (= expect result))

(check-sat)
(exit)
