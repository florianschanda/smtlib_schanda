(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01101000 #b00000101001011011001101)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b11111110 #b10000101110100010100001)))
; arg1 = 1.90954005718231201171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00000111 #b11101111101010111111101)
                arg2
                (fp #b0 #b01101011 #b11101001101001110111010)))
(assert (fp.leq (fp #b0 #b01101011 #b11101001101001110111010)
                arg2
                (fp #b0 #b01111110 #b01101110101011010110110)))
; arg2 = 0.000001824103719627601094543933868408203125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000110 #b01110110011010010101100)
                expect
                (fp #b0 #b01111111 #b11101000110101111000000)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111000000)
                expect
                (fp #b0 #b10110001 #b11111111011100111101001)))
; expect = 1.90953826904296875

(assert (= expect result))

(check-sat)
(exit)
