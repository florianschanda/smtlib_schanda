(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01000001 #b11111011010100100100100)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b10011100 #b10111011111110110001011)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01010000 #b10101100000101001110110)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b00000010 #b00101110111101111111101)))
; arg2 = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001011 #b10101101100100101011001)
                expect
                (fp #b0 #b01111111 #b11000100000000000001000)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001000)
                expect
                (fp #b0 #b10110101 #b00101100101101101101011)))
; expect = 1.76562595367431640625

(assert (= expect result))

(check-sat)
(exit)
