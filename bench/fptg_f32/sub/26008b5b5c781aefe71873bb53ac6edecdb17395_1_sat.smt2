(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100111 #b00010100001011100011111)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11110101 #b11000010000000001010001)))
; arg1 = 12907478160253124608.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111010 #b10100011111010010110001)
                arg2
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b00010010 #b11111011110111101010101)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111101 #b01101100101001011100110)
                expect
                (fp #b0 #b10111110 #b01100110010000010010010)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010010)
                expect
                (fp #b0 #b11110010 #b01110110010000110100100)))
; expect = 12907477060741496832.0

(assert (= expect result))

(check-sat)
(exit)
