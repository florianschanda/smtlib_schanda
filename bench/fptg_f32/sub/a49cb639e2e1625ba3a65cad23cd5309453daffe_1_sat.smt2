(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011101 #b01010001111101001011010)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11110101 #b01000011100000001000111)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110100 #b11001110111000011100111)
                expect
                (fp #b1 #b11101111 #b00010110010101110011001)))
(assert (fp.leq (fp #b1 #b11101111 #b00010110010101110011001)
                expect
                (fp #b0 #b00010000 #b10100000101000000111011)))
; expect = -5645418194204396442481410420244480.0

(assert (= expect result))

(check-sat)
(exit)
