(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00011010 #b11100000011000111100010)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b10111000 #b01101010010000111101011)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101000 #b01101111000100110001111)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b01011010 #b00010111101101010010010)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001000 #b01010000110111001000010)
                expect
                (fp #b0 #b10100101 #b00010011010001111001011)))
(assert (fp.leq (fp #b0 #b10100101 #b00010011010001111001011)
                expect
                (fp #b0 #b11100001 #b01101101010010110011101)))
; expect = 295579254784.0

(assert (= expect result))

(check-sat)
(exit)
