(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01101101 #b00101110100011101101110)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b11000110 #b00100001001101111010100)))
; arg1 = 2562247297597440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b00001111000100001100111)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b01110111 #b11011111100101110111110)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100011 #b00001111011011110100110)
                expect
                (fp #b0 #b10110010 #b00100011010010110011100)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011100)
                expect
                (fp #b0 #b11000010 #b01101110000001011010001)))
; expect = 2562247566032896.0

(assert (not (= expect result)))

(check-sat)
(exit)
