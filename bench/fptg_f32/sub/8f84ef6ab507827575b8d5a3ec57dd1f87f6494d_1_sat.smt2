; Format: FLOAT32
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010100 #b01111011100100101011001)
                arg1
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b00111110 #b00101001101001101010010)))
; arg1 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00101010 #b11011001101101110111100)
                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b11001010 #b00111000011110101101000)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111010 #b00000111110100001000010)
                expect
                (fp #b1 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b1 #b01111111 #b10100011000000110010111)
                expect
                (fp #b1 #b00100101 #b01100111111010011100000)))
; expect = -1.63676726818084716796875

(assert (= expect result))

(check-sat)
(exit)
