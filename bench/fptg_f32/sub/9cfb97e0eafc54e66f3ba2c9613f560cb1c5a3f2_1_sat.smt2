; Format: FLOAT32
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b11010100010010110111011)
                arg1
                (fp #b0 #b00000000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000)
                arg1
                (fp #b0 #b10101110 #b01000100000110111000001)))
; arg1 = 0.00000000000000000000000000000000000000293873587705571876992184134305561419454666389193021880377187926569604314863681793212890625

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01001111 #b00001111000111101110111)
                arg2
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                arg2
                (fp #b0 #b10001111 #b00010111001100001011101)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100101 #b10000000101111100101001)
                expect
                (fp #b1 #b01111111 #b10110000010011111100010)))
(assert (fp.leq (fp #b1 #b01111111 #b10110000010011111100010)
                expect
                (fp #b1 #b00001111 #b00010111100110000010101)))
; expect = -1.6887171268463134765625

(assert (= expect result))

(check-sat)
(exit)
