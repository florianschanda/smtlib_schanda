(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000001 #b00001001001011010011000)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b10001011 #b01011101100000011101010)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10010110 #b11110100011000010001111)
                arg2
                (fp #b1 #b00011111 #b01100100001110100011101)))
(assert (fp.leq (fp #b1 #b00011111 #b01100100001110100011101)
                arg2
                (fp #b0 #b01001011 #b00010111100000111100111)))
; arg2 = -0.00000000000000000000000000001756336916919526116167098104910924787843592479960087848755989625715301372110843658447265625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b11101011101101110100110)
                expect
                (fp #b1 #b10110000 #b11011100001000011101110)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101110)
                expect
                (fp #b0 #b01010001 #b00001101000110010111111)))
; expect = -1047025919459328.0

(assert (= expect result))

(check-sat)
(exit)
