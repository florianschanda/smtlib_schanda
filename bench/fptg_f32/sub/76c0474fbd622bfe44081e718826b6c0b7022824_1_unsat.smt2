(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110100 #b01010000010110011001111)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b10101000 #b01101011110110000000110)))
; arg1 = 11601303.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10011000 #b11001111011000110011011)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11110011 #b01001001110010111011101)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111110 #b10010111010000111110100)
                expect
                (fp #b1 #b10110110 #b10011110101101010110101)))
(assert (fp.leq (fp #b1 #b10110110 #b10011110101101010110101)
                expect
                (fp #b1 #b10011011 #b11100011101101101111110)))
; expect = -58365053614686208.0

(assert (not (= expect result)))

(check-sat)
(exit)
