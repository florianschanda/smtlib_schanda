(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00110001 #b10000111000110000000000)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11001000 #b01111000111110010110100)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b01000010100010110011110)
                expect
                (fp #b1 #b10111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111110)
                expect
                (fp #b0 #b00011100 #b00011011011111000000011)))
; expect = -18446741874686296064.0

(assert (= expect result))

(check-sat)
(exit)
