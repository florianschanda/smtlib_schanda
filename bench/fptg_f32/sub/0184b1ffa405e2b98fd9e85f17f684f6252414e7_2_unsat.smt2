(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001001 #b11111010111110000011100)
                arg2
                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b10111100 #b01100110011111111001101)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b10110000100110110110100)
                expect
                (fp #b1 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b1 #b10110100 #b11100010010111001100110)
                expect
                (fp #b1 #b00011011 #b00100010000010011100011)))
; expect = -16971621252202496.0

(assert (not (= expect result)))

(check-sat)
(exit)
