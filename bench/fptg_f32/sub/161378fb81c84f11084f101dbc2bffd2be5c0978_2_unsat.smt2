                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b00110010 #b00110011001111101010111)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101001 #b11001111101000011110011)
                expect
                (fp #b0 #b10000000 #b01110100011010111101000)))
(assert (fp.leq (fp #b0 #b10000000 #b01110100011010111101000)
                expect
                (fp #b0 #b11100010 #b11101101101110110001101)))
; expect = 2.9095401763916015625

(assert (not (= expect result)))

(check-sat)
(exit)
