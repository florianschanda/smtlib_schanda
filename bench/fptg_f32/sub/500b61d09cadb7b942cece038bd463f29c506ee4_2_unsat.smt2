; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11000010 #b01111100100110100100010)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b1 #b01010010 #b01110010110010011111101)))
; arg1 = -1047025986568192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00011111 #b01000001110001110001101)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b11111100 #b10100001101010011011110)))
; arg2 = -0.0000000000000000000000000000000000000059164194436288815055129368261491883180461313842729534869039744872745191506258066738155321218073368072509765625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b00101111010110110001000)
                expect
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                expect
                (fp #b1 #b10011001 #b10100100110010010101001)))
; expect = -1047025986568192.0

(assert (not (= expect result)))

(check-sat)
(exit)
