                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11011110 #b01100000111010110001010)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110100 #b00001000000101111011010)
                expect
                (fp #b1 #b10010101 #b00101010111110011100001)))
(assert (fp.leq (fp #b1 #b10010101 #b00101010111110011100001)
                expect
                (fp #b0 #b01000100 #b01111111100001001111110)))
; expect = -4898416.5

(assert (not (= expect result)))

