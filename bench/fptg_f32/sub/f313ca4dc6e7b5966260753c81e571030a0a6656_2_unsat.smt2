; Format: FLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011101 #b10010100101000110101100)
                arg1
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b00101010 #b00100000110010111111101)))
; arg1 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010101 #b00001100111100101011000)
                arg2
                (fp #b0 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b0 #b11101111 #b00010110010101110011010)
                arg2
                (fp #b0 #b11110000 #b10100000011111111110101)))
; arg2 = 5645418813174416085171547869806592.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110010 #b11001110011110101101100)
                expect
                (fp #b1 #b11101111 #b00010110010101110011010)))
(assert (fp.leq (fp #b1 #b11101111 #b00010110010101110011010)
                expect
                (fp #b0 #b10000111 #b11001111110110101001000)))
; expect = -5645418813174416085171547869806592.0

(assert (not (= expect result)))

(check-sat)
(exit)
