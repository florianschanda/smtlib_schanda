(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b01110111011011111010111)
                arg1
                (fp #b0 #b00101000 #b00111101011100011111111)))
(assert (fp.leq (fp #b0 #b00101000 #b00111101011100011111111)
                arg1
                (fp #b0 #b10100111 #b00000000011111011110010)))
; arg1 = 0.00000000000000000000000000801344552008936541742935047589268618360692185420557365205240785144269466400146484375

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b01110000000010010100010)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11110011 #b11001000101111011001111)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110010 #b00000101001101000001001)
                expect
                (fp #b1 #b10010101 #b00101010111110011011101)))
(assert (fp.leq (fp #b1 #b10010101 #b00101010111110011011101)
                expect
                (fp #b1 #b01001110 #b00110111110001101001010)))
; expect = -4898414.5

(assert (= expect result))

(check-sat)
(exit)
