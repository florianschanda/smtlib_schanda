(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010000 #b00010000000001101100100)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b10111100 #b00111111111110010100011)))
; arg1 = 2562247297597440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10101111 #b00101111001101010000100)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11111011 #b11010001001010001101110)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110110 #b10100110011100000000011)
                expect
                (fp #b1 #b10110110 #b10001100100000001011101)))
(assert (fp.leq (fp #b1 #b10110110 #b10001100100000001011101)
                expect
                (fp #b1 #b01110110 #b01110100110000101010111)))
; expect = -55802813564846080.0

(assert (= expect result))

(check-sat)
(exit)
