(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b10011001 #b00010011110111011000011)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111001 #b00111010010000101010110)
                expect
                (fp #b1 #b10010100 #b01101100101111010111101)))
(assert (fp.leq (fp #b1 #b10010100 #b01101100101111010111101)
                expect
                (fp #b1 #b01010000 #b01110110100011010011001)))
; expect = -2987951.25

(assert (not (= expect result)))

