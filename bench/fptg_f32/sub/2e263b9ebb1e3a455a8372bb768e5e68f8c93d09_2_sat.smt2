                arg2
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b10111110 #b10101001110101001001010)))
; arg2 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b11101000010000000010110)
                expect
                (fp #b1 #b11001111 #b01100111100100010011110)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011110)
                expect
                (fp #b0 #b11001101 #b01000101001000100111110)))
; expect = -1698008668696532792377344.0

(assert (= expect result))

(check-sat)
(exit)
