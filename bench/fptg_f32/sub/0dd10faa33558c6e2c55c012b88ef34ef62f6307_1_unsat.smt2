                (fp #b0 #b10110100 #b11100010010111001100110)))
(assert (fp.leq (fp #b0 #b10110100 #b11100010010111001100110)
                arg2
                (fp #b0 #b11110010 #b11000011011010001101111)))
; arg2 = 16971621252202496.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110100 #b01001001110111000110111)
                expect
                (fp #b0 #b10111110 #b11111111100001110110011)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111100001110110011)
                expect
                (fp #b0 #b11000011 #b00001101110110000000000)))
; expect = 18429770912711573504.0

(assert (not (= expect result)))

(check-sat)
(exit)
