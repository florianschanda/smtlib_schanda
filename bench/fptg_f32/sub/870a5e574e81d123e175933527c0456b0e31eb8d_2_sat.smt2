                arg2
                (fp #b0 #b01110101 #b10011000101000001010011)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01110100 #b01111111110110101010011)
                expect
                (fp #b0 #b01111111 #b01110010101001111111011)))
(assert (fp.leq (fp #b0 #b01111111 #b01110010101001111111011)
                expect
                (fp #b0 #b10111000 #b10100111001011001010010)))
; expect = 1.44787538051605224609375

(assert (= expect result))

