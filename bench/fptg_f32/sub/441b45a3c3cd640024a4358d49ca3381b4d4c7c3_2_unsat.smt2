                arg2
                (fp #b0 #b01111111 #b10100011000000110010111)))
(assert (fp.leq (fp #b0 #b01111111 #b10100011000000110010111)
                arg2
                (fp #b0 #b10010111 #b11100100000000101001111)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010101 #b10011101111011111111010)
                expect
                (fp #b1 #b10010011 #b01000001011100001001110)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001001110)
                expect
                (fp #b1 #b00000110 #b10010111010010101010011)))
; expect = -1316617.75

(assert (not (= expect result)))

(check-sat)
(exit)
