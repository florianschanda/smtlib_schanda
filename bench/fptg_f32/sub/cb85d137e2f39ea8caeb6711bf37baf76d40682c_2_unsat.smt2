                (fp #b0 #b10011111 #b00111110110010001000010)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10011100 #b11101100011010100100111)
                expect
                (fp #b0 #b10111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11111110 #b01101010101010001111101)))
; expect = 18446744073709551616.0

(assert (not (= expect result)))

