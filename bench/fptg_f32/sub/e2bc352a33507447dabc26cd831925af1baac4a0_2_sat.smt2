(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10001111 #b10001000100001110110101)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11001111 #b00111110110101010101111)))
; arg1 = 12907478160253124608.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001010 #b00001111110001011110010)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b10110011 #b11110010001001000010101)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001010 #b11001001101011000111110)
                expect
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                expect
                (fp #b0 #b11101111 #b00001000011011000100011)))
; expect = 12907478160253124608.0

(assert (= expect result))

(check-sat)
(exit)
