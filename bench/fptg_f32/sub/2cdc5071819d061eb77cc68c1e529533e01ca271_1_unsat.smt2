; Format: FLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011000 #b11000101101011110100010)
                arg1
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b01101100 #b11100010111010001010011)))
; arg1 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011000 #b10111101011001100101000)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b10011001 #b11011110001010001000001)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001110 #b01111000010110000100100)
                expect
                (fp #b0 #b01111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b01111110 #b11111111111111111111111)
                expect
                (fp #b0 #b10010101 #b10101110111001100111100)))
; expect = 0.999999940395355224609375

(assert (not (= expect result)))

(check-sat)
(exit)
