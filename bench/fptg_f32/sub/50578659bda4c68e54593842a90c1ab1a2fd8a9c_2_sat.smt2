(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01010010 #b11000011001001001110110)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b10001110 #b01011100011111001010001)))
; arg1 = 1.90954005718231201171875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11100100 #b10110000001011001000100)
                arg2
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b10000010 #b00110000011010011000101)))
; arg2 = -18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10001010 #b01100011010111110111011)
                expect
                (fp #b0 #b10111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11101111 #b11001100001100111000100)))
; expect = 18446744073709551616.0

(assert (= expect result))

(check-sat)
(exit)
