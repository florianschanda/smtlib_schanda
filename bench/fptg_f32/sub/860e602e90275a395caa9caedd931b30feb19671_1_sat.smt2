(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11110100 #b00100011100101101101101)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000010 #b11010100111110000001001)
                expect
                (fp #b1 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b1 #b10010100 #b01101100101111010111100)
                expect
                (fp #b0 #b11000100 #b11101011001101011111011)))
; expect = -2987951.0

(assert (= expect result))

(check-sat)
