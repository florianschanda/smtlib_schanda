                arg2
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b10110000 #b01000110111100001110011)))
; arg2 = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b11011100111000000001010)
                expect
                (fp #b1 #b11001111 #b01100111100100010011110)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011110)
                expect
                (fp #b0 #b10100010 #b01010110011110010011010)))
; expect = -1698008668696532792377344.0

(assert (= expect result))

(check-sat)
(exit)
