                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11001101 #b01111010010010010110001)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000011 #b11001001010100010000010)
                expect
                (fp #b1 #b10111110 #b11111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111110)
                expect
                (fp #b1 #b10010100 #b10010100110011010110100)))
; expect = -18446741874686296064.0

(assert (= expect result))

(check-sat)
