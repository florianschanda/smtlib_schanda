(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01111011 #b11010011100101001001111)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b11011111 #b10001000000001001111100)))
; arg1 = 838177.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b01100100001110101100101)
                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b0 #b01001101 #b10001110001010000010111)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101010 #b00010101100110010010000)
                expect
                (fp #b0 #b10110011 #b00000001000001111001011)))
(assert (fp.leq (fp #b0 #b10110011 #b00000001000001111001011)
                expect
                (fp #b0 #b11111010 #b11000010010011011110011)))
; expect = 4521713115070464.0

(assert (not (= expect result)))

(check-sat)
(exit)
