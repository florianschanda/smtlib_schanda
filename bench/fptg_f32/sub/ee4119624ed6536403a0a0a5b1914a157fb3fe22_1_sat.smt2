(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01101011 #b01001011010111101011000)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10011000 #b11000111010011011111111)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00001101 #b11111000101001001011001)
                arg2
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg2
                (fp #b0 #b11001101 #b11101100011100010100111)))
; arg2 = 18446742974197923840.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001010 #b01001010001110110101001)
                expect
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                expect
                (fp #b1 #b10000010 #b01010110001010000100001)))
; expect = -18446742974197923840.0

(assert (= expect result))

(check-sat)
(exit)
