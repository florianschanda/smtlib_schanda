(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00000111 #b11101110111001100010110)
                arg1
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b11111110 #b00000011010101111000110)))
; arg1 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01101110 #b11111011011110100100000)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11010000 #b11110001111101110111000)))
; arg2 = 1.0

(declare-const result Float32)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111101 #b10111001110110010001010)
                expect
                (fp #b1 #b01111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b01111110 #b11111111111111111111111)
                expect
                (fp #b0 #b10101111 #b01011011101100100100101)))
; expect = -0.999999940395355224609375

(assert (= expect result))

(check-sat)
(exit)
