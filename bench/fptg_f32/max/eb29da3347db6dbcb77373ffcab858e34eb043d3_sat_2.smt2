                arg2
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                arg2
                (fp #b0 #b10001111 #b11000110010110000110110)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000111 #b11010111001101110101011)
                expect
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                expect
                (fp #b0 #b11011111 #b11011110100011101100001)))
; expect = 1.68871724605560302734375

(assert (= expect result))

(check-sat)
(exit)
