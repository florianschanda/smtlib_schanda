(assert (fp.leq (fp #b1 #b11000000 #b11011010111110101011000)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
