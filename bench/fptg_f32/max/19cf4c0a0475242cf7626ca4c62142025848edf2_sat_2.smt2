(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ONE
; Arg2: +ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b11010100110001110101000)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11010101 #b01101001111111111010000)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111100 #b01001010110110011010011)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11100010 #b01101100011011001100100)))
; arg2 = 1.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110100 #b01100110110101100011000)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11000100 #b10100010010101100100001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
