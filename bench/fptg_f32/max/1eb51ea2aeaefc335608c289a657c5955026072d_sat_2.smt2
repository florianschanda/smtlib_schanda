; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110101 #b01100101101010010001011)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b11110001 #b00011010110000000000111)))
; arg1 = -0.00000000000000000000000000000000000000193308562634222785007100126523010614343659622777088600107578866935283123940081395630841143429279327392578125

(declare-const arg2 Float32)
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110110 #b11000010101011001000000)
                expect
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                expect
                (fp #b0 #b00001101 #b10000111011010000100001)))
; expect = -0.00000000000000000000000000000000000000193308562634222785007100126523010614343659622777088600107578866935283123940081395630841143429279327392578125

(assert (= expect result))

(check-sat)
(exit)
