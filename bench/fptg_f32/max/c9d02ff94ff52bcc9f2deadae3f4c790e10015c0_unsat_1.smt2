(assert (fp.leq (fp #b1 #b10110100 #b10001100011111000011110)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b00011001 #b01010110101100000011001)))
; arg1 = -19824648192.0

(declare-const arg2 Float32)
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000010 #b01100000110111001100101)
                expect
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                expect
                (fp #b0 #b01111100 #b11101011101011100011111)))
; expect = -19824648192.0

(assert (not (= expect result)))

(check-sat)
(exit)
