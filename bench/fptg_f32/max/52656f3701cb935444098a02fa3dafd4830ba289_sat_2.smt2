; Format: FLOAT32
; Arg1: -ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b10111000001000111101000)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b01010100 #b00010001110001100000001)))
; arg1 = -1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01011111 #b00000100011001110101101)
                arg2
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg2
                (fp #b0 #b10111111 #b01111010011011100110001)))
; arg2 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001011 #b00111000101010001001001)
                expect
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                expect
                (fp #b0 #b00011011 #b11010000011010101100110)))
; expect = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(assert (= expect result))

(check-sat)
(exit)
