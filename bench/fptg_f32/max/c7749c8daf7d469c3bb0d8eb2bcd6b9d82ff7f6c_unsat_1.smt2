                arg2
                (fp #b0 #b10111110 #b10010011011011100001111)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100001 #b11100110001001011100100)
                expect
                (fp #b0 #b01111111 #b10110000010011111100011)))
(assert (fp.leq (fp #b0 #b01111111 #b10110000010011111100011)
                expect
                (fp #b0 #b10110100 #b00101101100010100011100)))
; expect = 1.68871724605560302734375

(assert (not (= expect result)))

