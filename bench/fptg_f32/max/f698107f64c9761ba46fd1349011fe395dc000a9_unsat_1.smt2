; Format: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110111 #b11011010110110110100110)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b10000100 #b10000110101101111111100)))
; arg1 = -0.00000000000000000000000000000000000000193308562634222785007100126523010614343659622777088600107578866935283123940081395630841143429279327392578125

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01111010 #b11100110100001000010100)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b00100000 #b10111111100001000011011)))
; arg2 = 0.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01111111 #b00111101100011111001101)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b01000101 #b10011011101101000100100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
