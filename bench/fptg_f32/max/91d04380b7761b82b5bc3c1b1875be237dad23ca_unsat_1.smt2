; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110101 #b00000111010101000001000)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b01100111 #b01011010010001100110011)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b10101111010010111001100)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001100 #b11111011001101010100110)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101100 #b01110000110001111100100)
                expect
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                expect
                (fp #b1 #b01011100 #b11100011101110111101110)))
; expect = -3751329.0

(assert (not (= expect result)))

(check-sat)
(exit)
