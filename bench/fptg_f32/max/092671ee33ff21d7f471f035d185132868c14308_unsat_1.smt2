; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100011 #b11001101100101110000110)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00001000 #b11001110100011011001100)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11011101 #b00110011011001011110111)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b01010001 #b11000001100100110100010)))
; arg2 = -0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01000001 #b01011100101010111000010)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b00101010 #b01001101111010110110100)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
