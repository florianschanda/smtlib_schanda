(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110010 #b11100101001001110111011)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b01010000 #b01001101001000100100111)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000111 #b10001000011001101101011)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b00010011 #b11100100100111000010110)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
