                arg2
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                arg2
                (fp #b0 #b10000111 #b01111110111101001010001)))
; arg2 = -0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111000 #b11101100110001000101100)
                expect
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                expect
                (fp #b0 #b11100001 #b01010101001100101010111)))
; expect = 22559420300669994798153728.0

(assert (= expect result))

(check-sat)
