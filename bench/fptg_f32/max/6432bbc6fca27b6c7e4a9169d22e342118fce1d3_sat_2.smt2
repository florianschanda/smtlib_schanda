(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00001111 #b11100011111111011000111)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11101100 #b10001101100101010001111)))
; arg1 = 16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01000100 #b01110011101100110111100)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b10111111 #b01000101101010011000110)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001100 #b10101111000011101001011)
                expect
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                expect
                (fp #b0 #b11110011 #b01010011010001010101011)))
; expect = 58365057909653504.0

(assert (= expect result))

(check-sat)
(exit)
