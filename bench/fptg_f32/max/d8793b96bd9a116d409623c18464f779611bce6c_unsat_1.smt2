; Format: FLOAT32
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01000111 #b11010001001111001001001)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b10101100 #b11000100000110110010010)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110110 #b11110010010110110010110)
                expect
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                expect
                (fp #b0 #b10110000 #b00111111001011001101101)))
; expect = 494130912.0

(assert (not (= expect result)))

(check-sat)
(exit)
