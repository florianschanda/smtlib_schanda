; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101110 #b10101110011011101110101)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10110100 #b10111000010000001100001)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b10110101001110100011101)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b1 #b10011010 #b10010000110111001011000)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b11000110000100110001010)
                expect
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b00000101 #b00011011110101010001100)))
; expect = -16777216.0

(assert (not (= expect result)))

(check-sat)
(exit)
