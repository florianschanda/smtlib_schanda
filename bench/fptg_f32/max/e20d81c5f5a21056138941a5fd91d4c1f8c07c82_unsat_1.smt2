(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00110011111101111011101)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b01100001 #b01111010011111010110010)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100110 #b00111111011010111010010)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b01101010 #b01001111111111110111101)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b11011101010000010000010)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10001001 #b01010110010001010010001)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
