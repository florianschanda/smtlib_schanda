; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100100 #b10010110001001101011000)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b11110011 #b00000011111000101110100)))
; arg1 = -19824648192.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01010001 #b00011101011110011100001)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11011111 #b10010100011001100011001)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000110 #b10100000001010011111111)
                expect
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                expect
                (fp #b0 #b11110001 #b01101100001111000001100)))
; expect = 2987951.0

(assert (not (= expect result)))

(check-sat)
(exit)
