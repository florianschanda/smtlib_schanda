(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b01001000 #b10101100110001100110101)))
; arg1 = -340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10000011 #b00011010110111000110010)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11010101 #b11010000000011001001010)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000010 #b00011101110101101100111)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b01000011 #b11000011101111101111010)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
