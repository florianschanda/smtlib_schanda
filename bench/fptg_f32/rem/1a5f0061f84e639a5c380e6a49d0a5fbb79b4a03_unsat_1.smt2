(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111100 #b10010101010000011000110)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01010100 #b00011110000101011011100)))
; arg1 = -1316616.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10001011 #b01000011001111001110000)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b01010100 #b10001001000101110110001)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01111110 #b01101000111000101100100)
                expect
                (fp #b0 #b01111110 #b10110000101011001101000)))
(assert (fp.leq (fp #b0 #b01111110 #b10110000101011001101000)
                expect
                (fp #b0 #b10110011 #b11100011110010010101100)))
; expect = 0.845068454742431640625

(assert (not (= expect result)))

(check-sat)
(exit)
