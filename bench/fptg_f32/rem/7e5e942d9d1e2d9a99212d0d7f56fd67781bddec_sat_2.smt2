                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b01000010 #b00001000011110001111000)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001010 #b11110001011100001110000)
                expect
                (fp #b0 #b00000000 #b00000010100000000110110)))
(assert (fp.leq (fp #b0 #b00000000 #b00000010100000000110110)
                expect
                (fp #b0 #b01011100 #b11100101110111011011011)))
; expect = 0.0000000000000000000000000000000000000001148700403145625545719018088606075849455681924233855038740139155035817342120907369462656788527965545654296875

(assert (= expect result))

