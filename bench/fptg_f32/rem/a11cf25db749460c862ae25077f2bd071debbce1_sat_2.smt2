                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b10000010 #b00101011000101011110111)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000000 #b00101111110110000010100)
                expect
                (fp #b1 #b10100011 #b11000100101000000110000)))
(assert (fp.leq (fp #b1 #b10100011 #b11000100101000000110000)
                expect
                (fp #b0 #b11001100 #b01000000110011111100101)))
; expect = -121500991488.0

(assert (= expect result))

