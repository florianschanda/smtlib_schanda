                arg2
                (fp #b0 #b11110111 #b00010111101010101010101)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111101 #b10111110011111000010100)
                expect
                (fp #b1 #b01111110 #b01110010111100010001000)))
(assert (fp.leq (fp #b1 #b01111110 #b01110010111100010001000)
                expect
                (fp #b1 #b01010011 #b00001110101011100011101)))
; expect = -0.724495410919189453125

(assert (not (= expect result)))

