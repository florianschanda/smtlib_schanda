; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100001 #b11111100011100100011110)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111110 #b11111000001000010010001)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b01100000 #b10111000000000011000000)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b10101011 #b10101111000001100101110)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000010 #b00011111100001011100110)
                expect
                (fp #b1 #b10010011 #b11111100010010110011000)))
(assert (fp.leq (fp #b1 #b10010011 #b11111100010010110011000)
                expect
                (fp #b0 #b10000001 #b11010110010000110100010)))
; expect = -2081971.0

(assert (not (= expect result)))

(check-sat)
(exit)
