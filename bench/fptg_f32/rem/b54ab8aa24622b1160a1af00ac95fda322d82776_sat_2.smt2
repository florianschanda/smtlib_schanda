(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b01111011010100100111010)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b0 #b00100010 #b11000011011010101001000)))
; arg1 = -1.040654659271240234375

(declare-const arg2 Float32)
(assert (fp.isNaN arg2))
; arg2 = NaN

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
