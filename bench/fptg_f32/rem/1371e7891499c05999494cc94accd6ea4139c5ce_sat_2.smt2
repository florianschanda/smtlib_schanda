; Format: FLOAT32
; Arg1: +ONE
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01001011 #b00010001111011101001011)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111001 #b00110111000110000011110)))
; arg1 = 1.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10100100 #b01011010001010110100101)
                arg2
                (fp #b1 #b01111111 #b11010010101101101010010)))
(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b0 #b01110100 #b11000010001110010001100)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111011 #b00001101111011101000001)
                expect
                (fp #b1 #b01111110 #b10100101011011010100100)))
(assert (fp.leq (fp #b1 #b01111110 #b10100101011011010100100)
                expect
                (fp #b0 #b01100110 #b11010100111000001010110)))
; expect = -0.8230993747711181640625

(assert (= expect result))

(check-sat)
(exit)
