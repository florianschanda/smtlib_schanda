; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111100 #b11110001011001100011101)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b00110111 #b11001110111001010110111)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101000 #b10100011010011101000011)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b10000001 #b10100001001100100000111)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111110 #b11110110111011110100100)
                expect
                (fp #b0 #b00000000 #b00000010011010001011100)))
(assert (fp.leq (fp #b0 #b00000000 #b00000010011010001011100)
                expect
                (fp #b0 #b10111000 #b00111100010100101101001)))
; expect = 0.000000000000000000000000000000000000000110618500773801059578719213304905979403263877691732155022502970330260108067221835881355218589305877685546875

(assert (= expect result))

(check-sat)
