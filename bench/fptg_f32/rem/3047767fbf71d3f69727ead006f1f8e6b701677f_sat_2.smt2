(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b1 #b01101110 #b11000000100101101100011)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100111 #b11000110010010111100010)
                expect
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                expect
                (fp #b0 #b10111110 #b11110100111011110000101)))
; expect = 16777216.0

(assert (= expect result))

(check-sat)
