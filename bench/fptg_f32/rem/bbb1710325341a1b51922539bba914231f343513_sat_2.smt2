                (fp #b0 #b10111111 #b10101110110111011011011)))
; arg2 = 1.68871724605560302734375

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000011 #b01010010101001110000000)
                expect
                (fp #b1 #b01111110 #b01100000100011110000110)))
(assert (fp.leq (fp #b1 #b01111110 #b01100000100011110000110)
                expect
                (fp #b0 #b10111000 #b00110111111001011100001)))
; expect = -0.68859136104583740234375

(assert (= expect result))

