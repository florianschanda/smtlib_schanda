; Format: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00100100 #b01001100101111101101000)
                arg1
                (fp #b0 #b00000000 #b10000111010000110010101)))
(assert (fp.leq (fp #b0 #b00000000 #b10000111010000110010101)
                arg1
                (fp #b0 #b11100011 #b00011101001101111100100)))
; arg1 = 0.00000000000000000000000000000000000000621094295356220723266261538623547960060248555895461769529610334211419155059363816917539224959909915924072265625

(declare-const arg2 Float32)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10011000 #b11001111001110001110001)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b11001100 #b11101110100100011101011)))
; arg2 = -0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
