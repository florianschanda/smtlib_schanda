; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011000 #b01011111111110100110011)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b00010101 #b00011011110100111101000)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10101100 #b10011000010111010100110)
                arg2
                (fp #b1 #b00000000 #b10000000110110010010010)))
(assert (fp.leq (fp #b1 #b00000000 #b10000000110110010010010)
                arg2
                (fp #b0 #b11100010 #b01000011010110110100101)))
; arg2 = -0.0000000000000000000000000000000000000059164194436288815055129368261491883180461313842729534869039744872745191506258066738155321218073368072509765625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001010 #b01010110001110101110011)
                expect
                (fp #b0 #b00000000 #b00100011011101100101110)))
(assert (fp.leq (fp #b0 #b00000000 #b00100011011101100101110)
                expect
                (fp #b0 #b00100001 #b11101101110000010001000)))
; expect = 0.0000000000000000000000000000000000000016283508544993671809255014876703812420316027843187676222548660579284539318134505947455181740224361419677734375

(assert (= expect result))

(check-sat)
(exit)
