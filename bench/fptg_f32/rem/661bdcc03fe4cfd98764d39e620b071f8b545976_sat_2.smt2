; arg2 = -0.0000000000000000000000000002443337523960429071900470480785924266793062722101514960826307287788949906826019287109375

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000010 #b10010001111111001100101)
                expect
                (fp #b1 #b00100001 #b00010001001110111101000)))
(assert (fp.leq (fp #b1 #b00100001 #b00010001001110111101000)
                expect
                (fp #b0 #b00000000 #b11101101101011010000111)))
; expect = -0.000000000000000000000000000053885834655253520337134838852826504561292363278124373238142652553506195545196533203125

(assert (= expect result))

