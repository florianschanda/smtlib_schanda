(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110011 #b00000110011001100110001)
                arg2
                (fp #b0 #b00000000 #b00100010100110010110010)))
(assert (fp.leq (fp #b0 #b00000000 #b00100010100110010110010)
                arg2
                (fp #b0 #b00000100 #b01100001011100010011100)))
; arg2 = 0.0000000000000000000000000000000000000015887165287344040548914947201366092541744718555547322501664891385869150808307637134930700995028018951416015625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111001 #b10100010111100010101110)
                expect
                (fp #b0 #b00000000 #b00001100011100110101010)))
(assert (fp.leq (fp #b0 #b00000000 #b00001100011100110101010)
                expect
                (fp #b0 #b01100111 #b01010011111001110110110)))
; expect = 0.0000000000000000000000000000000000000005716989448783102189613213479314534034074587065228971515299052043247891863320120364733156748116016387939453125

(assert (= expect result))

(check-sat)
