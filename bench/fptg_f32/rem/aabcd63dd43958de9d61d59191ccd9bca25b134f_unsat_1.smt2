; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b10101000011010110011000)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b00111100 #b01010001100100000110001)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111101 #b11001000010011110010101)
                arg2
                (fp #b1 #b10010100 #b00001001011100110110100)))
(assert (fp.leq (fp #b1 #b10010100 #b00001001011100110110100)
                arg2
                (fp #b0 #b01110111 #b11111111100100001101000)))
; arg2 = -2174573.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101011 #b00011011000111001001111)
                expect
                (fp #b0 #b10010010 #b00101110011011010000000)))
(assert (fp.leq (fp #b0 #b10010010 #b00101110011011010000000)
                expect
                (fp #b0 #b10111111 #b01011100101110001111100)))
; expect = 619368.0

(assert (not (= expect result)))

(check-sat)
(exit)
