                expect
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                expect
                (fp #b0 #b10100100 #b00001111010001110000101)))
; expect = 0.000000000000000007176311283322198380889289648365547691355459392070770263671875

(assert (not (= expect result)))

