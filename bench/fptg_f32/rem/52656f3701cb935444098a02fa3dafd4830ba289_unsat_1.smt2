(assert (fp.leq (fp #b1 #b00001100 #b00111000101010001001001)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10001110 #b10000101111111001000001)))
; expect = -0

