(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INFINITY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))
; arg1 = -Infinity

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01111110 #b10010000111101001101110)
                arg2
                (fp #b1 #b00110100 #b01101010000010011110011)))
(assert (fp.leq (fp #b1 #b00110100 #b01101010000010011110011)
                arg2
                (fp #b0 #b11001111 #b10010101001101101101010)))
; arg2 = -0.00000000000000000000003743392066509216237576106995653467228446498182847790303640067577362060546875

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (not (= expect result)))

(check-sat)
(exit)
