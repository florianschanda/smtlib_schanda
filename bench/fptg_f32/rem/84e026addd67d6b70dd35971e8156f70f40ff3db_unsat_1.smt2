(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT32
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b10000001111110110001111)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10101101 #b00001111110111101100111)))
; arg1 = -16777216.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10110110 #b00111000110000100100111)
                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b11011110 #b01001000011001100100110)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010011 #b00100100010000111010001)
                expect
                (fp #b1 #b01111110 #b00000001001001011001100)))
(assert (fp.leq (fp #b1 #b01111110 #b00000001001001011001100)
                expect
                (fp #b0 #b11001110 #b00100001101110000110110)))
; expect = -0.5022399425506591796875

(assert (not (= expect result)))

(check-sat)
(exit)
