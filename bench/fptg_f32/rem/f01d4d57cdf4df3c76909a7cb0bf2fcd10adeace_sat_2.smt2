(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10011010 #b00011111100101010111010)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11111110 #b01001100100011000111001)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (= arg2 arg1))

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11000011 #b01110011011011101110100)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11001111 #b00101010001010101101010)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
