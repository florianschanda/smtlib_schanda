(assert (fp.leq (fp #b0 #b01111000 #b01111111000011000001010)
                expect
                (fp #b0 #b10010010 #b11101001010001111110000)))
(assert (fp.leq (fp #b0 #b10010010 #b11101001010001111110000)
                expect
                (fp #b0 #b10111010 #b00110101000011010001111)))
; expect = 1002047.0

(assert (not (= expect result)))

