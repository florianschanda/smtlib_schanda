(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110010 #b01010000001001001000101)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b10001100 #b10001110010010011111100)))
; arg1 = -3751329.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00111010 #b01001001111001011100101)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110111)
                arg2
                (fp #b0 #b11011110 #b11110011100000101111110)))
; arg2 = 494130912.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110100 #b01010001010000000111011)
                expect
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                expect
                (fp #b1 #b10010100 #b01110010000100011111001)))
; expect = -3751329.0

(assert (= expect result))

(check-sat)
(exit)
