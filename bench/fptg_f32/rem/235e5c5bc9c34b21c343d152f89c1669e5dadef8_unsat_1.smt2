; Format: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00101011 #b11110011101010011110101)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11101100 #b10011101011001001000111)))
; arg1 = 12907478160253124608.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10011101 #b00001000010001100101110)
                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b0 #b11000010 #b10100001011001111110100)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011100 #b01101111101101001000111)
                expect
                (fp #b1 #b10010010 #b01010110000001010010000)))
(assert (fp.leq (fp #b1 #b10010010 #b01010110000001010010000)
                expect
                (fp #b0 #b11010010 #b10100011010011000101101)))
; expect = -700457.0

(assert (not (= expect result)))

(check-sat)
(exit)
