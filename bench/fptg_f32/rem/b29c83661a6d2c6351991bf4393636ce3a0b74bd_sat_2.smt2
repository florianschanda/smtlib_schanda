; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00011010 #b10000010010100001100001)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11000101 #b10001000001001010010101)))
; arg1 = 55651713024.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11101010 #b10001111010100011010000)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b00011101 #b00110100110001100010010)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000100 #b10101011100111000100110)
                expect
                (fp #b0 #b10010011 #b10011100000000000000000)))
(assert (fp.leq (fp #b0 #b10010011 #b10011100000000000000000)
                expect
                (fp #b0 #b10100001 #b01011100000110110011010)))
; expect = 1687552.0

(assert (= expect result))

(check-sat)
(exit)
