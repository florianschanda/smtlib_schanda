; Format: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00010010010001010111110)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b0 #b00111000 #b11010001100010111010111)))
; arg1 = -14198738255872.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b00111001 #b10000110011000111111000)
                arg2
                (fp #b0 #b10010101 #b00101010111110011011110)))
(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11011110 #b11101000001010000101011)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100001 #b00001110001001000111000)
                expect
                (fp #b1 #b10010011 #b01101101111000111111000)))
(assert (fp.leq (fp #b1 #b10010011 #b01101101111000111111000)
                expect
                (fp #b0 #b11010010 #b00001010000110110110101)))
; expect = -1498687.0

(assert (= expect result))

(check-sat)
(exit)
