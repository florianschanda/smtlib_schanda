(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -ZERO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11000111 #b01111010110000100100110)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10110000 #b00111100000100000010011)))
; arg1 = -0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11110010 #b11100110110011100111100)
                arg2
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b11111110 #b01010001110101000110111)))
; arg2 = 85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11101000 #b00000010001001111101010)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b01111000 #b01010011001101101001010)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
