                arg2
                (fp #b1 #b00000000 #b01001110100111100100101)))
(assert (fp.leq (fp #b1 #b00000000 #b01001110100111100100101)
                arg2
                (fp #b0 #b11110001 #b10101111111001100011001)))
; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110011 #b11001110110110100011010)
                expect
                (fp #b0 #b00000000 #b00001011100000111001100)))
(assert (fp.leq (fp #b0 #b00000000 #b00001011100000111001100)
                expect
                (fp #b0 #b01001011 #b10011001110001010101101)))
; expect = 0.000000000000000000000000000000000000000528698700202038882322955781938619037002992588574474388557767806965347057168713718056096695363521575927734375

(assert (= expect result))

