                arg2
                (fp #b0 #b10000011 #b00110001000000011110000)))
; arg2 = 1.63676726818084716796875

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100111 #b11111011101101001000001)
                expect
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                expect
                (fp #b0 #b01000100 #b10000011011101110100001)))
; expect = -0.000000000000000000108420217248550443400745280086994171142578125

(assert (= expect result))

