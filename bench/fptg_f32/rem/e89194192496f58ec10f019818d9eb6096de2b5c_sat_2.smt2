                arg2
                (fp #b0 #b10010110 #b00101010000010101011011)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100001 #b10000110001000100101100)
                expect
                (fp #b0 #b10110001 #b10100011010110110000000)))
(assert (fp.leq (fp #b0 #b10110001 #b10100011010110110000000)
                expect
                (fp #b0 #b11001011 #b01101101110101110110101)))
; expect = 1844344856248320.0

(assert (= expect result))

