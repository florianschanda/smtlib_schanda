; Format: FLOAT32
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10100010 #b00100001000011000010010)
                arg1
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg1 = 340282346638528859811704183484516925440.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b10011111 #b10101110101000110000001)
                arg2
                (fp #b0 #b10110110 #b10011110101101010110110)))
(assert (fp.leq (fp #b0 #b10110110 #b10011110101101010110110)
                arg2
                (fp #b0 #b11000001 #b00110101001110101100101)))
; arg2 = 58365057909653504.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b10011100 #b10010000111101111111100)
                expect
                (fp #b0 #b10110100 #b00010111010011010110000)))
(assert (fp.leq (fp #b0 #b10110100 #b00010111010011010110000)
                expect
                (fp #b0 #b10111001 #b10011010010000011100110)))
; expect = 9827074151809024.0

(assert (= expect result))

(check-sat)
(exit)
