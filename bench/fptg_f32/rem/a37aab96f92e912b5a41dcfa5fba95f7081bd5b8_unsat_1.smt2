                arg2
                (fp #b0 #b11110010 #b01110100000110011111100)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010101 #b00100001101010010010110)
                expect
                (fp #b1 #b10010011 #b10110011111110100101000)))
(assert (fp.leq (fp #b1 #b10010011 #b10110011111110100101000)
                expect
                (fp #b1 #b01110000 #b01000001010011110111011)))
; expect = -1785765.0

(assert (not (= expect result)))

