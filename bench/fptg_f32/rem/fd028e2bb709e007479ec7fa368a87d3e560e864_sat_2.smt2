                arg2
                (fp #b1 #b01111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b01111111 #b01110010101001111111010)
                arg2
                (fp #b0 #b01111000 #b01000000100101110011010)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111111 #b11001110100011101011111)
                expect
                (fp #b1 #b01111110 #b01100010110000000110100)))
(assert (fp.leq (fp #b1 #b01111110 #b01100010110000000110100)
                expect
                (fp #b0 #b00001100 #b01111110000011001000010)))
; expect = -0.6928741931915283203125

(assert (= expect result))

(check-sat)
(exit)
