                arg2
                (fp #b1 #b00111001 #b10001110011001000111101)))
; arg2 = -1.4478752613067626953125

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b00110110100100001100101)
                expect
                (fp #b0 #b01111110 #b01011100111111010000000)))
(assert (fp.leq (fp #b0 #b01111110 #b01011100111111010000000)
                expect
                (fp #b0 #b10010101 #b11010000100011100001001)))
; expect = 0.68161773681640625

(assert (not (= expect result)))

