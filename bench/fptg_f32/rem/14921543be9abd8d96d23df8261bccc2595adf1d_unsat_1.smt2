; Format: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101011 #b01011001101000110001001)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b1 #b01101111 #b00101000100100001110000)))
; arg1 = -1698008524581344716521472.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11011001 #b01110011001000101101101)
                arg2
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b00100000 #b01111100010010011100001)))
; arg2 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01110110 #b01110100000101000100001)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11100111 #b10101100111101110001010)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
