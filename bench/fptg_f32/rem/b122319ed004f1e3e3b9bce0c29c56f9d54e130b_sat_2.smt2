                arg2
                (fp #b1 #b11100001 #b01011110011101100001111)))
(assert (fp.leq (fp #b1 #b11100001 #b01011110011101100001111)
                arg2
                (fp #b0 #b11000111 #b01010101111001001100001)))
; arg2 = -433850193420719145542580436992.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01100110 #b00010111010000001101110)
                expect
                (fp #b0 #b11100000 #b01011000110110110010000)))
(assert (fp.leq (fp #b0 #b11100000 #b01011000110110110010000)
                expect
                (fp #b0 #b11111010 #b01101101000000101010010)))
; expect = 213455498497531518518464348160.0

(assert (= expect result))

(check-sat)
(exit)
