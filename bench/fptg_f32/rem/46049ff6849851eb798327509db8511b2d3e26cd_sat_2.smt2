; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01000010 #b11110011101101110010000)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11101001 #b11100010010111011011001)))
; arg1 = 1.76562607288360595703125

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111001 #b11001001000111010010111)
                arg2
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b1 #b01101001 #b10001111000001010001000)))
; arg2 = -1.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111010 #b10110110000000101100001)
                expect
                (fp #b1 #b01111100 #b11011111111111110111000)))
(assert (fp.leq (fp #b1 #b01111100 #b11011111111111110111000)
                expect
                (fp #b0 #b10100100 #b00101000000110000001011)))
; expect = -0.23437392711639404296875

(assert (= expect result))

(check-sat)
(exit)
