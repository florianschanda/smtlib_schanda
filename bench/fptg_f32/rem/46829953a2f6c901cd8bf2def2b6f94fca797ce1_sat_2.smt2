                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b10011100 #b00111101111100101101100)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100010 #b10101100100110110110010)
                expect
                (fp #b0 #b11100111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11100111 #b00000000000000000000000)
                expect
                (fp #b0 #b11101100 #b11111000001011011011110)))
; expect = 20282409603651670423947251286016.0

(assert (= expect result))

(check-sat)
(exit)
