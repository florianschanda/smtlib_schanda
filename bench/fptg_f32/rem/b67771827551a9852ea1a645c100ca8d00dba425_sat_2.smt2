(assert (fp.leq (fp #b0 #b10010101 #b00101010111110011011110)
                arg2
                (fp #b0 #b11000000 #b10100010101000110110001)))
; arg2 = 4898415.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010111 #b10001101101011101001001)
                expect
                (fp #b1 #b10010000 #b00001010110010101000000)))
(assert (fp.leq (fp #b1 #b10010000 #b00001010110010101000000)
                expect
                (fp #b0 #b10011100 #b01110000110101110100011)))
; expect = -136597.0

(assert (= expect result))

