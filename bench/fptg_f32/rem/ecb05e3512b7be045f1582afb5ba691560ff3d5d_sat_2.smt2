                arg2
                (fp #b1 #b10010100 #b11000011110011101010100)))
(assert (fp.leq (fp #b1 #b10010100 #b11000011110011101010100)
                arg2
                (fp #b1 #b01111111 #b00110011110101110100100)))
; arg2 = -3701205.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b10111011010000001110111)
                expect
                (fp #b1 #b10010011 #b10011001101110011101000)))
(assert (fp.leq (fp #b1 #b10010011 #b10011001101110011101000)
                expect
                (fp #b0 #b10010101 #b00111000000111000100101)))
; expect = -1678237.0

(assert (= expect result))

(check-sat)
(exit)
