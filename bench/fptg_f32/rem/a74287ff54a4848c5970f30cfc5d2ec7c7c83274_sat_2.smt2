(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT32
; Arg1: -SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110010 #b11010110010101111010001)
                arg1
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b10110001 #b11011010100100111101101)))
; arg1 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const arg2 Float32)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b10101100 #b01111101111111011011100)
                arg2
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                arg2
                (fp #b0 #b10010110 #b10010001010010000110000)))
; arg2 = 0.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
