; Format: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +ONE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010000 #b10100011111001100001110)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11011111 #b10010110010000010100100)))
; arg1 = 18446742974197923840.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b0 #b00010100 #b10010100011000111010110)
                arg2
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg2
                (fp #b0 #b11100001 #b10011110111100011101001)))
; arg2 = 1.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00110001 #b00001111101010110101000)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b11011000 #b11100000100111101100011)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
