                arg2
                (fp #b0 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b11111111111111111111111)
                arg2
                (fp #b0 #b11101110 #b10000110011000011101010)))
; arg2 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000010 #b01101100010100100111001)
                expect
                (fp #b0 #b00000000 #b00000000001000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000001000000000000)
                expect
                (fp #b0 #b11011011 #b11011101100110101000101)))
; expect = 0.00000000000000000000000000000000000000000573971850987445072250359637315549647372395291392620860111695169081258427468128502368927001953125

(assert (= expect result))

(check-sat)
