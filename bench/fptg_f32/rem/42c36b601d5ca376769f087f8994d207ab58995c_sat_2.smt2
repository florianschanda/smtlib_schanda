(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00111110010111100111011)
                arg2
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg2
                (fp #b1 #b01001000 #b10101101011011101001111)))
; arg2 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011110 #b10001100000011100101000)
                expect
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                expect
                (fp #b1 #b01001100 #b01011000011010010001001)))
; expect = -1.6049678325653076171875

(assert (= expect result))

(check-sat)
(exit)
