(assert (fp.leq (fp #b1 #b01111111 #b11010010101101101010010)
                arg2
                (fp #b1 #b01000100 #b11001010110000111100001)))
; arg2 = -1.8230993747711181640625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011000 #b01111010110001111010011)
                expect
                (fp #b0 #b01111110 #b10010000000001111001100)))
(assert (fp.leq (fp #b0 #b01111110 #b10010000000001111001100)
                expect
                (fp #b0 #b10010001 #b00001010101100100010111)))
; expect = 0.7813079357147216796875

(assert (= expect result))

(check-sat)
