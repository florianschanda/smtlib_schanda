(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b10111010 #b10101110010011011111110)
                arg2
                (fp #b1 #b10100101 #b00010011010001111001010)))
(assert (fp.leq (fp #b1 #b10100101 #b00010011010001111001010)
                arg2
                (fp #b1 #b00101111 #b01011011001111100110010)))
; arg2 = -295579222016.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110100 #b00111000000010111101101)
                expect
                (fp #b1 #b10100010 #b10101111011101101000000)))
(assert (fp.leq (fp #b1 #b10100010 #b10101111011101101000000)
                expect
                (fp #b0 #b00100000 #b11011001111001001111001)))
; expect = -57909968896.0

(assert (not (= expect result)))

(check-sat)
(exit)
