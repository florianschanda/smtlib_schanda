; Format: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01110010 #b00000101000111110101000)
                arg1
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                arg1
                (fp #b0 #b11011100 #b00011111111011110111100)))
; arg1 = 22559420300669994798153728.0

(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b01100110 #b10111011010000100110010)
                arg2
                (fp #b0 #b10010100 #b01101100101111010111100)))
(assert (fp.leq (fp #b0 #b10010100 #b01101100101111010111100)
                arg2
                (fp #b0 #b11100100 #b10110110110011001100001)))
; arg2 = 2987951.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000101 #b10001111111011011011000)
                expect
                (fp #b1 #b10010010 #b10100010000010010010000)))
(assert (fp.leq (fp #b1 #b10010010 #b10100010000010010010000)
                expect
                (fp #b0 #b01011010 #b00110101011111101100000)))
; expect = -856137.0

(assert (= expect result))

(check-sat)
(exit)
