; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011101 #b00001011000100110011010)
                expect
                (fp #b0 #b00000000 #b00100011001011001000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00100011001011001000000)
                expect
                (fp #b0 #b00011000 #b11010100001101011101000)))
; expect = 0.00000000000000000000000000000000000000161510297881764036033698854818995837492647918792026704214867473437255984691773846861906349658966064453125

