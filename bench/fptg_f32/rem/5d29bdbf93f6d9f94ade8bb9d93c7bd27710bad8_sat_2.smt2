                arg2
                (fp #b1 #b10110011 #b00000001000001111001010)))
(assert (fp.leq (fp #b1 #b10110011 #b00000001000001111001010)
                arg2
                (fp #b1 #b00110111 #b10010011100100010011001)))
; arg2 = -4521712578199552.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010011 #b00010000110111111100010)
                expect
                (fp #b1 #b10110001 #b11001001010011100011000)))
(assert (fp.leq (fp #b1 #b10110001 #b11001001010011100011000)
                expect
                (fp #b1 #b01101111 #b11001010001111111000011)))
; expect = -2011250506596352.0

(assert (= expect result))

(check-sat)
(exit)
