; arg2 = 0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010101 #b01000100100000100111010)
                expect
                (fp #b1 #b00000000 #b01111000011011100001000)))
(assert (fp.leq (fp #b1 #b00000000 #b01111000011011100001000)
                expect
                (fp #b0 #b11001101 #b11000001111010101100000)))
; expect = -0.00000000000000000000000000000000000000552987126224488071649862602059866495323247112760631661126478720116352028046691202689544297754764556884765625

