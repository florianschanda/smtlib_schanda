(declare-const arg2 Float32)
(assert (fp.leq (fp #b1 #b11000010 #b01000000110101101100111)
                arg2
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg2
                (fp #b0 #b00000001 #b11001110011011001001000)))
; arg2 = -16777216.0

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010100 #b10000000110001011010010)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b01100000 #b01111100110011100100110)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
