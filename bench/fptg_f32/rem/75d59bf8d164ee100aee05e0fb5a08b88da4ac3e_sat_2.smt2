(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111111 #b11111001111000110101010)
                expect
                (fp #b1 #b00000000 #b00001111010000000011000)))
(assert (fp.leq (fp #b1 #b00000000 #b00001111010000000011000)
                expect
                (fp #b0 #b01010111 #b01011010011010011110001)))
; expect = -0.00000000000000000000000000000000000000070027928936782678375514092703496952778147298178560248571479027591794863649710123354452662169933319091796875

