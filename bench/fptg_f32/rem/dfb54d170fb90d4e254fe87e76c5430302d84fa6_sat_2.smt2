; arg2 = -0.00000000000000000000000000000000000000360997605834734236951622982193606679033961600549431425314854781556694364452742007642882526852190494537353515625

(declare-const result Float32)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101101 #b00110011100001010011111)
                expect
                (fp #b0 #b00000000 #b00000101001011110111001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000101001011110111001)
                expect
                (fp #b0 #b10100000 #b00101111010111001000110)))
; expect = 0.00000000000000000000000000000000000000023809882596882264297186366468553951961422314733006442432655874332056607223240263238039915449917316436767578125

