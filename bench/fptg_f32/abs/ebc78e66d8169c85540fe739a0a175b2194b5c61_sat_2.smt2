; Format: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01100010111111001000111)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01111111 #b01001010111001100111110)))
; arg1 = -1316616.0

(declare-const result Float32)
(assert (= result (fp.abs arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100000 #b11000110011100010001110)
                expect
                (fp #b0 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b0 #b10010011 #b01000001011100001000000)
                expect
                (fp #b0 #b11010110 #b00110100011000000001110)))
; expect = 1316616.0

(assert (= expect result))

(check-sat)
(exit)
