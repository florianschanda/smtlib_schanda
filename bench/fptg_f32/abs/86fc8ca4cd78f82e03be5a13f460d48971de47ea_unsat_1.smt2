; Format: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b01001111000000000100010)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b1 #b11100011 #b01111110000001110010110)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const result Float32)
(assert (= result (fp.abs arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010001 #b00000010000110010100010)
                expect
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                expect
                (fp #b0 #b11111101 #b10011010011000101010011)))
; expect = 85070591730234615865843651857942052864.0

(assert (not (= expect result)))

(check-sat)
(exit)
