                expect
                (fp #b0 #b10010110 #b11111101100111110110000)))
(assert (fp.leq (fp #b0 #b10010110 #b11111101100111110110000)
                expect
                (fp #b0 #b11000000 #b11010110101010101011110)))
; expect = 16699312.0

(assert (not (= expect result)))

(check-sat)
