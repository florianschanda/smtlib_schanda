(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010111 #b0011010110)
                arg1
                (fp #b0 #b10100001 #b0001110101)))
(assert (fp.leq (fp #b0 #b10100001 #b0001110101)
                arg1
                (fp #b0 #b11100000 #b0001010110)))
; arg1 = 19142803456.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01011100 #b1000101)
                expect
                (fp #b0 #b10100001 #b0001111)))
(assert (fp.leq (fp #b0 #b10100001 #b0001111)
                expect
                (fp #b0 #b10100101 #b0110000)))
; expect = 19193135104.0

(assert (= expect result))

(check-sat)
(exit)
