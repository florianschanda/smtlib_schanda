; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110110011101100 #b000011001000010)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b0 #b1011011011000010 #b111100010100110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000101 #b0111100)
                expect
                (fp #b1 #b01111111 #b1101001)))
(assert (fp.leq (fp #b1 #b01111111 #b1101001)
                expect
                (fp #b0 #b00010110 #b0101000)))
; expect = -1.8203125

(assert (not (= expect result)))

(check-sat)
(exit)
