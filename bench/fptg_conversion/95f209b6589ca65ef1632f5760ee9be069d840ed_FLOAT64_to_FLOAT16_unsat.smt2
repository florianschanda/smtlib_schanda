(assert (fp.leq (fp #b0 #b00010001110 #b0010101110101101001001010010000101111011010001010001)
                arg1
                (fp #b0 #b11100101000 #b1000100101000000011111100011001111000111011011010110)))
(assert (fp.leq (fp #b0 #b11100101000 #b1000100101000000011111100011001111000111011011010110)
                arg1
                (fp #b0 #b11101100100 #b0010011111111000011101110011100000110011111011010101)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

