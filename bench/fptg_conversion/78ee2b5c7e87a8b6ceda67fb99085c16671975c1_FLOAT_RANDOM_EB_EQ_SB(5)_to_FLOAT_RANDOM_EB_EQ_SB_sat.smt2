; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101101111010 #b100000100000)
                arg1
                (fp #b1 #b1000011111000 #b010000011111)))
(assert (fp.leq (fp #b1 #b1000011111000 #b010000011111)
                arg1
                (fp #b0 #b0010101001011 #b011001101010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111000 #b111010110)
                expect
                (fp #b1 #b1011111000 #b010000100)))
(assert (fp.leq (fp #b1 #b1011111000 #b010000100)
                expect
                (fp #b1 #b0101000110 #b000000001)))

(assert (= expect result))

(check-sat)
(exit)
