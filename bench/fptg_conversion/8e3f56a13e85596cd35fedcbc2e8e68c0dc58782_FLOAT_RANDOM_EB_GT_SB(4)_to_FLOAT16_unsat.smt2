                expect
                (fp #b1 #b10001 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001 #b0000000000)
                expect
                (fp #b0 #b01110 #b1011110001)))
; expect = -4.0

(assert (not (= expect result)))

