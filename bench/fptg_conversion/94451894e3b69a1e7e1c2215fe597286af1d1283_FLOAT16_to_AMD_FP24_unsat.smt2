; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010110111)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b0 #b11001 #b1001000001)))
; arg1 = -933.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0111001010010100)
                expect
                (fp #b1 #b1001000 #b1101001010000000)))
(assert (fp.leq (fp #b1 #b1001000 #b1101001010000000)
                expect
                (fp #b1 #b0011001 #b0111111101000001)))
; expect = -933.0

(assert (not (= expect result)))

(check-sat)
(exit)
