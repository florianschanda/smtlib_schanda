(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100101 #b0010001000110000)
                arg1
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                arg1
                (fp #b0 #b1100100 #b1001110001000111)))
; arg1 = 1.1314697265625

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b0 #b01 #b1)))
(assert (fp.leq (fp #b0 #b01 #b1)
                expect
                (fp #b0 #b10 #b1)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
