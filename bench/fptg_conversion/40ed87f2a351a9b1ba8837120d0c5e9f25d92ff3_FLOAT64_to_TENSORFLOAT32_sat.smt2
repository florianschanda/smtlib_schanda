(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT64
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110101010 #b1001110101110100000110011001111000111111010001001010)
                arg1
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                arg1
                (fp #b0 #b10101101110 #b1011010011101000111000111011010001011100001110011111)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
