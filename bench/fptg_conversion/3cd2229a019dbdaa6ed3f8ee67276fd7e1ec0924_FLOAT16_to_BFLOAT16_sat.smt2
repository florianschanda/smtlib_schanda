(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0001001011)
                arg1
                (fp #b0 #b00001 #b0001001010)))
(assert (fp.leq (fp #b0 #b00001 #b0001001010)
                arg1
                (fp #b0 #b10001 #b0110011111)))
; arg1 = 0.00006544589996337890625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001011 #b0111100)
                expect
                (fp #b0 #b01110001 #b0001010)))
(assert (fp.leq (fp #b0 #b01110001 #b0001010)
                expect
                (fp #b0 #b11000100 #b1000011)))
; expect = 0.00006580352783203125

(assert (= expect result))

(check-sat)
(exit)
