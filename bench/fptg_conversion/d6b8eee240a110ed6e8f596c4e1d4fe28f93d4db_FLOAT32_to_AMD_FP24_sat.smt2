(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011001 #b10111001001000100010110)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b00011101 #b11001100101011101011000)))
; arg1 = -3751329.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110010 #b0001111101100100)
                expect
                (fp #b1 #b1010100 #b1100100111101110)))
(assert (fp.leq (fp #b1 #b1010100 #b1100100111101110)
                expect
                (fp #b1 #b0010001 #b0110010000001000)))
; expect = -3751360.0

(assert (= expect result))

(check-sat)
(exit)
