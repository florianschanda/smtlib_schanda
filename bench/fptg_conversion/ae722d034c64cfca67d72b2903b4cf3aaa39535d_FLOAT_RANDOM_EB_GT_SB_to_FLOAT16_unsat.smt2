; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11011011 #b01)
                arg1
                (fp #b0 #b10000001 #b00)))
(assert (fp.leq (fp #b0 #b10000001 #b00)
                arg1
                (fp #b0 #b11100101 #b01)))
; arg1 = 4.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00101 #b1011011010)
                expect
                (fp #b0 #b10001 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001 #b0000000000)
                expect
                (fp #b0 #b11011 #b1010100000)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
