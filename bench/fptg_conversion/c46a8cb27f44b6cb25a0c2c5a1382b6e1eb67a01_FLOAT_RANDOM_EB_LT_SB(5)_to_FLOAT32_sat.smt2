(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b11110110001110000000001)
                expect
                (fp #b1 #b01110110 #b11010110000000000000000)))
(assert (fp.leq (fp #b1 #b01110110 #b11010110000000000000000)
                expect
                (fp #b1 #b00011010 #b10110100101110101011101)))
; expect = -0.0035858154296875

(assert (= expect result))

(check-sat)
(exit)
