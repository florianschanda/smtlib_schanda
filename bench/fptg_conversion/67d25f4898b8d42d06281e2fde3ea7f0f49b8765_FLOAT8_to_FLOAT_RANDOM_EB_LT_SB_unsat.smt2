(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011 #b0100)
                arg1
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg1
                (fp #b0 #b100 #b1111)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 3 39))
(assert (= result ((_ to_fp 3 39) rm arg1)))

(declare-const expect (_ FloatingPoint 3 39))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100 #b11000111001100101100011011001010111001)
                expect
                (fp #b0 #b000 #b00000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000 #b00000000000000000000000000000000000000)
                expect
                (fp #b0 #b010 #b00010011100110011101010111010101100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
