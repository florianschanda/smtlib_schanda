(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10010011 #b0)
                arg1
                (fp #b1 #b10000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000 #b1)
                arg1
                (fp #b0 #b00110000 #b0)))
; arg1 = -3.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b1100010001)
                expect
                (fp #b1 #b10000 #b1000000000)))
(assert (fp.leq (fp #b1 #b10000 #b1000000000)
                expect
                (fp #b0 #b00100 #b0101011101)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
