                arg1
                (fp #b0 #b011110010111110001 #b1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b1101100010)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b11001 #b1100111111)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

