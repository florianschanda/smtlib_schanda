(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001101011 #b1010010110)
                arg1
                (fp #b0 #b01111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111111 #b1001100100)
                arg1
                (fp #b0 #b11110101111 #b1111000001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00110110 #b0101001)
                expect
                (fp #b0 #b01111111 #b1001101)))
(assert (fp.leq (fp #b0 #b01111111 #b1001101)
                expect
                (fp #b0 #b11101010 #b1110001)))
; expect = 1.6015625

(assert (= expect result))

(check-sat)
(exit)
