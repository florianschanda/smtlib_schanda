; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000011010111 #b10000)
                arg1
                (fp #b0 #b0011000011100 #b10000)))
(assert (fp.leq (fp #b0 #b0011000011100 #b10000)
                arg1
                (fp #b0 #b1010110011000 #b01100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011000101 #b1101010100)
                expect
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b01100100111 #b0000111110)))

(assert (= expect result))

(check-sat)
(exit)
