; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0110100001)
                arg1
                (fp #b1 #b01111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111 #b0010001010)
                arg1
                (fp #b0 #b01000 #b0111111001)))
; arg1 = -1.134765625

(declare-const result (_ FloatingPoint 7 5))
(assert (= result ((_ to_fp 7 5) rm arg1)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1111000 #b1001)
                expect
                (fp #b1 #b0111111 #b0011)))
(assert (fp.leq (fp #b1 #b0111111 #b0011)
                expect
                (fp #b0 #b1010000 #b1100)))
; expect = -1.1875

(assert (not (= expect result)))

(check-sat)
(exit)
