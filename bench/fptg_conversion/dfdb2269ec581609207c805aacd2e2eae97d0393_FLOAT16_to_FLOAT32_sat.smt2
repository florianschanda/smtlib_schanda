(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0110000011)
                arg1
                (fp #b0 #b01111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111 #b1111110100)
                arg1
                (fp #b0 #b11110 #b1011101000)))
; arg1 = 1.98828125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111101 #b10010110001110101101100)
                expect
                (fp #b0 #b01111111 #b11111101000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b11111101000000000000000)
                expect
                (fp #b0 #b10010101 #b01011111000011100010001)))
; expect = 1.98828125

(assert (= expect result))

(check-sat)
(exit)
