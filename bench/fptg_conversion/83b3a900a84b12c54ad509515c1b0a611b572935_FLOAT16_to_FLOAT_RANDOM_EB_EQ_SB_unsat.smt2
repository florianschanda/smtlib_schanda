; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000110010)
                arg1
                (fp #b1 #b10110 #b0101001111)))
(assert (fp.leq (fp #b1 #b10110 #b0101001111)
                arg1
                (fp #b1 #b00111 #b1100011010)))
; arg1 = -169.875

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011010011 #b10110110011)
                expect
                (fp #b1 #b100000000110 #b01010011110)))
(assert (fp.leq (fp #b1 #b100000000110 #b01010011110)
                expect
                (fp #b0 #b000100000101 #b10000101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
