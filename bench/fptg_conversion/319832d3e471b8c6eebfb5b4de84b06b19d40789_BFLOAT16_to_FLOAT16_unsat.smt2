; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101111 #b1000101)
                arg1
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                arg1
                (fp #b0 #b10001010 #b0000101)))
; arg1 = -177.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0011010111)
                expect
                (fp #b1 #b10110 #b0110001000)))
(assert (fp.leq (fp #b1 #b10110 #b0110001000)
                expect
                (fp #b0 #b01100 #b1111000110)))
; expect = -177.0

(assert (not (= expect result)))

(check-sat)
(exit)
