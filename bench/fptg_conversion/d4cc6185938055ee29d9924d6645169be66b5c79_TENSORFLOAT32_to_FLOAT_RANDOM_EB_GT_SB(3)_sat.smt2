(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010111 #b0011010110)
                arg1
                (fp #b0 #b10100001 #b0001110101)))
(assert (fp.leq (fp #b0 #b10100001 #b0001110101)
                arg1
                (fp #b0 #b11100000 #b0001010110)))
; arg1 = 19142803456.0

(declare-const result (_ FloatingPoint 10 3))
(assert (= result ((_ to_fp 10 3) rm arg1)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0101000000 #b11)
                expect
                (fp #b0 #b1000100001 #b01)))
(assert (fp.leq (fp #b0 #b1000100001 #b01)
                expect
                (fp #b0 #b1010101011 #b00)))

(assert (= expect result))

(check-sat)
(exit)
