(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01000 #b1100)
                arg1
                (fp #b0 #b10110 #b1111)))
(assert (fp.leq (fp #b0 #b10110 #b1111)
                arg1
                (fp #b0 #b11011 #b1111)))
; arg1 = 248.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
