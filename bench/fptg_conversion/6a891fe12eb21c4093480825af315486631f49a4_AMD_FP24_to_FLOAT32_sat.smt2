(assert (fp.leq (fp #b1 #b11100010 #b10110010100011111100100)
                expect
                (fp #b1 #b10110111 #b01011110011110010000000)))
(assert (fp.leq (fp #b1 #b10110111 #b01011110011110010000000)
                expect
                (fp #b0 #b10100110 #b01011001001010111101101)))
; expect = -98649282755690496.0

(assert (= expect result))

