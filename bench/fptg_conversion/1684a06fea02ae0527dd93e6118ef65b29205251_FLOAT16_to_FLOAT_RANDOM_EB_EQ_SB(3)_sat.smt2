; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1110000001)
                arg1
                (fp #b1 #b00000 #b0001101111)))
(assert (fp.leq (fp #b1 #b00000 #b0001101111)
                arg1
                (fp #b0 #b11011 #b0010110001)))
; arg1 = -0.000006616115570068359375

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010000101 #b010001000)
                expect
                (fp #b1 #b0111101101 #b101111000)))
(assert (fp.leq (fp #b1 #b0111101101 #b101111000)
                expect
                (fp #b0 #b0001110101 #b001110110)))

(assert (= expect result))

(check-sat)
(exit)
