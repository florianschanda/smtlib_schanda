(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100110000)
                arg1
                (fp #b1 #b11011 #b1100100001)))
(assert (fp.leq (fp #b1 #b11011 #b1100100001)
                arg1
                (fp #b1 #b10101 #b1011100010)))
; arg1 = -7300.0

(declare-const result (_ FloatingPoint 10 3))
(assert (= result ((_ to_fp 10 3) rm arg1)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1010001011 #b11)
                expect
                (fp #b1 #b1000001100 #b00)))
(assert (fp.leq (fp #b1 #b1000001100 #b00)
                expect
                (fp #b0 #b1100000011 #b01)))

(assert (= expect result))

(check-sat)
(exit)
