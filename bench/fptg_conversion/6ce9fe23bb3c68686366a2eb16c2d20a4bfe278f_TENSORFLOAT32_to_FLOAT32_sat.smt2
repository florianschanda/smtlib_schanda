(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b0001100010)
                arg1
                (fp #b1 #b01111111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111111 #b0010001010)
                arg1
                (fp #b1 #b01100001 #b0010000111)))
; arg1 = -1.134765625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000000 #b11011101101011101011000)
                expect
                (fp #b1 #b01111111 #b00100010100000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00100010100000000000000)
                expect
                (fp #b1 #b00100001 #b01100000100100101001110)))
; expect = -1.134765625

(assert (= expect result))

(check-sat)
(exit)
