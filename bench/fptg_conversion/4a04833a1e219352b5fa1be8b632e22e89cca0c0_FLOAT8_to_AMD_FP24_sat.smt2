(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0010)
                arg1
                (fp #b0 #b010 #b1010)))
(assert (fp.leq (fp #b0 #b010 #b1010)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 0.8125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b0011000101111100)
                expect
                (fp #b0 #b0111110 #b1010000000000000)))
(assert (fp.leq (fp #b0 #b0111110 #b1010000000000000)
                expect
                (fp #b0 #b1101111 #b1100000001101111)))
; expect = 0.8125

(assert (= expect result))

(check-sat)
(exit)
