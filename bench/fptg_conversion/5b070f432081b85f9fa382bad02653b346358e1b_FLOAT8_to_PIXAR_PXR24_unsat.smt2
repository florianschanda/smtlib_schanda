                expect
                (fp #b0 #b01111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b000000000000000)
                expect
                (fp #b0 #b10111100 #b111010010001100)))
; expect = 0.25

(assert (not (= expect result)))

