(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b111011111 #b0010)
                arg1
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg1
                (fp #b0 #b001110101 #b0111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result ((_ to_fp 10 7) rm arg1)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101110001 #b010111)
                expect
                (fp #b1 #b0000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000)
                expect
                (fp #b0 #b1000000010 #b011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
