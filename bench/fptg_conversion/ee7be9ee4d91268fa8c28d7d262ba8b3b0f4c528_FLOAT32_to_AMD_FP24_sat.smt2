(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100110 #b10110111011101001011101)
                arg1
                (fp #b1 #b11100010 #b00000100001101001001101)))
(assert (fp.leq (fp #b1 #b11100010 #b00000100001101001001101)
                arg1
                (fp #b0 #b11110110 #b10010011111011000110101)))
; arg1 = -644237551524864324087125639168.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
