; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1101100111)
                arg1
                (fp #b0 #b10100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10100 #b0010001110)
                arg1
                (fp #b0 #b11100 #b1100100101)))
; arg1 = 36.4375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000100 #b00110001001010010000110)
                expect
                (fp #b0 #b10000100 #b00100011100000000000000)))
(assert (fp.leq (fp #b0 #b10000100 #b00100011100000000000000)
                expect
                (fp #b0 #b10100001 #b01110111001111010101011)))
; expect = 36.4375

(assert (not (= expect result)))

(check-sat)
(exit)
