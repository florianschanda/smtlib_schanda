(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b000010 #b11)
                arg1
                (fp #b0 #b000000 #b10)))
(assert (fp.leq (fp #b0 #b000000 #b10)
                arg1
                (fp #b0 #b001000 #b00)))
; arg1 = 0.0000000004656612873077392578125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b10100101100001000001001)
                expect
                (fp #b0 #b01100000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01100000 #b00000000000000000000000)
                expect
                (fp #b0 #b11110110 #b01101001100001000101000)))
; expect = 0.0000000004656612873077392578125

(assert (= expect result))

(check-sat)
(exit)
