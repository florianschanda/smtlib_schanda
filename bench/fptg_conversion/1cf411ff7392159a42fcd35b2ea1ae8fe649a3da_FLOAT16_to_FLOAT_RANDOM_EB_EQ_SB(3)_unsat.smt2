(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000001111)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11100 #b1000001010)))
; arg1 = 255.875

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b000010110 #b11100101)
                expect
                (fp #b0 #b100000111 #b00000000)))
(assert (fp.leq (fp #b0 #b100000111 #b00000000)
                expect
                (fp #b0 #b101000101 #b10010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
