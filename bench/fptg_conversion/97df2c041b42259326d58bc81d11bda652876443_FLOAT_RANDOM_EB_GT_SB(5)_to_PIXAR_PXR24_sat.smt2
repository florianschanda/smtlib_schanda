(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg1
                (fp #b1 #b01111111 #b100)))
(assert (fp.leq (fp #b1 #b01111111 #b100)
                arg1
                (fp #b0 #b01101101 #b010)))
; arg1 = -1.5

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110000 #b100110110111011)
                expect
                (fp #b1 #b01111111 #b100000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b100000000000000)
                expect
                (fp #b0 #b11100100 #b101110100010111)))
; expect = -1.5

(assert (= expect result))

(check-sat)
(exit)
