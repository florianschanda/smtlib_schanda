(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01001 #b1)
                arg1
                (fp #b1 #b00111 #b1)))
(assert (fp.leq (fp #b1 #b00111 #b1)
                arg1
