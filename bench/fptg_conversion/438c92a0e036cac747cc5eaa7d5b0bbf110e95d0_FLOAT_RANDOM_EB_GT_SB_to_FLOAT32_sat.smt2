(assert (fp.leq (fp #b1 #b10101111 #b11110001110010000101001)
                expect
                (fp #b1 #b01110111 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01110111 #b10000000000000000000000)
                expect
                (fp #b0 #b00001000 #b11101011011101000101011)))
; expect = -0.005859375

(assert (= expect result))

(check-sat)
(exit)
