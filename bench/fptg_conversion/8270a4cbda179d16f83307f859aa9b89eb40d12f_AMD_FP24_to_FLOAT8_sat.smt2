(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010111 #b0001100100110001)
                arg1
                (fp #b0 #b0101011 #b1100000010000001)))
(assert (fp.leq (fp #b0 #b0101011 #b1100000010000001)
                arg1
                (fp #b0 #b1100010 #b1011101000011101)))
; arg1 = 0.000001670807250775396823883056640625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0011)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b011 #b0110)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
