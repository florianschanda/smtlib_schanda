(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b111)
                arg1
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg1
                (fp #b0 #b101111 #b111)))
; arg1 = -1073741824.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00111011110111100100101)
                expect
                (fp #b1 #b10011101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10011101 #b00000000000000000000000)
                expect
                (fp #b0 #b01100100 #b01100111100011100010100)))
; expect = -1073741824.0

(assert (= expect result))

(check-sat)
(exit)
