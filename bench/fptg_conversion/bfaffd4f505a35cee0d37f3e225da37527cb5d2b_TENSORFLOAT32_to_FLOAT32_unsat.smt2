                expect
                (fp #b1 #b01111111 #b00010111010000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00010111010000000000000)
                expect
                (fp #b1 #b01011101 #b00000101111101110011010)))
; expect = -1.0908203125

(assert (not (= expect result)))

(check-sat)
