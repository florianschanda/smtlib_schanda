; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000011 #b1011001100)
                arg1
                (fp #b1 #b01111111 #b0001011101)))
