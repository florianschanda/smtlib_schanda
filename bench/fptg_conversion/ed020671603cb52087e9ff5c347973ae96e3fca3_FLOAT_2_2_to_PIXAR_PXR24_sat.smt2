(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: PIXAR_PXR24
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 0.5

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00010011 #b111110000000101)
                expect
                (fp #b0 #b01111110 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111110 #b000000000000000)
                expect
                (fp #b0 #b10011110 #b001100011001101)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
