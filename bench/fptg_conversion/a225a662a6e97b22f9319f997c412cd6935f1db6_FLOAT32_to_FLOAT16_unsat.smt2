(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10111101 #b11110110111111110001000)
                arg1
                (fp #b0 #b11100001 #b00100101010001111111111)))
(assert (fp.leq (fp #b0 #b11100001 #b00100101010001111111111)
                arg1
                (fp #b0 #b11100010 #b01000011000111111010010)))
; arg1 = 363064564367733570790597066752.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
