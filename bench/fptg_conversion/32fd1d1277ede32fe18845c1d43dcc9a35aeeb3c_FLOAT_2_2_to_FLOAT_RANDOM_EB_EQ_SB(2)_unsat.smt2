; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b01 #b1)))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = -1.5

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111011 #b100110)
                expect
                (fp #b1 #b0111111 #b100000)))
(assert (fp.leq (fp #b1 #b0111111 #b100000)
                expect
                (fp #b0 #b1000100 #b001001)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
