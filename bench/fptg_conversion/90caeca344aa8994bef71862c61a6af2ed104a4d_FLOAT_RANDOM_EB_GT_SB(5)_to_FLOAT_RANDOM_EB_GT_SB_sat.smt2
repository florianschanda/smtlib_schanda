; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0001 #b1)
                arg1
                (fp #b0 #b1011 #b1)))
(assert (fp.leq (fp #b0 #b1011 #b1)
                arg1
                (fp #b0 #b1101 #b1)))
; arg1 = 24.0

(declare-const result (_ FloatingPoint 10 9))
(assert (= result ((_ to_fp 10 9) rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0010000011 #b01011101)
                expect
                (fp #b0 #b1000000011 #b10000000)))
(assert (fp.leq (fp #b0 #b1000000011 #b10000000)
                expect
                (fp #b0 #b1001010010 #b10011100)))

(assert (= expect result))

(check-sat)
(exit)
