(assert (fp.leq (fp #b1 #b010001100 #b10010010101)
                expect
                (fp #b0 #b011110111 #b00000000000)))
(assert (fp.leq (fp #b0 #b011110111 #b00000000000)
                expect
                (fp #b0 #b110001101 #b00100110101)))

(assert (= expect result))

