; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0000)
                arg1
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                arg1
                (fp #b0 #b011 #b1101)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001100 #b0011101100100001)
                expect
                (fp #b0 #b0111100 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111100 #b0000000000000000)
                expect
                (fp #b0 #b1010111 #b1001011001000000)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
