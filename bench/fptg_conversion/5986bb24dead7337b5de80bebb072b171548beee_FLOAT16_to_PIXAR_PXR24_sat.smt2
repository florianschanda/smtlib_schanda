; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1001011000)
                arg1
                (fp #b0 #b11100 #b1101000111)))
(assert (fp.leq (fp #b0 #b11100 #b1101000111)
                arg1
                (fp #b0 #b11100 #b1101010101)))
; arg1 = 14904.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001001 #b011100010010011)
                expect
                (fp #b0 #b10001100 #b110100011100000)))
(assert (fp.leq (fp #b0 #b10001100 #b110100011100000)
                expect
                (fp #b0 #b10111100 #b101111101111011)))
; expect = 14904.0

(assert (= expect result))

(check-sat)
(exit)
