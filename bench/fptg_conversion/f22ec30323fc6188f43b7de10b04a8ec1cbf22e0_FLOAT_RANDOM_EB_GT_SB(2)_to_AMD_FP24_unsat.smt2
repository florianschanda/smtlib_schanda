                expect
                (fp #b1 #b1000001 #b1000000000000000)))
(assert (fp.leq (fp #b1 #b1000001 #b1000000000000000)
                expect
                (fp #b0 #b1110100 #b0010011101010100)))
; expect = -6.0

(assert (not (= expect result)))

