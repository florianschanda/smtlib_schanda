; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b100101000101100 #b0101010011)
                arg1
                (fp #b1 #b000000000000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1110100001)
                arg1
                (fp #b0 #b001000110001111 #b0010110000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1100000000)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10000 #b1001001001)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
