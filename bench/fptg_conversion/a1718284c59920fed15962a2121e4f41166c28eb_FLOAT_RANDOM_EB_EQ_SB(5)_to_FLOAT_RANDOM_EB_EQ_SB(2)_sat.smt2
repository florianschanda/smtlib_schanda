; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000110 #b011010000)
                arg1
                (fp #b1 #b1000000111 #b001010110)))
(assert (fp.leq (fp #b1 #b1000000111 #b001010110)
                arg1
                (fp #b0 #b1101111001 #b001000010)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101101 #b000010)
                expect
                (fp #b1 #b1000111 #b001011)))
(assert (fp.leq (fp #b1 #b1000111 #b001011)
                expect
                (fp #b0 #b0111011 #b111110)))
; expect = -300.0

(assert (= expect result))

(check-sat)
(exit)
