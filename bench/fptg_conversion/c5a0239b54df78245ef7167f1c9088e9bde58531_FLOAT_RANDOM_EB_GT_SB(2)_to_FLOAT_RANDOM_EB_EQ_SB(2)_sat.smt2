; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11001100111100 #b00)
                arg1
                (fp #b1 #b10000000000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000000000 #b10)
                arg1
                (fp #b0 #b00011110100101 #b11)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0001)
                expect
                (fp #b1 #b10000 #b1000)))
(assert (fp.leq (fp #b1 #b10000 #b1000)
                expect
                (fp #b1 #b00110 #b0001)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
