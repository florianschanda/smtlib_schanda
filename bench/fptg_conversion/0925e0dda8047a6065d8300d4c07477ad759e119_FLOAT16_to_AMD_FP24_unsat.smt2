(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101111 #b0110110010001000)
                expect
                (fp #b0 #b1001001 #b1111110011000000)))
(assert (fp.leq (fp #b0 #b1001001 #b1111110011000000)
                expect
                (fp #b0 #b1010001 #b0011010011111001)))
; expect = 2035.0

(assert (not (= expect result)))

(check-sat)
