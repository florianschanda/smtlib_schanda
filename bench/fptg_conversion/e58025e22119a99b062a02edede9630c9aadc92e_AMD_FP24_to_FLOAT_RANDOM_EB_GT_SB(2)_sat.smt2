; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110000 #b0000111110100110)
                arg1
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                arg1
                (fp #b0 #b1101110 #b1000010000011001)))
; arg1 = 357453824.0

(declare-const result (_ FloatingPoint 16 5))
(assert (= result ((_ to_fp 16 5) rm arg1)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1001111101101111 #b0010)
                expect
                (fp #b0 #b1000000000011011 #b0110)))
(assert (fp.leq (fp #b0 #b1000000000011011 #b0110)
                expect
                (fp #b0 #b1010100000011001 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
