(assert (fp.leq (fp #b1 #b1011000110100 #b01000001000)
                expect
                (fp #b1 #b1000000001001 #b00000000000)))
(assert (fp.leq (fp #b1 #b1000000001001 #b00000000000)
                expect
                (fp #b0 #b0100000011000 #b00110001010)))

(assert (= expect result))

