; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111101001 #b111)
                arg1
                (fp #b1 #b011111111 #b001)))
(assert (fp.leq (fp #b1 #b011111111 #b001)
                arg1
                (fp #b1 #b010100000 #b110)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1010101000)
                expect
                (fp #b1 #b01111 #b0010000000)))
(assert (fp.leq (fp #b1 #b01111 #b0010000000)
                expect
                (fp #b0 #b01101 #b1111001101)))
; expect = -1.125

(assert (not (= expect result)))

(check-sat)
(exit)
