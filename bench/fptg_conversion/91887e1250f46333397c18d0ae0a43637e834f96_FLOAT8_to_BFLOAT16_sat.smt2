(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg1
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg1
                (fp #b1 #b000 #b0000)))
; arg1 = -0.234375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111110 #b0010010)
                expect
                (fp #b1 #b01111100 #b1110000)))
(assert (fp.leq (fp #b1 #b01111100 #b1110000)
                expect
                (fp #b0 #b00001101 #b1110000)))
; expect = -0.234375

(assert (= expect result))

(check-sat)
(exit)
