(assert (fp.leq (fp #b1 #b1011000 #b1000100000010000)
                expect
                (fp #b1 #b0111111 #b1001111001000010)))
(assert (fp.leq (fp #b1 #b0111111 #b1001111001000010)
                expect
                (fp #b0 #b1100111 #b0111101100011101)))
