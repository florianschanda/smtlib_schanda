                expect
                (fp #b0 #b011111111101111 #b0010111000)))
(assert (fp.leq (fp #b0 #b011111111101111 #b0010111000)
                expect
                (fp #b0 #b111101110010000 #b0011110001)))

(assert (= expect result))

