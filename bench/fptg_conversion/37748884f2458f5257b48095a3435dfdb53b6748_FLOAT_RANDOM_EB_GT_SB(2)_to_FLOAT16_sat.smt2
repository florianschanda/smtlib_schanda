(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111100 #b100)
                arg1
                (fp #b0 #b01111111 #b001)))
(assert (fp.leq (fp #b0 #b01111111 #b001)
                arg1
                (fp #b0 #b11110000 #b111)))
; arg1 = 1.125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b1011110100)
                expect
                (fp #b0 #b01111 #b0010000000)))
(assert (fp.leq (fp #b0 #b01111 #b0010000000)
                expect
                (fp #b0 #b11010 #b0110110011)))
; expect = 1.125

(assert (= expect result))

(check-sat)
(exit)
