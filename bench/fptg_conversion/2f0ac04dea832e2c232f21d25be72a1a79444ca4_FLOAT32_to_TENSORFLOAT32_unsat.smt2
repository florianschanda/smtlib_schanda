; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011101 #b10010010010010101100100)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b1 #b00010110 #b11111000110101101110011)))
; arg1 = -1698008524581344716521472.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010010 #b0011111000)
                expect
                (fp #b1 #b11001111 #b0110011111)))
(assert (fp.leq (fp #b1 #b11001111 #b0110011111)
                expect
                (fp #b0 #b10001011 #b1001100110)))
; expect = -1698871342212354865627136.0

(assert (not (= expect result)))

(check-sat)
(exit)
