; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111001 #b0010100)
                arg1
                (fp #b0 #b00000000 #b0111100)))
(assert (fp.leq (fp #b0 #b00000000 #b0111100)
                arg1
                (fp #b0 #b11001111 #b1100011)))
