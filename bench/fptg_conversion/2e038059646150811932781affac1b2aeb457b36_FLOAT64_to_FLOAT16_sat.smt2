(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT64
; Format to: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000000101 #b0100111111001111111111010010100100011101001011000000)
                arg1
                (fp #b0 #b10101101111 #b0010101000111111110101000000110111101100101010001000)))
(assert (fp.leq (fp #b0 #b10101101111 #b0010101000111111110101000000110111101100101010001000)
                arg1
                (fp #b0 #b10111100010 #b1010011011101110110011000110000110111111100010001010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
