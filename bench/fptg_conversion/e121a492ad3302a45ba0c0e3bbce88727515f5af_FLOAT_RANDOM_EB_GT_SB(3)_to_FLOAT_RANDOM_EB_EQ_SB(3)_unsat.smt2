(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111100100 #b0100111)
                arg1
                (fp #b0 #b000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b000000000 #b1011100)
                arg1
                (fp #b0 #b101011101 #b1100111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101111101111 #b11110111001)
                expect
                (fp #b0 #b011100000000 #b01110000000)))
(assert (fp.leq (fp #b0 #b011100000000 #b01110000000)
                expect
                (fp #b0 #b111001011000 #b01110010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
