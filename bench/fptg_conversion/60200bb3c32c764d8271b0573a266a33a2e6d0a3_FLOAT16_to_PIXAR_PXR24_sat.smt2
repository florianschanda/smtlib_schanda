; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110111110)
                arg1
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg1
                (fp #b1 #b00101 #b1001111111)))
; arg1 = -1.203125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110001 #b011100101000110)
                expect
                (fp #b1 #b01111111 #b001101000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b001101000000000)
                expect
                (fp #b0 #b01010000 #b101111011000101)))
; expect = -1.203125

(assert (= expect result))

(check-sat)
(exit)
