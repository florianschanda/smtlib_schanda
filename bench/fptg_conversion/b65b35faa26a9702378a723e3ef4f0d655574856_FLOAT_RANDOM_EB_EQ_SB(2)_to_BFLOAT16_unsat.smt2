(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b01)
                arg1
                (fp #b0 #b000 #b10)))
(assert (fp.leq (fp #b0 #b000 #b10)
                arg1
                (fp #b0 #b001 #b00)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000011 #b0011101)
                expect
                (fp #b0 #b01111100 #b0000000)))
(assert (fp.leq (fp #b0 #b01111100 #b0000000)
                expect
                (fp #b0 #b11001111 #b1000010)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
