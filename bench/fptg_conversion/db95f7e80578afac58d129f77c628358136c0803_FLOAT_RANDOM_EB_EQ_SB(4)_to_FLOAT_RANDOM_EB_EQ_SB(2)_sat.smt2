; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001101011 #b1010010110)
                arg1
                (fp #b0 #b01111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111111 #b1001100100)
                arg1
                (fp #b0 #b11110101111 #b1111000001)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b010000 #b11110)
                expect
                (fp #b0 #b011111 #b10100)))
(assert (fp.leq (fp #b0 #b011111 #b10100)
                expect
                (fp #b0 #b101110 #b11111)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
