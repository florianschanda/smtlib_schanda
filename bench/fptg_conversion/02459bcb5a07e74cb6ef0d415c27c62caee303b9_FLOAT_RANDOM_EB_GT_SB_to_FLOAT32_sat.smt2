(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b01111110100011 #b1110110)
                arg1
                (fp #b0 #b10000000000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000000000011 #b1110000)
                arg1
                (fp #b0 #b10000011111101 #b0010100)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001100 #b00001101101110000100001)
                expect
                (fp #b0 #b10000011 #b11100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000011 #b11100000000000000000000)
                expect
                (fp #b0 #b10101001 #b10100000101011111111101)))
; expect = 30.0

(assert (= expect result))

(check-sat)
(exit)
