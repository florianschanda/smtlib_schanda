(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10000000 #b01001001101100011101000)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b11110100 #b11011100111100100110010)))
; arg1 = 838177.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111110 #b1110011100110000)
                expect
                (fp #b0 #b1010010 #b1001100101000101)))
(assert (fp.leq (fp #b0 #b1010010 #b1001100101000101)
                expect
                (fp #b0 #b1011010 #b1010100001000101)))
; expect = 838184.0

(assert (not (= expect result)))

(check-sat)
(exit)
