(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b0 #b001 #b10)))
(assert (fp.leq (fp #b0 #b001 #b10)
                arg1
                (fp #b0 #b100 #b00)))
; arg1 = 0.375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110011 #b11110100110010100110110)
                expect
                (fp #b0 #b01111101 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b10000000000000000000000)
                expect
                (fp #b0 #b01111101 #b11101001001010111111000)))
; expect = 0.375

(assert (not (= expect result)))

(check-sat)
(exit)
