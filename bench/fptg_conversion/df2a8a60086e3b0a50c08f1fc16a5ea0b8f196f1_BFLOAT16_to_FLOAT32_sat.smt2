(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101000 #b1101101)
                arg1
                (fp #b0 #b10000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000101 #b0101100)
                arg1
                (fp #b0 #b11101001 #b0010100)))
; arg1 = 86.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101111 #b11110000110111111000010)
                expect
                (fp #b0 #b10000101 #b01011000000000000000000)))
(assert (fp.leq (fp #b0 #b10000101 #b01011000000000000000000)
                expect
                (fp #b0 #b11100001 #b01101110101011100011001)))
; expect = 86.0

(assert (= expect result))

(check-sat)
(exit)
