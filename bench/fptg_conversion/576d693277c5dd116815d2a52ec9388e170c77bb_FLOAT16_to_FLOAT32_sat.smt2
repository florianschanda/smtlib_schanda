(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101000011)
                arg1
                (fp #b1 #b11011 #b0110100001)))
(assert (fp.leq (fp #b1 #b11011 #b0110100001)
                arg1
                (fp #b0 #b00100 #b1111000100)))
; arg1 = -5764.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b11000101000010111011110)
                expect
                (fp #b1 #b10001011 #b01101000010000000000000)))
(assert (fp.leq (fp #b1 #b10001011 #b01101000010000000000000)
                expect
                (fp #b1 #b01001010 #b10000111100101000010010)))
; expect = -5764.0

(assert (= expect result))

(check-sat)
(exit)
