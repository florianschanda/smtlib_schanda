(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0111100101)
                arg1
                (fp #b0 #b00000 #b0100101110)))
(assert (fp.leq (fp #b0 #b00000 #b0100101110)
                arg1
                (fp #b0 #b10001 #b1110100011)))
; arg1 = 0.00001800060272216796875

(declare-const result (_ FloatingPoint 9 6))
(assert (= result ((_ to_fp 9 6) rm arg1)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100000101 #b10100)
                expect
                (fp #b0 #b011101111 #b00110)))
(assert (fp.leq (fp #b0 #b011101111 #b00110)
                expect
                (fp #b0 #b110011000 #b10111)))

(assert (= expect result))

(check-sat)
(exit)
