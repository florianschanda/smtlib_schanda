(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100111 #b1110101110101001)
                arg1
                (fp #b1 #b0011010 #b0101001111100000)))
(assert (fp.leq (fp #b1 #b0011010 #b0101001111100000)
                arg1
                (fp #b1 #b0010100 #b1010100001001101)))
; arg1 = -0.000000000009659828492658562026917934417724609375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b100 #b0100)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
