; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0010)
                arg1
                (fp #b1 #b011 #b0011)))
(assert (fp.leq (fp #b1 #b011 #b0011)
                arg1
                (fp #b1 #b001 #b0100)))
; arg1 = -1.1875

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100010011 #b10000100101)
                expect
                (fp #b1 #b011111111111 #b00110000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00110000000)
                expect
                (fp #b0 #b100001010101 #b11011010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
