; Format from: FLOAT64
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001100000 #b1010011100001110110001110001101111001010111011110000)
                arg1
                (fp #b0 #b00000000000 #b0011100010001100001000101111110001110011001001100101)))
(assert (fp.leq (fp #b0 #b00000000000 #b0011100010001100001000101111110001110011001001100101)
                arg1
                (fp #b0 #b11001111100 #b1010011001111110010011111010111010011111010100111110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0100)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b100 #b1000)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
