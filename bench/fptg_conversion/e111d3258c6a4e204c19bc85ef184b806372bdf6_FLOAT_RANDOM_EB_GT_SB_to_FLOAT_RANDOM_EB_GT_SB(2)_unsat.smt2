(assert (fp.leq (fp #b1 #b1100 #b01)
                expect
                (fp #b1 #b1000 #b10)))
(assert (fp.leq (fp #b1 #b1000 #b10)
                expect
                (fp #b0 #b1110 #b00)))
; expect = -3.0

(assert (not (= expect result)))

