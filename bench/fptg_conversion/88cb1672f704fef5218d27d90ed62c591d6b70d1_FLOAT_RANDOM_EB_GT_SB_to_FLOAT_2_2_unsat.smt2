(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011101110 #b0000100)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b1101110010 #b1001110)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b01 #b1)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
(exit)
