; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010011000110100 #b011010010101101)
                arg1
                (fp #b0 #b0100100001110011 #b110011000110011)))
(assert (fp.leq (fp #b0 #b0100100001110011 #b110011000110011)
                arg1
                (fp #b0 #b0111011100101000 #b100001110000010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result ((_ to_fp 10 6) rm arg1)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001101001 #b00110)
                expect
                (fp #b0 #b0000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00001)
                expect
                (fp #b0 #b0000001110 #b10110)))

(assert (= expect result))

(check-sat)
(exit)
