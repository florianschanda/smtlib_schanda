(assert (fp.leq (fp #b1 #b01001110100 #b0010111111001101101000100001100110000100001111001000)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11111110111 #b0111001010101011010011001001011110000001101110100001)))

(assert (= expect result))

