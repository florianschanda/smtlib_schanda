; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00110 #b1111111001)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b11000 #b1111011110)))
; arg1 = 14.8359375

(declare-const result (_ FloatingPoint 16 3))
(assert (= result ((_ to_fp 16 3) rm arg1)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0101010100000111 #b10)
                expect
                (fp #b0 #b1000000000000011 #b00)))
(assert (fp.leq (fp #b0 #b1000000000000011 #b00)
                expect
                (fp #b0 #b1000111000100111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
