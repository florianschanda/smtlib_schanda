; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0000)
                arg1
                (fp #b1 #b10010 #b0011)))
(assert (fp.leq (fp #b1 #b10010 #b0011)
                arg1
                (fp #b1 #b10000 #b1100)))
; arg1 = -9.5

(declare-const result (_ FloatingPoint 7 6))
(assert (= result ((_ to_fp 7 6) rm arg1)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1100001 #b01100)
                expect
                (fp #b1 #b1000010 #b00110)))
(assert (fp.leq (fp #b1 #b1000010 #b00110)
                expect
                (fp #b0 #b1100011 #b00011)))
; expect = -9.5

(assert (= expect result))

(check-sat)
(exit)
