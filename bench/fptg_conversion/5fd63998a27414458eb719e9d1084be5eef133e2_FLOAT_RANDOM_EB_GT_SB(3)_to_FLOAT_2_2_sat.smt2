; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b0110100000001 #b00011100111)
                arg1
                (fp #b1 #b0011000100011 #b11001011101)))
(assert (fp.leq (fp #b1 #b0011000100011 #b11001011101)
                arg1
                (fp #b0 #b0111011010110 #b01010100010)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b10 #b0)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
