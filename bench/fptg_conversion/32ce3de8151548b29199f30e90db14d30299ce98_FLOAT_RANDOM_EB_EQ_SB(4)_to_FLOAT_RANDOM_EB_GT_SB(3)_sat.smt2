; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000110010 #b0011011100)
                arg1
                (fp #b1 #b01010111000 #b1011111111)))
(assert (fp.leq (fp #b1 #b01010111000 #b1011111111)
                arg1
                (fp #b1 #b01000111000 #b1011000110)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001011000 #b0011)
                expect
                (fp #b1 #b0010111000 #b1100)))
(assert (fp.leq (fp #b1 #b0010111000 #b1100)
                expect
                (fp #b0 #b0111100100 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
