; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011011111001 #b110)
                arg1
                (fp #b0 #b011111111111 #b101)))
(assert (fp.leq (fp #b0 #b011111111111 #b101)
                arg1
                (fp #b0 #b110101100101 #b001)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010001 #b1110111110011010)
                expect
                (fp #b0 #b0111111 #b1010000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1010000000000000)
                expect
                (fp #b0 #b1001001 #b1011100100011110)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
