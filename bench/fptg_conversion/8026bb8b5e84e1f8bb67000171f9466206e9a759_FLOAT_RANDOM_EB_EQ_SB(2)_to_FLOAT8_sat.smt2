(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111000001000 #b011000011010)
                arg1
                (fp #b1 #b0111111111111 #b101110111111)))
(assert (fp.leq (fp #b1 #b0111111111111 #b101110111111)
                arg1
                (fp #b0 #b1111101011100 #b011100101110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1110)
                expect
                (fp #b1 #b011 #b1100)))
(assert (fp.leq (fp #b1 #b011 #b1100)
                expect
                (fp #b1 #b000 #b1111)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
