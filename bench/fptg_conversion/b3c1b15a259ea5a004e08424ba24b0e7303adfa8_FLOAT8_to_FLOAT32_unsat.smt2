(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0111)
                arg1
                (fp #b0 #b010 #b0000)))
(assert (fp.leq (fp #b0 #b010 #b0000)
                arg1
                (fp #b0 #b100 #b1011)))
; arg1 = 0.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011000 #b00110110000000000100001)
                expect
                (fp #b0 #b01111110 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111110 #b00000000000000000000000)
                expect
                (fp #b0 #b11001111 #b11010100110010111010111)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
(exit)
