(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011011 #b010000)
                expect
                (fp #b1 #b0111111 #b000001)))
(assert (fp.leq (fp #b1 #b0111111 #b000001)
                expect
                (fp #b0 #b1011011 #b010000)))
; expect = -1.015625

(assert (= expect result))

