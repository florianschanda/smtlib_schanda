(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0001)
                arg1
                (fp #b0 #b011 #b0111)))
(assert (fp.leq (fp #b0 #b011 #b0111)
                arg1
                (fp #b0 #b111 #b0000)))
; arg1 = 1.4375

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b001 #b1)
                expect
                (fp #b0 #b011 #b1)))
(assert (fp.leq (fp #b0 #b011 #b1)
                expect
                (fp #b0 #b110 #b1)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
