; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1001010111)
                arg1
                (fp #b0 #b11001 #b0101110010)))
(assert (fp.leq (fp #b0 #b11001 #b0101110010)
                arg1
                (fp #b0 #b11100 #b0100000100)))
; arg1 = 1394.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101101 #b01011001001001101100100)
                expect
                (fp #b0 #b10001001 #b01011100100000000000000)))
(assert (fp.leq (fp #b0 #b10001001 #b01011100100000000000000)
                expect
                (fp #b0 #b11000011 #b01101011000111100110011)))
; expect = 1394.0

(assert (not (= expect result)))

(check-sat)
(exit)
