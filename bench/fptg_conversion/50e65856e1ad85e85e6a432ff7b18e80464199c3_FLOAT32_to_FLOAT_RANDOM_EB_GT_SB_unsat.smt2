(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01111011 #b10111000011000001010001)
                arg1
                (fp #b0 #b10011101 #b00000111101001011001111)))
(assert (fp.leq (fp #b0 #b10011101 #b00000111101001011001111)
                arg1
                (fp #b0 #b10101011 #b01110011101010100110101)))
; arg1 = 1105815424.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result ((_ to_fp 8 2) rm arg1)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b0 #b00101010 #b0)
                expect
                (fp #b0 #b10011101 #b1)))
(assert (fp.leq (fp #b0 #b10011101 #b1)
                expect
                (fp #b0 #b11010011 #b1)))
; expect = 1610612736.0

(assert (not (= expect result)))

(check-sat)
(exit)
