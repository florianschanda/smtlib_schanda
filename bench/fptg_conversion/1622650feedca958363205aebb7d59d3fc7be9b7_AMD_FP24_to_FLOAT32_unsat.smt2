(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1001111010011011)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b1 #b0110101 #b1100101100100110)))
; arg1 = -4294934528.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101111 #b10111001010100101110101)
                expect
                (fp #b1 #b10011110 #b11111111111111110000000)))
(assert (fp.leq (fp #b1 #b10011110 #b11111111111111110000000)
                expect
                (fp #b1 #b10011110 #b10011110110101011100001)))
; expect = -4294934528.0

(assert (not (= expect result)))

(check-sat)
(exit)
