(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11010101001 #b01101111)
                arg1
                (fp #b0 #b10000000111 #b11000011)))
(assert (fp.leq (fp #b0 #b10000000111 #b11000011)
                arg1
                (fp #b0 #b11111000100 #b01000100)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011101 #b01110100000011010001101)
                expect
                (fp #b0 #b10000111 #b11000011000000000000000)))
(assert (fp.leq (fp #b0 #b10000111 #b11000011000000000000000)
                expect
                (fp #b0 #b11000000 #b10010000100010101100100)))
; expect = 451.0

(assert (= expect result))

(check-sat)
(exit)
