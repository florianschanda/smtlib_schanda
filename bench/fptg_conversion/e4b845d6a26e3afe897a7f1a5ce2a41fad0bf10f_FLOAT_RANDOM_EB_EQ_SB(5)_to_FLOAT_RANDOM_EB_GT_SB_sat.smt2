; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00111110000 #b0101110001)
                arg1
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                arg1
                (fp #b0 #b11110011001 #b0001100111)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result ((_ to_fp 15 5) rm arg1)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111000011111000 #b0111)
                expect
                (fp #b0 #b100001001001000 #b0010)))
(assert (fp.leq (fp #b0 #b100001001001000 #b0010)
                expect
                (fp #b0 #b111111100010111 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
