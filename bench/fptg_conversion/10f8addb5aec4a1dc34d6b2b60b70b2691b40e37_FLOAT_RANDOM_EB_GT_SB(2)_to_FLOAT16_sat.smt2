; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b10111011000111101 #b10001000001011)
                arg1
                (fp #b1 #b00101100101001000 #b01001001111101)))
(assert (fp.leq (fp #b1 #b00101100101001000 #b01001001111101)
                arg1
                (fp #b0 #b11101101011100010 #b00111101000111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0010111100)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00000 #b0010001011)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
