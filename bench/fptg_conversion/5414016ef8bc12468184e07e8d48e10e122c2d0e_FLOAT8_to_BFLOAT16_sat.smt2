(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0000)
                arg1
                (fp #b1 #b100 #b1011)))
(assert (fp.leq (fp #b1 #b100 #b1011)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = -3.375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000110 #b0101000)
                expect
                (fp #b1 #b10000000 #b1011000)))
(assert (fp.leq (fp #b1 #b10000000 #b1011000)
                expect
                (fp #b1 #b00101100 #b1110101)))
; expect = -3.375

(assert (= expect result))

(check-sat)
(exit)
