; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0110 #b0)
                arg1
                (fp #b1 #b0010 #b0)))
(assert (fp.leq (fp #b1 #b0010 #b0)
                arg1
                (fp #b0 #b0010 #b0)))
; arg1 = -0.03125

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110000111011000 #b01101001011101)
                expect
                (fp #b1 #b011111111111010 #b00000000000000)))
(assert (fp.leq (fp #b1 #b011111111111010 #b00000000000000)
                expect
                (fp #b0 #b110000101101111 #b00101001101011)))

(assert (= expect result))

(check-sat)
(exit)
