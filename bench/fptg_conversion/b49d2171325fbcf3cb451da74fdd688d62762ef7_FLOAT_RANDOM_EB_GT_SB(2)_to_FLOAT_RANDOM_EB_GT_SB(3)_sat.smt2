; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b100 #b0)
                arg1
                (fp #b1 #b011 #b1)))
(assert (fp.leq (fp #b1 #b011 #b1)
                arg1
                (fp #b0 #b000 #b0)))
; arg1 = -1.5

(declare-const result (_ FloatingPoint 12 9))
(assert (= result ((_ to_fp 12 9) rm arg1)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110110101011 #b11100001)
                expect
                (fp #b1 #b011111111111 #b10000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b10000000)
                expect
                (fp #b1 #b001001010101 #b01110001)))

(assert (= expect result))

(check-sat)
(exit)
