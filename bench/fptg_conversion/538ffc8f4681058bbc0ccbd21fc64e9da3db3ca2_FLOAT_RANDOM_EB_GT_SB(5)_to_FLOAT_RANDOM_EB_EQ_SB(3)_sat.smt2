; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111011011 #b01)
                arg1
                (fp #b1 #b000000000 #b11)))
(assert (fp.leq (fp #b1 #b000000000 #b11)
                arg1
                (fp #b0 #b111111010 #b10)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010111110 #b101001100)
                expect
                (fp #b1 #b0100000000 #b100000000)))
(assert (fp.leq (fp #b1 #b0100000000 #b100000000)
                expect
                (fp #b0 #b0100100111 #b100100100)))

(assert (= expect result))

(check-sat)
(exit)
