                arg1
                (fp #b0 #b00101100 #b01001011011000111100011)))
; arg1 = -531263360.0

(declare-const result (_ FloatingPoint 13 13))
(assert (= result ((_ to_fp 13 13) rm arg1)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1110010110101 #b110110001000)
                expect
                (fp #b1 #b1000000011011 #b111110101011)))
(assert (fp.leq (fp #b1 #b1000000011011 #b111110101011)
                expect
                (fp #b1 #b0011010110010 #b000101101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
