(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110100111010 #b1100001111100)
                arg1
                (fp #b1 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b10000000001101 #b0000000000000)
                arg1
                (fp #b1 #b01001111100000 #b0101011000100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011100 #b1101101)
                expect
                (fp #b1 #b10001101 #b0000000)))
(assert (fp.leq (fp #b1 #b10001101 #b0000000)
                expect
                (fp #b1 #b01111101 #b1010011)))
; expect = -16384.0

(assert (= expect result))

(check-sat)
(exit)
