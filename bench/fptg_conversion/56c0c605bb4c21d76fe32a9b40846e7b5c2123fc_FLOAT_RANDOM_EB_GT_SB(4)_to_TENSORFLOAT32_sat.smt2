(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b11)
                arg1
                (fp #b1 #b0110 #b10)))
(assert (fp.leq (fp #b1 #b0110 #b10)
                arg1
                (fp #b1 #b0100 #b01)))
; arg1 = -0.75

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001001 #b0100011101)
                expect
                (fp #b1 #b01111110 #b1000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b1000000000)
                expect
                (fp #b0 #b11001000 #b0011010110)))
; expect = -0.75

(assert (= expect result))

(check-sat)
(exit)
