(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0111)
                arg1
                (fp #b0 #b010 #b0000)))
(assert (fp.leq (fp #b0 #b010 #b0000)
                arg1
                (fp #b0 #b100 #b1011)))
; arg1 = 0.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00100 #b0000010010)
                expect
                (fp #b0 #b01110 #b0000000000)))
(assert (fp.leq (fp #b0 #b01110 #b0000000000)
                expect
                (fp #b0 #b11101 #b0001100111)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
(exit)
