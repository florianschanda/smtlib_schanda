; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100110 #b10110111011101001011101)
                arg1
                (fp #b1 #b11100010 #b00000100001101001001101)))
(assert (fp.leq (fp #b1 #b11100010 #b00000100001101001001101)
                arg1
                (fp #b0 #b11110110 #b10010011111011000110101)))
; arg1 = -644237551524864324087125639168.0

(declare-const result (_ FloatingPoint 13 4))
(assert (= result ((_ to_fp 13 4) rm arg1)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1011010000001 #b101)
                expect
                (fp #b1 #b1000001100010 #b001)))
(assert (fp.leq (fp #b1 #b1000001100010 #b001)
                expect
                (fp #b0 #b1011001111111 #b111)))

(assert (= expect result))

(check-sat)
(exit)
