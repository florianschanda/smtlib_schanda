(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b011 #b1100)))
(assert (fp.leq (fp #b1 #b011 #b1100)
                arg1
                (fp #b0 #b010 #b0111)))
; arg1 = -1.75

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111001 #b00110100100100001000101)
                expect
                (fp #b1 #b01111111 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b11000000000000000000000)
                expect
                (fp #b0 #b10111111 #b01011010110000000111110)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
