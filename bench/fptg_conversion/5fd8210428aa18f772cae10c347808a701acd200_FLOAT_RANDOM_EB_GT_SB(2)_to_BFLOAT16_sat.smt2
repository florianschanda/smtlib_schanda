(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10000101100111 #b01000101)
                arg1
                (fp #b1 #b10000000000111 #b01111111)))
(assert (fp.leq (fp #b1 #b10000000000111 #b01111111)
                arg1
                (fp #b1 #b00110100010011 #b10000101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100001 #b0101011)
                expect
                (fp #b1 #b10000111 #b1000000)))
(assert (fp.leq (fp #b1 #b10000111 #b1000000)
                expect
                (fp #b0 #b01101110 #b0110100)))
; expect = -384.0

(assert (= expect result))

(check-sat)
(exit)
