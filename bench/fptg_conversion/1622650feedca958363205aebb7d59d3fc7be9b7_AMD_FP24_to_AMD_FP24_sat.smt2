(assert (fp.leq (fp #b1 #b1111011 #b1010110010110010)
                expect
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                expect
                (fp #b1 #b1000110 #b1011010110101111)))
; expect = -4294934528.0

(assert (= expect result))

(check-sat)
