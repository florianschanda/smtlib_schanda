(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1001111010011011)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
