(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110101101 #b00110010)
                arg1
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                arg1
                (fp #b0 #b100000001 #b11111111)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result ((_ to_fp 8 6) rm arg1)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001001 #b00110)
                expect
                (fp #b1 #b00000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000)
                expect
                (fp #b0 #b01000111 #b11001)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
