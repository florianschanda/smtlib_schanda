(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1100010100)
                arg1
                (fp #b1 #b00000 #b0101100101)))
(assert (fp.leq (fp #b1 #b00000 #b0101100101)
                arg1
                (fp #b0 #b01101 #b1000111101)))
; arg1 = -0.000021278858184814453125

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000101010 #b0011001110)
                expect
                (fp #b1 #b01111101111 #b0110010100)))
(assert (fp.leq (fp #b1 #b01111101111 #b0110010100)
                expect
                (fp #b1 #b00101010011 #b1000010000)))

(assert (= expect result))

(check-sat)
(exit)
