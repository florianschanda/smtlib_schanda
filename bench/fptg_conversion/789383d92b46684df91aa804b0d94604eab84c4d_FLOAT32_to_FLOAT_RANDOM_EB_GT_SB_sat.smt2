(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00001110 #b11010001001001100011010)
                arg1
                (fp #b0 #b01111111 #b00011111001010101011110)))
(assert (fp.leq (fp #b0 #b01111111 #b00011111001010101011110)
                arg1
                (fp #b0 #b10011001 #b11000000011111111101110)))
; arg1 = 1.1217458248138427734375

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b100 #b1)
                expect
                (fp #b0 #b011 #b1)))
(assert (fp.leq (fp #b0 #b011 #b1)
                expect
                (fp #b0 #b101 #b0)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
