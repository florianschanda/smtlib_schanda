; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00101101 #b00110100110101110011011)
                arg1
                (fp #b0 #b10011110 #b11110001001010000001001)))
(assert (fp.leq (fp #b0 #b10011110 #b11110001001010000001001)
                arg1
                (fp #b0 #b11110011 #b10011001111110110010010)))
; arg1 = 4170451200.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011001 #b0101001001100100)
                expect
                (fp #b0 #b1011110 #b1111000100101001)))
(assert (fp.leq (fp #b0 #b1011110 #b1111000100101001)
                expect
                (fp #b0 #b1101001 #b0111000111011010)))
; expect = 4170481664.0

(assert (= expect result))

(check-sat)
(exit)
