(assert (fp.leq (fp #b1 #b00111010111111 #b0110011010110)
                expect
                (fp #b0 #b01111110000001 #b0000000000000)))
(assert (fp.leq (fp #b0 #b01111110000001 #b0000000000000)
                expect
                (fp #b0 #b10001101010101 #b1111000110010)))

(assert (= expect result))

