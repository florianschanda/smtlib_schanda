; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b10011011001011111111011)
                arg1
                (fp #b1 #b10000110 #b01010010101110101101100)))
(assert (fp.leq (fp #b1 #b10000110 #b01010010101110101101100)
                arg1
                (fp #b0 #b11101001 #b10011010000011111101000)))
; arg1 = -169.36492919921875

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110100101011001 #b100000101100001111000010011110010100110010101011001110011110000)
                expect
                (fp #b1 #b100000000000110 #b010100101011101011011000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000000110 #b010100101011101011011000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b010010001011010 #b001100101010010100101001100011000000111011110001101011110100000)))

(assert (= expect result))

(check-sat)
(exit)
