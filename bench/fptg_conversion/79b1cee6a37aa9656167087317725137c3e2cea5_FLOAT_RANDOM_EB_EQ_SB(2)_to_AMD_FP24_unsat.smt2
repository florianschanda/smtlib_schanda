(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101110 #b1000001101000100)
                expect
                (fp #b0 #b0111111 #b1100000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1100000000000000)
                expect
                (fp #b0 #b1001001 #b1111100110100110)))
; expect = 1.75

(assert (not (= expect result)))

(check-sat)
