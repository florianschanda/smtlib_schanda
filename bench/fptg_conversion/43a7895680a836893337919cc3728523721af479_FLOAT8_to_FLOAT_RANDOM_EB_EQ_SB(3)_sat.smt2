                expect
                (fp #b0 #b10000000000010 #b0010000000000)))
(assert (fp.leq (fp #b0 #b10000000000010 #b0010000000000)
                expect
                (fp #b0 #b10111011101110 #b1011111001001)))

(assert (= expect result))

