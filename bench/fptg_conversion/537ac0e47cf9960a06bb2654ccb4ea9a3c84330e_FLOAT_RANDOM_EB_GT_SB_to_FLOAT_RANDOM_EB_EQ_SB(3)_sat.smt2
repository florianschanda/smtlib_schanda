; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101001 #b00)
                arg1
                (fp #b1 #b0111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111 #b11)
                arg1
                (fp #b0 #b1001100 #b00)))
; arg1 = -1.75

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b100)
                expect
                (fp #b1 #b0111 #b110)))
(assert (fp.leq (fp #b1 #b0111 #b110)
                expect
                (fp #b0 #b0100 #b010)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
