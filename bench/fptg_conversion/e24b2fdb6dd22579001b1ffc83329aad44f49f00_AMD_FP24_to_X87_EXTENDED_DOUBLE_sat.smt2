                expect
                (fp #b0 #b100000000001110 #b110110111001111000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000001110 #b110110111001111000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b100101110001000 #b010001010111100100000111001100001010011110111010001000001111011)))

(assert (= expect result))

(check-sat)
