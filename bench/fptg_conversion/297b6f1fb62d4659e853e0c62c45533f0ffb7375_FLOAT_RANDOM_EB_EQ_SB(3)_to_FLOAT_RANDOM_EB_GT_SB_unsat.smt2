; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001100010 #b000111101)
                arg1
                (fp #b1 #b0000000000 #b001010110)))
(assert (fp.leq (fp #b1 #b0000000000 #b001010110)
                arg1
                (fp #b0 #b0001101100 #b001010000)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result ((_ to_fp 12 7) rm arg1)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b011101000101 #b001110)
                expect
                (fp #b1 #b010111111110 #b010110)))
(assert (fp.leq (fp #b1 #b010111111110 #b010110)
                expect
                (fp #b0 #b001110010001 #b101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
