; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b10010010001011001010001)
                arg1
                (fp #b0 #b11010101 #b00100111011100011000100)))
(assert (fp.leq (fp #b0 #b11010101 #b00100111011100011000100)
                arg1
                (fp #b0 #b11011001 #b01010101001001000010101)))
; arg1 = 89292313239018475236622336.0

(declare-const result (_ FloatingPoint 18 18))
(assert (= result ((_ to_fp 18 18) rm arg1)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101001010000111110 #b11101001011000000)
                expect
                (fp #b0 #b100000000001010101 #b00100111011100100)))
(assert (fp.leq (fp #b0 #b100000000001010101 #b00100111011100100)
                expect
                (fp #b0 #b111101111011000101 #b01101011001010000)))

(assert (= expect result))

(check-sat)
(exit)
