; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000000001)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b10011 #b1100111011)))
; arg1 = -0.00006103515625

(declare-const result (_ FloatingPoint 15 12))
(assert (= result ((_ to_fp 15 12) rm arg1)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b110110111000110 #b00100011000)
                expect
                (fp #b1 #b011111111110001 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111111110001 #b00000000000)
                expect
                (fp #b1 #b001101010010010 #b10111010011)))

(assert (= expect result))

(check-sat)
(exit)
