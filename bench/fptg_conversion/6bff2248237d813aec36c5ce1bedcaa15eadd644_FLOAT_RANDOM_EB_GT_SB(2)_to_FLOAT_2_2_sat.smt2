; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b0 #b00100100100011011 #b1101010)
                arg1
                (fp #b0 #b01010111000001010 #b1001010)))
(assert (fp.leq (fp #b0 #b01010111000001010 #b1001010)
                arg1
                (fp #b0 #b11000110111110000 #b1000110)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b01 #b1)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
