(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg1
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                arg1
                (fp #b0 #b0000 #b101)))
; arg1 = -0.001953125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010011 #b01100001000111100110011)
                expect
                (fp #b1 #b01110110 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01110110 #b00000000000000000000000)
                expect
                (fp #b0 #b10000101 #b01011011100010110100111)))
; expect = -0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
