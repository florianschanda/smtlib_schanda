(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: PIXAR_PXR24
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b1111111)
                arg1
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg1
                (fp #b1 #b01101101 #b1001100)))
; arg1 = -256.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110000 #b010110001001011)
                expect
                (fp #b1 #b10000111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10000111 #b000000000000000)
                expect
                (fp #b0 #b11110111 #b011010010101011)))
; expect = -256.0

(assert (= expect result))

(check-sat)
(exit)
