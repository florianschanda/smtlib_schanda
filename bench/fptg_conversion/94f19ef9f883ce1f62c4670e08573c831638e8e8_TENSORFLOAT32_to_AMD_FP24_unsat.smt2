; Format from: TENSORFLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b0110111111)
                arg1
                (fp #b1 #b11001110 #b1011111101)))
(assert (fp.leq (fp #b1 #b11001110 #b1011111101)
                arg1
                (fp #b0 #b01000001 #b1110111001)))
; arg1 = -1056039204731724410912768.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
