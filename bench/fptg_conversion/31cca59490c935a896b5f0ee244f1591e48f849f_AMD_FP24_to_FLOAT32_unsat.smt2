; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010000 #b1100011110001001)
                arg1
                (fp #b1 #b1001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110101)
                arg1
                (fp #b0 #b1100111 #b0000010100110000)))
; arg1 = -130165.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100000 #b00101111010100011100001)
                expect
                (fp #b1 #b10001111 #b11111100011101010000000)))
(assert (fp.leq (fp #b1 #b10001111 #b11111100011101010000000)
                expect
                (fp #b1 #b10001000 #b11011111010011000010101)))
; expect = -130165.0

(assert (not (= expect result)))

(check-sat)
(exit)
