(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b11010110001011000 #b100000)
                arg1
                (fp #b1 #b00100100000000010 #b010101)))
(assert (fp.leq (fp #b1 #b00100100000000010 #b010101)
                arg1
                (fp #b0 #b00111010010000011 #b001011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00000 #b1101101011)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00101 #b1100001100)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
