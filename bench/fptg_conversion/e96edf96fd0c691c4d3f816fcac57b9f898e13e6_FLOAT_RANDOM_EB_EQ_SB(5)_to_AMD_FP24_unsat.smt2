; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b011)
                arg1
                (fp #b0 #b1100 #b110)))
(assert (fp.leq (fp #b0 #b1100 #b110)
                arg1
                (fp #b0 #b1101 #b000)))
; arg1 = 56.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111111 #b1001111100100000)
                expect
                (fp #b0 #b1000100 #b1100000000000000)))
(assert (fp.leq (fp #b0 #b1000100 #b1100000000000000)
                expect
                (fp #b0 #b1101001 #b1100011111100111)))
; expect = 56.0

(assert (not (= expect result)))

(check-sat)
(exit)
