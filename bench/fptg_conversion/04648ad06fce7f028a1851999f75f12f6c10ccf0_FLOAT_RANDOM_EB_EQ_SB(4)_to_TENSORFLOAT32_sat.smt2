(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b1001100010)
                expect
                (fp #b1 #b01111111 #b0100101011)))
(assert (fp.leq (fp #b1 #b01111111 #b0100101011)
                expect
                (fp #b1 #b00110110 #b0101110100)))
; expect = -1.2919921875

