; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011101 #b10010010010010101100100)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b1 #b00010110 #b11111000110101101110011)))
; arg1 = -1698008524581344716521472.0

(declare-const result (_ FloatingPoint 11 3))
(assert (= result ((_ to_fp 11 3) rm arg1)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11010111001 #b01)
                expect
                (fp #b1 #b10001001111 #b10)))
(assert (fp.leq (fp #b1 #b10001001111 #b10)
                expect
                (fp #b0 #b01010001111 #b01)))

(assert (= expect result))

(check-sat)
(exit)
