; Format from: TENSORFLOAT32
; Format to: FLOAT64
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b0010000100)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b1 #b00000100 #b0000010110)))
; arg1 = -2048.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b1100110011010100001111011111110101110110100110001110)
                expect
                (fp #b1 #b10000001010 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00110101010 #b0100101100101001100001100101010001000110101101100111)))

(assert (= expect result))

(check-sat)
(exit)
