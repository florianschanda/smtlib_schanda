; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg1
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg1
                (fp #b1 #b000 #b0000)))
; arg1 = -0.234375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111100 #b00010)
                expect
                (fp #b1 #b011100 #b11100)))
(assert (fp.leq (fp #b1 #b011100 #b11100)
                expect
                (fp #b1 #b000001 #b10000)))
; expect = -0.234375

(assert (= expect result))

(check-sat)
(exit)
