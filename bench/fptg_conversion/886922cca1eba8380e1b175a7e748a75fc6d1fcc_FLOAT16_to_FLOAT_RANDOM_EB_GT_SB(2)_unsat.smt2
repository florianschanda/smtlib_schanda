; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1101010110)
                arg1
                (fp #b1 #b00010 #b1001100111)))
(assert (fp.leq (fp #b1 #b00010 #b1001100111)
                arg1
                (fp #b0 #b11110 #b0011110100)))
; arg1 = -0.00019538402557373046875

(declare-const result (_ FloatingPoint 12 8))
(assert (= result ((_ to_fp 12 8) rm arg1)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100010000101 #b0001100)
                expect
                (fp #b1 #b011111110010 #b1001101)))
(assert (fp.leq (fp #b1 #b011111110010 #b1001101)
                expect
                (fp #b1 #b011001000010 #b1010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
