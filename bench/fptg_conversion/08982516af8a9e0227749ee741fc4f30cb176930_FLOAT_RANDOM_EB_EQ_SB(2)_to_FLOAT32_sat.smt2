(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b010)
                arg1
                (fp #b0 #b0000 #b110)))
(assert (fp.leq (fp #b0 #b0000 #b110)
                arg1
                (fp #b0 #b0111 #b110)))
; arg1 = 0.01171875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b11000100000001111001000)
                expect
                (fp #b0 #b01111000 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111000 #b10000000000000000000000)
                expect
                (fp #b0 #b11001101 #b11111000011001101001101)))
; expect = 0.01171875

(assert (= expect result))

(check-sat)
(exit)
