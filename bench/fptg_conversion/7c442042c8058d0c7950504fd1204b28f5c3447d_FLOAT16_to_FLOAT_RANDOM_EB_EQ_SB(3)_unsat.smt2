(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000000001)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b10011 #b1100111011)))
; arg1 = -0.00006103515625

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b11)
                expect
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                expect
                (fp #b0 #b001 #b10)))
; expect = -0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
