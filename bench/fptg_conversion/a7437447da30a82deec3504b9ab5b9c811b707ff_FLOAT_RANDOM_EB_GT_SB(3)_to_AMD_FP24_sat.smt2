(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b1 #b000 #b1)))
(assert (fp.leq (fp #b1 #b000 #b1)
                arg1
                (fp #b0 #b000 #b1)))
; arg1 = -0.125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011101 #b0011010100010000)
                expect
                (fp #b1 #b0111100 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111100 #b0000000000000000)
                expect
                (fp #b0 #b0001001 #b1100001111010000)))
; expect = -0.125

(assert (= expect result))

(check-sat)
(exit)
