                expect
                (fp #b0 #b0000000000 #b000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b1011011011 #b110110001000010010001110000000100100111010010000100)))

(assert (= expect result))

