; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000100 #b1101000)
                arg1
                (fp #b0 #b00000000 #b1100110)))
(assert (fp.leq (fp #b0 #b00000000 #b1100110)
                arg1
                (fp #b0 #b10000010 #b0010010)))
; arg1 = 0.000000000000000000000000000000000000009367220608115103579125869280989770245117491155527572437022865159406137536279857158660888671875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b1000010110)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b00110 #b0000001010)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
