(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01010101 #b00010010111000011010100)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b11111110 #b01000101110101101110111)))
; arg1 = 1.90954005718231201171875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000000 #b1111010)
                expect
                (fp #b0 #b01111111 #b1110101)))
(assert (fp.leq (fp #b0 #b01111111 #b1110101)
                expect
                (fp #b0 #b11101001 #b0110100)))
; expect = 1.9140625

(assert (not (= expect result)))

(check-sat)
(exit)
