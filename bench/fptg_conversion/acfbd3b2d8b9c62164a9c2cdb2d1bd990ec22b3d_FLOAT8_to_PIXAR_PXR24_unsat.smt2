; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1111)
                arg1
                (fp #b1 #b010 #b1000)))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b0 #b001 #b0110)))
; arg1 = -0.75

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011101 #b110101111100110)
                expect
                (fp #b1 #b01111110 #b100000000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b100000000000000)
                expect
                (fp #b0 #b00110111 #b110100011011101)))
; expect = -0.75

(assert (not (= expect result)))

(check-sat)
(exit)
