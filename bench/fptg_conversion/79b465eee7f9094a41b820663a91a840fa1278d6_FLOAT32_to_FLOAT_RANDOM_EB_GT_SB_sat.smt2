(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100101 #b00000010111110100100011)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11111000 #b00101110100100011110111)))
; arg1 = 1.76562607288360595703125

(declare-const result (_ FloatingPoint 14 3))
(assert (= result ((_ to_fp 14 3) rm arg1)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b01100110000000 #b10)
                expect
                (fp #b0 #b10000000000000 #b00)))
(assert (fp.leq (fp #b0 #b10000000000000 #b00)
                expect
                (fp #b0 #b10111101100010 #b01)))

(assert (= expect result))

(check-sat)
(exit)
