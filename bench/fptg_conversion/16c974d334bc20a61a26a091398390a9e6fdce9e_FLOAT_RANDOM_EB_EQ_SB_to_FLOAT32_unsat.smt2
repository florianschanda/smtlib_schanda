(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b001)
                arg1
                (fp #b1 #b0100 #b110)))
(assert (fp.leq (fp #b1 #b0100 #b110)
                arg1
                (fp #b1 #b0010 #b001)))
; arg1 = -0.21875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101110 #b11100000101110101001011)
                expect
                (fp #b1 #b01111100 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111100 #b11000000000000000000000)
                expect
                (fp #b1 #b00101110 #b01111001111000001010001)))
; expect = -0.21875

(assert (not (= expect result)))

(check-sat)
(exit)
