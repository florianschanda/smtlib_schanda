(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg1
                (fp #b0 #b0011 #b001)))
(assert (fp.leq (fp #b0 #b0011 #b001)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = 0.0703125

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b01 #b0)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
