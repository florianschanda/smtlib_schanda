(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01111011 #b10111000011000001010001)
                arg1
                (fp #b0 #b10011101 #b00000111101001011001111)))
(assert (fp.leq (fp #b0 #b10011101 #b00000111101001011001111)
                arg1
                (fp #b0 #b10101011 #b01110011101010100110101)))
; arg1 = 1105815424.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110111 #b1010011)
                expect
                (fp #b0 #b10011101 #b0000100)))
(assert (fp.leq (fp #b0 #b10011101 #b0000100)
                expect
                (fp #b0 #b11011101 #b0000101)))
; expect = 1107296256.0

(assert (= expect result))

(check-sat)
(exit)
