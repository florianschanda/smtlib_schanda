; Format from: FLOAT16
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1101011010)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11100 #b0101000111)))
