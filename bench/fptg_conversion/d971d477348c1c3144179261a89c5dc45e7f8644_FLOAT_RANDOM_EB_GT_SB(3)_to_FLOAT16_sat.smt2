; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0010101101011011 #b00011110000000)
                arg1
                (fp #b1 #b0000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01000000000000)
                arg1
                (fp #b0 #b0100010110110110 #b01011100100110)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b1011100011)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00101 #b0011110011)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
