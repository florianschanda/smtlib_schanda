; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1000100101000 #b010111010011)
                arg1
                (fp #b1 #b1000000001011 #b001110111110)))
(assert (fp.leq (fp #b1 #b1000000001011 #b001110111110)
                arg1
                (fp #b0 #b0110000001100 #b010111111000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110000 #b1010010010)
                expect
                (fp #b1 #b10001011 #b0011110000)))
(assert (fp.leq (fp #b1 #b10001011 #b0011110000)
                expect
                (fp #b0 #b10011110 #b0111000011)))
; expect = -5056.0

(assert (= expect result))

(check-sat)
(exit)
