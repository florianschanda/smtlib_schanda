; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101111 #b0101000111011100)
                arg1
                (fp #b0 #b1010010 #b1100101110011111)))
(assert (fp.leq (fp #b0 #b1010010 #b1100101110011111)
                arg1
                (fp #b0 #b1101011 #b1110010101010110)))
; arg1 = 941304.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b00000111011001111110010)
                expect
                (fp #b0 #b10010010 #b11001011100111110000000)))
(assert (fp.leq (fp #b0 #b10010010 #b11001011100111110000000)
                expect
                (fp #b0 #b11101000 #b10111001110000011000010)))
; expect = 941304.0

(assert (not (= expect result)))

(check-sat)
(exit)
