(assert (fp.leq (fp #b1 #b101111000001110 #b0)
                expect
                (fp #b1 #b011111111111101 #b0)))
(assert (fp.leq (fp #b1 #b011111111111101 #b0)
                expect
                (fp #b0 #b100000110010110 #b1)))

(assert (not (= expect result)))

(check-sat)
