; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

