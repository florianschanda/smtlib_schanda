(assert (fp.leq (fp #b1 #b10110111 #b10111010010010111010110)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11100000 #b11111010011110101011101)))
; arg1 = 55651713024.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111110 #b000110111010111)
                expect
                (fp #b0 #b10100010 #b100111101010010)))
(assert (fp.leq (fp #b0 #b10100010 #b100111101010010)
                expect
                (fp #b0 #b10110110 #b101011110110000)))
; expect = 55652122624.0

(assert (not (= expect result)))

(check-sat)
(exit)
