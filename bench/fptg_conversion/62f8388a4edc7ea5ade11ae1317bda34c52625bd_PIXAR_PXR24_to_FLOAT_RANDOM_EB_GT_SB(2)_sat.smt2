; Format from: PIXAR_PXR24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010011 #b001110111010100)
                arg1
                (fp #b0 #b10001101 #b011011001010000)))
(assert (fp.leq (fp #b0 #b10001101 #b011011001010000)
                arg1
                (fp #b0 #b11010100 #b101011100100100)))
; arg1 = 23336.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result ((_ to_fp 7 4) rm arg1)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1111100 #b000)
                expect
                (fp #b0 #b1001101 #b100)))
(assert (fp.leq (fp #b0 #b1001101 #b100)
                expect
                (fp #b0 #b1111110 #b000)))
; expect = 24576.0

(assert (= expect result))

(check-sat)
(exit)
