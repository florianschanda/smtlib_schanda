; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110111111)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b1 #b00000 #b0101101101)))
; arg1 = -2048.0

(declare-const result (_ FloatingPoint 12 10))
(assert (= result ((_ to_fp 12 10) rm arg1)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101001001101 #b001010000)
                expect
                (fp #b1 #b100000001010 #b000000000)))
(assert (fp.leq (fp #b1 #b100000001010 #b000000000)
                expect
                (fp #b0 #b100110101111 #b100101001)))

(assert (= expect result))

(check-sat)
(exit)
