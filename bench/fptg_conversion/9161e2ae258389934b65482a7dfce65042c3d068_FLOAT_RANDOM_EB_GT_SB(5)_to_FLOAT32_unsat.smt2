                expect
                (fp #b1 #b01110111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01110111 #b00000000000000000000000)
                expect
                (fp #b1 #b00000110 #b10010011100010000000001)))
; expect = -0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
