(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b1000 #b1)
                arg1
                (fp #b0 #b1101 #b0)))
(assert (fp.leq (fp #b0 #b1101 #b0)
                arg1
                (fp #b0 #b1110 #b1)))
; arg1 = 64.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01000111 #b0101101000)
                expect
                (fp #b0 #b10000101 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000101 #b0000000000)
                expect
                (fp #b0 #b10100111 #b0111000000)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
