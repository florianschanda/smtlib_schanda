(assert (fp.leq (fp #b1 #b11011111 #b011011011110010)
                expect
                (fp #b1 #b10111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10111111 #b000000000000000)
                expect
                (fp #b0 #b01001101 #b010001001001111)))
; expect = -18446744073709551616.0

(assert (not (= expect result)))

