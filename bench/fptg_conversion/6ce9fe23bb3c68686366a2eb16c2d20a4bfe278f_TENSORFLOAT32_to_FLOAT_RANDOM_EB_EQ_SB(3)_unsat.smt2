(assert (fp.leq (fp #b1 #b1111011 #b100000)
                expect
                (fp #b1 #b0111111 #b001001)))
(assert (fp.leq (fp #b1 #b0111111 #b001001)
                expect
                (fp #b0 #b1100101 #b011111)))
; expect = -1.140625

(assert (not (= expect result)))

