(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b0 #b001 #b10)))
(assert (fp.leq (fp #b0 #b001 #b10)
                arg1
                (fp #b0 #b100 #b00)))
; arg1 = 0.375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010110 #b1001111011010100)
                expect
                (fp #b0 #b0111101 #b1000000000000000)))
(assert (fp.leq (fp #b0 #b0111101 #b1000000000000000)
                expect
                (fp #b0 #b1100010 #b1010001011000110)))
; expect = 0.375

(assert (= expect result))

(check-sat)
(exit)
