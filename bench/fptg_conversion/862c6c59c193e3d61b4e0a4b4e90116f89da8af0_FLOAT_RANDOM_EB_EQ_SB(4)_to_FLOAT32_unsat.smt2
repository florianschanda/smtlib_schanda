(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                arg1
                (fp #b1 #b010 #b00)))
(assert (fp.leq (fp #b1 #b010 #b00)
                arg1
                (fp #b0 #b101 #b00)))
; arg1 = -0.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111110 #b01101010111101101101001)
                expect
                (fp #b1 #b01111110 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b00000000000000000000000)
                expect
                (fp #b0 #b00010100 #b00100001110001101110010)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
