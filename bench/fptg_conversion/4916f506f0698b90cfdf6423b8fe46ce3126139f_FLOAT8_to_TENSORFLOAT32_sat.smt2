(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b1 #b000 #b1000)))
(assert (fp.leq (fp #b1 #b000 #b1000)
                arg1
                (fp #b0 #b001 #b0110)))
; arg1 = -0.125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010110 #b1011101100)
                expect
                (fp #b1 #b01111100 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111100 #b0000000000)
                expect
                (fp #b0 #b11010101 #b0111001000)))
; expect = -0.125

(assert (= expect result))

(check-sat)
(exit)
