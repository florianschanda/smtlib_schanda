; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg1
                (fp #b1 #b01111111 #b100)))
(assert (fp.leq (fp #b1 #b01111111 #b100)
                arg1
                (fp #b0 #b01101101 #b010)))
; arg1 = -1.5

(declare-const result (_ FloatingPoint 14 2))
(assert (= result ((_ to_fp 14 2) rm arg1)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11001100111110 #b0)
                expect
                (fp #b1 #b01111111111111 #b1)))
(assert (fp.leq (fp #b1 #b01111111111111 #b1)
                expect
                (fp #b1 #b00000010101101 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
