(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b01101001011000100000110)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b00111011 #b10001001000001000110011)))
; arg1 = -1.6049678325653076171875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010010 #b1111010)
                expect
                (fp #b1 #b01111111 #b1001110)))
(assert (fp.leq (fp #b1 #b01111111 #b1001110)
                expect
                (fp #b0 #b00010010 #b1000000)))
; expect = -1.609375

(assert (not (= expect result)))

(check-sat)
(exit)
