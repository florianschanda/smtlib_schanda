(assert (fp.leq (fp #b1 #b11001010 #b1001100)
                expect
                (fp #b1 #b01111111 #b1100010)))
(assert (fp.leq (fp #b1 #b01111111 #b1100010)
                expect
                (fp #b1 #b00001110 #b1011010)))
; expect = -1.765625

(assert (not (= expect result)))

