(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01100010111111001000111)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01111111 #b01001010111001100111110)))
; arg1 = -1316616.0

(declare-const result (_ FloatingPoint 17 17))
(assert (= result ((_ to_fp 17 17) rm arg1)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11010011011100110 #b1100110110111111)
                expect
                (fp #b1 #b10000000000010011 #b0100000101110001)))
(assert (fp.leq (fp #b1 #b10000000000010011 #b0100000101110001)
                expect
                (fp #b0 #b00101110101001111 #b1011110011000010)))

(assert (= expect result))

(check-sat)
(exit)
