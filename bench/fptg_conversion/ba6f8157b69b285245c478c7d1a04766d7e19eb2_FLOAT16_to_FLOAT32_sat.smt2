; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00110 #b1111111001)
                arg1
                (fp #b0 #b10010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10010 #b1101101011)
                arg1
                (fp #b0 #b11000 #b1111011110)))
; arg1 = 14.8359375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001000 #b10101100001110101110100)
                expect
                (fp #b0 #b10000010 #b11011010110000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b11011010110000000000000)
                expect
                (fp #b0 #b11110000 #b10010001000101011111000)))
; expect = 14.8359375

(assert (= expect result))

(check-sat)
(exit)
