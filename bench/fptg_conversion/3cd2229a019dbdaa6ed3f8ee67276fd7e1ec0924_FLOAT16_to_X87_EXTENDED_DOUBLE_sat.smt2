(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b0 #b011000011101110 #b101101101010011110001011111011000110001000010101100001011010101)
                expect
                (fp #b0 #b011111111110001 #b000100101000000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b011111111110001 #b000100101000000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b100011001000000 #b110101111111100100010011110111110110111100010011110000110010101)))

(assert (= expect result))

(check-sat)
(exit)
