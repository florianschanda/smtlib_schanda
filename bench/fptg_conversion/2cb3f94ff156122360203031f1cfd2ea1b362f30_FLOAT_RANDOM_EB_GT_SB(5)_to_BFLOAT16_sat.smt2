(assert (fp.leq (fp #b1 #b10011010 #b1001000)
                expect
                (fp #b1 #b00000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000001)
                expect
                (fp #b0 #b01010001 #b1011110)))
