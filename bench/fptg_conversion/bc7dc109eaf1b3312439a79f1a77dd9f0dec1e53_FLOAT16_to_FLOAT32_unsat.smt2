(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg1
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11100 #b0011010100)))
; arg1 = -65504.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000000 #b10110000101000110110111)
                expect
                (fp #b1 #b10001110 #b11111111110000000000000)))
(assert (fp.leq (fp #b1 #b10001110 #b11111111110000000000000)
                expect
                (fp #b1 #b00100010 #b00010111000001101100011)))
; expect = -65504.0

(assert (not (= expect result)))

(check-sat)
(exit)
