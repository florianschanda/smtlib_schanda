(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg1
                (fp #b1 #b01 #b0)))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg1
                (fp #b0 #b10 #b1)))
; arg1 = -1.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b00000)
                expect
                (fp #b1 #b011111 #b00000)))
(assert (fp.leq (fp #b1 #b011111 #b00000)
                expect
                (fp #b1 #b000101 #b11001)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
