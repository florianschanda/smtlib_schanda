; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001101 #b010110)
                arg1
                (fp #b1 #b0100000 #b110111)))
(assert (fp.leq (fp #b1 #b0100000 #b110111)
                arg1
                (fp #b1 #b0000011 #b101101)))
; arg1 = -0.0000000008658389560878276824951171875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110011 #b1110110)
                expect
                (fp #b1 #b01100000 #b1101110)))
(assert (fp.leq (fp #b1 #b01100000 #b1101110)
                expect
                (fp #b0 #b11011101 #b1011000)))
; expect = -0.0000000008658389560878276824951171875

(assert (= expect result))

(check-sat)
(exit)
