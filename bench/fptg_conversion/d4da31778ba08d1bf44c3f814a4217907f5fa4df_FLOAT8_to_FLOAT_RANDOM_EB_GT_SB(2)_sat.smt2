                expect
                (fp #b1 #b0111111111111111 #b0111000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b0111000000)
                expect
                (fp #b1 #b0100011111010100 #b0101101011)))

(assert (= expect result))

(check-sat)
