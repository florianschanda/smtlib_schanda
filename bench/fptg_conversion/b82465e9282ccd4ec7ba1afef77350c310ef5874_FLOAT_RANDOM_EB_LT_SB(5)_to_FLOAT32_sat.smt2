; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 54))
(assert (fp.leq (fp #b1 #b101 #b11100101101001100110011100100000000101001010011011111)
                arg1
                (fp #b0 #b011 #b00001111000011111111111000101101001010100010010111011)))
(assert (fp.leq (fp #b0 #b011 #b00001111000011111111111000101101001010100010010111011)
                arg1
                (fp #b0 #b101 #b11000101101010011110110100001000101101101111011100101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101101 #b00011101010110011001010)
                expect
                (fp #b0 #b01111111 #b00001111000100000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00001111000100000000000)
                expect
                (fp #b0 #b11010011 #b10100010111101100100001)))
; expect = 1.058837890625

(assert (= expect result))

(check-sat)
(exit)
