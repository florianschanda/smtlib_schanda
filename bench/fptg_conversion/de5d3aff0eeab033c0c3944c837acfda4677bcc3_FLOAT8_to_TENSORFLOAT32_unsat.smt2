                expect
                (fp #b1 #b01111101 #b0100000000)))
(assert (fp.leq (fp #b1 #b01111101 #b0100000000)
                expect
                (fp #b0 #b10110100 #b0011011101)))
; expect = -0.3125

(assert (not (= expect result)))

