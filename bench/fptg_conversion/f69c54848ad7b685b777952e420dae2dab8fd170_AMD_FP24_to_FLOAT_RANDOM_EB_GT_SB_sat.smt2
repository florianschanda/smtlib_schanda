; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001001 #b0111100010001111)
                arg1
                (fp #b0 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0011000 #b0000000000000000)
                arg1
                (fp #b0 #b0100110 #b0110101111001011)))
; arg1 = 0.000000000001818989403545856475830078125

(declare-const result (_ FloatingPoint 10 9))
(assert (= result ((_ to_fp 10 9) rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001111000 #b01001111)
                expect
                (fp #b0 #b0111011000 #b00000000)))
(assert (fp.leq (fp #b0 #b0111011000 #b00000000)
                expect
                (fp #b0 #b1111000001 #b10000000)))

(assert (= expect result))

(check-sat)
(exit)
