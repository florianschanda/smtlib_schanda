(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0001101101000111 #b101001101001001)
                arg1
                (fp #b0 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1000000000001111 #b000000000000000)
                arg1
                (fp #b0 #b1111111110110000 #b111011100100001)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111100 #b10010110100001101001111)
                expect
                (fp #b0 #b10001111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b00000000000000000000000)
                expect
                (fp #b0 #b10011100 #b10000001111011010001010)))
; expect = 65536.0

(assert (= expect result))

(check-sat)
(exit)
