                expect
                (fp #b1 #b10000000001 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000001 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01010010100 #b1001111000110010100000001110111110101010110100101110)))

(assert (= expect result))

