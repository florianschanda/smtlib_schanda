; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b1001101101101001)
                arg1
                (fp #b1 #b0111111 #b1111001000110010)))
(assert (fp.leq (fp #b1 #b0111111 #b1111001000110010)
                arg1
                (fp #b0 #b0101101 #b1100110011110100)))
; arg1 = -1.946075439453125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b0111001100)
                expect
                (fp #b1 #b01111 #b1111001001)))
(assert (fp.leq (fp #b1 #b01111 #b1111001001)
                expect
                (fp #b1 #b00011 #b0100000110)))
; expect = -1.9462890625

(assert (not (= expect result)))

(check-sat)
(exit)
