(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0001001011)
                arg1
                (fp #b0 #b00001 #b0001001010)))
(assert (fp.leq (fp #b0 #b00001 #b0001001010)
                arg1
                (fp #b0 #b10001 #b0110011111)))
; arg1 = 0.00006544589996337890625

(declare-const result (_ FloatingPoint 9 4))
(assert (= result ((_ to_fp 9 4) rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101101100 #b101)
                expect
                (fp #b0 #b011110001 #b001)))
(assert (fp.leq (fp #b0 #b011110001 #b001)
                expect
                (fp #b0 #b100000001 #b010)))

(assert (= expect result))

(check-sat)
(exit)
