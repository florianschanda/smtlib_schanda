(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1010)
                arg1
                (fp #b0 #b100 #b0010)))
(assert (fp.leq (fp #b0 #b100 #b0010)
                arg1
                (fp #b0 #b101 #b0001)))
; arg1 = 2.25

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110001 #b0010001101110100)
                expect
                (fp #b0 #b1000000 #b0010000000000000)))
(assert (fp.leq (fp #b0 #b1000000 #b0010000000000000)
                expect
                (fp #b0 #b1010001 #b1001100010001110)))
; expect = 2.25

(assert (= expect result))

(check-sat)
(exit)
