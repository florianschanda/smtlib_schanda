(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b001)
                arg1
                (fp #b0 #b0111 #b000)))
(assert (fp.leq (fp #b0 #b0111 #b000)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = 1.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010101 #b01110101011110000000010)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11010001 #b01011100011011110101110)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
