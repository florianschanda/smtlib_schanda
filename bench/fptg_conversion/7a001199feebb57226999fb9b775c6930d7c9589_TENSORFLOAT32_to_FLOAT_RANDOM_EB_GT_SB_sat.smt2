(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110111110000 #b1011)
                expect
                (fp #b1 #b011110000000 #b0101)))
(assert (fp.leq (fp #b1 #b011110000000 #b0101)
                expect
                (fp #b1 #b011010101000 #b1110)))

(assert (= expect result))

(check-sat)
(exit)
