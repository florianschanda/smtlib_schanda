; Format from: FLOAT16
; Format to: X87_EXTENDED_DOUBLE
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000110110)
                arg1
                (fp #b1 #b11001 #b0000110001)))
(assert (fp.leq (fp #b1 #b11001 #b0000110001)
                arg1
                (fp #b0 #b01010 #b1100110000)))
; arg1 = -1073.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b101001111001110 #b001100001100000011000000001111101011111110010101000011110100000)
                expect
                (fp #b1 #b100000000001001 #b000011000100000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000001001 #b000011000100000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b001100111010110 #b010001011101001100101100101111100100101100110010111100000010001)))

(assert (= expect result))

(check-sat)
(exit)
