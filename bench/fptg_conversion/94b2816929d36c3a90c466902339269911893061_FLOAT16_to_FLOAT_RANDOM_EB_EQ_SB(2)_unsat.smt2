; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1101011100)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b11101 #b1101011111)))
; arg1 = 0.054473876953125

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010011000 #b10110000)
                expect
                (fp #b0 #b011111010 #b10111111)))
(assert (fp.leq (fp #b0 #b011111010 #b10111111)
                expect
                (fp #b0 #b111010001 #b00101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
