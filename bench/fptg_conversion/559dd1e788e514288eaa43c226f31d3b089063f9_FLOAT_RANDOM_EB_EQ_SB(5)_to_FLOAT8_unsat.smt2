(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01100100111101 #b0101010110010)
                arg1
                (fp #b0 #b01111111111111 #b0111001100001)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0111001100001)
                arg1
                (fp #b0 #b10011010001111 #b0111101100110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b0011)
                expect
                (fp #b0 #b011 #b1000)))
(assert (fp.leq (fp #b0 #b011 #b1000)
                expect
                (fp #b0 #b110 #b1000)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
