(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0111)
                expect
                (fp #b0 #b011 #b1010)))
(assert (fp.leq (fp #b0 #b011 #b1010)
                expect
                (fp #b0 #b110 #b1111)))
; expect = 1.625

(assert (not (= expect result)))

