(assert (fp.leq (fp #b1 #b10101111 #b1111010)
                expect
                (fp #b1 #b10001111 #b0000000)))
(assert (fp.leq (fp #b1 #b10001111 #b0000000)
                expect
                (fp #b0 #b10011000 #b0101101)))
; expect = -65536.0

(assert (= expect result))

