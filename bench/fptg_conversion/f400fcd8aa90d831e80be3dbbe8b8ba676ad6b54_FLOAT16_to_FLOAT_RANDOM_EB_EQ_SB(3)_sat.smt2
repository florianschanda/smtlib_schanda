; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b1110101010)
                arg1
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg1
                (fp #b0 #b10011 #b1001001111)))
; arg1 = 1.3701171875

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b011101101111010 #b11011101100100)
                expect
                (fp #b0 #b011111111111111 #b01011110110000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b01011110110000)
                expect
                (fp #b0 #b111011101011111 #b11001000111000)))

(assert (= expect result))

(check-sat)
(exit)
