(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101100 #b01100111001110001001010)
                arg1
                (fp #b0 #b10010010 #b10110101011110010100000)))
(assert (fp.leq (fp #b0 #b10010010 #b10110101011110010100000)
                arg1
                (fp #b0 #b11000001 #b11000001000101101011100)))
; arg1 = 895946.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000001 #b1010110001100011)
                expect
                (fp #b0 #b1010010 #b1011010101111010)))
(assert (fp.leq (fp #b0 #b1010010 #b1011010101111010)
                expect
                (fp #b0 #b1011111 #b0010001000101100)))
; expect = 895952.0

(assert (not (= expect result)))

(check-sat)
(exit)
