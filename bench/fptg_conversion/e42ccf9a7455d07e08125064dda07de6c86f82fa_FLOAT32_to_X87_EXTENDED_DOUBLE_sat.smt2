; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101100 #b01100111001110001001010)
                arg1
                (fp #b0 #b10010010 #b10110101011110010100000)))
(assert (fp.leq (fp #b0 #b10010010 #b10110101011110010100000)
                arg1
                (fp #b0 #b11000001 #b11000001000101101011100)))
; arg1 = 895946.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b0 #b001000001000110 #b100110001011111111001100100111001010010111000011010011000101000)
                expect
                (fp #b0 #b100000000010010 #b101101010111100101000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000010010 #b101101010111100101000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b101111111100111 #b111111101001010011011011101111010101100010100101001111111100100)))

(assert (= expect result))

(check-sat)
(exit)
