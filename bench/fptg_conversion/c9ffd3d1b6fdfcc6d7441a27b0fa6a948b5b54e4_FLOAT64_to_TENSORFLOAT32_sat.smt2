; Format from: FLOAT64
; Format to: TENSORFLOAT32
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001011110 #b0011001101101001100010110111011110010011100011101101)
                arg1
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b00000110001 #b1101110010110000000100100111100100010100010001111011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110001 #b0011111111)
                expect
                (fp #b1 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0000000000)
                expect
                (fp #b1 #b00101011 #b1111111101)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
