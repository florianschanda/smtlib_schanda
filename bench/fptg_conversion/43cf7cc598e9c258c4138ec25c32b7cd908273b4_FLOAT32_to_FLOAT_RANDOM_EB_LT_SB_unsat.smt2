(assert (fp.leq (fp #b1 #b001 #b0011001100101111)
                expect
                (fp #b0 #b011 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b011 #b0000000000000000)
                expect
                (fp #b0 #b101 #b1000010111000101)))
; expect = 1.0

(assert (not (= expect result)))

