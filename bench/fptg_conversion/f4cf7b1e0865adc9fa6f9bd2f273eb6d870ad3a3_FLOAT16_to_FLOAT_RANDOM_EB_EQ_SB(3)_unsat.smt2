                expect
                (fp #b1 #b100000000001001 #b00001100010000)))
(assert (fp.leq (fp #b1 #b100000000001001 #b00001100010000)
                expect
                (fp #b0 #b011110111110000 #b11011110100011)))

(assert (not (= expect result)))

