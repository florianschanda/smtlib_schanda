; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b001)
                arg1
                (fp #b1 #b11101 #b000)))
(assert (fp.leq (fp #b1 #b11101 #b000)
                arg1
                (fp #b0 #b11001 #b010)))
; arg1 = -16384.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100010100 #b1001111010010010011010001011011111110100101010011101)
                expect
                (fp #b1 #b10000001101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01010011011 #b1001110011000100101001101010000001111101101001000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
