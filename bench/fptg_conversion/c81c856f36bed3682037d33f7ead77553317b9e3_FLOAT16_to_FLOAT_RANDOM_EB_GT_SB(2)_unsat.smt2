(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10100 #b1100010001)
                arg1
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                arg1
                (fp #b0 #b10011 #b0010100110)))
; arg1 = -0

(declare-const result (_ FloatingPoint 5 2))
(assert (= result ((_ to_fp 5 2) rm arg1)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11111 #b0)
                expect
                (fp #b1 #b00000 #b0)))
(assert (fp.leq (fp #b1 #b00000 #b0)
                expect
                (fp #b0 #b11000 #b0)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
