(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1110)))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b010 #b0101)))
; arg1 = -15.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0000111100)
                expect
                (fp #b1 #b10010 #b1110000000)))
(assert (fp.leq (fp #b1 #b10010 #b1110000000)
                expect
                (fp #b0 #b00110 #b1000001010)))
; expect = -15.0

(assert (= expect result))

(check-sat)
(exit)
