(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0011101000)
                arg1
                (fp #b1 #b01111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111 #b0001011101)
                arg1
                (fp #b0 #b00111 #b1000011000)))
; arg1 = -1.0908203125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0111)
                expect
                (fp #b1 #b011 #b0010)))
(assert (fp.leq (fp #b1 #b011 #b0010)
                expect
                (fp #b1 #b001 #b0010)))
; expect = -1.125

(assert (= expect result))

(check-sat)
(exit)
