; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0111110000)
                arg1
                (fp #b1 #b00100 #b0101100101)))
(assert (fp.leq (fp #b1 #b00100 #b0101100101)
                arg1
                (fp #b0 #b00100 #b0000100001)))
; arg1 = -0.000658512115478515625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100011 #b11011)
                expect
                (fp #b1 #b010100 #b01100)))
(assert (fp.leq (fp #b1 #b010100 #b01100)
                expect
                (fp #b0 #b010010 #b00000)))
; expect = -0.00067138671875

(assert (not (= expect result)))

(check-sat)
(exit)
