; arg1 = 59.75

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00011000 #b00000011110110111101000)
                expect
                (fp #b0 #b10000100 #b11011110000000000000000)))
(assert (fp.leq (fp #b0 #b10000100 #b11011110000000000000000)
                expect
                (fp #b0 #b11011111 #b10111110010011001100110)))
; expect = 59.75

(assert (not (= expect result)))

(check-sat)
(exit)
