(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                arg1
                (fp #b1 #b010 #b00)))
(assert (fp.leq (fp #b1 #b010 #b00)
                arg1
                (fp #b0 #b101 #b00)))
; arg1 = -0.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1101101001)
                expect
                (fp #b1 #b01110 #b0000000000)))
(assert (fp.leq (fp #b1 #b01110 #b0000000000)
                expect
                (fp #b1 #b00000 #b1010111100)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
