; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b0111101001101110)
                arg1
                (fp #b0 #b1100011 #b1101001011011111)))
(assert (fp.leq (fp #b0 #b1100011 #b1101001011011111)
                arg1
                (fp #b0 #b1110111 #b1000010010000101)))
; arg1 = 125324754944.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000101 #b1001000110)
                expect
                (fp #b0 #b10100011 #b1101001100)))
(assert (fp.leq (fp #b0 #b10100011 #b1101001100)
                expect
                (fp #b0 #b10110010 #b1011100100)))
; expect = 125359357952.0

(assert (= expect result))

(check-sat)
(exit)
