(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111110110111001110 #b01100100111000111)
                expect
                (fp #b0 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b100101011010101101 #b11001010011001010)))

(assert (not (= expect result)))

(check-sat)
