(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10001011 #b1110000001)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b11011101 #b0000010100)))
; arg1 = -0

(declare-const result (_ FloatingPoint 16 7))
(assert (= result ((_ to_fp 16 7) rm arg1)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1000010110011111 #b000010)
                expect
                (fp #b1 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000)
                expect
                (fp #b0 #b0000000001100010 #b100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
