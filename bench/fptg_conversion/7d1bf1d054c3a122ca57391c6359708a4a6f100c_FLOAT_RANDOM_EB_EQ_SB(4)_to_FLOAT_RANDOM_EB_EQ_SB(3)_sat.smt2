; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000000 #b01011)
                arg1
                (fp #b0 #b010000 #b00000)))
(assert (fp.leq (fp #b0 #b010000 #b00000)
                arg1
                (fp #b0 #b111000 #b01110)))
; arg1 = 0.000030517578125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b111)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b1000 #b110)))
; expect = 0.001953125

(assert (= expect result))

(check-sat)
(exit)
