(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b011011110 #b01010)
                arg1
                (fp #b0 #b100000100 #b10000)))
(assert (fp.leq (fp #b0 #b100000100 #b10000)
                arg1
                (fp #b0 #b111011101 #b01111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010001 #b0010000001111110)
                expect
                (fp #b0 #b1000100 #b1000000000000000)))
(assert (fp.leq (fp #b0 #b1000100 #b1000000000000000)
                expect
                (fp #b0 #b1101001 #b0001100111110111)))
; expect = 48.0

(assert (= expect result))

(check-sat)
(exit)
