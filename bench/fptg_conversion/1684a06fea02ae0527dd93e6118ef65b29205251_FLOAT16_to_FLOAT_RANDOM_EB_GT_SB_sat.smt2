(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11110001101 #b1000000)
                expect
                (fp #b1 #b01111101101 #b1011110)))
(assert (fp.leq (fp #b1 #b01111101101 #b1011110)
                expect
                (fp #b0 #b00110010010 #b1101111)))

(assert (= expect result))

(check-sat)
(exit)
