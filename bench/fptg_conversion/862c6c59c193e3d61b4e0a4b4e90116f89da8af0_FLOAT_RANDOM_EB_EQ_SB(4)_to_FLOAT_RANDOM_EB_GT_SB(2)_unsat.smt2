(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                arg1
                (fp #b1 #b010 #b00)))
(assert (fp.leq (fp #b1 #b010 #b00)
                arg1
                (fp #b0 #b101 #b00)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b100 #b1)
                expect
                (fp #b1 #b010 #b0)))
(assert (fp.leq (fp #b1 #b010 #b0)
                expect
                (fp #b0 #b100 #b1)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
