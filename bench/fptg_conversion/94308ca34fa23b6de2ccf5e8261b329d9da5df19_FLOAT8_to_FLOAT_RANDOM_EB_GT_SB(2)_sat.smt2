(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1000)
                arg1
                (fp #b0 #b001 #b0011)))
(assert (fp.leq (fp #b0 #b001 #b0011)
                arg1
                (fp #b0 #b110 #b0011)))
; arg1 = 0.296875

(declare-const result (_ FloatingPoint 7 3))
(assert (= result ((_ to_fp 7 3) rm arg1)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b0000111 #b01)
                expect
                (fp #b0 #b0111101 #b01)))
(assert (fp.leq (fp #b0 #b0111101 #b01)
                expect
                (fp #b0 #b1011010 #b10)))
; expect = 0.3125

(assert (= expect result))

(check-sat)
(exit)
