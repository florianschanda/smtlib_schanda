(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b1110101010)
                arg1
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg1
                (fp #b0 #b10011 #b1001001111)))
; arg1 = 1.3701171875

(declare-const result (_ FloatingPoint 12 3))
(assert (= result ((_ to_fp 12 3) rm arg1)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b000111101001 #b00)
                expect
                (fp #b0 #b011111111111 #b10)))
(assert (fp.leq (fp #b0 #b011111111111 #b10)
                expect
                (fp #b0 #b100100111000 #b10)))

(assert (= expect result))

(check-sat)
(exit)
