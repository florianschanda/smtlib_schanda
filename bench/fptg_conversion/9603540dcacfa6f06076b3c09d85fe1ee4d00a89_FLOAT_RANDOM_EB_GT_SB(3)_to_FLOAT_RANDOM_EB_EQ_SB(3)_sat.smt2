; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b1)
                arg1
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                arg1
                (fp #b0 #b0010 #b0)))
; arg1 = 0.0078125

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011011 #b000011)
                expect
                (fp #b0 #b0111000 #b000000)))
(assert (fp.leq (fp #b0 #b0111000 #b000000)
                expect
                (fp #b0 #b1001001 #b001100)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
