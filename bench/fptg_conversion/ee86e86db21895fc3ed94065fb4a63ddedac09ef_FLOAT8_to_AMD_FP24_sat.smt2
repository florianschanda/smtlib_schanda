(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0011)
                arg1
                (fp #b1 #b000 #b1100)))
(assert (fp.leq (fp #b1 #b000 #b1100)
                arg1
                (fp #b0 #b001 #b0101)))
; arg1 = -0.1875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000101 #b0000111001011110)
                expect
                (fp #b1 #b0111100 #b1000000000000000)))
(assert (fp.leq (fp #b1 #b0111100 #b1000000000000000)
                expect
                (fp #b0 #b1100110 #b0100101000101100)))
; expect = -0.1875

(assert (= expect result))

(check-sat)
(exit)
