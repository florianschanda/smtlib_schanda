(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010011 #b1101101111)
                arg1
                (fp #b1 #b00000000 #b0101100101)))
(assert (fp.leq (fp #b1 #b00000000 #b0101100101)
                arg1
                (fp #b0 #b11011001 #b1100000011)))
; arg1 = -0.0000000000000000000000000000000000000040981590160503578158675678104330244822389023805433129411975035072401851721224375069141387939453125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0011)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b011 #b1100)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
