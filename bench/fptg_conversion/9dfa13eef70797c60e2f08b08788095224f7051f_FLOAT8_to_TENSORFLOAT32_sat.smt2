; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: +LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0111)
                arg1
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                arg1
                (fp #b0 #b111 #b0000)))
; arg1 = 15.5

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010000 #b1011111011)
                expect
                (fp #b0 #b10000010 #b1111000000)))
(assert (fp.leq (fp #b0 #b10000010 #b1111000000)
                expect
                (fp #b0 #b11100010 #b0000100000)))
; expect = 15.5

(assert (= expect result))

(check-sat)
(exit)
