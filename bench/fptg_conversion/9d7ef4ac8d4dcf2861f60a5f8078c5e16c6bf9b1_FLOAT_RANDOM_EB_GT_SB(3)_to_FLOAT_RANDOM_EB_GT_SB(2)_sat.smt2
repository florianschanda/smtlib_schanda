; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1000011111 #b0010101)
                arg1
                (fp #b0 #b0000000000 #b1100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100110)
                arg1
                (fp #b0 #b1000101100 #b1100100)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1110 #b0)
                expect
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                expect
                (fp #b0 #b1100 #b0)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
