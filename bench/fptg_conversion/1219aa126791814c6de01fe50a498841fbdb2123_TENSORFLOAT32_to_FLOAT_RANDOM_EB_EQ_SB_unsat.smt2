(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b1100)
                expect
                (fp #b1 #b11001 #b0111)))
(assert (fp.leq (fp #b1 #b11001 #b0111)
                expect
                (fp #b1 #b01100 #b0111)))
; expect = -1472.0

(assert (not (= expect result)))

