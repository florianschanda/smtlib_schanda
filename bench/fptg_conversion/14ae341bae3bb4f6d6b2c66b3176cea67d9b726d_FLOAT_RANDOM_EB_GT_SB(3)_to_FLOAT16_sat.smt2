(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000011010111 #b10000)
                arg1
                (fp #b0 #b0011000011100 #b10000)))
(assert (fp.leq (fp #b0 #b0011000011100 #b10000)
                arg1
                (fp #b0 #b1010110011000 #b01100)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b0010001110)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b11101 #b1110110001)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
