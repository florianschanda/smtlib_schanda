(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010011 #b0100111011)
                expect
                (fp #b1 #b01111001 #b0001000000)))
(assert (fp.leq (fp #b1 #b01111001 #b0001000000)
                expect
                (fp #b0 #b11010011 #b1001100011)))
; expect = -0.0166015625

(assert (= expect result))

(check-sat)
