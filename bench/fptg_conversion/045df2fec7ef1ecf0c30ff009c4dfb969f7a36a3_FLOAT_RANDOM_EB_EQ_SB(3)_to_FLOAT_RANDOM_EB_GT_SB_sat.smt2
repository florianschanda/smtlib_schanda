(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                arg1
                (fp #b1 #b011 #b01)))
(assert (fp.leq (fp #b1 #b011 #b01)
                arg1
                (fp #b0 #b100 #b11)))
; arg1 = -1.25

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1000001100 #b1101)
                expect
                (fp #b1 #b0111111111 #b0100)))
(assert (fp.leq (fp #b1 #b0111111111 #b0100)
                expect
                (fp #b1 #b0011111001 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
