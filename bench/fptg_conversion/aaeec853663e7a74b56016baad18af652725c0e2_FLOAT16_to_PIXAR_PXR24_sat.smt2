                expect
                (fp #b1 #b10000110 #b100000111000000)))
(assert (fp.leq (fp #b1 #b10000110 #b100000111000000)
                expect
                (fp #b0 #b00011001 #b000110111110010)))
; expect = -193.75

(assert (= expect result))

