; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg1
                (fp #b1 #b01111111 #b100)))
(assert (fp.leq (fp #b1 #b01111111 #b100)
                arg1
                (fp #b0 #b01101101 #b010)))
; arg1 = -1.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001010 #b01100110000110110111011)
                expect
                (fp #b1 #b01111111 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b10000000000000000000000)
                expect
                (fp #b0 #b01110010 #b01011000011101011001111)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
