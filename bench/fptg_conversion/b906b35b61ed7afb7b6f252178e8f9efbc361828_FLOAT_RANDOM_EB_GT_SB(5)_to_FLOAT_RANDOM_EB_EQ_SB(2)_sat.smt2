(assert (fp.leq (fp #b1 #b11101011100 #b1011000101)
                expect
                (fp #b1 #b10000000110 #b0110001000)))
(assert (fp.leq (fp #b1 #b10000000110 #b0110001000)
                expect
                (fp #b0 #b00111100000 #b0001110111)))

(assert (= expect result))

