; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00100011 #b1100000)
                arg1
                (fp #b0 #b01111111 #b1011110)))
(assert (fp.leq (fp #b0 #b01111111 #b1011110)
                arg1
                (fp #b0 #b10101100 #b1111011)))
; arg1 = 1.734375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01100 #b1101)
                expect
                (fp #b0 #b01111 #b1100)))
(assert (fp.leq (fp #b0 #b01111 #b1100)
                expect
                (fp #b0 #b10001 #b1101)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
