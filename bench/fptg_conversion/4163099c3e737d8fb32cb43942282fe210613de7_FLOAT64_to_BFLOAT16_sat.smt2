; Format from: FLOAT64
; Format to: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00001010110 #b1101101000001011011100100011110101011101100110110100)
                arg1
                (fp #b0 #b10001100100 #b0011110100101100111100101000010000100010101001111110)))
(assert (fp.leq (fp #b0 #b10001100100 #b0011110100101100111100101000010000100010101001111110)
                arg1
                (fp #b0 #b10100000101 #b1010011000000111111010001100000100000010010100010000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00110000 #b0100111)
                expect
                (fp #b0 #b11100100 #b0011111)))
(assert (fp.leq (fp #b0 #b11100100 #b0011111)
                expect
                (fp #b0 #b11101010 #b1100111)))
; expect = 3149319459942007419343372025856.0

(assert (= expect result))

(check-sat)
(exit)
