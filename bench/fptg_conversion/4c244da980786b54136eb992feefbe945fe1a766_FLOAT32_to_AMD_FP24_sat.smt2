; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110111 #b10111010010010111010110)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11100000 #b11111010011110101011101)))
; arg1 = 55651713024.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001001 #b1010000011000001)
                expect
                (fp #b0 #b1100010 #b1001111010100100)))
(assert (fp.leq (fp #b0 #b1100010 #b1001111010100100)
                expect
                (fp #b0 #b1101100 #b1010011100000010)))
; expect = 55652122624.0

(assert (= expect result))

(check-sat)
(exit)
