(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg1
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                arg1
                (fp #b0 #b0000 #b101)))
; arg1 = -0.001953125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010010 #b1100110011)
                expect
                (fp #b1 #b01110110 #b0000000000)))
(assert (fp.leq (fp #b1 #b01110110 #b0000000000)
                expect
                (fp #b1 #b00100111 #b1111110100)))
; expect = -0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
