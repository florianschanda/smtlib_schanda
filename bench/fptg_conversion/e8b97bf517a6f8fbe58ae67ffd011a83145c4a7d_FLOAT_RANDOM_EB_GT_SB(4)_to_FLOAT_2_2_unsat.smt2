(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11110111111 #b001001)
                arg1
                (fp #b1 #b11000000101 #b111011)))
(assert (fp.leq (fp #b1 #b11000000101 #b111011)
                arg1
                (fp #b0 #b11011000111 #b010001)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
