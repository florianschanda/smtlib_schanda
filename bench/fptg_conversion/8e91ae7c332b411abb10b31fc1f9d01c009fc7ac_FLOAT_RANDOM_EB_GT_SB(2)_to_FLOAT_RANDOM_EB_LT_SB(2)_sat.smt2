(declare-const expect (_ FloatingPoint 3 36))
(assert (fp.leq (fp #b1 #b001 #b10000111000000011010010111000010010)
                expect
                (fp #b1 #b000 #b00100000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000 #b00100000000000000000000000000000000)
                expect
                (fp #b0 #b011 #b11101110000100111100011001101001100)))

(assert (= expect result))

(check-sat)
