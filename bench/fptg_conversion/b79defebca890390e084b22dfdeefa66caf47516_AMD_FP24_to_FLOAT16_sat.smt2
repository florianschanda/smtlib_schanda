; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010100 #b0011111110011101)
                arg1
                (fp #b0 #b0111111 #b0111110000011101)))
(assert (fp.leq (fp #b0 #b0111111 #b0111110000011101)
                arg1
                (fp #b0 #b1010111 #b1000110011000101)))
; arg1 = 1.4848175048828125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01011 #b0110100110)
                expect
                (fp #b0 #b01111 #b0111110001)))
(assert (fp.leq (fp #b0 #b01111 #b0111110001)
                expect
                (fp #b0 #b11110 #b1101101001)))
; expect = 1.4853515625

(assert (= expect result))

(check-sat)
(exit)
