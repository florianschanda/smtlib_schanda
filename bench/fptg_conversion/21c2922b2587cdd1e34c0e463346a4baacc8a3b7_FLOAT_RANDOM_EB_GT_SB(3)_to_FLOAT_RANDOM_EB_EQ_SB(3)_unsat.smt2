; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011110001 #b1)
                arg1
                (fp #b0 #b0000000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000000 #b0)
                arg1
                (fp #b0 #b1100011111 #b1)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result ((_ to_fp 18 18) rm arg1)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011111111100000010 #b01001001001011001)
                expect
                (fp #b0 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b010011101010010000 #b00110101111001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
