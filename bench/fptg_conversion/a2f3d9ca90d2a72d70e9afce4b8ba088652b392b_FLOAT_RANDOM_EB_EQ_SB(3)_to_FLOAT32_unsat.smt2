(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b10)
                arg1
                (fp #b1 #b000 #b11)))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg1
                (fp #b0 #b000 #b00)))
; arg1 = -0.1875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100100 #b11110100010111001100000)
                expect
                (fp #b1 #b01111100 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111100 #b10000000000000000000000)
                expect
                (fp #b0 #b00011110 #b01011010001011011110011)))
; expect = -0.1875

(assert (not (= expect result)))

(check-sat)
(exit)
