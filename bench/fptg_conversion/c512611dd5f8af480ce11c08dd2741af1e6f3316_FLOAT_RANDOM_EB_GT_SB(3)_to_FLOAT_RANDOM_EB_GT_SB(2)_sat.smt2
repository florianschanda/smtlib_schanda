; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b011000 #b0)
                arg1
                (fp #b0 #b100000 #b1)))
(assert (fp.leq (fp #b0 #b100000 #b1)
                arg1
                (fp #b0 #b110101 #b0)))
; arg1 = 3.0

(declare-const result (_ FloatingPoint 12 4))
(assert (= result ((_ to_fp 12 4) rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100010111001 #b110)
                expect
                (fp #b0 #b100000000000 #b100)))
(assert (fp.leq (fp #b0 #b100000000000 #b100)
                expect
                (fp #b0 #b100110100100 #b111)))

(assert (= expect result))

(check-sat)
(exit)
