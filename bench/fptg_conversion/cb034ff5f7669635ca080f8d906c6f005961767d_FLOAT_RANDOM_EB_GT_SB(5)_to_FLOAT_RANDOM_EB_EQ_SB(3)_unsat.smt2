                expect
                (fp #b0 #b0000000000000 #b000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000001)
                expect
                (fp #b0 #b0110011100000 #b111101001110)))

(assert (not (= expect result)))

