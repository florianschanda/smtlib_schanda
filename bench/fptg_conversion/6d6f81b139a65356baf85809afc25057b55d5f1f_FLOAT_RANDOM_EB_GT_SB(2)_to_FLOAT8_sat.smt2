(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 13))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01011110111001000 #b000010011000)
                arg1
                (fp #b1 #b00000000000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000000000000)
                arg1
                (fp #b0 #b10010101011011000 #b001010001011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000 #b0100)
                expect
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                expect
                (fp #b0 #b110 #b1101)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
