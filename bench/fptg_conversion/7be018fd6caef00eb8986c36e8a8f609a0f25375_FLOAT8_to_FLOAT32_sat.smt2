(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b0 #b100 #b1100)))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b101 #b1001)))
; arg1 = 3.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001101 #b00110100010111001001000)
                expect
                (fp #b0 #b10000000 #b11000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b11000000000000000000000)
                expect
                (fp #b0 #b10111110 #b11000011101000000000000)))
; expect = 3.5

(assert (= expect result))

(check-sat)
(exit)
