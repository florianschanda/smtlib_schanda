(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01011111 #b1100101000)
                expect
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                expect
                (fp #b0 #b10010101 #b0011011100)))
