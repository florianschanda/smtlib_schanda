(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b00100010011001100000000)
                arg1
                (fp #b0 #b10010101 #b10001001000000100111000)))
(assert (fp.leq (fp #b0 #b10010101 #b10001001000000100111000)
                arg1
                (fp #b0 #b10010101 #b10001010111100001010010)))
; arg1 = 6439068.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110000010100100 #b101010000100111011011011100010010101111111011000101101011001011)
                expect
                (fp #b0 #b100000000010101 #b100010010000001001110000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000010101 #b100010010000001001110000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b110110101101000 #b110011110001001110100110011000011111011001110111101000001011101)))

(assert (= expect result))

(check-sat)
(exit)
