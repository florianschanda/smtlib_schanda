(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011000 #b0001001)
                expect
                (fp #b1 #b10010111 #b0000111)))
(assert (fp.leq (fp #b1 #b10010111 #b0000111)
                expect
                (fp #b0 #b01111110 #b1111100)))
; expect = -17694720.0

(assert (= expect result))

