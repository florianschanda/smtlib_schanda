; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110111 #b0011)
                arg1
                (fp #b1 #b110101 #b1011)))
(assert (fp.leq (fp #b1 #b110101 #b1011)
                arg1
                (fp #b0 #b101011 #b0100)))
; arg1 = -7077888.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101110 #b11001101000110000001101)
                expect
                (fp #b1 #b10010101 #b10110000000000000000000)))
(assert (fp.leq (fp #b1 #b10010101 #b10110000000000000000000)
                expect
                (fp #b0 #b00010110 #b00000101011011110110010)))
; expect = -7077888.0

(assert (= expect result))

(check-sat)
(exit)
