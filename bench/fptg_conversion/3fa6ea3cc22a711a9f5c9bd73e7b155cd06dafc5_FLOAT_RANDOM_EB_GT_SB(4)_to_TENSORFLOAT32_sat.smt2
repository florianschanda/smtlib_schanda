(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01100010 #b0000001101)
                expect
                (fp #b0 #b10000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b0000000000)
                expect
                (fp #b0 #b11100000 #b0100001110)))
; expect = 4.0

(assert (= expect result))

(check-sat)
