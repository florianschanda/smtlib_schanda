(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b1)
                arg1
                (fp #b0 #b101 #b0)))
(assert (fp.leq (fp #b0 #b101 #b0)
                arg1
                (fp #b0 #b101 #b1)))
; arg1 = 4.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00111101 #b00000011100100011010110)
                expect
                (fp #b0 #b10000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b00000000000000000000000)
                expect
                (fp #b0 #b11010111 #b00010100001101001100110)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
