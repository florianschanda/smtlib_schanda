(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000001011 #b0100)
                arg1
                (fp #b1 #b10000000010 #b1010)))
(assert (fp.leq (fp #b1 #b10000000010 #b1010)
                arg1
                (fp #b0 #b00001000111 #b0010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111100 #b10100101011000001011101)
                expect
                (fp #b1 #b10000010 #b10100000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b10100000000000000000000)
                expect
                (fp #b1 #b10000001 #b01111000010100010001001)))
; expect = -13.0

(assert (= expect result))

(check-sat)
(exit)
