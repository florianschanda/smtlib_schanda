(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010101 #b1111110100)
                arg1
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                arg1
                (fp #b0 #b11110000 #b0000100001)))
; arg1 = -933.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b1111101000)
                expect
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                expect
                (fp #b1 #b00001 #b0100011001)))
; expect = -933.0

(assert (= expect result))

(check-sat)
(exit)
