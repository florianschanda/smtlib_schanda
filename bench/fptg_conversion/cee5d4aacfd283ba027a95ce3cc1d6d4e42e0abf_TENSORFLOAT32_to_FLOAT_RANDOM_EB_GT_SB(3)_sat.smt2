(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001100 #b1011011110)
                arg1
                (fp #b1 #b10001000 #b1100000110)))
(assert (fp.leq (fp #b1 #b10001000 #b1100000110)
                arg1
                (fp #b0 #b01000110 #b0010100001)))
; arg1 = -899.0

(declare-const result (_ FloatingPoint 14 6))
(assert (= result ((_ to_fp 14 6) rm arg1)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10101010100011 #b00110)
                expect
                (fp #b1 #b10000000001000 #b11001)))
(assert (fp.leq (fp #b1 #b10000000001000 #b11001)
                expect
                (fp #b0 #b00001111010100 #b10010)))

(assert (= expect result))

(check-sat)
(exit)
