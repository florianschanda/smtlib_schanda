; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1000)
                arg1
                (fp #b0 #b000 #b0011)))
(assert (fp.leq (fp #b0 #b000 #b0011)
                arg1
                (fp #b0 #b110 #b1010)))
; arg1 = 0.046875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001111 #b001011010000101)
                expect
                (fp #b0 #b01111010 #b100000000000000)))
(assert (fp.leq (fp #b0 #b01111010 #b100000000000000)
                expect
                (fp #b0 #b11101101 #b000011001011110)))
; expect = 0.046875

(assert (= expect result))

(check-sat)
(exit)
