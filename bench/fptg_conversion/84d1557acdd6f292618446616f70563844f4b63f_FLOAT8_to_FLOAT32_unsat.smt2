(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b110 #b0100)))
(assert (fp.leq (fp #b0 #b110 #b0100)
                arg1
                (fp #b0 #b110 #b0111)))
; arg1 = 10.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b01101110100111111101111)
                expect
                (fp #b0 #b10000010 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b01000000000000000000000)
                expect
                (fp #b0 #b10010111 #b00010100011100111001110)))
; expect = 10.0

(assert (not (= expect result)))

(check-sat)
(exit)
