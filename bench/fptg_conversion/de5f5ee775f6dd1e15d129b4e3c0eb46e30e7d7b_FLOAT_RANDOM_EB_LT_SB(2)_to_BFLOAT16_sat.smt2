(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 28))
(assert (fp.leq (fp #b1 #b101111001101101 #b001011101001000001011000011)
                arg1
                (fp #b1 #b011111111111111 #b101101101101110110101011110)))
(assert (fp.leq (fp #b1 #b011111111111111 #b101101101101110110101011110)
                arg1
                (fp #b0 #b110011110101101 #b101101100001010010110010000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100011 #b0011110)
                expect
                (fp #b1 #b01111111 #b1011100)))
(assert (fp.leq (fp #b1 #b01111111 #b1011100)
                expect
                (fp #b1 #b01000000 #b1010010)))
; expect = -1.71875

(assert (= expect result))

(check-sat)
(exit)
