; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010101011 #b1110000100)
                arg1
                (fp #b1 #b01111111111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111111111 #b0001011101)
                arg1
                (fp #b1 #b01010001001 #b1001011111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111000 #b1110111)
                expect
                (fp #b1 #b01111111 #b0001100)))
(assert (fp.leq (fp #b1 #b01111111 #b0001100)
                expect
                (fp #b1 #b00111011 #b1000001)))
; expect = -1.09375

(assert (not (= expect result)))

(check-sat)
