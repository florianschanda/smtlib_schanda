(assert (fp.leq (fp #b0 #b00111001 #b1100111000)
                expect
                (fp #b0 #b01111010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01111010 #b1011111001)
                expect
                (fp #b0 #b11001011 #b1011111000)))
; expect = 0.054473876953125

(assert (= expect result))

