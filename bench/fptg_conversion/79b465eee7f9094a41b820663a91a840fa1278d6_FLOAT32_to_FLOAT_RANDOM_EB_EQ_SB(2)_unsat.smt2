; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100101 #b00000010111110100100011)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11111000 #b00101110100100011110111)))
; arg1 = 1.76562607288360595703125

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011000011010001 #b10111110100000)
                expect
                (fp #b0 #b011111111111111 #b11000100000001)))
(assert (fp.leq (fp #b0 #b011111111111111 #b11000100000001)
                expect
                (fp #b0 #b100110000100100 #b01011001000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
