(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0100)
                arg1
                (fp #b0 #b011 #b0011)))
(assert (fp.leq (fp #b0 #b011 #b0011)
                arg1
                (fp #b0 #b100 #b0011)))
; arg1 = 1.1875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010011 #b10000000001010000000011)
                expect
                (fp #b0 #b01111111 #b00110000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00110000000000000000000)
                expect
                (fp #b0 #b10100100 #b00001100011100101111110)))
; expect = 1.1875

(assert (= expect result))

(check-sat)
(exit)
