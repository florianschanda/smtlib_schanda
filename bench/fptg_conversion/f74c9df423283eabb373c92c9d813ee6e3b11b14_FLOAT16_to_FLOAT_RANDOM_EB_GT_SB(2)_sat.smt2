(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110000011)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b1 #b01111 #b1000100111)))
; arg1 = -255.875

(declare-const result (_ FloatingPoint 17 6))
(assert (= result ((_ to_fp 17 6) rm arg1)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b10010000000111111 #b11111)
                expect
                (fp #b1 #b10000000000000111 #b00000)))
(assert (fp.leq (fp #b1 #b10000000000000111 #b00000)
                expect
                (fp #b0 #b00010110100111101 #b01101)))

(assert (= expect result))

(check-sat)
(exit)
