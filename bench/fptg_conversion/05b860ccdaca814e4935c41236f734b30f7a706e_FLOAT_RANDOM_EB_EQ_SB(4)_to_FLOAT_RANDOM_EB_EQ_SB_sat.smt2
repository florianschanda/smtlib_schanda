; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101000001100100 #b000110001010011)
                arg1
                (fp #b0 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000001)
                arg1
                (fp #b0 #b1011110101100000 #b011001001101010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001011100111 #b11010111001)
                expect
                (fp #b0 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000001)
                expect
                (fp #b0 #b011001000000 #b00110000101)))

(assert (= expect result))

(check-sat)
(exit)
