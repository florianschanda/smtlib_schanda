(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b11011000 #b01011000111000111001000)
                arg1
                (fp #b0 #b11110011 #b01001001100100010110011)))
(assert (fp.leq (fp #b0 #b11110011 #b01001001100100010110011)
                arg1
                (fp #b0 #b11111000 #b00000011010111010100111)))
; arg1 = 106950918570191514810027511577051136.0

(declare-const result (_ FloatingPoint 15 14))
(assert (= result ((_ to_fp 15 14) rm arg1)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b000111000100110 #b1111100011111)
                expect
                (fp #b0 #b100000001110011 #b0100100110011)))
(assert (fp.leq (fp #b0 #b100000001110011 #b0100100110011)
                expect
                (fp #b0 #b111101110111000 #b1011111111111)))

(assert (= expect result))

(check-sat)
(exit)
