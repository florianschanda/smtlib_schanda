(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b0001100010)
                arg1
                (fp #b1 #b01111111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111111 #b0010001010)
                arg1
                (fp #b1 #b01100001 #b0010000111)))
; arg1 = -1.134765625

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b1 #b01 #b1)))
(assert (fp.leq (fp #b1 #b01 #b1)
                expect
                (fp #b0 #b01 #b1)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
