; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01000111010 #b10101)
                arg1
                (fp #b0 #b01111111111 #b10111)))
(assert (fp.leq (fp #b0 #b01111111111 #b10111)
                arg1
                (fp #b0 #b10000111001 #b01011)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00000101 #b00101011010010101101001)
                expect
                (fp #b0 #b01111111 #b10111000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10111000000000000000000)
                expect
                (fp #b0 #b11001011 #b01100101100001001000111)))
; expect = 1.71875

(assert (not (= expect result)))

(check-sat)
(exit)
