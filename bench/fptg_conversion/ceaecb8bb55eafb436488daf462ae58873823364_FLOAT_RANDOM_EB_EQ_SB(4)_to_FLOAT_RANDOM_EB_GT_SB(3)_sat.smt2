; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110010000 #b1111001011)
                arg1
                (fp #b1 #b11010001001 #b1011101101)))
(assert (fp.leq (fp #b1 #b11010001001 #b1011101101)
                arg1
                (fp #b0 #b01001000001 #b1000011011)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result ((_ to_fp 12 8) rm arg1)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110101101110 #b1111110)
                expect
                (fp #b1 #b101010001001 #b1011110)))
(assert (fp.leq (fp #b1 #b101010001001 #b1011110)
                expect
                (fp #b0 #b100010100101 #b0010001)))

(assert (= expect result))

(check-sat)
(exit)
