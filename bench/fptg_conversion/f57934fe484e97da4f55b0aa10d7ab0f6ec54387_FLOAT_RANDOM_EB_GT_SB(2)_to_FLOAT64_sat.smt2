; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10010011 #b0)
                arg1
                (fp #b1 #b10000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000 #b1)
                arg1
                (fp #b0 #b00110000 #b0)))
; arg1 = -3.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000100001 #b1011101010001000100001110011010001101001010111000100)
                expect
                (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11100011111 #b0111111111101001001001111011000010101100000011001110)))

(assert (= expect result))

(check-sat)
(exit)
