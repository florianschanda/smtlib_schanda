; Format from: TENSORFLOAT32
; Format to: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100111 #b1010111001)
                arg1
                (fp #b1 #b10001001 #b0110110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0110110001)
                arg1
                (fp #b0 #b10101100 #b1010011110)))
; arg1 = -1457.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111011001 #b1010011001111001000011110011110011011000011111001001)
                expect
                (fp #b1 #b10000001001 #b0110110001000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001001 #b0110110001000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01011011001 #b1100110111111011100001011110101011000101010011001110)))

(assert (= expect result))

(check-sat)
(exit)
