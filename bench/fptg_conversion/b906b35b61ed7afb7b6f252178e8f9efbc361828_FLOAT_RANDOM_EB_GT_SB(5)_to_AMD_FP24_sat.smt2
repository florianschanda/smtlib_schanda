; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101010000 #b0111111)
                arg1
                (fp #b1 #b100000110 #b0110001)))
(assert (fp.leq (fp #b1 #b100000110 #b0110001)
                arg1
                (fp #b1 #b001101000 #b1011000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1111000110110101)
                expect
                (fp #b1 #b1000110 #b0110001000000000)))
(assert (fp.leq (fp #b1 #b1000110 #b0110001000000000)
                expect
                (fp #b1 #b0100010 #b0000010110000010)))
; expect = -177.0

(assert (= expect result))

(check-sat)
(exit)
