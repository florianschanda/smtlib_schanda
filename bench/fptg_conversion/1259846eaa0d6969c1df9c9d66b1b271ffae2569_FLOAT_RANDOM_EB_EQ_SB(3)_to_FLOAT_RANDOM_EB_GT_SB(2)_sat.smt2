; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011110100011 #b10001110001)
                arg1
                (fp #b0 #b000000000000 #b10111100110)))
(assert (fp.leq (fp #b0 #b000000000000 #b10111100110)
                arg1
                (fp #b0 #b011000111010 #b11000100100)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0100 #b01)
                expect
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                expect
                (fp #b0 #b0110 #b01)))
; expect = 0.00390625

(assert (= expect result))

(check-sat)
(exit)
