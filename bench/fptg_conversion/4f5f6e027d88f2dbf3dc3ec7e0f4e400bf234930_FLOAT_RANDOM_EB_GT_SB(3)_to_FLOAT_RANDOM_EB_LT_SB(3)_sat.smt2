; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0101001001011 #b01001)
                arg1
                (fp #b0 #b0000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00001)
                arg1
                (fp #b0 #b1000000110100 #b11010)))

(declare-const result (_ FloatingPoint 6 40))
(assert (= result ((_ to_fp 6 40) rm arg1)))

(declare-const expect (_ FloatingPoint 6 40))
(assert (fp.leq (fp #b1 #b001000 #b101000110000101000100010110001001010010)
                expect
                (fp #b0 #b000000 #b000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b000000 #b000000000000000000000000000000000000001)
                expect
                (fp #b0 #b000001 #b010001101111011110101000001010110101110)))

(assert (= expect result))

(check-sat)
(exit)
