(assert (fp.leq (fp #b1 #b10110101001010010 #b10000)
                expect
                (fp #b1 #b01111111111111100 #b00000)))
(assert (fp.leq (fp #b1 #b01111111111111100 #b00000)
                expect
                (fp #b0 #b10001100111010001 #b01100)))

(assert (= expect result))

(check-sat)
