; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b1011001010100110)
                arg1
                (fp #b0 #b1101100 #b1010100100110011)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110011)
                arg1
                (fp #b0 #b1111000 #b1001100010100110)))
; arg1 = 58438935642112.0

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100000011101111 #b01011011111101)
                expect
                (fp #b0 #b100000000101100 #b10101001001101)))
(assert (fp.leq (fp #b0 #b100000000101100 #b10101001001101)
                expect
                (fp #b0 #b101110000101101 #b01101001100000)))

(assert (= expect result))

(check-sat)
(exit)
