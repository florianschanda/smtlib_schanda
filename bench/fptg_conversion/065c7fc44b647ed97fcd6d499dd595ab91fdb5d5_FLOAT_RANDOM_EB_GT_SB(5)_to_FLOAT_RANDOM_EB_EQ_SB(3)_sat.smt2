; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111101000 #b10101)
                arg1
                (fp #b1 #b011111111 #b10110)))
(assert (fp.leq (fp #b1 #b011111111 #b10110)
                arg1
                (fp #b1 #b001100101 #b10011)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101111 #b011111)
                expect
                (fp #b1 #b0111111 #b101100)))
(assert (fp.leq (fp #b1 #b0111111 #b101100)
                expect
                (fp #b0 #b0001010 #b011000)))
; expect = -1.6875

(assert (= expect result))

(check-sat)
(exit)
