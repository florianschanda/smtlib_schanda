; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110111 #b0011)
                arg1
                (fp #b1 #b110101 #b1011)))
(assert (fp.leq (fp #b1 #b110101 #b1011)
                arg1
                (fp #b0 #b101011 #b0100)))
; arg1 = -7077888.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b0000101)
                expect
                (fp #b1 #b10010101 #b1011000)))
(assert (fp.leq (fp #b1 #b10010101 #b1011000)
                expect
                (fp #b0 #b01000111 #b1100011)))
; expect = -7077888.0

(assert (= expect result))

(check-sat)
(exit)
