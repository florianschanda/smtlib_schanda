(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b00100001110110110 #b0011111110110101)
                arg1
                (fp #b0 #b00000000000000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0100000000000000)
                arg1
                (fp #b0 #b00010111110001011 #b1111100101010011)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b01)
                expect
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                expect
                (fp #b0 #b1000 #b01)))
; expect = 0.00390625

(assert (= expect result))

(check-sat)
