(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110100000 #b01101111110)
                expect
                (fp #b0 #b010000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b010000000000 #b00000000000)
                expect
                (fp #b0 #b011101110110 #b10100111101)))

(assert (= expect result))

(check-sat)
