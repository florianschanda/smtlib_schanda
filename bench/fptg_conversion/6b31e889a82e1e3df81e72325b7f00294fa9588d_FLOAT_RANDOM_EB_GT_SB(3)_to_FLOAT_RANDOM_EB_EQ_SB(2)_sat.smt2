(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b00)
                arg1
                (fp #b1 #b11001 #b00)))
(assert (fp.leq (fp #b1 #b11001 #b00)
                arg1
                (fp #b0 #b11100 #b10)))
; arg1 = -1024.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110110001 #b00101010001)
                expect
                (fp #b1 #b100000001001 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000001001 #b00000000000)
                expect
                (fp #b1 #b000110001011 #b01011100000)))

(assert (= expect result))

(check-sat)
(exit)
