; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0011100101001010)
                arg1
                (fp #b1 #b1001110 #b1001100011111110)))
(assert (fp.leq (fp #b1 #b1001110 #b1001100011111110)
                arg1
                (fp #b0 #b0010010 #b1010111011100101)))
; arg1 = -52351.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b1101)
                expect
                (fp #b1 #b11110 #b1010)))
(assert (fp.leq (fp #b1 #b11110 #b1010)
                expect
                (fp #b0 #b00010 #b1001)))
; expect = -53248.0

(assert (= expect result))

(check-sat)
(exit)
