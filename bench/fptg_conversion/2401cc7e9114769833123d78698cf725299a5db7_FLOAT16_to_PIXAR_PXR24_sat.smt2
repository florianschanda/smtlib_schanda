(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1100101001)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11101 #b1100111000)))
; arg1 = 1671.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001111 #b111000011010100)
                expect
                (fp #b0 #b10001001 #b101000011100000)))
(assert (fp.leq (fp #b0 #b10001001 #b101000011100000)
                expect
                (fp #b0 #b11100010 #b011000111110100)))
; expect = 1671.0

(assert (= expect result))

(check-sat)
(exit)
