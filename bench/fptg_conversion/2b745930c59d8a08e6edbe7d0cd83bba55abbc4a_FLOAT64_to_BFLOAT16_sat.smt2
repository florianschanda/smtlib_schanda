; Format from: FLOAT64
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010111010 #b0111110110111000110010111100001000000111110111010000)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b1 #b01000101110 #b0100101100111011011110101111010010010011100100100110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b0001100)
                expect
                (fp #b1 #b10101010 #b1100101)))
(assert (fp.leq (fp #b1 #b10101010 #b1100101)
                expect
                (fp #b0 #b00100000 #b0101011)))
; expect = -15736760172544.0

(assert (= expect result))

(check-sat)
(exit)
