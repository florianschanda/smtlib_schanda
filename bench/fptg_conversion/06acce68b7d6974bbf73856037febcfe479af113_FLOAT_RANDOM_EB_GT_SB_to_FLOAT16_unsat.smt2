; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100000010 #b0000001)
                arg1
                (fp #b0 #b0111010000 #b0010000)))
(assert (fp.leq (fp #b0 #b0111010000 #b0010000)
                arg1
                (fp #b0 #b1110100001 #b0000010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b1001001111)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b00001 #b1010100101)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
