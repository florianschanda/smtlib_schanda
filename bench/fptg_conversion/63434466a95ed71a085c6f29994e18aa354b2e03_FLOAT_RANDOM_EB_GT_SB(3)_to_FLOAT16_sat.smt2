; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0100010010100 #b00110)
                arg1
                (fp #b1 #b0001001001010 #b01010)))
(assert (fp.leq (fp #b1 #b0001001001010 #b01010)
                arg1
                (fp #b0 #b0111010001100 #b11010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0111000111)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b01010 #b0111110101)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
