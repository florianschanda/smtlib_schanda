(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                arg1
                (fp #b0 #b011 #b0000)))
(assert (fp.leq (fp #b0 #b011 #b0000)
                arg1
                (fp #b0 #b011 #b1101)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00110110 #b111000111101000)
                expect
                (fp #b0 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b000000000000000)
                expect
                (fp #b0 #b10010111 #b010101111101010)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
