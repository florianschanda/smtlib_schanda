; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b001001 #b0)
                arg1
                (fp #b0 #b011011 #b1)))
(assert (fp.leq (fp #b0 #b011011 #b1)
                arg1
                (fp #b0 #b100100 #b0)))
; arg1 = 0.09375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b0111110110110100)
                expect
                (fp #b0 #b0111011 #b1000000000000000)))
(assert (fp.leq (fp #b0 #b0111011 #b1000000000000000)
                expect
                (fp #b0 #b1110111 #b1110010000111010)))
; expect = 0.09375

(assert (= expect result))

(check-sat)
(exit)
