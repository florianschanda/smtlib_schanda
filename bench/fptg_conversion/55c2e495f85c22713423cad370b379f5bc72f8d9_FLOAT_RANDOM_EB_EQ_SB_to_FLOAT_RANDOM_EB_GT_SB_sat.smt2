; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100010 #b111101110)
                arg1
                (fp #b0 #b0000000001 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000001 #b000000000)
                arg1
                (fp #b0 #b0011011100 #b001101110)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result ((_ to_fp 11 4) rm arg1)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10110111010 #b010)
                expect
                (fp #b0 #b01000000001 #b000)))
(assert (fp.leq (fp #b0 #b01000000001 #b000)
                expect
                (fp #b0 #b11001000101 #b111)))

(assert (= expect result))

(check-sat)
(exit)
