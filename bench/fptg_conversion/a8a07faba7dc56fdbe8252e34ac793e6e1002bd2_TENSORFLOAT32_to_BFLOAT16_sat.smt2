(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010000 #b0010011010)
                arg1
                (fp #b0 #b10001001 #b0101110010)))
(assert (fp.leq (fp #b0 #b10001001 #b0101110010)
                arg1
                (fp #b0 #b11011011 #b0010010001)))
; arg1 = 1394.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001001 #b0100110)
                expect
                (fp #b0 #b10001001 #b0101111)))
(assert (fp.leq (fp #b0 #b10001001 #b0101111)
                expect
                (fp #b0 #b10010000 #b1111001)))
; expect = 1400.0

(assert (= expect result))

(check-sat)
(exit)
