(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b11100 #b100)
                arg1
                (fp #b0 #b11100 #b110)))
(assert (fp.leq (fp #b0 #b11100 #b110)
                arg1
                (fp #b0 #b11110 #b001)))
; arg1 = 14336.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001011 #b11111101110100010100101)
                expect
                (fp #b0 #b10001100 #b11000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001100 #b11000000000000000000000)
                expect
                (fp #b0 #b10101101 #b01101001000100110011100)))
; expect = 14336.0

(assert (= expect result))

(check-sat)
(exit)
