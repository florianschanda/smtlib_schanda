; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000100100)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b10110 #b0110111010)))
; arg1 = 0.10479736328125

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01001111101 #b0001110001)
                expect
                (fp #b0 #b01111111011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01111111011 #b1010110101)
                expect
                (fp #b0 #b11010100101 #b1000101011)))

(assert (= expect result))

(check-sat)
(exit)
