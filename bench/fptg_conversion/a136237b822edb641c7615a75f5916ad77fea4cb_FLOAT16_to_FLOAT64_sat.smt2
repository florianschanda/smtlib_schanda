(assert (fp.leq (fp #b1 #b11110101000 #b1111111111101011000100000101000010010111111001001111)
                expect
                (fp #b1 #b10000000111 #b0000100000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000100000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01011101101 #b1110000101011010000010101011001111000110011111000111)))

(assert (= expect result))

(check-sat)
