(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT64
; Format to: PIXAR_PXR24
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01100000000 #b1101000011000100010101101010110111001000000010110000)
                arg1
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111001101 #b0000010011010100101110110011010111100000110001000011)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00100010 #b110010100110101)
                expect
                (fp #b0 #b10110100 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10110100 #b000000000000000)
                expect
                (fp #b0 #b11110100 #b110100100111000)))
; expect = 9007199254740992.0

(assert (not (= expect result)))

(check-sat)
(exit)
