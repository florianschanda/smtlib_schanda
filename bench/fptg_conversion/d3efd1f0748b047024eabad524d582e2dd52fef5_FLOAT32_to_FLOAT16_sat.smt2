; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00011110 #b11111100011010110001010)
                arg1
                (fp #b1 #b00000000 #b00101010000110010101000)))
(assert (fp.leq (fp #b1 #b00000000 #b00101010000110010101000)
                arg1
                (fp #b0 #b00111101 #b10111010001100111110010)))
