; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110001 #b1100100111)
                arg1
                (fp #b0 #b10001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000111)
                arg1
                (fp #b0 #b11011011 #b0001001100)))
; arg1 = 1671.0

(declare-const result (_ FloatingPoint 9 7))
(assert (= result ((_ to_fp 9 7) rm arg1)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111011111 #b011001)
                expect
                (fp #b0 #b100001001 #b101001)))
(assert (fp.leq (fp #b0 #b100001001 #b101001)
                expect
                (fp #b0 #b110110000 #b110010)))

(assert (= expect result))

(check-sat)
(exit)
