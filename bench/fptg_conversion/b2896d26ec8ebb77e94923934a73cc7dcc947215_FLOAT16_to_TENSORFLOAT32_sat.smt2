(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111001 #b1111011001)
                expect
                (fp #b0 #b10001101 #b0000001101)))
(assert (fp.leq (fp #b0 #b10001101 #b0000001101)
                expect
                (fp #b0 #b11100100 #b1110110010)))
; expect = 16592.0

(assert (= expect result))

(check-sat)
