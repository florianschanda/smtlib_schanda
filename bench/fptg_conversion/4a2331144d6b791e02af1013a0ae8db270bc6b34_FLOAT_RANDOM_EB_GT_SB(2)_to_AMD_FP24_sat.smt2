(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0011 #b11)
                arg1
                (fp #b0 #b1011 #b00)))
(assert (fp.leq (fp #b0 #b1011 #b00)
                arg1
                (fp #b0 #b1011 #b10)))
; arg1 = 16.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010000 #b1111111110111101)
                expect
                (fp #b0 #b1000011 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000011 #b0000000000000000)
                expect
                (fp #b0 #b1010011 #b1010110011000111)))
; expect = 16.0

(assert (= expect result))

(check-sat)
(exit)
