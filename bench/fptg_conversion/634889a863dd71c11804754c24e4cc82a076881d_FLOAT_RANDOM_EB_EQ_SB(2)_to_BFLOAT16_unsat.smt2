(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100100 #b1011000)
                expect
                (fp #b0 #b01111111 #b1101000)))
(assert (fp.leq (fp #b0 #b01111111 #b1101000)
                expect
                (fp #b0 #b11010011 #b0010110)))
; expect = 1.8125

(assert (not (= expect result)))

