(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010111 #b100)
                arg1
                (fp #b0 #b011111 #b111)))
(assert (fp.leq (fp #b0 #b011111 #b111)
                arg1
                (fp #b0 #b101000 #b101)))
; arg1 = 1.875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011110 #b01010011101100011101011)
                expect
                (fp #b0 #b01111111 #b11100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b11100000000000000000000)
                expect
                (fp #b0 #b10100010 #b11000000111110111001110)))
; expect = 1.875

(assert (= expect result))

(check-sat)
(exit)
