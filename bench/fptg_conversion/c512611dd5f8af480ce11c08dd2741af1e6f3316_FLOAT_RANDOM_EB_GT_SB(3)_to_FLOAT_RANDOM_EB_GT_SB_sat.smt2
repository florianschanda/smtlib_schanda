; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b011000 #b0)
                arg1
                (fp #b0 #b100000 #b1)))
(assert (fp.leq (fp #b0 #b100000 #b1)
                arg1
                (fp #b0 #b110101 #b0)))
; arg1 = 3.0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0110 #b01)
                expect
                (fp #b0 #b1000 #b10)))
(assert (fp.leq (fp #b0 #b1000 #b10)
                expect
                (fp #b0 #b1101 #b11)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
