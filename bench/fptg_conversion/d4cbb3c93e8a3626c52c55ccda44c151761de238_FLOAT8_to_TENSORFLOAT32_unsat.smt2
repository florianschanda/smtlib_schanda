(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0000)
                arg1
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                arg1
                (fp #b0 #b011 #b1101)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001101 #b0011100000)
                expect
                (fp #b0 #b01111100 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111100 #b0000000000)
                expect
                (fp #b0 #b11011000 #b1001000000)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
