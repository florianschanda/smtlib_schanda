; Format from: TENSORFLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b0001100010)
                arg1
                (fp #b1 #b01111111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111111 #b0010001010)
                arg1
                (fp #b1 #b01100001 #b0010000111)))
; arg1 = -1.134765625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0111111011011000)
                expect
                (fp #b1 #b0111111 #b0010001010000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0010001010000000)
                expect
                (fp #b0 #b0101011 #b0010101100111001)))
; expect = -1.134765625

(assert (= expect result))

(check-sat)
(exit)
