(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1111000110111111 #b100010110)
                arg1
                (fp #b1 #b0111111111111111 #b101100000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b101100000)
                arg1
                (fp #b0 #b0111010001010111 #b000100110)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b11)
                expect
                (fp #b1 #b0111 #b11)))
(assert (fp.leq (fp #b1 #b0111 #b11)
                expect
                (fp #b1 #b0000 #b00)))
; expect = -1.75

(assert (not (= expect result)))

(check-sat)
(exit)
