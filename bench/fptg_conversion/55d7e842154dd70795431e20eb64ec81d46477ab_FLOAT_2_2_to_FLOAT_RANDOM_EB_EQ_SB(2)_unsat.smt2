                expect
                (fp #b1 #b00000000000000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0000000000000000)
                expect
                (fp #b0 #b10101010100011111 #b0000000000010010)))

(assert (not (= expect result)))

