(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b1 #b010 #b1001)))
(assert (fp.leq (fp #b1 #b010 #b1001)
                arg1
                (fp #b1 #b001 #b1110)))
; arg1 = -0.78125

(declare-const result (_ FloatingPoint 6 4))
(assert (= result ((_ to_fp 6 4) rm arg1)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b110010 #b100)
                expect
                (fp #b1 #b011110 #b101)))
(assert (fp.leq (fp #b1 #b011110 #b101)
                expect
                (fp #b0 #b011001 #b111)))
; expect = -0.8125

(assert (= expect result))

(check-sat)
(exit)
