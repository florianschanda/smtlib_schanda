; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b011111011100 #b011100011)
                arg1
                (fp #b0 #b000000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b111111111)
                arg1
                (fp #b0 #b011110010010 #b000000101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100011001 #b1000001010)
                expect
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b11111110000 #b0110000000)))

(assert (= expect result))

(check-sat)
(exit)
