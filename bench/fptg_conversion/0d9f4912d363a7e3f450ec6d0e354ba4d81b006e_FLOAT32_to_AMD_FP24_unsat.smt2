; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11111001010110101100000)
                arg1
                (fp #b0 #b01111111 #b00010001000010101011100)))
(assert (fp.leq (fp #b0 #b01111111 #b00010001000010101011100)
                arg1
                (fp #b0 #b11010000 #b00110101100001110001101)))
; arg1 = 1.066569805145263671875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101011 #b1101100010110110)
                expect
                (fp #b0 #b0111111 #b0001000100001011)))
(assert (fp.leq (fp #b0 #b0111111 #b0001000100001011)
                expect
                (fp #b0 #b1100001 #b1100000011001100)))
; expect = 1.0665740966796875

(assert (not (= expect result)))

(check-sat)
(exit)
