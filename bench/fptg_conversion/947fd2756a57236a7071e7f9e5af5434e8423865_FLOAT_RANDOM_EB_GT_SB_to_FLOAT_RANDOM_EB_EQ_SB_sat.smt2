; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011001011 #b10)
                arg1
                (fp #b1 #b0111111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111111 #b11)
                arg1
                (fp #b1 #b0110100011 #b11)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b01)
                expect
                (fp #b1 #b011 #b11)))
(assert (fp.leq (fp #b1 #b011 #b11)
                expect
                (fp #b0 #b100 #b00)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
