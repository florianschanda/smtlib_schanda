(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b10)
                arg1
                (fp #b0 #b00111 #b00)))
(assert (fp.leq (fp #b0 #b00111 #b00)
                arg1
                (fp #b0 #b10001 #b01)))
; arg1 = 0.00390625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111000 #b01111111001011110101110)
                expect
                (fp #b0 #b01110111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01110111 #b00000000000000000000000)
                expect
                (fp #b0 #b11100101 #b11010011010111010100110)))
; expect = 0.00390625

(assert (= expect result))

(check-sat)
(exit)
