; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b001111)
                arg1
                (fp #b1 #b0111111 #b101110)))
(assert (fp.leq (fp #b1 #b0111111 #b101110)
                arg1
                (fp #b1 #b0011001 #b001110)))
; arg1 = -1.71875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100001 #b0100111)
                expect
                (fp #b1 #b01111111 #b1011100)))
(assert (fp.leq (fp #b1 #b01111111 #b1011100)
                expect
                (fp #b0 #b00001010 #b1110100)))
; expect = -1.71875

(assert (= expect result))

(check-sat)
(exit)
