(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110100 #b1001110011)
                arg1
                (fp #b0 #b01111111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111111 #b1101111000)
                arg1
                (fp #b0 #b10001111 #b0111010100)))
; arg1 = 1.8671875

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                expect
                (fp #b0 #b100 #b00)))
(assert (fp.leq (fp #b0 #b100 #b00)
                expect
                (fp #b0 #b110 #b10)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
