; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b11001 #b1100100010)
                arg1
                (fp #b0 #b11101 #b1000010010)))
(assert (fp.leq (fp #b0 #b11101 #b1000010010)
                arg1
                (fp #b0 #b11110 #b1010101010)))
; arg1 = 24864.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011010 #b0110000)
                expect
                (fp #b0 #b10001101 #b1000011)))
(assert (fp.leq (fp #b0 #b10001101 #b1000011)
                expect
                (fp #b0 #b11010000 #b0011001)))
; expect = 24960.0

(assert (not (= expect result)))

(check-sat)
(exit)
