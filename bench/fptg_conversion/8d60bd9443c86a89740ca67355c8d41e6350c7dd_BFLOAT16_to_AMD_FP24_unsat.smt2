; Format from: BFLOAT16
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011101 #b1100000)
                arg1
                (fp #b1 #b10000110 #b0011101)))
(assert (fp.leq (fp #b1 #b10000110 #b0011101)
                arg1
                (fp #b1 #b01010011 #b0010001)))
; arg1 = -157.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b0011001110100000)
                expect
                (fp #b1 #b1000110 #b0011101000000000)))
(assert (fp.leq (fp #b1 #b1000110 #b0011101000000000)
                expect
                (fp #b0 #b1111010 #b1000011001111110)))
; expect = -157.0

(assert (not (= expect result)))

(check-sat)
(exit)
