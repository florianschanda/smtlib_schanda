; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1101010001)
                arg1
                (fp #b1 #b10110 #b1000001110)))
(assert (fp.leq (fp #b1 #b10110 #b1000001110)
                arg1
                (fp #b0 #b01101 #b1111101100)))
; arg1 = -193.75

(declare-const result (_ FloatingPoint 9 3))
(assert (= result ((_ to_fp 9 3) rm arg1)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101111011 #b10)
                expect
                (fp #b1 #b100000110 #b11)))
(assert (fp.leq (fp #b1 #b100000110 #b11)
                expect
                (fp #b1 #b000110100 #b10)))

(assert (= expect result))

(check-sat)
(exit)
