(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01010101 #b00010010111000011010100)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b11111110 #b01000101110101101110111)))
; arg1 = 1.90954005718231201171875

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b0)
                expect
                (fp #b0 #b100 #b0)))
(assert (fp.leq (fp #b0 #b100 #b0)
                expect
                (fp #b0 #b100 #b1)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
