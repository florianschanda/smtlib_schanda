(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101100 #b1011111100)
                expect
                (fp #b0 #b10000111 #b0000001000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000001000)
                expect
                (fp #b0 #b11101011 #b1100111110)))
; expect = 258.0

(assert (= expect result))

(check-sat)
