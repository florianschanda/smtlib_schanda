; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10001010011 #b0111111)
                arg1
                (fp #b0 #b00000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000)
                arg1
                (fp #b0 #b00111000111 #b1110110)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b000010 #b10101)
                expect
                (fp #b0 #b000000 #b00001)))
(assert (fp.leq (fp #b0 #b000000 #b00001)
                expect
                (fp #b0 #b101001 #b00111)))
; expect = 0.00000000002910383045673370361328125

(assert (= expect result))

(check-sat)
(exit)
