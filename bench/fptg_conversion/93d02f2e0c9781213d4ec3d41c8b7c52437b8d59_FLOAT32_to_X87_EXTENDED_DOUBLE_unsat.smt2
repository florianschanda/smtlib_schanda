(assert (fp.leq (fp #b1 #b110010110010111 #b010101000111100101111101010111110010010011010001100010001100010)
                expect
                (fp #b1 #b100000000010110 #b111111011001111101100000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000010110 #b111111011001111101100000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b010001011110001 #b010010100000000100111000011011000110101100111010001110100000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
