(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b1 #b1101 #b101)))
(assert (fp.leq (fp #b1 #b1101 #b101)
                arg1
                (fp #b0 #b1011 #b011)))
; arg1 = -104.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1001101101)
                expect
                (fp #b1 #b10101 #b1010000000)))
(assert (fp.leq (fp #b1 #b10101 #b1010000000)
                expect
                (fp #b1 #b01000 #b1001100100)))
; expect = -104.0

(assert (= expect result))

(check-sat)
(exit)
