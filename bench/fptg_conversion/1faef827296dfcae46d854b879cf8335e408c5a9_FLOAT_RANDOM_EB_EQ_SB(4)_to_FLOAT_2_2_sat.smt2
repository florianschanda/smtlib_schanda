(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010101011 #b1110000100)
                arg1
                (fp #b1 #b01111111111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111111111 #b0001011101)
                arg1
                (fp #b1 #b01010001001 #b1001011111)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b01 #b1)))
(assert (fp.leq (fp #b1 #b01 #b1)
                expect
                (fp #b0 #b10 #b0)))
; expect = -1.5

(assert (= expect result))

(check-sat)
(exit)
