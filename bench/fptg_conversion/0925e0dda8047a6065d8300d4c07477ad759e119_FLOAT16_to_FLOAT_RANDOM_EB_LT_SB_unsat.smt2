; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b1111100101)
                arg1
                (fp #b0 #b11001 #b1111110011)))
(assert (fp.leq (fp #b0 #b11001 #b1111110011)
                arg1
                (fp #b0 #b11010 #b1111100111)))
; arg1 = 2035.0

(declare-const result (_ FloatingPoint 2 140))
(assert (= result ((_ to_fp 2 140) rm arg1)))

(declare-const expect (_ FloatingPoint 2 140))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
