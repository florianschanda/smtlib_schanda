(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg1
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg1
                (fp #b1 #b000 #b0000)))
; arg1 = -0.234375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001100 #b00011111000011000010010)
                expect
                (fp #b1 #b01111100 #b11100000000000000000000)))
(assert (fp.leq (fp #b1 #b01111100 #b11100000000000000000000)
                expect
                (fp #b1 #b00011111 #b10010011110010111001110)))
; expect = -0.234375

(assert (not (= expect result)))

(check-sat)
(exit)
