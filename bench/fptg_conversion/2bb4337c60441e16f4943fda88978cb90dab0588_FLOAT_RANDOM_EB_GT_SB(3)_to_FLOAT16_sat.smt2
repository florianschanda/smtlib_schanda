(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b100010100111011001 #b100)
                arg1
                (fp #b0 #b011110001000010111 #b111)))
(assert (fp.leq (fp #b0 #b011110001000010111 #b111)
                arg1
                (fp #b0 #b110100011111001001 #b000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1101100001)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01000 #b0101011100)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
