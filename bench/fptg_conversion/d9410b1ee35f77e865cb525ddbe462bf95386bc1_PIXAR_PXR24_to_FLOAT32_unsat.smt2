                expect
                (fp #b0 #b10001110 #b10010001110110000000000)))
(assert (fp.leq (fp #b0 #b10001110 #b10010001110110000000000)
                expect
                (fp #b0 #b10100000 #b00001011100111101010111)))
; expect = 51436.0

(assert (not (= expect result)))

