; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01010011 #b00111111100101111111000)
                arg1
                (fp #b0 #b01111111 #b10111000111111110010110)))
(assert (fp.leq (fp #b0 #b01111111 #b10111000111111110010110)
                arg1
                (fp #b0 #b10111001 #b10011110100100100100100)))
; arg1 = 1.7226436138153076171875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001110 #b0010101000)
                expect
                (fp #b0 #b01111111 #b1011100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1011100100)
                expect
                (fp #b0 #b11101110 #b1011010000)))
; expect = 1.72265625

(assert (not (= expect result)))

(check-sat)
(exit)
