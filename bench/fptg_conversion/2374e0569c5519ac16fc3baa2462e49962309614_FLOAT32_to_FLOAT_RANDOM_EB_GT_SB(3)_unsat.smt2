; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg1 = 11601303.0

(declare-const result (_ FloatingPoint 13 9))
(assert (= result ((_ to_fp 13 9) rm arg1)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0101010100111 #b11100110)
                expect
                (fp #b0 #b1000000010110 #b01100011)))
(assert (fp.leq (fp #b0 #b1000000010110 #b01100011)
                expect
                (fp #b0 #b1011111101000 #b10100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
