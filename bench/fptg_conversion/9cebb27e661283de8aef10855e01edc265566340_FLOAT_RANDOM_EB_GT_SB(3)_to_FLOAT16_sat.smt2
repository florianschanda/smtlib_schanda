(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10000100110 #b1000011)
                arg1
                (fp #b1 #b01111111111 #b0000001)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000001)
                arg1
                (fp #b1 #b00010101010 #b0110001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b0100111010)
                expect
                (fp #b1 #b01111 #b0000001000)))
(assert (fp.leq (fp #b1 #b01111 #b0000001000)
                expect
                (fp #b1 #b00101 #b1111011000)))
; expect = -1.0078125

(assert (= expect result))

(check-sat)
(exit)
