(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b10000100011000011 #b10100101010010)
                arg1
                (fp #b0 #b01111111111111111 #b01110001110010)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b01110001110010)
                arg1
                (fp #b0 #b11110100110011001 #b11000101011010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b001 #b0011)
                expect
                (fp #b0 #b011 #b1000)))
(assert (fp.leq (fp #b0 #b011 #b1000)
                expect
                (fp #b0 #b100 #b1011)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
