(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b011 #b0100)))
(assert (fp.leq (fp #b0 #b011 #b0100)
                arg1
                (fp #b0 #b100 #b0111)))
; arg1 = 1.25

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011010 #b0011110)
                expect
                (fp #b0 #b01111111 #b0100000)))
(assert (fp.leq (fp #b0 #b01111111 #b0100000)
                expect
                (fp #b0 #b10111000 #b0011001)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
