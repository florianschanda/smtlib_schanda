; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100000000100 #b01000011001)
                arg1
                (fp #b0 #b100000001010 #b10111011111)))
(assert (fp.leq (fp #b0 #b100000001010 #b10111011111)
                arg1
                (fp #b0 #b110010100001 #b01110010001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00110110 #b0100011)
                expect
                (fp #b0 #b10001010 #b1011110)))
(assert (fp.leq (fp #b0 #b10001010 #b1011110)
                expect
                (fp #b0 #b11100001 #b1000110)))
; expect = 3552.0

(assert (= expect result))

(check-sat)
(exit)
