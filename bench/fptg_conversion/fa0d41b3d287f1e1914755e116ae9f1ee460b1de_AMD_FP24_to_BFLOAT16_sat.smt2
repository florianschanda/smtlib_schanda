(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1110001100110110)
                arg1
                (fp #b1 #b1001111 #b0101110100010011)))
(assert (fp.leq (fp #b1 #b1001111 #b0101110100010011)
                arg1
                (fp #b1 #b0011101 #b1010101001110010)))
; arg1 = -89363.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b1011110)
                expect
                (fp #b1 #b10001111 #b0101111)))
(assert (fp.leq (fp #b1 #b10001111 #b0101111)
                expect
                (fp #b0 #b10011011 #b0010111)))
; expect = -89600.0

(assert (= expect result))

(check-sat)
(exit)
