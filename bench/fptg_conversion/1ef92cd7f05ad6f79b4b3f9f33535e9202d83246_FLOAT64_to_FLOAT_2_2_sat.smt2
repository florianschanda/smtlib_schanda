; Format from: FLOAT64
; Format to: FLOAT_2_2
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101100011 #b0100111110001000110110111000101010111100010010001111)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b00011101010 #b0101110001000001110101000000001001011110010001100110)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b10 #b0)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
