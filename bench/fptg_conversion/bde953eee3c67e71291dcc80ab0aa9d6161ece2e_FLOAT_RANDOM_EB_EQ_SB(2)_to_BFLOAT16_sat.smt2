(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b000)
                arg1
                (fp #b0 #b1011 #b101)))
(assert (fp.leq (fp #b0 #b1011 #b101)
                arg1
                (fp #b0 #b1100 #b100)))
; arg1 = 26.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111000 #b0111011)
                expect
                (fp #b0 #b10000011 #b1010000)))
(assert (fp.leq (fp #b0 #b10000011 #b1010000)
                expect
                (fp #b0 #b10001110 #b1100011)))
; expect = 26.0

(assert (= expect result))

(check-sat)
(exit)
