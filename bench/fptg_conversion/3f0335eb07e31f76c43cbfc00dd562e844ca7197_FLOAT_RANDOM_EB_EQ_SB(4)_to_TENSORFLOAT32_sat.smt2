; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000111001111010 #b000110100011000)
                arg1
                (fp #b0 #b0000000000000000 #b110011001100100)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110011001100100)
                arg1
                (fp #b0 #b1001011001001110 #b010011110100000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010101 #b1111011110)
                expect
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                expect
                (fp #b0 #b11011100 #b0111011000)))
; expect = 0.0000000000000000000000000000000000000000114794370197489014450071927463109929474479058278524172022339033816251685493625700473785400390625

(assert (= expect result))

(check-sat)
(exit)
