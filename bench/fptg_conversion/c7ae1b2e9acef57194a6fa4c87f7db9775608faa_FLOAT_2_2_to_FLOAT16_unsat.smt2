(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_2_2
; Format to: FLOAT16
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg1
                (fp #b1 #b10 #b1)))
(assert (fp.leq (fp #b1 #b10 #b1)
                arg1
                (fp #b0 #b01 #b0)))
; arg1 = -3.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0010100000)
                expect
                (fp #b1 #b10000 #b1000000000)))
(assert (fp.leq (fp #b1 #b10000 #b1000000000)
                expect
                (fp #b0 #b10110 #b1001110101)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
