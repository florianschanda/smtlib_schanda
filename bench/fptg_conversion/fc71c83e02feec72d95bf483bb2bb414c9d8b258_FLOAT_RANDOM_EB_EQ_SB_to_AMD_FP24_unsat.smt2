; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110011 #b00010)
                arg1
                (fp #b1 #b100100 #b11000)))
(assert (fp.leq (fp #b1 #b100100 #b11000)
                arg1
                (fp #b0 #b100110 #b11011)))
; arg1 = -56.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111001 #b0111110101100010)
                expect
                (fp #b1 #b1000100 #b1100000000000000)))
(assert (fp.leq (fp #b1 #b1000100 #b1100000000000000)
                expect
                (fp #b0 #b1011111 #b0011100000011000)))
; expect = -56.0

(assert (not (= expect result)))

(check-sat)
(exit)
