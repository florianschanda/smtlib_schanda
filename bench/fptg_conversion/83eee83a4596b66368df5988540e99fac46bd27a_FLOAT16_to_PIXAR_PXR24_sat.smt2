; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b0001001111)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11110 #b1001101111)))
; arg1 = 551.5

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011101 #b001100001000111)
                expect
                (fp #b0 #b10001000 #b000100111100000)))
(assert (fp.leq (fp #b0 #b10001000 #b000100111100000)
                expect
                (fp #b0 #b11110110 #b100100111001011)))
; expect = 551.5

(assert (= expect result))

(check-sat)
(exit)
