                expect
                (fp #b1 #b10000000010 #b1111000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000010 #b1111000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01110110011 #b1010000001010011100001110101011100111100101001100000)))

