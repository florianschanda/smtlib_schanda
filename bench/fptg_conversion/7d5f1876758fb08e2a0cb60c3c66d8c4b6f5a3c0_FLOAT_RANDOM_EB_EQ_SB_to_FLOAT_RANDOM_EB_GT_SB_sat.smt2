; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011011001100010 #b110001010000100)
                arg1
                (fp #b0 #b0000000000000000 #b101011100010010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b101011100010010)
                arg1
                (fp #b0 #b1011110001100011 #b010101111110110)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01010011111 #b1001001)
                expect
                (fp #b0 #b00000000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000001)
                expect
                (fp #b0 #b00001100101 #b1100000)))

(assert (= expect result))

(check-sat)
(exit)
