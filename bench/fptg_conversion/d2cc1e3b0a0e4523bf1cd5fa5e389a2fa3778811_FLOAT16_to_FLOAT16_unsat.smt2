; arg1 = 1.59765625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0011001011)
                expect
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                expect
                (fp #b0 #b10100 #b0101011011)))
; expect = 1.59765625

(assert (not (= expect result)))

(check-sat)
