(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01101111 #b101010000001100)
                expect
                (fp #b0 #b01111111 #b010000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b010000000000000)
                expect
                (fp #b0 #b11000011 #b110101101011001)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
