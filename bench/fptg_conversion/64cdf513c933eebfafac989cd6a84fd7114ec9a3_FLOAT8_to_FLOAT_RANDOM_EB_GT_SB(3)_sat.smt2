(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1000)))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b101 #b0000)))
; arg1 = -12.0

(declare-const result (_ FloatingPoint 10 3))
(assert (= result ((_ to_fp 10 3) rm arg1)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110010110 #b00)
                expect
                (fp #b1 #b1000000010 #b10)))
(assert (fp.leq (fp #b1 #b1000000010 #b10)
                expect
                (fp #b0 #b0110011010 #b01)))

(assert (= expect result))

(check-sat)
(exit)
