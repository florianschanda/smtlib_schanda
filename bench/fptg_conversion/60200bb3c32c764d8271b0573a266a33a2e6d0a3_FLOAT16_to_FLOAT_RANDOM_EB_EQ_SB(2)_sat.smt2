(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110111110)
                arg1
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg1
                (fp #b1 #b00101 #b1001111111)))
; arg1 = -1.203125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100010 #b00101)
                expect
                (fp #b1 #b011111 #b00111)))
(assert (fp.leq (fp #b1 #b011111 #b00111)
                expect
                (fp #b0 #b010010 #b11000)))
; expect = -1.21875

(assert (= expect result))

(check-sat)
(exit)
