; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111001100100 #b100)
                arg1
                (fp #b0 #b00000000000001 #b000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b000)
                arg1
                (fp #b0 #b00101000101011 #b001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0101101000)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10110 #b1000011111)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
