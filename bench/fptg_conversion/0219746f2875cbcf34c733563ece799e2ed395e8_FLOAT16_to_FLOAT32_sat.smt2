; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b1010111110)
                arg1
                (fp #b1 #b00000 #b0010001101)))
(assert (fp.leq (fp #b1 #b00000 #b0010001101)
                arg1
                (fp #b0 #b00111 #b0010000111)))
; arg1 = -0.000008404254913330078125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000010 #b00101000001110110100100)
                expect
                (fp #b1 #b01101110 #b00011010000000000000000)))
(assert (fp.leq (fp #b1 #b01101110 #b00011010000000000000000)
                expect
                (fp #b0 #b10111101 #b00010110100110010011101)))
; expect = -0.000008404254913330078125

(assert (= expect result))

(check-sat)
(exit)
