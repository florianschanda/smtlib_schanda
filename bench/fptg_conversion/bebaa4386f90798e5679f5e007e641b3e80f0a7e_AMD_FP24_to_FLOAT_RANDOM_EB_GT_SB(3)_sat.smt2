(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1010101 #b0100110100100111)
                arg1
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1000011 #b0010101110011001)))
; arg1 = -0

(declare-const result (_ FloatingPoint 17 11))
(assert (= result ((_ to_fp 17 11) rm arg1)))

(declare-const expect (_ FloatingPoint 17 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11110010011011101 #b1001101100)
                expect
                (fp #b1 #b00000000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0000000000)
                expect
                (fp #b0 #b00001110110000111 #b0101101001)))

(assert (= expect result))

(check-sat)
(exit)
