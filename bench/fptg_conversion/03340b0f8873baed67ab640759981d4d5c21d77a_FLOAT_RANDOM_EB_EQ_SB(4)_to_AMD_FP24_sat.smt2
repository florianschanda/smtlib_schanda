; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101011010011 #b10110111010000)
                arg1
                (fp #b1 #b100000000001010 #b00010011100000)))
(assert (fp.leq (fp #b1 #b100000000001010 #b00010011100000)
                arg1
                (fp #b0 #b111000000101000 #b01000000100111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b1101001010001000)
                expect
                (fp #b1 #b1001010 #b0001001110000000)))
(assert (fp.leq (fp #b1 #b1001010 #b0001001110000000)
                expect
                (fp #b0 #b1001110 #b1110001100010010)))
; expect = -2204.0

(assert (= expect result))

(check-sat)
(exit)
