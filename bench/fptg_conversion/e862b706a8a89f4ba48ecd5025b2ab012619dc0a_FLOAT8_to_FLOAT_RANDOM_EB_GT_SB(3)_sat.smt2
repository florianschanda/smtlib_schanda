(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1001)
                arg1
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = 3.875

(declare-const result (_ FloatingPoint 7 5))
(assert (= result ((_ to_fp 7 5) rm arg1)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1001001 #b1100)
                expect
                (fp #b0 #b1000000 #b1111)))
(assert (fp.leq (fp #b0 #b1000000 #b1111)
                expect
                (fp #b0 #b1001111 #b0101)))
; expect = 3.875

(assert (= expect result))

(check-sat)
(exit)
