(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110011 #b10111010110111100100001)
                arg1
                (fp #b1 #b10010110 #b00110101100000100101101)))
(assert (fp.leq (fp #b1 #b10010110 #b00110101100000100101101)
                arg1
                (fp #b1 #b01100000 #b00100011000111000101101)))
; arg1 = -10141997.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101110 #b000001010101101)
                expect
                (fp #b1 #b10010110 #b001101011000010)))
(assert (fp.leq (fp #b1 #b10010110 #b001101011000010)
                expect
                (fp #b1 #b01001000 #b111010000000011)))
; expect = -10142208.0

(assert (= expect result))

(check-sat)
(exit)
