; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b01011 #b00)
                arg1
                (fp #b0 #b00000 #b11)))
(assert (fp.leq (fp #b0 #b00000 #b11)
                arg1
                (fp #b0 #b01001 #b01)))
; arg1 = 0.0000457763671875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010000 #b00110001000101001010001)
                expect
                (fp #b0 #b01110000 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01110000 #b10000000000000000000000)
                expect
                (fp #b0 #b11011001 #b01001011011001111011011)))
; expect = 0.0000457763671875

(assert (= expect result))

(check-sat)
(exit)
