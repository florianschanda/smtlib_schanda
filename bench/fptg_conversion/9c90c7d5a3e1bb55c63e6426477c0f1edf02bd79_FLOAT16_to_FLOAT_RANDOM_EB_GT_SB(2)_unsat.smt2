; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1001011101)
                arg1
                (fp #b0 #b00000 #b0111111111)))
(assert (fp.leq (fp #b0 #b00000 #b0111111111)
                arg1
                (fp #b0 #b11000 #b1010101100)))
; arg1 = 0.000030457973480224609375

(declare-const result (_ FloatingPoint 11 5))
(assert (= result ((_ to_fp 11 5) rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b00100111100 #b0000)
                expect
                (fp #b0 #b01111110000 #b0000)))
(assert (fp.leq (fp #b0 #b01111110000 #b0000)
                expect
                (fp #b0 #b10101001000 #b0111)))

(assert (not (= expect result)))

(check-sat)
(exit)
