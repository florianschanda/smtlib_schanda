(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg1
                (fp #b0 #b011 #b01)))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 1.25

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01100011 #b0101101)
                expect
                (fp #b0 #b01111111 #b0100000)))
(assert (fp.leq (fp #b0 #b01111111 #b0100000)
                expect
                (fp #b0 #b10101101 #b0001000)))
; expect = 1.25

(assert (= expect result))

(check-sat)
(exit)
