; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b10 #b1)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 16 10))
(assert (= result ((_ to_fp 16 10) rm arg1)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110111010010111 #b100101011)
                expect
                (fp #b1 #b0111111111111110 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111111110 #b000000000)
                expect
                (fp #b1 #b0000100011101010 #b110111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
