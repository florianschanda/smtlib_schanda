; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010000000 #b110110100)
                arg1
                (fp #b0 #b0111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b0111111111 #b111111100)
                arg1
                (fp #b0 #b1010001001 #b100010100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001010 #b1100101110011110)
                expect
                (fp #b0 #b0111111 #b1111111000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1111111000000000)
                expect
                (fp #b0 #b1111011 #b1111000101011100)))
; expect = 1.9921875

(assert (= expect result))

(check-sat)
(exit)
