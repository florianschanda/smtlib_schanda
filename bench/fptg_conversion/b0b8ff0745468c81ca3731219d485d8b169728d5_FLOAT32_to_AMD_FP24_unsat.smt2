; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000000 #b01001000101011010101001)
                arg1
                (fp #b0 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111110 #b11111111010001001110110)))
; arg1 = 0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011010 #b0000111110000010)
                expect
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b0001010 #b0001111011101000)))
; expect = 0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(assert (not (= expect result)))

(check-sat)
(exit)
