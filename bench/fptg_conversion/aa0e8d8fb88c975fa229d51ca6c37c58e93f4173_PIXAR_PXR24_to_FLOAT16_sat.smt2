(assert (fp.leq (fp #b1 #b11110 #b0101110010)
                expect
                (fp #b1 #b11010 #b0010101010)))
(assert (fp.leq (fp #b1 #b11010 #b0010101010)
                expect
                (fp #b0 #b10011 #b1111111010)))
; expect = -2388.0

(assert (= expect result))

(check-sat)
