                expect
                (fp #b0 #b011111111111100 #b0000000)))
(assert (fp.leq (fp #b0 #b011111111111100 #b0000000)
                expect
                (fp #b0 #b110111111101100 #b1001101)))

(assert (not (= expect result)))

