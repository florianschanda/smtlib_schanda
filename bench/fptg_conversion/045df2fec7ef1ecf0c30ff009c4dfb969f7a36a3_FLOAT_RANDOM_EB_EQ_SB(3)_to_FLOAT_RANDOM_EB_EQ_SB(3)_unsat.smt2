; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                arg1
                (fp #b1 #b011 #b01)))
(assert (fp.leq (fp #b1 #b011 #b01)
                arg1
                (fp #b0 #b100 #b11)))
; arg1 = -1.25

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110001111000 #b10100010001)
                expect
                (fp #b1 #b011111111111 #b01000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b01000000000)
                expect
                (fp #b0 #b100110011011 #b00101001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
