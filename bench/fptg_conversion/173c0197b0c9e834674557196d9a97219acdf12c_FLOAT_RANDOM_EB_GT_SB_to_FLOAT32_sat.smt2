(assert (fp.leq (fp #b1 #b10101100 #b10100011100110010011000)
                expect
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b10010100 #b00100100110000011111010)))
