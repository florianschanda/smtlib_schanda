; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0100)
                arg1
                (fp #b1 #b011 #b1101)))
(assert (fp.leq (fp #b1 #b011 #b1101)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -1.8125

(declare-const result (_ FloatingPoint 7 6))
(assert (= result ((_ to_fp 7 6) rm arg1)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1001100 #b01001)
                expect
                (fp #b1 #b0111111 #b11010)))
(assert (fp.leq (fp #b1 #b0111111 #b11010)
                expect
                (fp #b0 #b1001011 #b00001)))
; expect = -1.8125

(assert (= expect result))

(check-sat)
(exit)
