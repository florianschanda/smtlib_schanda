(assert (fp.leq (fp #b1 #b11010011 #b1110110000)
                expect
                (fp #b1 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000001)
                expect
                (fp #b0 #b01100001 #b0000100110)))
