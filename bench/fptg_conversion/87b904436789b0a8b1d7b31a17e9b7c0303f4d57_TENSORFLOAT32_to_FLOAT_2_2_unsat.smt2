(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_2_2
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00111111 #b0101100110)
                arg1
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b10111100 #b1011110000)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00 #b0)
                expect
                (fp #b0 #b00 #b0)))
(assert (fp.leq (fp #b0 #b00 #b0)
                expect
                (fp #b0 #b10 #b1)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
