(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110010000111110 #b001110111100100)
                arg1
                (fp #b1 #b0110000110100001 #b101111000011001)))
(assert (fp.leq (fp #b1 #b0110000110100001 #b101111000011001)
                arg1
                (fp #b1 #b0010000110111001 #b101100101010111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00100 #b0011100011)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10101 #b1000010011)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
