; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111110 #b0110110011001011)
                arg1
                (fp #b1 #b1111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1111101 #b0000000000000000)
                arg1
                (fp #b1 #b1010001 #b1101110000000010)))
; arg1 = -4611686018427387904.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b0000011)
                expect
                (fp #b1 #b10111101 #b0000000)))
(assert (fp.leq (fp #b1 #b10111101 #b0000000)
                expect
                (fp #b1 #b01001000 #b1110011)))
; expect = -4611686018427387904.0

(assert (= expect result))

(check-sat)
(exit)
