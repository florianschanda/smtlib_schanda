; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1000111110)
                arg1
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                arg1
                (fp #b1 #b11001 #b1100010111)))
; arg1 = -3788.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result ((_ to_fp 5 3) rm arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11101 #b00)
                expect
                (fp #b1 #b11011 #b00)))
(assert (fp.leq (fp #b1 #b11011 #b00)
                expect
                (fp #b0 #b00001 #b10)))
; expect = -4096.0

(assert (not (= expect result)))

(check-sat)
(exit)
