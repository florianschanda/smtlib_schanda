(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111100100 #b0100111)
                arg1
                (fp #b0 #b000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b000000000 #b1011100)
                arg1
                (fp #b0 #b101011101 #b1100111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011011111 #b011100011)
                expect
                (fp #b0 #b0100000000 #b011100000)))
(assert (fp.leq (fp #b0 #b0100000000 #b011100000)
                expect
                (fp #b0 #b1000011100 #b111010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
