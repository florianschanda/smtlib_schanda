(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1101100111)
                arg1
                (fp #b0 #b10100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10100 #b0010001110)
                arg1
                (fp #b0 #b11100 #b1100100101)))
; arg1 = 36.4375

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00101 #b0011)
                expect
                (fp #b0 #b10100 #b0011)))
(assert (fp.leq (fp #b0 #b10100 #b0011)
                expect
                (fp #b0 #b11010 #b0110)))
; expect = 38.0

(assert (not (= expect result)))

(check-sat)
(exit)
