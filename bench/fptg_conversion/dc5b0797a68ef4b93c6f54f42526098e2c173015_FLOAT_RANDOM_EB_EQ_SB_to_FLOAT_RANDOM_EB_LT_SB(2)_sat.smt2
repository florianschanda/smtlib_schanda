(assert (fp.leq (fp #b1 #b1101 #b0101101101110101100)
                expect
                (fp #b0 #b0000 #b0000000000000000001)))
(assert (fp.leq (fp #b0 #b0000 #b0000000000000000001)
                expect
                (fp #b0 #b1011 #b0101000100011011011)))
; expect = 0.0000000298023223876953125

(assert (= expect result))

