; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b0)
                arg1
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                arg1
                (fp #b0 #b00100 #b1)))
; arg1 = -4.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                expect
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                expect
                (fp #b1 #b000 #b0101)))
; expect = -4.0

(assert (= expect result))

(check-sat)
(exit)
