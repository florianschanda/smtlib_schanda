                expect
                (fp #b0 #b10000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010011100 #b1001001111011111110011001100011001000101001101011111)))

