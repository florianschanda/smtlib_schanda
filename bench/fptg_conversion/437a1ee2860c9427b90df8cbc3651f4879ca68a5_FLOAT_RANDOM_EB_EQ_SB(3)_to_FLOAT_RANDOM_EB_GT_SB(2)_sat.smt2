; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b0110)
                arg1
                (fp #b1 #b01001 #b0001)))
(assert (fp.leq (fp #b1 #b01001 #b0001)
                arg1
                (fp #b1 #b00101 #b1111)))
; arg1 = -0.0166015625

(declare-const result (_ FloatingPoint 12 5))
(assert (= result ((_ to_fp 12 5) rm arg1)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110101100101 #b1100)
                expect
                (fp #b1 #b011111111001 #b0001)))
(assert (fp.leq (fp #b1 #b011111111001 #b0001)
                expect
                (fp #b0 #b110001010110 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
