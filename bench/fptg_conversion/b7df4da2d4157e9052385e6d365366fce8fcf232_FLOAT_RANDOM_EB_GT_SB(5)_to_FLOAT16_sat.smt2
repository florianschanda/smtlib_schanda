(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b100001100111 #b000010010)
                arg1
                (fp #b1 #b001101111000 #b111100010)))
(assert (fp.leq (fp #b1 #b001101111000 #b111100010)
                arg1
                (fp #b0 #b000101000011 #b011101001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b1100100011)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00000 #b0010110011)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
