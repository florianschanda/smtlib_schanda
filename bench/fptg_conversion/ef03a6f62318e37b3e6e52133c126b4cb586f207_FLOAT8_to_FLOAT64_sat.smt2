(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00010101011 #b0110010010011010000000111010011101001100010101100001)
                expect
                (fp #b0 #b10000000010 #b0110000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000010 #b0110000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11010001110 #b1110100110110011011011101111000010000100001010010110)))

(assert (= expect result))

(check-sat)
