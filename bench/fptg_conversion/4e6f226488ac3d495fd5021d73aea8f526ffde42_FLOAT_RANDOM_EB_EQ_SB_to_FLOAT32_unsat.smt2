(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b111)
                arg1
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg1
                (fp #b0 #b1000 #b011)))
; arg1 = 0.00390625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100000 #b00001010011100111100100)
                expect
                (fp #b0 #b01110111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01110111 #b00000000000000000000000)
                expect
                (fp #b0 #b11100111 #b01100011110011001000101)))
; expect = 0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
