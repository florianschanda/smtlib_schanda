; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00101101111011110101000)
                arg1
                (fp #b1 #b01111111 #b10010010111110011011111)))
(assert (fp.leq (fp #b1 #b01111111 #b10010010111110011011111)
                arg1
                (fp #b0 #b11110000 #b01011011000101111111000)))
; arg1 = -1.57412326335906982421875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0111101011)
                expect
                (fp #b1 #b01111 #b1001001100)))
(assert (fp.leq (fp #b1 #b01111 #b1001001100)
                expect
                (fp #b0 #b11001 #b1010101001)))
; expect = -1.57421875

(assert (not (= expect result)))

(check-sat)
(exit)
