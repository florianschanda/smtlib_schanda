(set-info :category "random")
(set-info :status unsat)

; Format from: BFLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011101 #b1100000)
                arg1
                (fp #b1 #b10000110 #b0011101)))
(assert (fp.leq (fp #b1 #b10000110 #b0011101)
                arg1
                (fp #b1 #b01010011 #b0010001)))
; arg1 = -157.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b10001110000110110100000)
                expect
                (fp #b1 #b10000110 #b00111010000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b00111010000000000000000)
                expect
                (fp #b0 #b01100110 #b11111101111000110010101)))
; expect = -157.0

(assert (not (= expect result)))

(check-sat)
(exit)
