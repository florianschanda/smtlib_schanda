(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b0110 #b1)
                arg1
                (fp #b0 #b0111 #b1)))
(assert (fp.leq (fp #b0 #b0111 #b1)
                arg1
                (fp #b0 #b1101 #b0)))
; arg1 = 1.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b1100001110)
                expect
                (fp #b0 #b01111 #b1000000000)))
(assert (fp.leq (fp #b0 #b01111 #b1000000000)
                expect
                (fp #b0 #b10101 #b1100011011)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
