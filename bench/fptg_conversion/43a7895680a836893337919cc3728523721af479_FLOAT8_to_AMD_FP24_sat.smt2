(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0011)
                arg1
                (fp #b0 #b110 #b0010)))
(assert (fp.leq (fp #b0 #b110 #b0010)
                arg1
                (fp #b0 #b110 #b0110)))
; arg1 = 9.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011001 #b1100101110011101)
                expect
                (fp #b0 #b1000010 #b0010000000000000)))
(assert (fp.leq (fp #b0 #b1000010 #b0010000000000000)
                expect
                (fp #b0 #b1111100 #b1011001111001001)))
; expect = 9.0

(assert (= expect result))

(check-sat)
(exit)
