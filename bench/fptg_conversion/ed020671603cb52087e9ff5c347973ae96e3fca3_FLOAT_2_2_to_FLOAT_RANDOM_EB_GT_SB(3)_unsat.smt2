; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 0.5

(declare-const result (_ FloatingPoint 5 2))
(assert (= result ((_ to_fp 5 2) rm arg1)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b0 #b00011 #b0)
                expect
                (fp #b0 #b01110 #b0)))
(assert (fp.leq (fp #b0 #b01110 #b0)
                expect
                (fp #b0 #b01110 #b1)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
(exit)
