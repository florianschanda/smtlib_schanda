; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1100101001)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11101 #b1100111000)))
; arg1 = 1671.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001100 #b10111000011101010110100)
                expect
                (fp #b0 #b10001001 #b10100001110000000000000)))
(assert (fp.leq (fp #b0 #b10001001 #b10100001110000000000000)
                expect
                (fp #b0 #b10011001 #b10000110010001110001100)))
; expect = 1671.0

(assert (not (= expect result)))

(check-sat)
(exit)
