(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00011 #b1011101000)
                arg1
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg1
                (fp #b0 #b10110 #b1110111001)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 15 3))
(assert (= result ((_ to_fp 15 3) rm arg1)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011110000011011 #b01)
                expect
                (fp #b0 #b000000000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00)
                expect
                (fp #b0 #b011111101011110 #b00)))

(assert (= expect result))

(check-sat)
(exit)
