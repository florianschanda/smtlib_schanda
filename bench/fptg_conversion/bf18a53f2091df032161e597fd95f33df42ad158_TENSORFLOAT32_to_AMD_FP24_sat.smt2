(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: AMD_FP24
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000111 #b1010101001)
                arg1
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b10111010 #b1010011010)))
; arg1 = 2048.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001001 #b1100100001101111)
                expect
                (fp #b0 #b1001010 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1001010 #b0000000000000000)
                expect
                (fp #b0 #b1011010 #b1010001011111010)))
; expect = 2048.0

(assert (= expect result))

(check-sat)
(exit)
