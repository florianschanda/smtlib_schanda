(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101010000 #b0111111)
                arg1
                (fp #b1 #b100000110 #b0110001)))
(assert (fp.leq (fp #b1 #b100000110 #b0110001)
                arg1
                (fp #b1 #b001101000 #b1011000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110011010 #b11111110101)
                expect
                (fp #b1 #b100000000110 #b01100010000)))
(assert (fp.leq (fp #b1 #b100000000110 #b01100010000)
                expect
                (fp #b0 #b000100010101 #b00111111101)))

(assert (= expect result))

(check-sat)
(exit)
