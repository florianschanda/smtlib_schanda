(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0110 #b0)
                arg1
                (fp #b0 #b1010 #b1)))
(assert (fp.leq (fp #b0 #b1010 #b1)
                arg1
                (fp #b0 #b1110 #b0)))
; arg1 = 12.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01100001 #b00010011000111101110011)
                expect
                (fp #b0 #b10000010 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b10000000000000000000000)
                expect
                (fp #b0 #b10011001 #b11101000101000010110111)))
; expect = 12.0

(assert (= expect result))

(check-sat)
(exit)
