; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000110 #b1100001101000011)
                arg1
                (fp #b0 #b0111111 #b1000110111010011)))
(assert (fp.leq (fp #b0 #b0111111 #b1000110111010011)
                arg1
                (fp #b0 #b1110100 #b1111101110001000)))
; arg1 = 1.5540008544921875

(declare-const result (_ FloatingPoint 11 3))
(assert (= result ((_ to_fp 11 3) rm arg1)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10101100110 #b01)
                expect
                (fp #b0 #b01111111111 #b11)))
(assert (fp.leq (fp #b0 #b01111111111 #b11)
                expect
                (fp #b0 #b11011101000 #b10)))

(assert (= expect result))

(check-sat)
(exit)
