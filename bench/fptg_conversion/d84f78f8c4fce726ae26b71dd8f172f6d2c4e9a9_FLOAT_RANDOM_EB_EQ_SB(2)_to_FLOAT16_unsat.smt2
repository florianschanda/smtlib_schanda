(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0000)
                arg1
                (fp #b1 #b10010 #b0011)))
(assert (fp.leq (fp #b1 #b10010 #b0011)
                arg1
                (fp #b1 #b10000 #b1100)))
; arg1 = -9.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b0000000000)
                expect
                (fp #b1 #b10010 #b0011000000)))
(assert (fp.leq (fp #b1 #b10010 #b0011000000)
                expect
                (fp #b1 #b10000 #b0101100000)))
; expect = -9.5

(assert (not (= expect result)))

(check-sat)
(exit)
