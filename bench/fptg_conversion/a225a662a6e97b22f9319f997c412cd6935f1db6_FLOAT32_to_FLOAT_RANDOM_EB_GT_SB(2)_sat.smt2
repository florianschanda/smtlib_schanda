; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10111101 #b11110110111111110001000)
                arg1
                (fp #b0 #b11100001 #b00100101010001111111111)))
(assert (fp.leq (fp #b0 #b11100001 #b00100101010001111111111)
                arg1
                (fp #b0 #b11100010 #b01000011000111111010010)))
; arg1 = 363064564367733570790597066752.0

(declare-const result (_ FloatingPoint 13 9))
(assert (= result ((_ to_fp 13 9) rm arg1)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1101111110111 #b01100101)
                expect
                (fp #b0 #b1000001100001 #b00100110)))
(assert (fp.leq (fp #b0 #b1000001100001 #b00100110)
                expect
                (fp #b0 #b1000101000000 #b01011001)))

(assert (= expect result))

(check-sat)
(exit)
