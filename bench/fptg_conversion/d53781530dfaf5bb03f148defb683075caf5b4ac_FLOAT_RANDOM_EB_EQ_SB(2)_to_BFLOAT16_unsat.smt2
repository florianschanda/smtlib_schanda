; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b0 #b00111110100001011 #b0101000010011100)
                arg1
                (fp #b0 #b10000000000001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b10000000000001111 #b0010101011110000)
                arg1
                (fp #b0 #b10011001000110001 #b0111000001011111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111011 #b0011011)
                expect
                (fp #b0 #b10001111 #b0010110)))
(assert (fp.leq (fp #b0 #b10001111 #b0010110)
                expect
                (fp #b0 #b11111001 #b0110001)))
; expect = 76800.0

(assert (not (= expect result)))

(check-sat)
