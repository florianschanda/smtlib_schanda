; arg1 = -0.000006616115570068359375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110000 #b10110010110110110111000)
                expect
                (fp #b1 #b01101101 #b10111100000000000000000)))
(assert (fp.leq (fp #b1 #b01101101 #b10111100000000000000000)
                expect
                (fp #b1 #b00101100 #b00011011111011100111011)))
; expect = -0.000006616115570068359375

(assert (= expect result))

(check-sat)
(exit)
