; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000010000111100 #b001110111000011)
                arg1
                (fp #b1 #b0000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010000000000000)
                arg1
                (fp #b0 #b0000000001101000 #b001111101111011)))

(declare-const result (_ FloatingPoint 5 3))
(assert (= result ((_ to_fp 5 3) rm arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10000 #b11)
                expect
                (fp #b1 #b00000 #b01)))
(assert (fp.leq (fp #b1 #b00000 #b01)
                expect
                (fp #b0 #b10010 #b11)))
; expect = -0.0000152587890625

(assert (= expect result))

(check-sat)
(exit)
