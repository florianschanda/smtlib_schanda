(declare-const expect (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b101110110100010101 #b1011000011)
                expect
                (fp #b1 #b011111111111111111 #b0100000000)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b0100000000)
                expect
                (fp #b1 #b010101011010100110 #b0101110000)))

(assert (= expect result))

(check-sat)
(exit)
