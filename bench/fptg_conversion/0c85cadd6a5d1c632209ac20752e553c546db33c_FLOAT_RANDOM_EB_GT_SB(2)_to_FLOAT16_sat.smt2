(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000011001 #b10001001)
                arg1
                (fp #b1 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000000)
                arg1
                (fp #b0 #b0110100011 #b10010111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b0101001011)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00111 #b0010010010)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
