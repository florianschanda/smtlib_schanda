; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000000001)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b10011 #b1100111011)))
; arg1 = -0.00006103515625

(declare-const result (_ FloatingPoint 4 5))
(assert (= result ((_ to_fp 4 5) rm arg1)))

(declare-const expect (_ FloatingPoint 4 5))
(assert (fp.leq (fp #b1 #b1101 #b1010)
                expect
                (fp #b1 #b0000 #b0001)))
(assert (fp.leq (fp #b1 #b0000 #b0001)
                expect
                (fp #b0 #b1110 #b1000)))
; expect = -0.0009765625

(assert (not (= expect result)))

(check-sat)
(exit)
