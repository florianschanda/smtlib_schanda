; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg1
                (fp #b1 #b010 #b0000)))
(assert (fp.leq (fp #b1 #b010 #b0000)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101101 #b10000)
                expect
                (fp #b1 #b011110 #b00000)))
(assert (fp.leq (fp #b1 #b011110 #b00000)
                expect
                (fp #b0 #b001011 #b00010)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
