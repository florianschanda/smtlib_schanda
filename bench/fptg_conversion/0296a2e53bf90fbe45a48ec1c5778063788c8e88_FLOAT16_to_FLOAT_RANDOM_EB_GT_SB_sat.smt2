; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1101100111)
                arg1
                (fp #b0 #b10100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10100 #b0010001110)
                arg1
                (fp #b0 #b11100 #b1100100101)))
; arg1 = 36.4375

(declare-const result (_ FloatingPoint 14 11))
(assert (= result ((_ to_fp 14 11) rm arg1)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b0 #b00001111111011 #b1001111110)
                expect
                (fp #b0 #b10000000000100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10000000000100 #b0010001110)
                expect
                (fp #b0 #b11010001010011 #b1111001101)))

(assert (= expect result))

(check-sat)
(exit)
