(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111001 #b1110000)
                arg1
                (fp #b0 #b10000110 #b1001000)))
(assert (fp.leq (fp #b0 #b10000110 #b1001000)
                arg1
                (fp #b0 #b11101001 #b0100000)))
; arg1 = 200.0

(declare-const result (_ FloatingPoint 8 3))
(assert (= result ((_ to_fp 8 3) rm arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10001010 #b00)
                expect
                (fp #b0 #b10000110 #b11)))
(assert (fp.leq (fp #b0 #b10000110 #b11)
                expect
                (fp #b0 #b10011101 #b11)))
; expect = 224.0

(assert (= expect result))

(check-sat)
(exit)
