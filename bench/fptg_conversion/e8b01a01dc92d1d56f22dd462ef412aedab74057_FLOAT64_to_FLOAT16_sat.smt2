; Format from: FLOAT64
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01000111001 #b0010101100011010011101101100001000100100001101110011)
                arg1
                (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)
                arg1
                (fp #b0 #b10100110000 #b1110100111111111011011100111110010010011101000110111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00101 #b0010001011)
                expect
                (fp #b0 #b01111 #b0001000000)))
(assert (fp.leq (fp #b0 #b01111 #b0001000000)
                expect
                (fp #b0 #b10110 #b1110100111)))
; expect = 1.0625

(assert (= expect result))

(check-sat)
(exit)
