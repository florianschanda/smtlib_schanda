(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101010110101111 #b01000010101100)
                expect
                (fp #b1 #b011111111111111 #b00010010000000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b00010010000000)
                expect
                (fp #b0 #b001000111011011 #b00010101100010)))

(assert (= expect result))

(check-sat)
(exit)
