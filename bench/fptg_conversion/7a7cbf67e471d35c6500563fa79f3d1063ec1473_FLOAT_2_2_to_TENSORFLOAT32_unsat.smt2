; Format from: FLOAT_2_2
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b0)
                arg1
                (fp #b0 #b01 #b1)))
(assert (fp.leq (fp #b0 #b01 #b1)
                arg1
                (fp #b0 #b11 #b0)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01000010 #b0010010100)
                expect
                (fp #b0 #b01111111 #b1000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b1000000000)
                expect
                (fp #b0 #b10100101 #b1110111000)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
