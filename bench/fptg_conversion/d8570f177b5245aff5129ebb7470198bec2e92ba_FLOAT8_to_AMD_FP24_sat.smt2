(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1010)
                arg1
                (fp #b1 #b000 #b0100)))
(assert (fp.leq (fp #b1 #b000 #b0100)
                arg1
                (fp #b0 #b110 #b0000)))
; arg1 = -0.0625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000110 #b0101010110010010)
                expect
                (fp #b1 #b0111011 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111011 #b0000000000000000)
                expect
                (fp #b0 #b0110001 #b0011110011000010)))
; expect = -0.0625

(assert (= expect result))

(check-sat)
(exit)
