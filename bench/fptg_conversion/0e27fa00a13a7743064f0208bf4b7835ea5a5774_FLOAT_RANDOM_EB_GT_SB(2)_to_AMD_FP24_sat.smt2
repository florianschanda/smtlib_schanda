(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10100100 #b111011)
                arg1
                (fp #b1 #b10000101 #b011101)))
(assert (fp.leq (fp #b1 #b10000101 #b011101)
                arg1
                (fp #b0 #b01001110 #b000011)))
; arg1 = -93.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010001 #b0000001110111110)
                expect
                (fp #b1 #b1000101 #b0111010000000000)))
(assert (fp.leq (fp #b1 #b1000101 #b0111010000000000)
                expect
                (fp #b1 #b1000100 #b0101101000101011)))
; expect = -93.0

(assert (= expect result))

(check-sat)
(exit)
