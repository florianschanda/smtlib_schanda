; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111110 #b0001010)
                arg1
                (fp #b1 #b00000000 #b1101100)))
(assert (fp.leq (fp #b1 #b00000000 #b1101100)
                arg1
                (fp #b0 #b01010011 #b0101111)))
; arg1 = -0.00000000000000000000000000000000000000991823358506305084848621453281269790659499063526448846273009252172414562664926052093505859375

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0010100100)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10100 #b0101110001)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
