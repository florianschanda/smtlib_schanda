; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b01)
                arg1
                (fp #b0 #b011 #b11)))
(assert (fp.leq (fp #b0 #b011 #b11)
                arg1
                (fp #b0 #b111 #b00)))
; arg1 = 1.75

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001100101 #b00011000)
                expect
                (fp #b0 #b011111111 #b11000000)))
(assert (fp.leq (fp #b0 #b011111111 #b11000000)
                expect
                (fp #b0 #b111111110 #b10100110)))

(assert (= expect result))

(check-sat)
(exit)
