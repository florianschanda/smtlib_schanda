; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111101 #b1)
                arg1
                (fp #b1 #b111010 #b1)))
(assert (fp.leq (fp #b1 #b111010 #b1)
                arg1
                (fp #b1 #b100011 #b0)))
; arg1 = -201326592.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000011 #b0100001000)
                expect
                (fp #b1 #b10011010 #b1000000000)))
(assert (fp.leq (fp #b1 #b10011010 #b1000000000)
                expect
                (fp #b0 #b11010011 #b1111111111)))
; expect = -201326592.0

(assert (= expect result))

(check-sat)
(exit)
