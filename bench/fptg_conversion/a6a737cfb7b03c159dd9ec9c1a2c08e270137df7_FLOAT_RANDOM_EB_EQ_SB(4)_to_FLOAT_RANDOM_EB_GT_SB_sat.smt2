(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111011011 #b1001100000001)
                arg1
                (fp #b0 #b00000000000000 #b1000101001110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1000101001110)
                arg1
