(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0101110101010 #b110)
                expect
                (fp #b0 #b0000000000000 #b001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b001)
                expect
                (fp #b0 #b0000111101110 #b111)))

(assert (= expect result))

(check-sat)
