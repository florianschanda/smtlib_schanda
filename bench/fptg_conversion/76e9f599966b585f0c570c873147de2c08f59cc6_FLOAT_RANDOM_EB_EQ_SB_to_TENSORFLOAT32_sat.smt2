; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101001010001011 #b111111000101100)
                arg1
                (fp #b1 #b0111111111111111 #b100111100100001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b100111100100001)
                arg1
                (fp #b0 #b0110010001001010 #b101010011011000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001101 #b0010011100)
                expect
                (fp #b1 #b01111111 #b1001111010)))
(assert (fp.leq (fp #b1 #b01111111 #b1001111010)
                expect
                (fp #b0 #b00000110 #b1101011110)))
; expect = -1.619140625

(assert (= expect result))

(check-sat)
(exit)
