                expect
                (fp #b0 #b1000000000000010 #b11000000000000)))
(assert (fp.leq (fp #b0 #b1000000000000010 #b11000000000000)
                expect
                (fp #b0 #b1111000110011001 #b01111010110001)))

(assert (= expect result))

