(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01111011 #b10111000011000001010001)
                arg1
                (fp #b0 #b10011101 #b00000111101001011001111)))
(assert (fp.leq (fp #b0 #b10011101 #b00000111101001011001111)
                arg1
                (fp #b0 #b10101011 #b01110011101010100110101)))
; arg1 = 1105815424.0

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0100000011 #b1110)
                expect
                (fp #b0 #b1000011101 #b0001)))
(assert (fp.leq (fp #b0 #b1000011101 #b0001)
                expect
                (fp #b0 #b1010111110 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
