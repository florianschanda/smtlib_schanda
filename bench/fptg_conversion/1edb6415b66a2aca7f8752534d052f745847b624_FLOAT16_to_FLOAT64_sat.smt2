(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT64
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110111111)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b1 #b00000 #b0101101101)))
; arg1 = -2048.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111000111 #b0111000100110010011110011011011001101110110011000000)
                expect
                (fp #b1 #b10000001010 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01101001000 #b0000100001011010000000100101110100110111001001000001)))

(assert (= expect result))

(check-sat)
(exit)
