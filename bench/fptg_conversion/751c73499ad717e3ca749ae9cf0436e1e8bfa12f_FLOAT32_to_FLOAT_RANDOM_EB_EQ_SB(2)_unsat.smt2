(assert (fp.leq (fp #b1 #b111111011 #b11001110)
                expect
                (fp #b1 #b011111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111 #b00000000)
                expect
                (fp #b0 #b000000000 #b01100010)))

(assert (not (= expect result)))

