; Format from: FLOAT64
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111011101 #b0111000001110100101011010011000111100101110100000101)
                arg1
                (fp #b1 #b00000000000 #b0001011111000100100100000000011000100011100101110111)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011111000100100100000000011000100011100101110111)
                arg1
                (fp #b0 #b10011001110 #b1010001011100111100011100011010000000100110101010101)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0011)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b110 #b1100)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
