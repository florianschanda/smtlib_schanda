; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00001111111 #b1100111)
                arg1
                (fp #b1 #b00000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000001)
                arg1
                (fp #b0 #b01111101010 #b1100101)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100111 #b11001)
                expect
                (fp #b1 #b000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000 #b00001)
                expect
                (fp #b0 #b011000 #b10101)))
; expect = -0.00000000002910383045673370361328125

(assert (= expect result))

(check-sat)
(exit)
