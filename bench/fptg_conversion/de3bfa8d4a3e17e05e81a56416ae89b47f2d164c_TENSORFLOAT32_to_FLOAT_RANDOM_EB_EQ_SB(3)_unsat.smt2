(assert (fp.leq (fp #b1 #b011100011100001111 #b01111000000100000)
                expect
                (fp #b1 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b001111001010011000 #b00001010001000000)))

(assert (not (= expect result)))

