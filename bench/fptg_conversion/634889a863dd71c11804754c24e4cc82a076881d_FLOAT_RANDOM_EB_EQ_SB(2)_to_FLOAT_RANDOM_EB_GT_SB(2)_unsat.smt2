(declare-const result (_ FloatingPoint 16 2))
(assert (= result ((_ to_fp 16 2) rm arg1)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1010100110100011 #b1)
                expect
                (fp #b0 #b1000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b1000000000000000 #b0)
                expect
                (fp #b0 #b1101100101110011 #b0)))

(assert (not (= expect result)))

(check-sat)
