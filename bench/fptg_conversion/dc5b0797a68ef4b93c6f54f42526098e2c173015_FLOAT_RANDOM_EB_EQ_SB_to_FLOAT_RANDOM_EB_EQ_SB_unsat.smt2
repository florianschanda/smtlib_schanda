(assert (fp.leq (fp #b1 #b0100 #b100)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b0000 #b011)))
; expect = 0.001953125

(assert (not (= expect result)))

