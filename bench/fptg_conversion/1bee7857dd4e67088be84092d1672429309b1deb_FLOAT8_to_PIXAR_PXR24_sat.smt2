; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg1
                (fp #b1 #b011 #b0101)))
; arg1 = -3.875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100101 #b010011100011111)
                expect
                (fp #b1 #b10000000 #b111100000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b111100000000000)
                expect
                (fp #b0 #b10110011 #b000111001001110)))
; expect = -3.875

(assert (= expect result))

(check-sat)
(exit)
