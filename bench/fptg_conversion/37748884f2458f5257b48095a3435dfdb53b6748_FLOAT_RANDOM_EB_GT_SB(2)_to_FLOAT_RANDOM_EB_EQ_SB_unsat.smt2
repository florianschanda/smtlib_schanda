(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111100 #b100)
                arg1
                (fp #b0 #b01111111 #b001)))
(assert (fp.leq (fp #b0 #b01111111 #b001)
                arg1
                (fp #b0 #b11110000 #b111)))
; arg1 = 1.125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b010)
                expect
                (fp #b0 #b0111 #b001)))
(assert (fp.leq (fp #b0 #b0111 #b001)
                expect
                (fp #b0 #b1000 #b100)))
; expect = 1.125

(assert (not (= expect result)))

(check-sat)
(exit)
