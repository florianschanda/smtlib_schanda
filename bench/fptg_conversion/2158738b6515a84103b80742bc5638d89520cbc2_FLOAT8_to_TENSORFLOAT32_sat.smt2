(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1001)
                arg1
                (fp #b1 #b101 #b0110)))
(assert (fp.leq (fp #b1 #b101 #b0110)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -5.5

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110110 #b0011000111)
                expect
                (fp #b1 #b10000001 #b0110000000)))
(assert (fp.leq (fp #b1 #b10000001 #b0110000000)
                expect
                (fp #b0 #b10110110 #b0010011110)))
; expect = -5.5

(assert (= expect result))

(check-sat)
(exit)
