(assert (fp.leq (fp #b1 #b00111110 #b0101011)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b00011111 #b1010001)))
