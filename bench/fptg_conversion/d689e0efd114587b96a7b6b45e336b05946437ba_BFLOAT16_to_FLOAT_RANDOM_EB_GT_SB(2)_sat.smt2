; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b0101000)
                arg1
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                arg1
                (fp #b1 #b01010001 #b0011001)))
; arg1 = -1.3046875

(declare-const result (_ FloatingPoint 7 3))
(assert (= result ((_ to_fp 7 3) rm arg1)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1100110 #b10)
                expect
                (fp #b1 #b0111111 #b10)))
(assert (fp.leq (fp #b1 #b0111111 #b10)
                expect
                (fp #b0 #b0011111 #b01)))
; expect = -1.5

(assert (= expect result))

(check-sat)
(exit)
