(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111011000010011011 #b01100001011111110)
                arg1
                (fp #b1 #b001111111111110111 #b01101010000010100)))
(assert (fp.leq (fp #b1 #b001111111111110111 #b01101010000010100)
                arg1
                (fp #b1 #b001011110010011100 #b01110011010110111)))

(declare-const result (_ FloatingPoint 3 5))
