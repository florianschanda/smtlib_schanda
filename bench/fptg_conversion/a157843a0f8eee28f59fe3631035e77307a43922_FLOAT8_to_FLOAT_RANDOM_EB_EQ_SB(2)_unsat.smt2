                expect
                (fp #b0 #b011111111010 #b10000000000)))
(assert (fp.leq (fp #b0 #b011111111010 #b10000000000)
                expect
                (fp #b0 #b101011111010 #b01001011110)))

(assert (not (= expect result)))

