; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111011011 #b01)
                arg1
                (fp #b1 #b000000000 #b11)))
(assert (fp.leq (fp #b1 #b000000000 #b11)
                arg1
                (fp #b0 #b111111010 #b10)))

(declare-const result (_ FloatingPoint 12 34))
(assert (= result ((_ to_fp 12 34) rm arg1)))

(declare-const expect (_ FloatingPoint 12 34))
(assert (fp.leq (fp #b1 #b110011100100 #b111011000111011010001001111111010)
                expect
                (fp #b1 #b011100000000 #b100000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b011100000000 #b100000000000000000000000000000000)
                expect
                (fp #b0 #b101111000001 #b001001010110101101111111000100110)))

(assert (= expect result))

(check-sat)
(exit)
