; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000000010)
                arg1
                (fp #b1 #b10111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10111 #b0000100000)
                arg1
                (fp #b0 #b01110 #b0100111000)))
; arg1 = -264.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110110001110000 #b111010101100011)
                expect
                (fp #b1 #b1000000000000111 #b000010000000000)))
(assert (fp.leq (fp #b1 #b1000000000000111 #b000010000000000)
                expect
                (fp #b0 #b0011111100110100 #b111000110001111)))

(assert (= expect result))

(check-sat)
(exit)
