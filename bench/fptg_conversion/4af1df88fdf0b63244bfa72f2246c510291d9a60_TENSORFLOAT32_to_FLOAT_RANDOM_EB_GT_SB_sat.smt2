; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000100 #b1011101111)
                arg1
                (fp #b0 #b00000000 #b0100101110)))
(assert (fp.leq (fp #b0 #b00000000 #b0100101110)
                arg1
                (fp #b0 #b00010001 #b1001100000)))
; arg1 = 0.000000000000000000000000000000000000003466789979964168236392172209385919870129267560011429995074638821250800901907496154308319091796875

(declare-const result (_ FloatingPoint 10 2))
(assert (= result ((_ to_fp 10 2) rm arg1)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0111011111 #b1)
                expect
                (fp #b0 #b0101111111 #b1)))
(assert (fp.leq (fp #b0 #b0101111111 #b1)
                expect
                (fp #b0 #b1100110111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
