(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1101011100)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b11101 #b1101011111)))
; arg1 = 0.054473876953125

(declare-const result (_ FloatingPoint 6 2))
(assert (= result ((_ to_fp 6 2) rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110101 #b0)
                expect
                (fp #b0 #b011011 #b0)))
(assert (fp.leq (fp #b0 #b011011 #b0)
                expect
                (fp #b0 #b111010 #b1)))
; expect = 0.0625

(assert (= expect result))

(check-sat)
(exit)
