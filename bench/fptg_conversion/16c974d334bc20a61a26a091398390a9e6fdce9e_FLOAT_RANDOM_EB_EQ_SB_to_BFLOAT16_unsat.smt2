; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b001)
                arg1
                (fp #b1 #b0100 #b110)))
(assert (fp.leq (fp #b1 #b0100 #b110)
                arg1
                (fp #b1 #b0010 #b001)))
; arg1 = -0.21875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001001 #b1101011)
                expect
                (fp #b1 #b01111100 #b1100000)))
(assert (fp.leq (fp #b1 #b01111100 #b1100000)
                expect
                (fp #b0 #b11111010 #b0110110)))
; expect = -0.21875

(assert (not (= expect result)))

(check-sat)
(exit)
