(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00011 #b1010010100)
                arg1
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00010 #b1011110100)))
; arg1 = 0.0000152587890625

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0011 #b1)
                expect
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                expect
                (fp #b0 #b1000 #b0)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
