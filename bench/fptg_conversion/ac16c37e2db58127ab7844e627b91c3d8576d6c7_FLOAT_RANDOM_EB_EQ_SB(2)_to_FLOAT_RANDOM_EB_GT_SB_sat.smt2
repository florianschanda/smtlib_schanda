(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b01000011101)
                arg1
                (fp #b1 #b100000000111 #b10110100000)))
(assert (fp.leq (fp #b1 #b100000000111 #b10110100000)
                arg1
                (fp #b1 #b010111100000 #b10000011001)))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result ((_ to_fp 8 3) rm arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b10111111 #b10)
                expect
                (fp #b1 #b10000111 #b11)))
(assert (fp.leq (fp #b1 #b10000111 #b11)
                expect
                (fp #b1 #b01000000 #b10)))
; expect = -448.0

(assert (= expect result))

(check-sat)
(exit)
