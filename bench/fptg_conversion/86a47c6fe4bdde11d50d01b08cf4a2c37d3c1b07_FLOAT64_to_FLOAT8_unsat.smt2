; Format from: FLOAT64
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001111100 #b1011001001011111101000000010010010010111100001111011)
                arg1
                (fp #b0 #b11010010100 #b0011101110001100000111111010111001101010110011010101)))
(assert (fp.leq (fp #b0 #b11010010100 #b0011101110001100000111111010111001101010110011010101)
                arg1
                (fp #b0 #b11010100001 #b1110111000010000110001001101001011010110001101001100)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
