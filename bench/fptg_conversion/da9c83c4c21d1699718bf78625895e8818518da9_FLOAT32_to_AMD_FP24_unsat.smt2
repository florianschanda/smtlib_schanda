; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100110 #b00011100001110000101010)
                arg1
                (fp #b1 #b01111111 #b11110100011000110101101)))
(assert (fp.leq (fp #b1 #b01111111 #b11110100011000110101101)
                arg1
                (fp #b1 #b01010000 #b01111110010010000001111)))
; arg1 = -1.95464098453521728515625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010011 #b0101110101011000)
                expect
                (fp #b1 #b0111111 #b1111010001100100)))
(assert (fp.leq (fp #b1 #b0111111 #b1111010001100100)
                expect
                (fp #b0 #b1001000 #b0000110001100011)))
; expect = -1.95465087890625

(assert (not (= expect result)))

(check-sat)
(exit)
