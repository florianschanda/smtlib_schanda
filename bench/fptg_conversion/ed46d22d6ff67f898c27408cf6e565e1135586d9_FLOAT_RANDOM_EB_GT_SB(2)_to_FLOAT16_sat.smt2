; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111010111000 #b0000001010)
                arg1
                (fp #b0 #b000000000000 #b0111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b0111111111)
                arg1
                (fp #b0 #b000000111110 #b0111110001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b0000101000)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10010 #b1110111011)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
