; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101100 #b00011000010000111111110)
                arg1
                (fp #b1 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b10001001 #b00110000001010010001100)))
; arg1 = -18446742974197923840.0

(declare-const result (_ FloatingPoint 13 5))
(assert (= result ((_ to_fp 13 5) rm arg1)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1110100001001 #b0000)
                expect
                (fp #b1 #b1000000111111 #b0000)))
(assert (fp.leq (fp #b1 #b1000000111111 #b0000)
                expect
                (fp #b1 #b0001010001110 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
