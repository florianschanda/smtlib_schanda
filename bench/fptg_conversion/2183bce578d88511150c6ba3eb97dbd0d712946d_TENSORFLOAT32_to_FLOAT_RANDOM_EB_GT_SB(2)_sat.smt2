(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0110000001)
                arg1
                (fp #b1 #b11111110 #b0100100101)))
(assert (fp.leq (fp #b1 #b11111110 #b0100100101)
                arg1
                (fp #b0 #b10110001 #b1000100101)))
; arg1 = -218824158806091775576789237298651725824.0

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101110100 #b0100)
                expect
                (fp #b1 #b1001111110 #b0101)))
(assert (fp.leq (fp #b1 #b1001111110 #b0101)
                expect
                (fp #b0 #b1011100110 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
