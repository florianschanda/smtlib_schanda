; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010110 #b0101110100)
                arg1
                (fp #b1 #b01111111 #b0100110000)))
(assert (fp.leq (fp #b1 #b01111111 #b0100110000)
                arg1
                (fp #b1 #b00001111 #b0011110110)))
; arg1 = -1.296875

(declare-const result (_ FloatingPoint 6 2))
(assert (= result ((_ to_fp 6 2) rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111110 #b0)
                expect
                (fp #b1 #b011111 #b1)))
(assert (fp.leq (fp #b1 #b011111 #b1)
                expect
                (fp #b1 #b011101 #b0)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
