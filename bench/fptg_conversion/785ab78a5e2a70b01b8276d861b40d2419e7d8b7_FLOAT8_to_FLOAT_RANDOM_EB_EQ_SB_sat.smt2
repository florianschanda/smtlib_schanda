(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b011 #b0100)))
(assert (fp.leq (fp #b0 #b011 #b0100)
                arg1
                (fp #b0 #b100 #b0111)))
; arg1 = 1.25

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b001)
                expect
                (fp #b0 #b0111 #b010)))
(assert (fp.leq (fp #b0 #b0111 #b010)
                expect
                (fp #b0 #b1110 #b001)))
; expect = 1.25

(assert (= expect result))

(check-sat)
(exit)
