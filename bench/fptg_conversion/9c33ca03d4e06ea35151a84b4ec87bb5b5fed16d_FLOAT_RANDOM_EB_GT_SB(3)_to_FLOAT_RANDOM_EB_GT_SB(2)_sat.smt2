; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101010 #b10)
                arg1
                (fp #b1 #b011111 #b00)))
(assert (fp.leq (fp #b1 #b011111 #b00)
                arg1
                (fp #b0 #b011100 #b00)))
; arg1 = -1.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result ((_ to_fp 8 7) rm arg1)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11010010 #b111110)
                expect
                (fp #b1 #b01111111 #b000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000)
                expect
                (fp #b0 #b01110010 #b101100)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
