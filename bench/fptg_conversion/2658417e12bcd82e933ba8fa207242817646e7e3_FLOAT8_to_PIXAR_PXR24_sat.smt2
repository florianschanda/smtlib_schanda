(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b0101)))
(assert (fp.leq (fp #b0 #b000 #b0101)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = 0.078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100010 #b011110000101010)
                expect
                (fp #b0 #b01111011 #b010000000000000)))
(assert (fp.leq (fp #b0 #b01111011 #b010000000000000)
                expect
                (fp #b0 #b10111011 #b110100101001010)))
; expect = 0.078125

(assert (= expect result))

(check-sat)
(exit)
