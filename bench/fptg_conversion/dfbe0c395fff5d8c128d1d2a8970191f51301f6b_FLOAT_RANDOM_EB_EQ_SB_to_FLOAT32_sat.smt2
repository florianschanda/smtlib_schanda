(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111100000000 #b1010101000101)
                arg1
                (fp #b1 #b11101110010101 #b1000100010010)))
(assert (fp.leq (fp #b1 #b11101110010101 #b1000100010010)
                arg1
                (fp #b1 #b00110110000110 #b1001011010010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
