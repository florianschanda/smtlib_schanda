; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b110111100010010100 #b1100001000)
                arg1
                (fp #b0 #b100000010101101111 #b0100111111)))
(assert (fp.leq (fp #b0 #b100000010101101111 #b0100111111)
                arg1
                (fp #b0 #b110110100000111101 #b1011010110)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
