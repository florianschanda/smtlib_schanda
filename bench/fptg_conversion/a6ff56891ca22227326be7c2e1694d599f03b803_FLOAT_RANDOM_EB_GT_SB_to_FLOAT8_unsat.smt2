; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b001 #b0)
                arg1
                (fp #b0 #b001 #b1)))
(assert (fp.leq (fp #b0 #b001 #b1)
                arg1
                (fp #b0 #b011 #b1)))
; arg1 = 0.375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1100)
                expect
                (fp #b0 #b001 #b1000)))
(assert (fp.leq (fp #b0 #b001 #b1000)
                expect
                (fp #b0 #b100 #b1111)))
; expect = 0.375

(assert (not (= expect result)))

(check-sat)
(exit)
