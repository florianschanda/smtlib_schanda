(assert (fp.leq (fp #b1 #b11000111 #b10011110100010011100001)
                expect
                (fp #b1 #b01111110 #b00100001011001001011001)))
(assert (fp.leq (fp #b1 #b01111110 #b00100001011001001011001)
                expect
                (fp #b1 #b01101100 #b10101001101110000011011)))
