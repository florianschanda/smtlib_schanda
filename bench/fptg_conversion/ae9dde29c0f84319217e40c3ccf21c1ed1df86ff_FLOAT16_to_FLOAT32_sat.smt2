(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00111 #b0010111101)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b11110 #b1101111111)))
; arg1 = 0.0000045299530029296875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110100 #b01001110110000000001111)
                expect
                (fp #b0 #b01101101 #b00110000000000000000000)))
(assert (fp.leq (fp #b0 #b01101101 #b00110000000000000000000)
                expect
                (fp #b0 #b10111011 #b10111001010111100011110)))
; expect = 0.0000045299530029296875

(assert (= expect result))

(check-sat)
(exit)
