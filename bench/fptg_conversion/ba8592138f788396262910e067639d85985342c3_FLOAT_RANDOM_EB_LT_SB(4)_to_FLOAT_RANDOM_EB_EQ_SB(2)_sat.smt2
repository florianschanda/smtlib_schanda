(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 17))
(assert (fp.leq (fp #b0 #b1101 #b1011010000111010)
                arg1
                (fp #b0 #b1110 #b1111111000000000)))
(assert (fp.leq (fp #b0 #b1110 #b1111111000000000)
                arg1
                (fp #b0 #b1110 #b1111111001010111)))
; arg1 = 255.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111001 #b11000)
                expect
                (fp #b0 #b100111 #b00000)))
(assert (fp.leq (fp #b0 #b100111 #b00000)
                expect
                (fp #b0 #b101100 #b01100)))
; expect = 256.0

(assert (= expect result))

(check-sat)
(exit)
