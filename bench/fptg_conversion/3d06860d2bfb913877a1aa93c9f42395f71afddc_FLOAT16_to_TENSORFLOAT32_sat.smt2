(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1000011111)
                arg1
                (fp #b0 #b01111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111 #b1101111000)
                arg1
                (fp #b0 #b10011 #b1101000111)))
; arg1 = 1.8671875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00101111 #b0100111000)
                expect
                (fp #b0 #b01111111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111111 #b1101111000)
                expect
                (fp #b0 #b10001010 #b0100101111)))
; expect = 1.8671875

(assert (= expect result))

(check-sat)
(exit)
