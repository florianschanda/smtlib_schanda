; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b101)
                arg1
                (fp #b1 #b1010 #b001)))
(assert (fp.leq (fp #b1 #b1010 #b001)
                arg1
                (fp #b0 #b0110 #b000)))
; arg1 = -9.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b0000010010)
                expect
                (fp #b1 #b10010 #b0010000000)))
(assert (fp.leq (fp #b1 #b10010 #b0010000000)
                expect
                (fp #b0 #b00100 #b1000001101)))
; expect = -9.0

(assert (not (= expect result)))

(check-sat)
(exit)
