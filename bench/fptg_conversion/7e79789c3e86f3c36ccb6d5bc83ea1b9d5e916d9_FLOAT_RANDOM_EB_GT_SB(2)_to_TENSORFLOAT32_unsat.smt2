(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1110 #b1)
                arg1
                (fp #b1 #b0100 #b0)))
(assert (fp.leq (fp #b1 #b0100 #b0)
                arg1
                (fp #b1 #b0001 #b0)))
; arg1 = -0.125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111110 #b1101000111)
                expect
                (fp #b1 #b01111100 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111100 #b0000000000)
                expect
                (fp #b0 #b11111010 #b1101110110)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
