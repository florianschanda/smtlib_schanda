; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b0101)))
(assert (fp.leq (fp #b0 #b000 #b0101)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = 0.078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000111 #b1111110)
                expect
                (fp #b0 #b01111011 #b0100000)))
(assert (fp.leq (fp #b0 #b01111011 #b0100000)
                expect
                (fp #b0 #b10111001 #b0001010)))
; expect = 0.078125

(assert (not (= expect result)))

(check-sat)
(exit)
