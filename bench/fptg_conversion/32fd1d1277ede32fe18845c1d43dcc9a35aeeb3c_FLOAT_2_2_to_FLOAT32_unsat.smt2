(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_2_2
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b01 #b1)))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = -1.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100100 #b01111010110110011000110)
                expect
                (fp #b1 #b01111111 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b10000000000000000000000)
                expect
                (fp #b0 #b10110110 #b00110011000111011001111)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
