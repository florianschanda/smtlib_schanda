(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1110010 #b0010000011101111)
                arg1
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1001101 #b1110011011101000)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 15 6))
(assert (= result ((_ to_fp 15 6) rm arg1)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001111111101101 #b01110)
                expect
                (fp #b0 #b000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000)
                expect
                (fp #b0 #b010000000111101 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
