(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00010 #b0100)
                arg1
                (fp #b0 #b11011 #b0100)))
(assert (fp.leq (fp #b0 #b11011 #b0100)
                arg1
                (fp #b0 #b11101 #b0100)))
; arg1 = 5120.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111001 #b00110110110110011011001)
                expect
                (fp #b0 #b10001011 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001011 #b01000000000000000000000)
                expect
                (fp #b0 #b11000101 #b11101111110111010011011)))
; expect = 5120.0

(assert (= expect result))

(check-sat)
(exit)
