; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101001 #b01010010001101001000011)
                arg1
                (fp #b1 #b01111111 #b01000101000011100000101)))
(assert (fp.leq (fp #b1 #b01111111 #b01000101000011100000101)
                arg1
                (fp #b1 #b01011111 #b11100010001010011110000)))
; arg1 = -1.26974546909332275390625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b0110101111)
                expect
                (fp #b1 #b01111 #b0100010101)))
(assert (fp.leq (fp #b1 #b01111 #b0100010101)
                expect
                (fp #b0 #b11001 #b0110111001)))
; expect = -1.2705078125

(assert (= expect result))

(check-sat)
(exit)
