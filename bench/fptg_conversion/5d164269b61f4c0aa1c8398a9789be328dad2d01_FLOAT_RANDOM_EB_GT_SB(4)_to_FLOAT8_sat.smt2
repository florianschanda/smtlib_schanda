(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1110001 #b0101)
                arg1
                (fp #b0 #b0000000 #b1111)))
(assert (fp.leq (fp #b0 #b0000000 #b1111)
                arg1
                (fp #b0 #b1101110 #b0001)))
; arg1 = 0.000000000000000000203287907341032081376397400163114070892333984375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0101)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b010 #b0110)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
