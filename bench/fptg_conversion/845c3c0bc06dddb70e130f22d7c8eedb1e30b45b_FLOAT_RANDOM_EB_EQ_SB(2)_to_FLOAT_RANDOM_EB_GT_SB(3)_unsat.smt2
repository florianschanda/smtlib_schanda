(assert (fp.leq (fp #b1 #b101011010101010 #b00111)
                expect
                (fp #b1 #b011111111111111 #b10100)))
(assert (fp.leq (fp #b1 #b011111111111111 #b10100)
                expect
                (fp #b0 #b010010111100000 #b10000)))

(assert (not (= expect result)))

