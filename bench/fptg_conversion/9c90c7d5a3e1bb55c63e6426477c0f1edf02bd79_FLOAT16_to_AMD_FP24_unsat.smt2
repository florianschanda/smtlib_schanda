                expect
                (fp #b0 #b0101111 #b1111111100000000)))
(assert (fp.leq (fp #b0 #b0101111 #b1111111100000000)
                expect
                (fp #b0 #b1110101 #b0110010010110111)))
; expect = 0.000030457973480224609375

(assert (not (= expect result)))

