; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000100100)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b10110 #b0110111010)))
; arg1 = 0.10479736328125

(declare-const result (_ FloatingPoint 11 5))
(assert (= result ((_ to_fp 11 5) rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11001111010 #b1110)
                expect
                (fp #b0 #b01111111011 #b1011)))
(assert (fp.leq (fp #b0 #b01111111011 #b1011)
                expect
                (fp #b0 #b11111101010 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
