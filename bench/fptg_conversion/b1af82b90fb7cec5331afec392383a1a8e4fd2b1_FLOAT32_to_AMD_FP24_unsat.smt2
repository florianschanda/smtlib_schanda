(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b00100010011001100000000)
                arg1
                (fp #b0 #b10010101 #b10001001000000100111000)))
(assert (fp.leq (fp #b0 #b10010101 #b10001001000000100111000)
                arg1
                (fp #b0 #b10010101 #b10001010111100001010010)))
; arg1 = 6439068.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0100011110111111)
                expect
                (fp #b0 #b1010101 #b1000100100000011)))
(assert (fp.leq (fp #b0 #b1010101 #b1000100100000011)
                expect
                (fp #b0 #b1101100 #b1100011110110111)))
; expect = 6439104.0

(assert (not (= expect result)))

(check-sat)
(exit)
