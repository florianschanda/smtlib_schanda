(assert (fp.leq (fp #b1 #b111011011111111110 #b11110110001011100)
                expect
                (fp #b1 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b110110100111011001 #b01001111101101010)))

(assert (not (= expect result)))

