(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 36))
(assert (fp.leq (fp #b1 #b1100 #b10010000001101011010011000000011111)
                arg1
                (fp #b1 #b1010 #b11111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b1010 #b11111111111111111111111111111111111)
                arg1
                (fp #b0 #b1010 #b11100100100011010101111010100001011)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010000 #b10000101100100110110110)
                expect
                (fp #b1 #b10000011 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000011 #b00000000000000000000000)
                expect
                (fp #b0 #b00111110 #b00000000000001111000110)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
