; Format from: FLOAT64
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01011101100 #b1011101101111000011001101010111001000000101111010000)
                arg1
                (fp #b0 #b10000110001 #b0011011000100100000001100000010000000100001110101000)))
(assert (fp.leq (fp #b0 #b10000110001 #b0011011000100100000001100000010000000100001110101000)
                arg1
                (fp #b0 #b10101000000 #b1001100001010011000111001101011001010100111101001110)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
