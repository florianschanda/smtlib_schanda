(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1101011010)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11100 #b0101000111)))
; arg1 = 2048.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100110 #b01000101000100001100100)
                expect
                (fp #b0 #b10001010 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b00000000000000000000000)
                expect
                (fp #b0 #b10101001 #b01011110010100010011111)))
; expect = 2048.0

(assert (not (= expect result)))

(check-sat)
(exit)
