(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11011 #b1)
                arg1
                (fp #b1 #b10110 #b1)))
(assert (fp.leq (fp #b1 #b10110 #b1)
                arg1
                (fp #b0 #b10000 #b0)))
; arg1 = -192.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110101 #b1100110101)
                expect
                (fp #b1 #b10000110 #b1000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b1000000000)
                expect
                (fp #b0 #b00001010 #b1010001100)))
; expect = -192.0

(assert (= expect result))

(check-sat)
(exit)
