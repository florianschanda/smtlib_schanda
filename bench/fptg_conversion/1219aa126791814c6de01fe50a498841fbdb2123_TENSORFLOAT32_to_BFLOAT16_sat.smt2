(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100111 #b1010111001)
                arg1
                (fp #b1 #b10001001 #b0110110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0110110001)
                arg1
                (fp #b0 #b10101100 #b1010011110)))
; arg1 = -1457.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011001 #b0010110)
                expect
                (fp #b1 #b10001001 #b0110111)))
(assert (fp.leq (fp #b1 #b10001001 #b0110111)
                expect
                (fp #b0 #b10101001 #b0001000)))
; expect = -1464.0

(assert (= expect result))

(check-sat)
(exit)
