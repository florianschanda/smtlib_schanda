; Format from: AMD_FP24
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1110111110001011)
                arg1
                (fp #b1 #b1001101 #b0001110100010110)))
(assert (fp.leq (fp #b1 #b1001101 #b0001110100010110)
                arg1
                (fp #b0 #b1010011 #b0100110000101001)))
; arg1 = -18245.5

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
