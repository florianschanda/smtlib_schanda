(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001010 #b11110011011001100001000)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b1 #b00101100 #b10010100011010110100011)))
; arg1 = -1.040654659271240234375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                expect
                (fp #b1 #b011 #b0001)))
(assert (fp.leq (fp #b1 #b011 #b0001)
                expect
                (fp #b0 #b101 #b0100)))
; expect = -1.0625

(assert (= expect result))

(check-sat)
(exit)
