(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10110011100 #b00011)
                arg1
                (fp #b1 #b10000000011 #b10110)))
(assert (fp.leq (fp #b1 #b10000000011 #b10110)
                arg1
                (fp #b0 #b00101001000 #b01101)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1111101111)
                expect
                (fp #b1 #b10011 #b1011000000)))
(assert (fp.leq (fp #b1 #b10011 #b1011000000)
                expect
                (fp #b0 #b00110 #b1001010011)))
; expect = -27.0

(assert (= expect result))

(check-sat)
(exit)
