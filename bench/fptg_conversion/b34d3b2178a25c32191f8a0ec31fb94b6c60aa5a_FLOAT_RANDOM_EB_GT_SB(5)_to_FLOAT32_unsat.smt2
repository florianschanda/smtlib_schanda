(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b000111 #b0)
                arg1
                (fp #b0 #b011111 #b1)))
(assert (fp.leq (fp #b0 #b011111 #b1)
                arg1
                (fp #b0 #b100100 #b1)))
; arg1 = 1.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001100 #b10010100101100011010100)
                expect
                (fp #b0 #b01111111 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10000000000000000000000)
                expect
                (fp #b0 #b10111011 #b10100100010101011100111)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
