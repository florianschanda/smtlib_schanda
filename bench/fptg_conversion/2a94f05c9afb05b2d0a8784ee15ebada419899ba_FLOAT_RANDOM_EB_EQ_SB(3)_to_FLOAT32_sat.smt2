; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010111 #b10101)
                arg1
                (fp #b0 #b011111 #b10100)))
(assert (fp.leq (fp #b0 #b011111 #b10100)
                arg1
                (fp #b0 #b110110 #b00111)))
; arg1 = 1.625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000000 #b11110110001000011111001)
                expect
                (fp #b0 #b01111111 #b10100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10100000000000000000000)
                expect
                (fp #b0 #b10100110 #b01110101110000001110111)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
