(assert (fp.leq (fp #b1 #b000010111100 #b1)
                expect
                (fp #b1 #b000000000000 #b1)))
(assert (fp.leq (fp #b1 #b000000000000 #b1)
                expect
                (fp #b0 #b000001000100 #b0)))

(assert (= expect result))

