(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1000)
                arg1
                (fp #b0 #b000 #b0011)))
(assert (fp.leq (fp #b0 #b000 #b0011)
                arg1
                (fp #b0 #b110 #b1010)))
; arg1 = 0.046875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0111110001)
                expect
                (fp #b0 #b01010 #b1000000000)))
(assert (fp.leq (fp #b0 #b01010 #b1000000000)
                expect
                (fp #b0 #b11101 #b0001011110)))
; expect = 0.046875

(assert (not (= expect result)))

(check-sat)
(exit)
