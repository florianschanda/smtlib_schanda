; Format from: FLOAT64
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101110100 #b1010001000000101100110010010111101101011101100111111)
                arg1
                (fp #b0 #b01111111111 #b0100010000101010010100110110010000011010000110110111)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100010000101010010100110110010000011010000110110111)
                arg1
                (fp #b0 #b11111110000 #b1001011010101110111111111101111001111110110100001101)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0000 #b01)
                expect
                (fp #b0 #b0111 #b10)))
(assert (fp.leq (fp #b0 #b0111 #b10)
                expect
                (fp #b0 #b1000 #b01)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
