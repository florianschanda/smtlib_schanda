(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b100001101111 #b11111111011)
                arg1
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                arg1
                (fp #b0 #b111101100000 #b10010001100)))

(declare-const result (_ FloatingPoint 7 4))
(assert (= result ((_ to_fp 7 4) rm arg1)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0111111 #b011)
                expect
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                expect
                (fp #b0 #b1100000 #b111)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
