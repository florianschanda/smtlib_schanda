; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b01000000100011010100010)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b11001001 #b10100100001111010000000)))
; arg1 = -19824648192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b1010001000111011)
                expect
                (fp #b1 #b1100001 #b0010011101101010)))
(assert (fp.leq (fp #b1 #b1100001 #b0010011101101010)
                expect
                (fp #b1 #b0111010 #b1110110111100111)))
; expect = -19824902144.0

(assert (not (= expect result)))

(check-sat)
(exit)
