(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1101)
                arg1
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                arg1
                (fp #b0 #b110 #b1111)))
; arg1 = -0.015625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010011 #b110111010000100)
                expect
                (fp #b1 #b01111001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111001 #b000000000000000)
                expect
                (fp #b1 #b00101100 #b110101111000110)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
