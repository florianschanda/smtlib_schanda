; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT64
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10110111111 #b0111000100)
                arg1
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b11011110100 #b0110010000)))

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11001110110 #b1011011110100110110110110010010100100111111110000010)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00111111100 #b1000111011010110111001111101100001110001011101000111)))

(assert (= expect result))

(check-sat)
(exit)
