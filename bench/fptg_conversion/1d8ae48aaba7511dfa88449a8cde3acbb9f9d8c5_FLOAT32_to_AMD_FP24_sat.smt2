(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01010011 #b00111111100101111111000)
                arg1
                (fp #b0 #b01111111 #b10111000111111110010110)))
(assert (fp.leq (fp #b0 #b01111111 #b10111000111111110010110)
                arg1
                (fp #b0 #b10111001 #b10011110100100100100100)))
; arg1 = 1.7226436138153076171875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000011 #b0101010101000000)
                expect
                (fp #b0 #b0111111 #b1011100100000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1011100100000000)
                expect
                (fp #b0 #b1000010 #b1111100011001000)))
; expect = 1.72265625

(assert (= expect result))

(check-sat)
(exit)
