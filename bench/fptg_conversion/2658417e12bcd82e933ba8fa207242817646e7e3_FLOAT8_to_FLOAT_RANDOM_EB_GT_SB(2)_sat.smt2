(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b0101)))
(assert (fp.leq (fp #b0 #b000 #b0101)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = 0.078125

(declare-const result (_ FloatingPoint 16 9))
(assert (= result ((_ to_fp 16 9) rm arg1)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1000101010000100 #b11011010)
                expect
                (fp #b0 #b0111111111111011 #b01000000)))
(assert (fp.leq (fp #b0 #b0111111111111011 #b01000000)
                expect
                (fp #b0 #b1111100011101111 #b11001010)))

(assert (= expect result))

(check-sat)
(exit)
