; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110000011)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b1 #b01111 #b1000100111)))
; arg1 = -255.875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011110 #b11001011000100000011111)
                expect
                (fp #b1 #b10000110 #b11111111110000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b11111111110000000000000)
                expect
                (fp #b1 #b00011110 #b00110111001000010000011)))
; expect = -255.875

(assert (not (= expect result)))

(check-sat)
(exit)
