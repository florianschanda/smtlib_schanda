; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110111 #b11010110)
                arg1
                (fp #b0 #b000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000 #b00000001)
                arg1
                (fp #b0 #b111000001 #b00110010)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result ((_ to_fp 12 4) rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111111101100 #b001)
                expect
                (fp #b0 #b011011111001 #b000)))
(assert (fp.leq (fp #b0 #b011011111001 #b000)
                expect
                (fp #b0 #b100000111100 #b100)))

(assert (= expect result))

(check-sat)
(exit)
