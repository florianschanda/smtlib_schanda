; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: PIXAR_PXR24
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b1)
                arg1
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                arg1
                (fp #b0 #b0010 #b0)))
; arg1 = 0.0078125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00101111 #b101111001000100)
                expect
                (fp #b0 #b01111000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111000 #b000000000000000)
                expect
                (fp #b0 #b10111000 #b001010000001100)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
