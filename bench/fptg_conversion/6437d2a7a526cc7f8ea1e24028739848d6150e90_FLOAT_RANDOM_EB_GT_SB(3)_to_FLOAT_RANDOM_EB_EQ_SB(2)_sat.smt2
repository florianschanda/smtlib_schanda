; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001100001 #b0110)
                arg1
                (fp #b0 #b1000000010 #b0010)))
(assert (fp.leq (fp #b0 #b1000000010 #b0010)
                arg1
                (fp #b0 #b1000000011 #b0000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001100111001 #b01000100100)
                expect
                (fp #b0 #b100000000010 #b00100000000)))
(assert (fp.leq (fp #b0 #b100000000010 #b00100000000)
                expect
                (fp #b0 #b100100011111 #b01100110101)))

(assert (= expect result))

(check-sat)
(exit)
