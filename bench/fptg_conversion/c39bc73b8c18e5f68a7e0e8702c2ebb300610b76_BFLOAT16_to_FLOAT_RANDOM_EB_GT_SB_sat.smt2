(declare-const result (_ FloatingPoint 10 6))
(assert (= result ((_ to_fp 10 6) rm arg1)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101010000 #b01011)
                expect
                (fp #b1 #b1001111111 #b00000)))
(assert (fp.leq (fp #b1 #b1001111111 #b00000)
                expect
                (fp #b1 #b0100100001 #b11101)))

(assert (= expect result))

(check-sat)
(exit)
