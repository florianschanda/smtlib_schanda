; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b11011000 #b01011000111000111001000)
                arg1
                (fp #b0 #b11110011 #b01001001100100010110011)))
(assert (fp.leq (fp #b0 #b11110011 #b01001001100100010110011)
                arg1
                (fp #b0 #b11111000 #b00000011010111010100111)))
; arg1 = 106950918570191514810027511577051136.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010101 #b101000010110001)
                expect
                (fp #b0 #b11110011 #b010010011001001)))
(assert (fp.leq (fp #b0 #b11110011 #b010010011001001)
                expect
                (fp #b0 #b11110110 #b011000100010100)))
; expect = 106951681141255714604276849437573120.0

(assert (not (= expect result)))

(check-sat)
(exit)
