(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111101000 #b10101)
                arg1
                (fp #b1 #b011111111 #b10110)))
(assert (fp.leq (fp #b1 #b011111111 #b10110)
                arg1
                (fp #b1 #b001100101 #b10011)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111111 #b00001111100010001011111)
                expect
                (fp #b1 #b01111111 #b10110000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b10110000000000000000000)
                expect
                (fp #b0 #b10001110 #b10100100101010100110000)))
; expect = -1.6875

(assert (= expect result))

(check-sat)
(exit)
