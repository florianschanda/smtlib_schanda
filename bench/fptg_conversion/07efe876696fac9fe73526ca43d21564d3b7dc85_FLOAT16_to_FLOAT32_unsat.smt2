(assert (fp.leq (fp #b1 #b11010101 #b11100111010110110000111)
                expect
                (fp #b0 #b01110000 #b11111111100000000000000)))
(assert (fp.leq (fp #b0 #b01110000 #b11111111100000000000000)
                expect
                (fp #b0 #b10001110 #b11011010011101001011001)))
; expect = 0.000060975551605224609375

(assert (not (= expect result)))

(check-sat)
