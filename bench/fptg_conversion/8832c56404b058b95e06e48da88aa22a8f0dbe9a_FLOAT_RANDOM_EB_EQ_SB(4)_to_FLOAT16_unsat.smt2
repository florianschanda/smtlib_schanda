(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b101 #b10)))
(assert (fp.leq (fp #b1 #b101 #b10)
                arg1
                (fp #b0 #b100 #b10)))
; arg1 = -6.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0111100100)
                expect
                (fp #b1 #b10001 #b1000000000)))
(assert (fp.leq (fp #b1 #b10001 #b1000000000)
                expect
                (fp #b1 #b01101 #b1000011010)))
; expect = -6.0

(assert (not (= expect result)))

(check-sat)
(exit)
