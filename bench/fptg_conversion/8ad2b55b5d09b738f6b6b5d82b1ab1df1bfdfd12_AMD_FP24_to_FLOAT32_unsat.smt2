; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b1001111011111101)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg1
                (fp #b0 #b1111011 #b1010010101000011)))
; arg1 = -36787.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101101 #b01111010011010100111010)
                expect
                (fp #b1 #b10001110 #b00011111011001100000000)))
(assert (fp.leq (fp #b1 #b10001110 #b00011111011001100000000)
                expect
                (fp #b0 #b11110011 #b01100011111011111110000)))
; expect = -36787.0

(assert (not (= expect result)))

(check-sat)
(exit)
