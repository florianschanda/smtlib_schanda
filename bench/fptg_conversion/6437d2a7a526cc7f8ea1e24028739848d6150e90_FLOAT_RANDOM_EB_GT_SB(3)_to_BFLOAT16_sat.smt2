(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001100001 #b0110)
                arg1
                (fp #b0 #b1000000010 #b0010)))
(assert (fp.leq (fp #b0 #b1000000010 #b0010)
                arg1
                (fp #b0 #b1000000011 #b0000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001111 #b0111101)
                expect
                (fp #b0 #b10000010 #b0010000)))
(assert (fp.leq (fp #b0 #b10000010 #b0010000)
                expect
                (fp #b0 #b10101111 #b0000101)))
; expect = 9.0

(assert (= expect result))

(check-sat)
