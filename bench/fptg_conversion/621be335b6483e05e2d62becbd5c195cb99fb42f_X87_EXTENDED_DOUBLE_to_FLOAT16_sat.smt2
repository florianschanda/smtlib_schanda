(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b100011011110010 #b101111111000001011001010110001001110101001011110111100001010100)
                arg1
                (fp #b1 #b100000000111110 #b010001000101000001011000010010001110100011000011100111100111100)))
(assert (fp.leq (fp #b1 #b100000000111110 #b010001000101000001011000010010001110100011000011100111100111100)
                arg1
                (fp #b1 #b000010111010101 #b110000100100100110101111001001010000110010100100101101000101000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
