(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b1001110 #b1011)
                arg1
                (fp #b1 #b0111111 #b0000)))
(assert (fp.leq (fp #b1 #b0111111 #b0000)
                arg1
                (fp #b1 #b0001110 #b0001)))
; arg1 = -1.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111111 #b10001111100100011000010)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10000111 #b01011010111000111110111)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
