; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100101010101 #b10011110)
                arg1
                (fp #b1 #b011111111111 #b01111011)))
(assert (fp.leq (fp #b1 #b011111111111 #b01111011)
                arg1
                (fp #b0 #b100001111001 #b00111010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1101101010)
                expect
                (fp #b1 #b01111 #b0111101100)))
(assert (fp.leq (fp #b1 #b01111 #b0111101100)
                expect
                (fp #b0 #b10101 #b0100010011)))
; expect = -1.48046875

(assert (= expect result))

(check-sat)
(exit)
