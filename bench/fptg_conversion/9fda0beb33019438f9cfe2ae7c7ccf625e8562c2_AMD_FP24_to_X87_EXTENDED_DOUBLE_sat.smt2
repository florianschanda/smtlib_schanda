(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110100101011011 #b000011111001110101010010101010011100011111110101000001111011100)
                expect
                (fp #b1 #b100000000001111 #b101111101111001000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000001111 #b101111101111001000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b001100001011111 #b000110010011011000111100110001010010100001100100011100011101001)))

(assert (= expect result))

(check-sat)
(exit)
