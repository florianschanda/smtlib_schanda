(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b110 #b01)))
(assert (fp.leq (fp #b0 #b110 #b01)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 10.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001111 #b00110110100010111010100)
                expect
                (fp #b0 #b10000010 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b01000000000000000000000)
                expect
                (fp #b0 #b10111011 #b11000100011100011010110)))
; expect = 10.0

(assert (= expect result))

(check-sat)
(exit)
