(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111001010000000 #b10100100111001)
                arg1
                (fp #b1 #b011111111111111 #b01101011001011)))
(assert (fp.leq (fp #b1 #b011111111111111 #b01101011001011)
                arg1
                (fp #b0 #b100110101111101 #b11001001101101)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b01 #b1)))
(assert (fp.leq (fp #b1 #b01 #b1)
                expect
                (fp #b1 #b00 #b1)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
