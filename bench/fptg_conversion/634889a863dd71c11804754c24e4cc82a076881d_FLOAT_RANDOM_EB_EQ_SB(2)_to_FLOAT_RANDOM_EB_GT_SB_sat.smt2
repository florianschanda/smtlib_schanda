; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011011010 #b01110100001)
                arg1
                (fp #b0 #b011111111111 #b11001111101)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001111101)
                arg1
                (fp #b0 #b111111101111 #b00111100011)))

(declare-const result (_ FloatingPoint 6 3))
(assert (= result ((_ to_fp 6 3) rm arg1)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b000101 #b00)
                expect
                (fp #b0 #b100000 #b00)))
(assert (fp.leq (fp #b0 #b100000 #b00)
                expect
                (fp #b0 #b101010 #b10)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
