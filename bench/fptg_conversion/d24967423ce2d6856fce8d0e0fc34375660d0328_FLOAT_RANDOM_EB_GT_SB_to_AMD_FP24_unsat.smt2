(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b100 #b1)))
(assert (fp.leq (fp #b1 #b100 #b1)
                arg1
                (fp #b0 #b111 #b0)))
; arg1 = -3.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111011 #b1011000010010001)
                expect
                (fp #b1 #b1000000 #b1000000000000000)))
(assert (fp.leq (fp #b1 #b1000000 #b1000000000000000)
                expect
                (fp #b1 #b0101011 #b1000100111100110)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
