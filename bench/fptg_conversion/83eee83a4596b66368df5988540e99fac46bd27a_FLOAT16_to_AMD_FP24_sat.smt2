(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b0001001111)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11110 #b1001101111)))
; arg1 = 551.5

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001111 #b1100110010100101)
                expect
                (fp #b0 #b1001000 #b0001001111000000)))
(assert (fp.leq (fp #b0 #b1001000 #b0001001111000000)
                expect
                (fp #b0 #b1001001 #b1111111111101011)))
; expect = 551.5

(assert (= expect result))

(check-sat)
(exit)
