(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0010)
                arg1
                (fp #b0 #b010 #b1010)))
(assert (fp.leq (fp #b0 #b010 #b1010)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 0.8125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01011110 #b0001110111)
                expect
                (fp #b0 #b01111110 #b1010000000)))
(assert (fp.leq (fp #b0 #b01111110 #b1010000000)
                expect
                (fp #b0 #b10110111 #b0001101111)))
; expect = 0.8125

(assert (= expect result))

(check-sat)
(exit)
