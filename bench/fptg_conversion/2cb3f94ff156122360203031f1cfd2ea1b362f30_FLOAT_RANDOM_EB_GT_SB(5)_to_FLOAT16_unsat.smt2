(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b011010101101 #b0100111100)
                arg1
                (fp #b1 #b011010100111 #b1110011110)))
