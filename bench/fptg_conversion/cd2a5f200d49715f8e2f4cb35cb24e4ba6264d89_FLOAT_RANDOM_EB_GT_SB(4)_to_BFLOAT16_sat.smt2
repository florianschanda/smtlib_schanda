(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b10)
                arg1
                (fp #b0 #b00111 #b00)))
(assert (fp.leq (fp #b0 #b00111 #b00)
                arg1
                (fp #b0 #b10001 #b01)))
; arg1 = 0.00390625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b1111000)
                expect
                (fp #b0 #b01110111 #b0000000)))
(assert (fp.leq (fp #b0 #b01110111 #b0000000)
                expect
                (fp #b0 #b11100001 #b0110101)))
; expect = 0.00390625

(assert (= expect result))

(check-sat)
(exit)
