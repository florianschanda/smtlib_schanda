; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11011100111001 #b110)
                arg1
                (fp #b0 #b01111111111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111111111 #b101)
                arg1
                (fp #b0 #b11011111110010 #b000)))

(declare-const result (_ FloatingPoint 5 2))
(assert (= result ((_ to_fp 5 2) rm arg1)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b00100 #b0)
                expect
                (fp #b0 #b10000 #b0)))
(assert (fp.leq (fp #b0 #b10000 #b0)
                expect
                (fp #b0 #b11001 #b1)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
