                expect
                (fp #b0 #b0111000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111000 #b0000000000000000)
                expect
                (fp #b0 #b0111101 #b0001010000001100)))
; expect = 0.0078125

(assert (not (= expect result)))

