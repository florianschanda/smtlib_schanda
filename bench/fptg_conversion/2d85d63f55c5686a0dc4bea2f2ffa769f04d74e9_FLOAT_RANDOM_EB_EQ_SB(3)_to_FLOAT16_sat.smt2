(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001010000001100 #b001111100110110)
                arg1
                (fp #b0 #b0111111111111111 #b110010010101111)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b110010010101111)
                arg1
                (fp #b0 #b1101110101111010 #b101100110001010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00001 #b1000000100)
                expect
                (fp #b0 #b01111 #b1100100110)))
(assert (fp.leq (fp #b0 #b01111 #b1100100110)
                expect
                (fp #b0 #b10001 #b1011011100)))
; expect = 1.787109375

(assert (= expect result))

(check-sat)
(exit)
