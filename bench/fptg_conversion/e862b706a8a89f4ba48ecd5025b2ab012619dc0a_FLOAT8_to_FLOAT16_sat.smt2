(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1001)
                arg1
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = 3.875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01011 #b0111001101)
                expect
                (fp #b0 #b10000 #b1111000000)))
(assert (fp.leq (fp #b0 #b10000 #b1111000000)
                expect
                (fp #b0 #b10001 #b1011110101)))
; expect = 3.875

(assert (= expect result))

(check-sat)
(exit)
