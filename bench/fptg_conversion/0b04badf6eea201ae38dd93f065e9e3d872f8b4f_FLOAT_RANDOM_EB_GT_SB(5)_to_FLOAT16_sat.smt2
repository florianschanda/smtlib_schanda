(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01101000111 #b0)
                arg1
                (fp #b0 #b00010001001 #b1)))
(assert (fp.leq (fp #b0 #b00010001001 #b1)
                arg1
                (fp #b0 #b00011001011 #b1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b0101111110)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01101 #b0010000011)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
