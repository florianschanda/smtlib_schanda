(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b0101100110110000)
                expect
                (fp #b0 #b1000110 #b1111111111000000)))
(assert (fp.leq (fp #b0 #b1000110 #b1111111111000000)
                expect
                (fp #b0 #b1110000 #b0110100101010010)))
; expect = 255.875

(assert (not (= expect result)))

