(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b1 #b0110 #b101)))
(assert (fp.leq (fp #b1 #b0110 #b101)
                arg1
                (fp #b1 #b0011 #b011)))
; arg1 = -0.8125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0110110)
                expect
                (fp #b1 #b01111110 #b1010000)))
(assert (fp.leq (fp #b1 #b01111110 #b1010000)
                expect
                (fp #b0 #b01101001 #b1000000)))
; expect = -0.8125

(assert (= expect result))

(check-sat)
(exit)
