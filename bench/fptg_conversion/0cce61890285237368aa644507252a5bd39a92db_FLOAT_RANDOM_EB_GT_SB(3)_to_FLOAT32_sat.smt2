(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0110101 #b010)
                arg1
                (fp #b0 #b1000100 #b111)))
(assert (fp.leq (fp #b0 #b1000100 #b111)
                arg1
                (fp #b0 #b1110011 #b010)))
; arg1 = 60.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111001 #b01001110010100101101100)
                expect
                (fp #b0 #b10000100 #b11100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000100 #b11100000000000000000000)
                expect
                (fp #b0 #b11000111 #b01011110011101110110110)))
; expect = 60.0

(assert (= expect result))

(check-sat)
(exit)
