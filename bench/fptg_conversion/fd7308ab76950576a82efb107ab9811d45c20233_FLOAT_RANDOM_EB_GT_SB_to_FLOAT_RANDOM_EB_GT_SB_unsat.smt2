(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011011 #b001)
                arg1
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg1
                (fp #b0 #b1100010 #b011)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 9 8))
(assert (= result ((_ to_fp 9 8) rm arg1)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110010101 #b1100100)
                expect
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                expect
                (fp #b0 #b101110000 #b0101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
