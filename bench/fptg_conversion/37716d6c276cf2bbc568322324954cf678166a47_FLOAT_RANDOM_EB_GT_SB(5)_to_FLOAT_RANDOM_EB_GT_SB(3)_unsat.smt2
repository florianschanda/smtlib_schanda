(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10110000 #b0)
                expect
                (fp #b1 #b10000000 #b0)))
(assert (fp.leq (fp #b1 #b10000000 #b0)
                expect
                (fp #b0 #b00000101 #b1)))
; expect = -2.0

(assert (not (= expect result)))

