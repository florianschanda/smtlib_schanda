(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000000 #b0111100)
                expect
                (fp #b0 #b11110010 #b0110111)))
(assert (fp.leq (fp #b0 #b11110010 #b0110111)
                expect
                (fp #b0 #b11110010 #b1101011)))
; expect = 59386895319492091001317551765454848.0

(assert (= expect result))

