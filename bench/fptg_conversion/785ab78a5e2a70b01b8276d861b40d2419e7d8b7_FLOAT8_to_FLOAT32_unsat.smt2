(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b011 #b0100)))
(assert (fp.leq (fp #b0 #b011 #b0100)
                arg1
                (fp #b0 #b100 #b0111)))
; arg1 = 1.25

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110111 #b01111110110011010111111)
                expect
                (fp #b0 #b01111111 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b01000000000000000000000)
                expect
                (fp #b0 #b10111001 #b11000010001001010100001)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
