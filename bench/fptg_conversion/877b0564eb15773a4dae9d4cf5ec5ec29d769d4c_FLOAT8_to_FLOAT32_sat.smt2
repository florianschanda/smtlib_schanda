(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b110 #b0010)))
(assert (fp.leq (fp #b1 #b110 #b0010)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -9.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b01111110000000011010010)
                expect
                (fp #b1 #b10000010 #b00100000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b00100000000000000000000)
                expect
                (fp #b0 #b01000111 #b01001000100010000110101)))
; expect = -9.0

(assert (= expect result))

(check-sat)
(exit)
