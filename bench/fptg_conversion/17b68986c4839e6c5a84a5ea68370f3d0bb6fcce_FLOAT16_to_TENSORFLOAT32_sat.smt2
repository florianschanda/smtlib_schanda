; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0110100001)
                arg1
                (fp #b1 #b01111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111 #b0010001010)
                arg1
                (fp #b0 #b01000 #b0111111001)))
; arg1 = -1.134765625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010000 #b1000011110)
                expect
                (fp #b1 #b01111111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111111 #b0010001010)
                expect
                (fp #b0 #b11001101 #b0011110011)))
; expect = -1.134765625

(assert (= expect result))

(check-sat)
(exit)
