(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 13))
(assert (fp.leq (fp #b1 #b10001001100010111 #b001100010010)
                arg1
                (fp #b0 #b01111111111111111 #b110101101110)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b110101101110)
                arg1
                (fp #b0 #b11011100110011101 #b111011101010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0111)
                expect
                (fp #b0 #b011 #b1110)))
(assert (fp.leq (fp #b0 #b011 #b1110)
                expect
                (fp #b0 #b110 #b1011)))
; expect = 1.875

(assert (= expect result))

