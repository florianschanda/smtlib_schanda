(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010011 #b00000100110101010100000)
                arg1
                (fp #b0 #b10010110 #b11001001000000101010001)))
(assert (fp.leq (fp #b0 #b10010110 #b11001001000000101010001)
                arg1
                (fp #b0 #b10011011 #b01110101101001010001100)))
; arg1 = 14975313.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001100 #b0111000011)
                expect
                (fp #b0 #b10010110 #b1100100101)))
(assert (fp.leq (fp #b0 #b10010110 #b1100100101)
                expect
                (fp #b0 #b11110001 #b1110111011)))
; expect = 14983168.0

(assert (not (= expect result)))

(check-sat)
(exit)
