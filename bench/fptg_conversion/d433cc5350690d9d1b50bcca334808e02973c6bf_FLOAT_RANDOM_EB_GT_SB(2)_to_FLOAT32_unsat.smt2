(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111101001 #b111)
                arg1
                (fp #b1 #b011111111 #b001)))
(assert (fp.leq (fp #b1 #b011111111 #b001)
                arg1
                (fp #b1 #b010100000 #b110)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100001 #b10100101100100100101000)
                expect
                (fp #b1 #b01111111 #b00100000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00100000000000000000000)
                expect
                (fp #b0 #b00101010 #b00000011101100011110000)))
; expect = -1.125

(assert (not (= expect result)))

(check-sat)
(exit)
