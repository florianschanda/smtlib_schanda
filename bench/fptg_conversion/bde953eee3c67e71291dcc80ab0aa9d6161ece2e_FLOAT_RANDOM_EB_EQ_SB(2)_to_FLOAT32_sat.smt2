(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b000)
                arg1
                (fp #b0 #b1011 #b101)))
(assert (fp.leq (fp #b0 #b1011 #b101)
                arg1
                (fp #b0 #b1100 #b100)))
; arg1 = 26.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110101 #b10101000111110010010010)
                expect
                (fp #b0 #b10000011 #b10100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000011 #b10100000000000000000000)
                expect
                (fp #b0 #b10110100 #b00111010011100001000101)))
; expect = 26.0

(assert (= expect result))

(check-sat)
(exit)
