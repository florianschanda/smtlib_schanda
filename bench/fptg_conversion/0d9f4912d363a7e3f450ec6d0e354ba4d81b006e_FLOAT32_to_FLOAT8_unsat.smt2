(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11111001010110101100000)
                arg1
                (fp #b0 #b01111111 #b00010001000010101011100)))
(assert (fp.leq (fp #b0 #b01111111 #b00010001000010101011100)
                arg1
                (fp #b0 #b11010000 #b00110101100001110001101)))
; arg1 = 1.066569805145263671875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1010)
                expect
                (fp #b0 #b011 #b0010)))
(assert (fp.leq (fp #b0 #b011 #b0010)
                expect
                (fp #b0 #b011 #b1001)))
; expect = 1.125

(assert (not (= expect result)))

(check-sat)
(exit)
