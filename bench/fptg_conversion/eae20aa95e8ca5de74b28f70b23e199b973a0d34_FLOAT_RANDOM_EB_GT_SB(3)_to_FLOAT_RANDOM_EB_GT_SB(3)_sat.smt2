; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10011101111 #b11110010)
                arg1
                (fp #b0 #b00000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b01000000)
                arg1
                (fp #b0 #b11110010001 #b00110100)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result ((_ to_fp 9 4) rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111011100 #b100)
                expect
                (fp #b0 #b000000000 #b001)))
(assert (fp.leq (fp #b0 #b000000000 #b001)
                expect
                (fp #b0 #b100010100 #b011)))

(assert (= expect result))

(check-sat)
(exit)
