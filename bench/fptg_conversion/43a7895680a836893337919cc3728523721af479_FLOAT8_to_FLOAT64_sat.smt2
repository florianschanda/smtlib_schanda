                expect
                (fp #b0 #b10000000010 #b0010000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000010 #b0010000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11001001011 #b0010110111000100011010110110100001011010111110101010)))

