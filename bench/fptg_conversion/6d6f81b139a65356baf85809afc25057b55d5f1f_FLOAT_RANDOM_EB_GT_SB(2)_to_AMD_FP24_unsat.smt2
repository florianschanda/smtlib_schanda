(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 13))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01011110111001000 #b000010011000)
                arg1
                (fp #b1 #b00000000000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000000000000)
                arg1
                (fp #b0 #b10010101011011000 #b001010001011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1011010 #b0011001110110100)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b1111011 #b1010111111100010)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
