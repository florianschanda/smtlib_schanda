(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0010101101011011 #b00011110000000)
                arg1
                (fp #b1 #b0000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01000000000000)
                arg1
                (fp #b0 #b0100010110110110 #b01011100100110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1100)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b011 #b0101)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
