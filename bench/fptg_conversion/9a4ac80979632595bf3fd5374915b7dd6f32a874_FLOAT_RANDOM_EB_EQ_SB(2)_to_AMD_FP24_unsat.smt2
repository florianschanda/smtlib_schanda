; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg1
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                arg1
                (fp #b0 #b0000 #b101)))
; arg1 = -0.001953125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011011 #b1000111100110011)
                expect
                (fp #b1 #b0110110 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0110110 #b0000000000000000)
                expect
                (fp #b0 #b1101000 #b1110001001111011)))
; expect = -0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
