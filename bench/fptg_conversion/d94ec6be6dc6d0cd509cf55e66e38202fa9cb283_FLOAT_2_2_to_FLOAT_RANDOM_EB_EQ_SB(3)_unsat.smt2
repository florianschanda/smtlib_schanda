; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b0 #b00 #b0)
                arg1
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                arg1
                (fp #b0 #b11 #b0)))
; arg1 = 2.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0111001100 #b100101110)
                expect
                (fp #b0 #b1000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000000 #b000000000)
                expect
                (fp #b0 #b1000000101 #b000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
