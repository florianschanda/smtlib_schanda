(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00111110 #b1010101100)
                arg1
                (fp #b0 #b11100010 #b1100010110)))
(assert (fp.leq (fp #b0 #b11100010 #b1100010110)
                arg1
                (fp #b0 #b11110011 #b1001110100)))
; arg1 = 1122811615631839909333505671168.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
