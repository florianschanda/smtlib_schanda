(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b0 #b0110 #b101)))
; arg1 = -1.625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100100 #b00000111001011001001011)
                expect
                (fp #b1 #b01111111 #b10100000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b10100000000000000000000)
                expect
                (fp #b1 #b00110000 #b01001101100001101010111)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
