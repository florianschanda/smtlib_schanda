(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 25))
(assert (fp.leq (fp #b1 #b101000110 #b011001010010101011011101)
                arg1
                (fp #b1 #b100001011 #b101001010111010110101101)))
(assert (fp.leq (fp #b1 #b100001011 #b101001010111010110101101)
                arg1
                (fp #b0 #b100010100 #b111011011100110000001100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b1010010101110000)
                expect
                (fp #b1 #b1001011 #b1010010101110110)))
(assert (fp.leq (fp #b1 #b1001011 #b1010010101110110)
                expect
                (fp #b0 #b1010100 #b1100111110101010)))
; expect = -6743.375

(assert (= expect result))

(check-sat)
(exit)
