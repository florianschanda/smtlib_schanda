(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010111 #b0001100100110001)
                arg1
                (fp #b0 #b0101011 #b1100000010000001)))
(assert (fp.leq (fp #b0 #b0101011 #b1100000010000001)
                arg1
                (fp #b0 #b1100010 #b1011101000011101)))
; arg1 = 0.000001670807250775396823883056640625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00100 #b1110101011)
                expect
                (fp #b0 #b00000 #b0000011101)))
(assert (fp.leq (fp #b0 #b00000 #b0000011101)
                expect
                (fp #b0 #b00101 #b1001010101)))
; expect = 0.000001728534698486328125

(assert (= expect result))

(check-sat)
(exit)
