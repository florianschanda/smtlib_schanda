; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011001 #b110101)
                arg1
                (fp #b1 #b1000101 #b011101)))
(assert (fp.leq (fp #b1 #b1000101 #b011101)
                arg1
                (fp #b1 #b0001111 #b110011)))
; arg1 = -93.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111010 #b10011001001111000100101)
                expect
                (fp #b1 #b10000101 #b01110100000000000000000)))
(assert (fp.leq (fp #b1 #b10000101 #b01110100000000000000000)
                expect
                (fp #b0 #b10100010 #b01110101110000010000001)))
; expect = -93.0

(assert (= expect result))

(check-sat)
(exit)
