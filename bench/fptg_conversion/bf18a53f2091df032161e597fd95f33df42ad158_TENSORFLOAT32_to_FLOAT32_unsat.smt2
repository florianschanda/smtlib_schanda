; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000111 #b1010101001)
                arg1
                (fp #b0 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0000000000)
                arg1
                (fp #b0 #b10111010 #b1010011010)))
; arg1 = 2048.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111111 #b10101000110110111010110)
                expect
                (fp #b0 #b10001010 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b00000000000000000000000)
                expect
                (fp #b0 #b10100111 #b00100000101110010111001)))
; expect = 2048.0

(assert (not (= expect result)))

(check-sat)
(exit)
