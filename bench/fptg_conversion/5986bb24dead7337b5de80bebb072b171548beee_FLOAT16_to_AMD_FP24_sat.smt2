; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1001011000)
                arg1
                (fp #b0 #b11100 #b1101000111)))
(assert (fp.leq (fp #b0 #b11100 #b1101000111)
                arg1
                (fp #b0 #b11100 #b1101010101)))
; arg1 = 14904.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011111 #b0101000101100011)
                expect
                (fp #b0 #b1001100 #b1101000111000000)))
(assert (fp.leq (fp #b0 #b1001100 #b1101000111000000)
                expect
                (fp #b0 #b1110110 #b1011001010111011)))
; expect = 14904.0

(assert (= expect result))

(check-sat)
(exit)
