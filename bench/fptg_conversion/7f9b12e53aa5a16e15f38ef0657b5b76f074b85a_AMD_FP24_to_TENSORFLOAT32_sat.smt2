; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b1110111111110011)
                arg1
                (fp #b1 #b1111001 #b1011010110111001)))
(assert (fp.leq (fp #b1 #b1111001 #b1011010110111001)
                arg1
                (fp #b0 #b1110101 #b0101100111011010)))
; arg1 = -492831897894780928.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110001 #b1101101010)
                expect
                (fp #b1 #b10111001 #b1011010111)))
(assert (fp.leq (fp #b1 #b10111001 #b1011010111)
                expect
                (fp #b0 #b00111101 #b0011101101)))
; expect = -492862684220358656.0

(assert (= expect result))

(check-sat)
(exit)
