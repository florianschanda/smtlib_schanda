; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1101010110)
                arg1
                (fp #b1 #b00010 #b1001100111)))
(assert (fp.leq (fp #b1 #b00010 #b1001100111)
                arg1
                (fp #b0 #b11110 #b0011110100)))
; arg1 = -0.00019538402557373046875

(declare-const result (_ FloatingPoint 10 9))
(assert (= result ((_ to_fp 10 9) rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1100110011 #b10101001)
                expect
                (fp #b1 #b0111110010 #b10011010)))
(assert (fp.leq (fp #b1 #b0111110010 #b10011010)
                expect
                (fp #b1 #b0011100000 #b01011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
