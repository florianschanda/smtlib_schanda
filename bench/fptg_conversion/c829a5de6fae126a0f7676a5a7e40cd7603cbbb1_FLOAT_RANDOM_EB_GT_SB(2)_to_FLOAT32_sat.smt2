(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011 #b1)
                arg1
                (fp #b0 #b000 #b0)))
(assert (fp.leq (fp #b0 #b000 #b0)
                arg1
                (fp #b0 #b111 #b0)))
; arg1 = 0.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010100 #b01010101110101100001111)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b01010101 #b01100000100010000010011)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
