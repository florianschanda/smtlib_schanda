(assert (fp.leq (fp #b1 #b10111 #b0100001000)
                expect
                (fp #b1 #b01111 #b1100100000)))
(assert (fp.leq (fp #b1 #b01111 #b1100100000)
                expect
                (fp #b0 #b01110 #b0101110101)))
; expect = -1.78125

(assert (= expect result))

