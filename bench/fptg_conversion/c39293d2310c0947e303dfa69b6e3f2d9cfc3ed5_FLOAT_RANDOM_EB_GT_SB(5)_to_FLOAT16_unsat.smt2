; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b01)
                arg1
                (fp #b1 #b1001 #b00)))
(assert (fp.leq (fp #b1 #b1001 #b00)
                arg1
                (fp #b0 #b0101 #b11)))
; arg1 = -4.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b1110101101)
                expect
                (fp #b1 #b10001 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001 #b0000000000)
                expect
                (fp #b0 #b10110 #b1111101010)))
; expect = -4.0

(assert (not (= expect result)))

(check-sat)
(exit)
