(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011100111 #b011)
                arg1
                (fp #b1 #b000000000 #b100)))
(assert (fp.leq (fp #b1 #b000000000 #b100)
                arg1
                (fp #b0 #b111101010 #b011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b1001011000)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b01110 #b0100011101)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
