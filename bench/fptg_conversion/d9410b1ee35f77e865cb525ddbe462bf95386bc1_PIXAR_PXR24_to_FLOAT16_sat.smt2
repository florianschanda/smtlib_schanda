(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: PIXAR_PXR24
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000001 #b110100101100011)
                arg1
                (fp #b0 #b10001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b10001110 #b100100011101100)
                arg1
                (fp #b0 #b11110000 #b110101110000011)))
; arg1 = 51436.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b0000111001)
                expect
                (fp #b0 #b11110 #b1001001000)))
(assert (fp.leq (fp #b0 #b11110 #b1001001000)
                expect
                (fp #b0 #b11110 #b1110100011)))
; expect = 51456.0

(assert (= expect result))

(check-sat)
(exit)
