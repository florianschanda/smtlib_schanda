; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b00000)
                arg1
                (fp #b0 #b100100 #b10000)))
(assert (fp.leq (fp #b0 #b100100 #b10000)
                arg1
                (fp #b0 #b111100 #b01111)))
; arg1 = 48.0

(declare-const result (_ FloatingPoint 16 5))
(assert (= result ((_ to_fp 16 5) rm arg1)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0110101010110101 #b1001)
                expect
                (fp #b0 #b1000000000000100 #b1000)))
(assert (fp.leq (fp #b0 #b1000000000000100 #b1000)
                expect
                (fp #b0 #b1100101001101010 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
