(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010011 #b00000100110101010100000)
                arg1
                (fp #b0 #b10010110 #b11001001000000101010001)))
(assert (fp.leq (fp #b0 #b10010110 #b11001001000000101010001)
                arg1
                (fp #b0 #b10011011 #b01110101101001010001100)))
; arg1 = 14975313.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000100 #b1100011010100000)
                expect
                (fp #b0 #b1010110 #b1100100100000011)))
(assert (fp.leq (fp #b0 #b1010110 #b1100100100000011)
                expect
                (fp #b0 #b1111001 #b0110100101101011)))
; expect = 14975360.0

(assert (= expect result))

(check-sat)
(exit)
