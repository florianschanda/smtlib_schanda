; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: +LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0011001011)
                arg1
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11111 #b0000000000)))
; arg1 = 65504.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1000100 #b0011001101111011)
                expect
                (fp #b0 #b1001110 #b1111111111000000)))
(assert (fp.leq (fp #b0 #b1001110 #b1111111111000000)
                expect
                (fp #b0 #b1101000 #b0100011110101101)))
; expect = 65504.0

(assert (not (= expect result)))

(check-sat)
(exit)
