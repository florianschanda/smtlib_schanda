(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101001 #b0011101100)
                expect
                (fp #b1 #b10110011 #b0100010010)))
(assert (fp.leq (fp #b1 #b10110011 #b0100010010)
                expect
