; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010000 #b10011110000110111000001)
                arg1
                (fp #b1 #b00000000 #b11111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000 #b11111111111111111111111)
                arg1
                (fp #b0 #b01110000 #b11010010000100010101111)))
; arg1 = -0.00000000000000000000000000000000000001175494210692441075487029444849287348827052428745893333857174530571588870475618904265502351336181163787841796875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001101 #b110010011011000)
                expect
                (fp #b1 #b00000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b000000000000000)
                expect
                (fp #b0 #b01100111 #b001111010100111)))
; expect = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(assert (= expect result))

(check-sat)
(exit)
