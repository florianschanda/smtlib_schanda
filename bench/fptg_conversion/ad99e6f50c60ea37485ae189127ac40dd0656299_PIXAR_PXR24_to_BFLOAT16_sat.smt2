; Format from: PIXAR_PXR24
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100001 #b111110101001011)
                arg1
                (fp #b1 #b01111111 #b011011010011101)))
(assert (fp.leq (fp #b1 #b01111111 #b011011010011101)
                arg1
                (fp #b0 #b00111001 #b010000000110100)))
; arg1 = -1.426666259765625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110011 #b0000010)
                expect
                (fp #b1 #b01111111 #b0110111)))
(assert (fp.leq (fp #b1 #b01111111 #b0110111)
                expect
                (fp #b1 #b00011011 #b1110111)))
; expect = -1.4296875

(assert (= expect result))

(check-sat)
(exit)
