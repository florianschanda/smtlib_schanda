(declare-const result (_ FloatingPoint 15 14))
(assert (= result ((_ to_fp 15 14) rm arg1)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b111111101001101 #b0101100110101)
                expect
                (fp #b1 #b011100000000000 #b1011000100000)))
(assert (fp.leq (fp #b1 #b011100000000000 #b1011000100000)
                expect
                (fp #b0 #b100111010010110 #b0110100010101)))

(assert (not (= expect result)))

(check-sat)
