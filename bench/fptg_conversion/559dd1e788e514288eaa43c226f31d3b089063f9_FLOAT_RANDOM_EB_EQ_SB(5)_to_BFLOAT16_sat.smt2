; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01100100111101 #b0101010110010)
                arg1
                (fp #b0 #b01111111111111 #b0111001100001)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0111001100001)
                arg1
                (fp #b0 #b10011010001111 #b0111101100110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01100001 #b0000010)
                expect
                (fp #b0 #b01111111 #b0111010)))
(assert (fp.leq (fp #b0 #b01111111 #b0111010)
                expect
                (fp #b0 #b10011000 #b0001100)))
; expect = 1.453125

(assert (= expect result))

(check-sat)
(exit)
