; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0111)
                arg1
                (fp #b0 #b010 #b0000)))
(assert (fp.leq (fp #b0 #b010 #b0000)
                arg1
                (fp #b0 #b100 #b1011)))
; arg1 = 0.5

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011100 #b0111111101001100)
                expect
                (fp #b0 #b0111110 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111110 #b0000000000000000)
                expect
                (fp #b0 #b1000111 #b0100110001100111)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
(exit)
