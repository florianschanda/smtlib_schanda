; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10110011100 #b00011)
                arg1
                (fp #b1 #b10000000011 #b10110)))
(assert (fp.leq (fp #b1 #b10000000011 #b10110)
                arg1
                (fp #b0 #b00101001000 #b01101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101001 #b1001111)
                expect
                (fp #b1 #b10000011 #b1011000)))
(assert (fp.leq (fp #b1 #b10000011 #b1011000)
                expect
                (fp #b0 #b01100000 #b1001111)))
; expect = -27.0

(assert (= expect result))

(check-sat)
(exit)
