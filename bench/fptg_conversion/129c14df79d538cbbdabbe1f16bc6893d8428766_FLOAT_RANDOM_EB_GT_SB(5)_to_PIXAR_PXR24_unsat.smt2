(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1110000001101110 #b0011)
                arg1
                (fp #b1 #b1001100010100000 #b1010)))
(assert (fp.leq (fp #b1 #b1001100010100000 #b1010)
                arg1
                (fp #b1 #b0110100000001000 #b0000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
