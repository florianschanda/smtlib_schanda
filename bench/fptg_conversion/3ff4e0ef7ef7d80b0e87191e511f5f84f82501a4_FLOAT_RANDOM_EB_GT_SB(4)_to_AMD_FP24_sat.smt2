(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101101 #b0010001010011111)
                expect
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                expect
                (fp #b0 #b0111011 #b1101010000111100)))
; expect = 0.0000000004656612873077392578125

(assert (= expect result))

(check-sat)
