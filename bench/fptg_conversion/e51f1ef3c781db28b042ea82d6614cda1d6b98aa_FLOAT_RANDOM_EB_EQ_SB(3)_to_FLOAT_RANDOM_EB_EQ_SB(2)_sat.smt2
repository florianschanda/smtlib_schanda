; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                arg1
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg1
                (fp #b0 #b101 #b11)))
; arg1 = -0.0625

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100010111101101 #b11111111000001)
                expect
                (fp #b1 #b011111111111011 #b00000000000000)))
(assert (fp.leq (fp #b1 #b011111111111011 #b00000000000000)
                expect
                (fp #b0 #b000101000011101 #b11110111000001)))

(assert (= expect result))

(check-sat)
(exit)
