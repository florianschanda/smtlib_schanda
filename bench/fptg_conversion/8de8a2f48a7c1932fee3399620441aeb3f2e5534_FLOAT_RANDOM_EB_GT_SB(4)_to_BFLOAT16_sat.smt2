; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b1 #b11111001110110001 #b1111000100)
                arg1
                (fp #b1 #b01111111111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0011010000)
                arg1
                (fp #b0 #b10000011011101011 #b1010111100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000100 #b0011011)
                expect
                (fp #b1 #b01111111 #b0011010)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010)
                expect
                (fp #b0 #b11101101 #b1010101)))
; expect = -1.203125

(assert (= expect result))

(check-sat)
