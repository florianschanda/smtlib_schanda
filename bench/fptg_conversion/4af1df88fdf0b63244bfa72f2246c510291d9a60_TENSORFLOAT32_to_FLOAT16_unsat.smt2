; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00000100 #b1011101111)
                arg1
                (fp #b0 #b00000000 #b0100101110)))
