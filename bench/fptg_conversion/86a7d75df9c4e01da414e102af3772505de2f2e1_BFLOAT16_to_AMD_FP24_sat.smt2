(assert (fp.leq (fp #b1 #b1000100 #b0100000010101100)
                expect
                (fp #b1 #b0111111 #b0001001000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0001001000000000)
                expect
                (fp #b0 #b0100000 #b0111101010001000)))
; expect = -1.0703125

(assert (= expect result))

(check-sat)
