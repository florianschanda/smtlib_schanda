; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00000101111111011001110)
                arg1
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b0 #b11100000 #b10001010101011001011001)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000010100111111 #b11000000011110)
                expect
                (fp #b0 #b011111111111111 #b00000000000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b00000000000000)
                expect
                (fp #b0 #b101000010111001 #b00010111000101)))

(assert (= expect result))

(check-sat)
(exit)
