(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b100 #b0)))
(assert (fp.leq (fp #b1 #b100 #b0)
                arg1
                (fp #b0 #b010 #b0)))
; arg1 = -2.0

(declare-const result (_ FloatingPoint 10 8))
(assert (= result ((_ to_fp 10 8) rm arg1)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010111000 #b0010110)
                expect
                (fp #b1 #b1000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000000 #b0000000)
                expect
                (fp #b0 #b1111011010 #b0011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
