(assert (fp.leq (fp #b1 #b101100111101 #b00110001000)
                expect
                (fp #b1 #b011111111111 #b10100000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b10100000000)
                expect
                (fp #b0 #b011100010011 #b10111101101)))

(assert (not (= expect result)))

(check-sat)
