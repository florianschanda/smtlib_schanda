; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001100010 #b000111101)
                arg1
                (fp #b1 #b0000000000 #b001010110)))
(assert (fp.leq (fp #b1 #b0000000000 #b001010110)
                arg1
                (fp #b0 #b0001101100 #b001010000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b0100011000)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b11010 #b1001110111)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
