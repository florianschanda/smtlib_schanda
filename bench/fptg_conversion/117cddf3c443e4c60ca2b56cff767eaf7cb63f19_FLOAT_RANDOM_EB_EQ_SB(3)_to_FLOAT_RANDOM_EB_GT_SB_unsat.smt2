; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001001 #b01000)
                arg1
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg1
                (fp #b0 #b111101 #b11111)))
; arg1 = 1073741824.0

(declare-const result (_ FloatingPoint 12 7))
(assert (= result ((_ to_fp 12 7) rm arg1)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b011101101011 #b110001)
                expect
                (fp #b0 #b100000011101 #b000000)))
(assert (fp.leq (fp #b0 #b100000011101 #b000000)
                expect
                (fp #b0 #b101001111000 #b001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
