(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1010 #b010)
                arg1
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                arg1
                (fp #b0 #b1000 #b001)))
; arg1 = -0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result ((_ to_fp 6 3) rm arg1)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111011 #b01)
                expect
                (fp #b1 #b000000 #b00)))
(assert (fp.leq (fp #b1 #b000000 #b00)
                expect
                (fp #b0 #b100000 #b11)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
