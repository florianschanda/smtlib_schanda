(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RCP_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111110 #b1)
                arg1
                (fp #b1 #b111110 #b0)))
(assert (fp.leq (fp #b1 #b111110 #b0)
                arg1
                (fp #b0 #b011000 #b0)))
; arg1 = -2147483648.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100000 #b11001011011000010110001)
                expect
                (fp #b1 #b10011110 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10011110 #b00000000000000000000000)
                expect
                (fp #b0 #b11001011 #b10101000001101111110100)))
; expect = -2147483648.0

(assert (not (= expect result)))

(check-sat)
(exit)
