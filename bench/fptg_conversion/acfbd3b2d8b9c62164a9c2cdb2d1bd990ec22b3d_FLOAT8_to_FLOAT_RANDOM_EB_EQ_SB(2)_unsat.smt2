; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1111)
                arg1
                (fp #b1 #b010 #b1000)))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b0 #b001 #b0110)))
; arg1 = -0.75

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011101100 #b0111100110)
                expect
                (fp #b1 #b01111111110 #b1000000000)))
(assert (fp.leq (fp #b1 #b01111111110 #b1000000000)
                expect
                (fp #b0 #b00111100010 #b0010100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
