(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1001011101)
                arg1
                (fp #b0 #b00000 #b0111111111)))
(assert (fp.leq (fp #b0 #b00000 #b0111111111)
                arg1
                (fp #b0 #b11000 #b1010101100)))
; arg1 = 0.000030457973480224609375

(declare-const result (_ FloatingPoint 10 3))
(assert (= result ((_ to_fp 10 3) rm arg1)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110001100 #b11)
                expect
                (fp #b0 #b0111110000 #b00)))
(assert (fp.leq (fp #b0 #b0111110000 #b00)
                expect
                (fp #b0 #b1101111111 #b11)))

(assert (= expect result))

(check-sat)
(exit)
