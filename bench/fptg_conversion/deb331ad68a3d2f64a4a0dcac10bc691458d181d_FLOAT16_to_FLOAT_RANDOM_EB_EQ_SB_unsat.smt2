(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111101100)
                arg1
                (fp #b1 #b11000 #b1100000110)))
(assert (fp.leq (fp #b1 #b11000 #b1100000110)
                arg1
                (fp #b0 #b10000 #b0000010110)))
; arg1 = -899.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b1000)
                expect
                (fp #b1 #b11000 #b1101)))
(assert (fp.leq (fp #b1 #b11000 #b1101)
                expect
                (fp #b0 #b00001 #b1010)))
; expect = -928.0

(assert (not (= expect result)))

(check-sat)
(exit)
