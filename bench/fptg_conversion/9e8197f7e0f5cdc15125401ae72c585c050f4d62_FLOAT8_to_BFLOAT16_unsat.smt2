(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1110)))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b010 #b0101)))
; arg1 = -15.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b0101100)
                expect
                (fp #b1 #b10000010 #b1110000)))
(assert (fp.leq (fp #b1 #b10000010 #b1110000)
                expect
                (fp #b1 #b00011001 #b0010000)))
; expect = -15.0

(assert (not (= expect result)))

(check-sat)
(exit)
