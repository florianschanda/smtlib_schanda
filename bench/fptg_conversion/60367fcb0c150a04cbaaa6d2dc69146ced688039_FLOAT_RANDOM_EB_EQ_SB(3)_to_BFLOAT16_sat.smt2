(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100011000 #b10011001)
                arg1
                (fp #b1 #b011111111 #b01111011)))
(assert (fp.leq (fp #b1 #b011111111 #b01111011)
                arg1
                (fp #b0 #b100100001 #b01011010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000010 #b0111010)
                expect
                (fp #b1 #b01111111 #b0111110)))
(assert (fp.leq (fp #b1 #b01111111 #b0111110)
                expect
                (fp #b1 #b01001001 #b1111111)))
; expect = -1.484375

(assert (= expect result))

(check-sat)
(exit)
