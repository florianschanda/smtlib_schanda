(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1110001101011000)
                arg1
                (fp #b0 #b1000110 #b1011110001110100)))
(assert (fp.leq (fp #b0 #b1000110 #b1011110001110100)
                arg1
                (fp #b0 #b1110101 #b1001001101100100)))
; arg1 = 222.2265625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10011 #b0011010110)
                expect
                (fp #b0 #b10110 #b1011110010)))
(assert (fp.leq (fp #b0 #b10110 #b1011110010)
                expect
                (fp #b0 #b10111 #b0111100100)))
; expect = 222.25

(assert (= expect result))

(check-sat)
(exit)
