(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101111101011 #b11110010100)
                arg1
                (fp #b0 #b000000000000 #b11110111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b11110111111)
                arg1
                (fp #b0 #b101110010011 #b00011011011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1001)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b001 #b1011)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
