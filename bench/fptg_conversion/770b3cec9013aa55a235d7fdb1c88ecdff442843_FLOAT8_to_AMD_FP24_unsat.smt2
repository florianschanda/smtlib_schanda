(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b0110000110100101)
                expect
                (fp #b1 #b0111111 #b0011000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0011000000000000)
                expect
                (fp #b0 #b1011010 #b0100101111010111)))
; expect = -1.1875

(assert (not (= expect result)))

(check-sat)
