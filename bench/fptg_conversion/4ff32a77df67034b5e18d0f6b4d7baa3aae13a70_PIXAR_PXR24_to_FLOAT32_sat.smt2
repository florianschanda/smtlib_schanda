; Format from: PIXAR_PXR24
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011111 #b011000100100100)
                arg1
                (fp #b0 #b10001101 #b111010100010010)))
(assert (fp.leq (fp #b0 #b10001101 #b111010100010010)
                arg1
                (fp #b0 #b11110011 #b101000101010011)))
; arg1 = 31369.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01100001 #b11001000010000010011101)
                expect
                (fp #b0 #b10001101 #b11101010001001000000000)))
(assert (fp.leq (fp #b0 #b10001101 #b11101010001001000000000)
                expect
                (fp #b0 #b10110101 #b11111010101011011001101)))
; expect = 31369.0

(assert (= expect result))

(check-sat)
(exit)
