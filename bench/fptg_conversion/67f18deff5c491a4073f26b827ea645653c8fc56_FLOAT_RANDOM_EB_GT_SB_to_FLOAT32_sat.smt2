(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b001 #b0)
                arg1
                (fp #b0 #b100 #b0)))
(assert (fp.leq (fp #b0 #b100 #b0)
                arg1
                (fp #b0 #b100 #b1)))
; arg1 = 2.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001011 #b11111001110101111010010)
                expect
                (fp #b0 #b10000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10000110 #b01010110011110001110110)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
