; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011001011 #b10)
                arg1
                (fp #b1 #b0111111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111111 #b11)
                arg1
                (fp #b1 #b0110100011 #b11)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b1)
                expect
                (fp #b1 #b1000 #b0)))
(assert (fp.leq (fp #b1 #b1000 #b0)
                expect
                (fp #b0 #b0111 #b1)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
