; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000000 #b0001011110100011)
                arg1
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
                arg1
                (fp #b0 #b1111010 #b1000011100010000)))
; arg1 = 1.02752685546875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01011000 #b0110010)
                expect
                (fp #b0 #b01111111 #b0000100)))
(assert (fp.leq (fp #b0 #b01111111 #b0000100)
                expect
                (fp #b0 #b10001010 #b1101010)))
; expect = 1.03125

(assert (not (= expect result)))

(check-sat)
(exit)
