(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11000 #b0)
                arg1
                (fp #b1 #b10011 #b0)))
(assert (fp.leq (fp #b1 #b10011 #b0)
                arg1
                (fp #b0 #b10010 #b0)))
; arg1 = -16.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010111 #b11011101011001010011111)
                expect
                (fp #b1 #b10000011 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000011 #b00000000000000000000000)
                expect
                (fp #b1 #b01001100 #b11000110000110010011000)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
(exit)
