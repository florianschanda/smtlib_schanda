(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b01001 #b0)
                expect
                (fp #b0 #b00000 #b1)))
(assert (fp.leq (fp #b0 #b00000 #b1)
                expect
                (fp #b0 #b10111 #b1)))
; expect = 0.000030517578125

(assert (= expect result))

