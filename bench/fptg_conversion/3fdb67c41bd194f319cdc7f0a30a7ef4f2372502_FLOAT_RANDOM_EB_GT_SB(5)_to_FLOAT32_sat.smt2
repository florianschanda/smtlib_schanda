; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110010 #b01)
                arg1
                (fp #b1 #b000000 #b01)))
(assert (fp.leq (fp #b1 #b000000 #b01)
                arg1
                (fp #b0 #b010111 #b11)))
; arg1 = -0.00000000023283064365386962890625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000000 #b10000100000100110110111)
                expect
                (fp #b1 #b01011111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01011111 #b00000000000000000000000)
                expect
                (fp #b1 #b00101011 #b00011110001100000101101)))
; expect = -0.00000000023283064365386962890625

(assert (= expect result))

(check-sat)
(exit)
