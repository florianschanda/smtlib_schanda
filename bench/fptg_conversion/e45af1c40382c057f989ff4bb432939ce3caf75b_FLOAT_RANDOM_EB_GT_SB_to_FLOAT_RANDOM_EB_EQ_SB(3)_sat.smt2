(assert (fp.leq (fp #b0 #b0010010101111 #b011011101011)
                expect
                (fp #b0 #b0111100000000 #b000000000000)))
(assert (fp.leq (fp #b0 #b0111100000000 #b000000000000)
                expect
                (fp #b0 #b1000010001011 #b010111110010)))

(assert (= expect result))

(check-sat)
