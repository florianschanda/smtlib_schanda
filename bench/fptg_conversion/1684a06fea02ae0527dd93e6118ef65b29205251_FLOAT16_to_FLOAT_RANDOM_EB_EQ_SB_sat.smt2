(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1110000001)
                arg1
                (fp #b1 #b00000 #b0001101111)))
(assert (fp.leq (fp #b1 #b00000 #b0001101111)
                arg1
                (fp #b0 #b11011 #b0010110001)))
; arg1 = -0.000006616115570068359375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01000)
                expect
                (fp #b1 #b001101 #b11000)))
(assert (fp.leq (fp #b1 #b001101 #b11000)
                expect
                (fp #b0 #b110000 #b11111)))
; expect = -0.00000667572021484375

(assert (= expect result))

(check-sat)
(exit)
