; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111110101 #b1001)
                arg1
                (fp #b1 #b111100011 #b1001)))
(assert (fp.leq (fp #b1 #b111100011 #b1001)
                arg1
                (fp #b1 #b001001001 #b1010)))

(declare-const result (_ FloatingPoint 6 93))
(assert (= result ((_ to_fp 6 93) rm arg1)))

(declare-const expect (_ FloatingPoint 6 93))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
