; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 24))
(assert (fp.leq (fp #b1 #b011000010000 #b01100011101111001111001)
                arg1
                (fp #b0 #b100000010101 #b10001001000000100111000)))
(assert (fp.leq (fp #b0 #b100000010101 #b10001001000000100111000)
                arg1
                (fp #b0 #b100100000111 #b10100000011111001110111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000011 #b0100110001101000)
                expect
                (fp #b0 #b1010101 #b1000100100000011)))
(assert (fp.leq (fp #b0 #b1010101 #b1000100100000011)
                expect
                (fp #b0 #b1101111 #b1011110110001010)))
; expect = 6439104.0

(assert (= expect result))

(check-sat)
(exit)
