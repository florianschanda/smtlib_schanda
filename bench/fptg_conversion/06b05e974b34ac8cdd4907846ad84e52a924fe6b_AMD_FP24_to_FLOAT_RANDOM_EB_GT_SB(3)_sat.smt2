(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1110001101011000)
                arg1
                (fp #b0 #b1000110 #b1011110001110100)))
(assert (fp.leq (fp #b0 #b1000110 #b1011110001110100)
                arg1
                (fp #b0 #b1110101 #b1001001101100100)))
; arg1 = 222.2265625

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001100110 #b0111)
                expect
                (fp #b0 #b1000000110 #b1100)))
(assert (fp.leq (fp #b0 #b1000000110 #b1100)
                expect
                (fp #b0 #b1001000010 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
