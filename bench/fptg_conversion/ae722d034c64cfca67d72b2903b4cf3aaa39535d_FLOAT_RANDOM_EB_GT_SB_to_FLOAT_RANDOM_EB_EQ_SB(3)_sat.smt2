; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11011011 #b01)
                arg1
                (fp #b0 #b10000001 #b00)))
(assert (fp.leq (fp #b0 #b10000001 #b00)
                arg1
                (fp #b0 #b11100101 #b01)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110101 #b000011)
                expect
                (fp #b0 #b1000001 #b000000)))
(assert (fp.leq (fp #b0 #b1000001 #b000000)
                expect
                (fp #b0 #b1101101 #b100000)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
