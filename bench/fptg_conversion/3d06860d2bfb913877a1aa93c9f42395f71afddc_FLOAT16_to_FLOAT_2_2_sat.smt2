(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1000011111)
                arg1
                (fp #b0 #b01111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111 #b1101111000)
                arg1
                (fp #b0 #b10011 #b1101000111)))
; arg1 = 1.8671875

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                expect
                (fp #b0 #b10 #b1)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
