(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0110101011101001 #b01111)
                arg1
                (fp #b0 #b0000000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000)
                arg1
                (fp #b0 #b1011111001110101 #b00011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b0000001001)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10011 #b0000111101)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
