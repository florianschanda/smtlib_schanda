(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101111001 #b0101001100)
                arg1
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                arg1
                (fp #b1 #b00110011011 #b1111110110)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101110 #b00101100001001011001110)
                expect
                (fp #b1 #b10001010 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b00000000000000000000000)
                expect
                (fp #b0 #b10000011 #b01100110000001011101100)))
; expect = -2048.0

(assert (not (= expect result)))

(check-sat)
(exit)
