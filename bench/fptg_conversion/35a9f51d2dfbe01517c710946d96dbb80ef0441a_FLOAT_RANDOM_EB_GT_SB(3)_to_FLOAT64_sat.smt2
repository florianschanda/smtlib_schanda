; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1101 #b0)
                arg1
                (fp #b1 #b1000 #b1)))
(assert (fp.leq (fp #b1 #b1000 #b1)
                arg1
                (fp #b1 #b1000 #b0)))
; arg1 = -3.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111110011 #b0010010101111000000101011001011000011010011011010001)
                expect
                (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10111110010 #b0100110111001011011111101100100110111111000000000111)))

(assert (= expect result))

(check-sat)
(exit)
