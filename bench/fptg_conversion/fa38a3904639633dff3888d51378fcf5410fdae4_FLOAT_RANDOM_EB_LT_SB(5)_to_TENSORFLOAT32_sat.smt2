(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: TENSORFLOAT32
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 36))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001111 #b00100100000010101001101001011011101)
                arg1
                (fp #b0 #b000000 #b00000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000000 #b00000000000000000000000000000000000)
                arg1
                (fp #b0 #b100100 #b11100001110011010100101101100010000)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00110010 #b0100000111)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b01101000 #b0011011000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
