(assert (fp.leq (fp #b1 #b01 #b1)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b01 #b0)))
; expect = 0.5

(assert (= expect result))

