(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b000000101001110001 #b00000010100110011)
                arg1
                (fp #b0 #b001000101000010010 #b10000100101011010)))
(assert (fp.leq (fp #b0 #b001000101000010010 #b10000100101011010)
                arg1
                (fp #b0 #b111111010100101011 #b11111010000101100)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0110111110)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b00010 #b0101001111)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

