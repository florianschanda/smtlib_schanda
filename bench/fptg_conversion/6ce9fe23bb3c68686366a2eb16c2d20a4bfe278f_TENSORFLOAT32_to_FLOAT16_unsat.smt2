; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101010 #b0001100010)
                arg1
                (fp #b1 #b01111111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111111 #b0010001010)
                arg1
                (fp #b1 #b01100001 #b0010000111)))
; arg1 = -1.134765625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000111000)
                expect
                (fp #b1 #b01111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111 #b0010001010)
                expect
                (fp #b0 #b11011 #b1110101101)))
; expect = -1.134765625

(assert (not (= expect result)))

(check-sat)
