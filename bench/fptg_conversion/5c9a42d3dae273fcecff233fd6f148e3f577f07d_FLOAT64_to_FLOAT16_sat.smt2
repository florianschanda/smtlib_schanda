(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT64
; Format to: FLOAT16
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000110001 #b1010010001011110000100110010001111011001101110001101)
                arg1
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110011111 #b1101110111111111101011101011111110111001111111110011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0110000000)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b11100 #b0000000101)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
