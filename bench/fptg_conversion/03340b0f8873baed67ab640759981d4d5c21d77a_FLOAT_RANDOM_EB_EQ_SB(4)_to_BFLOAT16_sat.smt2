(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101011010011 #b10110111010000)
                arg1
                (fp #b1 #b100000000001010 #b00010011100000)))
(assert (fp.leq (fp #b1 #b100000000001010 #b00010011100000)
                arg1
                (fp #b0 #b111000000101000 #b01000000100111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010100 #b1101100)
                expect
                (fp #b1 #b10001010 #b0001010)))
(assert (fp.leq (fp #b1 #b10001010 #b0001010)
                expect
                (fp #b1 #b01000111 #b1111111)))
; expect = -2208.0

(assert (= expect result))

(check-sat)
(exit)
