; Format from: PIXAR_PXR24
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110101 #b101001101001110)
                arg1
                (fp #b1 #b01111110 #b001011010100111)))
(assert (fp.leq (fp #b1 #b01111110 #b001011010100111)
                arg1
                (fp #b1 #b01000110 #b001010011101000)))
; arg1 = -0.5884857177734375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010010 #b0111100000)
                expect
                (fp #b1 #b01111110 #b0010110110)))
(assert (fp.leq (fp #b1 #b01111110 #b0010110110)
                expect
                (fp #b0 #b00000000 #b0101100010)))
; expect = -0.5888671875

(assert (= expect result))

(check-sat)
(exit)
