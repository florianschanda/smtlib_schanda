(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b01101110111110111 #b00100110)
                arg1
                (fp #b1 #b00000000000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00000001)
                arg1
                (fp #b0 #b10011000101000101 #b11010011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b1010111011)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10110 #b0011010110)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
