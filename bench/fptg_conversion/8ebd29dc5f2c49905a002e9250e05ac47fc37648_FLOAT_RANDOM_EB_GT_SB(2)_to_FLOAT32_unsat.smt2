; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b10)
                arg1
                (fp #b1 #b1010 #b10)))
(assert (fp.leq (fp #b1 #b1010 #b10)
                arg1
                (fp #b0 #b0111 #b11)))
; arg1 = -12.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010100 #b11010010111010010110110)
                expect
                (fp #b1 #b10000010 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b10000000000000000000000)
                expect
                (fp #b0 #b11101010 #b00011010001101000100111)))
; expect = -12.0

(assert (not (= expect result)))

(check-sat)
(exit)
