; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b100001100111 #b000010010)
                arg1
                (fp #b1 #b001101111000 #b111100010)))
(assert (fp.leq (fp #b1 #b001101111000 #b111100010)
                arg1
                (fp #b0 #b000101000011 #b011101001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110100 #b11011110)
                expect
                (fp #b1 #b000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b000000000 #b00000001)
                expect
                (fp #b0 #b011100010 #b11110111)))

(assert (= expect result))

(check-sat)
(exit)
