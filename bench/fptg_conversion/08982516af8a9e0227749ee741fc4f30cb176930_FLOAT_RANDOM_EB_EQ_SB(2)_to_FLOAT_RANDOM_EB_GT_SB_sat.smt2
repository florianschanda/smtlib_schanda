; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b010)
                arg1
                (fp #b0 #b0000 #b110)))
(assert (fp.leq (fp #b0 #b0000 #b110)
                arg1
                (fp #b0 #b0111 #b110)))
; arg1 = 0.01171875

(declare-const result (_ FloatingPoint 15 10))
(assert (= result ((_ to_fp 15 10) rm arg1)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b001100001110111 #b011100101)
                expect
                (fp #b0 #b011111111111000 #b100000000)))
(assert (fp.leq (fp #b0 #b011111111111000 #b100000000)
                expect
                (fp #b0 #b111000011111100 #b010000001)))

(assert (= expect result))

(check-sat)
(exit)
