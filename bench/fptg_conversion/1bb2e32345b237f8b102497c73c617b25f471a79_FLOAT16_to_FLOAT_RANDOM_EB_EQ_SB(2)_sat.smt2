; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1001010111)
                arg1
                (fp #b0 #b11001 #b0101110010)))
(assert (fp.leq (fp #b0 #b11001 #b0101110010)
                arg1
                (fp #b0 #b11100 #b0100000100)))
; arg1 = 1394.0

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010111001011000 #b00100110110010)
                expect
                (fp #b0 #b100000000001001 #b01011100100000)))
(assert (fp.leq (fp #b0 #b100000000001001 #b01011100100000)
                expect
                (fp #b0 #b100011010110111 #b11100111010001)))

(assert (= expect result))

(check-sat)
(exit)
