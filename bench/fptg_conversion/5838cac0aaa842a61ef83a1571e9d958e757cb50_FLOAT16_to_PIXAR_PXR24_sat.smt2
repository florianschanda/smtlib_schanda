(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0001001110)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b01110 #b1100000101)))
; arg1 = -0.001132965087890625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10001011 #b010110111011110)
                expect
                (fp #b1 #b01110101 #b001010010000000)))
(assert (fp.leq (fp #b1 #b01110101 #b001010010000000)
                expect
                (fp #b0 #b00000100 #b011001010110000)))
; expect = -0.001132965087890625

(assert (= expect result))

(check-sat)
(exit)
