; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                arg1
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg1
                (fp #b0 #b101 #b11)))
; arg1 = -0.0625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001110 #b1111000001)
                expect
                (fp #b1 #b01111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111011 #b0000000000)
                expect
                (fp #b1 #b00111100 #b0110000000)))
; expect = -0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
