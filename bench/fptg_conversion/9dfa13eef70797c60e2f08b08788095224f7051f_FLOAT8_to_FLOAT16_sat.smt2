(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0111)
                arg1
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                arg1
                (fp #b0 #b111 #b0000)))
; arg1 = 15.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b1110011101)
                expect
                (fp #b0 #b10010 #b1111000000)))
(assert (fp.leq (fp #b0 #b10010 #b1111000000)
                expect
                (fp #b0 #b11000 #b0011100000)))
; expect = 15.5

(assert (= expect result))

(check-sat)
(exit)
