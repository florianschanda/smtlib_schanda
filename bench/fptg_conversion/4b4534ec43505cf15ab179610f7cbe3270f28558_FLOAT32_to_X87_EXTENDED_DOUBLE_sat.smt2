(assert (fp.leq (fp #b1 #b111010110011011 #b001010101101101101000110110011001110010010110010011011000000001)
                expect
                (fp #b1 #b011111111111111 #b100110101101111100101100000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b100110101101111100101100000000000000000000000000000000000000000)
                expect
                (fp #b1 #b001011111011110 #b001000010110101001001110110110110110110000010100110010010101001)))

(assert (= expect result))

(check-sat)
(exit)
