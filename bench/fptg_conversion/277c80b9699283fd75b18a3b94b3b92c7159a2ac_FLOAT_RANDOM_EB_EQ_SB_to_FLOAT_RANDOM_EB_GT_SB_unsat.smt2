; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b110 #b01)))
(assert (fp.leq (fp #b1 #b110 #b01)
                arg1
                (fp #b0 #b110 #b00)))
; arg1 = -10.0

(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10101011000 #b0011011)
                expect
                (fp #b1 #b10000000010 #b0100000)))
(assert (fp.leq (fp #b1 #b10000000010 #b0100000)
                expect
                (fp #b0 #b11011001111 #b0011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
