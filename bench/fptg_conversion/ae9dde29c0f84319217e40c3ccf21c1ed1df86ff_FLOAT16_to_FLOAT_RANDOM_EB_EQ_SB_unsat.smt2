; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00111 #b0010111101)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b11110 #b1101111111)))
; arg1 = 0.0000045299530029296875

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010100111 #b010111011)
                expect
                (fp #b0 #b0111101101 #b001100000)))
(assert (fp.leq (fp #b0 #b0111101101 #b001100000)
                expect
                (fp #b0 #b1101101111 #b111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
