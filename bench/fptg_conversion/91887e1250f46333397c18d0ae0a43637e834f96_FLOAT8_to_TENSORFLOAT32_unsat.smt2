(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg1
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg1
                (fp #b1 #b000 #b0000)))
; arg1 = -0.234375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110110 #b1110010010)
                expect
                (fp #b1 #b01111100 #b1110000000)))
(assert (fp.leq (fp #b1 #b01111100 #b1110000000)
                expect
                (fp #b0 #b00101111 #b0101100110)))
; expect = -0.234375

(assert (not (= expect result)))

(check-sat)
