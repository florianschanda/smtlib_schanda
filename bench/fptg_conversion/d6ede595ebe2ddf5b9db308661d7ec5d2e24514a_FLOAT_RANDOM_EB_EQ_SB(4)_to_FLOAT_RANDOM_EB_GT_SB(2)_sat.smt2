; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111111 #b00011110)
                arg1
                (fp #b1 #b000000000 #b00011110)))
(assert (fp.leq (fp #b1 #b000000000 #b00011110)
                arg1
                (fp #b0 #b000110010 #b11010011)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result ((_ to_fp 10 4) rm arg1)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110000101 #b001)
                expect
                (fp #b1 #b0011111101 #b111)))
(assert (fp.leq (fp #b1 #b0011111101 #b111)
                expect
                (fp #b0 #b1110010010 #b100)))

(assert (= expect result))

(check-sat)
(exit)
