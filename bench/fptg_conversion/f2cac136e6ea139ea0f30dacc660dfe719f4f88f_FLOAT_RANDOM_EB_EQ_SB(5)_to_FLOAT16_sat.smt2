(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b010010000110000000 #b00101001010001110)
                arg1
                (fp #b0 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000000000000000)
                arg1
                (fp #b0 #b010010110001001011 #b10011101010011000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01100 #b1111101000)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b10000 #b0101100100)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
