(assert (fp.leq (fp #b1 #b1110000101011 #b000100110101)
                expect
                (fp #b1 #b1000000000110 #b100000000000)))
(assert (fp.leq (fp #b1 #b1000000000110 #b100000000000)
                expect
                (fp #b1 #b0010001110111 #b011101110110)))

(assert (= expect result))

(check-sat)
