; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 17))
(assert (fp.leq (fp #b1 #b111101111100110011 #b1110011100101100)
                arg1
                (fp #b1 #b100000000000001111 #b0101110100010011)))
(assert (fp.leq (fp #b1 #b100000000000001111 #b0101110100010011)
                arg1
                (fp #b1 #b001110111100110000 #b1011111101111111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001100 #b1101000)
                expect
                (fp #b1 #b10001111 #b0101111)))
(assert (fp.leq (fp #b1 #b10001111 #b0101111)
                expect
                (fp #b0 #b10000111 #b0110000)))
; expect = -89600.0

(assert (= expect result))

(check-sat)
(exit)
