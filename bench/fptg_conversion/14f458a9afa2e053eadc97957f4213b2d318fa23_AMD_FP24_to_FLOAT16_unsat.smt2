(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b1011001010100110)
                arg1
                (fp #b0 #b1101100 #b1010100100110011)))
(assert (fp.leq (fp #b0 #b1101100 #b1010100100110011)
                arg1
                (fp #b0 #b1111000 #b1001100010100110)))
; arg1 = 58438935642112.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
