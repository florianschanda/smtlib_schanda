; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0010010101)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b1 #b00000 #b0011000000)))
; arg1 = -0.000060975551605224609375

(declare-const result (_ FloatingPoint 11 7))
(assert (= result ((_ to_fp 11 7) rm arg1)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10100010101 #b010000)
                expect
                (fp #b1 #b01111110001 #b000000)))
(assert (fp.leq (fp #b1 #b01111110001 #b000000)
                expect
                (fp #b0 #b01111011000 #b100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
