(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1100110010010001)
                arg1
                (fp #b1 #b1111011 #b0001001011100110)))
(assert (fp.leq (fp #b1 #b1111011 #b0001001011100110)
                arg1
                (fp #b1 #b0010110 #b1000101110110101)))
; arg1 = -1238032500689731584.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111110 #b1001101)
                expect
                (fp #b1 #b10111011 #b0001010)))
(assert (fp.leq (fp #b1 #b10111011 #b0001010)
                expect
                (fp #b0 #b10001001 #b1101111)))
; expect = -1242993497154256896.0

(assert (= expect result))

(check-sat)
(exit)
