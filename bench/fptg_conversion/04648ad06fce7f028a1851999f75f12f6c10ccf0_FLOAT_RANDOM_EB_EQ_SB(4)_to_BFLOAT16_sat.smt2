; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10011101101110011 #b0010010010111111)
                arg1
                (fp #b1 #b01111111111111111 #b0100101010101100)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0100101010101100)
                arg1
                (fp #b0 #b10010001011110001 #b0000010100010010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111111 #b1010011)
                expect
                (fp #b1 #b01111111 #b0100110)))
(assert (fp.leq (fp #b1 #b01111111 #b0100110)
                expect
                (fp #b0 #b00001011 #b0100100)))
; expect = -1.296875

(assert (= expect result))

(check-sat)
(exit)
