(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0110 #b111)
                arg1
                (fp #b0 #b1010 #b111)))
(assert (fp.leq (fp #b0 #b1010 #b111)
                arg1
                (fp #b0 #b1100 #b111)))
; arg1 = 15.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011000 #b0000010)
                expect
                (fp #b0 #b10000010 #b1110000)))
(assert (fp.leq (fp #b0 #b10000010 #b1110000)
                expect
                (fp #b0 #b10110111 #b0110100)))
; expect = 15.0

(assert (= expect result))

(check-sat)
(exit)
