; Format from: FLOAT64
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00100010100 #b1111000000000001100101011111000110000110101101010011)
                arg1
                (fp #b0 #b00000000000 #b0001111101011010000100001010100111001111011111010010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001111101011010000100001010100111001111011111010010)
                arg1
                (fp #b0 #b11101100000 #b1110011110000110011000001001000000100010001100110111)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1101)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b100 #b0111)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
