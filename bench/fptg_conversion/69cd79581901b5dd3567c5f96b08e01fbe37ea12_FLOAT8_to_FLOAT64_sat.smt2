; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0111)
                arg1
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                arg1
                (fp #b1 #b101 #b0100)))
; arg1 = -9.5

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011001101 #b0001101100100001011111001111101100001000001000011100)
                expect
                (fp #b1 #b10000000010 #b0011000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000010 #b0011000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01011111111 #b1111101001111010001010101010010111100000010011101000)))

(assert (= expect result))

(check-sat)
(exit)
