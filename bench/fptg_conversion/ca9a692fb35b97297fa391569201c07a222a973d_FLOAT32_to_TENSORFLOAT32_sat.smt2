(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b10010010001011001010001)
                arg1
                (fp #b0 #b11010101 #b00100111011100011000100)))
(assert (fp.leq (fp #b0 #b11010101 #b00100111011100011000100)
                arg1
                (fp #b0 #b11011001 #b01010101001001000010101)))
; arg1 = 89292313239018475236622336.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00101001 #b1110100100)
                expect
                (fp #b0 #b11010101 #b0010011110)))
(assert (fp.leq (fp #b0 #b11010101 #b0010011110)
                expect
                (fp #b0 #b11011011 #b0010000001)))
; expect = 89309394924030730281418752.0

(assert (= expect result))

(check-sat)
(exit)
