(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg1
                (fp #b0 #b011 #b01)))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 1.25

(declare-const result (_ FloatingPoint 13 12))
(assert (= result ((_ to_fp 13 12) rm arg1)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1111000110100 #b10011000101)
                expect
                (fp #b0 #b0111111111111 #b01000000000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b01000000000)
                expect
                (fp #b0 #b1111100110011 #b00110101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
