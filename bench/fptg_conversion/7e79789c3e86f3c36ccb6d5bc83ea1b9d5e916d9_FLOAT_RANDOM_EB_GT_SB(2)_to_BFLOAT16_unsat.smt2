(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1110 #b1)
                arg1
                (fp #b1 #b0100 #b0)))
(assert (fp.leq (fp #b1 #b0100 #b0)
                arg1
                (fp #b1 #b0001 #b0)))
; arg1 = -0.125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b1000111)
                expect
                (fp #b1 #b01111100 #b0000000)))
(assert (fp.leq (fp #b1 #b01111100 #b0000000)
                expect
                (fp #b0 #b01110100 #b0110000)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
