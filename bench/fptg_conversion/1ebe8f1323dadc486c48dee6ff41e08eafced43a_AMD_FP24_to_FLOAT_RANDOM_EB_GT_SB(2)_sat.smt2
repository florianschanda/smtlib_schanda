(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110010 #b0000110110010000)
                arg1
                (fp #b0 #b1101001 #b0010001000011000)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011000)
                arg1
                (fp #b0 #b1111100 #b0011101110001110)))
; arg1 = 4983772676096.0

(declare-const result (_ FloatingPoint 14 8))
(assert (= result ((_ to_fp 14 8) rm arg1)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10001010101011 #b1111111)
                expect
                (fp #b0 #b10000000101001 #b0010010)))
(assert (fp.leq (fp #b0 #b10000000101001 #b0010010)
                expect
                (fp #b0 #b11101110011000 #b1010001)))

(assert (= expect result))

(check-sat)
(exit)
