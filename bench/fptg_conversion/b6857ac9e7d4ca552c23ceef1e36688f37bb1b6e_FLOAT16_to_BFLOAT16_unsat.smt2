; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101101000)
                arg1
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg1
                (fp #b0 #b11010 #b1101001101)))
; arg1 = -0.000244140625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100111 #b0010001)
                expect
                (fp #b1 #b01110011 #b0000000)))
(assert (fp.leq (fp #b1 #b01110011 #b0000000)
                expect
                (fp #b0 #b01011011 #b0110010)))
; expect = -0.000244140625

(assert (not (= expect result)))

(check-sat)
(exit)
