; Format from: PIXAR_PXR24
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111000 #b010101110100010)
                arg1
                (fp #b1 #b01111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111 #b011000110111010)
                arg1
                (fp #b1 #b01111110 #b110110001000111)))
; arg1 = -1.38848876953125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0000101011)
                expect
                (fp #b1 #b01111 #b0110001110)))
(assert (fp.leq (fp #b1 #b01111 #b0110001110)
                expect
                (fp #b0 #b10001 #b0100101011)))
; expect = -1.388671875

(assert (= expect result))

(check-sat)
(exit)
