(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011011 #b001)
                arg1
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg1
                (fp #b0 #b1100010 #b011)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100 #b1100)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b110 #b1010)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
