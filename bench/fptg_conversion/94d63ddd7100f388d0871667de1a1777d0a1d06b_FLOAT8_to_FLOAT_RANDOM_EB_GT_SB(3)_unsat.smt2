; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b000 #b1100)))
(assert (fp.leq (fp #b0 #b000 #b1100)
                arg1
                (fp #b0 #b011 #b0110)))
; arg1 = 0.1875

(declare-const result (_ FloatingPoint 16 4))
(assert (= result ((_ to_fp 16 4) rm arg1)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111001010100011 #b100)
                expect
                (fp #b0 #b0111111111111100 #b100)))
(assert (fp.leq (fp #b0 #b0111111111111100 #b100)
                expect
                (fp #b0 #b1011011100100111 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
