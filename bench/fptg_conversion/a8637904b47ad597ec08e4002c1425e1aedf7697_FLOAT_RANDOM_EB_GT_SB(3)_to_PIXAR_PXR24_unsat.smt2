; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b100 #b0)))
(assert (fp.leq (fp #b1 #b100 #b0)
                arg1
                (fp #b0 #b010 #b0)))
; arg1 = -2.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100000 #b100001100010110)
                expect
                (fp #b1 #b10000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b000000000000000)
                expect
                (fp #b0 #b11001111 #b100101001001110)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
