; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1011101111001 #b00111)
                arg1
                (fp #b1 #b0111111111111 #b11001)))
(assert (fp.leq (fp #b1 #b0111111111111 #b11001)
                arg1
                (fp #b0 #b0000000110001 #b10100)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b00 #b0)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
