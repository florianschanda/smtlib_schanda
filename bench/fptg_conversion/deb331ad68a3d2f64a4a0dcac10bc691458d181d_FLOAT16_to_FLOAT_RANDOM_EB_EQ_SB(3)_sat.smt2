; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111101100)
                arg1
                (fp #b1 #b11000 #b1100000110)))
(assert (fp.leq (fp #b1 #b11000 #b1100000110)
                arg1
                (fp #b0 #b10000 #b0000010110)))
; arg1 = -899.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000101001011110 #b001010010100001)
                expect
                (fp #b1 #b1000000000001000 #b110000011000000)))
(assert (fp.leq (fp #b1 #b1000000000001000 #b110000011000000)
                expect
                (fp #b1 #b0010101000011000 #b110001101000100)))

(assert (= expect result))

(check-sat)
(exit)
