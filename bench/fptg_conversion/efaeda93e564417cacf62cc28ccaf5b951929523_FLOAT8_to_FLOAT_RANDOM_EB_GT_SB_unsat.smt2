(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0111)
                arg1
                (fp #b0 #b101 #b1000)))
(assert (fp.leq (fp #b0 #b101 #b1000)
                arg1
                (fp #b0 #b110 #b1101)))
; arg1 = 6.0

(declare-const result (_ FloatingPoint 5 4))
(assert (= result ((_ to_fp 5 4) rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b10001 #b010)
                expect
                (fp #b0 #b10001 #b100)))
(assert (fp.leq (fp #b0 #b10001 #b100)
                expect
                (fp #b0 #b10100 #b110)))
; expect = 6.0

(assert (not (= expect result)))

(check-sat)
(exit)
