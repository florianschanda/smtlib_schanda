(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b0)
                arg1
                (fp #b0 #b011 #b1)))
(assert (fp.leq (fp #b0 #b011 #b1)
                arg1
                (fp #b0 #b101 #b1)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010101 #b1111101110001100)
                expect
                (fp #b0 #b0111111 #b1000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1000000000000000)
                expect
                (fp #b0 #b1001001 #b0010111000111101)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
