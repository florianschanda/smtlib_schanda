; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b0 #b001 #b10)))
(assert (fp.leq (fp #b0 #b001 #b10)
                arg1
                (fp #b0 #b100 #b00)))
; arg1 = 0.375

(declare-const result (_ FloatingPoint 12 7))
(assert (= result ((_ to_fp 12 7) rm arg1)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b000011111000 #b001001)
                expect
                (fp #b0 #b011111111101 #b100000)))
(assert (fp.leq (fp #b0 #b011111111101 #b100000)
                expect
                (fp #b0 #b100001000111 #b100110)))

(assert (= expect result))

(check-sat)
(exit)
