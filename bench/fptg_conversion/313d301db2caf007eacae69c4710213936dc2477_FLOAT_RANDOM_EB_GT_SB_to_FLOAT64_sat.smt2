; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1000011001000100 #b010)
                arg1
                (fp #b1 #b0010100110110010 #b011)))
(assert (fp.leq (fp #b1 #b0010100110110010 #b011)
                arg1
                (fp #b0 #b1011010111010101 #b000)))

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000010100 #b0100100111011110100100001001110011001011001100010101)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01001000010 #b1000101010010000101011000111010001100100111010011100)))

(assert (= expect result))

(check-sat)
(exit)
