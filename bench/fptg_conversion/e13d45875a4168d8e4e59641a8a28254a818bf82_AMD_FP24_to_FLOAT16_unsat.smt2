; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100011 #b0101111000110000)
                arg1
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg1
                (fp #b0 #b1111010 #b0001001111010111)))
; arg1 = -0.00000000000000000021684043449710088680149056017398834228515625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b0000100111)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b11100 #b0010001000)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
