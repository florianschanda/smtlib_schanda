(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b101)
                arg1
                (fp #b0 #b0100 #b000)))
(assert (fp.leq (fp #b0 #b0100 #b000)
                arg1
                (fp #b0 #b0111 #b010)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 12 10))
(assert (= result ((_ to_fp 12 10) rm arg1)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b001100001110 #b011111011)
                expect
                (fp #b0 #b011111111100 #b000000000)))
(assert (fp.leq (fp #b0 #b011111111100 #b000000000)
                expect
                (fp #b0 #b111111111001 #b011011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
