; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01010101110 #b0101100100)
                arg1
                (fp #b0 #b01101110000 #b1101101101)))
(assert (fp.leq (fp #b0 #b01101110000 #b1101101101)
                arg1
                (fp #b0 #b11000000010 #b1000100000)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b11)
                expect
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                expect
                (fp #b0 #b0001 #b00)))
; expect = 0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
