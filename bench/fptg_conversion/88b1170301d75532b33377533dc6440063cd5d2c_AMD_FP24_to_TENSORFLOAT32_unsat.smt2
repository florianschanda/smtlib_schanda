; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0000101100101110)
                arg1
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg1
                (fp #b0 #b0111000 #b1100010001111100)))
; arg1 = -14354451791872.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010011 #b1010111100)
                expect
                (fp #b1 #b10101010 #b1010001000)))
(assert (fp.leq (fp #b1 #b10101010 #b1010001000)
                expect
                (fp #b0 #b10000110 #b1001100011)))
; expect = -14362370637824.0

(assert (not (= expect result)))

(check-sat)
(exit)
