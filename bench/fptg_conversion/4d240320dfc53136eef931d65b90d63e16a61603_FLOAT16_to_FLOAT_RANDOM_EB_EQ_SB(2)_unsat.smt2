(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111100111011 #b1101111100001)
                expect
                (fp #b1 #b10000000001010 #b1011001111000)))
(assert (fp.leq (fp #b1 #b10000000001010 #b1011001111000)
                expect
                (fp #b1 #b01010010010001 #b1011001010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
