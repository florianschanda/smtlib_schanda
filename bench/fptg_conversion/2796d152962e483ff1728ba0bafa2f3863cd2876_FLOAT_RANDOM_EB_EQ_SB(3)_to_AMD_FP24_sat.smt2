(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0110 #b111)
                arg1
                (fp #b0 #b1010 #b111)))
(assert (fp.leq (fp #b0 #b1010 #b111)
                arg1
                (fp #b0 #b1100 #b111)))
; arg1 = 15.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011010 #b0010001010100110)
                expect
                (fp #b0 #b1000010 #b1110000000000000)))
(assert (fp.leq (fp #b0 #b1000010 #b1110000000000000)
                expect
                (fp #b0 #b1101101 #b0101001001000100)))
; expect = 15.0

(assert (= expect result))

(check-sat)
(exit)
