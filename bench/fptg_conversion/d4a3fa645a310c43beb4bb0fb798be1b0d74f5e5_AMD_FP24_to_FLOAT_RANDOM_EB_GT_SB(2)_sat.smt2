; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1001000011110011)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b0111110 #b1111001010000010)))
; arg1 = -131072.0

(declare-const result (_ FloatingPoint 10 2))
(assert (= result ((_ to_fp 10 2) rm arg1)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101110111 #b1)
                expect
                (fp #b1 #b1000010000 #b0)))
(assert (fp.leq (fp #b1 #b1000010000 #b0)
                expect
                (fp #b1 #b0000010011 #b0)))

(assert (= expect result))

(check-sat)
(exit)
