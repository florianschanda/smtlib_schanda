(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b0101000011)
                arg1
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg1
                (fp #b1 #b00101 #b1011111001)))
; arg1 = -0.0078125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b00100000110101101011111)
                expect
                (fp #b1 #b01111000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111000 #b00000000000000000000000)
                expect
                (fp #b1 #b00100110 #b01111100011001110011010)))
; expect = -0.0078125

(assert (= expect result))

(check-sat)
(exit)
