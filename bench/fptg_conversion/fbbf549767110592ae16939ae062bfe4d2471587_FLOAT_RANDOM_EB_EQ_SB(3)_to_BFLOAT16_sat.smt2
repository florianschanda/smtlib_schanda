; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10010100000011110 #b1101000111101001)
                arg1
                (fp #b1 #b01111111111111111 #b1110010001100101)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1110010001100101)
                arg1
                (fp #b0 #b10110110100111000 #b0000000101010010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110000 #b1001110)
                expect
                (fp #b1 #b01111111 #b1110011)))
(assert (fp.leq (fp #b1 #b01111111 #b1110011)
                expect
                (fp #b0 #b01010000 #b1000011)))
; expect = -1.8984375

(assert (= expect result))

(check-sat)
