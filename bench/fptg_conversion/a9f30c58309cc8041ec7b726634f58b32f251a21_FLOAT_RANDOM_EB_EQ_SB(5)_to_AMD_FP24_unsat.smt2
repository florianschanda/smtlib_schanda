(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0110110111010100)
                expect
                (fp #b1 #b0111110 #b1100000000000000)))
(assert (fp.leq (fp #b1 #b0111110 #b1100000000000000)
                expect
                (fp #b0 #b0010000 #b0010100100010010)))
; expect = -0.875

(assert (not (= expect result)))

(check-sat)
(exit)
