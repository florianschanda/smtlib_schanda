; Format from: AMD_FP24
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010000 #b1011100000111000)
                arg1
                (fp #b0 #b0000000 #b0011101110101100)))
(assert (fp.leq (fp #b0 #b0000000 #b0011101110101100)
                arg1
                (fp #b0 #b1110000 #b0011100111110100)))
; arg1 = 0.0000000000000000000505440441494402030453425567202430102042853832244873046875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b011 #b0101)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
