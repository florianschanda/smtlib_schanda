(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0100001010)
                arg1
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                arg1
                (fp #b0 #b11010 #b1010000001)))
; arg1 = 1872.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011100 #b10111110000001010011010)
                expect
                (fp #b0 #b10001001 #b11010100000000000000000)))
(assert (fp.leq (fp #b0 #b10001001 #b11010100000000000000000)
                expect
                (fp #b0 #b11100101 #b10110110110100101100011)))
; expect = 1872.0

(assert (= expect result))

(check-sat)
(exit)
