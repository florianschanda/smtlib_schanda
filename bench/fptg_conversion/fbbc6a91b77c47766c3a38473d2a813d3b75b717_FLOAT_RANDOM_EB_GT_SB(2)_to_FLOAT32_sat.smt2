(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b01)
                arg1
                (fp #b1 #b1010 #b00)))
(assert (fp.leq (fp #b1 #b1010 #b00)
                arg1
                (fp #b0 #b1110 #b11)))
; arg1 = -8.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b01000000001000110000111)
                expect
                (fp #b1 #b10000010 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b00000000000000000000000)
                expect
                (fp #b0 #b11101000 #b01000100111011101100111)))
; expect = -8.0

(assert (= expect result))

(check-sat)
(exit)
