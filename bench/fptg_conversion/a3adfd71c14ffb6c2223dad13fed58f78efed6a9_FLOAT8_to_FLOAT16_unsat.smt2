; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b1111)))
(assert (fp.leq (fp #b0 #b000 #b1111)
                arg1
                (fp #b0 #b101 #b1110)))
; arg1 = 0.234375

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01011 #b1000011011)
                expect
                (fp #b0 #b01100 #b1110000000)))
(assert (fp.leq (fp #b0 #b01100 #b1110000000)
                expect
                (fp #b0 #b01110 #b0111100011)))
; expect = 0.234375

(assert (not (= expect result)))

(check-sat)
(exit)
