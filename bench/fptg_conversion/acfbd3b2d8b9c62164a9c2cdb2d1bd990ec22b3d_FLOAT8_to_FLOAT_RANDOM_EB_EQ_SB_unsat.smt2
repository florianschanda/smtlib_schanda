; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1111)
                arg1
                (fp #b1 #b010 #b1000)))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b0 #b001 #b0110)))
; arg1 = -0.75

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101101100 #b11111100110)
                expect
                (fp #b1 #b011111111110 #b10000000000)))
(assert (fp.leq (fp #b1 #b011111111110 #b10000000000)
                expect
                (fp #b0 #b000011000011 #b10011011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
