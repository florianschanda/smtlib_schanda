; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011101111 #b11111110)
                arg1
                (fp #b0 #b100000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000010 #b00100000)
                arg1
                (fp #b0 #b111010000 #b00000011)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011010 #b11011011111001110011111)
                expect
                (fp #b0 #b10000010 #b00100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b00100000000000000000000)
                expect
                (fp #b0 #b10011000 #b00111111110111010010011)))
; expect = 9.0

(assert (not (= expect result)))

(check-sat)
(exit)
