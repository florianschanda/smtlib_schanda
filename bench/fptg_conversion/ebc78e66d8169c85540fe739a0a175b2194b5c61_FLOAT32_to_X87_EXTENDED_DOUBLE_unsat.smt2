; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01100010111111001000111)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01111111 #b01001010111001100111110)))
; arg1 = -1316616.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110100110101001 #b110000100101101101100001110011100101111010000011110000000111010)
                expect
                (fp #b1 #b100000000010011 #b010000010111000010000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000010011 #b010000010111000010000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b001100011010000 #b100110011111011010100100001010110100011100011101101001001011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
