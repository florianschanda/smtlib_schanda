; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b11001 #b1100100010)
                arg1
                (fp #b0 #b11101 #b1000010010)))
(assert (fp.leq (fp #b0 #b11101 #b1000010010)
                arg1
                (fp #b0 #b11110 #b1010101010)))
; arg1 = 24864.0

(declare-const result (_ FloatingPoint 9 3))
(assert (= result ((_ to_fp 9 3) rm arg1)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b010100110 #b00)
                expect
                (fp #b0 #b100001101 #b11)))
(assert (fp.leq (fp #b0 #b100001101 #b11)
                expect
                (fp #b0 #b100111111 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
