(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b001 #b0)
                arg1
                (fp #b0 #b001 #b1)))
(assert (fp.leq (fp #b0 #b001 #b1)
                arg1
                (fp #b0 #b011 #b1)))
; arg1 = 0.375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010101 #b00110011010100101100100)
                expect
                (fp #b0 #b01111101 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b10000000000000000000000)
                expect
                (fp #b0 #b11000010 #b01111001000000010110100)))
; expect = 0.375

(assert (not (= expect result)))

(check-sat)
(exit)
