(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b101 #b0001)))
(assert (fp.leq (fp #b1 #b101 #b0001)
                arg1
                (fp #b1 #b011 #b0000)))
; arg1 = -4.25

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0001010100)
                expect
                (fp #b1 #b10001 #b0001000000)))
(assert (fp.leq (fp #b1 #b10001 #b0001000000)
                expect
                (fp #b1 #b01111 #b0111010010)))
; expect = -4.25

(assert (not (= expect result)))

(check-sat)
(exit)
