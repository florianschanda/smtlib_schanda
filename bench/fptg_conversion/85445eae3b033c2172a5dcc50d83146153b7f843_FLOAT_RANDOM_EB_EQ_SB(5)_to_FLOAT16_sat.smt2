; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010011100 #b1111010100)
                arg1
                (fp #b1 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000)
                arg1
                (fp #b1 #b01001001011 #b0011010011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b0101101001)
                expect
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                expect
                (fp #b0 #b01000 #b0010010000)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
