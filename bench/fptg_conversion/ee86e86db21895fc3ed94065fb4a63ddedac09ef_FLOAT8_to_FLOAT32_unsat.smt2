(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0011)
                arg1
                (fp #b1 #b000 #b1100)))
(assert (fp.leq (fp #b1 #b000 #b1100)
                arg1
                (fp #b0 #b001 #b0101)))
; arg1 = -0.1875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010111 #b10101110000111001011110)
                expect
                (fp #b1 #b01111100 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111100 #b10000000000000000000000)
                expect
                (fp #b0 #b01111101 #b00111010110010001011101)))
; expect = -0.1875

(assert (not (= expect result)))

(check-sat)
(exit)
