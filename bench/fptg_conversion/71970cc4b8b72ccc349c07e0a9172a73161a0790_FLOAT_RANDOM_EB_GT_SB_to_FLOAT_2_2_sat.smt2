(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011011011010 #b0110)
                arg1
                (fp #b0 #b001111111110 #b0000)))
(assert (fp.leq (fp #b0 #b001111111110 #b0000)
                arg1
                (fp #b0 #b111001011100 #b1100)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b1)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b10 #b1)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
