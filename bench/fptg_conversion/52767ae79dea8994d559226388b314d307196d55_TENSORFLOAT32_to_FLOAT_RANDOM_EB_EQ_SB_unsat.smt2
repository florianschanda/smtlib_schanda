; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011100 #b0101101001)
                arg1
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                arg1
                (fp #b0 #b00011111 #b1000111011)))
; arg1 = -1.203125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b101)
                expect
                (fp #b1 #b0111 #b010)))
(assert (fp.leq (fp #b1 #b0111 #b010)
                expect
                (fp #b1 #b0010 #b110)))
; expect = -1.25

(assert (not (= expect result)))

(check-sat)
(exit)
