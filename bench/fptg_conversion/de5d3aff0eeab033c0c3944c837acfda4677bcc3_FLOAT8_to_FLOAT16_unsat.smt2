(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg1
                (fp #b1 #b001 #b0100)))
(assert (fp.leq (fp #b1 #b001 #b0100)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -0.3125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110100010)
                expect
                (fp #b1 #b01101 #b0100000000)))
(assert (fp.leq (fp #b1 #b01101 #b0100000000)
                expect
                (fp #b0 #b01101 #b1110011101)))
; expect = -0.3125

(assert (not (= expect result)))

(check-sat)
(exit)
