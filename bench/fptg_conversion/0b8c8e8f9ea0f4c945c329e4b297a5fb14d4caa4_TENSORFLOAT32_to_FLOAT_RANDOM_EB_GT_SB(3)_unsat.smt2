(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010101 #b1111110100)
                arg1
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                arg1
                (fp #b0 #b11110000 #b0000100001)))
; arg1 = -933.0

(declare-const result (_ FloatingPoint 15 2))
(assert (= result ((_ to_fp 15 2) rm arg1)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b100101101000010 #b0)
                expect
                (fp #b1 #b100000000001001 #b0)))
(assert (fp.leq (fp #b1 #b100000000001001 #b0)
                expect
                (fp #b1 #b011111101011110 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
