                expect
                (fp #b0 #b01110111111000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b01110111111000 #b0000000000000)
                expect
                (fp #b0 #b11001001111011 #b1101000010010)))

(assert (= expect result))

