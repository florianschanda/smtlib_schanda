; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b10)
                arg1
                (fp #b1 #b1010 #b10)))
(assert (fp.leq (fp #b1 #b1010 #b10)
                arg1
                (fp #b0 #b0111 #b11)))
; arg1 = -12.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101011 #b1010110110)
                expect
                (fp #b1 #b10000010 #b1000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b1000000000)
                expect
                (fp #b0 #b11100111 #b0111110011)))
; expect = -12.0

(assert (= expect result))

(check-sat)
(exit)
