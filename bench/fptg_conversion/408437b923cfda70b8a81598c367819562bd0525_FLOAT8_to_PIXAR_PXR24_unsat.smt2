                expect
                (fp #b0 #b10000000 #b001000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b001000000000000)
                expect
                (fp #b0 #b11111100 #b010100010001110)))
; expect = 2.25

(assert (not (= expect result)))

