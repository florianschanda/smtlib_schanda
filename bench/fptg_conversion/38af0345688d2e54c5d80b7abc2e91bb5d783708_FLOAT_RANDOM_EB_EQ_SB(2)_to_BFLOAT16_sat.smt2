; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101001011011001 #b010011000001100)
                arg1
                (fp #b1 #b0100100001011010 #b001011000010101)))
(assert (fp.leq (fp #b1 #b0100100001011010 #b001011000010101)
                arg1
                (fp #b0 #b1001101011001110 #b000001011011000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001010 #b0111110)
                expect
                (fp #b1 #b00000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000001)
                expect
                (fp #b0 #b10001101 #b1010100)))
; expect = -0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

