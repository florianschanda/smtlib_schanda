(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0101)
                arg1
                (fp #b0 #b001 #b0110)))
(assert (fp.leq (fp #b0 #b001 #b0110)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = 0.34375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101110 #b11001011101001001010101)
                expect
                (fp #b0 #b01111101 #b01100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b01100000000000000000000)
                expect
                (fp #b0 #b10000011 #b11011001000011011111001)))
; expect = 0.34375

(assert (= expect result))

(check-sat)
(exit)
