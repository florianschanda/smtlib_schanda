; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0100100 #b111001)
                arg1
                (fp #b1 #b0000000 #b011100)))
(assert (fp.leq (fp #b1 #b0000000 #b011100)
                arg1
                (fp #b0 #b1001101 #b011101)))
; arg1 = -0.000000000000000000094867690092481637975652120076119899749755859375

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0110110100)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10111 #b0101100000)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
