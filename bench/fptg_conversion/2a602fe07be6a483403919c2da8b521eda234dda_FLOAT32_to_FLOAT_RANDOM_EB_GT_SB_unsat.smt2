; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11011100011100010010101)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11111001 #b00111010110001001100101)))
; arg1 = 12907478160253124608.0

(declare-const result (_ FloatingPoint 17 11))
(assert (= result ((_ to_fp 17 11) rm arg1)))

(declare-const expect (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b0 #b00100000100011000 #b1010001100)
                expect
                (fp #b0 #b10000000000111110 #b0110011010)))
(assert (fp.leq (fp #b0 #b10000000000111110 #b0110011010)
                expect
                (fp #b0 #b11101110001111001 #b1111101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
