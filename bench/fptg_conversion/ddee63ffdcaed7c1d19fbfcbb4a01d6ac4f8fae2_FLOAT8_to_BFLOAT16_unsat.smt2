; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg1
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                arg1
                (fp #b1 #b011 #b0100)))
; arg1 = -1.625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b0001000)
                expect
                (fp #b1 #b01111111 #b1010000)))
(assert (fp.leq (fp #b1 #b01111111 #b1010000)
                expect
                (fp #b1 #b00100001 #b1011001)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
