                expect
                (fp #b1 #b01111111 #b110000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b110000000000000)
                expect
                (fp #b0 #b10010010 #b000111100110101)))
; expect = -1.75

(assert (not (= expect result)))

