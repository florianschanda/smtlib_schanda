; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11011100111001 #b110)
                arg1
                (fp #b0 #b01111111111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111111111 #b101)
                arg1
                (fp #b0 #b11011111110010 #b000)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b011 #b1010)))
(assert (fp.leq (fp #b0 #b011 #b1010)
                expect
                (fp #b0 #b100 #b0001)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
