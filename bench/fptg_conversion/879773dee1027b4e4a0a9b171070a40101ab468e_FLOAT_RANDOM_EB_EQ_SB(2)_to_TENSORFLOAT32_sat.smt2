; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg1
                (fp #b0 #b0011 #b001)))
(assert (fp.leq (fp #b0 #b0011 #b001)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = 0.0703125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011101 #b0110000101)
                expect
                (fp #b0 #b01111011 #b0010000000)))
(assert (fp.leq (fp #b0 #b01111011 #b0010000000)
                expect
                (fp #b0 #b11110000 #b0011000100)))
; expect = 0.0703125

(assert (= expect result))

(check-sat)
(exit)
