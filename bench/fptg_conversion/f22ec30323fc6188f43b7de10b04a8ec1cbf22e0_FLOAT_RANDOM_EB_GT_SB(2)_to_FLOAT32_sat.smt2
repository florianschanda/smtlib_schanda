(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1100 #b1)
                arg1
                (fp #b1 #b1001 #b1)))
(assert (fp.leq (fp #b1 #b1001 #b1)
                arg1
                (fp #b1 #b1000 #b0)))
; arg1 = -6.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011010 #b01001011100001011100010)
                expect
                (fp #b1 #b10000001 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001 #b10000000000000000000000)
                expect
                (fp #b1 #b00111011 #b00110110010000111100000)))
; expect = -6.0

(assert (= expect result))

(check-sat)
(exit)
