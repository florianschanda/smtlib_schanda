(assert (fp.leq (fp #b1 #b001 #b0010)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b110 #b1000)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
