; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b1110)
                arg1
                (fp #b0 #b101 #b1100)))
(assert (fp.leq (fp #b0 #b101 #b1100)
                arg1
                (fp #b0 #b110 #b1110)))
; arg1 = 7.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01011110 #b01111000111001001010111)
                expect
                (fp #b0 #b10000001 #b11000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b11000000000000000000000)
                expect
                (fp #b0 #b11100001 #b11011111110100100101000)))
; expect = 7.0

(assert (not (= expect result)))

(check-sat)
(exit)
