(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101010 #b1101101001101101)
                expect
                (fp #b0 #b0111111 #b1100100100000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1100100100000000)
                expect
                (fp #b0 #b1100000 #b1110011110110001)))
; expect = 1.78515625

(assert (= expect result))

