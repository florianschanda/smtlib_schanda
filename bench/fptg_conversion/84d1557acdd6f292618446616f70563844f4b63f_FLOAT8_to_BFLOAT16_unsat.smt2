(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b110 #b0100)))
(assert (fp.leq (fp #b0 #b110 #b0100)
                arg1
                (fp #b0 #b110 #b0111)))
; arg1 = 10.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00001000 #b0100100)
                expect
                (fp #b0 #b10000010 #b0100000)))
(assert (fp.leq (fp #b0 #b10000010 #b0100000)
                expect
                (fp #b0 #b10011001 #b1001000)))
; expect = 10.0

(assert (not (= expect result)))

(check-sat)
(exit)
