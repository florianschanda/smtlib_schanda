                expect
                (fp #b1 #b010010 #b1001100111000000000000000000000)))
(assert (fp.leq (fp #b1 #b010010 #b1001100111000000000000000000000)
                expect
                (fp #b0 #b000011 #b1010111010001010101000001100110)))

(assert (= expect result))

