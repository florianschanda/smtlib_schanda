(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011001 #b10111001001000100010110)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b00011101 #b11001100101011101011000)))
; arg1 = -3751329.0

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110010100111010 #b01111010101010)
                expect
                (fp #b1 #b100000000010100 #b11001001111100)))
(assert (fp.leq (fp #b1 #b100000000010100 #b11001001111100)
                expect
                (fp #b0 #b000001010010100 #b11000010111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
