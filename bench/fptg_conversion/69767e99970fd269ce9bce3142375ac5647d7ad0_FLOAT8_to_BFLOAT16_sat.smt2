(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b011 #b1110)
                arg1
                (fp #b1 #b000 #b0000)))
(assert (fp.leq (fp #b1 #b000 #b0000)
                arg1
                (fp #b0 #b000 #b1100)))
; arg1 = -0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11001101 #b1011101)
                expect
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                expect
                (fp #b0 #b01010000 #b0000001)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
