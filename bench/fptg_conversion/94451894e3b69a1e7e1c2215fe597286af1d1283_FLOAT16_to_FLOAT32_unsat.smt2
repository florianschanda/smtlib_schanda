(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010110111)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b0 #b11001 #b1001000001)))
; arg1 = -933.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010001 #b00000000110011000010100)
                expect
                (fp #b1 #b10001000 #b11010010100000000000000)))
(assert (fp.leq (fp #b1 #b10001000 #b11010010100000000000000)
                expect
                (fp #b0 #b00111010 #b01001111101101011000100)))
; expect = -933.0

(assert (not (= expect result)))

(check-sat)
(exit)
