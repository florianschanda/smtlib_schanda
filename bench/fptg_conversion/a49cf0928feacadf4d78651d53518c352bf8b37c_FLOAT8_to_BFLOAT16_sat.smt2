(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b1 #b101 #b0100)))
(assert (fp.leq (fp #b1 #b101 #b0100)
                arg1
                (fp #b0 #b011 #b0100)))
; arg1 = -5.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001010 #b0101011)
                expect
                (fp #b1 #b10000001 #b0100000)))
(assert (fp.leq (fp #b1 #b10000001 #b0100000)
                expect
                (fp #b1 #b01011000 #b0110101)))
; expect = -5.0

(assert (= expect result))

(check-sat)
(exit)
