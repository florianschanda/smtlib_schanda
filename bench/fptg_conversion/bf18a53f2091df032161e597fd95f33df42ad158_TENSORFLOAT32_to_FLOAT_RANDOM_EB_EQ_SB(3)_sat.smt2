(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011101100 #b00111001)
                expect
                (fp #b0 #b100001010 #b00000000)))
(assert (fp.leq (fp #b0 #b100001010 #b00000000)
                expect
                (fp #b0 #b110000001 #b11111010)))

(assert (= expect result))

(check-sat)
(exit)
