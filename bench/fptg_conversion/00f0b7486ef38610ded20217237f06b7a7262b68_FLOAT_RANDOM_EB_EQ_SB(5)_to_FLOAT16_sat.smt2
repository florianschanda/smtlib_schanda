(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11110011111001 #b1000001110111)
                arg1
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                arg1
                (fp #b0 #b00001001001101 #b1011100110010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01100 #b0111111101)
                expect
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                expect
                (fp #b0 #b10000 #b1100110000)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
