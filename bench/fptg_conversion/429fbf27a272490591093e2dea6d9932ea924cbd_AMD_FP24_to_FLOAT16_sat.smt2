; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b0011110001011010)
                arg1
                (fp #b1 #b0111111 #b0011010000100011)))
(assert (fp.leq (fp #b1 #b0111111 #b0011010000100011)
                arg1
                (fp #b0 #b0100010 #b0100001100101001)))
; arg1 = -1.2036590576171875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0001111011)
                expect
                (fp #b1 #b01111 #b0011010001)))
(assert (fp.leq (fp #b1 #b01111 #b0011010001)
                expect
                (fp #b0 #b10110 #b0111110100)))
; expect = -1.2041015625

(assert (= expect result))

(check-sat)
(exit)
