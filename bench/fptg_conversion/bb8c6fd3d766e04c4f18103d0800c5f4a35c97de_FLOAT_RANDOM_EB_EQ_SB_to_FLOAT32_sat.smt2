; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01000 #b1100)
                arg1
                (fp #b0 #b10110 #b1111)))
(assert (fp.leq (fp #b0 #b10110 #b1111)
                arg1
                (fp #b0 #b11011 #b1111)))
; arg1 = 248.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101011 #b10010101001100110001101)
                expect
                (fp #b0 #b10000110 #b11110000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110 #b11110000000000000000000)
                expect
                (fp #b0 #b10011010 #b00110100100111010100000)))
; expect = 248.0

(assert (= expect result))

(check-sat)
(exit)
