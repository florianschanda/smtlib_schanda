; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110001 #b1100100111)
                arg1
                (fp #b0 #b10001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10001001 #b1010000111)
                arg1
                (fp #b0 #b11011011 #b0001001100)))
; arg1 = 1671.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110101 #b00100110001111000100111)
                expect
                (fp #b0 #b10001001 #b10100001110000000000000)))
(assert (fp.leq (fp #b0 #b10001001 #b10100001110000000000000)
                expect
                (fp #b0 #b11101001 #b00111011110101101111101)))
; expect = 1671.0

(assert (= expect result))

(check-sat)
(exit)
