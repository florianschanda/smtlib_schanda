(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101111100111 #b1100100011000)
                expect
                (fp #b1 #b01111111110001 #b0000000000000)))
(assert (fp.leq (fp #b1 #b01111111110001 #b0000000000000)
                expect
                (fp #b0 #b01100101111010 #b1001000110000)))

(assert (= expect result))

(check-sat)
