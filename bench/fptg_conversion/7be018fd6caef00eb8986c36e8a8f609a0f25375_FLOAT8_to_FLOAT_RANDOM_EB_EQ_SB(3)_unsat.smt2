(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b0 #b100 #b1100)))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b101 #b1001)))
; arg1 = 3.5

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b01001)
                expect
                (fp #b0 #b100000 #b11000)))
(assert (fp.leq (fp #b0 #b100000 #b11000)
                expect
                (fp #b0 #b100010 #b00111)))
; expect = 3.5

(assert (not (= expect result)))

(check-sat)
(exit)
