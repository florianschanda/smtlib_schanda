(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001101 #b111110010111110)
                expect
                (fp #b0 #b01111111 #b101110010000000)))
(assert (fp.leq (fp #b0 #b01111111 #b101110010000000)
                expect
                (fp #b0 #b11000110 #b110011101001000)))
; expect = 1.72265625

(assert (not (= expect result)))

(check-sat)
(exit)
