(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001010001010101 #b01011010110110)
                arg1
                (fp #b0 #b001111111111001 #b00000000000000)))
