(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                arg1
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 13 13))
(assert (= result ((_ to_fp 13 13) rm arg1)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1000011010101 #b010100100110)
                expect
                (fp #b0 #b0111111111100 #b000000000000)))
(assert (fp.leq (fp #b0 #b0111111111100 #b000000000000)
                expect
                (fp #b0 #b1101001100000 #b011111001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
