(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011101101 #b01)
                arg1
                (fp #b1 #b000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000 #b01)
                arg1
                (fp #b0 #b001100110 #b11)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b0110110110)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00011 #b1110001101)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
