; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000100100)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b10110 #b0110111010)))
; arg1 = 0.10479736328125

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                expect
                (fp #b0 #b000 #b10)))
(assert (fp.leq (fp #b0 #b000 #b10)
                expect
                (fp #b0 #b011 #b00)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
