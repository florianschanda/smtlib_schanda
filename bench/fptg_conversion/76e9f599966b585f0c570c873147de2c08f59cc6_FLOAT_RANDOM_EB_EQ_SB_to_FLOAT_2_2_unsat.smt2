; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101001010001011 #b111111000101100)
                arg1
                (fp #b1 #b0111111111111111 #b100111100100001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b100111100100001)
                arg1
                (fp #b0 #b0110010001001010 #b101010011011000)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b0 #b00 #b0)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
