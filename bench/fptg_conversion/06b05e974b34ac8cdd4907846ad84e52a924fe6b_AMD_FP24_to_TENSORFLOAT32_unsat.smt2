(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1110001101011000)
                arg1
                (fp #b0 #b1000110 #b1011110001110100)))
(assert (fp.leq (fp #b0 #b1000110 #b1011110001110100)
                arg1
                (fp #b0 #b1110101 #b1001001101100100)))
; arg1 = 222.2265625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00110110 #b1110010010)
                expect
                (fp #b0 #b10000110 #b1011110010)))
(assert (fp.leq (fp #b0 #b10000110 #b1011110010)
                expect
                (fp #b0 #b11100011 #b1101010110)))
; expect = 222.25

(assert (not (= expect result)))

(check-sat)
(exit)
