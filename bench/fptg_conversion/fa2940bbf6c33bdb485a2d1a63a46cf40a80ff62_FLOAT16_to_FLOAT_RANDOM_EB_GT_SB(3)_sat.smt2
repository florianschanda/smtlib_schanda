; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b1011011100)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11101 #b1101010110)))
; arg1 = 16384.0

(declare-const result (_ FloatingPoint 16 12))
(assert (= result ((_ to_fp 16 12) rm arg1)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b0000111110011111 #b01000111000)
                expect
                (fp #b0 #b1000000000001101 #b00000000000)))
(assert (fp.leq (fp #b0 #b1000000000001101 #b00000000000)
                expect
                (fp #b0 #b1100100101011101 #b11000000011)))

(assert (= expect result))

(check-sat)
(exit)
