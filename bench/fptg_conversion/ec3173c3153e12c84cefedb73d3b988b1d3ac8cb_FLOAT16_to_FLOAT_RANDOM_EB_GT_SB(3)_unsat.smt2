(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1100010100)
                arg1
                (fp #b1 #b00000 #b0101100101)))
(assert (fp.leq (fp #b1 #b00000 #b0101100101)
                arg1
                (fp #b0 #b01101 #b1000111101)))
; arg1 = -0.000021278858184814453125

(declare-const result (_ FloatingPoint 16 6))
(assert (= result ((_ to_fp 16 6) rm arg1)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1110110100110010 #b10000)
                expect
                (fp #b1 #b0111111111101111 #b01101)))
(assert (fp.leq (fp #b1 #b0111111111101111 #b01101)
                expect
                (fp #b1 #b0101010010011001 #b10000)))

(assert (not (= expect result)))

(check-sat)
(exit)
