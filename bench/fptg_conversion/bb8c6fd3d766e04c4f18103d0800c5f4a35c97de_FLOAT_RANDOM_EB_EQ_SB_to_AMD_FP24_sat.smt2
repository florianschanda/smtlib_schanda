(assert (fp.leq (fp #b1 #b0111000 #b0000110101001010)
                expect
                (fp #b0 #b1000110 #b1111000000000000)))
(assert (fp.leq (fp #b0 #b1000110 #b1111000000000000)
                expect
                (fp #b0 #b1010110 #b1111010011001101)))
; expect = 248.0

(assert (= expect result))

(check-sat)
