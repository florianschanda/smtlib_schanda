(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1111110101100100)
                arg1
                (fp #b1 #b1001111 #b1011111011110010)))
(assert (fp.leq (fp #b1 #b1001111 #b1011111011110010)
                arg1
                (fp #b1 #b0110101 #b0010000110000101)))
; arg1 = -114418.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110010 #b0111011)
                expect
                (fp #b1 #b10001111 #b1100000)))
(assert (fp.leq (fp #b1 #b10001111 #b1100000)
                expect
                (fp #b0 #b00101110 #b1001001)))
; expect = -114688.0

(assert (= expect result))

(check-sat)
(exit)
