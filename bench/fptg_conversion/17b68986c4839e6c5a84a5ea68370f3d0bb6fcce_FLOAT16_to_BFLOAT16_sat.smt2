(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0110100001)
                arg1
                (fp #b1 #b01111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111 #b0010001010)
                arg1
                (fp #b0 #b01000 #b0111111001)))
; arg1 = -1.134765625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010100 #b0010110)
                expect
                (fp #b1 #b01111111 #b0010010)))
(assert (fp.leq (fp #b1 #b01111111 #b0010010)
                expect
                (fp #b1 #b00001111 #b0100101)))
; expect = -1.140625

(assert (= expect result))

(check-sat)
(exit)
