(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b1001111011111101)
                arg1
                (fp #b1 #b1001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b1001110 #b0001111101100110)
                arg1
                (fp #b0 #b1111011 #b1010010101000011)))
; arg1 = -36787.0

(declare-const result (_ FloatingPoint 3 84))
(assert (= result ((_ to_fp 3 84) rm arg1)))

(declare-const expect (_ FloatingPoint 3 84))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
