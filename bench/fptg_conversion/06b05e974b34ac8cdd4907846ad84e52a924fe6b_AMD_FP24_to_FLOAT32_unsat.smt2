; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1110001101011000)
                arg1
                (fp #b0 #b1000110 #b1011110001110100)))
(assert (fp.leq (fp #b0 #b1000110 #b1011110001110100)
                arg1
                (fp #b0 #b1110101 #b1001001101100100)))
; arg1 = 222.2265625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001100 #b10111110010101010111001)
                expect
                (fp #b0 #b10000110 #b10111100011101000000000)))
(assert (fp.leq (fp #b0 #b10000110 #b10111100011101000000000)
                expect
                (fp #b0 #b10011100 #b01011110101001011011100)))
; expect = 222.2265625

(assert (not (= expect result)))

(check-sat)
(exit)
