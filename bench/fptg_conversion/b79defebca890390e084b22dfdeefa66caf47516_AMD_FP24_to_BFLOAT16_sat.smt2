; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010100 #b0011111110011101)
                arg1
                (fp #b0 #b0111111 #b0111110000011101)))
(assert (fp.leq (fp #b0 #b0111111 #b0111110000011101)
                arg1
                (fp #b0 #b1010111 #b1000110011000101)))
; arg1 = 1.4848175048828125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110011 #b0001011)
                expect
                (fp #b0 #b01111111 #b0111111)))
(assert (fp.leq (fp #b0 #b01111111 #b0111111)
                expect
                (fp #b0 #b11000101 #b1011110)))
; expect = 1.4921875

(assert (= expect result))

(check-sat)
(exit)
