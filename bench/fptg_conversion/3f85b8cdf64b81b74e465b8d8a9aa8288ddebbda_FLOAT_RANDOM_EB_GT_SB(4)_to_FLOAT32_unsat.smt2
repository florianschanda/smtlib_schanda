; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0010111000110 #b1101110)
                arg1
                (fp #b0 #b0111111111111 #b0000000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0000000)
                arg1
                (fp #b0 #b1100001000100 #b1001000)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010000 #b01010011111110110111110)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11101011 #b10111110100010110011001)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
