; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111111 #b0000000000000000)
                arg1
                (fp #b1 #b1111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1111110 #b1111111111111111)
                arg1
                (fp #b1 #b0100001 #b0111010001110101)))
; arg1 = -18446603336221196288.0

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110101 #b11110010)
                expect
                (fp #b1 #b100111111 #b00000000)))
(assert (fp.leq (fp #b1 #b100111111 #b00000000)
                expect
                (fp #b0 #b010011111 #b11111110)))

(assert (= expect result))

(check-sat)
(exit)
