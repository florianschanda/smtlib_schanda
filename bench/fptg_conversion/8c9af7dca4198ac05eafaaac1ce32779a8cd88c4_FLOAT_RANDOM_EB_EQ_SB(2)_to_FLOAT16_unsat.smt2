; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110011 #b10100000)
                arg1
                (fp #b1 #b001111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111100 #b00000000)
                arg1
                (fp #b0 #b101010011 #b01011011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1000100001)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b11001 #b1010110110)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
