(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b1011101111)
                expect
                (fp #b0 #b10101100 #b1010100101)))
(assert (fp.leq (fp #b0 #b10101100 #b1010100101)
                expect
                (fp #b0 #b10101110 #b1010001101)))
; expect = 58445914963968.0

(assert (= expect result))

(check-sat)
(exit)
