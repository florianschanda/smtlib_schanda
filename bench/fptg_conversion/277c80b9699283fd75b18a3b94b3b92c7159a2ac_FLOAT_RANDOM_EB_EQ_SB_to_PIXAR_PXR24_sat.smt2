; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b110 #b01)))
(assert (fp.leq (fp #b1 #b110 #b01)
                arg1
                (fp #b0 #b110 #b00)))
; arg1 = -10.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001011 #b011111000011011)
                expect
                (fp #b1 #b10000010 #b010000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b010000000000000)
                expect
                (fp #b0 #b00110000 #b001110010001001)))
; expect = -10.0

(assert (= expect result))

(check-sat)
(exit)
