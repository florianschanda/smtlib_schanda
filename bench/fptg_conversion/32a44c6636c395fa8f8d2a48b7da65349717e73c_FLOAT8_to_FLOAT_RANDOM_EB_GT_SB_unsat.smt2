(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0011)
                arg1
                (fp #b0 #b101 #b1001)))
(assert (fp.leq (fp #b0 #b101 #b1001)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 6.25

(declare-const result (_ FloatingPoint 11 3))
(assert (= result ((_ to_fp 11 3) rm arg1)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b01101111011 #b01)
                expect
                (fp #b0 #b10000000001 #b11)))
(assert (fp.leq (fp #b0 #b10000000001 #b11)
                expect
                (fp #b0 #b11111101001 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
