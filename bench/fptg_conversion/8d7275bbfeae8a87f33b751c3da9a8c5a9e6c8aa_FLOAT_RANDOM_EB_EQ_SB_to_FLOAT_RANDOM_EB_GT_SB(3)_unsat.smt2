(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01111 #b1101)
                arg1
                (fp #b1 #b01111 #b0000)))
(assert (fp.leq (fp #b1 #b01111 #b0000)
                arg1
                (fp #b0 #b01101 #b0011)))
; arg1 = -1.0

