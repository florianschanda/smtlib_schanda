(assert (= result ((_ to_fp 6 2) rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b101001 #b1)
                expect
                (fp #b1 #b011111 #b0)))
(assert (fp.leq (fp #b1 #b011111 #b0)
                expect
                (fp #b0 #b000000 #b1)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
