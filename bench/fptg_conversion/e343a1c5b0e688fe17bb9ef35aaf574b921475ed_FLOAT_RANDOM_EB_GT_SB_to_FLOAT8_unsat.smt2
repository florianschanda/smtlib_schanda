; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111100011011 #b000111)
                arg1
                (fp #b0 #b0000000000011001 #b010011)))
(assert (fp.leq (fp #b0 #b0000000000011001 #b010011)
                arg1
                (fp #b0 #b1010000001000000 #b110101)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0100)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b110 #b0101)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
