                expect
                (fp #b1 #b1000000000001001 #b000011000100000)))
(assert (fp.leq (fp #b1 #b1000000000001001 #b000011000100000)
                expect
                (fp #b0 #b0010111000110111 #b100100011101110)))

(assert (= expect result))

