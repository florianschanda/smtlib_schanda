; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101110 #b01000000001110000110110)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b1 #b00111001 #b10110100010110000100111)))
; arg1 = -14198738255872.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010110 #b0111001)
                expect
                (fp #b1 #b10101010 #b1001111)))
(assert (fp.leq (fp #b1 #b10101010 #b1001111)
                expect
                (fp #b1 #b10001011 #b0011110)))
; expect = -14224931684352.0

(assert (not (= expect result)))

(check-sat)
(exit)
