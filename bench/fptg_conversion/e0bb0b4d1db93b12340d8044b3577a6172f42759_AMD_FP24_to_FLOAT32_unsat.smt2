; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0101011101100011)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1111000 #b0110100001010001)))
; arg1 = 26078.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000110 #b10010110011011100100101)
                expect
                (fp #b0 #b10001101 #b10010111011110000000000)))
(assert (fp.leq (fp #b0 #b10001101 #b10010111011110000000000)
                expect
                (fp #b0 #b10011101 #b11111110101011010100100)))
; expect = 26078.0

(assert (not (= expect result)))

(check-sat)
(exit)
