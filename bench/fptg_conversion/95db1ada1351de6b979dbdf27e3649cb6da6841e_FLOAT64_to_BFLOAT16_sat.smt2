; Format from: FLOAT64
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100110010 #b0000000000101001110011110011101101111000110001111100)
                arg1
                (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)))
(assert (fp.leq (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)
                arg1
                (fp #b0 #b10110010101 #b0101011100111001001100110010011000011000000000010001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010101 #b1001001)
                expect
                (fp #b0 #b01111111 #b1010010)))
(assert (fp.leq (fp #b0 #b01111111 #b1010010)
                expect
                (fp #b0 #b10001010 #b0110111)))
; expect = 1.640625

(assert (= expect result))

(check-sat)
