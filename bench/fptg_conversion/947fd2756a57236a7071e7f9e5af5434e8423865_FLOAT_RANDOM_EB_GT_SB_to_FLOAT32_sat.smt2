(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011001011 #b10)
                arg1
                (fp #b1 #b0111111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111111 #b11)
                arg1
                (fp #b1 #b0110100011 #b11)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111110 #b01011011101001111000011)
                expect
                (fp #b1 #b01111111 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b11000000000000000000000)
                expect
                (fp #b0 #b11111010 #b11111000011001010101110)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
