; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0010001111011 #b0111)
                arg1
                (fp #b1 #b0000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000)
                arg1
                (fp #b0 #b1011101011100 #b0111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01010 #b0100100111)
                expect
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                expect
                (fp #b0 #b10011 #b0101000001)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
