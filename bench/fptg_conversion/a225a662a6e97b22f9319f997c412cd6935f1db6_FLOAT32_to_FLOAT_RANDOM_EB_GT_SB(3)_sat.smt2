(declare-const expect (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b010101001011111 #b011111110011)
                expect
                (fp #b0 #b100000001100001 #b001001010101)))
(assert (fp.leq (fp #b0 #b100000001100001 #b001001010101)
                expect
                (fp #b0 #b100111001000111 #b110110010001)))

(assert (= expect result))

(check-sat)
(exit)
