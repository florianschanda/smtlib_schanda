; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b01)
                arg1
                (fp #b0 #b011 #b11)))
(assert (fp.leq (fp #b0 #b011 #b11)
                arg1
                (fp #b0 #b111 #b00)))
; arg1 = 1.75

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b0 #b00 #b0)
                expect
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                expect
                (fp #b0 #b11 #b0)))
; expect = 2.0

(assert (not (= expect result)))

(check-sat)
(exit)
