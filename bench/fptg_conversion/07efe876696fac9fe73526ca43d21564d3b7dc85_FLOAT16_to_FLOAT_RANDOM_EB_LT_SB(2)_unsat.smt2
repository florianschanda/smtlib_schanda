(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0111101110)
                arg1
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg1
                (fp #b0 #b11000 #b1001000011)))
; arg1 = 0.000060975551605224609375

(declare-const result (_ FloatingPoint 3 4))
(assert (= result ((_ to_fp 3 4) rm arg1)))

(declare-const expect (_ FloatingPoint 3 4))
(assert (fp.leq (fp #b1 #b101 #b000)
                expect
                (fp #b0 #b000 #b001)))
(assert (fp.leq (fp #b0 #b000 #b001)
                expect
                (fp #b0 #b101 #b010)))
; expect = 0.03125

(assert (not (= expect result)))

(check-sat)
(exit)
