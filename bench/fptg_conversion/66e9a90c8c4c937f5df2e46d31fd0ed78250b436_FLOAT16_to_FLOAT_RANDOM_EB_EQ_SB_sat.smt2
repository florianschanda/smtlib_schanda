; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1100000111)
                arg1
                (fp #b0 #b01001 #b1111001110)))
(assert (fp.leq (fp #b0 #b01001 #b1111001110)
                arg1
                (fp #b0 #b10101 #b0001100011)))
; arg1 = 0.030487060546875

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00000110101 #b0101001110)
                expect
                (fp #b0 #b01111111001 #b1111001110)))
(assert (fp.leq (fp #b0 #b01111111001 #b1111001110)
                expect
                (fp #b0 #b10001011110 #b1101000001)))

(assert (= expect result))

(check-sat)
(exit)
