(assert (fp.leq (fp #b1 #b10110100 #b0110110)
                expect
                (fp #b1 #b01100110 #b1001111)))
(assert (fp.leq (fp #b1 #b01100110 #b1001111)
                expect
                (fp #b1 #b00010101 #b1010001)))
; expect = -0.00000004819594323635101318359375

(assert (= expect result))

