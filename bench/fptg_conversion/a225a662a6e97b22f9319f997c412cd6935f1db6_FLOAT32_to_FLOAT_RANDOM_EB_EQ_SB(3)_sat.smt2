(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011111101 #b001101100)
                expect
                (fp #b0 #b1001100001 #b001001011)))
(assert (fp.leq (fp #b0 #b1001100001 #b001001011)
                expect
                (fp #b0 #b1101000110 #b111110001)))

(assert (= expect result))

(check-sat)
(exit)
