(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10110110 #b000011000111010)
                expect
                (fp #b0 #b01111001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111001 #b000000000000000)
                expect
                (fp #b0 #b10010100 #b110001101101100)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
