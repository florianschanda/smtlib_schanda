(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b0 #b0101100000011 #b1)
                arg1
                (fp #b0 #b1000000000001 #b0)))
(assert (fp.leq (fp #b0 #b1000000000001 #b0)
                arg1
                (fp #b0 #b1001011101011 #b1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01100110 #b00001011101000111001101)
                expect
                (fp #b0 #b10000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b00000000000000000000000)
                expect
                (fp #b0 #b11101111 #b00011010110011010111111)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
