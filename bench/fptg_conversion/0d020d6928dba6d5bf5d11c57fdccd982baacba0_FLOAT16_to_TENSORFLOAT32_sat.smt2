; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b1011010010)
                arg1
                (fp #b0 #b00011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00011 #b0000000000)
                arg1
                (fp #b0 #b11010 #b1011001111)))
; arg1 = 0.000244140625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01010110 #b1011111000)
                expect
                (fp #b0 #b01110011 #b0000000000)))
(assert (fp.leq (fp #b0 #b01110011 #b0000000000)
                expect
                (fp #b0 #b10010111 #b0010110011)))
; expect = 0.000244140625

(assert (= expect result))

(check-sat)
(exit)
