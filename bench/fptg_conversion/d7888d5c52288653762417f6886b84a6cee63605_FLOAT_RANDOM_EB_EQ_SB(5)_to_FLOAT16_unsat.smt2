(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101100100100 #b11101000010011)
                arg1
                (fp #b1 #b100000000010011 #b01101001010110)))
(assert (fp.leq (fp #b1 #b100000000010011 #b01101001010110)
                arg1
                (fp #b1 #b001010100001001 #b00010101010011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
