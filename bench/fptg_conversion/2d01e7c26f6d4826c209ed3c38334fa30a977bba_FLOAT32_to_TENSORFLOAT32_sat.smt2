(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b11011000 #b01011000111000111001000)
                arg1
                (fp #b0 #b11110011 #b01001001100100010110011)))
(assert (fp.leq (fp #b0 #b11110011 #b01001001100100010110011)
                arg1
                (fp #b0 #b11111000 #b00000011010111010100111)))
; arg1 = 106950918570191514810027511577051136.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b10110011 #b1110000100)
                expect
                (fp #b0 #b11110011 #b0100100111)))
(assert (fp.leq (fp #b0 #b11110011 #b0100100111)
                expect
                (fp #b0 #b11110100 #b0001011011)))
; expect = 107009993068866213156745697785020416.0

(assert (= expect result))

(check-sat)
(exit)
