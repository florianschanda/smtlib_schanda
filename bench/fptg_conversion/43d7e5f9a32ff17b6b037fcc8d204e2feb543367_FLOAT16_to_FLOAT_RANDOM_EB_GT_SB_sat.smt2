                expect
                (fp #b1 #b01111111111110110 #b10)))
(assert (fp.leq (fp #b1 #b01111111111110110 #b10)
                expect
                (fp #b1 #b01001110000101100 #b11)))

(assert (= expect result))

(check-sat)
