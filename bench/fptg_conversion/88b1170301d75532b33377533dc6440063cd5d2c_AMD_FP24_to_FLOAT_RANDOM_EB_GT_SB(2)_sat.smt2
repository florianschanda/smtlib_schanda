(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0000101100101110)
                arg1
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg1
                (fp #b0 #b0111000 #b1100010001111100)))
; arg1 = -14354451791872.0

(declare-const result (_ FloatingPoint 16 14))
(assert (= result ((_ to_fp 16 14) rm arg1)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1010111111011110 #b0100001111010)
                expect
                (fp #b1 #b1000000000101010 #b1010000111001)))
(assert (fp.leq (fp #b1 #b1000000000101010 #b1010000111001)
                expect
                (fp #b0 #b1010010101010111 #b1010100010100)))

(assert (= expect result))

(check-sat)
(exit)
