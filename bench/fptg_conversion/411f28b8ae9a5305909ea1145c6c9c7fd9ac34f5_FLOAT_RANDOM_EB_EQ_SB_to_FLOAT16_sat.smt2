; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011001 #b110101)
                arg1
                (fp #b1 #b1000101 #b011101)))
(assert (fp.leq (fp #b1 #b1000101 #b011101)
                arg1
                (fp #b1 #b0001111 #b110011)))
; arg1 = -93.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1000100101)
                expect
                (fp #b1 #b10101 #b0111010000)))
(assert (fp.leq (fp #b1 #b10101 #b0111010000)
                expect
                (fp #b1 #b00100 #b1001001110)))
; expect = -93.0

(assert (= expect result))

(check-sat)
(exit)
