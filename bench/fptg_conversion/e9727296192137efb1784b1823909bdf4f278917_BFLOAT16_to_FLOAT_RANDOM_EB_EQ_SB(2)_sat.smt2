(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111001011100111 #b00110111001001)
                expect
                (fp #b1 #b011111111010110 #b00101010000000)))
(assert (fp.leq (fp #b1 #b011111111010110 #b00101010000000)
                expect
                (fp #b0 #b010111100010101 #b01100000000100)))

(assert (= expect result))

(check-sat)
(exit)
