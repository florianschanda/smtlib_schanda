(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000110110)
                arg1
                (fp #b1 #b11001 #b0000110001)))
(assert (fp.leq (fp #b1 #b11001 #b0000110001)
                arg1
                (fp #b0 #b01010 #b1100110000)))
; arg1 = -1073.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110000 #b01000000001101000000010)
                expect
                (fp #b1 #b10001001 #b00001100010000000000000)))
(assert (fp.leq (fp #b1 #b10001001 #b00001100010000000000000)
                expect
                (fp #b1 #b00010011 #b00001110011111001010110)))
; expect = -1073.0

(assert (not (= expect result)))

(check-sat)
(exit)
