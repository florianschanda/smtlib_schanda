; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0011101000)
                arg1
                (fp #b1 #b01111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111 #b0001011101)
                arg1
                (fp #b0 #b00111 #b1000011000)))
; arg1 = -1.0908203125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011010 #b111111100000111)
                expect
                (fp #b1 #b01111111 #b000101110100000)))
(assert (fp.leq (fp #b1 #b01111111 #b000101110100000)
                expect
                (fp #b1 #b01010111 #b000100011101001)))
; expect = -1.0908203125

(assert (= expect result))

(check-sat)
(exit)
