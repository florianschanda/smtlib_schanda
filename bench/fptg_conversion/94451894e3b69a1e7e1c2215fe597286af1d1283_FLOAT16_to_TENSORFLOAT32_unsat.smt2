(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0010110111)
                arg1
                (fp #b1 #b11000 #b1101001010)))
(assert (fp.leq (fp #b1 #b11000 #b1101001010)
                arg1
                (fp #b0 #b11001 #b1001000001)))
; arg1 = -933.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010011 #b1001000100)
                expect
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                expect
                (fp #b1 #b00111011 #b1111111001)))
; expect = -933.0

(assert (not (= expect result)))

(check-sat)
(exit)
