; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1100)
                arg1
                (fp #b0 #b011 #b0110)))
(assert (fp.leq (fp #b0 #b011 #b0110)
                arg1
                (fp #b0 #b110 #b0010)))
; arg1 = 1.375

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b001)
                expect
                (fp #b0 #b0111 #b011)))
(assert (fp.leq (fp #b0 #b0111 #b011)
                expect
                (fp #b0 #b1110 #b101)))
; expect = 1.375

(assert (= expect result))

(check-sat)
(exit)
