(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b0 #b0000 #b000)))
(assert (fp.leq (fp #b0 #b0000 #b000)
                arg1
                (fp #b0 #b0110 #b100)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 12 5))
(assert (= result ((_ to_fp 12 5) rm arg1)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011010011111 #b0001)
                expect
                (fp #b0 #b000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000)
                expect
                (fp #b0 #b001100010001 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
