; Format from: FLOAT32
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b11111010110010001010100)
                arg1
                (fp #b1 #b01010111 #b00100000111000001111100)))
(assert (fp.leq (fp #b1 #b01010111 #b00100000111000001111100)
                arg1
                (fp #b0 #b00001011 #b01110010011010001100110)))
; arg1 = -0.0000000000010263036080704335262225868063978850841522216796875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1110)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b011 #b0100)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
