; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1011110100100 #b0000)
                arg1
                (fp #b0 #b0111111111111 #b0110)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0110)
                arg1
                (fp #b0 #b1000101111010 #b1101)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b110)
                expect
                (fp #b0 #b0111 #b011)))
(assert (fp.leq (fp #b0 #b0111 #b011)
                expect
                (fp #b0 #b1111 #b000)))
; expect = 1.375

(assert (= expect result))

(check-sat)
(exit)
