(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b0 #b000 #b1110)))
(assert (fp.leq (fp #b0 #b000 #b1110)
                arg1
                (fp #b0 #b110 #b0100)))
; arg1 = 0.21875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010000 #b001001010100101)
                expect
                (fp #b0 #b01111100 #b110000000000000)))
(assert (fp.leq (fp #b0 #b01111100 #b110000000000000)
                expect
                (fp #b0 #b11111000 #b110000110101000)))
; expect = 0.21875

(assert (= expect result))

(check-sat)
(exit)
