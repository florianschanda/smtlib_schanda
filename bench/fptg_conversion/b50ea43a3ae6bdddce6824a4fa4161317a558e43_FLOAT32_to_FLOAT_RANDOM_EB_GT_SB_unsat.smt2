; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b11001100111000000010110)
                arg1
                (fp #b1 #b10010011 #b01111001100110011100000)))
(assert (fp.leq (fp #b1 #b10010011 #b01111001100110011100000)
                arg1
                (fp #b1 #b01000011 #b01000010011001101001111)))
; arg1 = -1546652.0

(declare-const result (_ FloatingPoint 7 3))
(assert (= result ((_ to_fp 7 3) rm arg1)))

(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1011101 #b11)
                expect
                (fp #b1 #b1010011 #b10)))
(assert (fp.leq (fp #b1 #b1010011 #b10)
                expect
                (fp #b1 #b0011011 #b01)))
; expect = -1572864.0

(assert (not (= expect result)))

(check-sat)
(exit)
