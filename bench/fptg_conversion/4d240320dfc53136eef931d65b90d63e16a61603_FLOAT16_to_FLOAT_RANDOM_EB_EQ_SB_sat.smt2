; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0101101011)
                arg1
                (fp #b1 #b11010 #b1011001111)))
(assert (fp.leq (fp #b1 #b11010 #b1011001111)
                arg1
                (fp #b0 #b01111 #b1011000101)))
; arg1 = -3486.0

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011100101 #b0110010000)
                expect
                (fp #b1 #b10000001010 #b1011001111)))
(assert (fp.leq (fp #b1 #b10000001010 #b1011001111)
                expect
                (fp #b1 #b00101110111 #b1111000100)))

(assert (= expect result))

(check-sat)
(exit)
