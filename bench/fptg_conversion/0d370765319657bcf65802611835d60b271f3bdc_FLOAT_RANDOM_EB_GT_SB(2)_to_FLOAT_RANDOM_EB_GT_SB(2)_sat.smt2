; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01110100101 #b11011)
                arg1
                (fp #b0 #b10000000100 #b11101)))
(assert (fp.leq (fp #b0 #b10000000100 #b11101)
                arg1
                (fp #b0 #b10010001011 #b10001)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0000 #b11)
                expect
                (fp #b0 #b1101 #b00)))
(assert (fp.leq (fp #b0 #b1101 #b00)
                expect
                (fp #b0 #b1110 #b00)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
