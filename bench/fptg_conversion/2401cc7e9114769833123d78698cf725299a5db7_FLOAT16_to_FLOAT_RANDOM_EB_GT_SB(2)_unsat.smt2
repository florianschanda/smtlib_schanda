; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1100101001)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11101 #b1100111000)))
; arg1 = 1671.0

(declare-const result (_ FloatingPoint 13 2))
(assert (= result ((_ to_fp 13 2) rm arg1)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1001110100100 #b0)
                expect
                (fp #b0 #b1000000001010 #b0)))
(assert (fp.leq (fp #b0 #b1000000001010 #b0)
                expect
                (fp #b0 #b1010011101010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
