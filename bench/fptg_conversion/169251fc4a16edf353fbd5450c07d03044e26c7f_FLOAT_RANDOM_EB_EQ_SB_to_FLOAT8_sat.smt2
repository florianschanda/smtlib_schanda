(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b1101)
                expect
                (fp #b0 #b110 #b1100)))
(assert (fp.leq (fp #b0 #b110 #b1100)
                expect
                (fp #b0 #b110 #b1101)))
; expect = 14.0

(assert (= expect result))

(check-sat)
