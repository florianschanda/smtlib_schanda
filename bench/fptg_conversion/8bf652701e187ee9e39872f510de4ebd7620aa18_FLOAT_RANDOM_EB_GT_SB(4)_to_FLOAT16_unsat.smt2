(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100010011000101 #b100)
                arg1
                (fp #b1 #b010000000000000 #b000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b000)
                arg1
                (fp #b0 #b010111111001101 #b000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00000 #b1101110110)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b01100 #b1111110000)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
