(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: PIXAR_PXR24
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110101 #b110110110001000)
                arg1
                (fp #b0 #b10001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b10001110 #b000110010000101)
                arg1
                (fp #b0 #b10011010 #b100100011110001)))
; arg1 = 35973.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000110111)
                expect
                (fp #b0 #b11110 #b0001100101)))
(assert (fp.leq (fp #b0 #b11110 #b0001100101)
                expect
                (fp #b0 #b11110 #b1001100110)))
; expect = 36000.0

(assert (= expect result))

(check-sat)
(exit)
