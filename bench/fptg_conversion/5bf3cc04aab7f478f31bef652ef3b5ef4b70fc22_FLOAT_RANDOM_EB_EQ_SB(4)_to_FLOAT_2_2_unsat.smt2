(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010011000110100 #b011010010101101)
                arg1
                (fp #b0 #b0100100001110011 #b110011000110011)))
(assert (fp.leq (fp #b0 #b0100100001110011 #b110011000110011)
                arg1
                (fp #b0 #b0111011100101000 #b100001110000010)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b10 #b1)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
