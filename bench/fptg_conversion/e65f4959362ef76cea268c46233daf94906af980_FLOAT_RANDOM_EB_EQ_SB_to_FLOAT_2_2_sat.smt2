; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100000011111 #b000000101111)
                arg1
                (fp #b1 #b0000000000000 #b001000111100)))
(assert (fp.leq (fp #b1 #b0000000000000 #b001000111100)
                arg1
                (fp #b0 #b1101011100010 #b100011010001)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b10 #b1)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
