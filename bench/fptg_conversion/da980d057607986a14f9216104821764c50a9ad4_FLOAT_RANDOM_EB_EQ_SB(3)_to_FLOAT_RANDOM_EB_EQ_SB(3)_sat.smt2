(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000110010 #b00110101101)
                expect
                (fp #b1 #b100011111110 #b11111111000)))
(assert (fp.leq (fp #b1 #b100011111110 #b11111111000)
                expect
                (fp #b0 #b010110101101 #b10001111110)))

(assert (= expect result))

(check-sat)
