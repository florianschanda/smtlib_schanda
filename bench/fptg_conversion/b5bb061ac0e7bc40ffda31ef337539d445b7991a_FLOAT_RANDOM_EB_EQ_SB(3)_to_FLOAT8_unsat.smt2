(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000011 #b011000001)
                arg1
                (fp #b1 #b0001111000 #b100101001)))
(assert (fp.leq (fp #b1 #b0001111000 #b100101001)
                arg1
                (fp #b1 #b0000001010 #b010111011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0010)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b101 #b0011)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
