; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0100100011011000 #b100101011100010)
                arg1
                (fp #b0 #b1000000000001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b000110010000101)
                arg1
                (fp #b0 #b1001101100101111 #b101101100001011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b0101001010)
                expect
                (fp #b0 #b11110 #b0001100101)))
(assert (fp.leq (fp #b0 #b11110 #b0001100101)
                expect
                (fp #b0 #b11110 #b1000011010)))
; expect = 36000.0

(assert (not (= expect result)))

(check-sat)
(exit)
