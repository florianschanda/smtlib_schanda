(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000110010)
                arg1
                (fp #b1 #b10110 #b0101001111)))
(assert (fp.leq (fp #b1 #b10110 #b0101001111)
                arg1
                (fp #b1 #b00111 #b1100011010)))
; arg1 = -169.875

(declare-const result (_ FloatingPoint 6 5))
(assert (= result ((_ to_fp 6 5) rm arg1)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b110111 #b0001)
                expect
                (fp #b1 #b100110 #b0110)))
(assert (fp.leq (fp #b1 #b100110 #b0110)
                expect
                (fp #b1 #b100011 #b1010)))
; expect = -176.0

(assert (= expect result))

(check-sat)
(exit)
