(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010111 #b100)
                arg1
                (fp #b0 #b011111 #b111)))
(assert (fp.leq (fp #b0 #b011111 #b111)
                arg1
                (fp #b0 #b101000 #b101)))
; arg1 = 1.875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0001110 #b1010110010011111)
                expect
                (fp #b0 #b0111111 #b1110000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1110000000000000)
                expect
                (fp #b0 #b1001110 #b0010001010010111)))
; expect = 1.875

(assert (= expect result))

(check-sat)
(exit)
