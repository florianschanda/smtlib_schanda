; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100101 #b0010001000110000)
                arg1
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                arg1
                (fp #b0 #b1100100 #b1001110001000111)))
; arg1 = 1.1314697265625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00001100 #b10001001001010111010100)
                expect
                (fp #b0 #b01111111 #b00100001101010000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00100001101010000000000)
                expect
                (fp #b0 #b11101110 #b01000100010111001100101)))
; expect = 1.1314697265625

(assert (not (= expect result)))

(check-sat)
(exit)
