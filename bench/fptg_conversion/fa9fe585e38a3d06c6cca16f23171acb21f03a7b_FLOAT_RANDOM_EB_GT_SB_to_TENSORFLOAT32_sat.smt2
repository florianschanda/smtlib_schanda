(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0010 #b11)
                arg1
                (fp #b0 #b1000 #b00)))
(assert (fp.leq (fp #b0 #b1000 #b00)
                arg1
                (fp #b0 #b1000 #b10)))
; arg1 = 2.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111011 #b1100110001)
                expect
                (fp #b0 #b10000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b0000000000)
                expect
                (fp #b0 #b11110111 #b1100011001)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
