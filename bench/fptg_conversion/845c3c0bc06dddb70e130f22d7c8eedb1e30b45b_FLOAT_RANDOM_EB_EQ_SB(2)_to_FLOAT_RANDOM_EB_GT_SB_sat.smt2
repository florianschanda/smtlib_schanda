(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b0 #b0110 #b101)))
; arg1 = -1.625

(declare-const result (_ FloatingPoint 7 2))
(assert (= result ((_ to_fp 7 2) rm arg1)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1100001 #b1)
                expect
                (fp #b1 #b1000000 #b0)))
(assert (fp.leq (fp #b1 #b1000000 #b0)
                expect
                (fp #b1 #b0111001 #b1)))
; expect = -2.0

(assert (= expect result))

(check-sat)
(exit)
