; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10010011 #b0)
                arg1
                (fp #b1 #b10000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000 #b1)
                arg1
                (fp #b0 #b00110000 #b0)))
; arg1 = -3.0

(declare-const result (_ FloatingPoint 12 9))
(assert (= result ((_ to_fp 12 9) rm arg1)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110000100011 #b10010001)
                expect
                (fp #b1 #b100000000000 #b10000000)))
(assert (fp.leq (fp #b1 #b100000000000 #b10000000)
                expect
                (fp #b0 #b100101010000 #b10000111)))

(assert (= expect result))

(check-sat)
(exit)
