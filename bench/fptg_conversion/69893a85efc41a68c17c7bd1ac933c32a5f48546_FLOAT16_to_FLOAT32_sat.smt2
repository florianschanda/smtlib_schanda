; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111100010)
                arg1
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg1
                (fp #b1 #b01011 #b1100001001)))
; arg1 = -25296.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100010 #b01110100111101101100111)
                expect
                (fp #b1 #b10001101 #b10001011010000000000000)))
(assert (fp.leq (fp #b1 #b10001101 #b10001011010000000000000)
                expect
                (fp #b0 #b10110010 #b11100001011011100111000)))
; expect = -25296.0

(assert (= expect result))

(check-sat)
(exit)
