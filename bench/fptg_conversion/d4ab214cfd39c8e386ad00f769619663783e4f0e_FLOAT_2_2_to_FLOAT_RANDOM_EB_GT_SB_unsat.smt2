; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b01 #b0)))
(assert (fp.leq (fp #b0 #b01 #b0)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 12 9))
(assert (= result ((_ to_fp 12 9) rm arg1)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110011001001 #b10110000)
                expect
                (fp #b0 #b011111111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b00000000)
                expect
                (fp #b0 #b110110110101 #b11101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
