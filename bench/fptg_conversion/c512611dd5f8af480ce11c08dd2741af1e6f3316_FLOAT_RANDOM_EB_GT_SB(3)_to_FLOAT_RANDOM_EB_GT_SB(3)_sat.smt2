; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b011000 #b0)
                arg1
                (fp #b0 #b100000 #b1)))
(assert (fp.leq (fp #b0 #b100000 #b1)
                arg1
                (fp #b0 #b110101 #b0)))
; arg1 = 3.0

(declare-const result (_ FloatingPoint 16 12))
(assert (= result ((_ to_fp 16 12) rm arg1)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b0010011101111100 #b10100101001)
                expect
                (fp #b0 #b1000000000000000 #b10000000000)))
(assert (fp.leq (fp #b0 #b1000000000000000 #b10000000000)
                expect
                (fp #b0 #b1111001010101011 #b01110110011)))

(assert (= expect result))

(check-sat)
(exit)
