; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011101 #b1100000)
                arg1
                (fp #b1 #b10000110 #b0011101)))
(assert (fp.leq (fp #b1 #b10000110 #b0011101)
                arg1
                (fp #b1 #b01010011 #b0010001)))
; arg1 = -157.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110100100 #b10100110000)
                expect
                (fp #b1 #b100000000110 #b00111010000)))
(assert (fp.leq (fp #b1 #b100000000110 #b00111010000)
                expect
                (fp #b1 #b011111100100 #b00010000100)))

(assert (= expect result))

(check-sat)
(exit)
