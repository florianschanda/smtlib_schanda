(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b000 #b1100)))
(assert (fp.leq (fp #b0 #b000 #b1100)
                arg1
                (fp #b0 #b011 #b0110)))
; arg1 = 0.1875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010000 #b101110001000011)
                expect
                (fp #b0 #b01111100 #b100000000000000)))
(assert (fp.leq (fp #b0 #b01111100 #b100000000000000)
                expect
                (fp #b0 #b10010111 #b001101111110110)))
; expect = 0.1875

(assert (= expect result))

(check-sat)
(exit)
