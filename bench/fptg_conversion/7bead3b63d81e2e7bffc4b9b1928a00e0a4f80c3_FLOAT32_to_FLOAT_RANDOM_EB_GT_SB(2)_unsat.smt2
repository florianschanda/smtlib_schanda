(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010011 #b00000100110101010100000)
                arg1
                (fp #b0 #b10010110 #b11001001000000101010001)))
(assert (fp.leq (fp #b0 #b10010110 #b11001001000000101010001)
                arg1
                (fp #b0 #b10011011 #b01110101101001010001100)))
; arg1 = 14975313.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result ((_ to_fp 6 3) rm arg1)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b110001 #b00)
                expect
                (fp #b0 #b110111 #b00)))
(assert (fp.leq (fp #b0 #b110111 #b00)
                expect
                (fp #b0 #b111101 #b11)))
; expect = 16777216.0

(assert (not (= expect result)))

(check-sat)
(exit)
