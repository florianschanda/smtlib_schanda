; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000110 #b1100001101000011)
                arg1
                (fp #b0 #b0111111 #b1000110111010011)))
(assert (fp.leq (fp #b0 #b0111111 #b1000110111010011)
                arg1
                (fp #b0 #b1110100 #b1111101110001000)))
; arg1 = 1.5540008544921875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001001 #b0011101)
                expect
                (fp #b0 #b01111111 #b1000111)))
(assert (fp.leq (fp #b0 #b01111111 #b1000111)
                expect
                (fp #b0 #b11100011 #b1011101)))
; expect = 1.5546875

(assert (not (= expect result)))

(check-sat)
(exit)
