; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101011 #b1100110)
                arg1
                (fp #b0 #b11100000 #b0011100)))
(assert (fp.leq (fp #b0 #b11100000 #b0011100)
                arg1
                (fp #b0 #b11101000 #b1001110)))
; arg1 = 193118646128519322884263378944.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
