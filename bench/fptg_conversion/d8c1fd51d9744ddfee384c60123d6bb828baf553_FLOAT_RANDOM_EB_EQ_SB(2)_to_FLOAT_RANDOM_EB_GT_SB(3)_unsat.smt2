(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b110 #b01)))
(assert (fp.leq (fp #b0 #b110 #b01)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 10.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result ((_ to_fp 6 2) rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b011101 #b0)
                expect
                (fp #b0 #b100010 #b1)))
(assert (fp.leq (fp #b0 #b100010 #b1)
                expect
                (fp #b0 #b100100 #b0)))
; expect = 12.0

(assert (not (= expect result)))

(check-sat)
(exit)
