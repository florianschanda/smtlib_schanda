(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100010 #b111101110)
                arg1
                (fp #b0 #b0000000001 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000001 #b000000000)
                arg1
                (fp #b0 #b0011011100 #b001101110)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101100 #b1000001111101000)
                expect
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b0100001 #b0000100101010100)))
; expect = 0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(assert (= expect result))

(check-sat)
(exit)
