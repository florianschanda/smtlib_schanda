(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b110 #b0100)))
(assert (fp.leq (fp #b0 #b110 #b0100)
                arg1
                (fp #b0 #b110 #b0111)))
; arg1 = 10.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b1101101101)
                expect
                (fp #b0 #b10010 #b0100000000)))
(assert (fp.leq (fp #b0 #b10010 #b0100000000)
                expect
                (fp #b0 #b11110 #b1010001000)))
; expect = 10.0

(assert (= expect result))

(check-sat)
(exit)
