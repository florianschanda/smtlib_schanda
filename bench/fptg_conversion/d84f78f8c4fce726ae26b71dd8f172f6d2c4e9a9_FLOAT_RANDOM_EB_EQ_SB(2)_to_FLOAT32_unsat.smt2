(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0000)
                arg1
                (fp #b1 #b10010 #b0011)))
(assert (fp.leq (fp #b1 #b10010 #b0011)
                arg1
                (fp #b1 #b10000 #b1100)))
; arg1 = -9.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b11100110100100100000000)
                expect
                (fp #b1 #b10000010 #b00110000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b00110000000000000000000)
                expect
                (fp #b0 #b00100010 #b11011001111100010011100)))
; expect = -9.5

(assert (not (= expect result)))

(check-sat)
(exit)
