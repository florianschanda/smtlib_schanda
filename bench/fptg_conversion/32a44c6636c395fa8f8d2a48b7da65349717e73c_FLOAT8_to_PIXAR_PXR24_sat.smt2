; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0011)
                arg1
                (fp #b0 #b101 #b1001)))
(assert (fp.leq (fp #b0 #b101 #b1001)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 6.25

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110001 #b110011001111001)
                expect
                (fp #b0 #b10000001 #b100100000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b100100000000000)
                expect
                (fp #b0 #b11000000 #b000100011011100)))
; expect = 6.25

(assert (= expect result))

(check-sat)
(exit)
