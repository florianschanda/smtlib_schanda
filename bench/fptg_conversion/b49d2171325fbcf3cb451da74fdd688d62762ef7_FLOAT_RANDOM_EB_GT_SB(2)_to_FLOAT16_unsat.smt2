; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b100 #b0)
                arg1
                (fp #b1 #b011 #b1)))
(assert (fp.leq (fp #b1 #b011 #b1)
                arg1
                (fp #b0 #b000 #b0)))
; arg1 = -1.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0111100001)
                expect
                (fp #b1 #b01111 #b1000000000)))
(assert (fp.leq (fp #b1 #b01111 #b1000000000)
                expect
                (fp #b1 #b01101 #b0001100010)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
