; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b1)
                arg1
                (fp #b0 #b101 #b0)))
(assert (fp.leq (fp #b0 #b101 #b0)
                arg1
                (fp #b0 #b101 #b1)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010101 #b0100110100)
                expect
                (fp #b0 #b10000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b0000000000)
                expect
                (fp #b0 #b11000111 #b0001011110)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
