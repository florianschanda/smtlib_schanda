(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b11001 #b1100100010)
                arg1
                (fp #b0 #b11101 #b1000010010)))
(assert (fp.leq (fp #b0 #b11101 #b1000010010)
                arg1
                (fp #b0 #b11110 #b1010101010)))
; arg1 = 24864.0

(declare-const result (_ FloatingPoint 16 4))
(assert (= result ((_ to_fp 16 4) rm arg1)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0010010101101010 #b010)
                expect
                (fp #b0 #b1000000000001101 #b101)))
(assert (fp.leq (fp #b0 #b1000000000001101 #b101)
                expect
                (fp #b0 #b1000001111110010 #b011)))

(assert (= expect result))

(check-sat)
(exit)
