; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011101 #b1100000)
                arg1
                (fp #b1 #b10000110 #b0011101)))
(assert (fp.leq (fp #b1 #b10000110 #b0011101)
                arg1
                (fp #b1 #b01010011 #b0010001)))
; arg1 = -157.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011111000 #b100001000)
                expect
                (fp #b1 #b1000000110 #b001110100)))
(assert (fp.leq (fp #b1 #b1000000110 #b001110100)
                expect
                (fp #b0 #b1100111010 #b001111010)))

(assert (= expect result))

(check-sat)
(exit)
