(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011001 #b111000000)
                arg1
                (fp #b0 #b0011100110 #b101001010)))
(assert (fp.leq (fp #b0 #b0011100110 #b101001010)
                arg1
                (fp #b0 #b0100000010 #b001110110)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b1100001001)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b11010 #b0101001000)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
