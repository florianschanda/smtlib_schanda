(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1101100001011 #b0010100001)
                arg1
                (fp #b1 #b0111111111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b0111111111111 #b1111110100)
                arg1
                (fp #b1 #b0001111000010 #b0000010000)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0101)
                expect
                (fp #b1 #b100 #b0000)))
(assert (fp.leq (fp #b1 #b100 #b0000)
                expect
                (fp #b1 #b010 #b0100)))
; expect = -2.0

(assert (= expect result))

(check-sat)
(exit)
