; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b0)
                arg1
                (fp #b0 #b011 #b1)))
(assert (fp.leq (fp #b0 #b011 #b1)
                arg1
                (fp #b0 #b101 #b1)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01111000100 #b1101111000)
                expect
                (fp #b0 #b01111111111 #b1000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b1000000000)
                expect
                (fp #b0 #b10111001111 #b1000111101)))

(assert (= expect result))

(check-sat)
(exit)
