(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b000111 #b0)
                arg1
                (fp #b0 #b011111 #b1)))
(assert (fp.leq (fp #b0 #b011111 #b1)
                arg1
                (fp #b0 #b100100 #b1)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b01010 #b1101)
                expect
                (fp #b0 #b01111 #b1000)))
(assert (fp.leq (fp #b0 #b01111 #b1000)
                expect
                (fp #b0 #b10110 #b0010)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
