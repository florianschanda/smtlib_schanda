(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0000110111)
                arg1
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg1
                (fp #b0 #b01000 #b0100111110)))
; arg1 = 0.00006103515625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0110110110110000)
                expect
                (fp #b0 #b0110001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0110001 #b0000000000000000)
                expect
                (fp #b0 #b1101001 #b1111001110101101)))
; expect = 0.00006103515625

(assert (not (= expect result)))

(check-sat)
(exit)
