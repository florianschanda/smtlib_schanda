                expect
                (fp #b1 #b1000011 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1000011 #b0000000000000000)
                expect
                (fp #b1 #b0010110 #b1000011011011100)))
; expect = -16.0

(assert (not (= expect result)))

