; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0001001011)
                arg1
                (fp #b0 #b00001 #b0001001010)))
(assert (fp.leq (fp #b0 #b00001 #b0001001010)
                arg1
                (fp #b0 #b10001 #b0110011111)))
; arg1 = 0.00006544589996337890625

(declare-const result (_ FloatingPoint 15 8))
(assert (= result ((_ to_fp 15 8) rm arg1)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b0 #b011110001010011 #b0111001)
                expect
                (fp #b0 #b011111111110001 #b0001010)))
(assert (fp.leq (fp #b0 #b011111111110001 #b0001010)
                expect
                (fp #b0 #b101011001001010 #b1100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
