(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg1
                (fp #b1 #b110 #b1100)))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg1
                (fp #b1 #b110 #b0001)))
; arg1 = -14.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result ((_ to_fp 8 2) rm arg1)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10000110 #b1)
                expect
                (fp #b1 #b10000011 #b0)))
(assert (fp.leq (fp #b1 #b10000011 #b0)
                expect
                (fp #b0 #b00010011 #b0)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
(exit)
