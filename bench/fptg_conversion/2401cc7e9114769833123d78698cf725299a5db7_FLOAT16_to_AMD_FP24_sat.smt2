(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1100101001)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11101 #b1100111000)))
; arg1 = 1671.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b1010110010010000)
                expect
                (fp #b0 #b1001001 #b1010000111000000)))
(assert (fp.leq (fp #b0 #b1001001 #b1010000111000000)
                expect
                (fp #b0 #b1110101 #b1110010010110100)))
; expect = 1671.0

(assert (= expect result))

(check-sat)
(exit)
