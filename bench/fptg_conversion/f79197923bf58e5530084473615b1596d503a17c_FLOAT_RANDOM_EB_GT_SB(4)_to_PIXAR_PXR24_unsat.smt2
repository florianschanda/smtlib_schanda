(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b111111111111110 #b0000000000010)
                arg1
                (fp #b1 #b111111111111101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b0000000000000)
                arg1
                (fp #b0 #b101101110011110 #b0111010111100)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

