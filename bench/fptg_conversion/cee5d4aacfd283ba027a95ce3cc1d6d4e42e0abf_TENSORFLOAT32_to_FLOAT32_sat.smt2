(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001100 #b1011011110)
                arg1
                (fp #b1 #b10001000 #b1100000110)))
(assert (fp.leq (fp #b1 #b10001000 #b1100000110)
                arg1
                (fp #b0 #b01000110 #b0010100001)))
; arg1 = -899.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110000 #b01010010101110110011110)
                expect
                (fp #b1 #b10001000 #b11000001100000000000000)))
(assert (fp.leq (fp #b1 #b10001000 #b11000001100000000000000)
                expect
                (fp #b1 #b00100000 #b11101000110000010000001)))
; expect = -899.0

(assert (= expect result))

(check-sat)
(exit)
