; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110011 #b11111010110010001010100)
                arg1
                (fp #b1 #b01010111 #b00100000111000001111100)))
(assert (fp.leq (fp #b1 #b01010111 #b00100000111000001111100)
                arg1
                (fp #b0 #b00001011 #b01110010011010001100110)))
; arg1 = -0.0000000000010263036080704335262225868063978850841522216796875

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100100101011 #b00011110101)
                expect
                (fp #b1 #b011111010111 #b00100001000)))
(assert (fp.leq (fp #b1 #b011111010111 #b00100001000)
                expect
                (fp #b0 #b011011011011 #b11100010101)))

(assert (= expect result))

(check-sat)
(exit)
