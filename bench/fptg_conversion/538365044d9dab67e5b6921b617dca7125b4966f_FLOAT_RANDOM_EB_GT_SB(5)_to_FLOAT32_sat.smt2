(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101100100 #b1111100)
                arg1
                (fp #b1 #b100000110 #b0011101)))
(assert (fp.leq (fp #b1 #b100000110 #b0011101)
                arg1
                (fp #b0 #b001100001 #b1000011)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b01010101000010000010010)
                expect
                (fp #b1 #b10000110 #b00111010000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b00111010000000000000000)
                expect
                (fp #b0 #b11101101 #b00010011001000001000111)))
; expect = -157.0

(assert (= expect result))

(check-sat)
(exit)
