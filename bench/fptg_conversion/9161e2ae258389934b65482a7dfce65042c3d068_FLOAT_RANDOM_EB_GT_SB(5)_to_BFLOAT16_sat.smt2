; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00111 #b11)
                arg1
                (fp #b1 #b00111 #b00)))
(assert (fp.leq (fp #b1 #b00111 #b00)
                arg1
                (fp #b0 #b11100 #b10)))
; arg1 = -0.00390625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010100 #b1111100)
                expect
                (fp #b1 #b01110111 #b0000000)))
(assert (fp.leq (fp #b1 #b01110111 #b0000000)
                expect
                (fp #b1 #b00110000 #b0010011)))
; expect = -0.00390625

(assert (= expect result))

(check-sat)
(exit)
