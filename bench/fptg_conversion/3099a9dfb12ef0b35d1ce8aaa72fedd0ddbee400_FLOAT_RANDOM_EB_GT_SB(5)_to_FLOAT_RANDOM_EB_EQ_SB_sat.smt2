(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101100001101111 #b11010011100110)
                expect
                (fp #b1 #b100111010111000 #b00101000000000)))
(assert (fp.leq (fp #b1 #b100111010111000 #b00101000000000)
                expect
                (fp #b1 #b011100110011010 #b01010011000110)))

(assert (= expect result))

(check-sat)
(exit)
