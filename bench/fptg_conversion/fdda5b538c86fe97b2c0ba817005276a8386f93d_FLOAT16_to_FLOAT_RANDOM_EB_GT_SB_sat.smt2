(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1001000011)
                arg1
                (fp #b0 #b01101 #b0001011010)))
(assert (fp.leq (fp #b0 #b01101 #b0001011010)
                arg1
                (fp #b0 #b10001 #b1101100110)))
; arg1 = 0.27197265625

(declare-const result (_ FloatingPoint 7 4))
(assert (= result ((_ to_fp 7 4) rm arg1)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b1101100 #b011)
                expect
                (fp #b0 #b0111101 #b001)))
(assert (fp.leq (fp #b0 #b0111101 #b001)
                expect
                (fp #b0 #b1100001 #b010)))
; expect = 0.28125

(assert (= expect result))

(check-sat)
(exit)
