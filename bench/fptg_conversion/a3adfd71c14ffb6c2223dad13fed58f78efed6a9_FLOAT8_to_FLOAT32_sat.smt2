(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b1111)))
(assert (fp.leq (fp #b0 #b000 #b1111)
                arg1
                (fp #b0 #b101 #b1110)))
; arg1 = 0.234375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00100010 #b10000110101111111110001)
                expect
                (fp #b0 #b01111100 #b11100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111100 #b11100000000000000000000)
                expect
                (fp #b0 #b11010011 #b00010101101110000001000)))
; expect = 0.234375

(assert (= expect result))

(check-sat)
(exit)
