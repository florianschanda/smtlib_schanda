(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b00100100110 #b0111111)
                arg1
                (fp #b0 #b01111111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000)
                arg1
                (fp #b0 #b10100000100 #b1100011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b1010001101)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b10001 #b1100111101)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
