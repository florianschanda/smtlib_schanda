(assert (fp.leq (fp #b1 #b11000 #b0)
                expect
                (fp #b0 #b00000 #b1)))
(assert (fp.leq (fp #b0 #b00000 #b1)
                expect
                (fp #b0 #b10101 #b1)))
; expect = 0.000030517578125

(assert (= expect result))

