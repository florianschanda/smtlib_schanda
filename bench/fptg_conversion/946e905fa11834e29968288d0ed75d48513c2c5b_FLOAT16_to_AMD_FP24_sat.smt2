; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1111011110)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b10100 #b0001011101)))
; arg1 = -1809.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001100 #b0110011001110011)
                expect
                (fp #b1 #b1001001 #b1100010001000000)))
(assert (fp.leq (fp #b1 #b1001001 #b1100010001000000)
                expect
                (fp #b0 #b1000111 #b1011101100011011)))
; expect = -1809.0

(assert (= expect result))

(check-sat)
(exit)
