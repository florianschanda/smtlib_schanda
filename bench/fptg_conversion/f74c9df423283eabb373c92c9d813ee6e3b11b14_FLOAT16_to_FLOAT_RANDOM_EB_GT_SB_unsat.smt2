(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110000011)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b1 #b01111 #b1000100111)))
; arg1 = -255.875

(declare-const result (_ FloatingPoint 11 2))
(assert (= result ((_ to_fp 11 2) rm arg1)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10010100110 #b1)
                expect
                (fp #b1 #b10000000111 #b0)))
(assert (fp.leq (fp #b1 #b10000000111 #b0)
                expect
                (fp #b1 #b00111001010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
