(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b1100010011010000)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b0 #b1101101 #b1010010011101010)))
; arg1 = -1.417633056640625

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b000)
                expect
                (fp #b1 #b0111 #b100)))
(assert (fp.leq (fp #b1 #b0111 #b100)
                expect
                (fp #b0 #b0100 #b111)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
