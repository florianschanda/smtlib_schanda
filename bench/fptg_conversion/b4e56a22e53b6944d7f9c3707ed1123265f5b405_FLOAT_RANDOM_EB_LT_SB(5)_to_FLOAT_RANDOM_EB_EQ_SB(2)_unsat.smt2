; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 20))
(assert (fp.leq (fp #b1 #b111111001110110 #b1101011011001110100)
                arg1
                (fp #b0 #b000000000000000 #b0000000000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000000000000001)
                arg1
                (fp #b0 #b111101101100101 #b0111001110110101100)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b10)
                expect
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                expect
                (fp #b0 #b110 #b00)))
; expect = 0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
