(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100010 #b00110001000011001100101)
                expect
                (fp #b1 #b01111111 #b11110010001100100000000)))
(assert (fp.leq (fp #b1 #b01111111 #b11110010001100100000000)
                expect
                (fp #b0 #b10011011 #b01110100110111110011010)))
; expect = -1.946075439453125

(assert (not (= expect result)))

(check-sat)
