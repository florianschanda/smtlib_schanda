; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b101001101010 #b1)
                arg1
                (fp #b1 #b100001110000 #b1)))
(assert (fp.leq (fp #b1 #b100001110000 #b1)
                arg1
                (fp #b1 #b000110001001 #b1)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110111 #b01110000)
                expect
                (fp #b1 #b101110000 #b10000000)))
(assert (fp.leq (fp #b1 #b101110000 #b10000000)
                expect
                (fp #b0 #b110011110 #b01101010)))

(assert (= expect result))

(check-sat)
(exit)
