; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b1 #b000 #b1000)))
(assert (fp.leq (fp #b1 #b000 #b1000)
                arg1
                (fp #b0 #b001 #b0110)))
; arg1 = -0.125

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100100011 #b0011100010101001011101011001100000011010011001010110)
                expect
                (fp #b1 #b01111111100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00100110011 #b1000111110010000001011010111100110110000000010001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
