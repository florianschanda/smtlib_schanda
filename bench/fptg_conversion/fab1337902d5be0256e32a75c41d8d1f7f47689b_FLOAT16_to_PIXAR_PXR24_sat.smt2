(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1101011010)
                arg1
                (fp #b0 #b11010 #b0000000000)))
(assert (fp.leq (fp #b0 #b11010 #b0000000000)
                arg1
                (fp #b0 #b11100 #b0101000111)))
; arg1 = 2048.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01100010 #b011101100110001)
                expect
                (fp #b0 #b10001010 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001010 #b000000000000000)
                expect
                (fp #b0 #b10011001 #b110100011001010)))
; expect = 2048.0

(assert (= expect result))

(check-sat)
(exit)
