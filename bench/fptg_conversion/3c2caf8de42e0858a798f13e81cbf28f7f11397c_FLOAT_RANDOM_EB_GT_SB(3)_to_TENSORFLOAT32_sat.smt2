(assert (fp.leq (fp #b1 #b10001110 #b1100000010)
                expect
                (fp #b1 #b10000001 #b1000000000)))
(assert (fp.leq (fp #b1 #b10000001 #b1000000000)
                expect
                (fp #b0 #b00000000 #b1110100101)))
; expect = -6.0

(assert (= expect result))

