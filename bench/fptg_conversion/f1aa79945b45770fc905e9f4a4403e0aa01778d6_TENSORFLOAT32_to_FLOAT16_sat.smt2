(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010010 #b0010011111)
                arg1
                (fp #b0 #b10001001 #b1111110011)))
(assert (fp.leq (fp #b0 #b10001001 #b1111110011)
                arg1
                (fp #b0 #b10110001 #b0000110000)))
; arg1 = 2035.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00100 #b0011111101)
                expect
                (fp #b0 #b11001 #b1111110011)))
(assert (fp.leq (fp #b0 #b11001 #b1111110011)
                expect
                (fp #b0 #b11010 #b1101001001)))
; expect = 2035.0

(assert (= expect result))

(check-sat)
(exit)
