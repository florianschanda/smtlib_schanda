; Format from: FLOAT32
; Format to: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg1 = 11601303.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01011110100 #b1000100011100100010011001010101001011101001111000100)
                expect
                (fp #b0 #b10000010110 #b0110001000001011001011100000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010110 #b0110001000001011001011100000000000000000000000000000)
                expect
                (fp #b0 #b10010010100 #b0010110000110011011110100011111111011111101100010010)))

(assert (= expect result))

(check-sat)
(exit)
