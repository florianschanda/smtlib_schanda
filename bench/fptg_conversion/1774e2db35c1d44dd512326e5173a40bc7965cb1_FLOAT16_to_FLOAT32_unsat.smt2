(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b01110011011001101010111)
                expect
                (fp #b0 #b10001101 #b10000100100000000000000)))
(assert (fp.leq (fp #b0 #b10001101 #b10000100100000000000000)
                expect
                (fp #b0 #b10110010 #b11111011100010001110010)))
; expect = 24864.0

(assert (not (= expect result)))

(check-sat)
(exit)
