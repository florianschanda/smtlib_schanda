; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010001 #b1111101001011001)
                arg1
                (fp #b0 #b1001110 #b1110100110010000)))
(assert (fp.leq (fp #b0 #b1001110 #b1110100110010000)
                arg1
                (fp #b0 #b1010000 #b0110010110011001)))
; arg1 = 62664.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001010 #b01101010011010111011011)
                expect
                (fp #b0 #b10001110 #b11101001100100000000000)))
(assert (fp.leq (fp #b0 #b10001110 #b11101001100100000000000)
                expect
                (fp #b0 #b10010100 #b00011111110110011001110)))
; expect = 62664.0

(assert (not (= expect result)))

(check-sat)
(exit)
