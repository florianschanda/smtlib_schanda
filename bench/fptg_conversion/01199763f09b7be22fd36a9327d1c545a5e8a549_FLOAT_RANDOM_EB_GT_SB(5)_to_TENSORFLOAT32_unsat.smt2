; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -RCP_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b111110 #b1)
                arg1
                (fp #b1 #b111110 #b0)))
(assert (fp.leq (fp #b1 #b111110 #b0)
                arg1
                (fp #b0 #b011000 #b0)))
; arg1 = -2147483648.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100001 #b0010110001)
                expect
                (fp #b1 #b10011110 #b0000000000)))
(assert (fp.leq (fp #b1 #b10011110 #b0000000000)
                expect
                (fp #b1 #b00101000 #b0101001100)))
; expect = -2147483648.0

(assert (not (= expect result)))

(check-sat)
(exit)
