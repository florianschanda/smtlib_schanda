(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_2_2
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01001101 #b01100011000110001111011)
                arg1
                (fp #b1 #b00000000 #b00000011000101111010001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000011000101111010001)
                arg1
                (fp #b0 #b11010100 #b10011011111110110101101)))
; arg1 = -0.00000000000000000000000000000000000000014199217209156938897963059494518391166649766230840546663637197213826864061747556888803956098854541778564453125

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b01 #b0)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
