; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111100 #b100)
                arg1
                (fp #b0 #b01111111 #b001)))
(assert (fp.leq (fp #b0 #b01111111 #b001)
                arg1
                (fp #b0 #b11110000 #b111)))
; arg1 = 1.125

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011001010 #b00110011)
                expect
                (fp #b0 #b011111111 #b00100000)))
(assert (fp.leq (fp #b0 #b011111111 #b00100000)
                expect
                (fp #b0 #b100100101 #b10010011)))

(assert (= expect result))

(check-sat)
(exit)
