(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1001010111)
                arg1
                (fp #b0 #b11001 #b0101110010)))
(assert (fp.leq (fp #b0 #b11001 #b0101110010)
                arg1
                (fp #b0 #b11100 #b0100000100)))
; arg1 = 1394.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01100000 #b1101101)
                expect
                (fp #b0 #b10001001 #b0101111)))
(assert (fp.leq (fp #b0 #b10001001 #b0101111)
                expect
                (fp #b0 #b10001001 #b0111000)))
; expect = 1400.0

(assert (not (= expect result)))

(check-sat)
(exit)
