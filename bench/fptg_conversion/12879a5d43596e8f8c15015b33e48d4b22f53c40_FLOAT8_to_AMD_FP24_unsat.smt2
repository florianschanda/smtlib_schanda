; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1100)
                arg1
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                arg1
                (fp #b0 #b110 #b0100)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101001 #b1111001110100100)
                expect
                (fp #b0 #b1000001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000001 #b0000000000000000)
                expect
                (fp #b0 #b1010101 #b1111000100101101)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
