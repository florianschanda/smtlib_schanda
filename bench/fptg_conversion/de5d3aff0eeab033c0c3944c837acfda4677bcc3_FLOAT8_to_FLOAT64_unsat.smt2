(assert (fp.leq (fp #b1 #b11011010010 #b0100001000001010000110001000000101011101011111110101)
                expect
                (fp #b1 #b01111111101 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111101 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01011101110 #b0001110011100111101010100000000001101000000000010101)))

(assert (not (= expect result)))

