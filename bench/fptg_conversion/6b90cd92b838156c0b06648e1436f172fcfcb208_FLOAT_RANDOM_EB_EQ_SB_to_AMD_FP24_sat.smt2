(assert (fp.leq (fp #b1 #b0010000 #b0011110011000000)
                expect
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b0000101 #b0001111010101111)))
; expect = -0.000000000000000000000003308722450212110699485634768279851414263248443603515625

