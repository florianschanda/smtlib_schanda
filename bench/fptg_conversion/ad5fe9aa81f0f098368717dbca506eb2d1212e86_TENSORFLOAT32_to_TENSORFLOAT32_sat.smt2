(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: TENSORFLOAT32
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b0010000100)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b1 #b00000100 #b0000010110)))
; arg1 = -2048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011101 #b1010001000)
                expect
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                expect
                (fp #b0 #b01111110 #b0100110110)))
; expect = -2048.0

(assert (= expect result))

(check-sat)
(exit)
