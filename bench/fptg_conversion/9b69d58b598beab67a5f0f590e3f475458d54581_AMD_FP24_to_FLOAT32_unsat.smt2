                expect
                (fp #b0 #b01000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000001 #b00000000000000000000000)
                expect
                (fp #b0 #b11001111 #b01001101010110000101110)))
; expect = 0.00000000000000000021684043449710088680149056017398834228515625

(assert (not (= expect result)))

