(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001110 #b01001)
                arg1
                (fp #b1 #b000000 #b10001)))
(assert (fp.leq (fp #b1 #b000000 #b10001)
                arg1
                (fp #b0 #b100100 #b00000)))
