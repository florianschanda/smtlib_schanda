(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111100000 #b010111010)
                expect
                (fp #b1 #b0111100000 #b000100000)))
(assert (fp.leq (fp #b1 #b0111100000 #b000100000)
                expect
                (fp #b0 #b1101011010 #b000111000)))

(assert (= expect result))

(check-sat)
