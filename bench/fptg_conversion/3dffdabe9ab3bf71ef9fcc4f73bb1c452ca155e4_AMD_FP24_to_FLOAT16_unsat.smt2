; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111001 #b1000100000001110)
                arg1
                (fp #b0 #b1001101 #b0111010111011000)))
(assert (fp.leq (fp #b0 #b1001101 #b0111010111011000)
                arg1
                (fp #b0 #b1100000 #b1101110001010000)))
; arg1 = 23926.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00000 #b0111111001)
                expect
                (fp #b0 #b11101 #b0111011000)))
(assert (fp.leq (fp #b0 #b11101 #b0111011000)
                expect
                (fp #b0 #b11110 #b0111100110)))
; expect = 23936.0

(assert (not (= expect result)))

(check-sat)
(exit)
