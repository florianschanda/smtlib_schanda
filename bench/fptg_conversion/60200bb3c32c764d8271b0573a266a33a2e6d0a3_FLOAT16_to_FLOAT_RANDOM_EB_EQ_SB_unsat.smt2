                expect
                (fp #b1 #b0111111 #b001101)))
(assert (fp.leq (fp #b1 #b0111111 #b001101)
                expect
                (fp #b0 #b0001011 #b110000)))
; expect = -1.203125

(assert (not (= expect result)))

