; Format from: FLOAT64
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001001011 #b1010001010011011001010011010100010110111010000001100)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b00010110101 #b1101010011110010000100000111001101010100100010100000)))

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b100 #b0)
                expect
                (fp #b1 #b000 #b1)))
(assert (fp.leq (fp #b1 #b000 #b1)
                expect
                (fp #b0 #b010 #b0)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
