(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10001101111010010 #b0100110000101000)
                expect
                (fp #b1 #b10000000000001000 #b1101001010000000)))
(assert (fp.leq (fp #b1 #b10000000000001000 #b1101001010000000)
                expect
                (fp #b0 #b01100110100110011 #b0010100111000011)))

(assert (= expect result))

(check-sat)
