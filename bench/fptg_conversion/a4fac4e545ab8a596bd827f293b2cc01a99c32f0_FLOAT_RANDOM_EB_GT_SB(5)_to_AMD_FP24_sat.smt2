; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 13))
(assert (fp.leq (fp #b1 #b101100111010010010 #b011110011011)
                arg1
                (fp #b1 #b100000000000001000 #b010011111000)))
(assert (fp.leq (fp #b1 #b100000000000001000 #b010011111000)
                arg1
                (fp #b1 #b010111010011010100 #b000011110000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001100 #b0010101101001101)
                expect
                (fp #b1 #b1001000 #b0100111110000000)))
(assert (fp.leq (fp #b1 #b1001000 #b0100111110000000)
                expect
                (fp #b0 #b0111011 #b0000110110001101)))
; expect = -671.0

(assert (= expect result))

(check-sat)
(exit)
