(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b10 #b1)))
; arg1 = -0.5

(declare-const result Float64)
