(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001111110 #b1100000000010010101000111100000100110101111101111011)
                expect
                (fp #b1 #b01111111110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10100110111 #b0110100101000010001000010001111100011000010110010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
