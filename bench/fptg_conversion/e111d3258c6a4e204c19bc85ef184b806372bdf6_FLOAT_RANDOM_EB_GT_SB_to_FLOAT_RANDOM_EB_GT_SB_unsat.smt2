                expect
                (fp #b1 #b100000000000000 #b1000000)))
(assert (fp.leq (fp #b1 #b100000000000000 #b1000000)
                expect
                (fp #b0 #b101001100101101 #b0101000)))

(assert (not (= expect result)))

