(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg1
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                arg1
                (fp #b0 #b0000 #b101)))
; arg1 = -0.001953125

(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11001100100 #b0110011)
                expect
                (fp #b1 #b01111110110 #b0000000)))
(assert (fp.leq (fp #b1 #b01111110110 #b0000000)
                expect
                (fp #b0 #b10101010000 #b1010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
