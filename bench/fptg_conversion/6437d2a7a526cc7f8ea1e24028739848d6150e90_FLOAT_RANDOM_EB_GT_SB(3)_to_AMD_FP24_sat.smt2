(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001100001 #b0110)
                arg1
                (fp #b0 #b1000000010 #b0010)))
(assert (fp.leq (fp #b0 #b1000000010 #b0010)
                arg1
                (fp #b0 #b1000000011 #b0000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101000 #b1100111111011011)
                expect
                (fp #b0 #b1000010 #b0010000000000000)))
(assert (fp.leq (fp #b0 #b1000010 #b0010000000000000)
                expect
                (fp #b0 #b1010000 #b0111101100110101)))
; expect = 9.0

(assert (= expect result))

(check-sat)
(exit)
