; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b0101000011)
                arg1
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg1
                (fp #b1 #b00101 #b1011111001)))
; arg1 = -0.0078125

(declare-const result (_ FloatingPoint 14 5))
(assert (= result ((_ to_fp 14 5) rm arg1)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11001110001111 #b0100)
                expect
                (fp #b1 #b01111111111000 #b0000)))
(assert (fp.leq (fp #b1 #b01111111111000 #b0000)
                expect
                (fp #b0 #b10100110010110 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
