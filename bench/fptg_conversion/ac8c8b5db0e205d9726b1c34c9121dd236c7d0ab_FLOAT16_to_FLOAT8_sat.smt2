(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT8
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0101111001)
                arg1
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                arg1
                (fp #b0 #b11110 #b0001110111)))
; arg1 = 13320.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
