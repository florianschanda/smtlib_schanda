(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000000010)
                arg1
                (fp #b1 #b10111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10111 #b0000100000)
                arg1
                (fp #b0 #b01110 #b0100111000)))
; arg1 = -264.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result ((_ to_fp 8 5) rm arg1)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b11011010 #b0100)
                expect
                (fp #b1 #b10000111 #b0001)))
(assert (fp.leq (fp #b1 #b10000111 #b0001)
                expect
                (fp #b0 #b10001010 #b0001)))
; expect = -272.0

(assert (= expect result))

(check-sat)
(exit)
