(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101001010001011 #b111111000101100)
                arg1
                (fp #b1 #b0111111111111111 #b100111100100001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b100111100100001)
                arg1
                (fp #b0 #b0110010001001010 #b101010011011000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111001010 #b0100)
                expect
                (fp #b1 #b0111111111 #b1010)))
(assert (fp.leq (fp #b1 #b0111111111 #b1010)
                expect
                (fp #b0 #b0011010001 #b0010)))

(assert (not (= expect result)))

(check-sat)
(exit)
