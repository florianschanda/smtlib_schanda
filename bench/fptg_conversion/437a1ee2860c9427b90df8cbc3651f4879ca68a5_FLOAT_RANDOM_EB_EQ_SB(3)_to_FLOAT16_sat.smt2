; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b0110)
                arg1
                (fp #b1 #b01001 #b0001)))
(assert (fp.leq (fp #b1 #b01001 #b0001)
                arg1
                (fp #b1 #b00101 #b1111)))
; arg1 = -0.0166015625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b0111111011)
                expect
                (fp #b1 #b01001 #b0001000000)))
(assert (fp.leq (fp #b1 #b01001 #b0001000000)
                expect
                (fp #b0 #b01010 #b1100100111)))
; expect = -0.0166015625

(assert (= expect result))

(check-sat)
(exit)
