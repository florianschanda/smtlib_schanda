(assert (fp.leq (fp #b0 #b010000000010010 #b10011110111000)
                expect
                (fp #b0 #b100000000000010 #b10000000000000)))
(assert (fp.leq (fp #b0 #b100000000000010 #b10000000000000)
                expect
                (fp #b0 #b101110011000000 #b01110101111101)))

(assert (= expect result))

(check-sat)
