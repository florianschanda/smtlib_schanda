(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01100110110 #b0011)
                arg1
                (fp #b1 #b00000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000)
                arg1
                (fp #b0 #b11110011100 #b0010)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result ((_ to_fp 13 4) rm arg1)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1001000100000 #b010)
                expect
                (fp #b1 #b0000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000)
                expect
                (fp #b0 #b1101101110011 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
