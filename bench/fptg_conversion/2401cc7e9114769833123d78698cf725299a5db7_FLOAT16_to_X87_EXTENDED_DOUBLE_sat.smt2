; Format from: FLOAT16
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1100101001)
                arg1
                (fp #b0 #b11001 #b1010000111)))
(assert (fp.leq (fp #b0 #b11001 #b1010000111)
                arg1
                (fp #b0 #b11101 #b1100111000)))
; arg1 = 1671.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b010001010010010 #b111111000111001110000111111111100010011010011000100111000111100)
                expect
                (fp #b0 #b100000000001001 #b101000011100000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000001001 #b101000011100000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b111011010011110 #b000010001011111111110000100100101110110110010100110111011001110)))

(assert (= expect result))

(check-sat)
(exit)
