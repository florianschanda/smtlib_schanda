(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0100)
                arg1
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                arg1
                (fp #b0 #b110 #b1111)))
; arg1 = 0.015625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110110 #b1011110100)
                expect
                (fp #b0 #b01111001 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111001 #b0000000000)
                expect
                (fp #b0 #b11001101 #b1101101100)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
