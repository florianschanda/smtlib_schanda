(assert (fp.leq (fp #b1 #b10111001110101 #b0010110000111)
                expect
                (fp #b1 #b10000000010001 #b1100000000000)))
(assert (fp.leq (fp #b1 #b10000000010001 #b1100000000000)
                expect
                (fp #b0 #b11100110000000 #b0100010111000)))

(assert (= expect result))

(check-sat)
