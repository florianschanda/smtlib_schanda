; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b11011000 #b01011000111000111001000)
                arg1
                (fp #b0 #b11110011 #b01001001100100010110011)))
(assert (fp.leq (fp #b0 #b11110011 #b01001001100100010110011)
                arg1
                (fp #b0 #b11111000 #b00000011010111010100111)))
; arg1 = 106950918570191514810027511577051136.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10011011 #b1010000)
                expect
                (fp #b0 #b11110011 #b0100101)))
(assert (fp.leq (fp #b0 #b11110011 #b0100101)
                expect
                (fp #b0 #b11111010 #b1111010)))
; expect = 107091122707280819838441486790164480.0

(assert (not (= expect result)))

(check-sat)
(exit)
