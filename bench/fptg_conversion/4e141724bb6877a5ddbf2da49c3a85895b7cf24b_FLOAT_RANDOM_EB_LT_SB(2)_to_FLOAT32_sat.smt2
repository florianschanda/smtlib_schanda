; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 32))
(assert (fp.leq (fp #b0 #b0010101 #b1110000100111110110111010010010)
                arg1
                (fp #b0 #b0111111 #b1111000011111111111000110001010)))
(assert (fp.leq (fp #b0 #b0111111 #b1111000011111111111000110001010)
                arg1
                (fp #b0 #b1101000 #b1101010011000111011000111010000)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000111 #b01110001010110011000100)
                expect
                (fp #b0 #b01111111 #b11110000111111111110010)))
(assert (fp.leq (fp #b0 #b01111111 #b11110000111111111110010)
                expect
                (fp #b0 #b11101101 #b00110111101001111101100)))
; expect = 1.9414045810699462890625

(assert (= expect result))

(check-sat)
(exit)
