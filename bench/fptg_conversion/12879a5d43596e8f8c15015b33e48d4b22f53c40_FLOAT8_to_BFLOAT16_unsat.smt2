(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1100)
                arg1
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                arg1
                (fp #b0 #b110 #b0100)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011011 #b1011001)
                expect
                (fp #b0 #b10000001 #b0000000)))
(assert (fp.leq (fp #b0 #b10000001 #b0000000)
                expect
                (fp #b0 #b10101101 #b0101101)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
