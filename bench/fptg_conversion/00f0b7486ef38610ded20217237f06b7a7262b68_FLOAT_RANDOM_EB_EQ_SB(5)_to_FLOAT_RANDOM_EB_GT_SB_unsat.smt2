; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11110011111001 #b1000001110111)
                arg1
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                arg1
                (fp #b0 #b00001001001101 #b1011100110010)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result ((_ to_fp 9 2) rm arg1)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011000001 #b1)
                expect
                (fp #b1 #b000000000 #b0)))
(assert (fp.leq (fp #b1 #b000000000 #b0)
                expect
                (fp #b0 #b011000010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
