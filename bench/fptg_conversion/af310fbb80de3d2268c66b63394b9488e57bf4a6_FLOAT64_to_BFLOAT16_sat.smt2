; Format from: FLOAT64
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001100101 #b0100110100011111101000001101000110011001011001010101)
                arg1
                (fp #b0 #b01111111111 #b1110001111111011110101111010110011110101100100100101)))
(assert (fp.leq (fp #b0 #b01111111111 #b1110001111111011110101111010110011110101100100100101)
                arg1
                (fp #b0 #b11000000001 #b1111110001000100000100000110000100100001111011100000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000111 #b0110111)
                expect
                (fp #b0 #b01111111 #b1110010)))
(assert (fp.leq (fp #b0 #b01111111 #b1110010)
                expect
                (fp #b0 #b11100010 #b0001111)))
; expect = 1.890625

(assert (= expect result))

(check-sat)
