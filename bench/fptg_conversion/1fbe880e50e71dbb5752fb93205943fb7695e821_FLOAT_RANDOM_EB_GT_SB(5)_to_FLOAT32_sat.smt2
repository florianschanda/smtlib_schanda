; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111010111 #b11010)
                arg1
                (fp #b1 #b011111111 #b01110)))
(assert (fp.leq (fp #b1 #b011111111 #b01110)
                arg1
                (fp #b0 #b001000110 #b11101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000011 #b01010000111011001100110)
                expect
                (fp #b1 #b01111111 #b01110000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b01110000000000000000000)
                expect
                (fp #b1 #b01010010 #b11000101010000000010100)))
; expect = -1.4375

(assert (= expect result))

(check-sat)
(exit)
