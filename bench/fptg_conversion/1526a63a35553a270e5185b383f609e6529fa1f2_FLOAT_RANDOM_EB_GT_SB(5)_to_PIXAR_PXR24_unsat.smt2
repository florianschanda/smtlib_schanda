(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: PIXAR_PXR24
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11100 #b00)
                arg1
                (fp #b0 #b00000 #b00)))
(assert (fp.leq (fp #b0 #b00000 #b00)
                arg1
                (fp #b0 #b00010 #b11)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010110 #b101111010001011)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b10011000 #b100111100000011)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
