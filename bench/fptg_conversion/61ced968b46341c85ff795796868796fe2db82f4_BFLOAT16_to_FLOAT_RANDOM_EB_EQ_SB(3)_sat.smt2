; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100000 #b1101110)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b10011000 #b0110010)))
; arg1 = 59.75

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011110101 #b11110000)
                expect
                (fp #b0 #b100000100 #b11011110)))
(assert (fp.leq (fp #b0 #b100000100 #b11011110)
                expect
                (fp #b0 #b110010111 #b11000010)))

(assert (= expect result))

(check-sat)
(exit)
