(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11011100011100010010101)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11111001 #b00111010110001001100101)))
; arg1 = 12907478160253124608.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100010 #b1110010011100000)
                expect
                (fp #b0 #b1111110 #b0110011001000010)))
(assert (fp.leq (fp #b0 #b1111110 #b0110011001000010)
                expect
                (fp #b0 #b1111110 #b1100011000100011)))
; expect = 12907598007020552192.0

(assert (= expect result))

(check-sat)
(exit)
