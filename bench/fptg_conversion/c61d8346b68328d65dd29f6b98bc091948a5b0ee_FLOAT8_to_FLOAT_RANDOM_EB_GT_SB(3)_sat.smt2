(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b0 #b000 #b1110)))
(assert (fp.leq (fp #b0 #b000 #b1110)
                arg1
                (fp #b0 #b110 #b0100)))
; arg1 = 0.21875

(declare-const result (_ FloatingPoint 16 15))
(assert (= result ((_ to_fp 16 15) rm arg1)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1111100010110010 #b01001010100011)
                expect
                (fp #b0 #b0111111111111100 #b11000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111100 #b11000000000000)
                expect
                (fp #b0 #b1101101110111010 #b00000110101000)))

(assert (= expect result))

(check-sat)
(exit)
