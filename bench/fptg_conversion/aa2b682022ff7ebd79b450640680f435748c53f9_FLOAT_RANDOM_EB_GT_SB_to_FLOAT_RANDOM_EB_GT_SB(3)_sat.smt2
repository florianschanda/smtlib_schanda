(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101101 #b10)
                arg1
                (fp #b1 #b011111 #b01)))
(assert (fp.leq (fp #b1 #b011111 #b01)
                arg1
                (fp #b0 #b100000 #b10)))
; arg1 = -1.25

(declare-const result (_ FloatingPoint 8 5))
(assert (= result ((_ to_fp 8 5) rm arg1)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10011100 #b0111)
                expect
                (fp #b1 #b01111111 #b0100)))
(assert (fp.leq (fp #b1 #b01111111 #b0100)
                expect
                (fp #b1 #b00000000 #b1001)))
; expect = -1.25

(assert (= expect result))

(check-sat)
(exit)
