(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110010000111110 #b001110111100100)
                arg1
                (fp #b1 #b0110000110100001 #b101111000011001)))
(assert (fp.leq (fp #b1 #b0110000110100001 #b101111000011001)
                arg1
                (fp #b1 #b0010000110111001 #b101100101010111)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result ((_ to_fp 12 7) rm arg1)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b011010011010 #b010111)
                expect
                (fp #b1 #b000000000000 #b000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b000001)
                expect
                (fp #b0 #b010000010001 #b110001)))

(assert (= expect result))

(check-sat)
