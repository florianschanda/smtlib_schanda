(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000000 #b10101011010100000101000)
                expect
                (fp #b1 #b01111111 #b11001000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b11001000000000000000000)
                expect
                (fp #b0 #b10000110 #b11001110101000011000101)))
; expect = -1.78125

(assert (not (= expect result)))

(check-sat)
(exit)
