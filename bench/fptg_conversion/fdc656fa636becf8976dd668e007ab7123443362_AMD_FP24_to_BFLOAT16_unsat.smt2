; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b0111110001111000)
                arg1
                (fp #b0 #b1000100 #b0100110011010001)))
(assert (fp.leq (fp #b0 #b1000100 #b0100110011010001)
                arg1
                (fp #b0 #b1100000 #b1011001001000010)))
; arg1 = 41.60205078125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000111 #b1101010)
                expect
                (fp #b0 #b10000100 #b0100111)))
(assert (fp.leq (fp #b0 #b10000100 #b0100111)
                expect
                (fp #b0 #b10110011 #b0000101)))
; expect = 41.75

(assert (not (= expect result)))

(check-sat)
(exit)
