; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b0010000100)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b1 #b00000100 #b0000010110)))
; arg1 = -2048.0

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1010001010 #b1000)
                expect
                (fp #b1 #b1000001010 #b0000)))
(assert (fp.leq (fp #b1 #b1000001010 #b0000)
                expect
                (fp #b0 #b1011001001 #b0010)))

(assert (not (= expect result)))

(check-sat)
(exit)
