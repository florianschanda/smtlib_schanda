; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101110 #b01000000001110000110110)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b1 #b00111001 #b10110100010110000100111)))
; arg1 = -14198738255872.0

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101000 #b10011010)
                expect
                (fp #b1 #b100101010 #b10011110)))
(assert (fp.leq (fp #b1 #b100101010 #b10011110)
                expect
                (fp #b0 #b010110111 #b00001110)))

(assert (= expect result))

(check-sat)
(exit)
