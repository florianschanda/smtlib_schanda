(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b1010110100100011)
                arg1
                (fp #b1 #b1010101 #b0001001101010100)))
(assert (fp.leq (fp #b1 #b1010101 #b0001001101010100)
                arg1
                (fp #b1 #b0000001 #b1011111010111111)))
; arg1 = -4510976.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000101 #b01010011101010111110111)
                expect
                (fp #b1 #b10010101 #b00010011010101000000000)))
(assert (fp.leq (fp #b1 #b10010101 #b00010011010101000000000)
                expect
                (fp #b0 #b00101011 #b11110000000110110110010)))
; expect = -4510976.0

(assert (= expect result))

(check-sat)
(exit)
