; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b010)
                arg1
                (fp #b1 #b1100 #b010)))
(assert (fp.leq (fp #b1 #b1100 #b010)
                arg1
                (fp #b0 #b1100 #b010)))
; arg1 = -40.0

(declare-const result (_ FloatingPoint 11 9))
(assert (= result ((_ to_fp 11 9) rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10100101100 #b10101010)
                expect
                (fp #b1 #b10000000100 #b01000000)))
(assert (fp.leq (fp #b1 #b10000000100 #b01000000)
                expect
                (fp #b0 #b10101011000 #b00100001)))

(assert (= expect result))

(check-sat)
(exit)
