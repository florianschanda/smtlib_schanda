(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 37))
(assert (fp.leq (fp #b1 #b110110011 #b110011011001011000110010110001000110)
                arg1
                (fp #b1 #b110001100 #b110011100100110110000010111001001100)))
(assert (fp.leq (fp #b1 #b110001100 #b110011100100110110000010111001001100)
                arg1
                (fp #b1 #b101110010 #b101110010111011100010000100111110100)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
