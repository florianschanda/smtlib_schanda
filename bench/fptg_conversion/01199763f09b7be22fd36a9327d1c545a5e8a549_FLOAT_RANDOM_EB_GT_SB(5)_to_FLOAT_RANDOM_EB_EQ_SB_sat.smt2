                expect
                (fp #b1 #b1000000011110 #b000000000000)))
(assert (fp.leq (fp #b1 #b1000000011110 #b000000000000)
                expect
                (fp #b0 #b1011111111110 #b101100100001)))

(assert (= expect result))

