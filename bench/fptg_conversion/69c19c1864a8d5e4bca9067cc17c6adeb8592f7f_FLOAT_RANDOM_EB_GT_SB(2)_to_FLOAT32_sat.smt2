; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b00011001001010000 #b01)
                arg1
                (fp #b0 #b00000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b01)
                arg1
                (fp #b0 #b10001001100111110 #b00)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011100 #b00001000111111010011001)
                expect
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b10101001 #b00010100100111010111000)))
; expect = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(assert (= expect result))

(check-sat)
(exit)
