; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1010010101)
                arg1
                (fp #b1 #b01111 #b0100110000)))
(assert (fp.leq (fp #b1 #b01111 #b0100110000)
                arg1
                (fp #b0 #b10111 #b0011000011)))
; arg1 = -1.296875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100111 #b10101001001110000101110)
                expect
                (fp #b1 #b01111111 #b01001100000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b01001100000000000000000)
                expect
                (fp #b0 #b01001011 #b11011111001101100000001)))
; expect = -1.296875

(assert (not (= expect result)))

(check-sat)
(exit)
