(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b100 #b0)))
(assert (fp.leq (fp #b1 #b100 #b0)
                arg1
                (fp #b0 #b010 #b0)))
; arg1 = -2.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b1100010110)
                expect
                (fp #b1 #b10000 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000 #b0000000000)
                expect
                (fp #b0 #b10011 #b1000110011)))
; expect = -2.0

(assert (= expect result))

(check-sat)
(exit)
