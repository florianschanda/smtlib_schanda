(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg1
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b00 #b1)))
; arg1 = -2.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000011 #b01101100111111100101000)
                expect
                (fp #b1 #b10000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b00000000000000000000000)
                expect
                (fp #b1 #b00110000 #b01011111001111111101000)))
; expect = -2.0

(assert (= expect result))

(check-sat)
(exit)
