; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001000110 #b10001101)
                arg1
                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                arg1
                (fp #b0 #b111111111 #b00000000)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result ((_ to_fp 14 8) rm arg1)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b01101001100110 #b0101001)
                expect
                (fp #b0 #b10000011111111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000011111111 #b0000000)
                expect
                (fp #b0 #b11001011100111 #b0010011)))

(assert (= expect result))

(check-sat)
(exit)
