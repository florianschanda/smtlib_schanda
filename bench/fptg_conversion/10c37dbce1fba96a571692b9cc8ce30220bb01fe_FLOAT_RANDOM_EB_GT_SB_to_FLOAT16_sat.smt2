; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b101101100000111 #b100011101100)
                arg1
                (fp #b1 #b000001011011100 #b011000011110)))
(assert (fp.leq (fp #b1 #b000001011011100 #b011000011110)
                arg1
                (fp #b0 #b100100101001101 #b111010001001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0001011111)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10110 #b1101011000)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
