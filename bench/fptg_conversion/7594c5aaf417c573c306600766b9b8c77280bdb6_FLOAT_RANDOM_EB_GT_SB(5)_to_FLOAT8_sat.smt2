(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01000111010 #b10101)
                arg1
                (fp #b0 #b01111111111 #b10111)))
(assert (fp.leq (fp #b0 #b01111111111 #b10111)
                arg1
                (fp #b0 #b10000111001 #b01011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b010 #b0010)
                expect
                (fp #b0 #b011 #b1100)))
(assert (fp.leq (fp #b0 #b011 #b1100)
                expect
                (fp #b0 #b101 #b1001)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
