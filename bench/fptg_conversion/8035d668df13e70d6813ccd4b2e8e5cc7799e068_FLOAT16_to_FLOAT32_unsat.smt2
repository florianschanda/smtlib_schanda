; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110100011)
                arg1
                (fp #b1 #b11110 #b0111011011)))
(assert (fp.leq (fp #b1 #b11110 #b0111011011)
                arg1
                (fp #b1 #b10010 #b0110110111)))
; arg1 = -47968.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b11111101110010101010010)
                expect
                (fp #b1 #b10001110 #b01110110110000000000000)))
(assert (fp.leq (fp #b1 #b10001110 #b01110110110000000000000)
                expect
                (fp #b0 #b10101000 #b00100110101111100010101)))
; expect = -47968.0

(assert (not (= expect result)))

(check-sat)
(exit)
