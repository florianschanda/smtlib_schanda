; Format from: BFLOAT16
; Format to: FLOAT64
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b1111111)
                arg1
                (fp #b1 #b10000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000000)
                arg1
                (fp #b1 #b01101101 #b1001100)))
; arg1 = -256.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110001011 #b0010010101100010010101110110000111001100101101001001)
                expect
                (fp #b1 #b10000000111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11010101011 #b0000100111111110100100000010010000111011010010000001)))

(assert (= expect result))

(check-sat)
(exit)
