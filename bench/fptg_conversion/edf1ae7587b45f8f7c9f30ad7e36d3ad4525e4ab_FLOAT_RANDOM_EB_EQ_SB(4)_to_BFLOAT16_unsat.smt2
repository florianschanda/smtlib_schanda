                expect
                (fp #b0 #b10000010 #b1100000)))
(assert (fp.leq (fp #b0 #b10000010 #b1100000)
                expect
                (fp #b0 #b11000100 #b0110000)))
; expect = 14.0

(assert (not (= expect result)))

