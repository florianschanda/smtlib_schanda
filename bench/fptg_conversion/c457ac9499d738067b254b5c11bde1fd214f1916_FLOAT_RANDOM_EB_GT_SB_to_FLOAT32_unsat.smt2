(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b00100100110 #b0111111)
                arg1
                (fp #b0 #b01111111111 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000)
                arg1
                (fp #b0 #b10100000100 #b1100011)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00010100 #b00001011101001111110100)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b11100100 #b11001100001110011111111)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
