(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010111001111110 #b010010010111011)
                arg1
                (fp #b1 #b0000000000000000 #b010010100000101)))
