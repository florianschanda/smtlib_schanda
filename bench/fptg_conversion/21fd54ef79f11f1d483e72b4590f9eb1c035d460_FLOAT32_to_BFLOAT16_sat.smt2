; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10010101 #b00011000110111101011010)
                arg1
                (fp #b1 #b01001001 #b01011001001011000010101)))
(assert (fp.leq (fp #b1 #b01001001 #b01011001001011000010101)
                arg1
                (fp #b0 #b11100011 #b01011011010100010001110)))
; arg1 = -0.00000000000000007484735831752190407008262784671615008846856653690338134765625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001111 #b0011100)
                expect
                (fp #b1 #b01001001 #b0101101)))
(assert (fp.leq (fp #b1 #b01001001 #b0101101)
                expect
                (fp #b0 #b11000000 #b0011010)))
; expect = -0.0000000000000000750267903359969068333157338201999664306640625

(assert (= expect result))

(check-sat)
(exit)
