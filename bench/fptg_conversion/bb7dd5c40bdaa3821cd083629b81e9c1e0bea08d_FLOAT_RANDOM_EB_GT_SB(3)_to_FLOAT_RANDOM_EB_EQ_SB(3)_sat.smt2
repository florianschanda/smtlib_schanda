                expect
                (fp #b0 #b000000000000000 #b00000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000001)
                expect
                (fp #b0 #b001001111101111 #b10000111010000)))

(assert (= expect result))

