; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001010 #b11110011011001100001000)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b1 #b00101100 #b10010100011010110100011)))
; arg1 = -1.040654659271240234375

(declare-const result (_ FloatingPoint 18 7))
(assert (= result ((_ to_fp 18 7) rm arg1)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b100101000101101111 #b010101)
                expect
                (fp #b1 #b011111111111111111 #b000011)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b000011)
                expect
                (fp #b0 #b000110001011001101 #b111110)))

(assert (= expect result))

(check-sat)
(exit)
