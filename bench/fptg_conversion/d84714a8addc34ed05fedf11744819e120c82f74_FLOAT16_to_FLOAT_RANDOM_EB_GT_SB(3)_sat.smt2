(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10010 #b1000001100)
                arg1
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg1
                (fp #b0 #b11100 #b1101010001)))
; arg1 = 0.0078125

(declare-const result (_ FloatingPoint 8 6))
(assert (= result ((_ to_fp 8 6) rm arg1)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11110101 #b01110)
                expect
                (fp #b0 #b01111000 #b00000)))
(assert (fp.leq (fp #b0 #b01111000 #b00000)
                expect
                (fp #b0 #b11011101 #b11100)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
