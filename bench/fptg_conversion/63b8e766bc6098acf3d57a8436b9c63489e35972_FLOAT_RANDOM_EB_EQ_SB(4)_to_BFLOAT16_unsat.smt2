; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111110100 #b1001000001)
                arg1
                (fp #b1 #b10000001001 #b0000110001)))
(assert (fp.leq (fp #b1 #b10000001001 #b0000110001)
                arg1
                (fp #b1 #b01101010000 #b1111001101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101001 #b1100100)
                expect
                (fp #b1 #b10001001 #b0000111)))
(assert (fp.leq (fp #b1 #b10001001 #b0000111)
                expect
                (fp #b1 #b00010100 #b1101110)))
; expect = -1080.0

(assert (not (= expect result)))

(check-sat)
(exit)
