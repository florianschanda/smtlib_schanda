; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1000011111 #b0010101)
                arg1
                (fp #b0 #b0000000000 #b1100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100110)
                arg1
                (fp #b0 #b1000101100 #b1100100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01110110100 #b1101100000)
                expect
                (fp #b0 #b01000000000 #b1001100000)))
(assert (fp.leq (fp #b0 #b01000000000 #b1001100000)
                expect
                (fp #b0 #b11001000011 #b0011011010)))

(assert (= expect result))

(check-sat)
(exit)
