(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT64
; Format to: FLOAT32
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010100001 #b1010111101000010011010001001010101101111000010010001)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01111110010 #b0110101001011100111000110111000101000101100010101010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100010 #b10001000101001110001110)
                expect
                (fp #b1 #b10110100 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10110100 #b00000000000000000000000)
                expect
                (fp #b1 #b00111010 #b01101000110101101001010)))
; expect = -9007199254740992.0

(assert (not (= expect result)))

(check-sat)
(exit)
