; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b1 #b010 #b1001)))
(assert (fp.leq (fp #b1 #b010 #b1001)
                arg1
                (fp #b1 #b001 #b1110)))
; arg1 = -0.78125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000110 #b1001101110)
                expect
                (fp #b1 #b01111110 #b1001000000)))
(assert (fp.leq (fp #b1 #b01111110 #b1001000000)
                expect
                (fp #b1 #b00100110 #b1111001100)))
; expect = -0.78125

(assert (= expect result))

(check-sat)
(exit)
