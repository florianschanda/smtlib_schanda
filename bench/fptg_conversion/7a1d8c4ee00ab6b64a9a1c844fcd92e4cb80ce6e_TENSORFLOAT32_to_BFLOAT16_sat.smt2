(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00110010 #b0010111011)
                arg1
                (fp #b0 #b10000000 #b1000110110)))
(assert (fp.leq (fp #b0 #b10000000 #b1000110110)
                arg1
                (fp #b0 #b11101000 #b1010010100)))
; arg1 = 3.10546875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011100 #b1110001)
                expect
                (fp #b0 #b10000000 #b1000111)))
(assert (fp.leq (fp #b0 #b10000000 #b1000111)
                expect
                (fp #b0 #b10101000 #b0000010)))
; expect = 3.109375

(assert (= expect result))

(check-sat)
(exit)
