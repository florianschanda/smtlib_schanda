; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 27))
(assert (fp.leq (fp #b1 #b0101 #b01000110010101110010010000)
                arg1
                (fp #b1 #b0001 #b00000100101010111000000000)))
(assert (fp.leq (fp #b1 #b0001 #b00000100101010111000000000)
                arg1
                (fp #b0 #b1001 #b10001111101010010001110101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011111 #b0011001110)
                expect
                (fp #b1 #b01111001 #b0000010011)))
(assert (fp.leq (fp #b1 #b01111001 #b0000010011)
                expect
                (fp #b1 #b00111100 #b1000001010)))
; expect = -0.0159149169921875

(assert (= expect result))

(check-sat)
(exit)
