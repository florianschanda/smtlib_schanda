(assert (fp.leq (fp #b1 #b11110 #b0101101111)
                expect
                (fp #b0 #b10010 #b1100000000)))
(assert (fp.leq (fp #b0 #b10010 #b1100000000)
                expect
                (fp #b0 #b10111 #b1110010000)))
; expect = 14.0

(assert (not (= expect result)))

