; Format from: FLOAT16
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b1111100101)
                arg1
                (fp #b0 #b11001 #b1111110011)))
(assert (fp.leq (fp #b0 #b11001 #b1111110011)
                arg1
                (fp #b0 #b11010 #b1111100111)))
; arg1 = 2035.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b0 #b010100101100001 #b001000100110100110101001011001101000001111110001110001001010110)
                expect
                (fp #b0 #b100000000001001 #b111111001100000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000001001 #b111111001100000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b101100101000111 #b001000000000100000110011011101110110011111011100100011100010011)))

(assert (= expect result))

(check-sat)
(exit)
