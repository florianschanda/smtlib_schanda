; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0110100001)
                arg1
                (fp #b1 #b01111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111 #b0010001010)
                arg1
                (fp #b0 #b01000 #b0111111001)))
; arg1 = -1.134765625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010111 #b11101110010110110001100)
                expect
                (fp #b1 #b01111111 #b00100010100000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00100010100000000000000)
                expect
                (fp #b0 #b01001011 #b01100101101011101110101)))
; expect = -1.134765625

(assert (= expect result))

(check-sat)
(exit)
