; Format from: BFLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110111 #b0010011)
                arg1
                (fp #b1 #b10000110 #b0011010)))
(assert (fp.leq (fp #b1 #b10000110 #b0011010)
                arg1
                (fp #b0 #b01000001 #b0000110)))
; arg1 = -154.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010011 #b01111001010001110000010)
                expect
                (fp #b1 #b10000110 #b00110100000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b00110100000000000000000)
                expect
                (fp #b1 #b01100111 #b11011001001100111001010)))
; expect = -154.0

(assert (not (= expect result)))

(check-sat)
(exit)
