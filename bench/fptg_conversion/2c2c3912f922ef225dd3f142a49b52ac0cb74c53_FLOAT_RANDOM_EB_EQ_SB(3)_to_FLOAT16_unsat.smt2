                expect
                (fp #b0 #b01101 #b1000000000)))
(assert (fp.leq (fp #b0 #b01101 #b1000000000)
                expect
                (fp #b0 #b11000 #b0001001111)))
; expect = 0.375

(assert (not (= expect result)))

