; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b001110111101010011 #b1)
                arg1
                (fp #b0 #b001111111111111111 #b1)))
(assert (fp.leq (fp #b0 #b001111111111111111 #b1)
                arg1
                (fp #b0 #b011110010111110001 #b1)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result ((_ to_fp 10 6) rm arg1)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100111010 #b10100)
                expect
                (fp #b0 #b0000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00001)
                expect
                (fp #b0 #b1101000111 #b01010)))

(assert (= expect result))

(check-sat)
(exit)
