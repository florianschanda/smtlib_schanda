(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00101101111011110101000)
                arg1
                (fp #b1 #b01111111 #b10010010111110011011111)))
(assert (fp.leq (fp #b1 #b01111111 #b10010010111110011011111)
                arg1
                (fp #b0 #b11110000 #b01011011000101111111000)))
; arg1 = -1.57412326335906982421875

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110100 #b000111)
                expect
                (fp #b1 #b0111111 #b100101)))
(assert (fp.leq (fp #b1 #b0111111 #b100101)
                expect
                (fp #b0 #b1001111 #b110001)))
; expect = -1.578125

(assert (= expect result))

(check-sat)
(exit)
