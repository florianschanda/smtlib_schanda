; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 40))
(assert (fp.leq (fp #b1 #b00001 #b001111100001011011100001011101101000111)
                arg1
                (fp #b0 #b11110 #b111111111111111010110100100101011111000)))
(assert (fp.leq (fp #b0 #b11110 #b111111111111111010110100100101011111000)
                arg1
                (fp #b0 #b11110 #b111111111111111110011110011001111110010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
