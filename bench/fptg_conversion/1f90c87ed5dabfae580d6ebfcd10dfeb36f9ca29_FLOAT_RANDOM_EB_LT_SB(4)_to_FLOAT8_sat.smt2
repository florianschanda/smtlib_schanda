(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 10))
(assert (fp.leq (fp #b1 #b0001 #b000000110)
                arg1
                (fp #b0 #b0101 #b011000110)))
(assert (fp.leq (fp #b0 #b0101 #b011000110)
                arg1
                (fp #b0 #b1100 #b011001010)))
; arg1 = 0.3466796875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0011)
                expect
                (fp #b0 #b001 #b0111)))
(assert (fp.leq (fp #b0 #b001 #b0111)
                expect
                (fp #b0 #b010 #b0011)))
; expect = 0.359375

(assert (= expect result))

(check-sat)
(exit)
