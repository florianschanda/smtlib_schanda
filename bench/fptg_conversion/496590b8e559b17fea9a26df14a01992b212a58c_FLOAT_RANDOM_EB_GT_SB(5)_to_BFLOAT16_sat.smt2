(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010011 #b000)
                arg1
                (fp #b0 #b100010 #b101)))
(assert (fp.leq (fp #b0 #b100010 #b101)
                arg1
                (fp #b0 #b111101 #b110)))
; arg1 = 13.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011111 #b0010101)
                expect
                (fp #b0 #b10000010 #b1010000)))
(assert (fp.leq (fp #b0 #b10000010 #b1010000)
                expect
                (fp #b0 #b11100000 #b1001001)))
; expect = 13.0

(assert (= expect result))

(check-sat)
(exit)
