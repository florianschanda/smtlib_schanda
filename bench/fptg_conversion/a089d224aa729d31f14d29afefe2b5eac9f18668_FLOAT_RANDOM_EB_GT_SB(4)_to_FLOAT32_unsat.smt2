                expect
                (fp #b0 #b01111111 #b01100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b01100000000000000000000)
                expect
                (fp #b0 #b10010110 #b01000111110101001110101)))
; expect = 1.375

