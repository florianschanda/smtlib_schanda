(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001100 #b1011011110)
                arg1
                (fp #b1 #b10001000 #b1100000110)))
(assert (fp.leq (fp #b1 #b10001000 #b1100000110)
                arg1
                (fp #b0 #b01000110 #b0010100001)))
; arg1 = -899.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11100 #b0010)
                expect
                (fp #b1 #b11000 #b1101)))
(assert (fp.leq (fp #b1 #b11000 #b1101)
                expect
                (fp #b1 #b00101 #b1101)))
; expect = -928.0

(assert (= expect result))

(check-sat)
(exit)
