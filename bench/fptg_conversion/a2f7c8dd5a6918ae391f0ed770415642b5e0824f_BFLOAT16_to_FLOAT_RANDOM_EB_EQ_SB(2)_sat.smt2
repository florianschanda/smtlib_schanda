(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001110101 #b00101110)
                expect
                (fp #b0 #b011111111 #b10001010)))
(assert (fp.leq (fp #b0 #b011111111 #b10001010)
                expect
                (fp #b0 #b101100010 #b10011101)))

(assert (= expect result))

(check-sat)
