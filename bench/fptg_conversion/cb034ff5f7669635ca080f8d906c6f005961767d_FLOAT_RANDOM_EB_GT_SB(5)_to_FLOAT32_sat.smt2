; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01111100110110 #b1101)
                arg1
                (fp #b0 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0001)
                arg1
                (fp #b0 #b10100000111100 #b0101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011000 #b10010011001101010100001)
                expect
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b00111101 #b00100110011111000001110)))
; expect = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(assert (= expect result))

(check-sat)
(exit)
