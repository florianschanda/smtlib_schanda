(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110000011 #b00101010101)
                arg1
                (fp #b0 #b011111111111 #b00000000000)))
