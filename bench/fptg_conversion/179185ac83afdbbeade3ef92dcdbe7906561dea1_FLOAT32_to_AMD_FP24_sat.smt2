(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110011 #b10111010110111100100001)
                arg1
                (fp #b1 #b10010110 #b00110101100000100101101)))
(assert (fp.leq (fp #b1 #b10010110 #b00110101100000100101101)
                arg1
                (fp #b1 #b01100000 #b00100011000111000101101)))
; arg1 = -10141997.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b0000001101011000)
                expect
                (fp #b1 #b1010110 #b0011010110000011)))
(assert (fp.leq (fp #b1 #b1010110 #b0011010110000011)
                expect
                (fp #b1 #b0101010 #b0111111101100101)))
; expect = -10142080.0

(assert (= expect result))

(check-sat)
(exit)
