(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b010)
                arg1
                (fp #b1 #b1100 #b010)))
(assert (fp.leq (fp #b1 #b1100 #b010)
                arg1
                (fp #b0 #b1100 #b010)))
; arg1 = -40.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111101 #b101010010101010)
                expect
                (fp #b1 #b10000100 #b010000000000000)))
(assert (fp.leq (fp #b1 #b10000100 #b010000000000000)
                expect
                (fp #b0 #b10111010 #b110110111101100)))
; expect = -40.0

(assert (= expect result))

(check-sat)
(exit)
