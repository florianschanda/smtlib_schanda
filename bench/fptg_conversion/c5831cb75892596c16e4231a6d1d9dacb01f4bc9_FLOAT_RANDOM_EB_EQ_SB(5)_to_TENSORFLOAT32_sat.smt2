; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111110 #b00000)
                arg1
                (fp #b1 #b101010 #b10100)))
(assert (fp.leq (fp #b1 #b101010 #b10100)
                arg1
                (fp #b0 #b100111 #b00101)))
; arg1 = -3328.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010100 #b1000000100)
                expect
                (fp #b1 #b10001010 #b1010000000)))
(assert (fp.leq (fp #b1 #b10001010 #b1010000000)
                expect
                (fp #b0 #b10010001 #b1000100100)))
; expect = -3328.0

(assert (= expect result))

(check-sat)
(exit)
