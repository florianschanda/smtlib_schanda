(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101000001101 #b01100000011)
                expect
                (fp #b1 #b100000000000 #b10000000000)))
(assert (fp.leq (fp #b1 #b100000000000 #b10000000000)
                expect
                (fp #b0 #b001111100100 #b00011111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
