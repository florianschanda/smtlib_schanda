(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b001 #b0)
                arg1
                (fp #b0 #b100 #b0)))
(assert (fp.leq (fp #b0 #b100 #b0)
                arg1
                (fp #b0 #b100 #b1)))
; arg1 = 2.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01101 #b1011011101)
                expect
                (fp #b0 #b10000 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000 #b0000000000)
                expect
                (fp #b0 #b10100 #b1101011111)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
