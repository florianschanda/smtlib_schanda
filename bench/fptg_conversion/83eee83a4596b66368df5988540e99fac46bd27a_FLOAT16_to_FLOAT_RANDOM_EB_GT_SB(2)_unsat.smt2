(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b0001001111)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11110 #b1001101111)))
; arg1 = 551.5

(declare-const result (_ FloatingPoint 15 4))
(assert (= result ((_ to_fp 15 4) rm arg1)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100111111111110 #b010)
                expect
                (fp #b0 #b100000000001000 #b001)))
(assert (fp.leq (fp #b0 #b100000000001000 #b001)
                expect
                (fp #b0 #b101110100011011 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
