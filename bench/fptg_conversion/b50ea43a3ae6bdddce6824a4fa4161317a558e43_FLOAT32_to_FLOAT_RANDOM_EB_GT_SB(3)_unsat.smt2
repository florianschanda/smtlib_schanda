; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b11001100111000000010110)
                arg1
                (fp #b1 #b10010011 #b01111001100110011100000)))
(assert (fp.leq (fp #b1 #b10010011 #b01111001100110011100000)
                arg1
                (fp #b1 #b01000011 #b01000010011001101001111)))
; arg1 = -1546652.0

(declare-const result (_ FloatingPoint 16 15))
(assert (= result ((_ to_fp 16 15) rm arg1)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1000000001100000 #b01001000100110)
                expect
                (fp #b1 #b1000000000010011 #b01111001100111)))
(assert (fp.leq (fp #b1 #b1000000000010011 #b01111001100111)
                expect
                (fp #b1 #b0100111110000100 #b00100100111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
