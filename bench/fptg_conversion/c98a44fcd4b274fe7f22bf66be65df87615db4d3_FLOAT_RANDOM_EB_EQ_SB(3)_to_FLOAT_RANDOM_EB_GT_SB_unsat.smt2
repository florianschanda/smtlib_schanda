(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0000 #b00)
                expect
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                expect
                (fp #b0 #b1101 #b10)))
; expect = 0.00390625

(assert (not (= expect result)))

