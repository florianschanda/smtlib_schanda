; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0101001101001 #b100111001011)
                arg1
                (fp #b1 #b0000000000000 #b001011011101)))
(assert (fp.leq (fp #b1 #b0000000000000 #b001011011101)
                arg1
                (fp #b0 #b1100110000101 #b001001111000)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result ((_ to_fp 9 6) rm arg1)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b010101100 #b11011)
                expect
                (fp #b1 #b000000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000000 #b00001)
                expect
                (fp #b0 #b111111010 #b11011)))

(assert (= expect result))

(check-sat)
(exit)
