(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011101 #b10010010010010101100100)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b1 #b00010110 #b11111000110101101110011)))
; arg1 = -1698008524581344716521472.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100000 #b0000111)
                expect
                (fp #b1 #b11001111 #b0110100)))
(assert (fp.leq (fp #b1 #b11001111 #b0110100)
                expect
                (fp #b0 #b11101011 #b0101101)))
; expect = -1700051933833072276930560.0

(assert (not (= expect result)))

(check-sat)
(exit)
