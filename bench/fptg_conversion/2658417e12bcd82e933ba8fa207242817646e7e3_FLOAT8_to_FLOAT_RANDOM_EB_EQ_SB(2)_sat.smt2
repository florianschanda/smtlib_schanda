(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b0101)))
(assert (fp.leq (fp #b0 #b000 #b0101)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = 0.078125

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00000000111 #b0101111010)
                expect
                (fp #b0 #b01111111011 #b0100000000)))
(assert (fp.leq (fp #b0 #b01111111011 #b0100000000)
                expect
                (fp #b0 #b10101111111 #b1001001010)))

(assert (= expect result))

(check-sat)
(exit)
