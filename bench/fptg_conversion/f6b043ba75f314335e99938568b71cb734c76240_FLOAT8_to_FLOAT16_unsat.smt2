(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b1110)
                arg1
                (fp #b0 #b101 #b1100)))
(assert (fp.leq (fp #b0 #b101 #b1100)
                arg1
                (fp #b0 #b110 #b1110)))
; arg1 = 7.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b1100100000)
                expect
                (fp #b0 #b10001 #b1100000000)))
(assert (fp.leq (fp #b0 #b10001 #b1100000000)
                expect
                (fp #b0 #b11101 #b1100110111)))
; expect = 7.0

(assert (not (= expect result)))

(check-sat)
(exit)
