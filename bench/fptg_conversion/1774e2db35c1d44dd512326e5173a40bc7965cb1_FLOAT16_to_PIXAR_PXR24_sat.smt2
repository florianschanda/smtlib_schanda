(assert (fp.leq (fp #b1 #b01001110 #b111010010111000)
                expect
                (fp #b0 #b10001101 #b100001001000000)))
(assert (fp.leq (fp #b0 #b10001101 #b100001001000000)
                expect
                (fp #b0 #b11110110 #b111110010101110)))
; expect = 24864.0

(assert (= expect result))

(check-sat)
