; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 9))
(assert (fp.leq (fp #b1 #b01 #b11111110)
                arg1
                (fp #b1 #b00 #b10111100)))
(assert (fp.leq (fp #b1 #b00 #b10111100)
                arg1
                (fp #b1 #b00 #b01011100)))
; arg1 = -0.734375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011110 #b0110100)
                expect
                (fp #b1 #b01111110 #b0111100)))
(assert (fp.leq (fp #b1 #b01111110 #b0111100)
                expect
                (fp #b1 #b01011011 #b0000110)))
; expect = -0.734375

(assert (= expect result))

(check-sat)
(exit)
