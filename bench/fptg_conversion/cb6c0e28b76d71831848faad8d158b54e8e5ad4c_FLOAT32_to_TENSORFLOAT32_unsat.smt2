(assert (fp.leq (fp #b1 #b00100101 #b0100100110)
                expect
                (fp #b0 #b10011110 #b1111000101)))
(assert (fp.leq (fp #b0 #b10011110 #b1111000101)
                expect
                (fp #b0 #b10110101 #b1100101101)))
; expect = 4171235328.0

