                expect
                (fp #b0 #b100000000000001 #b100000000000)))
(assert (fp.leq (fp #b0 #b100000000000001 #b100000000000)
                expect
                (fp #b0 #b111110001110100 #b110110101010)))

(assert (= expect result))

