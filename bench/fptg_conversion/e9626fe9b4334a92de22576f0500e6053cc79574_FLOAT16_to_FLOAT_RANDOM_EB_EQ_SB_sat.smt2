; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0110011011)
                arg1
                (fp #b1 #b11001 #b0110110001)))
(assert (fp.leq (fp #b1 #b11001 #b0110110001)
                arg1
                (fp #b0 #b11010 #b0100111011)))
; arg1 = -1457.0

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100110001111111 #b10100001000011)
                expect
                (fp #b1 #b100000000001001 #b01101100010000)))
(assert (fp.leq (fp #b1 #b100000000001001 #b01101100010000)
                expect
                (fp #b0 #b100010011101011 #b11001010111000)))

(assert (= expect result))

(check-sat)
(exit)
