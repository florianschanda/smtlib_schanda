; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110110011101100 #b000011001000010)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b0 #b1011011011000010 #b111100010100110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result ((_ to_fp 10 8) rm arg1)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100111101 #b1111011)
                expect
                (fp #b1 #b0111111111 #b1101001)))
(assert (fp.leq (fp #b1 #b0111111111 #b1101001)
                expect
                (fp #b0 #b1110011100 #b1100110)))

(assert (= expect result))

(check-sat)
(exit)
