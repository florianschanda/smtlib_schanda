; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0110)
                arg1
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                arg1
                (fp #b1 #b001 #b0110)))
; arg1 = -4.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000011001100011 #b010010000010011)
                expect
                (fp #b1 #b1000000000000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000000001 #b000000000000000)
                expect
                (fp #b0 #b1110011011101000 #b001100101010111)))

(assert (= expect result))

(check-sat)
(exit)
