; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b11)
                arg1
                (fp #b1 #b0110 #b10)))
(assert (fp.leq (fp #b1 #b0110 #b10)
                arg1
                (fp #b1 #b0100 #b01)))
; arg1 = -0.75

(declare-const result (_ FloatingPoint 9 5))
(assert (= result ((_ to_fp 9 5) rm arg1)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101001100 #b1101)
                expect
                (fp #b1 #b011111110 #b1000)))
(assert (fp.leq (fp #b1 #b011111110 #b1000)
                expect
                (fp #b0 #b101110101 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
