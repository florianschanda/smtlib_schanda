; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b1001011000001001)
                arg1
                (fp #b1 #b1010001 #b0101010110111110)))
(assert (fp.leq (fp #b1 #b1010001 #b0101010110111110)
                arg1
                (fp #b1 #b0011001 #b1110001101011001)))
; arg1 = -349944.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111101 #b00111010111100101101101)
                expect
                (fp #b1 #b10010001 #b01010101101111100000000)))
(assert (fp.leq (fp #b1 #b10010001 #b01010101101111100000000)
                expect
                (fp #b1 #b00000100 #b10001101100001100100001)))
; expect = -349944.0

(assert (= expect result))

(check-sat)
(exit)
