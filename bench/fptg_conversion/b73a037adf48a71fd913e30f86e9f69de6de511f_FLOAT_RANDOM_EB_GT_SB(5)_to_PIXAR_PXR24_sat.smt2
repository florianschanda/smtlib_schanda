                expect
                (fp #b0 #b01111111 #b100000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b100000000000000)
                expect
                (fp #b0 #b10011000 #b010111000111101)))
; expect = 1.5

(assert (= expect result))

