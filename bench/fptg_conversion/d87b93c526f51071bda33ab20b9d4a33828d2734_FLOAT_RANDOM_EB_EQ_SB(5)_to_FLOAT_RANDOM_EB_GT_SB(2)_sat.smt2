(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000101011111100 #b110110000111000)
                arg1
                (fp #b1 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b000000000000000)
                arg1
                (fp #b0 #b0010001001101100 #b011111100111100)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result ((_ to_fp 10 9) rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0000010101 #b00110010)
                expect
                (fp #b1 #b0000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000001)
                expect
                (fp #b0 #b1000100110 #b11000001)))

(assert (= expect result))

(check-sat)
(exit)
