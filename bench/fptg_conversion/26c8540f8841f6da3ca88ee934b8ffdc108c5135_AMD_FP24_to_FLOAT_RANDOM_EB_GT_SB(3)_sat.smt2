(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0100010010000000)
                arg1
                (fp #b1 #b1100000 #b1001011101101101)))
(assert (fp.leq (fp #b1 #b1100000 #b1001011101101101)
                arg1
                (fp #b1 #b1000001 #b1011101001001010)))
; arg1 = -13670940672.0

(declare-const result (_ FloatingPoint 8 2))
(assert (= result ((_ to_fp 8 2) rm arg1)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11111001 #b1)
                expect
                (fp #b1 #b10100001 #b0)))
(assert (fp.leq (fp #b1 #b10100001 #b0)
                expect
                (fp #b0 #b01000001 #b1)))
; expect = -17179869184.0

(assert (= expect result))

(check-sat)
(exit)
