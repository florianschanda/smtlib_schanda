; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0111110111)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b11110 #b1010100111)))
; arg1 = 1.59765625

(declare-const result (_ FloatingPoint 10 9))
(assert (= result ((_ to_fp 10 9) rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0110111100 #b00100010)
                expect
                (fp #b0 #b0111111111 #b10011001)))
(assert (fp.leq (fp #b0 #b0111111111 #b10011001)
                expect
                (fp #b0 #b1110011011 #b10010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
