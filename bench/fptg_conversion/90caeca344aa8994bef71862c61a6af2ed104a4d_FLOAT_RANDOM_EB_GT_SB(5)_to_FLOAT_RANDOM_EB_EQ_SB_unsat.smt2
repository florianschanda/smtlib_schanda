; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0001 #b1)
                arg1
                (fp #b0 #b1011 #b1)))
(assert (fp.leq (fp #b0 #b1011 #b1)
                arg1
                (fp #b0 #b1101 #b1)))
; arg1 = 24.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001110101010 #b11101111000)
                expect
                (fp #b0 #b100000000011 #b10000000000)))
(assert (fp.leq (fp #b0 #b100000000011 #b10000000000)
                expect
                (fp #b0 #b110100001100 #b00110011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
