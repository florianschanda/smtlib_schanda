; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0011)
                arg1
                (fp #b1 #b000 #b1100)))
(assert (fp.leq (fp #b1 #b000 #b1100)
                arg1
                (fp #b0 #b001 #b0101)))
; arg1 = -0.1875

(declare-const result (_ FloatingPoint 13 12))
(assert (= result ((_ to_fp 13 12) rm arg1)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1010010000111 #b01001011110)
                expect
                (fp #b1 #b0111111111100 #b10000000000)))
(assert (fp.leq (fp #b1 #b0111111111100 #b10000000000)
                expect
                (fp #b1 #b0001100111001 #b10100110001)))

(assert (= expect result))

(check-sat)
(exit)
