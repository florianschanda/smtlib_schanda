; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10010 #b1000001100)
                arg1
                (fp #b0 #b01000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000 #b0000000000)
                arg1
                (fp #b0 #b11100 #b1101010001)))
; arg1 = 0.0078125

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000010101 #b0011110011)
                expect
                (fp #b0 #b01111111000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111000 #b0000000000)
                expect
                (fp #b0 #b10111010110 #b1101011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
