(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11000010110001010 #b1)
                arg1
                (fp #b0 #b00000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0)
                arg1
                (fp #b0 #b00101111100100001 #b0)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b110 #b0110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
