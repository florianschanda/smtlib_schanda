; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01001010 #b1101011)
                arg1
                (fp #b0 #b00000000 #b1011100)))
(assert (fp.leq (fp #b0 #b00000000 #b1011100)
                arg1
                (fp #b0 #b01010010 #b1111011)))
