(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111100 #b10)
                arg1
                (fp #b1 #b1001000 #b01)))
(assert (fp.leq (fp #b1 #b1001000 #b01)
                arg1
                (fp #b1 #b0011100 #b01)))
; arg1 = -640.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b0110100)
                expect
                (fp #b1 #b10001000 #b0100000)))
(assert (fp.leq (fp #b1 #b10001000 #b0100000)
                expect
                (fp #b0 #b00101000 #b0000101)))
; expect = -640.0

(assert (= expect result))

(check-sat)
(exit)
