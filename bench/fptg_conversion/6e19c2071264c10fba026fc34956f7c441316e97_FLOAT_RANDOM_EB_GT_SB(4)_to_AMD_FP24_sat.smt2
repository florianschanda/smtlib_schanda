(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11000010 #b00)
                arg1
                (fp #b1 #b01111111 #b11)))
(assert (fp.leq (fp #b1 #b01111111 #b11)
                arg1
                (fp #b1 #b00101011 #b01)))
; arg1 = -1.75

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1011110101100110)
                expect
                (fp #b1 #b0111111 #b1100000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b1100000000000000)
                expect
                (fp #b0 #b0010000 #b1001100001001001)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
