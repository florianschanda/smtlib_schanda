(assert (fp.leq (fp #b1 #b11100100 #b111)
                expect
                (fp #b1 #b10010111 #b011)))
(assert (fp.leq (fp #b1 #b10010111 #b011)
                expect
                (fp #b1 #b10000111 #b111)))
; expect = -23068672.0

(assert (= expect result))

(check-sat)
