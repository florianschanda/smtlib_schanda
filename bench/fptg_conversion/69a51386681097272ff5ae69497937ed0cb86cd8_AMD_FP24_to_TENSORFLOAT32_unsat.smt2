(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010001 #b1111101001011001)
                arg1
                (fp #b0 #b1001110 #b1110100110010000)))
(assert (fp.leq (fp #b0 #b1001110 #b1110100110010000)
                arg1
                (fp #b0 #b1010000 #b0110010110011001)))
; arg1 = 62664.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01100111 #b0000111101)
                expect
                (fp #b0 #b10001110 #b1110100111)))
(assert (fp.leq (fp #b0 #b10001110 #b1110100111)
                expect
                (fp #b0 #b11001000 #b1111001100)))
; expect = 62688.0

(assert (not (= expect result)))

(check-sat)
(exit)
