; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0101001010)
                arg1
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg1
                (fp #b0 #b01101 #b1101100111)))
; arg1 = -16384.0

(declare-const result (_ FloatingPoint 6 11))
(assert (= result ((_ to_fp 6 11) rm arg1)))

(declare-const expect (_ FloatingPoint 6 11))
(assert (fp.leq (fp #b1 #b101111 #b1111001010)
                expect
                (fp #b1 #b101101 #b0000000000)))
(assert (fp.leq (fp #b1 #b101101 #b0000000000)
                expect
                (fp #b0 #b100101 #b1101011010)))
; expect = -16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
