; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111000 #b1010110100100011)
                arg1
                (fp #b1 #b1010101 #b0001001101010100)))
(assert (fp.leq (fp #b1 #b1010101 #b0001001101010100)
                arg1
                (fp #b1 #b0000001 #b1011111010111111)))
; arg1 = -4510976.0

(declare-const result (_ FloatingPoint 6 2))
(assert (= result ((_ to_fp 6 2) rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110110 #b1)
                expect
                (fp #b1 #b110101 #b1)))
(assert (fp.leq (fp #b1 #b110101 #b1)
                expect
                (fp #b1 #b101001 #b1)))
; expect = -6291456.0

(assert (not (= expect result)))

(check-sat)
(exit)
