; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01010011 #b00111111100101111111000)
                arg1
                (fp #b0 #b01111111 #b10111000111111110010110)))
(assert (fp.leq (fp #b0 #b01111111 #b10111000111111110010110)
                arg1
                (fp #b0 #b10111001 #b10011110100100100100100)))
; arg1 = 1.7226436138153076171875

(declare-const result (_ FloatingPoint 18 8))
(assert (= result ((_ to_fp 18 8) rm arg1)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b011001111110101001 #b0101000)
                expect
                (fp #b0 #b011111111111111111 #b1011101)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b1011101)
                expect
                (fp #b0 #b110000110001001111 #b1100001)))

(assert (= expect result))

(check-sat)
(exit)
