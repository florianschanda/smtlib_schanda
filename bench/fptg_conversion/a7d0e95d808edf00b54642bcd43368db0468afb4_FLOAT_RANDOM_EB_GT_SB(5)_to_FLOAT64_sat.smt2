; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11100 #b0)
                arg1
                (fp #b1 #b10111 #b0)))
(assert (fp.leq (fp #b1 #b10111 #b0)
                arg1
                (fp #b1 #b01100 #b0)))
; arg1 = -256.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010100001 #b1110010000010100100101101100100100101100010000100011)
                expect
                (fp #b1 #b10000000111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10100001001 #b1110100111101010010100110110010001010110001100000111)))

(assert (= expect result))

(check-sat)
(exit)
