(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1000111 #b110000)
                arg1
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg1
                (fp #b0 #b1001100 #b011111)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01110011000 #b0010001)
                expect
                (fp #b0 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000)
                expect
                (fp #b0 #b10011010110 #b0101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
