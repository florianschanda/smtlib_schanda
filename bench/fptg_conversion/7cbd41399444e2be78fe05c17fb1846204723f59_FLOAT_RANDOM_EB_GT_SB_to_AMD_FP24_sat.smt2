(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b01)
                arg1
                (fp #b0 #b1010 #b00)))
(assert (fp.leq (fp #b0 #b1010 #b00)
                arg1
                (fp #b0 #b1010 #b01)))
; arg1 = 8.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101001 #b1110101000111100)
                expect
                (fp #b0 #b1000010 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000010 #b0000000000000000)
                expect
                (fp #b0 #b1101100 #b1001001001110110)))
; expect = 8.0

(assert (= expect result))

(check-sat)
(exit)
