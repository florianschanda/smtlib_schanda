; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                arg1
                (fp #b0 #b010 #b0)))
(assert (fp.leq (fp #b0 #b010 #b0)
                arg1
                (fp #b0 #b101 #b1)))
; arg1 = 0.5

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011010011 #b00010111)
                expect
                (fp #b0 #b011111110 #b00000000)))
(assert (fp.leq (fp #b0 #b011111110 #b00000000)
                expect
                (fp #b0 #b110101111 #b00010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
