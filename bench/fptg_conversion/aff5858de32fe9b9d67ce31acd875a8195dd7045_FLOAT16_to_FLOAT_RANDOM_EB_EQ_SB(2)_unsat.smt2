; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0000011110)
                arg1
                (fp #b0 #b11100 #b1001010011)))
(assert (fp.leq (fp #b0 #b11100 #b1001010011)
                arg1
                (fp #b0 #b11100 #b1010000001)))
; arg1 = 12952.0

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101000 #b01111110)
                expect
                (fp #b0 #b100001100 #b10010101)))
(assert (fp.leq (fp #b0 #b100001100 #b10010101)
                expect
                (fp #b0 #b111001100 #b11101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
