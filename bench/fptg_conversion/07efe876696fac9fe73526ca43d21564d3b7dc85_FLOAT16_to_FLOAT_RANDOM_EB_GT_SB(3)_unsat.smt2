; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0111101110)
                arg1
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg1
                (fp #b0 #b11000 #b1001000011)))
; arg1 = 0.000060975551605224609375

(declare-const result (_ FloatingPoint 7 5))
(assert (= result ((_ to_fp 7 5) rm arg1)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b1 #b0100000 #b0110)
                expect
                (fp #b0 #b0110001 #b0000)))
(assert (fp.leq (fp #b0 #b0110001 #b0000)
                expect
                (fp #b0 #b0111110 #b1111)))
; expect = 0.00006103515625

(assert (not (= expect result)))

(check-sat)
(exit)
