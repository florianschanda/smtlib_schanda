; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011010000 #b0001011)
                arg1
                (fp #b1 #b0000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b0000000)
                arg1
                (fp #b0 #b0111100100 #b1001111)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00110 #b0100)
                expect
                (fp #b1 #b00000 #b0001)))
(assert (fp.leq (fp #b1 #b00000 #b0001)
                expect
                (fp #b0 #b01110 #b0110)))
; expect = -0.000003814697265625

(assert (= expect result))

(check-sat)
