(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1010110010)
                arg1
                (fp #b0 #b00000 #b1011110010)))
(assert (fp.leq (fp #b0 #b00000 #b1011110010)
                arg1
                (fp #b0 #b01111 #b0101001010)))
; arg1 = 0.00004494190216064453125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000100 #b11000100101010101001010)
                expect
                (fp #b0 #b01110000 #b01111001000000000000000)))
(assert (fp.leq (fp #b0 #b01110000 #b01111001000000000000000)
                expect
                (fp #b0 #b11011011 #b01000001011111100001100)))
; expect = 0.00004494190216064453125

(assert (= expect result))

(check-sat)
(exit)
