; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                arg1
                (fp #b1 #b10000 #b1)))
(assert (fp.leq (fp #b1 #b10000 #b1)
                arg1
                (fp #b1 #b01010 #b0)))
; arg1 = -3.0

(declare-const result (_ FloatingPoint 8 5))
(assert (= result ((_ to_fp 8 5) rm arg1)))

(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10010001 #b0011)
                expect
                (fp #b1 #b10000000 #b1000)))
(assert (fp.leq (fp #b1 #b10000000 #b1000)
                expect
                (fp #b0 #b11110100 #b0110)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
