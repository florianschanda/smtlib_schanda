(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110100 #b1001110011)
                arg1
                (fp #b0 #b01111111 #b1101111000)))
(assert (fp.leq (fp #b0 #b01111111 #b1101111000)
                arg1
                (fp #b0 #b10001111 #b0111010100)))
; arg1 = 1.8671875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0011)
                expect
                (fp #b0 #b011 #b1110)))
(assert (fp.leq (fp #b0 #b011 #b1110)
                expect
                (fp #b0 #b100 #b1100)))
; expect = 1.875

(assert (= expect result))

(check-sat)
(exit)
