(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg1
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                arg1
                (fp #b1 #b011 #b0100)))
; arg1 = -1.625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001101 #b00100110101101110001000)
                expect
                (fp #b1 #b01111111 #b10100000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b10100000000000000000000)
                expect
                (fp #b0 #b01010111 #b00110110001110001101000)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
