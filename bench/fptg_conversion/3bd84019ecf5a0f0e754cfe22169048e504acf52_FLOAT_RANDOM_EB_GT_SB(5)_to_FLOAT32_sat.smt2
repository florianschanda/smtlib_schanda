(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1000 #b10)
                arg1
                (fp #b0 #b1001 #b11)))
(assert (fp.leq (fp #b0 #b1001 #b11)
                arg1
                (fp #b0 #b1111 #b00)))
; arg1 = 7.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101001 #b01010001010000111111011)
                expect
                (fp #b0 #b10000001 #b11000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b11000000000000000000000)
                expect
                (fp #b0 #b11010110 #b10111111000011111010010)))
; expect = 7.0

(assert (= expect result))

(check-sat)
(exit)
