; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: -LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg1
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11100 #b0011010100)))
; arg1 = -65504.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001111 #b110001101110111)
                expect
                (fp #b1 #b10001110 #b111111111100000)))
(assert (fp.leq (fp #b1 #b10001110 #b111111111100000)
                expect
                (fp #b1 #b10000100 #b100110111010100)))
; expect = -65504.0

(assert (= expect result))

(check-sat)
(exit)
