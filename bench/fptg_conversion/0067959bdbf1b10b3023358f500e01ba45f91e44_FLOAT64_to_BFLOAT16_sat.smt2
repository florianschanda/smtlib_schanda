; Format from: FLOAT64
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101010110 #b1111000011001001100100100000011100110010000011101111)
                arg1
                (fp #b1 #b10000101011 #b1001010111010110101111110000011101101000101111101001)))
(assert (fp.leq (fp #b1 #b10000101011 #b1001010111010110101111110000011101101000101111101001)
                arg1
                (fp #b1 #b01000110110 #b1111110110010001011001100001100100110001110101100100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b0101000)
                expect
                (fp #b1 #b10101011 #b1001011)))
(assert (fp.leq (fp #b1 #b10101011 #b1001011)
                expect
                (fp #b1 #b00011100 #b1001010)))
; expect = -27900107554816.0

(assert (= expect result))

(check-sat)
(exit)
