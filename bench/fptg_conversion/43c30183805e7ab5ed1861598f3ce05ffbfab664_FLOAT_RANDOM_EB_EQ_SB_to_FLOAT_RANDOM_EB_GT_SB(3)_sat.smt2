; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010000 #b011100)
                arg1
                (fp #b1 #b0111111 #b110011)))
(assert (fp.leq (fp #b1 #b0111111 #b110011)
                arg1
                (fp #b0 #b0101011 #b100000)))
; arg1 = -1.796875

(declare-const result (_ FloatingPoint 14 12))
(assert (= result ((_ to_fp 14 12) rm arg1)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10011010011110 #b00110101110)
                expect
                (fp #b1 #b01111111111111 #b11001100000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b11001100000)
                expect
                (fp #b0 #b00101100110100 #b11111110001)))

(assert (= expect result))

(check-sat)
(exit)
