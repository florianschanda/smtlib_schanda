; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111000 #b01101)
                arg1
                (fp #b1 #b0111111 #b11111)))
(assert (fp.leq (fp #b1 #b0111111 #b11111)
                arg1
                (fp #b1 #b0111101 #b10010)))
; arg1 = -1.96875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0101001010)
                expect
                (fp #b1 #b01111 #b1111100000)))
(assert (fp.leq (fp #b1 #b01111 #b1111100000)
                expect
                (fp #b0 #b11011 #b1010011110)))
; expect = -1.96875

(assert (= expect result))

(check-sat)
(exit)
