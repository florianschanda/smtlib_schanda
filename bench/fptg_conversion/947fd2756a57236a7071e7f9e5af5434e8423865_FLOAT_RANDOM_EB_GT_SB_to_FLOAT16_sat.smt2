(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011001011 #b10)
                arg1
                (fp #b1 #b0111111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111111 #b11)
                arg1
                (fp #b1 #b0110100011 #b11)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b1111000011)
                expect
                (fp #b1 #b01111 #b1100000000)))
(assert (fp.leq (fp #b1 #b01111 #b1100000000)
                expect
                (fp #b0 #b11001 #b0010111011)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
