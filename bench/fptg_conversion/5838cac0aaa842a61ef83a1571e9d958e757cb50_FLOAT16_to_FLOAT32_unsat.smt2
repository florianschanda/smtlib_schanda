; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0001001110)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b01110 #b1100000101)))
; arg1 = -0.001132965087890625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010001 #b00111110110111101011110)
                expect
                (fp #b1 #b01110101 #b00101001000000000000000)))
(assert (fp.leq (fp #b1 #b01110101 #b00101001000000000000000)
                expect
                (fp #b0 #b01111101 #b00011100101101100000101)))
; expect = -0.001132965087890625

(assert (not (= expect result)))

(check-sat)
(exit)
