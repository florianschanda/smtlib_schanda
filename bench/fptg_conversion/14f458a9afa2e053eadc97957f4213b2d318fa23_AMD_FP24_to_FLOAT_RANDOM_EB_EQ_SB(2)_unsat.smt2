(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011010100 #b110100001)
                expect
                (fp #b0 #b1000101100 #b101010011)))
(assert (fp.leq (fp #b0 #b1000101100 #b101010011)
                expect
                (fp #b0 #b1111011000 #b110010111)))

(assert (not (= expect result)))

(check-sat)
