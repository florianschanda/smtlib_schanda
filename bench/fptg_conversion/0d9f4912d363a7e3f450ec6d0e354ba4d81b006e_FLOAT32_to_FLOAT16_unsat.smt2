(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11111001010110101100000)
                arg1
                (fp #b0 #b01111111 #b00010001000010101011100)))
(assert (fp.leq (fp #b0 #b01111111 #b00010001000010101011100)
                arg1
                (fp #b0 #b11010000 #b00110101100001110001101)))
; arg1 = 1.066569805145263671875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00110 #b1100101001)
                expect
                (fp #b0 #b01111 #b0001000101)))
(assert (fp.leq (fp #b0 #b01111 #b0001000101)
                expect
                (fp #b0 #b10101 #b0101011010)))
; expect = 1.0673828125

(assert (not (= expect result)))

(check-sat)
(exit)
