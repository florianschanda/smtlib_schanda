(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1000110000100001 #b0110011)
                arg1
                (fp #b1 #b0100000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0000000)
                arg1
                (fp #b0 #b0010110101001100 #b0000110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0110)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b110 #b1011)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
