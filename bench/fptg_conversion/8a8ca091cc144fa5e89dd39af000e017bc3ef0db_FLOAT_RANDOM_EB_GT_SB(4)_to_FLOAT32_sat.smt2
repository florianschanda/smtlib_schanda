(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000110111 #b11101)
                arg1
                (fp #b1 #b1000000011 #b10110)))
(assert (fp.leq (fp #b1 #b1000000011 #b10110)
                arg1
                (fp #b1 #b0101000000 #b10111)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001110 #b01111000100110000011111)
                expect
                (fp #b1 #b10000011 #b10110000000000000000000)))
(assert (fp.leq (fp #b1 #b10000011 #b10110000000000000000000)
                expect
                (fp #b0 #b00001010 #b01111000011111100011100)))
; expect = -27.0

(assert (= expect result))

(check-sat)
(exit)
