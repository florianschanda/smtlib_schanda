(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101010000 #b0111111)
                arg1
                (fp #b1 #b100000110 #b0110001)))
(assert (fp.leq (fp #b1 #b100000110 #b0110001)
                arg1
                (fp #b1 #b001101000 #b1011000)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result ((_ to_fp 10 3) rm arg1)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011100111 #b11)
                expect
                (fp #b1 #b1000000110 #b10)))
(assert (fp.leq (fp #b1 #b1000000110 #b10)
                expect
                (fp #b0 #b0000100011 #b11)))

(assert (= expect result))

(check-sat)
(exit)
