; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0110110000110 #b011101010)
                arg1
                (fp #b0 #b0111111111111 #b110010111)))
(assert (fp.leq (fp #b0 #b0111111111111 #b110010111)
                arg1
                (fp #b0 #b1010011101000 #b000000010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1110)
                expect
                (fp #b0 #b011 #b1101)))
(assert (fp.leq (fp #b0 #b011 #b1101)
                expect
                (fp #b0 #b100 #b0001)))
; expect = 1.8125

(assert (= expect result))

(check-sat)
(exit)
