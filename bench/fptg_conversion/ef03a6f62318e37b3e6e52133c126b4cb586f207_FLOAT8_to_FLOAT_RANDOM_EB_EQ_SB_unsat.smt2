                expect
                (fp #b0 #b100000000010 #b01100000000)))
(assert (fp.leq (fp #b0 #b100000000010 #b01100000000)
                expect
                (fp #b0 #b110010101110 #b10001010001)))

(assert (not (= expect result)))

