(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110100111010 #b1100001111100)
                arg1
                (fp #b1 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b10000000001101 #b0000000000000)
                arg1
                (fp #b1 #b01001111100000 #b0101011000100)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b0100100011101101)
                expect
                (fp #b1 #b1001101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1001101 #b0000000000000000)
                expect
                (fp #b0 #b0101111 #b0100100000110100)))
; expect = -16384.0

(assert (not (= expect result)))

(check-sat)
