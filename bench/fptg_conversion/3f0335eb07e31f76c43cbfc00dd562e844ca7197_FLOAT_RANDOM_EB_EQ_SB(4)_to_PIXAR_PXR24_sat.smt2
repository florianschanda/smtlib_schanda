; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000111001111010 #b000110100011000)
                arg1
                (fp #b0 #b0000000000000000 #b110011001100100)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110011001100100)
                arg1
                (fp #b0 #b1001011001001110 #b010011110100000)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011110 #b111100111100100)
                expect
                (fp #b0 #b00000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000001)
                expect
                (fp #b0 #b10100110 #b000110000110110)))
; expect = 0.000000000000000000000000000000000000000000358732406867153170156474773322218529607747057120388037569809480675786517167580313980579376220703125

(assert (= expect result))

(check-sat)
