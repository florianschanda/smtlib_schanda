(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b0)
                arg1
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                arg1
                (fp #b0 #b00100 #b1)))
; arg1 = -4.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001110 #b11000000010000100011110)
                expect
                (fp #b1 #b10000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001 #b00000000000000000000000)
                expect
                (fp #b0 #b01001010 #b11100101000010111001110)))
; expect = -4.0

(assert (= expect result))

(check-sat)
(exit)
