(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010011100 #b0101000001)
                expect
                (fp #b1 #b01111111111 #b1011000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b1011000000)
                expect
                (fp #b0 #b11110001101 #b0111100111)))

(assert (= expect result))

(check-sat)
