; Format from: FLOAT64
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010101100 #b1111001011100100101001000101110100110000110110110100)
                arg1
                (fp #b1 #b10111111100 #b0110000100010000000110000010010000010001001111001011)))
(assert (fp.leq (fp #b1 #b10111111100 #b0110000100010000000110000010010000010001001111001011)
                arg1
                (fp #b1 #b10110101011 #b1000000100010000010100011010101101100101110100101011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
