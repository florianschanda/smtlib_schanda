; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001010 #b11110011011001100001000)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b1 #b00101100 #b10010100011010110100011)))
; arg1 = -1.040654659271240234375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110010 #b01110)
                expect
                (fp #b1 #b011111 #b00010)))
(assert (fp.leq (fp #b1 #b011111 #b00010)
                expect
                (fp #b0 #b110110 #b00101)))
; expect = -1.0625

(assert (not (= expect result)))

(check-sat)
(exit)
