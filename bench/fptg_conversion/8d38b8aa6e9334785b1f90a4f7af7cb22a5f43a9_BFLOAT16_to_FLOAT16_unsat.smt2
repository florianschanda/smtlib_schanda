; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b0000100)
                arg1
                (fp #b0 #b11001001 #b0100010)))
(assert (fp.leq (fp #b0 #b11001001 #b0100010)
                arg1
                (fp #b0 #b11101110 #b1000110)))
; arg1 = 23906980319527578894336.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
