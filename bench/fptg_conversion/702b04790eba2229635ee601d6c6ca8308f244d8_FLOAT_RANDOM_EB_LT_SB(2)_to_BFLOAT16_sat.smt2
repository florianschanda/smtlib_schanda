                arg1
                (fp #b0 #b0000 #b00110111100011000000111001011111111000101011011010111000101010011001000000111010101100100010010111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00100100 #b1010100)
                expect
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                expect
                (fp #b0 #b01100110 #b1111110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
