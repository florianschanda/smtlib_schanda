(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010010 #b01100100100000110001011)
                arg1
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10000010 #b00110011010010010110111)))
; arg1 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00111110 #b0001010)
                expect
                (fp #b0 #b01000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000 #b0000000)
                expect
                (fp #b0 #b01110110 #b0011110)))
; expect = 0.000000000000000000108420217248550443400745280086994171142578125

(assert (= expect result))

(check-sat)
(exit)
