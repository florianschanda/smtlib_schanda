(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00000010101100 #b0110100011)
                arg1
                (fp #b1 #b00000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000)
                arg1
                (fp #b0 #b01011011000101 #b1001101110)))

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01111010010 #b0111011000001111111010111111000100111101101100100101)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010101010 #b1001011000010010001010001110110100000110000000111110)))

(assert (= expect result))

(check-sat)
(exit)
