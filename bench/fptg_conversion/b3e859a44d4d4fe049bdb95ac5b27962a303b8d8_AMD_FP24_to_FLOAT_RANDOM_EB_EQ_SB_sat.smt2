; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b1100001011001011)
                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b1101001 #b0010100100001000)))
; arg1 = 0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 13 13))
(assert (= result ((_ to_fp 13 13) rm arg1)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0101101101100 #b100010010111)
                expect
                (fp #b0 #b0111111100000 #b000000000000)))
(assert (fp.leq (fp #b0 #b0111111100000 #b000000000000)
                expect
                (fp #b0 #b1100110010110 #b000000110101)))

(assert (= expect result))

(check-sat)
(exit)
