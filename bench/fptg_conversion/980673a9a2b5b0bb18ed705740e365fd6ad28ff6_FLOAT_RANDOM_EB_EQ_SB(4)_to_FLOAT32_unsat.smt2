; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001001110 #b100011100)
                arg1
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                arg1
                (fp #b0 #b1100000010 #b010111101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000000 #b01100000110110011111101)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10001111 #b10101001101111101100010)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
