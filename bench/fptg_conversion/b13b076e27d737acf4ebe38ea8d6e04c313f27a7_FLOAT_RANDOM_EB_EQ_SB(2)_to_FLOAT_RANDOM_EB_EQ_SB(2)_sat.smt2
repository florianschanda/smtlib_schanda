(assert (fp.leq (fp #b1 #b1110 #b010)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b0001 #b111)))
; expect = 0.001953125

