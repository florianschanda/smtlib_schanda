(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b01110)
                arg1
                (fp #b1 #b011111 #b00000)))
(assert (fp.leq (fp #b1 #b011111 #b00000)
                arg1
                (fp #b0 #b101101 #b00000)))
; arg1 = -1.0

(declare-const result (_ FloatingPoint 14 3))
(assert (= result ((_ to_fp 14 3) rm arg1)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11000110100000 #b01)
                expect
                (fp #b1 #b01111111111111 #b00)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00)
                expect
                (fp #b0 #b11101001111010 #b00)))

(assert (= expect result))

(check-sat)
(exit)
