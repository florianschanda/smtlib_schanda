(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT64
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b111011111 #b0010)
                arg1
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg1
                (fp #b0 #b001110101 #b0111)))

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01010100110 #b1010010000110101011011111001010111000010000111111100)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10100010101 #b0011110100110010000011100100101110101110101110110010)))

(assert (= expect result))

(check-sat)
(exit)
