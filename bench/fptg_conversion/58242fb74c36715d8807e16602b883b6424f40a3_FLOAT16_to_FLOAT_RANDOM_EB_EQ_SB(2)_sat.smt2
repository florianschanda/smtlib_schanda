(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100101001 #b01011101110)
                expect
                (fp #b1 #b011111110001 #b11011101100)))
(assert (fp.leq (fp #b1 #b011111110001 #b11011101100)
                expect
                (fp #b0 #b100010000011 #b01100000000)))

(assert (= expect result))

(check-sat)
(exit)
