; Format from: FLOAT64
; Format to: FLOAT_2_2
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000101110 #b0010000011100111011111101010111001110010000010011011)
                arg1
                (fp #b0 #b00000000000 #b0100100111111101111100100010011101000001011101001000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100100111111101111100100010011101000001011101001000)
                arg1
                (fp #b0 #b11010111011 #b1111101100000001011101100100100010111101010010011000)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b10 #b1)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
