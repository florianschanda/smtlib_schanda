(assert (fp.leq (fp #b1 #b11001101110101 #b0010101)
                expect
                (fp #b0 #b01111111111110 #b0000000)))
(assert (fp.leq (fp #b0 #b01111111111110 #b0000000)
                expect
                (fp #b0 #b11010101001001 #b1100111)))

(assert (not (= expect result)))

(check-sat)
