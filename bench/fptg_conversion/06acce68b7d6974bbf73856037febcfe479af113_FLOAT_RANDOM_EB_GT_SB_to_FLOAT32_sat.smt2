; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100000010 #b0000001)
                arg1
                (fp #b0 #b0111010000 #b0010000)))
(assert (fp.leq (fp #b0 #b0111010000 #b0010000)
                arg1
                (fp #b0 #b1110100001 #b0000010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b01100100100110101000111)
                expect
                (fp #b0 #b01010000 #b00100000000000000000000)))
(assert (fp.leq (fp #b0 #b01010000 #b00100000000000000000000)
                expect
                (fp #b0 #b11110000 #b01110010010110110001010)))
; expect = 0.00000000000000799360577730112709105014801025390625

(assert (= expect result))

(check-sat)
(exit)
