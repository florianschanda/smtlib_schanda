(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1100010100)
                arg1
                (fp #b1 #b00000 #b0101100101)))
(assert (fp.leq (fp #b1 #b00000 #b0101100101)
                arg1
                (fp #b0 #b01101 #b1000111101)))
; arg1 = -0.000021278858184814453125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101010 #b0101011)
                expect
                (fp #b1 #b01101111 #b0110011)))
(assert (fp.leq (fp #b1 #b01101111 #b0110011)
                expect
                (fp #b0 #b01101111 #b0010011)))
; expect = -0.00002133846282958984375

(assert (= expect result))

(check-sat)
(exit)
