; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01010101 #b00010010111000011010100)
                arg1
                (fp #b0 #b01111111 #b11101000110101111001111)))
(assert (fp.leq (fp #b0 #b01111111 #b11101000110101111001111)
                arg1
                (fp #b0 #b11111110 #b01000101110101101110111)))
; arg1 = 1.90954005718231201171875

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00011100100 #b0011010110)
                expect
                (fp #b0 #b01111111111 #b1110100100)))
(assert (fp.leq (fp #b0 #b01111111111 #b1110100100)
                expect
                (fp #b0 #b10100001110 #b1000110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
