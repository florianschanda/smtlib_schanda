(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: PIXAR_PXR24
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010100 #b111001000100000)
                arg1
                (fp #b0 #b10001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b000000000000000)
                arg1
                (fp #b0 #b11000101 #b011100111000110)))
; arg1 = 65536.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011001 #b10111010000100110000111)
                expect
                (fp #b0 #b10001111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b00000000000000000000000)
                expect
                (fp #b0 #b10110100 #b11000010100011011111100)))
; expect = 65536.0

(assert (= expect result))

(check-sat)
(exit)
