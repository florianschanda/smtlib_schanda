; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01001110 #b1000001001)
                arg1
                (fp #b0 #b00000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b1111111111)
                arg1
                (fp #b0 #b11010110 #b1111000100)))
; arg1 = 0.0000000000000000000000000000000000000117434640712031261782423581794761457852392076618930227978852831594025474259979091584682464599609375

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1111000011)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b00010 #b0101010111)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
