; Format from: AMD_FP24
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0000101100101110)
                arg1
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg1
                (fp #b0 #b0111000 #b1100010001111100)))
; arg1 = -14354451791872.0

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
