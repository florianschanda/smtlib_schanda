; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001111110 #b000101101)
                arg1
                (fp #b0 #b1000000111 #b000000100)))
(assert (fp.leq (fp #b0 #b1000000111 #b000000100)
                arg1
                (fp #b0 #b1001101101 #b011010111)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b0011)
                expect
                (fp #b0 #b10111 #b0001)))
(assert (fp.leq (fp #b0 #b10111 #b0001)
                expect
                (fp #b0 #b11010 #b1010)))
; expect = 272.0

(assert (= expect result))

(check-sat)
(exit)
