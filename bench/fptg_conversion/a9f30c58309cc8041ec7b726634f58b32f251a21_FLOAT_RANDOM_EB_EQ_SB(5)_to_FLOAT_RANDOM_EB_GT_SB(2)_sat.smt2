(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b010 #b11)))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b1 #b010 #b01)))
; arg1 = -0.875

(declare-const result (_ FloatingPoint 12 4))
(assert (= result ((_ to_fp 12 4) rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101100010101 #b000)
                expect
                (fp #b1 #b011111111110 #b110)))
(assert (fp.leq (fp #b1 #b011111111110 #b110)
                expect
                (fp #b0 #b000001110000 #b111)))

(assert (= expect result))

(check-sat)
(exit)
