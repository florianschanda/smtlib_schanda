; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0010 #b11)
                arg1
                (fp #b0 #b1000 #b00)))
(assert (fp.leq (fp #b0 #b1000 #b00)
                arg1
                (fp #b0 #b1000 #b10)))
; arg1 = 2.0

(declare-const result (_ FloatingPoint 3 32))
(assert (= result ((_ to_fp 3 32) rm arg1)))

(declare-const expect (_ FloatingPoint 3 32))
(assert (fp.leq (fp #b0 #b000 #b1101010111101101101111111010110)
                expect
                (fp #b0 #b100 #b0000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100 #b0000000000000000000000000000000)
                expect
                (fp #b0 #b100 #b0010101110111000000001001110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
