                expect
                (fp #b0 #b011111111111111 #b010000000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b010000000000)
                expect
                (fp #b0 #b110111111110000 #b001101011001)))

(assert (= expect result))

