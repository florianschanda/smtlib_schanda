(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0101011101100011)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1111000 #b0110100001010001)))
; arg1 = 26078.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000011 #b1001001)
                expect
                (fp #b0 #b10001101 #b1001100)))
(assert (fp.leq (fp #b0 #b10001101 #b1001100)
                expect
                (fp #b0 #b11010011 #b0100101)))
; expect = 26112.0

(assert (not (= expect result)))

(check-sat)
(exit)
