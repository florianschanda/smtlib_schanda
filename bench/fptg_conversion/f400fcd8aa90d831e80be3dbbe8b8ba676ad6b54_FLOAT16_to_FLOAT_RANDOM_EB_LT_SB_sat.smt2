; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b1110101010)
                arg1
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg1
                (fp #b0 #b10011 #b1001001111)))
; arg1 = 1.3701171875

(declare-const result (_ FloatingPoint 7 9))
(assert (= result ((_ to_fp 7 9) rm arg1)))

(declare-const expect (_ FloatingPoint 7 9))
(assert (fp.leq (fp #b0 #b0001010 #b00001000)
                expect
                (fp #b0 #b0111111 #b01011111)))
(assert (fp.leq (fp #b0 #b0111111 #b01011111)
                expect
                (fp #b0 #b1011100 #b01101111)))
; expect = 1.37109375

(assert (= expect result))

(check-sat)
(exit)
