(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b01111100 #b100)
                arg1
                (fp #b0 #b01111111 #b001)))
(assert (fp.leq (fp #b0 #b01111111 #b001)
                arg1
                (fp #b0 #b11110000 #b111)))
; arg1 = 1.125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b01101001101111000101001)
                expect
                (fp #b0 #b01111111 #b00100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00100000000000000000000)
                expect
                (fp #b0 #b11111000 #b00101101010000001001100)))
; expect = 1.125

(assert (= expect result))

(check-sat)
(exit)
