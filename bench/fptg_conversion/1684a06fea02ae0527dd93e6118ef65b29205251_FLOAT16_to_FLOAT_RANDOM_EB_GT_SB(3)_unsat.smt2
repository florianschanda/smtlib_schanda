; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1110000001)
                arg1
                (fp #b1 #b00000 #b0001101111)))
(assert (fp.leq (fp #b1 #b00000 #b0001101111)
                arg1
                (fp #b0 #b11011 #b0010110001)))
; arg1 = -0.000006616115570068359375

(declare-const result (_ FloatingPoint 13 4))
(assert (= result ((_ to_fp 13 4) rm arg1)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1001101010010 #b010)
                expect
                (fp #b1 #b0111111101101 #b110)))
(assert (fp.leq (fp #b1 #b0111111101101 #b110)
                expect
                (fp #b0 #b0111001111011 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
