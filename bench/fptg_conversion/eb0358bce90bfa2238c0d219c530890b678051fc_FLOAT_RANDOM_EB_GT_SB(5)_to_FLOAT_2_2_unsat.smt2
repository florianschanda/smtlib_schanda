(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00000010101100 #b0110100011)
                arg1
                (fp #b1 #b00000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000)
                arg1
                (fp #b0 #b01011011000101 #b1001101110)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b1 #b00 #b0)))
(assert (fp.leq (fp #b1 #b00 #b0)
                expect
                (fp #b0 #b01 #b1)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
