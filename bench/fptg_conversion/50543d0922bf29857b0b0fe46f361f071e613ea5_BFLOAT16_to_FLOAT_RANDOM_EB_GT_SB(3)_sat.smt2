(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11001010 #b0000100)
                arg1
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg1
                (fp #b0 #b01111101 #b1010010)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 15 9))
(assert (= result ((_ to_fp 15 9) rm arg1)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000101000101011 #b11111101)
                expect
                (fp #b0 #b000000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000)
                expect
                (fp #b0 #b010101000110100 #b11111001)))

(assert (= expect result))

(check-sat)
(exit)
