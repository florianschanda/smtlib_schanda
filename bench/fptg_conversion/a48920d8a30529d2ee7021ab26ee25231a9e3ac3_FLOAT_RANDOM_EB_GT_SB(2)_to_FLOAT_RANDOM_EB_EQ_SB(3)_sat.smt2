(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100110011101 #b0011100)
                arg1
                (fp #b0 #b101100000101 #b0010011)))
(assert (fp.leq (fp #b0 #b101100000101 #b0010011)
                arg1
                (fp #b0 #b110110100001 #b0000110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110001000110000 #b101101010111001)
                expect
                (fp #b0 #b1000001100000101 #b001001100000000)))
(assert (fp.leq (fp #b0 #b1000001100000101 #b001001100000000)
                expect
                (fp #b0 #b1110101000010111 #b101110010110000)))

(assert (= expect result))

(check-sat)
(exit)
