; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b001010010111111000 #b00001101101000011)
                arg1
                (fp #b0 #b011111111111111111 #b00100110001111010)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b00100110001111010)
                arg1
                (fp #b0 #b100001000110001110 #b01101011111111001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101011 #b0010001)
                expect
                (fp #b0 #b01111111 #b0010100)))
(assert (fp.leq (fp #b0 #b01111111 #b0010100)
                expect
                (fp #b0 #b10010011 #b1111110)))
; expect = 1.15625

(assert (= expect result))

(check-sat)
(exit)
