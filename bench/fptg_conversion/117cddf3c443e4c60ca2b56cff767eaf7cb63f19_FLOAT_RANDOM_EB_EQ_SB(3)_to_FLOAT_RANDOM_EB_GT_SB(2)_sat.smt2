; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001001 #b01000)
                arg1
                (fp #b0 #b111101 #b00000)))
(assert (fp.leq (fp #b0 #b111101 #b00000)
                arg1
                (fp #b0 #b111101 #b11111)))
; arg1 = 1073741824.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result ((_ to_fp 7 2) rm arg1)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0001100 #b0)
                expect
                (fp #b0 #b1011101 #b0)))
(assert (fp.leq (fp #b0 #b1011101 #b0)
                expect
                (fp #b0 #b1101101 #b1)))
; expect = 1073741824.0

(assert (= expect result))

(check-sat)
(exit)
