; Format from: AMD_FP24
; Format to: FLOAT8
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100011 #b0101111000110000)
                arg1
                (fp #b1 #b0000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000001 #b0000000000000000)
                arg1
                (fp #b0 #b1111010 #b0001001111010111)))
; arg1 = -0.00000000000000000021684043449710088680149056017398834228515625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1111)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b011 #b1110)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
