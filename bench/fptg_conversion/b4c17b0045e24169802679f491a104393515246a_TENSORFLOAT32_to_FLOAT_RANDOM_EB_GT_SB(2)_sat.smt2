(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b01000 #b100)
                expect
                (fp #b0 #b00000 #b001)))
(assert (fp.leq (fp #b0 #b00000 #b001)
                expect
                (fp #b0 #b00011 #b000)))
; expect = 0.00000762939453125

(assert (= expect result))

