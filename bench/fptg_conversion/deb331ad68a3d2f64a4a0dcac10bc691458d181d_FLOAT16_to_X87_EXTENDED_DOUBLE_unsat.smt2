(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b100001010010100 #b010110011111000000010001010001000100111011010111001100111111011)
                expect
                (fp #b1 #b100000000001000 #b110000011000000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000001000 #b110000011000000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b001010100010100 #b101001001100001011111000110010110101000011111111101001110111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
