(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0101001001011 #b01001)
                arg1
                (fp #b0 #b0000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00001)
                arg1
                (fp #b0 #b1000000110100 #b11010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00110 #b0101100110)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01011 #b1100111010)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
