(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b01011110100101011 #b0011000100000000)
                arg1
                (fp #b1 #b00000000000000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1111111111111111)
                arg1
                (fp #b0 #b01111001101000000 #b0100011011010011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1111)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b110 #b0101)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
