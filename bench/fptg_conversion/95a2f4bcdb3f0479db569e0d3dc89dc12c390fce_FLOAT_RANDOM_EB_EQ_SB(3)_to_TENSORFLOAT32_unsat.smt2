                expect
                (fp #b0 #b01111111 #b0100000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0100000000)
                expect
                (fp #b0 #b10100100 #b1110101000)))
; expect = 1.25

(assert (not (= expect result)))

