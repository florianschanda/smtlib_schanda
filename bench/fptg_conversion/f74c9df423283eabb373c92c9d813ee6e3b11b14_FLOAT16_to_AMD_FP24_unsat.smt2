; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1110000011)
                arg1
                (fp #b1 #b10110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10110 #b1111111111)
                arg1
                (fp #b1 #b01111 #b1000100111)))
; arg1 = -255.875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001100 #b1011111011011111)
                expect
                (fp #b1 #b1000110 #b1111111111000000)))
(assert (fp.leq (fp #b1 #b1000110 #b1111111111000000)
                expect
                (fp #b1 #b0111101 #b0110010010001100)))
; expect = -255.875

(assert (not (= expect result)))

(check-sat)
(exit)
