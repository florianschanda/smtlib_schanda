; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10111 #b0111100101)
                arg1
                (fp #b0 #b11101 #b0000001101)))
(assert (fp.leq (fp #b0 #b11101 #b0000001101)
                arg1
                (fp #b0 #b11110 #b1101011010)))
; arg1 = 16592.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100010011100 #b00111101000)
                expect
                (fp #b0 #b100000001101 #b00000011010)))
(assert (fp.leq (fp #b0 #b100000001101 #b00000011010)
                expect
                (fp #b0 #b110010001011 #b01110111010)))

(assert (= expect result))

(check-sat)
(exit)
