(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg1
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                arg1
                (fp #b1 #b011 #b0100)))
; arg1 = -1.625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1000001000)
                expect
                (fp #b1 #b01111 #b1010000000)))
(assert (fp.leq (fp #b1 #b01111 #b1010000000)
                expect
                (fp #b0 #b11110 #b0111111100)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
