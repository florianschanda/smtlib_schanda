(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b0 #b001000101001110100 #b00010011)
                arg1
                (fp #b0 #b001011111101010111 #b01010111)))
(assert (fp.leq (fp #b0 #b001011111101010111 #b01010111)
                arg1
                (fp #b0 #b010111011000100110 #b01010111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01010 #b1100001000)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b11011 #b1010010100)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
