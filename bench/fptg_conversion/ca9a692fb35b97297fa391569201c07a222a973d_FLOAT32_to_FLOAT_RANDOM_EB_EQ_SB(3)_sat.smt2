(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b10010010001011001010001)
                arg1
                (fp #b0 #b11010101 #b00100111011100011000100)))
(assert (fp.leq (fp #b0 #b11010101 #b00100111011100011000100)
                arg1
                (fp #b0 #b11011001 #b01010101001001000010101)))
; arg1 = 89292313239018475236622336.0

(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01010110001100 #b1110001111001)
                expect
                (fp #b0 #b10000001010101 #b0010011101111)))
(assert (fp.leq (fp #b0 #b10000001010101 #b0010011101111)
                expect
                (fp #b0 #b10110110110101 #b0000111101110)))

(assert (= expect result))

(check-sat)
(exit)
