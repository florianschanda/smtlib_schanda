; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b11)
                arg1
                (fp #b1 #b0110 #b10)))
(assert (fp.leq (fp #b1 #b0110 #b10)
                arg1
                (fp #b1 #b0100 #b01)))
; arg1 = -0.75

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100110 #b11101)
                expect
                (fp #b1 #b011110 #b10000)))
(assert (fp.leq (fp #b1 #b011110 #b10000)
                expect
                (fp #b0 #b011010 #b10011)))
; expect = -0.75

(assert (= expect result))

(check-sat)
(exit)
