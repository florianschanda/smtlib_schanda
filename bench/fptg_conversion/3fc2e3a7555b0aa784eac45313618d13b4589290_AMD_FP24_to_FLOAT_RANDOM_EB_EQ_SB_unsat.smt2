(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101010110 #b001011000)
                expect
                (fp #b0 #b0110110001 #b000000000)))
(assert (fp.leq (fp #b0 #b0110110001 #b000000000)
                expect
                (fp #b0 #b1100110100 #b111101101)))

(assert (not (= expect result)))

(check-sat)
