; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b010011110101 #b00)
                arg1
                (fp #b1 #b000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000 #b01)
                arg1
                (fp #b0 #b001111100011 #b01)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result ((_ to_fp 10 9) rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1011111111 #b00110111)
                expect
                (fp #b1 #b0000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000001)
                expect
                (fp #b0 #b1011001010 #b00100010)))

(assert (= expect result))

(check-sat)
(exit)
