                expect
                (fp #b0 #b01111110 #b101000000000000)))
(assert (fp.leq (fp #b0 #b01111110 #b101000000000000)
                expect
                (fp #b0 #b11111100 #b110000001101111)))
; expect = 0.8125

(assert (not (= expect result)))

