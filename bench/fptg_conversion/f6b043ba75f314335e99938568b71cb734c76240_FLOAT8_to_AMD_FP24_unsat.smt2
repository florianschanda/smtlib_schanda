; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b1110)
                arg1
                (fp #b0 #b101 #b1100)))
(assert (fp.leq (fp #b0 #b101 #b1100)
                arg1
                (fp #b0 #b110 #b1110)))
; arg1 = 7.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1111100111100000)
                expect
                (fp #b0 #b1000001 #b1100000000000000)))
(assert (fp.leq (fp #b0 #b1000001 #b1100000000000000)
                expect
                (fp #b0 #b1011011 #b0010001000110111)))
; expect = 7.0

(assert (not (= expect result)))

(check-sat)
(exit)
