; Format from: FLOAT64
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10001011000 #b0001011110010000010010000111111110110011101101010110)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result ((_ to_fp 12 6) rm arg1)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b110010011101 #b11111)
                expect
                (fp #b1 #b101111111111 #b00000)))
(assert (fp.leq (fp #b1 #b101111111111 #b00000)
                expect
                (fp #b1 #b010100111100 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
