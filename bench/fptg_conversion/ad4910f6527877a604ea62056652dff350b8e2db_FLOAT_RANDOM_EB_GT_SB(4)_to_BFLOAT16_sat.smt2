; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b00101000101111 #b01)
                arg1
                (fp #b0 #b01111111111111 #b01)))
(assert (fp.leq (fp #b0 #b01111111111111 #b01)
                arg1
                (fp #b0 #b10010011100101 #b11)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00110011 #b1000010)
                expect
                (fp #b0 #b01111111 #b0100000)))
(assert (fp.leq (fp #b0 #b01111111 #b0100000)
                expect
                (fp #b0 #b10010000 #b1000001)))
; expect = 1.25

(assert (= expect result))

(check-sat)
(exit)
