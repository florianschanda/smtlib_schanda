; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0010)
                arg1
                (fp #b0 #b010 #b1010)))
(assert (fp.leq (fp #b0 #b010 #b1010)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 0.8125

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                expect
                (fp #b0 #b011 #b0)))
(assert (fp.leq (fp #b0 #b011 #b0)
                expect
                (fp #b0 #b110 #b1)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
