; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b10)
                arg1
                (fp #b1 #b000000 #b11)))
(assert (fp.leq (fp #b1 #b000000 #b11)
                arg1
                (fp #b0 #b110101 #b01)))
; arg1 = -0.00000000069849193096160888671875

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b1 #b00 #b0)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
