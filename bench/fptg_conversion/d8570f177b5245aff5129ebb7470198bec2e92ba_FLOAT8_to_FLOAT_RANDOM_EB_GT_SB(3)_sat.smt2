; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1010)
                arg1
                (fp #b1 #b000 #b0100)))
(assert (fp.leq (fp #b1 #b000 #b0100)
                arg1
                (fp #b0 #b110 #b0000)))
; arg1 = -0.0625

(declare-const result (_ FloatingPoint 13 10))
(assert (= result ((_ to_fp 13 10) rm arg1)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1011101101001 #b110010010)
                expect
                (fp #b1 #b0111111111011 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111011 #b000000000)
                expect
                (fp #b0 #b0000110111100 #b110010100)))

(assert (= expect result))

(check-sat)
(exit)
