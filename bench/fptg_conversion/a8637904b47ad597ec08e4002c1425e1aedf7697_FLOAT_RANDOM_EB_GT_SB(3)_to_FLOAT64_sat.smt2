                expect
                (fp #b1 #b10000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00000001001 #b1001001111001010100010100110001010011100001110110101)))

