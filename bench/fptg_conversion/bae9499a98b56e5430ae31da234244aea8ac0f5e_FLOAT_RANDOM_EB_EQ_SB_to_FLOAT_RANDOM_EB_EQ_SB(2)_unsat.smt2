; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11001 #b0011)
                arg1
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                arg1
                (fp #b0 #b10011 #b1111)))
; arg1 = -0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001 #b10)
                expect
                (fp #b1 #b000 #b00)))
(assert (fp.leq (fp #b1 #b000 #b00)
                expect
                (fp #b0 #b011 #b00)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
