(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101001011 #b0100)
                arg1
                (fp #b1 #b000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000 #b0001)
                arg1
                (fp #b0 #b000010000 #b1100)))

(declare-const result (_ FloatingPoint 12 15))
(assert (= result ((_ to_fp 12 15) rm arg1)))

(declare-const expect (_ FloatingPoint 12 15))
(assert (fp.leq (fp #b1 #b111110011111 #b11111001100110)
                expect
                (fp #b1 #b011011111101 #b00000000000000)))
(assert (fp.leq (fp #b1 #b011011111101 #b00000000000000)
                expect
                (fp #b0 #b101010010010 #b00001011000111)))

(assert (= expect result))

(check-sat)
(exit)
