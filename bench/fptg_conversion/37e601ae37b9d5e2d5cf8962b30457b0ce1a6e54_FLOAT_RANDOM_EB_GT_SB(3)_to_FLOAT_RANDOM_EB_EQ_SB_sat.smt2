(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111111111111110 #b001)
                arg1
                (fp #b1 #b111111111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000)
                arg1
                (fp #b0 #b011010011110100 #b101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100110001000101 #b101010011001110)
                expect
                (fp #b1 #b1011111111111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1011111111111101 #b000000000000000)
                expect
                (fp #b0 #b1000110110000101 #b110001110101011)))

(assert (= expect result))

(check-sat)
(exit)
