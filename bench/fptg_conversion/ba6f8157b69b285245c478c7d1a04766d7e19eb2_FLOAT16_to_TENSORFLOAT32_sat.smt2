                expect
                (fp #b0 #b10000010 #b1101101011)))
(assert (fp.leq (fp #b0 #b10000010 #b1101101011)
                expect
                (fp #b0 #b11100111 #b0011101100)))
; expect = 14.8359375

(assert (= expect result))

