; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000101101 #b011001010)
                arg1
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg1
                (fp #b0 #b1110010101 #b110011100)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result ((_ to_fp 9 3) rm arg1)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111110 #b11)
                expect
                (fp #b1 #b100001001 #b00)))
(assert (fp.leq (fp #b1 #b100001001 #b00)
                expect
                (fp #b1 #b011110010 #b01)))

(assert (= expect result))

(check-sat)
(exit)
