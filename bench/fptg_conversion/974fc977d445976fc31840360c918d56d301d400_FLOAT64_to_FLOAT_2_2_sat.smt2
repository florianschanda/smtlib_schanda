; Format from: FLOAT64
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111001111 #b1011000100011010110001010010111111100000110011011101)
                arg1
                (fp #b1 #b00100100010 #b0110010010110000101001101011011111011110011001011010)))
(assert (fp.leq (fp #b1 #b00100100010 #b0110010010110000101001101011011111011110011001011010)
                arg1
                (fp #b0 #b01001100001 #b0001100010101011101100000000011000100100100000110000)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b01 #b1)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
