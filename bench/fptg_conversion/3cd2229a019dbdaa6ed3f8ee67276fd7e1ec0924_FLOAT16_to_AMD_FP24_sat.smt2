; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0001001011)
                arg1
                (fp #b0 #b00001 #b0001001010)))
(assert (fp.leq (fp #b0 #b00001 #b0001001010)
                arg1
                (fp #b0 #b10001 #b0110011111)))
; arg1 = 0.00006544589996337890625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010001 #b0110010100101101)
                expect
                (fp #b0 #b0110001 #b0001001010000000)))
(assert (fp.leq (fp #b0 #b0110001 #b0001001010000000)
                expect
                (fp #b0 #b1001010 #b0011110010001011)))
; expect = 0.00006544589996337890625

(assert (= expect result))

(check-sat)
(exit)
