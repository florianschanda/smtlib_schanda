(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11110 #b0110)
                expect
                (fp #b1 #b10110 #b0100)))
(assert (fp.leq (fp #b1 #b10110 #b0100)
                expect
                (fp #b0 #b01011 #b1001)))
; expect = -160.0

(assert (not (= expect result)))

(check-sat)
(exit)
