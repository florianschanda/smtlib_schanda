(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110111 #b0111011)
                arg1
                (fp #b1 #b00111100 #b0110101)))
