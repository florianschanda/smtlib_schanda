(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00101 #b101)
                arg1
                (fp #b0 #b01111 #b100)))
(assert (fp.leq (fp #b0 #b01111 #b100)
                arg1
                (fp #b0 #b10011 #b001)))
; arg1 = 1.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011100 #b01011101001110011000100)
                expect
                (fp #b0 #b01111111 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10000000000000000000000)
                expect
                (fp #b0 #b11100110 #b00111011000011111101100)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
