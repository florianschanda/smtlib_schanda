(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1001010111)
                arg1
                (fp #b0 #b11001 #b0101110010)))
(assert (fp.leq (fp #b0 #b11001 #b0101110010)
                arg1
                (fp #b0 #b11100 #b0100000100)))
; arg1 = 1394.0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result ((_ to_fp 6 5) rm arg1)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b001011 #b1100)
                expect
                (fp #b0 #b101001 #b0110)))
(assert (fp.leq (fp #b0 #b101001 #b0110)
                expect
                (fp #b0 #b101100 #b0111)))
; expect = 1408.0

(assert (= expect result))

(check-sat)
(exit)
