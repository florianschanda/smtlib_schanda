(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110110011101100 #b000011001000010)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b0 #b1011011011000010 #b111100010100110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0101)
                expect
                (fp #b1 #b011 #b1110)))
(assert (fp.leq (fp #b1 #b011 #b1110)
                expect
                (fp #b0 #b110 #b1101)))
; expect = -1.875

(assert (not (= expect result)))

(check-sat)
(exit)
