(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101100 #b01100111001110001001010)
                arg1
                (fp #b0 #b10010010 #b10110101011110010100000)))
(assert (fp.leq (fp #b0 #b10010010 #b10110101011110010100000)
                arg1
                (fp #b0 #b11000001 #b11000001000101101011100)))
; arg1 = 895946.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110100 #b1001100)
                expect
                (fp #b0 #b10010010 #b1011011)))
(assert (fp.leq (fp #b0 #b10010010 #b1011011)
                expect
                (fp #b0 #b11010001 #b1110011)))
; expect = 897024.0

(assert (= expect result))

(check-sat)
(exit)
