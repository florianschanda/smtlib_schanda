(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00101101 #b00110100110101110011011)
                arg1
                (fp #b0 #b10011110 #b11110001001010000001001)))
(assert (fp.leq (fp #b0 #b10011110 #b11110001001010000001001)
                arg1
                (fp #b0 #b11110011 #b10011001111110110010010)))
; arg1 = 4170451200.0

(declare-const result (_ FloatingPoint 14 7))
(assert (= result ((_ to_fp 14 7) rm arg1)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b01010010110010 #b000101)
                expect
                (fp #b0 #b10000000011110 #b111101)))
(assert (fp.leq (fp #b0 #b10000000011110 #b111101)
                expect
                (fp #b0 #b11010110101100 #b001001)))

(assert (= expect result))

(check-sat)
(exit)
