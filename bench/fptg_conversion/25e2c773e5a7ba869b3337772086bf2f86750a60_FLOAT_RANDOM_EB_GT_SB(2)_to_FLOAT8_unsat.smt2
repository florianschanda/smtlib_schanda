(assert (fp.leq (fp #b1 #b000 #b1100)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b010 #b0000)))
; expect = -0.015625

(assert (not (= expect result)))

