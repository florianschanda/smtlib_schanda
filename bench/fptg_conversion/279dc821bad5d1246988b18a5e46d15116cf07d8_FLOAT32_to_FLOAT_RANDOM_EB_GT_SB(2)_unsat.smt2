; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011110 #b10111000000111110100001)
                arg1
                (fp #b1 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b1 #b00101101 #b00000000010100101010001)))
; arg1 = -0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 10 4))
(assert (= result ((_ to_fp 10 4) rm arg1)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110010111 #b111)
                expect
                (fp #b1 #b0111000000 #b000)))
(assert (fp.leq (fp #b1 #b0111000000 #b000)
                expect
                (fp #b0 #b0001100011 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
