; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110101010 #b00011)
                arg1
                (fp #b1 #b1001101010 #b11001)))
(assert (fp.leq (fp #b1 #b1001101010 #b11001)
                arg1
                (fp #b1 #b0000000000 #b10101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101011 #b11010101001100000010010)
                expect
                (fp #b1 #b11101010 #b11001000000000000000000)))
(assert (fp.leq (fp #b1 #b11101010 #b11001000000000000000000)
                expect
                (fp #b1 #b01111101 #b01111101000011110100111)))
; expect = -289024336852036303541248330825728.0

(assert (= expect result))

(check-sat)
(exit)
