(assert (fp.leq (fp #b1 #b00111111110101 #b01001010001)
                expect
                (fp #b0 #b10000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b10000000000000 #b00000000000)
                expect
                (fp #b0 #b10010110100101 #b11101011111)))

(assert (= expect result))

(check-sat)
