; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110000 #b0000111110100110)
                arg1
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                arg1
                (fp #b0 #b1101110 #b1000010000011001)))
; arg1 = 357453824.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011101 #b11101001011001100001010)
                expect
                (fp #b0 #b10011011 #b01010100111001010000000)))
(assert (fp.leq (fp #b0 #b10011011 #b01010100111001010000000)
                expect
                (fp #b0 #b10011011 #b11111111000001101000111)))
; expect = 357453824.0

(assert (= expect result))

(check-sat)
(exit)
