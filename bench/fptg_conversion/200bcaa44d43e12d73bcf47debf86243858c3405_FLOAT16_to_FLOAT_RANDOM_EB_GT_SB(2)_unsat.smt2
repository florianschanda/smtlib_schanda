; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1101000111)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b00010 #b0000111001)))
; arg1 = 0.000060558319091796875

(declare-const result (_ FloatingPoint 13 3))
(assert (= result ((_ to_fp 13 3) rm arg1)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0100000001101 #b00)
                expect
                (fp #b0 #b0111111110001 #b00)))
(assert (fp.leq (fp #b0 #b0111111110001 #b00)
                expect
                (fp #b0 #b1101110100111 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
