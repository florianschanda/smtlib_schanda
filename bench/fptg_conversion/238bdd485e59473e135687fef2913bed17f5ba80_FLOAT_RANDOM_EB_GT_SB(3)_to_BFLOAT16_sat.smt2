; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1111000110111111 #b100010110)
                arg1
                (fp #b1 #b0111111111111111 #b101100000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b101100000)
                arg1
                (fp #b0 #b0111010001010111 #b000100110)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011001 #b1111101)
                expect
                (fp #b1 #b01111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000)
                expect
                (fp #b0 #b10111101 #b1011100)))
; expect = -1.6875

(assert (= expect result))

(check-sat)
(exit)
