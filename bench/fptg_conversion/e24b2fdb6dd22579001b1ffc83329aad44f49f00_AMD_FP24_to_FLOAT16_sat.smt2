(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100000 #b1111011100011011)
                arg1
                (fp #b0 #b1001110 #b1101101110011110)))
(assert (fp.leq (fp #b0 #b1001110 #b1101101110011110)
                arg1
                (fp #b0 #b1101000 #b1111110101000011)))
; arg1 = 60879.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b0101000100)
                expect
                (fp #b0 #b11110 #b1101101111)))
(assert (fp.leq (fp #b0 #b11110 #b1101101111)
                expect
                (fp #b0 #b11110 #b1111011001)))
; expect = 60896.0

(assert (= expect result))

(check-sat)
(exit)
