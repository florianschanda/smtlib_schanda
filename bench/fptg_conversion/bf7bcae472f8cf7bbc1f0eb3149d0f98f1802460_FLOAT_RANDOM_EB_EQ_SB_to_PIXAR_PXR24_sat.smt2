; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0101)
                arg1
                (fp #b0 #b10111 #b0000)))
(assert (fp.leq (fp #b0 #b10111 #b0000)
                arg1
                (fp #b0 #b11101 #b1110)))
; arg1 = 256.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000011 #b110101001111110)
                expect
                (fp #b0 #b10000111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10000111 #b000000000000000)
                expect
                (fp #b0 #b11001001 #b111101110110100)))
; expect = 256.0

(assert (= expect result))

(check-sat)
(exit)
