(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1110 #b11)
                arg1
                (fp #b1 #b0110 #b10)))
(assert (fp.leq (fp #b1 #b0110 #b10)
                arg1
                (fp #b1 #b0100 #b01)))
; arg1 = -0.75

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b10011010111110100011101)
                expect
                (fp #b1 #b01111110 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b10000000000000000000000)
                expect
                (fp #b0 #b10001111 #b11000111010100001010110)))
; expect = -0.75

(assert (= expect result))

(check-sat)
(exit)
