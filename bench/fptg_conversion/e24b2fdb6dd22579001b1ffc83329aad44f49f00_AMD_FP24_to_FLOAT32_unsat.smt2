(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100000 #b1111011100011011)
                arg1
                (fp #b0 #b1001110 #b1101101110011110)))
(assert (fp.leq (fp #b0 #b1001110 #b1101101110011110)
                arg1
                (fp #b0 #b1101000 #b1111110101000011)))
; arg1 = 60879.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101010 #b10111010110100001000111)
                expect
                (fp #b0 #b10001110 #b11011011100111100000000)))
(assert (fp.leq (fp #b0 #b10001110 #b11011011100111100000000)
                expect
                (fp #b0 #b10101101 #b00110101101001010010001)))
; expect = 60879.0

(assert (not (= expect result)))

(check-sat)
(exit)
