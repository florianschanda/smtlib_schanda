(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110110 #b0100000101)
                expect
                (fp #b0 #b01111011 #b1000000000)))
(assert (fp.leq (fp #b0 #b01111011 #b1000000000)
                expect
                (fp #b0 #b01111100 #b0000111010)))
; expect = 0.09375

(assert (= expect result))

(check-sat)
(exit)
