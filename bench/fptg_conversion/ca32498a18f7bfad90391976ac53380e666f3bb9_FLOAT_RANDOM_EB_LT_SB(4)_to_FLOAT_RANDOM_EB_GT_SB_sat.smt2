; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b010 #b11100110010)
                arg1
                (fp #b0 #b110 #b01010011000)))
(assert (fp.leq (fp #b0 #b110 #b01010011000)
                arg1
                (fp #b0 #b110 #b01100010110)))
; arg1 = 10.59375

(declare-const result (_ FloatingPoint 9 5))
(assert (= result ((_ to_fp 9 5) rm arg1)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010111001 #b0010)
                expect
                (fp #b0 #b100000010 #b0110)))
(assert (fp.leq (fp #b0 #b100000010 #b0110)
                expect
                (fp #b0 #b111011010 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
