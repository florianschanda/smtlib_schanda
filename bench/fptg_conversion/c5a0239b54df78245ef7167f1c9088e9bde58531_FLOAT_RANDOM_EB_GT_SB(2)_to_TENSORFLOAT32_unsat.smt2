                expect
                (fp #b1 #b10000000 #b1000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b1000000000)
                expect
                (fp #b0 #b01101010 #b0011011000)))
; expect = -3.0

(assert (not (= expect result)))

