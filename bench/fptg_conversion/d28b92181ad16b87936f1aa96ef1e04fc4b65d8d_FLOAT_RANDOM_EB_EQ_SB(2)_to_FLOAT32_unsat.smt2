; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111100 #b111000010)
                arg1
                (fp #b1 #b1000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b1000001000 #b011100001)
                arg1
                (fp #b0 #b1001001010 #b111110010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001100 #b00010110100010111000000)
                expect
                (fp #b1 #b10001000 #b01110000100000000000000)))
(assert (fp.leq (fp #b1 #b10001000 #b01110000100000000000000)
                expect
                (fp #b0 #b01001001 #b11000110001010110100110)))
; expect = -737.0

(assert (not (= expect result)))

(check-sat)
(exit)
