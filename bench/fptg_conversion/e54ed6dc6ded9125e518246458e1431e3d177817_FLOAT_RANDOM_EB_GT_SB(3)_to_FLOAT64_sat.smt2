                expect
                (fp #b0 #b10000000010 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000010 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10101001010 #b1100011010110110000111001010100011010101110011110010)))

