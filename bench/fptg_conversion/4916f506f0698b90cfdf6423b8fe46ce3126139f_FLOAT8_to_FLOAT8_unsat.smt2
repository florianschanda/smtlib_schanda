; Format from: FLOAT8
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                arg1
                (fp #b1 #b000 #b1000)))
(assert (fp.leq (fp #b1 #b000 #b1000)
                arg1
                (fp #b0 #b001 #b0110)))
; arg1 = -0.125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1100)
                expect
                (fp #b1 #b000 #b1000)))
(assert (fp.leq (fp #b1 #b000 #b1000)
                expect
                (fp #b0 #b001 #b0001)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
