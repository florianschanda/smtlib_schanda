; Format from: FLOAT_2_2
; Format to: TENSORFLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg1
                (fp #b0 #b10 #b1)))
(assert (fp.leq (fp #b0 #b10 #b1)
                arg1
                (fp #b0 #b11 #b0)))
; arg1 = 3.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010101 #b0111011101)
                expect
                (fp #b0 #b10000000 #b1000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b1000000000)
                expect
                (fp #b0 #b11001010 #b0001000111)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
