(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1100110010010001)
                arg1
                (fp #b1 #b1111011 #b0001001011100110)))
(assert (fp.leq (fp #b1 #b1111011 #b0001001011100110)
                arg1
                (fp #b1 #b0010110 #b1000101110110101)))
; arg1 = -1238032500689731584.0

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111010111011000 #b10010111011111)
                expect
                (fp #b1 #b100000000111011 #b00010010111010)))
(assert (fp.leq (fp #b1 #b100000000111011 #b00010010111010)
                expect
                (fp #b1 #b011010010110110 #b11010100011100)))

(assert (= expect result))

(check-sat)
(exit)
