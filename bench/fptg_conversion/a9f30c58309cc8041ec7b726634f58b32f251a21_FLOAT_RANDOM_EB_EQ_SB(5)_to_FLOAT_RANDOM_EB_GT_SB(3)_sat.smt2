; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b010 #b11)))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b1 #b010 #b01)))
; arg1 = -0.875

(declare-const result (_ FloatingPoint 13 5))
(assert (= result ((_ to_fp 13 5) rm arg1)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1110000110100 #b0000)
                expect
                (fp #b1 #b0111111111110 #b1100)))
(assert (fp.leq (fp #b1 #b0111111111110 #b1100)
                expect
                (fp #b0 #b0101111000101 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
