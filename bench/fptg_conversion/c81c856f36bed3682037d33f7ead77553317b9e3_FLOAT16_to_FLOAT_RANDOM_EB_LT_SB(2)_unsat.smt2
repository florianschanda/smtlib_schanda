(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10100 #b1100010001)
                arg1
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                arg1
                (fp #b0 #b10011 #b0010100110)))
; arg1 = -0

(declare-const result (_ FloatingPoint 2 50))
(assert (= result ((_ to_fp 2 50) rm arg1)))

(declare-const expect (_ FloatingPoint 2 50))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01 #b1110111110111010110100001101101000100100100111111)
                expect
                (fp #b1 #b00 #b0000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00 #b0000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00 #b0011001011000100111001110001001100110110101101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
