(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001100000 #b1)
                arg1
                (fp #b0 #b011111111 #b1)))
(assert (fp.leq (fp #b0 #b011111111 #b1)
                arg1
                (fp #b0 #b101011110 #b1)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b0 #b0001011 #b110110)
                expect
                (fp #b0 #b0111111 #b100000)))
(assert (fp.leq (fp #b0 #b0111111 #b100000)
                expect
                (fp #b0 #b1001011 #b010011)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
