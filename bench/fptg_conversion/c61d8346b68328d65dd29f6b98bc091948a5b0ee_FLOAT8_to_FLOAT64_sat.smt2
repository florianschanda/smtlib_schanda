                expect
                (fp #b0 #b01111111100 #b1100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111100 #b1100000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10001110001 #b1110101001111110010010011111111011011110101111100001)))

