(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1011111111000001)
                expect
                (fp #b1 #b0111011 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111011 #b0000000000000000)
                expect
                (fp #b0 #b0101011 #b1011110101100111)))
; expect = -0.0625

(assert (not (= expect result)))

(check-sat)
