                expect
                (fp #b0 #b10000001 #b1100000000)))
(assert (fp.leq (fp #b0 #b10000001 #b1100000000)
                expect
                (fp #b0 #b11010000 #b0000110111)))
; expect = 7.0

(assert (not (= expect result)))

