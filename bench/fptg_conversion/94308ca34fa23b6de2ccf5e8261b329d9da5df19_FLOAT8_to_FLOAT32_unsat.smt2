; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1000)
                arg1
                (fp #b0 #b001 #b0011)))
(assert (fp.leq (fp #b0 #b001 #b0011)
                arg1
                (fp #b0 #b110 #b0011)))
; arg1 = 0.296875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010011 #b00010011000000111010000)
                expect
                (fp #b0 #b01111101 #b00110000000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b00110000000000000000000)
                expect
                (fp #b0 #b10001100 #b10011011100000001001110)))
; expect = 0.296875

(assert (not (= expect result)))

(check-sat)
(exit)
