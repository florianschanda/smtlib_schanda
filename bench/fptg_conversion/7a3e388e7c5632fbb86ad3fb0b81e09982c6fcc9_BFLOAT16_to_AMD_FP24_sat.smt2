(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010101 #b0110111)
                arg1
                (fp #b0 #b10000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000011 #b1110000)
                arg1
                (fp #b0 #b11011011 #b1101001)))
; arg1 = 30.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100111 #b1100011011000011)
                expect
                (fp #b0 #b1000011 #b1110000000000000)))
(assert (fp.leq (fp #b0 #b1000011 #b1110000000000000)
                expect
                (fp #b0 #b1101011 #b0010110000010101)))
; expect = 30.0

(assert (= expect result))

(check-sat)
(exit)
