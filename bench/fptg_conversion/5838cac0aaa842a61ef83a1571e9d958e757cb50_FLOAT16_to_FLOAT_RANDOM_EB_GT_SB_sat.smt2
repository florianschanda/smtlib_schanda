(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0001001110)
                arg1
                (fp #b1 #b00101 #b0010100100)))
(assert (fp.leq (fp #b1 #b00101 #b0010100100)
                arg1
                (fp #b0 #b01110 #b1100000101)))
; arg1 = -0.001132965087890625

(declare-const result (_ FloatingPoint 11 2))
(assert (= result ((_ to_fp 11 2) rm arg1)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10000001000 #b1)
                expect
                (fp #b1 #b01111110101 #b1)))
(assert (fp.leq (fp #b1 #b01111110101 #b1)
                expect
                (fp #b0 #b11011100001 #b0)))

(assert (= expect result))

(check-sat)
(exit)
