(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0000110111)
                arg1
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg1
                (fp #b0 #b01000 #b0100111110)))
; arg1 = 0.00006103515625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00001111 #b110110110100010)
                expect
                (fp #b0 #b01110001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01110001 #b000000000000000)
                expect
                (fp #b0 #b11001110 #b111001110101101)))
; expect = 0.00006103515625

(assert (= expect result))

(check-sat)
(exit)
