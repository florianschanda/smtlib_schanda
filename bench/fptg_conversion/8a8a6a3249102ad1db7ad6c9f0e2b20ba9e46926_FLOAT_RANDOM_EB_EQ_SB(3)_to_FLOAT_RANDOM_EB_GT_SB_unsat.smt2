(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b010100011110010 #b100)
                expect
                (fp #b0 #b100000000000000 #b101)))
(assert (fp.leq (fp #b0 #b100000000000000 #b101)
                expect
                (fp #b0 #b111101110100000 #b000)))

(assert (not (= expect result)))

(check-sat)
