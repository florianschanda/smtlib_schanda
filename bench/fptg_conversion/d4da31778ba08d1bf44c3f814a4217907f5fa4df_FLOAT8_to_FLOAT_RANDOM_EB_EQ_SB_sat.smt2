(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110010 #b001000)
                expect
                (fp #b1 #b0111111 #b011100)))
(assert (fp.leq (fp #b1 #b0111111 #b011100)
                expect
                (fp #b0 #b0101100 #b000110)))
; expect = -1.4375

(assert (= expect result))

(check-sat)
