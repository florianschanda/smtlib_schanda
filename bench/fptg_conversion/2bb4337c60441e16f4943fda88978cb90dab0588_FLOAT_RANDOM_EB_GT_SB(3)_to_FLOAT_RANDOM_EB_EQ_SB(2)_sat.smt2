; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b100010100111011001 #b100)
                arg1
                (fp #b0 #b011110001000010111 #b111)))
(assert (fp.leq (fp #b0 #b011110001000010111 #b111)
                arg1
                (fp #b0 #b110100011111001001 #b000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010111101 #b000001011)
                expect
                (fp #b0 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000001)
                expect
                (fp #b0 #b0001110010 #b001010000)))

(assert (= expect result))

(check-sat)
(exit)
