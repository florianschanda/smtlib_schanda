(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                arg1
                (fp #b1 #b001 #b0110)))
(assert (fp.leq (fp #b1 #b001 #b0110)
                arg1
                (fp #b1 #b001 #b0011)))
; arg1 = -0.34375

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100011011 #b11001110001)
                expect
                (fp #b1 #b011111111101 #b01100000000)))
(assert (fp.leq (fp #b1 #b011111111101 #b01100000000)
                expect
                (fp #b1 #b001001000110 #b01001100110)))

(assert (= expect result))

(check-sat)
(exit)
