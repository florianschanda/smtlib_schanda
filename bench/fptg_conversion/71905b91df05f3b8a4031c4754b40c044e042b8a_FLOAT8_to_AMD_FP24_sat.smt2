(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b001 #b0011)))
(assert (fp.leq (fp #b1 #b001 #b0011)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -0.296875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b1000000100001111)
                expect
                (fp #b1 #b0111101 #b0011000000000000)))
(assert (fp.leq (fp #b1 #b0111101 #b0011000000000000)
                expect
                (fp #b0 #b0110001 #b1011100110001001)))
; expect = -0.296875

(assert (= expect result))

(check-sat)
(exit)
