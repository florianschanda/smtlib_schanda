                arg1
                (fp #b0 #b10011 #b001)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011111011 #b10011110)
                expect
                (fp #b0 #b011111111 #b10000000)))
(assert (fp.leq (fp #b0 #b011111111 #b10000000)
                expect
                (fp #b0 #b101001101 #b11000001)))

(assert (= expect result))

(check-sat)
(exit)
