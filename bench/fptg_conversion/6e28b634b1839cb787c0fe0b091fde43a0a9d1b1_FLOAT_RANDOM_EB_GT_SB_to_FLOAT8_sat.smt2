; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b01111111 #b000000)
                arg1
                (fp #b1 #b00000000 #b111111)))
(assert (fp.leq (fp #b1 #b00000000 #b111111)
                arg1
                (fp #b0 #b01001000 #b011010)))
; arg1 = -0.000000000000000000000000000000000000011571272515906892656567250288281480891027489074475236539851774608678169897757470607757568359375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0101)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b101 #b0000)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
