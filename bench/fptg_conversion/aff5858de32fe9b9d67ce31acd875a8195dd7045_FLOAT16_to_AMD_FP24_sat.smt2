; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0000011110)
                arg1
                (fp #b0 #b11100 #b1001010011)))
(assert (fp.leq (fp #b0 #b11100 #b1001010011)
                arg1
                (fp #b0 #b11100 #b1010000001)))
; arg1 = 12952.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111001 #b1110001101011101)
                expect
                (fp #b0 #b1001100 #b1001010011000000)))
(assert (fp.leq (fp #b0 #b1001100 #b1001010011000000)
                expect
                (fp #b0 #b1111101 #b0110110100111100)))
; expect = 12952.0

(assert (= expect result))

(check-sat)
(exit)
