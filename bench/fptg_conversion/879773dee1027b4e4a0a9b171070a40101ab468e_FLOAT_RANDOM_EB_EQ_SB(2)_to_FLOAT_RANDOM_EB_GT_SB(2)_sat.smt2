; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg1
                (fp #b0 #b0011 #b001)))
(assert (fp.leq (fp #b0 #b0011 #b001)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = 0.0703125

(declare-const result (_ FloatingPoint 11 9))
(assert (= result ((_ to_fp 11 9) rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00101001101 #b11101111)
                expect
                (fp #b0 #b01111111011 #b00100000)))
(assert (fp.leq (fp #b0 #b01111111011 #b00100000)
                expect
                (fp #b0 #b10100111100 #b11000100)))

(assert (= expect result))

(check-sat)
(exit)
