(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0100010101101 #b010001110110)
                expect
                (fp #b0 #b1000000000100 #b001000111000)))
(assert (fp.leq (fp #b0 #b1000000000100 #b001000111000)
                expect
                (fp #b0 #b1010101111100 #b010010111011)))

(assert (= expect result))

(check-sat)
