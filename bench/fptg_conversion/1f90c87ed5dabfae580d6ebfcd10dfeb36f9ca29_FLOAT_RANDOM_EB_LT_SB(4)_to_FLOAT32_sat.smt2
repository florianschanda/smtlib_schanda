; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 10))
(assert (fp.leq (fp #b1 #b0001 #b000000110)
                arg1
                (fp #b0 #b0101 #b011000110)))
(assert (fp.leq (fp #b0 #b0101 #b011000110)
                arg1
                (fp #b0 #b1100 #b011001010)))
; arg1 = 0.3466796875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01101100 #b10100111010101011001001)
                expect
                (fp #b0 #b01111101 #b01100011000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b01100011000000000000000)
                expect
                (fp #b0 #b11000000 #b01100110001010001000000)))
; expect = 0.3466796875

(assert (= expect result))

(check-sat)
(exit)
