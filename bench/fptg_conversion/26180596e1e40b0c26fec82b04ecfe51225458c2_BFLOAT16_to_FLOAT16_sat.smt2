; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111001 #b1110000)
                arg1
                (fp #b0 #b10000110 #b1001000)))
(assert (fp.leq (fp #b0 #b10000110 #b1001000)
                arg1
                (fp #b0 #b11101001 #b0100000)))
; arg1 = 200.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b0100011000)
                expect
                (fp #b0 #b10110 #b1001000000)))
(assert (fp.leq (fp #b0 #b10110 #b1001000000)
                expect
                (fp #b0 #b11110 #b1111100001)))
; expect = 200.0

(assert (= expect result))

(check-sat)
(exit)
