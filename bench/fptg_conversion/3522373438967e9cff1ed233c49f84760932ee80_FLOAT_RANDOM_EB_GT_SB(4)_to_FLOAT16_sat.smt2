; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101100010011 #b10000010)
                arg1
                (fp #b1 #b000000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b000000000000 #b00010010)
                arg1
                (fp #b0 #b000110111111 #b00011011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11000 #b0101100100)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10010 #b1101011100)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
