; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101001011011001 #b010011000001100)
                arg1
                (fp #b1 #b0100100001011010 #b001011000010101)))
(assert (fp.leq (fp #b1 #b0100100001011010 #b001011000010101)
                arg1
                (fp #b0 #b1001101011001110 #b000001011011000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0101101010)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10011 #b1001001100)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
