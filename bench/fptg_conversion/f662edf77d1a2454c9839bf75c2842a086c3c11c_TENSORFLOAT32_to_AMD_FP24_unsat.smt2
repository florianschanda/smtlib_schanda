; Format from: TENSORFLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110011 #b1011011011)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b10011110 #b0100101110)))
; arg1 = 1.59765625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100100 #b0101110000100010)
                expect
                (fp #b0 #b0111111 #b1001100100000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1001100100000000)
                expect
                (fp #b0 #b1110110 #b1111111101001011)))
; expect = 1.59765625

(assert (not (= expect result)))

(check-sat)
(exit)
