; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1101000001)
                arg1
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                arg1
                (fp #b0 #b11101 #b0111110100)))
; arg1 = -0.000055372714996337890625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110110 #b1101101)
                expect
                (fp #b1 #b01110000 #b1101001)))
(assert (fp.leq (fp #b1 #b01110000 #b1101001)
                expect
                (fp #b0 #b11001011 #b1000011)))
; expect = -0.0000555515289306640625

(assert (not (= expect result)))

(check-sat)
(exit)
