(assert (fp.leq (fp #b0 #b01101001 #b0000000011)
                expect
                (fp #b0 #b01111111 #b1011011000)))
(assert (fp.leq (fp #b0 #b01111111 #b1011011000)
                expect
                (fp #b0 #b10010010 #b0110111101)))
; expect = 1.7109375

(assert (= expect result))

(check-sat)
