; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b00101001100001 #b1)
                arg1
                (fp #b0 #b10000000000001 #b0)))
(assert (fp.leq (fp #b0 #b10000000000001 #b0)
                arg1
                (fp #b0 #b11110001101011 #b0)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111011 #b10111001101011110100000)
                expect
                (fp #b0 #b10000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b00000000000000000000000)
                expect
                (fp #b0 #b11110101 #b11011011101000001011000)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
