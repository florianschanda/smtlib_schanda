(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01111101000011 #b0001100000110)
                arg1
                (fp #b0 #b01111111111111 #b0111011011110)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0111011011110)
                arg1
                (fp #b0 #b11110001111111 #b1111100100010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01011011 #b1001010)
                expect
                (fp #b0 #b01111111 #b0111100)))
(assert (fp.leq (fp #b0 #b01111111 #b0111100)
                expect
                (fp #b0 #b11100001 #b0010000)))
; expect = 1.46875

(assert (= expect result))

(check-sat)
(exit)
