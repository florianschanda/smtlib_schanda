; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT16
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 17))
(assert (fp.leq (fp #b0 #b1101 #b1011010000111010)
                arg1
                (fp #b0 #b1110 #b1111111000000000)))
(assert (fp.leq (fp #b0 #b1110 #b1111111000000000)
                arg1
                (fp #b0 #b1110 #b1111111001010111)))
; arg1 = 255.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00110 #b0011010001)
                expect
                (fp #b0 #b10110 #b1111111000)))
(assert (fp.leq (fp #b0 #b10110 #b1111111000)
                expect
                (fp #b0 #b11010 #b0101111100)))
; expect = 255.0

(assert (= expect result))

(check-sat)
(exit)
