(assert (fp.leq (fp #b1 #b00110 #b0111110011)
                expect
                (fp #b0 #b10011 #b1010000000)))
(assert (fp.leq (fp #b0 #b10011 #b1010000000)
                expect
                (fp #b0 #b11001 #b0100100011)))
; expect = 26.0

(assert (not (= expect result)))

