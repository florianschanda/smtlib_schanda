(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT8
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 20))
(assert (fp.leq (fp #b1 #b111111001110110 #b1101011011001110100)
                arg1
                (fp #b0 #b000000000000000 #b0000000000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000000000000001)
                arg1
                (fp #b0 #b111101101100101 #b0111001110110101100)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0110)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b011 #b1111)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
