(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010000000 #b00100000)
                expect
                (fp #b0 #b100001010 #b00000000)))
(assert (fp.leq (fp #b0 #b100001010 #b00000000)
                expect
                (fp #b0 #b101010001 #b11001010)))

(assert (= expect result))

(check-sat)
(exit)
