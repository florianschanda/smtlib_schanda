(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: -SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101101 #b1110001110110000)
                arg1
                (fp #b1 #b0011000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0011000 #b0000000000000000)
                arg1
                (fp #b0 #b1101001 #b1011010001001110)))
; arg1 = -0.000000000001818989403545856475830078125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b1001000001)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b11100 #b0111001110)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
