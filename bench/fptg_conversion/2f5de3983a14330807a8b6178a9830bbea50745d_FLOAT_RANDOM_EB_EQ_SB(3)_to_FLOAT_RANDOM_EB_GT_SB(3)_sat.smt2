; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b10000001110)
                arg1
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                arg1
                (fp #b0 #b110001001101 #b00101011001)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result ((_ to_fp 10 3) rm arg1)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1100001001 #b00)
                expect
                (fp #b0 #b0000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000 #b01)
                expect
                (fp #b0 #b0111111100 #b00)))

(assert (= expect result))

(check-sat)
(exit)
