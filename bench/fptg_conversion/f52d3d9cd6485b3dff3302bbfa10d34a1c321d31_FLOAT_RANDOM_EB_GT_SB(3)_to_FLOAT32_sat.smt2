(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011011111001 #b110)
                arg1
                (fp #b0 #b011111111111 #b101)))
(assert (fp.leq (fp #b0 #b011111111111 #b101)
                arg1
                (fp #b0 #b110101100101 #b001)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101110 #b10111000010000011111111)
                expect
                (fp #b0 #b01111111 #b10100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10100000000000000000000)
                expect
                (fp #b0 #b11011100 #b10011111100011001100000)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
