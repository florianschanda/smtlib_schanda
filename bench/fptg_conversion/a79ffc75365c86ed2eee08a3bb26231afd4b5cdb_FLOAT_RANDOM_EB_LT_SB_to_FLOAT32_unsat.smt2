; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 40))
(assert (fp.leq (fp #b1 #b00001 #b001111100001011011100001011101101000111)
                arg1
                (fp #b0 #b11110 #b111111111111111010110100100101011111000)))
(assert (fp.leq (fp #b0 #b11110 #b111111111111111010110100100101011111000)
                arg1
                (fp #b0 #b11110 #b111111111111111110011110011001111110010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001110 #b01010110110110100101010)
                expect
                (fp #b0 #b10001110 #b11111111111111101011011)))
(assert (fp.leq (fp #b0 #b10001110 #b11111111111111101011011)
                expect
                (fp #b0 #b11010011 #b11110101110100100000100)))
; expect = 65535.35546875

(assert (not (= expect result)))

(check-sat)
(exit)
