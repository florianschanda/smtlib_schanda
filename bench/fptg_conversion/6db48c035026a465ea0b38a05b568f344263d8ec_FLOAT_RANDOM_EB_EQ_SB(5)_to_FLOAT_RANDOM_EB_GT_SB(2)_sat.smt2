(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001011111101 #b01110001000)
                arg1
                (fp #b1 #b000000000000 #b11010001010)))
(assert (fp.leq (fp #b1 #b000000000000 #b11010001010)
                arg1
                (fp #b0 #b010111011110 #b00100101010)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0011 #b01)
                expect
                (fp #b1 #b0000 #b01)))
(assert (fp.leq (fp #b1 #b0000 #b01)
                expect
                (fp #b0 #b0011 #b10)))
; expect = -0.00390625

(assert (= expect result))

(check-sat)
(exit)
