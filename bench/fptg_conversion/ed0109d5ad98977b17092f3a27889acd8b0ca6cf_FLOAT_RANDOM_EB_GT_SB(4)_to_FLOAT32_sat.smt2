; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b111101100101111 #b0100101110)
                arg1
                (fp #b1 #b011010011111000 #b1011000111)))
(assert (fp.leq (fp #b1 #b011010011111000 #b1011000111)
                arg1
                (fp #b0 #b110001001111110 #b0101101001)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010010 #b01011101101001001000110)
                expect
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b01000011 #b10110000001001000101111)))
; expect = -0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(assert (= expect result))

(check-sat)
(exit)
