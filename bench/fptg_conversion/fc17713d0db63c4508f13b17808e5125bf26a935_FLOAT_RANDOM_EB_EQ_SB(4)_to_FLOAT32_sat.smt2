(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b1 #b0110 #b001)))
(assert (fp.leq (fp #b1 #b0110 #b001)
                arg1
                (fp #b0 #b1000 #b100)))
; arg1 = -0.5625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101110 #b00011110001111011000101)
                expect
                (fp #b1 #b01111110 #b00100000000000000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b00100000000000000000000)
                expect
                (fp #b0 #b00100111 #b00100100011101001110000)))
; expect = -0.5625

(assert (= expect result))

(check-sat)
(exit)
