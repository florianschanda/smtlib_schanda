(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1010110010)
                arg1
                (fp #b0 #b00000 #b1011110010)))
(assert (fp.leq (fp #b0 #b00000 #b1011110010)
                arg1
                (fp #b0 #b01111 #b0101001010)))
; arg1 = 0.00004494190216064453125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01001110 #b1100101)
                expect
                (fp #b0 #b01110000 #b0111101)))
(assert (fp.leq (fp #b0 #b01110000 #b0111101)
                expect
                (fp #b0 #b01111000 #b1000110)))
; expect = 0.0000450611114501953125

(assert (not (= expect result)))

(check-sat)
(exit)
