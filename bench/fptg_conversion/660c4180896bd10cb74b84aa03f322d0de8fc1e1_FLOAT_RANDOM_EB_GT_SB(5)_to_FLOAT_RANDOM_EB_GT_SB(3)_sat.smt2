(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101001001011 #b111101100)
                arg1
                (fp #b1 #b100101110100 #b101010110)))
(assert (fp.leq (fp #b1 #b100101110100 #b101010110)
                arg1
                (fp #b0 #b011101001001 #b011100111)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result ((_ to_fp 9 2) rm arg1)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
