(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11000 #b0)
                arg1
                (fp #b1 #b10011 #b0)))
(assert (fp.leq (fp #b1 #b10011 #b0)
                arg1
                (fp #b0 #b10010 #b0)))
; arg1 = -16.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1010011111)
                expect
                (fp #b1 #b10011 #b0000000000)))
(assert (fp.leq (fp #b1 #b10011 #b0000000000)
                expect
                (fp #b0 #b01100 #b0011010110)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
(exit)
