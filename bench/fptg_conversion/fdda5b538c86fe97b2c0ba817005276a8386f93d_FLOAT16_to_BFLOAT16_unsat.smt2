; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1001000011)
                arg1
                (fp #b0 #b01101 #b0001011010)))
(assert (fp.leq (fp #b0 #b01101 #b0001011010)
                arg1
                (fp #b0 #b10001 #b1101100110)))
; arg1 = 0.27197265625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010011 #b0000101)
                expect
                (fp #b0 #b01111101 #b0001100)))
(assert (fp.leq (fp #b0 #b01111101 #b0001100)
                expect
                (fp #b0 #b10110000 #b0101011)))
; expect = 0.2734375

(assert (not (= expect result)))

(check-sat)
(exit)
