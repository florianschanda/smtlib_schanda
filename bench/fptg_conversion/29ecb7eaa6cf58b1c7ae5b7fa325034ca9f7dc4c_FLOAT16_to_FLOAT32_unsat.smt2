; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1111111001)
                arg1
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg1
                (fp #b0 #b01101 #b0001111101)))
; arg1 = 0.000000059604644775390625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001011 #b11111100111100100001011)
                expect
                (fp #b0 #b01100111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01100111 #b00000000000000000000000)
                expect
                (fp #b0 #b10111011 #b01011110000111011110000)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
