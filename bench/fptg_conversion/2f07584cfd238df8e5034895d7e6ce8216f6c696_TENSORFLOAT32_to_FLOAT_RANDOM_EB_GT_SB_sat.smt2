; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010100 #b1011001111)
                arg1
                (fp #b0 #b10001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10001001 #b1101010000)
                arg1
                (fp #b0 #b10011001 #b1010010001)))
; arg1 = 1872.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result ((_ to_fp 8 6) rm arg1)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b0 #b01100110 #b10111)
                expect
                (fp #b0 #b10001001 #b11011)))
(assert (fp.leq (fp #b0 #b10001001 #b11011)
                expect
                (fp #b0 #b10111011 #b00101)))
; expect = 1888.0

(assert (= expect result))

(check-sat)
(exit)
