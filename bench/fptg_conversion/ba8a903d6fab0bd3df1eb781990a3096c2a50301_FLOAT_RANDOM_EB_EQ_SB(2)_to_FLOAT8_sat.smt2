(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100101 #b10011100)
                arg1
                (fp #b0 #b011111111 #b10011001)))
(assert (fp.leq (fp #b0 #b011111111 #b10011001)
                arg1
                (fp #b0 #b100000101 #b01111011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b000 #b1010)
                expect
                (fp #b0 #b011 #b1010)))
(assert (fp.leq (fp #b0 #b011 #b1010)
                expect
                (fp #b0 #b100 #b1111)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
