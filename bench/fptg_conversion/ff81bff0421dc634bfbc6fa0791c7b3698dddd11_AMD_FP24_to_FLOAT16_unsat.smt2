; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b0111110011111010)
                arg1
                (fp #b0 #b0100100 #b0110011011001000)))
(assert (fp.leq (fp #b0 #b0100100 #b0110011011001000)
                arg1
                (fp #b0 #b1000001 #b1011101010000111)))
; arg1 = 0.0000000104419086710549890995025634765625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b1100100110)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10001 #b1010100000)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
