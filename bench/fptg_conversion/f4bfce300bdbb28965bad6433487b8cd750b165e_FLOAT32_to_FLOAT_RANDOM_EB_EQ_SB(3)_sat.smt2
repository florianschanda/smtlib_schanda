(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101111 #b100111)
                expect
                (fp #b0 #b0000000 #b100000)))
(assert (fp.leq (fp #b0 #b0000000 #b100000)
                expect
                (fp #b0 #b1110011 #b111110)))
; expect = 0.000000000000000000108420217248550443400745280086994171142578125

(assert (= expect result))

(check-sat)
(exit)
