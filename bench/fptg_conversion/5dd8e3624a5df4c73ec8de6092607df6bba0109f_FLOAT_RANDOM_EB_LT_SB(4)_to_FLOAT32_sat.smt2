; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 9))
(assert (fp.leq (fp #b1 #b01 #b11111110)
                arg1
                (fp #b1 #b00 #b10111100)))
(assert (fp.leq (fp #b1 #b00 #b10111100)
                arg1
                (fp #b1 #b00 #b01011100)))
; arg1 = -0.734375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001111 #b01110101000100010110000)
                expect
                (fp #b1 #b01111110 #b01111000000000000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b01111000000000000000000)
                expect
                (fp #b0 #b00010011 #b01001110011011101110011)))
; expect = -0.734375

(assert (= expect result))

(check-sat)
(exit)
