; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg1
                (fp #b1 #b011 #b1010)))
(assert (fp.leq (fp #b1 #b011 #b1010)
                arg1
                (fp #b1 #b011 #b0100)))
; arg1 = -1.625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010111 #b001101110001000)
                expect
                (fp #b1 #b01111111 #b101000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b101000000000000)
                expect
                (fp #b0 #b11001101 #b000110111101101)))
; expect = -1.625

(assert (= expect result))

(check-sat)
(exit)
