; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00111 #b0010111101)
                arg1
                (fp #b0 #b00000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000 #b0001001100)
                arg1
                (fp #b0 #b11110 #b1101111111)))
; arg1 = 0.0000045299530029296875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111111 #b1001000)
                expect
                (fp #b0 #b01101101 #b0011000)))
(assert (fp.leq (fp #b0 #b01101101 #b0011000)
                expect
                (fp #b0 #b01111101 #b0110110)))
; expect = 0.0000045299530029296875

(assert (not (= expect result)))

(check-sat)
(exit)
