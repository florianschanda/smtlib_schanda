; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111000 #b1100010110111011)
                arg1
                (fp #b1 #b0110111 #b1011000001001100)))
(assert (fp.leq (fp #b1 #b0110111 #b1011000001001100)
                arg1
                (fp #b1 #b0011110 #b1110011100001001)))
; arg1 = -0.0065963268280029296875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010100 #b1011101)
                expect
                (fp #b1 #b01110111 #b1011001)))
(assert (fp.leq (fp #b1 #b01110111 #b1011001)
                expect
                (fp #b0 #b01011101 #b0111100)))
; expect = -0.006622314453125

(assert (= expect result))

(check-sat)
(exit)
