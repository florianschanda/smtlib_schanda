(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0001100110011011 #b100001)
                arg1
                (fp #b0 #b0000000000000000 #b110101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110101)
                arg1
                (fp #b0 #b1010000001101011 #b010111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b0011010110)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01110 #b0000001100)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
