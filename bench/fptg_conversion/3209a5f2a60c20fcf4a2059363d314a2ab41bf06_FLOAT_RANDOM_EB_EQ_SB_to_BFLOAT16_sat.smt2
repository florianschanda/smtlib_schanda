(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000101100 #b000000010)
                arg1
                (fp #b0 #b0111111111 #b110010111)))
(assert (fp.leq (fp #b0 #b0111111111 #b110010111)
                arg1
                (fp #b0 #b1101011101 #b111101010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00110100 #b0010101)
                expect
                (fp #b0 #b01111111 #b1100110)))
(assert (fp.leq (fp #b0 #b01111111 #b1100110)
                expect
                (fp #b0 #b11110100 #b0100010)))
; expect = 1.796875

(assert (= expect result))

(check-sat)
(exit)
