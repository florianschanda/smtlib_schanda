(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010000000 #b110110100)
                arg1
                (fp #b0 #b0111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b0111111111 #b111111100)
                arg1
                (fp #b0 #b1010001001 #b100010100)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b01011111100011100100011)
                expect
                (fp #b0 #b01111111 #b11111110000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b11111110000000000000000)
                expect
                (fp #b0 #b10001001 #b10001010111000010011100)))
; expect = 1.9921875

(assert (= expect result))

(check-sat)
(exit)
