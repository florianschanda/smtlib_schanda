(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b1111010100)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b0 #b01100000 #b0001100000)))
; arg1 = -264.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result ((_ to_fp 5 3) rm arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b10)
                expect
                (fp #b1 #b10111 #b01)))
(assert (fp.leq (fp #b1 #b10111 #b01)
                expect
                (fp #b0 #b11000 #b01)))
; expect = -320.0

(assert (= expect result))

(check-sat)
(exit)
