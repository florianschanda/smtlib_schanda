(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0011)
                arg1
                (fp #b1 #b000 #b1100)))
(assert (fp.leq (fp #b1 #b000 #b1100)
                arg1
                (fp #b0 #b001 #b0101)))
; arg1 = -0.1875

(declare-const result (_ FloatingPoint 9 3))
(assert (= result ((_ to_fp 9 3) rm arg1)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111001001 #b10)
                expect
                (fp #b1 #b011111100 #b10)))
(assert (fp.leq (fp #b1 #b011111100 #b10)
                expect
                (fp #b1 #b000111101 #b00)))

(assert (= expect result))

(check-sat)
(exit)
