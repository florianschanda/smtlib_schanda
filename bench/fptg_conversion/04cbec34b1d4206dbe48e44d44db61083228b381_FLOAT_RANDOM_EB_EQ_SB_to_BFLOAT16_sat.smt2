(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0010)
                arg1
                (fp #b1 #b10001 #b0000)))
(assert (fp.leq (fp #b1 #b10001 #b0000)
                arg1
                (fp #b1 #b01100 #b1110)))
; arg1 = -4.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111111 #b1110101)
                expect
                (fp #b1 #b10000001 #b0000000)))
(assert (fp.leq (fp #b1 #b10000001 #b0000000)
                expect
                (fp #b0 #b00111101 #b0110101)))
; expect = -4.0

(assert (= expect result))

(check-sat)
(exit)
