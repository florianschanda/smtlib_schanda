(assert (fp.leq (fp #b1 #b01101001 #b000100001011101)
                expect
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                expect
                (fp #b0 #b01001010 #b111110011011000)))
; expect = 0.0

(assert (not (= expect result)))

