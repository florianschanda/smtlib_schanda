; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b00101000101111 #b01)
                arg1
                (fp #b0 #b01111111111111 #b01)))
(assert (fp.leq (fp #b0 #b01111111111111 #b01)
                arg1
                (fp #b0 #b10010011100101 #b11)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111000 #b01011100010011011101001)
                expect
                (fp #b0 #b01111111 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b01000000000000000000000)
                expect
                (fp #b0 #b11101011 #b01001101100000010101010)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
