(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: FLOAT64
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg1
                (fp #b1 #b10 #b1)))
(assert (fp.leq (fp #b1 #b10 #b1)
                arg1
                (fp #b0 #b01 #b0)))
; arg1 = -3.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010111100 #b0100011111000100111111010010101101100110010010000100)
                expect
                (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01010010110 #b1010000101110001001111010101001010101010110001000010)))

(assert (= expect result))

(check-sat)
(exit)
