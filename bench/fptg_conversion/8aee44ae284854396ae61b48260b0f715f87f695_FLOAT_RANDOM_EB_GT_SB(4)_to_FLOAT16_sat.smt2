(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001100000 #b1)
                arg1
                (fp #b0 #b011111111 #b1)))
(assert (fp.leq (fp #b0 #b011111111 #b1)
                arg1
                (fp #b0 #b101011110 #b1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00100 #b0011011010)
                expect
                (fp #b0 #b01111 #b1000000000)))
(assert (fp.leq (fp #b0 #b01111 #b1000000000)
                expect
                (fp #b0 #b10000 #b1010010011)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
