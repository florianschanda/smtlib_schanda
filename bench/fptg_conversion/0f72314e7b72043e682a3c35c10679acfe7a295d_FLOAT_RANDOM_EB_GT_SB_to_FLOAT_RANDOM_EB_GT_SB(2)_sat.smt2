; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b0 #b10110011111010001 #b1101011)
                arg1
                (fp #b0 #b10111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b10111111111111110 #b1111111)
                arg1
                (fp #b0 #b11100111011010110 #b1110110)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
