; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00101101 #b00110100110101110011011)
                arg1
                (fp #b0 #b10011110 #b11110001001010000001001)))
(assert (fp.leq (fp #b0 #b10011110 #b11110001001010000001001)
                arg1
                (fp #b0 #b11110011 #b10011001111110110010010)))
; arg1 = 4170451200.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000110 #b0000000)
                expect
                (fp #b0 #b10011110 #b1111001)))
(assert (fp.leq (fp #b0 #b10011110 #b1111001)
                expect
                (fp #b0 #b11110100 #b1110110)))
; expect = 4177526784.0

(assert (not (= expect result)))

(check-sat)
(exit)
