(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011010110101 #b00001000010)
                expect
                (fp #b0 #b100001100110 #b10100101111)))
(assert (fp.leq (fp #b0 #b100001100110 #b10100101111)
                expect
                (fp #b0 #b101001110000 #b01110011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
