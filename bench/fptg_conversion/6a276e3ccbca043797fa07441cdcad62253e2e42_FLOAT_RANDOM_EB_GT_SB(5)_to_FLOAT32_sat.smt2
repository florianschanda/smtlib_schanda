(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b001)
                arg1
                (fp #b1 #b11101 #b000)))
(assert (fp.leq (fp #b1 #b11101 #b000)
                arg1
                (fp #b0 #b11001 #b010)))
; arg1 = -16384.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110110 #b01100111101001001001110)
                expect
                (fp #b1 #b10001101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10001101 #b00000000000000000000000)
                expect
                (fp #b0 #b01001000 #b00010011100110001001010)))
; expect = -16384.0

(assert (= expect result))

(check-sat)
(exit)
