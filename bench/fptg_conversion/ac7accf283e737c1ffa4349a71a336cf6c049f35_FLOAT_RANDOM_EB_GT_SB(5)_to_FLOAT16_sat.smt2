(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000000100 #b0100)
                arg1
                (fp #b0 #b01010001101 #b0011)))
(assert (fp.leq (fp #b0 #b01010001101 #b0011)
                arg1
                (fp #b0 #b01111010101 #b0011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b0011101000)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10111 #b1110101010)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
