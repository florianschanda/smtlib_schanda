; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00101 #b1011)
                arg1
                (fp #b0 #b01000 #b0000)))
(assert (fp.leq (fp #b0 #b01000 #b0000)
                arg1
                (fp #b0 #b10011 #b1001)))
; arg1 = 0.0078125

(declare-const result (_ FloatingPoint 8 3))
(assert (= result ((_ to_fp 8 3) rm arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b0 #b00001110 #b10)
                expect
                (fp #b0 #b01111000 #b00)))
(assert (fp.leq (fp #b0 #b01111000 #b00)
                expect
                (fp #b0 #b10111100 #b01)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
