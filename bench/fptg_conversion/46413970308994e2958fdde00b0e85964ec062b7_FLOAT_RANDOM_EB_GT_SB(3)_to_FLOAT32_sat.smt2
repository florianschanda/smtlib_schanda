(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b0)
                arg1
                (fp #b1 #b0111 #b1)))
(assert (fp.leq (fp #b1 #b0111 #b1)
                arg1
                (fp #b0 #b0111 #b0)))
; arg1 = -1.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b01100101101011111111000)
                expect
                (fp #b1 #b01111111 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b10000000000000000000000)
                expect
                (fp #b0 #b00111111 #b01000010100010010011101)))
; expect = -1.5

(assert (= expect result))

(check-sat)
(exit)
