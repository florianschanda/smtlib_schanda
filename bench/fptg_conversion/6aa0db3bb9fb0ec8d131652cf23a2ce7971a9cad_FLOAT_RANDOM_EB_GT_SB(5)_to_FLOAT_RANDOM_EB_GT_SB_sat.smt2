(assert (fp.leq (fp #b1 #b1011101110011100 #b10001111110001)
                expect
                (fp #b0 #b1000000000000101 #b00000000000000)))
(assert (fp.leq (fp #b0 #b1000000000000101 #b00000000000000)
                expect
                (fp #b0 #b1110111100001100 #b00100111000000)))

(assert (= expect result))

(check-sat)
