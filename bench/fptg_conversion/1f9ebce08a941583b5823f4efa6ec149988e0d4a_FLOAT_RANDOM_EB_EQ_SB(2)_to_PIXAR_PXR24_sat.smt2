; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111011010110 #b1001010110000)
                arg1
                (fp #b0 #b10000101001011 #b1010000100010)))
(assert (fp.leq (fp #b0 #b10000101001011 #b1010000100010)
                arg1
                (fp #b0 #b10010110111100 #b1010110001111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
