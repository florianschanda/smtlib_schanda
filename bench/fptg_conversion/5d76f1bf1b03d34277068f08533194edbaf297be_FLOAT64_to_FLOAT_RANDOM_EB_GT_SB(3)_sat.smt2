; Format from: FLOAT64
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001100001 #b1100101111110111000001000100001011001010000000010100)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01001100010 #b1010110001110010101110011101010011111000010001101011)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result ((_ to_fp 14 5) rm arg1)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01111110011101 #b1001)
                expect
                (fp #b1 #b01110000000001 #b0000)))
(assert (fp.leq (fp #b1 #b01110000000001 #b0000)
                expect
                (fp #b0 #b00111010011000 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
