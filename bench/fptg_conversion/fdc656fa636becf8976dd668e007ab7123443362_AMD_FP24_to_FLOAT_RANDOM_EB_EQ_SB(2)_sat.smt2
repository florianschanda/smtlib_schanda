; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b0111110001111000)
                arg1
                (fp #b0 #b1000100 #b0100110011010001)))
(assert (fp.leq (fp #b0 #b1000100 #b0100110011010001)
                arg1
                (fp #b0 #b1100000 #b1011001001000010)))
; arg1 = 41.60205078125

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b011100000011001 #b10011000111111)
                expect
                (fp #b0 #b100000000000100 #b01001100110101)))
(assert (fp.leq (fp #b0 #b100000000000100 #b01001100110101)
                expect
                (fp #b0 #b101110111001001 #b10110001000101)))

(assert (= expect result))

(check-sat)
(exit)
