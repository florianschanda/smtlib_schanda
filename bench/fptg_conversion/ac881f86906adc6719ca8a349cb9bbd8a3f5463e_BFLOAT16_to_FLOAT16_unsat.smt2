; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001000 #b1011100)
                arg1
                (fp #b1 #b00000000 #b1001010)))
(assert (fp.leq (fp #b1 #b00000000 #b1001010)
                arg1
                (fp #b0 #b11011000 #b1010010)))
