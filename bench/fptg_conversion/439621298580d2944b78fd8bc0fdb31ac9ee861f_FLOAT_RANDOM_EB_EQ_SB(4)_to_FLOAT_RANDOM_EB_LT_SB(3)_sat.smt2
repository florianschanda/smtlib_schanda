; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b011 #b10)
                arg1
                (fp #b0 #b101 #b00)))
(assert (fp.leq (fp #b0 #b101 #b00)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 11 15))
(assert (= result ((_ to_fp 11 15) rm arg1)))

(declare-const expect (_ FloatingPoint 11 15))
(assert (fp.leq (fp #b0 #b01001000000 #b00001100110100)
                expect
                (fp #b0 #b10000000001 #b00000000000000)))
(assert (fp.leq (fp #b0 #b10000000001 #b00000000000000)
                expect
                (fp #b0 #b11000100000 #b10011111001000)))

(assert (= expect result))

(check-sat)
(exit)
