(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: FLOAT16
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b01 #b0)))
(assert (fp.leq (fp #b0 #b01 #b0)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 1.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b0101010000)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b11100 #b1011101001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
