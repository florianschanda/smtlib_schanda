(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1010010101)
                arg1
                (fp #b1 #b01111 #b0100110000)))
(assert (fp.leq (fp #b1 #b01111 #b0100110000)
                arg1
                (fp #b0 #b10111 #b0011000011)))
; arg1 = -1.296875

(declare-const result (_ FloatingPoint 12 5))
(assert (= result ((_ to_fp 12 5) rm arg1)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b101001110110 #b1011)
                expect
                (fp #b1 #b011111111111 #b0101)))
(assert (fp.leq (fp #b1 #b011111111111 #b0101)
                expect
                (fp #b0 #b001101110011 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
