; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b101101100001111110 #b1110111000)
                arg1
                (fp #b1 #b100100010101000100 #b0010001010)))
(assert (fp.leq (fp #b1 #b100100010101000100 #b0010001010)
                arg1
                (fp #b1 #b011010101001111011 #b0101101000)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
