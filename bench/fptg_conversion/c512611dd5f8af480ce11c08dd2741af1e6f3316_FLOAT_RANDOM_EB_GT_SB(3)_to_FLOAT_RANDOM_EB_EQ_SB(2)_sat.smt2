; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b011000 #b0)
                arg1
                (fp #b0 #b100000 #b1)))
(assert (fp.leq (fp #b0 #b100000 #b1)
                arg1
                (fp #b0 #b110101 #b0)))
; arg1 = 3.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0111101100001111 #b101010110011001)
                expect
                (fp #b0 #b1000000000000000 #b100000000000000)))
(assert (fp.leq (fp #b0 #b1000000000000000 #b100000000000000)
                expect
                (fp #b0 #b1011101111100101 #b101011000100010)))

(assert (= expect result))

(check-sat)
(exit)
