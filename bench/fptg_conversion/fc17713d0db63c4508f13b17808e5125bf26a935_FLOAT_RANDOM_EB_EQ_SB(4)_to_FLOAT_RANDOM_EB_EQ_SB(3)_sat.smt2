                expect
                (fp #b1 #b0111111111111110 #b001000000000000)))
(assert (fp.leq (fp #b1 #b0111111111111110 #b001000000000000)
                expect
                (fp #b0 #b0010001001101001 #b001101001110000)))

(assert (= expect result))

