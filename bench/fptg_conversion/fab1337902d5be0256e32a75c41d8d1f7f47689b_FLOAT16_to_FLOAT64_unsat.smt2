                expect
                (fp #b0 #b10000001010 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001010 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11011011011 #b1001010001111010010100011010101111101001000011001010)))

(assert (not (= expect result)))

