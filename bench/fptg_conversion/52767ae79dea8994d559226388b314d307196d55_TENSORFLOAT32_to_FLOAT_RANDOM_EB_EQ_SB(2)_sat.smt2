; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011100 #b0101101001)
                arg1
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                arg1
                (fp #b0 #b00011111 #b1000111011)))
; arg1 = -1.203125

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110001111110 #b11100011111)
                expect
                (fp #b1 #b011111111111 #b00110100000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00110100000)
                expect
                (fp #b0 #b001011111010 #b01010101111)))

(assert (= expect result))

(check-sat)
(exit)
