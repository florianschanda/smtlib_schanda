; Format from: FLOAT64
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01000000111 #b0101000011110100000001000000101111010101111010101110)
                arg1
                (fp #b0 #b11100100111 #b0010111001110010100000010000111101011101010011010001)))
(assert (fp.leq (fp #b0 #b11100100111 #b0010111001110010100000010000111101011101010011010001)
                arg1
                (fp #b0 #b11101000001 #b1001110000000110110111110011111111100101000010110010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
