(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1000101 #b1)
                arg1
                (fp #b0 #b1001100 #b1)))
(assert (fp.leq (fp #b0 #b1001100 #b1)
                arg1
                (fp #b0 #b1110110 #b0)))
; arg1 = 12288.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100100 #b11010100010110000110101)
                expect
                (fp #b0 #b10001100 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001100 #b10000000000000000000000)
                expect
                (fp #b0 #b11110101 #b10110111010100000010010)))
; expect = 12288.0

(assert (= expect result))

(check-sat)
(exit)
