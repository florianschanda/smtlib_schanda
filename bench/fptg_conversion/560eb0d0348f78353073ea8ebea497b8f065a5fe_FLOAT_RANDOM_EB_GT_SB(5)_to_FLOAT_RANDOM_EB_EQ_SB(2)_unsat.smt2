; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101001011 #b0100)
                arg1
                (fp #b1 #b000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000 #b0001)
                arg1
                (fp #b0 #b000010000 #b1100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100000110 #b11001100110)
                expect
                (fp #b1 #b011011111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b011011111101 #b00000000000)
                expect
                (fp #b1 #b010001101100 #b10110110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
