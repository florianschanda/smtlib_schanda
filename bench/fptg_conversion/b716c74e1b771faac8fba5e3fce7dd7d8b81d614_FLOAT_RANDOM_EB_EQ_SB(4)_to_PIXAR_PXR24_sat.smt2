; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b11)
                arg1
                (fp #b0 #b110 #b10)))
(assert (fp.leq (fp #b0 #b110 #b10)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 12.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00101010 #b111101001101011)
                expect
                (fp #b0 #b10000010 #b100000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b100000000000000)
                expect
                (fp #b0 #b11010011 #b001101001000010)))
; expect = 12.0

(assert (= expect result))

(check-sat)
(exit)
