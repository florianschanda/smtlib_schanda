(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110101 #b10000111100111011111011)
                arg1
                (fp #b1 #b11100001 #b01101100001000100000010)))
(assert (fp.leq (fp #b1 #b11100001 #b01101100001000100000010)
                arg1
                (fp #b1 #b11001100 #b11010001001000100101110)))
; arg1 = -450774663769209735545364676608.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101110 #b001001010100010)
                expect
                (fp #b1 #b11100001 #b011011000010010)))
(assert (fp.leq (fp #b1 #b11100001 #b011011000010010)
                expect
                (fp #b0 #b11000000 #b111110110110001)))
; expect = -450784259617902926664438906880.0

(assert (= expect result))

(check-sat)
(exit)
