; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0110)
                arg1
                (fp #b1 #b101 #b0000)))
(assert (fp.leq (fp #b1 #b101 #b0000)
                arg1
                (fp #b1 #b001 #b0110)))
; arg1 = -4.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000010110 #b1010100100100000100100001001101001010110001101111110)
                expect
                (fp #b1 #b10000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b00010010101 #b1001100111010110100100000110101001010010100010110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
