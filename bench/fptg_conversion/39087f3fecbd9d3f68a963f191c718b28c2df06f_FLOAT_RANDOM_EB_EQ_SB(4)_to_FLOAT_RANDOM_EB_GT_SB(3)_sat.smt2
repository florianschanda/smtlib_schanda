(assert (fp.leq (fp #b1 #b1011010000010 #b0)
                expect
                (fp #b1 #b0110111111110 #b1)))
(assert (fp.leq (fp #b1 #b0110111111110 #b1)
                expect
                (fp #b1 #b0110110101001 #b1)))

(assert (= expect result))

(check-sat)
