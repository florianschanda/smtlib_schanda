(assert (= result ((_ to_fp 10 7) rm arg1)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1011101000 #b011001)
                expect
                (fp #b1 #b0110110001 #b000000)))
(assert (fp.leq (fp #b1 #b0110110001 #b000000)
                expect
                (fp #b0 #b1011101011 #b001001)))

(assert (= expect result))

(check-sat)
