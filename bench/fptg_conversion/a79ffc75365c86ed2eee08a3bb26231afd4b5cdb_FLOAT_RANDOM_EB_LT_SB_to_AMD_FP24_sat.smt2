; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 40))
(assert (fp.leq (fp #b1 #b00001 #b001111100001011011100001011101101000111)
                arg1
                (fp #b0 #b11110 #b111111111111111010110100100101011111000)))
(assert (fp.leq (fp #b0 #b11110 #b111111111111111010110100100101011111000)
                arg1
                (fp #b0 #b11110 #b111111111111111110011110011001111110010)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011111 #b0100100100011000)
                expect
                (fp #b0 #b1001110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1001110 #b1111111111111111)
                expect
                (fp #b0 #b1010000 #b0110111111111100)))
; expect = 65535.5

(assert (= expect result))

(check-sat)
(exit)
