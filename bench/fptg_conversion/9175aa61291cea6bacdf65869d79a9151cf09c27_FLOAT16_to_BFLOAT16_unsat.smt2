; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01100 #b0000111111)
                arg1
                (fp #b0 #b10101 #b1011010000)))
(assert (fp.leq (fp #b0 #b10101 #b1011010000)
                arg1
                (fp #b0 #b11110 #b1001110011)))
; arg1 = 109.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00100011 #b0100010)
                expect
                (fp #b0 #b10000101 #b1011010)))
(assert (fp.leq (fp #b0 #b10000101 #b1011010)
                expect
                (fp #b0 #b10101110 #b1000001)))
; expect = 109.0

(assert (not (= expect result)))

(check-sat)
(exit)
