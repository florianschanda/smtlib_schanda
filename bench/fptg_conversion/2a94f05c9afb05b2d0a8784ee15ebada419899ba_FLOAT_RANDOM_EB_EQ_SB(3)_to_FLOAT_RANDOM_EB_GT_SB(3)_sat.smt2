(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b000000 #b101)
                expect
                (fp #b0 #b011111 #b101)))
(assert (fp.leq (fp #b0 #b011111 #b101)
                expect
                (fp #b0 #b101110 #b100)))
; expect = 1.625

(assert (= expect result))

(check-sat)
