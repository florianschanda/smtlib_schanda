(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0111)
                arg1
                (fp #b0 #b010 #b0000)))
(assert (fp.leq (fp #b0 #b010 #b0000)
                arg1
                (fp #b0 #b100 #b1011)))
; arg1 = 0.5

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00110100 #b000000010110010)
                expect
                (fp #b0 #b01111110 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111110 #b000000000000000)
                expect
                (fp #b0 #b11100010 #b100110001100111)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
