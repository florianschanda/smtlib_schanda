(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111000 #b01101000101110110101111)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b00101010 #b01000110111001010100111)))
; arg1 = -1047025986568192.0

(declare-const result (_ FloatingPoint 13 13))
(assert (= result ((_ to_fp 13 13) rm arg1)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1001000100111 #b011001100010)
                expect
                (fp #b1 #b1000000110000 #b110111000011)))
(assert (fp.leq (fp #b1 #b1000000110000 #b110111000011)
                expect
                (fp #b1 #b0011010111001 #b011011101100)))

(assert (= expect result))

(check-sat)
(exit)
