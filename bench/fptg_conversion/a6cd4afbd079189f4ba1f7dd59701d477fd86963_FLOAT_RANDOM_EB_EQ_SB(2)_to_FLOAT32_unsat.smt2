(assert (fp.leq (fp #b1 #b11111111111111110 #b0111100100111111)
                arg1
                (fp #b1 #b11111111111111101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b0000000000000000)
                arg1
