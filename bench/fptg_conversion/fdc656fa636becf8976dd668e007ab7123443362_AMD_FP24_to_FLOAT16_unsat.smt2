; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100000 #b0111110001111000)
                arg1
                (fp #b0 #b1000100 #b0100110011010001)))
(assert (fp.leq (fp #b0 #b1000100 #b0100110011010001)
                arg1
                (fp #b0 #b1100000 #b1011001001000010)))
; arg1 = 41.60205078125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0001111011)
                expect
                (fp #b0 #b10100 #b0100110100)))
(assert (fp.leq (fp #b0 #b10100 #b0100110100)
                expect
                (fp #b0 #b10110 #b1001001001)))
; expect = 41.625

(assert (not (= expect result)))

(check-sat)
(exit)
