(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b010010001 #b1)
                arg1
                (fp #b0 #b000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000 #b1)
                arg1
                (fp #b0 #b110100000 #b1)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b0111110000010100)
                expect
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b0001000 #b1110011010011000)))
; expect = 0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(assert (not (= expect result)))

(check-sat)
(exit)
