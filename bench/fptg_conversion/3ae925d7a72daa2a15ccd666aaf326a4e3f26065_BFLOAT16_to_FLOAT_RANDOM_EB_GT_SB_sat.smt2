; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const result (_ FloatingPoint 8 4))
(assert (= result ((_ to_fp 8 4) rm arg1)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
