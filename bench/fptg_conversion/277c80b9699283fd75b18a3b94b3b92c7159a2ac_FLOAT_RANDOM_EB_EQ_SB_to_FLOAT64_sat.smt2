                expect
                (fp #b1 #b10000000010 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000010 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01011010000 #b1111111011011011101101011001101110010101001110101100)))

