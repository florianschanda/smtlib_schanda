; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b0011110001011010)
                arg1
                (fp #b1 #b0111111 #b0011010000100011)))
(assert (fp.leq (fp #b1 #b0111111 #b0011010000100011)
                arg1
                (fp #b0 #b0100010 #b0100001100101001)))
; arg1 = -1.2036590576171875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10110 #b1100)
                expect
                (fp #b1 #b01111 #b0100)))
(assert (fp.leq (fp #b1 #b01111 #b0100)
                expect
                (fp #b1 #b00100 #b1010)))
; expect = -1.25

(assert (= expect result))

(check-sat)
(exit)
