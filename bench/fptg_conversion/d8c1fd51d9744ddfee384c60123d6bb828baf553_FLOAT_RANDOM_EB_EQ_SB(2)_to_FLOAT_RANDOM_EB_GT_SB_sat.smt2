; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b110 #b01)))
(assert (fp.leq (fp #b0 #b110 #b01)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 10.0

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1010100100 #b0001)
                expect
                (fp #b0 #b1000000010 #b0100)))
(assert (fp.leq (fp #b0 #b1000000010 #b0100)
                expect
                (fp #b0 #b1011000110 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
