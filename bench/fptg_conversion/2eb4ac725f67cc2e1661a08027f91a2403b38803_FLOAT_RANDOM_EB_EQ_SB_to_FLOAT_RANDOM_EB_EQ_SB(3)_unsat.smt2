; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1000111 #b110000)
                arg1
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg1
                (fp #b0 #b1001100 #b011111)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111101 #b01001)
                expect
                (fp #b0 #b000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000 #b00000)
                expect
                (fp #b0 #b011011 #b01000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
