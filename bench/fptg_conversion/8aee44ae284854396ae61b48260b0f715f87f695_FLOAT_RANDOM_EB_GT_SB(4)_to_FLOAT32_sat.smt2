(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001100000 #b1)
                arg1
                (fp #b0 #b011111111 #b1)))
(assert (fp.leq (fp #b0 #b011111111 #b1)
                arg1
                (fp #b0 #b101011110 #b1)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001110 #b10001010101111011111110)
                expect
                (fp #b0 #b01111111 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10000000000000000000000)
                expect
                (fp #b0 #b10001010 #b10001101110100011100110)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
