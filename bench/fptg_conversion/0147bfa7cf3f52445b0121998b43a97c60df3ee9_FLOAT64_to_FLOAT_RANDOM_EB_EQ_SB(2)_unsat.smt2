; Format from: FLOAT64
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010010101 #b0010010110010111111010110111011010100101010111100110)
                arg1
                (fp #b1 #b10000110001 #b1001000101111001100101001110110001110001110110011000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1001000101111001100101001110110001110001110110011000)
                arg1
                (fp #b1 #b01010111110 #b1011011011000011101101000011011010101010110111111000)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
