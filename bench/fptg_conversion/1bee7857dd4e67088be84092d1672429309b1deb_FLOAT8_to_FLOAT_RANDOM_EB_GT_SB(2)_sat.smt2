; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg1
                (fp #b1 #b011 #b0101)))
; arg1 = -3.875

(declare-const result (_ FloatingPoint 13 4))
(assert (= result ((_ to_fp 13 4) rm arg1)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1010111110100 #b111)
                expect
                (fp #b1 #b1000000000001 #b000)))
(assert (fp.leq (fp #b1 #b1000000000001 #b000)
                expect
                (fp #b0 #b1011111110010 #b010)))

(assert (= expect result))

(check-sat)
(exit)
