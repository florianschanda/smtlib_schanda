(assert (fp.leq (fp #b1 #b01011110 #b10111001101011000001111)
                expect
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b10101101 #b00000111011010111001101)))
