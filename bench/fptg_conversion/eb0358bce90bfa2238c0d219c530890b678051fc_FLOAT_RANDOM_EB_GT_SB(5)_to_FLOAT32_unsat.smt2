(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00000010101100 #b0110100011)
                arg1
                (fp #b1 #b00000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000)
                arg1
                (fp #b0 #b01011011000101 #b1001101110)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01111000 #b10001110110000011111111)
                expect
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b00000100 #b10110000100100110110110)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
