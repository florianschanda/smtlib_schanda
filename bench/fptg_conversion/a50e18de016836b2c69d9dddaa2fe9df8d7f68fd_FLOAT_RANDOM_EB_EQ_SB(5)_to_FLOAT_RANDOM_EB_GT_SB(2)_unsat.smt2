; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001111 #b00111)
                arg1
                (fp #b0 #b000000 #b11001)))
(assert (fp.leq (fp #b0 #b000000 #b11001)
                arg1
                (fp #b0 #b110111 #b01000)))
; arg1 = 0.00000000072759576141834259033203125

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0111 #b01)
                expect
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                expect
                (fp #b0 #b1100 #b01)))
; expect = 0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
