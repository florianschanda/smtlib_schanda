; Format from: FLOAT64
; Format to: FLOAT16
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001011110 #b0011001101101001100010110111011110010011100011101101)
                arg1
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b00000110001 #b1101110010110000000100100111100100010100010001111011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b0011111111)
                expect
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                expect
                (fp #b1 #b01001 #b0110000011)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
