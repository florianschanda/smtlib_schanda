(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b10001101100110100 #b0)
                expect
                (fp #b1 #b10000001111111101 #b0)))
(assert (fp.leq (fp #b1 #b10000001111111101 #b0)
                expect
                (fp #b0 #b10101110100110001 #b1)))

(assert (= expect result))

(check-sat)
(exit)
