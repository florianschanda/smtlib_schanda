(assert (fp.leq (fp #b1 #b000 #b10)
                expect
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                expect
                (fp #b0 #b011 #b00)))
; expect = 0.0625

(assert (not (= expect result)))

