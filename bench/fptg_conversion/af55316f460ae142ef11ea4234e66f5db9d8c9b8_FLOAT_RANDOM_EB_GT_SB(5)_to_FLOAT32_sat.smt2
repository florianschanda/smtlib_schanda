(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11011100111001 #b110)
                arg1
                (fp #b0 #b01111111111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111111111 #b101)
                arg1
                (fp #b0 #b11011111110010 #b000)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011111 #b11111100011111100110011)
                expect
                (fp #b0 #b01111111 #b10100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10100000000000000000000)
                expect
                (fp #b0 #b10010011 #b01100110011110011101100)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
