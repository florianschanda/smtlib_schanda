(assert (fp.leq (fp #b1 #b11011110 #b00110100000000100001101)
                expect
                (fp #b1 #b10111011 #b00010010111001100000000)))
(assert (fp.leq (fp #b1 #b10111011 #b00010010111001100000000)
                expect
                (fp #b0 #b00010000 #b10101011011010110110000)))
; expect = -1238032500689731584.0

(assert (= expect result))

(check-sat)
