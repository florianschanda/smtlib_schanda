(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11011011 #b01)
                arg1
                (fp #b0 #b10000001 #b00)))
(assert (fp.leq (fp #b0 #b10000001 #b00)
                arg1
                (fp #b0 #b11100101 #b01)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00100110 #b1011010)
                expect
                (fp #b0 #b10000001 #b0000000)))
(assert (fp.leq (fp #b0 #b10000001 #b0000000)
                expect
                (fp #b0 #b11010110 #b0100000)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
