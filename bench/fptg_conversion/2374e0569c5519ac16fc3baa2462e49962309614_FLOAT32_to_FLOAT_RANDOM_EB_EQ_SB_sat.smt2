(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg1 = 11601303.0

(declare-const result (_ FloatingPoint 17 17))
(assert (= result ((_ to_fp 17 17) rm arg1)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b0 #b01011110011100011 #b0011100100010001)
                expect
                (fp #b0 #b10000000000010110 #b0110001000001100)))
(assert (fp.leq (fp #b0 #b10000000000010110 #b0110001000001100)
                expect
                (fp #b0 #b11100101111111010 #b1100000000001111)))

(assert (= expect result))

(check-sat)
(exit)
