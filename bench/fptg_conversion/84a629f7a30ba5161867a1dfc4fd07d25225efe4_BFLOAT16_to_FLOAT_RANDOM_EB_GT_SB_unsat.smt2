(assert (fp.leq (fp #b1 #b11100 #b100)
                expect
                (fp #b0 #b00000 #b001)))
(assert (fp.leq (fp #b0 #b00000 #b001)
                expect
                (fp #b0 #b00100 #b101)))
; expect = 0.00000762939453125

