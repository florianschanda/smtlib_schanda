(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b0000000001)
                arg1
                (fp #b1 #b00001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00001 #b0000000000)
                arg1
                (fp #b0 #b10011 #b1100111011)))
; arg1 = -0.00006103515625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01110101 #b10111110101100100011000)
                expect
                (fp #b1 #b01110001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01110001 #b00000000000000000000000)
                expect
                (fp #b0 #b00111011 #b10011101110010001100110)))
; expect = -0.00006103515625

(assert (not (= expect result)))

(check-sat)
(exit)
