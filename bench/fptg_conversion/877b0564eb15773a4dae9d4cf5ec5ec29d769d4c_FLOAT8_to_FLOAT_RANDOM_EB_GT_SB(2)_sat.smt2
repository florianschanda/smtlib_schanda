; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b110 #b0010)))
(assert (fp.leq (fp #b1 #b110 #b0010)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -9.0

(declare-const result (_ FloatingPoint 15 11))
(assert (= result ((_ to_fp 15 11) rm arg1)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b110111110011001 #b1011010010)
                expect
                (fp #b1 #b100000000000010 #b0010000000)))
(assert (fp.leq (fp #b1 #b100000000000010 #b0010000000)
                expect
                (fp #b0 #b110100001010000 #b0101101011)))

(assert (= expect result))

(check-sat)
(exit)
