; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000100100)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b10110 #b0110111010)))
; arg1 = 0.10479736328125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010000 #b0110101111110111)
                expect
                (fp #b0 #b0111011 #b1010110101000000)))
(assert (fp.leq (fp #b0 #b0111011 #b1010110101000000)
                expect
                (fp #b0 #b1101100 #b0010001100001100)))
; expect = 0.10479736328125

(assert (= expect result))

(check-sat)
(exit)
