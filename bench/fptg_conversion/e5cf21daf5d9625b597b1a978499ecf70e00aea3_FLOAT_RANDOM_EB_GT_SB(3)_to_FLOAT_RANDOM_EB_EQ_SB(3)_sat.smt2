(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111000000111001100 #b10100111010011101)
                expect
                (fp #b0 #b011111111111111111 #b11100000000000000)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b11100000000000000)
                expect
                (fp #b0 #b100111001100001001 #b11101110011010110)))

(assert (= expect result))

(check-sat)
