(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0101)
                arg1
                (fp #b0 #b10111 #b0000)))
(assert (fp.leq (fp #b0 #b10111 #b0000)
                arg1
                (fp #b0 #b11101 #b1110)))
; arg1 = 256.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111001 #b11111101101001111111010)
                expect
                (fp #b0 #b10000111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000111 #b00000000000000000000000)
                expect
                (fp #b0 #b11001010 #b01101100100001101111001)))
; expect = 256.0

(assert (= expect result))

(check-sat)
(exit)
