                expect
                (fp #b0 #b0111100 #b1100000000000000)))
(assert (fp.leq (fp #b0 #b0111100 #b1100000000000000)
                expect
                (fp #b0 #b1001111 #b1010000110101000)))
; expect = 0.21875

(assert (not (= expect result)))

