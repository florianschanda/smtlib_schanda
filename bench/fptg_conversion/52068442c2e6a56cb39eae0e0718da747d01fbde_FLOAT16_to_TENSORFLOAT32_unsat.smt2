                expect
                (fp #b1 #b01110000 #b0100101010)))
(assert (fp.leq (fp #b1 #b01110000 #b0100101010)
                expect
                (fp #b0 #b10000100 #b0111100110)))
; expect = -0.000039398670196533203125

(assert (not (= expect result)))

