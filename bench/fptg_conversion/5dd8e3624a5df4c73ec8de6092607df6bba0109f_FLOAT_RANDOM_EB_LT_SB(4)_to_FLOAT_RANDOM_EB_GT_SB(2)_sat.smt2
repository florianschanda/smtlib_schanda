(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 9))
(assert (fp.leq (fp #b1 #b01 #b11111110)
                arg1
                (fp #b1 #b00 #b10111100)))
(assert (fp.leq (fp #b1 #b00 #b10111100)
                arg1
                (fp #b1 #b00 #b01011100)))
; arg1 = -0.734375

(declare-const result (_ FloatingPoint 14 5))
(assert (= result ((_ to_fp 14 5) rm arg1)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10111001111011 #b0000)
                expect
                (fp #b1 #b01111111111110 #b1000)))
(assert (fp.leq (fp #b1 #b01111111111110 #b1000)
                expect
                (fp #b0 #b00111101001001 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
