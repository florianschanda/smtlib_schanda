(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011110 #b00000)
                arg1
                (fp #b0 #b011111 #b10111)))
(assert (fp.leq (fp #b0 #b011111 #b10111)
                arg1
                (fp #b0 #b110110 #b01100)))
; arg1 = 1.71875

(declare-const result (_ FloatingPoint 8 4))
(assert (= result ((_ to_fp 8 4) rm arg1)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10000110 #b000)
                expect
                (fp #b0 #b01111111 #b110)))
(assert (fp.leq (fp #b0 #b01111111 #b110)
                expect
                (fp #b0 #b10011100 #b000)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
