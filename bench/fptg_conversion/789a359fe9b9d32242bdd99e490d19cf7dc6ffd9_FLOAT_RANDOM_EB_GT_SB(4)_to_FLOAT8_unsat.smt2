; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0110110111101 #b0111111)
                arg1
                (fp #b0 #b0000000000000 #b1100110)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1100110)
                arg1
                (fp #b0 #b1111001001110 #b1101011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1000)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b101 #b0100)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
