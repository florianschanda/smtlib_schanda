(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11011 #b1)
                arg1
                (fp #b1 #b10110 #b1)))
(assert (fp.leq (fp #b1 #b10110 #b1)
                arg1
                (fp #b0 #b10000 #b0)))
; arg1 = -192.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101010 #b11010110100100100110101)
                expect
                (fp #b1 #b10000110 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b10000000000000000000000)
                expect
                (fp #b0 #b00001100 #b01110100010000100101011)))
; expect = -192.0

(assert (not (= expect result)))

(check-sat)
(exit)
