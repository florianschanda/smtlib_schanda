; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000100100)
                arg1
                (fp #b0 #b01011 #b1010110101)))
(assert (fp.leq (fp #b0 #b01011 #b1010110101)
                arg1
                (fp #b0 #b10110 #b0110111010)))
; arg1 = 0.10479736328125

(declare-const result (_ FloatingPoint 13 9))
(assert (= result ((_ to_fp 13 9) rm arg1)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1010000110001 #b10100011)
                expect
                (fp #b0 #b0111111111011 #b10101110)))
(assert (fp.leq (fp #b0 #b0111111111011 #b10101110)
                expect
                (fp #b0 #b1000111100101 #b11101010)))

(assert (= expect result))

(check-sat)
(exit)
