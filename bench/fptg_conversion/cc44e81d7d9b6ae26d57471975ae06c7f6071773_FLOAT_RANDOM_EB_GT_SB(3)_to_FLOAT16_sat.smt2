(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b010001100 #b00011)
                arg1
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg1
                (fp #b0 #b100111000 #b00011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10011 #b1110010010)
                expect
                (fp #b0 #b10101 #b0000000000)))
(assert (fp.leq (fp #b0 #b10101 #b0000000000)
                expect
                (fp #b0 #b11100 #b0000010010)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
