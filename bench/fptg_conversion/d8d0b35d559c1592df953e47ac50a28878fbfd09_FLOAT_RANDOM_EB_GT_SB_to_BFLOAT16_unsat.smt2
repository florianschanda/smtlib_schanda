(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b1000101)
                expect
                (fp #b0 #b01111111 #b1100110)))
(assert (fp.leq (fp #b0 #b01111111 #b1100110)
                expect
                (fp #b0 #b11101100 #b1011010)))
; expect = 1.796875

(assert (not (= expect result)))

