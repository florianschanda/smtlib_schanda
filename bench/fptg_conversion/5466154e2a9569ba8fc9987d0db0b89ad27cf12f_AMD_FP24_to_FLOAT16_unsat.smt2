; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011011 #b1011001101100011)
                arg1
                (fp #b0 #b0111111 #b1000110101010111)))
(assert (fp.leq (fp #b0 #b0111111 #b1000110101010111)
                arg1
                (fp #b0 #b1101111 #b1001100101001000)))
; arg1 = 1.5521087646484375

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01001 #b0001001100)
                expect
                (fp #b0 #b01111 #b1000110110)))
(assert (fp.leq (fp #b0 #b01111 #b1000110110)
                expect
                (fp #b0 #b11100 #b1101000101)))
; expect = 1.552734375

(assert (not (= expect result)))

(check-sat)
(exit)
