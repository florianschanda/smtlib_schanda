(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b011 #b10)
                arg1
                (fp #b0 #b101 #b00)))
(assert (fp.leq (fp #b0 #b101 #b00)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result ((_ to_fp 8 6) rm arg1)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b11010010 #b10100)
                expect
                (fp #b0 #b10000001 #b00000)))
(assert (fp.leq (fp #b0 #b10000001 #b00000)
                expect
                (fp #b0 #b10000001 #b01000)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
