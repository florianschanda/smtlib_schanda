; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000100 #b10101000011011010000001)
                arg1
                (fp #b1 #b00000000 #b01001000110110111010000)))
(assert (fp.leq (fp #b1 #b00000000 #b01001000110110111010000)
                arg1
                (fp #b0 #b11010111 #b01001011101000100010010)))
; arg1 = -0.0000000000000000000000000000000000000033454711641167828736598793969830120911475476021315287656189988775047583491328850868740119040012359619140625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01001 #b0110111110)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00001 #b1000110001)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
