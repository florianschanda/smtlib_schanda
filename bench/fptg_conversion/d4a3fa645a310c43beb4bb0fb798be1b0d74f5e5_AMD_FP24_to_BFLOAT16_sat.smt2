; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1001000011110011)
                arg1
                (fp #b1 #b1010000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1010000 #b0000000000000000)
                arg1
                (fp #b0 #b0111110 #b1111001010000010)))
; arg1 = -131072.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101000 #b0101101)
                expect
                (fp #b1 #b10010000 #b0000000)))
(assert (fp.leq (fp #b1 #b10010000 #b0000000)
                expect
                (fp #b1 #b01110110 #b1010100)))
; expect = -131072.0

(assert (= expect result))

(check-sat)
(exit)
