(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0100)
                arg1
                (fp #b1 #b011 #b0111)))
(assert (fp.leq (fp #b1 #b011 #b0111)
                arg1
                (fp #b0 #b000 #b0101)))
; arg1 = -1.4375

(declare-const result (_ FloatingPoint 8 4))
(assert (= result ((_ to_fp 8 4) rm arg1)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10101110 #b100)
                expect
                (fp #b1 #b01111111 #b100)))
(assert (fp.leq (fp #b1 #b01111111 #b100)
                expect
                (fp #b0 #b01101111 #b110)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
