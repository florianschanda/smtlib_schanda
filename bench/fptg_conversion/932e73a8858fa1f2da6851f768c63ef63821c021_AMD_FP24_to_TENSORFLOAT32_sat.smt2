; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000000 #b0001011110100011)
                arg1
                (fp #b0 #b0111111 #b0000011100001100)))
(assert (fp.leq (fp #b0 #b0111111 #b0000011100001100)
                arg1
                (fp #b0 #b1111010 #b1000011100010000)))
; arg1 = 1.02752685546875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110100 #b0101101101)
                expect
                (fp #b0 #b01111111 #b0000011101)))
(assert (fp.leq (fp #b0 #b01111111 #b0000011101)
                expect
                (fp #b0 #b10010100 #b0000111100)))
; expect = 1.0283203125

(assert (= expect result))

(check-sat)
(exit)
