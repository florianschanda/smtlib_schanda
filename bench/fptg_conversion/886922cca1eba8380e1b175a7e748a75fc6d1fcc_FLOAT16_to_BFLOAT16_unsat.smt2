(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01111 #b1101010110)
                arg1
                (fp #b1 #b00010 #b1001100111)))
(assert (fp.leq (fp #b1 #b00010 #b1001100111)
                arg1
                (fp #b0 #b11110 #b0011110100)))
; arg1 = -0.00019538402557373046875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101101 #b1111100)
                expect
                (fp #b1 #b01110010 #b1001101)))
(assert (fp.leq (fp #b1 #b01110010 #b1001101)
                expect
                (fp #b0 #b00011100 #b0101010)))
; expect = -0.00019550323486328125

(assert (not (= expect result)))

(check-sat)
(exit)
