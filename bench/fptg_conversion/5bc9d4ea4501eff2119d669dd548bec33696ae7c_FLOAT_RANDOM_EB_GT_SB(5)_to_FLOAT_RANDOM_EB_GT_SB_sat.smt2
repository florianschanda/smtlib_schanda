(assert (fp.leq (fp #b1 #b111111101011 #b110000001)
                expect
                (fp #b1 #b011100000001 #b000000000)))
(assert (fp.leq (fp #b1 #b011100000001 #b000000000)
                expect
                (fp #b1 #b000100001011 #b100001001)))

(assert (= expect result))

(check-sat)
