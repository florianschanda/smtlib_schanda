; Format from: FLOAT64
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000000101 #b0001011011000010011111101101000100101010100100110111)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00010011010 #b0101001000011010111111100011101101101000001110011111)))

(declare-const result (_ FloatingPoint 8 2))
(assert (= result ((_ to_fp 8 2) rm arg1)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11001101 #b0)
                expect
                (fp #b1 #b00000000 #b1)))
(assert (fp.leq (fp #b1 #b00000000 #b1)
                expect
                (fp #b0 #b00110100 #b1)))
; expect = -0.0000000000000000000000000000000000000058774717541114375398436826861112283890933277838604376075437585313920862972736358642578125

(assert (= expect result))

(check-sat)
