(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT64
; Format to: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100110011 #b0010011100101001111010101001000001100001101100000001)
                arg1
                (fp #b1 #b11100010000 #b1101010100110111101000010011001001001001000000100010)))
(assert (fp.leq (fp #b1 #b11100010000 #b1101010100110111101000010011001001001001000000100010)
                arg1
                (fp #b0 #b10010010101 #b1001100111001001100010010010110101110111001000100000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
