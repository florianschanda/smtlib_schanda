(declare-const result (_ FloatingPoint 5 4))
(assert (= result ((_ to_fp 5 4) rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10110 #b011)
                expect
                (fp #b1 #b00000 #b001)))
(assert (fp.leq (fp #b1 #b00000 #b001)
                expect
                (fp #b0 #b10001 #b111)))
; expect = -0.00000762939453125

(assert (= expect result))

(check-sat)
(exit)
