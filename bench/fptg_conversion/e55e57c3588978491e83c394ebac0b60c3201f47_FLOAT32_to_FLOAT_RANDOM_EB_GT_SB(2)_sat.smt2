(assert (fp.leq (fp #b1 #b10000100 #b10101000011011010000001)
                arg1
                (fp #b1 #b00000000 #b01001000110110111010000)))
(assert (fp.leq (fp #b1 #b00000000 #b01001000110110111010000)
                arg1
                (fp #b0 #b11010111 #b01001011101000100010010)))
