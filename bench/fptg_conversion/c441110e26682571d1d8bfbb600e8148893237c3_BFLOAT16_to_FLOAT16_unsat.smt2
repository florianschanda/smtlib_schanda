; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b0001100)
                arg1
                (fp #b0 #b11010001 #b0100000)))
(assert (fp.leq (fp #b0 #b11010001 #b0100000)
                arg1
                (fp #b0 #b11111010 #b1001100)))
; arg1 = 6044629098073145873530880.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
