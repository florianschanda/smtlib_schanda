; Format from: BFLOAT16
; Format to: FLOAT64
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001100 #b0010110)
                arg1
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg1
                (fp #b0 #b11011000 #b0001000)))
; arg1 = 256.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01010001000 #b1001011010000111010010000011010000010010100101011011)
                expect
                (fp #b0 #b10000000111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000010110 #b0100100110110101010111100010000010110110001110111001)))

(assert (= expect result))

(check-sat)
(exit)
