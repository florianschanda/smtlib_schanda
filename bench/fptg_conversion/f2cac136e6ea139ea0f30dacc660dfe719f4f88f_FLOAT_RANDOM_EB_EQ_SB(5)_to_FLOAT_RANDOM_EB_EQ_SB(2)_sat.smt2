(assert (fp.leq (fp #b1 #b000111110101001 #b01111111100000)
                expect
                (fp #b0 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b001010000110010 #b01000101100100)))

(assert (= expect result))

