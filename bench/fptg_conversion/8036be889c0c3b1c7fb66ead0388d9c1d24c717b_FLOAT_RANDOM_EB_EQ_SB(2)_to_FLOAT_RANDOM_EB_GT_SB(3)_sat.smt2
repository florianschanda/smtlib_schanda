(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111101100 #b01000010101)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b0 #b011001111100 #b11100001101)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result ((_ to_fp 16 4) rm arg1)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1000001011100011 #b000)
                expect
                (fp #b1 #b1000000000100000 #b100)))
(assert (fp.leq (fp #b1 #b1000000000100000 #b100)
                expect
                (fp #b0 #b0011111001101011 #b001)))

(assert (= expect result))

(check-sat)
(exit)
