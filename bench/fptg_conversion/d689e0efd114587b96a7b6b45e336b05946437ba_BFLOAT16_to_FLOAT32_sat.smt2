; Format from: BFLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b0101000)
                arg1
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                arg1
                (fp #b1 #b01010001 #b0011001)))
; arg1 = -1.3046875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000110 #b00001011000111101001110)
                expect
                (fp #b1 #b01111111 #b01001110000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b01001110000000000000000)
                expect
                (fp #b1 #b01100100 #b01111110110111010010001)))
; expect = -1.3046875

(assert (= expect result))

(check-sat)
(exit)
