; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b110 #b0)))
(assert (fp.leq (fp #b1 #b110 #b0)
                arg1
                (fp #b1 #b010 #b1)))
; arg1 = -8.0

(declare-const result (_ FloatingPoint 11 6))
(assert (= result ((_ to_fp 11 6) rm arg1)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11110110100 #b11111)
                expect
                (fp #b1 #b10000000010 #b00000)))
(assert (fp.leq (fp #b1 #b10000000010 #b00000)
                expect
                (fp #b0 #b00010100001 #b00011)))

(assert (= expect result))

(check-sat)
(exit)
