(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01101001000 #b1100001100)
                expect
                (fp #b0 #b10000000011 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000000011 #b0000000000)
                expect
                (fp #b0 #b11001001110 #b0011000111)))

(assert (= expect result))

(check-sat)
