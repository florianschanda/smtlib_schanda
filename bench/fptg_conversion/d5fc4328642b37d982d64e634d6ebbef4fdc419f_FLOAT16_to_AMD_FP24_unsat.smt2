; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000011)
                arg1
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg1
                (fp #b0 #b10001 #b1110111101)))
; arg1 = -0.0000152587890625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110100 #b0110111011010010)
                expect
                (fp #b1 #b0101111 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0101111 #b0000000000000000)
                expect
                (fp #b0 #b1101111 #b1111110011011010)))
; expect = -0.0000152587890625

(assert (not (= expect result)))

(check-sat)
(exit)
