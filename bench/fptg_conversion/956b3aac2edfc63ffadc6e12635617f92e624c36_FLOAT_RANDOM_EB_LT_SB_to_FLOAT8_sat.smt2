(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 5 13))
(assert (fp.leq (fp #b1 #b11010 #b001110101011)
                arg1
                (fp #b0 #b00101 #b111110011001)))
