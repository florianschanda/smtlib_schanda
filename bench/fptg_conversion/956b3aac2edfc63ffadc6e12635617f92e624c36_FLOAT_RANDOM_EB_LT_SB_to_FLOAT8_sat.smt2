(assert (fp.leq (fp #b1 #b110 #b1001)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b001 #b1110)))
; expect = 0.015625

(assert (= expect result))

