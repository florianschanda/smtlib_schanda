; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b0101)))
(assert (fp.leq (fp #b0 #b000 #b0101)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = 0.078125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100011 #b00101011011100000010101)
                expect
                (fp #b0 #b01111011 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111011 #b01000000000000000000000)
                expect
                (fp #b0 #b01111100 #b10011110111101000000101)))
; expect = 0.078125

(assert (not (= expect result)))

(check-sat)
(exit)
