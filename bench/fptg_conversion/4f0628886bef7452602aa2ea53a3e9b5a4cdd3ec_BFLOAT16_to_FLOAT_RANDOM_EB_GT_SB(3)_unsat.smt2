(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001100 #b1001111)
                arg1
                (fp #b1 #b10000011 #b1010000)))
(assert (fp.leq (fp #b1 #b10000011 #b1010000)
                arg1
                (fp #b1 #b01110101 #b1010001)))
; arg1 = -26.0

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
