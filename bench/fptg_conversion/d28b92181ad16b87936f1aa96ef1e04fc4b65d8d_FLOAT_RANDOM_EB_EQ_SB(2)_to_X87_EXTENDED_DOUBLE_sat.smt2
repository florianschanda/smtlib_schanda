                expect
                (fp #b1 #b100000000001000 #b011100001000000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000001000 #b011100001000000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b010010111001100 #b101010110100101001001001111011101011111111001001100010110011011)))

