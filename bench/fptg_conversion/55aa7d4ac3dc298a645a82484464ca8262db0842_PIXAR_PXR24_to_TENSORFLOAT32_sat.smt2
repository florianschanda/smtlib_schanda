(assert (fp.leq (fp #b1 #b11000110 #b1111110010)
                expect
                (fp #b1 #b10001110 #b1011000000)))
(assert (fp.leq (fp #b1 #b10001110 #b1011000000)
                expect
                (fp #b0 #b10110101 #b0010110000)))
; expect = -55296.0

(assert (= expect result))

(check-sat)
