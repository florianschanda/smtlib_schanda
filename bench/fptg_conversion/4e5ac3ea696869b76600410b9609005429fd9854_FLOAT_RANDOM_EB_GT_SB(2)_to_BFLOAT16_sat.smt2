(assert (fp.leq (fp #b1 #b01010110 #b0110101)
                expect
                (fp #b0 #b10000100 #b0011100)))
(assert (fp.leq (fp #b0 #b10000100 #b0011100)
                expect
                (fp #b0 #b11010000 #b1010011)))
; expect = 39.0

