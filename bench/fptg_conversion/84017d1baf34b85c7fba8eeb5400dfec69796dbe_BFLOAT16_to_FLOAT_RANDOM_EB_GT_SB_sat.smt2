(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000001 #b1001101)
                arg1
                (fp #b0 #b10000110 #b0101000)))
(assert (fp.leq (fp #b0 #b10000110 #b0101000)
                arg1
                (fp #b0 #b11010010 #b0101001)))
; arg1 = 168.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result ((_ to_fp 7 2) rm arg1)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1101001 #b0)
                expect
                (fp #b0 #b1000110 #b1)))
(assert (fp.leq (fp #b0 #b1000110 #b1)
                expect
                (fp #b0 #b1100100 #b1)))
; expect = 192.0

(assert (= expect result))

(check-sat)
(exit)
