; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111011 #b000)
                arg1
                (fp #b1 #b011111 #b000)))
(assert (fp.leq (fp #b1 #b011111 #b000)
                arg1
                (fp #b0 #b100000 #b011)))
; arg1 = -1.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0001110000)
                expect
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                expect
                (fp #b1 #b00000 #b1101100101)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
(exit)
