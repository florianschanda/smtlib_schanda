; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b1 #b000 #b1)))
(assert (fp.leq (fp #b1 #b000 #b1)
                arg1
                (fp #b0 #b000 #b1)))
; arg1 = -0.125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011000 #b0100010000)
                expect
                (fp #b1 #b01111100 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111100 #b0000000000)
                expect
                (fp #b0 #b10011000 #b1011111011)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
