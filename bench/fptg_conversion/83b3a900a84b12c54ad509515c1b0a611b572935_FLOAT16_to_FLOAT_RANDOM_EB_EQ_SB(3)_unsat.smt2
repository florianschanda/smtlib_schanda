; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000110010)
                arg1
                (fp #b1 #b10110 #b0101001111)))
(assert (fp.leq (fp #b1 #b10110 #b0101001111)
                arg1
                (fp #b1 #b00111 #b1100011010)))
; arg1 = -169.875

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1111101 #b110110)
                expect
                (fp #b1 #b1000110 #b010101)))
(assert (fp.leq (fp #b1 #b1000110 #b010101)
                expect
                (fp #b0 #b0011001 #b000010)))
; expect = -170.0

(assert (not (= expect result)))

(check-sat)
(exit)
