                expect
                (fp #b0 #b01111111 #b01111111100000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b01111111100000000000000)
                expect
                (fp #b0 #b11001101 #b00001101100000011100110)))
; expect = 1.498046875

(assert (not (= expect result)))

