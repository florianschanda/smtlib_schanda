(assert (fp.leq (fp #b1 #b0010100 #b1010010100000000)
                expect
                (fp #b0 #b1001101 #b0000001101000000)))
(assert (fp.leq (fp #b0 #b1001101 #b0000001101000000)
                expect
                (fp #b0 #b1010111 #b1011011011011010)))
; expect = 16592.0

(assert (= expect result))

