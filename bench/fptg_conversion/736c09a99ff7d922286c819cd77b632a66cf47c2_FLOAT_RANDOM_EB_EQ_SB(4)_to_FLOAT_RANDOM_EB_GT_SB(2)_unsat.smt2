; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101100110100 #b01100100010100)
                arg1
                (fp #b0 #b000000000000000 #b11111111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111111111111)
                arg1
                (fp #b0 #b101101110100010 #b01110001001110)))

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                expect
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                expect
                (fp #b0 #b011 #b1)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
