(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b0 #b011110101001111101 #b1100000)
                expect
                (fp #b0 #b011111111111111001 #b0000000)))
(assert (fp.leq (fp #b0 #b011111111111111001 #b0000000)
                expect
                (fp #b0 #b111101011010000111 #b1101100)))

(assert (= expect result))

(check-sat)
(exit)
