; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0111)
                arg1
                (fp #b1 #b110 #b0011)))
(assert (fp.leq (fp #b1 #b110 #b0011)
                arg1
                (fp #b1 #b101 #b0100)))
; arg1 = -9.5

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100001001 #b011110000)
                expect
                (fp #b1 #b1000000010 #b001100000)))
(assert (fp.leq (fp #b1 #b1000000010 #b001100000)
                expect
                (fp #b0 #b1011110100 #b110011111)))

(assert (= expect result))

(check-sat)
(exit)
