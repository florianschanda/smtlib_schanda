(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1001)
                arg1
                (fp #b1 #b10010 #b1111)))
(assert (fp.leq (fp #b1 #b10010 #b1111)
                arg1
                (fp #b0 #b10100 #b0100)))
; arg1 = -15.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b11110110101110101011001)
                expect
                (fp #b1 #b10000010 #b11110000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b11110000000000000000000)
                expect
                (fp #b0 #b10110000 #b10100111001000001100011)))
; expect = -15.5

(assert (= expect result))

(check-sat)
(exit)
