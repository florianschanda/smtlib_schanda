(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110010001 #b0010)
                arg1
                (fp #b1 #b0000000000 #b1100)))
(assert (fp.leq (fp #b1 #b0000000000 #b1100)
                arg1
                (fp #b0 #b0100101001 #b1010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00000 #b1100011111)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b01001 #b1001010001)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
