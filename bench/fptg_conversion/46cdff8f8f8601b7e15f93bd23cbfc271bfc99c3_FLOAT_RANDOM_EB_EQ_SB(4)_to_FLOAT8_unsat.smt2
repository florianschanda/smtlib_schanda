; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110000100000 #b11100110001)
                arg1
                (fp #b1 #b011111111111 #b11001010001)))
(assert (fp.leq (fp #b1 #b011111111111 #b11001010001)
                arg1
                (fp #b1 #b011000111111 #b11001111010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0101)
                expect
                (fp #b1 #b011 #b1101)))
(assert (fp.leq (fp #b1 #b011 #b1101)
                expect
                (fp #b1 #b000 #b0100)))
; expect = -1.8125

(assert (not (= expect result)))

(check-sat)
(exit)
