; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b0 #b0110 #b101)))
; arg1 = -1.625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101001011)
                expect
                (fp #b1 #b01111 #b1010000000)))
(assert (fp.leq (fp #b1 #b01111 #b1010000000)
                expect
                (fp #b0 #b11101 #b1000110010)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
