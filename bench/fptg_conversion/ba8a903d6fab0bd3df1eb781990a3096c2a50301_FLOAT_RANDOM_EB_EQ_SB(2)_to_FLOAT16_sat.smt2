; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100101 #b10011100)
                arg1
                (fp #b0 #b011111111 #b10011001)))
(assert (fp.leq (fp #b0 #b011111111 #b10011001)
                arg1
                (fp #b0 #b100000101 #b01111011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1011101001)
                expect
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                expect
                (fp #b0 #b11010 #b0001011101)))
; expect = 1.59765625

(assert (= expect result))

(check-sat)
(exit)
