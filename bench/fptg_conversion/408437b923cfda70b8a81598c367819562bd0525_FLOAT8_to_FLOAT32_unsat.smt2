(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1010)
                arg1
                (fp #b0 #b100 #b0010)))
(assert (fp.leq (fp #b0 #b100 #b0010)
                arg1
                (fp #b0 #b101 #b0001)))
; arg1 = 2.25

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011101 #b10001111011011111010110)
                expect
                (fp #b0 #b10000000 #b00100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b00100000000000000000000)
                expect
                (fp #b0 #b11010000 #b00111001111100110101010)))
; expect = 2.25

(assert (not (= expect result)))

(check-sat)
(exit)
