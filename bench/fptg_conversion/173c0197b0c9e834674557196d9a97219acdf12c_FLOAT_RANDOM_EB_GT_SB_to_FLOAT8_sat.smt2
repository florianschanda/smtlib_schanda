(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000100100 #b10111001)
                arg1
                (fp #b1 #b0000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b00000000)
                arg1
                (fp #b0 #b0011111101 #b01100111)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1101)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b001 #b0000)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
