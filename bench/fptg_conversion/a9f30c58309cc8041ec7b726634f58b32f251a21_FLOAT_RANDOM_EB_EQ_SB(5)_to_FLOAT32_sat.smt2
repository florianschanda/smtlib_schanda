(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b010 #b11)))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b1 #b010 #b01)))
; arg1 = -0.875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b11001110001011011010110)
                expect
                (fp #b1 #b01111110 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b11000000000000000000000)
                expect
                (fp #b0 #b00001001 #b01100001111110111100111)))
; expect = -0.875

(assert (= expect result))

(check-sat)
(exit)
