(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b0)
                arg1
                (fp #b0 #b01 #b1)))
(assert (fp.leq (fp #b0 #b01 #b1)
                arg1
                (fp #b0 #b11 #b0)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00110 #b1010)
                expect
                (fp #b0 #b01111 #b1000)))
(assert (fp.leq (fp #b0 #b01111 #b1000)
                expect
                (fp #b0 #b10101 #b1000)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
