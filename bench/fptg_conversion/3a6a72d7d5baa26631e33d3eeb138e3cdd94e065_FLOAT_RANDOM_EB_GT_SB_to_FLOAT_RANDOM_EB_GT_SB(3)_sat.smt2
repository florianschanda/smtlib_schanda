(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b000100010111 #b0000)
                expect
                (fp #b1 #b000000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000000 #b0001)
                expect
                (fp #b0 #b101001101001 #b1111)))

(assert (= expect result))

(check-sat)
