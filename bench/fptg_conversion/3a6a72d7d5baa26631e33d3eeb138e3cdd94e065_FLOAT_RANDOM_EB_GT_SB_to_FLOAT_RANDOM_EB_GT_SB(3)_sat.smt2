(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1001001000101011 #b001110)
                arg1
                (fp #b1 #b0100110001101000 #b000010)))
