(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110110011101100 #b000011001000010)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b0 #b1011011011000010 #b111100010100110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101001 #b1000011011)
                expect
                (fp #b1 #b01111111 #b1101000010)))
(assert (fp.leq (fp #b1 #b01111111 #b1101000010)
                expect
                (fp #b0 #b10110110 #b1010101101)))
; expect = -1.814453125

(assert (= expect result))

(check-sat)
(exit)
