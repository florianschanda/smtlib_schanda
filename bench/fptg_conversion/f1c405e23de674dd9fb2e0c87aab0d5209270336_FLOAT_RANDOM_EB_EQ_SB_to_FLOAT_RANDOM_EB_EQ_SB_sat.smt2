(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101011011 #b1001110001)
                arg1
                (fp #b1 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b01101000000 #b0110001110)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                expect
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                expect
                (fp #b0 #b110 #b11)))
; expect = -0.0625

(assert (= expect result))

(check-sat)
(exit)
