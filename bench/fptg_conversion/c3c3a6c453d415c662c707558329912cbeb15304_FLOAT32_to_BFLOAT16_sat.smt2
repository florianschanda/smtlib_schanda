(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00111101 #b11111010101100011110011)
                arg1
                (fp #b0 #b11100110 #b10100101110011100101010)))
(assert (fp.leq (fp #b0 #b11100110 #b10100101110011100101010)
                arg1
                (fp #b0 #b11111010 #b10011100111110110101100)))
; arg1 = 16709455940148665419944991653888.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101101 #b0001010)
                expect
                (fp #b0 #b11100110 #b1010011)))
(assert (fp.leq (fp #b0 #b11100110 #b1010011)
                expect
                (fp #b0 #b11110001 #b1110000)))
; expect = 16717142290509775232237773520896.0

(assert (= expect result))

(check-sat)
(exit)
