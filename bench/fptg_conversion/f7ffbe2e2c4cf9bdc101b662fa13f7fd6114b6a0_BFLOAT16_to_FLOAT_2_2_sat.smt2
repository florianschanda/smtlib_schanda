; Format from: BFLOAT16
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100110 #b1010110)
                arg1
                (fp #b0 #b01111111 #b0101011)))
(assert (fp.leq (fp #b0 #b01111111 #b0101011)
                arg1
                (fp #b0 #b10110110 #b0110100)))
; arg1 = 1.3359375

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b0 #b01 #b1)))
(assert (fp.leq (fp #b0 #b01 #b1)
                expect
                (fp #b0 #b11 #b0)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
