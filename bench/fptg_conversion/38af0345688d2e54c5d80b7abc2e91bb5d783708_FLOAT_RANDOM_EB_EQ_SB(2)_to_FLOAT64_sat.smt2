(assert (fp.leq (fp #b1 #b00001111000 #b0110110110100000001001011100011110110100111010010011)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01010011011 #b0011001011100100111010111011100111100111111010000100)))

(assert (= expect result))

