                expect
                (fp #b1 #b0000 #b000000000000000000001)))
(assert (fp.leq (fp #b1 #b0000 #b000000000000000000001)
                expect
                (fp #b0 #b0100 #b001011110101101001100)))
; expect = -0.000000007450580596923828125

(assert (not (= expect result)))

