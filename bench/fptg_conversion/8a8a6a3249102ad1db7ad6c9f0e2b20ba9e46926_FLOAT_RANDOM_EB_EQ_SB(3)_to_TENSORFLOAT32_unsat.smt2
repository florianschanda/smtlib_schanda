(assert (fp.leq (fp #b1 #b00011101 #b0111111111)
                expect
                (fp #b0 #b10000000 #b1010000000)))
(assert (fp.leq (fp #b0 #b10000000 #b1010000000)
                expect
                (fp #b0 #b10011110 #b1110000000)))
; expect = 3.25

(assert (not (= expect result)))

