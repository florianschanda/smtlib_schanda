; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b110 #b0)))
(assert (fp.leq (fp #b1 #b110 #b0)
                arg1
                (fp #b1 #b010 #b1)))
; arg1 = -8.0

(declare-const result (_ FloatingPoint 14 12))
(assert (= result ((_ to_fp 14 12) rm arg1)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11011010001000 #b01101111111)
                expect
                (fp #b1 #b10000000000010 #b00000000000)))
(assert (fp.leq (fp #b1 #b10000000000010 #b00000000000)
                expect
                (fp #b0 #b10100101001100 #b10010100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
