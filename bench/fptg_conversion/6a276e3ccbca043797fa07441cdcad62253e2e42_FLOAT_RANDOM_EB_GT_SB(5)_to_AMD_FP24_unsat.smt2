; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b001)
                arg1
                (fp #b1 #b11101 #b000)))
(assert (fp.leq (fp #b1 #b11101 #b000)
                arg1
                (fp #b0 #b11001 #b010)))
; arg1 = -16384.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011100 #b1101001001001110)
                expect
                (fp #b1 #b1001101 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1001101 #b0000000000000000)
                expect
                (fp #b0 #b0001111 #b0101010010011110)))
; expect = -16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
