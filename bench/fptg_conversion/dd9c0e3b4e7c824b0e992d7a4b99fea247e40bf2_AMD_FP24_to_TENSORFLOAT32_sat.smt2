(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b1100010011010000)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b0 #b1101101 #b1010010011101010)))
; arg1 = -1.417633056640625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000001 #b1000001100)
                expect
                (fp #b1 #b01111111 #b0110101100)))
(assert (fp.leq (fp #b1 #b01111111 #b0110101100)
                expect
                (fp #b1 #b01010110 #b0000000000)))
; expect = -1.41796875

(assert (= expect result))

(check-sat)
(exit)
