; Format from: FLOAT32
; Format to: FLOAT64
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b01010100101100011001000)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b10000110 #b00001010001111111111110)))
; arg1 = -16777216.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011100100 #b0110111111011111111100100110010001000001111000111111)
                expect
                (fp #b1 #b10000010111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01101111011 #b0101011011110110101011100110011010011100011101010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
