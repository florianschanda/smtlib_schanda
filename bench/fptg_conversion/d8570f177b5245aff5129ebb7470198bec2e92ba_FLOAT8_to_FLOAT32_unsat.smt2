(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1010)
                arg1
                (fp #b1 #b000 #b0100)))
(assert (fp.leq (fp #b1 #b000 #b0100)
                arg1
                (fp #b0 #b110 #b0000)))
; arg1 = -0.0625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001100 #b10100101111110101010101)
                expect
                (fp #b1 #b01111011 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111011 #b00000000000000000000000)
                expect
                (fp #b1 #b00000100 #b00111110011010010001000)))
; expect = -0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
