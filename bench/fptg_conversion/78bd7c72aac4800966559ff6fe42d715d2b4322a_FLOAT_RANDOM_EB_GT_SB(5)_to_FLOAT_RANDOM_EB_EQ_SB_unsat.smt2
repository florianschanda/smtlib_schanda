(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011101110 #b1111011)
                arg1
                (fp #b1 #b010000000 #b0000000)))
(assert (fp.leq (fp #b1 #b010000000 #b0000000)
                arg1
                (fp #b1 #b000010001 #b1011001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11001100111001 #b0100010110111)
                expect
                (fp #b1 #b01111110000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b01111110000000 #b0000000000000)
                expect
                (fp #b0 #b01001100010110 #b1001011111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
