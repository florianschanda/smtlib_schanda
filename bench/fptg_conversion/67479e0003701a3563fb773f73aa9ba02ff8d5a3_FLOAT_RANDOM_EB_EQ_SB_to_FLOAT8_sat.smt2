(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b101)
                arg1
                (fp #b0 #b0100 #b000)))
(assert (fp.leq (fp #b0 #b0100 #b000)
                arg1
                (fp #b0 #b0111 #b010)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                expect
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                expect
                (fp #b0 #b011 #b1101)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
