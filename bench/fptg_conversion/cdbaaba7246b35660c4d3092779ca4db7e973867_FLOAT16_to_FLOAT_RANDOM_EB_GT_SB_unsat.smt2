(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00011 #b1011101000)
                arg1
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                arg1
                (fp #b0 #b10110 #b1110111001)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0111 #b1)
                expect
                (fp #b0 #b0000 #b0)))
(assert (fp.leq (fp #b0 #b0000 #b0)
                expect
                (fp #b0 #b0101 #b0)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
