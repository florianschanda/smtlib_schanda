; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0010)
                arg1
                (fp #b0 #b010 #b1010)))
(assert (fp.leq (fp #b0 #b010 #b1010)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 0.8125

(declare-const result (_ FloatingPoint 11 9))
(assert (= result ((_ to_fp 11 9) rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10100100011 #b00001011)
                expect
                (fp #b0 #b01111111110 #b10100000)))
(assert (fp.leq (fp #b0 #b01111111110 #b10100000)
                expect
                (fp #b0 #b11111010111 #b11001111)))

(assert (= expect result))

(check-sat)
(exit)
