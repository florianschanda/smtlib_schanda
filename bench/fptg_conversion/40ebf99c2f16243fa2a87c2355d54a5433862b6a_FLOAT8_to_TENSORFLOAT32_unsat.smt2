(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1100)
                arg1
                (fp #b1 #b000 #b0110)))
(assert (fp.leq (fp #b1 #b000 #b0110)
                arg1
