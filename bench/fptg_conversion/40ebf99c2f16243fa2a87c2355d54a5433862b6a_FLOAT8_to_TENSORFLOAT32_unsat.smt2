(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010111 #b1011110101)
                expect
                (fp #b1 #b01111011 #b1000000000)))
(assert (fp.leq (fp #b1 #b01111011 #b1000000000)
                expect
                (fp #b0 #b10111100 #b1010101111)))
; expect = -0.09375

(assert (not (= expect result)))

