(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10001011 #b1110000001)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b11011101 #b0000010100)))
; arg1 = -0

(declare-const result (_ FloatingPoint 6 5))
(assert (= result ((_ to_fp 6 5) rm arg1)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110100 #b0010)
                expect
                (fp #b1 #b000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000 #b0000)
                expect
                (fp #b0 #b111101 #b0110)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
