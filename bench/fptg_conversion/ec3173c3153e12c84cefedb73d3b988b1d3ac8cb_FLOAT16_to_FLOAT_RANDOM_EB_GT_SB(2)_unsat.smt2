(declare-const expect (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b10010110 #b1110)
                expect
                (fp #b1 #b01101111 #b0111)))
(assert (fp.leq (fp #b1 #b01101111 #b0111)
                expect
                (fp #b1 #b01001000 #b0100)))
; expect = -0.00002193450927734375

(assert (not (= expect result)))

(check-sat)
