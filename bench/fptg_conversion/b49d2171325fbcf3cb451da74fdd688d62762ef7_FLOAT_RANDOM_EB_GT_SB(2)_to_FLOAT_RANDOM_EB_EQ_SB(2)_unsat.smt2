                expect
                (fp #b1 #b01111111111111 #b1000000000000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b1000000000000)
                expect
                (fp #b0 #b10001101101111 #b0100111011011)))

(assert (not (= expect result)))

