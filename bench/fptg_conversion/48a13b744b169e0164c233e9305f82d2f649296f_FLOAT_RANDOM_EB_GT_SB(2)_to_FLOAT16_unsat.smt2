; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11011 #b1)
                arg1
                (fp #b1 #b10110 #b1)))
(assert (fp.leq (fp #b1 #b10110 #b1)
                arg1
                (fp #b0 #b10000 #b0)))
; arg1 = -192.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1100110101)
                expect
                (fp #b1 #b10110 #b1000000000)))
(assert (fp.leq (fp #b1 #b10110 #b1000000000)
                expect
                (fp #b0 #b01111 #b1010100011)))
; expect = -192.0

(assert (not (= expect result)))

(check-sat)
(exit)
