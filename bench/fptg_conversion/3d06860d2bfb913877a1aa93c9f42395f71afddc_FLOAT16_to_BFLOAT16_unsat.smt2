                expect
                (fp #b0 #b01111111 #b1101111)))
(assert (fp.leq (fp #b0 #b01111111 #b1101111)
                expect
                (fp #b0 #b11010011 #b0100110)))
; expect = 1.8671875

(assert (not (= expect result)))

