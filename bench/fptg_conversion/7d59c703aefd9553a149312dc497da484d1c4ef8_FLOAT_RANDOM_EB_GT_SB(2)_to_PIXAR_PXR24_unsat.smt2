                expect
                (fp #b1 #b10000010 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b000000000000000)
                expect
                (fp #b1 #b01111011 #b111001101100101)))
; expect = -8.0

(assert (not (= expect result)))

