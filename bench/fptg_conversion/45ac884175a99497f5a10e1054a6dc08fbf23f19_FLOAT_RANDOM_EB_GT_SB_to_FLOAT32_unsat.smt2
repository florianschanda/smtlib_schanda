(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010011 #b11110111011111100101111)
                expect
                (fp #b1 #b10000011 #b10110000000000000000000)))
(assert (fp.leq (fp #b1 #b10000011 #b10110000000000000000000)
                expect
                (fp #b1 #b01000111 #b10100011000100111110000)))
; expect = -27.0

(assert (not (= expect result)))

(check-sat)
(exit)
