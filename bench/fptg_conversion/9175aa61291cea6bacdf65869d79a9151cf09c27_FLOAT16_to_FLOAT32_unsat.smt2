(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01100 #b0000111111)
                arg1
                (fp #b0 #b10101 #b1011010000)))
(assert (fp.leq (fp #b0 #b10101 #b1011010000)
                arg1
                (fp #b0 #b11110 #b1001110011)))
; arg1 = 109.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101010 #b01110101000001100011000)
                expect
                (fp #b0 #b10000101 #b10110100000000000000000)))
(assert (fp.leq (fp #b0 #b10000101 #b10110100000000000000000)
                expect
                (fp #b0 #b11100101 #b00101111100010000001001)))
; expect = 109.0

(assert (not (= expect result)))

(check-sat)
(exit)
