(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111110101 #b111)
                expect
                (fp #b1 #b0111011101 #b000)))
(assert (fp.leq (fp #b1 #b0111011101 #b000)
                expect
                (fp #b0 #b0001110110 #b000)))

(assert (= expect result))

(check-sat)
