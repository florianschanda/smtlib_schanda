(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001101010 #b0000001)
                arg1
                (fp #b1 #b0000000000 #b1101100)))
