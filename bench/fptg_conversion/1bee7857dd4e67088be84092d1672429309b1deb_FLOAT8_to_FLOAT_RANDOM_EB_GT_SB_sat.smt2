(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg1
                (fp #b1 #b011 #b0101)))
; arg1 = -3.875

(declare-const result (_ FloatingPoint 8 2))
(assert (= result ((_ to_fp 8 2) rm arg1)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10100000 #b1)
                expect
                (fp #b1 #b10000001 #b0)))
(assert (fp.leq (fp #b1 #b10000001 #b0)
                expect
                (fp #b1 #b10000000 #b1)))
; expect = -4.0

(assert (= expect result))

(check-sat)
(exit)
