; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100100011000 #b10101000)
                arg1
                (fp #b0 #b011111111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001001)
                arg1
                (fp #b0 #b110000100011 #b01110011)))

(declare-const result (_ FloatingPoint 8 7))
(assert (= result ((_ to_fp 8 7) rm arg1)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b00001110 #b110101)
                expect
                (fp #b0 #b01111111 #b110011)))
(assert (fp.leq (fp #b0 #b01111111 #b110011)
                expect
                (fp #b0 #b11000101 #b000011)))
; expect = 1.796875

(assert (= expect result))

(check-sat)
(exit)
