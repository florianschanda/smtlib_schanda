; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b0010101111)
                arg1
                (fp #b0 #b11011 #b0101101000)))
(assert (fp.leq (fp #b0 #b11011 #b0101101000)
                arg1
                (fp #b0 #b11011 #b1110111100)))
; arg1 = 5536.0

(declare-const result (_ FloatingPoint 7 2))
(assert (= result ((_ to_fp 7 2) rm arg1)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0111100 #b0)
                expect
                (fp #b0 #b1001011 #b1)))
(assert (fp.leq (fp #b0 #b1001011 #b1)
                expect
                (fp #b0 #b1111010 #b1)))
; expect = 6144.0

(assert (not (= expect result)))

(check-sat)
(exit)
