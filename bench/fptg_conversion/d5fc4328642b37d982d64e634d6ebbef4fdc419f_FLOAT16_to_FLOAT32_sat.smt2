(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000011)
                arg1
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg1
                (fp #b0 #b10001 #b1110111101)))
; arg1 = -0.0000152587890625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111101 #b00001010110111011010010)
                expect
                (fp #b1 #b01101111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01101111 #b00000000000000000000000)
                expect
                (fp #b0 #b11100101 #b10100011111101110111010)))
; expect = -0.0000152587890625

(assert (= expect result))

(check-sat)
(exit)
