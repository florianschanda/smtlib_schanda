(assert (fp.leq (fp #b1 #b1110111000101 #b1111101)
                expect
                (fp #b0 #b1000000111111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000111111 #b0000000)
                expect
                (fp #b0 #b1011111110011 #b1010111)))

(assert (not (= expect result)))

