; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110111 #b010111)
                arg1
                (fp #b1 #b0111111 #b110000)))
(assert (fp.leq (fp #b1 #b0111111 #b110000)
                arg1
                (fp #b1 #b0001010 #b101100)))
; arg1 = -1.75

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100000 #b00000100010111011110011)
                expect
                (fp #b1 #b01111111 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b11000000000000000000000)
                expect
                (fp #b0 #b11110101 #b00010110011111100011101)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
