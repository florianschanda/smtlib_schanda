; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001111110 #b000101101)
                arg1
                (fp #b0 #b1000000111 #b000000100)))
(assert (fp.leq (fp #b0 #b1000000111 #b000000100)
                arg1
                (fp #b0 #b1001101101 #b011010111)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101011 #b00001100010111101000101)
                expect
                (fp #b0 #b10000111 #b00000010000000000000000)))
(assert (fp.leq (fp #b0 #b10000111 #b00000010000000000000000)
                expect
                (fp #b0 #b11000101 #b11110001000001111111111)))
; expect = 258.0

(assert (= expect result))

(check-sat)
(exit)
