                expect
                (fp #b0 #b1000010 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b1000010 #b0100000000000000)
                expect
                (fp #b0 #b1001110 #b1111101110011011)))
; expect = 10.0

(assert (not (= expect result)))

(check-sat)
