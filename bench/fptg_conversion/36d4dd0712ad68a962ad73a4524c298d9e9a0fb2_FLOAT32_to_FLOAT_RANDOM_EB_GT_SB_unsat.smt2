(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11101110 #b11110001101001000110011)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111101 #b00010111000111101011110)))
; arg1 = -0

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0010 #b11)
                expect
                (fp #b1 #b0000 #b00)))
(assert (fp.leq (fp #b1 #b0000 #b00)
                expect
                (fp #b0 #b0110 #b00)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
