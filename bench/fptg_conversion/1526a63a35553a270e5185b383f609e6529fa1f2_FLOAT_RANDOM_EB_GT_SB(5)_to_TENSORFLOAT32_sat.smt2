(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11100 #b00)
                arg1
                (fp #b0 #b00000 #b00)))
(assert (fp.leq (fp #b0 #b00000 #b00)
                arg1
                (fp #b0 #b00010 #b11)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11101111 #b0111011000)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b00100110 #b1100000011)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
