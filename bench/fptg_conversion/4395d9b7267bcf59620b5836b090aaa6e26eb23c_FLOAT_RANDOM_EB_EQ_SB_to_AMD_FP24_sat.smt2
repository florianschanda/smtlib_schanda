(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: -LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b110 #b11)))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg1
                (fp #b0 #b101 #b10)))
; arg1 = -14.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b1111100100010011)
                expect
                (fp #b1 #b1000010 #b1100000000000000)))
(assert (fp.leq (fp #b1 #b1000010 #b1100000000000000)
                expect
                (fp #b0 #b1000000 #b1101110011011001)))
; expect = -14.0

(assert (= expect result))

(check-sat)
(exit)
