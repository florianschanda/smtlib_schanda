(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001001110 #b100011100)
                arg1
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                arg1
                (fp #b0 #b1100000010 #b010111101)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b01)
                expect
                (fp #b0 #b0111 #b00)))
(assert (fp.leq (fp #b0 #b0111 #b00)
                expect
                (fp #b0 #b1000 #b10)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
