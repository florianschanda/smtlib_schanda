(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100000 #b000)
                arg1
                (fp #b0 #b000000 #b101)))
(assert (fp.leq (fp #b0 #b000000 #b101)
                arg1
                (fp #b0 #b110000 #b111)))
; arg1 = 0.000000000582076609134674072265625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00111111 #b10111011000100010001011)
                expect
                (fp #b0 #b01100000 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b01100000 #b01000000000000000000000)
                expect
                (fp #b0 #b10001111 #b10011011011001111011001)))
; expect = 0.000000000582076609134674072265625

(assert (= expect result))

(check-sat)
(exit)
