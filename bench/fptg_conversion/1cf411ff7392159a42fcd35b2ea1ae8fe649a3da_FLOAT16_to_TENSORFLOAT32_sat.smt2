; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000001111)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11100 #b1000001010)))
; arg1 = 255.875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01111010 #b0100010111)
                expect
                (fp #b0 #b10000110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10000110 #b1111111111)
                expect
                (fp #b0 #b10110110 #b0100110111)))
; expect = 255.875

(assert (= expect result))

(check-sat)
(exit)
