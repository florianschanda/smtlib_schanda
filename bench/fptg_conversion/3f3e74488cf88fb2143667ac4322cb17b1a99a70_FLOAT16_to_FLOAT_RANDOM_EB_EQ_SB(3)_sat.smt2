; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1101000001)
                arg1
                (fp #b1 #b00000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000 #b1110100001)
                arg1
                (fp #b0 #b11101 #b0111110100)))
; arg1 = -0.000055372714996337890625

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011010111 #b1011000100)
                expect
                (fp #b1 #b01111110000 #b1101000010)))
(assert (fp.leq (fp #b1 #b01111110000 #b1101000010)
                expect
                (fp #b0 #b01000001100 #b0101011100)))

(assert (= expect result))

(check-sat)
(exit)
