(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b0000)
                arg1
                (fp #b1 #b10010 #b1010)))
(assert (fp.leq (fp #b1 #b10010 #b1010)
                arg1
                (fp #b0 #b10001 #b1001)))
; arg1 = -13.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1001100011)
                expect
                (fp #b1 #b10010 #b1010000000)))
(assert (fp.leq (fp #b1 #b10010 #b1010000000)
                expect
                (fp #b1 #b00011 #b1100110010)))
; expect = -13.0

(assert (= expect result))

(check-sat)
(exit)
