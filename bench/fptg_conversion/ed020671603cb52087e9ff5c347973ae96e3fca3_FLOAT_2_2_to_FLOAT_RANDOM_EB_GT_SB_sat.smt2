(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 0.5

(declare-const result (_ FloatingPoint 6 4))
(assert (= result ((_ to_fp 6 4) rm arg1)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b000000 #b110)
                expect
                (fp #b0 #b011110 #b000)))
(assert (fp.leq (fp #b0 #b011110 #b000)
                expect
                (fp #b0 #b101101 #b101)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
