(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010111111 #b1100101111)
                arg1
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                arg1
                (fp #b0 #b10001110000 #b0111000001)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1011)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b001 #b1000)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
