; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11001100111100 #b00)
                arg1
                (fp #b1 #b10000000000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000000000 #b10)
                arg1
                (fp #b0 #b00011110100101 #b11)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101001 #b101110111000001)
                expect
                (fp #b1 #b10000000 #b100000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b100000000000000)
                expect
                (fp #b0 #b10001110 #b100110110010101)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
