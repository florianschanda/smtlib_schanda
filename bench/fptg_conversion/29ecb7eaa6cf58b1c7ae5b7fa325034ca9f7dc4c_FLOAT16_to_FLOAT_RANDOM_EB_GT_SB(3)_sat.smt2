; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10000 #b1111111001)
                arg1
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                arg1
                (fp #b0 #b01101 #b0001111101)))
; arg1 = 0.000000059604644775390625

(declare-const result (_ FloatingPoint 7 2))
(assert (= result ((_ to_fp 7 2) rm arg1)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b0010100 #b1)
                expect
                (fp #b0 #b0100111 #b0)))
(assert (fp.leq (fp #b0 #b0100111 #b0)
                expect
                (fp #b0 #b1101000 #b0)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
