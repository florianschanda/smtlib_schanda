(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011110001 #b1)
                arg1
                (fp #b0 #b0000000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000000 #b0)
                arg1
                (fp #b0 #b1100011111 #b1)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result ((_ to_fp 10 7) rm arg1)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0011010110 #b110100)
                expect
                (fp #b0 #b0000000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000)
                expect
                (fp #b0 #b0010011111 #b001001)))

(assert (= expect result))

(check-sat)
(exit)
