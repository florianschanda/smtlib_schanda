; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101010 #b1001101011100111)
                arg1
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                arg1
                (fp #b0 #b1100101 #b1101110011111101)))
; arg1 = 76528.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100110 #b10111010011000011101010)
                expect
                (fp #b0 #b10001111 #b00101010111100000000000)))
(assert (fp.leq (fp #b0 #b10001111 #b00101010111100000000000)
                expect
                (fp #b0 #b11100100 #b10001101110101000000011)))
; expect = 76528.0

(assert (not (= expect result)))

(check-sat)
(exit)
