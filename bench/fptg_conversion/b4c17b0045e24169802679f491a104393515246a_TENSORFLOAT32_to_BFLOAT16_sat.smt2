(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b1010010)
                expect
                (fp #b0 #b01101101 #b1110100)))
(assert (fp.leq (fp #b0 #b01101101 #b1110100)
                expect
                (fp #b0 #b11011011 #b0110101)))
; expect = 0.00000727176666259765625

(assert (= expect result))

(check-sat)
