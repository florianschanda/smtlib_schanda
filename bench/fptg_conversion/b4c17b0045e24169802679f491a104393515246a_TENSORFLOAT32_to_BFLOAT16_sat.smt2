; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111000 #b0100111001)
                arg1
                (fp #b0 #b01101101 #b1110100000)))
(assert (fp.leq (fp #b0 #b01101101 #b1110100000)
                arg1
                (fp #b0 #b11001100 #b1110010001)))
