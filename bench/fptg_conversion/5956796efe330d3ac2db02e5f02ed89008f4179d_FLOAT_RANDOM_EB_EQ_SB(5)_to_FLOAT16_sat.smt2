(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111101101101101 #b11111110011001)
                arg1
                (fp #b1 #b100000000001101 #b10111010110111)))
(assert (fp.leq (fp #b1 #b100000000001101 #b10111010110111)
                arg1
                (fp #b0 #b110011001101110 #b10101111011011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1111100100)
                expect
                (fp #b1 #b11101 #b1011101100)))
(assert (fp.leq (fp #b1 #b11101 #b1011101100)
                expect
                (fp #b1 #b01100 #b0010000111)))
; expect = -28352.0

(assert (= expect result))

(check-sat)
