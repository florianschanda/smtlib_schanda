(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01011001110001011000100)
                arg1
                (fp #b1 #b10010110 #b11111101100111110110000)))
(assert (fp.leq (fp #b1 #b10010110 #b11111101100111110110000)
                arg1
                (fp #b1 #b10000010 #b11100101010111000100101)))
; arg1 = -16699312.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10100010 #b0101100001)
                expect
                (fp #b1 #b10010110 #b1111110111)))
(assert (fp.leq (fp #b1 #b10010110 #b1111110111)
                expect
                (fp #b1 #b01011111 #b1011111010)))
; expect = -16703488.0

(assert (not (= expect result)))

(check-sat)
(exit)
