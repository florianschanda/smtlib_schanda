; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                arg1
                (fp #b0 #b00000 #b010)))
(assert (fp.leq (fp #b0 #b00000 #b010)
                arg1
                (fp #b0 #b10100 #b000)))
; arg1 = 0.0000152587890625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1110010000)
                expect
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                expect
                (fp #b0 #b11010 #b1101010011)))
; expect = 0.0000152587890625

(assert (= expect result))

(check-sat)
(exit)
