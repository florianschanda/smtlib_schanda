; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1101000111)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b00010 #b0000111001)))
; arg1 = 0.000060558319091796875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011111 #b10000000011100010101000)
                expect
                (fp #b0 #b01110000 #b11111100000000000000000)))
(assert (fp.leq (fp #b0 #b01110000 #b11111100000000000000000)
                expect
                (fp #b0 #b11101101 #b11010100001010101101111)))
; expect = 0.000060558319091796875

(assert (not (= expect result)))

(check-sat)
(exit)
