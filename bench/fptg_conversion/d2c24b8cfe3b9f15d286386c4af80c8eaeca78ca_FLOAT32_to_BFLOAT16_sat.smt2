(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010110 #b01011111010100010111111)
                arg1
                (fp #b1 #b11000011 #b10100011111100011101000)))
(assert (fp.leq (fp #b1 #b11000011 #b10100011111100011101000)
                arg1
                (fp #b0 #b11110000 #b01111100010110000101001)))
; arg1 = -484163137115162411008.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011110 #b1100010)
                expect
                (fp #b1 #b11000011 #b1010010)))
(assert (fp.leq (fp #b1 #b11000011 #b1010010)
                expect
                (fp #b1 #b11000010 #b0110001)))
; expect = -484227031934875729920.0

(assert (= expect result))

(check-sat)
(exit)
