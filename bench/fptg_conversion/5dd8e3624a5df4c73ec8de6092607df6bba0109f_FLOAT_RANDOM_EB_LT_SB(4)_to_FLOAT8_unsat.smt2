; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 9))
(assert (fp.leq (fp #b1 #b01 #b11111110)
                arg1
                (fp #b1 #b00 #b10111100)))
(assert (fp.leq (fp #b1 #b00 #b10111100)
                arg1
                (fp #b1 #b00 #b01011100)))
; arg1 = -0.734375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0000)
                expect
                (fp #b1 #b010 #b1000)))
(assert (fp.leq (fp #b1 #b010 #b1000)
                expect
                (fp #b0 #b100 #b1110)))
; expect = -0.75

(assert (not (= expect result)))

(check-sat)
(exit)
