(assert (fp.leq (fp #b1 #b11011110 #b001010000100101)
                expect
                (fp #b1 #b10000101 #b011101000000000)))
(assert (fp.leq (fp #b1 #b10000101 #b011101000000000)
                expect
                (fp #b0 #b00111111 #b011101101100000)))
; expect = -93.0

(assert (= expect result))

