; Format from: PIXAR_PXR24
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11110011 #b011010001100000)
                arg1
                (fp #b1 #b11001001 #b001110100010000)))
(assert (fp.leq (fp #b1 #b11001001 #b001110100010000)
                arg1
                (fp #b0 #b11011001 #b011001111111001)))
; arg1 = -23178333928616051605504.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
