(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010101 #b1111110100)
                arg1
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                arg1
                (fp #b0 #b11110000 #b0000100001)))
; arg1 = -933.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010001 #b1000010)
                expect
                (fp #b1 #b10001000 #b1101010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101010)
                expect
                (fp #b0 #b10010010 #b1101010)))
; expect = -936.0

(assert (not (= expect result)))

(check-sat)
(exit)
