(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111011010001 #b000101)
                expect
                (fp #b1 #b011111011000 #b000000)))
(assert (fp.leq (fp #b1 #b011111011000 #b000000)
                expect
                (fp #b0 #b001101101111 #b101000)))

(assert (not (= expect result)))

(check-sat)
