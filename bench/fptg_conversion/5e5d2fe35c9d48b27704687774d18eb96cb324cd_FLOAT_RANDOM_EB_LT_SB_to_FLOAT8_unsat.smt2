; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 37))
(assert (fp.leq (fp #b1 #b0101011011000 #b110100101101100001000001010101010011)
                arg1
                (fp #b1 #b0000000000000 #b000101100010101000010010110010001101)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000101100010101000010010110010001101)
                arg1
                (fp #b0 #b0000000011111 #b110000010111010011010110100110011101)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1101)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b010 #b1011)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
