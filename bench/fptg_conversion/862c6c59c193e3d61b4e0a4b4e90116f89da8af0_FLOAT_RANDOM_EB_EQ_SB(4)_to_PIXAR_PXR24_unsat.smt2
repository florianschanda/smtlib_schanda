                expect
                (fp #b1 #b01111110 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b000000000000000)
                expect
                (fp #b0 #b10000000 #b110000011011110)))
; expect = -0.5

(assert (not (= expect result)))

