(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1001)
                arg1
                (fp #b1 #b101 #b0110)))
(assert (fp.leq (fp #b1 #b101 #b0110)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -5.5

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1101110 #b010111)
                expect
                (fp #b1 #b1000001 #b011000)))
(assert (fp.leq (fp #b1 #b1000001 #b011000)
                expect
                (fp #b0 #b0011111 #b100010)))
; expect = -5.5

(assert (not (= expect result)))

(check-sat)
(exit)
