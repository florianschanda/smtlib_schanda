; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010111001111110 #b010010010111011)
                arg1
                (fp #b1 #b0000000000000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010010100000101)
                arg1
                (fp #b0 #b1110101010010111 #b111000100000001)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result ((_ to_fp 11 4) rm arg1)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01100110000 #b010)
                expect
                (fp #b1 #b00000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000 #b001)
                expect
                (fp #b0 #b10000011110 #b011)))

(assert (= expect result))

(check-sat)
(exit)
