(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101000 #b1011111011111001)
                expect
                (fp #b0 #b1000110 #b1111111000000000)))
(assert (fp.leq (fp #b0 #b1000110 #b1111111000000000)
                expect
                (fp #b0 #b1101010 #b1001000010101100)))
; expect = 255.0

(assert (not (= expect result)))

