(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10000101 #b11101100101101000000110)
                arg1
                (fp #b0 #b11010011 #b00101010100100100100101)))
(assert (fp.leq (fp #b0 #b11010011 #b00101010100100100100101)
                arg1
                (fp #b0 #b11111100 #b10111011101100111010110)))
; arg1 = 22559420300669994798153728.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10011000 #b0001000)
                expect
                (fp #b0 #b11010011 #b0010110)))
(assert (fp.leq (fp #b0 #b11010011 #b0010110)
                expect
                (fp #b0 #b11100110 #b1110000)))
; expect = 22667359117774297025740800.0

(assert (not (= expect result)))

(check-sat)
(exit)
