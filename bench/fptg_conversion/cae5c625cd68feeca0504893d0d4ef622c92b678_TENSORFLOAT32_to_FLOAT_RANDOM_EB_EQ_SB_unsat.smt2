; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111101 #b0010010010)
                arg1
                (fp #b1 #b11111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b0000000000)
                arg1
                (fp #b0 #b00111010 #b1011001000)))
; arg1 = -85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101101100 #b110101000)
                expect
                (fp #b1 #b1001111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1001111101 #b000000000)
                expect
                (fp #b1 #b0011011100 #b101011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
