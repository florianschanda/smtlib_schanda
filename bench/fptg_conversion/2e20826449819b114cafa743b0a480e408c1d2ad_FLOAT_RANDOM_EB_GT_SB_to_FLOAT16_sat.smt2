; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100100011000 #b10101000)
                arg1
                (fp #b0 #b011111111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001001)
                arg1
                (fp #b0 #b110000100011 #b01110011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1101110000)
                expect
                (fp #b0 #b01111 #b1100100100)))
(assert (fp.leq (fp #b0 #b01111 #b1100100100)
                expect
                (fp #b0 #b10001 #b1001011010)))
; expect = 1.78515625

(assert (= expect result))

(check-sat)
(exit)
