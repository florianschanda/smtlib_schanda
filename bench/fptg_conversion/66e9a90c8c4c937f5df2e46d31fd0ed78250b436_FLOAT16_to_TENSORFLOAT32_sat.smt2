; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1100000111)
                arg1
                (fp #b0 #b01001 #b1111001110)))
(assert (fp.leq (fp #b0 #b01001 #b1111001110)
                arg1
                (fp #b0 #b10101 #b0001100011)))
; arg1 = 0.030487060546875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01010100 #b0011110010)
                expect
                (fp #b0 #b01111001 #b1111001110)))
(assert (fp.leq (fp #b0 #b01111001 #b1111001110)
                expect
                (fp #b0 #b11001101 #b1000110011)))
; expect = 0.030487060546875

(assert (= expect result))

(check-sat)
