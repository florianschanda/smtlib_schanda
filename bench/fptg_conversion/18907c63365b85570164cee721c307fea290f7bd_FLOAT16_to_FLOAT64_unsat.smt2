; Format from: FLOAT16
; Format to: FLOAT64
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1101000001)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b10101 #b1010100011)))
; arg1 = 1.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00111000110 #b0111110010010111111011000001101110111010000010110101)
                expect
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11010010110 #b1110001111110101100001000010111011000000001110010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
