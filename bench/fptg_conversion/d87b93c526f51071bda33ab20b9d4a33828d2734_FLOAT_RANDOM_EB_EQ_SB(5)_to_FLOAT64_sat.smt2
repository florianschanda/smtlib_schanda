(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000101011111100 #b110110000111000)
                arg1
                (fp #b1 #b0100000000000000 #b000000000000000)))
