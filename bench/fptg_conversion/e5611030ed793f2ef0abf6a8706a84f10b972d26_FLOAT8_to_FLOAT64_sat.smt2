; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0101)
                arg1
                (fp #b0 #b000 #b0100)))
(assert (fp.leq (fp #b0 #b000 #b0100)
                arg1
                (fp #b0 #b101 #b1100)))
; arg1 = 0.0625

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01110011100 #b0011110110001011110110000000001111101111110010100100)
                expect
                (fp #b0 #b01111111011 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111011 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11110000000 #b1100110011010101000010011110000101111000101100010000)))

(assert (= expect result))

(check-sat)
(exit)
