(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1101100111)
                arg1
                (fp #b0 #b10100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10100 #b0010001110)
                arg1
                (fp #b0 #b11100 #b1100100101)))
; arg1 = 36.4375

(declare-const result (_ FloatingPoint 15 6))
(assert (= result ((_ to_fp 15 6) rm arg1)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b010110000100000 #b11110)
                expect
                (fp #b0 #b100000000000100 #b00101)))
(assert (fp.leq (fp #b0 #b100000000000100 #b00101)
                expect
                (fp #b0 #b111000100110101 #b01101)))

(assert (not (= expect result)))

(check-sat)
(exit)
