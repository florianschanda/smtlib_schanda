(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111100 #b11)
                arg1
                (fp #b1 #b10000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000 #b10)
                arg1
                (fp #b1 #b00011011 #b10)))
; arg1 = -3.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b0101111010111111)
                expect
                (fp #b1 #b1000000 #b1000000000000000)))
(assert (fp.leq (fp #b1 #b1000000 #b1000000000000000)
                expect
                (fp #b1 #b0101000 #b1001011011111011)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
