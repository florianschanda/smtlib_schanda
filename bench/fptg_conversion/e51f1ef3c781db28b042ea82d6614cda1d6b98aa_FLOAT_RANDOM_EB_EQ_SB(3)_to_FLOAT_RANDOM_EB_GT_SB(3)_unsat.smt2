; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                arg1
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg1
                (fp #b0 #b101 #b11)))
; arg1 = -0.0625

(declare-const result (_ FloatingPoint 13 4))
(assert (= result ((_ to_fp 13 4) rm arg1)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1101101101011 #b001)
                expect
                (fp #b1 #b0111111111011 #b000)))
(assert (fp.leq (fp #b1 #b0111111111011 #b000)
                expect
                (fp #b0 #b1110001011111 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
