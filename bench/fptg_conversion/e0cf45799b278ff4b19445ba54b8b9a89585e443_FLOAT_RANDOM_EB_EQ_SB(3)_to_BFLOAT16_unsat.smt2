                arg1
                (fp #b0 #b1001 #b011)))
; arg1 = 1.625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101110 #b0011110)
                expect
                (fp #b0 #b01111111 #b1010000)))
(assert (fp.leq (fp #b0 #b01111111 #b1010000)
                expect
                (fp #b0 #b11101111 #b1000111)))
; expect = 1.625

(assert (not (= expect result)))

(check-sat)
