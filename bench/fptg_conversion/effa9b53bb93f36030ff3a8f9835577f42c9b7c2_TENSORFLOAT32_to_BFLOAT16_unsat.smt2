; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101101 #b1000001000)
                arg1
                (fp #b1 #b10001001 #b0000110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0000110001)
                arg1
                (fp #b1 #b01111010 #b1011101100)))
; arg1 = -1073.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b0001111)
                expect
                (fp #b1 #b10001001 #b0000111)))
(assert (fp.leq (fp #b1 #b10001001 #b0000111)
                expect
                (fp #b0 #b00101011 #b1010000)))
; expect = -1080.0

(assert (not (= expect result)))

(check-sat)
(exit)
