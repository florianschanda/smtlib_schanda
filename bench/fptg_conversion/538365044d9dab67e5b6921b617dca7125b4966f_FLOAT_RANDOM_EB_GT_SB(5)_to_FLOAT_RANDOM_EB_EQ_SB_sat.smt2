(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110001010000110 #b110011100010010)
                expect
                (fp #b1 #b1000000000000110 #b001110100000000)))
(assert (fp.leq (fp #b1 #b1000000000000110 #b001110100000000)
                expect
                (fp #b0 #b1111100001111011 #b101011001000111)))

(assert (= expect result))

(check-sat)
