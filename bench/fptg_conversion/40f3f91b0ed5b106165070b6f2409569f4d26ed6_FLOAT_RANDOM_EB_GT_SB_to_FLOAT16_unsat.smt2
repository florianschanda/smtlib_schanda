(assert (fp.leq (fp #b1 #b10011 #b0001100000)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10110 #b0110001011)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

