                expect
                (fp #b0 #b011111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b011111111101 #b00000000000)
                expect
                (fp #b0 #b101000101100 #b00100010111)))

(assert (not (= expect result)))

