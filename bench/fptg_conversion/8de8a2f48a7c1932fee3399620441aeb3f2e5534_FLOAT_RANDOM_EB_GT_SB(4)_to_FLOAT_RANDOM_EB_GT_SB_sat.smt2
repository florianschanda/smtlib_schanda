(assert (fp.leq (fp #b1 #b1101010 #b011)
                expect
                (fp #b1 #b0111111 #b010)))
(assert (fp.leq (fp #b1 #b0111111 #b010)
                expect
                (fp #b0 #b0010011 #b111)))
; expect = -1.25

