; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0110010 #b0000110110010000)
                arg1
                (fp #b0 #b1101001 #b0010001000011000)))
(assert (fp.leq (fp #b0 #b1101001 #b0010001000011000)
                arg1
                (fp #b0 #b1111100 #b0011101110001110)))
; arg1 = 4983772676096.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00001011 #b0001010101)
                expect
                (fp #b0 #b10101001 #b0010001001)))
(assert (fp.leq (fp #b0 #b10101001 #b0010001001)
                expect
                (fp #b0 #b11010111 #b1100010111)))
; expect = 4986457030656.0

(assert (= expect result))

(check-sat)
(exit)
