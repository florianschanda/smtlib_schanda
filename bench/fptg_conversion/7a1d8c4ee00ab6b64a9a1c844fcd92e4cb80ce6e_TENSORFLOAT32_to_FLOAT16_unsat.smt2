; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00110010 #b0010111011)
                arg1
                (fp #b0 #b10000000 #b1000110110)))
(assert (fp.leq (fp #b0 #b10000000 #b1000110110)
                arg1
                (fp #b0 #b11101000 #b1010010100)))
; arg1 = 3.10546875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b1111000010)
                expect
                (fp #b0 #b10000 #b1000110110)))
(assert (fp.leq (fp #b0 #b10000 #b1000110110)
                expect
                (fp #b0 #b10000 #b1101110101)))
; expect = 3.10546875

(assert (not (= expect result)))

(check-sat)
(exit)
