(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b11011000 #b01011000111000111001000)
                arg1
                (fp #b0 #b11110011 #b01001001100100010110011)))
(assert (fp.leq (fp #b0 #b11110011 #b01001001100100010110011)
                arg1
                (fp #b0 #b11111000 #b00000011010111010100111)))
; arg1 = 106950918570191514810027511577051136.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
