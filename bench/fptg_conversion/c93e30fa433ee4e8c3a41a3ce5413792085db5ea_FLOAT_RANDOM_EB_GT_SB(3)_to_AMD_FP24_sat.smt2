(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11100101110011111 #b10000)
                arg1
                (fp #b0 #b00000000000000001 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000001 #b00000)
                arg1
                (fp #b0 #b01111001011101011 #b11000)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101110 #b1001101101111110)
                expect
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b1001111 #b1110010011100011)))
; expect = 0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(assert (= expect result))

(check-sat)
(exit)
