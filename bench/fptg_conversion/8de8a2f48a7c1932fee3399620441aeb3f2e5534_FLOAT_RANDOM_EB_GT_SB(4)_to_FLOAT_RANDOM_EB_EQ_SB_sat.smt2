; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b1 #b11111001110110001 #b1111000100)
                arg1
                (fp #b1 #b01111111111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0011010000)
                arg1
                (fp #b0 #b10000011011101011 #b1010111100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100101000 #b110110011)
                expect
                (fp #b1 #b0111111111 #b001101000)))
(assert (fp.leq (fp #b1 #b0111111111 #b001101000)
                expect
                (fp #b0 #b1000001000 #b101011010)))

(assert (= expect result))

(check-sat)
(exit)
