(assert (fp.leq (fp #b1 #b10101 #b1011011001)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00111 #b0011000000)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

