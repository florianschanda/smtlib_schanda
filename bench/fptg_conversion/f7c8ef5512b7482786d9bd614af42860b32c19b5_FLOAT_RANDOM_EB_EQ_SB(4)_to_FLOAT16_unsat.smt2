(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000011100011 #b01101001101)
                arg1
                (fp #b1 #b000000000000 #b11011000100)))
