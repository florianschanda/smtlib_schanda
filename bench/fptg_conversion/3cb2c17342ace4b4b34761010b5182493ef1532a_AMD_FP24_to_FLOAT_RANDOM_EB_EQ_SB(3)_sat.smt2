; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100101 #b0010001000110000)
                arg1
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                arg1
                (fp #b0 #b1100100 #b1001110001000111)))
; arg1 = 1.1314697265625

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000111101100100 #b101001010101000)
                expect
                (fp #b0 #b0111111111111111 #b001000011010100)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b001000011010100)
                expect
                (fp #b0 #b1110111010111101 #b010000110110101)))

(assert (= expect result))

(check-sat)
(exit)
