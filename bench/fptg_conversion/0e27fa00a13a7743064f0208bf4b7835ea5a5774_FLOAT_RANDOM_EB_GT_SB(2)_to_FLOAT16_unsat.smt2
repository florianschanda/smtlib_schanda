; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10100100 #b111011)
                arg1
                (fp #b1 #b10000101 #b011101)))
(assert (fp.leq (fp #b1 #b10000101 #b011101)
                arg1
                (fp #b0 #b01001110 #b000011)))
; arg1 = -93.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0100111110)
                expect
                (fp #b1 #b10101 #b0111010000)))
(assert (fp.leq (fp #b1 #b10101 #b0111010000)
                expect
                (fp #b1 #b01000 #b1011100100)))
; expect = -93.0

(assert (not (= expect result)))

(check-sat)
(exit)
