; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011011111001 #b110)
                arg1
                (fp #b0 #b011111111111 #b101)))
(assert (fp.leq (fp #b0 #b011111111111 #b101)
                arg1
                (fp #b0 #b110101100101 #b001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100000 #b1001110)
                expect
                (fp #b0 #b01111111 #b1010000)))
(assert (fp.leq (fp #b0 #b01111111 #b1010000)
                expect
                (fp #b0 #b11000011 #b1101110)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
