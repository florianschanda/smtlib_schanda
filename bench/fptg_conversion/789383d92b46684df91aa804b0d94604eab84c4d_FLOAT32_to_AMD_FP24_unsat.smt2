; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00001110 #b11010001001001100011010)
                arg1
                (fp #b0 #b01111111 #b00011111001010101011110)))
(assert (fp.leq (fp #b0 #b01111111 #b00011111001010101011110)
                arg1
                (fp #b0 #b10011001 #b11000000011111111101110)))
; arg1 = 1.1217458248138427734375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010101 #b0110111110010100)
                expect
                (fp #b0 #b0111111 #b0001111100101011)))
(assert (fp.leq (fp #b0 #b0111111 #b0001111100101011)
                expect
                (fp #b0 #b1100101 #b1100110000011001)))
; expect = 1.1217498779296875

(assert (not (= expect result)))

(check-sat)
(exit)
