; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0011)
                arg1
                (fp #b0 #b101 #b1001)))
(assert (fp.leq (fp #b0 #b101 #b1001)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 6.25

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001011 #b1011000110000111)
                expect
                (fp #b0 #b1000001 #b1001000000000000)))
(assert (fp.leq (fp #b0 #b1000001 #b1001000000000000)
                expect
                (fp #b0 #b1010000 #b0001000011011100)))
; expect = 6.25

(assert (= expect result))

(check-sat)
(exit)
