(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10001101 #b01110010000111101010111)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10100001 #b11010101001111011001010)))
; arg1 = 16777216.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100110 #b1011000000)
                expect
                (fp #b0 #b10010111 #b0000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b0000000000)
                expect
                (fp #b0 #b10011001 #b1111111010)))
; expect = 16777216.0

(assert (= expect result))

(check-sat)
(exit)
