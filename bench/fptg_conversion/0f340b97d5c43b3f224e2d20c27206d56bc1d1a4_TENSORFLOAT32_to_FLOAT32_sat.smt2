                expect
                (fp #b1 #b01111111 #b11111101000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b11111101000000000000000)
                expect
                (fp #b1 #b00101001 #b11000010111010100100111)))
; expect = -1.98828125

(assert (= expect result))

(check-sat)
