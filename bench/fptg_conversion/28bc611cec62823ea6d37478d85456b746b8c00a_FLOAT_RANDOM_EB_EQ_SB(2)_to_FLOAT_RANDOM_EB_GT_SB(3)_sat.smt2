; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00100101110 #b0010001000)
                arg1
                (fp #b0 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000)
                arg1
                (fp #b0 #b11111111110 #b0111001101)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result ((_ to_fp 12 4) rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b001101010101 #b111)
                expect
                (fp #b0 #b101111111101 #b000)))
(assert (fp.leq (fp #b0 #b101111111101 #b000)
                expect
                (fp #b0 #b110011110000 #b101)))

(assert (= expect result))

(check-sat)
(exit)
