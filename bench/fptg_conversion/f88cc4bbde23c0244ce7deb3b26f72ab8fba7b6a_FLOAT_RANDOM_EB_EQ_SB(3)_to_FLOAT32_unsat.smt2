(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b101)
                arg1
                (fp #b1 #b1010 #b001)))
(assert (fp.leq (fp #b1 #b1010 #b001)
                arg1
                (fp #b0 #b0110 #b000)))
; arg1 = -9.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001011 #b10011111011100010010010)
                expect
                (fp #b1 #b10000010 #b00100000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b00100000000000000000000)
                expect
                (fp #b1 #b00010110 #b11010010010000100100011)))
; expect = -9.0

(assert (not (= expect result)))

(check-sat)
(exit)
