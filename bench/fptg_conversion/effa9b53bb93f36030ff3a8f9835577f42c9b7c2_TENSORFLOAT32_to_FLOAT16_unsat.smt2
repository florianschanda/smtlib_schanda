; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101101 #b1000001000)
                arg1
                (fp #b1 #b10001001 #b0000110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0000110001)
                arg1
                (fp #b1 #b01111010 #b1011101100)))
; arg1 = -1073.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0100111000)
                expect
                (fp #b1 #b11001 #b0000110001)))
(assert (fp.leq (fp #b1 #b11001 #b0000110001)
                expect
                (fp #b1 #b00011 #b0001111001)))
; expect = -1073.0

(assert (not (= expect result)))

(check-sat)
(exit)
