(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101001110 #b00101001100)
                arg1
                (fp #b0 #b100000001000 #b11000100100)))
(assert (fp.leq (fp #b0 #b100000001000 #b11000100100)
                arg1
                (fp #b0 #b111010101110 #b00010011101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010000 #b1101111)
                expect
                (fp #b0 #b10001000 #b1100011)))
(assert (fp.leq (fp #b0 #b10001000 #b1100011)
                expect
                (fp #b0 #b10010000 #b1010010)))
; expect = 908.0

(assert (= expect result))

(check-sat)
(exit)
