; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01010011 #b00111111100101111111000)
                arg1
                (fp #b0 #b01111111 #b10111000111111110010110)))
(assert (fp.leq (fp #b0 #b01111111 #b10111000111111110010110)
                arg1
                (fp #b0 #b10111001 #b10011110100100100100100)))
; arg1 = 1.7226436138153076171875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b1101)
                expect
                (fp #b0 #b01111 #b1100)))
(assert (fp.leq (fp #b0 #b01111 #b1100)
                expect
                (fp #b0 #b11011 #b0100)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
