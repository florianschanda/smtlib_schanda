                expect
                (fp #b0 #b01100100 #b0110100)))
(assert (fp.leq (fp #b0 #b01100100 #b0110100)
                expect
                (fp #b0 #b10100100 #b0000011)))
; expect = 0.00000001047737896442413330078125

