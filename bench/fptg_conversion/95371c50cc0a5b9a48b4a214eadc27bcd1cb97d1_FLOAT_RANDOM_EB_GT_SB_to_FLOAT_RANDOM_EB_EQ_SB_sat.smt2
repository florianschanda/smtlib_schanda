(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b0)
                arg1
                (fp #b1 #b101 #b1)))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b0 #b101 #b0)))
; arg1 = -6.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b0111)
                expect
                (fp #b1 #b10001 #b1000)))
(assert (fp.leq (fp #b1 #b10001 #b1000)
                expect
                (fp #b0 #b00111 #b0101)))
; expect = -6.0

(assert (= expect result))

(check-sat)
(exit)
