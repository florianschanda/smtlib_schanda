(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0110011011)
                arg1
                (fp #b1 #b11001 #b0110110001)))
(assert (fp.leq (fp #b1 #b11001 #b0110110001)
                arg1
                (fp #b0 #b11010 #b0100111011)))
; arg1 = -1457.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011101 #b0010111000)
                expect
                (fp #b1 #b10001001 #b0110110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0110110001)
                expect
                (fp #b0 #b10100110 #b0010110001)))
; expect = -1457.0

(assert (= expect result))

(check-sat)
(exit)
