; Format from: FLOAT64
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101011100 #b1111011100011101100111000001100011001000110111001010)
                arg1
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01011010110 #b0111010000111101010000110101000001011000000010010100)))

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b1)
                expect
                (fp #b1 #b0000 #b1)))
(assert (fp.leq (fp #b1 #b0000 #b1)
                expect
                (fp #b0 #b1100 #b1)))
; expect = -0.0078125

(assert (= expect result))

(check-sat)
(exit)
