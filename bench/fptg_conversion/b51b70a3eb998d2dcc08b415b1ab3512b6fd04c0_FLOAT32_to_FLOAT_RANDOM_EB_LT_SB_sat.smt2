(assert (fp.leq (fp #b1 #b01011011 #b00101111011100110001111)
                arg1
                (fp #b0 #b01100100 #b10101011010010001101101)))
(assert (fp.leq (fp #b0 #b01100100 #b10101011010010001101101)
                arg1
                (fp #b0 #b11001000 #b10010101000100001011110)))
; arg1 = 0.00000001243561786878899511066265404224395751953125

(declare-const result (_ FloatingPoint 10 20))
(assert (= result ((_ to_fp 10 20) rm arg1)))

(declare-const expect (_ FloatingPoint 10 20))
(assert (fp.leq (fp #b0 #b0000001001 #b1001011011110110001)
                expect
                (fp #b0 #b0111100100 #b1010101101001000111)))
(assert (fp.leq (fp #b0 #b0111100100 #b1010101101001000111)
                expect
                (fp #b0 #b1011101111 #b0100010100001111000)))

(assert (= expect result))

(check-sat)
(exit)
