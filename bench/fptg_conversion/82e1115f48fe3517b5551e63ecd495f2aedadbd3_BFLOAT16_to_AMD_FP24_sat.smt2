; Format from: BFLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01001010 #b1101011)
                arg1
                (fp #b0 #b00000000 #b1011100)))
(assert (fp.leq (fp #b0 #b00000000 #b1011100)
                arg1
                (fp #b0 #b01010010 #b1111011)))
; arg1 = 0.00000000000000000000000000000000000000844886564653519146352529386128489080932165868929937906084415288887612405233085155487060546875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010011 #b1101001010101100)
                expect
                (fp #b0 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b0000010 #b1000000111100100)))
; expect = 0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(assert (= expect result))

(check-sat)
(exit)
