(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b110 #b01)))
(assert (fp.leq (fp #b0 #b110 #b01)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 10.0

(declare-const result (_ FloatingPoint 16 12))
(assert (= result ((_ to_fp 16 12) rm arg1)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0011001011101000 #b10011011000)
                expect
                (fp #b0 #b1000000000000010 #b01000000000)))
(assert (fp.leq (fp #b0 #b1000000000000010 #b01000000000)
                expect
                (fp #b0 #b1001101010011000 #b00110011011)))

(assert (= expect result))

(check-sat)
(exit)
