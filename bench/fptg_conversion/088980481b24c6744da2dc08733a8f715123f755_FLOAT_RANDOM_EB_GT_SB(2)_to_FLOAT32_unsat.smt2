(assert (fp.leq (fp #b0 #b00010001 #b00011110100010000100100)
                expect
                (fp #b0 #b10000011 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000011 #b00000000000000000000000)
                expect
                (fp #b0 #b11111011 #b01001111111010000110001)))
; expect = 16.0

(assert (not (= expect result)))

(check-sat)
