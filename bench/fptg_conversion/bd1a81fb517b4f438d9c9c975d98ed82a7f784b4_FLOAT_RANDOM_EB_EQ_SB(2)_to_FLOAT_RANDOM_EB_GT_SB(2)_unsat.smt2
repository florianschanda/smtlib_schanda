; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1110111 #b010111)
                arg1
                (fp #b1 #b0111111 #b110000)))
(assert (fp.leq (fp #b1 #b0111111 #b110000)
                arg1
                (fp #b1 #b0001010 #b101100)))
; arg1 = -1.75

(declare-const result (_ FloatingPoint 10 2))
(assert (= result ((_ to_fp 10 2) rm arg1)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1000100100 #b1)
                expect
                (fp #b1 #b1000000000 #b0)))
(assert (fp.leq (fp #b1 #b1000000000 #b0)
                expect
                (fp #b1 #b0010101001 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
