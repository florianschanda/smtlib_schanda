(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b0110 #b1)
                arg1
                (fp #b0 #b0111 #b1)))
(assert (fp.leq (fp #b0 #b0111 #b1)
                arg1
                (fp #b0 #b1101 #b0)))
; arg1 = 1.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101111 #b00000110011110100011100)
                expect
                (fp #b0 #b01111111 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10000000000000000000000)
                expect
                (fp #b0 #b11000001 #b11010111000100110010010)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
