(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1011 #b100)
                arg1
                (fp #b0 #b0111 #b101)))
(assert (fp.leq (fp #b0 #b0111 #b101)
                arg1
                (fp #b0 #b1001 #b011)))
; arg1 = 1.625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011110 #b10011101010101100101011)
                expect
                (fp #b0 #b01111111 #b10100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10100000000000000000000)
                expect
                (fp #b0 #b10000111 #b10001001111110111111101)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
