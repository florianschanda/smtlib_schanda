; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101100010011 #b10000010)
                arg1
                (fp #b1 #b000000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b000000000000 #b00010010)
                arg1
                (fp #b0 #b000110111111 #b00011011)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b11 #b0)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
