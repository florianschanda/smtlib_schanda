(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111101 #b10011000)
                arg1
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg1
                (fp #b0 #b100111100 #b10000000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1111010010)
                expect
                (fp #b0 #b11000 #b0000000000)))
(assert (fp.leq (fp #b0 #b11000 #b0000000000)
                expect
                (fp #b0 #b11101 #b0100111011)))
; expect = 512.0

(assert (= expect result))

(check-sat)
(exit)
