(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11000010110001010 #b1)
                arg1
                (fp #b0 #b00000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0)
                arg1
                (fp #b0 #b00101111100100001 #b0)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11011011011101 #b0111000001111)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b10000010111111 #b1101110100110)))

(assert (= expect result))

(check-sat)
(exit)
