; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011101110 #b0000100)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b1101110010 #b1001110)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b0110100000)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01010 #b0101111001)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
