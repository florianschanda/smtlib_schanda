; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0011100101001010)
                arg1
                (fp #b1 #b1001110 #b1001100011111110)))
(assert (fp.leq (fp #b1 #b1001110 #b1001100011111110)
                arg1
                (fp #b0 #b0010010 #b1010111011100101)))
; arg1 = -52351.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011010 #b10100000010001000111110)
                expect
                (fp #b1 #b10001110 #b10011000111111100000000)))
(assert (fp.leq (fp #b1 #b10001110 #b10011000111111100000000)
                expect
                (fp #b1 #b01111110 #b10010001110001010110000)))
; expect = -52351.0

(assert (not (= expect result)))

(check-sat)
(exit)
