(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b100)
                arg1
                (fp #b0 #b1000 #b101)))
(assert (fp.leq (fp #b0 #b1000 #b101)
                arg1
                (fp #b0 #b1110 #b000)))
; arg1 = 3.25

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00011001 #b0111001)
                expect
                (fp #b0 #b10000000 #b1010000)))
(assert (fp.leq (fp #b0 #b10000000 #b1010000)
                expect
                (fp #b0 #b11110100 #b0100000)))
; expect = 3.25

(assert (= expect result))

(check-sat)
(exit)
