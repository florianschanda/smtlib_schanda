                expect
                (fp #b0 #b01111111111111110 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111111110 #b0000000000000000)
                expect
                (fp #b0 #b11100101100101010 #b1110110100101001)))

(assert (= expect result))

