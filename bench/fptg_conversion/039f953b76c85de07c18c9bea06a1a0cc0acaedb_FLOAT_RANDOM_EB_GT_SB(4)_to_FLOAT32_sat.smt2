; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000000 #b0100)
                arg1
                (fp #b0 #b001101 #b1101)))
(assert (fp.leq (fp #b0 #b001101 #b1101)
                arg1
                (fp #b0 #b111100 #b1011)))
; arg1 = 0.0000069141387939453125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000011 #b00001010101011010111101)
                expect
                (fp #b0 #b01101101 #b11010000000000000000000)))
(assert (fp.leq (fp #b0 #b01101101 #b11010000000000000000000)
                expect
                (fp #b0 #b01110100 #b00001000101000011000110)))
; expect = 0.0000069141387939453125

(assert (= expect result))

(check-sat)
(exit)
