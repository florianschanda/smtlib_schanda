(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011110001 #b1)
                arg1
                (fp #b0 #b0000000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000000 #b0)
                arg1
                (fp #b0 #b1100011111 #b1)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result ((_ to_fp 16 15) rm arg1)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1111111101111110 #b00100100101001)
                expect
                (fp #b0 #b0000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000000000)
                expect
                (fp #b0 #b1010001110111111 #b10100101001001)))

(assert (= expect result))

(check-sat)
(exit)
