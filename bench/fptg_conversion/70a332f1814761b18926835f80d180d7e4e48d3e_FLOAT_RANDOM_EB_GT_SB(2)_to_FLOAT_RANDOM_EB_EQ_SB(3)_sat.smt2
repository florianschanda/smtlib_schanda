(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b111101 #b111)
                arg1
                (fp #b1 #b111101 #b000)))
(assert (fp.leq (fp #b1 #b111101 #b000)
                arg1
                (fp #b0 #b101111 #b111)))
; arg1 = -1073741824.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001110100111010 #b110111100100101)
                expect
                (fp #b1 #b1000000000011101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000011101 #b000000000000000)
                expect
                (fp #b0 #b1000000101001010 #b100011100010100)))

(assert (= expect result))

(check-sat)
(exit)
