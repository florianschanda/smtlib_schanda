(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110000 #b10001101110010110100110)
                expect
                (fp #b1 #b10000011 #b10100000000000000000000)))
(assert (fp.leq (fp #b1 #b10000011 #b10100000000000000000000)
                expect
                (fp #b1 #b00011110 #b10101101001000111010001)))
; expect = -26.0

(assert (not (= expect result)))

(check-sat)
