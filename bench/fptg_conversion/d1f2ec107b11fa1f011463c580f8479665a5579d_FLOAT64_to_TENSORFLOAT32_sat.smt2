; Format from: FLOAT64
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100001001 #b0111101100011001011111010011011011001100001000100011)
                arg1
                (fp #b1 #b10000101111 #b1110011010110000010001010100101101101100100010010000)))
(assert (fp.leq (fp #b1 #b10000101111 #b1110011010110000010001010100101101101100100010010000)
                arg1
                (fp #b0 #b11000110000 #b0101101110010101110001111110110001100111111011101101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000111 #b0111111000)
                expect
                (fp #b1 #b10101111 #b1110011011)))
(assert (fp.leq (fp #b1 #b10101111 #b1110011011)
                expect
                (fp #b0 #b11100111 #b1101100111)))
; expect = -535187284819968.0

(assert (= expect result))

(check-sat)
(exit)
