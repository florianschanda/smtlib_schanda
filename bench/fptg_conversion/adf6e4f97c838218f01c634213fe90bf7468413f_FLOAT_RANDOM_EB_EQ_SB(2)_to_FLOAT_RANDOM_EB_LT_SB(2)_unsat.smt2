; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1010 #b010)
                arg1
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                arg1
                (fp #b0 #b1000 #b001)))
; arg1 = -0

(declare-const result (_ FloatingPoint 15 42))
(assert (= result ((_ to_fp 15 42) rm arg1)))

(declare-const expect (_ FloatingPoint 15 42))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110101110100011 #b10010101011111000001010010011100110100111)
                expect
                (fp #b1 #b000000000000000 #b00000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000000000000000000000000000000)
                expect
                (fp #b0 #b101000101011100 #b10011110010100101001000100100010010101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
