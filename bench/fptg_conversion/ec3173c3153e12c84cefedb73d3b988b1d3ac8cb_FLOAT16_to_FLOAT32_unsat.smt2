(assert (fp.leq (fp #b1 #b11011111 #b00110111011011101010110)
                expect
                (fp #b1 #b01101111 #b01100101000000000000000)))
(assert (fp.leq (fp #b1 #b01101111 #b01100101000000000000000)
                expect
                (fp #b0 #b10101011 #b01100011101111000110101)))
; expect = -0.000021278858184814453125

(assert (not (= expect result)))

