(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100101011 #b00111000001)
                arg1
                (fp #b0 #b100000001000 #b10111110100)))
(assert (fp.leq (fp #b0 #b100000001000 #b10111110100)
                arg1
                (fp #b0 #b101001011000 #b01000110101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101101 #b1010010)
                expect
                (fp #b0 #b10001000 #b1100000)))
(assert (fp.leq (fp #b0 #b10001000 #b1100000)
                expect
                (fp #b0 #b10101011 #b1000011)))
; expect = 896.0

(assert (= expect result))

(check-sat)
(exit)
