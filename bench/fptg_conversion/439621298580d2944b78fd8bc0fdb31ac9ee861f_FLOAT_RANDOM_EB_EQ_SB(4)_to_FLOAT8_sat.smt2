(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b011 #b10)
                arg1
                (fp #b0 #b101 #b00)))
(assert (fp.leq (fp #b0 #b101 #b00)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0011)
                expect
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                expect
                (fp #b0 #b101 #b1000)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
