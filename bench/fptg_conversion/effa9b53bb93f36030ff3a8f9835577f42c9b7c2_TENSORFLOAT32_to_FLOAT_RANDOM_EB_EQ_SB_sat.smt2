(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101101 #b1000001000)
                arg1
                (fp #b1 #b10001001 #b0000110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0000110001)
                arg1
                (fp #b1 #b01111010 #b1011101100)))
; arg1 = -1073.0

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100101101 #b10001010)
                expect
                (fp #b1 #b100001001 #b00001101)))
(assert (fp.leq (fp #b1 #b100001001 #b00001101)
                expect
                (fp #b0 #b000011011 #b01001110)))

(assert (= expect result))

(check-sat)
(exit)
