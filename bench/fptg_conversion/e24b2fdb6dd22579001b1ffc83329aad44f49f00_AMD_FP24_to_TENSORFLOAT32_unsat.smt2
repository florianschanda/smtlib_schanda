(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100000 #b1111011100011011)
                arg1
                (fp #b0 #b1001110 #b1101101110011110)))
(assert (fp.leq (fp #b0 #b1001110 #b1101101110011110)
                arg1
                (fp #b0 #b1101000 #b1111110101000011)))
; arg1 = 60879.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010001 #b0011011011)
                expect
                (fp #b0 #b10001110 #b1101101111)))
(assert (fp.leq (fp #b0 #b10001110 #b1101101111)
                expect
                (fp #b0 #b10111001 #b1000110010)))
; expect = 60896.0

(assert (not (= expect result)))

(check-sat)
(exit)
