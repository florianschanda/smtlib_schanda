(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b10)
                arg1
                (fp #b1 #b000 #b11)))
(assert (fp.leq (fp #b1 #b000 #b11)
                arg1
                (fp #b0 #b000 #b00)))
; arg1 = -0.1875

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001011000 #b001100000)
                expect
                (fp #b1 #b0111111100 #b100000000)))
(assert (fp.leq (fp #b1 #b0111111100 #b100000000)
                expect
                (fp #b1 #b0001111111 #b010101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
