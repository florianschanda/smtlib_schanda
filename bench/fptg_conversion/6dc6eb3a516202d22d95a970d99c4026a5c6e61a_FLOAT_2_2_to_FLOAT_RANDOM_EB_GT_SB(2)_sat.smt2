(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg1
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b00 #b1)))
; arg1 = -2.0

(declare-const result (_ FloatingPoint 14 8))
(assert (= result ((_ to_fp 14 8) rm arg1)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10101100100001 #b0101000)
                expect
                (fp #b1 #b10000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000000000 #b0000000)
                expect
                (fp #b0 #b11010000000110 #b1000011)))

(assert (= expect result))

(check-sat)
(exit)
