(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110100011)
                arg1
                (fp #b1 #b11110 #b0111011011)))
(assert (fp.leq (fp #b1 #b11110 #b0111011011)
                arg1
                (fp #b1 #b10010 #b0110110111)))
; arg1 = -47968.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111101 #b0111110)
                expect
                (fp #b1 #b10001110 #b0111100)))
(assert (fp.leq (fp #b1 #b10001110 #b0111100)
                expect
                (fp #b1 #b01101000 #b0011110)))
; expect = -48128.0

(assert (= expect result))

(check-sat)
(exit)
