(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b0 #b0110 #b101)))
; arg1 = -1.625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010000 #b0011011001001011)
                expect
                (fp #b1 #b0111111 #b1010000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b1010000000000000)
                expect
                (fp #b1 #b0101110 #b1010010110011010)))
; expect = -1.625

(assert (= expect result))

(check-sat)
(exit)
