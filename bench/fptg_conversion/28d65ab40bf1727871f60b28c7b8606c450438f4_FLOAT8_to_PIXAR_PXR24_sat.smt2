(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: -LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1111)))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b0 #b000 #b1101)))
; arg1 = -15.5

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11001110 #b101011001011001)
                expect
                (fp #b1 #b10000010 #b111100000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b111100000000000)
                expect
                (fp #b1 #b00111111 #b000101110001000)))
; expect = -15.5

(assert (= expect result))

(check-sat)
(exit)
