(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b00011001001010000 #b01)
                arg1
                (fp #b0 #b00000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b01)
                arg1
                (fp #b0 #b10001001100111110 #b00)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b100 #b0111)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
