(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11000010110001010 #b1)
                arg1
                (fp #b0 #b00000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0)
                arg1
                (fp #b0 #b00101111100100001 #b0)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01011100 #b10111010000111000000101)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10110000 #b01011101011011101001100)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
