; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11001010 #b0000100)
                arg1
                (fp #b0 #b00000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000)
                arg1
                (fp #b0 #b01111101 #b1010010)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 13 13))
(assert (= result ((_ to_fp 13 13) rm arg1)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1100001001100 #b001110100111)
                expect
                (fp #b0 #b0000000000000 #b000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000000)
                expect
                (fp #b0 #b1001010101100 #b001011111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
