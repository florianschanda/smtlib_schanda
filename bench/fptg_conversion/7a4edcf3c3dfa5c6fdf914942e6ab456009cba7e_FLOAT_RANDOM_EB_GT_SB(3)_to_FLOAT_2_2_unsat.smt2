; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b011101000001010 #b1011101101101)
                arg1
                (fp #b1 #b000000000000001 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0000000000000)
                arg1
                (fp #b0 #b110001110001110 #b0001001100010)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b01 #b0)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
