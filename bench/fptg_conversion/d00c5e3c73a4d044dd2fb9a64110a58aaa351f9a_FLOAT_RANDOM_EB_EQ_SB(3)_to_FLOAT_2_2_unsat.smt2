(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b10001111)
                arg1
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg1
                (fp #b0 #b101011000 #b01000100)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
