; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110100011)
                arg1
                (fp #b1 #b11110 #b0111011011)))
(assert (fp.leq (fp #b1 #b11110 #b0111011011)
                arg1
                (fp #b1 #b10010 #b0110110111)))
; arg1 = -47968.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b0001001111)
                expect
                (fp #b1 #b10001110 #b0111011011)))
(assert (fp.leq (fp #b1 #b10001110 #b0111011011)
                expect
                (fp #b0 #b11110101 #b1110110000)))
; expect = -47968.0

(assert (= expect result))

(check-sat)
(exit)
