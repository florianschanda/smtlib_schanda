; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b110010000000001000 #b0011000100)
                arg1
                (fp #b0 #b011111111111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b0000000000)
                arg1
                (fp #b0 #b110011001010110011 #b0011001110)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101110 #b10010010100010110000001)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10000110 #b01111111100011011101101)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
