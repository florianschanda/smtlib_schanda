; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011101 #b10010010010010101100100)
                arg1
                (fp #b1 #b11001111 #b01100111100100010011101)))
(assert (fp.leq (fp #b1 #b11001111 #b01100111100100010011101)
                arg1
                (fp #b1 #b00010110 #b11111000110101101110011)))
; arg1 = -1698008524581344716521472.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101001110011 #b00001001111)
                expect
                (fp #b1 #b100001001111 #b01100111101)))
(assert (fp.leq (fp #b1 #b100001001111 #b01100111101)
                expect
                (fp #b0 #b010011110001 #b10010000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
