; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0111110000)
                arg1
                (fp #b1 #b00100 #b0101100101)))
(assert (fp.leq (fp #b1 #b00100 #b0101100101)
                arg1
                (fp #b0 #b00100 #b0000100001)))
; arg1 = -0.000658512115478515625

(declare-const result (_ FloatingPoint 8 7))
(assert (= result ((_ to_fp 8 7) rm arg1)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11011011 #b010110)
                expect
                (fp #b1 #b01110100 #b010111)))
(assert (fp.leq (fp #b1 #b01110100 #b010111)
                expect
                (fp #b0 #b00010110 #b110110)))
; expect = -0.00066375732421875

(assert (not (= expect result)))

(check-sat)
(exit)
