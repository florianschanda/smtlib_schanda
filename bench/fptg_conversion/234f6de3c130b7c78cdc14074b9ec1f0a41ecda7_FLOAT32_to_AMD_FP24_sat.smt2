(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011100 #b10001010111010110001001)
                arg1
                (fp #b1 #b10011011 #b11111010101001101111100)))
(assert (fp.leq (fp #b1 #b10011011 #b11111010101001101111100)
                arg1
                (fp #b0 #b00101100 #b01001011011000111100011)))
; arg1 = -531263360.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b0000011110111110)
                expect
                (fp #b1 #b1011011 #b1111101010100111)))
(assert (fp.leq (fp #b1 #b1011011 #b1111101010100111)
                expect
                (fp #b0 #b0111000 #b1011010010100011)))
; expect = -531263488.0

(assert (= expect result))

(check-sat)
(exit)
