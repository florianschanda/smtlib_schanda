; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000000 #b0100)
                arg1
                (fp #b0 #b001101 #b1101)))
(assert (fp.leq (fp #b0 #b001101 #b1101)
                arg1
                (fp #b0 #b111100 #b1011)))
; arg1 = 0.0000069141387939453125

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b11 #b0)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
(exit)
