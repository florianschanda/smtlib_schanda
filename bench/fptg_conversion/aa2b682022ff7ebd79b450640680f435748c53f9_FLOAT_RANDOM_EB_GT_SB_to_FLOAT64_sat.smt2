                expect
                (fp #b1 #b01111111111 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00011010110 #b0011001100110010000101001100000110010100000010001010)))

(assert (= expect result))

(check-sat)
