(assert (fp.leq (fp #b1 #b0111010 #b101)
                expect
                (fp #b0 #b1001111 #b000)))
(assert (fp.leq (fp #b0 #b1001111 #b000)
                expect
                (fp #b0 #b1011010 #b111)))
; expect = 65536.0

(assert (not (= expect result)))

