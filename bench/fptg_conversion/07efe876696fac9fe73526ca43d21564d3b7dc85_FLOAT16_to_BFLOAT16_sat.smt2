(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00000 #b0111101110)
                arg1
                (fp #b0 #b00000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000 #b1111111111)
                arg1
                (fp #b0 #b11000 #b1001000011)))
; arg1 = 0.000060975551605224609375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101100 #b0100000)
                expect
                (fp #b0 #b01110001 #b0000000)))
(assert (fp.leq (fp #b0 #b01110001 #b0000000)
                expect
                (fp #b0 #b11100010 #b0111111)))
; expect = 0.00006103515625

(assert (= expect result))

(check-sat)
(exit)
