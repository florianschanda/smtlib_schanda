(assert (fp.leq (fp #b1 #b11010000000110 #b011)
                expect
                (fp #b1 #b00000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b001)
                expect
                (fp #b0 #b01011001100000 #b101)))

(assert (not (= expect result)))

