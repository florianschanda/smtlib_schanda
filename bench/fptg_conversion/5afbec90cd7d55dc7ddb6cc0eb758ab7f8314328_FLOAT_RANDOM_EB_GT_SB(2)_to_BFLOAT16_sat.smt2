; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b00)
                arg1
                (fp #b0 #b10111 #b10)))
(assert (fp.leq (fp #b0 #b10111 #b10)
                arg1
                (fp #b0 #b11000 #b00)))
; arg1 = 384.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01100110 #b0001101)
                expect
                (fp #b0 #b10000111 #b1000000)))
(assert (fp.leq (fp #b0 #b10000111 #b1000000)
                expect
                (fp #b0 #b10100010 #b1110010)))
; expect = 384.0

(assert (= expect result))

(check-sat)
(exit)
