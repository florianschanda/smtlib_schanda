(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b1111100101)
                arg1
                (fp #b0 #b11001 #b1111110011)))
(assert (fp.leq (fp #b0 #b11001 #b1111110011)
                arg1
                (fp #b0 #b11010 #b1111100111)))
; arg1 = 2035.0

(declare-const result (_ FloatingPoint 11 6))
(assert (= result ((_ to_fp 11 6) rm arg1)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111011010 #b10111)
                expect
                (fp #b0 #b10000001010 #b00000)))
(assert (fp.leq (fp #b0 #b10000001010 #b00000)
                expect
                (fp #b0 #b10001010000 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
