; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100000 #b1111011100011011)
                arg1
                (fp #b0 #b1001110 #b1101101110011110)))
(assert (fp.leq (fp #b0 #b1001110 #b1101101110011110)
                arg1
                (fp #b0 #b1101000 #b1111110101000011)))
; arg1 = 60879.0

(declare-const result (_ FloatingPoint 16 12))
(assert (= result ((_ to_fp 16 12) rm arg1)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0101110111010101 #b10000100100)
                expect
                (fp #b0 #b1000000000001110 #b11011011101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b11011011101)
                expect
                (fp #b0 #b1010011000111011 #b10000010101)))

(assert (= expect result))

(check-sat)
(exit)
