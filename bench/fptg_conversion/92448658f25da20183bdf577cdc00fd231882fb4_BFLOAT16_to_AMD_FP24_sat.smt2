; Format from: BFLOAT16
; Format to: AMD_FP24
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010000 #b0101010)
                arg1
                (fp #b1 #b00000000 #b0111101)))
(assert (fp.leq (fp #b1 #b00000000 #b0111101)
                arg1
                (fp #b0 #b10010111 #b1001101)))
; arg1 = -0.0000000000000000000000000000000000000056019652656374639051635100601997645583545780439919795946901448502330822520889341831207275390625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110011 #b0101001100010000)
                expect
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b0010001 #b1011001001111001)))
; expect = -0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(assert (= expect result))

(check-sat)
(exit)
