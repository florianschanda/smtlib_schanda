                expect
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                expect
                (fp #b0 #b00001011 #b0100001101)))
; expect = -1.98828125

(assert (= expect result))

