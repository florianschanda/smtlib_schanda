(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110101 #b10000111100111011111011)
                arg1
                (fp #b1 #b11100001 #b01101100001000100000010)))
(assert (fp.leq (fp #b1 #b11100001 #b01101100001000100000010)
                arg1
                (fp #b1 #b11001100 #b11010001001000100101110)))
; arg1 = -450774663769209735545364676608.0

(declare-const result (_ FloatingPoint 12 6))
(assert (= result ((_ to_fp 12 6) rm arg1)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100011001001 #b11110)
                expect
                (fp #b1 #b100001100001 #b01110)))
(assert (fp.leq (fp #b1 #b100001100001 #b01110)
                expect
                (fp #b0 #b001000011010 #b00101)))

(assert (= expect result))

(check-sat)
(exit)
