(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1001011101)
                arg1
                (fp #b0 #b00000 #b0111111111)))
(assert (fp.leq (fp #b0 #b00000 #b0111111111)
                arg1
                (fp #b0 #b11000 #b1010101100)))
; arg1 = 0.000030457973480224609375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101011 #b0101010)
                expect
                (fp #b0 #b01110000 #b0000000)))
(assert (fp.leq (fp #b0 #b01110000 #b0000000)
                expect
                (fp #b0 #b10101111 #b0110111)))
; expect = 0.000030517578125

(assert (= expect result))

(check-sat)
(exit)
