(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101001111 #b111111001)
                arg1
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg1
                (fp #b0 #b1111111110 #b100010110)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result ((_ to_fp 16 10) rm arg1)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1111011100011000 #b110000110)
                expect
                (fp #b0 #b1000000111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000111111101 #b000000000)
                expect
                (fp #b0 #b1101011110100001 #b001111101)))

(assert (= expect result))

(check-sat)
(exit)
