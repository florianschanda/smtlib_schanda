(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101110110 #b100110001)
                expect
                (fp #b0 #b1000000101 #b010110000)))
(assert (fp.leq (fp #b0 #b1000000101 #b010110000)
                expect
                (fp #b0 #b1110111110 #b111101101)))

(assert (not (= expect result)))

(check-sat)
