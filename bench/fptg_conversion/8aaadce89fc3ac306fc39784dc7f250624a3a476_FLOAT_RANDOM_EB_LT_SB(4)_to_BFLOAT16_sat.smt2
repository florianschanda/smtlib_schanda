; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 19))
(assert (fp.leq (fp #b0 #b010001 #b011100000100010001)
                arg1
                (fp #b0 #b100100 #b010100101100000001)))
(assert (fp.leq (fp #b0 #b100100 #b010100101100000001)
                arg1
                (fp #b0 #b101001 #b111110100001100100)))
; arg1 = 42.3438720703125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010000 #b1001010)
                expect
                (fp #b0 #b10000100 #b0101010)))
(assert (fp.leq (fp #b0 #b10000100 #b0101010)
                expect
                (fp #b0 #b10010110 #b1110001)))
; expect = 42.5

(assert (= expect result))

(check-sat)
(exit)
