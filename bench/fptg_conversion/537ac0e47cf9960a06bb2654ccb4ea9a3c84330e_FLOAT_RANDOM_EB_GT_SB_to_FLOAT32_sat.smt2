(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1101001 #b00)
                arg1
                (fp #b1 #b0111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111 #b11)
                arg1
                (fp #b0 #b1001100 #b00)))
; arg1 = -1.75

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b10000110100101100111110)
                expect
                (fp #b1 #b01111111 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b11000000000000000000000)
                expect
                (fp #b0 #b01110110 #b01100000001100111110001)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
