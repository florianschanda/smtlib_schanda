(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b1001111001001011)
                arg1
                (fp #b1 #b0111111 #b0010010101010110)))
(assert (fp.leq (fp #b1 #b0111111 #b0010010101010110)
                arg1
                (fp #b0 #b0001110 #b1011100011011111)))
; arg1 = -1.145843505859375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0111)
                expect
                (fp #b1 #b011 #b0011)))
(assert (fp.leq (fp #b1 #b011 #b0011)
                expect
                (fp #b0 #b101 #b1101)))
; expect = -1.1875

(assert (= expect result))

(check-sat)
(exit)
