; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1110)))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b010 #b0101)))
; arg1 = -15.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011100000 #b1000001101101101110111011111100010000011110101001101)
                expect
                (fp #b1 #b10000000010 #b1110000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000010 #b1110000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b00101101001 #b0101110011001000011011011101010000110011000100001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
