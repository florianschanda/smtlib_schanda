; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg1
                (fp #b1 #b00 #b0)))
(assert (fp.leq (fp #b1 #b00 #b0)
                arg1
                (fp #b0 #b00 #b1)))
; arg1 = -0

(declare-const result (_ FloatingPoint 18 18))
(assert (= result ((_ to_fp 18 18) rm arg1)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001101001100000001 #b00011011100111101)
                expect
                (fp #b1 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b101010101000111100 #b00000000001011010)))

(assert (= expect result))

(check-sat)
(exit)
