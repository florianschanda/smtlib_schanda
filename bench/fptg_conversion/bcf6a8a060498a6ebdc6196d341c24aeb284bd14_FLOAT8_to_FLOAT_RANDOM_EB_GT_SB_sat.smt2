(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1000)
                arg1
                (fp #b0 #b001 #b0111)))
(assert (fp.leq (fp #b0 #b001 #b0111)
                arg1
                (fp #b0 #b100 #b1011)))
; arg1 = 0.359375

(declare-const result (_ FloatingPoint 6 3))
(assert (= result ((_ to_fp 6 3) rm arg1)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b0 #b010011 #b11)
                expect
                (fp #b0 #b011101 #b10)))
(assert (fp.leq (fp #b0 #b011101 #b10)
                expect
                (fp #b0 #b111100 #b11)))
; expect = 0.375

(assert (= expect result))

(check-sat)
(exit)
