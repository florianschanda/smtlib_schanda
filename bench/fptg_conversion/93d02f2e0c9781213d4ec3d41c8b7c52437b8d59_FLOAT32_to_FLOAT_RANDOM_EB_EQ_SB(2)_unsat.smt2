(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01011001110001011000100)
                arg1
                (fp #b1 #b10010110 #b11111101100111110110000)))
(assert (fp.leq (fp #b1 #b10010110 #b11111101100111110110000)
                arg1
                (fp #b1 #b10000010 #b11100101010111000100101)))
; arg1 = -16699312.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001011001100000 #b010100011110011)
                expect
                (fp #b1 #b1000000000010110 #b111111011010000)))
(assert (fp.leq (fp #b1 #b1000000000010110 #b111111011010000)
                expect
                (fp #b1 #b0110101100010000 #b001001000010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
