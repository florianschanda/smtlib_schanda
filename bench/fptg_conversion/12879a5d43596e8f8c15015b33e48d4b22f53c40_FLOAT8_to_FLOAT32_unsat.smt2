(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1100)
                arg1
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                arg1
                (fp #b0 #b110 #b0100)))
; arg1 = 4.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00101001 #b10100011110100100001100)
                expect
                (fp #b0 #b10000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b00000000000000000000000)
                expect
                (fp #b0 #b10010110 #b00001001001000110000000)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
