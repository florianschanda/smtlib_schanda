(assert (fp.leq (fp #b1 #b011111101001010 #b000111010110101101100000111010110010100101111110011110001111000)
                expect
                (fp #b0 #b011111111111111 #b111111010000000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b111111010000000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b100100110000010 #b000011001100100011100011100011000001110110000101110010100000101)))

(assert (= expect result))

(check-sat)
