(assert (fp.leq (fp #b1 #b1010010100 #b010011001)
                expect
                (fp #b1 #b0101111110 #b011000000)))
(assert (fp.leq (fp #b1 #b0101111110 #b011000000)
                expect
                (fp #b0 #b0010100000 #b100100110)))

(assert (not (= expect result)))

