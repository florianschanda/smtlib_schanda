(assert (fp.leq (fp #b0 #b00001011010110 #b1001000000111)
                expect
                (fp #b0 #b01111111111111 #b1111110100000)))
(assert (fp.leq (fp #b0 #b01111111111111 #b1111110100000)
                expect
                (fp #b0 #b11110001100110 #b0001111000001)))

(assert (= expect result))

(check-sat)
