(assert (fp.leq (fp #b0 #b010010010110110 #b001101011101110111100110001001010101000010111101100101001100101)
                expect
                (fp #b0 #b100000000001110 #b111010011001000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000001110 #b111010011001000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b100100010111010 #b011110110111111011100100100110010101010100011110010100001110011)))

(assert (= expect result))

(check-sat)
(exit)
