; Format from: BFLOAT16
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01011100 #b1101000)
                arg1
                (fp #b0 #b01111111 #b1000101)))
(assert (fp.leq (fp #b0 #b01111111 #b1000101)
                arg1
                (fp #b0 #b11010010 #b0011000)))
; arg1 = 1.5390625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0010)
                expect
                (fp #b0 #b011 #b1001)))
(assert (fp.leq (fp #b0 #b011 #b1001)
                expect
                (fp #b0 #b101 #b1111)))
; expect = 1.5625

(assert (not (= expect result)))

(check-sat)
(exit)
