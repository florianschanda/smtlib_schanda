; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10101 #b1100101111)
                arg1
                (fp #b1 #b00001 #b1101110110)))
(assert (fp.leq (fp #b1 #b00001 #b1101110110)
                arg1
                (fp #b0 #b10011 #b1001110010)))
; arg1 = -0.00011384487152099609375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001001 #b1011101)
                expect
                (fp #b1 #b01110001 #b1101111)))
(assert (fp.leq (fp #b1 #b01110001 #b1101111)
                expect
                (fp #b1 #b00101010 #b0111100)))
; expect = -0.000113964080810546875

(assert (not (= expect result)))

(check-sat)
(exit)
