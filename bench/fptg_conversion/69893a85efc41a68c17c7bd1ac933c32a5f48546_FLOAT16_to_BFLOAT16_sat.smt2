(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111100010)
                arg1
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg1
                (fp #b1 #b01011 #b1100001001)))
; arg1 = -25296.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101010 #b1010010)
                expect
                (fp #b1 #b10001101 #b1000110)))
(assert (fp.leq (fp #b1 #b10001101 #b1000110)
                expect
                (fp #b1 #b00100000 #b1000010)))
; expect = -25344.0

(assert (= expect result))

(check-sat)
(exit)
