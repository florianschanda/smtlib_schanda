(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1101100111)
                arg1
                (fp #b0 #b10100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10100 #b0010001110)
                arg1
                (fp #b0 #b11100 #b1100100101)))
; arg1 = 36.4375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110101 #b1011111)
                expect
                (fp #b0 #b10000100 #b0010010)))
(assert (fp.leq (fp #b0 #b10000100 #b0010010)
                expect
                (fp #b0 #b10111101 #b1111011)))
; expect = 36.5

(assert (= expect result))

(check-sat)
(exit)
