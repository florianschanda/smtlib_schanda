(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b1 #b010 #b0)))
(assert (fp.leq (fp #b1 #b010 #b0)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 16 8))
(assert (= result ((_ to_fp 16 8) rm arg1)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1001101110000101 #b0110100)
                expect
                (fp #b1 #b0111111111111110 #b0000000)))
(assert (fp.leq (fp #b1 #b0111111111111110 #b0000000)
                expect
                (fp #b1 #b0111000000110110 #b1100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
