(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101010101010 #b00110101010)
                expect
                (fp #b1 #b011111100111 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111100111 #b00000000000)
                expect
                (fp #b0 #b010100111011 #b11100011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
