(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b101 #b10)))
(assert (fp.leq (fp #b1 #b101 #b10)
                arg1
                (fp #b0 #b100 #b10)))
; arg1 = -6.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010001 #b010010111100100)
                expect
                (fp #b1 #b10000001 #b100000000000000)))
(assert (fp.leq (fp #b1 #b10000001 #b100000000000000)
                expect
                (fp #b0 #b10010011 #b101011101100000)))
; expect = -6.0

(assert (= expect result))

(check-sat)
(exit)
