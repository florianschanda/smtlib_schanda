; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 40))
(assert (fp.leq (fp #b1 #b010110010001010 #b011101001011110001111100010010011110111)
                arg1
                (fp #b0 #b000000000000001 #b000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b000110100111010 #b100100110010110010001010110010011110001)))

(declare-const result (_ FloatingPoint 8 6))
(assert (= result ((_ to_fp 8 6) rm arg1)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b01111001 #b01010)
                expect
                (fp #b0 #b00000000 #b00001)))
(assert (fp.leq (fp #b0 #b00000000 #b00001)
                expect
                (fp #b0 #b11000000 #b00010)))
; expect = 0.00000000000000000000000000000000000000036734198463196484624023016788195177431833298649127735047148490821200539357960224151611328125

