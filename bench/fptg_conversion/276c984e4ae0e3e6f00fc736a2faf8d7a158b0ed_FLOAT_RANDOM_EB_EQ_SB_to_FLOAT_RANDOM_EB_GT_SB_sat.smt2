; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b1 #b1101 #b101)))
(assert (fp.leq (fp #b1 #b1101 #b101)
                arg1
                (fp #b0 #b1011 #b011)))
; arg1 = -104.0

(declare-const result (_ FloatingPoint 9 3))
(assert (= result ((_ to_fp 9 3) rm arg1)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110100100 #b00)
                expect
                (fp #b1 #b100000101 #b11)))
(assert (fp.leq (fp #b1 #b100000101 #b11)
                expect
                (fp #b1 #b001001000 #b01)))

(assert (= expect result))

(check-sat)
(exit)
