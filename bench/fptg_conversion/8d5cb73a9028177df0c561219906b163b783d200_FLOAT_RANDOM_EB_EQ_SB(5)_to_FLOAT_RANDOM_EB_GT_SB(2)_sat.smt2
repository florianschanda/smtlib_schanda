(assert (fp.leq (fp #b1 #b101100000000 #b1)
                expect
                (fp #b0 #b110101010100 #b1)))
(assert (fp.leq (fp #b0 #b110101010100 #b1)
                expect
                (fp #b0 #b111010001001 #b1)))

(assert (= expect result))

