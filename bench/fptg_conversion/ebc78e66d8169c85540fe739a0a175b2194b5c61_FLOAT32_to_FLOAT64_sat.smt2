; Format from: FLOAT32
; Format to: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01100010111111001000111)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01111111 #b01001010111001100111110)))
; arg1 = -1316616.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010000110 #b1010111011001100001111000011100111001011110100001000)
                expect
                (fp #b1 #b10000010011 #b0100000101110000100000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010011 #b0100000101110000100000000000000000000000000000000000)
                expect
                (fp #b0 #b00101100010 #b0100101010001000010100011000111101100001110011010110)))

(assert (= expect result))

(check-sat)
(exit)
