; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111101 #b10)
                arg1
                (fp #b1 #b000000 #b11)))
(assert (fp.leq (fp #b1 #b000000 #b11)
                arg1
                (fp #b0 #b110101 #b01)))
; arg1 = -0.00000000069849193096160888671875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01100111 #b11010110100101011011010)
                expect
                (fp #b1 #b01100000 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01100000 #b10000000000000000000000)
                expect
                (fp #b0 #b01101000 #b10001001000000010111000)))
; expect = -0.00000000069849193096160888671875

(assert (= expect result))

(check-sat)
(exit)
