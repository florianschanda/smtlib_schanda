(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111100101110101 #b00110001111000)
                arg1
                (fp #b1 #b011111111111111 #b11101110010001)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11101110010001)
                arg1
                (fp #b0 #b000111000010101 #b01011010110000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11110110 #b0101010)
                expect
                (fp #b1 #b01111111 #b1111000)))
(assert (fp.leq (fp #b1 #b01111111 #b1111000)
                expect
                (fp #b1 #b01110111 #b0011011)))
; expect = -1.9375

(assert (= expect result))

(check-sat)
(exit)
