                expect
                (fp #b1 #b0111111 #b0100110000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0100110000000000)
                expect
                (fp #b0 #b1101100 #b0101000010111101)))
; expect = -1.296875

(assert (= expect result))

(check-sat)
