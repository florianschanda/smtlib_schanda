; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010110 #b1100010011010000)
                arg1
                (fp #b1 #b0111111 #b0110101011101010)))
(assert (fp.leq (fp #b1 #b0111111 #b0110101011101010)
                arg1
                (fp #b0 #b1101101 #b1010010011101010)))
; arg1 = -1.417633056640625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b10011100000110010001000)
                expect
                (fp #b1 #b01111111 #b01101010111010100000000)))
(assert (fp.leq (fp #b1 #b01111111 #b01101010111010100000000)
                expect
                (fp #b1 #b00101001 #b11001010111100001000111)))
; expect = -1.417633056640625

(assert (= expect result))

(check-sat)
(exit)
