(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111010 #b00100101)
                expect
                (fp #b1 #b100010001 #b01010110)))
(assert (fp.leq (fp #b1 #b100010001 #b01010110)
                expect
                (fp #b1 #b000000101 #b00100111)))

(assert (= expect result))

(check-sat)
