; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b0010101111)
                arg1
                (fp #b0 #b11011 #b0101101000)))
(assert (fp.leq (fp #b0 #b11011 #b0101101000)
                arg1
                (fp #b0 #b11011 #b1110111100)))
; arg1 = 5536.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100000 #b01001001111111100001001)
                expect
                (fp #b0 #b10001011 #b01011010000000000000000)))
(assert (fp.leq (fp #b0 #b10001011 #b01011010000000000000000)
                expect
                (fp #b0 #b10011111 #b01111000100110000111000)))
; expect = 5536.0

(assert (not (= expect result)))

(check-sat)
(exit)
