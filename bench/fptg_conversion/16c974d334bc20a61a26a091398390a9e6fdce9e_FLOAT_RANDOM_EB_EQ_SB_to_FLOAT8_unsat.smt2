(assert (fp.leq (fp #b1 #b101 #b0001)
                expect
                (fp #b1 #b000 #b1110)))
(assert (fp.leq (fp #b1 #b000 #b1110)
                expect
                (fp #b0 #b011 #b1100)))
; expect = -0.21875

(assert (not (= expect result)))

(check-sat)
