(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000110 #b1100001101000011)
                arg1
                (fp #b0 #b0111111 #b1000110111010011)))
(assert (fp.leq (fp #b0 #b0111111 #b1000110111010011)
                arg1
                (fp #b0 #b1110100 #b1111101110001000)))
; arg1 = 1.5540008544921875

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                expect
                (fp #b0 #b10 #b1)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
