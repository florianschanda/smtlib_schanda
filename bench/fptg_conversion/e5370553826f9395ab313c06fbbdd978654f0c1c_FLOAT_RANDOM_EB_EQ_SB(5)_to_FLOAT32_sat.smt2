(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01101011101100 #b0101111101100)
                arg1
                (fp #b0 #b00000000000000 #b1101100101001)))
