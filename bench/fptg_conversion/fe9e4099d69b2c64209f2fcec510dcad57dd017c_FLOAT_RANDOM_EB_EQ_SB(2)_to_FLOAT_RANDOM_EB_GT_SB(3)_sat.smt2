(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100011100 #b10010000111)
                arg1
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                arg1
                (fp #b0 #b011001001111 #b10011011011)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result ((_ to_fp 10 7) rm arg1)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0101100100 #b110010)
                expect
                (fp #b1 #b0011010111 #b000010)))
(assert (fp.leq (fp #b1 #b0011010111 #b000010)
                expect
                (fp #b1 #b0001100100 #b101110)))

(assert (= expect result))

(check-sat)
