; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1001)
                arg1
                (fp #b0 #b100 #b1111)))
(assert (fp.leq (fp #b0 #b100 #b1111)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = 3.875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100010 #b00001001111000101011000)
                expect
                (fp #b0 #b10000000 #b11110000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b11110000000000000000000)
                expect
                (fp #b0 #b10010000 #b01100101001000110001010)))
; expect = 3.875

(assert (not (= expect result)))

(check-sat)
(exit)
