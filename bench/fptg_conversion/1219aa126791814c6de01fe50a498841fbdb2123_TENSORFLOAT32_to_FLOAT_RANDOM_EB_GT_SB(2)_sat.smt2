(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100111 #b1010111001)
                arg1
                (fp #b1 #b10001001 #b0110110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0110110001)
                arg1
                (fp #b0 #b10101100 #b1010011110)))
; arg1 = -1457.0

(declare-const result (_ FloatingPoint 14 4))
(assert (= result ((_ to_fp 14 4) rm arg1)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10100011010101 #b010)
                expect
                (fp #b1 #b10000000001001 #b100)))
(assert (fp.leq (fp #b1 #b10000000001001 #b100)
                expect
                (fp #b0 #b00101111110011 #b011)))

(assert (= expect result))

(check-sat)
(exit)
