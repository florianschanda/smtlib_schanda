(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1011010 #b0011100101010011)
                arg1
                (fp #b1 #b0000000 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0100000000000000)
                arg1
                (fp #b0 #b0000111 #b1000110101111110)))
; arg1 = -0.0000000000000000000542101086242752217003726400434970855712890625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00010 #b1110110011)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00010 #b0100011010)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
