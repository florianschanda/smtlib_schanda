(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0000)
                arg1
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                arg1
                (fp #b0 #b011 #b1101)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 17 6))
(assert (= result ((_ to_fp 17 6) rm arg1)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b01001100101001100 #b01111)
                expect
                (fp #b0 #b01111111111111100 #b00000)))
(assert (fp.leq (fp #b0 #b01111111111111100 #b00000)
                expect
                (fp #b0 #b10010001011001001 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
