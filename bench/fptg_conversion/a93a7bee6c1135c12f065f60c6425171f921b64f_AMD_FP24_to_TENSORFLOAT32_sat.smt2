; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101111 #b0101000111011100)
                arg1
                (fp #b0 #b1010010 #b1100101110011111)))
(assert (fp.leq (fp #b0 #b1010010 #b1100101110011111)
                arg1
                (fp #b0 #b1101011 #b1110010101010110)))
; arg1 = 941304.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100101 #b0001001001)
                expect
                (fp #b0 #b10010010 #b1100101111)))
(assert (fp.leq (fp #b0 #b10010010 #b1100101111)
                expect
                (fp #b0 #b11010111 #b1010010110)))
; expect = 941568.0

(assert (= expect result))

(check-sat)
(exit)
