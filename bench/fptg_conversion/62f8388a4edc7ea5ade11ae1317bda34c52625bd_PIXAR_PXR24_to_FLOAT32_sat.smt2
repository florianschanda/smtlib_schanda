; Format from: PIXAR_PXR24
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010011 #b001110111010100)
                arg1
                (fp #b0 #b10001101 #b011011001010000)))
(assert (fp.leq (fp #b0 #b10001101 #b011011001010000)
                arg1
                (fp #b0 #b11010100 #b101011100100100)))
; arg1 = 23336.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011111 #b10100000100111100111111)
                expect
                (fp #b0 #b10001101 #b01101100101000000000000)))
(assert (fp.leq (fp #b0 #b10001101 #b01101100101000000000000)
                expect
                (fp #b0 #b10101001 #b10101010111000111010010)))
; expect = 23336.0

(assert (= expect result))

(check-sat)
(exit)
