(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b100 #b0)))
(assert (fp.leq (fp #b1 #b100 #b0)
                arg1
                (fp #b0 #b010 #b0)))
; arg1 = -2.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1100001100010110)
                expect
                (fp #b1 #b1000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1000000 #b0000000000000000)
                expect
                (fp #b0 #b0111000 #b0100101001001101)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
