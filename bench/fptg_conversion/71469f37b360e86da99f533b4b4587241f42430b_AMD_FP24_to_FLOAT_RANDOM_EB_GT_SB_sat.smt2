; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0011100101001010)
                arg1
                (fp #b1 #b1001110 #b1001100011111110)))
(assert (fp.leq (fp #b1 #b1001110 #b1001100011111110)
                arg1
                (fp #b0 #b0010010 #b1010111011100101)))
; arg1 = -52351.0

(declare-const result (_ FloatingPoint 14 7))
(assert (= result ((_ to_fp 14 7) rm arg1)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11110100010011 #b001000)
                expect
                (fp #b1 #b10000000001110 #b100111)))
(assert (fp.leq (fp #b1 #b10000000001110 #b100111)
                expect
                (fp #b1 #b00000010000010 #b111100)))

(assert (= expect result))

(check-sat)
(exit)
