; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg1 = 11601303.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b0 #b010111100111001 #b100011100100010011001010101001011101001111000100001010111110100)
                expect
                (fp #b0 #b100000000010110 #b011000100000101100101110000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000010110 #b011000100000101100101110000000000000000000000000000000000000000)
                expect
                (fp #b0 #b100001111010110 #b110010001001100011011011111111011111101100010001111010011101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
