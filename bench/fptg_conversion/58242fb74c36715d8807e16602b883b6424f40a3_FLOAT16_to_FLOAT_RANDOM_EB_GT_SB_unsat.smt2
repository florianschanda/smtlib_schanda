; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10101 #b1100101111)
                arg1
                (fp #b1 #b00001 #b1101110110)))
(assert (fp.leq (fp #b1 #b00001 #b1101110110)
                arg1
                (fp #b0 #b10011 #b1001110010)))
; arg1 = -0.00011384487152099609375

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                expect
                (fp #b1 #b000 #b1)))
(assert (fp.leq (fp #b1 #b000 #b1)
                expect
                (fp #b0 #b000 #b1)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
