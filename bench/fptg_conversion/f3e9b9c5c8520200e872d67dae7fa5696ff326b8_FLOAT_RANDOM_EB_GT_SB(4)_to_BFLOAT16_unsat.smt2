; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00101 #b101)
                arg1
                (fp #b0 #b01111 #b100)))
(assert (fp.leq (fp #b0 #b01111 #b100)
                arg1
                (fp #b0 #b10011 #b001)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00100011 #b1011100)
                expect
                (fp #b0 #b01111111 #b1000000)))
(assert (fp.leq (fp #b0 #b01111111 #b1000000)
                expect
                (fp #b0 #b10000000 #b1000001)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
