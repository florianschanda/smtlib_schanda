(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111001 #b1000100000001110)
                arg1
                (fp #b0 #b1001101 #b0111010111011000)))
(assert (fp.leq (fp #b0 #b1001101 #b0111010111011000)
                arg1
                (fp #b0 #b1100000 #b1101110001010000)))
; arg1 = 23926.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110101 #b0111110111)
                expect
                (fp #b0 #b10001101 #b0111011000)))
(assert (fp.leq (fp #b0 #b10001101 #b0111011000)
                expect
                (fp #b0 #b11101011 #b0111100110)))
; expect = 23936.0

(assert (= expect result))

(check-sat)
(exit)
