; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101100100100 #b11101000010011)
                arg1
                (fp #b1 #b100000000010011 #b01101001010110)))
(assert (fp.leq (fp #b1 #b100000000010011 #b01101001010110)
                arg1
                (fp #b1 #b001010100001001 #b00010101010011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10101000 #b1010010110)
                expect
                (fp #b1 #b10010011 #b0110100110)))
(assert (fp.leq (fp #b1 #b10010011 #b0110100110)
                expect
                (fp #b0 #b10000111 #b0100011000)))
; expect = -1480704.0

(assert (= expect result))

(check-sat)
(exit)
