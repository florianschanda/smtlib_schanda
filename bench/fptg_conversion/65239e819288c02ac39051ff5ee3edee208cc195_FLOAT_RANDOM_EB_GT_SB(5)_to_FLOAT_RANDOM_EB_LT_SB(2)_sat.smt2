(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011100111 #b011)
                arg1
                (fp #b1 #b000000000 #b100)))
(assert (fp.leq (fp #b1 #b000000000 #b100)
                arg1
                (fp #b0 #b111101010 #b011)))

(declare-const result (_ FloatingPoint 7 29))
(assert (= result ((_ to_fp 7 29) rm arg1)))

(declare-const expect (_ FloatingPoint 7 29))
(assert (fp.leq (fp #b1 #b0101111 #b0000101110010101100111011111)
                expect
                (fp #b1 #b0000000 #b0000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000000000000001)
                expect
                (fp #b0 #b1111110 #b0100010100111010011011010110)))

(assert (= expect result))

(check-sat)
(exit)
