                expect
                (fp #b1 #b10000000000000000 #b1000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000000000 #b1000000000000000)
                expect
                (fp #b0 #b10111110010110010 #b1111001011011011)))

(assert (= expect result))

