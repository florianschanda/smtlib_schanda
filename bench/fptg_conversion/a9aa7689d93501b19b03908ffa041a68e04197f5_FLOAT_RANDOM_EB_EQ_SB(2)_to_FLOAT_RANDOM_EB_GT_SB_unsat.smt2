(assert (fp.leq (fp #b1 #b000000101101 #b010)
                expect
                (fp #b0 #b100000001000 #b000)))
(assert (fp.leq (fp #b0 #b100000001000 #b000)
                expect
                (fp #b0 #b101011001010 #b011)))

(assert (not (= expect result)))

