(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0011)
                arg1
                (fp #b0 #b110 #b0010)))
(assert (fp.leq (fp #b0 #b110 #b0010)
                arg1
                (fp #b0 #b110 #b0110)))
; arg1 = 9.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000001 #b00101110110101001101100)
                expect
                (fp #b0 #b10000010 #b00100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b00100000000000000000000)
                expect
                (fp #b0 #b10111111 #b01011001110101110011110)))
; expect = 9.0

(assert (= expect result))

(check-sat)
(exit)
