; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 25))
(assert (fp.leq (fp #b1 #b101000110 #b011001010010101011011101)
                arg1
                (fp #b1 #b100001011 #b101001010111010110101101)))
(assert (fp.leq (fp #b1 #b100001011 #b101001010111010110101101)
                arg1
                (fp #b0 #b100010100 #b111011011100110000001100)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
