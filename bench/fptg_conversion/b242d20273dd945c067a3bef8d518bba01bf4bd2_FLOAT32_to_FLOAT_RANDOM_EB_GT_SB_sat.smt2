; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01000010 #b00001011010011101100011)
                arg1
                (fp #b0 #b11111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11111111 #b00000000000000000000000)))
; arg1 = 340282346638528859811704183484516925440.0

(declare-const result (_ FloatingPoint 18 14))
(assert (= result ((_ to_fp 18 14) rm arg1)))

(declare-const expect (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b000110111011010100 #b0110011111111)
                expect
                (fp #b0 #b100000000001111111 #b0000000000000)))
(assert (fp.leq (fp #b0 #b100000000001111111 #b0000000000000)
                expect
                (fp #b0 #b110000110111010011 #b0011101010100)))

(assert (= expect result))

(check-sat)
(exit)
