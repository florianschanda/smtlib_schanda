; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b1001011000001001)
                arg1
                (fp #b1 #b1010001 #b0101010110111110)))
(assert (fp.leq (fp #b1 #b1010001 #b0101010110111110)
                arg1
                (fp #b1 #b0011001 #b1110001101011001)))
; arg1 = -349944.0

(declare-const result (_ FloatingPoint 12 16))
(assert (= result ((_ to_fp 12 16) rm arg1)))

(declare-const expect (_ FloatingPoint 12 16))
(assert (fp.leq (fp #b1 #b110110100111 #b010001001110101)
                expect
                (fp #b1 #b100000010001 #b010101011011111)))
(assert (fp.leq (fp #b1 #b100000010001 #b010101011011111)
                expect
                (fp #b1 #b001000110110 #b000010100001111)))

(assert (= expect result))

(check-sat)
(exit)
