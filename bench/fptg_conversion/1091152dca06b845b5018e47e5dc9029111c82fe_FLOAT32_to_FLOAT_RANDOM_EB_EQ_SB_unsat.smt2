; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101100 #b10011000100111010011010)
                arg1
                (fp #b0 #b00000000 #b10001100001001000101000)))
(assert (fp.leq (fp #b0 #b00000000 #b10001100001001000101000)
                arg1
                (fp #b0 #b01010110 #b01111110001111000100000)))
; arg1 = 0.00000000000000000000000000000000000000643499796632156655894968143303728758074901792110319567855811274709361413659536310660769231617450714111328125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1010 #b011)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b0001 #b010)))
; expect = 0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
