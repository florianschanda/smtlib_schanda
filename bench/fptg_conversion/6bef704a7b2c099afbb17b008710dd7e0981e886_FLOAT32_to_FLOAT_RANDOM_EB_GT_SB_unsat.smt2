(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111000 #b01101000101110110101111)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b00101010 #b01000110111001010100111)))
; arg1 = -1047025986568192.0

(declare-const result (_ FloatingPoint 12 8))
(assert (= result ((_ to_fp 12 8) rm arg1)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100100000101 #b0111101)
                expect
                (fp #b1 #b100000110000 #b1101111)))
(assert (fp.leq (fp #b1 #b100000110000 #b1101111)
                expect
                (fp #b0 #b111101010010 #b1100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
