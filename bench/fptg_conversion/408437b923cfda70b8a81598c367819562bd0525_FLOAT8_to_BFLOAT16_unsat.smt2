; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1010)
                arg1
                (fp #b0 #b100 #b0010)))
(assert (fp.leq (fp #b0 #b100 #b0010)
                arg1
                (fp #b0 #b101 #b0001)))
; arg1 = 2.25

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b1001000)
                expect
                (fp #b0 #b10000000 #b0010000)))
(assert (fp.leq (fp #b0 #b10000000 #b0010000)
                expect
                (fp #b0 #b11001010 #b0111110)))
; expect = 2.25

(assert (not (= expect result)))

(check-sat)
(exit)
