(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0010111111110 #b001100100011)
                arg1
                (fp #b0 #b1000000001100 #b000000000000)))
(assert (fp.leq (fp #b0 #b1000000001100 #b000000000000)
                arg1
                (fp #b0 #b1111001001011 #b101111101010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011101 #b11110010010011011100110)
                expect
                (fp #b0 #b10001100 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001100 #b00000000000000000000000)
                expect
                (fp #b0 #b10111100 #b00001101100011011111111)))
; expect = 8192.0

(assert (= expect result))

(check-sat)
(exit)
