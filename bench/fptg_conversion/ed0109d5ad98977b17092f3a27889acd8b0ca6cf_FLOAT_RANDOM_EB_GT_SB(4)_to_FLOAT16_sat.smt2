; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b111101100101111 #b0100101110)
                arg1
                (fp #b1 #b011010011111000 #b1011000111)))
(assert (fp.leq (fp #b1 #b011010011111000 #b1011000111)
                arg1
                (fp #b0 #b110001001111110 #b0101101001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b1011000101)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10001 #b0011010001)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
