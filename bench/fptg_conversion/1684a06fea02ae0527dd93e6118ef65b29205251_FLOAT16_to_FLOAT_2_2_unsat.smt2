; Format from: FLOAT16
; Format to: FLOAT_2_2
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10011 #b1110000001)
                arg1
                (fp #b1 #b00000 #b0001101111)))
(assert (fp.leq (fp #b1 #b00000 #b0001101111)
                arg1
                (fp #b0 #b11011 #b0010110001)))
; arg1 = -0.000006616115570068359375

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b1)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b00 #b1)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
