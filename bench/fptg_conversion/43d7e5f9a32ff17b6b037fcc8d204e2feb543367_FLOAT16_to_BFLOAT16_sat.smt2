(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000101111)
                arg1
                (fp #b1 #b00110 #b0100011011)))
(assert (fp.leq (fp #b1 #b00110 #b0100011011)
                arg1
                (fp #b1 #b00000 #b0011110101)))
; arg1 = -0.0024929046630859375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100111 #b0011100)
                expect
                (fp #b1 #b01110110 #b0100100)))
(assert (fp.leq (fp #b1 #b01110110 #b0100100)
                expect
                (fp #b0 #b11110011 #b0000001)))
; expect = -0.00250244140625

(assert (= expect result))

(check-sat)
(exit)
