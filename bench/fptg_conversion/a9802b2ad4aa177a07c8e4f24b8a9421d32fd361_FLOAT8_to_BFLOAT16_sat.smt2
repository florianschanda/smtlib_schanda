(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                arg1
                (fp #b1 #b001 #b0110)))
(assert (fp.leq (fp #b1 #b001 #b0110)
                arg1
                (fp #b1 #b001 #b0011)))
; arg1 = -0.34375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101001 #b0110001)
                expect
                (fp #b1 #b01111101 #b0110000)))
(assert (fp.leq (fp #b1 #b01111101 #b0110000)
                expect
                (fp #b1 #b00111010 #b1011111)))
; expect = -0.34375

(assert (= expect result))

(check-sat)
(exit)
