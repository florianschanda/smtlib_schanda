(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011101110 #b0000100)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b1101110010 #b1001110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000100 #b10101010)
                expect
                (fp #b0 #b000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000 #b00000001)
                expect
                (fp #b0 #b100010000 #b00010000)))

(assert (= expect result))

(check-sat)
(exit)
