(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b1100001011001011)
                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b1101001 #b0010100100001000)))
; arg1 = 0.0000000004656612873077392578125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b11100011101000100101100)
                expect
                (fp #b0 #b01100000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01100000 #b00000000000000000000000)
                expect
                (fp #b0 #b10110000 #b01000000011000110001000)))
; expect = 0.0000000004656612873077392578125

(assert (= expect result))

(check-sat)
(exit)
