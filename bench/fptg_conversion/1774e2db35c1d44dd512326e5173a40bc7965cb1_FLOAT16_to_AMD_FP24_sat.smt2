(assert (fp.leq (fp #b1 #b1110010 #b0000111110111000)
                expect
                (fp #b0 #b1001101 #b1000010010000000)))
(assert (fp.leq (fp #b0 #b1001101 #b1000010010000000)
                expect
                (fp #b0 #b1101010 #b1111000001101110)))
; expect = 24864.0

(assert (= expect result))

