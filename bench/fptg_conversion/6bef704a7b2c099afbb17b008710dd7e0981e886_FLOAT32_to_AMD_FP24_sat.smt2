(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10111000 #b01101000101110110101111)
                arg1
                (fp #b1 #b10110000 #b11011100001000011101111)))
(assert (fp.leq (fp #b1 #b10110000 #b11011100001000011101111)
                arg1
                (fp #b0 #b00101010 #b01000110111001010100111)))
; arg1 = -1047025986568192.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1111001111000111)
                expect
                (fp #b1 #b1110000 #b1101110000100010)))
(assert (fp.leq (fp #b1 #b1110000 #b1101110000100010)
                expect
                (fp #b0 #b0010110 #b0111111101110110)))
; expect = -1047027127418880.0

(assert (= expect result))

(check-sat)
(exit)
