(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0010001111011 #b0111)
                arg1
                (fp #b1 #b0000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000)
                arg1
                (fp #b0 #b1011101011100 #b0111)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01 #b1)
                expect
                (fp #b1 #b00 #b0)))
(assert (fp.leq (fp #b1 #b00 #b0)
                expect
                (fp #b0 #b01 #b0)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
