(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1000)
                arg1
                (fp #b0 #b000 #b0011)))
(assert (fp.leq (fp #b0 #b000 #b0011)
                arg1
                (fp #b0 #b110 #b1010)))
; arg1 = 0.046875

(declare-const result (_ FloatingPoint 11 4))
(assert (= result ((_ to_fp 11 4) rm arg1)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b01011110000 #b110)
                expect
                (fp #b0 #b01111111010 #b100)))
(assert (fp.leq (fp #b0 #b01111111010 #b100)
                expect
                (fp #b0 #b10111110100 #b010)))

(assert (= expect result))

(check-sat)
(exit)
