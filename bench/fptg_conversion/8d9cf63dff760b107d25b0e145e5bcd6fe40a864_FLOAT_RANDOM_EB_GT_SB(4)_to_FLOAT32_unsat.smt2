; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b00)
                arg1
                (fp #b0 #b1001 #b01)))
(assert (fp.leq (fp #b0 #b1001 #b01)
                arg1
                (fp #b0 #b1100 #b10)))
; arg1 = 5.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01000111 #b11011001011111101011111)
                expect
                (fp #b0 #b10000001 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b01000000000000000000000)
                expect
                (fp #b0 #b10101111 #b01011101001110010010101)))
; expect = 5.0

(assert (not (= expect result)))

(check-sat)
(exit)
