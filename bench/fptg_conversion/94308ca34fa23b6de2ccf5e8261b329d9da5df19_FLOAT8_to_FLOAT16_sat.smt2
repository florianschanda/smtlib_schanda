(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1000)
                arg1
                (fp #b0 #b001 #b0011)))
(assert (fp.leq (fp #b0 #b001 #b0011)
                arg1
                (fp #b0 #b110 #b0011)))
; arg1 = 0.296875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b0010101001)
                expect
                (fp #b0 #b01101 #b0011000000)))
(assert (fp.leq (fp #b0 #b01101 #b0011000000)
                expect
                (fp #b0 #b01110 #b0010101001)))
; expect = 0.296875

(assert (= expect result))

(check-sat)
(exit)
