; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010110 #b01011111010100010111111)
                arg1
                (fp #b1 #b11000011 #b10100011111100011101000)))
(assert (fp.leq (fp #b1 #b11000011 #b10100011111100011101000)
                arg1
                (fp #b0 #b11110000 #b01111100010110000101001)))
; arg1 = -484163137115162411008.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101100 #b0010000110)
                expect
                (fp #b1 #b11000011 #b1010010000)))
(assert (fp.leq (fp #b1 #b11000011 #b1010010000)
                expect
                (fp #b0 #b00000010 #b1001110111)))
; expect = -484227031934875729920.0

(assert (not (= expect result)))

(check-sat)
(exit)
