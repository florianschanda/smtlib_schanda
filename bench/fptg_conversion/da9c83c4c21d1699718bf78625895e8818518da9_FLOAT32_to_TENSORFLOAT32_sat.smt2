(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100110 #b00011100001110000101010)
                arg1
                (fp #b1 #b01111111 #b11110100011000110101101)))
(assert (fp.leq (fp #b1 #b01111111 #b11110100011000110101101)
                arg1
                (fp #b1 #b01010000 #b01111110010010000001111)))
; arg1 = -1.95464098453521728515625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010010 #b0111010000)
                expect
                (fp #b1 #b01111111 #b1111010010)))
(assert (fp.leq (fp #b1 #b01111111 #b1111010010)
                expect
                (fp #b1 #b00111011 #b1111000100)))
; expect = -1.955078125

(assert (= expect result))

(check-sat)
(exit)
