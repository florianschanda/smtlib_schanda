(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1001000011)
                arg1
                (fp #b0 #b01101 #b0001011010)))
(assert (fp.leq (fp #b0 #b01101 #b0001011010)
                arg1
                (fp #b0 #b10001 #b1101100110)))
; arg1 = 0.27197265625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                expect
                (fp #b0 #b001 #b0010)))
(assert (fp.leq (fp #b0 #b001 #b0010)
                expect
                (fp #b0 #b011 #b0001)))
; expect = 0.28125

(assert (not (= expect result)))

(check-sat)
(exit)
