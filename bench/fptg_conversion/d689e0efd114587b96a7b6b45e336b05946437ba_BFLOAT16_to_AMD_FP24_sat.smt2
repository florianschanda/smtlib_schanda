; Format from: BFLOAT16
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b0101000)
                arg1
                (fp #b1 #b01111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111 #b0100111)
                arg1
                (fp #b1 #b01010001 #b0011001)))
; arg1 = -1.3046875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b1101001101001110)
                expect
                (fp #b1 #b0111111 #b0100111000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0100111000000000)
                expect
                (fp #b0 #b0110000 #b0011110000101110)))
; expect = -1.3046875

(assert (= expect result))

(check-sat)
(exit)
