; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01111011 #b10111000011000001010001)
                arg1
                (fp #b0 #b10011101 #b00000111101001011001111)))
(assert (fp.leq (fp #b0 #b10011101 #b00000111101001011001111)
                arg1
                (fp #b0 #b10101011 #b01110011101010100110101)))
; arg1 = 1105815424.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
