(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011010 #b01000011)
                arg1
                (fp #b0 #b000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b000000000 #b01010111)
                arg1
                (fp #b0 #b110011101 #b00100100)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result ((_ to_fp 10 4) rm arg1)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1011111010 #b111)
                expect
                (fp #b0 #b0011111111 #b011)))
(assert (fp.leq (fp #b0 #b0011111111 #b011)
                expect
                (fp #b0 #b0100001000 #b000)))

(assert (= expect result))

(check-sat)
(exit)
