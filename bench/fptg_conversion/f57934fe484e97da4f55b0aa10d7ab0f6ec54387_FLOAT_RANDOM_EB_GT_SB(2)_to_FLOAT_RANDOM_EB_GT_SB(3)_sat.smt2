; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b10010011 #b0)
                arg1
                (fp #b1 #b10000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000 #b1)
                arg1
                (fp #b0 #b00110000 #b0)))
; arg1 = -3.0

(declare-const result (_ FloatingPoint 14 6))
(assert (= result ((_ to_fp 14 6) rm arg1)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11010000110111 #b10001)
                expect
                (fp #b1 #b10000000000000 #b10000)))
(assert (fp.leq (fp #b1 #b10000000000000 #b10000)
                expect
                (fp #b1 #b00101111011110 #b11101)))

(assert (= expect result))

(check-sat)
(exit)
