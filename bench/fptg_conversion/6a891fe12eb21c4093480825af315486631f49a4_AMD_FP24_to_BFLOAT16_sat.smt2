; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0101100010000100)
                arg1
                (fp #b1 #b1110111 #b0101111001111001)))
(assert (fp.leq (fp #b1 #b1110111 #b0101111001111001)
                arg1
                (fp #b1 #b1010100 #b0000010101110100)))
; arg1 = -98649282755690496.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11101011 #b1000100)
                expect
                (fp #b1 #b10110111 #b0110000)))
(assert (fp.leq (fp #b1 #b10110111 #b0110000)
                expect
                (fp #b0 #b00001111 #b0011100)))
; expect = -99079191802150912.0

(assert (= expect result))

(check-sat)
(exit)
