(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10000000 #b01001001101100011101000)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b11110100 #b11011100111100100110010)))
; arg1 = 838177.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b100101100011000 #b011111001101111111010101010001010010101001001110101001101111110)
                expect
                (fp #b0 #b100000000010010 #b100110010100010000100000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000010010 #b100110010100010000100000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b101011010001000 #b111101010100011010111010101010010100101010011010111010101100000)))

(assert (= expect result))

(check-sat)
(exit)
