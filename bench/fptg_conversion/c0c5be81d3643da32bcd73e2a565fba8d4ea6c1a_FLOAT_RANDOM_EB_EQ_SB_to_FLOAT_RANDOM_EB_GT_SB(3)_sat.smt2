; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100110100111001001 #b00101110101110011)
                arg1
                (fp #b0 #b011111111111111111 #b00011001101001010)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b00011001101001010)
                arg1
                (fp #b0 #b101101101100001010 #b01111111010001010)))

(declare-const result (_ FloatingPoint 8 2))
(assert (= result ((_ to_fp 8 2) rm arg1)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11001101 #b0)
                expect
                (fp #b0 #b01111111 #b1)))
(assert (fp.leq (fp #b0 #b01111111 #b1)
                expect
                (fp #b0 #b10001110 #b0)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
