(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100000000 #b1101101001001001101001011011010000101110111101101011)
                expect
                (fp #b1 #b10000000110 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000110 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b00110010011 #b0101000000011101010011010111100011010000111010100000)))

(assert (= expect result))

(check-sat)
(exit)
