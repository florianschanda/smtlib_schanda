(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b1 #b1111100 #b10)
                arg1
                (fp #b1 #b1001000 #b01)))
(assert (fp.leq (fp #b1 #b1001000 #b01)
                arg1
                (fp #b1 #b0011100 #b01)))
; arg1 = -640.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111010 #b10000111101101011110100)
                expect
                (fp #b1 #b10001000 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b10001000 #b01000000000000000000000)
                expect
                (fp #b0 #b00101010 #b11100111100110001010010)))
; expect = -640.0

(assert (= expect result))

(check-sat)
(exit)
