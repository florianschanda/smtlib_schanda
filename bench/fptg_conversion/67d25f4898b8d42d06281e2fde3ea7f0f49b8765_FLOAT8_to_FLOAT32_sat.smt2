(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011 #b0100)
                arg1
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg1
                (fp #b0 #b100 #b1111)))
; arg1 = 0.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00111001 #b01011011101110010010000)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000)
                expect
                (fp #b0 #b10101111 #b11110111011011111010000)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
