(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1000)))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b101 #b0000)))
; arg1 = -12.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001100001 #b1111001010011001011111010000001011001000001010011101)
                expect
                (fp #b1 #b10000000010 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000010 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11011101011 #b0101100100101100000001111011110101000000100011001100)))

(assert (= expect result))

(check-sat)
(exit)
