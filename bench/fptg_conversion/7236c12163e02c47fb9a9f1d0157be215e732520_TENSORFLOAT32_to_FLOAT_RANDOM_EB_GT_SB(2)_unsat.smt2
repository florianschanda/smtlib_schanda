(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110011 #b1)
                expect
                (fp #b0 #b000000 #b1)))
(assert (fp.leq (fp #b0 #b000000 #b1)
                expect
                (fp #b0 #b011101 #b1)))
; expect = 0.0000000004656612873077392578125

(assert (not (= expect result)))

(check-sat)
