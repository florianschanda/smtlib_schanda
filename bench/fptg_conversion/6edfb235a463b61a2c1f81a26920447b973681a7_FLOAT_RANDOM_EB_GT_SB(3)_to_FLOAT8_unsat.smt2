(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b101011110110101 #b001)
                arg1
                (fp #b1 #b001111111111110 #b011)))
(assert (fp.leq (fp #b1 #b001111111111110 #b011)
                arg1
                (fp #b1 #b001101101001111 #b010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1001)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b010 #b1010)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
