; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01011011 #b00101111011100110001111)
                arg1
                (fp #b0 #b01100100 #b10101011010010001101101)))
(assert (fp.leq (fp #b0 #b01100100 #b10101011010010001101101)
                arg1
                (fp #b0 #b11001000 #b10010101000100001011110)))
; arg1 = 0.00000001243561786878899511066265404224395751953125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b0110001000)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10001 #b1111110001)))
; expect = 0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
