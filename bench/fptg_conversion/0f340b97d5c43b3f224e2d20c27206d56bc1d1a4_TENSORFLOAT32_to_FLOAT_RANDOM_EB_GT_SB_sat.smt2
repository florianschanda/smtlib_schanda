(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111011 #b0101100000)
                arg1
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                arg1
                (fp #b1 #b00101001 #b1001111011)))
; arg1 = -1.98828125

(declare-const result (_ FloatingPoint 12 7))
(assert (= result ((_ to_fp 12 7) rm arg1)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111110100100 #b101000)
                expect
                (fp #b1 #b100000000000 #b000000)))
(assert (fp.leq (fp #b1 #b100000000000 #b000000)
                expect
                (fp #b0 #b110110011110 #b010101)))

(assert (= expect result))

(check-sat)
(exit)
