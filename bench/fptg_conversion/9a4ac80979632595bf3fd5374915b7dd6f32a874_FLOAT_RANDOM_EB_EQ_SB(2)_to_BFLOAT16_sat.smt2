(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg1
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                arg1
                (fp #b0 #b0000 #b101)))
; arg1 = -0.001953125

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101111 #b0110011)
                expect
                (fp #b1 #b01110110 #b0000000)))
(assert (fp.leq (fp #b1 #b01110110 #b0000000)
                expect
                (fp #b1 #b00010001 #b1101101)))
; expect = -0.001953125

(assert (= expect result))

(check-sat)
(exit)
