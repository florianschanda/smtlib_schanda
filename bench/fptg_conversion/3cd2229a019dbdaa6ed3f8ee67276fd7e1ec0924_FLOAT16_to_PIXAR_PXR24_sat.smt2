; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0001001011)
                arg1
                (fp #b0 #b00001 #b0001001010)))
(assert (fp.leq (fp #b0 #b00001 #b0001001010)
                arg1
                (fp #b0 #b10001 #b0110011111)))
; arg1 = 0.00006544589996337890625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101010 #b001011011101000)
                expect
                (fp #b0 #b01110001 #b000100101000000)))
(assert (fp.leq (fp #b0 #b01110001 #b000100101000000)
                expect
                (fp #b0 #b10000101 #b000011011001011)))
; expect = 0.00006544589996337890625

(assert (= expect result))

(check-sat)
(exit)
