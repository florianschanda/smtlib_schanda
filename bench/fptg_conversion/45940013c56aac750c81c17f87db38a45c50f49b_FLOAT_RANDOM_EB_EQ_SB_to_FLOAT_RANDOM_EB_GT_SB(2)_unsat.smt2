(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b1)
                expect
                (fp #b1 #b1011 #b0)))
(assert (fp.leq (fp #b1 #b1011 #b0)
                expect
                (fp #b0 #b0100 #b1)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
