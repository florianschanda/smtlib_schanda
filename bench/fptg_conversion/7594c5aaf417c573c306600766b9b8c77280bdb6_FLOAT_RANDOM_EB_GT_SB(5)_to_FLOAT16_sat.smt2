(assert (fp.leq (fp #b0 #b00011 #b0010101011)
                expect
                (fp #b0 #b01111 #b1011100000)))
(assert (fp.leq (fp #b0 #b01111 #b1011100000)
                expect
                (fp #b0 #b10101 #b1100010001)))
; expect = 1.71875

(assert (= expect result))

