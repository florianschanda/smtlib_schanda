                expect
                (fp #b1 #b01110000 #b1111111110)))
(assert (fp.leq (fp #b1 #b01110000 #b1111111110)
                expect
                (fp #b0 #b01101110 #b0001010001)))
; expect = -0.000060975551605224609375

