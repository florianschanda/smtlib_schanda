; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1110001100110110)
                arg1
                (fp #b1 #b1001111 #b0101110100010011)))
(assert (fp.leq (fp #b1 #b1001111 #b0101110100010011)
                arg1
                (fp #b1 #b0011101 #b1010101001110010)))
; arg1 = -89363.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100110 #b1000100100)
                expect
                (fp #b1 #b10001111 #b0101110101)))
(assert (fp.leq (fp #b1 #b10001111 #b0101110101)
                expect
                (fp #b0 #b11011011 #b0010011011)))
; expect = -89408.0

(assert (not (= expect result)))

(check-sat)
(exit)
