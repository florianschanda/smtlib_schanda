; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1101000111)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b00010 #b0000111001)))
; arg1 = 0.000060558319091796875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00111101 #b0111101)
                expect
                (fp #b0 #b01110000 #b1111110)))
(assert (fp.leq (fp #b0 #b01110000 #b1111110)
                expect
                (fp #b0 #b11011100 #b0101101)))
; expect = 0.000060558319091796875

(assert (= expect result))

(check-sat)
(exit)
