(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                arg1
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = 0.125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100011 #b00110011110000111101111)
                expect
                (fp #b0 #b01111100 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111100 #b00000000000000000000000)
                expect
                (fp #b0 #b11011010 #b00000000011110101101101)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
