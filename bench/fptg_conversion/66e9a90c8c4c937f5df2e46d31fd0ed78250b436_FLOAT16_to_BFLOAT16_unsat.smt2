; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1100000111)
                arg1
                (fp #b0 #b01001 #b1111001110)))
(assert (fp.leq (fp #b0 #b01001 #b1111001110)
                arg1
                (fp #b0 #b10101 #b0001100011)))
; arg1 = 0.030487060546875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001011 #b0001010)
                expect
                (fp #b0 #b01111001 #b1111010)))
(assert (fp.leq (fp #b0 #b01111001 #b1111010)
                expect
                (fp #b0 #b11000001 #b0011011)))
; expect = 0.030517578125

(assert (not (= expect result)))

(check-sat)
(exit)
