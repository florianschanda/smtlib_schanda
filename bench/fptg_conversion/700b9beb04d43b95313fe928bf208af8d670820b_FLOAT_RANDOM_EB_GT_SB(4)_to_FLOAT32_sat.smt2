; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b001001 #b0)
                arg1
                (fp #b0 #b011011 #b1)))
(assert (fp.leq (fp #b0 #b011011 #b1)
                arg1
                (fp #b0 #b100100 #b0)))
; arg1 = 0.09375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011011 #b01100101111101011001011)
                expect
                (fp #b0 #b01111011 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111011 #b10000000000000000000000)
                expect
                (fp #b0 #b10000111 #b00111101101111101100100)))
; expect = 0.09375

(assert (= expect result))

(check-sat)
(exit)
