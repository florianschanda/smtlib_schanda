(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101001 #b01010010001101001000011)
                arg1
                (fp #b1 #b01111111 #b01000101000011100000101)))
(assert (fp.leq (fp #b1 #b01111111 #b01000101000011100000101)
                arg1
                (fp #b1 #b01011111 #b11100010001010011110000)))
; arg1 = -1.26974546909332275390625

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010001 #b010101010010100)
                expect
                (fp #b1 #b01111111 #b010001010001000)))
(assert (fp.leq (fp #b1 #b01111111 #b010001010001000)
                expect
                (fp #b1 #b01010101 #b010011001001101)))
; expect = -1.269775390625

(assert (= expect result))

(check-sat)
(exit)
