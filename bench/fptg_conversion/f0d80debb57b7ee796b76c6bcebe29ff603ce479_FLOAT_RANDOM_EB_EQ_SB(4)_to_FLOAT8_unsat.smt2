(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                expect
                (fp #b1 #b011 #b0000)))
(assert (fp.leq (fp #b1 #b011 #b0000)
                expect
                (fp #b0 #b000 #b0011)))
; expect = -1.0

(assert (not (= expect result)))

(check-sat)
