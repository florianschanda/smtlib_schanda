; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1001011101)
                arg1
                (fp #b0 #b00000 #b0111111111)))
(assert (fp.leq (fp #b0 #b00000 #b0111111111)
                arg1
                (fp #b0 #b11000 #b1010101100)))
; arg1 = 0.000030457973480224609375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001010 #b00000111010011000101110)
                expect
                (fp #b0 #b01101111 #b11111111000000000000000)))
(assert (fp.leq (fp #b0 #b01101111 #b11111111000000000000000)
                expect
                (fp #b0 #b10000101 #b00101000011110110110010)))
; expect = 0.000030457973480224609375

(assert (not (= expect result)))

(check-sat)
(exit)
