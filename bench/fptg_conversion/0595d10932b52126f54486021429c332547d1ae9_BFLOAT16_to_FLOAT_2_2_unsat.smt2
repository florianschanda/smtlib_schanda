; Format from: BFLOAT16
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010100 #b1011011)
                arg1
                (fp #b0 #b01111111 #b1011011)))
(assert (fp.leq (fp #b0 #b01111111 #b1011011)
                arg1
                (fp #b0 #b10001100 #b1110000)))
; arg1 = 1.7109375

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                expect
                (fp #b0 #b10 #b1)))
; expect = 2.0

(assert (not (= expect result)))

(check-sat)
(exit)
