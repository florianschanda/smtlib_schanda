; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111111 #b00011110)
                arg1
                (fp #b1 #b000000000 #b00011110)))
(assert (fp.leq (fp #b1 #b000000000 #b00011110)
                arg1
                (fp #b0 #b000110010 #b11010011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011001 #b0111111101110001)
                expect
                (fp #b1 #b0000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000001)
                expect
                (fp #b0 #b1110011 #b0111001110010000)))
; expect = -0.000000000000000000000003308722450212110699485634768279851414263248443603515625

(assert (= expect result))

(check-sat)
(exit)
