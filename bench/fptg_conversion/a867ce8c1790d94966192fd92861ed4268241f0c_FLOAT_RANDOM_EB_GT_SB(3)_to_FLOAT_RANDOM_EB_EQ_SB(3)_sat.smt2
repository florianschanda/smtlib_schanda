(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011011101010001 #b101111111111001)
                expect
                (fp #b0 #b1001010101010111 #b010000000000000)))
(assert (fp.leq (fp #b0 #b1001010101010111 #b010000000000000)
                expect
                (fp #b0 #b1011101011101000 #b111010001110110)))

(assert (= expect result))

(check-sat)
