; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10011 #b1001)
                arg1
                (fp #b1 #b10010 #b1111)))
(assert (fp.leq (fp #b1 #b10010 #b1111)
                arg1
                (fp #b0 #b10100 #b0100)))
; arg1 = -15.5

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                expect
                (fp #b1 #b110 #b1111)))
(assert (fp.leq (fp #b1 #b110 #b1111)
                expect
                (fp #b1 #b001 #b1101)))
; expect = -15.5

(assert (= expect result))

(check-sat)
(exit)
