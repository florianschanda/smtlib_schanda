(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101000 #b01111)
                expect
                (fp #b1 #b000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000 #b00001)
                expect
                (fp #b0 #b110111 #b10000)))
; expect = -0.00000000002910383045673370361328125

