(declare-const result (_ FloatingPoint 16 5))
(assert (= result ((_ to_fp 16 5) rm arg1)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1011111001010110 #b1010)
                expect
                (fp #b1 #b1000000001001111 #b0111)))
(assert (fp.leq (fp #b1 #b1000000001001111 #b0111)
                expect
                (fp #b0 #b1100100111000111 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
