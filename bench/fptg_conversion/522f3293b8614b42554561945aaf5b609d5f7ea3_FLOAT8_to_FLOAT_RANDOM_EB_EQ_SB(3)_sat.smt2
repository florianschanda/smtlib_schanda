; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0100)
                arg1
                (fp #b1 #b011 #b1101)))
(assert (fp.leq (fp #b1 #b011 #b1101)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -1.8125

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110011000 #b1011111011)
                expect
                (fp #b1 #b01111111111 #b1101000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b1101000000)
                expect
                (fp #b0 #b10001100101 #b1101011100)))

(assert (= expect result))

(check-sat)
(exit)
