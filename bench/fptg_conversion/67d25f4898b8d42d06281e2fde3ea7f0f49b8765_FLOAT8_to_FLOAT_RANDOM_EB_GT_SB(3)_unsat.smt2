(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011 #b0100)
                arg1
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg1
                (fp #b0 #b100 #b1111)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01110001110 #b0101010)
                expect
                (fp #b0 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000)
                expect
                (fp #b0 #b11010011011 #b1101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
