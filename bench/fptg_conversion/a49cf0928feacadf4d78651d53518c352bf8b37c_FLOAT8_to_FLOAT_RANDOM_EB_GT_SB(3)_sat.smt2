; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b1 #b101 #b0100)))
(assert (fp.leq (fp #b1 #b101 #b0100)
                arg1
                (fp #b0 #b011 #b0100)))
; arg1 = -5.0

(declare-const result (_ FloatingPoint 12 9))
(assert (= result ((_ to_fp 12 9) rm arg1)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111001001001 #b10001011)
                expect
                (fp #b1 #b100000000001 #b01000000)))
(assert (fp.leq (fp #b1 #b100000000001 #b01000000)
                expect
                (fp #b1 #b011110011101 #b10011000)))

(assert (= expect result))

(check-sat)
(exit)
