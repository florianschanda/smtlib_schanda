(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101100 #b10011000100111010011010)
                arg1
                (fp #b0 #b00000000 #b10001100001001000101000)))
(assert (fp.leq (fp #b0 #b00000000 #b10001100001001000101000)
                arg1
                (fp #b0 #b01010110 #b01111110001111000100000)))
; arg1 = 0.00000000000000000000000000000000000000643499796632156655894968143303728758074901792110319567855811274709361413659536310660769231617450714111328125

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b1)
                expect
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                expect
                (fp #b0 #b100 #b1)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
