; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010011 #b000)
                arg1
                (fp #b0 #b100010 #b101)))
(assert (fp.leq (fp #b0 #b100010 #b101)
                arg1
                (fp #b0 #b111101 #b110)))
; arg1 = 13.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010010 #b1001010111110111)
                expect
                (fp #b0 #b1000010 #b1010000000000000)))
(assert (fp.leq (fp #b0 #b1000010 #b1010000000000000)
                expect
                (fp #b0 #b1110001 #b0110100001011001)))
; expect = 13.0

(assert (= expect result))

(check-sat)
(exit)
