; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0111110100)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b00011 #b1101100101)))
; arg1 = -0.000039398670196533203125

(declare-const result (_ FloatingPoint 17 5))
(assert (= result ((_ to_fp 17 5) rm arg1)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11101111110001001 #b1100)
                expect
                (fp #b1 #b01111111111110000 #b0101)))
(assert (fp.leq (fp #b1 #b01111111111110000 #b0101)
                expect
                (fp #b0 #b00110011010101001 #b0010)))

(assert (not (= expect result)))

(check-sat)
(exit)
