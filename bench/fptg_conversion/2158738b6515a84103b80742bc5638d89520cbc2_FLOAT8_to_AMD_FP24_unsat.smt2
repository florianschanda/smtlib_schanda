; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1001)
                arg1
                (fp #b1 #b101 #b0110)))
(assert (fp.leq (fp #b1 #b101 #b0110)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -5.5

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001010 #b0110001011000111)
                expect
                (fp #b1 #b1000001 #b0110000000000000)))
(assert (fp.leq (fp #b1 #b1000001 #b0110000000000000)
                expect
                (fp #b0 #b0001011 #b1001000010110010)))
; expect = -5.5

(assert (not (= expect result)))

(check-sat)
(exit)
