(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1110111110001011)
                arg1
                (fp #b1 #b1001101 #b0001110100010110)))
(assert (fp.leq (fp #b1 #b1001101 #b0001110100010110)
                arg1
                (fp #b0 #b1010011 #b0100110000101001)))
; arg1 = -18245.5

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001100 #b1000010)
                expect
                (fp #b1 #b10001101 #b0001111)))
(assert (fp.leq (fp #b1 #b10001101 #b0001111)
                expect
                (fp #b0 #b11101110 #b1001101)))
; expect = -18304.0

(assert (= expect result))

(check-sat)
(exit)
