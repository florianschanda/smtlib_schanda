; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b101 #b0001)))
(assert (fp.leq (fp #b1 #b101 #b0001)
                arg1
                (fp #b1 #b011 #b0000)))
; arg1 = -4.25

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111100 #b0110100)
                expect
                (fp #b1 #b10000001 #b0001000)))
(assert (fp.leq (fp #b1 #b10000001 #b0001000)
                expect
                (fp #b1 #b00000110 #b0110010)))
; expect = -4.25

(assert (not (= expect result)))

(check-sat)
(exit)
