(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT64
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011011001 #b0000110010001111100010101010011001010001101001111101)
                arg1
                (fp #b1 #b01111111111 #b1101000110001101010000000001101100000010101110101011)))
(assert (fp.leq (fp #b1 #b01111111111 #b1101000110001101010000000001101100000010101110101011)
                arg1
                (fp #b0 #b11111001001 #b1001001111001011001000001111010001111011110011001011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001111 #b0000000)
                expect
                (fp #b1 #b01111111 #b1101001)))
(assert (fp.leq (fp #b1 #b01111111 #b1101001)
                expect
                (fp #b0 #b10010000 #b0110110)))
; expect = -1.8203125

(assert (= expect result))

(check-sat)
(exit)
