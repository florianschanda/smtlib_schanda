; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b110 #b0010)))
(assert (fp.leq (fp #b1 #b110 #b0010)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -9.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110011100 #b1111100000000110100010011100000111111011011001100101)
                expect
                (fp #b1 #b10000000010 #b0010000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000010 #b0010000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11101011101 #b1110000101110111011011110001010100001101000110111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
