; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b0 #b00 #b0)
                arg1
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                arg1
                (fp #b0 #b11 #b0)))
; arg1 = 2.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010010011101111 #b110000111010111)
                expect
                (fp #b0 #b1000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1000000000000000 #b000000000000000)
                expect
                (fp #b0 #b1000010110010111 #b010101101001111)))

(assert (= expect result))

(check-sat)
(exit)
