(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110011 #b1011011011)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b10011110 #b0100101110)))
; arg1 = 1.59765625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010000 #b10111101001011010100101)
                expect
                (fp #b0 #b01111111 #b10011001000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10011001000000000000000)
                expect
                (fp #b0 #b10111000 #b11100010001101000001000)))
; expect = 1.59765625

(assert (= expect result))

(check-sat)
(exit)
