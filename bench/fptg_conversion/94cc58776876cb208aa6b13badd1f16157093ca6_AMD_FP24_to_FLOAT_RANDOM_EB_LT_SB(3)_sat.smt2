; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b0010010100101110)
                arg1
                (fp #b0 #b1010100 #b1001011001010011)))
(assert (fp.leq (fp #b0 #b1010100 #b1001011001010011)
                arg1
                (fp #b0 #b1010111 #b0100110011100001)))
; arg1 = 3328608.0

(declare-const result (_ FloatingPoint 7 11))
(assert (= result ((_ to_fp 7 11) rm arg1)))

(declare-const expect (_ FloatingPoint 7 11))
(assert (fp.leq (fp #b0 #b1010001 #b1100110011)
                expect
                (fp #b0 #b1010100 #b1001011010)))
(assert (fp.leq (fp #b0 #b1010100 #b1001011010)
                expect
                (fp #b0 #b1110001 #b0100100111)))
; expect = 3330048.0

(assert (= expect result))

(check-sat)
(exit)
