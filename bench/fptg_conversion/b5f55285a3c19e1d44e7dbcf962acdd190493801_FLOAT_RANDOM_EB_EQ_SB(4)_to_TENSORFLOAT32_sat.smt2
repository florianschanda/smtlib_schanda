(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10000100110000010 #b1100000101100110)
                arg1
                (fp #b1 #b01111111111111111 #b1101010111010100)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1101010111010100)
                arg1
                (fp #b0 #b10000000001100101 #b0001011000010101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100000 #b1110010001)
                expect
                (fp #b1 #b01111111 #b1101011000)))
(assert (fp.leq (fp #b1 #b01111111 #b1101011000)
                expect
                (fp #b0 #b10110010 #b1000011101)))
; expect = -1.8359375

(assert (= expect result))

(check-sat)
