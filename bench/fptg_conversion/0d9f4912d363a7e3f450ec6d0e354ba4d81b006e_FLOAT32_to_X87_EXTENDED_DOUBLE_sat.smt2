; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11111001010110101100000)
                arg1
                (fp #b0 #b01111111 #b00010001000010101011100)))
(assert (fp.leq (fp #b0 #b01111111 #b00010001000010101011100)
                arg1
                (fp #b0 #b11010000 #b00110101100001110001101)))
; arg1 = 1.066569805145263671875

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b011101110001010 #b100100010001101100111111111011011100000101111110111011101100011)
                expect
                (fp #b0 #b011111111111111 #b000100010000101010111000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b000100010000101010111000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b101010011000101 #b000011111010001011010001010010011110101101000010111101111010001)))

(assert (= expect result))

(check-sat)
(exit)
