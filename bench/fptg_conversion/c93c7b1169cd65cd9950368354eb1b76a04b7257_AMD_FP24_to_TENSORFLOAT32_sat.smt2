; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b0000001100111011)
                arg1
                (fp #b1 #b1100000 #b1111110001110100)))
(assert (fp.leq (fp #b1 #b1100000 #b1111110001110100)
                arg1
                (fp #b0 #b1101000 #b0010111100000100)))
; arg1 = -17060855808.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111110 #b0011111110)
                expect
                (fp #b1 #b10100000 #b1111110010)))
(assert (fp.leq (fp #b1 #b10100000 #b1111110010)
                expect
                (fp #b0 #b01001011 #b0011111111)))
; expect = -17062428672.0

(assert (= expect result))

(check-sat)
(exit)
