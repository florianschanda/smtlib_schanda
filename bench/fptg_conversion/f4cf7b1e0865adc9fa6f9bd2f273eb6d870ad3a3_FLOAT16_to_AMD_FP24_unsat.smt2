                expect
                (fp #b1 #b1001001 #b0000110001000000)))
(assert (fp.leq (fp #b1 #b1001001 #b0000110001000000)
                expect
                (fp #b1 #b0100110 #b0101100011001101)))
; expect = -1073.0

