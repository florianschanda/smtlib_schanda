(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0101001011)
                arg1
                (fp #b1 #b11011 #b1100111101)))
(assert (fp.leq (fp #b1 #b11011 #b1100111101)
                arg1
                (fp #b1 #b01000 #b1010011001)))
; arg1 = -7412.0

(declare-const result (_ FloatingPoint 13 7))
(assert (= result ((_ to_fp 13 7) rm arg1)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1000110010111 #b010010)
                expect
                (fp #b1 #b1000000001011 #b110100)))
(assert (fp.leq (fp #b1 #b1000000001011 #b110100)
                expect
                (fp #b0 #b0001100100011 #b101001)))

(assert (= expect result))

(check-sat)
(exit)
