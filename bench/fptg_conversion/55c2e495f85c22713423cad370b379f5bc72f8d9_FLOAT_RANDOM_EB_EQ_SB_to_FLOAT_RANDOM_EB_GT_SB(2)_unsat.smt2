(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100010 #b111101110)
                arg1
                (fp #b0 #b0000000001 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000001 #b000000000)
                arg1
                (fp #b0 #b0011011100 #b001101110)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b0011 #b10)
                expect
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                expect
                (fp #b0 #b0011 #b00)))
; expect = 0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
