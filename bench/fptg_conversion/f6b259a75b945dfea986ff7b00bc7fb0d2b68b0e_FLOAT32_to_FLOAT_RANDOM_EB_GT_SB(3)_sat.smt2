(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110110 #b01000000100011010100010)
                arg1
                (fp #b1 #b10100001 #b00100111011010010000100)))
(assert (fp.leq (fp #b1 #b10100001 #b00100111011010010000100)
                arg1
                (fp #b0 #b11001001 #b10100100001111010000000)))
; arg1 = -19824648192.0

(declare-const result (_ FloatingPoint 8 7))
(assert (= result ((_ to_fp 8 7) rm arg1)))

(declare-const expect (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b11111110 #b000011)
                expect
                (fp #b1 #b10100001 #b001010)))
(assert (fp.leq (fp #b1 #b10100001 #b001010)
                expect
                (fp #b0 #b01011001 #b001010)))
; expect = -19864223744.0

(assert (= expect result))

(check-sat)
(exit)
