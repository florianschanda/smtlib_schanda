(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01101101 #b0001010)
                arg1
                (fp #b1 #b01010011 #b0010101)))
(assert (fp.leq (fp #b1 #b01010011 #b0010101)
                arg1
                (fp #b0 #b01110110 #b0001001)))
; arg1 = -0.000000000000066169292267659329809248447418212890625

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b011 #b1)
                expect
                (fp #b1 #b000 #b1)))
(assert (fp.leq (fp #b1 #b000 #b1)
                expect
                (fp #b0 #b001 #b1)))
; expect = -0.125

(assert (= expect result))

(check-sat)
(exit)
