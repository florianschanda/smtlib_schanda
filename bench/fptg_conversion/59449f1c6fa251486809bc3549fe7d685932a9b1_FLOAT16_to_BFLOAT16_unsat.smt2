(assert (fp.leq (fp #b0 #b00101011 #b0111110)
                expect
                (fp #b0 #b10001010 #b0010000)))
(assert (fp.leq (fp #b0 #b10001010 #b0010000)
                expect
                (fp #b0 #b11011000 #b1000100)))
; expect = 2304.0

(assert (not (= expect result)))

