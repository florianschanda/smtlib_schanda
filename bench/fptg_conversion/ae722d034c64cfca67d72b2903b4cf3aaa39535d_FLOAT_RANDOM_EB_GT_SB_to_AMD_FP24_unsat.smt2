(assert (fp.leq (fp #b1 #b1100101 #b0010110110000100)
                expect
                (fp #b0 #b1000001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000001 #b0000000000000000)
                expect
                (fp #b0 #b1000100 #b1111101010100000)))
; expect = 4.0

(assert (not (= expect result)))

