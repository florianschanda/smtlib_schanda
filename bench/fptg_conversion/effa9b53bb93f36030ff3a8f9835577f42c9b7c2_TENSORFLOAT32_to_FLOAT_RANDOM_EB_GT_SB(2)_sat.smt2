; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101101 #b1000001000)
                arg1
                (fp #b1 #b10001001 #b0000110001)))
(assert (fp.leq (fp #b1 #b10001001 #b0000110001)
                arg1
                (fp #b1 #b01111010 #b1011101100)))
; arg1 = -1073.0

(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11000110011 #b1001010)
                expect
                (fp #b1 #b10000001001 #b0000111)))
(assert (fp.leq (fp #b1 #b10000001001 #b0000111)
                expect
                (fp #b1 #b00110011001 #b0100111)))

(assert (= expect result))

(check-sat)
(exit)
