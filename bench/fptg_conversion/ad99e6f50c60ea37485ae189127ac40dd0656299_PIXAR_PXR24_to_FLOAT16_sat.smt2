; Format from: PIXAR_PXR24
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100001 #b111110101001011)
                arg1
                (fp #b1 #b01111111 #b011011010011101)))
(assert (fp.leq (fp #b1 #b01111111 #b011011010011101)
                arg1
                (fp #b0 #b00111001 #b010000000110100)))
; arg1 = -1.426666259765625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b1011000111)
                expect
                (fp #b1 #b01111 #b0110110101)))
(assert (fp.leq (fp #b1 #b01111 #b0110110101)
                expect
                (fp #b1 #b01111 #b0100000011)))
; expect = -1.4267578125

(assert (= expect result))

(check-sat)
(exit)
