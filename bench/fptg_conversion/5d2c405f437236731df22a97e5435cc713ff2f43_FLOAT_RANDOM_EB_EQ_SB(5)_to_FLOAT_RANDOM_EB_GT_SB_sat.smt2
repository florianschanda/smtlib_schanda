(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg1
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                arg1
                (fp #b0 #b001 #b00)))
; arg1 = 0.0625

(declare-const result (_ FloatingPoint 14 3))
(assert (= result ((_ to_fp 14 3) rm arg1)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10111000011000 #b01)
                expect
                (fp #b0 #b01111111111011 #b00)))
(assert (fp.leq (fp #b0 #b01111111111011 #b00)
                expect
                (fp #b0 #b11011010010010 #b01)))

(assert (= expect result))

(check-sat)
(exit)
