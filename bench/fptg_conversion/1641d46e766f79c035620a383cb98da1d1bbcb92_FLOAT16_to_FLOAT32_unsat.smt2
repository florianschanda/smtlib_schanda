; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1000111110)
                arg1
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                arg1
                (fp #b1 #b11001 #b1100010111)))
; arg1 = -3788.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101001 #b01011110001010011011000)
                expect
                (fp #b1 #b10001010 #b11011001100000000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b11011001100000000000000)
                expect
                (fp #b0 #b01111000 #b01100011001111110010111)))
; expect = -3788.0

(assert (not (= expect result)))

(check-sat)
(exit)
