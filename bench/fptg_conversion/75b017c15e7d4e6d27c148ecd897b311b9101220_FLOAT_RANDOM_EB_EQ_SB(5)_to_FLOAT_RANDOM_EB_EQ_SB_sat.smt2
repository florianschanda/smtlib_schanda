(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b000)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = -0.00390625

(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100111001100 #b1111011101100)
                expect
                (fp #b1 #b01111111110111 #b0000000000000)))
(assert (fp.leq (fp #b1 #b01111111110111 #b0000000000000)
                expect
                (fp #b0 #b11010110000011 #b1010111110101)))

(assert (= expect result))

(check-sat)
(exit)
