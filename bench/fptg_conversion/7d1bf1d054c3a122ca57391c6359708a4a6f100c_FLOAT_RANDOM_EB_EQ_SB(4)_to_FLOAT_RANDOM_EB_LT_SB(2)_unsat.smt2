                expect
                (fp #b0 #b00 #b00000000001)))
(assert (fp.leq (fp #b0 #b00 #b00000000001)
                expect
                (fp #b0 #b10 #b10011110010)))
; expect = 0.00048828125

(assert (not (= expect result)))

