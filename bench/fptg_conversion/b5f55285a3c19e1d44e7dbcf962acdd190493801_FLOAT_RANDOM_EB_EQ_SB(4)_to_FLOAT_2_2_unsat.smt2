(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10000100110000010 #b1100000101100110)
                arg1
                (fp #b1 #b01111111111111111 #b1101010111010100)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1101010111010100)
                arg1
                (fp #b0 #b10000000001100101 #b0001011000010101)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b01 #b1)))
; expect = -2.0

(assert (not (= expect result)))

