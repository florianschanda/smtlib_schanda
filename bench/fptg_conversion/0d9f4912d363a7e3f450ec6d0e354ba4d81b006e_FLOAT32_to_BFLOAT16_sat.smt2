(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11111001010110101100000)
                arg1
                (fp #b0 #b01111111 #b00010001000010101011100)))
(assert (fp.leq (fp #b0 #b01111111 #b00010001000010101011100)
                arg1
                (fp #b0 #b11010000 #b00110101100001110001101)))
; arg1 = 1.066569805145263671875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00010100 #b1001111)
                expect
                (fp #b0 #b01111111 #b0001001)))
(assert (fp.leq (fp #b0 #b01111111 #b0001001)
                expect
                (fp #b0 #b11000011 #b1110100)))
; expect = 1.0703125

(assert (= expect result))

(check-sat)
(exit)
