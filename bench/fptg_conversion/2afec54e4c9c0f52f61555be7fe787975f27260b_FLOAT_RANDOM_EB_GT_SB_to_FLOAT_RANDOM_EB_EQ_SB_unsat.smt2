; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b010011110101 #b00)
                arg1
                (fp #b1 #b000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000 #b01)
                arg1
                (fp #b0 #b001111100011 #b01)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b011 #b10)
                expect
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                expect
                (fp #b0 #b010 #b00)))
; expect = -0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
