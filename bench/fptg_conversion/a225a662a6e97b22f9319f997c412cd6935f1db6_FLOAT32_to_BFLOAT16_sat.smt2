(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01000011 #b1111100)
                expect
                (fp #b0 #b11100001 #b0010011)))
(assert (fp.leq (fp #b0 #b11100001 #b0010011)
                expect
                (fp #b0 #b11110001 #b0010010)))
; expect = 363954371549901800820342521856.0

(assert (= expect result))

