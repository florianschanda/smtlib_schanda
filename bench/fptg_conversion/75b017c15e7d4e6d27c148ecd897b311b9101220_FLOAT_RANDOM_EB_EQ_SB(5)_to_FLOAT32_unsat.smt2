(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b000)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = -0.00390625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10000001 #b00010001011111011101100)
                expect
                (fp #b1 #b01110111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01110111 #b00000000000000000000000)
                expect
                (fp #b0 #b10101101 #b01111100010110000000100)))
; expect = -0.00390625

(assert (not (= expect result)))

(check-sat)
(exit)
