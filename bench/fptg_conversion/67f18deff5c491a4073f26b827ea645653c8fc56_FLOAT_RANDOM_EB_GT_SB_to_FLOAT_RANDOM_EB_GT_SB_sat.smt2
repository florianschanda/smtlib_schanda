; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b0 #b001 #b0)
                arg1
                (fp #b0 #b100 #b0)))
(assert (fp.leq (fp #b0 #b100 #b0)
                arg1
                (fp #b0 #b100 #b1)))
; arg1 = 2.0

(declare-const result (_ FloatingPoint 16 8))
(assert (= result ((_ to_fp 16 8) rm arg1)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b0 #b0111110111010111 #b1111100)
                expect
                (fp #b0 #b1000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000000000000 #b0000000)
                expect
                (fp #b0 #b1101010111110110 #b1011111)))

(assert (= expect result))

(check-sat)
(exit)
