(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010001 #b1100110)
                expect
                (fp #b1 #b10100000 #b0110101)))
(assert (fp.leq (fp #b1 #b10100000 #b0110101)
                expect
                (fp #b0 #b01111111 #b1001011)))
; expect = -12146704384.0

(assert (not (= expect result)))

