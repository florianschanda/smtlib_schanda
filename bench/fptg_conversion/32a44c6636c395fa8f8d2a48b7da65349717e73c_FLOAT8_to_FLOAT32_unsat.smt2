; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0011)
                arg1
                (fp #b0 #b101 #b1001)))
(assert (fp.leq (fp #b0 #b101 #b1001)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 6.25

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000110 #b01111100010010010111011)
                expect
                (fp #b0 #b10000001 #b10010000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b10010000000000000000000)
                expect
                (fp #b0 #b11000001 #b11101110111000011000011)))
; expect = 6.25

(assert (not (= expect result)))

(check-sat)
(exit)
