(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1100)
                arg1
                (fp #b1 #b000 #b0110)))
(assert (fp.leq (fp #b1 #b000 #b0110)
                arg1
                (fp #b0 #b000 #b1110)))
; arg1 = -0.09375

(declare-const result (_ FloatingPoint 10 8))
(assert (= result ((_ to_fp 10 8) rm arg1)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1011101100 #b1110101)
                expect
                (fp #b1 #b0111111011 #b1000000)))
(assert (fp.leq (fp #b1 #b0111111011 #b1000000)
                expect
                (fp #b0 #b1101111010 #b0100001)))

(assert (= expect result))

(check-sat)
(exit)
