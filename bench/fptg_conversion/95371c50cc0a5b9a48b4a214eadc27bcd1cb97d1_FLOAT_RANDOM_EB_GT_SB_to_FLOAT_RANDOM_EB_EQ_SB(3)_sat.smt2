                expect
                (fp #b1 #b100000000000001 #b10000000000000)))
(assert (fp.leq (fp #b1 #b100000000000001 #b10000000000000)
                expect
                (fp #b0 #b111100111001101 #b00111001110111)))

(assert (= expect result))

(check-sat)
