(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101100000111 #b101)
                arg1
                (fp #b0 #b100000000010 #b100)))
(assert (fp.leq (fp #b0 #b100000000010 #b100)
                arg1
                (fp #b0 #b111110000000 #b010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111111 #b00010101110101010010001)
                expect
                (fp #b0 #b10000010 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b10000000000000000000000)
                expect
                (fp #b0 #b11010100 #b10000000100101011000001)))
; expect = 12.0

(assert (= expect result))

(check-sat)
(exit)
