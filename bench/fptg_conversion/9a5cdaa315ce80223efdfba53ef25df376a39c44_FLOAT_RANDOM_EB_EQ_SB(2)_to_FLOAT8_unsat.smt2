(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1010)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b101 #b1110)))
; expect = -0.015625

(assert (not (= expect result)))

