(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b0001001111)
                arg1
                (fp #b0 #b11000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11000 #b0001001111)
                arg1
                (fp #b0 #b11110 #b1001101111)))
; arg1 = 551.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011011 #b00000011000100000010011)
                expect
                (fp #b0 #b10001000 #b00010011110000000000000)))
(assert (fp.leq (fp #b0 #b10001000 #b00010011110000000000000)
                expect
                (fp #b0 #b11101000 #b01001101000000111111011)))
; expect = 551.5

(assert (not (= expect result)))

(check-sat)
(exit)
