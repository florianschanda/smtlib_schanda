(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1001111010011011)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b1 #b0110101 #b1100101100100110)))
; arg1 = -4294934528.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001000 #b1111110101)
                expect
                (fp #b1 #b10011111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10011111 #b0000000000)
                expect
                (fp #b0 #b10011001 #b1001001100)))
; expect = -4294967296.0

(assert (= expect result))

(check-sat)
(exit)
