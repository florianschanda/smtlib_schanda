(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT64
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b0100001001)
                arg1
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                arg1
                (fp #b0 #b00011 #b0011101110)))
; arg1 = -1.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110011110 #b0100111100111010110011011010110011100101111101000000)
                expect
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b00110100101 #b1110101010000110110101000110110111100001000100111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
