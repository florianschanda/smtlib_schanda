; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b001101100111111001 #b01111001011110111)
                arg1
                (fp #b1 #b000000000000000000 #b11101011100011111)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b11101011100011111)
                arg1
                (fp #b0 #b011101111101000010 #b10001011110001011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0101)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b110 #b1001)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
