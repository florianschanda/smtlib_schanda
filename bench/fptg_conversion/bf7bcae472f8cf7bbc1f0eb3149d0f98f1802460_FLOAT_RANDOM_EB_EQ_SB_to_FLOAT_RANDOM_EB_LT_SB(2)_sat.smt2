; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11101 #b0101)
                arg1
                (fp #b0 #b10111 #b0000)))
(assert (fp.leq (fp #b0 #b10111 #b0000)
                arg1
                (fp #b0 #b11101 #b1110)))
; arg1 = 256.0

(declare-const result (_ FloatingPoint 9 10))
(assert (= result ((_ to_fp 9 10) rm arg1)))

(declare-const expect (_ FloatingPoint 9 10))
(assert (fp.leq (fp #b0 #b001001011 #b110101110)
                expect
                (fp #b0 #b100000111 #b000000000)))
(assert (fp.leq (fp #b0 #b100000111 #b000000000)
                expect
                (fp #b0 #b101101100 #b110110100)))

(assert (= expect result))

(check-sat)
(exit)
