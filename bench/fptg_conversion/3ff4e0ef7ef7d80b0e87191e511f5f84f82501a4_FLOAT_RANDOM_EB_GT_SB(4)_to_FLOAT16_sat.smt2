; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b000010 #b11)
                arg1
                (fp #b0 #b000000 #b10)))
(assert (fp.leq (fp #b0 #b000000 #b10)
                arg1
                (fp #b0 #b001000 #b00)))
; arg1 = 0.0000000004656612873077392578125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11001 #b0101100010)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b00011 #b1110010101)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
