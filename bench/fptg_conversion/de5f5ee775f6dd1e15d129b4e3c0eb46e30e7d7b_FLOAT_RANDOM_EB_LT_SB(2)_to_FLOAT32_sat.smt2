(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 28))
(assert (fp.leq (fp #b1 #b101111001101101 #b001011101001000001011000011)
                arg1
                (fp #b1 #b011111111111111 #b101101101101110110101011110)))
(assert (fp.leq (fp #b1 #b011111111111111 #b101101101101110110101011110)
                arg1
                (fp #b0 #b110011110101101 #b101101100001010010110010000)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101100 #b10000110010010011111100)
                expect
                (fp #b1 #b01111111 #b10110110110111011010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10110110110111011010110)
                expect
                (fp #b0 #b11111101 #b10000001001000101101000)))
; expect = -1.7143199443817138671875

(assert (= expect result))

(check-sat)
(exit)
