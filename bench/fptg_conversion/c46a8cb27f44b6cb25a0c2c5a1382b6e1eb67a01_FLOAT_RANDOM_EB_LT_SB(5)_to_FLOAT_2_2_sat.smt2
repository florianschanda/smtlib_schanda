(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 4 15))
(assert (fp.leq (fp #b1 #b1101 #b00110001100100)
                arg1
                (fp #b1 #b0000 #b00111010110000)))
(assert (fp.leq (fp #b1 #b0000 #b00111010110000)
                arg1
                (fp #b0 #b0000 #b01010111110110)))
; arg1 = -0.0035858154296875

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b11 #b0)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
