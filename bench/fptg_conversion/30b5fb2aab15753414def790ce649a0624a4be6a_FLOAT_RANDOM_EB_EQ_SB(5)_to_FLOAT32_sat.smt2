(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00101 #b1011)
                arg1
                (fp #b0 #b01000 #b0000)))
(assert (fp.leq (fp #b0 #b01000 #b0000)
                arg1
                (fp #b0 #b10011 #b1001)))
; arg1 = 0.0078125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100111 #b00010011111100010001100)
                expect
                (fp #b0 #b01111000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111000 #b00000000000000000000000)
                expect
                (fp #b0 #b11110101 #b01001011100010001101000)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
