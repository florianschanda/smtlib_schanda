; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011110 #b00000)
                arg1
                (fp #b0 #b011111 #b10111)))
(assert (fp.leq (fp #b0 #b011111 #b10111)
                arg1
                (fp #b0 #b110110 #b01100)))
; arg1 = 1.71875

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                expect
                (fp #b0 #b11 #b0)))
; expect = 2.0

(assert (not (= expect result)))

(check-sat)
(exit)
