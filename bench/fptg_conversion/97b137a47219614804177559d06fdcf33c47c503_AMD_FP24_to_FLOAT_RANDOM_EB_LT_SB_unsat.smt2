(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1110010 #b0010000011101111)
                arg1
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1001101 #b1110011011101000)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 15 38))
(assert (= result ((_ to_fp 15 38) rm arg1)))

(declare-const expect (_ FloatingPoint 15 38))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110101100010011 #b0010011000111111111000011110000011011)
                expect
                (fp #b0 #b000000000000000 #b0000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000000000000000000000000000000000)
                expect
                (fp #b0 #b110011001101001 #b0011110110100110101000101110111110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
