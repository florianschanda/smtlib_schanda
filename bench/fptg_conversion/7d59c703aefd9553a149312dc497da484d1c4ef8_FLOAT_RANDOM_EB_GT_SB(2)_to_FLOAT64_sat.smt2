; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b110 #b0)))
(assert (fp.leq (fp #b1 #b110 #b0)
                arg1
                (fp #b1 #b010 #b1)))
; arg1 = -8.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010110100 #b1111000100011011111101110100101101010111001101010111)
                expect
                (fp #b1 #b10000000010 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000010 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01000100011 #b1010000011000000010010001101010100101001011011000010)))

(assert (= expect result))

(check-sat)
(exit)
