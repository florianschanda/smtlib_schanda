(assert (fp.leq (fp #b1 #b11010101100 #b1111001011100100101001000101110100110000110110110100)
                arg1
                (fp #b1 #b10111111100 #b0110000100010000000110000010010000010001001111001011)))
(assert (fp.leq (fp #b1 #b10111111100 #b0110000100010000000110000010010000010001001111001011)
                arg1
                (fp #b1 #b10110101011 #b1000000100010000010100011010101101100101110100101011)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result ((_ to_fp 12 2) rm arg1)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b111101111110 #b1)
                expect
                (fp #b1 #b100111111100 #b1)))
(assert (fp.leq (fp #b1 #b100111111100 #b1)
                expect
                (fp #b0 #b100001101000 #b1)))

(assert (= expect result))

(check-sat)
(exit)
