; Format from: FLOAT16
; Format to: AMD_FP24
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b0101000011)
                arg1
                (fp #b1 #b01000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000 #b0000000000)
                arg1
                (fp #b1 #b00101 #b1011111001)))
; arg1 = -0.0078125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b1100100001110100)
                expect
                (fp #b1 #b0111000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0111000 #b0000000000000000)
                expect
                (fp #b1 #b0000001 #b0110101101101101)))
; expect = -0.0078125

(assert (not (= expect result)))

(check-sat)
(exit)
