; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01000 #b1001011101)
                arg1
                (fp #b0 #b00000 #b0111111111)))
(assert (fp.leq (fp #b0 #b00000 #b0111111111)
                arg1
                (fp #b0 #b11000 #b1010101100)))
; arg1 = 0.000030457973480224609375

(declare-const result (_ FloatingPoint 12 9))
(assert (= result ((_ to_fp 12 9) rm arg1)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111000110001 #b11101000)
                expect
                (fp #b0 #b011111101111 #b11111111)))
(assert (fp.leq (fp #b0 #b011111101111 #b11111111)
                expect
                (fp #b0 #b111101111100 #b00011111)))

(assert (= expect result))

(check-sat)
(exit)
