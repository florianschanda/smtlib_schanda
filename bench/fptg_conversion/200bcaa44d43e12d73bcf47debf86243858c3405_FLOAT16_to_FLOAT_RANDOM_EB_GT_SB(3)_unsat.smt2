(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b0 #b011001100111 #b1010101)
                expect
                (fp #b0 #b011111110000 #b1111110)))
(assert (fp.leq (fp #b0 #b011111110000 #b1111110)
                expect
                (fp #b0 #b110101110010 #b0010011)))

(assert (not (= expect result)))

(check-sat)
