(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100010 #b01101)
                expect
                (fp #b0 #b011111 #b11100)))
(assert (fp.leq (fp #b0 #b011111 #b11100)
                expect
                (fp #b0 #b101110 #b11111)))
; expect = 1.875

(assert (not (= expect result)))

(check-sat)
