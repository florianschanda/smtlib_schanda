; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg1
                (fp #b1 #b001 #b0100)))
(assert (fp.leq (fp #b1 #b001 #b0100)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -0.3125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101110 #b00010)
                expect
                (fp #b1 #b011101 #b01000)))
(assert (fp.leq (fp #b1 #b011101 #b01000)
                expect
                (fp #b0 #b110111 #b11111)))
; expect = -0.3125

(assert (not (= expect result)))

(check-sat)
(exit)
