; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0111110111)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b11110 #b1010100111)))
; arg1 = 1.59765625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00111100 #b00110011001010001011000)
                expect
                (fp #b0 #b01111111 #b10011001000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10011001000000000000000)
                expect
                (fp #b0 #b10110001 #b00101101011101010001000)))
; expect = 1.59765625

(assert (not (= expect result)))

(check-sat)
(exit)
