(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1001110101001011 #b10110101)
                arg1
                (fp #b0 #b0000000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000001)
                arg1
                (fp #b0 #b1100001011011110 #b01100111)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b111)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b1010 #b101)))
; expect = 0.001953125

(assert (= expect result))

(check-sat)
(exit)
