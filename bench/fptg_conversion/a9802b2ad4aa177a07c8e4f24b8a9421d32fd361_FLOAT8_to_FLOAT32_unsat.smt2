; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                arg1
                (fp #b1 #b001 #b0110)))
(assert (fp.leq (fp #b1 #b001 #b0110)
                arg1
                (fp #b1 #b001 #b0011)))
; arg1 = -0.34375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100110 #b00110001111011000101100)
                expect
                (fp #b1 #b01111101 #b01100000000000000000000)))
(assert (fp.leq (fp #b1 #b01111101 #b01100000000000000000000)
                expect
                (fp #b0 #b11101111 #b10000011010010001111101)))
; expect = -0.34375

(assert (not (= expect result)))

(check-sat)
(exit)
