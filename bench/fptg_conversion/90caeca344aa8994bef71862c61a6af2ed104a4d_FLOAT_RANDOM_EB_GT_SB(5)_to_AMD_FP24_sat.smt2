(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0001 #b1)
                arg1
                (fp #b0 #b1011 #b1)))
(assert (fp.leq (fp #b0 #b1011 #b1)
                arg1
                (fp #b0 #b1101 #b1)))
; arg1 = 24.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000111 #b1100100010001010)
                expect
                (fp #b0 #b1000011 #b1000000000000000)))
(assert (fp.leq (fp #b0 #b1000011 #b1000000000000000)
                expect
                (fp #b0 #b1001010 #b1000010110011100)))
; expect = 24.0

(assert (= expect result))

(check-sat)
(exit)
