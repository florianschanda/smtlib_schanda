(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_2_2
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01010011 #b00111111100101111111000)
                arg1
                (fp #b0 #b01111111 #b10111000111111110010110)))
(assert (fp.leq (fp #b0 #b01111111 #b10111000111111110010110)
                arg1
                (fp #b0 #b10111001 #b10011110100100100100100)))
; arg1 = 1.7226436138153076171875

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                expect
                (fp #b0 #b11 #b0)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
