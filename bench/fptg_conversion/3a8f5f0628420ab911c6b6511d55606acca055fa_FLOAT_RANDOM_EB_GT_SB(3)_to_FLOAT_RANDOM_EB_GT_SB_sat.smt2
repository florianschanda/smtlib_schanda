(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11001000011100 #b0)
                expect
                (fp #b1 #b10011111111111 #b0)))
(assert (fp.leq (fp #b1 #b10011111111111 #b0)
                expect
                (fp #b1 #b01011010011010 #b0)))

(assert (= expect result))

(check-sat)
(exit)
