(assert (fp.leq (fp #b1 #b1100111100000 #b00)
                arg1
                (fp #b1 #b1011111111110 #b11)))
(assert (fp.leq (fp #b1 #b1011111111110 #b11)
                arg1
                (fp #b0 #b0011101010111 #b01)))

(declare-const result (_ FloatingPoint 14 2))
