; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0111110000)
                arg1
                (fp #b1 #b00100 #b0101100101)))
(assert (fp.leq (fp #b1 #b00100 #b0101100101)
                arg1
                (fp #b0 #b00100 #b0000100001)))
; arg1 = -0.000658512115478515625

(declare-const result (_ FloatingPoint 8 48))
(assert (= result ((_ to_fp 8 48) rm arg1)))

(declare-const expect (_ FloatingPoint 8 48))
(assert (fp.leq (fp #b1 #b11000100 #b10010011010000101011010010010100011011000001011)
                expect
                (fp #b1 #b01110100 #b01011001010000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01110100 #b01011001010000000000000000000000000000000000000)
                expect
                (fp #b0 #b11110011 #b10000001011011111010100000111100000111110111000)))

(assert (= expect result))

(check-sat)
(exit)
