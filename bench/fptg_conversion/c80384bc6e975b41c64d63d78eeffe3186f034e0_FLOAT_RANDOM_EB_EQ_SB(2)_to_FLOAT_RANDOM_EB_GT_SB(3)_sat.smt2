(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11010011010110 #b0011111)
                expect
                (fp #b1 #b10000000011001 #b1010000)))
(assert (fp.leq (fp #b1 #b10000000011001 #b1010000)
                expect
                (fp #b0 #b10001010001011 #b1001000)))

(assert (= expect result))

(check-sat)
