; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0101011101100011)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1111000 #b0110100001010001)))
; arg1 = 26078.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001001 #b0111000100)
                expect
                (fp #b0 #b10001101 #b1001011110)))
(assert (fp.leq (fp #b0 #b10001101 #b1001011110)
                expect
                (fp #b0 #b10110100 #b1100110101)))
; expect = 26080.0

(assert (not (= expect result)))

(check-sat)
(exit)
