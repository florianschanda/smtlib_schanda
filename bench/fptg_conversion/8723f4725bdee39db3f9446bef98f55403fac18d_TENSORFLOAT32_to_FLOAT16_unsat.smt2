; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100110 #b1100001111)
                arg1
                (fp #b1 #b10101101 #b0110111010)))
(assert (fp.leq (fp #b1 #b10101101 #b0110111010)
                arg1
                (fp #b0 #b10000111 #b1110010101)))
; arg1 = -100742752894976.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
