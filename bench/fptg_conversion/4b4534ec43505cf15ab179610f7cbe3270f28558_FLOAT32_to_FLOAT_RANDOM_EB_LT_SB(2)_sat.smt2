; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b01101001011000100000110)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b00111011 #b10001001000001000110011)))
; arg1 = -1.6049678325653076171875

(declare-const result (_ FloatingPoint 15 18))
(assert (= result ((_ to_fp 15 18) rm arg1)))

(declare-const expect (_ FloatingPoint 15 18))
(assert (fp.leq (fp #b1 #b111010110011011 #b00101010110110101)
                expect
                (fp #b1 #b011111111111111 #b10011010110111111)))
(assert (fp.leq (fp #b1 #b011111111111111 #b10011010110111111)
                expect
                (fp #b0 #b000001101111001 #b11111001000111110)))

(assert (= expect result))

(check-sat)
(exit)
