; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00000 #b0011)
                arg1
                (fp #b0 #b01111 #b0111)))
(assert (fp.leq (fp #b0 #b01111 #b0111)
                arg1
                (fp #b0 #b11100 #b1110)))
; arg1 = 1.4375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111100 #b1000010)
                expect
                (fp #b0 #b01111111 #b0111000)))
(assert (fp.leq (fp #b0 #b01111111 #b0111000)
                expect
                (fp #b0 #b11100000 #b0001111)))
; expect = 1.4375

(assert (= expect result))

(check-sat)
(exit)
