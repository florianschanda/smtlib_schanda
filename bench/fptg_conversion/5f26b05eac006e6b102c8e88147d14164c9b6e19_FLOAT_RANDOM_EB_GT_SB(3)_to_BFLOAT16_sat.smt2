(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b0100111)
                expect
                (fp #b1 #b10010001 #b1100000)))
(assert (fp.leq (fp #b1 #b10010001 #b1100000)
                expect
                (fp #b1 #b01110111 #b1111000)))
; expect = -458752.0

(assert (= expect result))

(check-sat)
