                expect
                (fp #b1 #b1001110 #b0111011011000000)))
(assert (fp.leq (fp #b1 #b1001110 #b0111011011000000)
                expect
                (fp #b0 #b0100100 #b1000101011101111)))
; expect = -47968.0

(assert (= expect result))

