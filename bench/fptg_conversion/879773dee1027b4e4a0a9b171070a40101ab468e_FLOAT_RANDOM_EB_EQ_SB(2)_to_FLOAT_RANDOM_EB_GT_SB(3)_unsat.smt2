; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1100 #b101)
                arg1
                (fp #b0 #b0011 #b001)))
(assert (fp.leq (fp #b0 #b0011 #b001)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = 0.0703125

(declare-const result (_ FloatingPoint 6 2))
(assert (= result ((_ to_fp 6 2) rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b110101 #b0)
                expect
                (fp #b0 #b011011 #b1)))
(assert (fp.leq (fp #b0 #b011011 #b1)
                expect
                (fp #b0 #b100110 #b1)))
; expect = 0.09375

(assert (not (= expect result)))

(check-sat)
(exit)
