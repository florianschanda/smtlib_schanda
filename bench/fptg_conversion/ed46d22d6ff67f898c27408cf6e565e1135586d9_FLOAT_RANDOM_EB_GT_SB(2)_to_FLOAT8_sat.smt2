(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111010111000 #b0000001010)
                arg1
                (fp #b0 #b000000000000 #b0111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b0111111111)
                arg1
                (fp #b0 #b000000111110 #b0111110001)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1110)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b001 #b1111)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
