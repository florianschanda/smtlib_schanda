(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b100101000101100 #b0101010011)
                arg1
                (fp #b1 #b000000000000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1110100001)
                arg1
                (fp #b0 #b001000110001111 #b0010110000)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b00 #b1)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
