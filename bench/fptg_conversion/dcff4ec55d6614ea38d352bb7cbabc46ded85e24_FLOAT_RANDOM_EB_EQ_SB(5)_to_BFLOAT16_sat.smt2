; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100000101100 #b1101010010101)
                arg1
                (fp #b0 #b10000000001100 #b0100100000111)))
(assert (fp.leq (fp #b0 #b10000000001100 #b0100100000111)
                arg1
                (fp #b0 #b10000001001010 #b0100110010111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000001 #b0101111)
                expect
                (fp #b0 #b10001100 #b0100101)))
(assert (fp.leq (fp #b0 #b10001100 #b0100101)
                expect
                (fp #b0 #b11000001 #b0100100)))
; expect = 10560.0

(assert (= expect result))

(check-sat)
(exit)
