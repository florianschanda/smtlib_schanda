; Format from: FLOAT_2_2
; Format to: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg1
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b00 #b1)))
; arg1 = -2.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100010000 #b1011001111111001001111101100000101111100111111110101)
                expect
                (fp #b1 #b10000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b00111000100 #b0110001111111110010100000001000011011001100110010111)))

(assert (= expect result))

(check-sat)
(exit)
