(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b110 #b00)))
(assert (fp.leq (fp #b0 #b110 #b00)
                arg1
