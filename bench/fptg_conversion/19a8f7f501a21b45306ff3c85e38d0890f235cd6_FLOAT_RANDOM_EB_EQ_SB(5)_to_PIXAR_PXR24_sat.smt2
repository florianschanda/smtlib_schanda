; arg1 = 8.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01111100 #b000000101101010)
                expect
                (fp #b0 #b10000010 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b000000000000000)
                expect
                (fp #b0 #b11001100 #b110011000001011)))
; expect = 8.0

(assert (= expect result))

(check-sat)
(exit)
