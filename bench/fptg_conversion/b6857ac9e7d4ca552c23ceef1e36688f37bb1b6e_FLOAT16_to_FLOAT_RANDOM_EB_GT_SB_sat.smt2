; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101101000)
                arg1
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg1
                (fp #b0 #b11010 #b1101001101)))
; arg1 = -0.000244140625

(declare-const result (_ FloatingPoint 16 15))
(assert (= result ((_ to_fp 16 15) rm arg1)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1110010111101100 #b01001000010001)
                expect
                (fp #b1 #b0111111111110011 #b00000000000000)))
(assert (fp.leq (fp #b1 #b0111111111110011 #b00000000000000)
                expect
                (fp #b1 #b0010100010100000 #b10011011000111)))

(assert (= expect result))

(check-sat)
(exit)
