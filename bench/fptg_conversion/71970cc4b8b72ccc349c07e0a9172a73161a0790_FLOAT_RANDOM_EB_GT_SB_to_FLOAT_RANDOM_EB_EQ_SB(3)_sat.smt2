(assert (fp.leq (fp #b1 #b001101 #b10111)
                expect
                (fp #b0 #b000000 #b00001)))
(assert (fp.leq (fp #b0 #b000000 #b00001)
                expect
                (fp #b0 #b100110 #b01110)))
; expect = 0.00000000002910383045673370361328125

(assert (= expect result))

