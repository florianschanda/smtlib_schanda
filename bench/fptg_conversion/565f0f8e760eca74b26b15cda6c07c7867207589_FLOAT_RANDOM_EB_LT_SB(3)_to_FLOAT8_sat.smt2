; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT8
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 21))
(assert (fp.leq (fp #b1 #b0110001010000 #b01010100110010101010)
                arg1
                (fp #b0 #b0011111110110 #b00000000000000000000)))
(assert (fp.leq (fp #b0 #b0011111110110 #b00000000000000000000)
                arg1
                (fp #b0 #b1010110110100 #b11000100110100110010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1110)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b001 #b0101)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
