                expect
                (fp #b1 #b01111111111111100 #b1000000000000)))
(assert (fp.leq (fp #b1 #b01111111111111100 #b1000000000000)
                expect
                (fp #b0 #b00010110010111100 #b0101101111001)))

(assert (= expect result))

