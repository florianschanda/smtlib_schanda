; Format from: TENSORFLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111011 #b0101100000)
                arg1
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                arg1
                (fp #b1 #b00101001 #b1001111011)))
; arg1 = -1.98828125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001011 #b0110100001101000)
                expect
                (fp #b1 #b0111111 #b1111110100000000)))
(assert (fp.leq (fp #b1 #b0111111 #b1111110100000000)
                expect
                (fp #b0 #b1101010 #b1101110001010000)))
; expect = -1.98828125

(assert (= expect result))

(check-sat)
(exit)
