; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b101 #b10)))
(assert (fp.leq (fp #b1 #b101 #b10)
                arg1
                (fp #b0 #b100 #b10)))
; arg1 = -6.0

(declare-const result (_ FloatingPoint 15 9))
(assert (= result ((_ to_fp 15 9) rm arg1)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b101001100101110 #b11100100)
                expect
                (fp #b1 #b100000000000001 #b10000000)))
(assert (fp.leq (fp #b1 #b100000000000001 #b10000000)
                expect
                (fp #b1 #b010010001001110 #b00100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
