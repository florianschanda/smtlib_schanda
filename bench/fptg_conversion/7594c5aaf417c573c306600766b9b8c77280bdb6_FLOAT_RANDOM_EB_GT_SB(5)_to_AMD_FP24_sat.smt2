                expect
                (fp #b0 #b0111111 #b1011100000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1011100000000000)
                expect
                (fp #b0 #b1110111 #b0111110011010001)))
; expect = 1.71875

