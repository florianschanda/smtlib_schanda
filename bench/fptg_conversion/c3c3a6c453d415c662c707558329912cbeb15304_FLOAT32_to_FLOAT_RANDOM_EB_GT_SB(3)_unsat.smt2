                expect
                (fp #b0 #b1000000001100110 #b101010)))
(assert (fp.leq (fp #b0 #b1000000001100110 #b101010)
                expect
                (fp #b0 #b1011101111011010 #b110000)))

(assert (not (= expect result)))

(check-sat)
