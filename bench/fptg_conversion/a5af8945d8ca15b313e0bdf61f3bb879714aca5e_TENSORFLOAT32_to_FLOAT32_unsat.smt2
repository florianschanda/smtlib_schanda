(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111001 #b00110010110100010000001)
                expect
                (fp #b0 #b01111111 #b11111101000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b11111101000000000000000)
                expect
                (fp #b0 #b10010001 #b11101100010010000110010)))
; expect = 1.98828125

(assert (not (= expect result)))

(check-sat)
