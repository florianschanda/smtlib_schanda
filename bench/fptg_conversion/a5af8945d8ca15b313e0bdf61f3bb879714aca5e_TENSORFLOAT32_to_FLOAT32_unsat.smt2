; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111100 #b0010101010)
                arg1
                (fp #b0 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1111110100)
                arg1
                (fp #b0 #b11001011 #b0111110110)))
