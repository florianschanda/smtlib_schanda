(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01110100101 #b11011)
                arg1
                (fp #b0 #b10000000100 #b11101)))
(assert (fp.leq (fp #b0 #b10000000100 #b11101)
                arg1
                (fp #b0 #b10010001011 #b10001)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101110 #b11100111110110101111011)
                expect
                (fp #b0 #b10000100 #b11101000000000000000000)))
(assert (fp.leq (fp #b0 #b10000100 #b11101000000000000000000)
                expect
                (fp #b0 #b10010011 #b00110001010111111111011)))
; expect = 61.0

(assert (= expect result))

(check-sat)
(exit)
