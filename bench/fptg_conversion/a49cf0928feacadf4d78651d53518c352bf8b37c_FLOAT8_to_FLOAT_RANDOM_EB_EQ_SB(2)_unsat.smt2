; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b1 #b101 #b0100)))
(assert (fp.leq (fp #b1 #b101 #b0100)
                arg1
                (fp #b0 #b011 #b0100)))
; arg1 = -5.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111001010 #b00000001011)
                expect
                (fp #b1 #b100000000001 #b01000000000)))
(assert (fp.leq (fp #b1 #b100000000001 #b01000000000)
                expect
                (fp #b1 #b010011110011 #b11011100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
