(assert (fp.leq (fp #b0 #b00101111 #b0101010011)
                expect
                (fp #b0 #b01111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b0000000000)
                expect
                (fp #b0 #b10001111 #b0100010111)))
; expect = 0.25

(assert (not (= expect result)))

(check-sat)
