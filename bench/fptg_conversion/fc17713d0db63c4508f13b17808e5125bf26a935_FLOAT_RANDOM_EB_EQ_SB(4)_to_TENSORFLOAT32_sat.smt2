(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b1 #b0110 #b001)))
(assert (fp.leq (fp #b1 #b0110 #b001)
                arg1
                (fp #b0 #b1000 #b100)))
; arg1 = -0.5625

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011000 #b1011111001)
                expect
                (fp #b1 #b01111110 #b0010000000)))
(assert (fp.leq (fp #b1 #b01111110 #b0010000000)
                expect
                (fp #b0 #b00111101 #b0011110001)))
; expect = -0.5625

(assert (= expect result))

(check-sat)
(exit)
