(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111100 #b0010101010)
                arg1
                (fp #b0 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111111 #b1111110100)
                arg1
                (fp #b0 #b11001011 #b0111110110)))
; arg1 = 1.98828125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1010001011)
                expect
                (fp #b0 #b01111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111 #b1111110100)
                expect
                (fp #b0 #b10001 #b0001101011)))
; expect = 1.98828125

(assert (= expect result))

(check-sat)
(exit)
