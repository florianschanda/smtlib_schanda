; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b10010010001011001010001)
                arg1
                (fp #b0 #b11010101 #b00100111011100011000100)))
(assert (fp.leq (fp #b0 #b11010101 #b00100111011100011000100)
                arg1
                (fp #b0 #b11011001 #b01010101001001000010101)))
; arg1 = 89292313239018475236622336.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10111111 #b1011101)
                expect
                (fp #b0 #b11010101 #b0010100)))
(assert (fp.leq (fp #b0 #b11010101 #b0010100)
                expect
                (fp #b0 #b11010111 #b1011001)))
; expect = 89460510651482558928257024.0

(assert (not (= expect result)))

(check-sat)
(exit)
