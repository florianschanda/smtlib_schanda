(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1011 #b1)
                arg1
                (fp #b0 #b0000 #b1)))
(assert (fp.leq (fp #b0 #b0000 #b1)
                arg1
                (fp #b0 #b0010 #b0)))
; arg1 = 0.0078125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010000 #b11111011011110000111101)
                expect
                (fp #b0 #b01111000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111000 #b00000000000000000000000)
                expect
                (fp #b0 #b10011101 #b10100111011111011011101)))
; expect = 0.0078125

(assert (not (= expect result)))

(check-sat)
(exit)
