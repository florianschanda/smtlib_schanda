; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101111001 #b0101001100)
                arg1
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                arg1
                (fp #b1 #b00110011011 #b1111110110)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011111 #b001001011001110)
                expect
                (fp #b1 #b10001010 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b000000000000000)
                expect
                (fp #b0 #b10011010 #b000000010011111)))
; expect = -2048.0

(assert (= expect result))

(check-sat)
(exit)
