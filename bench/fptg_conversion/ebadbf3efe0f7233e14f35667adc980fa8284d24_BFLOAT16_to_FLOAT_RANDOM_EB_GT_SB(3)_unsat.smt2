; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b1101111)
                arg1
                (fp #b1 #b01111111 #b0000001)))
(assert (fp.leq (fp #b1 #b01111111 #b0000001)
                arg1
                (fp #b0 #b00001110 #b1000011)))
; arg1 = -1.0078125

(declare-const result (_ FloatingPoint 8 2))
(assert (= result ((_ to_fp 8 2) rm arg1)))

(declare-const expect (_ FloatingPoint 8 2))
(assert (fp.leq (fp #b1 #b11110101 #b1)
                expect
                (fp #b1 #b01111111 #b1)))
(assert (fp.leq (fp #b1 #b01111111 #b1)
                expect
                (fp #b1 #b00000011 #b0)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
