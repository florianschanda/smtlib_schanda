; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111001100100 #b100)
                arg1
                (fp #b0 #b00000000000001 #b000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b000)
                arg1
                (fp #b0 #b00101000101011 #b001)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b00)
                expect
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                expect
                (fp #b0 #b001 #b00)))
; expect = 0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
