(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010101101 #b11001010)
                expect
                (fp #b0 #b010111111 #b10100001)))
(assert (fp.leq (fp #b0 #b010111111 #b10100001)
                expect
                (fp #b0 #b111010000 #b11011100)))

(assert (= expect result))

(check-sat)
(exit)
