(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011011001100010 #b110001010000100)
                arg1
                (fp #b0 #b0000000000000000 #b101011100010010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b101011100010010)
                arg1
                (fp #b0 #b1011110001100011 #b010101111110110)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b0 #b00 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b10 #b0)))
; expect = 0.5

(assert (= expect result))

(check-sat)
(exit)
