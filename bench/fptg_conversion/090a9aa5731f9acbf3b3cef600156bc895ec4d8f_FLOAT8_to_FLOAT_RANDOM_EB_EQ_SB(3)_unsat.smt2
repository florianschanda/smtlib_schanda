; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b001 #b0000)))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b001 #b1000)))
; arg1 = -0.25

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b011 #b10)
                expect
                (fp #b1 #b001 #b00)))
(assert (fp.leq (fp #b1 #b001 #b00)
                expect
                (fp #b0 #b110 #b10)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
