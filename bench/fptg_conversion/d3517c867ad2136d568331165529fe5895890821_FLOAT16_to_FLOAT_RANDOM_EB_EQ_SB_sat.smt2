(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1010110010)
                arg1
                (fp #b0 #b00000 #b1011110010)))
(assert (fp.leq (fp #b0 #b00000 #b1011110010)
                arg1
                (fp #b0 #b01111 #b0101001010)))
; arg1 = 0.00004494190216064453125

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b011010010100100 #b00111010101110)
                expect
                (fp #b0 #b011111111110000 #b01111001000000)))
(assert (fp.leq (fp #b0 #b011111111110000 #b01111001000000)
                expect
                (fp #b0 #b110110000101011 #b01101110001110)))

(assert (= expect result))

(check-sat)
(exit)
