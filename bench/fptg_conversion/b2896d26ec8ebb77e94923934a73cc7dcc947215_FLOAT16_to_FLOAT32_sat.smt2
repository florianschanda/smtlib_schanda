; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10111 #b0111100101)
                arg1
                (fp #b0 #b11101 #b0000001101)))
(assert (fp.leq (fp #b0 #b11101 #b0000001101)
                arg1
                (fp #b0 #b11110 #b1101011010)))
; arg1 = 16592.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100000 #b11100101000110101000101)
                expect
                (fp #b0 #b10001101 #b00000011010000000000000)))
(assert (fp.leq (fp #b0 #b10001101 #b00000011010000000000000)
                expect
                (fp #b0 #b10111100 #b10101000010101100001100)))
; expect = 16592.0

(assert (= expect result))

(check-sat)
(exit)
