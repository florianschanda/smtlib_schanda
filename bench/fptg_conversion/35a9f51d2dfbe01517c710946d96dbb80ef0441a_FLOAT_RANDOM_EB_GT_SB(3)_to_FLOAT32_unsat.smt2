(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1101 #b0)
                arg1
                (fp #b1 #b1000 #b1)))
(assert (fp.leq (fp #b1 #b1000 #b1)
                arg1
                (fp #b1 #b1000 #b0)))
; arg1 = -3.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b11101001010111100000011)
                expect
                (fp #b1 #b10000000 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b10000000000000000000000)
                expect
                (fp #b0 #b00011001 #b11111001011001001011111)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
