; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110001111001 #b11100101111)
                arg1
                (fp #b1 #b011101010011 #b00011011010)))
(assert (fp.leq (fp #b1 #b011101010011 #b00011011010)
                arg1
                (fp #b0 #b110000110011 #b11110001110)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1100110001)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10110 #b0101000101)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
