(assert (fp.leq (fp #b1 #b11010100 #b0101)
                expect
                (fp #b0 #b10001111 #b0011)))
(assert (fp.leq (fp #b0 #b10001111 #b0011)
                expect
                (fp #b0 #b10100000 #b1111)))
; expect = 77824.0

(assert (not (= expect result)))

