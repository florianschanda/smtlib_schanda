(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b001)
                arg1
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                arg1
                (fp #b0 #b0000 #b101)))
; arg1 = -0.001953125

(declare-const result (_ FloatingPoint 16 2))
(assert (= result ((_ to_fp 16 2) rm arg1)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1000101111001101 #b1)
                expect
                (fp #b1 #b0111111111110110 #b0)))
(assert (fp.leq (fp #b1 #b0111111111110110 #b0)
                expect
                (fp #b0 #b1100110101100000 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
