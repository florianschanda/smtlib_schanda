(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b0011110001011010)
                arg1
                (fp #b1 #b0111111 #b0011010000100011)))
(assert (fp.leq (fp #b1 #b0111111 #b0011010000100011)
                arg1
                (fp #b0 #b0100010 #b0100001100101001)))
; arg1 = -1.2036590576171875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010100 #b1101001)
                expect
                (fp #b1 #b01111111 #b0011011)))
(assert (fp.leq (fp #b1 #b01111111 #b0011011)
                expect
                (fp #b0 #b00010101 #b0111000)))
; expect = -1.2109375

(assert (= expect result))

(check-sat)
(exit)
