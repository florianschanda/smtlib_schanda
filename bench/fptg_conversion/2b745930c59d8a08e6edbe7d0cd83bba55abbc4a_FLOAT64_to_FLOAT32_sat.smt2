(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000111 #b00111000111011111100110)
                expect
                (fp #b1 #b10101010 #b11001001111000001111011)))
(assert (fp.leq (fp #b1 #b10101010 #b11001001111000001111011)
                expect
                (fp #b1 #b10000011 #b11111110100100110101110)))
