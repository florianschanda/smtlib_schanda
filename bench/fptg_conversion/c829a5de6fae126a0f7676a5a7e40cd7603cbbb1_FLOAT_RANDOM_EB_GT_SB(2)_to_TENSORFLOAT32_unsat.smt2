(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011 #b1)
                arg1
                (fp #b0 #b000 #b0)))
(assert (fp.leq (fp #b0 #b000 #b0)
                arg1
                (fp #b0 #b111 #b0)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01011101 #b0001111000)
                expect
                (fp #b0 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000000)
                expect
                (fp #b0 #b01100011 #b1000001010)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
