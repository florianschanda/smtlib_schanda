(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b010 #b10)
                arg1
                (fp #b0 #b001 #b00)))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 0.25

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011100 #b0100001)
                expect
                (fp #b0 #b01111101 #b0000000)))
(assert (fp.leq (fp #b0 #b01111101 #b0000000)
                expect
                (fp #b0 #b10001101 #b0010111)))
; expect = 0.25

(assert (= expect result))

(check-sat)
(exit)
