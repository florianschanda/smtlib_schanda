(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1011 #b01)
                arg1
                (fp #b0 #b1010 #b00)))
(assert (fp.leq (fp #b0 #b1010 #b00)
                arg1
                (fp #b0 #b1010 #b01)))
; arg1 = 8.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01001100010101101111101)
                expect
                (fp #b0 #b10000010 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b00000000000000000000000)
                expect
                (fp #b0 #b10001011 #b10111010001001110010001)))
; expect = 8.0

(assert (= expect result))

(check-sat)
(exit)
