; arg1 = 26.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11001 #b0101)
                expect
                (fp #b0 #b10011 #b1010)))
(assert (fp.leq (fp #b0 #b10011 #b1010)
                expect
                (fp #b0 #b11101 #b0011)))
; expect = 26.0

(assert (= expect result))

(check-sat)
(exit)
