; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b01011000001011110 #b0101011010110001)
                arg1
                (fp #b0 #b00000000000000001 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000001 #b0000000000000000)
                arg1
                (fp #b0 #b10010011100111100 #b0100111001110101)))

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b100 #b0)
                expect
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                expect
                (fp #b0 #b110 #b1)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
