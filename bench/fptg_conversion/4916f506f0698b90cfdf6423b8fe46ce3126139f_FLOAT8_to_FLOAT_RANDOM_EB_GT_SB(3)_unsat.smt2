(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b110100110100001100 #b11101100)
                expect
                (fp #b1 #b011111111111111100 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111111111100 #b00000000)
                expect
                (fp #b1 #b001110100011001110 #b00000100)))

(assert (not (= expect result)))

(check-sat)
