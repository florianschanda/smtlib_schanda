(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100011110111 #b001100010110)
                expect
                (fp #b1 #b1000000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b1000000000000 #b000000000000)
                expect
                (fp #b0 #b1010111001011 #b101100100110)))

(assert (= expect result))

(check-sat)
(exit)
