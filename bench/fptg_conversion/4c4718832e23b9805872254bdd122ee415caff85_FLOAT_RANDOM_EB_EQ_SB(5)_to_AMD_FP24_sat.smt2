(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10101 #b0000)
                arg1
                (fp #b1 #b10010 #b1010)))
(assert (fp.leq (fp #b1 #b10010 #b1010)
                arg1
                (fp #b0 #b10001 #b1001)))
; arg1 = -13.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101111 #b0000110101011100)
                expect
                (fp #b1 #b1000010 #b1010000000000000)))
(assert (fp.leq (fp #b1 #b1000010 #b1010000000000000)
                expect
                (fp #b0 #b0111101 #b1100100001111100)))
; expect = -13.0

(assert (= expect result))

(check-sat)
(exit)
