(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b100 #b1)))
(assert (fp.leq (fp #b1 #b100 #b1)
                arg1
                (fp #b0 #b111 #b0)))
; arg1 = -3.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111010 #b10011101011000010010001)
                expect
                (fp #b1 #b10000000 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b10000000000000000000000)
                expect
                (fp #b0 #b11111110 #b01010011110111000110010)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
