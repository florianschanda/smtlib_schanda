; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg1
                (fp #b0 #b011 #b01)))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 1.25

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001101 #b00010110011100011111010)
                expect
                (fp #b0 #b01111111 #b01000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b01000000000000000000000)
                expect
                (fp #b0 #b11100011 #b01111101000101100101011)))
; expect = 1.25

(assert (not (= expect result)))

(check-sat)
(exit)
