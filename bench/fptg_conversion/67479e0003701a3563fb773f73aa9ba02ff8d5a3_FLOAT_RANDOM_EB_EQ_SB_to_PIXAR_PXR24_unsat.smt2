                expect
                (fp #b0 #b01111100 #b000000000000000)))
(assert (fp.leq (fp #b0 #b01111100 #b000000000000000)
                expect
                (fp #b0 #b10101000 #b111101011011101)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
