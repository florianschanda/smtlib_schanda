; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01111000011 #b0011110100)
                arg1
                (fp #b0 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b00100100100 #b0111000000)))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result ((_ to_fp 16 14) rm arg1)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0001111101010111 #b1101011011101)
                expect
                (fp #b0 #b0000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000000000)
                expect
                (fp #b0 #b0111000111101010 #b0101010101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
