; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110100 #b1110111110001011)
                arg1
                (fp #b1 #b1001101 #b0001110100010110)))
(assert (fp.leq (fp #b1 #b1001101 #b0001110100010110)
                arg1
                (fp #b0 #b1010011 #b0100110000101001)))
; arg1 = -18245.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1010100100)
                expect
                (fp #b1 #b11101 #b0001110101)))
(assert (fp.leq (fp #b1 #b11101 #b0001110101)
                expect
                (fp #b1 #b00010 #b1010111010)))
; expect = -18256.0

(assert (not (= expect result)))

(check-sat)
(exit)
