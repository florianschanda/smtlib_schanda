(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000011 #b1011001100)
                arg1
                (fp #b1 #b01111111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111111 #b0001011101)
                arg1
                (fp #b1 #b00010001 #b1110000000)))
; arg1 = -1.0908203125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b0011001111)
                expect
                (fp #b1 #b01111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111 #b0001011101)
                expect
                (fp #b0 #b00101 #b1001011011)))
; expect = -1.0908203125

(assert (= expect result))

(check-sat)
(exit)
