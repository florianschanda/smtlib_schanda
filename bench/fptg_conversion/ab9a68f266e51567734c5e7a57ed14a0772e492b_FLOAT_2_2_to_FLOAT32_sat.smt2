(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: FLOAT32
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg1
                (fp #b1 #b01 #b0)))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg1
                (fp #b0 #b10 #b1)))
; arg1 = -1.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110011 #b00001001011110100101000)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b1 #b00011110 #b10000100000100001001111)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
