(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0000010110100110)
                expect
                (fp #b1 #b1000011 #b1010000000000000)))
(assert (fp.leq (fp #b1 #b1000011 #b1010000000000000)
                expect
                (fp #b0 #b0000110 #b1010010100011011)))
; expect = -26.0

(assert (= expect result))

(check-sat)
(exit)
