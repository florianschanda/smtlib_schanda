(assert (fp.leq (fp #b0 #b000010000101101 #b010010111011110000100111110111110010111111100111010110100110001)
                expect
                (fp #b0 #b011111111111011 #b101011010100000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b011111111111011 #b101011010100000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b100001101100101 #b001111110101110101110110001100100001100000010111000101001000111)))

(assert (= expect result))

(check-sat)
(exit)
