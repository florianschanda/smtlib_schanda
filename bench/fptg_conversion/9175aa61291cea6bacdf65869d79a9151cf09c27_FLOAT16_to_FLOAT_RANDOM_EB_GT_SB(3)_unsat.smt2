(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01100 #b0000111111)
                arg1
                (fp #b0 #b10101 #b1011010000)))
(assert (fp.leq (fp #b0 #b10101 #b1011010000)
                arg1
                (fp #b0 #b11110 #b1001110011)))
; arg1 = 109.0

(declare-const result (_ FloatingPoint 10 2))
(assert (= result ((_ to_fp 10 2) rm arg1)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0011001110 #b0)
                expect
                (fp #b0 #b1000000110 #b0)))
(assert (fp.leq (fp #b0 #b1000000110 #b0)
                expect
                (fp #b0 #b1110000101 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
