(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0110 #b0)
                arg1
                (fp #b1 #b0010 #b0)))
(assert (fp.leq (fp #b1 #b0010 #b0)
                arg1
                (fp #b0 #b0010 #b0)))
; arg1 = -0.03125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1111)
                expect
                (fp #b1 #b000 #b0010)))
(assert (fp.leq (fp #b1 #b000 #b0010)
                expect
                (fp #b0 #b011 #b0100)))
; expect = -0.03125

(assert (= expect result))

(check-sat)
(exit)
