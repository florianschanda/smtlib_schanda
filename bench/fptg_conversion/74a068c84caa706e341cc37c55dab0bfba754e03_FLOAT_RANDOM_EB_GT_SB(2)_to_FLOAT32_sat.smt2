; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b0001001011000 #b0)
                arg1
                (fp #b0 #b0000111101000 #b1)))
(assert (fp.leq (fp #b0 #b0000111101000 #b1)
                arg1
                (fp #b0 #b0101111100010 #b0)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01010010 #b11010100011101100101101)
                expect
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b00101100 #b01100100001001101100100)))
; expect = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(assert (= expect result))

(check-sat)
(exit)
