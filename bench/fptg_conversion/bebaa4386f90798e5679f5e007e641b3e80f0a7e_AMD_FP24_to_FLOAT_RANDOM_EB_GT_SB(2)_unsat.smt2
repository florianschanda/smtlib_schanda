(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1010101 #b0100110100100111)
                arg1
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1000011 #b0010101110011001)))
; arg1 = -0

(declare-const result (_ FloatingPoint 13 8))
(assert (= result ((_ to_fp 13 8) rm arg1)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0011011101101 #b1101100)
                expect
                (fp #b1 #b0000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000000)
                expect
                (fp #b0 #b1101000110100 #b0000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
