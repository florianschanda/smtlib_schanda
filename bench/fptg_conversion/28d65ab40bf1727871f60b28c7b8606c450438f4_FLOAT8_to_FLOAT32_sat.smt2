(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1111)))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b0 #b000 #b1101)))
; arg1 = -15.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101010 #b11111000110111001011001)
                expect
                (fp #b1 #b10000010 #b11110000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b11110000000000000000000)
                expect
                (fp #b1 #b01111010 #b10111000000010100111010)))
; expect = -15.5

(assert (= expect result))

(check-sat)
(exit)
