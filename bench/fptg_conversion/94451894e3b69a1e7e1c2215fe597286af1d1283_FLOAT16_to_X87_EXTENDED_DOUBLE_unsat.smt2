; arg1 = -933.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b100011011110011 #b110100110000100110010110100010000101010001011001100000001111000)
                expect
                (fp #b1 #b100000000001000 #b110100101000000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000001000 #b110100101000000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b011101101010010 #b100000010011111000010001000011000011101010110001100101011011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
