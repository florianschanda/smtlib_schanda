(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b01)
                arg1
                (fp #b1 #b0111 #b01)))
(assert (fp.leq (fp #b1 #b0111 #b01)
                arg1
                (fp #b0 #b1101 #b11)))
; arg1 = -1.25

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011110 #b0010101)
                expect
                (fp #b1 #b01111111 #b0100000)))
(assert (fp.leq (fp #b1 #b01111111 #b0100000)
                expect
                (fp #b1 #b00011000 #b0110111)))
; expect = -1.25

(assert (not (= expect result)))

(check-sat)
(exit)
