                expect
                (fp #b1 #b0110110 #b1101011000000000)))
(assert (fp.leq (fp #b1 #b0110110 #b1101011000000000)
                expect
                (fp #b1 #b0001111 #b0001100001111001)))
; expect = -0.0035858154296875

(assert (= expect result))

