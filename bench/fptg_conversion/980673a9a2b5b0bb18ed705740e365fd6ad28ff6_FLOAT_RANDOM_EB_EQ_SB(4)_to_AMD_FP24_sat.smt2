(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001001110 #b100011100)
                arg1
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                arg1
                (fp #b0 #b1100000010 #b010111101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001110 #b1100101001101101)
                expect
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b1000110 #b1000001001000110)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
