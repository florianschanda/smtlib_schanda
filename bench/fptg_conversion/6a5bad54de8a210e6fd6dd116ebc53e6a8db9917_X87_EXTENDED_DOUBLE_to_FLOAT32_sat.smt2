(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: X87_EXTENDED_DOUBLE
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110000110000010 #b100001000101001000001111101001000011110011011111011111011001110)
                arg1
                (fp #b1 #b101011101110000 #b000100001110110100100100110000010010100010001001110100111100001)))
(assert (fp.leq (fp #b1 #b101011101110000 #b000100001110110100100100110000010010100010001001110100111100001)
                arg1
                (fp #b1 #b100111001101110 #b111100100110111110001001110010100001101010000111101111010101101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
