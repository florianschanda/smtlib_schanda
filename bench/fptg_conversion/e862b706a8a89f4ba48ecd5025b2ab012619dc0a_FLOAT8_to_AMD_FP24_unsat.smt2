                expect
                (fp #b0 #b1000000 #b1111000000000000)))
(assert (fp.leq (fp #b0 #b1000000 #b1111000000000000)
                expect
                (fp #b0 #b1011000 #b1110110100110101)))
; expect = 3.875

(assert (not (= expect result)))

