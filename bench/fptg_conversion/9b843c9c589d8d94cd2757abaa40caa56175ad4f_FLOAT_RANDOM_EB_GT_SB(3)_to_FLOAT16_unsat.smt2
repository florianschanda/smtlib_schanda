; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01011100010 #b10)
                arg1
                (fp #b1 #b00110001011 #b00)))
(assert (fp.leq (fp #b1 #b00110001011 #b00)
                arg1
                (fp #b0 #b10101101010 #b00)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b1100110111)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00110 #b0111100101)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

(check-sat)
(exit)
