(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg1
                (fp #b1 #b010 #b0000)))
(assert (fp.leq (fp #b1 #b010 #b0000)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000110 #b1011110000)
                expect
                (fp #b1 #b01111110 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b0000000000)
                expect
                (fp #b0 #b10000010 #b1110001111)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
