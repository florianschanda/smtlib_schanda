; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0110101 #b010)
                arg1
                (fp #b0 #b1000100 #b111)))
(assert (fp.leq (fp #b0 #b1000100 #b111)
                arg1
                (fp #b0 #b1110011 #b010)))
; arg1 = 60.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b1001110011)
                expect
                (fp #b0 #b10100 #b1110000000)))
(assert (fp.leq (fp #b0 #b10100 #b1110000000)
                expect
                (fp #b0 #b11100 #b1101111101)))
; expect = 60.0

(assert (not (= expect result)))

(check-sat)
(exit)
