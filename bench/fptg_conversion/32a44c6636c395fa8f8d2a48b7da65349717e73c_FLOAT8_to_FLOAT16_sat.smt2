(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0011)
                arg1
                (fp #b0 #b101 #b1001)))
(assert (fp.leq (fp #b0 #b101 #b1001)
                arg1
                (fp #b0 #b110 #b0101)))
; arg1 = 6.25

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00110 #b0101000100)
                expect
                (fp #b0 #b10001 #b1001000000)))
(assert (fp.leq (fp #b0 #b10001 #b1001000000)
                expect
                (fp #b0 #b10010 #b1000011100)))
; expect = 6.25

(assert (= expect result))

(check-sat)
(exit)
