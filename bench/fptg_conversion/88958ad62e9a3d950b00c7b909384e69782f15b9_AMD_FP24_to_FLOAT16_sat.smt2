(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101000 #b1111111101111011)
                arg1
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b1011010 #b0101011110111110)))
; arg1 = -0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1111110100)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00111 #b0000110010)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
