(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT64
; Format to: FLOAT_2_2
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111001101 #b1011110011000010011001110010010110001000111010110101)
                arg1
                (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)))
(assert (fp.leq (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)
                arg1
                (fp #b1 #b11110100000 #b0000010011010100011100011010100111011000000000101001)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
