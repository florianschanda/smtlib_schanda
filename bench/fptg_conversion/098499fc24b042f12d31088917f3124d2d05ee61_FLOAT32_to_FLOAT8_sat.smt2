; Format from: FLOAT32
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00010100 #b10001000010100101000011)
                arg1
                (fp #b0 #b01000110 #b00001000110000100101100)))
(assert (fp.leq (fp #b0 #b01000110 #b00001000110000100101100)
                arg1
                (fp #b0 #b11110010 #b11101111010100000011011)))
; arg1 = 0.000000000000000007176311283322198380889289648365547691355459392070770263671875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1001)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b011 #b0110)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
