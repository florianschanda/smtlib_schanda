(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b01)
                arg1
                (fp #b1 #b0111 #b01)))
(assert (fp.leq (fp #b1 #b0111 #b01)
                arg1
                (fp #b0 #b1101 #b11)))
; arg1 = -1.25

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111010011110 #b10100110101)
                expect
                (fp #b1 #b011111111111 #b01000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b01000000000)
                expect
                (fp #b0 #b111100010011 #b10011000000)))

(assert (= expect result))

(check-sat)
(exit)
