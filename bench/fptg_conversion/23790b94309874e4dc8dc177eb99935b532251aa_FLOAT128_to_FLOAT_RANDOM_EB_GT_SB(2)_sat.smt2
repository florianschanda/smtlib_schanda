                arg1
                (fp #b0 #b000111101110001 #b0010010010110010010000000010011110100010001111001011010001111101101100101101001110001101010110011111001000010010)))

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100 #b0)
                expect
                (fp #b1 #b000 #b0)))
(assert (fp.leq (fp #b1 #b000 #b0)
                expect
                (fp #b0 #b100 #b1)))
; expect = -0

