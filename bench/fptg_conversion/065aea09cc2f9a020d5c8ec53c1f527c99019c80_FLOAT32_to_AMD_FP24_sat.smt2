(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101001 #b01010010001101001000011)
                arg1
                (fp #b1 #b01111111 #b01000101000011100000101)))
(assert (fp.leq (fp #b1 #b01111111 #b01000101000011100000101)
                arg1
                (fp #b1 #b01011111 #b11100010001010011110000)))
; arg1 = -1.26974546909332275390625

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b0011111001111100)
                expect
                (fp #b1 #b0111111 #b0100010100001111)))
(assert (fp.leq (fp #b1 #b0111111 #b0100010100001111)
                expect
                (fp #b0 #b1001011 #b0101111101110011)))
; expect = -1.2697601318359375

(assert (= expect result))

(check-sat)
(exit)
