(assert (fp.leq (fp #b0 #b0010111 #b0001001100011111)
                expect
                (fp #b0 #b1001010 #b0010000000000000)))
(assert (fp.leq (fp #b0 #b1001010 #b0010000000000000)
                expect
                (fp #b0 #b1100101 #b0011011101010100)))
; expect = 2304.0

(assert (not (= expect result)))

