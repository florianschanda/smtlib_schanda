; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01010101110 #b0101100100)
                arg1
                (fp #b0 #b01101110000 #b1101101101)))
(assert (fp.leq (fp #b0 #b01101110000 #b1101101101)
                arg1
                (fp #b0 #b11000000010 #b1000100000)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1011)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b101 #b1100)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
