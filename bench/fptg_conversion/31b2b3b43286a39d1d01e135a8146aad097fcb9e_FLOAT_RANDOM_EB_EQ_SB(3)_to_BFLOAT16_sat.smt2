; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0100010110100 #b000101110110)
                arg1
                (fp #b0 #b0110100011100 #b111010100011)))
(assert (fp.leq (fp #b0 #b0110100011100 #b111010100011)
                arg1
                (fp #b0 #b1111001110111 #b100000101100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b1101000)
                expect
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                expect
                (fp #b0 #b10100010 #b1001111)))
; expect = 0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(assert (= expect result))

(check-sat)
(exit)
