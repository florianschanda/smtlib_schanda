(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b111101 #b1100)
                expect
                (fp #b1 #b011111 #b0101)))
(assert (fp.leq (fp #b1 #b011111 #b0101)
                expect
                (fp #b0 #b110010 #b1011)))
; expect = -1.3125

(assert (not (= expect result)))

