(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010101 #b1111110100)
                arg1
                (fp #b1 #b10001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10001000 #b1101001010)
                arg1
                (fp #b0 #b11110000 #b0000100001)))
; arg1 = -933.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001001001100101 #b010011111001110)
                expect
                (fp #b1 #b1000000000001000 #b110100101000000)))
(assert (fp.leq (fp #b1 #b1000000000001000 #b110100101000000)
                expect
                (fp #b0 #b0001011110100101 #b000101101010001)))

(assert (= expect result))

(check-sat)
(exit)
