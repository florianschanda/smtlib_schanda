(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11111 #b000)
                arg1
                (fp #b0 #b00000 #b010)))
(assert (fp.leq (fp #b0 #b00000 #b010)
                arg1
                (fp #b0 #b10100 #b000)))
; arg1 = 0.0000152587890625

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111110110 #b00001011101)
                expect
                (fp #b0 #b011111101111 #b00000000000)))
(assert (fp.leq (fp #b0 #b011111101111 #b00000000000)
                expect
                (fp #b0 #b110100101110 #b00001010011)))

(assert (= expect result))

(check-sat)
(exit)
