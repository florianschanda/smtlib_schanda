; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0110 #b0)
                arg1
                (fp #b1 #b0010 #b0)))
(assert (fp.leq (fp #b1 #b0010 #b0)
                arg1
                (fp #b0 #b0010 #b0)))
; arg1 = -0.03125

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101000011100100 #b001101001011101)
                expect
                (fp #b1 #b0111111111111010 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0111111111111010 #b000000000000000)
                expect
                (fp #b0 #b1110000101100001 #b001010011011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
