; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100001000011000000 #b00000000100111000)
                arg1
                (fp #b1 #b001010010001000100 #b11000001111001010)))
(assert (fp.leq (fp #b1 #b001010010001000100 #b11000001111001010)
                arg1
                (fp #b0 #b011111011100100010 #b01110110000000100)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0110)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b011 #b1001)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
