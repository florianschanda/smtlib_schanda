; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0001100110011011 #b100001)
                arg1
                (fp #b0 #b0000000000000000 #b110101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110101)
                arg1
                (fp #b0 #b1010000001101011 #b010111)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01111111 #b1010010)
                expect
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                expect
                (fp #b0 #b11011111 #b0111011)))
; expect = 0.0000000000000000000000000000000000000000918354961579912115600575419704879435795832466228193376178712270530013483949005603790283203125

(assert (= expect result))

(check-sat)
