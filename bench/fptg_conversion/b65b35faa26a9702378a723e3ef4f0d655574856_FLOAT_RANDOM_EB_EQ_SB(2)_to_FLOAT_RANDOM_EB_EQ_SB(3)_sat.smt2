(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b01)
                arg1
                (fp #b0 #b000 #b10)))
(assert (fp.leq (fp #b0 #b000 #b10)
                arg1
                (fp #b0 #b001 #b00)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0101010110001110 #b010010101111000)
                expect
                (fp #b0 #b0111111111111100 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111100 #b000000000000000)
                expect
                (fp #b0 #b1000001101110001 #b001001011101000)))

(assert (= expect result))

(check-sat)
(exit)
