(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1001011000)
                arg1
                (fp #b0 #b11100 #b1101000111)))
(assert (fp.leq (fp #b0 #b11100 #b1101000111)
                arg1
                (fp #b0 #b11100 #b1101010101)))
; arg1 = 14904.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011101110 #b10111011110)
                expect
                (fp #b0 #b100000001100 #b11010001110)))
(assert (fp.leq (fp #b0 #b100000001100 #b11010001110)
                expect
                (fp #b0 #b100100110000 #b00011011011)))

(assert (= expect result))

(check-sat)
(exit)
