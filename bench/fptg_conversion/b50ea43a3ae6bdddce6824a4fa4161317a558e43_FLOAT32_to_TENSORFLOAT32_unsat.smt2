(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b11001100111000000010110)
                arg1
                (fp #b1 #b10010011 #b01111001100110011100000)))
(assert (fp.leq (fp #b1 #b10010011 #b01111001100110011100000)
                arg1
                (fp #b1 #b01000011 #b01000010011001101001111)))
; arg1 = -1546652.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001101 #b1100100011)
                expect
                (fp #b1 #b10010011 #b0111100111)))
(assert (fp.leq (fp #b1 #b10010011 #b0111100111)
                expect
                (fp #b1 #b01000101 #b1001101001)))
; expect = -1547264.0

(assert (not (= expect result)))

(check-sat)
(exit)
