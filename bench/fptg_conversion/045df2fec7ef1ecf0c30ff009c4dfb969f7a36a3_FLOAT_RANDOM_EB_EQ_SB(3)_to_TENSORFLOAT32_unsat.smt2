; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                arg1
                (fp #b1 #b011 #b01)))
(assert (fp.leq (fp #b1 #b011 #b01)
                arg1
                (fp #b0 #b100 #b11)))
; arg1 = -1.25

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000001 #b1000010001)
                expect
                (fp #b1 #b01111111 #b0100000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0100000000)
                expect
                (fp #b1 #b01000101 #b1111111100)))
; expect = -1.25

(assert (not (= expect result)))

(check-sat)
(exit)
