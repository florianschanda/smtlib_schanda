(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b101 #b1011)
                arg1
                (fp #b0 #b110 #b0110)))
(assert (fp.leq (fp #b0 #b110 #b0110)
                arg1
                (fp #b0 #b110 #b1111)))
; arg1 = 11.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010101 #b11000000100100110100011)
                expect
                (fp #b0 #b10000010 #b01100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b01100000000000000000000)
                expect
                (fp #b0 #b11110010 #b01101000100010001100110)))
; expect = 11.0

(assert (= expect result))

(check-sat)
(exit)
