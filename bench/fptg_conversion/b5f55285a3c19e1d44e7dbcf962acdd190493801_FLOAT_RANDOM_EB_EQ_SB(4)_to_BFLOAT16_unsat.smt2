(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001101 #b0100110)
                expect
                (fp #b1 #b01111111 #b1101011)))
(assert (fp.leq (fp #b1 #b01111111 #b1101011)
                expect
                (fp #b0 #b01111001 #b0011010)))
; expect = -1.8359375

(assert (not (= expect result)))

