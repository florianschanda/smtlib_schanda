; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0000111101110001 #b000)
                arg1
                (fp #b0 #b0111111111111111 #b000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000)
                arg1
                (fp #b0 #b1001100110000110 #b100)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10101 #b1100001011)
                expect
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                expect
                (fp #b0 #b10010 #b0110100110)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
