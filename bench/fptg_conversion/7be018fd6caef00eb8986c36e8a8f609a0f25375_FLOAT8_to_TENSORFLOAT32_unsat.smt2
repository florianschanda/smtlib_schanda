; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b0 #b100 #b1100)))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b101 #b1001)))
; arg1 = 3.5

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01100111 #b1101101110)
                expect
                (fp #b0 #b10000000 #b1100000000)))
(assert (fp.leq (fp #b0 #b10000000 #b1100000000)
                expect
                (fp #b0 #b11010100 #b1011110111)))
; expect = 3.5

(assert (not (= expect result)))

(check-sat)
(exit)
