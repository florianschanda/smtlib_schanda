; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000001000010101 #b101011101000111)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                arg1
                (fp #b0 #b1000011011101011 #b110001000011011)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result ((_ to_fp 11 9) rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10110110000 #b11000111)
                expect
                (fp #b1 #b00000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000001)
                expect
                (fp #b0 #b01001001111 #b11111011)))

(assert (= expect result))

(check-sat)
(exit)
