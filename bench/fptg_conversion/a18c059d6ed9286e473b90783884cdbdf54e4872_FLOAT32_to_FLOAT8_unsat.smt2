(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT8
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00001110101100001000111)
                arg1
                (fp #b0 #b10110010 #b00100011010010110011011)))
(assert (fp.leq (fp #b0 #b10110010 #b00100011010010110011011)
                arg1
                (fp #b0 #b10110100 #b10111011001101011111110)))
; arg1 = 2562247297597440.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
