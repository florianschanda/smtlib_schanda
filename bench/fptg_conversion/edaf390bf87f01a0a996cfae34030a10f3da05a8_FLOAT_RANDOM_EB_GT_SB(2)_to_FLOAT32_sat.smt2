(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0000111101110001 #b000)
                arg1
                (fp #b0 #b0111111111111111 #b000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000)
                arg1
                (fp #b0 #b1001100110000110 #b100)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00101110 #b11011110011101110010010)
                expect
                (fp #b0 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10101110 #b00110111100111010110011)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
