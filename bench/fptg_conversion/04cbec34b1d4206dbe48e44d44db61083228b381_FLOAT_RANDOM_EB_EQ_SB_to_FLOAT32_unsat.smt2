(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0010)
                arg1
                (fp #b1 #b10001 #b0000)))
(assert (fp.leq (fp #b1 #b10001 #b0000)
                arg1
                (fp #b1 #b01100 #b1110)))
; arg1 = -4.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010011 #b10101010011001101110101)
                expect
                (fp #b1 #b10000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001 #b00000000000000000000000)
                expect
                (fp #b0 #b11011101 #b11101101010100001011010)))
; expect = -4.0

(assert (not (= expect result)))

(check-sat)
(exit)
