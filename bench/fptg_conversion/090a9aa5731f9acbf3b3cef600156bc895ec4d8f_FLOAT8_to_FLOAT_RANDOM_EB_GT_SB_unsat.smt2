; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b001 #b0000)))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b001 #b1000)))
; arg1 = -0.25

(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10010111011 #b0110010)
                expect
                (fp #b1 #b01111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111101 #b0000000)
                expect
                (fp #b0 #b10110001001 #b1100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
