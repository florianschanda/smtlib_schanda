; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0111110 #b0001100111101111)
                arg1
                (fp #b0 #b0000000 #b1010110011010011)))
(assert (fp.leq (fp #b0 #b0000000 #b1010110011010011)
                arg1
                (fp #b0 #b1011010 #b0000111000010011)))
; arg1 = 0.000000000000000000146387807364734413677342939053005466121248900890350341796875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101000 #b01100101011010001010110)
                expect
                (fp #b0 #b01000000 #b01011001101001100000000)))
(assert (fp.leq (fp #b0 #b01000000 #b01011001101001100000000)
                expect
                (fp #b0 #b01101110 #b11101111000110000110000)))
; expect = 0.000000000000000000146387807364734413677342939053005466121248900890350341796875

(assert (= expect result))

(check-sat)
(exit)
