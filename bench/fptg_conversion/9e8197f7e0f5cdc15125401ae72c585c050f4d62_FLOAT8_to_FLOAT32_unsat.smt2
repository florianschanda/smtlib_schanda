(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1110)))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b0 #b010 #b0101)))
; arg1 = -15.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110111 #b01100000110110110111100)
                expect
                (fp #b1 #b10000010 #b11100000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b11100000000000000000000)
                expect
                (fp #b1 #b00000001 #b00000000111101010011001)))
; expect = -15.0

(assert (not (= expect result)))

(check-sat)
(exit)
