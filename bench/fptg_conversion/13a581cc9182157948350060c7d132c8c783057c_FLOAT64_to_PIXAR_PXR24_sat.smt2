(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT64
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011111111 #b1000011010010001110111100010010010011001000011011101)
                arg1
                (fp #b0 #b11110001100 #b0100110010001011000111101101000001011011101100100010)))
(assert (fp.leq (fp #b0 #b11110001100 #b0100110010001011000111101101000001011011101100100010)
                arg1
                (fp #b0 #b11110100010 #b1111111111110011110100011001010110100010101010001111)))

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
