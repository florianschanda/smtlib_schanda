; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b11001 #b1100100010)
                arg1
                (fp #b0 #b11101 #b1000010010)))
(assert (fp.leq (fp #b0 #b11101 #b1000010010)
                arg1
                (fp #b0 #b11110 #b1010101010)))
; arg1 = 24864.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0110100110 #b101100101)
                expect
                (fp #b0 #b1000001101 #b100001001)))
(assert (fp.leq (fp #b0 #b1000001101 #b100001001)
                expect
                (fp #b0 #b1110001011 #b110100000)))

(assert (= expect result))

(check-sat)
(exit)
