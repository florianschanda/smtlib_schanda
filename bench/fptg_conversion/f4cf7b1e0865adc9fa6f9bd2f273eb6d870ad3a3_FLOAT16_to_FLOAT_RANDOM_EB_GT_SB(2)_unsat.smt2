; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000110110)
                arg1
                (fp #b1 #b11001 #b0000110001)))
(assert (fp.leq (fp #b1 #b11001 #b0000110001)
                arg1
                (fp #b0 #b01010 #b1100110000)))
; arg1 = -1073.0

(declare-const result (_ FloatingPoint 16 6))
(assert (= result ((_ to_fp 16 6) rm arg1)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1000101111000100 #b11000)
                expect
                (fp #b1 #b1000000000001001 #b00010)))
(assert (fp.leq (fp #b1 #b1000000000001001 #b00010)
                expect
                (fp #b0 #b1111111010000101 #b11110)))

(assert (not (= expect result)))

(check-sat)
(exit)
