; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011 #b0100)
                arg1
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                arg1
                (fp #b0 #b100 #b1111)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 17 14))
(assert (= result ((_ to_fp 17 14) rm arg1)))

(declare-const expect (_ FloatingPoint 17 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01110110101101010 #b1110010010010)
                expect
                (fp #b0 #b00000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000000000000)
                expect
                (fp #b0 #b10101101111110000 #b1101111101000)))

(assert (= expect result))

(check-sat)
(exit)
