; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101100 #b0000101100101110)
                arg1
                (fp #b1 #b1101010 #b1010000111000101)))
(assert (fp.leq (fp #b1 #b1101010 #b1010000111000101)
                arg1
                (fp #b0 #b0111000 #b1100010001111100)))
; arg1 = -14354451791872.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111100 #b11011101110100010110100)
                expect
                (fp #b1 #b10101010 #b10100001110001010000000)))
(assert (fp.leq (fp #b1 #b10101010 #b10100001110001010000000)
                expect
                (fp #b0 #b10101000 #b00110100001100010001110)))
; expect = -14354451791872.0

(assert (not (= expect result)))

(check-sat)
(exit)
