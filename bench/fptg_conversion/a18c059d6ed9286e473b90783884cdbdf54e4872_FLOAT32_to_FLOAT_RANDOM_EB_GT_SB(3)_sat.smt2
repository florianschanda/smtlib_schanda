(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0101000011011111 #b1010010110)
                expect
                (fp #b0 #b1000000000110010 #b0010001110)))
(assert (fp.leq (fp #b0 #b1000000000110010 #b0010001110)
                expect
                (fp #b0 #b1010111101011111 #b0111110001)))

(assert (= expect result))

(check-sat)
(exit)
