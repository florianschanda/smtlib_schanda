                expect
                (fp #b1 #b10000110 #b00001100000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b00001100000000000000000)
                expect
                (fp #b0 #b01000100 #b11000010011100010110111)))
; expect = -134.0

