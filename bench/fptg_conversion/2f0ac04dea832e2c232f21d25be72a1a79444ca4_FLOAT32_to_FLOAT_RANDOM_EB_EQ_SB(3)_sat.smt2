                expect
                (fp #b1 #b100000000001001111 #b01100111100100011)))
(assert (fp.leq (fp #b1 #b100000000001001111 #b01100111100100011)
                expect
                (fp #b0 #b101100110111011011 #b10101111000001100)))

(assert (= expect result))

