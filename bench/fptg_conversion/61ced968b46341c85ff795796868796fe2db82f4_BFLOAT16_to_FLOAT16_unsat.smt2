; Format from: BFLOAT16
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100000 #b1101110)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b10011000 #b0110010)))
; arg1 = 59.75

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b10011 #b1101001101)
                expect
                (fp #b0 #b10100 #b1101111000)))
(assert (fp.leq (fp #b0 #b10100 #b1101111000)
                expect
                (fp #b0 #b11110 #b0001001100)))
; expect = 59.75

(assert (not (= expect result)))

(check-sat)
(exit)
