; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01010 #b0000110111)
                arg1
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                arg1
                (fp #b0 #b01000 #b0100111110)))
; arg1 = 0.00006103515625

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001001 #b11110)
                expect
                (fp #b0 #b010001 #b00000)))
(assert (fp.leq (fp #b0 #b010001 #b00000)
                expect
                (fp #b0 #b110000 #b01101)))
; expect = 0.00006103515625

(assert (= expect result))

(check-sat)
(exit)
