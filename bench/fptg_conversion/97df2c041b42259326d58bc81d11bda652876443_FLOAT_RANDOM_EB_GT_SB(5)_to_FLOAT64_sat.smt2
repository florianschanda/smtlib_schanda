(assert (fp.leq (fp #b1 #b11001100001 #b0011000011011011101011000011100010011110001010011001)
                expect
                (fp #b1 #b01111111111 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10101010001 #b1000010100110100111110101101110111010110101010101100)))

(assert (= expect result))

(check-sat)
