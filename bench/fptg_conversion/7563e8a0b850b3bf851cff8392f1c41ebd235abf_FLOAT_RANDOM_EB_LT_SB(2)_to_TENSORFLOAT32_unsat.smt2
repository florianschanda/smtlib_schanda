(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: TENSORFLOAT32
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 20))
(assert (fp.leq (fp #b1 #b01101011001 #b0010001001111001001)
                arg1
                (fp #b0 #b11111111101 #b0000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000)
                arg1
                (fp #b0 #b11111111101 #b1010010001101110101)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
