(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b001 #b0011)))
(assert (fp.leq (fp #b1 #b001 #b0011)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -0.296875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110101 #b0110111)
                expect
                (fp #b1 #b01111101 #b0011000)))
(assert (fp.leq (fp #b1 #b01111101 #b0011000)
                expect
                (fp #b0 #b10001100 #b0111110)))
; expect = -0.296875

(assert (= expect result))

(check-sat)
(exit)
