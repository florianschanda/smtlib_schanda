; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01100010111111001000111)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01111111 #b01001010111001100111110)))
; arg1 = -1316616.0

(declare-const result (_ FloatingPoint 16 23))
(assert (= result ((_ to_fp 16 23) rm arg1)))

(declare-const expect (_ FloatingPoint 16 23))
(assert (fp.leq (fp #b1 #b1101001101101000 #b1100011000100110101000)
                expect
                (fp #b1 #b1000000000010011 #b0100000101110000100000)))
(assert (fp.leq (fp #b1 #b1000000000010011 #b0100000101110000100000)
                expect
                (fp #b0 #b0010111010011110 #b0011110110101001001011)))

(assert (= expect result))

(check-sat)
(exit)
