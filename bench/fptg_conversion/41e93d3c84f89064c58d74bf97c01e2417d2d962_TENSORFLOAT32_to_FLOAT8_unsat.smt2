(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011110 #b1101000010)
                arg1
                (fp #b0 #b00000000 #b0111111111)))
(assert (fp.leq (fp #b0 #b00000000 #b0111111111)
                arg1
                (fp #b0 #b01000010 #b1110101101)))
