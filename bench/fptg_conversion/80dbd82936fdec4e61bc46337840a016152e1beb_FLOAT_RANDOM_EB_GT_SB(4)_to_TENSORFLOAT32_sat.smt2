; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100111 #b1101)
                arg1
                (fp #b1 #b011111 #b0111)))
(assert (fp.leq (fp #b1 #b011111 #b0111)
                arg1
                (fp #b1 #b011011 #b0000)))
; arg1 = -1.4375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000011 #b1111011000)
                expect
                (fp #b1 #b01111111 #b0111000000)))
(assert (fp.leq (fp #b1 #b01111111 #b0111000000)
                expect
                (fp #b0 #b01000100 #b1001101001)))
; expect = -1.4375

(assert (= expect result))

(check-sat)
(exit)
