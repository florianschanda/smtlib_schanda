(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1010101110011000 #b101011001001)
                arg1
                (fp #b1 #b0000000000000001 #b000000000000)))
