                expect
                (fp #b1 #b10001001 #b011011000100000)))
(assert (fp.leq (fp #b1 #b10001001 #b011011000100000)
                expect
                (fp #b0 #b00000111 #b000000000011101)))
; expect = -1457.0

(assert (not (= expect result)))

