; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10001 #b1010110010)
                arg1
                (fp #b0 #b00000 #b1011110010)))
(assert (fp.leq (fp #b0 #b00000 #b1011110010)
                arg1
                (fp #b0 #b01111 #b0101001010)))
; arg1 = 0.00004494190216064453125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00011110 #b1101011001)
                expect
                (fp #b0 #b01110000 #b0111100100)))
(assert (fp.leq (fp #b0 #b01110000 #b0111100100)
                expect
                (fp #b0 #b11001100 #b0111011010)))
; expect = 0.00004494190216064453125

(assert (= expect result))

(check-sat)
(exit)
