(assert (fp.leq (fp #b1 #b10000 #b0000000)
                expect
                (fp #b0 #b10100 #b1101111)))
(assert (fp.leq (fp #b0 #b10100 #b1101111)
                expect
                (fp #b0 #b10111 #b1001100)))
; expect = 59.75

(assert (= expect result))

(check-sat)
