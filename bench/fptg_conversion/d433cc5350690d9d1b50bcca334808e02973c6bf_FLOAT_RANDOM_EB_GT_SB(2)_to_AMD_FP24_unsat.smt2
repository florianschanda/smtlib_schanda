(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111010 #b0110100100101000)
                expect
                (fp #b1 #b0111111 #b0010000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0010000000000000)
                expect
                (fp #b0 #b1110010 #b1100110001000000)))
; expect = -1.125

(assert (not (= expect result)))

(check-sat)
