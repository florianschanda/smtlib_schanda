; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01101100 #b01100111001110001001010)
                arg1
                (fp #b0 #b10010010 #b10110101011110010100000)))
(assert (fp.leq (fp #b0 #b10010010 #b10110101011110010100000)
                arg1
                (fp #b0 #b11000001 #b11000001000101101011100)))
; arg1 = 895946.0

(declare-const result (_ FloatingPoint 9 5))
(assert (= result ((_ to_fp 9 5) rm arg1)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110011001 #b1000)
                expect
                (fp #b0 #b100010010 #b1100)))
(assert (fp.leq (fp #b0 #b100010010 #b1100)
                expect
                (fp #b0 #b111010010 #b1010)))

(assert (not (= expect result)))

(check-sat)
(exit)
