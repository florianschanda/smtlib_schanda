(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg1
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                arg1
                (fp #b0 #b011 #b0111)))
; arg1 = -0.046875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11010100 #b011101001111000)
                expect
                (fp #b1 #b01111010 #b100000000000000)))
(assert (fp.leq (fp #b1 #b01111010 #b100000000000000)
                expect
                (fp #b0 #b01110011 #b100110111110010)))
; expect = -0.046875

(assert (= expect result))

(check-sat)
(exit)
