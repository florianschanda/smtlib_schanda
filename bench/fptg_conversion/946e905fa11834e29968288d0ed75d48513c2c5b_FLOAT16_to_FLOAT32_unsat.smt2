; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1111011110)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b10100 #b0001011101)))
; arg1 = -1809.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001011 #b01100111011111110110011)
                expect
                (fp #b1 #b10001001 #b11000100010000000000000)))
(assert (fp.leq (fp #b1 #b10001001 #b11000100010000000000000)
                expect
                (fp #b1 #b01001111 #b10101100000000010101011)))
; expect = -1809.0

(assert (not (= expect result)))

(check-sat)
(exit)
