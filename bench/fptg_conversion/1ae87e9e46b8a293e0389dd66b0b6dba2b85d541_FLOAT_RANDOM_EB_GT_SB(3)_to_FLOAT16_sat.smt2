; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0010001011100011 #b000011)
                arg1
                (fp #b1 #b0000000000000000 #b011011)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b011011)
                arg1
                (fp #b0 #b1010111001101110 #b000100)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b0001011101)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10011 #b1010001101)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
