(assert (fp.leq (fp #b1 #b11001 #b0000101101)
                expect
                (fp #b1 #b01111 #b1110101110)))
(assert (fp.leq (fp #b1 #b01111 #b1110101110)
                expect
                (fp #b0 #b00110 #b0011000011)))
; expect = -1.919921875

(assert (= expect result))

