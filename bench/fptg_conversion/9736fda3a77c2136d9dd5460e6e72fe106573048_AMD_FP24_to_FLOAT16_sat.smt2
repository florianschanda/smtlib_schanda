(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001111 #b1000001011000011)
                arg1
                (fp #b1 #b0111111 #b1110101101011101)))
