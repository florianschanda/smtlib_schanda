; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0100010111 #b111)
                arg1
                (fp #b0 #b1111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000)
                arg1
                (fp #b0 #b1111111101 #b110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01001001011 #b0010111100)
                expect
                (fp #b0 #b10111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b10111111101 #b0000000000)
                expect
                (fp #b0 #b11100101110 #b0011101011)))

(assert (= expect result))

(check-sat)
(exit)
