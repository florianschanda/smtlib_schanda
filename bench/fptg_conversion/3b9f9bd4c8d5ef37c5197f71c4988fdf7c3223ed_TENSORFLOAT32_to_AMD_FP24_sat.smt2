; Format from: TENSORFLOAT32
; Format to: AMD_FP24
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01000001 #b1000000110)
                arg1
                (fp #b0 #b00000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000 #b0100000000)
                arg1
                (fp #b0 #b11100000 #b1010001000)))
