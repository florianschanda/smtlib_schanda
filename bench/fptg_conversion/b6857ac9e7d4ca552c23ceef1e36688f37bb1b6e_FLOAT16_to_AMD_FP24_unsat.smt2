                expect
                (fp #b1 #b0110011 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0110011 #b0000000000000000)
                expect
                (fp #b0 #b0011100 #b0001100010010000)))
; expect = -0.000244140625

(assert (not (= expect result)))

