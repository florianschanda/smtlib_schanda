; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg1
                (fp #b1 #b011 #b0101)))
; arg1 = -3.875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010001 #b0110111100011111)
                expect
                (fp #b1 #b1000000 #b1111000000000000)))
(assert (fp.leq (fp #b1 #b1000000 #b1111000000000000)
                expect
                (fp #b0 #b1011110 #b1000011001001110)))
; expect = -3.875

(assert (= expect result))

(check-sat)
(exit)
