; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0100 #b000)
                arg1
                (fp #b1 #b0000 #b010)))
(assert (fp.leq (fp #b1 #b0000 #b010)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = -0.00390625

(declare-const result (_ FloatingPoint 17 6))
(assert (= result ((_ to_fp 17 6) rm arg1)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b10111011110101110 #b01100)
                expect
                (fp #b1 #b01111111111110111 #b00000)))
(assert (fp.leq (fp #b1 #b01111111111110111 #b00000)
                expect
                (fp #b0 #b00000101000000011 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
