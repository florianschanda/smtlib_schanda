; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10001101 #b01110010000111101010111)
                arg1
                (fp #b0 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b0 #b10100001 #b11010101001111011001010)))
; arg1 = 16777216.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b1001001 #b0011010011010010)
                expect
                (fp #b0 #b1010111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1010111 #b0000000000000000)
                expect
                (fp #b0 #b1101010 #b1100101111111010)))
; expect = 16777216.0

(assert (not (= expect result)))

(check-sat)
(exit)
