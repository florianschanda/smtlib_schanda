; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011001 #b111000000)
                arg1
                (fp #b0 #b0011100110 #b101001010)))
(assert (fp.leq (fp #b0 #b0011100110 #b101001010)
                arg1
                (fp #b0 #b0100000010 #b001110110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01110110 #b1010110111)
                expect
                (fp #b0 #b00000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000000001)
                expect
                (fp #b0 #b10001001 #b1001101001)))
; expect = 0.0000000000000000000000000000000000000000114794370197489014450071927463109929474479058278524172022339033816251685493625700473785400390625

(assert (= expect result))

(check-sat)
(exit)
