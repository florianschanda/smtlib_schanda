(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0000)
                arg1
                (fp #b1 #b100 #b1011)))
(assert (fp.leq (fp #b1 #b100 #b1011)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = -3.375

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b10)
                expect
                (fp #b1 #b1000 #b11)))
(assert (fp.leq (fp #b1 #b1000 #b11)
                expect
                (fp #b1 #b0000 #b01)))
; expect = -3.5

(assert (not (= expect result)))

(check-sat)
(exit)
