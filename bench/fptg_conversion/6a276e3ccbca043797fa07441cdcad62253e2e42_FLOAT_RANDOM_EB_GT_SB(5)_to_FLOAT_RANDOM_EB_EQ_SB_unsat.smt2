; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b001)
                arg1
                (fp #b1 #b11101 #b000)))
(assert (fp.leq (fp #b1 #b11101 #b000)
                arg1
                (fp #b0 #b11001 #b010)))
; arg1 = -16384.0

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000110101 #b1001001110)
                expect
                (fp #b1 #b10000001101 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001101 #b0000000000)
                expect
                (fp #b0 #b11111011111 #b0010101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
