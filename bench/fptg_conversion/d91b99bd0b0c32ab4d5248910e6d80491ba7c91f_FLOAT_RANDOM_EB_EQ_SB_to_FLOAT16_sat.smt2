; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110100 #b01011011)
                arg1
                (fp #b0 #b010001111 #b10110101)))
(assert (fp.leq (fp #b0 #b010001111 #b10110101)
                arg1
                (fp #b0 #b011000011 #b10101011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10100 #b0110101010)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10100 #b0011011000)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
