                expect
                (fp #b0 #b01101101 #b11101000000000000000000)))
(assert (fp.leq (fp #b0 #b01101101 #b11101000000000000000000)
                expect
                (fp #b0 #b11001110 #b10001100110001101010010)))
; expect = 0.00000727176666259765625

(assert (= expect result))

(check-sat)
