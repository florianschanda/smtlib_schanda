; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b001110 #b01001)
                arg1
                (fp #b1 #b000000 #b10001)))
(assert (fp.leq (fp #b1 #b000000 #b10001)
                arg1
                (fp #b0 #b100100 #b00000)))
; arg1 = -0.00000000049476511776447296142578125

(declare-const result (_ FloatingPoint 15 9))
(assert (= result ((_ to_fp 15 9) rm arg1)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b100110110001110 #b00111010)
                expect
                (fp #b1 #b011111111100000 #b00010000)))
(assert (fp.leq (fp #b1 #b011111111100000 #b00010000)
                expect
                (fp #b0 #b110111001000011 #b11100100)))

(assert (= expect result))

(check-sat)
(exit)
