(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b0111110111)
                arg1
                (fp #b0 #b01111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111 #b1001100100)
                arg1
                (fp #b0 #b11110 #b1010100111)))
; arg1 = 1.59765625

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001111101 #b11101101)
                expect
                (fp #b0 #b011111111 #b10011001)))
(assert (fp.leq (fp #b0 #b011111111 #b10011001)
                expect
                (fp #b0 #b100100000 #b00000111)))

(assert (= expect result))

(check-sat)
(exit)
