; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b010001100 #b00011)
                arg1
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg1
                (fp #b0 #b100111000 #b00011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111100 #b0111111011)
                expect
                (fp #b0 #b10000101 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000101 #b0000000000)
                expect
                (fp #b0 #b10110100 #b0000010010)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
