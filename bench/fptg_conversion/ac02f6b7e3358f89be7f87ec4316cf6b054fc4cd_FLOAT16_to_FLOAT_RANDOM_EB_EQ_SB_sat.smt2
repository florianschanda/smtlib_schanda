; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00011 #b1010010100)
                arg1
                (fp #b0 #b00000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000 #b0100000000)
                arg1
                (fp #b0 #b00010 #b1011110100)))
; arg1 = 0.0000152587890625

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00110 #b0110)
                expect
                (fp #b0 #b00000 #b0100)))
(assert (fp.leq (fp #b0 #b00000 #b0100)
                expect
                (fp #b0 #b00101 #b0011)))
; expect = 0.0000152587890625

(assert (= expect result))

(check-sat)
(exit)
