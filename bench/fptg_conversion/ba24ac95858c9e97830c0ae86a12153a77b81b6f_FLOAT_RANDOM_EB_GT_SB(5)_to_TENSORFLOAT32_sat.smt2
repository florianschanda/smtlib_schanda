(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b1 #b010 #b0)))
(assert (fp.leq (fp #b1 #b010 #b0)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111101 #b0000110100)
                expect
                (fp #b1 #b01111110 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b0000000000)
                expect
                (fp #b0 #b01101000 #b0000000101)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
