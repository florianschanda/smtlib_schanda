(assert (fp.leq (fp #b1 #b1010001 #b1000101000100101)
                expect
                (fp #b1 #b1000101 #b0111010000000000)))
(assert (fp.leq (fp #b1 #b1000101 #b0111010000000000)
                expect
                (fp #b0 #b1110101 #b0110001101100011)))
; expect = -93.0

(assert (not (= expect result)))

(check-sat)
