(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b01)
                arg1
                (fp #b1 #b011 #b01)))
(assert (fp.leq (fp #b1 #b011 #b01)
                arg1
                (fp #b0 #b100 #b11)))
; arg1 = -1.25

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001000 #b11001011010010100010001)
                expect
                (fp #b1 #b01111111 #b01000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b01000000000000000000000)
                expect
                (fp #b0 #b01100010 #b10010011001101010101011)))
; expect = -1.25

(assert (= expect result))

(check-sat)
(exit)
