; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b1111010100)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b0 #b01100000 #b0001100000)))
; arg1 = -264.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111111 #b01010010001011110000101)
                expect
                (fp #b1 #b10000111 #b00001000000000000000000)))
(assert (fp.leq (fp #b1 #b10000111 #b00001000000000000000000)
                expect
                (fp #b1 #b00011011 #b00100101101011101100000)))
; expect = -264.0

(assert (not (= expect result)))

(check-sat)
(exit)
