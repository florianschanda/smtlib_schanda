; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1110001100110110)
                arg1
                (fp #b1 #b1001111 #b0101110100010011)))
(assert (fp.leq (fp #b1 #b1001111 #b0101110100010011)
                arg1
                (fp #b1 #b0011101 #b1010101001110010)))
; arg1 = -89363.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011110 #b11001101000101101010011)
                expect
                (fp #b1 #b10001111 #b01011101000100110000000)))
(assert (fp.leq (fp #b1 #b10001111 #b01011101000100110000000)
                expect
                (fp #b0 #b01110111 #b11001110001101001001100)))
; expect = -89363.0

(assert (= expect result))

(check-sat)
(exit)
