(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01111001 #b1000000000)
                arg1
                (fp #b0 #b10111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b1111111111)
                arg1
                (fp #b0 #b11100010 #b1011110110)))
; arg1 = 18437736874454810624.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01101010 #b1010100)
                expect
                (fp #b0 #b10111111 #b0000000)))
(assert (fp.leq (fp #b0 #b10111111 #b0000000)
                expect
                (fp #b0 #b11100000 #b0011101)))
; expect = 18446744073709551616.0

(assert (= expect result))

(check-sat)
(exit)
