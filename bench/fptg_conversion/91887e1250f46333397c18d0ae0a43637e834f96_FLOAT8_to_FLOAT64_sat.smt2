(assert (fp.leq (fp #b1 #b11001001010 #b0011100001100001000100110100110010100000101011011110)
                expect
                (fp #b1 #b01111111100 #b1110000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111100 #b1110000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00110100111 #b0010101001010100001010100011101100101001111001000000)))

(assert (= expect result))

(check-sat)
