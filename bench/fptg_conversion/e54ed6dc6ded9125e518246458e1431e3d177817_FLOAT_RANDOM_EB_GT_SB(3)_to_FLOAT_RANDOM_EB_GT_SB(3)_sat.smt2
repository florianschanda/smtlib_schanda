; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b10)
                arg1
                (fp #b0 #b1010 #b10)))
(assert (fp.leq (fp #b0 #b1010 #b10)
                arg1
                (fp #b0 #b1101 #b10)))
; arg1 = 12.0

(declare-const result (_ FloatingPoint 7 5))
(assert (= result ((_ to_fp 7 5) rm arg1)))

(declare-const expect (_ FloatingPoint 7 5))
(assert (fp.leq (fp #b0 #b0011010 #b1010)
                expect
                (fp #b0 #b1000010 #b1000)))
(assert (fp.leq (fp #b0 #b1000010 #b1000)
                expect
                (fp #b0 #b1001001 #b0011)))
; expect = 12.0

(assert (= expect result))

(check-sat)
(exit)
