(set-info :category "random")
(set-info :status unsat)

; Format from: TENSORFLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111011 #b0011111001)
                arg1
                (fp #b1 #b11100110 #b1110111011)))
(assert (fp.leq (fp #b1 #b11100110 #b1110111011)
                arg1
                (fp #b1 #b01010100 #b0110011101)))
; arg1 = -19599066701966140512202934714368.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
