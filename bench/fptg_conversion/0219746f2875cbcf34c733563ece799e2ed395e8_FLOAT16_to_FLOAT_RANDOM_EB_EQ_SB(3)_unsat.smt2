(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b1010111110)
                arg1
                (fp #b1 #b00000 #b0010001101)))
(assert (fp.leq (fp #b1 #b00000 #b0010001101)
                arg1
                (fp #b0 #b00111 #b0010000111)))
; arg1 = -0.000008404254913330078125

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b000)
                expect
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                expect
                (fp #b0 #b0100 #b011)))
; expect = -0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
