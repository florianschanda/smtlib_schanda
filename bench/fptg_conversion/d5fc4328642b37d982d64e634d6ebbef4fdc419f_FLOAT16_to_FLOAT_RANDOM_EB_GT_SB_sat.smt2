; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000011)
                arg1
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg1
                (fp #b0 #b10001 #b1110111101)))
; arg1 = -0.0000152587890625

(declare-const result (_ FloatingPoint 14 3))
(assert (= result ((_ to_fp 14 3) rm arg1)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11000111110011 #b10)
                expect
                (fp #b1 #b01111111101111 #b00)))
(assert (fp.leq (fp #b1 #b01111111101111 #b00)
                expect
                (fp #b0 #b10101101110111 #b10)))

(assert (= expect result))

(check-sat)
(exit)
