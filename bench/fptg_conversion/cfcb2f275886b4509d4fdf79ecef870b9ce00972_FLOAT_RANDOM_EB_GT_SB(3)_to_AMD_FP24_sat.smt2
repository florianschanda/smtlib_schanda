(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100111000001 #b011)
                arg1
                (fp #b1 #b100000000001 #b010)))
(assert (fp.leq (fp #b1 #b100000000001 #b010)
                arg1
                (fp #b0 #b101100111011 #b101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000110 #b1111100110000100)
                expect
                (fp #b1 #b1000001 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b1000001 #b0100000000000000)
                expect
                (fp #b0 #b1101001 #b1100111100001101)))
; expect = -5.0

(assert (= expect result))

(check-sat)
(exit)
