                expect
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b1000101 #b1000001111111001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
