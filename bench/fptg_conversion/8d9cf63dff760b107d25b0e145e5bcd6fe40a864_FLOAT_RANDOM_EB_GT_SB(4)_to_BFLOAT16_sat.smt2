; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1010 #b00)
                arg1
                (fp #b0 #b1001 #b01)))
(assert (fp.leq (fp #b0 #b1001 #b01)
                arg1
                (fp #b0 #b1100 #b10)))
; arg1 = 5.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01010001 #b0110000)
                expect
                (fp #b0 #b10000001 #b0100000)))
(assert (fp.leq (fp #b0 #b10000001 #b0100000)
                expect
                (fp #b0 #b10000101 #b1011011)))
; expect = 5.0

(assert (= expect result))

(check-sat)
(exit)
