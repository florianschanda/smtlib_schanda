; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00101 #b1011)
                arg1
                (fp #b0 #b01000 #b0000)))
(assert (fp.leq (fp #b0 #b01000 #b0000)
                arg1
                (fp #b0 #b10011 #b1001)))
; arg1 = 0.0078125

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100000 #b1111110010010001)
                expect
                (fp #b0 #b0111000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111000 #b0000000000000000)
                expect
                (fp #b0 #b1001001 #b0111000001001101)))
; expect = 0.0078125

(assert (= expect result))

(check-sat)
(exit)
