; Format from: TENSORFLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00110010 #b0010111011)
                arg1
                (fp #b0 #b10000000 #b1000110110)))
(assert (fp.leq (fp #b0 #b10000000 #b1000110110)
                arg1
                (fp #b0 #b11101000 #b1010010100)))
; arg1 = 3.10546875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0010111 #b0110000110111110)
                expect
                (fp #b0 #b1000000 #b1000110110000000)))
(assert (fp.leq (fp #b0 #b1000000 #b1000110110000000)
                expect
                (fp #b0 #b1101100 #b0001100011011011)))
; expect = 3.10546875

(assert (= expect result))

(check-sat)
(exit)
