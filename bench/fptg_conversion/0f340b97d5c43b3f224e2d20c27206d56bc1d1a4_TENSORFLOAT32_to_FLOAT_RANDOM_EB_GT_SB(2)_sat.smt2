(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111011 #b0101100000)
                arg1
                (fp #b1 #b01111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111 #b1111110100)
                arg1
                (fp #b1 #b00101001 #b1001111011)))
; arg1 = -1.98828125

(declare-const result (_ FloatingPoint 15 5))
(assert (= result ((_ to_fp 15 5) rm arg1)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b100100000110101 #b1000)
                expect
                (fp #b1 #b100000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b100000000000000 #b0000)
                expect
                (fp #b0 #b110101000000101 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
