                expect
                (fp #b0 #b10001101 #b0110111)))
(assert (fp.leq (fp #b0 #b10001101 #b0110111)
                expect
                (fp #b0 #b11100001 #b0100101)))
; expect = 23424.0

(assert (= expect result))

(check-sat)
