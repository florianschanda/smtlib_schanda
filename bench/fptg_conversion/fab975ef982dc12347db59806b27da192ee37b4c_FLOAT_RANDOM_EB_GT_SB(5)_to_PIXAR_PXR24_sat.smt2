(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10010011 #b101100010101110)
                expect
                (fp #b1 #b10000100 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10000100 #b000000000000000)
                expect
                (fp #b0 #b10010011 #b100111001001100)))
; expect = -32.0

(assert (= expect result))

(check-sat)
