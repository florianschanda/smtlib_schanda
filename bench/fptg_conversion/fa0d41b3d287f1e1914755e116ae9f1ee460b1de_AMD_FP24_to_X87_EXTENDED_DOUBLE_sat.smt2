(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110011111110010 #b010001011010100101011111000110101001011100001100111111110111110)
                expect
                (fp #b1 #b100000000001111 #b010111010001001100000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000001111 #b010111010001001100000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b000001001110001 #b111111001100001010110000111011110111110111110001111011010100010)))

(assert (= expect result))

(check-sat)
(exit)
