; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101110 #b01000000001110000110110)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b1 #b00111001 #b10110100010110000100111)))
; arg1 = -14198738255872.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100100110 #b111100110)
                expect
                (fp #b1 #b1000101010 #b100111011)))
(assert (fp.leq (fp #b1 #b1000101010 #b100111011)
                expect
                (fp #b0 #b1011111110 #b011001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
