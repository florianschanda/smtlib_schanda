; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b11)
                arg1
                (fp #b0 #b000 #b01)))
(assert (fp.leq (fp #b0 #b000 #b01)
                arg1
                (fp #b0 #b001 #b00)))
; arg1 = 0.0625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00110111 #b00011101100000000111111)
                expect
                (fp #b0 #b01111011 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111011 #b00000000000000000000000)
                expect
                (fp #b0 #b11110000 #b00101100011111111100110)))
; expect = 0.0625

(assert (not (= expect result)))

(check-sat)
(exit)
