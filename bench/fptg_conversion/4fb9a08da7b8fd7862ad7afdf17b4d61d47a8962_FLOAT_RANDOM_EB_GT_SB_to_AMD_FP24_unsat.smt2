; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0010001111011 #b0111)
                arg1
                (fp #b1 #b0000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000)
                arg1
                (fp #b0 #b1011101011100 #b0111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1010100 #b1011000100100111)
                expect
                (fp #b1 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b0000000000000000)
                expect
                (fp #b0 #b0111110 #b1110100100101110)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
