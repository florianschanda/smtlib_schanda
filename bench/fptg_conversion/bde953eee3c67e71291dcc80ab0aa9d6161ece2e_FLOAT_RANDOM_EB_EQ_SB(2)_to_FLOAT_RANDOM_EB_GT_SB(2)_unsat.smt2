; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1001 #b000)
                arg1
                (fp #b0 #b1011 #b101)))
(assert (fp.leq (fp #b0 #b1011 #b101)
                arg1
                (fp #b0 #b1100 #b100)))
; arg1 = 26.0

(declare-const result (_ FloatingPoint 11 2))
(assert (= result ((_ to_fp 11 2) rm arg1)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b00100110111 #b0)
                expect
                (fp #b0 #b10000000100 #b0)))
(assert (fp.leq (fp #b0 #b10000000100 #b0)
                expect
                (fp #b0 #b10101010100 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
