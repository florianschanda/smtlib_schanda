; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                arg1
                (fp #b1 #b10000 #b1)))
(assert (fp.leq (fp #b1 #b10000 #b1)
                arg1
                (fp #b1 #b01010 #b0)))
; arg1 = -3.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111100101 #b1110000010001011100100010110010101000010101111001001)
                expect
                (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01001110000 #b0001001111011100001000001001011111100111001111101110)))

(assert (= expect result))

(check-sat)
(exit)
