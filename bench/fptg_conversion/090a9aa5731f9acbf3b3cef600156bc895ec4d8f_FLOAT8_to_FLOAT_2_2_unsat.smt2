(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT_2_2
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b001 #b0000)))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b001 #b1000)))
; arg1 = -0.25

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b00 #b1)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
