(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b010)
                arg1
                (fp #b1 #b1100 #b010)))
(assert (fp.leq (fp #b1 #b1100 #b010)
                arg1
                (fp #b0 #b1100 #b010)))
; arg1 = -40.0

(declare-const result (_ FloatingPoint 15 2))
(assert (= result ((_ to_fp 15 2) rm arg1)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b100000000110010 #b0)
                expect
                (fp #b1 #b100000000000100 #b1)))
(assert (fp.leq (fp #b1 #b100000000000100 #b1)
                expect
                (fp #b1 #b010011101000111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
