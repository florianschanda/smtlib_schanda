; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011001 #b10111001001000100010110)
                arg1
                (fp #b1 #b10010100 #b11001001111011010000100)))
(assert (fp.leq (fp #b1 #b10010100 #b11001001111011010000100)
                arg1
                (fp #b1 #b00011101 #b11001100101011101011000)))
; arg1 = -3751329.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110010010101110 #b100110110000111010010111101000001110100101101011001111111010110)
                expect
                (fp #b1 #b100000000010100 #b110010011110110100001000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000010100 #b110010011110110100001000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b100010010001110 #b110101101100001101100010011101100010111110010100111111111111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
