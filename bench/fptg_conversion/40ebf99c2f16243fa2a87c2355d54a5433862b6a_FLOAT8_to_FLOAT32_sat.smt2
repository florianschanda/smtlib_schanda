(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1100)
                arg1
                (fp #b1 #b000 #b0110)))
(assert (fp.leq (fp #b1 #b000 #b0110)
                arg1
                (fp #b0 #b000 #b1110)))
; arg1 = -0.09375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001100 #b01011101110011011110101)
                expect
                (fp #b1 #b01111011 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111011 #b10000000000000000000000)
                expect
                (fp #b0 #b01001111 #b10011000101011010000111)))
; expect = -0.09375

(assert (= expect result))

(check-sat)
(exit)
