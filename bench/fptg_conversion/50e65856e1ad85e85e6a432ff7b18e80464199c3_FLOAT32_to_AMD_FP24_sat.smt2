; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b01111011 #b10111000011000001010001)
                arg1
                (fp #b0 #b10011101 #b00000111101001011001111)))
(assert (fp.leq (fp #b0 #b10011101 #b00000111101001011001111)
                arg1
                (fp #b0 #b10101011 #b01110011101010100110101)))
; arg1 = 1105815424.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101101 #b0000001100110001)
                expect
                (fp #b0 #b1011101 #b0000011110100110)))
(assert (fp.leq (fp #b0 #b1011101 #b0000011110100110)
                expect
                (fp #b0 #b1101010 #b1001010000101101)))
; expect = 1105821696.0

(assert (= expect result))

(check-sat)
(exit)
