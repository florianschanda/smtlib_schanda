; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100110100010110101 #b01010011001000011)
                arg1
                (fp #b1 #b100000000000001111 #b10011100010010110)))
(assert (fp.leq (fp #b1 #b100000000000001111 #b10011100010010110)
                arg1
                (fp #b0 #b110111111010111001 #b00001001111010100)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b0011001)
                expect
                (fp #b1 #b10001111 #b1001111)))
(assert (fp.leq (fp #b1 #b10001111 #b1001111)
                expect
                (fp #b0 #b00101001 #b1101001)))
; expect = -105984.0

(assert (= expect result))

(check-sat)
(exit)
