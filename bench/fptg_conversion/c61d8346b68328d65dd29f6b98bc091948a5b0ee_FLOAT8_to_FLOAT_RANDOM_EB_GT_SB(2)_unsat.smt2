(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0010101011111 #b1101)
                expect
                (fp #b0 #b0111111111100 #b1100)))
(assert (fp.leq (fp #b0 #b0111111111100 #b1100)
                expect
                (fp #b0 #b1001010001101 #b0100)))

(assert (not (= expect result)))

(check-sat)
