; Format from: BFLOAT16
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10010010 #b1101100)
                arg1
                (fp #b1 #b01010110 #b0010101)))
(assert (fp.leq (fp #b1 #b01010110 #b0010101)
                arg1
                (fp #b0 #b00000100 #b1010001)))
; arg1 = -0.000000000000529354338141274638473987579345703125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0110)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b110 #b1111)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
