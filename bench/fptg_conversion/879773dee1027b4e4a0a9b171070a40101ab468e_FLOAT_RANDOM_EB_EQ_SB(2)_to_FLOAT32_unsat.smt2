                expect
                (fp #b0 #b01111011 #b00100000000000000000000)))
(assert (fp.leq (fp #b0 #b01111011 #b00100000000000000000000)
                expect
                (fp #b0 #b10110001 #b10101100001111011001110)))
; expect = 0.0703125

