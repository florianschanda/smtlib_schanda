; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00111110 #b10100011101011011010110)
                arg1
                (fp #b0 #b10111110 #b11111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111110 #b11111111111111111111111)
                arg1
                (fp #b0 #b11001001 #b11011011110001101011010)))
; arg1 = 18446742974197923840.0

(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00100111011001 #b1110001001101)
                expect
                (fp #b0 #b10000000111111 #b0000000000000)))
(assert (fp.leq (fp #b0 #b10000000111111 #b0000000000000)
                expect
                (fp #b0 #b10001100010010 #b1101001010111)))

(assert (= expect result))

(check-sat)
(exit)
