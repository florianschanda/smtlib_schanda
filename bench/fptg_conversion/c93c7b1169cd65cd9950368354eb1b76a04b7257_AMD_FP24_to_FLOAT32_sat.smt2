; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100101 #b0000001100111011)
                arg1
                (fp #b1 #b1100000 #b1111110001110100)))
(assert (fp.leq (fp #b1 #b1100000 #b1111110001110100)
                arg1
                (fp #b0 #b1101000 #b0010111100000100)))
; arg1 = -17060855808.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000100 #b10101101100111100010010)
                expect
                (fp #b1 #b10100000 #b11111100011101000000000)))
(assert (fp.leq (fp #b1 #b10100000 #b11111100011101000000000)
                expect
                (fp #b1 #b00001100 #b00101110000001100111101)))
; expect = -17060855808.0

(assert (= expect result))

(check-sat)
(exit)
