; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010110 #b0101110100)
                arg1
                (fp #b1 #b01111111 #b0100110000)))
(assert (fp.leq (fp #b1 #b01111111 #b0100110000)
                arg1
                (fp #b1 #b00001111 #b0011110110)))
; arg1 = -1.296875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010001 #b00110000111100000100111)
                expect
                (fp #b1 #b01111111 #b01001100000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b01001100000000000000000)
                expect
                (fp #b1 #b01011000 #b11010111011011010111011)))
; expect = -1.296875

(assert (not (= expect result)))

(check-sat)
(exit)
