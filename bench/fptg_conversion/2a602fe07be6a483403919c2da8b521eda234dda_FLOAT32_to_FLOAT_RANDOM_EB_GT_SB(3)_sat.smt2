; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11011100011100010010101)
                arg1
                (fp #b0 #b10111110 #b01100110010000010010011)))
(assert (fp.leq (fp #b0 #b10111110 #b01100110010000010010011)
                arg1
                (fp #b0 #b11111001 #b00111010110001001100101)))
; arg1 = 12907478160253124608.0

(declare-const result (_ FloatingPoint 18 10))
(assert (= result ((_ to_fp 18 10) rm arg1)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b0 #b001000001010101011 #b000100110)
                expect
                (fp #b0 #b100000000000111110 #b011001101)))
(assert (fp.leq (fp #b0 #b100000000000111110 #b011001101)
                expect
                (fp #b0 #b111010100110011010 #b001000111)))

(assert (= expect result))

(check-sat)
(exit)
