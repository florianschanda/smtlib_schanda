                expect
                (fp #b0 #b011111111111111 #b100110010000000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b100110010000000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b111101101101010 #b100101111011101000000110010010001101010000100110100100001010110)))

(assert (= expect result))

(check-sat)
