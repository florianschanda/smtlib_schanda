; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b01)
                arg1
                (fp #b0 #b011 #b11)))
(assert (fp.leq (fp #b0 #b011 #b11)
                arg1
                (fp #b0 #b111 #b00)))
; arg1 = 1.75

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00111 #b0000101110)
                expect
                (fp #b0 #b01111 #b1100000000)))
(assert (fp.leq (fp #b0 #b01111 #b1100000000)
                expect
                (fp #b0 #b11000 #b1110100110)))
; expect = 1.75

(assert (not (= expect result)))

(check-sat)
(exit)
