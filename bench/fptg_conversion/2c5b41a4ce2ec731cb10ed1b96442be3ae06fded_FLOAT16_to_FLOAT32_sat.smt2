; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01110 #b0010010101)
                arg1
                (fp #b1 #b00000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000 #b1111111111)
                arg1
                (fp #b1 #b00000 #b0011000000)))
; arg1 = -0.000060975551605224609375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011111 #b10110110111011110010000)
                expect
                (fp #b1 #b01110000 #b11111111100000000000000)))
(assert (fp.leq (fp #b1 #b01110000 #b11111111100000000000000)
                expect
                (fp #b0 #b11111101 #b11010100011010010010011)))
; expect = -0.000060975551605224609375

(assert (= expect result))

(check-sat)
(exit)
