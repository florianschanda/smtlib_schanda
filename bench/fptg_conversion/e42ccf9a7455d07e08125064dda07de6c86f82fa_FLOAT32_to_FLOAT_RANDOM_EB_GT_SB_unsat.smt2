                expect
                (fp #b0 #b1000000000010010 #b10110101100)))
(assert (fp.leq (fp #b0 #b1000000000010010 #b10110101100)
                expect
                (fp #b0 #b1100110001100111 #b01110111010)))

(assert (not (= expect result)))

