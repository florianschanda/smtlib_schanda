(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0011100101001010)
                arg1
                (fp #b1 #b1001110 #b1001100011111110)))
(assert (fp.leq (fp #b1 #b1001110 #b1001100011111110)
                arg1
                (fp #b0 #b0010010 #b1010111011100101)))
; arg1 = -52351.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1100010101)
                expect
                (fp #b1 #b11110 #b1001100100)))
(assert (fp.leq (fp #b1 #b11110 #b1001100100)
                expect
                (fp #b0 #b00010 #b0101000100)))
; expect = -52352.0

(assert (not (= expect result)))

(check-sat)
(exit)
