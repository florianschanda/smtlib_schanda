(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 3 37))
(assert (fp.leq (fp #b1 #b001 #b000101110100000101001100110110110000)
                arg1
                (fp #b1 #b000 #b000101100010101000010010110010001101)))
(assert (fp.leq (fp #b1 #b000 #b000101100010101000010010110010001101)
                arg1
                (fp #b0 #b010 #b110110110001001101111111111111000001)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010110 #b00100111111100000001001)
                expect
                (fp #b1 #b01111001 #b01100010101000010010111)))
(assert (fp.leq (fp #b1 #b01111001 #b01100010101000010010111)
                expect
                (fp #b0 #b10010011 #b01111100111100011101101)))
; expect = -0.02164487354457378387451171875

(assert (= expect result))

(check-sat)
(exit)
