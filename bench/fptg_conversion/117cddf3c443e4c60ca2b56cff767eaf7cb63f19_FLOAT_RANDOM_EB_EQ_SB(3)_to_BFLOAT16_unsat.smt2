                expect
                (fp #b0 #b10011101 #b0000000)))
(assert (fp.leq (fp #b0 #b10011101 #b0000000)
                expect
                (fp #b0 #b11100111 #b1001001)))
; expect = 1073741824.0

(assert (not (= expect result)))

