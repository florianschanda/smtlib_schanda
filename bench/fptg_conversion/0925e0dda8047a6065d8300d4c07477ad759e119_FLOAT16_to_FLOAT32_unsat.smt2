(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b1111100101)
                arg1
                (fp #b0 #b11001 #b1111110011)))
(assert (fp.leq (fp #b0 #b11001 #b1111110011)
                arg1
                (fp #b0 #b11010 #b1111100111)))
; arg1 = 2035.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01010011 #b11000000010001001100111)
                expect
                (fp #b0 #b10001001 #b11111100110000000000000)))
(assert (fp.leq (fp #b0 #b10001001 #b11111100110000000000000)
                expect
                (fp #b0 #b11101001 #b11010100110010010101111)))
; expect = 2035.0

(assert (not (= expect result)))

(check-sat)
(exit)
