; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011110101010011 #b101100010101000)
                arg1
                (fp #b0 #b1000000000001101 #b111010100010010)))
(assert (fp.leq (fp #b0 #b1000000000001101 #b111010100010010)
                arg1
                (fp #b0 #b1100101101110100 #b001011000101001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101110 #b1110010)
                expect
                (fp #b0 #b10001101 #b1110110)))
(assert (fp.leq (fp #b0 #b10001101 #b1110110)
                expect
                (fp #b0 #b10111011 #b0001000)))
; expect = 31488.0

(assert (= expect result))

(check-sat)
