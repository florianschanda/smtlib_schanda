(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000101001 #b0000011000000011101011110111101000101111010001110111)
                expect
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10110100011 #b0001000010010000101110010110011000100011101001011100)))

(assert (not (= expect result)))

(check-sat)
