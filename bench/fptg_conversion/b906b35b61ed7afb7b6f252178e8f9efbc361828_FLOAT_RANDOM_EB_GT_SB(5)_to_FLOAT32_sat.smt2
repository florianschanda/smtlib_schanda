(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101010000 #b0111111)
                arg1
                (fp #b1 #b100000110 #b0110001)))
(assert (fp.leq (fp #b1 #b100000110 #b0110001)
                arg1
                (fp #b1 #b001101000 #b1011000)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101100 #b01001111010101110110101)
                expect
                (fp #b1 #b10000110 #b01100010000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b01100010000000000000000)
                expect
                (fp #b1 #b01110000 #b00111001110101011110111)))
; expect = -177.0

(assert (= expect result))

(check-sat)
(exit)
