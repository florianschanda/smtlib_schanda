; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010001 #b0101111110)
                arg1
                (fp #b0 #b01111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b0000000000)
                arg1
                (fp #b0 #b11110101 #b1111100110)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 12 2))
(assert (= result ((_ to_fp 12 2) rm arg1)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b001110000100 #b1)
                expect
                (fp #b0 #b011111111111 #b0)))
(assert (fp.leq (fp #b0 #b011111111111 #b0)
                expect
                (fp #b0 #b111000110001 #b0)))

(assert (= expect result))

(check-sat)
(exit)
