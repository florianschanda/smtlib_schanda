(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b110 #b01)
                arg1
                (fp #b0 #b011 #b11)))
(assert (fp.leq (fp #b0 #b011 #b11)
                arg1
                (fp #b0 #b111 #b00)))
; arg1 = 1.75

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01001111 #b100001101000100)
                expect
                (fp #b0 #b01111111 #b110000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b110000000000000)
                expect
                (fp #b0 #b10001110 #b111100110100110)))
; expect = 1.75

(assert (= expect result))

(check-sat)
(exit)
