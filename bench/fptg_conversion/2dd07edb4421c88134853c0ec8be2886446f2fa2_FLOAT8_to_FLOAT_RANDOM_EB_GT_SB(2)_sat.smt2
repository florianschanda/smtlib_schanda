; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg1
                (fp #b1 #b000 #b0011)))
(assert (fp.leq (fp #b1 #b000 #b0011)
                arg1
                (fp #b0 #b011 #b0111)))
; arg1 = -0.046875

(declare-const result (_ FloatingPoint 11 5))
(assert (= result ((_ to_fp 11 5) rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111000 #b1000)
                expect
                (fp #b1 #b01111111010 #b1000)))
(assert (fp.leq (fp #b1 #b01111111010 #b1000)
                expect
                (fp #b0 #b00000100101 #b0010)))

(assert (= expect result))

(check-sat)
(exit)
