(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01001010 #b001110100111101)
                expect
                (fp #b0 #b10000010 #b110110101100000)))
(assert (fp.leq (fp #b0 #b10000010 #b110110101100000)
                expect
                (fp #b0 #b11001111 #b101100111110000)))
; expect = 14.8359375

(assert (= expect result))

(check-sat)
