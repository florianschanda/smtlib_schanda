; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000110010 #b0011011100)
                arg1
                (fp #b1 #b01010111000 #b1011111111)))
(assert (fp.leq (fp #b1 #b01010111000 #b1011111111)
                arg1
                (fp #b1 #b01000111000 #b1011000110)))

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                expect
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                expect
                (fp #b0 #b000 #b10)))
; expect = -0.0625

(assert (= expect result))

(check-sat)
(exit)
