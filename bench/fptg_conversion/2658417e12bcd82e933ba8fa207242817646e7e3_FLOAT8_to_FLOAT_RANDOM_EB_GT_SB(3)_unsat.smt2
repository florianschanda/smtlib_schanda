; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1011)
                arg1
                (fp #b0 #b000 #b0101)))
(assert (fp.leq (fp #b0 #b000 #b0101)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = 0.078125

(declare-const result (_ FloatingPoint 14 10))
(assert (= result ((_ to_fp 14 10) rm arg1)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00010011000000 #b100101001)
                expect
                (fp #b0 #b01111111111011 #b010000000)))
(assert (fp.leq (fp #b0 #b01111111111011 #b010000000)
                expect
                (fp #b0 #b11011011100010 #b101001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
