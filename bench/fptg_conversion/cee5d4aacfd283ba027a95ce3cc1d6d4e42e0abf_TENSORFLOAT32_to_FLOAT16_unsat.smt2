(set-info :category "random")
(set-info :status unsat)

; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001100 #b1011011110)
                arg1
                (fp #b1 #b10001000 #b1100000110)))
(assert (fp.leq (fp #b1 #b10001000 #b1100000110)
                arg1
                (fp #b0 #b01000110 #b0010100001)))
; arg1 = -899.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1001100110)
                expect
                (fp #b1 #b11000 #b1100000110)))
(assert (fp.leq (fp #b1 #b11000 #b1100000110)
                expect
                (fp #b0 #b11000 #b0000111000)))
; expect = -899.0

(assert (not (= expect result)))

(check-sat)
(exit)
