(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b11111000 #b10110010010110011010000)
                arg1
                (fp #b0 #b11111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b00000000000000000000000)
                arg1
                (fp #b0 #b11111101 #b00011110000100100001101)))
; arg1 = 85070591730234615865843651857942052864.0

(declare-const result (_ FloatingPoint 15 2))
(assert (= result ((_ to_fp 15 2) rm arg1)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b001110010001011 #b1)
                expect
                (fp #b0 #b100000001111101 #b0)))
(assert (fp.leq (fp #b0 #b100000001111101 #b0)
                expect
                (fp #b0 #b110110110001101 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
