(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11001011 #b1001101)
                arg1
                (fp #b1 #b00000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000)
                arg1
                (fp #b0 #b11010110 #b0111101)))
; arg1 = -0

(declare-const result (_ FloatingPoint 11 9))
(assert (= result ((_ to_fp 11 9) rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01111111111 #b01111100)
                expect
                (fp #b1 #b00000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000000)
                expect
                (fp #b0 #b01010000110 #b10010011)))

(assert (= expect result))

(check-sat)
(exit)
