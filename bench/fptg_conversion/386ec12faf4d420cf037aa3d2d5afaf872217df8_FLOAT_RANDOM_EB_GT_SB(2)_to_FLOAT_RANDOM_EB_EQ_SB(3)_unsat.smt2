(assert (fp.leq (fp #b1 #b10110 #b0001)
                expect
                (fp #b1 #b01111 #b0100)))
(assert (fp.leq (fp #b1 #b01111 #b0100)
                expect
                (fp #b1 #b00101 #b1011)))
; expect = -1.25

(assert (not (= expect result)))

