; Format from: FLOAT64
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100001001 #b0111101100011001011111010011011011001100001000100011)
                arg1
                (fp #b1 #b10000101111 #b1110011010110000010001010100101101101100100010010000)))
(assert (fp.leq (fp #b1 #b10000101111 #b1110011010110000010001010100101101101100100010010000)
                arg1
                (fp #b0 #b11000110000 #b0101101110010101110001111110110001100111111011101101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110100 #b00000001010100011111110)
                expect
                (fp #b1 #b10101111 #b11100110101100000100011)))
(assert (fp.leq (fp #b1 #b10101111 #b11100110101100000100011)
                expect
                (fp #b0 #b11101001 #b00111000011000000111101)))
; expect = -535119739748352.0

(assert (= expect result))

(check-sat)
(exit)
