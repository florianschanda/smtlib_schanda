; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111101001 #b111)
                arg1
                (fp #b1 #b011111111 #b001)))
(assert (fp.leq (fp #b1 #b011111111 #b001)
                arg1
                (fp #b1 #b010100000 #b110)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100111 #b11000)
                expect
                (fp #b1 #b011111 #b00100)))
(assert (fp.leq (fp #b1 #b011111 #b00100)
                expect
                (fp #b0 #b101001 #b00011)))
; expect = -1.125

(assert (= expect result))

(check-sat)
(exit)
