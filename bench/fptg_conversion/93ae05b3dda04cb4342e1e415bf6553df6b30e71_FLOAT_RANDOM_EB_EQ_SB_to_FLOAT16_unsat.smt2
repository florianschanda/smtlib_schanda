; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b1 #b0110 #b101)))
(assert (fp.leq (fp #b1 #b0110 #b101)
                arg1
                (fp #b1 #b0011 #b011)))
; arg1 = -0.8125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b1111110110)
                expect
                (fp #b1 #b01110 #b1010000000)))
(assert (fp.leq (fp #b1 #b01110 #b1010000000)
                expect
                (fp #b0 #b10100 #b1100101011)))
; expect = -0.8125

(assert (not (= expect result)))

(check-sat)
(exit)
