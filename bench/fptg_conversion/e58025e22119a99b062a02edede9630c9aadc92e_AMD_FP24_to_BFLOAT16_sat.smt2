(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0110000 #b0000111110100110)
                arg1
                (fp #b0 #b1011011 #b0101010011100101)))
(assert (fp.leq (fp #b0 #b1011011 #b0101010011100101)
                arg1
                (fp #b0 #b1101110 #b1000010000011001)))
; arg1 = 357453824.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b10000101 #b1000000)
                expect
                (fp #b0 #b10011011 #b0101011)))
(assert (fp.leq (fp #b0 #b10011011 #b0101011)
                expect
                (fp #b0 #b11010111 #b0001000)))
; expect = 358612992.0

(assert (= expect result))

(check-sat)
(exit)
