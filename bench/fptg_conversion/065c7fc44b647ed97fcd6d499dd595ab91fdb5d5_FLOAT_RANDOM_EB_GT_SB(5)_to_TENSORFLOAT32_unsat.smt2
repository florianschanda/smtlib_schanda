(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100011 #b1011011111)
                expect
                (fp #b1 #b01111111 #b1011000000)))
(assert (fp.leq (fp #b1 #b01111111 #b1011000000)
                expect
                (fp #b0 #b00011101 #b0011001011)))
; expect = -1.6875

(assert (not (= expect result)))

(check-sat)
