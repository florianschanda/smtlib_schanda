(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0000)
                arg1
                (fp #b1 #b100 #b1011)))
(assert (fp.leq (fp #b1 #b100 #b1011)
                arg1
                (fp #b0 #b110 #b1000)))
; arg1 = -3.375

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110101 #b10110)
                expect
                (fp #b1 #b100000 #b10110)))
(assert (fp.leq (fp #b1 #b100000 #b10110)
                expect
                (fp #b0 #b100001 #b10110)))
; expect = -3.375

(assert (= expect result))

(check-sat)
(exit)
