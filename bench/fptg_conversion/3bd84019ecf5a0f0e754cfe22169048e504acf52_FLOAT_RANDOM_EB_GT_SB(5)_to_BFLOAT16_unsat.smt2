; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1000 #b10)
                arg1
                (fp #b0 #b1001 #b11)))
(assert (fp.leq (fp #b0 #b1001 #b11)
                arg1
                (fp #b0 #b1111 #b00)))
; arg1 = 7.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011100 #b1101000)
                expect
                (fp #b0 #b10000001 #b1100000)))
(assert (fp.leq (fp #b0 #b10000001 #b1100000)
                expect
                (fp #b0 #b11111110 #b0100011)))
; expect = 7.0

(assert (not (= expect result)))

(check-sat)
(exit)
