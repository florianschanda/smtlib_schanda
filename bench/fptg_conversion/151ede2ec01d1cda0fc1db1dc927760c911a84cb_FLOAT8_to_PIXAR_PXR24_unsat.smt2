; arg1 = -4.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11100011 #b010010000010011)
                expect
                (fp #b1 #b10000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10000001 #b000000000000000)
                expect
                (fp #b0 #b01110011 #b100101110110101)))
; expect = -4.0

(assert (not (= expect result)))

(check-sat)
(exit)
