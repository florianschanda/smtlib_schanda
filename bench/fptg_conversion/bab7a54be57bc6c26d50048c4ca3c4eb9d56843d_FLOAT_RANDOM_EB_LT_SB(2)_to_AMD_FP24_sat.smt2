                arg1
                (fp #b0 #b110 #b1011000111110111001010)))
; arg1 = 5.33064937591552734375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011101 #b1101000010111101)
                expect
                (fp #b0 #b1000001 #b0101010100101010)))
(assert (fp.leq (fp #b0 #b1000001 #b0101010100101010)
                expect
                (fp #b0 #b1011000 #b0101011011010000)))
; expect = 5.3306884765625

(assert (= expect result))

(check-sat)
(exit)
