(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 3 23))
(assert (fp.leq (fp #b1 #b100 #b0100110101100001011000)
                arg1
                (fp #b0 #b101 #b0101010100101001010111)))
