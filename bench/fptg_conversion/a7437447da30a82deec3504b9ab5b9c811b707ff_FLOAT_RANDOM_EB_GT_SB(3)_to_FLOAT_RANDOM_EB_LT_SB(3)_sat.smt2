(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b1 #b000 #b1)))
(assert (fp.leq (fp #b1 #b000 #b1)
                arg1
                (fp #b0 #b000 #b1)))
; arg1 = -0.125

(declare-const result (_ FloatingPoint 7 40))
(assert (= result ((_ to_fp 7 40) rm arg1)))

(declare-const expect (_ FloatingPoint 7 40))
(assert (fp.leq (fp #b1 #b1110111 #b110011010011010100001111011101011111100)
                expect
                (fp #b1 #b0111100 #b000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b0111100 #b000000000000000000000000000000000000000)
                expect
                (fp #b0 #b1011010 #b010101111001000111000100011100101110001)))

(assert (= expect result))

(check-sat)
(exit)
