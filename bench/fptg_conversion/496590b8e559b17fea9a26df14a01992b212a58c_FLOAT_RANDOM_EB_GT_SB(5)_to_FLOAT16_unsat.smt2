(assert (fp.leq (fp #b0 #b10001 #b1011111110)
                expect
                (fp #b0 #b10010 #b1010000000)))
(assert (fp.leq (fp #b0 #b10010 #b1010000000)
                expect
                (fp #b0 #b10100 #b0011011001)))
; expect = 13.0

(assert (not (= expect result)))

(check-sat)
