(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b010111 #b100)
                arg1
                (fp #b0 #b011111 #b111)))
(assert (fp.leq (fp #b0 #b011111 #b111)
                arg1
                (fp #b0 #b101000 #b101)))
; arg1 = 1.875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0101)
                expect
                (fp #b0 #b011 #b1110)))
(assert (fp.leq (fp #b0 #b011 #b1110)
                expect
                (fp #b0 #b101 #b0011)))
; expect = 1.875

(assert (not (= expect result)))

(check-sat)
(exit)
