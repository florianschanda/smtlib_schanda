(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg1
                (fp #b1 #b00 #b0)))
(assert (fp.leq (fp #b1 #b00 #b0)
                arg1
                (fp #b0 #b00 #b1)))
; arg1 = -0

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110 #b0)
                expect
                (fp #b1 #b000 #b0)))
(assert (fp.leq (fp #b1 #b000 #b0)
                expect
                (fp #b0 #b001 #b0)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
