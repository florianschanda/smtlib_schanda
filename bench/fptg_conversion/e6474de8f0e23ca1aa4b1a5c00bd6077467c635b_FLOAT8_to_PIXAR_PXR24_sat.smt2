(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: PIXAR_PXR24
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0001)
                arg1
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                arg1
                (fp #b0 #b110 #b1111)))
; arg1 = 15.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00000001 #b100111011111110)
                expect
                (fp #b0 #b10000010 #b111000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b111000000000000)
                expect
                (fp #b0 #b10011111 #b001000101001000)))
; expect = 15.0

(assert (= expect result))

(check-sat)
(exit)
