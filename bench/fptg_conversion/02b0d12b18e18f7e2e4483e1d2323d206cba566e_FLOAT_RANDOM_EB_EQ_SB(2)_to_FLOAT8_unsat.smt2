(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111100101110101 #b00110001111000)
                arg1
                (fp #b1 #b011111111111111 #b11101110010001)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11101110010001)
                arg1
                (fp #b0 #b000111000010101 #b01011010110000)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0000)
                expect
                (fp #b1 #b011 #b1111)))
(assert (fp.leq (fp #b1 #b011 #b1111)
                expect
                (fp #b0 #b000 #b0000)))
; expect = -1.9375

(assert (not (= expect result)))

