                arg1
                (fp #b0 #b111001100000110 #b1001010010111100010101110111100110111000010010111111111001010110100001010100000010011011111101011001100001110011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01101 #b0010111101)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b10111 #b0100001111)))
; expect = 0.0

(assert (not (= expect result)))

