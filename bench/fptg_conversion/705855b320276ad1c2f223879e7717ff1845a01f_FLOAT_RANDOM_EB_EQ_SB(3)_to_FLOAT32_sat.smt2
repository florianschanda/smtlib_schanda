(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111000000 #b0001101010)
                arg1
                (fp #b1 #b10000001001 #b0110110001)))
(assert (fp.leq (fp #b1 #b10000001001 #b0110110001)
                arg1
                (fp #b1 #b01101111110 #b0100100100)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100001 #b01001000110111110100010)
                expect
                (fp #b1 #b10001001 #b01101100010000000000000)))
(assert (fp.leq (fp #b1 #b10001001 #b01101100010000000000000)
                expect
                (fp #b0 #b00001001 #b10100100111011010110000)))
; expect = -1457.0

(assert (= expect result))

(check-sat)
(exit)
