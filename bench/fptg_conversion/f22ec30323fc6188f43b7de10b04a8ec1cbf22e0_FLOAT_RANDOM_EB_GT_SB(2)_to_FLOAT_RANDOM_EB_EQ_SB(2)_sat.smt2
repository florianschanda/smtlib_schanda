; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1100 #b1)
                arg1
                (fp #b1 #b1001 #b1)))
(assert (fp.leq (fp #b1 #b1001 #b1)
                arg1
                (fp #b1 #b1000 #b0)))
; arg1 = -6.0

(declare-const result (_ FloatingPoint 13 13))
(assert (= result ((_ to_fp 13 13) rm arg1)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100111011110 #b001011100010)
                expect
                (fp #b1 #b1000000000001 #b100000000000)))
(assert (fp.leq (fp #b1 #b1000000000001 #b100000000000)
                expect
                (fp #b1 #b0100010101111 #b011111101001)))

(assert (= expect result))

(check-sat)
(exit)
