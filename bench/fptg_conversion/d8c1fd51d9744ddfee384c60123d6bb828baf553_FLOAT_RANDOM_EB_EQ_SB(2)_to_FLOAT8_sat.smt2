(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b00)
                arg1
                (fp #b0 #b110 #b01)))
(assert (fp.leq (fp #b0 #b110 #b01)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 10.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1000)
                expect
                (fp #b0 #b110 #b0100)))
(assert (fp.leq (fp #b0 #b110 #b0100)
                expect
                (fp #b0 #b110 #b0111)))
; expect = 10.0

(assert (= expect result))

(check-sat)
(exit)
