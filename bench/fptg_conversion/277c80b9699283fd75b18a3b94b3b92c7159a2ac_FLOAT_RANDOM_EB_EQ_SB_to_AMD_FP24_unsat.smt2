                expect
                (fp #b1 #b1000010 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b1000010 #b0100000000000000)
                expect
                (fp #b0 #b0100101 #b0111110010001010)))
; expect = -10.0

(assert (not (= expect result)))

(check-sat)
