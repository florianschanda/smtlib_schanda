; arg1 = -0.0078125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111011 #b0001110100)
                expect
                (fp #b1 #b01111000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111000 #b0000000000)
                expect
                (fp #b0 #b10110001 #b1011000100)))
; expect = -0.0078125

(assert (not (= expect result)))

(check-sat)
