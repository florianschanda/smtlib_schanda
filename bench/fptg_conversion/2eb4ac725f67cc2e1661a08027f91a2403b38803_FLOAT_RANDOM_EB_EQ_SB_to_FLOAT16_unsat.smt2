(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1000111 #b110000)
                arg1
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg1
                (fp #b0 #b1001100 #b011111)))
; arg1 = 0.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01101 #b1100110000)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b11110 #b0000101000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
