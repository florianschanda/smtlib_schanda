(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1101000111)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b00010 #b0000111001)))
; arg1 = 0.000060558319091796875

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01010011 #b000110101011011)
                expect
                (fp #b0 #b01110000 #b111111000000000)))
(assert (fp.leq (fp #b0 #b01110000 #b111111000000000)
                expect
                (fp #b0 #b01111101 #b000011011011001)))
; expect = 0.000060558319091796875

(assert (= expect result))

(check-sat)
(exit)
