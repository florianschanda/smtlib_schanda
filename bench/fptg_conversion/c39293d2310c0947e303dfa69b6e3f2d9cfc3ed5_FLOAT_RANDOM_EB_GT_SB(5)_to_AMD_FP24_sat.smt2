(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b01)
                arg1
                (fp #b1 #b1001 #b00)))
(assert (fp.leq (fp #b1 #b1001 #b00)
                arg1
                (fp #b0 #b0101 #b11)))
; arg1 = -4.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001000 #b1011001110101101)
                expect
                (fp #b1 #b1000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1000001 #b0000000000000000)
                expect
                (fp #b0 #b1000101 #b1110001011011001)))
; expect = -4.0

(assert (= expect result))

(check-sat)
(exit)
