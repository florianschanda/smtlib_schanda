(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111111111111 #b000000000000)
                arg1
                (fp #b1 #b1111111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b111111111111)
                arg1
                (fp #b1 #b1111101011101 #b111101110010)))

