(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b00100010011001100000000)
                arg1
                (fp #b0 #b10010101 #b10001001000000100111000)))
(assert (fp.leq (fp #b0 #b10010101 #b10001001000000100111000)
                arg1
                (fp #b0 #b10010101 #b10001010111100001010010)))
; arg1 = 6439068.0

(declare-const result (_ FloatingPoint 16 4))
(assert (= result ((_ to_fp 16 4) rm arg1)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b0010110011111001 #b100)
                expect
                (fp #b0 #b1000000000010101 #b101)))
(assert (fp.leq (fp #b0 #b1000000000010101 #b101)
                expect
                (fp #b0 #b1110001010110000 #b100)))

(assert (= expect result))

(check-sat)
(exit)
