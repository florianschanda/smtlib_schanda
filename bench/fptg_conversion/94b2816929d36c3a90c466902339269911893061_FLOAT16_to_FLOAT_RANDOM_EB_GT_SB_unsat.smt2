; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1101011100)
                arg1
                (fp #b0 #b01010 #b1011111001)))
(assert (fp.leq (fp #b0 #b01010 #b1011111001)
                arg1
                (fp #b0 #b11101 #b1101011111)))
; arg1 = 0.054473876953125

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111001011 #b1111)
                expect
                (fp #b0 #b0111111010 #b1100)))
(assert (fp.leq (fp #b0 #b0111111010 #b1100)
                expect
                (fp #b0 #b1010011101 #b0111)))

(assert (not (= expect result)))

(check-sat)
(exit)
