(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT64
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011000100 #b0110010011100111101101000100000000110010100111010000)
                arg1
                (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)))
(assert (fp.leq (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)
                arg1
                (fp #b0 #b10101111001 #b1011010101101100101101100111110110000101010001101101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
