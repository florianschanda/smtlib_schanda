; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b10011011001011111111011)
                arg1
                (fp #b1 #b10000110 #b01010010101110101101100)))
(assert (fp.leq (fp #b1 #b10000110 #b01010010101110101101100)
                arg1
                (fp #b0 #b11101001 #b10011010000011111101000)))
; arg1 = -169.36492919921875

(declare-const result (_ FloatingPoint 15 3))
(assert (= result ((_ to_fp 15 3) rm arg1)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b101011011100110 #b10)
                expect
                (fp #b1 #b100000000000110 #b10)))
(assert (fp.leq (fp #b1 #b100000000000110 #b10)
                expect
                (fp #b1 #b010101101111110 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
