; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001010000001100 #b001111100110110)
                arg1
                (fp #b0 #b0111111111111111 #b110010010101111)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b110010010101111)
                arg1
                (fp #b0 #b1101110101111010 #b101100110001010)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00000011 #b1001111)
                expect
                (fp #b0 #b01111111 #b1100101)))
(assert (fp.leq (fp #b0 #b01111111 #b1100101)
                expect
                (fp #b0 #b11101010 #b0000101)))
; expect = 1.7890625

(assert (= expect result))

(check-sat)
(exit)
