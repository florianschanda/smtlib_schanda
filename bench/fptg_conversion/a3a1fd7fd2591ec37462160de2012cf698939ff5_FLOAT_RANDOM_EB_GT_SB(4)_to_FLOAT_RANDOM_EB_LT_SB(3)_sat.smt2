; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b110010111101000 #b011011)
                arg1
                (fp #b1 #b101111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b101111111111110 #b111111)
                arg1
                (fp #b1 #b001101100101010 #b111101)))

(declare-const result (_ FloatingPoint 10 250))
(assert (= result ((_ to_fp 10 250) rm arg1)))

(declare-const expect (_ FloatingPoint 10 250))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
