(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110001110011010 #b111110100001111)
                expect
                (fp #b1 #b0111111111110010 #b100110011100000)))
(assert (fp.leq (fp #b1 #b0111111111110010 #b100110011100000)
                expect
                (fp #b1 #b0110001111001100 #b111111111110100)))

(assert (= expect result))

(check-sat)
(exit)
