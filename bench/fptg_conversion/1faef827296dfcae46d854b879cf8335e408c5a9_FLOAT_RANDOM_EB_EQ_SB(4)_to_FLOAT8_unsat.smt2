; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010101011 #b1110000100)
                arg1
                (fp #b1 #b01111111111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111111111 #b0001011101)
                arg1
                (fp #b1 #b01010001001 #b1001011111)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1001)
                expect
                (fp #b1 #b011 #b0010)))
(assert (fp.leq (fp #b1 #b011 #b0010)
                expect
                (fp #b1 #b010 #b0010)))
; expect = -1.125

(assert (not (= expect result)))

(check-sat)
(exit)
