; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b01000011101)
                arg1
                (fp #b1 #b100000000111 #b10110100000)))
(assert (fp.leq (fp #b1 #b100000000111 #b10110100000)
                arg1
                (fp #b1 #b010111100000 #b10000011001)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011101 #b1010110)
                expect
                (fp #b1 #b10000111 #b1011010)))
(assert (fp.leq (fp #b1 #b10000111 #b1011010)
                expect
                (fp #b0 #b10100100 #b0110001)))
; expect = -436.0

(assert (= expect result))

(check-sat)
(exit)
