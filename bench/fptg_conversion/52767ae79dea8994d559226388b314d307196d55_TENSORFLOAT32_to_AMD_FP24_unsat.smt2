(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100001 #b1111000001011111)
                expect
                (fp #b1 #b0111111 #b0011010000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0011010000000000)
                expect
                (fp #b1 #b0100100 #b1100101101110001)))
; expect = -1.203125

(assert (not (= expect result)))

(check-sat)
(exit)
