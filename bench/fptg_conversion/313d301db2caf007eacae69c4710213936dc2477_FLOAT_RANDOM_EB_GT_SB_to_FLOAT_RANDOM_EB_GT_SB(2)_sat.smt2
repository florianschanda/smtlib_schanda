; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1000011001000100 #b010)
                arg1
                (fp #b1 #b0010100110110010 #b011)))
(assert (fp.leq (fp #b1 #b0010100110110010 #b011)
                arg1
                (fp #b0 #b1011010111010101 #b000)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result ((_ to_fp 9 6) rm arg1)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101011011 #b10101)
                expect
                (fp #b1 #b000000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000000 #b00001)
                expect
                (fp #b0 #b101011000 #b10011)))

(assert (= expect result))

(check-sat)
(exit)
