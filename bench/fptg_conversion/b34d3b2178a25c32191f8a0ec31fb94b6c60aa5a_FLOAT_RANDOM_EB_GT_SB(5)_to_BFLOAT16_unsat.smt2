; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b0 #b000111 #b0)
                arg1
                (fp #b0 #b011111 #b1)))
(assert (fp.leq (fp #b0 #b011111 #b1)
                arg1
                (fp #b0 #b100100 #b1)))
; arg1 = 1.5

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111100 #b0010111)
                expect
                (fp #b0 #b01111111 #b1000000)))
(assert (fp.leq (fp #b0 #b01111111 #b1000000)
                expect
                (fp #b0 #b11100011 #b0100010)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
