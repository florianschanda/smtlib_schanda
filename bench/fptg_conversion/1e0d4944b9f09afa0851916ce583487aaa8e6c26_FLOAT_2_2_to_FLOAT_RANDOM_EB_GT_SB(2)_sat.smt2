(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg1
                (fp #b0 #b00 #b0)))
(assert (fp.leq (fp #b0 #b00 #b0)
                arg1
                (fp #b0 #b01 #b1)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 11 7))
(assert (= result ((_ to_fp 11 7) rm arg1)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00000010010 #b110000)
                expect
                (fp #b0 #b00000000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000)
                expect
                (fp #b0 #b11011111010 #b011110)))

(assert (= expect result))

(check-sat)
(exit)
