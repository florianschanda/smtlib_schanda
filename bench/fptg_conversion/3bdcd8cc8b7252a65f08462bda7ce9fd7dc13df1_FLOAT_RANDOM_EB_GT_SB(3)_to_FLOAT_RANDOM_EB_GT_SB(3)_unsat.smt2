; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110100010 #b0001010)
                arg1
                (fp #b1 #b000000000 #b1101100)))
(assert (fp.leq (fp #b1 #b000000000 #b1101100)
                arg1
                (fp #b0 #b111011010 #b1000110)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result ((_ to_fp 9 2) rm arg1)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b110101000 #b0)
                expect
                (fp #b1 #b000000001 #b0)))
(assert (fp.leq (fp #b1 #b000000001 #b0)
                expect
                (fp #b0 #b001111000 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
