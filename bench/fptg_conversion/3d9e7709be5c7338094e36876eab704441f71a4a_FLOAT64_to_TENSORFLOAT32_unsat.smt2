; Format from: FLOAT64
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111110011 #b0110111011010010000111011001111011001110110111111010)
                arg1
                (fp #b1 #b11100000010 #b0010000110100100101101101100101111110110111001111100)))
(assert (fp.leq (fp #b1 #b11100000010 #b0010000110100100101101101100101111110110111001111100)
                arg1
                (fp #b1 #b10101101010 #b0111101111101010101111011001111100000100001101010110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
