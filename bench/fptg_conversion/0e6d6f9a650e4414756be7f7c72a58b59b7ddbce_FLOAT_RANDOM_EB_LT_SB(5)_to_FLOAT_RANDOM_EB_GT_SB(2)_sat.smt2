; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 35))
(assert (fp.leq (fp #b1 #b110 #b0000100011111100011101000000101100)
                arg1
                (fp #b1 #b011 #b0010100100010100001100011101001100)))
(assert (fp.leq (fp #b1 #b011 #b0010100100010100001100011101001100)
                arg1
                (fp #b0 #b100 #b0110101110010001011111010100101111)))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result ((_ to_fp 8 3) rm arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11100000 #b01)
                expect
                (fp #b1 #b01111111 #b01)))
(assert (fp.leq (fp #b1 #b01111111 #b01)
                expect
                (fp #b1 #b00100010 #b01)))
; expect = -1.25

(assert (= expect result))

(check-sat)
(exit)
