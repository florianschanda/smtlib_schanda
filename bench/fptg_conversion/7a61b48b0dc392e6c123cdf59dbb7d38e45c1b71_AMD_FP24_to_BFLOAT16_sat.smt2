; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b1111101101111011)
                arg1
                (fp #b1 #b1110111 #b1100101001010000)))
(assert (fp.leq (fp #b1 #b1110111 #b1100101001010000)
                arg1
                (fp #b0 #b0001011 #b0110011101110110)))
; arg1 = -129003500263702528.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011011 #b1011100)
                expect
                (fp #b1 #b10110111 #b1100110)))
(assert (fp.leq (fp #b1 #b10110111 #b1100110)
                expect
                (fp #b0 #b00000000 #b1001011)))
; expect = -129478489286901760.0

(assert (= expect result))

(check-sat)
(exit)
