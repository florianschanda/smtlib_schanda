(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1000111 #b110000)
                arg1
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                arg1
                (fp #b0 #b1001100 #b011111)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 15 41))
(assert (= result ((_ to_fp 15 41) rm arg1)))

(declare-const expect (_ FloatingPoint 15 41))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110110101110111 #b0001100011101110101100110101111111011001)
                expect
                (fp #b0 #b000000000000000 #b0000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000000000000000000000000000000000000)
                expect
                (fp #b0 #b110011101010011 #b1101010110001011000010100001110000101001)))

(assert (= expect result))

(check-sat)
(exit)
