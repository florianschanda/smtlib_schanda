(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                arg1
                (fp #b1 #b110 #b1000)))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b101 #b0000)))
; arg1 = -12.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b0100110000)
                expect
                (fp #b1 #b10010 #b1000000000)))
(assert (fp.leq (fp #b1 #b10010 #b1000000000)
                expect
                (fp #b0 #b01101 #b1110001110)))
; expect = -12.0

(assert (= expect result))

(check-sat)
(exit)
