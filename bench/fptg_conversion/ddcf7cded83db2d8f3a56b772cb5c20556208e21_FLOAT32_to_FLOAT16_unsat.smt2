(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110101 #b10000111100111011111011)
                arg1
                (fp #b1 #b11100001 #b01101100001000100000010)))
(assert (fp.leq (fp #b1 #b11100001 #b01101100001000100000010)
                arg1
                (fp #b1 #b11001100 #b11010001001000100101110)))
; arg1 = -450774663769209735545364676608.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
