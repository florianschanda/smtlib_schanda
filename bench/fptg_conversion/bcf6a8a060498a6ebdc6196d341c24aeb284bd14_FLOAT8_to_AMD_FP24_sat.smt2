; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1000)
                arg1
                (fp #b0 #b001 #b0111)))
(assert (fp.leq (fp #b0 #b001 #b0111)
                arg1
                (fp #b0 #b100 #b1011)))
; arg1 = 0.359375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010010 #b1011111001101101)
                expect
                (fp #b0 #b0111101 #b0111000000000000)))
(assert (fp.leq (fp #b0 #b0111101 #b0111000000000000)
                expect
                (fp #b0 #b1110110 #b1011001100010011)))
; expect = 0.359375

(assert (= expect result))

(check-sat)
(exit)
