(assert (fp.leq (fp #b1 #b10010111 #b01000111100010100111010)
                expect
                (fp #b0 #b01111111 #b01011110110000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b01011110110000000000000)
                expect
                (fp #b0 #b10000010 #b01000000100011001001000)))
; expect = 1.3701171875

(assert (= expect result))

(check-sat)
