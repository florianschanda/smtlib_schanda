(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11111 #b0)
                arg1
                (fp #b1 #b10000 #b1)))
(assert (fp.leq (fp #b1 #b10000 #b1)
                arg1
                (fp #b1 #b01010 #b0)))
; arg1 = -3.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111000 #b10111000001000101110011)
                expect
                (fp #b1 #b10000000 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b10000000000000000000000)
                expect
                (fp #b1 #b01011001 #b01010000101011110010001)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
