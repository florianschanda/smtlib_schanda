(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00000 #b001)
                arg1
                (fp #b0 #b10010 #b111)))
(assert (fp.leq (fp #b0 #b10010 #b111)
                arg1
                (fp #b0 #b11000 #b011)))
; arg1 = 15.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b100 #b1111)
                expect
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                expect
                (fp #b0 #b111 #b0000)))
; expect = 15.0

(assert (= expect result))

(check-sat)
(exit)
