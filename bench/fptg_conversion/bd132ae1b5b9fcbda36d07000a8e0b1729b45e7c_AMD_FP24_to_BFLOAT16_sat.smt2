                arg1
                (fp #b0 #b1110100 #b0110000011111111)))
; arg1 = 1052233433088.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01011100 #b0101101)
                expect
                (fp #b0 #b10100110 #b1110101)))
(assert (fp.leq (fp #b0 #b10100110 #b1110101)
                expect
                (fp #b0 #b11000111 #b0110100)))
; expect = 1052266987520.0

(assert (= expect result))

(check-sat)
