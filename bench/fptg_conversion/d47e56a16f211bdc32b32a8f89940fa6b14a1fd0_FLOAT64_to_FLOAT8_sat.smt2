; Format from: FLOAT64
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001101111 #b1111011010111011000111101010001001010011001111111011)
                arg1
                (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)))
(assert (fp.leq (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)
                arg1
                (fp #b0 #b01001001000 #b0101011110010011100001101000010000111100010010011100)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b1100)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b110 #b0100)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
