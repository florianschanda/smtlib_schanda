; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00011 #b1001010111)
                arg1
                (fp #b0 #b11001 #b0101110010)))
(assert (fp.leq (fp #b0 #b11001 #b0101110010)
                arg1
                (fp #b0 #b11100 #b0100000100)))
; arg1 = 1394.0

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011001 #b01011100)
                expect
                (fp #b0 #b100001001 #b01011101)))
(assert (fp.leq (fp #b0 #b100001001 #b01011101)
                expect
                (fp #b0 #b100100100 #b10011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
