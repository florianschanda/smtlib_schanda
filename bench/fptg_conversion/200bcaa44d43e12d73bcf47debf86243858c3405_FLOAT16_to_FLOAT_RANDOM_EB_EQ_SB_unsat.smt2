(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1101000111)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b00010 #b0000111001)))
; arg1 = 0.000060558319091796875

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b111)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b1110 #b100)))
; expect = 0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
