; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100101 #b0010001000110000)
                arg1
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                arg1
                (fp #b0 #b1100100 #b1001110001000111)))
; arg1 = 1.1314697265625

(declare-const result (_ FloatingPoint 10 9))
(assert (= result ((_ to_fp 10 9) rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0101010011 #b11010100)
                expect
                (fp #b0 #b0111111111 #b00100010)))
(assert (fp.leq (fp #b0 #b0111111111 #b00100010)
                expect
                (fp #b0 #b1101000111 #b01001100)))

(assert (= expect result))

(check-sat)
(exit)
