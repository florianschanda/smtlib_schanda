; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b10001 #b0010)
                arg1
                (fp #b1 #b10001 #b0000)))
(assert (fp.leq (fp #b1 #b10001 #b0000)
                arg1
                (fp #b1 #b01100 #b1110)))
; arg1 = -4.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001010010101001 #b011001101110101)
                expect
                (fp #b1 #b1000000000000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000000001 #b000000000000000)
                expect
                (fp #b0 #b1101111011101100 #b010100001011010)))

(assert (= expect result))

(check-sat)
(exit)
