; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1100)
                arg1
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                arg1
                (fp #b0 #b110 #b0100)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 5 3))
(assert (= result ((_ to_fp 5 3) rm arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b00010 #b10)
                expect
                (fp #b0 #b10001 #b00)))
(assert (fp.leq (fp #b0 #b10001 #b00)
                expect
                (fp #b0 #b10110 #b01)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
