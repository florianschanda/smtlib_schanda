                expect
                (fp #b0 #b01100000 #b0100000000)))
(assert (fp.leq (fp #b0 #b01100000 #b0100000000)
                expect
                (fp #b0 #b10101000 #b1100101101)))
; expect = 0.000000000582076609134674072265625

(assert (= expect result))

