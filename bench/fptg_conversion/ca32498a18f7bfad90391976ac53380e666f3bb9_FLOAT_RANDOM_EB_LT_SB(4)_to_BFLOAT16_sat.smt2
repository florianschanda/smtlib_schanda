(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 12))
(assert (fp.leq (fp #b1 #b010 #b11100110010)
                arg1
                (fp #b0 #b110 #b01010011000)))
(assert (fp.leq (fp #b0 #b110 #b01010011000)
                arg1
                (fp #b0 #b110 #b01100010110)))
; arg1 = 10.59375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000010 #b0001010)
                expect
                (fp #b0 #b10000010 #b0101010)))
(assert (fp.leq (fp #b0 #b10000010 #b0101010)
                expect
                (fp #b0 #b10111110 #b1010011)))
; expect = 10.625

(assert (= expect result))

(check-sat)
(exit)
