(assert (fp.leq (fp #b1 #b1101001 #b0110010100010001)
                expect
                (fp #b1 #b0111111 #b0100000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b0100000000000000)
                expect
                (fp #b1 #b0010000 #b1100101010111010)))
; expect = -1.25

(assert (not (= expect result)))

(check-sat)
