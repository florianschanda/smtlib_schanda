; Format from: FLOAT32
; Format to: X87_EXTENDED_DOUBLE
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010011 #b00000100110101010100000)
                arg1
                (fp #b0 #b10010110 #b11001001000000101010001)))
(assert (fp.leq (fp #b0 #b10010110 #b11001001000000101010001)
                arg1
                (fp #b0 #b10011011 #b01110101101001010001100)))
; arg1 = 14975313.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b0 #b000111101111100 #b110110100111111111101111101111000010011111110100110011101011101)
                expect
                (fp #b0 #b100000000010110 #b110010010000001010100010000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000010110 #b110010010000001010100010000000000000000000000000000000000000000)
                expect
                (fp #b0 #b100001111100000 #b000101000110100001010000111111010010101001010111101101011101111)))

(assert (= expect result))

(check-sat)
(exit)
