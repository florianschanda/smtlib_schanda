                expect
                (fp #b0 #b0111111111111 #b10111000000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b10111000000)
                expect
                (fp #b0 #b1010100101011 #b10110110110)))

(assert (= expect result))

