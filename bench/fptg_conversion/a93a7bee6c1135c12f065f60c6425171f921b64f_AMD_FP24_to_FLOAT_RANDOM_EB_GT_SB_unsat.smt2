; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101111 #b0101000111011100)
                arg1
                (fp #b0 #b1010010 #b1100101110011111)))
(assert (fp.leq (fp #b0 #b1010010 #b1100101110011111)
                arg1
                (fp #b0 #b1101011 #b1110010101010110)))
; arg1 = 941304.0

(declare-const result (_ FloatingPoint 9 4))
(assert (= result ((_ to_fp 9 4) rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b011011111 #b110)
                expect
                (fp #b0 #b100010010 #b111)))
(assert (fp.leq (fp #b0 #b100010010 #b111)
                expect
                (fp #b0 #b100101100 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
