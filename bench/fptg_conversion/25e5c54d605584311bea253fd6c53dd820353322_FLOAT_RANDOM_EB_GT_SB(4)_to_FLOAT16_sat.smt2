(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01100110110 #b0011)
                arg1
                (fp #b1 #b00000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000)
                arg1
                (fp #b0 #b11110011100 #b0010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00111 #b0110011010)
                expect
                (fp #b1 #b00000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000)
                expect
                (fp #b0 #b11110 #b0010100010)))
; expect = -0

(assert (= expect result))

(check-sat)
(exit)
