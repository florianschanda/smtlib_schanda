(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b101010 #b10)
                arg1
                (fp #b1 #b011111 #b00)))
(assert (fp.leq (fp #b1 #b011111 #b00)
                arg1
                (fp #b0 #b011100 #b00)))
; arg1 = -1.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110000 #b00011100001011101011001)
                expect
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                expect
                (fp #b0 #b10110100 #b01001010101101111110101)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
