; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 30))
(assert (fp.leq (fp #b1 #b101 #b11010000111001011110001011000)
                arg1
                (fp #b1 #b010 #b00100001011001001011000010101)))
(assert (fp.leq (fp #b1 #b010 #b00100001011001001011000010101)
                arg1
                (fp #b1 #b001 #b01000010001001111110000111110)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111011 #b1101001111)
                expect
                (fp #b1 #b01111110 #b0010000110)))
(assert (fp.leq (fp #b1 #b01111110 #b0010000110)
                expect
                (fp #b0 #b00000101 #b1100001111)))
; expect = -0.5654296875

(assert (= expect result))

(check-sat)
(exit)
