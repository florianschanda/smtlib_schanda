(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b001 #b01)
                arg1
                (fp #b1 #b000 #b01)))
(assert (fp.leq (fp #b1 #b000 #b01)
                arg1
                (fp #b0 #b101 #b11)))
; arg1 = -0.0625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1111000001)
                expect
                (fp #b1 #b01011 #b0000000000)))
(assert (fp.leq (fp #b1 #b01011 #b0000000000)
                expect
                (fp #b0 #b11101 #b0001100111)))
; expect = -0.0625

(assert (= expect result))

(check-sat)
(exit)
