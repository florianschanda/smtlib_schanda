(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101010 #b1001000111100111)
                arg1
                (fp #b0 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b0 #b1011110 #b1111111111111111)
                arg1
                (fp #b0 #b1101101 #b1101111000111111)))
; arg1 = 4294934528.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000010 #b10010111101010010100011)
                expect
                (fp #b0 #b10011110 #b11111111111111110000000)))
(assert (fp.leq (fp #b0 #b10011110 #b11111111111111110000000)
                expect
                (fp #b0 #b11111110 #b10000101001111110100110)))
; expect = 4294934528.0

(assert (= expect result))

(check-sat)
(exit)
