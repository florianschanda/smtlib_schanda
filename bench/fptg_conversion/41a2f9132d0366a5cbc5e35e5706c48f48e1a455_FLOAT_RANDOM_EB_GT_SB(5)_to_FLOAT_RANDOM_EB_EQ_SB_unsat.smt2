(assert (fp.leq (fp #b0 #b0101110101 #b101111101)
                expect
                (fp #b0 #b0111100000 #b010000000)))
(assert (fp.leq (fp #b0 #b0111100000 #b010000000)
                expect
                (fp #b0 #b1010111010 #b110101101)))

(assert (not (= expect result)))

