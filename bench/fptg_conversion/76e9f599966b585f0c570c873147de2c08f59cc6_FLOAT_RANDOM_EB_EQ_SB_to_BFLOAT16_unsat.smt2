; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101001010001011 #b111111000101100)
                arg1
                (fp #b1 #b0111111111111111 #b100111100100001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b100111100100001)
                arg1
                (fp #b0 #b0110010001001010 #b101010011011000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100001 #b1000000)
                expect
                (fp #b1 #b01111111 #b1010000)))
(assert (fp.leq (fp #b1 #b01111111 #b1010000)
                expect
                (fp #b1 #b00001101 #b1100011)))
; expect = -1.625

(assert (not (= expect result)))

(check-sat)
(exit)
