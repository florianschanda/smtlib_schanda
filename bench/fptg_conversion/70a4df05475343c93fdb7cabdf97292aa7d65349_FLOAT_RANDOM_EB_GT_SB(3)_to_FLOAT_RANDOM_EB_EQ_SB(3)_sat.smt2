; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110101 #b10111)
                arg1
                (fp #b1 #b0111111 #b10110)))
(assert (fp.leq (fp #b1 #b0111111 #b10110)
                arg1
                (fp #b0 #b0001100 #b10010)))
; arg1 = -1.6875

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000000001 #b000100001)
                expect
                (fp #b1 #b0111111111 #b101100000)))
(assert (fp.leq (fp #b1 #b0111111111 #b101100000)
                expect
                (fp #b1 #b0001111011 #b000111001)))

(assert (= expect result))

(check-sat)
(exit)
