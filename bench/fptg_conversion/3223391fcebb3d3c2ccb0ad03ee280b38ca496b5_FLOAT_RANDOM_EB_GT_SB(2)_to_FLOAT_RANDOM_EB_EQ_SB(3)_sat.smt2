; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110010001 #b0010)
                arg1
                (fp #b1 #b0000000000 #b1100)))
(assert (fp.leq (fp #b1 #b0000000000 #b1100)
                arg1
                (fp #b0 #b0100101001 #b1010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result ((_ to_fp 11 11) rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000010111 #b1101111111)
                expect
                (fp #b1 #b01000000000 #b1000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b1000000000)
                expect
                (fp #b0 #b01111000011 #b0100011001)))

(assert (= expect result))

(check-sat)
(exit)
