; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b0010101111)
                arg1
                (fp #b0 #b11011 #b0101101000)))
(assert (fp.leq (fp #b0 #b11011 #b0101101000)
                arg1
                (fp #b0 #b11011 #b1110111100)))
; arg1 = 5536.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01000110 #b1001010)
                expect
                (fp #b0 #b10001011 #b0101101)))
(assert (fp.leq (fp #b0 #b10001011 #b0101101)
                expect
                (fp #b0 #b10101000 #b1101001)))
; expect = 5536.0

(assert (= expect result))

(check-sat)
