; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1111)
                arg1
                (fp #b1 #b010 #b0000)))
(assert (fp.leq (fp #b1 #b010 #b0000)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 11 3))
(assert (= result ((_ to_fp 11 3) rm arg1)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10101011111 #b00)
                expect
                (fp #b1 #b01111111110 #b00)))
(assert (fp.leq (fp #b1 #b01111111110 #b00)
                expect
                (fp #b1 #b01101100011 #b11)))

(assert (= expect result))

(check-sat)
(exit)
