; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000110 #b1100001101000011)
                arg1
                (fp #b0 #b0111111 #b1000110111010011)))
(assert (fp.leq (fp #b0 #b0111111 #b1000110111010011)
                arg1
                (fp #b0 #b1110100 #b1111101110001000)))
; arg1 = 1.5540008544921875

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111000 #b00011)
                expect
                (fp #b0 #b011111 #b10010)))
(assert (fp.leq (fp #b0 #b011111 #b10010)
                expect
                (fp #b0 #b100110 #b00001)))
; expect = 1.5625

(assert (= expect result))

(check-sat)
(exit)
