(assert (fp.leq (fp #b1 #b11100010 #b10000101111010111001011)
                arg1
                (fp #b1 #b11011011 #b11100111001001101100011)))
(assert (fp.leq (fp #b1 #b11011011 #b11100111001001101100011)
                arg1
                (fp #b1 #b10011101 #b11101011111111111001100)))
; arg1 = -9422879624544000785459970048.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101001 #b0101010101)
                expect
                (fp #b1 #b11011011 #b1110011101)))
(assert (fp.leq (fp #b1 #b11011011 #b1110011101)
                expect
                (fp #b0 #b00001100 #b1101010110)))
; expect = -9424785689715649046009348096.0

(assert (not (= expect result)))

(check-sat)
(exit)
