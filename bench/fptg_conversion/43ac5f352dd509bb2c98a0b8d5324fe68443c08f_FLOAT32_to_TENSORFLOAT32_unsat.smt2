; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

