; Format from: FLOAT64
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001001011 #b1010001010011011001010011010100010110111010000001100)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b00010110101 #b1101010011110010000100000111001101010100100010100000)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result ((_ to_fp 11 4) rm arg1)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00001000001 #b101)
                expect
                (fp #b1 #b00000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000 #b001)
                expect
                (fp #b0 #b11110001011 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
