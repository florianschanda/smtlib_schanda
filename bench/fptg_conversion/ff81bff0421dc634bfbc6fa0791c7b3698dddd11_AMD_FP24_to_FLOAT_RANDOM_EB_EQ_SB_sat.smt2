(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110111 #b0111110011111010)
                arg1
                (fp #b0 #b0100100 #b0110011011001000)))
(assert (fp.leq (fp #b0 #b0100100 #b0110011011001000)
                arg1
                (fp #b0 #b1000001 #b1011101010000111)))
; arg1 = 0.0000000104419086710549890995025634765625

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001101101010 #b01001010100)
                expect
                (fp #b0 #b011111100100 #b01100110111)))
(assert (fp.leq (fp #b0 #b011111100100 #b01100110111)
                expect
                (fp #b0 #b101111100101 #b00011101011)))

(assert (= expect result))

(check-sat)
(exit)
