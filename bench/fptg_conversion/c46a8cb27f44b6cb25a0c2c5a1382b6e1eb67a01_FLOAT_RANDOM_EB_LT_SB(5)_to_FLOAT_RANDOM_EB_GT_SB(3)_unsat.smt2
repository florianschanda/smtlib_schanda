(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                expect
                (fp #b1 #b000 #b1)))
(assert (fp.leq (fp #b1 #b000 #b1)
                expect
                (fp #b0 #b111 #b0)))
; expect = -0.125

(assert (not (= expect result)))

(check-sat)
(exit)
