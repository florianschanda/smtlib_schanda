; Format from: TENSORFLOAT32
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00010010 #b0010011111)
                arg1
                (fp #b0 #b10001001 #b1111110011)))
(assert (fp.leq (fp #b0 #b10001001 #b1111110011)
                arg1
                (fp #b0 #b10110001 #b0000110000)))
