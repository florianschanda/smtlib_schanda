(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01110111 #b101110000101001)
                expect
                (fp #b0 #b10001001 #b111111001100000)))
(assert (fp.leq (fp #b0 #b10001001 #b111111001100000)
                expect
                (fp #b0 #b11000111 #b101010100100010)))
; expect = 2035.0

(assert (= expect result))

(check-sat)
(exit)
