; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11111001010110101100000)
                arg1
                (fp #b0 #b01111111 #b00010001000010101011100)))
(assert (fp.leq (fp #b0 #b01111111 #b00010001000010101011100)
                arg1
                (fp #b0 #b11010000 #b00110101100001110001101)))
; arg1 = 1.066569805145263671875

(declare-const result (_ FloatingPoint 18 18))
(assert (= result ((_ to_fp 18 18) rm arg1)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b011101110001011011 #b10001000111000000)
                expect
                (fp #b0 #b011111111111111111 #b00010001000010110)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b00010001000010110)
                expect
                (fp #b0 #b101000111000001000 #b00000001001010001)))

(assert (= expect result))

(check-sat)
(exit)
