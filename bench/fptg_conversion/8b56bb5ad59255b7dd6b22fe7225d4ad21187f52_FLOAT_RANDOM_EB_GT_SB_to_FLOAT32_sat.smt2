(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11011001111 #b0010000)
                arg1
                (fp #b1 #b10000000110 #b0011010)))
(assert (fp.leq (fp #b1 #b10000000110 #b0011010)
                arg1
                (fp #b1 #b00000001011 #b0111111)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100001 #b01000000010010111110001)
                expect
                (fp #b1 #b10000110 #b00110100000000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b00110100000000000000000)
                expect
                (fp #b0 #b00110101 #b00100100011111110011101)))
; expect = -154.0

(assert (= expect result))

(check-sat)
(exit)
