(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0110000011)
                arg1
                (fp #b0 #b01111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111 #b1111110100)
                arg1
                (fp #b0 #b11110 #b1011101000)))
; arg1 = 1.98828125

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100001 #b10011)
                expect
                (fp #b0 #b100000 #b00000)))
(assert (fp.leq (fp #b0 #b100000 #b00000)
                expect
                (fp #b0 #b101011 #b00001)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
