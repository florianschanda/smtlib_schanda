(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_2_2
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                arg1
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                arg1
                (fp #b1 #b00 #b1)))
; arg1 = -2.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011100 #b1100101000)
                expect
                (fp #b1 #b10000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b0000000000)
                expect
                (fp #b1 #b01110010 #b0101010010)))
; expect = -2.0

(assert (not (= expect result)))

(check-sat)
(exit)
