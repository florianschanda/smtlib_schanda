; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100010111101 #b00111)
                arg1
                (fp #b0 #b011111111111 #b10100)))
(assert (fp.leq (fp #b0 #b011111111111 #b10100)
                arg1
                (fp #b0 #b111101100110 #b00101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0100110 #b1111000110110000)
                expect
                (fp #b0 #b0111111 #b1010000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1010000000000000)
                expect
                (fp #b0 #b1011010 #b1010001110010001)))
; expect = 1.625

(assert (= expect result))

(check-sat)
(exit)
