(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01100010 #b11011011011011010100101)
                expect
                (fp #b0 #b01110001 #b00010010100000000000000)))
(assert (fp.leq (fp #b0 #b01110001 #b00010010100000000000000)
                expect
                (fp #b0 #b11000100 #b11111110100010110101101)))
; expect = 0.00006544589996337890625

(assert (= expect result))

(check-sat)
(exit)
