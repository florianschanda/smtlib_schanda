; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1011)
                arg1
                (fp #b1 #b011 #b0000)))
(assert (fp.leq (fp #b1 #b011 #b0000)
                arg1
                (fp #b1 #b000 #b1001)))
; arg1 = -1.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000001001101001 #b011011001010001)
                expect
                (fp #b1 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b000000000000000)
                expect
                (fp #b0 #b1000111101111110 #b101010110001011)))

(assert (= expect result))

(check-sat)
(exit)
