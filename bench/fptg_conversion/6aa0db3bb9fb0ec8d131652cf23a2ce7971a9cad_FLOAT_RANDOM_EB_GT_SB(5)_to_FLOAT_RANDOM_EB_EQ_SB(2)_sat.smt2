(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b1000 #b1)
                arg1
                (fp #b0 #b1101 #b0)))
(assert (fp.leq (fp #b0 #b1101 #b0)
                arg1
                (fp #b0 #b1110 #b1)))
; arg1 = 64.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b000100 #b11111)
                expect
                (fp #b0 #b100101 #b00000)))
(assert (fp.leq (fp #b0 #b100101 #b00000)
                expect
                (fp #b0 #b111011 #b00000)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
