(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                arg1
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 10 11))
(assert (= result ((_ to_fp 10 11) rm arg1)))

(declare-const expect (_ FloatingPoint 10 11))
(assert (fp.leq (fp #b1 #b0000110110 #b0111001111)
                expect
                (fp #b0 #b0111111100 #b0000000000)))
(assert (fp.leq (fp #b0 #b0111111100 #b0000000000)
                expect
                (fp #b0 #b1000110101 #b1111001101)))

(assert (= expect result))

(check-sat)
(exit)
