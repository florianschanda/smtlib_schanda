(assert (fp.leq (fp #b1 #b111000111011 #b10)
                expect
                (fp #b1 #b001101111001 #b00)))
(assert (fp.leq (fp #b1 #b001101111001 #b00)
                expect
                (fp #b0 #b011110001100 #b10)))

(assert (= expect result))

(check-sat)
