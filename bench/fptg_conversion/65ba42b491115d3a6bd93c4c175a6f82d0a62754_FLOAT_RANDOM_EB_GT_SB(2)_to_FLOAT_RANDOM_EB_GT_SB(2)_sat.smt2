; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b110001100001111 #b1100010100100)
                arg1
                (fp #b0 #b000000000000001 #b0000000000000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b0000000000000)
                arg1
                (fp #b0 #b110111011000111 #b0101001000001)))

(declare-const result (_ FloatingPoint 4 3))
(assert (= result ((_ to_fp 4 3) rm arg1)))

(declare-const expect (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1001 #b01)
                expect
                (fp #b0 #b0000 #b01)))
(assert (fp.leq (fp #b0 #b0000 #b01)
                expect
                (fp #b0 #b1010 #b11)))
; expect = 0.00390625

(assert (= expect result))

(check-sat)
(exit)
