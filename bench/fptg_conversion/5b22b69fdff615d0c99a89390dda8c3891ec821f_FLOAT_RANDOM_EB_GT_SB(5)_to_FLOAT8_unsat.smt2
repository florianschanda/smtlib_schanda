; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11100001000110 #b11101010)
                arg1
                (fp #b0 #b00000000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b10100110)
                arg1
                (fp #b0 #b01011100111110 #b01111011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1111)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b000 #b0100)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
