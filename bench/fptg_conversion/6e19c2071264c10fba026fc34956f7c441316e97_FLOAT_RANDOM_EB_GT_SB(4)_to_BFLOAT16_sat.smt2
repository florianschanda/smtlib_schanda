(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11000010 #b00)
                arg1
                (fp #b1 #b01111111 #b11)))
(assert (fp.leq (fp #b1 #b01111111 #b11)
                arg1
                (fp #b1 #b00101011 #b01)))
; arg1 = -1.75

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011010 #b0000110)
                expect
                (fp #b1 #b01111111 #b1100000)))
(assert (fp.leq (fp #b1 #b01111111 #b1100000)
                expect
                (fp #b0 #b10100110 #b1010100)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
