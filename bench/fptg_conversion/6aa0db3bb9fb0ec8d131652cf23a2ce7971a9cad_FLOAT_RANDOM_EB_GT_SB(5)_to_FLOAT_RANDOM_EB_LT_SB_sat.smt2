(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b1000 #b1)
                arg1
                (fp #b0 #b1101 #b0)))
(assert (fp.leq (fp #b0 #b1101 #b0)
                arg1
                (fp #b0 #b1110 #b1)))
; arg1 = 64.0

(declare-const result (_ FloatingPoint 10 25))
(assert (= result ((_ to_fp 10 25) rm arg1)))

(declare-const expect (_ FloatingPoint 10 25))
(assert (fp.leq (fp #b1 #b1011110001 #b011001100011111011110010)
                expect
                (fp #b0 #b1000000101 #b000000000000000000000000)))
(assert (fp.leq (fp #b0 #b1000000101 #b000000000000000000000000)
                expect
                (fp #b0 #b1001011110 #b010100010000111111100011)))

(assert (= expect result))

(check-sat)
(exit)
