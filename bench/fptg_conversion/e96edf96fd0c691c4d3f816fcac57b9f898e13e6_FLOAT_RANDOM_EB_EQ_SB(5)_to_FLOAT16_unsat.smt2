; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b011)
                arg1
                (fp #b0 #b1100 #b110)))
(assert (fp.leq (fp #b0 #b1100 #b110)
                arg1
                (fp #b0 #b1101 #b000)))
; arg1 = 56.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00100 #b1001000011)
                expect
                (fp #b0 #b10100 #b1100000000)))
(assert (fp.leq (fp #b0 #b10100 #b1100000000)
                expect
                (fp #b0 #b10110 #b1111100111)))
; expect = 56.0

(assert (not (= expect result)))

(check-sat)
(exit)
