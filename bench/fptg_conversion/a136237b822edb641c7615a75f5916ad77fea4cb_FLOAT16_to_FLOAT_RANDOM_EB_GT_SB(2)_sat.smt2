; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000000010)
                arg1
                (fp #b1 #b10111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10111 #b0000100000)
                arg1
                (fp #b0 #b01110 #b0100111000)))
; arg1 = -264.0

(declare-const result (_ FloatingPoint 11 6))
(assert (= result ((_ to_fp 11 6) rm arg1)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10111100100 #b11000)
                expect
                (fp #b1 #b10000000111 #b00001)))
(assert (fp.leq (fp #b1 #b10000000111 #b00001)
                expect
                (fp #b0 #b00100010000 #b10011)))

(assert (= expect result))

(check-sat)
(exit)
