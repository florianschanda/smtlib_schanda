; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100010010010111 #b10010010111111)
                arg1
                (fp #b1 #b100000000001101 #b11110010010110)))
(assert (fp.leq (fp #b1 #b100000000001101 #b11110010010110)
                arg1
                (fp #b0 #b010101001011100 #b11111011000101)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100000 #b1100010)
                expect
                (fp #b1 #b10001101 #b1111010)))
(assert (fp.leq (fp #b1 #b10001101 #b1111010)
                expect
                (fp #b0 #b11111110 #b0111010)))
; expect = -32000.0

(assert (not (= expect result)))

(check-sat)
(exit)
