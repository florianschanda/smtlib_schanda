(assert (fp.leq (fp #b1 #b11001111101 #b0101001000011010100110101001100011111010110001011010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10101100110 #b0011000101100011100011011001101100010101000101000100)))

(assert (= expect result))

(check-sat)
