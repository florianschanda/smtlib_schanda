; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101000011)
                arg1
                (fp #b1 #b11011 #b0110100001)))
(assert (fp.leq (fp #b1 #b11011 #b0110100001)
                arg1
                (fp #b0 #b00100 #b1111000100)))
; arg1 = -5764.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11000101 #b0111111)
                expect
                (fp #b1 #b10001011 #b0110101)))
(assert (fp.leq (fp #b1 #b10001011 #b0110101)
                expect
                (fp #b0 #b11100111 #b0000011)))
; expect = -5792.0

(assert (not (= expect result)))

(check-sat)
(exit)
