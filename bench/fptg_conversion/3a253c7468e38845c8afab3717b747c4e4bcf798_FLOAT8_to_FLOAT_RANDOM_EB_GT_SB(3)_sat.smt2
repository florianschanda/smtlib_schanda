(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                arg1
                (fp #b1 #b110 #b0001)))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b0 #b101 #b1001)))
; arg1 = -8.5

(declare-const result (_ FloatingPoint 5 3))
(assert (= result ((_ to_fp 5 3) rm arg1)))

(declare-const expect (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10100 #b01)
                expect
                (fp #b1 #b10010 #b01)))
(assert (fp.leq (fp #b1 #b10010 #b01)
                expect
                (fp #b0 #b00111 #b10)))
; expect = -10.0

(assert (= expect result))

(check-sat)
(exit)
