; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001011 #b01001)
                arg1
                (fp #b0 #b100001 #b00000)))
(assert (fp.leq (fp #b0 #b100001 #b00000)
                arg1
                (fp #b0 #b111010 #b11010)))
; arg1 = 4.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111011 #b00100110010101101000111)
                expect
                (fp #b0 #b10000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b00000000000000000000000)
                expect
                (fp #b0 #b10111011 #b10011010011011100001101)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
