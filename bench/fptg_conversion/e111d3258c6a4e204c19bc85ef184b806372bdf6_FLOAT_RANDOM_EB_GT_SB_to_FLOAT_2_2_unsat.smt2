; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111100 #b11)
                arg1
                (fp #b1 #b10000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000 #b10)
                arg1
                (fp #b1 #b00011011 #b10)))
; arg1 = -3.0

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b11 #b0)
                expect
                (fp #b1 #b10 #b1)))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b0 #b00 #b0)))
; expect = -3.0

(assert (not (= expect result)))

(check-sat)
(exit)
