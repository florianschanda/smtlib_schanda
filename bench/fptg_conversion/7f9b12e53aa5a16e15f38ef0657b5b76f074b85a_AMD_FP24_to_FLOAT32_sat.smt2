                expect
                (fp #b1 #b10111001 #b10110101101110010000000)))
(assert (fp.leq (fp #b1 #b10111001 #b10110101101110010000000)
                expect
                (fp #b0 #b01101001 #b01001010001000110001000)))
; expect = -492831897894780928.0

