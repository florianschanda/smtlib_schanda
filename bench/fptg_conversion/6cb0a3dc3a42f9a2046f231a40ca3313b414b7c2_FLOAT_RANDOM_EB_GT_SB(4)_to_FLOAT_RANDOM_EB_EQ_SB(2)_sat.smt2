(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0010111110010 #b1001)
                arg1
                (fp #b0 #b0110101001100 #b0100)))
(assert (fp.leq (fp #b0 #b0110101001100 #b0100)
                arg1
                (fp #b0 #b1101011000000 #b0110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010001 #b00010100)
                expect
                (fp #b0 #b000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000 #b00000001)
                expect
                (fp #b0 #b100100010 #b11110100)))

(assert (= expect result))

(check-sat)
(exit)
