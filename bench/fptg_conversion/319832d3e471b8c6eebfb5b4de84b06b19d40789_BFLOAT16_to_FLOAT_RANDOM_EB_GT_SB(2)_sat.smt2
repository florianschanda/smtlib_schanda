(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101111 #b1000101)
                arg1
                (fp #b1 #b10000110 #b0110001)))
(assert (fp.leq (fp #b1 #b10000110 #b0110001)
                arg1
                (fp #b0 #b10001010 #b0000101)))
; arg1 = -177.0

(declare-const result (_ FloatingPoint 11 6))
(assert (= result ((_ to_fp 11 6) rm arg1)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10111100111 #b01010)
                expect
                (fp #b1 #b10000000110 #b01101)))
(assert (fp.leq (fp #b1 #b10000000110 #b01101)
                expect
                (fp #b1 #b01100001001 #b01101)))

(assert (= expect result))

(check-sat)
(exit)
