; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10111 #b0111100101)
                arg1
                (fp #b0 #b11101 #b0000001101)))
(assert (fp.leq (fp #b0 #b11101 #b0000001101)
                arg1
                (fp #b0 #b11110 #b1101011010)))
; arg1 = 16592.0

(declare-const result (_ FloatingPoint 6 4))
(assert (= result ((_ to_fp 6 4) rm arg1)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b0 #b001111 #b110)
                expect
                (fp #b0 #b101101 #b001)))
(assert (fp.leq (fp #b0 #b101101 #b001)
                expect
                (fp #b0 #b110110 #b111)))
; expect = 18432.0

(assert (not (= expect result)))

(check-sat)
(exit)
