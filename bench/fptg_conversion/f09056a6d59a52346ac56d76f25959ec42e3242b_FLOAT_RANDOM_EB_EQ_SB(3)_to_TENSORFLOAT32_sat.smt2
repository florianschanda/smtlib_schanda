; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b011110 #b00000)
                arg1
                (fp #b0 #b011111 #b10111)))
(assert (fp.leq (fp #b0 #b011111 #b10111)
                arg1
                (fp #b0 #b110110 #b01100)))
; arg1 = 1.71875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00101111 #b1000110000)
                expect
                (fp #b0 #b01111111 #b1011100000)))
(assert (fp.leq (fp #b0 #b01111111 #b1011100000)
                expect
                (fp #b0 #b11110110 #b1000110110)))
; expect = 1.71875

(assert (= expect result))

(check-sat)
(exit)
