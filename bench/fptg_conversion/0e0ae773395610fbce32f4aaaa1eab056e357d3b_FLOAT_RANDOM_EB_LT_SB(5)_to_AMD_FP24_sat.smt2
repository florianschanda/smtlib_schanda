; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 27))
(assert (fp.leq (fp #b1 #b0101 #b01000110010101110010010000)
                arg1
                (fp #b1 #b0001 #b00000100101010111000000000)))
(assert (fp.leq (fp #b1 #b0001 #b00000100101010111000000000)
                arg1
                (fp #b0 #b1001 #b10001111101010010001110101)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b0110111011111110)
                expect
                (fp #b1 #b0111001 #b0000010010101100)))
(assert (fp.leq (fp #b1 #b0111001 #b0000010010101100)
                expect
                (fp #b0 #b1100011 #b1001111001100101)))
; expect = -0.01591014862060546875

(assert (= expect result))

(check-sat)
(exit)
