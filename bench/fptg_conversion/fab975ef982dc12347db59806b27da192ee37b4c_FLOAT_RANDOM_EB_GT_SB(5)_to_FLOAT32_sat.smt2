(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1000001101 #b1010)
                arg1
                (fp #b1 #b1000000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000000100 #b0000)
                arg1
                (fp #b0 #b0000001110 #b1101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101000 #b11110101101100010101110)
                expect
                (fp #b1 #b10000100 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000100 #b00000000000000000000000)
                expect
                (fp #b0 #b11000101 #b01110011000010100100111)))
; expect = -32.0

(assert (= expect result))

(check-sat)
(exit)
