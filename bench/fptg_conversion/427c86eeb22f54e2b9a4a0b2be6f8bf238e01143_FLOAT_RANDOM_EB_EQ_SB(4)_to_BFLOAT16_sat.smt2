(assert (fp.leq (fp #b1 #b11111000 #b1011100)
                expect
                (fp #b0 #b00000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000 #b0000001)
                expect
                (fp #b0 #b10111010 #b1100101)))
