; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101010000 #b0111111)
                arg1
                (fp #b1 #b100000110 #b0110001)))
(assert (fp.leq (fp #b1 #b100000110 #b0110001)
                arg1
                (fp #b1 #b001101000 #b1011000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11101 #b1010111101)
                expect
                (fp #b1 #b10110 #b0110001000)))
(assert (fp.leq (fp #b1 #b10110 #b0110001000)
                expect
                (fp #b1 #b10100 #b0011000111)))
; expect = -177.0

(assert (not (= expect result)))

(check-sat)
(exit)
