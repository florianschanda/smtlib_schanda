(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1001)
                arg1
                (fp #b1 #b101 #b0110)))
(assert (fp.leq (fp #b1 #b101 #b0110)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -5.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10001 #b1111000111)
                expect
                (fp #b1 #b10001 #b0110000000)))
(assert (fp.leq (fp #b1 #b10001 #b0110000000)
                expect
                (fp #b1 #b01001 #b0001100010)))
; expect = -5.5

(assert (not (= expect result)))

(check-sat)
(exit)
