(assert (fp.leq (fp #b0 #b00010011 #b0010110010)
                expect
                (fp #b0 #b10001010 #b1011110000)))
(assert (fp.leq (fp #b0 #b10001010 #b1011110000)
                expect
                (fp #b0 #b10110010 #b1010011100)))
; expect = 3552.0

