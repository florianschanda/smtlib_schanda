; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0011101000)
                arg1
                (fp #b1 #b01111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111 #b0001011101)
                arg1
                (fp #b0 #b00111 #b1000011000)))
; arg1 = -1.0908203125

(declare-const result (_ FloatingPoint 14 4))
(assert (= result ((_ to_fp 14 4) rm arg1)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111000011 #b011)
                expect
                (fp #b1 #b01111111111111 #b001)))
(assert (fp.leq (fp #b1 #b01111111111111 #b001)
                expect
                (fp #b0 #b01111010011011 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
