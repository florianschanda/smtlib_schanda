(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b0 #b0000 #b000)))
(assert (fp.leq (fp #b0 #b0000 #b000)
                arg1
                (fp #b0 #b0110 #b100)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 17 17))
(assert (= result ((_ to_fp 17 17) rm arg1)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11110011000001010 #b0010110101001110)
                expect
                (fp #b0 #b00000000000000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000000000000000)
                expect
                (fp #b0 #b00111000100100101 #b0111101000010101)))

(assert (= expect result))

(check-sat)
(exit)
