; Format from: FLOAT8
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1100)
                arg1
                (fp #b1 #b000 #b0110)))
(assert (fp.leq (fp #b1 #b000 #b0110)
                arg1
                (fp #b0 #b000 #b1110)))
; arg1 = -0.09375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1001)
                expect
                (fp #b1 #b000 #b0110)))
(assert (fp.leq (fp #b1 #b000 #b0110)
                expect
                (fp #b1 #b000 #b0100)))
; expect = -0.09375

(assert (= expect result))

(check-sat)
(exit)
