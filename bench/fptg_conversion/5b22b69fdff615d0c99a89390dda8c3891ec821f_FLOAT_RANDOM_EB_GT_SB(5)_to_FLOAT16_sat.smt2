; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11100001000110 #b11101010)
                arg1
                (fp #b0 #b00000000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b10100110)
                arg1
                (fp #b0 #b01011100111110 #b01111011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10110 #b1111001011)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01111 #b0110101000)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
