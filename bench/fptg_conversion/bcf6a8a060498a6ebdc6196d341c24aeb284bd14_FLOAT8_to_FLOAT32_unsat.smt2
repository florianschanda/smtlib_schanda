; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1000)
                arg1
                (fp #b0 #b001 #b0111)))
(assert (fp.leq (fp #b0 #b001 #b0111)
                arg1
