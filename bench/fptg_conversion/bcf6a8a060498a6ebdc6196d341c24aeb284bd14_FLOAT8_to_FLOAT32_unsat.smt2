(assert (fp.leq (fp #b0 #b00011010 #b01100111010001111100011)
                expect
                (fp #b0 #b01111101 #b01110000000000000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b01110000000000000000000)
                expect
                (fp #b0 #b11001000 #b11001001100001101010001)))
; expect = 0.359375

(assert (not (= expect result)))

(check-sat)
