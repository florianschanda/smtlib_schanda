; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00110010 #b0010111011)
                arg1
                (fp #b0 #b10000000 #b1000110110)))
(assert (fp.leq (fp #b0 #b10000000 #b1000110110)
                arg1
                (fp #b0 #b11101000 #b1010010100)))
; arg1 = 3.10546875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100101 #b00100111010001101110011)
                expect
                (fp #b0 #b10000000 #b10001101100000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b10001101100000000000000)
                expect
                (fp #b0 #b10000110 #b10001110011111010000001)))
; expect = 3.10546875

(assert (= expect result))

(check-sat)
(exit)
