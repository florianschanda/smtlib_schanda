; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101101000)
                arg1
                (fp #b1 #b00011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00011 #b0000000000)
                arg1
                (fp #b0 #b11010 #b1101001101)))
; arg1 = -0.000244140625

(declare-const result (_ FloatingPoint 11 26))
(assert (= result ((_ to_fp 11 26) rm arg1)))

(declare-const expect (_ FloatingPoint 11 26))
(assert (fp.leq (fp #b1 #b11110100010 #b0101010100100001000000111)
                expect
                (fp #b1 #b01111110011 #b0000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111110011 #b0000000000000000000000000)
                expect
                (fp #b0 #b11000010010 #b0100111011101101110010110)))

(assert (= expect result))

(check-sat)
(exit)
