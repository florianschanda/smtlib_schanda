(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b01100101 #b00000010111110100100011)
                arg1
                (fp #b0 #b01111111 #b11000100000000000001001)))
(assert (fp.leq (fp #b0 #b01111111 #b11000100000000000001001)
                arg1
                (fp #b0 #b11111000 #b00101110100100011110111)))
; arg1 = 1.76562607288360595703125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b01010100 #b011110100101111)
                expect
                (fp #b0 #b01111111 #b110001000000001)))
(assert (fp.leq (fp #b0 #b01111111 #b110001000000001)
                expect
                (fp #b0 #b10011011 #b001111101001110)))
; expect = 1.765655517578125

(assert (= expect result))

(check-sat)
(exit)
