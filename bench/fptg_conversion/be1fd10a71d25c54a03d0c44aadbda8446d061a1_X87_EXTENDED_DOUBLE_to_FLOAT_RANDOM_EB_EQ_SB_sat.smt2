(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: X87_EXTENDED_DOUBLE
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 64))
(assert (fp.isNaN arg1))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNaN expect))
; expect = NaN

(assert (= expect result))

(check-sat)
(exit)
