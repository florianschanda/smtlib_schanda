(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg1
                (fp #b1 #b01111111 #b100)))
(assert (fp.leq (fp #b1 #b01111111 #b100)
                arg1
                (fp #b0 #b01101101 #b010)))
; arg1 = -1.5

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0110111011)
                expect
                (fp #b1 #b01111 #b1000000000)))
(assert (fp.leq (fp #b1 #b01111 #b1000000000)
                expect
                (fp #b0 #b10100 #b0000110001)))
; expect = -1.5

(assert (= expect result))

(check-sat)
(exit)
