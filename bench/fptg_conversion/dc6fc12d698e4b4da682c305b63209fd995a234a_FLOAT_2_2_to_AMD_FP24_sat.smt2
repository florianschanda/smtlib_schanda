(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: AMD_FP24
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b01 #b0)
                arg1
                (fp #b0 #b10 #b1)))
(assert (fp.leq (fp #b0 #b10 #b1)
                arg1
                (fp #b0 #b11 #b0)))
; arg1 = 3.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b0100011011001111)
                expect
                (fp #b0 #b1000000 #b1000000000000000)))
(assert (fp.leq (fp #b0 #b1000000 #b1000000000000000)
                expect
                (fp #b0 #b1101010 #b0110001001000111)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
