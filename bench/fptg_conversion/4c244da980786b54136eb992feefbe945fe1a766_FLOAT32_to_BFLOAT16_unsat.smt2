; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110111 #b10111010010010111010110)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11100000 #b11111010011110101011101)))
; arg1 = 55651713024.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b0101110)
                expect
                (fp #b0 #b10100010 #b1010000)))
(assert (fp.leq (fp #b0 #b10100010 #b1010000)
                expect
                (fp #b0 #b11011010 #b1011110)))
; expect = 55834574848.0

(assert (not (= expect result)))

(check-sat)
(exit)
