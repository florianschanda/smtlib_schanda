(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0010)
                arg1
                (fp #b1 #b011 #b0011)))
(assert (fp.leq (fp #b1 #b011 #b0011)
                arg1
                (fp #b1 #b001 #b0100)))
; arg1 = -1.1875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111001 #b11111000111000110100101)
                expect
                (fp #b1 #b01111111 #b00110000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00110000000000000000000)
                expect
                (fp #b1 #b01010110 #b00101000010100000110111)))
; expect = -1.1875

(assert (= expect result))

(check-sat)
(exit)
