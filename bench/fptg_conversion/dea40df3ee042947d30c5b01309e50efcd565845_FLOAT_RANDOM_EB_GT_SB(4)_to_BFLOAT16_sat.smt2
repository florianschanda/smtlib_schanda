(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b10010 #b000)
                arg1
                (fp #b1 #b01111 #b110)))
(assert (fp.leq (fp #b1 #b01111 #b110)
                arg1
                (fp #b1 #b01101 #b010)))
; arg1 = -1.75

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10111001 #b1101010)
                expect
                (fp #b1 #b01111111 #b1100000)))
(assert (fp.leq (fp #b1 #b01111111 #b1100000)
                expect
                (fp #b0 #b10011111 #b0010011)))
; expect = -1.75

(assert (= expect result))

(check-sat)
(exit)
