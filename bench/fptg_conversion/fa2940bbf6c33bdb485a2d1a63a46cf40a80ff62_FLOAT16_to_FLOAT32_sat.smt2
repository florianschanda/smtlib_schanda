(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01011 #b1011011100)
                arg1
                (fp #b0 #b11101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11101 #b0000000000)
                arg1
                (fp #b0 #b11101 #b1101010110)))
; arg1 = 16384.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10101101 #b00001010101101110001100)
                expect
                (fp #b0 #b10001101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001101 #b00000000000000000000000)
                expect
                (fp #b0 #b10110011 #b10010000010000011001101)))
; expect = 16384.0

(assert (= expect result))

(check-sat)
(exit)
