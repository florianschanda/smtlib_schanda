; Format from: FLOAT8
; Format to: AMD_FP24
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0110)
                arg1
                (fp #b1 #b000 #b1111)))
(assert (fp.leq (fp #b1 #b000 #b1111)
                arg1
                (fp #b1 #b000 #b0000)))
; arg1 = -0.234375

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101101 #b1100011000010010)
                expect
                (fp #b1 #b0111100 #b1110000000000000)))
(assert (fp.leq (fp #b1 #b0111100 #b1110000000000000)
                expect
                (fp #b0 #b1101011 #b1001010000001110)))
; expect = -0.234375

(assert (not (= expect result)))

(check-sat)
(exit)
