(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1001100110010010 #b0010110110011)
                expect
                (fp #b1 #b1000000000001001 #b0110110001000)))
(assert (fp.leq (fp #b1 #b1000000000001001 #b0110110001000)
                expect
                (fp #b0 #b1000100111100001 #b0000001000000)))

(assert (= expect result))

(check-sat)
