(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1010 #b010)
                arg1
                (fp #b1 #b0000 #b000)))
(assert (fp.leq (fp #b1 #b0000 #b000)
                arg1
                (fp #b0 #b1000 #b001)))
; arg1 = -0

(declare-const result (_ FloatingPoint 12 6))
(assert (= result ((_ to_fp 12 6) rm arg1)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101001111100 #b11101)
                expect
                (fp #b1 #b000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000)
                expect
                (fp #b0 #b100101111001 #b01011)))

(assert (= expect result))

(check-sat)
(exit)
