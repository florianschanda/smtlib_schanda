; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01110 #b1101)
                arg1
                (fp #b0 #b01111 #b0011)))
(assert (fp.leq (fp #b0 #b01111 #b0011)
                arg1
                (fp #b0 #b10111 #b0111)))
; arg1 = 1.1875

(declare-const result (_ FloatingPoint 6 4))
(assert (= result ((_ to_fp 6 4) rm arg1)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b101011 #b010)
                expect
                (fp #b0 #b011111 #b010)))
(assert (fp.leq (fp #b0 #b011111 #b010)
                expect
                (fp #b0 #b101101 #b100)))
; expect = 1.25

(assert (= expect result))

(check-sat)
(exit)
