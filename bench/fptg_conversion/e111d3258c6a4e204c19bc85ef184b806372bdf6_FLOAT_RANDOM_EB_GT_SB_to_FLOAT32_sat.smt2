(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11111100 #b11)
                arg1
                (fp #b1 #b10000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000 #b10)
                arg1
                (fp #b1 #b00011011 #b10)))
; arg1 = -3.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110111 #b11110011101111010111111)
                expect
                (fp #b1 #b10000000 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b10000000000000000000000)
                expect
                (fp #b0 #b10010110 #b00100101101001011000010)))
; expect = -3.0

(assert (= expect result))

(check-sat)
(exit)
