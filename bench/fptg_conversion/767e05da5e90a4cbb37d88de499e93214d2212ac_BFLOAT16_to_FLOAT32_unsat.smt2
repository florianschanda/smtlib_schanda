; Format from: BFLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100100 #b0011011)
                arg1
                (fp #b1 #b01111111 #b0000010)))
(assert (fp.leq (fp #b1 #b01111111 #b0000010)
                arg1
                (fp #b1 #b00000100 #b1000000)))
; arg1 = -1.015625

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001100 #b11111111000000001000101)
                expect
                (fp #b1 #b01111111 #b00000100000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000100000000000000000)
                expect
                (fp #b0 #b11110001 #b11110000001101010110100)))
; expect = -1.015625

(assert (not (= expect result)))

(check-sat)
(exit)
