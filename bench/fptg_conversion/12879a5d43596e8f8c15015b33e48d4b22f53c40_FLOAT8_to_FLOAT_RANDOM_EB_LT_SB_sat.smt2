(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1100)
                arg1
                (fp #b0 #b101 #b0000)))
(assert (fp.leq (fp #b0 #b101 #b0000)
                arg1
                (fp #b0 #b110 #b0100)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 5 8))
(assert (= result ((_ to_fp 5 8) rm arg1)))

(declare-const expect (_ FloatingPoint 5 8))
(assert (fp.leq (fp #b1 #b00011 #b0110111)
                expect
                (fp #b0 #b10001 #b0000000)))
(assert (fp.leq (fp #b0 #b10001 #b0000000)
                expect
                (fp #b0 #b10011 #b0101101)))
; expect = 4.0

(assert (= expect result))

(check-sat)
(exit)
