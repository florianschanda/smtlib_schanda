(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b10111 #b10)
                arg1
                (fp #b0 #b00111 #b00)))
(assert (fp.leq (fp #b0 #b00111 #b00)
                arg1
                (fp #b0 #b10001 #b01)))
; arg1 = 0.00390625

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10011 #b0110000110)
                expect
                (fp #b0 #b00111 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111 #b0000000000)
                expect
                (fp #b0 #b10011 #b0100110101)))
; expect = 0.00390625

(assert (= expect result))

(check-sat)
(exit)
