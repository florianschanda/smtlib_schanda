; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b01010100101100011001000)
                arg1
                (fp #b1 #b10010111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010111 #b00000000000000000000000)
                arg1
                (fp #b1 #b10000110 #b00001010001111111111110)))
; arg1 = -16777216.0

(declare-const result (_ FloatingPoint 16 2))
(assert (= result ((_ to_fp 16 2) rm arg1)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111001101111110 #b1)
                expect
                (fp #b1 #b1000000000010111 #b0)))
(assert (fp.leq (fp #b1 #b1000000000010111 #b0)
                expect
                (fp #b0 #b0100010101101010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
