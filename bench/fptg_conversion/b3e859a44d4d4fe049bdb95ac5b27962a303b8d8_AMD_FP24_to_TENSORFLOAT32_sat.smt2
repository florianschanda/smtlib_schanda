; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1000000 #b1100001011001011)
                arg1
                (fp #b0 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b1101001 #b0010100100001000)))
; arg1 = 0.0000000004656612873077392578125

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00010010 #b0101011101)
                expect
                (fp #b0 #b01100000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01100000 #b0000000000)
                expect
                (fp #b0 #b11010010 #b0000110101)))
; expect = 0.0000000004656612873077392578125

(assert (= expect result))

(check-sat)
(exit)
