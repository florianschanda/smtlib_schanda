; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01100 #b0000011110)
                arg1
                (fp #b0 #b11100 #b1001010011)))
(assert (fp.leq (fp #b0 #b11100 #b1001010011)
                arg1
                (fp #b0 #b11100 #b1010000001)))
; arg1 = 12952.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100100 #b00101111111010000010100)
                expect
                (fp #b0 #b10001100 #b10010100110000000000000)))
(assert (fp.leq (fp #b0 #b10001100 #b10010100110000000000000)
                expect
                (fp #b0 #b10011110 #b11111101001111010111011)))
; expect = 12952.0

(assert (not (= expect result)))

(check-sat)
(exit)
