(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001000110 #b1010001101)
                arg1
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b00110110111 #b1111011001)))

(declare-const result (_ FloatingPoint 3 2))
(assert (= result ((_ to_fp 3 2) rm arg1)))

(declare-const expect (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b010 #b1)
                expect
                (fp #b0 #b000 #b1)))
(assert (fp.leq (fp #b0 #b000 #b1)
                expect
                (fp #b0 #b110 #b1)))
; expect = 0.125

(assert (not (= expect result)))

(check-sat)
(exit)
