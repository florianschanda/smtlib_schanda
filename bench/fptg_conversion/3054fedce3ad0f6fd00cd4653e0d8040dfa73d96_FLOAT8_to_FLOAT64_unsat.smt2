; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1101)
                arg1
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                arg1
                (fp #b0 #b110 #b1111)))
; arg1 = -0.015625

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000110100 #b1111011011101000001110100000011000011110101101000101)
                expect
                (fp #b1 #b01111111001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111011000 #b1110011000100110111001100101110010010101011001010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
