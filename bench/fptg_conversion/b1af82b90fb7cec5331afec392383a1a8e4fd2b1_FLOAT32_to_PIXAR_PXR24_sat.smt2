(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001000 #b00100010011001100000000)
                arg1
                (fp #b0 #b10010101 #b10001001000000100111000)))
(assert (fp.leq (fp #b0 #b10010101 #b10001001000000100111000)
                arg1
                (fp #b0 #b10010101 #b10001010111100001010010)))
; arg1 = 6439068.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01011111 #b100101111001110)
                expect
                (fp #b0 #b10010101 #b100010010000010)))
(assert (fp.leq (fp #b0 #b10010101 #b100010010000010)
                expect
                (fp #b0 #b11100111 #b001101011000000)))
; expect = 6439168.0

(assert (= expect result))

(check-sat)
(exit)
