(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100000100 #b01000)
                arg1
                (fp #b1 #b000000000 #b00101)))
(assert (fp.leq (fp #b1 #b000000000 #b00101)
                arg1
                (fp #b0 #b001101100 #b01011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100111101 #b01100111101)
                expect
                (fp #b1 #b011011111110 #b01000000000)))
(assert (fp.leq (fp #b1 #b011011111110 #b01000000000)
                expect
                (fp #b0 #b100100111001 #b10000111111)))

(assert (= expect result))

(check-sat)
(exit)
