; Format from: AMD_FP24
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0100101 #b0010001000110000)
                arg1
                (fp #b0 #b0111111 #b0010000110101000)))
(assert (fp.leq (fp #b0 #b0111111 #b0010000110101000)
                arg1
                (fp #b0 #b1100100 #b1001110001000111)))
; arg1 = 1.1314697265625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b010 #b0101)
                expect
                (fp #b0 #b011 #b0011)))
(assert (fp.leq (fp #b0 #b011 #b0011)
                expect
                (fp #b0 #b110 #b0010)))
; expect = 1.1875

(assert (not (= expect result)))

(check-sat)
(exit)
