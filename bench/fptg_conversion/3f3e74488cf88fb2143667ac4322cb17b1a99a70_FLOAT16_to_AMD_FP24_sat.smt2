(assert (fp.leq (fp #b1 #b1000100 #b1000101100000110)
                expect
                (fp #b1 #b0110000 #b1101000010000000)))
(assert (fp.leq (fp #b1 #b0110000 #b1101000010000000)
                expect
                (fp #b0 #b0001111 #b0110100010110101)))
; expect = -0.000055372714996337890625

(assert (= expect result))

(check-sat)
