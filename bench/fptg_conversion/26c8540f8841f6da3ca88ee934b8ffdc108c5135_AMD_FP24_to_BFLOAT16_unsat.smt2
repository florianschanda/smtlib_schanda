; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0100010010000000)
                arg1
                (fp #b1 #b1100000 #b1001011101101101)))
(assert (fp.leq (fp #b1 #b1100000 #b1001011101101101)
                arg1
                (fp #b1 #b1000001 #b1011101001001010)))
; arg1 = -13670940672.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001001 #b1101001)
                expect
                (fp #b1 #b10100000 #b1001100)))
(assert (fp.leq (fp #b1 #b10100000 #b1001100)
                expect
                (fp #b1 #b01010111 #b1000011)))
; expect = -13690208256.0

(assert (not (= expect result)))

(check-sat)
(exit)
