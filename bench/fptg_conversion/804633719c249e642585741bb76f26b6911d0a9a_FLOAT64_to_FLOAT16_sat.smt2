; Format from: FLOAT64
; Format to: FLOAT16
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01111111011 #b1011000100101001111010011010010011110101100001100001)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b00100011011 #b0011001111000101011001100101101000100101001000000111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01111 #b0111011110)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b10010 #b1100100111)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
