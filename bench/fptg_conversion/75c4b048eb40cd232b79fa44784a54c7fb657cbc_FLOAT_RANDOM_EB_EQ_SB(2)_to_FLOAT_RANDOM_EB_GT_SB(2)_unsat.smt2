(declare-const expect (_ FloatingPoint 7 3))
(assert (fp.leq (fp #b0 #b0000010 #b01)
                expect
                (fp #b0 #b1001001 #b00)))
(assert (fp.leq (fp #b0 #b1001001 #b00)
                expect
                (fp #b0 #b1001100 #b10)))
; expect = 1024.0

(assert (not (= expect result)))

