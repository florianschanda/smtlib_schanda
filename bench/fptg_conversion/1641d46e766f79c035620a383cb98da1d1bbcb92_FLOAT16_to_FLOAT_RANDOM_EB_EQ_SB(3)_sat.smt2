; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1000111110)
                arg1
                (fp #b1 #b11010 #b1101100110)))
(assert (fp.leq (fp #b1 #b11010 #b1101100110)
                arg1
                (fp #b1 #b11001 #b1100010111)))
; arg1 = -3788.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000111111 #b100101110)
                expect
                (fp #b1 #b1000001010 #b110110011)))
(assert (fp.leq (fp #b1 #b1000001010 #b110110011)
                expect
                (fp #b0 #b1010110110 #b110110100)))

(assert (= expect result))

(check-sat)
(exit)
