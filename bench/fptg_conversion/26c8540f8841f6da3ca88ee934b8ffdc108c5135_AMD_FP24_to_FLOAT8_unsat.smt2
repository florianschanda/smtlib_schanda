(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT8
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0100010010000000)
                arg1
                (fp #b1 #b1100000 #b1001011101101101)))
(assert (fp.leq (fp #b1 #b1100000 #b1001011101101101)
                arg1
                (fp #b1 #b1000001 #b1011101001001010)))
; arg1 = -13670940672.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
