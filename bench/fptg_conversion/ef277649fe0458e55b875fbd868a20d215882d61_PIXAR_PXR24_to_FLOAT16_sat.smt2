(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: PIXAR_PXR24
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b01010000 #b110010100110010)
                arg1
                (fp #b0 #b10001101 #b000000011000110)))
(assert (fp.leq (fp #b0 #b10001101 #b000000011000110)
                arg1
                (fp #b0 #b11110010 #b011101111010111)))
; arg1 = 16483.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01111 #b1011101001)
                expect
                (fp #b0 #b11101 #b0000000111)))
(assert (fp.leq (fp #b0 #b11101 #b0000000111)
                expect
                (fp #b0 #b11110 #b0010101110)))
; expect = 16496.0

(assert (= expect result))

(check-sat)
(exit)
