; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10111 #b1100010100)
                arg1
                (fp #b1 #b00000 #b0101100101)))
(assert (fp.leq (fp #b1 #b00000 #b0101100101)
                arg1
                (fp #b0 #b01101 #b1000111101)))
; arg1 = -0.000021278858184814453125

(declare-const result (_ FloatingPoint 14 12))
(assert (= result ((_ to_fp 14 12) rm arg1)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10010001011111 #b11111111110)
                expect
                (fp #b1 #b01111111101111 #b01100101000)))
(assert (fp.leq (fp #b1 #b01111111101111 #b01100101000)
                expect
                (fp #b0 #b01011111101011 #b01101000011)))

(assert (= expect result))

(check-sat)
(exit)
