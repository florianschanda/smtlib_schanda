; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b011)
                arg1
                (fp #b0 #b1100 #b110)))
(assert (fp.leq (fp #b0 #b1100 #b110)
                arg1
                (fp #b0 #b1101 #b000)))
; arg1 = 56.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00000010 #b00000010110111010110110)
                expect
                (fp #b0 #b10000100 #b11000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000100 #b11000000000000000000000)
                expect
                (fp #b0 #b11110101 #b01011101011000100101110)))
; expect = 56.0

(assert (not (= expect result)))

(check-sat)
(exit)
