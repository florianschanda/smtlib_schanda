(assert (fp.leq (fp #b1 #b01001 #b0000011001)
                expect
                (fp #b0 #b00001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00001 #b0000000000)
                expect
                (fp #b0 #b00011 #b1110101101)))
; expect = 0.00006103515625

(assert (not (= expect result)))

(check-sat)
(exit)
