; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111001100100 #b100)
                arg1
                (fp #b0 #b00000000000001 #b000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b000)
                arg1
                (fp #b0 #b00101000101011 #b001)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0100)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b000 #b1101)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
