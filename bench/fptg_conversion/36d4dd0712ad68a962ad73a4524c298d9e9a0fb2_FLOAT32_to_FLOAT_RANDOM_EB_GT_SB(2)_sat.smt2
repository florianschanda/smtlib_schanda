(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11101110 #b11110001101001000110011)
                arg1
                (fp #b1 #b00000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10111101 #b00010111000111101011110)))
; arg1 = -0

(declare-const result (_ FloatingPoint 18 11))
(assert (= result ((_ to_fp 18 11) rm arg1)))

(declare-const expect (_ FloatingPoint 18 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100010010001110111 #b1111101011)
                expect
                (fp #b1 #b000000000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000000000)
                expect
                (fp #b0 #b011100100100101001 #b0000101100)))

(assert (= expect result))

(check-sat)
(exit)
