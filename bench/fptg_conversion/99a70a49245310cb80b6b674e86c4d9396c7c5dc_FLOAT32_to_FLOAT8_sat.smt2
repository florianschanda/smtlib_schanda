(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT8
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110101 #b11101101100101110110011)
                arg1
                (fp #b1 #b00000001 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000001 #b00000000000000000000000)
                arg1
                (fp #b0 #b01000111 #b00110011100000000000010)))
; arg1 = -0.000000000000000000000000000000000000011754943508222875079687365372222456778186655567720875215087517062784172594547271728515625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1001)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b000 #b1010)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
