(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b11101 #b001)
                arg1
                (fp #b1 #b11101 #b000)))
(assert (fp.leq (fp #b1 #b11101 #b000)
                arg1
                (fp #b0 #b11001 #b010)))
; arg1 = -16384.0

(declare-const result (_ FloatingPoint 13 13))
(assert (= result ((_ to_fp 13 13) rm arg1)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1011000100110 #b001001001110)
                expect
                (fp #b1 #b1000000001101 #b000000000000)))
(assert (fp.leq (fp #b1 #b1000000001101 #b000000000000)
                expect
                (fp #b1 #b0011101101011 #b101001111011)))

(assert (= expect result))

(check-sat)
(exit)
