; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b00010011 #b00000100110101010100000)
                arg1
                (fp #b0 #b10010110 #b11001001000000101010001)))
(assert (fp.leq (fp #b0 #b10010110 #b11001001000000101010001)
                arg1
                (fp #b0 #b10011011 #b01110101101001010001100)))
; arg1 = 14975313.0

(declare-const result (_ FloatingPoint 13 8))
(assert (= result ((_ to_fp 13 8) rm arg1)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0011001101100 #b1011011)
                expect
                (fp #b0 #b1000000010110 #b1100101)))
(assert (fp.leq (fp #b0 #b1000000010110 #b1100101)
                expect
                (fp #b0 #b1011000101000 #b0001101)))

(assert (= expect result))

(check-sat)
(exit)
