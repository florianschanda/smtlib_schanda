                expect
                (fp #b1 #b0000 #b00000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b0000 #b00000000000000000000000000000001)
                expect
                (fp #b0 #b0001 #b11011000000100100110000001000101)))

(assert (= expect result))

