(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011 #b1)
                arg1
                (fp #b0 #b000 #b0)))
(assert (fp.leq (fp #b0 #b000 #b0)
                arg1
                (fp #b0 #b111 #b0)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0100000 #b101000)
                expect
                (fp #b0 #b0000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000 #b000000)
                expect
                (fp #b0 #b0100101 #b001010)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
