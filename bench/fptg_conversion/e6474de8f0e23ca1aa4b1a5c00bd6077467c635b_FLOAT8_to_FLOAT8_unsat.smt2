(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0001)
                arg1
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                arg1
                (fp #b0 #b110 #b1111)))
; arg1 = 15.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0010)
                expect
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                expect
                (fp #b0 #b111 #b0000)))
; expect = 15.0

(assert (not (= expect result)))

(check-sat)
(exit)
