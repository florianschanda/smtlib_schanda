                expect
                (fp #b0 #b10000010 #b11110000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b11110000000000000000000)
                expect
                (fp #b0 #b11000111 #b01111101000001001000011)))
; expect = 15.5

(assert (= expect result))

