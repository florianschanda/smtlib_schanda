; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1011110100100 #b0000)
                arg1
                (fp #b0 #b0111111111111 #b0110)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0110)
                arg1
                (fp #b0 #b1000101111010 #b1101)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00101 #b0000111010)
                expect
                (fp #b0 #b01111 #b0110000000)))
(assert (fp.leq (fp #b0 #b01111 #b0110000000)
                expect
                (fp #b0 #b10001 #b1001011011)))
; expect = 1.375

(assert (= expect result))

(check-sat)
(exit)
