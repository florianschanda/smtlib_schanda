(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01101 #b0100)
                expect
                (fp #b1 #b00000 #b0001)))
(assert (fp.leq (fp #b1 #b00000 #b0001)
                expect
                (fp #b0 #b01000 #b1000)))
; expect = -0.000003814697265625

(assert (= expect result))

(check-sat)
