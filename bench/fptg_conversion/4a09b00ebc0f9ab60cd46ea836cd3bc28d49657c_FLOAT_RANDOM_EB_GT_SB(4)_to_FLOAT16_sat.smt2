; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000000011000 #b01110100)
                arg1
                (fp #b0 #b000110111011 #b01101011)))
(assert (fp.leq (fp #b0 #b000110111011 #b01101011)
                arg1
                (fp #b0 #b010111011011 #b01100110)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10000 #b1001100011)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01001 #b0010101011)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
