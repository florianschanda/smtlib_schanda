(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b100 #b0)
                arg1
                (fp #b1 #b011 #b1)))
(assert (fp.leq (fp #b1 #b011 #b1)
                arg1
                (fp #b0 #b000 #b0)))
; arg1 = -1.5

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101000 #b0110100111100001)
                expect
                (fp #b1 #b0111111 #b1000000000000000)))
(assert (fp.leq (fp #b1 #b0111111 #b1000000000000000)
                expect
                (fp #b0 #b1110101 #b1110100100001100)))
; expect = -1.5

(assert (not (= expect result)))

(check-sat)
(exit)
