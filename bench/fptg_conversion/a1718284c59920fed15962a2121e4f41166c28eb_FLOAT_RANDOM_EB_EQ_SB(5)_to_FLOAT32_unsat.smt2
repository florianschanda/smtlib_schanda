; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000110 #b011010000)
                arg1
                (fp #b1 #b1000000111 #b001010110)))
(assert (fp.leq (fp #b1 #b1000000111 #b001010110)
                arg1
                (fp #b0 #b1101111001 #b001000010)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010001 #b00111011111110110001110)
                expect
                (fp #b1 #b10000111 #b00101011000000000000000)))
(assert (fp.leq (fp #b1 #b10000111 #b00101011000000000000000)
                expect
                (fp #b0 #b00110110 #b01000111000000001100111)))
; expect = -299.0

(assert (not (= expect result)))

(check-sat)
(exit)
