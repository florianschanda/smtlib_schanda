(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b011000100 #b0)
                arg1
                (fp #b0 #b100000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000 #b1)
                arg1
                (fp #b0 #b101101101 #b0)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01011001 #b10010100001011100010010)
                expect
                (fp #b0 #b10000000 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b10000000000000000000000)
                expect
                (fp #b0 #b11111010 #b10110001000110001000111)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
