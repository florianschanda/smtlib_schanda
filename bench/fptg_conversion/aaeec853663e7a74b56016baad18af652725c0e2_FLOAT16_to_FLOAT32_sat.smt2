(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1101010001)
                arg1
                (fp #b1 #b10110 #b1000001110)))
(assert (fp.leq (fp #b1 #b10110 #b1000001110)
                arg1
                (fp #b0 #b01101 #b1111101100)))
; arg1 = -193.75

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111000 #b01100010101111110100000)
                expect
                (fp #b1 #b10000110 #b10000011100000000000000)))
(assert (fp.leq (fp #b1 #b10000110 #b10000011100000000000000)
                expect
                (fp #b1 #b00111010 #b01110001101000001001110)))
; expect = -193.75

(assert (= expect result))

(check-sat)
(exit)
