; Format from: AMD_FP24
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1001110 #b0011100100001110)
                arg1
                (fp #b0 #b0000000 #b0011011101011101)))
(assert (fp.leq (fp #b0 #b0000000 #b0011011101011101)
                arg1
                (fp #b0 #b1110011 #b1100100000110010)))
