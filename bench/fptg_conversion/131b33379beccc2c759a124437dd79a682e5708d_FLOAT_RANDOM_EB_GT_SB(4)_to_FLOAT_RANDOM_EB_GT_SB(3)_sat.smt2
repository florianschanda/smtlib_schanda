(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00000 #b001)
                arg1
                (fp #b0 #b10010 #b111)))
(assert (fp.leq (fp #b0 #b10010 #b111)
                arg1
                (fp #b0 #b11000 #b011)))
; arg1 = 15.0

(declare-const result (_ FloatingPoint 11 3))
(assert (= result ((_ to_fp 11 3) rm arg1)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11110110110 #b11)
                expect
                (fp #b0 #b10000000011 #b00)))
(assert (fp.leq (fp #b0 #b10000000011 #b00)
                expect
                (fp #b0 #b11010010000 #b10)))

(assert (= expect result))

(check-sat)
(exit)
