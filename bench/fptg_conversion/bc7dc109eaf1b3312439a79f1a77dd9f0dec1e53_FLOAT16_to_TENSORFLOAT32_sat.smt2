; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: -LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11111 #b0000000000)
                arg1
                (fp #b1 #b11110 #b1111111111)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11100 #b0011010100)))
; arg1 = -65504.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11000111 #b1110000100)
                expect
                (fp #b1 #b10001110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10001110 #b1111111111)
                expect
                (fp #b0 #b10111000 #b1001001111)))
; expect = -65504.0

(assert (= expect result))

(check-sat)
(exit)
