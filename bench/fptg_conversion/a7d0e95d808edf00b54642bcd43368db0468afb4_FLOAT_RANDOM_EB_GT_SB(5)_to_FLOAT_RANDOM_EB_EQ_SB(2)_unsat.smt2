; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11100 #b0)
                arg1
                (fp #b1 #b10111 #b0)))
(assert (fp.leq (fp #b1 #b10111 #b0)
                arg1
                (fp #b1 #b01100 #b0)))
; arg1 = -256.0

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010101010101000 #b000001010010011)
                expect
                (fp #b1 #b1000000000000111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000000111 #b000000000000000)
                expect
                (fp #b1 #b0011001001010010 #b000100001000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
