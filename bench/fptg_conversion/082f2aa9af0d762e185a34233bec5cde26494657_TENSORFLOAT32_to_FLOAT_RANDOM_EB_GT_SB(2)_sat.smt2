; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11111010 #b1111010100)
                arg1
                (fp #b1 #b10000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100000)
                arg1
                (fp #b0 #b01100000 #b0001100000)))
; arg1 = -264.0

(declare-const result (_ FloatingPoint 11 10))
(assert (= result ((_ to_fp 11 10) rm arg1)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11011110001 #b110000101)
                expect
                (fp #b1 #b10000000111 #b000010000)))
(assert (fp.leq (fp #b1 #b10000000111 #b000010000)
                expect
                (fp #b1 #b00111110110 #b110111100)))

(assert (= expect result))

(check-sat)
(exit)
