(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01111 #b1001101110)
                arg1
                (fp #b0 #b11010 #b0010000000)))
(assert (fp.leq (fp #b0 #b11010 #b0010000000)
                arg1
                (fp #b0 #b11011 #b1101100111)))
; arg1 = 2304.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01000011 #b0001011100)
                expect
                (fp #b0 #b10001010 #b0010000000)))
(assert (fp.leq (fp #b0 #b10001010 #b0010000000)
                expect
                (fp #b0 #b11101011 #b1001010100)))
; expect = 2304.0

(assert (= expect result))

(check-sat)
(exit)
