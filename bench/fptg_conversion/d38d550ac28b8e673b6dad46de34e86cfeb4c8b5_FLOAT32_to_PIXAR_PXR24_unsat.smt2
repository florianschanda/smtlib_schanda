(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10000000 #b01001001101100011101000)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b11110100 #b11011100111100100110010)))
; arg1 = 838177.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b0 #b00100010 #b110000001101011)
                expect
                (fp #b0 #b10010010 #b100110010100011)))
(assert (fp.leq (fp #b0 #b10010010 #b100110010100011)
                expect
                (fp #b0 #b11110101 #b010011100101000)))
; expect = 838192.0

(assert (not (= expect result)))

(check-sat)
(exit)
