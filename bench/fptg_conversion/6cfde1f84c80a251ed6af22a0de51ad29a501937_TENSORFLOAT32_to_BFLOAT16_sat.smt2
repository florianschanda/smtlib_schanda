; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11010110 #b1000000001)
                arg1
                (fp #b0 #b10101101 #b0100000101)))
(assert (fp.leq (fp #b0 #b10101101 #b0100000101)
                arg1
                (fp #b0 #b11111110 #b1100100011)))
; arg1 = 88304527605760.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00101100 #b1010101)
                expect
                (fp #b0 #b10101101 #b0100001)))
(assert (fp.leq (fp #b0 #b10101101 #b0100001)
                expect
                (fp #b0 #b11011100 #b0100101)))
; expect = 88510686035968.0

(assert (= expect result))

(check-sat)
(exit)
