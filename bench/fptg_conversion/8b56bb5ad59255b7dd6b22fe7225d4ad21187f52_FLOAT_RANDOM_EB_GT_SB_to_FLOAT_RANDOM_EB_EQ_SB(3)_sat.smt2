; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11011001111 #b0010000)
                arg1
                (fp #b1 #b10000000110 #b0011010)))
(assert (fp.leq (fp #b1 #b10000000110 #b0011010)
                arg1
                (fp #b1 #b00000001011 #b0111111)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b110111 #b00110)
                expect
                (fp #b1 #b100110 #b00111)))
(assert (fp.leq (fp #b1 #b100110 #b00111)
                expect
                (fp #b1 #b010101 #b01000)))
; expect = -156.0

(assert (= expect result))

(check-sat)
(exit)
