; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010100000010 #b00010011000)
                arg1
                (fp #b0 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b100000001011 #b00000000000)
                arg1
                (fp #b0 #b100000010010 #b01111101011)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01101001 #b10111011111100111111010)
                expect
                (fp #b0 #b10001011 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001011 #b00000000000000000000000)
                expect
                (fp #b0 #b11000010 #b10011111100001101000111)))
; expect = 4096.0

(assert (not (= expect result)))

(check-sat)
(exit)
