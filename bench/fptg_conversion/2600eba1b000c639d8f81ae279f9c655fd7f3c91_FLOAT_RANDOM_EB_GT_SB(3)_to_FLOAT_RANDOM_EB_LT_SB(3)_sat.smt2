(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0001100110011011 #b100001)
                arg1
                (fp #b0 #b0000000000000000 #b110101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110101)
                arg1
                (fp #b0 #b1010000001101011 #b010111)))

(declare-const result (_ FloatingPoint 7 48))
(assert (= result ((_ to_fp 7 48) rm arg1)))

(declare-const expect (_ FloatingPoint 7 48))
(assert (fp.leq (fp #b1 #b0011100 #b11010111001111110011010100000011011001110110101)
                expect
                (fp #b0 #b0000000 #b00000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b0000000 #b00000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b0110011 #b01010100001001001001001111100110000011010010001)))

(assert (= expect result))

(check-sat)
(exit)
