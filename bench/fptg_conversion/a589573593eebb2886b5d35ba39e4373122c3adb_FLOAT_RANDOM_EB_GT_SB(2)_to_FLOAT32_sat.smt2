                expect
                (fp #b0 #b01011111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01011111 #b00000000000000000000000)
                expect
                (fp #b0 #b10110000 #b11011101010110111011101)))
; expect = 0.00000000023283064365386962890625

(assert (= expect result))

(check-sat)
