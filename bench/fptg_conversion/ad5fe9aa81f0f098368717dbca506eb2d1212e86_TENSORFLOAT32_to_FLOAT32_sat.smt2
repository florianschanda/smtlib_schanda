(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b0010000100)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b1 #b00000100 #b0000010110)))
; arg1 = -2048.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101011 #b01110011001101010001000)
                expect
                (fp #b1 #b10001010 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b00000000000000000000000)
                expect
                (fp #b1 #b00001001 #b01011101101001100011011)))
; expect = -2048.0

(assert (= expect result))

(check-sat)
(exit)
