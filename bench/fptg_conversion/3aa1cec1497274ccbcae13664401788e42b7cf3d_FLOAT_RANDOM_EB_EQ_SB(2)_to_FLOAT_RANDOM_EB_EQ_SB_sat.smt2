(assert (fp.leq (fp #b1 #b1001 #b000)
                expect
                (fp #b1 #b0000 #b001)))
(assert (fp.leq (fp #b1 #b0000 #b001)
                expect
                (fp #b0 #b1010 #b001)))
; expect = -0.001953125

(assert (= expect result))

