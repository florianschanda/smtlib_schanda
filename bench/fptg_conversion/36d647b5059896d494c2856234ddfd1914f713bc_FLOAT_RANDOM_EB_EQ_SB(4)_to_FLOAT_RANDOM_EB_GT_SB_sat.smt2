; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010101101111 #b00101001101)
                arg1
                (fp #b0 #b011111111111 #b01110010110)))
(assert (fp.leq (fp #b0 #b011111111111 #b01110010110)
                arg1
                (fp #b0 #b111110111111 #b10110100110)))

(declare-const result (_ FloatingPoint 7 2))
(assert (= result ((_ to_fp 7 2) rm arg1)))

(declare-const expect (_ FloatingPoint 7 2))
(assert (fp.leq (fp #b1 #b1110001 #b0)
                expect
                (fp #b0 #b0111111 #b1)))
(assert (fp.leq (fp #b0 #b0111111 #b1)
                expect
                (fp #b0 #b1101011 #b0)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
