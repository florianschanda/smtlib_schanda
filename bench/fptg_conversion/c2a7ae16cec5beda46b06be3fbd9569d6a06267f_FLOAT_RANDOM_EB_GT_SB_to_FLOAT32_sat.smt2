(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b011011110 #b01010)
                arg1
                (fp #b0 #b100000100 #b10000)))
(assert (fp.leq (fp #b0 #b100000100 #b10000)
                arg1
                (fp #b0 #b111011101 #b01111)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001101 #b00000010100000110101011)
                expect
                (fp #b0 #b10000100 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000100 #b10000000000000000000000)
                expect
                (fp #b0 #b10100001 #b01000000101100100100010)))
; expect = 48.0

(assert (= expect result))

(check-sat)
(exit)
