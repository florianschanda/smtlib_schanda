(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010001 #b1111101001011001)
                arg1
                (fp #b0 #b1001110 #b1110100110010000)))
(assert (fp.leq (fp #b0 #b1001110 #b1110100110010000)
                arg1
                (fp #b0 #b1010000 #b0110010110011001)))
; arg1 = 62664.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00001010 #b0001001)
                expect
                (fp #b0 #b10001110 #b1110101)))
(assert (fp.leq (fp #b0 #b10001110 #b1110101)
                expect
                (fp #b0 #b11010100 #b0100010)))
; expect = 62720.0

(assert (= expect result))

(check-sat)
(exit)
