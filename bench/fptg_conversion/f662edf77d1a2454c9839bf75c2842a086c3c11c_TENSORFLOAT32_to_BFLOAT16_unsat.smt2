; Format from: TENSORFLOAT32
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110011 #b1011011011)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b10011110 #b0100101110)))
; arg1 = 1.59765625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00111111 #b0101010)
                expect
                (fp #b0 #b01111111 #b1001101)))
(assert (fp.leq (fp #b0 #b01111111 #b1001101)
                expect
                (fp #b0 #b11001011 #b0100000)))
; expect = 1.6015625

(assert (not (= expect result)))

(check-sat)
(exit)
