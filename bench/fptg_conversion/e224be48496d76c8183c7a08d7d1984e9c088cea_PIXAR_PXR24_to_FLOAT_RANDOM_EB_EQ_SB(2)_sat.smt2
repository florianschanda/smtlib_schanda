(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: PIXAR_PXR24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00101101 #b110101111110010)
                arg1
                (fp #b0 #b00000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b000000000000000)
                arg1
                (fp #b0 #b00110100 #b010010110001011)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10010 #b1000)
                expect
                (fp #b0 #b00000 #b0000)))
(assert (fp.leq (fp #b0 #b00000 #b0000)
                expect
                (fp #b0 #b01101 #b0110)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
