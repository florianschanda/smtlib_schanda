(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11011011 #b11001100111000000010110)
                arg1
                (fp #b1 #b10010011 #b01111001100110011100000)))
(assert (fp.leq (fp #b1 #b10010011 #b01111001100110011100000)
                arg1
                (fp #b1 #b01000011 #b01000010011001101001111)))
; arg1 = -1546652.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000100010 #b000100101)
                expect
                (fp #b1 #b1000010011 #b011110100)))
(assert (fp.leq (fp #b1 #b1000010011 #b011110100)
                expect
                (fp #b0 #b1101101111 #b000101110)))

(assert (= expect result))

(check-sat)
(exit)
