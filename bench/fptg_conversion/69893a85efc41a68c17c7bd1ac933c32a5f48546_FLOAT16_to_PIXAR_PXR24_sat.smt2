; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111100010)
                arg1
                (fp #b1 #b11101 #b1000101101)))
(assert (fp.leq (fp #b1 #b11101 #b1000101101)
                arg1
                (fp #b1 #b01011 #b1100001001)))
; arg1 = -25296.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11101000 #b000011011101110)
                expect
                (fp #b1 #b10001101 #b100010110100000)))
(assert (fp.leq (fp #b1 #b10001101 #b100010110100000)
                expect
                (fp #b1 #b00110001 #b000100010010100)))
; expect = -25296.0

(assert (= expect result))

(check-sat)
(exit)
