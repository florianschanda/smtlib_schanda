(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b1100001100)
                arg1
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                arg1
                (fp #b0 #b00100 #b1111011000)))
; arg1 = -0.000000059604644775390625

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11100010 #b0101010)
                expect
                (fp #b1 #b01100111 #b0000000)))
(assert (fp.leq (fp #b1 #b01100111 #b0000000)
                expect
                (fp #b1 #b00101011 #b1010101)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
