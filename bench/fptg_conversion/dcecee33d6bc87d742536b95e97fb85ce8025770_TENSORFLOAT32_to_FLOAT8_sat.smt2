; Format from: TENSORFLOAT32
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11110000 #b1110000001)
                arg1
                (fp #b1 #b00000000 #b0001101111)))
(assert (fp.leq (fp #b1 #b00000000 #b0001101111)
                arg1
                (fp #b0 #b00101000 #b0001010100)))
; arg1 = -0.0000000000000000000000000000000000000012742175091921280603957983948405202171667175468916183094479632753603937089792452752590179443359375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1100)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b001 #b0111)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
