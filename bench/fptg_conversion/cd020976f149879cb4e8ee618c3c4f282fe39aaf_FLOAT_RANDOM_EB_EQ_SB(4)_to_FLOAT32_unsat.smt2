; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b01011110100101011 #b0011000100000000)
                arg1
                (fp #b1 #b00000000000000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1111111111111111)
                arg1
