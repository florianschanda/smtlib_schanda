(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011011 #b1011001101100011)
                arg1
                (fp #b0 #b0111111 #b1000110101010111)))
(assert (fp.leq (fp #b0 #b0111111 #b1000110101010111)
                arg1
                (fp #b0 #b1101111 #b1001100101001000)))
; arg1 = 1.5521087646484375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011010 #b1100100)
                expect
                (fp #b0 #b01111111 #b1000111)))
(assert (fp.leq (fp #b0 #b01111111 #b1000111)
                expect
                (fp #b0 #b11100010 #b1010000)))
; expect = 1.5546875

(assert (= expect result))

(check-sat)
(exit)
