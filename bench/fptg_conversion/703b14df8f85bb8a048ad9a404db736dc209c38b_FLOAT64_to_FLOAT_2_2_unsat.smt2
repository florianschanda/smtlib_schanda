(assert (fp.leq (fp #b1 #b00101110100 #b1010001000000101100110010010111101101011101100111111)
                arg1
                (fp #b0 #b01111111111 #b0100010000101010010100110110010000011010000110110111)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100010000101010010100110110010000011010000110110111)
                arg1
                (fp #b0 #b11111110000 #b1001011010101110111111111101111001111110110100001101)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b0 #b01 #b1)))
(assert (fp.leq (fp #b0 #b01 #b1)
                expect
                (fp #b0 #b11 #b0)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
