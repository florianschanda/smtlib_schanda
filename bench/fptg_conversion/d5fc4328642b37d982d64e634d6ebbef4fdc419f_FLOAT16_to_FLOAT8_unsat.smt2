(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT8
; Arg1: -RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b0101000011)
                arg1
                (fp #b1 #b00000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000 #b0100000000)
                arg1
                (fp #b0 #b10001 #b1110111101)))
; arg1 = -0.0000152587890625

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0011)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b001 #b1100)))
; expect = -0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
