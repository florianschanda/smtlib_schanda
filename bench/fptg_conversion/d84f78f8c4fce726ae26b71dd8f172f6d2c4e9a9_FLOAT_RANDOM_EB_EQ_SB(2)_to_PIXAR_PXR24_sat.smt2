; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b0000)
                arg1
                (fp #b1 #b10010 #b0011)))
(assert (fp.leq (fp #b1 #b10010 #b0011)
                arg1
                (fp #b1 #b10000 #b1100)))
; arg1 = -9.5

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011111 #b011100100000000)
                expect
                (fp #b1 #b10000010 #b001100000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b001100000000000)
                expect
                (fp #b0 #b11000010 #b101010000011000)))
; expect = -9.5

(assert (= expect result))

(check-sat)
(exit)
