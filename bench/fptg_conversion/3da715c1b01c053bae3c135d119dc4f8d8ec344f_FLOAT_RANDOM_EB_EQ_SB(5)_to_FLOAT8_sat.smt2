; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0000110111111 #b101010110011)
                arg1
                (fp #b0 #b0000000000000 #b101000101111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b101000101111)
                arg1
                (fp #b0 #b1010100011101 #b000111101010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0000)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b010 #b0010)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
