                expect
                (fp #b0 #b10000001 #b1100000000)))
(assert (fp.leq (fp #b0 #b10000001 #b1100000000)
                expect
                (fp #b0 #b10100000 #b1111100011)))
; expect = 7.0

(assert (not (= expect result)))

