; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0100)
                arg1
                (fp #b1 #b011 #b1101)))
(assert (fp.leq (fp #b1 #b011 #b1101)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -1.8125

(declare-const result (_ FloatingPoint 18 4))
(assert (= result ((_ to_fp 18 4) rm arg1)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b110100110011000101 #b011)
                expect
                (fp #b1 #b011111111111111111 #b111)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b111)
                expect
                (fp #b1 #b000011000110000011 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
