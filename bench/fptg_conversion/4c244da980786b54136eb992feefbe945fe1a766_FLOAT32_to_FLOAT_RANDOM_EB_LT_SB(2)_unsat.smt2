; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110111 #b10111010010010111010110)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11100000 #b11111010011110101011101)))
; arg1 = 55651713024.0

(declare-const result (_ FloatingPoint 2 31))
(assert (= result ((_ to_fp 2 31) rm arg1)))

(declare-const expect (_ FloatingPoint 2 31))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
