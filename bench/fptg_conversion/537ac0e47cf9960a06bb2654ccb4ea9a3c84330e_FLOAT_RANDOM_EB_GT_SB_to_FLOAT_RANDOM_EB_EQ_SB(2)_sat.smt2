                expect
                (fp #b1 #b011111111111111 #b11000000000000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11000000000000)
                expect
                (fp #b0 #b101110010101000 #b00100011000000)))

(assert (= expect result))

