; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b1)
                arg1
                (fp #b1 #b110 #b0)))
(assert (fp.leq (fp #b1 #b110 #b0)
                arg1
                (fp #b1 #b010 #b1)))
; arg1 = -8.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b0010001101111111)
                expect
                (fp #b1 #b1000010 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b1000010 #b0000000000000000)
                expect
                (fp #b0 #b1111010 #b1000110010011011)))
; expect = -8.0

(assert (not (= expect result)))

(check-sat)
(exit)
