                expect
                (fp #b1 #b10001010 #b10110011110000000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b10110011110000000000000)
                expect
                (fp #b0 #b11111011 #b00101111100011111010101)))
; expect = -3486.0

(assert (not (= expect result)))

