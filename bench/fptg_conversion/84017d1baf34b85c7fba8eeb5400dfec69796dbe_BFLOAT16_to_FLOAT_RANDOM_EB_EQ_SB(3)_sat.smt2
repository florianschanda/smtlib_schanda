; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000001 #b1001101)
                arg1
                (fp #b0 #b10000110 #b0101000)))
(assert (fp.leq (fp #b0 #b10000110 #b0101000)
                arg1
                (fp #b0 #b11010010 #b0101001)))
; arg1 = 168.0

(declare-const result (_ FloatingPoint 5 5))
