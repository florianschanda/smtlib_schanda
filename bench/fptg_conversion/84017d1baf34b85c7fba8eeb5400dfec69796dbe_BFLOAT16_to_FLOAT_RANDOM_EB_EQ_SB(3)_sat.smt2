(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00001 #b1101)
                expect
                (fp #b0 #b10110 #b0101)))
(assert (fp.leq (fp #b0 #b10110 #b0101)
                expect
                (fp #b0 #b11000 #b1100)))
; expect = 168.0

(assert (= expect result))

(check-sat)
(exit)
