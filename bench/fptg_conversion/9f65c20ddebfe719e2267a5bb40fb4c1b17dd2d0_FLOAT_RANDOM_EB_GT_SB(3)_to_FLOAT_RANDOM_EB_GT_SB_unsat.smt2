(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100000100 #b01000)
                arg1
                (fp #b1 #b000000000 #b00101)))
(assert (fp.leq (fp #b1 #b000000000 #b00101)
                arg1
                (fp #b0 #b001101100 #b01011)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result ((_ to_fp 12 2) rm arg1)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b011101010001 #b1)
                expect
                (fp #b1 #b011011111110 #b1)))
(assert (fp.leq (fp #b1 #b011011111110 #b1)
                expect
                (fp #b1 #b010111110111 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
