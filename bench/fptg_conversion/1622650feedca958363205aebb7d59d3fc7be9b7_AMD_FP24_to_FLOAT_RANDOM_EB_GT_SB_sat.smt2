(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b1001111010011011)
                arg1
                (fp #b1 #b1011110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b1011110 #b1111111111111111)
                arg1
                (fp #b1 #b0110101 #b1100101100100110)))
; arg1 = -4294934528.0

(declare-const result (_ FloatingPoint 11 5))
(assert (= result ((_ to_fp 11 5) rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11010111110 #b0101)
                expect
                (fp #b1 #b10000011111 #b0000)))
(assert (fp.leq (fp #b1 #b10000011111 #b0000)
                expect
                (fp #b1 #b01100111100 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
