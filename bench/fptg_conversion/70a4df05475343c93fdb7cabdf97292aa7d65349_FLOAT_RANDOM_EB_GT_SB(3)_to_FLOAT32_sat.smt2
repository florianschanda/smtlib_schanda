(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1110101 #b10111)
                arg1
                (fp #b1 #b0111111 #b10110)))
(assert (fp.leq (fp #b1 #b0111111 #b10110)
                arg1
                (fp #b0 #b0001100 #b10010)))
; arg1 = -1.6875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001010 #b10001001101110011000001)
                expect
                (fp #b1 #b01111111 #b10110000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b10110000000000000000000)
                expect
                (fp #b0 #b01101001 #b00010101100110110110101)))
; expect = -1.6875

(assert (= expect result))

(check-sat)
(exit)
