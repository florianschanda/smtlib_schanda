; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg1
                (fp #b0 #b011 #b01)))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 1.25

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100001100 #b100000000)
                expect
                (fp #b0 #b0111111111 #b010000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b010000000)
                expect
                (fp #b0 #b1011101011 #b100101000)))

(assert (= expect result))

(check-sat)
(exit)
