; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1111101100)
                arg1
                (fp #b1 #b11000 #b1100000110)))
(assert (fp.leq (fp #b1 #b11000 #b1100000110)
                arg1
                (fp #b0 #b10000 #b0000010110)))
; arg1 = -899.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100010 #b010100100100001)
                expect
                (fp #b1 #b10001000 #b110000011000000)))
(assert (fp.leq (fp #b1 #b10001000 #b110000011000000)
                expect
                (fp #b0 #b00100100 #b100011110110000)))
; expect = -899.0

(assert (not (= expect result)))

(check-sat)
(exit)
