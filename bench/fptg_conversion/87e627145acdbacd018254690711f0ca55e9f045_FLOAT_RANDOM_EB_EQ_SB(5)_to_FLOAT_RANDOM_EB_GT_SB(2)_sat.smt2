; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110100 #b00001011)
                arg1
                (fp #b0 #b011111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111 #b11001001)
                arg1
                (fp #b0 #b101001111 #b10111111)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result ((_ to_fp 10 6) rm arg1)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001101100 #b11100)
                expect
                (fp #b0 #b0111111111 #b11010)))
(assert (fp.leq (fp #b0 #b0111111111 #b11010)
                expect
                (fp #b0 #b1001101101 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
