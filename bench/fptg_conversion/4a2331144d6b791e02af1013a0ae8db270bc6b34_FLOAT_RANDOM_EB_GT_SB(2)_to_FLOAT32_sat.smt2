(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0011 #b11)
                arg1
                (fp #b0 #b1011 #b00)))
(assert (fp.leq (fp #b0 #b1011 #b00)
                arg1
                (fp #b0 #b1011 #b10)))
; arg1 = 16.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00110110 #b11101000000000101010001)
                expect
                (fp #b0 #b10000011 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000011 #b00000000000000000000000)
                expect
                (fp #b0 #b11010001 #b10000001101000010101100)))
; expect = 16.0

(assert (= expect result))

(check-sat)
(exit)
