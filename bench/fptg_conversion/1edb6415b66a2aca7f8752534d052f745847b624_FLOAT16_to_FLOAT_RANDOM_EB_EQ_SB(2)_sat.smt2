(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b1110111111)
                arg1
                (fp #b1 #b11010 #b0000000000)))
(assert (fp.leq (fp #b1 #b11010 #b0000000000)
                arg1
                (fp #b1 #b00000 #b0101101101)))
; arg1 = -2048.0

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b101111 #b10000)
                expect
                (fp #b1 #b101010 #b00000)))
(assert (fp.leq (fp #b1 #b101010 #b00000)
                expect
                (fp #b1 #b011010 #b01101)))
; expect = -2048.0

(assert (= expect result))

(check-sat)
(exit)
