(assert (fp.leq (fp #b1 #b11111100101 #b0000000010001100001100000110011100111100111100010101)
                expect
                (fp #b1 #b10000000010 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000010 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10001101110 #b1100111111001001000101111110000110100100101111001110)))

(assert (= expect result))

