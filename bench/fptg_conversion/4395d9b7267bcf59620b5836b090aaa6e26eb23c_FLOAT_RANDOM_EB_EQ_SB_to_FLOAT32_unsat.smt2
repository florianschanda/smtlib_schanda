(assert (fp.leq (fp #b1 #b11100010 #b00010111011100100010011)
                expect
                (fp #b1 #b10000010 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b11000000000000000000000)
                expect
                (fp #b1 #b01010111 #b10010110100010100110100)))
; expect = -14.0

(assert (not (= expect result)))

(check-sat)
