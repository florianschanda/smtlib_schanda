                expect
                (fp #b0 #b10000010 #b1000000)))
(assert (fp.leq (fp #b0 #b10000010 #b1000000)
                expect
                (fp #b0 #b11100100 #b1111101)))
; expect = 12.0

(assert (not (= expect result)))

