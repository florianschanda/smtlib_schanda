; Format from: FLOAT32
; Format to: FLOAT64
; Arg1: -ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101100 #b11011110101010011110010)
                arg1
                (fp #b1 #b01111111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00000000000000000000000)
                arg1
                (fp #b1 #b01111100 #b11100010001011001101111)))
; arg1 = -1.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001101010 #b1010111100000000110011100011111000001011110000111011)
                expect
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10111100000 #b1000011101010111001010010100011001101010001100101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
