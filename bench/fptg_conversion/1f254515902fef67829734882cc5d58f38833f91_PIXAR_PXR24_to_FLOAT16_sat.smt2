                expect
                (fp #b1 #b01111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111 #b0000000000)
                expect
                (fp #b0 #b01111 #b1111000011)))
; expect = -1.0

(assert (= expect result))

