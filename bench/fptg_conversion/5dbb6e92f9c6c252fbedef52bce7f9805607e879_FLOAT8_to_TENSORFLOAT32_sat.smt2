(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b101 #b0001)))
(assert (fp.leq (fp #b1 #b101 #b0001)
                arg1
                (fp #b1 #b011 #b0000)))
; arg1 = -4.25

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10110111 #b1011010100)
                expect
                (fp #b1 #b10000001 #b0001000000)))
(assert (fp.leq (fp #b1 #b10000001 #b0001000000)
                expect
                (fp #b0 #b01001110 #b1001001010)))
; expect = -4.25

(assert (= expect result))

(check-sat)
(exit)
