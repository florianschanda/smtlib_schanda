(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b0 #b00000 #b001)
                arg1
                (fp #b0 #b10010 #b111)))
(assert (fp.leq (fp #b0 #b10010 #b111)
                arg1
                (fp #b0 #b11000 #b011)))
; arg1 = 15.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101001 #b01110100001100100000011)
                expect
                (fp #b0 #b10000010 #b11100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b11100000000000000000000)
                expect
                (fp #b0 #b10111000 #b10001111010011111000010)))
; expect = 15.0

(assert (not (= expect result)))

(check-sat)
(exit)
