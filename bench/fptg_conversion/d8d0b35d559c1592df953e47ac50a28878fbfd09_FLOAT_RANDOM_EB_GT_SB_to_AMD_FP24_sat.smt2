; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110110111010111 #b000000110)
                arg1
                (fp #b0 #b0111111111111111 #b110010111)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b110010111)
                arg1
                (fp #b0 #b1001111001001000 #b000111011)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101101 #b1011100100010011)
                expect
                (fp #b0 #b0111111 #b1100101110000000)))
(assert (fp.leq (fp #b0 #b0111111 #b1100101110000000)
                expect
                (fp #b0 #b1001100 #b1011011010110110)))
; expect = 1.794921875

(assert (= expect result))

(check-sat)
(exit)
