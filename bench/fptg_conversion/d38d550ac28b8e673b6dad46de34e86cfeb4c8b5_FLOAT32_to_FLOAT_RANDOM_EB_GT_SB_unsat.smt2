; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b0 #b10000000 #b01001001101100011101000)
                arg1
                (fp #b0 #b10010010 #b10011001010001000010000)))
(assert (fp.leq (fp #b0 #b10010010 #b10011001010001000010000)
                arg1
                (fp #b0 #b11110100 #b11011100111100100110010)))
; arg1 = 838177.0

(declare-const result (_ FloatingPoint 15 10))
(assert (= result ((_ to_fp 15 10) rm arg1)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b000011110001001 #b011100100)
                expect
                (fp #b0 #b100000000010010 #b100110011)))
(assert (fp.leq (fp #b0 #b100000000010010 #b100110011)
                expect
                (fp #b0 #b111000111111111 #b001101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
