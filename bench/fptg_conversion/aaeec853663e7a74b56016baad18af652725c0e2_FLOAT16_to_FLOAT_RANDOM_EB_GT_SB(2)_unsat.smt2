; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1101010001)
                arg1
                (fp #b1 #b10110 #b1000001110)))
(assert (fp.leq (fp #b1 #b10110 #b1000001110)
                arg1
                (fp #b0 #b01101 #b1111101100)))
; arg1 = -193.75

(declare-const result (_ FloatingPoint 6 5))
(assert (= result ((_ to_fp 6 5) rm arg1)))

(declare-const expect (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b101101 #b0000)
                expect
                (fp #b1 #b100110 #b1001)))
(assert (fp.leq (fp #b1 #b100110 #b1001)
                expect
                (fp #b1 #b001111 #b0100)))
; expect = -200.0

(assert (not (= expect result)))

(check-sat)
(exit)
