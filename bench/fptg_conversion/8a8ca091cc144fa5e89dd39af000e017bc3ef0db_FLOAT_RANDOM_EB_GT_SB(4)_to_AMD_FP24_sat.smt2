; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000110111 #b11101)
                arg1
                (fp #b1 #b1000000011 #b10110)))
(assert (fp.leq (fp #b1 #b1000000011 #b10110)
                arg1
                (fp #b1 #b0101000000 #b10111)))

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110011 #b1001110000011111)
                expect
                (fp #b1 #b1000011 #b1011000000000000)))
(assert (fp.leq (fp #b1 #b1000011 #b1011000000000000)
                expect
                (fp #b1 #b0110111 #b1110000001100001)))
; expect = -27.0

(assert (= expect result))

(check-sat)
(exit)
