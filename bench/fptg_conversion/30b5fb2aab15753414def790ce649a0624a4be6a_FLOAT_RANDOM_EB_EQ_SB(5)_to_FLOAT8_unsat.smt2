(assert (fp.leq (fp #b1 #b100 #b1110)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b101 #b0010)))
; expect = 0.015625

(assert (not (= expect result)))

