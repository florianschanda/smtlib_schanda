; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 3))
(assert (fp.leq (fp #b1 #b11110 #b00)
                arg1
                (fp #b0 #b00000 #b10)))
(assert (fp.leq (fp #b0 #b00000 #b10)
                arg1
                (fp #b0 #b10111 #b10)))
; arg1 = 0.000030517578125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010110 #b00011101000001001101011)
                expect
                (fp #b0 #b01110000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01110000 #b00000000000000000000000)
                expect
                (fp #b0 #b10110100 #b10100111110111010010010)))
; expect = 0.000030517578125

(assert (= expect result))

(check-sat)
(exit)
