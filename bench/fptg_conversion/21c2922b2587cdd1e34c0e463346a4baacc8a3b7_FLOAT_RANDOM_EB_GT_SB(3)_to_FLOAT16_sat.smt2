(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011110001 #b1)
                arg1
                (fp #b0 #b0000000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000000 #b0)
                arg1
                (fp #b0 #b1100011111 #b1)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00100 #b0111000110)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b11101 #b0101001001)))
; expect = 0.0

(assert (= expect result))

(check-sat)
(exit)
