(assert (fp.leq (fp #b1 #b10100101101 #b0010000110100101010011100010101000101011000111101110)
                expect
                (fp #b1 #b10000000100 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000100 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b00001011000 #b0111100111010110111110101101011111110010100101100101)))

(assert (= expect result))

(check-sat)
