; Format from: FLOAT_2_2
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01 #b1)
                arg1
                (fp #b0 #b00 #b0)))
(assert (fp.leq (fp #b0 #b00 #b0)
                arg1
                (fp #b0 #b01 #b1)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1011000100 #b110001000)
                expect
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                expect
                (fp #b0 #b1011000010 #b101011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
