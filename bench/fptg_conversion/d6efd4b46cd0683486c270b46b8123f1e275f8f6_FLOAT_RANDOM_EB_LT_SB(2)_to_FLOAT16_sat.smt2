; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 37))
(assert (fp.leq (fp #b1 #b001 #b000101110100000101001100110110110000)
                arg1
                (fp #b1 #b000 #b000101100010101000010010110010001101)))
(assert (fp.leq (fp #b1 #b000 #b000101100010101000010010110010001101)
                arg1
                (fp #b0 #b010 #b110110110001001101111111111111000001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01101 #b0010100001)
                expect
                (fp #b1 #b01001 #b0110001011)))
(assert (fp.leq (fp #b1 #b01001 #b0110001011)
                expect
                (fp #b0 #b11110 #b1100000111)))
; expect = -0.0216522216796875

(assert (= expect result))

(check-sat)
(exit)
