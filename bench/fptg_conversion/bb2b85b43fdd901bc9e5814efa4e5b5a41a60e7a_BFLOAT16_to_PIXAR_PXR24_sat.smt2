; arg1 = -1.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10111100 #b100000010101110)
                expect
                (fp #b1 #b01111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b000000000000000)
                expect
                (fp #b0 #b11100011 #b100000111010111)))
; expect = -1.0

(assert (= expect result))

(check-sat)
(exit)
