; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: +SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000001111)
                arg1
                (fp #b0 #b10110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10110 #b1111111111)
                arg1
                (fp #b0 #b11100 #b1000001010)))
; arg1 = 255.875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00011001 #b11010001111010111010000)
                expect
                (fp #b0 #b10000110 #b11111111110000000000000)))
(assert (fp.leq (fp #b0 #b10000110 #b11111111110000000000000)
                expect
                (fp #b0 #b10011110 #b01100001010101110110000)))
; expect = 255.875

(assert (not (= expect result)))

(check-sat)
(exit)
