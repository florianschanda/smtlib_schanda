(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b001100111110111100 #b1010)
                arg1
                (fp #b0 #b000000000000000000 #b1100)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b1100)
                arg1
                (fp #b0 #b100011100101111001 #b0011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result ((_ to_fp 16 16) rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100000000001101 #b001010101011101)
                expect
                (fp #b0 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000001)
                expect
                (fp #b0 #b0011000101000110 #b111110011011000)))

(assert (= expect result))

(check-sat)
(exit)
