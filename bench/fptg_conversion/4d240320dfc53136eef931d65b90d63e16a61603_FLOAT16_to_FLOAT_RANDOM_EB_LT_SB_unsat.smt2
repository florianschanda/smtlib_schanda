(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0101101011)
                arg1
                (fp #b1 #b11010 #b1011001111)))
(assert (fp.leq (fp #b1 #b11010 #b1011001111)
                arg1
                (fp #b0 #b01111 #b1011000101)))
; arg1 = -3486.0

(declare-const result (_ FloatingPoint 3 89))
(assert (= result ((_ to_fp 3 89) rm arg1)))

(declare-const expect (_ FloatingPoint 3 89))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
