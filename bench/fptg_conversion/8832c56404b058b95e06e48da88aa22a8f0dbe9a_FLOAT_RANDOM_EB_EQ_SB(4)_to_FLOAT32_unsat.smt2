(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b101 #b10)))
(assert (fp.leq (fp #b1 #b101 #b10)
                arg1
                (fp #b0 #b100 #b10)))
; arg1 = -6.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10001011 #b01000111010011101011001)
                expect
                (fp #b1 #b10000001 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001 #b10000000000000000000000)
                expect
                (fp #b0 #b01000011 #b00000010110100100001101)))
; expect = -6.0

(assert (not (= expect result)))

(check-sat)
(exit)
