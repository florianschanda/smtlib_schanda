(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110001 #b1001011000001001)
                arg1
                (fp #b1 #b1010001 #b0101010110111110)))
(assert (fp.leq (fp #b1 #b1010001 #b0101010110111110)
                arg1
                (fp #b1 #b0011001 #b1110001101011001)))
; arg1 = -349944.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001110010 #b101100101)
                expect
                (fp #b1 #b1000010001 #b010101100)))
(assert (fp.leq (fp #b1 #b1000010001 #b010101100)
                expect
                (fp #b0 #b0101111000 #b101101000)))

(assert (= expect result))

(check-sat)
(exit)
