(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0101)
                arg1
                (fp #b0 #b000 #b0100)))
(assert (fp.leq (fp #b0 #b000 #b0100)
                arg1
                (fp #b0 #b101 #b1100)))
; arg1 = 0.0625

(declare-const result (_ FloatingPoint 6 3))
(assert (= result ((_ to_fp 6 3) rm arg1)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b111100 #b11)
                expect
                (fp #b0 #b011011 #b00)))
(assert (fp.leq (fp #b0 #b011011 #b00)
                expect
                (fp #b0 #b101000 #b00)))
; expect = 0.0625

(assert (= expect result))

(check-sat)
(exit)
