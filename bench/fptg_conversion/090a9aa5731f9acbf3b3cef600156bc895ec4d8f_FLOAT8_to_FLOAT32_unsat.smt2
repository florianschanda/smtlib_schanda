(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b001 #b0000)))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b001 #b1000)))
; arg1 = -0.25

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100110 #b01111111101001000110010)
                expect
                (fp #b1 #b01111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111101 #b00000000000000000000000)
                expect
                (fp #b0 #b01101011 #b11111001010000100011101)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
