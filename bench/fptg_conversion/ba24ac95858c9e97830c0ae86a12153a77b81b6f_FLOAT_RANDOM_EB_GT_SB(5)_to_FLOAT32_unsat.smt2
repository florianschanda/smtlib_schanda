(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b1 #b010 #b0)))
(assert (fp.leq (fp #b1 #b010 #b0)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = -0.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11000100 #b10011010000100000110100)
                expect
                (fp #b1 #b01111110 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111110 #b00000000000000000000000)
                expect
                (fp #b0 #b10001001 #b00010110110101010111110)))
; expect = -0.5

(assert (not (= expect result)))

(check-sat)
(exit)
