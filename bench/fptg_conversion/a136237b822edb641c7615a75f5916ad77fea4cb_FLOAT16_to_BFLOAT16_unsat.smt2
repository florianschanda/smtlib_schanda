; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b0000000010)
                arg1
                (fp #b1 #b10111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10111 #b0000100000)
                arg1
                (fp #b0 #b01110 #b0100111000)))
; arg1 = -264.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10101010 #b1101011)
                expect
                (fp #b1 #b10000111 #b0000100)))
(assert (fp.leq (fp #b1 #b10000111 #b0000100)
                expect
                (fp #b0 #b10100100 #b0011110)))
; expect = -264.0

(assert (not (= expect result)))

(check-sat)
(exit)
