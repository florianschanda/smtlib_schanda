; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b0 #b001011 #b01001)
                arg1
                (fp #b0 #b100001 #b00000)))
(assert (fp.leq (fp #b0 #b100001 #b00000)
                arg1
                (fp #b0 #b111010 #b11010)))
; arg1 = 4.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00101100 #b1101010)
                expect
                (fp #b0 #b10000001 #b0000000)))
(assert (fp.leq (fp #b0 #b10000001 #b0000000)
                expect
                (fp #b0 #b10001010 #b1101001)))
; expect = 4.0

(assert (not (= expect result)))

(check-sat)
(exit)
