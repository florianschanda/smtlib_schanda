(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT8
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1111)
                arg1
                (fp #b1 #b110 #b0010)))
(assert (fp.leq (fp #b1 #b110 #b0010)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -9.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1110)
                expect
                (fp #b1 #b110 #b0010)))
(assert (fp.leq (fp #b1 #b110 #b0010)
                expect
                (fp #b1 #b000 #b0101)))
; expect = -9.0

(assert (= expect result))

(check-sat)
(exit)
