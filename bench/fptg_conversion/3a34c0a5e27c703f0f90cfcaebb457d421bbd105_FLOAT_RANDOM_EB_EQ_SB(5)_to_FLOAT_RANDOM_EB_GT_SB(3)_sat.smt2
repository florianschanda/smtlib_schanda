; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01001 #b1101)
                arg1
                (fp #b0 #b01111 #b0000)))
(assert (fp.leq (fp #b0 #b01111 #b0000)
                arg1
                (fp #b0 #b11011 #b1101)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 10 5))
(assert (= result ((_ to_fp 10 5) rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101101000 #b1010)
                expect
                (fp #b0 #b0111111111 #b0000)))
(assert (fp.leq (fp #b0 #b0111111111 #b0000)
                expect
                (fp #b0 #b1010110111 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
