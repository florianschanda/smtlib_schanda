; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT16
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 6 64))
(assert (fp.leq (fp #b1 #b010010 #b100110001100001001000101011110111000010010010100010110111000110)
                arg1
                (fp #b1 #b000000 #b111111111111111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b000000 #b111111111111111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b100000 #b010011011010000111111110001010001001000001110001101110010110010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b1011111000)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b01001 #b0001001101)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
