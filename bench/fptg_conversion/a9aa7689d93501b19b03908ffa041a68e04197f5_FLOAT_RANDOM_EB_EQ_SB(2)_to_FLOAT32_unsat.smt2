; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111101 #b10011000)
                arg1
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg1
                (fp #b0 #b100111100 #b10000000)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b01001101 #b01001101100000110110001)
                expect
                (fp #b0 #b10001000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10001000 #b00000000000000000000000)
                expect
                (fp #b0 #b10010111 #b00111100111111101100001)))
; expect = 512.0

(assert (not (= expect result)))

(check-sat)
(exit)
