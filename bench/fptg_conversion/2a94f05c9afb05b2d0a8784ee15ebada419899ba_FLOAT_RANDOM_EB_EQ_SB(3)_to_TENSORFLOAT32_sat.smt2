(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10111110 #b1101100100)
                expect
                (fp #b0 #b01111111 #b1010000000)))
(assert (fp.leq (fp #b0 #b01111111 #b1010000000)
                expect
                (fp #b0 #b10010101 #b0110000000)))
; expect = 1.625

(assert (= expect result))

(check-sat)
