(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b010111 #b10101)
                arg1
                (fp #b0 #b011111 #b10100)))
(assert (fp.leq (fp #b0 #b011111 #b10100)
                arg1
