(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0101001101001 #b100111001011)
                arg1
                (fp #b1 #b0000000000000 #b001011011101)))
(assert (fp.leq (fp #b1 #b0000000000000 #b001011011101)
                arg1
