(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg1 = 11601303.0

(declare-const result (_ FloatingPoint 18 8))
(assert (= result ((_ to_fp 18 8) rm arg1)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b101100100111011101 #b0100101)
                expect
                (fp #b0 #b100000000000010110 #b0110010)))
(assert (fp.leq (fp #b0 #b100000000000010110 #b0110010)
                expect
                (fp #b0 #b101010111100100100 #b1001111)))

(assert (= expect result))

(check-sat)
(exit)
