; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b0 #b00000 #b0011)
                arg1
                (fp #b0 #b01111 #b0111)))
(assert (fp.leq (fp #b0 #b01111 #b0111)
                arg1
                (fp #b0 #b11100 #b1110)))
; arg1 = 1.4375

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b00010 #b0000110001)
                expect
                (fp #b0 #b01111 #b0111000000)))
(assert (fp.leq (fp #b0 #b01111 #b0111000000)
                expect
                (fp #b0 #b10000 #b0110010111)))
; expect = 1.4375

(assert (= expect result))

(check-sat)
(exit)
