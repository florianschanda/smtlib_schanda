; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0110011011)
                arg1
                (fp #b1 #b11001 #b0110110001)))
(assert (fp.leq (fp #b1 #b11001 #b0110110001)
                arg1
                (fp #b0 #b11010 #b0100111011)))
; arg1 = -1457.0

(declare-const result (_ FloatingPoint 16 11))
(assert (= result ((_ to_fp 16 11) rm arg1)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1100110001011001 #b1110001101)
                expect
                (fp #b1 #b1000000000001001 #b0110110001)))
(assert (fp.leq (fp #b1 #b1000000000001001 #b0110110001)
                expect
                (fp #b0 #b0100111100011111 #b1110011101)))

(assert (= expect result))

(check-sat)
(exit)
