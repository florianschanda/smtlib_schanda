; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11101 #b1101000011)
                arg1
                (fp #b1 #b11011 #b0110100001)))
(assert (fp.leq (fp #b1 #b11011 #b0110100001)
                arg1
                (fp #b0 #b00100 #b1111000100)))
; arg1 = -5764.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110100010 #b00001000010)
                expect
                (fp #b1 #b100000001011 #b01101000010)))
(assert (fp.leq (fp #b1 #b100000001011 #b01101000010)
                expect
                (fp #b0 #b011000011111 #b01100110101)))

(assert (= expect result))

(check-sat)
(exit)
