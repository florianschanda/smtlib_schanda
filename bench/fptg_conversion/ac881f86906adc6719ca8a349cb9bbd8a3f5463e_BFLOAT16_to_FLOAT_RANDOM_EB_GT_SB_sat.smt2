; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11001000 #b1011100)
                arg1
                (fp #b1 #b00000000 #b1001010)))
(assert (fp.leq (fp #b1 #b00000000 #b1001010)
                arg1
                (fp #b0 #b11011000 #b1010010)))
; arg1 = -0.000000000000000000000000000000000000006795826715691349655444258105816107824889160250088630983722470801922099781222641468048095703125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b0110 #b0)
                expect
                (fp #b1 #b0000 #b1)))
(assert (fp.leq (fp #b1 #b0000 #b1)
                expect
                (fp #b1 #b0000 #b0)))
; expect = -0.0078125

(assert (= expect result))

(check-sat)
(exit)
