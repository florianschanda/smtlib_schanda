(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0110100001)
                arg1
                (fp #b1 #b01111 #b0010001010)))
(assert (fp.leq (fp #b1 #b01111 #b0010001010)
                arg1
                (fp #b0 #b01000 #b0111111001)))
; arg1 = -1.134765625

(declare-const result (_ FloatingPoint 13 7))
(assert (= result ((_ to_fp 13 7) rm arg1)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1000001100110 #b101011)
                expect
                (fp #b1 #b0111111111111 #b001001)))
(assert (fp.leq (fp #b1 #b0111111111111 #b001001)
                expect
                (fp #b0 #b1000100100100 #b100110)))

(assert (= expect result))

(check-sat)
(exit)
