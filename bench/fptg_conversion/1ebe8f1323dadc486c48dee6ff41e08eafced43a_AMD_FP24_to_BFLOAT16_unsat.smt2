(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110110 #b1001111)
                expect
                (fp #b0 #b10101001 #b0010010)))
(assert (fp.leq (fp #b0 #b10101001 #b0010010)
                expect
                (fp #b0 #b10111001 #b0100111)))
; expect = 5016521801728.0

(assert (not (= expect result)))

(check-sat)
(exit)
