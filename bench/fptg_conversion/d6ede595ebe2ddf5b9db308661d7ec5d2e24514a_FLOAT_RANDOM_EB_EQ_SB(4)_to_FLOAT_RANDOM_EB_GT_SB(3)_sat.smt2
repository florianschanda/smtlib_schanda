; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111111 #b00011110)
                arg1
                (fp #b1 #b000000000 #b00011110)))
(assert (fp.leq (fp #b1 #b000000000 #b00011110)
                arg1
                (fp #b0 #b000110010 #b11010011)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result ((_ to_fp 14 9) rm arg1)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10100100000000 #b11110001)
                expect
                (fp #b1 #b01111011111101 #b11100000)))
(assert (fp.leq (fp #b1 #b01111011111101 #b11100000)
                expect
                (fp #b0 #b10101001110110 #b00011001)))

(assert (= expect result))

(check-sat)
(exit)
