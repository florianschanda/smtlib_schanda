; Format from: AMD_FP24
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111100 #b1100110010010001)
                arg1
                (fp #b1 #b1111011 #b0001001011100110)))
(assert (fp.leq (fp #b1 #b1111011 #b0001001011100110)
                arg1
                (fp #b1 #b0010110 #b1000101110110101)))
; arg1 = -1238032500689731584.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11100010 #b0111101001)
                expect
                (fp #b1 #b10111011 #b0001001100)))
(assert (fp.leq (fp #b1 #b10111011 #b0001001100)
                expect
                (fp #b0 #b10010110 #b0001111001)))
; expect = -1238489897526886400.0

(assert (= expect result))

(check-sat)
(exit)
