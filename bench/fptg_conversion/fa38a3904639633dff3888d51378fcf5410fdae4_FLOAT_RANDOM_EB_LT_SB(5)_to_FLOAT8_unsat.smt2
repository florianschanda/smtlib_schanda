; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT8
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 36))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001111 #b00100100000010101001101001011011101)
                arg1
                (fp #b0 #b000000 #b00000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000000 #b00000000000000000000000000000000000)
                arg1
                (fp #b0 #b100100 #b11100001110011010100101101100010000)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000 #b0110)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b101 #b1000)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
