; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b1 #b1101 #b10)
                arg1
                (fp #b0 #b1010 #b10)))
(assert (fp.leq (fp #b0 #b1010 #b10)
                arg1
                (fp #b0 #b1101 #b10)))
; arg1 = 12.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01011 #b0010100000)
                expect
                (fp #b0 #b10010 #b1000000000)))
(assert (fp.leq (fp #b0 #b10010 #b1000000000)
                expect
                (fp #b0 #b11100 #b0101011011)))
; expect = 12.0

(assert (not (= expect result)))

(check-sat)
(exit)
