; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11000 #b0)
                arg1
                (fp #b1 #b10011 #b0)))
(assert (fp.leq (fp #b1 #b10011 #b0)
                arg1
                (fp #b0 #b10010 #b0)))
; arg1 = -16.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10110100 #b0011111)
                expect
                (fp #b1 #b10000011 #b0000000)))
(assert (fp.leq (fp #b1 #b10000011 #b0000000)
                expect
                (fp #b0 #b01011000 #b0111010)))
; expect = -16.0

(assert (not (= expect result)))

(check-sat)
(exit)
