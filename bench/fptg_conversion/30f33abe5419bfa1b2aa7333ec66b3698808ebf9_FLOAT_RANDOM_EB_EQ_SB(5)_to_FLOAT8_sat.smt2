(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101101000101 #b1010101100011)
                arg1
                (fp #b1 #b00011011001011 #b1111001000011)))
(assert (fp.leq (fp #b1 #b00011011001011 #b1111001000011)
                arg1
                (fp #b0 #b10000001101101 #b1101000100110)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1101)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b000 #b0100)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
