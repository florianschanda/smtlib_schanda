                expect
                (fp #b0 #b01111111101 #b0011000000)))
(assert (fp.leq (fp #b0 #b01111111101 #b0011000000)
                expect
                (fp #b0 #b10101001011 #b1110101001)))

(assert (not (= expect result)))

