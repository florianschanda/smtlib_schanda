(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0101 #b001)
                arg1
                (fp #b1 #b0100 #b110)))
(assert (fp.leq (fp #b1 #b0100 #b110)
                arg1
                (fp #b1 #b0010 #b001)))
; arg1 = -0.21875

(declare-const result (_ FloatingPoint 6 2))
(assert (= result ((_ to_fp 6 2) rm arg1)))

(declare-const expect (_ FloatingPoint 6 2))
(assert (fp.leq (fp #b1 #b101010 #b1)
                expect
                (fp #b1 #b011101 #b0)))
(assert (fp.leq (fp #b1 #b011101 #b0)
                expect
                (fp #b0 #b001101 #b0)))
; expect = -0.25

(assert (not (= expect result)))

(check-sat)
(exit)
