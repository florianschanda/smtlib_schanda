; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10100 #b1010111110)
                arg1
                (fp #b1 #b00000 #b0010001101)))
(assert (fp.leq (fp #b1 #b00000 #b0010001101)
                arg1
                (fp #b0 #b00111 #b0010000111)))
; arg1 = -0.000008404254913330078125

(declare-const result (_ FloatingPoint 18 6))
(assert (= result ((_ to_fp 18 6) rm arg1)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b101011000101010110 #b00000)
                expect
                (fp #b1 #b011111111111101110 #b00100)))
(assert (fp.leq (fp #b1 #b011111111111101110 #b00100)
                expect
                (fp #b0 #b100110100010001101 #b11011)))

(assert (= expect result))

(check-sat)
(exit)
