; Format from: BFLOAT16
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111001 #b1110000)
                arg1
                (fp #b0 #b10000110 #b1001000)))
(assert (fp.leq (fp #b0 #b10000110 #b1001000)
                arg1
                (fp #b0 #b11101001 #b0100000)))
; arg1 = 200.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100010 #b0000101100111001)
                expect
                (fp #b0 #b1000110 #b1001000000000000)))
(assert (fp.leq (fp #b0 #b1000110 #b1001000000000000)
                expect
                (fp #b0 #b1111101 #b1100010110100001)))
; expect = 200.0

(assert (not (= expect result)))

(check-sat)
(exit)
