; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011010001111 #b10001111)
                arg1
                (fp #b1 #b000000000000 #b10111100)))
(assert (fp.leq (fp #b1 #b000000000000 #b10111100)
                arg1
                (fp #b0 #b101100011001 #b01001101)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110101111)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b10101 #b0111011111)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
