(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1101010 #b0100010010000000)
                arg1
                (fp #b1 #b1100000 #b1001011101101101)))
(assert (fp.leq (fp #b1 #b1100000 #b1001011101101101)
                arg1
                (fp #b1 #b1000001 #b1011101001001010)))
; arg1 = -13670940672.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101110 #b11001111011011101011000)
                expect
                (fp #b1 #b10100000 #b10010111011011010000000)))
(assert (fp.leq (fp #b1 #b10100000 #b10010111011011010000000)
                expect
                (fp #b0 #b01110101 #b01111001100001111101110)))
; expect = -13670940672.0

(assert (= expect result))

(check-sat)
(exit)
