(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111110100101100010 #b01000011001100111)
                arg1
                (fp #b1 #b011111111111111111 #b11001011100101100)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b11001011100101100)
                arg1
                (fp #b0 #b100001100001010101 #b10011011100100100)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b1 #b10 #b0)))
(assert (fp.leq (fp #b1 #b10 #b0)
                expect
                (fp #b0 #b01 #b1)))
; expect = -2.0

(assert (= expect result))

(check-sat)
(exit)
