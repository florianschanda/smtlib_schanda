(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0110111110)
                arg1
                (fp #b1 #b01111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111 #b0011010000)
                arg1
                (fp #b1 #b00101 #b1001111111)))
; arg1 = -1.203125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011101 #b10011010000011101000110)
                expect
                (fp #b1 #b01111111 #b00110100000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00110100000000000000000)
                expect
                (fp #b0 #b01011111 #b01100001111101000011110)))
; expect = -1.203125

(assert (not (= expect result)))

(check-sat)
(exit)
