(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011011 #b001)
                arg1
                (fp #b0 #b0000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000 #b000)
                arg1
                (fp #b0 #b1100010 #b011)))
; arg1 = 0.0

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010 #b0101001110)
                expect
                (fp #b0 #b00000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000)
                expect
                (fp #b0 #b10011 #b1000101010)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
