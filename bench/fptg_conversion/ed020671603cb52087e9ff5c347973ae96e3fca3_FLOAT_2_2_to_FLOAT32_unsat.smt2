(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_2_2
; Format to: FLOAT32
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b00 #b1)
                arg1
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                arg1
                (fp #b0 #b10 #b0)))
; arg1 = 0.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00100011 #b11011111111011101111000)
                expect
                (fp #b0 #b01111110 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111110 #b00000000000000000000000)
                expect
                (fp #b0 #b11100001 #b10010111011101101001011)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
(exit)
