(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10010101111100 #b1001100011001)
                arg1
                (fp #b1 #b00000000000000 #b0000000000001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000001)
                arg1
                (fp #b0 #b10010000011100 #b0101111100010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1001)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b000 #b0000)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
