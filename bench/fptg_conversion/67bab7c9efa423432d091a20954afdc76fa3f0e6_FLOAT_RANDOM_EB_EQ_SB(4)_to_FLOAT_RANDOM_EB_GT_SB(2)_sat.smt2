; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100111110 #b111000111)
                arg1
                (fp #b0 #b1011100011 #b101000100)))
(assert (fp.leq (fp #b0 #b1011100011 #b101000100)
                arg1
                (fp #b0 #b1100101110 #b011101101)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result ((_ to_fp 12 4) rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110011101101 #b100)
                expect
                (fp #b0 #b100011100011 #b110)))
(assert (fp.leq (fp #b0 #b100011100011 #b110)
                expect
                (fp #b0 #b110110111010 #b101)))

(assert (= expect result))

(check-sat)
(exit)
