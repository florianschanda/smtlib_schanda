; Format from: FLOAT32
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10100110 #b01101110010100010001111)
                arg1
                (fp #b1 #b01100110 #b10011100101111000011001)))
(assert (fp.leq (fp #b1 #b01100110 #b10011100101111000011001)
                arg1
                (fp #b1 #b00011111 #b10010111111100010101100)))
; arg1 = -0.000000048048693912505768821574747562408447265625

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b1 #b10 #b1)
                expect
                (fp #b1 #b00 #b1)))
(assert (fp.leq (fp #b1 #b00 #b1)
                expect
                (fp #b0 #b10 #b0)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
