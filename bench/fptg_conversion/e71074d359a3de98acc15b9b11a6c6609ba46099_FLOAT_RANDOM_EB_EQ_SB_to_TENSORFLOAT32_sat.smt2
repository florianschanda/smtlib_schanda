(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0100100011011000 #b100101011100010)
                arg1
                (fp #b0 #b1000000000001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b000110010000101)
                arg1
                (fp #b0 #b1001101100101111 #b101101100001011)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00101100 #b1010000100)
                expect
                (fp #b0 #b10001110 #b0001100101)))
(assert (fp.leq (fp #b0 #b10001110 #b0001100101)
                expect
                (fp #b0 #b11101000 #b1110110001)))
; expect = 36000.0

(assert (= expect result))

(check-sat)
(exit)
