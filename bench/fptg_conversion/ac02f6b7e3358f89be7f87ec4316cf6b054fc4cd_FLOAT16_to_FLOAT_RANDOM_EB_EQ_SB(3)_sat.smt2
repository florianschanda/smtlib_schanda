                expect
                (fp #b0 #b011111111101111 #b00000000000000)))
(assert (fp.leq (fp #b0 #b011111111101111 #b00000000000000)
                expect
                (fp #b0 #b100001111000100 #b11000101110011)))

(assert (= expect result))

