(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10000 #b1101100111)
                arg1
                (fp #b0 #b10100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10100 #b0010001110)
                arg1
                (fp #b0 #b11100 #b1100100101)))
; arg1 = 36.4375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010001 #b0101100110)
                expect
                (fp #b0 #b10000100 #b0010001110)))
(assert (fp.leq (fp #b0 #b10000100 #b0010001110)
                expect
                (fp #b0 #b11101100 #b1010001011)))
; expect = 36.4375

(assert (= expect result))

(check-sat)
(exit)
