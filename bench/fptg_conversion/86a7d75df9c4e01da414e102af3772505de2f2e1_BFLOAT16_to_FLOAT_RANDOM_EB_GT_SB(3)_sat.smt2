(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011000 #b1101010)
                arg1
                (fp #b1 #b01111111 #b0001001)))
(assert (fp.leq (fp #b1 #b01111111 #b0001001)
                arg1
                (fp #b0 #b11101101 #b1100001)))
; arg1 = -1.0703125

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b1 #b1110 #b0)
                expect
                (fp #b1 #b0111 #b1)))
(assert (fp.leq (fp #b1 #b0111 #b1)
                expect
                (fp #b0 #b1100 #b0)))
; expect = -1.5

(assert (= expect result))

(check-sat)
(exit)
