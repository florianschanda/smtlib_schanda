(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111010111000 #b0111010111100)
                arg1
                (fp #b1 #b10000000001100 #b0001100110010)))
(assert (fp.leq (fp #b1 #b10000000001100 #b0001100110010)
                arg1
                (fp #b1 #b00010110011010 #b1111000011110)))

(declare-const result (_ FloatingPoint 4 19))
(assert (= result ((_ to_fp 4 19) rm arg1)))

(declare-const expect (_ FloatingPoint 4 19))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

