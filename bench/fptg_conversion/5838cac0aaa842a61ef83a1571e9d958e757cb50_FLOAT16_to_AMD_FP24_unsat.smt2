(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110000 #b0011101001011110)
                expect
                (fp #b1 #b0110101 #b0010100100000000)))
(assert (fp.leq (fp #b1 #b0110101 #b0010100100000000)
                expect
                (fp #b1 #b0000100 #b0110011001010110)))
; expect = -0.001132965087890625

(assert (not (= expect result)))

(check-sat)
(exit)
