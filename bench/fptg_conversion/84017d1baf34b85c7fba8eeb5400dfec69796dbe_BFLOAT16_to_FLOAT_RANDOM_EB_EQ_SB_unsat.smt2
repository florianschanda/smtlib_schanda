; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00000001 #b1001101)
                arg1
                (fp #b0 #b10000110 #b0101000)))
(assert (fp.leq (fp #b0 #b10000110 #b0101000)
                arg1
                (fp #b0 #b11010010 #b0101001)))
; arg1 = 168.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b011000110000 #b11010010100)
                expect
                (fp #b0 #b100000000110 #b01010000000)))
(assert (fp.leq (fp #b0 #b100000000110 #b01010000000)
                expect
                (fp #b0 #b111000101001 #b01001011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
