; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101001 #b01010010001101001000011)
                arg1
                (fp #b1 #b01111111 #b01000101000011100000101)))
(assert (fp.leq (fp #b1 #b01111111 #b01000101000011100000101)
                arg1
                (fp #b1 #b01011111 #b11100010001010011110000)))
; arg1 = -1.26974546909332275390625

(declare-const result (_ FloatingPoint 3 6))
(assert (= result ((_ to_fp 3 6) rm arg1)))

(declare-const expect (_ FloatingPoint 3 6))
(assert (fp.leq (fp #b1 #b110 #b10111)
                expect
                (fp #b1 #b011 #b01001)))
(assert (fp.leq (fp #b1 #b011 #b01001)
                expect
                (fp #b1 #b000 #b01100)))
; expect = -1.28125

(assert (not (= expect result)))

(check-sat)
(exit)
