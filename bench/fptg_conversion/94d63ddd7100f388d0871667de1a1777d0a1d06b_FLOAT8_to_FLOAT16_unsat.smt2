(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b000 #b1100)))
(assert (fp.leq (fp #b0 #b000 #b1100)
                arg1
                (fp #b0 #b011 #b0110)))
; arg1 = 0.1875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1111010110)
                expect
                (fp #b0 #b01100 #b1000000000)))
(assert (fp.leq (fp #b0 #b01100 #b1000000000)
                expect
                (fp #b0 #b11010 #b0111110110)))
; expect = 0.1875

(assert (not (= expect result)))

(check-sat)
(exit)
