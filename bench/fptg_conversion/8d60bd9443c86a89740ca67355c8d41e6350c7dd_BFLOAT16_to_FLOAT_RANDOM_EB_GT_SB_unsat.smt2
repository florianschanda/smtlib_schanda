; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11011101 #b1100000)
                arg1
                (fp #b1 #b10000110 #b0011101)))
(assert (fp.leq (fp #b1 #b10000110 #b0011101)
                arg1
                (fp #b1 #b01010011 #b0010001)))
; arg1 = -157.0

(declare-const result (_ FloatingPoint 8 6))
(assert (= result ((_ to_fp 8 6) rm arg1)))

(declare-const expect (_ FloatingPoint 8 6))
(assert (fp.leq (fp #b1 #b10100110 #b00000)
                expect
                (fp #b1 #b10000110 #b01000)))
(assert (fp.leq (fp #b1 #b10000110 #b01000)
                expect
                (fp #b1 #b01111111 #b11101)))
; expect = -160.0

(assert (not (= expect result)))

(check-sat)
(exit)
