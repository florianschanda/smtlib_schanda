; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110010011110 #b0110001000)
                arg1
                (fp #b0 #b010000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b010000000000 #b0000000000)
                arg1
                (fp #b0 #b011010110110 #b0000100101)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b1100)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b001 #b0101)))
; expect = 0.015625

(assert (not (= expect result)))

(check-sat)
(exit)
