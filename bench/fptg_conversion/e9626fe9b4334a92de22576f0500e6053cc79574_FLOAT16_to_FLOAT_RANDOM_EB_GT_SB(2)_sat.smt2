(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0110011011)
                arg1
                (fp #b1 #b11001 #b0110110001)))
(assert (fp.leq (fp #b1 #b11001 #b0110110001)
                arg1
                (fp #b0 #b11010 #b0100111011)))
; arg1 = -1457.0

(declare-const result (_ FloatingPoint 11 9))
(assert (= result ((_ to_fp 11 9) rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10101001001 #b00100001)
                expect
                (fp #b1 #b10000001001 #b01101101)))
(assert (fp.leq (fp #b1 #b10000001001 #b01101101)
                expect
                (fp #b1 #b01000000011 #b01101110)))

(assert (= expect result))

(check-sat)
(exit)
