(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111000011001 #b11)
                arg1
                (fp #b1 #b0111110100101 #b11)))
