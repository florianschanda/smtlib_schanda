(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT8
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0011)
                arg1
                (fp #b0 #b110 #b0010)))
(assert (fp.leq (fp #b0 #b110 #b0010)
                arg1
                (fp #b0 #b110 #b0110)))
; arg1 = 9.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b101 #b1000)
                expect
                (fp #b0 #b110 #b0010)))
(assert (fp.leq (fp #b0 #b110 #b0010)
                expect
                (fp #b0 #b110 #b1101)))
; expect = 9.0

(assert (not (= expect result)))

(check-sat)
(exit)
