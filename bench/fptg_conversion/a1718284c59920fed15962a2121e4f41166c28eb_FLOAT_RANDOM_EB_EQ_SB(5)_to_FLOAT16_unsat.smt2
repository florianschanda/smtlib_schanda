; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000110 #b011010000)
                arg1
                (fp #b1 #b1000000111 #b001010110)))
(assert (fp.leq (fp #b1 #b1000000111 #b001010110)
                arg1
                (fp #b0 #b1101111001 #b001000010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b1011000110)
                expect
                (fp #b1 #b10111 #b0010101100)))
(assert (fp.leq (fp #b1 #b10111 #b0010101100)
                expect
                (fp #b1 #b01111 #b1000010000)))
; expect = -299.0

(assert (not (= expect result)))

(check-sat)
(exit)
