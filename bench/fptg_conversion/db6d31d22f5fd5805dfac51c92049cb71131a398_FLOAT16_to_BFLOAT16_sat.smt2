; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1010010101)
                arg1
                (fp #b1 #b01111 #b0100110000)))
(assert (fp.leq (fp #b1 #b01111 #b0100110000)
                arg1
                (fp #b0 #b10111 #b0011000011)))
; arg1 = -1.296875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010011 #b1011000)
                expect
                (fp #b1 #b01111111 #b0100110)))
(assert (fp.leq (fp #b1 #b01111111 #b0100110)
                expect
                (fp #b1 #b00010011 #b1100111)))
; expect = -1.296875

(assert (= expect result))

(check-sat)
(exit)
