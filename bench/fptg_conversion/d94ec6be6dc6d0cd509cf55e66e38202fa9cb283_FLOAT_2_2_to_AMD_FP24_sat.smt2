(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_2_2
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b0 #b00 #b0)
                arg1
                (fp #b0 #b10 #b0)))
(assert (fp.leq (fp #b0 #b10 #b0)
                arg1
                (fp #b0 #b11 #b0)))
; arg1 = 2.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0011101 #b0011000100001010)
                expect
                (fp #b0 #b1000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000000 #b0000000000000000)
                expect
                (fp #b0 #b1011011 #b1010100000000000)))
; expect = 2.0

(assert (= expect result))

(check-sat)
(exit)
