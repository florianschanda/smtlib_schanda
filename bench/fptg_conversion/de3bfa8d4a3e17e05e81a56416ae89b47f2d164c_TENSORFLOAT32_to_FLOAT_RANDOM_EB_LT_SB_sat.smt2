; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10001011 #b1110000001)
                arg1
                (fp #b1 #b00000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000)
                arg1
                (fp #b0 #b11011101 #b0000010100)))
; arg1 = -0

(declare-const result (_ FloatingPoint 6 53))
(assert (= result ((_ to_fp 6 53) rm arg1)))

(declare-const expect (_ FloatingPoint 6 53))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011010 #b0111000100010111100000001000000000000000111011000000)
                expect
                (fp #b1 #b000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b010010 #b0010100101010000101000100001111111001001000111000000)))

(assert (= expect result))

(check-sat)
(exit)
