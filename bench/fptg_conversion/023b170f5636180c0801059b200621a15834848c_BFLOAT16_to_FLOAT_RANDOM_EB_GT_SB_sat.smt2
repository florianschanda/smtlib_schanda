(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10011011 #b1101000)
                arg1
                (fp #b1 #b01111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111 #b0101111)
                arg1
                (fp #b1 #b01000101 #b1111000)))
; arg1 = -1.3671875

(declare-const result (_ FloatingPoint 12 4))
(assert (= result ((_ to_fp 12 4) rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101001111011 #b111)
                expect
                (fp #b1 #b011111111111 #b011)))
(assert (fp.leq (fp #b1 #b011111111111 #b011)
                expect
                (fp #b0 #b001011111110 #b100)))

(assert (= expect result))

(check-sat)
(exit)
