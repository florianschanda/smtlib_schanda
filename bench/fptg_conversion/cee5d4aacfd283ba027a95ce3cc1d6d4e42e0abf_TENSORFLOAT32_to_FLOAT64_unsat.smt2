                expect
                (fp #b1 #b10000001000 #b1100000110000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001000 #b1100000110000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b00001000000 #b1110001001010111100111000010110110110010010110011010)))

(assert (not (= expect result)))

