(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0111)
                arg1
                (fp #b0 #b110 #b1111)))
(assert (fp.leq (fp #b0 #b110 #b1111)
                arg1
                (fp #b0 #b111 #b0000)))
; arg1 = 15.5

(declare-const result (_ FloatingPoint 14 2))
(assert (= result ((_ to_fp 14 2) rm arg1)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b10001100010011 #b0)
                expect
                (fp #b0 #b10000000000011 #b0)))
(assert (fp.leq (fp #b0 #b10000000000011 #b0)
                expect
                (fp #b0 #b11101001110111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
