; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101000111110011 #b01101)
                arg1
                (fp #b1 #b000000000000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11111)
                arg1
                (fp #b0 #b100000011101101 #b01001)))

(declare-const result (_ FloatingPoint 9 14))
(assert (= result ((_ to_fp 9 14) rm arg1)))

(declare-const expect (_ FloatingPoint 9 14))
(assert (fp.leq (fp #b1 #b101101101 #b1101101110101)
                expect
                (fp #b1 #b000000000 #b0000000000001)))
(assert (fp.leq (fp #b1 #b000000000 #b0000000000001)
                expect
                (fp #b0 #b100100101 #b0110000001011)))

(assert (= expect result))

(check-sat)
(exit)
