; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b1001111001001011)
                arg1
                (fp #b1 #b0111111 #b0010010101010110)))
(assert (fp.leq (fp #b1 #b0111111 #b0010010101010110)
                arg1
                (fp #b0 #b0001110 #b1011100011011111)))
; arg1 = -1.145843505859375

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101101 #b10011110110110111011010)
                expect
                (fp #b1 #b01111111 #b00100101010101100000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00100101010101100000000)
                expect
                (fp #b1 #b00000000 #b01110000001110111110000)))
; expect = -1.145843505859375

(assert (= expect result))

(check-sat)
(exit)
