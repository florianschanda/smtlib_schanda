; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b011010101101 #b0100111100)
                arg1
                (fp #b1 #b011010100111 #b1110011110)))
(assert (fp.leq (fp #b1 #b011010100111 #b1110011110)
                arg1
                (fp #b1 #b010100001101 #b1011111000)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01000111 #b01011001011011100101001)
                expect
                (fp #b1 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b00011101 #b11100111000111110110001)))
; expect = -0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(assert (= expect result))

(check-sat)
(exit)
