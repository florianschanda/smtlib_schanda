; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0011100 #b1010010100011101)
                arg1
                (fp #b0 #b1100110 #b1110100111111100)))
(assert (fp.leq (fp #b0 #b1100110 #b1110100111111100)
                arg1
                (fp #b0 #b1110100 #b0110000011111111)))
; arg1 = 1052233433088.0

(declare-const result (_ FloatingPoint 4 2))
(assert (= result ((_ to_fp 4 2) rm arg1)))

(declare-const expect (_ FloatingPoint 4 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
