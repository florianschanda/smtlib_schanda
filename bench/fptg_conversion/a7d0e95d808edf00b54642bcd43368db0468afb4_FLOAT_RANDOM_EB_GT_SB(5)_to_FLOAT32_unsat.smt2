(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11100 #b0)
                arg1
                (fp #b1 #b10111 #b0)))
(assert (fp.leq (fp #b1 #b10111 #b0)
                arg1
                (fp #b1 #b01100 #b0)))
; arg1 = -256.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10011001 #b10111001000001010010011)
                expect
                (fp #b1 #b10000111 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000111 #b00000000000000000000000)
                expect
                (fp #b1 #b00111001 #b01001011000100001000101)))
; expect = -256.0

(assert (not (= expect result)))

(check-sat)
(exit)
