(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b00110011 #b1011011011)
                arg1
                (fp #b0 #b01111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111 #b1001100100)
                arg1
                (fp #b0 #b10011110 #b0100101110)))
; arg1 = 1.59765625

(declare-const result (_ FloatingPoint 16 6))
(assert (= result ((_ to_fp 16 6) rm arg1)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0011101111111101 #b10110)
                expect
                (fp #b0 #b0111111111111111 #b10100)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b10100)
                expect
                (fp #b0 #b1110001110010110 #b00011)))

(assert (= expect result))

(check-sat)
(exit)
