(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010000 #b1100011110001001)
                arg1
                (fp #b1 #b1001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b1001111 #b1111110001110101)
                arg1
                (fp #b0 #b1100111 #b0000010100110000)))
; arg1 = -130165.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111010 #b110111011)
                expect
                (fp #b1 #b1000001111 #b111111001)))
(assert (fp.leq (fp #b1 #b1000001111 #b111111001)
                expect
                (fp #b0 #b1110011100 #b110111100)))

(assert (= expect result))

(check-sat)
(exit)
