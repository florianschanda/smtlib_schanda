; Format from: FLOAT64
; Format to: FLOAT_2_2
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101001111 #b0010100011100000001101011111101100000110100101000100)
                arg1
                (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)))
(assert (fp.leq (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)
                arg1
                (fp #b0 #b11100100101 #b1000100010100110001001110010011011101010110111100010)))

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
