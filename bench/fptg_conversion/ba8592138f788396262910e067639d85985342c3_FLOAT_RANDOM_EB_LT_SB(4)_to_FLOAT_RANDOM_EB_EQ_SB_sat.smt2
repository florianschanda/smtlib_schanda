; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 17))
(assert (fp.leq (fp #b0 #b1101 #b1011010000111010)
                arg1
                (fp #b0 #b1110 #b1111111000000000)))
(assert (fp.leq (fp #b0 #b1110 #b1111111000000000)
                arg1
                (fp #b0 #b1110 #b1111111001010111)))
; arg1 = 255.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011111101 #b101110111)
                expect
                (fp #b0 #b1000000110 #b111111100)))
(assert (fp.leq (fp #b0 #b1000000110 #b111111100)
                expect
                (fp #b0 #b1101001010 #b000010000)))

(assert (= expect result))

(check-sat)
(exit)
