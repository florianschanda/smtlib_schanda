; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10100000 #b1101110)
                arg1
                (fp #b0 #b10000100 #b1101111)))
(assert (fp.leq (fp #b0 #b10000100 #b1101111)
                arg1
                (fp #b0 #b10011000 #b0110010)))
; arg1 = 59.75

(declare-const result (_ FloatingPoint 11 5))
(assert (= result ((_ to_fp 11 5) rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b00000110111 #b1100)
                expect
                (fp #b0 #b10000000100 #b1110)))
(assert (fp.leq (fp #b0 #b10000000100 #b1110)
                expect
                (fp #b0 #b11011110010 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
