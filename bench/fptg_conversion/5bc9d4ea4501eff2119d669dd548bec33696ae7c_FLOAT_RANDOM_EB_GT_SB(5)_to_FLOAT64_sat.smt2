(assert (fp.leq (fp #b1 #b10011100100 #b0100101010011000000011101100101110100001010010011111)
                expect
                (fp #b1 #b01100000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01100000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01010101110 #b1000000100101110100001100110110001100111011010110001)))

(assert (= expect result))

