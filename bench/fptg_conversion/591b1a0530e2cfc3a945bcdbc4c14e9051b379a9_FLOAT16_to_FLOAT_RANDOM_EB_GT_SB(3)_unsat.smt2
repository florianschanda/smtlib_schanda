(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0100001010)
                arg1
                (fp #b0 #b11001 #b1101010000)))
(assert (fp.leq (fp #b0 #b11001 #b1101010000)
                arg1
                (fp #b0 #b11010 #b1010000001)))
; arg1 = 1872.0

(declare-const result (_ FloatingPoint 6 3))
(assert (= result ((_ to_fp 6 3) rm arg1)))

(declare-const expect (_ FloatingPoint 6 3))
(assert (fp.leq (fp #b1 #b001010 #b00)
                expect
                (fp #b0 #b101010 #b00)))
(assert (fp.leq (fp #b0 #b101010 #b00)
                expect
                (fp #b0 #b110101 #b10)))
; expect = 2048.0

(assert (not (= expect result)))

(check-sat)
(exit)
