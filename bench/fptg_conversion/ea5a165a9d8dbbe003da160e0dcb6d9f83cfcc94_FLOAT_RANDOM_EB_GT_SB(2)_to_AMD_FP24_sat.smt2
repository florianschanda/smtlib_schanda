(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100110 #b0110010100001000)
                expect
                (fp #b1 #b1011010 #b1000000000000000)))
(assert (fp.leq (fp #b1 #b1011010 #b1000000000000000)
                expect
                (fp #b1 #b0110010 #b0101110101101000)))
; expect = -201326592.0

(assert (= expect result))

(check-sat)
(exit)
