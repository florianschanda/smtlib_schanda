; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0100100011011000 #b100101011100010)
                arg1
                (fp #b0 #b1000000000001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b000110010000101)
                arg1
                (fp #b0 #b1001101100101111 #b101101100001011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01100101 #b0001100)
                expect
                (fp #b0 #b10001110 #b0001101)))
(assert (fp.leq (fp #b0 #b10001110 #b0001101)
                expect
                (fp #b0 #b11100000 #b1111011)))
; expect = 36096.0

(assert (not (= expect result)))

(check-sat)
(exit)
