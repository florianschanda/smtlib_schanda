(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010010 #b01100100100000110001011)
                arg1
                (fp #b0 #b01000000 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000 #b00000000000000000000000)
                arg1
                (fp #b0 #b10000010 #b00110011010010010110111)))
; arg1 = 0.000000000000000000108420217248550443400745280086994171142578125

(declare-const result (_ FloatingPoint 10 2))
(assert (= result ((_ to_fp 10 2) rm arg1)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0010010111 #b1)
                expect
                (fp #b0 #b0111000000 #b0)))
(assert (fp.leq (fp #b0 #b0111000000 #b0)
                expect
                (fp #b0 #b1010000111 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
