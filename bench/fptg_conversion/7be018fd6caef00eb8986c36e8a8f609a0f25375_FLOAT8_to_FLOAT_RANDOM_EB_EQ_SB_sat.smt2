; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0111)
                arg1
                (fp #b0 #b100 #b1100)))
(assert (fp.leq (fp #b0 #b100 #b1100)
                arg1
                (fp #b0 #b101 #b1001)))
; arg1 = 3.5

(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01011111001010 #b1100001011001)
                expect
                (fp #b0 #b10000000000000 #b1100000000000)))
(assert (fp.leq (fp #b0 #b10000000000000 #b1100000000000)
                expect
                (fp #b0 #b10010011001101 #b0000011110111)))

(assert (= expect result))

(check-sat)
(exit)
