; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00000 #b1110101010)
                arg1
                (fp #b0 #b01111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111 #b0101111011)
                arg1
                (fp #b0 #b10011 #b1001001111)))
; arg1 = 1.3701171875

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100101000 #b110101010)
                expect
                (fp #b0 #b0111111111 #b010111110)))
(assert (fp.leq (fp #b0 #b0111111111 #b010111110)
                expect
                (fp #b0 #b1000001011 #b001010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
