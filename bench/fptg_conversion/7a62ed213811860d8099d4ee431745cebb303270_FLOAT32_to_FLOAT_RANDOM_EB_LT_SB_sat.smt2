; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11010100 #b00101101111011110101000)
                arg1
                (fp #b1 #b01111111 #b10010010111110011011111)))
(assert (fp.leq (fp #b1 #b01111111 #b10010010111110011011111)
                arg1
                (fp #b0 #b11110000 #b01011011000101111111000)))
; arg1 = -1.57412326335906982421875

(declare-const result (_ FloatingPoint 6 9))
(assert (= result ((_ to_fp 6 9) rm arg1)))

(declare-const expect (_ FloatingPoint 6 9))
(assert (fp.leq (fp #b1 #b110000 #b00010000)
                expect
                (fp #b1 #b011111 #b10010011)))
(assert (fp.leq (fp #b1 #b011111 #b10010011)
                expect
                (fp #b1 #b011100 #b01100110)))
; expect = -1.57421875

(assert (= expect result))

(check-sat)
(exit)
