                expect
                (fp #b1 #b10001010 #b00101010100000000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b00101010100000000000000)
                expect
                (fp #b0 #b10000101 #b01011111110111111110010)))
; expect = -2388.0

