(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0011001011)
                arg1
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11111 #b0000000000)))
; arg1 = 65504.0

(declare-const result (_ FloatingPoint 11 2))
(assert (= result ((_ to_fp 11 2) rm arg1)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01011111110 #b0)
                expect
                (fp #b0 #b10000001111 #b0)))
(assert (fp.leq (fp #b0 #b10000001111 #b0)
                expect
                (fp #b0 #b10101010101 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
