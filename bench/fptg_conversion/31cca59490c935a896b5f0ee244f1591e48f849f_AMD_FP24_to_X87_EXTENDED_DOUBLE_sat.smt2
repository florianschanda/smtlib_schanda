(assert (fp.leq (fp #b1 #b101110010001001 #b111100011011000001001101001111001100110001000101010000000111011)
                expect
                (fp #b1 #b100000000001111 #b111111000111010100000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000001111 #b111111000111010100000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b011011100011101 #b001001000101001010010100110010111110101110111101110110111001111)))

(assert (= expect result))

(check-sat)
(exit)
