(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b011000100 #b0)
                arg1
                (fp #b0 #b100000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000 #b1)
                arg1
                (fp #b0 #b101101101 #b0)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0100)
                expect
                (fp #b0 #b100 #b1000)))
(assert (fp.leq (fp #b0 #b100 #b1000)
                expect
                (fp #b0 #b101 #b1100)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
