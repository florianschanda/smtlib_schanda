; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1010000 #b011100)
                arg1
                (fp #b1 #b0111111 #b110011)))
(assert (fp.leq (fp #b1 #b0111111 #b110011)
                arg1
                (fp #b0 #b0101011 #b100000)))
; arg1 = -1.796875

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011011 #b0001001110)
                expect
                (fp #b1 #b01111111 #b1100110000)))
(assert (fp.leq (fp #b1 #b01111111 #b1100110000)
                expect
                (fp #b1 #b00100010 #b1110010011)))
; expect = -1.796875

(assert (= expect result))

(check-sat)
(exit)
