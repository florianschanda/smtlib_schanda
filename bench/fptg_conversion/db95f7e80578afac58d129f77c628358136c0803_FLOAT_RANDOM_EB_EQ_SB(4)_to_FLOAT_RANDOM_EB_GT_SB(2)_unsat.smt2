; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001101011 #b1010010110)
                arg1
                (fp #b0 #b01111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111111 #b1001100100)
                arg1
                (fp #b0 #b11110101111 #b1111000001)))

(declare-const result (_ FloatingPoint 5 2))
(assert (= result ((_ to_fp 5 2) rm arg1)))

(declare-const expect (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b10100 #b0)
                expect
                (fp #b0 #b10000 #b0)))
(assert (fp.leq (fp #b0 #b10000 #b0)
                expect
                (fp #b0 #b11011 #b1)))
; expect = 2.0

(assert (not (= expect result)))

(check-sat)
(exit)
