; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 32))
(assert (fp.leq (fp #b0 #b0010101 #b1110000100111110110111010010010)
                arg1
                (fp #b0 #b0111111 #b1111000011111111111000110001010)))
(assert (fp.leq (fp #b0 #b0111111 #b1111000011111111111000110001010)
                arg1
                (fp #b0 #b1101000 #b1101010011000111011000111010000)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b01110010 #b1010011)
                expect
                (fp #b0 #b01111111 #b1111001)))
(assert (fp.leq (fp #b0 #b01111111 #b1111001)
                expect
                (fp #b0 #b10111110 #b0011110)))
; expect = 1.9453125

(assert (not (= expect result)))

(check-sat)
(exit)
