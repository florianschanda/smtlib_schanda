(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0110110111101 #b0111111)
                arg1
                (fp #b0 #b0000000000000 #b1100110)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1100110)
                arg1
                (fp #b0 #b1111001001110 #b1101011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00100 #b1000101000)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01010 #b1011010010)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
