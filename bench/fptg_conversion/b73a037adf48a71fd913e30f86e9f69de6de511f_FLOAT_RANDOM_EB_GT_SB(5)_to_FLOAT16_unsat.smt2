                expect
                (fp #b0 #b01111 #b1000000000)))
(assert (fp.leq (fp #b0 #b01111 #b1000000000)
                expect
                (fp #b0 #b10010 #b1000111101)))
; expect = 1.5

(assert (not (= expect result)))

