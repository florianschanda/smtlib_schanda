(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100010 #b111101110)
                arg1
                (fp #b0 #b0000000001 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000001 #b000000000)
                arg1
                (fp #b0 #b0011011100 #b001101110)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result ((_ to_fp 12 6) rm arg1)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b0 #b001001101101 #b01101)
                expect
                (fp #b0 #b011000000001 #b00000)))
(assert (fp.leq (fp #b0 #b011000000001 #b00000)
                expect
                (fp #b0 #b101110110001 #b00111)))

(assert (= expect result))

(check-sat)
(exit)
