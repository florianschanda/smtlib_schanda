; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11001100 #b1011011110)
                arg1
                (fp #b1 #b10001000 #b1100000110)))
(assert (fp.leq (fp #b1 #b10001000 #b1100000110)
                arg1
                (fp #b0 #b01000110 #b0010100001)))
; arg1 = -899.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100100101 #b01000110110)
                expect
                (fp #b1 #b100000001000 #b11000001100)))
(assert (fp.leq (fp #b1 #b100000001000 #b11000001100)
                expect
                (fp #b0 #b111111010001 #b00101011111)))

(assert (= expect result))

(check-sat)
(exit)
