(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b011010101 #b0111)
                expect
                (fp #b0 #b000000000 #b0001)))
(assert (fp.leq (fp #b0 #b000000000 #b0001)
                expect
                (fp #b0 #b101111011 #b0101)))

(assert (= expect result))

(check-sat)
