; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b01)
                arg1
                (fp #b0 #b000 #b10)))
(assert (fp.leq (fp #b0 #b000 #b10)
                arg1
                (fp #b0 #b001 #b00)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 13 13))
(assert (= result ((_ to_fp 13 13) rm arg1)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0100100111101 #b110101100000)
                expect
                (fp #b0 #b0111111111100 #b000000000000)))
(assert (fp.leq (fp #b0 #b0111111111100 #b000000000000)
                expect
                (fp #b0 #b1100110010010 #b000101000010)))

(assert (= expect result))

(check-sat)
(exit)
