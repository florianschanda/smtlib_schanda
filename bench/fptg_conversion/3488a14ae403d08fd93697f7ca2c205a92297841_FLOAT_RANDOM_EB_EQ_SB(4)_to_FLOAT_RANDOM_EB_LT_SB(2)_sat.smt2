; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0001101101000111 #b101001101001001)
                arg1
                (fp #b0 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1000000000001111 #b000000000000000)
                arg1
                (fp #b0 #b1111111110110000 #b111011100100001)))

(declare-const result (_ FloatingPoint 5 195))
(assert (= result ((_ to_fp 5 195) rm arg1)))

(declare-const expect (_ FloatingPoint 5 195))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
