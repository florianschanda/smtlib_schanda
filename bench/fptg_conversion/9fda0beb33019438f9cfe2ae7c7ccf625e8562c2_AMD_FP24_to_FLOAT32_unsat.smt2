; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1110101 #b1111110101100100)
                arg1
                (fp #b1 #b1001111 #b1011111011110010)))
(assert (fp.leq (fp #b1 #b1001111 #b1011111011110010)
                arg1
                (fp #b1 #b0110101 #b0010000110000101)))
; arg1 = -114418.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10100100 #b01110000001111100111011)
                expect
                (fp #b1 #b10001111 #b10111110111100100000000)))
(assert (fp.leq (fp #b1 #b10001111 #b10111110111100100000000)
                expect
                (fp #b0 #b11011010 #b11110010110011100101010)))
; expect = -114418.0

(assert (not (= expect result)))

(check-sat)
(exit)
