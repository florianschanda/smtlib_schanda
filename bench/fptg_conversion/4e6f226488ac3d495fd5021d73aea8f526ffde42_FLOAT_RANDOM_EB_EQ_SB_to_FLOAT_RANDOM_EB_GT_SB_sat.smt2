(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0011 #b111)
                arg1
                (fp #b0 #b0000 #b010)))
(assert (fp.leq (fp #b0 #b0000 #b010)
                arg1
                (fp #b0 #b1000 #b011)))
; arg1 = 0.00390625

(declare-const result (_ FloatingPoint 8 4))
(assert (= result ((_ to_fp 8 4) rm arg1)))

(declare-const expect (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b11111101 #b111)
                expect
                (fp #b0 #b01110111 #b000)))
(assert (fp.leq (fp #b0 #b01110111 #b000)
                expect
                (fp #b0 #b10010011 #b101)))
; expect = 0.00390625

(assert (= expect result))

(check-sat)
(exit)
