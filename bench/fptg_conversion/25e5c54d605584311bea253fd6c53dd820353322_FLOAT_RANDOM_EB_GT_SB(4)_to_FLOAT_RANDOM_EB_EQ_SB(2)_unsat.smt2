(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01100110110 #b0011)
                arg1
                (fp #b1 #b00000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000)
                arg1
                (fp #b0 #b11110011100 #b0010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101010011 #b110011010)
                expect
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                expect
                (fp #b0 #b1110101110 #b001011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
