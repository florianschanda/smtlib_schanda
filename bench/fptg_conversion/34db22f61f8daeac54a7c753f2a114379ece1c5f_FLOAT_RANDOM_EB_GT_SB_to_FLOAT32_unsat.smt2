(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b001 #b0)
                arg1
                (fp #b0 #b010 #b0)))
(assert (fp.leq (fp #b0 #b010 #b0)
                arg1
                (fp #b0 #b101 #b1)))
; arg1 = 0.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001011 #b10111111111000011001111)
                expect
                (fp #b0 #b01111110 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111110 #b00000000000000000000000)
                expect
                (fp #b0 #b11010010 #b00100101000011101110111)))
; expect = 0.5

(assert (not (= expect result)))

(check-sat)
(exit)
