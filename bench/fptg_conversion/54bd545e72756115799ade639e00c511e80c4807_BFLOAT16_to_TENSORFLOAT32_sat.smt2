(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00001110 #b1010000)
                arg1
                (fp #b0 #b10000101 #b0000000)))
(assert (fp.leq (fp #b0 #b10000101 #b0000000)
                arg1
                (fp #b0 #b10011001 #b0101011)))
; arg1 = 64.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011010 #b0110101011)
                expect
                (fp #b0 #b10000101 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000101 #b0000000000)
                expect
                (fp #b0 #b10001100 #b1101011110)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
