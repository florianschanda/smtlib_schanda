(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1010)
                arg1
                (fp #b0 #b100 #b0010)))
(assert (fp.leq (fp #b0 #b100 #b0010)
                arg1
                (fp #b0 #b101 #b0001)))
; arg1 = 2.25

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b00111 #b0001)
                expect
                (fp #b0 #b10000 #b0010)))
(assert (fp.leq (fp #b0 #b10000 #b0010)
                expect
                (fp #b0 #b10000 #b1110)))
; expect = 2.25

(assert (= expect result))

(check-sat)
(exit)
