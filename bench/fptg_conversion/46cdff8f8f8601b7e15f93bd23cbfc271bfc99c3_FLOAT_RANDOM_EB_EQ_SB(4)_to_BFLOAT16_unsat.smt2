(assert (fp.leq (fp #b1 #b11111001 #b1001101)
                expect
                (fp #b1 #b01111111 #b1100110)))
(assert (fp.leq (fp #b1 #b01111111 #b1100110)
                expect
                (fp #b0 #b10111001 #b0001000)))
; expect = -1.796875

(assert (not (= expect result)))

