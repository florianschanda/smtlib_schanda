; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 2))
(assert (fp.leq (fp #b1 #b11101 #b0)
                arg1
                (fp #b1 #b10001 #b0)))
(assert (fp.leq (fp #b1 #b10001 #b0)
                arg1
                (fp #b0 #b00100 #b1)))
; arg1 = -4.0

(declare-const result (_ FloatingPoint 12 12))
(assert (= result ((_ to_fp 12 12) rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100001001011 #b00100011110)
                expect
                (fp #b1 #b100000000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000000001 #b00000000000)
                expect
                (fp #b0 #b111100100111 #b01010100100)))

(assert (= expect result))

(check-sat)
(exit)
