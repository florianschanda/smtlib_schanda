(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111100 #b111000010)
                arg1
                (fp #b1 #b1000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b1000001000 #b011100001)
                arg1
                (fp #b0 #b1001001010 #b111110010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11110 #b1011101000)
                expect
                (fp #b1 #b11000 #b0111000010)))
(assert (fp.leq (fp #b1 #b11000 #b0111000010)
                expect
                (fp #b0 #b10100 #b0110010011)))
; expect = -737.0

(assert (= expect result))

(check-sat)
(exit)
