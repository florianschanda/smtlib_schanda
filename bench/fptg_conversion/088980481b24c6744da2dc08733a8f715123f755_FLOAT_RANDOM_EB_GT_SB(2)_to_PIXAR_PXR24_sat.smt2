; arg1 = 16.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100011 #b101111001001000)
                expect
                (fp #b0 #b10000011 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10000011 #b000000000000000)
                expect
                (fp #b0 #b11000010 #b111101011011010)))
; expect = 16.0

(assert (= expect result))

(check-sat)
(exit)
