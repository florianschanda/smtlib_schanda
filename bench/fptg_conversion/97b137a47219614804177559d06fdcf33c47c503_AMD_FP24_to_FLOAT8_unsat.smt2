(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: FLOAT8
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1110010 #b0010000011101111)
                arg1
                (fp #b0 #b0000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0000000 #b0000000000000000)
                arg1
                (fp #b0 #b1001101 #b1110011011101000)))
; arg1 = 0.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001 #b1011)
                expect
                (fp #b0 #b000 #b0000)))
(assert (fp.leq (fp #b0 #b000 #b0000)
                expect
                (fp #b0 #b000 #b0110)))
; expect = 0.0

(assert (not (= expect result)))

(check-sat)
(exit)
