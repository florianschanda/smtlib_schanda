(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b10110 #b0011001011)
                arg1
                (fp #b0 #b11110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11110 #b1111111111)
                arg1
                (fp #b0 #b11111 #b0000000000)))
; arg1 = 65504.0

(declare-const result (_ FloatingPoint 14 3))
(assert (= result ((_ to_fp 14 3) rm arg1)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10001011100110 #b10)
                expect
                (fp #b0 #b10000000001111 #b00)))
(assert (fp.leq (fp #b0 #b10000000001111 #b00)
                expect
                (fp #b0 #b11101110011010 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
