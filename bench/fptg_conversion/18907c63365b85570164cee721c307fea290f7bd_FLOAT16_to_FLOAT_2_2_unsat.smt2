(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_2_2
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1101000001)
                arg1
                (fp #b0 #b01111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111 #b0000000000)
                arg1
                (fp #b0 #b10101 #b1010100011)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 2 2))
(assert (= result ((_ to_fp 2 2) rm arg1)))

(declare-const expect (_ FloatingPoint 2 2))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b01 #b0)))
(assert (fp.leq (fp #b0 #b01 #b0)
                expect
                (fp #b0 #b11 #b0)))
; expect = 1.0

(assert (not (= expect result)))

(check-sat)
(exit)
