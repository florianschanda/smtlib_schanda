; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0010 #b11)
                arg1
                (fp #b0 #b1000 #b00)))
(assert (fp.leq (fp #b0 #b1000 #b00)
                arg1
                (fp #b0 #b1000 #b10)))
; arg1 = 2.0

(declare-const result (_ FloatingPoint 13 10))
(assert (= result ((_ to_fp 13 10) rm arg1)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b0 #b0100101001000 #b001101011)
                expect
                (fp #b0 #b1000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000000000 #b000000000)
                expect
                (fp #b0 #b1110101001101 #b100011001)))

(assert (= expect result))

(check-sat)
(exit)
