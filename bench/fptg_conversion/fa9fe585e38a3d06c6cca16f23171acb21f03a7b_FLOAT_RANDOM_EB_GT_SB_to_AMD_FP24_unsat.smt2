(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 3))
(assert (fp.leq (fp #b0 #b0010 #b11)
                arg1
                (fp #b0 #b1000 #b00)))
(assert (fp.leq (fp #b0 #b1000 #b00)
                arg1
                (fp #b0 #b1000 #b10)))
; arg1 = 2.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0111001 #b0110110100110011)
                expect
                (fp #b0 #b1000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000000 #b0000000000000000)
                expect
                (fp #b0 #b1001110 #b1100101100011001)))
; expect = 2.0

(assert (not (= expect result)))

(check-sat)
(exit)
