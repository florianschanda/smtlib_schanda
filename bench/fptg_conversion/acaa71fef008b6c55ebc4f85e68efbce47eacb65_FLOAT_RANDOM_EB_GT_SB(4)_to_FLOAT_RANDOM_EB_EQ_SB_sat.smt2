(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01010110001101111 #b010)
                arg1
                (fp #b0 #b00000000000000000 #b011)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b011)
                arg1
