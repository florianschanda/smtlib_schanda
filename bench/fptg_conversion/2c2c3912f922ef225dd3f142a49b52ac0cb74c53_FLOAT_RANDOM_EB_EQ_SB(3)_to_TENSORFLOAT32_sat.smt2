; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b111101 #b00101)
                arg1
                (fp #b0 #b011101 #b10000)))
(assert (fp.leq (fp #b0 #b011101 #b10000)
                arg1
                (fp #b0 #b100110 #b00111)))
; arg1 = 0.375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00000010 #b1111000001)
                expect
                (fp #b0 #b01111101 #b1000000000)))
(assert (fp.leq (fp #b0 #b01111101 #b1000000000)
                expect
                (fp #b0 #b11001010 #b1001001111)))
; expect = 0.375

(assert (= expect result))

(check-sat)
(exit)
