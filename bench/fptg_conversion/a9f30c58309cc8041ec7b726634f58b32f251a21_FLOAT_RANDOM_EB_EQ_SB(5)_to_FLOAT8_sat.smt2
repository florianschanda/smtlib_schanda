(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b111 #b00)
                arg1
                (fp #b1 #b010 #b11)))
(assert (fp.leq (fp #b1 #b010 #b11)
                arg1
                (fp #b1 #b010 #b01)))
; arg1 = -0.875

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b1100)
                expect
                (fp #b1 #b010 #b1100)))
(assert (fp.leq (fp #b1 #b010 #b1100)
                expect
                (fp #b0 #b110 #b0010)))
; expect = -0.875

(assert (= expect result))

(check-sat)
(exit)
