; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0000111 #b0101011101100011)
                arg1
                (fp #b0 #b1001101 #b1001011101111000)))
(assert (fp.leq (fp #b0 #b1001101 #b1001011101111000)
                arg1
                (fp #b0 #b1111000 #b0110100001010001)))
; arg1 = 26078.0

(declare-const result (_ FloatingPoint 7 4))
(assert (= result ((_ to_fp 7 4) rm arg1)))

(declare-const expect (_ FloatingPoint 7 4))
(assert (fp.leq (fp #b1 #b0100000 #b110)
                expect
                (fp #b0 #b1001101 #b101)))
(assert (fp.leq (fp #b0 #b1001101 #b101)
                expect
                (fp #b0 #b1101101 #b101)))
; expect = 26624.0

(assert (= expect result))

(check-sat)
(exit)
