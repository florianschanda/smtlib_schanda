(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101100010011 #b10000010)
                arg1
                (fp #b1 #b000000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b000000000000 #b00010010)
                arg1
                (fp #b0 #b000110111111 #b00011011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101111010 #b100101010)
                expect
                (fp #b1 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000001)
                expect
                (fp #b0 #b1011111011 #b010011110)))

(assert (= expect result))

(check-sat)
(exit)
