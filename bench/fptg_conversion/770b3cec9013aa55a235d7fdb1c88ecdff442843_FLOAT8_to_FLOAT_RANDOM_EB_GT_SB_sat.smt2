(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b101 #b0010)
                arg1
                (fp #b1 #b011 #b0011)))
(assert (fp.leq (fp #b1 #b011 #b0011)
                arg1
                (fp #b1 #b001 #b0100)))
; arg1 = -1.1875

(declare-const result (_ FloatingPoint 6 4))
(assert (= result ((_ to_fp 6 4) rm arg1)))

(declare-const expect (_ FloatingPoint 6 4))
(assert (fp.leq (fp #b1 #b100010 #b111)
                expect
                (fp #b1 #b011111 #b010)))
(assert (fp.leq (fp #b1 #b011111 #b010)
                expect
                (fp #b0 #b111001 #b010)))
; expect = -1.25

(assert (= expect result))

(check-sat)
(exit)
