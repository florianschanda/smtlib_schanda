; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b011000100 #b0)
                arg1
                (fp #b0 #b100000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000 #b1)
                arg1
                (fp #b0 #b101101101 #b0)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b0 #b01110 #b1101111000)
                expect
                (fp #b0 #b10000 #b1000000000)))
(assert (fp.leq (fp #b0 #b10000 #b1000000000)
                expect
                (fp #b0 #b10101 #b0011011100)))
; expect = 3.0

(assert (not (= expect result)))

(check-sat)
(exit)
