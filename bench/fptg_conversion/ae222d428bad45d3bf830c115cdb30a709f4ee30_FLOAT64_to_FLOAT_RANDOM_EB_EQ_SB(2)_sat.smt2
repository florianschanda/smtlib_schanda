(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01011110111011 #b1100110100001)
                expect
                (fp #b0 #b10000011111111 #b1111010100100)))
(assert (fp.leq (fp #b0 #b10000011111111 #b1111010100100)
                expect
                (fp #b0 #b10011101100101 #b0101100111100)))

(assert (= expect result))

