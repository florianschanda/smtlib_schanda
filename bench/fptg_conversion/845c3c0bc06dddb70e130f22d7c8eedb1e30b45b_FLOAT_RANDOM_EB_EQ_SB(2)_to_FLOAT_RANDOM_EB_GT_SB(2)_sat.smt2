(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1101 #b110)
                arg1
                (fp #b1 #b0111 #b101)))
(assert (fp.leq (fp #b1 #b0111 #b101)
                arg1
                (fp #b0 #b0110 #b101)))
; arg1 = -1.625

(declare-const result (_ FloatingPoint 16 10))
(assert (= result ((_ to_fp 16 10) rm arg1)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110100110011010 #b000001011)
                expect
                (fp #b1 #b0111111111111111 #b101000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b101000000)
                expect
                (fp #b0 #b0010000111110000 #b001100010)))

(assert (= expect result))

(check-sat)
(exit)
