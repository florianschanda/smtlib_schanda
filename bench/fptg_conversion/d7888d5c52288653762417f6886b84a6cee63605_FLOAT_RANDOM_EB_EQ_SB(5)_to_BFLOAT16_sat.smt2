(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: BFLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101100100100 #b11101000010011)
                arg1
                (fp #b1 #b100000000010011 #b01101001010110)))
(assert (fp.leq (fp #b1 #b100000000010011 #b01101001010110)
                arg1
                (fp #b1 #b001010100001001 #b00010101010011)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111100 #b1101101)
                expect
                (fp #b1 #b10010011 #b0110101)))
(assert (fp.leq (fp #b1 #b10010011 #b0110101)
                expect
                (fp #b0 #b11011000 #b0011111)))
; expect = -1482752.0

(assert (= expect result))

(check-sat)
(exit)
