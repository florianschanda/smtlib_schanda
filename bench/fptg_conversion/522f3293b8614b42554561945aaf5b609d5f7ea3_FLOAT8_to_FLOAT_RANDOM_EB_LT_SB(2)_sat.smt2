; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0100)
                arg1
                (fp #b1 #b011 #b1101)))
(assert (fp.leq (fp #b1 #b011 #b1101)
                arg1
                (fp #b0 #b101 #b0100)))
; arg1 = -1.8125

(declare-const result (_ FloatingPoint 4 9))
(assert (= result ((_ to_fp 4 9) rm arg1)))

(declare-const expect (_ FloatingPoint 4 9))
(assert (fp.leq (fp #b1 #b1000 #b00001011)
                expect
                (fp #b1 #b0111 #b11010000)))
(assert (fp.leq (fp #b1 #b0111 #b11010000)
                expect
                (fp #b0 #b0001 #b01101111)))
; expect = -1.8125

(assert (= expect result))

(check-sat)
(exit)
