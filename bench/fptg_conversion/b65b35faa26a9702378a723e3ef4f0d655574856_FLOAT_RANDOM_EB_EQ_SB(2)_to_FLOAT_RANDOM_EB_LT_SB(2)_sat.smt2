(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_SUBNORMAL(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b100 #b01)
                arg1
                (fp #b0 #b000 #b10)))
(assert (fp.leq (fp #b0 #b000 #b10)
                arg1
                (fp #b0 #b001 #b00)))
; arg1 = 0.125

(declare-const result (_ FloatingPoint 3 32))
(assert (= result ((_ to_fp 3 32) rm arg1)))

(declare-const expect (_ FloatingPoint 3 32))
(assert (fp.leq (fp #b1 #b011 #b1101001110010101101010001000000)
                expect
                (fp #b0 #b000 #b1000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000 #b1000000000000000000000000000000)
                expect
                (fp #b0 #b110 #b0001101111110001001011100110100)))

(assert (= expect result))

(check-sat)
(exit)
