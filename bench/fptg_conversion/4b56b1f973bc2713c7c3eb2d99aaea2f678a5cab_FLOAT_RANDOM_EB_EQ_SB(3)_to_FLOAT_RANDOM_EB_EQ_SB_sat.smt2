; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1000 #b001)
                arg1
                (fp #b0 #b0111 #b000)))
(assert (fp.leq (fp #b0 #b0111 #b000)
                arg1
                (fp #b0 #b1011 #b111)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b0010000 #b010100)
                expect
                (fp #b0 #b0111111 #b000000)))
(assert (fp.leq (fp #b0 #b0111111 #b000000)
                expect
                (fp #b0 #b1001101 #b111011)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
