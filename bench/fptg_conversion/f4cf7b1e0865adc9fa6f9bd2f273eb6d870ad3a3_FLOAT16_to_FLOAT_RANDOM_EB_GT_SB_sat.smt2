; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b0000110110)
                arg1
                (fp #b1 #b11001 #b0000110001)))
(assert (fp.leq (fp #b1 #b11001 #b0000110001)
                arg1
                (fp #b0 #b01010 #b1100110000)))
; arg1 = -1073.0

(declare-const result (_ FloatingPoint 17 10))
(assert (= result ((_ to_fp 17 10) rm arg1)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b11101010011111110 #b101110110)
                expect
                (fp #b1 #b10000000000001001 #b000011001)))
(assert (fp.leq (fp #b1 #b10000000000001001 #b000011001)
                expect
                (fp #b1 #b00011111101110001 #b101100101)))

(assert (= expect result))

(check-sat)
(exit)
