(assert (fp.leq (fp #b0 #b00 #b0)
                expect
                (fp #b0 #b00 #b1)))
(assert (fp.leq (fp #b0 #b00 #b1)
                expect
                (fp #b0 #b10 #b0)))
; expect = 0.5

