; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b1100000111)
                arg1
                (fp #b0 #b01001 #b1111001110)))
(assert (fp.leq (fp #b0 #b01001 #b1111001110)
                arg1
                (fp #b0 #b10101 #b0001100011)))
; arg1 = 0.030487060546875

(declare-const result (_ FloatingPoint 13 7))
(assert (= result ((_ to_fp 13 7) rm arg1)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0011010000110 #b110001)
                expect
                (fp #b0 #b0111111111001 #b111101)))
(assert (fp.leq (fp #b0 #b0111111111001 #b111101)
                expect
                (fp #b0 #b1011110000001 #b101111)))

(assert (= expect result))

(check-sat)
(exit)
