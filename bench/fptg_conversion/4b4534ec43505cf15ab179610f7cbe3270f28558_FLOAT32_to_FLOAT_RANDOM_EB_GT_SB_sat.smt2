(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10101010 #b01101001011000100000110)
                arg1
                (fp #b1 #b01111111 #b10011010110111110010110)))
(assert (fp.leq (fp #b1 #b01111111 #b10011010110111110010110)
                arg1
                (fp #b0 #b00111011 #b10001001000001000110011)))
; arg1 = -1.6049678325653076171875

(declare-const result (_ FloatingPoint 9 4))
(assert (= result ((_ to_fp 9 4) rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110011000 #b000)
                expect
                (fp #b1 #b011111111 #b101)))
(assert (fp.leq (fp #b1 #b011111111 #b101)
                expect
                (fp #b0 #b010000101 #b000)))

(assert (= expect result))

(check-sat)
(exit)
