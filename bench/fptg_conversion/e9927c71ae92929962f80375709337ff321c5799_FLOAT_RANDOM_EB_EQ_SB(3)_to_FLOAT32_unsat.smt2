; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 6))
(assert (fp.leq (fp #b1 #b100100 #b00000)
                arg1
                (fp #b0 #b100100 #b10000)))
(assert (fp.leq (fp #b0 #b100100 #b10000)
                arg1
                (fp #b0 #b111100 #b01111)))
; arg1 = 48.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00010110 #b01011000100001010111010)
                expect
                (fp #b0 #b10000100 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000100 #b10000000000000000000000)
                expect
                (fp #b0 #b11001000 #b10101001101101111010110)))
; expect = 48.0

(assert (not (= expect result)))

(check-sat)
(exit)
