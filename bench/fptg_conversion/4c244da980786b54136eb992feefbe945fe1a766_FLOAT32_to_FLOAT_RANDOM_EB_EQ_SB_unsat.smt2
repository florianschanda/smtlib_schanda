; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110111 #b10111010010010111010110)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11100000 #b11111010011110101011101)))
; arg1 = 55651713024.0

(declare-const result (_ FloatingPoint 18 18))
(assert (= result ((_ to_fp 18 18) rm arg1)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b000101000100010111 #b11110110110101001)
                expect
                (fp #b0 #b100000000000100010 #b10011110101000111)))
(assert (fp.leq (fp #b0 #b100000000000100010 #b10011110101000111)
                expect
                (fp #b0 #b111110111110000010 #b11010010110100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
