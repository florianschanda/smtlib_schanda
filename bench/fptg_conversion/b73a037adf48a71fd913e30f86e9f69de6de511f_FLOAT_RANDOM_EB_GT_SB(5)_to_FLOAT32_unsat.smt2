(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b0)
                arg1
                (fp #b0 #b011 #b1)))
(assert (fp.leq (fp #b0 #b011 #b1)
                arg1
                (fp #b0 #b101 #b1)))
; arg1 = 1.5

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010000 #b10111001111010111001111)
                expect
                (fp #b0 #b01111111 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111 #b10000000000000000000000)
                expect
                (fp #b0 #b10111000 #b00111110110100011001111)))
; expect = 1.5

(assert (not (= expect result)))

(check-sat)
(exit)
