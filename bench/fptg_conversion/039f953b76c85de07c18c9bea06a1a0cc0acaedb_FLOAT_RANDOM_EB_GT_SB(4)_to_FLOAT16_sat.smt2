; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b000000 #b0100)
                arg1
                (fp #b0 #b001101 #b1101)))
(assert (fp.leq (fp #b0 #b001101 #b1101)
                arg1
                (fp #b0 #b111100 #b1011)))
; arg1 = 0.0000069141387939453125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00100 #b0010000011)
                expect
                (fp #b0 #b00000 #b0001110100)))
(assert (fp.leq (fp #b0 #b00000 #b0001110100)
                expect
                (fp #b0 #b01100 #b0111011000)))
; expect = 0.0000069141387939453125

(assert (= expect result))

(check-sat)
(exit)
