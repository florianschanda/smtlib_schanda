                expect
                (fp #b1 #b011111111110 #b00000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b011111111110 #b00000000000000000000000000000000000)
                expect
                (fp #b0 #b011111100111 #b11111110110010100100110000001000111)))

(assert (not (= expect result)))

