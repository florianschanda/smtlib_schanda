(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0010001111011 #b0111)
                arg1
                (fp #b1 #b0000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000)
                arg1
                (fp #b0 #b1011101011100 #b0111)))

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101110 #b100111)
                expect
                (fp #b1 #b0000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000)
                expect
                (fp #b0 #b0100101 #b011000)))
; expect = -0

(assert (not (= expect result)))

(check-sat)
(exit)
