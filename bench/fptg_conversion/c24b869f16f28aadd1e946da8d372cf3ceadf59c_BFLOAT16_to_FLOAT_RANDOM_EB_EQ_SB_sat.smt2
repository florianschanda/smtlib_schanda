; Format from: BFLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00110000 #b1001000)
                arg1
                (fp #b0 #b00000000 #b0110000)))
(assert (fp.leq (fp #b0 #b00000000 #b0110000)
                arg1
                (fp #b0 #b01101011 #b0010001)))
; arg1 = 0.000000000000000000000000000000000000004408103815583578154882762014583421291819995837895328205657818898544064722955226898193359375

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0111 #b000)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b1001 #b010)))
; expect = 0.001953125

(assert (= expect result))

(check-sat)
(exit)
