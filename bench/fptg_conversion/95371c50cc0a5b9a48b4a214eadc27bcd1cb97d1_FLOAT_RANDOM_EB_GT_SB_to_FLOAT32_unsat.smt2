(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b110 #b0)
                arg1
                (fp #b1 #b101 #b1)))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b0 #b101 #b0)))
; arg1 = -6.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11101110 #b11011000111010110011111)
                expect
                (fp #b1 #b10000001 #b10000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001 #b10000000000000000000000)
                expect
                (fp #b0 #b11110111 #b11010000001110011110011)))
; expect = -6.0

(assert (not (= expect result)))

(check-sat)
(exit)
