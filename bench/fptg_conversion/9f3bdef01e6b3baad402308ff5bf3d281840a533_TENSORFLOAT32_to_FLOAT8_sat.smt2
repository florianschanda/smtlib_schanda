(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT8
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10000010 #b0000110000)
                arg1
                (fp #b0 #b00000000 #b1011110010)))
(assert (fp.leq (fp #b0 #b00000000 #b1011110010)
                arg1
                (fp #b0 #b10000011 #b0100000100)))
; arg1 = 0.000000000000000000000000000000000000008655495512890671689535423330718488682375720994200722570484363149745377086219377815723419189453125

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b010 #b0011)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b010 #b0110)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
(exit)
