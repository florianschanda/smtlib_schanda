; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b1110 #b100)
                arg1
                (fp #b0 #b1000 #b101)))
(assert (fp.leq (fp #b0 #b1000 #b101)
                arg1
                (fp #b0 #b1110 #b000)))
; arg1 = 3.25

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111010 #b10010010111110001001001)
                expect
                (fp #b0 #b10000000 #b10100000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000 #b10100000000000000000000)
                expect
                (fp #b0 #b11101011 #b10111010001101111001010)))
; expect = 3.25

(assert (not (= expect result)))

(check-sat)
(exit)
