; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b0101)
                arg1
                (fp #b1 #b001 #b0110)))
(assert (fp.leq (fp #b1 #b001 #b0110)
                arg1
                (fp #b1 #b001 #b0011)))
; arg1 = -0.34375

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11011 #b1101110001)
                expect
                (fp #b1 #b01101 #b0110000000)))
(assert (fp.leq (fp #b1 #b01101 #b0110000000)
                expect
                (fp #b0 #b10101 #b1011001011)))
; expect = -0.34375

(assert (not (= expect result)))

(check-sat)
(exit)
