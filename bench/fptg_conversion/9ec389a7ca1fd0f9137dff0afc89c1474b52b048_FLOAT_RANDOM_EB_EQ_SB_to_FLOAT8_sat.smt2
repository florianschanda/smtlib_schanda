(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: +RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01111101000011 #b0001100000110)
                arg1
                (fp #b0 #b01111111111111 #b0111011011110)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0111011011110)
                arg1
                (fp #b0 #b11110001111111 #b1111100100010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b1011)
                expect
                (fp #b0 #b011 #b1000)))
(assert (fp.leq (fp #b0 #b011 #b1000)
                expect
                (fp #b0 #b100 #b0100)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
