; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg1 = 11601303.0

(declare-const result (_ FloatingPoint 18 18))
(assert (= result ((_ to_fp 18 18) rm arg1)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b010111100111000101 #b01110010001000001)
                expect
                (fp #b0 #b100000000000010110 #b01100010000010111)))
(assert (fp.leq (fp #b0 #b100000000000010110 #b01100010000010111)
                expect
                (fp #b0 #b111001011100111011 #b01101111101101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
