; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0101000 #b1111111101111011)
                arg1
                (fp #b1 #b0000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b0000000 #b1111111111111111)
                arg1
                (fp #b0 #b1011010 #b0101011110111110)))
; arg1 = -0.000000000000000000216837125774650674690791074539220062433741986751556396484375

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11010011 #b1110000)
                expect
                (fp #b1 #b01000001 #b0000000)))
(assert (fp.leq (fp #b1 #b01000001 #b0000000)
                expect
                (fp #b0 #b00111001 #b1010010)))
; expect = -0.00000000000000000021684043449710088680149056017398834228515625

(assert (= expect result))

(check-sat)
(exit)
