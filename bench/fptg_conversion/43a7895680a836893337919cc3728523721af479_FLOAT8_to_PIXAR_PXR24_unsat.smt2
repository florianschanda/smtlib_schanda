(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0011)
                arg1
                (fp #b0 #b110 #b0010)))
(assert (fp.leq (fp #b0 #b110 #b0010)
                arg1
                (fp #b0 #b110 #b0110)))
; arg1 = 9.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11000111 #b001101110011110)
                expect
                (fp #b0 #b10000010 #b001000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b001000000000000)
                expect
                (fp #b0 #b11001001 #b000001111001001)))
; expect = 9.0

(assert (not (= expect result)))

(check-sat)
(exit)
