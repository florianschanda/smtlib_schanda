(assert (fp.leq (fp #b1 #b10110 #b1000111011)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b11101 #b0110110110)))
; expect = -0.000000059604644775390625

(assert (not (= expect result)))

