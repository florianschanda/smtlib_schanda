(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0011111110 #b1101)
                arg1
                (fp #b1 #b0011111110 #b0000)))
