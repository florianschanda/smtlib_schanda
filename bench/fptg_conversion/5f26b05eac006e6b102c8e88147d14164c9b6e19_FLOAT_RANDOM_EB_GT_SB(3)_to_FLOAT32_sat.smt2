(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110010100 #b10)
                arg1
                (fp #b1 #b100010001 #b11)))
(assert (fp.leq (fp #b1 #b100010001 #b11)
                arg1
                (fp #b0 #b010000111 #b11)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10110011 #b01000111111010110000111)
                expect
                (fp #b1 #b10010001 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b10010001 #b11000000000000000000000)
                expect
                (fp #b0 #b00101011 #b00100010001000101110110)))
; expect = -458752.0

(assert (= expect result))

(check-sat)
(exit)
