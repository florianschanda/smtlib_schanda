(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b00110000 #b11111110111110111001001)
                arg1
                (fp #b0 #b10010110 #b01100010000010110010111)))
(assert (fp.leq (fp #b0 #b10010110 #b01100010000010110010111)
                arg1
                (fp #b0 #b11101100 #b10000011011110100100100)))
; arg1 = 11601303.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100111 #b1111000000110011)
                expect
                (fp #b0 #b1010110 #b0110001000001100)))
(assert (fp.leq (fp #b0 #b1010110 #b0110001000001100)
                expect
                (fp #b0 #b1101111 #b1010010111010111)))
; expect = 11601408.0

(assert (not (= expect result)))

(check-sat)
(exit)
