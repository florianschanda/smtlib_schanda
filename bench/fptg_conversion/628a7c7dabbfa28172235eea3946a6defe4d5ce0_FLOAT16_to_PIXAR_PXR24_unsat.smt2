(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0101001010)
                arg1
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg1
                (fp #b0 #b01101 #b1101100111)))
; arg1 = -16384.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10100101 #b000101111001010)
                expect
                (fp #b1 #b10001101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b10001101 #b000000000000000)
                expect
                (fp #b1 #b00001000 #b101110000001101)))
; expect = -16384.0

(assert (not (= expect result)))

(check-sat)
(exit)
