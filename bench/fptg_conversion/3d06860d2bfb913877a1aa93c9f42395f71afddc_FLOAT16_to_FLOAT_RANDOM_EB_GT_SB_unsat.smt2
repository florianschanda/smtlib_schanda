(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b10000011001001011 #b0101)
                expect
                (fp #b0 #b01111111111111111 #b1110)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b1110)
                expect
                (fp #b0 #b11100110111111111 #b1111)))

(assert (not (= expect result)))

(check-sat)
