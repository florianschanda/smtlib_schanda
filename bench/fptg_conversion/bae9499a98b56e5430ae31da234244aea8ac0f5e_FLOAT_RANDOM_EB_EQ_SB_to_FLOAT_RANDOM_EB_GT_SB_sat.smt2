(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11001 #b0011)
                arg1
                (fp #b1 #b00000 #b0000)))
(assert (fp.leq (fp #b1 #b00000 #b0000)
                arg1
                (fp #b0 #b10011 #b1111)))
; arg1 = -0

(declare-const result (_ FloatingPoint 13 12))
(assert (= result ((_ to_fp 13 12) rm arg1)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111111110101 #b11011000110)
                expect
                (fp #b1 #b0000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00000000000)
                expect
                (fp #b0 #b1100001100100 #b00101011011)))

(assert (= expect result))

(check-sat)
(exit)
