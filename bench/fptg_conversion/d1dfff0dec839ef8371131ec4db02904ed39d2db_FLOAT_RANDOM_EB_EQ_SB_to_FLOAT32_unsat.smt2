; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001000110 #b1010001101)
                arg1
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b00110110111 #b1111011001)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011110 #b01011101000011110100111)
                expect
                (fp #b0 #b00000000 #b00000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000001)
                expect
                (fp #b0 #b10011110 #b11111100001100100100011)))
; expect = 0.00000000000000000000000000000000000000000000140129846432481707092372958328991613128026194187651577175706828388979108268586060148663818836212158203125

(assert (not (= expect result)))

(check-sat)
