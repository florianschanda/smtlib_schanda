(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b000101100101001 #b100000)
                arg1
                (fp #b0 #b000000000000000 #b000110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000110)
                arg1
