; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b0 #b001 #b00)
                arg1
                (fp #b0 #b011 #b01)))
(assert (fp.leq (fp #b0 #b011 #b01)
                arg1
                (fp #b0 #b110 #b01)))
; arg1 = 1.25

(declare-const result (_ FloatingPoint 5 4))
(assert (= result ((_ to_fp 5 4) rm arg1)))

(declare-const expect (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00001 #b101)
                expect
                (fp #b0 #b01111 #b010)))
(assert (fp.leq (fp #b0 #b01111 #b010)
                expect
                (fp #b0 #b10100 #b010)))
; expect = 1.25

(assert (= expect result))

(check-sat)
(exit)
