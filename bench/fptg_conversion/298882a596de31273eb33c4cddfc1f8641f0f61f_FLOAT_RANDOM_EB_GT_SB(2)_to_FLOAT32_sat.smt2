; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 6))
(assert (fp.leq (fp #b1 #b1111000 #b01101)
                arg1
                (fp #b1 #b0111111 #b11111)))
(assert (fp.leq (fp #b1 #b0111111 #b11111)
                arg1
                (fp #b1 #b0111101 #b10010)))
; arg1 = -1.96875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11100111 #b11100000110011000101010)
                expect
                (fp #b1 #b01111111 #b11111000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b11111000000000000000000)
                expect
                (fp #b1 #b00000000 #b00010000011100000100000)))
; expect = -1.96875

(assert (= expect result))

(check-sat)
(exit)
