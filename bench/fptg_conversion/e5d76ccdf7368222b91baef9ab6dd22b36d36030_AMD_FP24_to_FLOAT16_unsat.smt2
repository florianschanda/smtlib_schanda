(assert (fp.leq (fp #b1 #b1000111 #b0110001001110100)
                arg1
                (fp #b0 #b0000000 #b0110100000010010)))
(assert (fp.leq (fp #b0 #b0000000 #b0110100000010010)
                arg1
                (fp #b0 #b1101010 #b0000101010010010)))
