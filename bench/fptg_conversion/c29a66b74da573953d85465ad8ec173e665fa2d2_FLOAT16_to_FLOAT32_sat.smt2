(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT32
; Arg1: -RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b1100110000)
                arg1
                (fp #b1 #b11011 #b1100100001)))
(assert (fp.leq (fp #b1 #b11011 #b1100100001)
                arg1
                (fp #b1 #b10101 #b1011100010)))
; arg1 = -7300.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011000 #b11010100101000011100111)
                expect
                (fp #b1 #b10001011 #b11001000010000000000000)))
(assert (fp.leq (fp #b1 #b10001011 #b11001000010000000000000)
                expect
                (fp #b0 #b10000100 #b10101011100100101010101)))
; expect = -7300.0

(assert (= expect result))

(check-sat)
(exit)
