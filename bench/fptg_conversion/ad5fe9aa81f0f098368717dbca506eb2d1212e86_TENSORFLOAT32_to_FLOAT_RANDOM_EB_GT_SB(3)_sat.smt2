; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11011100 #b0010000100)
                arg1
                (fp #b1 #b10001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10001010 #b0000000000)
                arg1
                (fp #b1 #b00000100 #b0000010110)))
; arg1 = -2048.0

(declare-const result (_ FloatingPoint 11 8))
(assert (= result ((_ to_fp 11 8) rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11001100011 #b0001000)
                expect
                (fp #b1 #b10000001010 #b0000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000)
                expect
                (fp #b1 #b01011111111 #b1100101)))

(assert (= expect result))

(check-sat)
(exit)
