; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b00001 #b1101000111)
                arg1
                (fp #b0 #b00000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000 #b1111111000)
                arg1
                (fp #b0 #b00010 #b0000111001)))
; arg1 = 0.000060558319091796875

(declare-const result (_ FloatingPoint 15 15))
(assert (= result ((_ to_fp 15 15) rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b000111010101101 #b01111101010001)
                expect
                (fp #b0 #b011111111110000 #b11111100000000)))
(assert (fp.leq (fp #b0 #b011111111110000 #b11111100000000)
                expect
                (fp #b0 #b110001010111001 #b11100011011001)))

(assert (= expect result))

(check-sat)
(exit)
