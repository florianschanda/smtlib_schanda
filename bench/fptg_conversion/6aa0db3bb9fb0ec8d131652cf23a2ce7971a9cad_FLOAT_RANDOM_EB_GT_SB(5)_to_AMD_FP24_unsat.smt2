; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: AMD_FP24
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b1000 #b1)
                arg1
                (fp #b0 #b1101 #b0)))
(assert (fp.leq (fp #b0 #b1101 #b0)
                arg1
                (fp #b0 #b1110 #b1)))
; arg1 = 64.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001110 #b1001101101111100)
                expect
                (fp #b0 #b1000101 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b1000101 #b0000000000000000)
                expect
                (fp #b0 #b1101111 #b0100100111000000)))
; expect = 64.0

(assert (not (= expect result)))

(check-sat)
(exit)
