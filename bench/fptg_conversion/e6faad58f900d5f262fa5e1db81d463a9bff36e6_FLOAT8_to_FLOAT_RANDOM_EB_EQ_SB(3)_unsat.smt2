                expect
                (fp #b1 #b0111111111111110 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0111111111111110 #b000000000000000)
                expect
                (fp #b1 #b0100110111111010 #b010011101000011)))

(assert (not (= expect result)))

