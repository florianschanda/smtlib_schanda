; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 5))
(assert (fp.leq (fp #b1 #b100111 #b1101)
                arg1
                (fp #b1 #b011111 #b0111)))
(assert (fp.leq (fp #b1 #b011111 #b0111)
                arg1
                (fp #b1 #b011011 #b0000)))
; arg1 = -1.4375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b111 #b0000)
                expect
                (fp #b1 #b011 #b0111)))
(assert (fp.leq (fp #b1 #b011 #b0111)
                expect
                (fp #b1 #b000 #b1111)))
; expect = -1.4375

(assert (= expect result))

(check-sat)
(exit)
