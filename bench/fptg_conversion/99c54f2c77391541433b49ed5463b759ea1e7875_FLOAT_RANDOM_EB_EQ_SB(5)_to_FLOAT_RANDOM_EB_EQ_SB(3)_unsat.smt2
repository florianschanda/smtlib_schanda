(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b010100101)
                arg1
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg1
                (fp #b0 #b0111101001 #b011001111)))

(declare-const result (_ FloatingPoint 6 6))
(assert (= result ((_ to_fp 6 6) rm arg1)))

(declare-const expect (_ FloatingPoint 6 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
