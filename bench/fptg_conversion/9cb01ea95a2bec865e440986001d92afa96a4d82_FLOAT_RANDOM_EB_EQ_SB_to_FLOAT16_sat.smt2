; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011101111 #b11111110)
                arg1
                (fp #b0 #b100000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000010 #b00100000)
                arg1
                (fp #b0 #b111010000 #b00000011)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00001 #b0111000011)
                expect
                (fp #b0 #b10010 #b0010000000)))
(assert (fp.leq (fp #b0 #b10010 #b0010000000)
                expect
                (fp #b0 #b10111 #b1111101000)))
; expect = 9.0

(assert (= expect result))

(check-sat)
(exit)
