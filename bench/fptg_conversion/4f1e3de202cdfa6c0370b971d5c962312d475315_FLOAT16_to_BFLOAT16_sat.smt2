(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0001110100)
                arg1
                (fp #b0 #b01111 #b0111111110)))
(assert (fp.leq (fp #b0 #b01111 #b0111111110)
                arg1
                (fp #b0 #b11110 #b1110110011)))
; arg1 = 1.498046875

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10000000 #b0111111)
                expect
                (fp #b0 #b01111111 #b1000000)))
(assert (fp.leq (fp #b0 #b01111111 #b1000000)
                expect
                (fp #b0 #b10110001 #b1101001)))
; expect = 1.5

(assert (= expect result))

(check-sat)
(exit)
