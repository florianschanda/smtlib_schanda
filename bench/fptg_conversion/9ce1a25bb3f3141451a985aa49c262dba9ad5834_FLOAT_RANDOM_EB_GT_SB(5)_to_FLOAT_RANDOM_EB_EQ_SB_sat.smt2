(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0110101011101001 #b01111)
                arg1
                (fp #b0 #b0000000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000)
                arg1
                (fp #b0 #b1011111001110101 #b00011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000011000100 #b1001011000001)
                expect
                (fp #b0 #b00000000000000 #b0000000000001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000001)
                expect
                (fp #b0 #b01011101110000 #b0011101011010)))

(assert (= expect result))

(check-sat)
(exit)
