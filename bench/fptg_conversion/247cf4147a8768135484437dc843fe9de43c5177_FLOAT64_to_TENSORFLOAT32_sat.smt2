; Format from: FLOAT64
; Format to: TENSORFLOAT32
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100011011 #b1111101110111100110101010111011111000111011001110000)
                arg1
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b1 #b10000100011 #b1111111001010011011000001110000011100110001110010010)))

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
