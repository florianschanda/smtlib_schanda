; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101111 #b0101000111011100)
                arg1
                (fp #b0 #b1010010 #b1100101110011111)))
(assert (fp.leq (fp #b0 #b1010010 #b1100101110011111)
                arg1
                (fp #b0 #b1101011 #b1110010101010110)))
; arg1 = 941304.0

(declare-const result (_ FloatingPoint 11 2))
(assert (= result ((_ to_fp 11 2) rm arg1)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01011001100 #b1)
                expect
                (fp #b0 #b10000010011 #b0)))
(assert (fp.leq (fp #b0 #b10000010011 #b0)
                expect
                (fp #b0 #b11000101000 #b1)))

(assert (= expect result))

(check-sat)
(exit)
