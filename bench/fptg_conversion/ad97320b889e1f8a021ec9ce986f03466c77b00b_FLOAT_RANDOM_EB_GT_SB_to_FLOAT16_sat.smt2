; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 8 5))
(assert (fp.leq (fp #b1 #b00110011 #b1011)
                arg1
                (fp #b1 #b00000000 #b1100)))
(assert (fp.leq (fp #b1 #b00000000 #b1100)
                arg1
                (fp #b0 #b11010111 #b0100)))
; arg1 = -0.00000000000000000000000000000000000000881620763116715630976552402916684258363999167579065641131563779708812944591045379638671875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00111 #b1001001100)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00001 #b0111110001)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
