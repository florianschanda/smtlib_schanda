(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b011 #b1100)))
(assert (fp.leq (fp #b1 #b011 #b1100)
                arg1
                (fp #b0 #b010 #b0111)))
; arg1 = -1.75

(declare-const result (_ FloatingPoint 11 5))
(assert (= result ((_ to_fp 11 5) rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10011001101 #b0101)
                expect
                (fp #b1 #b01111111111 #b1100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100)
                expect
                (fp #b0 #b10011101110 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
