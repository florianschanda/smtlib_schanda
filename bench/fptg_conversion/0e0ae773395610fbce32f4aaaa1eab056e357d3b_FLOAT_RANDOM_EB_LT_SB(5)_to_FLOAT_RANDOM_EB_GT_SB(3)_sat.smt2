; Format from: FLOAT_RANDOM_EB_LT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 4 27))
(assert (fp.leq (fp #b1 #b0101 #b01000110010101110010010000)
                arg1
                (fp #b1 #b0001 #b00000100101010111000000000)))
(assert (fp.leq (fp #b1 #b0001 #b00000100101010111000000000)
                arg1
                (fp #b0 #b1001 #b10001111101010010001110101)))

(declare-const result (_ FloatingPoint 8 3))
(assert (= result ((_ to_fp 8 3) rm arg1)))

(declare-const expect (_ FloatingPoint 8 3))
(assert (fp.leq (fp #b1 #b11011111 #b10)
                expect
                (fp #b1 #b01111001 #b01)))
(assert (fp.leq (fp #b1 #b01111001 #b01)
                expect
                (fp #b0 #b10001100 #b11)))
; expect = -0.01953125

(assert (= expect result))

(check-sat)
(exit)
