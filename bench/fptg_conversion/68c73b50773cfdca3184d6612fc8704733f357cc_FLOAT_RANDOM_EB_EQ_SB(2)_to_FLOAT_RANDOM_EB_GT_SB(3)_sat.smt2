(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01111000011 #b0011110100)
                arg1
                (fp #b0 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b00100100100 #b0111000000)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result ((_ to_fp 13 12) rm arg1)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1110010011110 #b01110110011)
                expect
                (fp #b0 #b0000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000000000)
                expect
                (fp #b0 #b0100000001011 #b01010101000)))

(assert (= expect result))

(check-sat)
(exit)
