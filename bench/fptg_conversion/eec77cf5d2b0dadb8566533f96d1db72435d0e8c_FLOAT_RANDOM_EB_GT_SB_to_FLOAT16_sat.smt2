(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RCP_LARGEST_NORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110110110 #b11)
                arg1
                (fp #b0 #b0000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000 #b01)
                arg1
                (fp #b0 #b1110111011 #b01)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00011 #b1001001101)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01001 #b0101001000)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
