(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11101110 #b01000000001110000110110)
                arg1
                (fp #b1 #b10101010 #b10011101001111001101100)))
(assert (fp.leq (fp #b1 #b10101010 #b10011101001111001101100)
                arg1
                (fp #b1 #b00111001 #b10110100010110000100111)))
; arg1 = -14198738255872.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10101110 #b101001110100111)
                expect
                (fp #b1 #b10101010 #b100111010011111)))
(assert (fp.leq (fp #b1 #b10101010 #b100111010011111)
                expect
                (fp #b1 #b00111011 #b000011010101110)))
; expect = -14198893445120.0

(assert (= expect result))

(check-sat)
(exit)
