(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: BFLOAT16
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00001100 #b0010110)
                arg1
                (fp #b0 #b10000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000111 #b0000000)
                arg1
                (fp #b0 #b11011000 #b0001000)))
; arg1 = 256.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00001100 #b10000011000111001110100)
                expect
                (fp #b0 #b10000111 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000111 #b00000000000000000000000)
                expect
                (fp #b0 #b11100001 #b11001000011001011011100)))
; expect = 256.0

(assert (= expect result))

(check-sat)
(exit)
