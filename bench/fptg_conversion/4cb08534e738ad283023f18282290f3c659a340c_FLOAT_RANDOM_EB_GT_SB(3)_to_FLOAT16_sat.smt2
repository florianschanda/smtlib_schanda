; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b010110000101111 #b0011001101011)
                arg1
                (fp #b0 #b000000000000000 #b1000101001110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1000101001110)
                arg1
                (fp #b0 #b010101100111001 #b1010100101001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01011 #b1110111111)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b11010 #b0010110000)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
