(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010111 #b00101101)
                expect
                (fp #b0 #b011111101 #b01110000)))
(assert (fp.leq (fp #b0 #b011111101 #b01110000)
                expect
                (fp #b0 #b100010101 #b11010011)))

(assert (= expect result))

(check-sat)
