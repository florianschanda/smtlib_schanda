; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100000010 #b0000001)
                arg1
                (fp #b0 #b0111010000 #b0010000)))
(assert (fp.leq (fp #b0 #b0111010000 #b0010000)
                arg1
                (fp #b0 #b1110100001 #b0000010)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.leq (fp #b1 #b0001 #b111)
                expect
                (fp #b0 #b0000 #b001)))
(assert (fp.leq (fp #b0 #b0000 #b001)
                expect
                (fp #b0 #b0001 #b100)))
; expect = 0.001953125

(assert (not (= expect result)))

(check-sat)
(exit)
