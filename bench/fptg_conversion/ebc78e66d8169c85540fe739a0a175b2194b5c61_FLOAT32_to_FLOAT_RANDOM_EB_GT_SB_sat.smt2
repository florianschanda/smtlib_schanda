; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01100010111111001000111)
                arg1
                (fp #b1 #b10010011 #b01000001011100001000000)))
(assert (fp.leq (fp #b1 #b10010011 #b01000001011100001000000)
                arg1
                (fp #b1 #b01111111 #b01001010111001100111110)))
; arg1 = -1316616.0

(declare-const result (_ FloatingPoint 17 7))
(assert (= result ((_ to_fp 17 7) rm arg1)))

(declare-const expect (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b11100000101111110 #b000110)
                expect
                (fp #b1 #b10000000000010011 #b010001)))
(assert (fp.leq (fp #b1 #b10000000000010011 #b010001)
                expect
                (fp #b0 #b01000011101000010 #b000111)))

(assert (= expect result))

(check-sat)
(exit)
