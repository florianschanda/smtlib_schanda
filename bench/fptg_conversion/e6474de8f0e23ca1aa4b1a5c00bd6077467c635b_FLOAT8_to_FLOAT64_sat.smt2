; Format from: FLOAT8
; Format to: FLOAT64
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b0 #b011 #b0001)
                arg1
                (fp #b0 #b110 #b1110)))
(assert (fp.leq (fp #b0 #b110 #b1110)
                arg1
                (fp #b0 #b110 #b1111)))
; arg1 = 15.0

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01110110100 #b0110000000111111101101000001100100110010001010001100)
                expect
                (fp #b0 #b10000000010 #b1110000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000010 #b1110000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10000001001 #b0110101011011001000100101100001010101010001101111011)))

(assert (= expect result))

(check-sat)
(exit)
