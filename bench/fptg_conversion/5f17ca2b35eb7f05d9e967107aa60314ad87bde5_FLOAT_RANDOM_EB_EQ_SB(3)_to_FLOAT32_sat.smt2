(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000010000111100 #b001110111000011)
                arg1
                (fp #b1 #b0000000000000000 #b010000000000000)))
