(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b10110111 #b10111010010010111010110)
                arg1
                (fp #b0 #b10100010 #b10011110101000110011100)))
(assert (fp.leq (fp #b0 #b10100010 #b10011110101000110011100)
                arg1
                (fp #b0 #b11100000 #b11111010011110101011101)))
; arg1 = 55651713024.0

(declare-const result (_ FloatingPoint 12 13))
(assert (= result ((_ to_fp 12 13) rm arg1)))

(declare-const expect (_ FloatingPoint 12 13))
(assert (fp.leq (fp #b0 #b001110010011 #b001001101101)
                expect
                (fp #b0 #b100000100010 #b100111101011)))
(assert (fp.leq (fp #b0 #b100000100010 #b100111101011)
                expect
                (fp #b0 #b100011000011 #b001001001001)))

(assert (= expect result))

(check-sat)
(exit)
