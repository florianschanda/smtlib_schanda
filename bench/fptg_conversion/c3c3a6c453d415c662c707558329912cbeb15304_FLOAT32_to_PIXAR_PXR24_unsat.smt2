                arg1
                (fp #b0 #b11100110 #b10100101110011100101010)))
(assert (fp.leq (fp #b0 #b11100110 #b10100101110011100101010)
                arg1
                (fp #b0 #b11111010 #b10011100111110110101100)))
; arg1 = 16709455940148665419944991653888.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b00111100 #b100000011000110)
                expect
                (fp #b0 #b11100110 #b101001011101000)))
(assert (fp.leq (fp #b0 #b11100110 #b101001011101000)
                expect
                (fp #b0 #b11111010 #b100100011000100)))
; expect = 16709714650274062950588378775552.0

(assert (not (= expect result)))

(check-sat)
(exit)
