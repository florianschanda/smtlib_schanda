; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: +RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000111001111010 #b000110100011000)
                arg1
                (fp #b0 #b0000000000000000 #b110011001100100)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110011001100100)
                arg1
                (fp #b0 #b1001011001001110 #b010011110100000)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0000101100)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b00011 #b1100110111)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
