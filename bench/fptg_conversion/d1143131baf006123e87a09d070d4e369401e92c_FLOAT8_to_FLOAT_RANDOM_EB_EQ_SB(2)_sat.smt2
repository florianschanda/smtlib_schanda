; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.isNaN arg1))
; arg1 = NaN

(declare-const result (_ FloatingPoint 14 14))
(assert (= result ((_ to_fp 14 14) rm arg1)))

