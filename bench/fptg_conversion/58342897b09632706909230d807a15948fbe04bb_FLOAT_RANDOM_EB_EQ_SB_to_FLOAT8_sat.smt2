(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00111001101000 #b1011010010011)
                arg1
                (fp #b0 #b00011001000010 #b1111000110001)))
(assert (fp.leq (fp #b0 #b00011001000010 #b1111000110001)
                arg1
                (fp #b0 #b00101111011011 #b1101000110011)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b000 #b0111)
                expect
                (fp #b0 #b000 #b0001)))
(assert (fp.leq (fp #b0 #b000 #b0001)
                expect
                (fp #b0 #b011 #b1111)))
; expect = 0.015625

(assert (= expect result))

(check-sat)
