(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1001110101001011 #b10110101)
                arg1
                (fp #b0 #b0000000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000001)
                arg1
                (fp #b0 #b1100001011011110 #b01100111)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b00100 #b1101101001)
                expect
                (fp #b0 #b00000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000 #b0000000001)
                expect
                (fp #b0 #b01000 #b0110000100)))
; expect = 0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
