(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11110 #b0101001010)
                arg1
                (fp #b1 #b11101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0000000000)
                arg1
                (fp #b0 #b01101 #b1101100111)))
; arg1 = -16384.0

(declare-const result (_ FloatingPoint 9 7))
(assert (= result ((_ to_fp 9 7) rm arg1)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101001100 #b001010)
                expect
                (fp #b1 #b100001101 #b000000)))
(assert (fp.leq (fp #b1 #b100001101 #b000000)
                expect
                (fp #b0 #b110101001 #b010111)))

(assert (= expect result))

(check-sat)
(exit)
