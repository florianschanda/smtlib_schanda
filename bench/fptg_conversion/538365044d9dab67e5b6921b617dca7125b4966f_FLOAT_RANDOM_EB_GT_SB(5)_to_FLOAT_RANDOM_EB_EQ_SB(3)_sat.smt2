(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101100100 #b1111100)
                arg1
                (fp #b1 #b100000110 #b0011101)))
(assert (fp.leq (fp #b1 #b100000110 #b0011101)
                arg1
                (fp #b0 #b001100001 #b1000011)))

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11000 #b1110)
                expect
                (fp #b1 #b10110 #b0100)))
(assert (fp.leq (fp #b1 #b10110 #b0100)
                expect
                (fp #b1 #b01010 #b0010)))
; expect = -160.0

(assert (= expect result))

(check-sat)
(exit)
