(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b001 #b0011)))
(assert (fp.leq (fp #b1 #b001 #b0011)
                arg1
                (fp #b0 #b100 #b1001)))
; arg1 = -0.296875

(declare-const result (_ FloatingPoint 5 5))
(assert (= result ((_ to_fp 5 5) rm arg1)))

(declare-const expect (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b11011 #b1000)
                expect
                (fp #b1 #b01101 #b0011)))
(assert (fp.leq (fp #b1 #b01101 #b0011)
                expect
                (fp #b1 #b00101 #b0111)))
; expect = -0.296875

(assert (= expect result))

(check-sat)
