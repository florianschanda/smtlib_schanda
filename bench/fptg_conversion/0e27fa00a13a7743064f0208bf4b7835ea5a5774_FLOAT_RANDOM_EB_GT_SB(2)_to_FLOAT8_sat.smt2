(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 7))
(assert (fp.leq (fp #b1 #b10100100 #b111011)
                arg1
                (fp #b1 #b10000101 #b011101)))
(assert (fp.leq (fp #b1 #b10000101 #b011101)
                arg1
                (fp #b0 #b01001110 #b000011)))
; arg1 = -93.0

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
