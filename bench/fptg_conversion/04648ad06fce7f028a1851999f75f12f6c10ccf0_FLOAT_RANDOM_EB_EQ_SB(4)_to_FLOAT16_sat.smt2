; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10011101101110011 #b0010010010111111)
                arg1
                (fp #b1 #b01111111111111111 #b0100101010101100)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0100101010101100)
                arg1
                (fp #b0 #b10010001011110001 #b0000010100010010)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b0110110010)
                expect
                (fp #b1 #b01111 #b0100101011)))
(assert (fp.leq (fp #b1 #b01111 #b0100101011)
                expect
                (fp #b0 #b00001 #b0111111111)))
; expect = -1.2919921875

(assert (= expect result))

