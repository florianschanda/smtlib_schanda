(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT8
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 5 4))
(assert (fp.leq (fp #b1 #b00010 #b100)
                arg1
                (fp #b1 #b00000 #b011)))
(assert (fp.leq (fp #b1 #b00000 #b011)
                arg1
                (fp #b0 #b11000 #b001)))
; arg1 = -0.00002288818359375

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                expect
                (fp #b1 #b000 #b0001)))
(assert (fp.leq (fp #b1 #b000 #b0001)
                expect
                (fp #b0 #b001 #b0101)))
; expect = -0.015625

(assert (= expect result))

(check-sat)
(exit)
