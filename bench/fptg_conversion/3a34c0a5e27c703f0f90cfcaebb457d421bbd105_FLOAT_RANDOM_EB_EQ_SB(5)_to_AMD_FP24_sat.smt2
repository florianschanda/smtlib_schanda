; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: AMD_FP24
; Arg1: +ONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 5))
(assert (fp.leq (fp #b1 #b01001 #b1101)
                arg1
                (fp #b0 #b01111 #b0000)))
(assert (fp.leq (fp #b0 #b01111 #b0000)
                arg1
                (fp #b0 #b11011 #b1101)))
; arg1 = 1.0

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0000001 #b1111000001101111)
                expect
                (fp #b0 #b0111111 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b0111111 #b0000000000000000)
                expect
                (fp #b0 #b1001000 #b0000101110000001)))
; expect = 1.0

(assert (= expect result))

(check-sat)
(exit)
