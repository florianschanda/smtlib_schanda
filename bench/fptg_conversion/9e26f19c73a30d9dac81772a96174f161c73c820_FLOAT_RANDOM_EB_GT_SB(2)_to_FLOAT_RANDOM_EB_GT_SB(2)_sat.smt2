(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100101001 #b010)
                arg1
                (fp #b0 #b1011110101 #b000)))
(assert (fp.leq (fp #b0 #b1011110101 #b000)
                arg1
                (fp #b0 #b1111011010 #b100)))

(declare-const result (_ FloatingPoint 7 6))
(assert (= result ((_ to_fp 7 6) rm arg1)))

(declare-const expect (_ FloatingPoint 7 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (= expect result))

(check-sat)
(exit)
