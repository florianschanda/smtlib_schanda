(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11001 #b0101111001)
                arg1
                (fp #b0 #b11100 #b1010000001)))
(assert (fp.leq (fp #b0 #b11100 #b1010000001)
                arg1
                (fp #b0 #b11110 #b0001110111)))
; arg1 = 13320.0

(declare-const result (_ FloatingPoint 18 4))
(assert (= result ((_ to_fp 18 4) rm arg1)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b100010110001001100 #b001)
                expect
                (fp #b0 #b100000000000001100 #b110)))
(assert (fp.leq (fp #b0 #b100000000000001100 #b110)
                expect
                (fp #b0 #b111011110100011010 #b100)))

(assert (= expect result))

(check-sat)
(exit)
