(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: BFLOAT16
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1001011000)
                arg1
                (fp #b0 #b11100 #b1101000111)))
(assert (fp.leq (fp #b0 #b11100 #b1101000111)
                arg1
                (fp #b0 #b11100 #b1101010101)))
; arg1 = 14904.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b00010011 #b1011110)
                expect
                (fp #b0 #b10001100 #b1101001)))
(assert (fp.leq (fp #b0 #b10001100 #b1101001)
                expect
                (fp #b0 #b11110100 #b1011001)))
; expect = 14912.0

(assert (not (= expect result)))

(check-sat)
(exit)
