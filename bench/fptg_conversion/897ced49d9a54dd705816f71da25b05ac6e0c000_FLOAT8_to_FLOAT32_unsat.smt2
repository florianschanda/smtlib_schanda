(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1101)
                arg1
                (fp #b1 #b110 #b1100)))
(assert (fp.leq (fp #b1 #b110 #b1100)
                arg1
                (fp #b1 #b110 #b0001)))
; arg1 = -14.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11011101 #b10010100101010011001111)
                expect
                (fp #b1 #b10000010 #b11000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000010 #b11000000000000000000000)
                expect
                (fp #b0 #b10000111 #b11101111010101100011100)))
; expect = -14.0

(assert (not (= expect result)))

(check-sat)
(exit)
