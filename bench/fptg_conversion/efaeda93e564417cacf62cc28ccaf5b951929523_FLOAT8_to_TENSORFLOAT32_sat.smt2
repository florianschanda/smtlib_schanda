(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0111)
                arg1
                (fp #b0 #b101 #b1000)))
(assert (fp.leq (fp #b0 #b101 #b1000)
                arg1
                (fp #b0 #b110 #b1101)))
; arg1 = 6.0

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b11101111 #b1101100000)
                expect
                (fp #b0 #b10000001 #b1000000000)))
(assert (fp.leq (fp #b0 #b10000001 #b1000000000)
                expect
                (fp #b0 #b11100011 #b0110101010)))
; expect = 6.0

(assert (= expect result))

(check-sat)
(exit)
