(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11100 #b0111101010)
                expect
                (fp #b0 #b01111 #b0010000111)))
(assert (fp.leq (fp #b0 #b01111 #b0010000111)
                expect
                (fp #b0 #b11001 #b1010000000)))
; expect = 1.1318359375

(assert (not (= expect result)))

(check-sat)
