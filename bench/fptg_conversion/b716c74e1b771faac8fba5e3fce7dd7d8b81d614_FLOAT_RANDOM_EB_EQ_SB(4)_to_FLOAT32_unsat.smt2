; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: +RANDOM_GT_INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 3))
(assert (fp.leq (fp #b1 #b101 #b11)
                arg1
                (fp #b0 #b110 #b10)))
(assert (fp.leq (fp #b0 #b110 #b10)
                arg1
                (fp #b0 #b110 #b11)))
; arg1 = 12.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01111110 #b00101110000100111010100)
                expect
                (fp #b0 #b10000010 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000010 #b10000000000000000000000)
                expect
                (fp #b0 #b11001110 #b01110110010111000101011)))
; expect = 12.0

(assert (not (= expect result)))

(check-sat)
(exit)
