(assert (fp.leq (fp #b1 #b10001111 #b1101010)
                expect
                (fp #b1 #b10001110 #b1011000)))
(assert (fp.leq (fp #b1 #b10001110 #b1011000)
                expect
                (fp #b1 #b00110100 #b0100010)))
; expect = -55296.0

(assert (= expect result))

(check-sat)
