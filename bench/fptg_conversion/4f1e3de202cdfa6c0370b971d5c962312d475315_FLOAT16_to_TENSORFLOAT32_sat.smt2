(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b00001000 #b1101101001)
                expect
                (fp #b0 #b01111111 #b0111111110)))
(assert (fp.leq (fp #b0 #b01111111 #b0111111110)
                expect
                (fp #b0 #b10110011 #b1101001001)))
; expect = 1.498046875

(assert (= expect result))

(check-sat)
