; Format from: FLOAT16
; Format to: TENSORFLOAT32
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11000 #b0001110100)
                arg1
                (fp #b0 #b01111 #b0111111110)))
(assert (fp.leq (fp #b0 #b01111 #b0111111110)
                arg1
                (fp #b0 #b11110 #b1110110011)))
