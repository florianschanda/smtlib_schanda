; Format from: TENSORFLOAT32
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10010011 #b1101101111)
                arg1
                (fp #b1 #b00000000 #b0101100101)))
(assert (fp.leq (fp #b1 #b00000000 #b0101100101)
                arg1
                (fp #b0 #b11011001 #b1100000011)))
; arg1 = -0.0000000000000000000000000000000000000040981590160503578158675678104330244822389023805433129411975035072401851721224375069141387939453125

(declare-const result (_ FloatingPoint 15 2))
(assert (= result ((_ to_fp 15 2) rm arg1)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b101001011111110 #b0)
                expect
                (fp #b1 #b011111101111111 #b1)))
(assert (fp.leq (fp #b1 #b011111101111111 #b1)
                expect
                (fp #b0 #b100111111100101 #b0)))

(assert (= expect result))

(check-sat)
(exit)
