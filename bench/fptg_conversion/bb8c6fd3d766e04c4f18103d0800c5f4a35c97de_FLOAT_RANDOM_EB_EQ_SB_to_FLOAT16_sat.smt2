(assert (fp.leq (fp #b0 #b01000 #b0100001100)
                expect
                (fp #b0 #b10110 #b1111000000)))
(assert (fp.leq (fp #b0 #b10110 #b1111000000)
                expect
                (fp #b0 #b11010 #b1010001101)))
; expect = 248.0

(assert (= expect result))

(check-sat)
