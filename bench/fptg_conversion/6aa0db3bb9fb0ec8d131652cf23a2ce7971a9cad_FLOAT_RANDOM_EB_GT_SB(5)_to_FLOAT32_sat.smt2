(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +RCP_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 2))
(assert (fp.leq (fp #b0 #b1000 #b1)
                arg1
                (fp #b0 #b1101 #b0)))
(assert (fp.leq (fp #b0 #b1101 #b0)
                arg1
                (fp #b0 #b1110 #b1)))
; arg1 = 64.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10111110 #b10011001100011111100000)
                expect
                (fp #b0 #b10000101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000101 #b00000000000000000000000)
                expect
                (fp #b0 #b10110110 #b01010100010000111111101)))
; expect = 64.0

(assert (= expect result))

(check-sat)
(exit)
