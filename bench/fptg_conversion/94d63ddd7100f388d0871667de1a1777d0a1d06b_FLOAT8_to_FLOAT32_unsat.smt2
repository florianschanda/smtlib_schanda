(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: +RANDOM_SUBNORMAL(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b001 #b0000)
                arg1
                (fp #b0 #b000 #b1100)))
(assert (fp.leq (fp #b0 #b000 #b1100)
                arg1
                (fp #b0 #b011 #b0110)))
; arg1 = 0.1875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11110101 #b00111110011100001111111)
                expect
                (fp #b0 #b01111100 #b10000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111100 #b10000000000000000000000)
                expect
                (fp #b0 #b11000100 #b01100110111001000100100)))
; expect = 0.1875

(assert (not (= expect result)))

(check-sat)
(exit)
