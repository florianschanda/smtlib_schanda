                expect
                (fp #b1 #b100000000000010 #b11000000000000)))
(assert (fp.leq (fp #b1 #b100000000000010 #b11000000000000)
                expect
                (fp #b0 #b000101010101010 #b11010110001101)))

(assert (= expect result))

