(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b100110011011000 #b001010001101001011101111110101000010101000001001010000010100100)
                expect
                (fp #b0 #b100000000001100 #b100101001100000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b100000000001100 #b100101001100000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b101100001011101 #b001001111100010101111111110111111011001011010010111110110111010)))

(assert (= expect result))

(check-sat)
(exit)
