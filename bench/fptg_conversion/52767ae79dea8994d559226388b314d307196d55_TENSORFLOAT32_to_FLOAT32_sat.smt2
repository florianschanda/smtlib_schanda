(set-info :category "random")
(set-info :status sat)

; Format from: TENSORFLOAT32
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10011100 #b0101101001)
                arg1
                (fp #b1 #b01111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111 #b0011010000)
                arg1
                (fp #b0 #b00011111 #b1000111011)))
; arg1 = -1.203125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b10010101 #b00111000011010001011111)
                expect
                (fp #b1 #b01111111 #b00110100000000000000000)))
(assert (fp.leq (fp #b1 #b01111111 #b00110100000000000000000)
                expect
                (fp #b0 #b01100000 #b00011010100100110110011)))
; expect = -1.203125

(assert (= expect result))

(check-sat)
(exit)
