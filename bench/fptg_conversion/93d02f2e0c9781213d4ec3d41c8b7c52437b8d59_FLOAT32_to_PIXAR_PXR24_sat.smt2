(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11110000 #b01011001110001011000100)
                arg1
                (fp #b1 #b10010110 #b11111101100111110110000)))
(assert (fp.leq (fp #b1 #b10010110 #b11111101100111110110000)
                arg1
                (fp #b1 #b10000010 #b11100101010111000100101)))
; arg1 = -16699312.0

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011010 #b101110010000011)
                expect
                (fp #b1 #b10010110 #b111111011010000)))
(assert (fp.leq (fp #b1 #b10010110 #b111111011010000)
                expect
                (fp #b0 #b01101000 #b011111010100110)))
; expect = -16699392.0

(assert (= expect result))

(check-sat)
(exit)
