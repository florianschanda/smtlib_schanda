; Format from: AMD_FP24
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0001101 #b0111101001101110)
                arg1
                (fp #b0 #b1100011 #b1101001011011111)))
(assert (fp.leq (fp #b0 #b1100011 #b1101001011011111)
                arg1
                (fp #b0 #b1110111 #b1000010010000101)))
; arg1 = 125324754944.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111000000 #b000100011)
                expect
                (fp #b0 #b1000100011 #b110100110)))
(assert (fp.leq (fp #b0 #b1000100011 #b110100110)
                expect
                (fp #b0 #b1111010001 #b000111010)))

(assert (= expect result))

(check-sat)
(exit)
