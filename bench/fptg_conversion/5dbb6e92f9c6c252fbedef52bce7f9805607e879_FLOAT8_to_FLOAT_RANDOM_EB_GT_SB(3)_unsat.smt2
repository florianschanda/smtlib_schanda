; Format from: FLOAT8
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b1000)
                arg1
                (fp #b1 #b101 #b0001)))
(assert (fp.leq (fp #b1 #b101 #b0001)
                arg1
                (fp #b1 #b011 #b0000)))
; arg1 = -4.25

(declare-const result (_ FloatingPoint 9 3))
(assert (= result ((_ to_fp 9 3) rm arg1)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110010011 #b11)
                expect
                (fp #b1 #b100000001 #b01)))
(assert (fp.leq (fp #b1 #b100000001 #b01)
                expect
                (fp #b0 #b000011111 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
