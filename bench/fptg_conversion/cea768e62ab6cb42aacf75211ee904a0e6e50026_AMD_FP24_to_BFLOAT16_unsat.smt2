(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: AMD_FP24
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b0 #b0101010 #b1001101011100111)
                arg1
                (fp #b0 #b1001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b1001111 #b0010101011110000)
                arg1
                (fp #b0 #b1100101 #b1101110011111101)))
; arg1 = 76528.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b10001001 #b0010101)
                expect
                (fp #b0 #b10001111 #b0010110)))
(assert (fp.leq (fp #b0 #b10001111 #b0010110)
                expect
                (fp #b0 #b10111010 #b1101111)))
; expect = 76800.0

(assert (not (= expect result)))

(check-sat)
(exit)
