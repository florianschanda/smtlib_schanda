(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: BFLOAT16
; Format to: FLOAT32
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b01111001 #b1110000)
                arg1
                (fp #b0 #b10000110 #b1001000)))
(assert (fp.leq (fp #b0 #b10000110 #b1001000)
                arg1
                (fp #b0 #b11101001 #b0100000)))
; arg1 = 200.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b0 #b00111001 #b00111011000101001010111)
                expect
                (fp #b0 #b10000110 #b10010000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110 #b10010000000000000000000)
                expect
                (fp #b0 #b10111100 #b00111001001010100110011)))
; expect = 200.0

(assert (not (= expect result)))

(check-sat)
(exit)
