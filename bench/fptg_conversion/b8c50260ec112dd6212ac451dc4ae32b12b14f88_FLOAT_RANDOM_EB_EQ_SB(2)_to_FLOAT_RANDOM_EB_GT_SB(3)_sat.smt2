; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111000010111100 #b000001111100111)
                arg1
                (fp #b1 #b0000000000000000 #b000111101010100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000111101010100)
                arg1
                (fp #b0 #b0011010010011010 #b000111011100001)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result ((_ to_fp 9 4) rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000101100 #b111)
                expect
                (fp #b1 #b000000000 #b001)))
(assert (fp.leq (fp #b1 #b000000000 #b001)
                expect
                (fp #b0 #b001011011 #b101)))

(assert (= expect result))

(check-sat)
(exit)
