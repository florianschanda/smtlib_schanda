; Format from: AMD_FP24
; Format to: FLOAT32
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1010010 #b0111110001100010)
                arg1
                (fp #b1 #b0100000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0100000 #b0000000000000000)
                arg1
                (fp #b0 #b0010101 #b1001011001100000)))
; arg1 = -0.0000000004656612873077392578125

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001100 #b00001010111110101100100)
                expect
                (fp #b1 #b01100000 #b00000000000000000000000)))
(assert (fp.leq (fp #b1 #b01100000 #b00000000000000000000000)
                expect
                (fp #b1 #b01000001 #b11100000011110111011111)))
; expect = -0.0000000004656612873077392578125

(assert (not (= expect result)))

(check-sat)
(exit)
