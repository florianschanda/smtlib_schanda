(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: BFLOAT16
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b011000100 #b0)
                arg1
                (fp #b0 #b100000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000 #b1)
                arg1
                (fp #b0 #b101101101 #b0)))

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b0 #b00110010 #b1000111)
                expect
                (fp #b0 #b10000000 #b1000000)))
(assert (fp.leq (fp #b0 #b10000000 #b1000000)
                expect
                (fp #b0 #b11111001 #b1011100)))
; expect = 3.0

(assert (= expect result))

(check-sat)
(exit)
