; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: -RANDOM_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11011 #b0111110100)
                arg1
                (fp #b1 #b00000 #b1010010101)))
(assert (fp.leq (fp #b1 #b00000 #b1010010101)
                arg1
                (fp #b0 #b00011 #b1101100101)))
; arg1 = -0.000039398670196533203125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b11011110 #b110100111111110)
                expect
                (fp #b1 #b01110000 #b010010101000000)))
(assert (fp.leq (fp #b1 #b01110000 #b010010101000000)
                expect
                (fp #b0 #b10011111 #b011111001011011)))
; expect = -0.000039398670196533203125

(assert (= expect result))

(check-sat)
(exit)
