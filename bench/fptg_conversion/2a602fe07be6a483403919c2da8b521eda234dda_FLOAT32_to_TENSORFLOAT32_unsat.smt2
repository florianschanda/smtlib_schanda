(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b0 #b01100110 #b0010111000)
                expect
                (fp #b0 #b10111110 #b0110011010)))
(assert (fp.leq (fp #b0 #b10111110 #b0110011010)
                expect
                (fp #b0 #b11000100 #b1101100101)))
; expect = 12916323731298582528.0

(assert (not (= expect result)))

