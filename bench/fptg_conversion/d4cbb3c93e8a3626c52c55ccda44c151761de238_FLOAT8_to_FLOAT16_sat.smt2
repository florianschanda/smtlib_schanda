(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT8
; Format to: FLOAT16
; Arg1: +SQRT_SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b0000)
                arg1
                (fp #b0 #b000 #b1000)))
(assert (fp.leq (fp #b0 #b000 #b1000)
                arg1
                (fp #b0 #b011 #b1101)))
; arg1 = 0.125

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10010 #b1011110110)
                expect
                (fp #b0 #b01100 #b0000000000)))
(assert (fp.leq (fp #b0 #b01100 #b0000000000)
                expect
                (fp #b0 #b11001 #b1001000000)))
; expect = 0.125

(assert (= expect result))

(check-sat)
(exit)
