; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011101 #b111010)
                arg1
                (fp #b1 #b1000101 #b110001)))
(assert (fp.leq (fp #b1 #b1000101 #b110001)
                arg1
                (fp #b0 #b1101100 #b011000)))
; arg1 = -113.0

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001110 #b10001100100001111101100)
                expect
                (fp #b1 #b10000101 #b11000100000000000000000)))
(assert (fp.leq (fp #b1 #b10000101 #b11000100000000000000000)
                expect
                (fp #b1 #b01111000 #b00101111010101100010101)))
; expect = -113.0

(assert (not (= expect result)))

(check-sat)
(exit)
