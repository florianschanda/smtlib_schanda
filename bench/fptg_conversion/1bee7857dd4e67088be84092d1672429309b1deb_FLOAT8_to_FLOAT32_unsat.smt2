; Format from: FLOAT8
; Format to: FLOAT32
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b110 #b0001)
                arg1
                (fp #b1 #b100 #b1111)))
(assert (fp.leq (fp #b1 #b100 #b1111)
                arg1
                (fp #b1 #b011 #b0101)))
; arg1 = -3.875

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11111110 #b00101000001111100011111)
                expect
                (fp #b1 #b10000000 #b11110000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000 #b11110000000000000000000)
                expect
                (fp #b0 #b00001011 #b01110010010110111111000)))
; expect = -3.875

(assert (not (= expect result)))

(check-sat)
(exit)
