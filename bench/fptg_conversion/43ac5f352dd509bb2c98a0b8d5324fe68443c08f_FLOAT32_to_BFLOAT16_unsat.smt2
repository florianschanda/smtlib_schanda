; Format from: FLOAT32
; Format to: BFLOAT16
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11100010 #b10000101111010111001011)
                arg1
                (fp #b1 #b11011011 #b11100111001001101100011)))
(assert (fp.leq (fp #b1 #b11011011 #b11100111001001101100011)
                arg1
                (fp #b1 #b10011101 #b11101011111111111001100)))
; arg1 = -9422879624544000785459970048.0

(declare-const result (_ FloatingPoint 8 8))
(assert (= result ((_ to_fp 8 8) rm arg1)))

(declare-const expect (_ FloatingPoint 8 8))
(assert (fp.leq (fp #b1 #b11111010 #b0011011)
                expect
                (fp #b1 #b11011011 #b1110100)))
(assert (fp.leq (fp #b1 #b11011011 #b1110100)
                expect
                (fp #b1 #b10000000 #b1111111)))
; expect = -9439292799551024596105822208.0

(assert (not (= expect result)))

(check-sat)
(exit)
