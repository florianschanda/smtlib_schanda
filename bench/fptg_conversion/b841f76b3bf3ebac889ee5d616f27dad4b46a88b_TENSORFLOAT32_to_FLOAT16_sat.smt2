; Format from: TENSORFLOAT32
; Format to: FLOAT16
; Arg1: +SMALLEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b01101001 #b1100110011)
                arg1
                (fp #b0 #b00000000 #b0000000001)))
