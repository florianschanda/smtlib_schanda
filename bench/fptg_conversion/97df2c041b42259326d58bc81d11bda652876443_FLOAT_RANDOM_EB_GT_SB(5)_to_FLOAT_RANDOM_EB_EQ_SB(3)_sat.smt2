; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 4))
(assert (fp.leq (fp #b1 #b10000010 #b001)
                arg1
                (fp #b1 #b01111111 #b100)))
(assert (fp.leq (fp #b1 #b01111111 #b100)
                arg1
                (fp #b0 #b01101101 #b010)))
; arg1 = -1.5

(declare-const result (_ FloatingPoint 7 7))
(assert (= result ((_ to_fp 7 7) rm arg1)))

(declare-const expect (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1011110 #b011011)
                expect
                (fp #b1 #b0111111 #b100000)))
(assert (fp.leq (fp #b1 #b0111111 #b100000)
                expect
                (fp #b1 #b0101000 #b010001)))
; expect = -1.5

(assert (= expect result))

(check-sat)
(exit)
