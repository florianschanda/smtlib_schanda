(assert (fp.leq (fp #b1 #b1011000101110 #b101101011110)
                expect
                (fp #b1 #b0111011111110 #b000000000000)))
(assert (fp.leq (fp #b1 #b0111011111110 #b000000000000)
                expect
                (fp #b0 #b1100111010111 #b110011011010)))

(assert (= expect result))

(check-sat)
