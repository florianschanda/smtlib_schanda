(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100010 #b00011111)
                expect
                (fp #b1 #b101011011 #b11101000)))
(assert (fp.leq (fp #b1 #b101011011 #b11101000)
                expect
                (fp #b1 #b011010001 #b11010111)))

(assert (= expect result))

(check-sat)
