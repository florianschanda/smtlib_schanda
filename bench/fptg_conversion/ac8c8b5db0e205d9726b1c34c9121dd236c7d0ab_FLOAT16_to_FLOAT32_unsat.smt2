(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b01001111 #b01000100001011100100101)
                expect
                (fp #b0 #b10001100 #b10100000010000000000000)))
(assert (fp.leq (fp #b0 #b10001100 #b10100000010000000000000)
                expect
                (fp #b0 #b11100110 #b00001110111110010010011)))
; expect = 13320.0

(assert (not (= expect result)))

(check-sat)
