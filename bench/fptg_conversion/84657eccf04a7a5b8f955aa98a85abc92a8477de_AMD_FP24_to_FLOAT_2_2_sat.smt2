; Format from: AMD_FP24
; Format to: FLOAT_2_2
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b0010100 #b1010100011001101)
                arg1
                (fp #b1 #b0000101 #b0111001100110100)))
(assert (fp.leq (fp #b1 #b0000101 #b0111001100110100)
                arg1
                (fp #b0 #b0011011 #b1010110000101011)))
