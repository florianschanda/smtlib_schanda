(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: AMD_FP24
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b10011011001011111111011)
                arg1
                (fp #b1 #b10000110 #b01010010101110101101100)))
(assert (fp.leq (fp #b1 #b10000110 #b01010010101110101101100)
                arg1
                (fp #b0 #b11101001 #b10011010000011111101000)))
; arg1 = -169.36492919921875

(declare-const result (_ FloatingPoint 7 17))
(assert (= result ((_ to_fp 7 17) rm arg1)))

(declare-const expect (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1100011 #b1111001111000100)
                expect
                (fp #b1 #b1000110 #b0101001010111011)))
(assert (fp.leq (fp #b1 #b1000110 #b0101001010111011)
                expect
                (fp #b0 #b0001111 #b0001010011001010)))
; expect = -169.365234375

(assert (= expect result))

(check-sat)
(exit)
