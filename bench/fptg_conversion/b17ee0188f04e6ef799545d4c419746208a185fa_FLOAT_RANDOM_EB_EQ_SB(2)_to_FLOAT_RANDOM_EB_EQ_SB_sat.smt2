(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101011111111 #b10010000100000)
                expect
                (fp #b0 #b011111111111101 #b00000000000000)))
(assert (fp.leq (fp #b0 #b011111111111101 #b00000000000000)
                expect
                (fp #b0 #b101110101100110 #b00100100010111)))

(assert (= expect result))

(check-sat)
