; Format from: AMD_FP24
; Format to: X87_EXTENDED_DOUBLE
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 17))
(assert (fp.leq (fp #b1 #b1111101 #b0011100101001010)
                arg1
                (fp #b1 #b1001110 #b1001100011111110)))
(assert (fp.leq (fp #b1 #b1001110 #b1001100011111110)
                arg1
                (fp #b0 #b0010010 #b1010111011100101)))
; arg1 = -52351.0

(declare-const result (_ FloatingPoint 15 64))
(assert (= result ((_ to_fp 15 64) rm arg1)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b100010010011111 #b010011010111000000100010100110101100111110011110111000111011001)
                expect
                (fp #b1 #b100000000001110 #b100110001111111000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000001110 #b100110001111111000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b111001100110110 #b010110000010110101111110010100000010001100011011001000110001001)))

(assert (= expect result))

(check-sat)
(exit)
