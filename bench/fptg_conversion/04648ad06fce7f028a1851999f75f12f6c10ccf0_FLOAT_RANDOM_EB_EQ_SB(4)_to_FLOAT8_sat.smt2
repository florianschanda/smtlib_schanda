(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT8
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10011101101110011 #b0010010010111111)
                arg1
                (fp #b1 #b01111111111111111 #b0100101010101100)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0100101010101100)
                arg1
                (fp #b0 #b10010001011110001 #b0000010100010010)))

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b011 #b1001)
                expect
                (fp #b1 #b011 #b0101)))
(assert (fp.leq (fp #b1 #b011 #b0101)
                expect
                (fp #b1 #b000 #b1100)))
; expect = -1.3125

(assert (= expect result))

(check-sat)
(exit)
