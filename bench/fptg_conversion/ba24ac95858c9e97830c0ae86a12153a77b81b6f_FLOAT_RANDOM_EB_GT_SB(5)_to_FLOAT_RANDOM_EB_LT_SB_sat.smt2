(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 2))
(assert (fp.leq (fp #b1 #b101 #b1)
                arg1
                (fp #b1 #b010 #b0)))
(assert (fp.leq (fp #b1 #b010 #b0)
                arg1
                (fp #b0 #b010 #b1)))
; arg1 = -0.5

(declare-const result (_ FloatingPoint 4 5))
(assert (= result ((_ to_fp 4 5) rm arg1)))

(declare-const expect (_ FloatingPoint 4 5))
(assert (fp.leq (fp #b1 #b1001 #b0100)
                expect
                (fp #b1 #b0110 #b0000)))
(assert (fp.leq (fp #b1 #b0110 #b0000)
                expect
                (fp #b0 #b0111 #b0110)))
; expect = -0.5

(assert (= expect result))

(check-sat)
(exit)
