; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01010101101 #b00001)
                arg1
                (fp #b0 #b11010111000 #b11101)))
(assert (fp.leq (fp #b0 #b11010111000 #b11101)
                arg1
                (fp #b0 #b11100000001 #b01111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result ((_ to_fp 9 4) rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
