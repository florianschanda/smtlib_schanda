; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT16
; Arg1: -LARGEST_SUBNORMAL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101000111110011 #b01101)
                arg1
                (fp #b1 #b000000000000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11111)
                arg1
                (fp #b0 #b100000011101101 #b01001)))

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b10111 #b1000111111)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b00011 #b0110001001)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
