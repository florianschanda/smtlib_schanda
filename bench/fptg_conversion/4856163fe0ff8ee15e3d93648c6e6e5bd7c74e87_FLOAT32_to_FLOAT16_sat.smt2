(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT32
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11111001 #b10011011001011111111011)
                arg1
                (fp #b1 #b10000110 #b01010010101110101101100)))
(assert (fp.leq (fp #b1 #b10000110 #b01010010101110101101100)
                arg1
                (fp #b0 #b11101001 #b10011010000011111101000)))
; arg1 = -169.36492919921875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b11010 #b1011010000)
                expect
                (fp #b1 #b10110 #b0101001011)))
(assert (fp.leq (fp #b1 #b10110 #b0101001011)
                expect
                (fp #b1 #b00100 #b0000010001)))
; expect = -169.375

(assert (= expect result))

(check-sat)
(exit)
