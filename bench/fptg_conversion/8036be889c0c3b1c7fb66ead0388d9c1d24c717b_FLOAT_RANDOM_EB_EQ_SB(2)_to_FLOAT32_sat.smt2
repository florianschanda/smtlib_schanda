; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111101100 #b01000010101)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b0 #b011001111100 #b11100001101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11010110 #b11011001100000001101100)
                expect
                (fp #b1 #b10100000 #b01101001011000000000000)))
(assert (fp.leq (fp #b1 #b10100000 #b01101001011000000000000)
                expect
                (fp #b0 #b01110001 #b00101101110010010100100)))
; expect = -12125732864.0

(assert (= expect result))

(check-sat)
(exit)
