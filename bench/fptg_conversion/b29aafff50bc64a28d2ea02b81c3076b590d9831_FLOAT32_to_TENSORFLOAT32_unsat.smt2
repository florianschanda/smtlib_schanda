(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT32
; Format to: TENSORFLOAT32
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float32)
(assert (fp.leq (fp #b1 #b11001010 #b11110011011001100001000)
                arg1
                (fp #b1 #b01111111 #b00001010011010000101100)))
(assert (fp.leq (fp #b1 #b01111111 #b00001010011010000101100)
                arg1
                (fp #b1 #b00101100 #b10010100011010110100011)))
; arg1 = -1.040654659271240234375

(declare-const result (_ FloatingPoint 8 11))
(assert (= result ((_ to_fp 8 11) rm arg1)))

(declare-const expect (_ FloatingPoint 8 11))
(assert (fp.leq (fp #b1 #b10001100 #b0000000000)
                expect
                (fp #b1 #b01111111 #b0000101010)))
(assert (fp.leq (fp #b1 #b01111111 #b0000101010)
                expect
                (fp #b0 #b01110000 #b0100010000)))
; expect = -1.041015625

(assert (not (= expect result)))

(check-sat)
(exit)
