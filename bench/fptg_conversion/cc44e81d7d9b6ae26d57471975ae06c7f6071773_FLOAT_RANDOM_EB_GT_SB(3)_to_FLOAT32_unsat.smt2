; Format from: FLOAT_RANDOM_EB_GT_SB
; Format to: FLOAT32
; Arg1: +INT_BOUNDARY

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b010001100 #b00011)
                arg1
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg1
                (fp #b0 #b100111000 #b00011)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b00111111 #b00000100010011010111100)
                expect
                (fp #b0 #b10000101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000101 #b00000000000000000000000)
                expect
                (fp #b0 #b11000010 #b01010010111101001111011)))
; expect = 64.0

(assert (not (= expect result)))

(check-sat)
(exit)
