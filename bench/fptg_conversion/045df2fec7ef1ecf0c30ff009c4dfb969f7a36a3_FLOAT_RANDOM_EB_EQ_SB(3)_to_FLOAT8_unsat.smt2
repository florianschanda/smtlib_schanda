                arg1
                (fp #b0 #b100 #b11)))
; arg1 = -1.25

(declare-const result (_ FloatingPoint 3 5))
(assert (= result ((_ to_fp 3 5) rm arg1)))

(declare-const expect (_ FloatingPoint 3 5))
(assert (fp.leq (fp #b1 #b100 #b1001)
                expect
                (fp #b1 #b011 #b0100)))
(assert (fp.leq (fp #b1 #b011 #b0100)
                expect
                (fp #b0 #b010 #b1101)))
; expect = -1.25

(assert (not (= expect result)))

(check-sat)
(exit)
