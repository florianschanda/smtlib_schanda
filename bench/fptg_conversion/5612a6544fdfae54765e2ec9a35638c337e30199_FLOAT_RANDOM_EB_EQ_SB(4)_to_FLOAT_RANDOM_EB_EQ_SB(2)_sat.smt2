(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000110000010 #b1000000101001)
                arg1
                (fp #b1 #b10000000001001 #b1001111010000)))
(assert (fp.leq (fp #b1 #b10000000001001 #b1001111010000)
                arg1
                (fp #b0 #b01100011011100 #b0000010110000)))

(declare-const result (_ FloatingPoint 4 4))
(assert (= result ((_ to_fp 4 4) rm arg1)))

(declare-const expect (_ FloatingPoint 4 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))
; expect = -Infinity

(assert (= expect result))

(check-sat)
(exit)
