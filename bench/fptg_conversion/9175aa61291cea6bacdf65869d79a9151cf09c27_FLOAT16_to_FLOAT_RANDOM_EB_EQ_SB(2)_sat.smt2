(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b01100 #b0000111111)
                arg1
                (fp #b0 #b10101 #b1011010000)))
(assert (fp.leq (fp #b0 #b10101 #b1011010000)
                arg1
                (fp #b0 #b11110 #b1001110011)))
; arg1 = 109.0

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010100000 #b101000001)
                expect
                (fp #b0 #b1000000101 #b101101000)))
(assert (fp.leq (fp #b0 #b1000000101 #b101101000)
                expect
                (fp #b0 #b1011111011 #b001011101)))

(assert (= expect result))

(check-sat)
(exit)
