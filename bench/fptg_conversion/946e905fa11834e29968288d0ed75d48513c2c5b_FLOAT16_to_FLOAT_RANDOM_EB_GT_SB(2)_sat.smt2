; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11100 #b1111011110)
                arg1
                (fp #b1 #b11001 #b1100010001)))
(assert (fp.leq (fp #b1 #b11001 #b1100010001)
                arg1
                (fp #b0 #b10100 #b0001011101)))
; arg1 = -1809.0

(declare-const result (_ FloatingPoint 14 11))
(assert (= result ((_ to_fp 14 11) rm arg1)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b10100000011000 #b1100010000)
                expect
                (fp #b1 #b10000000001001 #b1100010001)))
(assert (fp.leq (fp #b1 #b10000000001001 #b1100010001)
                expect
                (fp #b1 #b01010011010011 #b0110101100)))

(assert (= expect result))

(check-sat)
(exit)
