(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b00001 #b0010101111)
                arg1
                (fp #b0 #b11011 #b0101101000)))
(assert (fp.leq (fp #b0 #b11011 #b0101101000)
                arg1
                (fp #b0 #b11011 #b1110111100)))
; arg1 = 5536.0

(declare-const result (_ FloatingPoint 3 3))
(assert (= result ((_ to_fp 3 3) rm arg1)))

(declare-const expect (_ FloatingPoint 3 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))
; expect = Infinity

(assert (not (= expect result)))

(check-sat)
(exit)
