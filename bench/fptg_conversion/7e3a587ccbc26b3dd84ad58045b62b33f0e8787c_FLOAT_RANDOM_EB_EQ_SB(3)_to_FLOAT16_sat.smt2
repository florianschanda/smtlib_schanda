; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT16
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 7 7))
(assert (fp.leq (fp #b1 #b1001101 #b010110)
                arg1
                (fp #b1 #b0100000 #b110111)))
(assert (fp.leq (fp #b1 #b0100000 #b110111)
                arg1
                (fp #b1 #b0000011 #b101101)))
; arg1 = -0.0000000008658389560878276824951171875

(declare-const result Float16)
(assert (= result ((_ to_fp 5 11) rm arg1)))

(declare-const expect Float16)
(assert (fp.leq (fp #b1 #b01000 #b0111010000)
                expect
                (fp #b1 #b00000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000 #b0000000001)
                expect
                (fp #b0 #b01100 #b1110001101)))
; expect = -0.000000059604644775390625

(assert (= expect result))

(check-sat)
(exit)
