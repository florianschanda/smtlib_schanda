; Format from: FLOAT_RANDOM_EB_EQ_SB
; Format to: FLOAT32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111110100 #b1001000001)
                arg1
                (fp #b1 #b10000001001 #b0000110001)))
(assert (fp.leq (fp #b1 #b10000001001 #b0000110001)
                arg1
                (fp #b1 #b01101010000 #b1111001101)))

(declare-const result Float32)
(assert (= result ((_ to_fp 8 24) rm arg1)))

(declare-const expect Float32)
(assert (fp.leq (fp #b1 #b11001001 #b10001011010011111000110)
                expect
                (fp #b1 #b10001001 #b00001100010000000000000)))
(assert (fp.leq (fp #b1 #b10001001 #b00001100010000000000000)
                expect
                (fp #b1 #b01011010 #b11011110100101010101111)))
; expect = -1073.0

(assert (= expect result))

(check-sat)
(exit)
