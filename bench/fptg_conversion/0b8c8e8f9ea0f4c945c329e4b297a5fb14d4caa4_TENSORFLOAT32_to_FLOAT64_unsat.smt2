                expect
                (fp #b1 #b10000001000 #b1101001010000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000001000 #b1101001010000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00010000100 #b1111010111011001011110000100100001001011100101111100)))

(assert (not (= expect result)))

