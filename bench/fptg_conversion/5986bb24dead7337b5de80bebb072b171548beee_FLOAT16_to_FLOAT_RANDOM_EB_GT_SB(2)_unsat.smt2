(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b0 #b10001 #b1001011000)
                arg1
                (fp #b0 #b11100 #b1101000111)))
(assert (fp.leq (fp #b0 #b11100 #b1101000111)
                arg1
                (fp #b0 #b11100 #b1101010101)))
; arg1 = 14904.0

(declare-const result (_ FloatingPoint 10 2))
(assert (= result ((_ to_fp 10 2) rm arg1)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1000111000 #b0)
                expect
                (fp #b0 #b1000001101 #b0)))
(assert (fp.leq (fp #b0 #b1000001101 #b0)
                expect
                (fp #b0 #b1000010100 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
