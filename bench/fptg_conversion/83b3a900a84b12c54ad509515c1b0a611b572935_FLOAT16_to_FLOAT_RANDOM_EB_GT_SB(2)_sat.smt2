(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format from: FLOAT16
; Format to: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b11010 #b1000110010)
                arg1
                (fp #b1 #b10110 #b0101001111)))
(assert (fp.leq (fp #b1 #b10110 #b0101001111)
                arg1
                (fp #b1 #b00111 #b1100011010)))
; arg1 = -169.875

(declare-const result (_ FloatingPoint 16 9))
(assert (= result ((_ to_fp 16 9) rm arg1)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1111110111101000 #b11010001)
                expect
                (fp #b1 #b1000000000000110 #b01010100)))
(assert (fp.leq (fp #b1 #b1000000000000110 #b01010100)
                expect
                (fp #b1 #b0000100010000101 #b00011011)))

(assert (= expect result))

(check-sat)
(exit)
