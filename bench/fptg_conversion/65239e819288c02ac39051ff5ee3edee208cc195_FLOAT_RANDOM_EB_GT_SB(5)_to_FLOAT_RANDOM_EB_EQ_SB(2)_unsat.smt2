                expect
                (fp #b1 #b01111100000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b01111100000000 #b0000000000000)
                expect
                (fp #b0 #b10001001110101 #b1010000110011)))

(assert (not (= expect result)))

