; Format from: FLOAT16
; Format to: PIXAR_PXR24
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const rm RoundingMode)

(declare-const arg1 Float16)
(assert (fp.leq (fp #b1 #b01001 #b0110000011)
                arg1
                (fp #b0 #b01111 #b1111110100)))
(assert (fp.leq (fp #b0 #b01111 #b1111110100)
                arg1
                (fp #b0 #b11110 #b1011101000)))
; arg1 = 1.98828125

(declare-const result (_ FloatingPoint 8 16))
(assert (= result ((_ to_fp 8 16) rm arg1)))

(declare-const expect (_ FloatingPoint 8 16))
(assert (fp.leq (fp #b1 #b10011110 #b100111001100001)
                expect
                (fp #b0 #b01111111 #b111111010000000)))
(assert (fp.leq (fp #b0 #b01111111 #b111111010000000)
                expect
                (fp #b0 #b11010001 #b000100111000001)))
; expect = 1.98828125

(assert (= expect result))

(check-sat)
(exit)
