; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: 2

; Redundancy: False
; Validation for: UBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 2))
(assert (not (bvule arg1 #b01)))
(assert (not (bvule #b11 arg1)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result ((_ to_fp_unsigned 11 10) rm arg1)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00111101111 #b001001010)
                expect
                (fp #b0 #b10000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b10000000000 #b000000000)
                expect
                (fp #b0 #b10010101011 #b001101100)))

(assert (= expect result))

(check-sat)
(exit)
