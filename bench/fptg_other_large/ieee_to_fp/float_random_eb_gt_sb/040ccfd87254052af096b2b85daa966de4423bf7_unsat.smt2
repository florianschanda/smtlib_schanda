; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1111110100110111)))
(assert (not (bvule #b1111110100111001 arg1)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result ((_ to_fp 14 2) arg1)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11111111011110 #b1)
                expect
                (fp #b1 #b11111010011100 #b0)))
(assert (fp.leq (fp #b1 #b11111010011100 #b0)
                expect
                (fp #b0 #b00100010010000 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
