(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1101111101100001)))
(assert (not (bvule #b1101111101100011 arg1)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result ((_ to_fp 12 4) arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110111101100 #b011)
                expect
                (fp #b1 #b101111101100 #b010)))
(assert (fp.leq (fp #b1 #b101111101100 #b010)
                expect
                (fp #b0 #b110010011001 #b010)))

(assert (= expect result))

(check-sat)
(exit)
