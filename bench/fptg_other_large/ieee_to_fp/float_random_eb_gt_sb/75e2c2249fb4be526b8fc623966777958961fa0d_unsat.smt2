; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY

(declare-const arg1 (_ BitVec 15))
(assert (not (bvule arg1 #b111111111111011)))
(assert (not (bvule #b111111111111101 arg1)))

(declare-const result (_ FloatingPoint 12 3))
