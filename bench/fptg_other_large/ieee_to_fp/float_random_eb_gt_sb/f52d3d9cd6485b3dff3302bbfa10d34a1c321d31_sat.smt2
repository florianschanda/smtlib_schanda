; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0011111111111100)))
(assert (not (bvule #b0011111111111110 arg1)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result ((_ to_fp 12 4) arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100010111011 #b110)
                expect
                (fp #b0 #b011111111111 #b101)))
(assert (fp.leq (fp #b0 #b011111111111 #b101)
                expect
                (fp #b0 #b110110110111 #b110)))

(assert (= expect result))

(check-sat)
(exit)
