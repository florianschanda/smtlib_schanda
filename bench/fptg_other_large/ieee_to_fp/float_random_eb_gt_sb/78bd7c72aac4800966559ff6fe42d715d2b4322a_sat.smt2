; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const arg1 (_ BitVec 17))
(assert (not (bvule arg1 #b10011111111111111)))
(assert (not (bvule #b10100000000000001 arg1)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result ((_ to_fp 9 8) arg1)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010000111 #b0110111)
