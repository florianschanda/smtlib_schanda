; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1101111111111010)))
(assert (not (bvule #b1101111111111100 arg1)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result ((_ to_fp 13 3) arg1)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1101000011010 #b00)
