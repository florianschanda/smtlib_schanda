; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

(declare-const arg1 (_ BitVec 24))
(assert (not (bvule arg1 #b100111111111111111111111)))
(assert (not (bvule #b101000000000000000000001 arg1)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result ((_ to_fp 16 8) arg1)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1001100111101101 #b1010000)
                expect
                (fp #b1 #b0100000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0000000)
                expect
                (fp #b1 #b0011011000101011 #b1010110)))

(assert (= expect result))

(check-sat)
(exit)
