(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b0111111111111111)))
(assert (not (bvule #b1000000000000001 arg1)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result ((_ to_fp 11 5) arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01100110110 #b0011)
                expect
                (fp #b1 #b00000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000)
                expect
                (fp #b0 #b11110011100 #b0010)))

(assert (not (= expect result)))

(check-sat)
(exit)
