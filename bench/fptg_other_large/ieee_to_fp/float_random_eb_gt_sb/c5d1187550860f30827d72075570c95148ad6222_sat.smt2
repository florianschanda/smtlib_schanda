; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL

(declare-const arg1 (_ BitVec 16))
(assert (not (bvule arg1 #b1111111111011110)))
(assert (not (bvule #b1111111111100000 arg1)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result ((_ to_fp 10 6) arg1)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111111 #b00000)
                expect
                (fp #b1 #b1111111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111)
                expect
                (fp #b1 #b1011010110 #b01100)))

(assert (= expect result))

(check-sat)
(exit)
