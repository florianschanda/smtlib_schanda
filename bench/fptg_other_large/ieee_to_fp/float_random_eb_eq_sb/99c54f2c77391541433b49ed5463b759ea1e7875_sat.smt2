(declare-const arg1 (_ BitVec 20))
(assert (not (bvule arg1 #b11111111100111111111)))
(assert (not (bvule #b11111111101000000001 arg1)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b010011010)
