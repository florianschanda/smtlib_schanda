(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO

(declare-const arg1 (_ BitVec 18))
(assert (not (bvule arg1 #b011111111111111111)))
(assert (not (bvule #b100000000000000001 arg1)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result ((_ to_fp 9 9) arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100101010 #b00100110)
                expect
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                expect
                (fp #b0 #b101101110 #b11001100)))

(assert (= expect result))

(check-sat)
(exit)
