; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01011101110 #b1110001101)
                arg1
                (fp #b0 #b10011010111 #b1010011001)))
(assert (fp.leq (fp #b0 #b10011010111 #b1010011001)
                arg1
                (fp #b0 #b11110000011 #b0100001000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110000001 #b1001111000)
                arg2
                (fp #b1 #b01000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000)
                arg2
                (fp #b0 #b11010000100 #b0001101101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00000110110 #b1001010110)
                expect
                (fp #b0 #b10011010111 #b1010011010)))
(assert (fp.leq (fp #b0 #b10011010111 #b1010011010)
                expect
                (fp #b0 #b11101001100 #b0111000101)))

(assert (= expect result))

(check-sat)
(exit)
