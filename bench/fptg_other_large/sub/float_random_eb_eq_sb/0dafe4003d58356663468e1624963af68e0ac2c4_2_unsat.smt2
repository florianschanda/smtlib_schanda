(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001100101 #b01101010)
                arg1
                (fp #b0 #b000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b000000000 #b11111111)
                arg1
                (fp #b0 #b001011010 #b00111011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b10110010)
                arg2
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg2
                (fp #b1 #b101011011 #b01100101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011001001 #b01101101)
                expect
                (fp #b0 #b111111101 #b00000001)))
(assert (fp.leq (fp #b0 #b111111101 #b00000001)
                expect
                (fp #b0 #b111111110 #b01000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
