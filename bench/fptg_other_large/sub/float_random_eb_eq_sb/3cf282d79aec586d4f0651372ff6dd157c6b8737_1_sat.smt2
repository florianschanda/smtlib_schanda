(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110100000 #b110100011)
                arg1
                (fp #b1 #b0000001001 #b000100110)))
(assert (fp.leq (fp #b1 #b0000001001 #b000100110)
                arg1
                (fp #b0 #b0000011101 #b100000101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001111010 #b101010011)
                expect
                (fp #b1 #b0000001010 #b000100110)))
(assert (fp.leq (fp #b1 #b0000001010 #b000100110)
                expect
                (fp #b0 #b1100010111 #b111010100)))

(assert (= expect result))

(check-sat)
(exit)
