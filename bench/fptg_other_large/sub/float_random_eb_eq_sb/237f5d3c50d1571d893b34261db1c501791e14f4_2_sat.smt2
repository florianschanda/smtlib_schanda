; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000001100 #b1100010001)
                arg1
                (fp #b1 #b10010100001 #b0000011110)))
(assert (fp.leq (fp #b1 #b10010100001 #b0000011110)
                arg1
                (fp #b0 #b01011110000 #b0000101010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011000000 #b1111111101)
                arg2
                (fp #b1 #b10000000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000000111 #b0011100100)
                arg2
                (fp #b1 #b01001011101 #b1100111110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010110001 #b0000010010)
                expect
                (fp #b1 #b10010100001 #b0000011110)))
(assert (fp.leq (fp #b1 #b10010100001 #b0000011110)
                expect
                (fp #b0 #b11100010011 #b1010010100)))

(assert (= expect result))

(check-sat)
(exit)
