(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000001001 #b01010101)
                arg1
                (fp #b0 #b101111110 #b11111111)))
(assert (fp.leq (fp #b0 #b101111110 #b11111111)
                arg1
                (fp #b0 #b110010010 #b00100111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101110 #b00000010)
                arg2
                (fp #b0 #b011111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111 #b00000000)
                arg2
                (fp #b0 #b101001000 #b00110110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101111 #b01110001)
                expect
                (fp #b0 #b101111110 #b11111111)))
(assert (fp.leq (fp #b0 #b101111110 #b11111111)
                expect
                (fp #b0 #b111101101 #b10100100)))

(assert (= expect result))

(check-sat)
(exit)
