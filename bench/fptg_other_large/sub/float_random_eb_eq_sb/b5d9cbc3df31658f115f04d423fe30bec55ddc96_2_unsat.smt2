(assert (fp.leq (fp #b1 #b1111111111111110 #b101000011011011)
                arg2
                (fp #b1 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000000000000000)
                arg2
                (fp #b0 #b0010110110100111 #b011110100110101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001111001010111 #b001000000000101)
                expect
                (fp #b0 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000000)
                expect
                (fp #b0 #b1111111111111101 #b001000110110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
