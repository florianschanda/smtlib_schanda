                arg2
                (fp #b1 #b100110100100 #b11011001001)))
(assert (fp.leq (fp #b1 #b100110100100 #b11011001001)
                arg2
                (fp #b0 #b111011100100 #b00010111101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000011111101 #b01100111110)
                expect
                (fp #b0 #b100110100100 #b11011001001)))
(assert (fp.leq (fp #b0 #b100110100100 #b11011001001)
                expect
                (fp #b0 #b100111011011 #b00001000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
