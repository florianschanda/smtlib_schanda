(assert (fp.leq (fp #b0 #b1010111000 #b000110101)
                arg2
                (fp #b0 #b1110100000 #b001110111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101011100 #b000110011)
                expect
                (fp #b1 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111111)
                expect
                (fp #b0 #b1000100110 #b000011100)))

(assert (= expect result))

(check-sat)
