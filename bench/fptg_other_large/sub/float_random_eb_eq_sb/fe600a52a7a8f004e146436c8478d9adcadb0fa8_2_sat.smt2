; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111011111 #b0110010010)
                arg1
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                arg1
                (fp #b0 #b11100011100 #b1000111111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000010000 #b0011110010)
                arg2
                (fp #b1 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000001)
                arg2
                (fp #b0 #b00110110011 #b1100111010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01000110111 #b1110010110)
                expect
                (fp #b0 #b11001001000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001111)
                expect
                (fp #b0 #b11101010010 #b1011110101)))

(assert (= expect result))

(check-sat)
(exit)
