; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110001 #b10111101)
                arg1
                (fp #b1 #b010000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000 #b00000000)
                arg1
                (fp #b0 #b110100010 #b11001000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100000010 #b10001010)
                arg2
                (fp #b1 #b011111111 #b10011100)))
(assert (fp.leq (fp #b1 #b011111111 #b10011100)
                arg2
                (fp #b0 #b000101111 #b01010011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110110 #b10010110)
                expect
                (fp #b0 #b011111111 #b10011011)))
(assert (fp.leq (fp #b0 #b011111111 #b10011011)
                expect
                (fp #b0 #b110010000 #b10110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
