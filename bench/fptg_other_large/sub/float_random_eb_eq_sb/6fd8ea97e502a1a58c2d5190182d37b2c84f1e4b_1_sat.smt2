                arg2
                (fp #b0 #b1000000000001011 #b111110110011000)))
(assert (fp.leq (fp #b0 #b1000000000001011 #b111110110011000)
                arg2
                (fp #b0 #b1010101101101001 #b101000111100100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001100100111100 #b110001100001101)
                expect
                (fp #b1 #b1000000000001011 #b111110110001101)))
(assert (fp.leq (fp #b1 #b1000000000001011 #b111110110001101)
                expect
                (fp #b0 #b0010101000000011 #b001011101100101)))

(assert (= expect result))

(check-sat)
(exit)
