(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000100100 #b11100000)
                arg1
                (fp #b0 #b000011000 #b11110110)))
(assert (fp.leq (fp #b0 #b000011000 #b11110110)
                arg1
                (fp #b0 #b010010001 #b00001111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001111 #b10001010)
                arg2
                (fp #b1 #b100001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100001000 #b00000000)
                arg2
                (fp #b1 #b000110010 #b01010010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011011010 #b01001010)
                expect
                (fp #b0 #b100001000 #b00000001)))
(assert (fp.leq (fp #b0 #b100001000 #b00000001)
                expect
                (fp #b0 #b110100100 #b11001000)))

(assert (= expect result))

(check-sat)
(exit)
