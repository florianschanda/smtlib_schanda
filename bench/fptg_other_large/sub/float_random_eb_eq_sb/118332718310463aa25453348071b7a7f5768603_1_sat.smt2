; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0010011001111100 #b111001101011001)
                arg1
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                arg1
                (fp #b0 #b1010111101001101 #b011110001100010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110011101011101 #b010011011000001)
                arg2
                (fp #b1 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b000000000000000)
                arg2
                (fp #b0 #b0111010100000111 #b000010011000000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0010001101011011 #b010000111111011)
                expect
                (fp #b0 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000000000000000)
                expect
                (fp #b0 #b1000110000000110 #b100111010110011)))

(assert (= expect result))

(check-sat)
(exit)
