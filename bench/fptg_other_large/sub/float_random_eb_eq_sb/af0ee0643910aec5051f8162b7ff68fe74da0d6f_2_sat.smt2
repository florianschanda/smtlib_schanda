; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0001100111011011 #b100110011111101)
                arg1
                (fp #b0 #b0000000000000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111110010011101)
                arg1
                (fp #b0 #b1000010110101001 #b011011001000101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110001100101010 #b110010011011111)
                arg2
                (fp #b0 #b0110100011101100 #b101001110111010)))
(assert (fp.leq (fp #b0 #b0110100011101100 #b101001110111010)
                arg2
                (fp #b0 #b0111111011101111 #b111001011111001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001111001111100 #b101010000111111)
                expect
                (fp #b1 #b0110100011101100 #b101001110111010)))
(assert (fp.leq (fp #b1 #b0110100011101100 #b101001110111010)
                expect
                (fp #b1 #b0001010111111010 #b000101000010000)))

(assert (= expect result))

(check-sat)
(exit)
