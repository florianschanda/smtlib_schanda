; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110010 #b01111111)
                arg1
                (fp #b1 #b010000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000 #b00000000)
                arg1
                (fp #b0 #b001110011 #b01010011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001111101 #b00011110)
                arg2
                (fp #b0 #b011111111 #b11100111)))
(assert (fp.leq (fp #b0 #b011111111 #b11100111)
                arg2
                (fp #b0 #b111001110 #b11011101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111010000 #b11100000)
                expect
                (fp #b1 #b011111111 #b11101000)))
(assert (fp.leq (fp #b1 #b011111111 #b11101000)
                expect
                (fp #b0 #b110010011 #b11110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
