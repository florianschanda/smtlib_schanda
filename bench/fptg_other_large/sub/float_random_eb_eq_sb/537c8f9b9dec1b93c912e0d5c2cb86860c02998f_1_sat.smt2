;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01010001001000 #b1111111100010)
                arg1
                (fp #b0 #b11111010101101 #b1000111001100)))
(assert (fp.leq (fp #b0 #b11111010101101 #b1000111001100)
                arg1
                (fp #b0 #b11111011011001 #b1000001011001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01001001101111 #b1111010001100)
                arg2
                (fp #b0 #b10000000001100 #b1110010010000)))
(assert (fp.leq (fp #b0 #b10000000001100 #b1110010010000)
                arg2
                (fp #b0 #b10000110000100 #b1101110100101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01110110001110 #b1111011001000)
                expect
                (fp #b0 #b11111010101101 #b1000111001011)))
(assert (fp.leq (fp #b0 #b11111010101101 #b1000111001011)
                expect
                (fp #b0 #b11111100010001 #b0100010100111)))

(assert (= expect result))

(check-sat)
(exit)
