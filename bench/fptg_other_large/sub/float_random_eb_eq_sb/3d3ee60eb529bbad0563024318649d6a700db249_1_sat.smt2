(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100010010010000 #b100001110010101)
                arg1
                (fp #b1 #b1010111011011110 #b001000011101111)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101111)
                arg1
                (fp #b1 #b0110101000000110 #b101101010000000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000101111100010 #b100010100100100)
                arg2
                (fp #b1 #b0000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010000000000000)
                arg2
                (fp #b0 #b0101001010010010 #b110101001000111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101010101101111 #b011011011001010)
                expect
                (fp #b1 #b1010111011011110 #b001000011101110)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101110)
                expect
                (fp #b0 #b0111110101001001 #b000111110000111)))

(assert (= expect result))

(check-sat)
(exit)
