                arg2
                (fp #b1 #b100000000000001110 #b00011011110111000)))
(assert (fp.leq (fp #b1 #b100000000000001110 #b00011011110111000)
                arg2
                (fp #b1 #b010011101101000111 #b11101110000111010)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100101011000101111 #b10001110001110011)
                expect
                (fp #b0 #b110100000010101101 #b01001001000100100)))
(assert (fp.leq (fp #b0 #b110100000010101101 #b01001001000100100)
                expect
                (fp #b0 #b110111100101101010 #b01000100010001101)))

(assert (= expect result))

(check-sat)
(exit)
