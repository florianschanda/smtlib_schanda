                arg2
                (fp #b0 #b111000010100010 #b01110001000110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010011100010101 #b01111111111111)
                expect
                (fp #b0 #b010000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b010000000000000 #b00000000000000)
                expect
                (fp #b0 #b011101100000001 #b00010111000001)))

(assert (= expect result))

(check-sat)
