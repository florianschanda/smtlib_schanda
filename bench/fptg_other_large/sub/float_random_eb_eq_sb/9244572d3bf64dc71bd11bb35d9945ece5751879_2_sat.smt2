(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000010010 #b001111110)
                arg1
                (fp #b0 #b0000000000 #b011110111)))
(assert (fp.leq (fp #b0 #b0000000000 #b011110111)
                arg1
                (fp #b0 #b1110000111 #b010001000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011110001 #b010100100)
                arg2
                (fp #b0 #b1010001101 #b000010110)))
(assert (fp.leq (fp #b0 #b1010001101 #b000010110)
                arg2
                (fp #b0 #b1101001000 #b011011111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111101101 #b101111000)
                expect
                (fp #b1 #b1010001101 #b000010110)))
(assert (fp.leq (fp #b1 #b1010001101 #b000010110)
                expect
                (fp #b0 #b0111100001 #b000001100)))

(assert (= expect result))

(check-sat)
(exit)
