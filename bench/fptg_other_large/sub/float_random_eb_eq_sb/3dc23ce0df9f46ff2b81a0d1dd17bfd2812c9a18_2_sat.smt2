; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000100110110 #b11000100110)
                arg1
                (fp #b0 #b111001001001 #b10011000010)))
(assert (fp.leq (fp #b0 #b111001001001 #b10011000010)
                arg1
                (fp #b0 #b111110100101 #b11001101000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111110010 #b00101111000)
                arg2
                (fp #b1 #b100110100100 #b11011001001)))
(assert (fp.leq (fp #b1 #b100110100100 #b11011001001)
                arg2
                (fp #b0 #b100001011110 #b00101010010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b011101101011 #b01100000000)
                expect
                (fp #b0 #b111001001001 #b10011000011)))
(assert (fp.leq (fp #b0 #b111001001001 #b10011000011)
                expect
                (fp #b0 #b111101111000 #b01111001110)))

(assert (= expect result))

(check-sat)
(exit)
