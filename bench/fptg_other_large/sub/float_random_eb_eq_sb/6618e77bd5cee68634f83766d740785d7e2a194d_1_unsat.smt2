;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000110101111110 #b011010101001000)
                arg1
                (fp #b0 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1000000000001111 #b000000000000000)
                arg1
                (fp #b0 #b1001101111110000 #b100000111000101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100001000000000 #b110101000101000)
                arg2
                (fp #b0 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000000)
                arg2
                (fp #b0 #b1111111111111101 #b111110110011000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111110 #b001110010011001)
                expect
                (fp #b1 #b1111111111111100 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111100 #b111111111111111)
                expect
                (fp #b1 #b1101010011010100 #b101100011101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
