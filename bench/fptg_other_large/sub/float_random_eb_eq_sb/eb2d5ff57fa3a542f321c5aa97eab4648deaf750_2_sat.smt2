(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11100110111001 #b0001010010110)
                arg1
                (fp #b1 #b10100101101110 #b1010010010001)))
(assert (fp.leq (fp #b1 #b10100101101110 #b1010010010001)
                arg1
                (fp #b0 #b10011011101101 #b1011101010011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111001101001 #b0011101110110)
                arg2
                (fp #b1 #b00000000000000 #b0000000000001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000001)
                arg2
                (fp #b0 #b00010111101000 #b1111111001100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110101010001 #b0110010111101)
                expect
                (fp #b1 #b10100101101110 #b1010010010001)))
(assert (fp.leq (fp #b1 #b10100101101110 #b1010010010001)
                expect
                (fp #b0 #b01101011010010 #b0010100001011)))

(assert (= expect result))

(check-sat)
(exit)
