; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110000010 #b1111001001)
                arg1
                (fp #b1 #b10000001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10000001000 #b1101001010)
                arg1
                (fp #b0 #b00000110111 #b0001100011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100000001 #b1010110101)
                expect
                (fp #b1 #b10000001001 #b1101001010)))
(assert (fp.leq (fp #b1 #b10000001001 #b1101001010)
                expect
                (fp #b0 #b11100101001 #b1011101010)))

(assert (= expect result))

(check-sat)
(exit)
