; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111101000 #b101100011)
                arg1
                (fp #b1 #b0111111111 #b100111111)))
(assert (fp.leq (fp #b1 #b0111111111 #b100111111)
                arg1
                (fp #b1 #b0100011000 #b011111111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110010000 #b001111011)
                arg2
                (fp #b1 #b0111111111 #b001111111)))
(assert (fp.leq (fp #b1 #b0111111111 #b001111111)
                arg2
                (fp #b1 #b0100101010 #b010100110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000111110 #b111011110)
                expect
                (fp #b1 #b0111111101 #b100000000)))
(assert (fp.leq (fp #b1 #b0111111101 #b100000000)
                expect
                (fp #b0 #b1111100010 #b010111100)))

(assert (= expect result))

(check-sat)
(exit)
