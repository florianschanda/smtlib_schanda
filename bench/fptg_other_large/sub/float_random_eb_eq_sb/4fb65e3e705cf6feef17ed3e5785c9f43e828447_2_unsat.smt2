; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011111011 #b0101100011)
                arg1
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                arg1
                (fp #b0 #b11100011001 #b1001110000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010010001 #b0110010010)
                arg2
                (fp #b1 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000)
                arg2
                (fp #b0 #b10011011100 #b0011110100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00110010101 #b0000011100)
                expect
                (fp #b0 #b11001001000 #b0001001111)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001111)
                expect
                (fp #b0 #b11101100110 #b1010100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
