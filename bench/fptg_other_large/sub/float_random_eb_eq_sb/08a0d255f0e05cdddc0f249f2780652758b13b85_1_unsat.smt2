(assert (fp.leq (fp #b0 #b0000000000 #b100001010)
                arg2
                (fp #b0 #b1001101010 #b000111101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000111011 #b001101101)
                expect
                (fp #b1 #b0000000000 #b110001010)))
(assert (fp.leq (fp #b1 #b0000000000 #b110001010)
                expect
                (fp #b0 #b0100101111 #b111101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
