(assert (fp.leq (fp #b1 #b11011001000 #b1000000010)
                arg2
                (fp #b0 #b10010100100 #b1101010001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001001110 #b1110001100)
                expect
                (fp #b0 #b11011001000 #b1000000001)))
(assert (fp.leq (fp #b0 #b11011001000 #b1000000001)
                expect
                (fp #b0 #b11011110111 #b1010100110)))

(assert (not (= expect result)))

(check-sat)
