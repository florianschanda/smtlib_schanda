(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011000110 #b100100111)
                arg1
                (fp #b0 #b0111111111 #b101000010)))
(assert (fp.leq (fp #b0 #b0111111111 #b101000010)
                arg1
                (fp #b0 #b1010110010 #b101000110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010010001 #b110101010)
                arg2
                (fp #b0 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b000000000)
                arg2
                (fp #b0 #b0100011000 #b011110000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100010111 #b100100100)
                expect
                (fp #b0 #b0111111111 #b101000001)))
(assert (fp.leq (fp #b0 #b0111111111 #b101000001)
                expect
                (fp #b0 #b1111110101 #b110101000)))

(assert (= expect result))

(check-sat)
(exit)
