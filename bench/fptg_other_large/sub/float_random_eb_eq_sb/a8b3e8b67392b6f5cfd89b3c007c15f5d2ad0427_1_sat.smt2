; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101010100001101 #b111110001100010)
                arg1
                (fp #b0 #b0000000000000000 #b101011011111011)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b101011011111011)
                arg1
                (fp #b0 #b1101101011000010 #b101101111000001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0001111111011101 #b100101100101111)
                arg2
                (fp #b0 #b1000000000001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b1000000000001100 #b010011110100100)
                arg2
                (fp #b0 #b1011001111010111 #b010100001110100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100010011010011 #b100110011001010)
                expect
                (fp #b1 #b1000000000001100 #b010011110100011)))
(assert (fp.leq (fp #b1 #b1000000000001100 #b010011110100011)
                expect
                (fp #b0 #b1000101111110010 #b000110100100001)))

(assert (= expect result))

(check-sat)
(exit)
