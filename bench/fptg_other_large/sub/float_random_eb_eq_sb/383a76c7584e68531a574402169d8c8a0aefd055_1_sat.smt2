(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110001001 #b010000110)
                arg1
                (fp #b0 #b0111111111 #b101000010)))
(assert (fp.leq (fp #b0 #b0111111111 #b101000010)
                arg1
                (fp #b0 #b1011001110 #b101001100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001111011 #b100100110)
                arg2
                (fp #b0 #b1010001101 #b000010110)))
(assert (fp.leq (fp #b0 #b1010001101 #b000010110)
                arg2
                (fp #b0 #b1110100000 #b001001101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111101101 #b011110000)
                expect
                (fp #b1 #b1010001101 #b000010101)))
(assert (fp.leq (fp #b1 #b1010001101 #b000010101)
                expect
                (fp #b1 #b0011100110 #b010111101)))

(assert (= expect result))

(check-sat)
(exit)
