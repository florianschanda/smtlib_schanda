; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101000111 #b101000100)
                arg1
                (fp #b1 #b1000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b1000001000 #b011100001)
                arg1
                (fp #b1 #b0100101000 #b000101000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0010010101 #b011110111)
                arg2
                (fp #b0 #b1001110111 #b101110100)))
(assert (fp.leq (fp #b0 #b1001110111 #b101110100)
                arg2
                (fp #b0 #b1010010110 #b010101111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010010000 #b000000100)
                expect
                (fp #b1 #b1001110111 #b101110100)))
(assert (fp.leq (fp #b1 #b1001110111 #b101110100)
                expect
                (fp #b0 #b1010010011 #b001011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
