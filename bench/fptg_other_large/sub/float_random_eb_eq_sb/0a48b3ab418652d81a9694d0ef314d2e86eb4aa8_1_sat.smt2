; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01010001011 #b0100111101)
                arg1
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                arg1
                (fp #b0 #b01101001001 #b1100001011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01101100001 #b0110010010)
                arg2
                (fp #b0 #b10110010001 #b0110101010)))
(assert (fp.leq (fp #b0 #b10110010001 #b0110101010)
                arg2
                (fp #b0 #b11010100011 #b1101110010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000100000 #b0110010111)
                expect
                (fp #b1 #b10110010001 #b0110101001)))
(assert (fp.leq (fp #b1 #b10110010001 #b0110101001)
                expect
                (fp #b0 #b00111000100 #b0001101011)))

(assert (= expect result))

(check-sat)
(exit)
