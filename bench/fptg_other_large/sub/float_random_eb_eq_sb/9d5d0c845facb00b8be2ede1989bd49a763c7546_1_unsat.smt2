(assert (fp.leq (fp #b0 #b00000000000 #b0001110101)
                arg2
                (fp #b0 #b01011000010 #b1010110010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00000010100 #b1000100100)
                expect
                (fp #b0 #b10111111110 #b1111111110)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111110)
                expect
                (fp #b0 #b11100000101 #b1111000110)))

(assert (not (= expect result)))

