(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010100001 #b1111010001)
                arg1
                (fp #b0 #b00000000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111000)
                arg1
                (fp #b0 #b11000110110 #b1001101000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000111110 #b1100101011)
                arg2
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                arg2
                (fp #b1 #b00100010110 #b0011010101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00110000001 #b0100100001)
                expect
                (fp #b0 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000001010 #b0000000000)
                expect
                (fp #b0 #b10101100101 #b0011000000)))

(assert (= expect result))

(check-sat)
(exit)
