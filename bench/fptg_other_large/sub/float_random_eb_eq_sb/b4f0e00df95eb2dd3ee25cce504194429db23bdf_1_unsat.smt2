                arg2
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg2
                (fp #b0 #b10000000001 #b0110100010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110101101 #b1011101110)
                expect
                (fp #b1 #b01000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000)
                expect
                (fp #b1 #b00100010000 #b1000111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
