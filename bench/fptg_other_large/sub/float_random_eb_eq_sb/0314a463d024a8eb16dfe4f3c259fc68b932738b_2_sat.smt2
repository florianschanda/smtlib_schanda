; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010011010101 #b0011011010010)
                arg1
                (fp #b0 #b01010100011110 #b1100100010010)))
(assert (fp.leq (fp #b0 #b01010100011110 #b1100100010010)
                arg1
                (fp #b0 #b11010111110001 #b0001010011101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10010100011001 #b0000001111110)
                arg2
                (fp #b1 #b10000000000100 #b1100100000000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b1100100000000)
                arg2
                (fp #b1 #b00110111101010 #b0001011100101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010111101101 #b1100101101111)
                expect
                (fp #b0 #b10000000000100 #b1100100000001)))
(assert (fp.leq (fp #b0 #b10000000000100 #b1100100000001)
                expect
                (fp #b0 #b11010011101110 #b1100110101011)))

(assert (= expect result))

(check-sat)
(exit)
