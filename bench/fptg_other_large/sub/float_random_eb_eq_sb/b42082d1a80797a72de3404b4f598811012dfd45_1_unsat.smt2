; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00101010101 #b1100111000)
                arg1
                (fp #b0 #b00000000000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001001100)
                arg1
                (fp #b0 #b11110111010 #b0101110100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011100110 #b0011000101)
                arg2
                (fp #b1 #b10000000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000000111 #b0011100100)
                arg2
                (fp #b1 #b00100011100 #b1010011110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00101010001 #b0110100010)
                expect
                (fp #b0 #b10000000111 #b0011100100)))
(assert (fp.leq (fp #b0 #b10000000111 #b0011100100)
                expect
                (fp #b0 #b11100011111 #b1111100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
