(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001101011 #b111101000)
                arg1
                (fp #b1 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000001)
                arg1
                (fp #b0 #b1011101101 #b001110111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100010011 #b101100011)
                arg2
                (fp #b0 #b1000000111 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b000000000)
                arg2
                (fp #b0 #b1100100100 #b110111101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011100010 #b001100010)
                expect
                (fp #b1 #b1000000111 #b000000001)))
(assert (fp.leq (fp #b1 #b1000000111 #b000000001)
                expect
                (fp #b0 #b1110111100 #b101000111)))

(assert (= expect result))

(check-sat)
(exit)
