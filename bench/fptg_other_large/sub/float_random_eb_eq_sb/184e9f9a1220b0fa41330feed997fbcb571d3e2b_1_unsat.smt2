(assert (fp.leq (fp #b0 #b00000000000000 #b1111111111111)
                arg2
                (fp #b0 #b00101100010111 #b0001101000100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111000011101 #b0010001110100)
                expect
                (fp #b0 #b11111010010100 #b0000010100010)))
(assert (fp.leq (fp #b0 #b11111010010100 #b0000010100010)
                expect
                (fp #b0 #b11111110111000 #b0100101001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
