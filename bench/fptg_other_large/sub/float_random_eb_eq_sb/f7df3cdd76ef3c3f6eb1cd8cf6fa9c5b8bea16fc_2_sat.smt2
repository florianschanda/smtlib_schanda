(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001011000 #b0111111000)
                arg1
                (fp #b1 #b01100100100 #b1111100011)))
(assert (fp.leq (fp #b1 #b01100100100 #b1111100011)
                arg1
                (fp #b1 #b00011100000 #b0001010111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11110111111 #b0110110110)
                expect
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b10011000111 #b1101101000)))

(assert (= expect result))

(check-sat)
(exit)
