(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011000 #b11000011)
                arg1
                (fp #b1 #b100000111 #b10110100)))
(assert (fp.leq (fp #b1 #b100000111 #b10110100)
                arg1
                (fp #b0 #b010111000 #b00101010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110001 #b01000100)
                arg2
                (fp #b1 #b101101100 #b10101111)))
(assert (fp.leq (fp #b1 #b101101100 #b10101111)
                arg2
                (fp #b0 #b010111011 #b10010000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b101010100 #b11011111)
                expect
                (fp #b0 #b101101100 #b10101111)))
(assert (fp.leq (fp #b0 #b101101100 #b10101111)
                expect
                (fp #b0 #b110000100 #b10010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
