; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011011000111011 #b101011011101101)
                arg1
                (fp #b0 #b1101000000101101 #b100100100100101)))
(assert (fp.leq (fp #b0 #b1101000000101101 #b100100100100101)
                arg1
                (fp #b0 #b1110101100001000 #b000100001000010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001010011101100 #b111000000001101)
                arg2
                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b0 #b1011001000011110 #b100000110100011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010011011011111 #b010110110100100)
                expect
                (fp #b0 #b1101000000101101 #b100100100100100)))
(assert (fp.leq (fp #b0 #b1101000000101101 #b100100100100100)
                expect
                (fp #b0 #b1111000101001000 #b001010110110100)))

(assert (= expect result))

(check-sat)
(exit)
