; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110111010 #b1100101000)
                arg1
                (fp #b0 #b00101101011 #b1101010101)))
(assert (fp.leq (fp #b0 #b00101101011 #b1101010101)
                arg1
                (fp #b0 #b11110001010 #b1101011010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111100111 #b1100111010)
                arg2
                (fp #b1 #b01000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000)
                arg2
                (fp #b0 #b10110000011 #b1011100111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01110010010 #b0111100101)
                expect
                (fp #b0 #b01000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000001)
                expect
                (fp #b0 #b01110011000 #b0001010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
