(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010111110101 #b01100010111)
                arg1
                (fp #b0 #b011111111111 #b01110010110)))
(assert (fp.leq (fp #b0 #b011111111111 #b01110010110)
                arg1
                (fp #b0 #b101001100001 #b01001100001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001100100110 #b11111010100)
                arg2
                (fp #b0 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b100000001011 #b00000000000)
                arg2
                (fp #b0 #b110011001001 #b00010011010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111001110 #b11010000110)
                expect
                (fp #b1 #b100000001010 #b11111111110)))
(assert (fp.leq (fp #b1 #b100000001010 #b11111111110)
                expect
                (fp #b0 #b110111111110 #b00011100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
