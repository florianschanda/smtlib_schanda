(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101101110 #b000000011)
                arg1
                (fp #b0 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000001)
                arg1
                (fp #b0 #b0111010001 #b100010101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011011001 #b000111101)
                arg2
                (fp #b1 #b1000000111 #b001100100)))
(assert (fp.leq (fp #b1 #b1000000111 #b001100100)
                arg2
                (fp #b0 #b1100100001 #b001001111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000111001 #b110011100)
                expect
                (fp #b0 #b1000000111 #b001100101)))
(assert (fp.leq (fp #b0 #b1000000111 #b001100101)
                expect
                (fp #b0 #b1010011011 #b111100000)))

(assert (= expect result))

(check-sat)
(exit)
