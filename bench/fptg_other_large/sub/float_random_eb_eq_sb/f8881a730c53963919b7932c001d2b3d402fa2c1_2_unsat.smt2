(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011010 #b111101010)
                arg1
                (fp #b1 #b1101101100 #b100010000)))
(assert (fp.leq (fp #b1 #b1101101100 #b100010000)
                arg1
                (fp #b1 #b0111010110 #b101010100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001100111 #b011010010)
                arg2
                (fp #b1 #b0111111111 #b001111111)))
(assert (fp.leq (fp #b1 #b0111111111 #b001111111)
                arg2
                (fp #b0 #b1000101100 #b010110111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011010 #b100001111)
                expect
                (fp #b1 #b1101101100 #b100010000)))
(assert (fp.leq (fp #b1 #b1101101100 #b100010000)
                expect
                (fp #b0 #b0111001011 #b010011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
