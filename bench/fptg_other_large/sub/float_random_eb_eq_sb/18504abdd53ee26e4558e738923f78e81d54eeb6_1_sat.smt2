; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10010100110011 #b0111100101100)
                arg1
                (fp #b1 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b10000000001101 #b0000000000000)
                arg1
                (fp #b0 #b01010101110111 #b1111010010101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101110010111 #b1101101010100)
                arg2
                (fp #b1 #b11100110110100 #b1101101000111)))
(assert (fp.leq (fp #b1 #b11100110110100 #b1101101000111)
                arg2
                (fp #b0 #b11101010110011 #b1110100101011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b10001000010001 #b1001100100001)
                expect
                (fp #b0 #b11100110110100 #b1101101000110)))
(assert (fp.leq (fp #b0 #b11100110110100 #b1101101000110)
                expect
                (fp #b0 #b11110011001111 #b1000000101001)))

(assert (= expect result))

(check-sat)
(exit)
