; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101110 #b01110001)
                arg1
                (fp #b1 #b101011111 #b10101011)))
(assert (fp.leq (fp #b1 #b101011111 #b10101011)
                arg1
                (fp #b1 #b100111111 #b10111111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010001011 #b10000011)
                arg2
                (fp #b0 #b000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b000000000 #b00111011)
                arg2
                (fp #b0 #b110110100 #b11100010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000000 #b10100011)
                expect
                (fp #b1 #b101011111 #b10101100)))
(assert (fp.leq (fp #b1 #b101011111 #b10101100)
                expect
                (fp #b0 #b110101010 #b01101111)))

(assert (= expect result))

(check-sat)
(exit)
