; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011110110011 #b0101010001100)
                arg1
                (fp #b1 #b10100101101110 #b1010010010001)))
(assert (fp.leq (fp #b1 #b10100101101110 #b1010010010001)
                arg1
                (fp #b0 #b01110110010001 #b0100010001110)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b11000100001110 #b0100010101110)
                arg2
                (fp #b0 #b11111111111101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000000000000)
                arg2
                (fp #b0 #b11111111111110 #b0001110111110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111111101 #b0110111100010)
                expect
                (fp #b1 #b11111111111101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000000)
                expect
                (fp #b0 #b11110110110111 #b1101000010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
