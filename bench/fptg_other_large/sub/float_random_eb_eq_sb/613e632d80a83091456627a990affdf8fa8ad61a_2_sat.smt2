(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011101001011 #b1001110001001)
                arg1
                (fp #b0 #b01010100011110 #b1100100010010)))
(assert (fp.leq (fp #b0 #b01010100011110 #b1100100010010)
                arg1
                (fp #b0 #b11010010100111 #b0001100001101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110001000011 #b0000000000000)
                arg2
                (fp #b1 #b11100110110100 #b1101101000111)))
(assert (fp.leq (fp #b1 #b11100110110100 #b1101101000111)
                arg2
                (fp #b1 #b00101000101100 #b1010101111011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01001100101100 #b1010011100111)
                expect
                (fp #b0 #b11100110110100 #b1101101001000)))
(assert (fp.leq (fp #b0 #b11100110110100 #b1101101001000)
                expect
                (fp #b0 #b11101101100100 #b1101011100010)))

(assert (= expect result))

(check-sat)
(exit)
