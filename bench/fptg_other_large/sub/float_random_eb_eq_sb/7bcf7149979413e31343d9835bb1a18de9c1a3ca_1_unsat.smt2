(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001011110 #b101110011)
                arg1
                (fp #b1 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0100000000 #b000000000)
                arg1
                (fp #b0 #b0010100000 #b110000010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100110000 #b100101010)
                arg2
                (fp #b0 #b1000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b1000001000 #b001010110)
                arg2
                (fp #b0 #b1011100000 #b010110000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100111010 #b110100100)
                expect
                (fp #b1 #b1000001000 #b001010110)))
(assert (fp.leq (fp #b1 #b1000001000 #b001010110)
                expect
                (fp #b0 #b1101101011 #b000000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
