(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111010111 #b011011111)
                arg1
                (fp #b0 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b000000000)
                arg1
                (fp #b0 #b1101000011 #b111010010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                arg2
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                arg2
                (fp #b0 #b1110000101 #b010000111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0111110001 #b100001000)
                expect
                (fp #b0 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111111)
                expect
                (fp #b0 #b1111111111 #b000000000)))

(assert (= expect result))

(check-sat)
(exit)
