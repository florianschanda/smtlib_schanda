; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101011100 #b0100110111)
                arg1
                (fp #b1 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000)
                arg1
                (fp #b0 #b11011001101 #b0110011100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010110111 #b1000000101)
                arg2
                (fp #b1 #b00000000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000)
                arg2
                (fp #b0 #b11100000110 #b1001001001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111110010 #b0101110101)
                expect
                (fp #b1 #b01111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b01111111110 #b1111111111)
                expect
                (fp #b1 #b00100010000 #b1111010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
