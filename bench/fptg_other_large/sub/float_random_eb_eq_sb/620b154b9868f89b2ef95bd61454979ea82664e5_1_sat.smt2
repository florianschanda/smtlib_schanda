(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110010000100010 #b011101011001011)
                arg1
                (fp #b1 #b0010110010100101 #b101001001111101)))
(assert (fp.leq (fp #b1 #b0010110010100101 #b101001001111101)
                arg1
                (fp #b1 #b0001011100101111 #b001101010100110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010000011101101 #b110110101010110)
                arg2
                (fp #b1 #b0000000000000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b000000000000000)
                arg2
                (fp #b0 #b0100011111011001 #b000101001111110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100111011000100 #b000001011011010)
                expect
                (fp #b1 #b0010110010100101 #b101001001111100)))
(assert (fp.leq (fp #b1 #b0010110010100101 #b101001001111100)
                expect
                (fp #b0 #b1000101111100111 #b001001110001101)))

(assert (= expect result))

(check-sat)
(exit)
