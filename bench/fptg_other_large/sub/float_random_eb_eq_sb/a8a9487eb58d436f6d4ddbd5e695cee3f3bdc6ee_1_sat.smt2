(assert (fp.leq (fp #b1 #b1011111111111110 #b111111111111111)
                arg2
                (fp #b0 #b1001001100101010 #b001101110010011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000010001100100 #b010110011010111)
                expect
                (fp #b0 #b1011111111111110 #b111111111111110)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b111111111111110)
                expect
                (fp #b0 #b1100101011011011 #b000001100111010)))

(assert (= expect result))

(check-sat)
