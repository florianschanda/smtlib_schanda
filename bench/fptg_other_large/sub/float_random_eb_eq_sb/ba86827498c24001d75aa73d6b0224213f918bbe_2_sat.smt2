(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01011000110 #b1010110101)
                arg1
                (fp #b0 #b01111111111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111111111 #b0101111011)
                arg1
                (fp #b0 #b11011001110 #b1111110100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011111110 #b0111100010)
                arg2
                (fp #b1 #b10000001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10000001000 #b0100001100)
                arg2
                (fp #b0 #b11101111111 #b0010110010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001000100 #b1100011001)
                expect
                (fp #b0 #b10000001000 #b0100001111)))
(assert (fp.leq (fp #b0 #b10000001000 #b0100001111)
                expect
                (fp #b0 #b11110010000 #b0101000010)))

(assert (= expect result))

(check-sat)
(exit)
