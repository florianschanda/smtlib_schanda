(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0000010100110111 #b111000010010010)
                arg1
                (fp #b0 #b0010010101000000 #b011100011111111)))
(assert (fp.leq (fp #b0 #b0010010101000000 #b011100011111111)
                arg1
                (fp #b0 #b1111000100011010 #b101011100100000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1001101100100100 #b000011111000110)
                expect
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b0111010000110100 #b001110101000111)))

(assert (= expect result))

(check-sat)
(exit)
