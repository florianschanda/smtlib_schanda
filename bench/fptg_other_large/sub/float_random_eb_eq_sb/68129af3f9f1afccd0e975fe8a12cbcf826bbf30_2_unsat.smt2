(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110001001100 #b10000100010)
                arg1
                (fp #b1 #b011111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b011111111111 #b01100111111)
                arg1
                (fp #b0 #b100011001011 #b10000010000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010011100110 #b10001111011)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b100100111010 #b01110110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
