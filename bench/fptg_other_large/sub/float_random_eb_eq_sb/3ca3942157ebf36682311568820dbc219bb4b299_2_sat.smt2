(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001111001 #b111001101)
                arg1
                (fp #b0 #b1001110010 #b011011010)))
(assert (fp.leq (fp #b0 #b1001110010 #b011011010)
                arg1
                (fp #b0 #b1010101101 #b111010011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1011101111 #b000010101)
                arg2
                (fp #b0 #b1100101101 #b000000001)))
(assert (fp.leq (fp #b0 #b1100101101 #b000000001)
                arg2
                (fp #b0 #b1110100001 #b011100000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101010011 #b001110100)
                expect
                (fp #b1 #b1100101101 #b000000001)))
(assert (fp.leq (fp #b1 #b1100101101 #b000000001)
                expect
                (fp #b1 #b1011101000 #b101000011)))

(assert (= expect result))

(check-sat)
(exit)
