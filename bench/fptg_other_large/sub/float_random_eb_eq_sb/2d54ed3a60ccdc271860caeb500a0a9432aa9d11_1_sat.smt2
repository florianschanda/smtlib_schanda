; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100001111100 #b000111000100)
                arg1
                (fp #b1 #b1011101111000 #b000110000100)))
(assert (fp.leq (fp #b1 #b1011101111000 #b000110000100)
                arg1
                (fp #b0 #b0111111100010 #b110001111110)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100001001011 #b001101110110)
                arg2
                (fp #b1 #b0100000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b000000000000)
                arg2
                (fp #b0 #b1101101000010 #b111100110000)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111001100111 #b001000110000)
                expect
                (fp #b1 #b1011101111000 #b000110000011)))
(assert (fp.leq (fp #b1 #b1011101111000 #b000110000011)
                expect
                (fp #b1 #b0011010000001 #b000100010111)))

(assert (= expect result))

(check-sat)
(exit)
