                arg2
                (fp #b1 #b100000111 #b11010011)))
(assert (fp.leq (fp #b1 #b100000111 #b11010011)
                arg2
                (fp #b0 #b001101010 #b01111011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001111010 #b00001111)
                expect
                (fp #b0 #b100000111 #b11010100)))
(assert (fp.leq (fp #b0 #b100000111 #b11010100)
                expect
                (fp #b0 #b111001101 #b11111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
