; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10000011100010011 #b0010101111010010)
                arg2
                (fp #b1 #b00000000000000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000001 #b0000000000000000)
                arg2
                (fp #b0 #b10010001111001000 #b1000100110101001)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
