; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011010010111000 #b110011110000001)
                arg1
                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg1
                (fp #b0 #b0100111101101010 #b111010001011011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0001001010100000 #b001001100001111)
                arg2
                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b0 #b1011110111010101 #b010110110100011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1101101010011111 #b000000000110001)
                expect
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b0110100101001100 #b011110010100110)))

(assert (= expect result))

(check-sat)
(exit)
