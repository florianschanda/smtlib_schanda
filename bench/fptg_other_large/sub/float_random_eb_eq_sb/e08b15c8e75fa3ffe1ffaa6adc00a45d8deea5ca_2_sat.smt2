(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001000000 #b001101001)
                arg1
                (fp #b1 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111 #b000000000)
                arg1
                (fp #b0 #b0000111011 #b111111100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0010011011 #b101000110)
                arg2
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg2
                (fp #b0 #b1111111101 #b011111000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111110 #b001000110)
                expect
                (fp #b1 #b1111111101 #b000000001)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000001)
                expect
                (fp #b1 #b0000101110 #b010101100)))

(assert (= expect result))

(check-sat)
(exit)
