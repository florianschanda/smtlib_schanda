(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1010000110010 #b111010000011)
                arg1
                (fp #b1 #b0111111111111 #b001101110000)))
(assert (fp.leq (fp #b1 #b0111111111111 #b001101110000)
                arg1
                (fp #b0 #b1111000111011 #b111111010010)))

