                arg2
                (fp #b0 #b1000000001000 #b110010011000)))
(assert (fp.leq (fp #b0 #b1000000001000 #b110010011000)
                arg2
                (fp #b0 #b1101001000000 #b000001111011)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1110000001100 #b001101000101)
                expect
                (fp #b1 #b1000000001000 #b110010100010)))
(assert (fp.leq (fp #b1 #b1000000001000 #b110010100010)
                expect
                (fp #b0 #b1001111111011 #b010111101011)))

(assert (= expect result))

(check-sat)
(exit)
