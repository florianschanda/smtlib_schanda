(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010001000 #b11011001110)
                expect
                (fp #b1 #b101101010110 #b10000100001)))
(assert (fp.leq (fp #b1 #b101101010110 #b10000100001)
                expect
                (fp #b0 #b100001101110 #b11110001100)))

(assert (not (= expect result)))

