                (fp #b0 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000000000000000)
                arg2
                (fp #b0 #b0101101011101001 #b111100001100001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0101111101101100 #b101100100001101)
                expect
                (fp #b0 #b1000000000001110 #b100100011101100)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b100100011101100)
                expect
                (fp #b0 #b1101000110010010 #b110010110110101)))

(assert (= expect result))

(check-sat)
