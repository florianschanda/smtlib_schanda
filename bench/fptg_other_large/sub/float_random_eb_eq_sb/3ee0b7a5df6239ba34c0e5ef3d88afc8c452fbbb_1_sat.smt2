(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110101111 #b00110001001)
                arg1
                (fp #b1 #b110100100011 #b00110111000)))
(assert (fp.leq (fp #b1 #b110100100011 #b00110111000)
                arg1
                (fp #b0 #b011110001100 #b10111100011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101101111010 #b10000010010)
                arg2
                (fp #b1 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000001011 #b00000000000)
                arg2
                (fp #b0 #b101101111001 #b01011001010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111010100011 #b00101000110)
                expect
                (fp #b1 #b110100100011 #b00110110111)))
(assert (fp.leq (fp #b1 #b110100100011 #b00110110111)
                expect
                (fp #b1 #b100010011011 #b10010110110)))

(assert (= expect result))

(check-sat)
(exit)
