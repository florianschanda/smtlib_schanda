(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010111000000100 #b011110101110010)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                arg1
                (fp #b0 #b0101111111101011 #b101011001101101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110001111111011 #b100100111100110)
                arg2
                (fp #b1 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b0 #b0001011110000001 #b010110010101101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010110001011000 #b100001001000010)
                expect
                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                expect
                (fp #b0 #b0110100111010101 #b110100100001011)))

(assert (= expect result))

(check-sat)
(exit)
