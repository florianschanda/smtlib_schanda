; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001011110 #b1010011110)
                arg1
                (fp #b1 #b00000000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000000 #b1110100001)
                arg1
                (fp #b0 #b11100111101 #b0010111001)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01011100111 #b0110011000)
                expect
                (fp #b1 #b00000000001 #b1101000010)))
(assert (fp.leq (fp #b1 #b00000000001 #b1101000010)
                expect
                (fp #b0 #b01000101101 #b0110001000)))

(assert (= expect result))

(check-sat)
(exit)
