; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010111100100 #b0111100010110)
                arg1
                (fp #b0 #b10111011100110 #b0010111000010)))
(assert (fp.leq (fp #b0 #b10111011100110 #b0010111000010)
                arg1
                (fp #b0 #b11110100000101 #b1001001010111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000000100100 #b1111001011000)
                arg2
                (fp #b1 #b10000000001100 #b1000110111100)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1000110111100)
                arg2
                (fp #b0 #b11011010111111 #b1111110101011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010010111000 #b1011011011110)
                expect
                (fp #b0 #b10111011100110 #b0010111000011)))
(assert (fp.leq (fp #b0 #b10111011100110 #b0010111000011)
                expect
                (fp #b0 #b11001000010101 #b0001001001111)))

(assert (= expect result))

(check-sat)
(exit)
