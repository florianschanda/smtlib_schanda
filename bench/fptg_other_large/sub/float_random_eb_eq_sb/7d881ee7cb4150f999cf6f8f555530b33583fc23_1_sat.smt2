(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110010110010 #b01010001011)
                arg1
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                arg1
                (fp #b0 #b011001010000 #b11001110010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b011010000011 #b10110111011)
                arg2
                (fp #b0 #b100000000111 #b01010000000)))
(assert (fp.leq (fp #b0 #b100000000111 #b01010000000)
                arg2
                (fp #b0 #b111001100010 #b00001101010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011111011 #b01011000110)
                expect
                (fp #b1 #b100000000111 #b01010000000)))
(assert (fp.leq (fp #b1 #b100000000111 #b01010000000)
                expect
                (fp #b0 #b110111101111 #b01111101000)))

(assert (= expect result))

(check-sat)
(exit)
