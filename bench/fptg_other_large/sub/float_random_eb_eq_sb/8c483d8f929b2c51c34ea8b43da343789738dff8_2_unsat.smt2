; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000010 #b01101010)
                arg1
                (fp #b0 #b000011000 #b11110110)))
(assert (fp.leq (fp #b0 #b000011000 #b11110110)
                arg1
                (fp #b0 #b011111001 #b01111111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011011 #b11010111)
                arg2
                (fp #b1 #b100000111 #b10010100)))
(assert (fp.leq (fp #b1 #b100000111 #b10010100)
                arg2
                (fp #b1 #b001010001 #b01011111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011000100 #b10001001)
                expect
                (fp #b0 #b100000111 #b10010101)))
(assert (fp.leq (fp #b0 #b100000111 #b10010101)
                expect
                (fp #b0 #b111001110 #b00000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
