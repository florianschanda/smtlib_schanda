                (fp #b1 #b1100011100100110 #b011000011011000)))
(assert (fp.leq (fp #b1 #b1100011100100110 #b011000011011000)
                arg2
                (fp #b0 #b1011110001010110 #b010001101101011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0110001110010101 #b101110101101101)
                expect
                (fp #b0 #b1100011100100110 #b011000011010111)))
(assert (fp.leq (fp #b0 #b1100011100100110 #b011000011010111)
                expect
                (fp #b0 #b1100011111101001 #b001001000100111)))

(assert (= expect result))

(check-sat)
(exit)
