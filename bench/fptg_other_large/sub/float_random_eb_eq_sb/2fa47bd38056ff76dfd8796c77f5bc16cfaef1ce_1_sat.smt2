;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111100110111011101 #b11001011001100111)
                arg1
                (fp #b1 #b011111111111111111 #b01001001101111010)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b01001001101111010)
                arg1
                (fp #b0 #b010010011101011000 #b10011010111100100)))

