                arg2
                (fp #b0 #b100000000000010001 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b100000000000010001 #b00000000000000000)
                arg2
                (fp #b0 #b110011001111111110 #b00011101011011111)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110000011001110111 #b00011101000111101)
                expect
                (fp #b1 #b100000000000010001 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b100000000000010001 #b00000000000000000)
                expect
                (fp #b1 #b001001001011010101 #b11011100100010011)))

(assert (= expect result))

(check-sat)
(exit)
