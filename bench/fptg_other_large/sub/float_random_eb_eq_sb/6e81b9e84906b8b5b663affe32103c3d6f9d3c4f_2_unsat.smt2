;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010010011101000 #b010110001101110)
                arg1
                (fp #b0 #b0111111111111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b010001110000010)
                arg1
                (fp #b0 #b1010010111101101 #b101111101100000)))

(declare-const arg2 (_ FloatingPoint 16 16))
