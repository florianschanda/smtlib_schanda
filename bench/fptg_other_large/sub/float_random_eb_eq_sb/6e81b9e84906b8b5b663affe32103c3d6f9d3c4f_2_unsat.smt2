                arg2
                (fp #b1 #b0000000000000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b000000000000000)
                arg2
                (fp #b0 #b1111101011001001 #b110010110110101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110000000111100 #b001111000110001)
                expect
                (fp #b0 #b0111111111111111 #b010001110000011)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b010001110000011)
                expect
                (fp #b0 #b1101001110101101 #b100111110110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
