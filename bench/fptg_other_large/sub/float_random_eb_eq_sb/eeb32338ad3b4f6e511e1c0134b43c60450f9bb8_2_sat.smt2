                (fp #b0 #b0111111111111 #b000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b000000000000)
                arg2
                (fp #b0 #b1011011100101 #b000000000011)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1110010110001 #b101011010100)
                expect
                (fp #b1 #b1000000000000 #b010111100000)))
(assert (fp.leq (fp #b1 #b1000000000000 #b010111100000)
                expect
                (fp #b1 #b0000100101000 #b100111110100)))

(assert (= expect result))

(check-sat)
