                arg2
                (fp #b0 #b100000000001110 #b00000000000000)))
(assert (fp.leq (fp #b0 #b100000000001110 #b00000000000000)
                arg2
                (fp #b0 #b111111001000010 #b11000101010011)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101101110111 #b01000001000011)
                expect
                (fp #b1 #b100000000001110 #b00000000000000)))
(assert (fp.leq (fp #b1 #b100000000001110 #b00000000000000)
                expect
                (fp #b1 #b000110101011100 #b10011011111110)))

(assert (= expect result))

(check-sat)
(exit)
