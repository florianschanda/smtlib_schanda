;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111100100011000 #b10111001100110)
                arg1
                (fp #b0 #b000000000000000 #b00110110101000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00110110101000)
                arg1
                (fp #b0 #b000110000010001 #b10111011110010)))

