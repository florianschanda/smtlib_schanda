                arg2
                (fp #b1 #b01000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b01000000000000 #b0000000000000)
                arg2
                (fp #b0 #b01000000101100 #b0001110010000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101001001110 #b1111000000101)
                expect
                (fp #b1 #b10001011000011 #b0100010101111)))
(assert (fp.leq (fp #b1 #b10001011000011 #b0100010101111)
                expect
                (fp #b1 #b01000111011110 #b0010111011011)))

(assert (= expect result))

(check-sat)
(exit)
