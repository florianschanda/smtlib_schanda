(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00110111010001 #b1111001011000)
                arg1
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                arg1
                (fp #b0 #b11111111101111 #b0011111101111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10101010110110 #b0101010101000)
                arg2
                (fp #b1 #b01111111111111 #b0000000000000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0000000000000)
                arg2
                (fp #b0 #b11011000100101 #b0001100101100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010011001100 #b0100001011000)
                expect
                (fp #b0 #b01111111111111 #b0000000000000)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0000000000000)
                expect
                (fp #b0 #b11011000111111 #b0110110011000)))

(assert (= expect result))

(check-sat)
(exit)
