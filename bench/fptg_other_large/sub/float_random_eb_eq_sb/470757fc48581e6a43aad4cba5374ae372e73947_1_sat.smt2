(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101101011100 #b00011100111)
                arg1
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                arg1
                (fp #b0 #b110101011001 #b01101010011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111101111 #b11010011001)
                arg2
                (fp #b1 #b110001100101 #b10101001100)))
(assert (fp.leq (fp #b1 #b110001100101 #b10101001100)
                arg2
                (fp #b1 #b010111011101 #b01001111101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b100110000100 #b01101010010)
                expect
                (fp #b0 #b110001100101 #b10101001100)))
(assert (fp.leq (fp #b0 #b110001100101 #b10101001100)
                expect
                (fp #b0 #b110010101101 #b10000011101)))

(assert (= expect result))

(check-sat)
(exit)
