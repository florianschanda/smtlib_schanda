(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000111111101011 #b001111000101101)
                arg1
                (fp #b0 #b0000000000000000 #b101011011111011)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b101011011111011)
                arg1
                (fp #b0 #b1111011100010000 #b111000100110111)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0101101000000011 #b100011100011001)
                arg2
                (fp #b0 #b0111111111111111 #b000010100111000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000010100111000)
                arg2
                (fp #b0 #b1100000000011101 #b001110001111110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010100011100110 #b110111101101100)
                expect
                (fp #b1 #b0111111111111111 #b000010100111000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b000010100111000)
                expect
                (fp #b0 #b1010010000110101 #b000111011000101)))

(assert (= expect result))

(check-sat)
(exit)
