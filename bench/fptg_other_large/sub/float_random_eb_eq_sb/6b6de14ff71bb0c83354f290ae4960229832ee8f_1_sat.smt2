;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0010010101001010 #b001001001111000)
                arg1
                (fp #b0 #b1001111110100001 #b101000110011100)))
(assert (fp.leq (fp #b0 #b1001111110100001 #b101000110011100)
                arg1
                (fp #b0 #b1101100011101000 #b010010000111100)))

