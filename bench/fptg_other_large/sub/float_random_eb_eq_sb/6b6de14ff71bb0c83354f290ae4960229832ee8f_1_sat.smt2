                arg2
                (fp #b0 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1000000000001111 #b000000000000000)
                arg2
                (fp #b0 #b1010010110100000 #b001010110101001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0011101000000100 #b110111110100101)
                expect
                (fp #b0 #b1001111110100001 #b101000110011011)))
(assert (fp.leq (fp #b0 #b1001111110100001 #b101000110011011)
                expect
                (fp #b0 #b1010100011011000 #b001101001000111)))

(assert (= expect result))

(check-sat)
(exit)
