; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101111110 #b10110101100)
                arg1
                (fp #b0 #b100000001010 #b10001010101)))
(assert (fp.leq (fp #b0 #b100000001010 #b10001010101)
                arg1
                (fp #b0 #b111010011110 #b10011101011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011100000 #b11101111110)
                arg2
                (fp #b0 #b001000111111 #b10110001011)))
(assert (fp.leq (fp #b0 #b001000111111 #b10110001011)
                arg2
                (fp #b0 #b101110111111 #b01011100101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110111100 #b01000100000)
                expect
                (fp #b0 #b100000001010 #b10001010101)))
(assert (fp.leq (fp #b0 #b100000001010 #b10001010101)
                expect
                (fp #b0 #b111100100100 #b10110101101)))

(assert (= expect result))

(check-sat)
(exit)
