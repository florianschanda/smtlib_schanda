(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010100001100 #b01100010011)
                arg1
                (fp #b1 #b010000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b00000000000)
                arg1
                (fp #b0 #b011010001101 #b00110010001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110000101111 #b01101101101)
                arg2
                (fp #b1 #b100110100100 #b11011001001)))
(assert (fp.leq (fp #b1 #b100110100100 #b11011001001)
                arg2
                (fp #b0 #b010100010111 #b00110011000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001000000001 #b00110000011)
                expect
                (fp #b0 #b100110100100 #b11011001000)))
(assert (fp.leq (fp #b0 #b100110100100 #b11011001000)
                expect
                (fp #b0 #b101011101000 #b11000000111)))

(assert (= expect result))

(check-sat)
(exit)
