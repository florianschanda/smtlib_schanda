; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101011011010110 #b11000111011110)
                arg1
                (fp #b0 #b000101000010110 #b10000100101110)))
(assert (fp.leq (fp #b0 #b000101000010110 #b10000100101110)
                arg1
                (fp #b0 #b110000000101100 #b00000100101100)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111110000011011 #b11011110001011)
                arg2
                (fp #b1 #b100111001011010 #b11000011011010)))
(assert (fp.leq (fp #b1 #b100111001011010 #b11000011011010)
                arg2
                (fp #b0 #b111111010001100 #b10110101101111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010100011110001 #b01111011000010)
                expect
                (fp #b0 #b100111001011010 #b11000011011010)))
(assert (fp.leq (fp #b0 #b100111001011010 #b11000011011010)
                expect
                (fp #b0 #b110101111011010 #b01100100001111)))

(assert (= expect result))

(check-sat)
(exit)
