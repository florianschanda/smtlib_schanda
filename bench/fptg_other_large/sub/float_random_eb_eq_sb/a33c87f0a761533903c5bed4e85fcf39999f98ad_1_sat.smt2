                arg2
                (fp #b1 #b1000001000 #b100111000)))
(assert (fp.leq (fp #b1 #b1000001000 #b100111000)
                arg2
                (fp #b1 #b0001001010 #b101110010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000101101 #b100101010)
                expect
                (fp #b0 #b1000001000 #b100111001)))
(assert (fp.leq (fp #b0 #b1000001000 #b100111001)
                expect
                (fp #b0 #b1111001100 #b001101111)))

(assert (= expect result))

(check-sat)
(exit)
