; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001011101001 #b10100110000)
                arg1
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                arg1
                (fp #b0 #b011101100100 #b00011000110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000000001011 #b00111001001)
                arg2
                (fp #b0 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000001 #b00000000000)
                arg2
                (fp #b0 #b010101001100 #b11011111000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011101010011 #b00011001110)
                expect
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                expect
                (fp #b0 #b110001101000 #b00111110011)))

(assert (= expect result))

(check-sat)
(exit)
