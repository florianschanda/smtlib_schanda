; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b100000111111 #b01100010111)
                arg1
                (fp #b0 #b101000111000 #b00001000010)))
(assert (fp.leq (fp #b0 #b101000111000 #b00001000010)
                arg1
                (fp #b0 #b111101111010 #b11011011100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001000001110 #b01100000001)
                arg2
                (fp #b0 #b100000001000 #b10100111100)))
(assert (fp.leq (fp #b0 #b100000001000 #b10100111100)
                arg2
                (fp #b0 #b100101110110 #b01001101000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110000110 #b00000101101)
                expect
                (fp #b0 #b101000111000 #b00001000001)))
(assert (fp.leq (fp #b0 #b101000111000 #b00001000001)
                expect
                (fp #b0 #b110110010010 #b00110000110)))

(assert (= expect result))

(check-sat)
(exit)
