(assert (fp.leq (fp #b0 #b10110010001 #b0110101010)
                arg2
                (fp #b0 #b11100001011 #b0111100100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00100100011 #b1010101011)
                expect
                (fp #b0 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000)
                expect
                (fp #b0 #b11111111101 #b1000011111)))

(assert (= expect result))

(check-sat)
(exit)
