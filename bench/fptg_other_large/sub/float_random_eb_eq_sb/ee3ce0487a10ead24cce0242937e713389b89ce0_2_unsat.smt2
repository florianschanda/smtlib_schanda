; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101011000 #b001000100)
                arg1
                (fp #b1 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111111)
                arg1
                (fp #b1 #b0110101010 #b000100111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100011000 #b101111110)
                arg2
                (fp #b0 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111111)
                arg2
                (fp #b0 #b0011100111 #b100001101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100101101 #b011000100)
                expect
                (fp #b1 #b1011111111 #b000000000)))
(assert (fp.leq (fp #b1 #b1011111111 #b000000000)
                expect
                (fp #b0 #b1001110011 #b011000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
