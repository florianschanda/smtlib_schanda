; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101110111000 #b1101011010000)
                arg1
                (fp #b0 #b01010100011110 #b1100100010010)))
(assert (fp.leq (fp #b0 #b01010100011110 #b1100100010010)
                arg1
                (fp #b0 #b10100101100111 #b1100000010100)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01101101001100 #b1010100000101)
                arg2
                (fp #b0 #b10000000001100 #b1001111110101)))
(assert (fp.leq (fp #b0 #b10000000001100 #b1001111110101)
                arg2
                (fp #b0 #b10001110010010 #b0010100110010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000110010111 #b0111101111011)
                expect
                (fp #b1 #b10000000001100 #b1001111110100)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1001111110100)
                expect
                (fp #b0 #b10001110011010 #b0111100101000)))

(assert (= expect result))

(check-sat)
(exit)
