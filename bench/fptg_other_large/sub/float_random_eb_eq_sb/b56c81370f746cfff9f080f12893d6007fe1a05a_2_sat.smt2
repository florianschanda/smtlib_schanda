(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010000101100 #b11001110011)
                arg1
                (fp #b0 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000001 #b00000000000)
                arg1
                (fp #b0 #b100001011001 #b11110110111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101000000000 #b00001010001)
                arg2
                (fp #b0 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b00000000000)
                arg2
                (fp #b0 #b101011010000 #b10100000011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000010001 #b10110111011)
                expect
                (fp #b1 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000000000)
                expect
                (fp #b0 #b001000110100 #b01111010000)))

(assert (= expect result))

(check-sat)
(exit)
