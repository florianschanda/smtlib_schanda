(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0101100001000 #b111111111010)
                arg1
                (fp #b0 #b1111011011001 #b000011011001)))
(assert (fp.leq (fp #b0 #b1111011011001 #b000011011001)
                arg1
                (fp #b0 #b1111110010111 #b111010001001)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b1100011101100 #b011000011011)
                expect
                (fp #b0 #b1111011011010 #b000011011001)))
(assert (fp.leq (fp #b0 #b1111011011010 #b000011011001)
                expect
                (fp #b0 #b1111110111010 #b010101011010)))

(assert (= expect result))

(check-sat)
(exit)
