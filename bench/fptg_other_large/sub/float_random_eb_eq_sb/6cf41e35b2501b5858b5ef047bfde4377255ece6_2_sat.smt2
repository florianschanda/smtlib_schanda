(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111001101101001 #b10110001011000)
                arg1
                (fp #b1 #b100000100101000 #b00100010100001)))
(assert (fp.leq (fp #b1 #b100000100101000 #b00100010100001)
                arg1
                (fp #b1 #b000110100101000 #b01101011000111)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110010000111001 #b01110001100010)
                arg2
                (fp #b1 #b100000000001100 #b01110100100110)))
(assert (fp.leq (fp #b1 #b100000000001100 #b01110100100110)
                arg2
                (fp #b0 #b010100111001000 #b01000100100110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101100001000000 #b01010000001100)
                expect
                (fp #b1 #b100000100101000 #b00100010100001)))
(assert (fp.leq (fp #b1 #b100000100101000 #b00100010100001)
                expect
                (fp #b1 #b001001001101100 #b00101111011111)))

(assert (= expect result))

(check-sat)
(exit)
