(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110110 #b011111010)
                arg1
                (fp #b1 #b1101101100 #b100010000)))
(assert (fp.leq (fp #b1 #b1101101100 #b100010000)
                arg1
                (fp #b0 #b0000100110 #b010110001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111010 #b010111011)
                arg2
                (fp #b1 #b1000001000 #b100111000)))
(assert (fp.leq (fp #b1 #b1000001000 #b100111000)
                arg2
                (fp #b1 #b0101000001 #b011101010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110111100 #b111000101)
                expect
                (fp #b1 #b1101101100 #b100010000)))
(assert (fp.leq (fp #b1 #b1101101100 #b100010000)
                expect
                (fp #b0 #b0001110010 #b111011000)))

(assert (= expect result))

(check-sat)
(exit)
