                arg2
                (fp #b0 #b11011101011 #b0000111011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010111100 #b1110100011)
                expect
