(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00111101111 #b1000101011)
                arg1
                (fp #b1 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000001)
                arg1
                (fp #b0 #b01111001110 #b1101001011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011011100 #b0010101111)
                arg2
                (fp #b1 #b11011001000 #b1000000010)))
(assert (fp.leq (fp #b1 #b11011001000 #b1000000010)
                arg2
                (fp #b1 #b01000011101 #b1000011011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00101011111 #b1111001010)
                expect
                (fp #b0 #b11011001000 #b1000000010)))
(assert (fp.leq (fp #b0 #b11011001000 #b1000000010)
                expect
                (fp #b0 #b11111011110 #b1001001010)))

(assert (= expect result))

(check-sat)
(exit)
