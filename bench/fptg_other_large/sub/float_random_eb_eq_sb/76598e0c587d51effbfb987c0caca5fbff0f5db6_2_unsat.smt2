(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110111111 #b100111001)
                arg1
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg1
                (fp #b0 #b1001110101 #b001100011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111110 #b000011010)
                arg2
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg2
                (fp #b0 #b1010101001 #b110110010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1101010111 #b110110111)
                expect
                (fp #b0 #b1111111101 #b000000001)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000001)
                expect
                (fp #b0 #b1111111110 #b110010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
