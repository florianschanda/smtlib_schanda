                arg2
                (fp #b0 #b110011100110011101 #b10011011011001100)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111101100101111100 #b01100110110010011)
                expect
                (fp #b1 #b101101011001111011 #b11010101101010101)))
(assert (fp.leq (fp #b1 #b101101011001111011 #b11010101101010101)
                expect
                (fp #b0 #b101101001010011100 #b01010000110110111)))

(assert (= expect result))

(check-sat)
