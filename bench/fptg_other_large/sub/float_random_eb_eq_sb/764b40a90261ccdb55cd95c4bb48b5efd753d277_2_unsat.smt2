(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000011010 #b000001111)
                arg1
                (fp #b1 #b0111111111 #b111000101)))
(assert (fp.leq (fp #b1 #b0111111111 #b111000101)
                arg1
                (fp #b1 #b0101101000 #b100000111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101100010 #b010011001)
                arg2
                (fp #b0 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111111)
                arg2
                (fp #b0 #b1110010010 #b011110101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011111100 #b010000011)
                expect
                (fp #b1 #b0111111111 #b111000110)))
(assert (fp.leq (fp #b1 #b0111111111 #b111000110)
                expect
                (fp #b0 #b1111001000 #b011101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
