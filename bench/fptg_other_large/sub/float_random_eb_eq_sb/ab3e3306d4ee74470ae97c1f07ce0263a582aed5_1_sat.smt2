; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111011111111 #b0001110001111)
                arg1
                (fp #b0 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b0 #b00111111111001 #b0110101000001)
                arg1
                (fp #b0 #b01011100110011 #b1000111100111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110000010101 #b0000001100011)
                arg2
                (fp #b1 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100000000000)
                arg2
                (fp #b0 #b01001000011111 #b0100111010011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000010001000 #b0011100001001)
                expect
                (fp #b0 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b0 #b00111111111001 #b0110101000001)
                expect
                (fp #b0 #b10011110011101 #b1001011100101)))

(assert (= expect result))

(check-sat)
(exit)
