(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000000 #b00101111)
                arg1
                (fp #b0 #b000000001 #b00000000)))
(assert (fp.leq (fp #b0 #b000000001 #b00000000)
                arg1
                (fp #b0 #b100010011 #b01000110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010010 #b00100001)
                arg2
                (fp #b1 #b101111110 #b11111111)))
(assert (fp.leq (fp #b1 #b101111110 #b11111111)
                arg2
                (fp #b1 #b001000011 #b00010100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010010101 #b00101000)
                expect
                (fp #b0 #b101111111 #b00000000)))
(assert (fp.leq (fp #b0 #b101111111 #b00000000)
                expect
                (fp #b0 #b110101111 #b00000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
