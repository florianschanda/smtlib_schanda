; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: +ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b10111000011000101 #b1000110000010000)
                arg2
                (fp #b0 #b00000000000000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000000000000000)
                arg2
                (fp #b0 #b01101011101001001 #b1010100010000001)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
