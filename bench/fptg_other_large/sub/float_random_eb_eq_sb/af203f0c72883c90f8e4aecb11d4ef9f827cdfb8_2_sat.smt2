(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0110111100001 #b011111110000)
                arg1
                (fp #b0 #b0111111111111 #b001001111010)))
(assert (fp.leq (fp #b0 #b0111111111111 #b001001111010)
                arg1
                (fp #b0 #b1111110110100 #b010000111000)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1110100111011 #b111001000100)
                expect
                (fp #b1 #b0000000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000000000000)
                expect
                (fp #b0 #b1101110111111 #b101001100110)))

(assert (= expect result))

(check-sat)
(exit)
