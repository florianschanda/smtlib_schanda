; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10000101100110000 #b0101001011010110)
                arg1
                (fp #b1 #b01111111111111111 #b1110010001100101)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1110010001100101)
                arg1
                (fp #b0 #b00110110111011110 #b0110011111000111)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10100100101000111 #b1100111101110010)
                expect
                (fp #b0 #b00000000000000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000000000000000)
                expect
                (fp #b0 #b10110100010000100 #b1111001010110111)))

(assert (= expect result))

(check-sat)
(exit)
