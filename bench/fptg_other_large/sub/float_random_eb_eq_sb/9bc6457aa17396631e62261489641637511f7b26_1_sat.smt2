(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100001001000001100 #b01110110110111011)
                arg1
                (fp #b0 #b001000101000010010 #b10000100101011010)))
(assert (fp.leq (fp #b0 #b001000101000010010 #b10000100101011010)
                arg1
                (fp #b0 #b011110101111101000 #b11001011110100000)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b000100101011111000 #b00001000011010010)
                arg2
                (fp #b0 #b100000000000010000 #b10101011101111000)))
(assert (fp.leq (fp #b0 #b100000000000010000 #b10101011101111000)
                arg2
                (fp #b0 #b100101000110111101 #b01011111000101110)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101001010100101111 #b10001101011101000)
                expect
                (fp #b1 #b100000000000010000 #b10101011101110111)))
(assert (fp.leq (fp #b1 #b100000000000010000 #b10101011101110111)
                expect
                (fp #b0 #b000010001100011011 #b00101000011101111)))

(assert (= expect result))

(check-sat)
(exit)
