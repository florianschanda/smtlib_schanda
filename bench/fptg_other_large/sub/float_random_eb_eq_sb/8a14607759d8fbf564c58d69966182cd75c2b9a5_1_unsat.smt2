; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001000011 #b1111111000)
                arg1
                (fp #b0 #b01000001000 #b1000101010)))
(assert (fp.leq (fp #b0 #b01000001000 #b1000101010)
                arg1
                (fp #b0 #b01000111110 #b1101111100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010101010 #b0111000101)
                arg2
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg2
                (fp #b0 #b00001001000 #b0010101111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01010010000 #b1000010000)
                expect
                (fp #b0 #b01000001000 #b1000101001)))
(assert (fp.leq (fp #b0 #b01000001000 #b1000101001)
                expect
                (fp #b0 #b10111001010 #b1111011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
