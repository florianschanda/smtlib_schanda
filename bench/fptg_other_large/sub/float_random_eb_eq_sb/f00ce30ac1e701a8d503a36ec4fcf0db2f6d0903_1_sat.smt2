; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001001011110 #b0100011100010)
                arg1
                (fp #b1 #b00000000000000 #b1111111111111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1111111111111)
                arg1
                (fp #b0 #b10000101111001 #b0110010101010)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01100110000000 #b1011111010100)
                arg2
                (fp #b0 #b10000110110110 #b0101110110001)))
(assert (fp.leq (fp #b0 #b10000110110110 #b0101110110001)
                arg2
                (fp #b0 #b10010100111010 #b0110100101111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11001111010001 #b1011101000011)
                expect
                (fp #b1 #b10000110110110 #b0101110110001)))
(assert (fp.leq (fp #b1 #b10000110110110 #b0101110110001)
                expect
                (fp #b0 #b00111010110111 #b1111110100110)))

(assert (= expect result))

(check-sat)
(exit)
