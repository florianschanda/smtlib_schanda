; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010100100 #b11101111101)
                arg1
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg1
                (fp #b0 #b100010001100 #b10001010110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011111000110 #b00111001011)
                arg2
                (fp #b1 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b001111111010 #b01101010000)
                arg2
                (fp #b1 #b000111010011 #b01010100000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110110011 #b11101010001)
                expect
                (fp #b0 #b001111111010 #b01101001111)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101001111)
                expect
                (fp #b0 #b110111010011 #b00001000110)))

(assert (= expect result))

(check-sat)
(exit)
