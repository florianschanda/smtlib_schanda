; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111001111001000 #b110100100001011)
                arg1
                (fp #b1 #b1111001000110110 #b011010010000011)))
(assert (fp.leq (fp #b1 #b1111001000110110 #b011010010000011)
                arg1
                (fp #b1 #b0100110111001001 #b000101100101101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111000101111110 #b010010110001100)
                arg2
                (fp #b1 #b1100010001011010 #b111000111000010)))
(assert (fp.leq (fp #b1 #b1100010001011010 #b111000111000010)
                arg2
                (fp #b1 #b1010110011111111 #b110010110110111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111001011000101 #b000110000101010)
                expect
                (fp #b1 #b1111001000110110 #b011010010000010)))
(assert (fp.leq (fp #b1 #b1111001000110110 #b011010010000010)
                expect
                (fp #b1 #b0100111110111101 #b001101011011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
