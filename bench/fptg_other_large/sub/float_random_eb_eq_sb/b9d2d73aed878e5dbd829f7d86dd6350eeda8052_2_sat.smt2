                (fp #b0 #b1011111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b111111111111111)
                arg2
                (fp #b0 #b1110110100111100 #b001110010101100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110001010000110 #b011110011101001)
                expect
                (fp #b1 #b1011111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1011111111111110 #b111111111111111)
                expect
                (fp #b1 #b0001010001101010 #b010000010001010)))

(assert (= expect result))

(check-sat)
