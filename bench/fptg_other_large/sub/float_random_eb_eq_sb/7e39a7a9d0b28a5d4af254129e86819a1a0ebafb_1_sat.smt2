(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110110011 #b00001001100)
                arg1
                (fp #b1 #b100000001010 #b01101011101)))
(assert (fp.leq (fp #b1 #b100000001010 #b01101011101)
                arg1
                (fp #b1 #b000111000100 #b00110110100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011111010011 #b01001111001)
                arg2
                (fp #b1 #b000000000000 #b10001001100)))
(assert (fp.leq (fp #b1 #b000000000000 #b10001001100)
                arg2
                (fp #b0 #b110110110100 #b11100110110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011010101 #b11101111101)
                expect
                (fp #b1 #b100000001010 #b01101011100)))
(assert (fp.leq (fp #b1 #b100000001010 #b01101011100)
                expect
                (fp #b0 #b110011001001 #b10100100110)))

(assert (= expect result))

(check-sat)
(exit)
