                arg2
                (fp #b1 #b11100110110100 #b1101101000111)))
(assert (fp.leq (fp #b1 #b11100110110100 #b1101101000111)
                arg2
                (fp #b0 #b00010010011001 #b0110010111100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110000100110 #b1100010011110)
                expect
                (fp #b1 #b11101110010101 #b1000100010010)))
(assert (fp.leq (fp #b1 #b11101110010101 #b1000100010010)
                expect
                (fp #b1 #b01110011010110 #b1010010110001)))

(assert (= expect result))

(check-sat)
