; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111110000110 #b0111010011010)
                arg1
                (fp #b1 #b11111010101000 #b1111010011101)))
(assert (fp.leq (fp #b1 #b11111010101000 #b1111010011101)
                arg1
                (fp #b0 #b00000101111101 #b0001010010011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110001010101 #b1100001111010)
                arg2
                (fp #b1 #b01111111111111 #b0100100001010)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0100100001010)
                arg2
                (fp #b0 #b01001100011111 #b1110000011100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111011111 #b0011100010011)
                expect
                (fp #b1 #b11111010101000 #b1111010011101)))
(assert (fp.leq (fp #b1 #b11111010101000 #b1111010011101)
                expect
                (fp #b0 #b01000010000101 #b0110011000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
