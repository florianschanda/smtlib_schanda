(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110100101 #b01010101011)
                expect
                (fp #b0 #b000000000001 #b00101101100)))
(assert (fp.leq (fp #b0 #b000000000001 #b00101101100)
                expect
                (fp #b0 #b100110011010 #b10010100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
