; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: -NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100011000000010010 #b11010000001101001)
                arg1
                (fp #b0 #b011111111111111111 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b00000000000000000)
                arg1
                (fp #b0 #b111011011010110101 #b11000001011100111)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
