; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101011000 #b001100100)
                arg1
                (fp #b1 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b1 #b0011111011 #b011010100)
                arg1
                (fp #b1 #b0000010100 #b000000000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111110 #b101100010)
                arg2
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg2
                (fp #b0 #b0001111100 #b111111011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000111010 #b010110000)
                expect
                (fp #b0 #b1111111100 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111100 #b111111111)
                expect
                (fp #b0 #b1111111110 #b001000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
