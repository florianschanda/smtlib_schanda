                arg2
                (fp #b0 #b001111100 #b00000000)))
(assert (fp.leq (fp #b0 #b001111100 #b00000000)
                arg2
                (fp #b0 #b100010011 #b11001100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111101 #b10110110)
                expect
                (fp #b1 #b001111100 #b00000001)))
(assert (fp.leq (fp #b1 #b001111100 #b00000001)
                expect
                (fp #b1 #b000000110 #b10011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
