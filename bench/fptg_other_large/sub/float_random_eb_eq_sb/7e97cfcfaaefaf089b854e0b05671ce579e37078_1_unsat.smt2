; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000001001000011 #b110110100111010)
                arg1
                (fp #b1 #b1000000000001111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001111 #b000000000000000)
                arg1
                (fp #b0 #b1000110011011000 #b101100100111101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0110011001000000 #b110001011011110)
                arg2
                (fp #b0 #b1011010110011111 #b101101010110110)))
(assert (fp.leq (fp #b0 #b1011010110011111 #b101101010110110)
                arg2
                (fp #b0 #b1110111100101000 #b001101011110100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100110010101010 #b111100110000100)
                expect
                (fp #b1 #b1011010110011111 #b101101010110110)))
(assert (fp.leq (fp #b1 #b1011010110011111 #b101101010110110)
                expect
                (fp #b0 #b1110100000001100 #b011110110110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
