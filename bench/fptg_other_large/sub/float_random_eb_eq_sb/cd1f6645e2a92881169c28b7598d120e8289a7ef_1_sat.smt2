(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101000101 #b100110110)
                arg1
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b1010000001 #b001000101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010101100 #b010010000)
                arg2
                (fp #b0 #b0111111111 #b000000101)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000101)
                arg2
                (fp #b0 #b1001011001 #b101011011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011001 #b001101001)
                expect
                (fp #b1 #b0111111111 #b000000100)))
(assert (fp.leq (fp #b1 #b0111111111 #b000000100)
                expect
                (fp #b1 #b0001100101 #b001100100)))

(assert (= expect result))

(check-sat)
(exit)
