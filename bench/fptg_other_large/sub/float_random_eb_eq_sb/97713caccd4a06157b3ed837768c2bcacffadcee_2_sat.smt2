;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b010110010011001 #b00001001111000)
                arg1
                (fp #b0 #b100000000001101 #b00111110110010)))
(assert (fp.leq (fp #b0 #b100000000001101 #b00111110110010)
                arg1
                (fp #b0 #b110111110001001 #b00110100010011)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b010001000100011 #b01101001010100)
                arg2
                (fp #b0 #b010011000010010 #b01011011110110)))
(assert (fp.leq (fp #b0 #b010011000010010 #b01011011110110)
                arg2
                (fp #b0 #b011011100011100 #b00011011011110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111011110011010 #b11111111111101)
                expect
                (fp #b0 #b100000000001101 #b00111110110010)))
(assert (fp.leq (fp #b0 #b100000000001101 #b00111110110010)
                expect
                (fp #b0 #b111100110100011 #b01110010001000)))

(assert (= expect result))

(check-sat)
(exit)
