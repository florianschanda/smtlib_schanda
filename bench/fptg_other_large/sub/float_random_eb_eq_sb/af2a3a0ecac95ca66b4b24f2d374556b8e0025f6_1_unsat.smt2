; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1010101100001 #b101111011000)
                arg1
                (fp #b1 #b1000000001100 #b000000000000)))
(assert (fp.leq (fp #b1 #b1000000001100 #b000000000000)
                arg1
                (fp #b0 #b0101110101011 #b101111001000)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
