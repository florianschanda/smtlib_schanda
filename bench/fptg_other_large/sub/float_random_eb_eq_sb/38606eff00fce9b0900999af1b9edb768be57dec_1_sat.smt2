(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101101100 #b101000000)
                arg1
                (fp #b1 #b1001110101 #b100001111)))
(assert (fp.leq (fp #b1 #b1001110101 #b100001111)
                arg1
                (fp #b0 #b0000101100 #b011100100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100111 #b110111111)
                expect
                (fp #b1 #b1001110110 #b100001111)))
(assert (fp.leq (fp #b1 #b1001110110 #b100001111)
                expect
                (fp #b1 #b1001000101 #b011011001)))

(assert (= expect result))

(check-sat)
(exit)
