(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01110101010 #b0100000000)
                arg1
                (fp #b0 #b00101101011 #b1101010101)))
(assert (fp.leq (fp #b0 #b00101101011 #b1101010101)
                arg1
                (fp #b0 #b01000110111 #b1001001101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110011001 #b0010010001)
                arg2
                (fp #b1 #b11011001000 #b1000000010)))
(assert (fp.leq (fp #b1 #b11011001000 #b1000000010)
                arg2
                (fp #b1 #b01100001111 #b0001110010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01101010101 #b0001101100)
                expect
                (fp #b0 #b11011001000 #b1000000011)))
(assert (fp.leq (fp #b0 #b11011001000 #b1000000011)
                expect
                (fp #b0 #b11100010111 #b0000110000)))

(assert (= expect result))

(check-sat)
(exit)
