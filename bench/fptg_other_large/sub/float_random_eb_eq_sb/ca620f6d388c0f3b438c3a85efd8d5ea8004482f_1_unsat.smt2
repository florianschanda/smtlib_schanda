(assert (fp.leq (fp #b1 #b01000000000000 #b0000000000000)
                arg2
                (fp #b1 #b00100111111010 #b1100111000010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011011100000 #b0011011011111)
                expect
                (fp #b1 #b10000000001100 #b1111100010100)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1111100010100)
                expect
                (fp #b1 #b01011001111101 #b0010110101111)))

(assert (not (= expect result)))

(check-sat)
