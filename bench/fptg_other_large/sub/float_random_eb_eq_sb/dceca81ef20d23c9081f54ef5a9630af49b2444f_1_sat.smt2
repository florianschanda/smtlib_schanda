(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110000010100 #b1011111111000)
                arg1
                (fp #b0 #b01010000110100 #b0000100110100)))
(assert (fp.leq (fp #b0 #b01010000110100 #b0000100110100)
                arg1
                (fp #b0 #b01100000001001 #b0111010111001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110101101000 #b1011100011111)
                arg2
                (fp #b1 #b00000000000000 #b0000000000001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000001)
                arg2
                (fp #b0 #b01000101111110 #b0111100100001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00100001101000 #b0011010111111)
                expect
                (fp #b0 #b01010000110100 #b0000100110100)))
(assert (fp.leq (fp #b0 #b01010000110100 #b0000100110100)
                expect
                (fp #b0 #b01011100011010 #b1000100010010)))

(assert (= expect result))

(check-sat)
(exit)
