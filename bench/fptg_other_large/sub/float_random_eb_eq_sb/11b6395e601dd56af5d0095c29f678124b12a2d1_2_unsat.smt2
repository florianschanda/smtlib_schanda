                (fp #b1 #b011111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111 #b00000000)
                arg2
                (fp #b0 #b011101110 #b11100000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011010001 #b11001010)
                expect
                (fp #b0 #b100000000 #b00001010)))
(assert (fp.leq (fp #b0 #b100000000 #b00001010)
                expect
                (fp #b0 #b111011000 #b11011011)))

(assert (not (= expect result)))

(check-sat)
