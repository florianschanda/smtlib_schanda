(assert (fp.leq (fp #b1 #b111110011001010 #b11101100011010)
                arg2
                (fp #b0 #b000000001001111 #b11000010101001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b110010110101010 #b01111111011101)
                expect
                (fp #b0 #b111110011001010 #b11101100011010)))
(assert (fp.leq (fp #b0 #b111110011001010 #b11101100011010)
                expect
                (fp #b0 #b111111100110010 #b10010111001011)))

(assert (= expect result))

(check-sat)
