;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111010011111 #b01110111010)
                arg1
                (fp #b1 #b000000000000 #b10011011110)))
(assert (fp.leq (fp #b1 #b000000000000 #b10011011110)
                arg1
                (fp #b0 #b001010111011 #b01100001111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111010111101 #b10101011011)
                arg2
                (fp #b1 #b010000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b00000000000)
                arg2
                (fp #b0 #b111101110010 #b00111111101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101001110011 #b10101100001)
                expect
                (fp #b0 #b010000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b010000000000 #b00000000000)
                expect
                (fp #b0 #b110111011111 #b11011000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
