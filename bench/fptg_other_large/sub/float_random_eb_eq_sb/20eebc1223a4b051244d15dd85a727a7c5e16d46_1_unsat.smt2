; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000010000 #b101110110)
                arg1
                (fp #b1 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b111111111)
                arg1
                (fp #b0 #b1001000011 #b000011100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000110110 #b101000100)
                arg2
                (fp #b0 #b0111111111 #b111110111)))
(assert (fp.leq (fp #b0 #b0111111111 #b111110111)
                arg2
                (fp #b0 #b1110000011 #b100111011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000100111 #b110110010)
                expect
                (fp #b1 #b0111111111 #b111110111)))
(assert (fp.leq (fp #b1 #b0111111111 #b111110111)
                expect
                (fp #b1 #b0101000101 #b000101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
