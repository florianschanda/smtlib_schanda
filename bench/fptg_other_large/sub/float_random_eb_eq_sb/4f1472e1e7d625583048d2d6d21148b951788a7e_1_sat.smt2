(assert (fp.leq (fp #b0 #b0111111111111111 #b001111010011110)
                arg2
                (fp #b0 #b1101011010110011 #b000001000011111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001000111001111 #b111000010011111)
                expect
                (fp #b1 #b0111111111111111 #b001111010011101)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b001111010011101)
                expect
                (fp #b0 #b1100001001010010 #b110110000001000)))

(assert (= expect result))

(check-sat)
