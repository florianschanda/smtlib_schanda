; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111100100100 #b000111100100)
                arg1
                (fp #b1 #b1011111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b111111111111)
                arg1
                (fp #b0 #b0011001100111 #b011100100011)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111111111111 #b000000000000)
                arg2
                (fp #b1 #b1111111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b111111111111)
                arg2
                (fp #b1 #b0010000100000 #b101010011011)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b1011010101011 #b011111000010)
                expect
                (fp #b0 #b1111111111110 #b111111111110)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111111111110)
                expect
                (fp #b0 #b1111111111111 #b000000000000)))

(assert (= expect result))

(check-sat)
(exit)
