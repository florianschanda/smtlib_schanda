; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100011011 #b00011101111)
                arg1
                (fp #b1 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b001111111010 #b01101010000)
                arg1
                (fp #b0 #b110011010100 #b00101000010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010001010100 #b10001010101)
                arg2
                (fp #b1 #b010000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b00000000000)
                arg2
                (fp #b0 #b110110011001 #b11010011100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000101010001 #b11000100100)
                expect
                (fp #b0 #b001111111111 #b11110100110)))
(assert (fp.leq (fp #b0 #b001111111111 #b11110100110)
                expect
                (fp #b0 #b010011101001 #b01010100101)))

(assert (= expect result))

(check-sat)
(exit)
