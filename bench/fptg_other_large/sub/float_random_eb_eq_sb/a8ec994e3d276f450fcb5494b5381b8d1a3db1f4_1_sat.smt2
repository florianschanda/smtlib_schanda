                arg2
                (fp #b1 #b01000011101 #b0111100011)))
(assert (fp.leq (fp #b1 #b01000011101 #b0111100011)
                arg2
                (fp #b0 #b11001000011 #b1010010101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001110110 #b0111001110)
                expect
                (fp #b0 #b01000011101 #b0111100011)))
(assert (fp.leq (fp #b0 #b01000011101 #b0111100011)
                expect
                (fp #b0 #b10100010001 #b1000001111)))

(assert (= expect result))

(check-sat)
(exit)
