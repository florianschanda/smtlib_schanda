                arg2
                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b0 #b00000111001 #b1100011010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101110101 #b1111000100)
                expect
                (fp #b0 #b11110001011 #b0011101001)))
(assert (fp.leq (fp #b0 #b11110001011 #b0011101001)
                expect
                (fp #b0 #b11110001111 #b0001010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
