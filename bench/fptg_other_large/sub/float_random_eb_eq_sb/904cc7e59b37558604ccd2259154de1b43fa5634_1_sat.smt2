(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100010110 #b000100000)
                arg1
                (fp #b0 #b0111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b0111111111 #b111111100)
                arg1
                (fp #b0 #b1101011111 #b011111001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0000011111 #b101110000)
                arg2
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg2
                (fp #b0 #b0100011000 #b001100110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101001011 #b100110101)
                expect
                (fp #b0 #b0111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b0111111111 #b111111100)
                expect
                (fp #b0 #b1110111111 #b000000111)))

(assert (= expect result))

(check-sat)
(exit)
