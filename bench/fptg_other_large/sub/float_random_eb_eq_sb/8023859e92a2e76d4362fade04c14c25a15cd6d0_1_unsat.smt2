; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -INFINITY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b010010010001010110 #b10111001001101110)
                arg1
                (fp #b0 #b100000000000001110 #b11110100010011100)))
(assert (fp.leq (fp #b0 #b100000000000001110 #b11110100010011100)
                arg1
                (fp #b0 #b111011111000110010 #b11101110111101001)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
