(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100000 #b01010011)
                arg1
                (fp #b0 #b000000001 #b00000000)))
(assert (fp.leq (fp #b0 #b000000001 #b00000000)
                arg1
                (fp #b0 #b111100000 #b11010111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101100 #b11100101)
                arg2
                (fp #b0 #b000011101 #b00011110)))
(assert (fp.leq (fp #b0 #b000011101 #b00011110)
                arg2
                (fp #b0 #b011011011 #b01101010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111000 #b01111011)
                expect
                (fp #b1 #b000011101 #b00011101)))
(assert (fp.leq (fp #b1 #b000011101 #b00011101)
                expect
                (fp #b0 #b111100100 #b11010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
