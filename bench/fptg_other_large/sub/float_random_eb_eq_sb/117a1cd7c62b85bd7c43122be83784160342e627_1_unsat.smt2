                (fp #b0 #b10110010001 #b0110101010)))
(assert (fp.leq (fp #b0 #b10110010001 #b0110101010)
                arg2
                (fp #b0 #b11011000010 #b1010111111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101010000 #b1110011010)
                expect
                (fp #b1 #b10110010001 #b0110101001)))
(assert (fp.leq (fp #b1 #b10110010001 #b0110101001)
                expect
                (fp #b0 #b10110000100 #b0011110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
