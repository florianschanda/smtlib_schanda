(assert (fp.leq (fp #b1 #b10010100010 #b0000000111)
                arg2
                (fp #b0 #b11000100101 #b0001110110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00111101010 #b1111110011)
                expect
                (fp #b0 #b10010100010 #b0000000110)))
(assert (fp.leq (fp #b0 #b10010100010 #b0000000110)
                expect
                (fp #b0 #b10011111011 #b1100000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
