(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000000 #b10000001)
                arg1
                (fp #b1 #b000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b000000000 #b00010010)
                arg1
                (fp #b0 #b101011100 #b01000111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011110111 #b11000111)
                arg2
                (fp #b0 #b101111010 #b00100100)))
(assert (fp.leq (fp #b0 #b101111010 #b00100100)
                arg2
                (fp #b0 #b111010010 #b00011111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011010 #b11010011)
                expect
                (fp #b1 #b101111010 #b00100101)))
(assert (fp.leq (fp #b1 #b101111010 #b00100101)
                expect
                (fp #b0 #b000010011 #b01100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
