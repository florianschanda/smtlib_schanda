(assert (fp.leq (fp #b0 #b01000000000000 #b0000000000000)
                arg2
                (fp #b0 #b01001011011001 #b0010101111100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b00000110000100 #b1010111100111)
                expect
                (fp #b0 #b11111010010100 #b0000010100010)))
(assert (fp.leq (fp #b0 #b11111010010100 #b0000010100010)
                expect
                (fp #b0 #b11111111010011 #b0010011011011)))

(assert (not (= expect result)))

