                arg2
                (fp #b0 #b11111111111101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000000000000)
                arg2
                (fp #b0 #b11111111111110 #b1000010011010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111111110 #b1011100000111)
                expect
                (fp #b1 #b11111111111100 #b1111111111111)))
(assert (fp.leq (fp #b1 #b11111111111100 #b1111111111111)
                expect
                (fp #b0 #b00010110010000 #b1000010101011)))

(assert (= expect result))

(check-sat)
(exit)
