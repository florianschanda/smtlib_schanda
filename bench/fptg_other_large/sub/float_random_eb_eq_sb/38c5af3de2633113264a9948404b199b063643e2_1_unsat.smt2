(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100111 #b01000101)
                arg1
                (fp #b1 #b010000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000 #b00000000)
                arg1
                (fp #b0 #b111111110 #b10001000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100101 #b01010100)
                arg2
                (fp #b1 #b101101100 #b10101111)))
(assert (fp.leq (fp #b1 #b101101100 #b10101111)
                arg2
                (fp #b0 #b101010101 #b00100000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000010000 #b11011001)
                expect
                (fp #b0 #b101101100 #b10101110)))
(assert (fp.leq (fp #b0 #b101101100 #b10101110)
                expect
                (fp #b0 #b111011011 #b00101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
