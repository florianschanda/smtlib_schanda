                (fp #b0 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b10000000001101 #b0000000000000)
                arg2
                (fp #b0 #b11101110011100 #b1010001011010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000001111110 #b1011110101010)
                expect
                (fp #b1 #b10000000001101 #b0000000000001)))
(assert (fp.leq (fp #b1 #b10000000001101 #b0000000000001)
                expect
                (fp #b1 #b00111100101011 #b0001001100000)))

(assert (not (= expect result)))

(check-sat)
