; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010101000 #b1101111010)
                arg1
                (fp #b1 #b01010111000 #b1011111111)))
(assert (fp.leq (fp #b1 #b01010111000 #b1011111111)
                arg1
                (fp #b0 #b11001011011 #b0111011100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001010000 #b1111001110)
                arg2
                (fp #b1 #b00000000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000000 #b0101011111)
                arg2
                (fp #b0 #b01111101011 #b1101100010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101101011 #b1101100010)
                expect
                (fp #b1 #b01010111000 #b1011111111)))
(assert (fp.leq (fp #b1 #b01010111000 #b1011111111)
                expect
                (fp #b0 #b01110000010 #b1001110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
