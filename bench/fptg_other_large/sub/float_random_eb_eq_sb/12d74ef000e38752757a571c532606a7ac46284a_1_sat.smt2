(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101111111010100101 #b01101001010110011)
                expect
                (fp #b1 #b011111111111111111 #b10010011010111011)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b10010011010111011)
                expect
                (fp #b0 #b101100000000111101 #b01001011100011111)))

(assert (= expect result))

