(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010111111 #b01001100)
                arg1
                (fp #b1 #b000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b000000001 #b00000000)
                arg1
                (fp #b0 #b010110100 #b00010000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100101110 #b01000000)
                arg2
                (fp #b1 #b011111111 #b00010001)))
(assert (fp.leq (fp #b1 #b011111111 #b00010001)
                arg2
                (fp #b1 #b011011010 #b00111001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010011110 #b11101001)
                expect
                (fp #b0 #b011111111 #b00010000)))
(assert (fp.leq (fp #b0 #b011111111 #b00010000)
                expect
                (fp #b0 #b100110000 #b01111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
