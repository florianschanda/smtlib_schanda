; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111101110101110 #b010010110111010)
                arg1
                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg1
                (fp #b0 #b1011111011010011 #b101101100000111)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110111110101100 #b111011010010110)
                arg2
                (fp #b1 #b0000000000000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b111111111111111)
                arg2
                (fp #b0 #b1101001101001111 #b111101011110000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110011110111101 #b101000100101010)
                expect
                (fp #b0 #b0011111111111000 #b011010100000110)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000110)
                expect
                (fp #b0 #b1100111111100100 #b110101011011110)))

(assert (= expect result))

(check-sat)
(exit)
