; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101111001 #b01010111)
                arg1
                (fp #b0 #b001111100 #b00000000)))
(assert (fp.leq (fp #b0 #b001111100 #b00000000)
                arg1
                (fp #b0 #b111100101 #b00100000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010100100 #b10111100)
                arg2
                (fp #b0 #b100000111 #b01000010)))
(assert (fp.leq (fp #b0 #b100000111 #b01000010)
                arg2
                (fp #b0 #b110010000 #b11001100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011000 #b01001100)
                expect
                (fp #b1 #b100000111 #b01000001)))
(assert (fp.leq (fp #b1 #b100000111 #b01000001)
                expect
                (fp #b0 #b000010001 #b11011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
