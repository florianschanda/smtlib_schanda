;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0110000100001000 #b110010101101000)
                arg1
                (fp #b0 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000000000000000)
                arg1
                (fp #b0 #b1000111100111100 #b001011000011111)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100100111101000 #b100101110111101)
                arg2
                (fp #b0 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000000)
                arg2
                (fp #b0 #b1111111111111110 #b000111000100000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000001111101010)
                expect
                (fp #b1 #b1111111111111100 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111100 #b111111111111111)
                expect
                (fp #b1 #b1010000001111101 #b111001010010011)))

(assert (= expect result))

(check-sat)
(exit)
