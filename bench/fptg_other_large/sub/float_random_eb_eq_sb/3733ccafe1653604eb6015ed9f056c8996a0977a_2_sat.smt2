; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0010010111010100 #b011111101001001)
                arg1
                (fp #b0 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000000)
                arg1
                (fp #b0 #b1111111111111110 #b110100101011111)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101111110101111 #b100110111001101)
                arg2
                (fp #b1 #b1101111001100001 #b011101100001111)))
(assert (fp.leq (fp #b1 #b1101111001100001 #b011101100001111)
                arg2
                (fp #b0 #b1011110110101010 #b110111000011000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110111000010111 #b010110001001001)
                expect
                (fp #b0 #b1111111111111101 #b000000000000001)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000001)
                expect
                (fp #b0 #b1111111111111101 #b011001010011110)))

(assert (= expect result))

(check-sat)
(exit)
