; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011000001 #b00101110)
                arg1
                (fp #b0 #b101111110 #b11111111)))
(assert (fp.leq (fp #b0 #b101111110 #b11111111)
                arg1
                (fp #b0 #b110101001 #b01010011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101110101 #b10100000)
                arg2
                (fp #b1 #b011111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111 #b00000000)
                arg2
                (fp #b0 #b111010011 #b00111110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011111010 #b11110110)
                expect
                (fp #b0 #b101111111 #b00000000)))
(assert (fp.leq (fp #b0 #b101111111 #b00000000)
                expect
                (fp #b0 #b110000101 #b10010110)))

(assert (= expect result))

(check-sat)
(exit)
