; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110100100 #b1010011111)
                arg1
                (fp #b1 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000)
                arg1
                (fp #b0 #b11001101011 #b0001000011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110100100 #b0000001001)
                arg2
                (fp #b1 #b11110100000 #b1100010110)))
(assert (fp.leq (fp #b1 #b11110100000 #b1100010110)
                arg2
                (fp #b1 #b00100100001 #b1111101111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001000011 #b1100110111)
                expect
                (fp #b0 #b11110100000 #b1100010101)))
(assert (fp.leq (fp #b0 #b11110100000 #b1100010101)
                expect
                (fp #b0 #b11111011000 #b0111001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
