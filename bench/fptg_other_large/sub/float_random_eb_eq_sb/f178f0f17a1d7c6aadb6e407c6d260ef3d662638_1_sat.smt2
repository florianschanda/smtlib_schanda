; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b101011100100 #b11001010101)
                arg1
                (fp #b0 #b101111101111 #b00110110010)))
(assert (fp.leq (fp #b0 #b101111101111 #b00110110010)
                arg1
                (fp #b0 #b111001010000 #b10001000111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100011000110 #b10010011001)
                arg2
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg2
                (fp #b0 #b001000111011 #b10111101010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100001100100 #b00011110100)
                expect
                (fp #b0 #b101111101111 #b00110110010)))
(assert (fp.leq (fp #b0 #b101111101111 #b00110110010)
                expect
                (fp #b0 #b111001110101 #b00011000001)))

(assert (= expect result))

(check-sat)
(exit)
