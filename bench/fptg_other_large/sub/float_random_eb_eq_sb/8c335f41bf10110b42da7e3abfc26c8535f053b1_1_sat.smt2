; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011100010000 #b0010011101101)
                arg1
                (fp #b1 #b00000000000001 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000001 #b0000000000000)
                arg1
                (fp #b0 #b10111001000110 #b1000110110111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110100000011 #b0001001000001)
                arg2
                (fp #b1 #b11100110110100 #b1101101000111)))
(assert (fp.leq (fp #b1 #b11100110110100 #b1101101000111)
                arg2
                (fp #b0 #b01001110110110 #b0001110010111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00101010010010 #b1001010100011)
                expect
                (fp #b0 #b11100110110100 #b1101101000110)))
(assert (fp.leq (fp #b0 #b11100110110100 #b1101101000110)
                expect
                (fp #b0 #b11111111111101 #b0001011001110)))

(assert (= expect result))

(check-sat)
(exit)
