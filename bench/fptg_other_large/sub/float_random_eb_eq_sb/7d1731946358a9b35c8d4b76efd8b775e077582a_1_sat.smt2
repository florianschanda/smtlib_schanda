(assert (fp.leq (fp #b1 #b00000000000001 #b0000000000000)
                arg2
                (fp #b0 #b10010000011111 #b1110000101101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111110000111 #b1011001001101)
                expect
                (fp #b0 #b01111111111111 #b0000000000000)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0000000000000)
                expect
                (fp #b0 #b10001111100111 #b1001011000100)))

(assert (= expect result))

(check-sat)
(exit)
