;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101000000101 #b011111001101)
                arg1
                (fp #b1 #b1011111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b111111111111)
                arg1
                (fp #b1 #b0100100101011 #b001010110111)))

