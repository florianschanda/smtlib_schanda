                arg2
                (fp #b1 #b1000011101100 #b010000011011)))
(assert (fp.leq (fp #b1 #b1000011101100 #b010000011011)
                arg2
                (fp #b0 #b1001011011011 #b100111000101)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101000000011 #b000010111010)
                expect
                (fp #b1 #b1011111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b111111111111)
                expect
                (fp #b0 #b0111111011110 #b010010101100)))

(assert (= expect result))

(check-sat)
(exit)
