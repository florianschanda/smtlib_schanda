; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100100101111011 #b00010101001010)
                arg1
                (fp #b0 #b000000000000001 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b00000000000000)
                arg1
                (fp #b0 #b011100110001001 #b11000100000010)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001010100011111 #b01011101101110)
                arg2
                (fp #b0 #b010000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b010000000000000 #b00000000000000)
                arg2
                (fp #b0 #b011010100111000 #b10101111111100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011010101010110 #b00101001110011)
                expect
                (fp #b1 #b010000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b00000000000000)
                expect
                (fp #b0 #b001010011001001 #b00011010001110)))

(assert (= expect result))

(check-sat)
(exit)
