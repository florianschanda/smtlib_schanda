; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010111101 #b10110001)
                arg1
                (fp #b1 #b000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b000000001 #b00000000)
                arg1
                (fp #b0 #b111011000 #b10110000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101111 #b00100000)
                arg2
                (fp #b1 #b110000111 #b00001010)))
(assert (fp.leq (fp #b1 #b110000111 #b00001010)
                arg2
                (fp #b0 #b001101000 #b10000011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000110110 #b01011110)
                expect
                (fp #b0 #b110000111 #b00001001)))
(assert (fp.leq (fp #b0 #b110000111 #b00001001)
                expect
                (fp #b0 #b110011001 #b01101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
