; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100101100 #b01110011111)
                arg1
                (fp #b0 #b111001001001 #b10011000010)))
(assert (fp.leq (fp #b0 #b111001001001 #b10011000010)
                arg1
                (fp #b0 #b111011001111 #b10100000111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000100000010 #b10110011000)
                arg2
                (fp #b1 #b000000000000 #b01101101001)))
(assert (fp.leq (fp #b1 #b000000000000 #b01101101001)
                arg2
                (fp #b0 #b101001100110 #b10110000000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000110000010 #b00100011100)
                expect
                (fp #b0 #b111001001001 #b10011000011)))
(assert (fp.leq (fp #b0 #b111001001001 #b10011000011)
                expect
                (fp #b0 #b111001001101 #b10110000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
