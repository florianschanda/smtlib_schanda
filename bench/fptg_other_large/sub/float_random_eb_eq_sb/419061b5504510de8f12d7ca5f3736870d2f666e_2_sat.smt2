                (fp #b1 #b100000000001011 #b11001101101000)))
(assert (fp.leq (fp #b1 #b100000000001011 #b11001101101000)
                arg2
                (fp #b0 #b000010001101100 #b01110110110111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111001000101100 #b00110101110110)
                expect
                (fp #b0 #b110000001100011 #b00100100110001)))
(assert (fp.leq (fp #b0 #b110000001100011 #b00100100110001)
                expect
                (fp #b0 #b110111100111010 #b01100110100000)))

(assert (= expect result))

(check-sat)
(exit)
