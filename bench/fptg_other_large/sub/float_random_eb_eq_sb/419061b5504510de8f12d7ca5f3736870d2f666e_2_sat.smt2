(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000001110010100 #b10000010111110)
                arg1
                (fp #b0 #b110000001100011 #b00100100110000)))
(assert (fp.leq (fp #b0 #b110000001100011 #b00100100110000)
