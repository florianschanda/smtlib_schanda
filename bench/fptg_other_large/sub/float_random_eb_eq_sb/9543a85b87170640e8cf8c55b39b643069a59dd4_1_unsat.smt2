                arg2
                (fp #b0 #b01000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b0000000000000)
                arg2
                (fp #b0 #b11000100000000 #b1010010111111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001000100000 #b1101100110100)
                expect
                (fp #b1 #b01000000000000 #b0000001011010)))
(assert (fp.leq (fp #b1 #b01000000000000 #b0000001011010)
                expect
                (fp #b0 #b10110011011111 #b0101001001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
