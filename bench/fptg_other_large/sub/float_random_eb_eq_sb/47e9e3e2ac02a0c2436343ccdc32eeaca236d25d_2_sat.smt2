; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100101101011111 #b011011001101100)
                arg1
                (fp #b1 #b1010011110100000 #b001111001101100)))
(assert (fp.leq (fp #b1 #b1010011110100000 #b001111001101100)
                arg1
                (fp #b1 #b0010110000010010 #b000010110001000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010111010000110 #b100100010010101)
                arg2
                (fp #b1 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b000000000000000)
                arg2
                (fp #b0 #b0000111010010010 #b101001100110011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100101100000101 #b110101101111001)
                expect
                (fp #b1 #b1010011110100000 #b001111001101100)))
(assert (fp.leq (fp #b1 #b1010011110100000 #b001111001101100)
                expect
                (fp #b0 #b0010011100010100 #b000111101011011)))

(assert (= expect result))

(check-sat)
(exit)
