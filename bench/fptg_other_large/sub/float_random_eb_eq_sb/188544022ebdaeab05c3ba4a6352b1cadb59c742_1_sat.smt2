; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011010111001010 #b11011011100100)
                arg1
                (fp #b1 #b000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000000)
                arg1
                (fp #b0 #b011110110011001 #b00001011100101)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101011101010011 #b10101001000000)
                arg2
                (fp #b0 #b010000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b010000000000000 #b00000000000000)
                arg2
                (fp #b0 #b010010110001010 #b11011010011010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101000010011010 #b00110100000001)
                expect
                (fp #b1 #b010000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b00000000000000)
                expect
                (fp #b0 #b001001011101111 #b00011000101000)))

(assert (= expect result))

(check-sat)
(exit)
