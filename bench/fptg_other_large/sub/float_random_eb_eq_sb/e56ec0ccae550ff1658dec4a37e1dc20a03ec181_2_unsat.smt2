(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010101 #b11001001)
                arg1
                (fp #b0 #b000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b000000000 #b10100110)
                arg1
                (fp #b0 #b110010110 #b01010111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010111111 #b00001001)
                arg2
                (fp #b0 #b100000111 #b01101001)))
(assert (fp.leq (fp #b0 #b100000111 #b01101001)
                arg2
                (fp #b0 #b100101010 #b01110011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010101 #b11110101)
                expect
                (fp #b1 #b100000111 #b01101001)))
(assert (fp.leq (fp #b1 #b100000111 #b01101001)
                expect
                (fp #b1 #b000000111 #b01011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
