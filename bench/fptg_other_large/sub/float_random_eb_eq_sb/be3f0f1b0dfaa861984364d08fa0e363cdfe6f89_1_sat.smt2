                expect
                (fp #b0 #b011111111111111 #b00011101010000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b00011101010000)
                expect
                (fp #b0 #b101111000101100 #b11111001000000)))

(assert (= expect result))

(check-sat)
