; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b11010100110 #b1101001110)
                arg1
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                arg1
                (fp #b0 #b11111111111 #b0000000000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101010001 #b1111011000)
                arg2
                (fp #b1 #b01111111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011111110)
                arg2
                (fp #b1 #b01000011101 #b1100101001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00011100111 #b1111010010)
                expect
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
