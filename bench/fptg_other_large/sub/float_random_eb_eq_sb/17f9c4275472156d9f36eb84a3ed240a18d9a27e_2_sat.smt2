; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111010000 #b11111100010)
                arg1
                (fp #b0 #b100000001010 #b10001010101)))
(assert (fp.leq (fp #b0 #b100000001010 #b10001010101)
                arg1
                (fp #b0 #b111001001001 #b01000011111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101010000101 #b01110000110)
                arg2
                (fp #b1 #b100000001010 #b01000101000)))
(assert (fp.leq (fp #b1 #b100000001010 #b01000101000)
                arg2
                (fp #b1 #b010001111100 #b00001000001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000110001100 #b00111111111)
                expect
                (fp #b0 #b100000001011 #b01100111111)))
(assert (fp.leq (fp #b0 #b100000001011 #b01100111111)
                expect
                (fp #b0 #b111010101101 #b11101001001)))

(assert (= expect result))

(check-sat)
(exit)
