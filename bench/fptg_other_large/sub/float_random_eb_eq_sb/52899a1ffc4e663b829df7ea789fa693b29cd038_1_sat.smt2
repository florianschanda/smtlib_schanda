(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100000 #b101100011)
                arg1
                (fp #b1 #b0110111010 #b000100010)))
(assert (fp.leq (fp #b1 #b0110111010 #b000100010)
                arg1
                (fp #b0 #b1110111100 #b001100100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000111 #b000001011)
                arg2
                (fp #b1 #b0110100111 #b001011001)))
(assert (fp.leq (fp #b1 #b0110100111 #b001011001)
                arg2
                (fp #b1 #b0001110111 #b000110001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010111110 #b010111000)
                expect
                (fp #b1 #b0110111010 #b000100001)))
(assert (fp.leq (fp #b1 #b0110111010 #b000100001)
                expect
                (fp #b0 #b1110111011 #b011001000)))

(assert (= expect result))

(check-sat)
(exit)
