;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1100000100000101 #b011101111100110)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                arg1
                (fp #b0 #b0000010010011110 #b001001110011111)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0000110101110111 #b111001010100011)
                arg2
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                arg2
                (fp #b0 #b0111110000000010 #b000110110010000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0000100101011010 #b100000001100001)
                expect
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b0111000000110111 #b010101111101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
