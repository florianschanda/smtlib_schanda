; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001010101110 #b10100101000)
                arg1
                (fp #b0 #b011111111111 #b01110010110)))
(assert (fp.leq (fp #b0 #b011111111111 #b01110010110)
                arg1
                (fp #b0 #b111101010000 #b00101110110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101101100 #b11011111100)
                arg2
                (fp #b0 #b111110100111 #b00011101000)))
(assert (fp.leq (fp #b0 #b111110100111 #b00011101000)
                arg2
                (fp #b0 #b111110110001 #b11011111111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111000010 #b00110010000)
                expect
                (fp #b1 #b111110100111 #b00011100111)))
(assert (fp.leq (fp #b1 #b111110100111 #b00011100111)
                expect
                (fp #b0 #b101000100111 #b00100011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
