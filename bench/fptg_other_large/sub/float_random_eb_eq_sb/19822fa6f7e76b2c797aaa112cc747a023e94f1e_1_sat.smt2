(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110001010 #b011011111)
                arg1
                (fp #b0 #b0000000000 #b011110111)))
(assert (fp.leq (fp #b0 #b0000000000 #b011110111)
                arg1
                (fp #b0 #b0100101101 #b001001100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0000110001 #b010010111)
                arg2
                (fp #b0 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b000000000)
                arg2
                (fp #b0 #b1110010111 #b111101001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100111110 #b111100110)
                expect
                (fp #b1 #b0011111111 #b111111111)))
(assert (fp.leq (fp #b1 #b0011111111 #b111111111)
                expect
                (fp #b0 #b1101111010 #b111010110)))

(assert (= expect result))

(check-sat)
(exit)
