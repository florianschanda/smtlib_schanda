(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011100100 #b10010110)
                arg1
                (fp #b1 #b010101000 #b01111011)))
(assert (fp.leq (fp #b1 #b010101000 #b01111011)
                arg1
                (fp #b1 #b010100111 #b11111011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001111111 #b01100101)
                arg2
                (fp #b0 #b000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b000000000 #b11111111)
                arg2
                (fp #b0 #b001001001 #b00110010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b01001010)
                expect
                (fp #b1 #b010101000 #b01111011)))
(assert (fp.leq (fp #b1 #b010101000 #b01111011)
                expect
                (fp #b1 #b001100010 #b00111111)))

(assert (= expect result))

(check-sat)
(exit)
