(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010011100 #b010001001)
                arg1
                (fp #b0 #b0000000000 #b011110111)))
(assert (fp.leq (fp #b0 #b0000000000 #b011110111)
                arg1
                (fp #b0 #b1111110010 #b111000001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110101100 #b011101011)
                arg2
                (fp #b1 #b1000001000 #b100111000)))
(assert (fp.leq (fp #b1 #b1000001000 #b100111000)
                arg2
                (fp #b0 #b1000000001 #b110000000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011011111 #b001100000)
                expect
                (fp #b0 #b1000001000 #b100111001)))
(assert (fp.leq (fp #b0 #b1000001000 #b100111001)
                expect
                (fp #b0 #b1101000110 #b010110110)))

(assert (= expect result))

(check-sat)
(exit)
