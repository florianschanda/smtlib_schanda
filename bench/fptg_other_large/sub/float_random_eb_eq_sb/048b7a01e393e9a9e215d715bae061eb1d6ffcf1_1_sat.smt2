(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01110110100111 #b1001010100100)
                arg1
                (fp #b0 #b11111010010100 #b0000010100011)))
(assert (fp.leq (fp #b0 #b11111010010100 #b0000010100011)
                arg1
                (fp #b0 #b11111110100111 #b0001111100101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01110010001001 #b1110000011011)
                arg2
                (fp #b1 #b00000111110111 #b1110101001101)))
(assert (fp.leq (fp #b1 #b00000111110111 #b1110101001101)
                arg2
                (fp #b0 #b11100001010010 #b0101100100000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110000010000 #b0010001001101)
                expect
                (fp #b0 #b11111010010100 #b0000010100011)))
(assert (fp.leq (fp #b0 #b11111010010100 #b0000010100011)
                expect
                (fp #b0 #b11111011110010 #b1111001100011)))

(assert (= expect result))

(check-sat)
(exit)
