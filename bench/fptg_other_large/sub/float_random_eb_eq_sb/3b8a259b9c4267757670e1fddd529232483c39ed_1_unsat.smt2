;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001000110110001 #b101011000001011)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b1 #b0001011110011011 #b110111111001100)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110010110000001 #b101011101111101)
                arg2
                (fp #b1 #b0000000000000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b111111111111111)
                arg2
                (fp #b0 #b1111010001111000 #b110111000101001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100100100100011 #b001000000100001)
                expect
                (fp #b1 #b0111111111111111 #b110100000111001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111001)
                expect
                (fp #b1 #b0000110110011111 #b101011000100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
