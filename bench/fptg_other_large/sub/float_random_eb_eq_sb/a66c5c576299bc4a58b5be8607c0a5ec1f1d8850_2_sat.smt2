(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110010110 #b110011001)
                arg1
                (fp #b1 #b0000000000 #b110111001)))
(assert (fp.leq (fp #b1 #b0000000000 #b110111001)
                arg1
                (fp #b0 #b0111110101 #b101101110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001000 #b101110100)
                arg2
                (fp #b1 #b1000000111 #b001100100)))
(assert (fp.leq (fp #b1 #b1000000111 #b001100100)
                arg2
                (fp #b0 #b1000110110 #b011111110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0000001000 #b101100100)
                expect
                (fp #b0 #b1000000111 #b001100100)))
(assert (fp.leq (fp #b0 #b1000000111 #b001100100)
                expect
                (fp #b0 #b1101001000 #b100110110)))

(assert (= expect result))

(check-sat)
(exit)
