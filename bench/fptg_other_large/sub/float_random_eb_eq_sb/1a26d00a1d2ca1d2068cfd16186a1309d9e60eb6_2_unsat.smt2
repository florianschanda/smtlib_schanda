                arg2
                (fp #b0 #b11100101010010 #b0100011101011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00101110011010 #b1111111011101)
                expect
                (fp #b0 #b10000011100100 #b0100101011100)))
(assert (fp.leq (fp #b0 #b10000011100100 #b0100101011100)
                expect
