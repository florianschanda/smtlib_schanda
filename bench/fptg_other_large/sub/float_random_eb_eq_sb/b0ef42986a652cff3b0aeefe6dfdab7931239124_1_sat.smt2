(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010101010 #b00000010)
                arg1
                (fp #b0 #b011111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111 #b11001001)
                arg1
                (fp #b0 #b110001000 #b00101011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010101 #b00011001)
                arg2
                (fp #b0 #b101111110 #b11111111)))
(assert (fp.leq (fp #b0 #b101111110 #b11111111)
                arg2
                (fp #b0 #b110100110 #b10001000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101101 #b01111011)
                expect
                (fp #b1 #b101111110 #b11111110)))
(assert (fp.leq (fp #b1 #b101111110 #b11111110)
                expect
                (fp #b1 #b001101010 #b10000010)))

(assert (= expect result))

(check-sat)
(exit)
