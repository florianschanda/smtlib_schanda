(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000001111 #b111101011)
                arg1
                (fp #b1 #b1000001000 #b101100010)))
(assert (fp.leq (fp #b1 #b1000001000 #b101100010)
                arg1
                (fp #b1 #b0100001100 #b001011101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101101001 #b011111000)
                arg2
                (fp #b0 #b0111111111 #b111110111)))
(assert (fp.leq (fp #b0 #b0111111111 #b111110111)
                arg2
                (fp #b0 #b1100110010 #b000011111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000001111 #b000000010)
                expect
                (fp #b1 #b1000001000 #b101100011)))
(assert (fp.leq (fp #b1 #b1000001000 #b101100011)
                expect
                (fp #b0 #b1011110111 #b110100010)))

(assert (= expect result))

(check-sat)
(exit)
