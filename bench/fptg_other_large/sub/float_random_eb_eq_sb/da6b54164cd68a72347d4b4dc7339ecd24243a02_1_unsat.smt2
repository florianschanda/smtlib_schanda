; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100011100100100111 #b11010111011000010)
                arg1
                (fp #b1 #b000000000000000000 #b11111111111111111)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b11111111111111111)
                arg1
                (fp #b0 #b010010001101100111 #b10111110101001000)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
