(assert (fp.leq (fp #b1 #b011000011100001 #b01110100100110)
                arg2
                (fp #b1 #b010101111000000 #b00111011110100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101010101011111 #b10110011001001)
                expect
                (fp #b1 #b011111111111111 #b10001011100001)))
(assert (fp.leq (fp #b1 #b011111111111111 #b10001011100001)
                expect
                (fp #b0 #b111011111110011 #b01111000110101)))

(assert (= expect result))

(check-sat)
