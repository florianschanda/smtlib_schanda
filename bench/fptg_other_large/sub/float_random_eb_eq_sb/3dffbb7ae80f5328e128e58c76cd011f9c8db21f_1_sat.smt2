                (fp #b1 #b11001110001100 #b1000111110111)))
(assert (fp.leq (fp #b1 #b11001110001100 #b1000111110111)
                arg2
                (fp #b1 #b10001000011101 #b0101110101010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101001011001 #b1011011101110)
                expect
                (fp #b0 #b11001110001100 #b1000111110110)))
(assert (fp.leq (fp #b0 #b11001110001100 #b1000111110110)
                expect
                (fp #b0 #b11111101011000 #b1011100011000)))

(assert (= expect result))

(check-sat)
