; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111111100 #b10001100001)
                arg1
                (fp #b1 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000001)
                arg1
                (fp #b0 #b011001100000 #b10111110011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001101110001 #b00000000001)
                arg2
                (fp #b0 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b00000000000)
                arg2
                (fp #b0 #b111001110100 #b01000101110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101000110111 #b01011111111)
                expect
                (fp #b1 #b011111111111 #b00000000001)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000000001)
                expect
                (fp #b0 #b100000000110 #b11110101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
