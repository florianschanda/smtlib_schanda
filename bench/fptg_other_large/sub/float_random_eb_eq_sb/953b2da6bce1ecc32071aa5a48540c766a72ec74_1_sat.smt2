; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101000010 #b1111000111)
                arg1
                (fp #b1 #b01111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011010000)
                arg1
                (fp #b1 #b00000101111 #b0110101100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110111001 #b1001111000)
                arg2
                (fp #b1 #b00000000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000000 #b0101011111)
                arg2
                (fp #b0 #b00010010100 #b1001100110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111001110 #b0001010110)
                expect
                (fp #b1 #b01111111111 #b0011001111)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011001111)
                expect
                (fp #b1 #b01001011000 #b0000000101)))

(assert (= expect result))

(check-sat)
(exit)
