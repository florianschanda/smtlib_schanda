(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00001100111 #b0100100000)
                arg1
                (fp #b0 #b11010100000 #b0100011001)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011001)
                arg1
                (fp #b0 #b11110000101 #b1101100000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00000000000 #b0100010111)
                arg2
                (fp #b0 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000)
                arg2
                (fp #b0 #b11111111101 #b1111011110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111110 #b1110011011)
                expect
                (fp #b1 #b11111111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111)
                expect
                (fp #b0 #b00010010011 #b0000101100)))

(assert (= expect result))

(check-sat)
(exit)
