                arg2
                (fp #b0 #b10011010111010 #b0011101001100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11100110100111 #b1000100011111)
                expect
                (fp #b0 #b01111111111111 #b0100100001001)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0100100001001)
                expect
                (fp #b0 #b11000000000010 #b1001011111011)))

(assert (= expect result))

(check-sat)
