; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100100110110 #b01000100100)
                arg1
                (fp #b1 #b011111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b011111111111 #b01100111111)
                arg1
                (fp #b0 #b001000110001 #b01010000111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b111111111110 #b00000010000)
                arg2
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                arg2
                (fp #b0 #b101010011110 #b11100110011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100000110 #b01110100110)
                expect
                (fp #b1 #b011111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b011111111111 #b01100111111)
                expect
                (fp #b0 #b101010100100 #b01010011111)))

(assert (= expect result))

(check-sat)
(exit)
