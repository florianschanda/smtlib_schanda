(assert (fp.leq (fp #b0 #b100000000001100 #b01001010010010)
                arg2
                (fp #b0 #b110100110110011 #b01101001000000)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101111001111000 #b11111101000100)
                expect
                (fp #b1 #b100000000001100 #b01001010010010)))
(assert (fp.leq (fp #b1 #b100000000001100 #b01001010010010)
                expect
                (fp #b1 #b011011110001010 #b11001111011000)))

(assert (not (= expect result)))

