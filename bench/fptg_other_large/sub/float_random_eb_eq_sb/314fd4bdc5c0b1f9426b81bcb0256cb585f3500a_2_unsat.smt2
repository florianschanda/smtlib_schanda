;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110000 #b101000010)
                arg1
                (fp #b0 #b1101001001 #b011010100)))
(assert (fp.leq (fp #b0 #b1101001001 #b011010100)
                arg1
                (fp #b0 #b1111110000 #b011001111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100111100 #b101110011)
                arg2
                (fp #b0 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b000000000)
                arg2
                (fp #b0 #b1101000001 #b011000110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100001101 #b100111110)
                expect
                (fp #b0 #b1101001001 #b011010100)))
(assert (fp.leq (fp #b0 #b1101001001 #b011010100)
                expect
                (fp #b0 #b1101101011 #b001001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
