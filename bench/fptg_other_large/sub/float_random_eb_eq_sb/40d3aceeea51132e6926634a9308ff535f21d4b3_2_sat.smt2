; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100010101 #b0011110111)
                arg1
                (fp #b1 #b10000000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000100000)
                arg1
                (fp #b0 #b00001001010 #b1010110011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100110010 #b1101001011)
                arg2
                (fp #b1 #b00111111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111111011 #b0000000000)
                arg2
                (fp #b0 #b01011100010 #b1010011011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110100101 #b1010011011)
                expect
                (fp #b1 #b10000000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000100000)
                expect
                (fp #b0 #b10010001111 #b0000000001)))

(assert (= expect result))

(check-sat)
(exit)
