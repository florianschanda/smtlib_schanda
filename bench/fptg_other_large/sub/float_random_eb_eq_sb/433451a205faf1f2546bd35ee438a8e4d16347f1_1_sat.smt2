; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111110001110100110 #b00100100101111011)
                arg1
                (fp #b1 #b111100100010101110 #b10100100000110111)))
(assert (fp.leq (fp #b1 #b111100100010101110 #b10100100000110111)
                arg1
                (fp #b0 #b011110010000000000 #b01110110110101100)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001110110111101100 #b10101110011011100)
                expect
                (fp #b0 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b101111111101011010 #b10010010110101100)))

(assert (= expect result))

(check-sat)
(exit)
