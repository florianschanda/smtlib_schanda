(assert (fp.leq (fp #b0 #b110100001 #b11100010)
                arg2
                (fp #b0 #b111001101 #b11001001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101000 #b11000011)
                expect
                (fp #b1 #b110100001 #b11100011)))
(assert (fp.leq (fp #b1 #b110100001 #b11100011)
                expect
                (fp #b1 #b110000110 #b01101000)))

(assert (= expect result))

(check-sat)
(exit)
