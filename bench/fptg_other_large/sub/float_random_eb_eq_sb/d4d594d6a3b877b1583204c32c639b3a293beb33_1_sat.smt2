; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110001010000 #b1011011000010)
                arg1
                (fp #b0 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b1111111111111)
                arg1
                (fp #b0 #b11011100110001 #b0001110101111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111111110 #b0110100100011)
                arg2
                (fp #b1 #b11111111111101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000000)
                arg2
                (fp #b0 #b00000100011000 #b0100100011011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b10111100101001 #b1101011000010)
                expect
                (fp #b0 #b11111111111101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000000000000)
                expect
                (fp #b0 #b11111111111101 #b1101001001000)))

(assert (= expect result))

(check-sat)
(exit)
