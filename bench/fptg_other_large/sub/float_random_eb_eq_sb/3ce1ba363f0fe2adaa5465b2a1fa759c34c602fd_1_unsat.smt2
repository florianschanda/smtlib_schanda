(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                arg1
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                arg1
                (fp #b1 #b100110110 #b00111001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010010100 #b11011100)
                arg2
                (fp #b1 #b000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111111)
                arg2
                (fp #b0 #b011100010 #b11001000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                expect
                (fp #b1 #b111111110 #b11111110)))
(assert (fp.leq (fp #b1 #b111111110 #b11111110)
                expect
                (fp #b1 #b010110010 #b11110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
