;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000011001101001 #b100001111010010)
                arg1
                (fp #b0 #b0111111111111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b010001110000010)
                arg1
                (fp #b0 #b1010001010011111 #b001011011010010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111110111101010 #b000101000101001)
                arg2
                (fp #b1 #b1100011100100110 #b011000011011000)))
(assert (fp.leq (fp #b1 #b1100011100100110 #b011000011011000)
                arg2
                (fp #b1 #b0100011100010100 #b010101000110010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010001111111001 #b111001010111001)
                expect
                (fp #b0 #b1100011100100110 #b011000011011001)))
(assert (fp.leq (fp #b0 #b1100011100100110 #b011000011011001)
                expect
                (fp #b0 #b1111011011010100 #b100001101011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
