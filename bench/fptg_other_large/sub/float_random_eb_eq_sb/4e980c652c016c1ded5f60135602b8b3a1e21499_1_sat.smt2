(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111010111101101 #b111000000111011)
                arg1
                (fp #b0 #b1101001101010010 #b010010110011010)))
(assert (fp.leq (fp #b0 #b1101001101010010 #b010010110011010)
                arg1
                (fp #b0 #b1111011111001001 #b011111101011010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111000001111001 #b010100110110101)
                arg2
                (fp #b1 #b1101111001100001 #b011101100001111)))
(assert (fp.leq (fp #b1 #b1101111001100001 #b011101100001111)
                arg2
                (fp #b0 #b1001011011110010 #b000111000111101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b1011010000101010 #b010110100001000)
                expect
                (fp #b0 #b1101111001100001 #b011101100001111)))
(assert (fp.leq (fp #b0 #b1101111001100001 #b011101100001111)
                expect
                (fp #b0 #b1111000001011111 #b001011111000010)))

(assert (= expect result))

(check-sat)
(exit)
