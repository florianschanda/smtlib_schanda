(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011000111001111 #b100110110001010)
                arg1
                (fp #b0 #b0111111111111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b010001110000010)
                arg1
                (fp #b0 #b1000010110110111 #b001101001100110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101111011100001 #b101001111000001)
                arg2
                (fp #b1 #b1101111001100001 #b011101100001111)))
(assert (fp.leq (fp #b1 #b1101111001100001 #b011101100001111)
                arg2
                (fp #b0 #b1000001100010101 #b001110011010110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001111100010100 #b001000011101100)
                expect
                (fp #b0 #b1101111001100001 #b011101100001111)))
(assert (fp.leq (fp #b0 #b1101111001100001 #b011101100001111)
                expect
                (fp #b0 #b1111011100011000 #b010101101001100)))

(assert (= expect result))

(check-sat)
(exit)
