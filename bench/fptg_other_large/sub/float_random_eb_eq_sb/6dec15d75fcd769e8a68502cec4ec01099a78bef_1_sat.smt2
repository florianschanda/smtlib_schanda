(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110111 #b00000010)
                arg1
                (fp #b1 #b100000100 #b01111000)))
(assert (fp.leq (fp #b1 #b100000100 #b01111000)
                arg1
                (fp #b0 #b110111111 #b10011001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000111001 #b11101110)
                arg2
                (fp #b0 #b111011111 #b11011111)))
(assert (fp.leq (fp #b0 #b111011111 #b11011111)
                arg2
                (fp #b0 #b111111100 #b11101010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101010 #b00001011)
                expect
                (fp #b1 #b111011111 #b11011111)))
(assert (fp.leq (fp #b1 #b111011111 #b11011111)
                expect
                (fp #b1 #b011011101 #b10001001)))

(assert (= expect result))

(check-sat)
(exit)
