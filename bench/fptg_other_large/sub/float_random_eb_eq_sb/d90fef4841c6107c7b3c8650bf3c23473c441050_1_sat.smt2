(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01000100100 #b0101001000)
                arg1
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                arg1
                (fp #b0 #b11111001001 #b0111001011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b11010100101 #b1111100000)
                arg2
                (fp #b0 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000)
                arg2
                (fp #b0 #b11111111101 #b1000010001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111101 #b0010110110)
                expect
                (fp #b1 #b11111111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111)
                expect
                (fp #b0 #b01011011101 #b0101001001)))

(assert (= expect result))

(check-sat)
(exit)
