                (fp #b0 #b00001111100001 #b1001111010110)))
(assert (fp.leq (fp #b0 #b00001111100001 #b1001111010110)
                arg2
                (fp #b0 #b11111111100001 #b1111011001110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01100001100100 #b0011001011111)
                expect
                (fp #b0 #b11111010010100 #b0000010100010)))
(assert (fp.leq (fp #b0 #b11111010010100 #b0000010100010)
                expect
                (fp #b0 #b11111101110100 #b1011011101000)))

(assert (= expect result))

(check-sat)
(exit)
