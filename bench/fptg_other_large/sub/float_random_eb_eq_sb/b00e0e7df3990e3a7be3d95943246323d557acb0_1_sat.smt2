; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001100111110110 #b001001010101100)
                arg1
                (fp #b0 #b1000000000001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b000110010000101)
                arg1
                (fp #b0 #b1100111000001100 #b100001110100110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0101110000000010 #b001111001101111)
                arg2
                (fp #b0 #b1111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000000)
                arg2
                (fp #b0 #b1111111111111101 #b100011011010010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111101 #b010100111010010)
                expect
                (fp #b1 #b1111111111111100 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111100 #b111111111111111)
                expect
                (fp #b1 #b0011000011010010 #b000011111101000)))

(assert (= expect result))

(check-sat)
(exit)
