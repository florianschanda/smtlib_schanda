(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101001 #b00100010)
                arg1
                (fp #b0 #b011111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111 #b11001001)
                arg1
                (fp #b0 #b100010010 #b00101111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b01101001)
                arg2
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg2
                (fp #b1 #b001111111 #b00110011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011100101 #b11011111)
                expect
                (fp #b0 #b111111101 #b00000001)))
(assert (fp.leq (fp #b0 #b111111101 #b00000001)
                expect
                (fp #b0 #b111111110 #b11110000)))

(assert (= expect result))

(check-sat)
(exit)
