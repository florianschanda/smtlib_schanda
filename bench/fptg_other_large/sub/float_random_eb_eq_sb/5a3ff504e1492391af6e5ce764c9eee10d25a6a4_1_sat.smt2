;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110111001111110010 #b10110011110110101)
                arg1
                (fp #b0 #b111111111111111101 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b00000000000000000)
                arg1
