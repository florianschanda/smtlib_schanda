                arg2
                (fp #b1 #b000000000000000000 #b11000100111101100)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b11000100111101100)
                arg2
                (fp #b0 #b000100010110111100 #b10001000011011110)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b110011101000100001 #b10110000101100001)
                expect
                (fp #b0 #b111111111111111101 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b00000000000000000)
                expect
                (fp #b0 #b111111111111111101 #b11101000101111010)))

(assert (= expect result))

(check-sat)
(exit)
