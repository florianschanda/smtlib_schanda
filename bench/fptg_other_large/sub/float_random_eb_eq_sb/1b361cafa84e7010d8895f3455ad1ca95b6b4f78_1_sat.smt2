(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b000100111110110 #b00111110001100)
                arg1
                (fp #b0 #b010000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b010000000000000 #b00000000000000)
                arg1
                (fp #b0 #b100110000100001 #b11000001010011)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011011001100101 #b11101111010010)
                arg2
                (fp #b1 #b011000011100001 #b01110100100110)))
(assert (fp.leq (fp #b1 #b011000011100001 #b01110100100110)
                arg2
                (fp #b0 #b011111110010100 #b11111110001001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110101010011011 #b10101101101000)
                expect
                (fp #b0 #b011000011100001 #b01110100100110)))
(assert (fp.leq (fp #b0 #b011000011100001 #b01110100100110)
                expect
                (fp #b0 #b100010001100001 #b11111011011010)))

(assert (= expect result))

(check-sat)
(exit)
