; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011111100 #b1011001110)
                arg1
                (fp #b0 #b00000000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000)
                arg1
                (fp #b0 #b10000010001 #b1111111101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11011111010 #b0110011101)
                arg2
                (fp #b0 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000)
                arg2
                (fp #b0 #b01110100111 #b0000000011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100110101 #b0100101001)
                expect
                (fp #b0 #b00000000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000)
                expect
                (fp #b0 #b01001010101 #b1100111100)))

(assert (= expect result))

(check-sat)
(exit)
