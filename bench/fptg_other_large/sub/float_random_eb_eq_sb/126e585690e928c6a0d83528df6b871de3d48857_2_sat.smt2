(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000000000)
                arg2
                (fp #b0 #b1111111111111101 #b100111100100000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111110 #b000000011010111)
                expect
                (fp #b1 #b1111111111111101 #b000000000000001)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000000000000001)
                expect
                (fp #b0 #b1001011001111000 #b111010000110101)))

(assert (= expect result))

(check-sat)
