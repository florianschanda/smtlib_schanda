;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111110110000 #b11101110110011)
                arg1
                (fp #b1 #b100000000001100 #b11101100010010)))
(assert (fp.leq (fp #b1 #b100000000001100 #b11101100010010)
                arg1
                (fp #b1 #b010001111011010 #b01010110011011)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111101 #b11001010010110)
                arg2
                (fp #b1 #b111111111111101 #b00000000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00000000000000)
                arg2
                (fp #b0 #b110100110011011 #b01000101001010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010001000010110 #b10000100111011)
                expect
                (fp #b0 #b111111111111101 #b00000000000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00000000000000)
                expect
                (fp #b0 #b111111111111101 #b10100101010011)))

(assert (= expect result))

(check-sat)
(exit)
