; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b011100111101101 #b00110000100010)
                arg1
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                arg1
                (fp #b0 #b111100001001111 #b10111010010101)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111110011100011 #b00101110101001)
                arg2
                (fp #b1 #b111110011001010 #b11101100011010)))
(assert (fp.leq (fp #b1 #b111110011001010 #b11101100011010)
                arg2
                (fp #b0 #b101011011110000 #b00000011001010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011111010010001 #b11100000101010)
                expect
                (fp #b0 #b111110011001010 #b11101100011010)))
(assert (fp.leq (fp #b0 #b111110011001010 #b11101100011010)
                expect
                (fp #b0 #b111111111000001 #b10100110001110)))

(assert (= expect result))

(check-sat)
(exit)
