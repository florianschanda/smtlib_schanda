; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00101100101 #b1011011100)
                arg1
                (fp #b0 #b00101101011 #b1101010101)))
(assert (fp.leq (fp #b0 #b00101101011 #b1101010101)
                arg1
                (fp #b0 #b01011110101 #b0101111010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000111111 #b0011010011)
                arg2
                (fp #b1 #b10000000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000000111 #b0011100100)
                arg2
                (fp #b0 #b11111010110 #b0011001000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000110000 #b0000010010)
                expect
                (fp #b0 #b10000000111 #b0011100101)))
(assert (fp.leq (fp #b0 #b10000000111 #b0011100101)
                expect
                (fp #b0 #b11000001101 #b0000111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
