                (fp #b1 #b101001000001001110 #b00011110010011000)))
(assert (fp.leq (fp #b1 #b101001000001001110 #b00011110010011000)
                arg2
                (fp #b0 #b100001111011110110 #b10001111001000110)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b100110011100110011 #b10101101100011000)
                expect
                (fp #b0 #b101001000001001110 #b00011110010011001)))
(assert (fp.leq (fp #b0 #b101001000001001110 #b00011110010011001)
                expect
                (fp #b0 #b111001011001100100 #b00010010100010100)))

(assert (= expect result))

(check-sat)
(exit)
