(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001001111 #b1101111001)
                arg1
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                arg1
                (fp #b0 #b00100111000 #b0100000110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001011010 #b0111100000)
                arg2
                (fp #b0 #b10000001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10000001001 #b0100111000)
                arg2
                (fp #b0 #b11110011011 #b1001010101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100100100 #b0110100100)
                expect
                (fp #b1 #b10000001001 #b0100111000)))
(assert (fp.leq (fp #b1 #b10000001001 #b0100111000)
                expect
                (fp #b0 #b10010001101 #b0010100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
