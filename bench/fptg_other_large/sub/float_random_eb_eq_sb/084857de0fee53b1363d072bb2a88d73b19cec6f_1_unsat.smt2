; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011010 #b10010011)
                arg1
                (fp #b1 #b100000100 #b01111000)))
(assert (fp.leq (fp #b1 #b100000100 #b01111000)
                arg1
                (fp #b0 #b110010010 #b01010110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001111 #b11001001)
                arg2
                (fp #b1 #b101001011 #b00101100)))
(assert (fp.leq (fp #b1 #b101001011 #b00101100)
                arg2
                (fp #b1 #b001010011 #b00111000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000100 #b11110010)
                expect
                (fp #b0 #b101001011 #b00101011)))
(assert (fp.leq (fp #b0 #b101001011 #b00101011)
                expect
                (fp #b0 #b110010000 #b11010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
