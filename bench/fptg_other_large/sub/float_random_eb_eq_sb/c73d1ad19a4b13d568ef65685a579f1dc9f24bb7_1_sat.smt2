; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010001110 #b011000110)
                arg1
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b0101011000 #b000000001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110101100 #b110111111)
                arg2
                (fp #b0 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111011 #b011010100)
                arg2
                (fp #b0 #b1101100101 #b000100100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110010111 #b011110111)
                expect
                (fp #b1 #b0011111011 #b011010011)))
(assert (fp.leq (fp #b1 #b0011111011 #b011010011)
                expect
                (fp #b0 #b0000100001 #b000010010)))

(assert (= expect result))

(check-sat)
(exit)
