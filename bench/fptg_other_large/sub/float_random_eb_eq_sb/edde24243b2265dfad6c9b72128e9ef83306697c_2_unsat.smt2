(assert (fp.leq (fp #b1 #b001010110 #b00101000)
                arg2
                (fp #b0 #b011101111 #b11000110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000100111 #b01111100)
                expect
                (fp #b0 #b001010110 #b00101000)))
(assert (fp.leq (fp #b0 #b001010110 #b00101000)
                expect
                (fp #b0 #b100101110 #b11100101)))

(assert (not (= expect result)))

