(assert (fp.leq (fp #b1 #b11111111111111 #b0000000000000)
                expect
                (fp #b1 #b11111111111110 #b1111111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111111111111)
                expect
                (fp #b0 #b10110000011010 #b1010110001010)))

(assert (= expect result))

(check-sat)
