(assert (fp.leq (fp #b0 #b11111111111110 #b1111111111111)
                arg2
                (fp #b0 #b11111111111111 #b0000000000000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

