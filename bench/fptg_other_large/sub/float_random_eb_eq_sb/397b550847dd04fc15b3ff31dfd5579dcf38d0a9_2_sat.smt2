; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011100010111 #b1000011101101)
                arg1
                (fp #b0 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b10000000001101 #b0000000000000)
                arg1
                (fp #b0 #b11010010100101 #b0110001101111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110011101001 #b1001010110100)
                arg2
                (fp #b0 #b11011010010000 #b1101011001011)))
(assert (fp.leq (fp #b0 #b11011010010000 #b1101011001011)
                arg2
                (fp #b0 #b11111101010000 #b1010010101110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111000110011 #b0111110000110)
                expect
                (fp #b1 #b11011010010000 #b1101011001011)))
(assert (fp.leq (fp #b1 #b11011010010000 #b1101011001011)
                expect
                (fp #b1 #b11001000010010 #b1011111000111)))

(assert (= expect result))

(check-sat)
(exit)
