(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110111010 #b10011110100)
                arg1
                (fp #b1 #b110100100011 #b00110111000)))
(assert (fp.leq (fp #b1 #b110100100011 #b00110111000)
                arg1
                (fp #b1 #b101000001001 #b00111010010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000101100000 #b11111011010)
                expect
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b110000010101 #b11100001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
