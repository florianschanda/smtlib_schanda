; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111010 #b011100100)
                arg1
                (fp #b1 #b0000000000 #b110111001)))
(assert (fp.leq (fp #b1 #b0000000000 #b110111001)
                arg1
                (fp #b0 #b0000111011 #b010101000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110001 #b010001101)
                arg2
                (fp #b1 #b0111001011 #b101101101)))
(assert (fp.leq (fp #b1 #b0111001011 #b101101101)
                arg2
                (fp #b0 #b1101100101 #b001010011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001111000 #b101000011)
                expect
                (fp #b0 #b0111001011 #b101101100)))
(assert (fp.leq (fp #b0 #b0111001011 #b101101100)
                expect
                (fp #b0 #b1011010001 #b111100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
