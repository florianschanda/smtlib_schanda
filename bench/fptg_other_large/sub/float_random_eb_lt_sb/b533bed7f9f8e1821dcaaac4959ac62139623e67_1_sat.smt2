(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +ZERO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 29))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001 #b1000111100110111100101101101)
                arg1
                (fp #b0 #b000 #b0000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000 #b0000000000000000000000000000)
                arg1
                (fp #b0 #b011 #b1100110101011011111110110101)))

(declare-const arg2 (_ FloatingPoint 3 29))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 3 29))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 29))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
