; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 23))
(assert (fp.leq (fp #b1 #b1111011000 #b1100100101011000110111)
                arg1
                (fp #b1 #b0101011010 #b0100010101001001111100)))
(assert (fp.leq (fp #b1 #b0101011010 #b0100010101001001111100)
                arg1
                (fp #b0 #b1011100010 #b1001110011110000011111)))

(declare-const arg2 (_ FloatingPoint 10 23))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 10 23))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 23))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
