                arg2
                (fp #b0 #b11011011011 #b0011110100000)))

(declare-const result (_ FloatingPoint 11 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 14))
(assert (fp.leq (fp #b1 #b01100101001 #b1011011001101)
                expect
                (fp #b0 #b01111111111 #b0100100001010)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100100001010)
                expect
                (fp #b0 #b11111110101 #b1000000010111)))

(assert (= expect result))

(check-sat)
