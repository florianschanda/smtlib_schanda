; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 27))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 8 27))
(assert (fp.leq (fp #b1 #b11001000 #b11000000011001111100111101)
                arg2
                (fp #b0 #b10011011 #b11010111001111010110101111)))
(assert (fp.leq (fp #b0 #b10011011 #b11010111001111010110101111)
                arg2
                (fp #b0 #b11111001 #b11110100110000110100010100)))

(declare-const result (_ FloatingPoint 8 27))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 27))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
