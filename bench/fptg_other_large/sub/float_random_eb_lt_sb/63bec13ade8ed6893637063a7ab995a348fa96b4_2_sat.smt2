(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 16))
(assert (fp.leq (fp #b1 #b111111110 #b110001100101000)
                arg1
                (fp #b1 #b111111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b111111101 #b000000000000000)
                arg1
                (fp #b1 #b011001101 #b101101100001100)))

(declare-const arg2 (_ FloatingPoint 9 16))
(assert (fp.leq (fp #b1 #b100000101 #b011000011100111)
                arg2
                (fp #b1 #b011111111 #b110011000011011)))
(assert (fp.leq (fp #b1 #b011111111 #b110011000011011)
                arg2
                (fp #b1 #b000001101 #b100100011101101)))

(declare-const result (_ FloatingPoint 9 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 16))
(assert (fp.leq (fp #b1 #b111111110 #b110111101000010)
                expect
                (fp #b1 #b111111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b111111101 #b000000000000000)
                expect
                (fp #b1 #b110010111 #b110011100101110)))

(assert (= expect result))

(check-sat)
(exit)
