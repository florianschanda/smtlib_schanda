; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 29))
(assert (fp.leq (fp #b1 #b11 #b0000000000000000000000000000)
                arg1
                (fp #b1 #b10 #b1111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10 #b1111111111111111111111111111)
                arg1
                (fp #b1 #b01 #b1010011100011011011011101100)))

(declare-const arg2 (_ FloatingPoint 2 29))
(assert (fp.leq (fp #b0 #b00 #b0011001010100100000100011101)
                arg2
                (fp #b0 #b01 #b0000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01 #b0000000000000000000000000000)
                arg2
                (fp #b0 #b01 #b0111100000110011101001000000)))

(declare-const result (_ FloatingPoint 2 29))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 29))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
