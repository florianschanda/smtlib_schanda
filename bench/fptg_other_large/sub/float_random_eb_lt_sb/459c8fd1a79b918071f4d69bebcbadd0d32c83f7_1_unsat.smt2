; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 60))
(assert (fp.leq (fp #b1 #b001 #b10010011010011010110001110101111110101011011000000101100101)
                arg1
                (fp #b1 #b000 #b11111111111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b000 #b11111111111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b001 #b10101001010011110011100000011100010111010101111100000000110)))

(declare-const arg2 (_ FloatingPoint 3 60))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 3 60))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 60))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
