                arg2
                (fp #b1 #b101111110 #b11111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b101111110 #b11111111111111111111111111111)
                arg2
                (fp #b1 #b101000001 #b01011110000001010100001111111)))

(declare-const result (_ FloatingPoint 9 30))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 30))
(assert (fp.leq (fp #b1 #b000111101 #b00001101010011101101111011011)
                expect
                (fp #b0 #b101111110 #b11111111111111111111111111110)))
(assert (fp.leq (fp #b0 #b101111110 #b11111111111111111111111111110)
                expect
                (fp #b0 #b110011010 #b00000110100101111011010010010)))

(assert (= expect result))

(check-sat)
(exit)
