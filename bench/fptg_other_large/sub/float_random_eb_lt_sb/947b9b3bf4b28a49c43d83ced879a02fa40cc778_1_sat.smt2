                (fp #b0 #b0101111010 #b101001100101010110101110001011110100011000110111110000001111010011101110000110001101001110111011101)))

(declare-const result (_ FloatingPoint 10 100))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 100))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
