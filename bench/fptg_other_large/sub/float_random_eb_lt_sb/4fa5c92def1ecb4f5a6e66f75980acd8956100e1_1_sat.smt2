(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 32))
(assert (fp.leq (fp #b0 #b11100111 #b1100010010110110110001000000111)
                arg1
                (fp #b0 #b11111101 #b0000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111101 #b0000000000000000000000000000000)
                arg1
                (fp #b0 #b11111110 #b0000101000100100001110111101000)))

(declare-const arg2 (_ FloatingPoint 8 32))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 8 32))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 32))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
