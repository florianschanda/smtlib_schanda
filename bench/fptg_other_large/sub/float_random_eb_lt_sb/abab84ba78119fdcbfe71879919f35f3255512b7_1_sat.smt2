; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 41))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 41))
(assert (fp.leq (fp #b1 #b1111101010 #b0011001111010111100111001100111001011011)
                arg2
                (fp #b1 #b0111111111 #b1010010101101001000110101111000010011001)))
(assert (fp.leq (fp #b1 #b0111111111 #b1010010101101001000110101111000010011001)
                arg2
                (fp #b1 #b0100111110 #b1000110001100011101011010100010110101011)))

(declare-const result (_ FloatingPoint 10 41))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 41))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
