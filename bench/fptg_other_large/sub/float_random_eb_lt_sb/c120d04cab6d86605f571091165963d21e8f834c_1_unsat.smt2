(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +ZERO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 28))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0010 #b011101100111001100000111010)
                arg1
                (fp #b0 #b0000 #b000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b0000 #b000000000000000000000000000)
                arg1
                (fp #b0 #b1100 #b110000110001111100000111010)))

(declare-const arg2 (_ FloatingPoint 4 28))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 4 28))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 28))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
