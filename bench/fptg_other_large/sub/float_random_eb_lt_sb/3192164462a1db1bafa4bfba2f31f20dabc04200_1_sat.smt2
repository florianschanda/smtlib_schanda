                arg2
                (fp #b0 #b110 #b11100000101100101011100110011001101011)))
(assert (fp.leq (fp #b0 #b110 #b11100000101100101011100110011001101011)
                arg2
                (fp #b0 #b110 #b11110011001010110111100111000001110011)))

(declare-const result (_ FloatingPoint 3 39))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 39))
(assert (fp.leq (fp #b1 #b111 #b00000000000000000000000000000000000000)
                expect
                (fp #b1 #b110 #b11111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b110 #b11111111111111111111111111111111111111)
                expect
                (fp #b0 #b101 #b10010110101101010100010011001101111011)))

(assert (= expect result))

(check-sat)
(exit)
