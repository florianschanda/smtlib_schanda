;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 39))
(assert (fp.leq (fp #b1 #b101 #b01111010101010101100110111000010001110)
                arg1
                (fp #b1 #b101 #b01000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b101 #b01000000000000000000000000000000000000)
                arg1
                (fp #b1 #b100 #b00001101010100011111001110011011011110)))

(declare-const arg2 (_ FloatingPoint 3 39))
