; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 25))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 3 25))
(assert (fp.leq (fp #b1 #b110 #b100100101001110110100101)
                arg2
                (fp #b1 #b110 #b100000000000000000000000)))
(assert (fp.leq (fp #b1 #b110 #b100000000000000000000000)
                arg2
                (fp #b1 #b011 #b111011110111110011110000)))

(declare-const result (_ FloatingPoint 3 25))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 25))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
