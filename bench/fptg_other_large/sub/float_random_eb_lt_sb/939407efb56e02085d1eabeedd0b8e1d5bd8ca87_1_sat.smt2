(assert (fp.leq (fp #b0 #b101101011010000 #b01011010101101011110101)
                arg2
                (fp #b0 #b110100011110001 #b00111000100101111000000)))

(declare-const result (_ FloatingPoint 15 24))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 24))
(assert (fp.leq (fp #b1 #b101111111000111 #b01100101011110111011001)
                expect
                (fp #b1 #b101101011010000 #b01011010101101011110100)))
(assert (fp.leq (fp #b1 #b101101011010000 #b01011010101101011110100)
                expect
                (fp #b0 #b000100110001011 #b11000101011101011110111)))

(assert (= expect result))

(check-sat)
(exit)
