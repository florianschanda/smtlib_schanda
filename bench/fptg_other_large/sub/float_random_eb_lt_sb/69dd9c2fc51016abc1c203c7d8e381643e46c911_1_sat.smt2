; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 41))
(assert (fp.leq (fp #b1 #b1000001011010101 #b0010010100011000000110010100101010100101)
                arg1
                (fp #b0 #b0000000000000000 #b0100000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100000000000000000000000000000000000000)
                arg1
                (fp #b0 #b1100100100110011 #b1111101101101011001000000100001011010101)))

(declare-const arg2 (_ FloatingPoint 16 41))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 41))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 41))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
