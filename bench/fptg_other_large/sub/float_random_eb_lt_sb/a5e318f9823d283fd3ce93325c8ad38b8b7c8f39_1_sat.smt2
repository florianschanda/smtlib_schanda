(assert (fp.leq (fp #b1 #b1011010101010 #b1001000110000)
                arg2
                (fp #b0 #b0111111111111 #b0110010010011)))

(declare-const result (_ FloatingPoint 13 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 14))
(assert (fp.leq (fp #b1 #b0010100011101 #b1000011110101)
                expect
                (fp #b0 #b1011010101010 #b1001000110000)))
(assert (fp.leq (fp #b0 #b1011010101010 #b1001000110000)
                expect
                (fp #b0 #b1100000101100 #b1111001101101)))

(assert (= expect result))

(check-sat)
(exit)
