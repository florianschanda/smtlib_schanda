;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 14))
(assert (fp.leq (fp #b1 #b1000000001100 #b1110011011110)
