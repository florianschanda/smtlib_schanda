; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +NAN
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 26))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 26))
(assert (fp.leq (fp #b1 #b1110000000100000 #b0100000011000110100000010)
                arg2
                (fp #b1 #b1000000000011001 #b0000000000000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000011001 #b0000000000000000000000000)
                arg2
                (fp #b1 #b0101100110101000 #b1100011010000010101100111)))

(declare-const result (_ FloatingPoint 16 26))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 26))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
