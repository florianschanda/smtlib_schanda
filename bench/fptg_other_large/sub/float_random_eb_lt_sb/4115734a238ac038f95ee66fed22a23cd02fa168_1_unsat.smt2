(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 16))
(assert (fp.leq (fp #b1 #b10101101011 #b000100011110111)
                arg1
                (fp #b1 #b10000001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b001010101000000)
                arg1
                (fp #b0 #b01110110110 #b110111010100110)))

(declare-const arg2 (_ FloatingPoint 11 16))
(assert (fp.leq (fp #b1 #b10001000000 #b000100001010000)
                arg2
                (fp #b1 #b01011000100 #b101110110110000)))
(assert (fp.leq (fp #b1 #b01011000100 #b101110110110000)
                arg2
                (fp #b0 #b01110000000 #b010010100010000)))

(declare-const result (_ FloatingPoint 11 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 16))
(assert (fp.leq (fp #b1 #b10101010001 #b010110111010010)
                expect
                (fp #b1 #b10000001010 #b001010100111111)))
(assert (fp.leq (fp #b1 #b10000001010 #b001010100111111)
                expect
                (fp #b1 #b01011001110 #b110100100111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
