; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 6 32))
(assert (fp.leq (fp #b1 #b101011 #b0100110010100101111000111011111)
                arg1
                (fp #b0 #b001001 #b1010000100011000010010101100010)))
(assert (fp.leq (fp #b0 #b001001 #b1010000100011000010010101100010)
                arg1
                (fp #b0 #b011001 #b1001111100111100101100111110111)))

(declare-const arg2 (_ FloatingPoint 6 32))
(assert (fp.leq (fp #b1 #b101011 #b1110110011101100101010010100011)
                arg2
                (fp #b0 #b011001 #b0101111101110101101110100011001)))
(assert (fp.leq (fp #b0 #b011001 #b0101111101110101101110100011001)
                arg2
                (fp #b0 #b111101 #b0011101011110110001011000011110)))

(declare-const result (_ FloatingPoint 6 32))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 32))
(assert (fp.leq (fp #b1 #b011100 #b0001101001110010101100001000101)
                expect
                (fp #b1 #b011001 #b0101111101110100000110010001100)))
(assert (fp.leq (fp #b1 #b011001 #b0101111101110100000110010001100)
                expect
                (fp #b0 #b000001 #b1000010000101010100010101110101)))

(assert (= expect result))

(check-sat)
(exit)
