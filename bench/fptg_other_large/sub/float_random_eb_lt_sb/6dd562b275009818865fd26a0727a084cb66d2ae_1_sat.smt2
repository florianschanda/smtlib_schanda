                arg2
                (fp #b1 #b001111111001 #b0110101000001)))
(assert (fp.leq (fp #b1 #b001111111001 #b0110101000001)
                arg2
                (fp #b0 #b001111001001 #b0011101111100)))

(declare-const result (_ FloatingPoint 12 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 14))
(assert (fp.leq (fp #b1 #b010110000110 #b0001001100111)
                expect
                (fp #b0 #b101111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b1111111111111)
                expect
                (fp #b0 #b111010100010 #b1100010101101)))

(assert (= expect result))

(check-sat)
(exit)
