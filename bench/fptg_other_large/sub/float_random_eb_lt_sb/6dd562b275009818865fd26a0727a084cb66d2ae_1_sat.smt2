;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 14))
(assert (fp.leq (fp #b0 #b001100110110 #b0100101010100)
                arg1
                (fp #b0 #b101111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b1111111111111)
