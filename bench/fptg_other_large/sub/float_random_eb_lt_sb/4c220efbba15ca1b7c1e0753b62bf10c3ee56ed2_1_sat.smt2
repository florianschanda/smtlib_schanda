;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 5 38))
(assert (fp.leq (fp #b1 #b11101 #b0111001101101010110000010101101110110)
                arg1
                (fp #b1 #b11101 #b0110100110100100000000000000000000000)))
(assert (fp.leq (fp #b1 #b11101 #b0110100110100100000000000000000000000)
                arg1
                (fp #b0 #b00000 #b1100111100000100111010111101001100010)))

(declare-const arg2 (_ FloatingPoint 5 38))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 5 38))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 38))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11001 #b1101001101110111111000010100000111000)
                expect
                (fp #b0 #b00000 #b0000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000 #b0000000000000000000000000000000000000)
                expect
                (fp #b0 #b11010 #b1001001000101111001011110100100011000)))

(assert (= expect result))

(check-sat)
(exit)
