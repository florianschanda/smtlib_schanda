(assert (fp.leq (fp #b1 #b100010011 #b010010100111011110100)
                expect
                (fp #b0 #b000000000 #b000000000000000000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000000000000000000)
                expect
                (fp #b0 #b101111100 #b111100000000001101101)))

(assert (= expect result))

(check-sat)
(exit)
