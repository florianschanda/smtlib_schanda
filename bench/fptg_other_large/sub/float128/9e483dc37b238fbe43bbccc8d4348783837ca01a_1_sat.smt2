; Format: FLOAT128
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b0 #b011001001011000 #b1100111100010010000001000101111110010011010011011001011000101001111110000001101100000001010011100100100111101010)
                arg2
                (fp #b0 #b011111111111111 #b0001001101110101101010100011111011101011011111010001001011111110010101001111011111010000011011001100000010100011)))
(assert (fp.leq (fp #b0 #b011111111111111 #b0001001101110101101010100011111011101011011111010001001011111110010101001111011111010000011011001100000010100011)
                arg2
                (fp #b0 #b111101110001101 #b0100101010100010011100110111100000100110111111100100101111001110000011001010001011010101010100100111101000110011)))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
