(assert (fp.leq (fp #b1 #b100100001001101 #b1110000111111101101110010010100010011011001101111001000111011110011000101110101110110111110101000100011100000100)
                arg1
                (fp #b0 #b110100000011000 #b0100100100100010100011011011001101110101101100010100001010110100000011011100111001100001110100000110010100101111)))
(assert (fp.leq (fp #b0 #b110100000011000 #b0100100100100010100011011011001101110101101100010100001010110100000011011100111001100001110100000110010100101111)
                arg1
                (fp #b0 #b111100101110100 #b0011001011111001000000101010000100111100001100011101110110011110000101110000110100101100111100101111111101110000)))

(declare-const arg2 Float128)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
