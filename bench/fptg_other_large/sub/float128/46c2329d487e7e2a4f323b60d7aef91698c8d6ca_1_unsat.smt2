(assert (fp.leq (fp #b1 #b000000110110001 #b1100000001011110101000100011111000101000010001000000001001100011100100100000011110111110000001110000110011111111)
                arg1
                (fp #b0 #b100000001101111 #b0000010000110011001001010110111010000101010110001111111001110100001001110000011001001101110111100100110011001100)))
(assert (fp.leq (fp #b0 #b100000001101111 #b0000010000110011001001010110111010000101010110001111111001110100001001110000011001001101110111100100110011001100)
                arg1
                (fp #b0 #b101101101100011 #b1111100111001111111111110010001101000111010010101111011010000101100000110010101001000111001100110110100011100110)))

(declare-const arg2 Float128)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

