                arg1
                (fp #b0 #b000011100110011 #b1011001011011010111100011001011010110001010000010111110111001100010101101011101000111101110010110010110110010001)))

(declare-const arg2 Float128)
(assert (fp.isNaN arg2))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
