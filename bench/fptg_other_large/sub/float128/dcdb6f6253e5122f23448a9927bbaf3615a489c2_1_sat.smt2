(assert (fp.leq (fp #b1 #b100000001100110 #b1100100111100000111101110101000101101110101100100000110011101110101101110100101000010111001100010011101000000000)
                arg1
                (fp #b0 #b111000011110111 #b0111100000111110110010000111101000110100100101111100111101010010111110101111100001100000100111000110101101101010)))

(declare-const arg2 Float128)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

