(assert (fp.leq (fp #b1 #b000000000000000 #b0110110101001110100110111011100110000010010000110100111011101000100010000001010001010110111110110110010000011111)
                arg2
                (fp #b0 #b110110110101111 #b1000100101110001000101101101011110011110000100100011011000000111110000000100101101101111000110001110010100111110)))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

