                (fp #b0 #b110101010011010 #b0000011100101000010011010111000111000001101100011011010100000100011000010010010001010000011101100000100110111100)))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
