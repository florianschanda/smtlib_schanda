(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b010010001011101 #b1100101111100000100100100010010000111010001000000000010101011010000111111000001000101111111101101100001110111101)
                arg2
                (fp #b0 #b000000000000000 #b1010101000100010100101010110010001000110100110010101010011011011000010011001110011000110111100101001100000010110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1010101000100010100101010110010001000110100110010101010011011011000010011001110011000110111100101001100000010110)
                arg2
                (fp #b0 #b011111000111001 #b0011111001110111010010100110110000010001000100000001110011000101010001111101000111011101011001011100010000111010)))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
