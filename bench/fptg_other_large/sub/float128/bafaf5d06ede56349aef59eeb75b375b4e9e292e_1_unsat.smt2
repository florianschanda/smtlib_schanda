                (fp #b0 #b010101101111010 #b0110101111100101001000011101001100101010100100101011101001011011001101111001101100001000001100000110010101001100)))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

