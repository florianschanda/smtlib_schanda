(assert (fp.leq (fp #b0 #b110000011101100 #b0010101110011001011100101001101000010010001110110101111111010000110100011011110100001111000100100001001110101110)
                arg2
                (fp #b0 #b111100101111101 #b0110001011001100000101000110111010100000110111010000100010011001011011110100001010010010010101110011111110010000)))

(declare-const result Float128)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
