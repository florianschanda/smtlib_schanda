(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b001000000100100 #b1101100)
                arg1
                (fp #b0 #b000001010100010 #b0010011)))
(assert (fp.leq (fp #b0 #b000001010100010 #b0010011)
                arg1
                (fp #b0 #b010001000111100 #b1010011)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b0 #b011100001111100 #b0101001)
                arg2
                (fp #b0 #b110111001100100 #b0011001)))
(assert (fp.leq (fp #b0 #b110111001100100 #b0011001)
                arg2
                (fp #b0 #b111001110111100 #b0101011)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111000101000100 #b1100110)
                expect
                (fp #b1 #b110111001100100 #b0011000)))
(assert (fp.leq (fp #b1 #b110111001100100 #b0011000)
                expect
                (fp #b1 #b100101100011110 #b0000011)))

(assert (= expect result))

(check-sat)
(exit)
