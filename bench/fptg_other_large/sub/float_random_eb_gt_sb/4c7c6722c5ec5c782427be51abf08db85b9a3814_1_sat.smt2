(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b11101010000000110 #b0010100)
                arg1
                (fp #b1 #b11001111011100111 #b0010000)))
(assert (fp.leq (fp #b1 #b11001111011100111 #b0010000)
                arg1
                (fp #b0 #b11011101000001111 #b0001010)))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b11111111111111110 #b1000101)
                arg2
                (fp #b1 #b11111111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b0000000)
                arg2
                (fp #b1 #b01101100100011100 #b1111111)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b0 #b00111011001001000 #b0001110)
                expect
                (fp #b0 #b11111111111111100 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111111100 #b1111111)
                expect
                (fp #b0 #b11111111111111101 #b0100011)))

(assert (= expect result))

(check-sat)
(exit)
