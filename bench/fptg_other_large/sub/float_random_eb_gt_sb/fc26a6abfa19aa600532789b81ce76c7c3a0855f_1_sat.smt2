(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100000001101 #b001000)
                arg1
                (fp #b1 #b010000000000 #b000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b000000)
                arg1
                (fp #b0 #b100001001010 #b111111)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101101010010 #b011110)
                arg2
                (fp #b1 #b011111111111 #b001000)))
(assert (fp.leq (fp #b1 #b011111111111 #b001000)
                arg2
                (fp #b0 #b100000110101 #b110010)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b000010110010 #b100111)
                expect
                (fp #b0 #b011111111111 #b000111)))
(assert (fp.leq (fp #b0 #b011111111111 #b000111)
                expect
                (fp #b0 #b110001111111 #b110110)))

(assert (= expect result))

(check-sat)
(exit)
