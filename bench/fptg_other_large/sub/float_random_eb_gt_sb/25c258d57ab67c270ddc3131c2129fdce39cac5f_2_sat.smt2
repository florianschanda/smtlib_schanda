(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010011101 #b0011110)
                arg1
                (fp #b0 #b101111110 #b1111111)))
(assert (fp.leq (fp #b0 #b101111110 #b1111111)
                arg1
                (fp #b0 #b110011111 #b0111010)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110111011 #b0110111)
                arg2
                (fp #b1 #b100000110 #b1010010)))
(assert (fp.leq (fp #b1 #b100000110 #b1010010)
                arg2
                (fp #b0 #b010011101 #b1111110)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101011010 #b1011101)
                expect
                (fp #b0 #b101111111 #b0000000)))
(assert (fp.leq (fp #b0 #b101111111 #b0000000)
                expect
                (fp #b0 #b110100111 #b0010111)))

(assert (= expect result))

(check-sat)
(exit)
