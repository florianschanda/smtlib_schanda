(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b011011111 #b000111)
                arg1
                (fp #b1 #b000000000 #b000000)))
(assert (fp.leq (fp #b1 #b000000000 #b000000)
                arg1
                (fp #b0 #b100001001 #b111010)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101111100 #b000010)
                arg2
                (fp #b0 #b011111111 #b000110)))
(assert (fp.leq (fp #b0 #b011111111 #b000110)
                arg2
                (fp #b0 #b100011100 #b010010)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101110111 #b010100)
                expect
                (fp #b1 #b011111111 #b000110)))
(assert (fp.leq (fp #b1 #b011111111 #b000110)
                expect
                (fp #b0 #b010001010 #b101001)))

(assert (= expect result))

(check-sat)
(exit)
