(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100010001011 #b10)
                arg1
                (fp #b1 #b001111111111 #b00)))
(assert (fp.leq (fp #b1 #b001111111111 #b00)
                arg1
                (fp #b0 #b111111010000 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100110001000 #b10)
                arg2
                (fp #b1 #b100000000010 #b00)))
(assert (fp.leq (fp #b1 #b100000000010 #b00)
                arg2
                (fp #b0 #b101010001010 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b011111100100 #b10)
                expect
                (fp #b0 #b100000000010 #b00)))
(assert (fp.leq (fp #b0 #b100000000010 #b00)
                expect
                (fp #b0 #b111001101011 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
