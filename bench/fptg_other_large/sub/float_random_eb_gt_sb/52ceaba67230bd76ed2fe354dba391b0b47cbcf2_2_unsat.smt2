(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00111010000000 #b011110110)
                arg1
                (fp #b0 #b01000111110010 #b001001000)))
(assert (fp.leq (fp #b0 #b01000111110010 #b001001000)
                arg1
                (fp #b0 #b11011101000101 #b101010101)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10101001010001 #b000100100)
                arg2
                (fp #b1 #b01111111111111 #b010001010)))
(assert (fp.leq (fp #b1 #b01111111111111 #b010001010)
                arg2
                (fp #b1 #b00001110100101 #b011010001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b0 #b01111010011111 #b110111110)
                expect
                (fp #b0 #b01111111111111 #b010001011)))
(assert (fp.leq (fp #b0 #b01111111111111 #b010001011)
                expect
                (fp #b0 #b11101001101110 #b111110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
