(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10101010100110101 #b011)
                arg1
                (fp #b1 #b00000000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b001)
                arg1
                (fp #b0 #b01110001001011101 #b010)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01100000100000010 #b001)
                arg2
                (fp #b0 #b01111111111111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b000)
                arg2
                (fp #b0 #b11111110101111000 #b110)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11101011111000001 #b010)
                expect
                (fp #b1 #b01111111111111111 #b000)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b000)
                expect
                (fp #b0 #b00110111100111100 #b000)))

(assert (= expect result))

(check-sat)
(exit)
