(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0101101111100 #b000)
                arg1
                (fp #b0 #b0011111111110 #b011)))
(assert (fp.leq (fp #b0 #b0011111111110 #b011)
                arg1
                (fp #b0 #b1101100000001 #b001)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1101111111110 #b101)
                arg2
                (fp #b0 #b1011110110111 #b000)))
(assert (fp.leq (fp #b0 #b1011110110111 #b000)
                arg2
                (fp #b0 #b1111111110010 #b101)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1100110101011 #b001)
                expect
                (fp #b1 #b1011110110111 #b000)))
(assert (fp.leq (fp #b1 #b1011110110111 #b000)
                expect
                (fp #b1 #b0101101000110 #b101)))

(assert (= expect result))

(check-sat)
(exit)
