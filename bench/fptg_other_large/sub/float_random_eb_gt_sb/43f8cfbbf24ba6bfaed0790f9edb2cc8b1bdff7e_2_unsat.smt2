(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111110011010 #b101)
                arg1
                (fp #b1 #b100000000010 #b110)))
(assert (fp.leq (fp #b1 #b100000000010 #b110)
                arg1
                (fp #b1 #b011010000011 #b100)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100010000111 #b001)
                arg2
                (fp #b1 #b000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000 #b010)
                arg2
                (fp #b0 #b011100100100 #b000)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111111110101 #b000)
                expect
                (fp #b1 #b100000000010 #b110)))
(assert (fp.leq (fp #b1 #b100000000010 #b110)
                expect
                (fp #b1 #b001001010110 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
