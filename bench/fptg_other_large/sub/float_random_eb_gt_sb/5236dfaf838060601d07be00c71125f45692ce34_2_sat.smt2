(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101000011 #b110)
                arg1
                (fp #b1 #b000000000 #b110)))
(assert (fp.leq (fp #b1 #b000000000 #b110)
                arg1
                (fp #b0 #b110100110 #b111)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111110001 #b110)
                arg2
                (fp #b1 #b100011001 #b101)))
(assert (fp.leq (fp #b1 #b100011001 #b101)
                arg2
                (fp #b0 #b110100101 #b111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b001010111 #b001)
                expect
                (fp #b0 #b100011001 #b101)))
(assert (fp.leq (fp #b0 #b100011001 #b101)
                expect
                (fp #b0 #b111001011 #b001)))

(assert (= expect result))

(check-sat)
(exit)
