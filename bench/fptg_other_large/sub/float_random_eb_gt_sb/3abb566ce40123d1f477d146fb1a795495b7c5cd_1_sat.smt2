(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0101010111 #b010001)
                arg1
                (fp #b0 #b0000000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000001)
                arg1
                (fp #b0 #b0010000011 #b111100)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0110101111 #b011101)
                arg2
                (fp #b0 #b1100000110 #b011010)))
(assert (fp.leq (fp #b0 #b1100000110 #b011010)
                arg2
                (fp #b0 #b1100100111 #b011101)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1100010101 #b110010)
                expect
                (fp #b1 #b1100000110 #b011001)))
(assert (fp.leq (fp #b1 #b1100000110 #b011001)
                expect
                (fp #b1 #b0000000110 #b000101)))

(assert (= expect result))

(check-sat)
(exit)
