; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1000010100100111 #b011011101)
                arg1
                (fp #b0 #b1000000000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000000001001 #b000000000)
                arg1
                (fp #b0 #b1000000000100111 #b110000111)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b0111110000101110 #b000000001)
                arg2
                (fp #b0 #b1000100101011110 #b111111001)))
(assert (fp.leq (fp #b0 #b1000100101011110 #b111111001)
                arg2
                (fp #b0 #b1100011011111001 #b011101101)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1010011011001000 #b100101000)
                expect
                (fp #b1 #b1000100101011110 #b111111000)))
(assert (fp.leq (fp #b1 #b1000100101011110 #b111111000)
                expect
                (fp #b0 #b0001000000101100 #b101101000)))

(assert (= expect result))

(check-sat)
(exit)
