(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b011110001100 #b1000)
                arg1
                (fp #b0 #b101000000000 #b1010)))
(assert (fp.leq (fp #b0 #b101000000000 #b1010)
                arg1
                (fp #b0 #b110101000010 #b0000)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111011011101 #b1100)
                arg2
                (fp #b1 #b100000000011 #b1110)))
(assert (fp.leq (fp #b1 #b100000000011 #b1110)
                arg2
                (fp #b1 #b000001001100 #b1100)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b010011110100 #b1011)
                expect
                (fp #b0 #b101000000000 #b1010)))
(assert (fp.leq (fp #b0 #b101000000000 #b1010)
                expect
                (fp #b0 #b101100101001 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
