;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1111111001001 #b100000011)
                arg1
                (fp #b1 #b1101111000101 #b110101000)))
(assert (fp.leq (fp #b1 #b1101111000101 #b110101000)
                arg1
                (fp #b0 #b1110110101111 #b001111101)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b0 #b1001100010011 #b010001011)
                arg2
                (fp #b0 #b1111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111111111)
                arg2
                (fp #b0 #b1111111111111 #b000000000)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
