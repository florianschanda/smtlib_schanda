(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11111111010 #b00010000)
                arg1
                (fp #b1 #b10111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b11111111)
                arg1
                (fp #b1 #b01011101101 #b01000001)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b00001000110 #b00100000)
                arg2
                (fp #b0 #b01101000111 #b11100100)))
(assert (fp.leq (fp #b0 #b01101000111 #b11100100)
                arg2
                (fp #b0 #b10101011111 #b10100101)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11100011100 #b10111001)
                expect
                (fp #b1 #b10111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b11111111)
                expect
                (fp #b1 #b01100000100 #b11001101)))

(assert (= expect result))

(check-sat)
(exit)
