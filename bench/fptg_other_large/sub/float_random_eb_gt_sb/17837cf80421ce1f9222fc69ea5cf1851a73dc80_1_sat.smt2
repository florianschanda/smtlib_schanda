; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1101110001111 #b110001)
                arg1
                (fp #b1 #b0000000000000 #b000001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000001)
                arg1
                (fp #b0 #b1001110111100 #b000000)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111111111110 #b010101)
                arg2
                (fp #b1 #b1111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b000000)
                arg2
                (fp #b1 #b1010010101110 #b100100)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0110010110000 #b000111)
                expect
                (fp #b0 #b1111111111100 #b111111)))
(assert (fp.leq (fp #b0 #b1111111111100 #b111111)
                expect
                (fp #b0 #b1111111111101 #b111101)))

(assert (= expect result))

(check-sat)
(exit)
