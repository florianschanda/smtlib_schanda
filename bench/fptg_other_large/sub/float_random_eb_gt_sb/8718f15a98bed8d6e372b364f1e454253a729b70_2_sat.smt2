                arg2
                (fp #b1 #b100000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b100000000001101 #b0000000000000)
                arg2
                (fp #b0 #b010101000110101 #b1001001111101)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b100101110010011 #b0100111101001)
                expect
                (fp #b0 #b111111000010110 #b0000010011011)))
(assert (fp.leq (fp #b0 #b111111000010110 #b0000010011011)
                expect
                (fp #b0 #b111111101011100 #b0111010000010)))

(assert (= expect result))

(check-sat)
(exit)
