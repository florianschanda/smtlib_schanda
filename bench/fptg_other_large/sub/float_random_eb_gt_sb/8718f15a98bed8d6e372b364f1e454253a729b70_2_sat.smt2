;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b111110001101001 #b1000100101011)
                arg1
                (fp #b0 #b111111000010110 #b0000010011010)))
(assert (fp.leq (fp #b0 #b111111000010110 #b0000010011010)
                arg1
                (fp #b0 #b111111010110101 #b1001111111010)))

(declare-const arg2 (_ FloatingPoint 15 14))
