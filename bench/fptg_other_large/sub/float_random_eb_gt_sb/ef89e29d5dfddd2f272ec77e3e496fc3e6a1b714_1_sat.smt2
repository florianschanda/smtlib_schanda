(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b0111001011100100 #b111100000011)
                arg1
                (fp #b1 #b0000000000000000 #b010000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010000000000)
                arg1
                (fp #b0 #b1110111110100010 #b001101011110)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1101100110111001 #b010111111000)
                arg2
                (fp #b1 #b1010000010100100 #b001111010011)))
(assert (fp.leq (fp #b1 #b1010000010100100 #b001111010011)
                arg2
                (fp #b1 #b0010110011010101 #b101110111000)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b0 #b0101010010110011 #b101101001101)
                expect
                (fp #b0 #b1010000010100100 #b001111010010)))
(assert (fp.leq (fp #b0 #b1010000010100100 #b001111010010)
                expect
                (fp #b0 #b1100100111011000 #b101000110101)))

(assert (= expect result))

(check-sat)
(exit)
