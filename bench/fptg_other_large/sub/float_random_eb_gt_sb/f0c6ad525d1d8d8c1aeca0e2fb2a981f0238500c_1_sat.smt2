; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0001001011101111 #b0110010101)
                arg1
                (fp #b1 #b0000010100111100 #b1001000010)))
(assert (fp.leq (fp #b1 #b0000010100111100 #b1001000010)
                arg1
                (fp #b0 #b0111111100111011 #b1010111111)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0100111011000010 #b1011100101)
                arg2
                (fp #b0 #b1011010000000011 #b1011100010)))
(assert (fp.leq (fp #b0 #b1011010000000011 #b1011100010)
                arg2
                (fp #b0 #b1111010111001011 #b0101000110)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1111101001011001 #b0110010110)
                expect
                (fp #b1 #b1011010000000011 #b1011100010)))
(assert (fp.leq (fp #b1 #b1011010000000011 #b1011100010)
                expect
                (fp #b0 #b1100100100011010 #b1100011100)))

(assert (= expect result))

(check-sat)
(exit)
