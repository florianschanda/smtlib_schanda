(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0000101011000 #b101111000)
                arg1
                (fp #b0 #b0000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000)
                arg1
                (fp #b0 #b0010010101100 #b111110111)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101011110101 #b001000010)
                arg2
                (fp #b1 #b0100000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b000000000)
                arg2
                (fp #b0 #b0000010001010 #b000101001)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101110010010 #b101101011)
                expect
                (fp #b0 #b0100000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000000000 #b000000000)
                expect
                (fp #b0 #b0100110100010 #b111010011)))

(assert (= expect result))

(check-sat)
(exit)
