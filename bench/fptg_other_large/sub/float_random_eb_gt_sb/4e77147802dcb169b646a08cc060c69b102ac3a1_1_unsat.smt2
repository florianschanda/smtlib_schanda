;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111001001 #b001000000)
                arg1
                (fp #b1 #b10111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b111111111)
                arg1
                (fp #b1 #b00111000010 #b111001011)))

