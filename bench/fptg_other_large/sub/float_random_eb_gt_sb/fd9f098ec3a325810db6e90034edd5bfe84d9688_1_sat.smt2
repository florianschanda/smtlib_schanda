(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b111101100100010 #b011001111)
                arg1
                (fp #b0 #b100000000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b100000000000111 #b000111000)
                arg1
                (fp #b0 #b110101010110000 #b101100011)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101110101101101 #b011001100)
                expect
                (fp #b0 #b000000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000000000)
                expect
                (fp #b0 #b110111010100110 #b100000001)))

(assert (= expect result))

(check-sat)
(exit)
