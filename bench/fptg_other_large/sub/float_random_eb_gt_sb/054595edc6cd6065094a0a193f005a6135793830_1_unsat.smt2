; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0000000010 #b10)
                arg1
                (fp #b0 #b0111111111 #b00)))
(assert (fp.leq (fp #b0 #b0111111111 #b00)
                arg1
                (fp #b0 #b1000010010 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1100001110 #b00)
                arg2
                (fp #b0 #b0000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000 #b01)
                arg2
                (fp #b0 #b1000101010 #b01)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0100100010 #b11)
                expect
                (fp #b0 #b0111111110 #b11)))
(assert (fp.leq (fp #b0 #b0111111110 #b11)
                expect
                (fp #b0 #b1100101010 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
