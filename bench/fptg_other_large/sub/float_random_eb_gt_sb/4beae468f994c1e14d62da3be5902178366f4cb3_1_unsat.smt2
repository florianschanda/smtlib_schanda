(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110000100100 #b0110010)
                arg1
                (fp #b0 #b101100000101 #b0010011)))
(assert (fp.leq (fp #b0 #b101100000101 #b0010011)
                arg1
                (fp #b0 #b110001010100 #b0101101)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b011001110001 #b0000010)
                arg2
                (fp #b0 #b111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111111)
                arg2
                (fp #b0 #b111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111110 #b1111111)
                expect
                (fp #b1 #b111111111110 #b1111110)))
(assert (fp.leq (fp #b1 #b111111111110 #b1111110)
                expect
                (fp #b1 #b001100100001 #b1101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
