(assert (fp.leq (fp #b1 #b000000000000000 #b0100000000)
                arg2
                (fp #b0 #b011100110001010 #b0000001110)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b101100100010000 #b0110001111)
                expect
                (fp #b0 #b100000000001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b100000000001001 #b1101010000)
                expect
                (fp #b0 #b101010110111100 #b0111101111)))

(assert (not (= expect result)))

