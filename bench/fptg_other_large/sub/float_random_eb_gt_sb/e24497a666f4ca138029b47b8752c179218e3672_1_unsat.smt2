; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b10100111000100000 #b000100011111010)
                arg1
                (fp #b1 #b01111111111111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b011000110111010)
                arg1
                (fp #b0 #b11101010010100001 #b100100011111001)))

(declare-const arg2 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b10000100011110110 #b010010011011101)
                arg2
                (fp #b1 #b00000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000000000000001)
                arg2
                (fp #b0 #b11010000010001101 #b000000100110011)))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11011110111111000 #b000111010111100)
                expect
                (fp #b1 #b01111111111111111 #b011000110111001)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b011000110111001)
                expect
                (fp #b0 #b00001011011010001 #b000000111001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
