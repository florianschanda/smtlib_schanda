(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110100100 #b010)
                arg1
                (fp #b0 #b0000000001 #b000)))
(assert (fp.leq (fp #b0 #b0000000001 #b000)
                arg1
                (fp #b0 #b0011110110 #b110)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1101010011 #b111)
                arg2
                (fp #b0 #b0000000001 #b000)))
(assert (fp.leq (fp #b0 #b0000000001 #b000)
                arg2
                (fp #b0 #b1011110010 #b011)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0001010001 #b011)
                expect
                (fp #b1 #b0000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000)
                expect
                (fp #b0 #b0001111101 #b101)))

(assert (= expect result))

(check-sat)
(exit)
