(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0111110001001 #b01)
                arg1
                (fp #b0 #b1111111111110 #b11)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11)
                arg1
                (fp #b0 #b1111111111111 #b00)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111111111101 #b10)
                arg2
                (fp #b1 #b1111111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111111101 #b00)
                arg2
                (fp #b0 #b0101011001011 #b10)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0001010110101 #b10)
                expect
                (fp #b0 #b1111111111110 #b11)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11)
                expect
                (fp #b0 #b1111111111111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
