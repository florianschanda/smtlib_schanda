(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111100111011110 #b01)
                arg1
                (fp #b0 #b010000000000000 #b00)))
(assert (fp.leq (fp #b0 #b010000000000000 #b00)
                arg1
                (fp #b0 #b010100001001011 #b11)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b110001110100100 #b01)
                arg2
                (fp #b1 #b011111111111111 #b11)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11)
                arg2
                (fp #b0 #b011001100001111 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000000000101111 #b01)
                expect
                (fp #b0 #b011111111111111 #b11)))
(assert (fp.leq (fp #b0 #b011111111111111 #b11)
                expect
                (fp #b0 #b101111010110111 #b11)))

(assert (= expect result))

(check-sat)
(exit)
