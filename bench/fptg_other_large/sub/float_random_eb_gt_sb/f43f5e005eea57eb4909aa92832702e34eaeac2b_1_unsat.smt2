(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011010100 #b000011)
                arg1
                (fp #b0 #b001001101 #b011000)))
(assert (fp.leq (fp #b0 #b001001101 #b011000)
                arg1
                (fp #b0 #b101100111 #b111101)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111100010 #b111000)
                arg2
                (fp #b1 #b100110001 #b110001)))
(assert (fp.leq (fp #b1 #b100110001 #b110001)
                arg2
                (fp #b0 #b010101110 #b011000)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001100010 #b101011)
                expect
                (fp #b0 #b100110001 #b110001)))
(assert (fp.leq (fp #b0 #b100110001 #b110001)
                expect
                (fp #b0 #b101001001 #b111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
