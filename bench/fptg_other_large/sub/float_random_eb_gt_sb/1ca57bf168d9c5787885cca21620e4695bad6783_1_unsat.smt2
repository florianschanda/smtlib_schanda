(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0000001000 #b11001100)
                arg1
                (fp #b1 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000000)
                arg1
                (fp #b0 #b1111000010 #b10101111)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0001011001 #b11011001)
                arg2
                (fp #b1 #b0000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b0000000000 #b01111101)
                arg2
                (fp #b0 #b0010010001 #b11100111)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0000000011 #b10000101)
                expect
                (fp #b0 #b0000000000 #b01111101)))
(assert (fp.leq (fp #b0 #b0000000000 #b01111101)
                expect
                (fp #b0 #b1110110000 #b10100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
