(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000101000101 #b01100011)
                arg1
                (fp #b0 #b011111111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001001)
                arg1
                (fp #b0 #b100111110101 #b01110001)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010111000100 #b00001000)
                arg2
                (fp #b1 #b010000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b00000000)
                arg2
                (fp #b0 #b011111100100 #b00111001)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b010101010101 #b00010001)
                expect
                (fp #b0 #b011111111111 #b11001010)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001010)
                expect
                (fp #b0 #b101110110101 #b00010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
