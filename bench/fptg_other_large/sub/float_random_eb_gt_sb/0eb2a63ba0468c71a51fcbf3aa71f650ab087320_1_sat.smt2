(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0111101010100 #b1000)
                arg1
                (fp #b0 #b0111111111111 #b0100)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0100)
                arg1
                (fp #b0 #b1010100111010 #b0111)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b1111110110010 #b1101)
                arg2
                (fp #b0 #b1111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b1111)
                arg2
                (fp #b0 #b1111111111111 #b0000)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1111111111110 #b1111)
                expect
                (fp #b1 #b1111111111110 #b1110)))
(assert (fp.leq (fp #b1 #b1111111111110 #b1110)
                expect
                (fp #b1 #b0011100100101 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
