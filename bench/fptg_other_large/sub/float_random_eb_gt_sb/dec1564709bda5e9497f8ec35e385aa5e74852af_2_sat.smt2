(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11001101000 #b1111010)
                arg1
                (fp #b1 #b10111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111)
                arg1
                (fp #b1 #b00001010111 #b0010001)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10000111111 #b0010000)
                arg2
                (fp #b1 #b00111111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111111100 #b0110101)
                arg2
                (fp #b0 #b10011100000 #b1011100)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11011010110 #b0100011)
                expect
                (fp #b1 #b10111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111)
                expect
                (fp #b0 #b01010010000 #b0000101)))

(assert (= expect result))

(check-sat)
(exit)
