(assert (fp.leq (fp #b1 #b00111111111111010 #b01101010000)
                arg2
                (fp #b0 #b11110010100011001 #b10101000100)))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b0 #b00010101001111101 #b11111011101)
                expect
                (fp #b0 #b00111111111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b00111111111111010 #b01101010000)
                expect
                (fp #b0 #b11110011010100100 #b11111001110)))

(assert (not (= expect result)))

(check-sat)
