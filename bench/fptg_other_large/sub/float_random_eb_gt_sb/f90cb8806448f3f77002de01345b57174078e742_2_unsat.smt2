(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b0 #b00011100010111 #b1000)
                arg1
                (fp #b0 #b10011110100110 #b0001)))
(assert (fp.leq (fp #b0 #b10011110100110 #b0001)
                arg1
                (fp #b0 #b10111101101010 #b0011)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111000000000 #b0110)
                arg2
                (fp #b1 #b01111111111111 #b0010)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0010)
                arg2
                (fp #b1 #b00101100010010 #b1001)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00111001111000 #b0110)
                expect
                (fp #b0 #b10011110100110 #b0010)))
(assert (fp.leq (fp #b0 #b10011110100110 #b0010)
                expect
                (fp #b0 #b11111111111100 #b0100)))

(assert (not (= expect result)))

(check-sat)
(exit)
