(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100101100 #b0111101)
                arg1
                (fp #b1 #b100000111 #b0000000)))
(assert (fp.leq (fp #b1 #b100000111 #b0000000)
                arg1
                (fp #b1 #b010100110 #b0011011)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b100010100 #b1010110)
                arg2
                (fp #b0 #b111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b111111101 #b0000000)
                arg2
                (fp #b0 #b111111101 #b1000110)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111101 #b1111111)
                expect
                (fp #b1 #b111111101 #b0000001)))
(assert (fp.leq (fp #b1 #b111111101 #b0000001)
                expect
                (fp #b1 #b100010110 #b0101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
