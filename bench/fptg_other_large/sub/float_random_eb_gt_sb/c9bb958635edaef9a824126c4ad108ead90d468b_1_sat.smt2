; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b0 #b00010110111000100 #b0000011110001)
                arg1
                (fp #b0 #b01000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b01000000000000000 #b0000000000000)
                arg1
                (fp #b0 #b10000111001110101 #b1001111001101)))

(declare-const arg2 (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b0 #b00110110001111100 #b0111110110010)
                arg2
                (fp #b0 #b11101011001111100 #b1101010110111)))
(assert (fp.leq (fp #b0 #b11101011001111100 #b1101010110111)
                arg2
                (fp #b0 #b11110000011100000 #b1100000010000)))

(declare-const result (_ FloatingPoint 17 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b1 #b11101110100001001 #b1001010011000)
                expect
                (fp #b1 #b11101011001111100 #b1101010110110)))
(assert (fp.leq (fp #b1 #b11101011001111100 #b1101010110110)
                expect
                (fp #b0 #b01100100101101000 #b0011111110100)))

(assert (= expect result))

(check-sat)
(exit)
