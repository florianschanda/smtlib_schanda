(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011001010 #b00111)
                arg2
                (fp #b0 #b0000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000)
                arg2
                (fp #b0 #b0100110111 #b00100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100110110 #b00111)
                expect
                (fp #b1 #b0000000000 #b01001)))
(assert (fp.leq (fp #b1 #b0000000000 #b01001)
                expect
                (fp #b0 #b1011000010 #b00100)))

(assert (= expect result))

(check-sat)
(exit)
