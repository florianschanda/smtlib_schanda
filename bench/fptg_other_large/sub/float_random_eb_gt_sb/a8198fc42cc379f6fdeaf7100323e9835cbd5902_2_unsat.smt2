(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01010001100101 #b11000)
                arg1
                (fp #b0 #b01010010010001 #b01101)))
(assert (fp.leq (fp #b0 #b01010010010001 #b01101)
                arg1
                (fp #b0 #b11011011010101 #b10101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01001001000010 #b00010)
                arg2
                (fp #b0 #b10101001001100 #b00000)))
(assert (fp.leq (fp #b0 #b10101001001100 #b00000)
                arg2
                (fp #b0 #b10101101001001 #b11100)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11011001100110 #b01011)
                expect
                (fp #b1 #b10101001001100 #b00000)))
(assert (fp.leq (fp #b1 #b10101001001100 #b00000)
                expect
                (fp #b0 #b01110111101101 #b01010)))

(assert (not (= expect result)))

(check-sat)
(exit)
