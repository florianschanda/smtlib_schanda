(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110110011000010 #b0)
                arg1
                (fp #b1 #b100000000000000 #b1)))
(assert (fp.leq (fp #b1 #b100000000000000 #b1)
                arg1
                (fp #b0 #b001100100110101 #b0)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b000001110100000 #b1)
                arg2
                (fp #b0 #b000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1)
                arg2
                (fp #b0 #b010110010010011 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b101111110001001 #b0)
                expect
                (fp #b1 #b100000000000000 #b1)))
(assert (fp.leq (fp #b1 #b100000000000000 #b1)
                expect
                (fp #b0 #b010111000011011 #b0)))

(assert (= expect result))

(check-sat)
(exit)
