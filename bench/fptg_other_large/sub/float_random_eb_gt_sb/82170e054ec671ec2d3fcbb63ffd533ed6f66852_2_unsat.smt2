(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b01011111101101 #b10111001011)
                expect
                (fp #b0 #b10000110000110 #b10000011100)))
(assert (fp.leq (fp #b0 #b10000110000110 #b10000011100)
                expect
