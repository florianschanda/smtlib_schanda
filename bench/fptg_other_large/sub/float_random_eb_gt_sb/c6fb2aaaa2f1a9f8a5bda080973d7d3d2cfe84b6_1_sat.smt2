(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11010111111 #b000)
                arg1
                (fp #b1 #b00000010101 #b101)))
(assert (fp.leq (fp #b1 #b00000010101 #b101)
                arg1
                (fp #b0 #b10000100010 #b100)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00110110010 #b011)
                arg2
                (fp #b0 #b10000000000 #b100)))
(assert (fp.leq (fp #b0 #b10000000000 #b100)
                arg2
                (fp #b0 #b11101001001 #b101)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10110001010 #b100)
                expect
                (fp #b1 #b10000000000 #b100)))
(assert (fp.leq (fp #b1 #b10000000000 #b100)
                expect
                (fp #b0 #b00010101100 #b110)))

(assert (= expect result))

(check-sat)
(exit)
