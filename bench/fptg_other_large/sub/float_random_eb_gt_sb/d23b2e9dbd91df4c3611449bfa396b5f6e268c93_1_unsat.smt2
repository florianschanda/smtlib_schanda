(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1000110011 #b1110101)
                arg1
                (fp #b0 #b0011111100 #b0110101)))
(assert (fp.leq (fp #b0 #b0011111100 #b0110101)
                arg1
                (fp #b0 #b0111011010 #b0110101)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111110010 #b0011100)
                arg2
                (fp #b1 #b1011011101 #b1100100)))
(assert (fp.leq (fp #b1 #b1011011101 #b1100100)
                arg2
                (fp #b1 #b1000001001 #b1000011)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0100011101 #b0110110)
                expect
                (fp #b0 #b1011011101 #b1100100)))
(assert (fp.leq (fp #b0 #b1011011101 #b1100100)
                expect
                (fp #b0 #b1101000001 #b1110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
