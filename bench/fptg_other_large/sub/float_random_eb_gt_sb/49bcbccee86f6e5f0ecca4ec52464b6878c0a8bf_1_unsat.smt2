(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00111101010 #b0010)
                arg1
                (fp #b0 #b00000000000 #b1110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110)
                arg1
                (fp #b0 #b00111101111 #b0001)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11110110001 #b1111)
                arg2
                (fp #b0 #b10000000011 #b0011)))
(assert (fp.leq (fp #b0 #b10000000011 #b0011)
                arg2
                (fp #b0 #b11111000100 #b0111)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11000000011 #b1101)
                expect
                (fp #b1 #b10000000011 #b0010)))
(assert (fp.leq (fp #b1 #b10000000011 #b0010)
                expect
                (fp #b0 #b11101111001 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
