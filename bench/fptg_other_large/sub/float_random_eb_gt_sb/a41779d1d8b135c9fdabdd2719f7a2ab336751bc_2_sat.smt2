(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101100101111 #b101011111)
                arg1
                (fp #b0 #b0000000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000001)
                arg1
                (fp #b0 #b0010111100011 #b010010110)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b0 #b0001011110111 #b000101010)
                arg2
                (fp #b0 #b1000000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000001001 #b000000000)
                arg2
                (fp #b0 #b1110111000000 #b111010011)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101001110111 #b001110010)
                expect
                (fp #b1 #b1000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000000001001 #b000000000)
                expect
                (fp #b0 #b1100010000100 #b001100100)))

(assert (= expect result))

(check-sat)
(exit)
