; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0001000000001111 #b101110001)
                arg1
                (fp #b0 #b0000000000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111111111)
                arg1
                (fp #b0 #b1110001000011100 #b010100001)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1100100100011000 #b100110000)
                arg2
                (fp #b0 #b0100000010011110 #b111000010)))
(assert (fp.leq (fp #b0 #b0100000010011110 #b111000010)
                arg2
                (fp #b0 #b0100000101110111 #b100101101)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0100110011010000 #b111011100)
                expect
                (fp #b1 #b0100000010011110 #b111000010)))
(assert (fp.leq (fp #b1 #b0100000010011110 #b111000010)
                expect
                (fp #b0 #b0101110101011100 #b010100100)))

(assert (= expect result))

(check-sat)
(exit)
