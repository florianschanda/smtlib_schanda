; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b0 #b010011000100100 #b111000110001)
                arg1
                (fp #b0 #b100000000001011 #b010101111110)))
(assert (fp.leq (fp #b0 #b100000000001011 #b010101111110)
                arg1
                (fp #b0 #b100001000110001 #b111010000010)))

(declare-const arg2 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b011100111010010 #b011001010110)
                arg2
                (fp #b1 #b000000000000000 #b101011101010)))
(assert (fp.leq (fp #b1 #b000000000000000 #b101011101010)
                arg2
                (fp #b0 #b000110110001100 #b111110000010)))

(declare-const result (_ FloatingPoint 15 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b001011000001101 #b000101100011)
                expect
                (fp #b0 #b100000000001011 #b010101111111)))
(assert (fp.leq (fp #b0 #b100000000001011 #b010101111111)
                expect
                (fp #b0 #b111011010011001 #b000010010000)))

(assert (= expect result))

(check-sat)
(exit)
