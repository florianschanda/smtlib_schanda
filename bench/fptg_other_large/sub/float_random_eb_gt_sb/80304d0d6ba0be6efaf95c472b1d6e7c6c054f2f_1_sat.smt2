(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111100001110 #b00)
                arg1
                (fp #b1 #b0111111111111 #b01)))
(assert (fp.leq (fp #b1 #b0111111111111 #b01)
                arg1
                (fp #b0 #b0000010000111 #b01)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1110011000111 #b11)
                arg2
                (fp #b1 #b1100101111010 #b10)))
(assert (fp.leq (fp #b1 #b1100101111010 #b10)
                arg2
                (fp #b1 #b0011100100000 #b11)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0101101110011 #b10)
                expect
                (fp #b0 #b1100101111010 #b01)))
(assert (fp.leq (fp #b0 #b1100101111010 #b01)
                expect
                (fp #b0 #b1111010100010 #b01)))

(assert (= expect result))

(check-sat)
(exit)
