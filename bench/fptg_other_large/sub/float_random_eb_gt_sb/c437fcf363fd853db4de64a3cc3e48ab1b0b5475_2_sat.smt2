;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b001101000111110 #b00110110011)
                arg1
                (fp #b0 #b000000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000001)
                arg1
                (fp #b0 #b000000001111100 #b10111010100)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b100110011100001 #b00101110001)
                arg2
                (fp #b0 #b011111111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b01111100000)
                arg2
                (fp #b0 #b101000011010110 #b00000011001)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b100111000110101 #b10011101011)
                expect
                (fp #b1 #b011111111111111 #b01111100000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b01111100000)
                expect
                (fp #b0 #b010010111010001 #b11000110110)))

(assert (= expect result))

(check-sat)
(exit)
