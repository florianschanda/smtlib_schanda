(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b00010110010 #b001)
                arg1
                (fp #b0 #b01111111111 #b100)))
(assert (fp.leq (fp #b0 #b01111111111 #b100)
                arg1
                (fp #b0 #b11011010111 #b110)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11010111010 #b101)
                arg2
                (fp #b1 #b10000110010 #b111)))
(assert (fp.leq (fp #b1 #b10000110010 #b111)
                arg2
                (fp #b1 #b00011000001 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01110111100 #b101)
                expect
                (fp #b0 #b10000110010 #b111)))
(assert (fp.leq (fp #b0 #b10000110010 #b111)
                expect
                (fp #b0 #b11011011011 #b010)))

(assert (= expect result))

(check-sat)
(exit)
