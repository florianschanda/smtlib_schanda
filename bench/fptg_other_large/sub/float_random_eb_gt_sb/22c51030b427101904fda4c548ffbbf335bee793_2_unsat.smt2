(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1010111100 #b1000)
                arg1
                (fp #b1 #b0100101000 #b0001)))
(assert (fp.leq (fp #b1 #b0100101000 #b0001)
                arg1
                (fp #b0 #b1001011110 #b1001)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1000000101 #b1111)
                arg2
                (fp #b0 #b0011111110 #b0000)))
(assert (fp.leq (fp #b0 #b0011111110 #b0000)
                arg2
                (fp #b0 #b1010101110 #b0000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0110000111 #b1111)
                expect
                (fp #b1 #b0100101000 #b0010)))
(assert (fp.leq (fp #b1 #b0100101000 #b0010)
                expect
                (fp #b0 #b1001010001 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
