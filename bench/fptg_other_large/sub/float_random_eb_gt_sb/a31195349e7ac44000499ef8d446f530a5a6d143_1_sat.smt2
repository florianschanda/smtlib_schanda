(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0011111100 #b00100)
                arg1
                (fp #b0 #b1101111110 #b00011)))
(assert (fp.leq (fp #b0 #b1101111110 #b00011)
                arg1
                (fp #b0 #b1111101001 #b01011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100000110 #b01001)
                arg2
                (fp #b0 #b0000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00001)
                arg2
                (fp #b0 #b0000101101 #b01100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011010010 #b10001)
                expect
                (fp #b0 #b1101111110 #b00010)))
(assert (fp.leq (fp #b0 #b1101111110 #b00010)
                expect
                (fp #b0 #b1111001011 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
