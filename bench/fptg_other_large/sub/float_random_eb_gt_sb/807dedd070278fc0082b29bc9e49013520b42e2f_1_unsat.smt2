(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110110001000 #b01011101)
                arg1
                (fp #b1 #b100000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100000001000 #b00000000)
                arg1
                (fp #b1 #b011100110101 #b00001000)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010101011011 #b11110111)
                arg2
                (fp #b0 #b010000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b010000000000 #b00000000)
                arg2
                (fp #b0 #b101000110000 #b11010010)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110010111101 #b11010110)
                expect
                (fp #b1 #b100000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100000001000 #b00000000)
                expect
                (fp #b0 #b110100101101 #b11011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
