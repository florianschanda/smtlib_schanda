(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b00011101000001 #b01111001010)
                arg1
                (fp #b1 #b00001101110110 #b11010001010)))
(assert (fp.leq (fp #b1 #b00001101110110 #b11010001010)
                arg1
                (fp #b0 #b11110111001000 #b01010001001)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11101110010010 #b10101101101)
                arg2
                (fp #b1 #b00000000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000000001)
                arg2
                (fp #b0 #b11011111010111 #b11111001000)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11001111101101 #b11100110000)
                expect
                (fp #b1 #b00001101110110 #b11010001010)))
(assert (fp.leq (fp #b1 #b00001101110110 #b11010001010)
                expect
                (fp #b0 #b00111101111001 #b10011010111)))

(assert (= expect result))

(check-sat)
(exit)
