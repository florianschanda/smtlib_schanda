(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0010010011 #b101)
                arg1
                (fp #b0 #b1011111110 #b111)))
(assert (fp.leq (fp #b0 #b1011111110 #b111)
                arg1
                (fp #b0 #b1111111010 #b000)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000000111 #b000)
                arg2
                (fp #b0 #b0000000000 #b001)))
(assert (fp.leq (fp #b0 #b0000000000 #b001)
                arg2
                (fp #b0 #b0011100101 #b111)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001011110 #b011)
                expect
                (fp #b0 #b1011111110 #b111)))
(assert (fp.leq (fp #b0 #b1011111110 #b111)
                expect
                (fp #b0 #b1110101000 #b010)))

(assert (= expect result))

(check-sat)
(exit)
