(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b011001010110010 #b000)
                arg1
                (fp #b0 #b101001010000111 #b110)))
(assert (fp.leq (fp #b0 #b101001010000111 #b110)
                arg1
                (fp #b0 #b110101110101111 #b110)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100100011010000 #b101)
                arg2
                (fp #b0 #b100000000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000000011 #b000)
                arg2
                (fp #b0 #b101111010000111 #b101)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b011011111100011 #b111)
                expect
                (fp #b0 #b101001010000111 #b110)))
(assert (fp.leq (fp #b0 #b101001010000111 #b110)
                expect
                (fp #b0 #b101111101101011 #b110)))

(assert (= expect result))

(check-sat)
(exit)
