(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b011111110001111 #b1100)
                arg1
                (fp #b1 #b011010100101010 #b1111)))
(assert (fp.leq (fp #b1 #b011010100101010 #b1111)
                arg1
                (fp #b0 #b010011000000000 #b1111)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b010010101010011 #b0000)
                arg2
                (fp #b0 #b100110111001010 #b1001)))
(assert (fp.leq (fp #b0 #b100110111001010 #b1001)
                arg2
                (fp #b0 #b111010100101010 #b0101)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111000111110001 #b1011)
                expect
                (fp #b1 #b100110111001010 #b1001)))
(assert (fp.leq (fp #b1 #b100110111001010 #b1001)
                expect
                (fp #b0 #b010001011110011 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
