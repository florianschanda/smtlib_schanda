(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100110010110000 #b001)
                arg1
                (fp #b0 #b101111100011001 #b010)))
(assert (fp.leq (fp #b0 #b101111100011001 #b010)
                arg1
                (fp #b0 #b110101010100000 #b101)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b011011111101010 #b001)
                arg2
                (fp #b1 #b001110010100000 #b110)))
(assert (fp.leq (fp #b1 #b001110010100000 #b110)
                arg2
                (fp #b0 #b101011110001101 #b110)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b010100001001110 #b100)
                expect
                (fp #b0 #b101111100011001 #b011)))
(assert (fp.leq (fp #b0 #b101111100011001 #b011)
                expect
                (fp #b0 #b110111100110010 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
