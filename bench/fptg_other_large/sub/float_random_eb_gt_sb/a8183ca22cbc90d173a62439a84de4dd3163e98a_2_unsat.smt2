; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b0 #b010010110001001 #b111000111)
                arg1
                (fp #b0 #b110100101001000 #b100111000)))
(assert (fp.leq (fp #b0 #b110100101001000 #b100111000)
                arg1
                (fp #b0 #b111110110011100 #b000110101)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b110110001111110 #b111010010)
                arg2
                (fp #b1 #b100010101110110 #b001101101)))
(assert (fp.leq (fp #b1 #b100010101110110 #b001101101)
                arg2
                (fp #b0 #b000011011010110 #b111101101)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b0 #b010101001000100 #b011011101)
                expect
                (fp #b0 #b110100101001000 #b100111001)))
(assert (fp.leq (fp #b0 #b110100101001000 #b100111001)
                expect
                (fp #b0 #b110111000000001 #b010001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
