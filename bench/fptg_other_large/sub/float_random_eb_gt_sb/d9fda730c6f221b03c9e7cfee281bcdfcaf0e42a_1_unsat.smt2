(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b0 #b001001010011101 #b00101000011)
                arg1
                (fp #b0 #b111100000010011 #b00010110101)))
(assert (fp.leq (fp #b0 #b111100000010011 #b00010110101)
                arg1
                (fp #b0 #b111101100001010 #b10110000000)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b111111111111110 #b01011001000)
                arg2
                (fp #b1 #b111111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00000000000)
                arg2
                (fp #b0 #b000001100000010 #b01011000010)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b010001001010011 #b10010101110)
                expect
                (fp #b0 #b111111111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00000000000)
                expect
                (fp #b0 #b111111111111101 #b11011010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
