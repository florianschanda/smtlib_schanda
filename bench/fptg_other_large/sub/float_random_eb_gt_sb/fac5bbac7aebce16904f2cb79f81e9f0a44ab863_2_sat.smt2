(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b010101001 #b110001)
                arg1
                (fp #b1 #b001111101 #b000000)))
(assert (fp.leq (fp #b1 #b001111101 #b000000)
                arg1
                (fp #b0 #b000100101 #b111001)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110101000 #b001000)
                arg2
                (fp #b1 #b100000110 #b000000)))
(assert (fp.leq (fp #b1 #b100000110 #b000000)
                arg2
                (fp #b1 #b100000000 #b001111)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011000111 #b011111)
                expect
                (fp #b0 #b100000110 #b000000)))
(assert (fp.leq (fp #b0 #b100000110 #b000000)
                expect
                (fp #b0 #b101111001 #b000010)))

(assert (= expect result))

(check-sat)
(exit)
