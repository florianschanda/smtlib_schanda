; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1010111001111100 #b0010100010)
                arg1
                (fp #b1 #b0001010010101011 #b1010100111)))
(assert (fp.leq (fp #b1 #b0001010010101011 #b1010100111)
                arg1
                (fp #b0 #b0001011011000000 #b1000000111)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0111001111111100 #b0011110000)
                arg2
                (fp #b0 #b0000000000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000001)
                arg2
                (fp #b0 #b0001111010001100 #b0010000100)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1010011000101000 #b1010000110)
                expect
                (fp #b1 #b0001010010101011 #b1010101000)))
(assert (fp.leq (fp #b1 #b0001010010101011 #b1010101000)
                expect
                (fp #b0 #b1111011101001001 #b1011101110)))

(assert (= expect result))

(check-sat)
(exit)
