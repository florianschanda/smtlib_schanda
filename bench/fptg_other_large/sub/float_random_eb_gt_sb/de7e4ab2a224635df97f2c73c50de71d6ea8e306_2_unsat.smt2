(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b101011000011 #b0101)
                arg1
                (fp #b1 #b011111111111 #b1010)))
(assert (fp.leq (fp #b1 #b011111111111 #b1010)
                arg1
                (fp #b0 #b001110011110 #b0101)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b000010001010 #b1101)
                arg2
                (fp #b0 #b101111111110 #b1111)))
(assert (fp.leq (fp #b0 #b101111111110 #b1111)
                arg2
                (fp #b0 #b110010100110 #b0001)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111010000000 #b0001)
                expect
                (fp #b1 #b101111111111 #b0000)))
(assert (fp.leq (fp #b1 #b101111111111 #b0000)
                expect
                (fp #b1 #b101111111101 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
