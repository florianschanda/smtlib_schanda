                arg2
                (fp #b1 #b10000000011 #b1110)))
(assert (fp.leq (fp #b1 #b10000000011 #b1110)
                arg2
                (fp #b0 #b11110011111 #b1111)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01010111010 #b0101)
                expect
                (fp #b0 #b10000000100 #b0011)))
(assert (fp.leq (fp #b0 #b10000000100 #b0011)
                expect
                (fp #b0 #b10110011101 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
