; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00100000100110 #b111100001)
                arg1
                (fp #b0 #b10000000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b10000000000111 #b000111000)
                arg1
                (fp #b0 #b11010000001110 #b011011111)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00010001101010 #b001110011)
                arg2
                (fp #b0 #b10100100011001 #b000100000)))
(assert (fp.leq (fp #b0 #b10100100011001 #b000100000)
                arg2
                (fp #b0 #b11101011011100 #b101100000)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11001011110000 #b110011011)
                expect
                (fp #b1 #b10100100011001 #b000100000)))
(assert (fp.leq (fp #b1 #b10100100011001 #b000100000)
                expect
                (fp #b0 #b10110011101010 #b111010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
