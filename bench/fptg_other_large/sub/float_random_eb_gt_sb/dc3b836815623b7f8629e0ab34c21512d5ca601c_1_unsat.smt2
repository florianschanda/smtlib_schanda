(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10101111101 #b0)
                arg1
                (fp #b0 #b01001000101 #b1)))
(assert (fp.leq (fp #b0 #b01001000101 #b1)
                arg1
                (fp #b0 #b01010001000 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11010101010 #b0)
                arg2
                (fp #b1 #b00111111111 #b1)))
(assert (fp.leq (fp #b1 #b00111111111 #b1)
                arg2
                (fp #b0 #b10101100010 #b0)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01010010100 #b1)
                expect
                (fp #b0 #b01001000101 #b1)))
(assert (fp.leq (fp #b0 #b01001000101 #b1)
                expect
                (fp #b0 #b01100111110 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
