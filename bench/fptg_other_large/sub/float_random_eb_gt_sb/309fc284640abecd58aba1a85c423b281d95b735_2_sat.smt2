(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011100010 #b110)
                arg1
                (fp #b1 #b000001011 #b101)))
(assert (fp.leq (fp #b1 #b000001011 #b101)
                arg1
                (fp #b0 #b001000001 #b100)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b011011100 #b110)
                arg2
                (fp #b0 #b100000001 #b000)))
(assert (fp.leq (fp #b0 #b100000001 #b000)
                arg2
                (fp #b0 #b110110100 #b011)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101110010 #b011)
                expect
                (fp #b1 #b100000001 #b001)))
(assert (fp.leq (fp #b1 #b100000001 #b001)
                expect
                (fp #b1 #b011011111 #b010)))

(assert (= expect result))

(check-sat)
(exit)
