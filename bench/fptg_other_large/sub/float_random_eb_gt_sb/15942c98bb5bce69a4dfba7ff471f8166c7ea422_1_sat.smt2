(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1101001001001 #b00100110)
                arg1
                (fp #b0 #b0000000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b11111111)
                arg1
                (fp #b0 #b0100001001011 #b11010001)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0110001101110 #b01110010)
                arg2
                (fp #b1 #b0100000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b00000000)
                arg2
                (fp #b0 #b0110001000110 #b00110101)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1001001100011 #b00011011)
                expect
                (fp #b0 #b0100000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0100000000000 #b00000000)
                expect
                (fp #b0 #b0100000110101 #b00100001)))

(assert (= expect result))

(check-sat)
(exit)
