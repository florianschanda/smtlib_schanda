(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111011010 #b01010000)
                arg1
                (fp #b1 #b1101000101 #b10001111)))
(assert (fp.leq (fp #b1 #b1101000101 #b10001111)
                arg1
                (fp #b1 #b0110000110 #b10000011)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0010000011 #b10010001)
                arg2
                (fp #b0 #b0010011101 #b00010101)))
(assert (fp.leq (fp #b0 #b0010011101 #b00010101)
                arg2
                (fp #b0 #b1110011000 #b01001010)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101001000 #b10001010)
                expect
                (fp #b1 #b1101000101 #b10010000)))
(assert (fp.leq (fp #b1 #b1101000101 #b10010000)
                expect
                (fp #b1 #b0101111010 #b11110111)))

(assert (= expect result))

(check-sat)
(exit)
