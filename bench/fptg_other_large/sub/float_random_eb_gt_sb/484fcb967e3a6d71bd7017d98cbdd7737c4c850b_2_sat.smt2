; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101011100101001 #b11011)
                arg1
                (fp #b0 #b000101011000011 #b10010)))
(assert (fp.leq (fp #b0 #b000101011000011 #b10010)
                arg1
                (fp #b0 #b100101111001100 #b01001)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b110001000010001 #b11110)
                arg2
                (fp #b1 #b100000000000100 #b11110)))
(assert (fp.leq (fp #b1 #b100000000000100 #b11110)
                arg2
                (fp #b0 #b110100000110110 #b00010)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b110101001001110 #b00100)
                expect
                (fp #b0 #b100000000000100 #b11111)))
(assert (fp.leq (fp #b0 #b100000000000100 #b11111)
                expect
                (fp #b0 #b111010001100000 #b10111)))

(assert (= expect result))

(check-sat)
(exit)
