; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10111111000 #b101011011)
                arg1
                (fp #b0 #b00000010100 #b101010111)))
(assert (fp.leq (fp #b0 #b00000010100 #b101010111)
                arg1
                (fp #b0 #b00110000100 #b001111010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11011100100 #b010101100)
                arg2
                (fp #b1 #b01111111111 #b001111111)))
(assert (fp.leq (fp #b1 #b01111111111 #b001111111)
                arg2
                (fp #b0 #b00011111010 #b000100111)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01101101100 #b000001011)
                expect
                (fp #b0 #b01111111111 #b001111111)))
(assert (fp.leq (fp #b0 #b01111111111 #b001111111)
                expect
                (fp #b0 #b11001110110 #b010001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
