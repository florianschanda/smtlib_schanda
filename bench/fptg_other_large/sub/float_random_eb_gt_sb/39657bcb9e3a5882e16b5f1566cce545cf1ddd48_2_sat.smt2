(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0110111010 #b0)
                arg1
                (fp #b0 #b1100101000 #b1)))
(assert (fp.leq (fp #b0 #b1100101000 #b1)
                arg1
                (fp #b0 #b1111011010 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1011110001 #b0)
                arg2
                (fp #b0 #b0000000000 #b1)))
(assert (fp.leq (fp #b0 #b0000000000 #b1)
                arg2
                (fp #b0 #b1000000100 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0110010110 #b0)
                expect
                (fp #b0 #b1100101000 #b1)))
(assert (fp.leq (fp #b0 #b1100101000 #b1)
                expect
                (fp #b0 #b1111010000 #b1)))

(assert (= expect result))

(check-sat)
(exit)
