(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00100100011100 #b00101)
                arg1
                (fp #b0 #b01010010010001 #b01101)))
(assert (fp.leq (fp #b0 #b01010010010001 #b01101)
                arg1
                (fp #b0 #b10101111101011 #b10100)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10010011000001 #b00101)
                expect
                (fp #b0 #b01010010010010 #b01101)))
(assert (fp.leq (fp #b0 #b01010010010010 #b01101)
                expect
                (fp #b0 #b11010111110000 #b01000)))

(assert (not (= expect result)))

(check-sat)
(exit)
