(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 13))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b01010110110101 #b011011011100)
                arg2
                (fp #b0 #b01111111111111 #b011000101101)))
(assert (fp.leq (fp #b0 #b01111111111111 #b011000101101)
                arg2
                (fp #b0 #b10010010011101 #b011001011001)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
