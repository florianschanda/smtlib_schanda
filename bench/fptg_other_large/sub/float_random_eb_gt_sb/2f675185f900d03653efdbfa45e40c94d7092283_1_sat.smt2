; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0111000111111111 #b111001)
                arg1
                (fp #b0 #b0000000000000000 #b010111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010111)
                arg1
                (fp #b0 #b0001111110001000 #b101111)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1001000000110001 #b100100)
                arg2
                (fp #b1 #b0101010101010000 #b111011)))
(assert (fp.leq (fp #b1 #b0101010101010000 #b111011)
                arg2
                (fp #b0 #b1100100000100100 #b111110)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0001001010000110 #b110010)
                expect
                (fp #b0 #b0101010101010000 #b111011)))
(assert (fp.leq (fp #b0 #b0101010101010000 #b111011)
                expect
                (fp #b0 #b0110000010110001 #b000001)))

(assert (= expect result))

(check-sat)
(exit)
