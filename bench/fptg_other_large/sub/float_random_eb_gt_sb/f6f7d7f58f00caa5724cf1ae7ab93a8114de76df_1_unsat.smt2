(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100101000 #b00101)
                arg1
                (fp #b0 #b100000001 #b00000)))
(assert (fp.leq (fp #b0 #b100000001 #b00000)
                arg1
                (fp #b0 #b101100000 #b11010)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b011010111 #b11110)
                arg2
                (fp #b1 #b000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000)
                arg2
                (fp #b0 #b110001000 #b10011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011001111 #b01000)
                expect
                (fp #b0 #b100000001 #b00000)))
(assert (fp.leq (fp #b0 #b100000001 #b00000)
                expect
                (fp #b0 #b110000010 #b01100)))

(assert (not (= expect result)))

(check-sat)
(exit)
