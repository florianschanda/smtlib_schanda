; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0001011001001 #b011)
                arg1
                (fp #b0 #b0000000000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000000000 #b110)
                arg1
                (fp #b0 #b0100111100000 #b010)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111011000110 #b100)
                arg2
                (fp #b1 #b1110100011010 #b111)))
(assert (fp.leq (fp #b1 #b1110100011010 #b111)
                arg2
                (fp #b0 #b1110000011000 #b010)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1011011111111 #b010)
                expect
                (fp #b0 #b1110100011011 #b000)))
(assert (fp.leq (fp #b0 #b1110100011011 #b000)
                expect
                (fp #b0 #b1111100011011 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
