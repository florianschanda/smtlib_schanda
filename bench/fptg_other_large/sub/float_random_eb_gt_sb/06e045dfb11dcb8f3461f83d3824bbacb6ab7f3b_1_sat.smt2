(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11000110111 #b1001)
                arg1
                (fp #b0 #b00000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000)
                arg1
                (fp #b0 #b10111011011 #b0000)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
