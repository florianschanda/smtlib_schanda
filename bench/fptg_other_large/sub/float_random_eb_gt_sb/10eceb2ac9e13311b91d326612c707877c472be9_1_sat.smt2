(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b001100000110000 #b11111001)
                arg1
                (fp #b1 #b001011100110001 #b00111010)))
(assert (fp.leq (fp #b1 #b001011100110001 #b00111010)
                arg1
                (fp #b0 #b001111111101100 #b11111010)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b101001110111011 #b11110010)
                arg2
                (fp #b1 #b011111111111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b00000000)
                arg2
                (fp #b1 #b010100111010111 #b00101101)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b101010011001011 #b01100100)
                expect
                (fp #b0 #b011111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b011111111111110 #b11111111)
                expect
                (fp #b0 #b101101100001100 #b00001011)))

(assert (= expect result))

(check-sat)
(exit)
