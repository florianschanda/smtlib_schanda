(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b11001111000 #b111101)
                arg1
                (fp #b0 #b11111111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b000000)
                arg1
                (fp #b0 #b11111111101 #b011111)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b01100001000 #b100111)
                arg2
                (fp #b1 #b00111111101 #b000000)))
(assert (fp.leq (fp #b1 #b00111111101 #b000000)
                arg2
                (fp #b0 #b11000111111 #b000001)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10000000010 #b111110)
                expect
                (fp #b0 #b11111111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b000000)
                expect
                (fp #b0 #b11111111110 #b100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
