;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b00100010000100011 #b10111)
                arg1
                (fp #b0 #b00000000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00001)
                arg1
                (fp #b0 #b11111010111111001 #b00001)))

(declare-const arg2 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b0 #b00111010111100000 #b00010)
                arg2
                (fp #b0 #b10111111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b10111111111111110 #b11111)
                arg2
                (fp #b0 #b11100010000010100 #b01111)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11111001100100000 #b11100)
                expect
                (fp #b1 #b10111111111111110 #b11110)))
(assert (fp.leq (fp #b1 #b10111111111111110 #b11110)
                expect
                (fp #b1 #b10000010001010011 #b10010)))

(assert (= expect result))

(check-sat)
(exit)
