                (fp #b1 #b00000000000000000 #b11)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b11)
                arg2
                (fp #b0 #b00000010111101110 #b11)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11101111001111000 #b10)
                expect
                (fp #b1 #b10111111111111110 #b11)))
(assert (fp.leq (fp #b1 #b10111111111111110 #b11)
                expect
                (fp #b1 #b01100110101001000 #b01)))

(assert (not (= expect result)))

(check-sat)
