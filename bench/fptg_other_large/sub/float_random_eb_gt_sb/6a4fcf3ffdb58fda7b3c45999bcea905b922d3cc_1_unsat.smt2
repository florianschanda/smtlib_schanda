; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0000110010 #b10110000)
                arg1
                (fp #b1 #b0000100110 #b11010000)))
(assert (fp.leq (fp #b1 #b0000100110 #b11010000)
                arg1
                (fp #b0 #b0110111101 #b01010110)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111101010 #b11000101)
                arg2
                (fp #b1 #b0111111111 #b10011100)))
(assert (fp.leq (fp #b1 #b0111111111 #b10011100)
                arg2
                (fp #b0 #b0011000011 #b01110000)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0010101010 #b11101011)
                expect
                (fp #b0 #b0111111111 #b10011011)))
(assert (fp.leq (fp #b0 #b0111111111 #b10011011)
                expect
                (fp #b0 #b1100011110 #b10010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
