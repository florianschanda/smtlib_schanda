; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0111110110111 #b01)
                arg1
                (fp #b0 #b0000000000001 #b00)))
(assert (fp.leq (fp #b0 #b0000000000001 #b00)
                arg1
                (fp #b0 #b0011111000010 #b11)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1001000000011 #b01)
                arg2
                (fp #b1 #b1000000000001 #b10)))
(assert (fp.leq (fp #b1 #b1000000000001 #b10)
                arg2
                (fp #b0 #b0001011100000 #b00)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0000001101010 #b11)
                expect
                (fp #b0 #b1000000000001 #b11)))
(assert (fp.leq (fp #b0 #b1000000000001 #b11)
                expect
                (fp #b0 #b1110011111010 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
