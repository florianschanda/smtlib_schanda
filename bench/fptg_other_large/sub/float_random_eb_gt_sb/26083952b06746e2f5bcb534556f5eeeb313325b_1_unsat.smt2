; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101101010011 #b0110101101)
                arg1
                (fp #b1 #b100010110011 #b1100100001)))
(assert (fp.leq (fp #b1 #b100010110011 #b1100100001)
                arg1
                (fp #b0 #b011111100011 #b1110011110)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110111110100 #b1111001010)
                expect
                (fp #b1 #b100010110100 #b1100100001)))
(assert (fp.leq (fp #b1 #b100010110100 #b1100100001)
                expect
                (fp #b0 #b010100011100 #b0011001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
