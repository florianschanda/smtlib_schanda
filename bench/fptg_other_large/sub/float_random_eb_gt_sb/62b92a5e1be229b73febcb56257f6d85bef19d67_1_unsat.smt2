(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1100011010 #b100100)
                arg1
                (fp #b1 #b0000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000)
                arg1
                (fp #b0 #b0011110110 #b110010)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111101000 #b010000)
                arg2
                (fp #b1 #b0000000000 #b111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b111111)
                arg2
                (fp #b0 #b0100101001 #b000010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0001011010 #b110110)
                expect
                (fp #b0 #b0000000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111)
                expect
                (fp #b0 #b0011011111 #b000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
