(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b100110010010100111 #b111)
                arg1
                (fp #b0 #b011111111111111111 #b000)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b000)
                arg1
                (fp #b0 #b110001100000101011 #b110)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b111111111111111101 #b001)
                arg2
                (fp #b1 #b111111111111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b000)
                arg2
                (fp #b1 #b001001010111111111 #b001)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b101000000110111000 #b110)
                expect
                (fp #b0 #b111111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b000)
                expect
                (fp #b0 #b111111111111111110 #b001)))

(assert (= expect result))

(check-sat)
(exit)
