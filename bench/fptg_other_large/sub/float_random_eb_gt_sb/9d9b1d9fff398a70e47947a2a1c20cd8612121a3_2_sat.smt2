                arg2
                (fp #b0 #b110011000011100 #b1011101)))
(assert (fp.leq (fp #b0 #b110011000011100 #b1011101)
                arg2
                (fp #b0 #b110011100100101 #b1010101)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111111000111100 #b1000010)
                expect
                (fp #b1 #b110011000011100 #b1011110)))
(assert (fp.leq (fp #b1 #b110011000011100 #b1011110)
                expect
                (fp #b0 #b110101010010001 #b1100000)))

(assert (= expect result))

(check-sat)
(exit)
