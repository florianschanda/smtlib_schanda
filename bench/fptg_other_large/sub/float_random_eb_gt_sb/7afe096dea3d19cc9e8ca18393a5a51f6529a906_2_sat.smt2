; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b1001011011001010 #b001110110)
                arg1
                (fp #b0 #b1100111101110110 #b001000001)))
(assert (fp.leq (fp #b0 #b1100111101110110 #b001000001)
                arg1
                (fp #b0 #b1111010101011100 #b101000101)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0110000000110101 #b010111111)
                arg2
                (fp #b0 #b0000000000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100101010)
                arg2
                (fp #b0 #b0010010100011111 #b010011010)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b1001111111010011 #b111111101)
                expect
                (fp #b0 #b1100111101110110 #b001000001)))
(assert (fp.leq (fp #b0 #b1100111101110110 #b001000001)
                expect
                (fp #b0 #b1101011111101101 #b101011101)))

(assert (= expect result))

(check-sat)
(exit)
