(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b0 #b000001100110110011 #b01100)
                arg1
                (fp #b0 #b100111110111100101 #b11000)))
(assert (fp.leq (fp #b0 #b100111110111100101 #b11000)
                arg1
                (fp #b0 #b111111000011110100 #b00010)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
