(assert (fp.leq (fp #b0 #b001111111111111110 #b011)
                arg2
                (fp #b0 #b110100101000110110 #b111)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b110001110010000100 #b111)
                expect
                (fp #b1 #b001111111111111110 #b011)))
(assert (fp.leq (fp #b1 #b001111111111111110 #b011)
                expect
                (fp #b0 #b110101110010001000 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
