;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111010100011011 #b000010)
                arg1
                (fp #b0 #b010000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b010000000000000 #b000000)
                arg1
                (fp #b0 #b111011100010000 #b100000)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b101101111110111 #b000000)
                arg2
                (fp #b0 #b011111111111111 #b000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b000000)
                arg2
                (fp #b0 #b100010110101110 #b111111)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b100100110001111 #b001100)
                expect
                (fp #b1 #b011111111111111 #b000000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b000000)
                expect
                (fp #b1 #b000011000111101 #b111110)))

(assert (= expect result))

(check-sat)
(exit)
