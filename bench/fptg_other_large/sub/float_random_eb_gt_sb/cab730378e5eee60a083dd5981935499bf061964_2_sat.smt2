; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1001010101100011 #b11100001001)
                arg1
                (fp #b1 #b0000001010011110 #b11000011110)))
(assert (fp.leq (fp #b1 #b0000001010011110 #b11000011110)
                arg1
                (fp #b0 #b1000001000000110 #b11101001110)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0101101110101010 #b01001001101)
                arg2
                (fp #b1 #b0011111111111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b0011111111111010 #b01101010000)
                arg2
                (fp #b0 #b0110001011011110 #b11101011111)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0001111111110101 #b11110011100)
                expect
                (fp #b0 #b0011111111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b0011111111111010 #b01101010000)
                expect
                (fp #b0 #b1100011000001100 #b10001000010)))

(assert (= expect result))

(check-sat)
(exit)
