                (fp #b1 #b1111001100010000 #b101100101001)))
(assert (fp.leq (fp #b1 #b1111001100010000 #b101100101001)
                arg2
                (fp #b0 #b0011111110101011 #b000100100010)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b0011100001110000 #b011000000111)
                expect
                (fp #b0 #b1111001100010000 #b101100101000)))
(assert (fp.leq (fp #b0 #b1111001100010000 #b101100101000)
                expect
                (fp #b0 #b1111111110011111 #b100010001011)))

(assert (= expect result))

(check-sat)
