(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100111100 #b00111)
                arg1
                (fp #b1 #b0111111111 #b10100)))
(assert (fp.leq (fp #b1 #b0111111111 #b10100)
                arg1
                (fp #b0 #b1111100011 #b11011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111001011 #b00001)
                arg2
                (fp #b1 #b1101001010 #b11000)))
(assert (fp.leq (fp #b1 #b1101001010 #b11000)
                arg2
                (fp #b0 #b0111110101 #b00010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0110110110 #b00000)
                expect
                (fp #b0 #b1101001010 #b10111)))
(assert (fp.leq (fp #b0 #b1101001010 #b10111)
                expect
                (fp #b0 #b1111100000 #b11000)))

(assert (not (= expect result)))

(check-sat)
(exit)
