(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111110100100000 #b0001100)
                arg1
                (fp #b1 #b010111001100101 #b1111010)))
(assert (fp.leq (fp #b1 #b010111001100101 #b1111010)
                arg1
                (fp #b1 #b000111111110111 #b0101001)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111110110000010 #b0011010)
                arg2
                (fp #b1 #b010000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b0000000)
                arg2
                (fp #b1 #b001111001110111 #b0001011)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101011001100000 #b1100101)
                expect
                (fp #b1 #b010111001100101 #b1111001)))
(assert (fp.leq (fp #b1 #b010111001100101 #b1111001)
                expect
                (fp #b0 #b001001100110000 #b1110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
