(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1011101111110000 #b01111100000101)
                arg1
                (fp #b1 #b1000000000001101 #b11110010010110)))
(assert (fp.leq (fp #b1 #b1000000000001101 #b11110010010110)
                arg1
                (fp #b0 #b0100100110100110 #b00101100010100)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
