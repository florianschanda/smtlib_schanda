; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0010110011000 #b111000010)
                arg1
                (fp #b0 #b0000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000)
                arg1
                (fp #b0 #b0010011111000 #b011010101)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1001110101111 #b111010111)
                arg2
                (fp #b1 #b1000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000000001001 #b000000000)
                arg2
                (fp #b1 #b0010111100101 #b001100010)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0111101000011 #b011011101)
                expect
                (fp #b0 #b1000000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000001001 #b000000000)
                expect
                (fp #b0 #b1011111010001 #b011111011)))

(assert (= expect result))

(check-sat)
(exit)
