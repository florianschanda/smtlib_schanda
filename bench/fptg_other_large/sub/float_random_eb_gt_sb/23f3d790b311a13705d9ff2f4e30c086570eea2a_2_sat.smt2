(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01110111010100 #b110)
                arg1
                (fp #b1 #b01000000000000 #b000)))
(assert (fp.leq (fp #b1 #b01000000000000 #b000)
                arg1
                (fp #b1 #b00111000010001 #b001)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111100010000 #b011)
                arg2
                (fp #b0 #b00000000000000 #b111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b111)
                arg2
                (fp #b0 #b01101001100110 #b111)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11010111101011 #b110)
                expect
                (fp #b1 #b01000000000000 #b001)))
(assert (fp.leq (fp #b1 #b01000000000000 #b001)
                expect
                (fp #b0 #b10000010100100 #b111)))

(assert (= expect result))

(check-sat)
(exit)
