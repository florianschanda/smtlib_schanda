; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11100010101110 #b00010010)
                arg1
                (fp #b0 #b00001111100110 #b10010011)))
(assert (fp.leq (fp #b0 #b00001111100110 #b10010011)
                arg1
                (fp #b0 #b10010100001001 #b11010100)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b0 #b10111010011010 #b11100011)
                arg2
                (fp #b0 #b11111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b11111111)
                arg2
                (fp #b0 #b11111111111111 #b00000000)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11111111111111 #b00000000)
                expect
                (fp #b1 #b11111111111110 #b11111110)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11111110)
                expect
                (fp #b0 #b01000110101111 #b10101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
