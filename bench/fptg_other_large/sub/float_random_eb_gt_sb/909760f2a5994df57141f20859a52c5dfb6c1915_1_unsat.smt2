; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1101011110011000 #b10000)
                arg1
                (fp #b0 #b0000000000000000 #b11001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b11001)
                arg1
                (fp #b0 #b0010000111001001 #b11000)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1011111100101000 #b00100)
                arg2
                (fp #b0 #b1000000010110000 #b00010)))
(assert (fp.leq (fp #b0 #b1000000010110000 #b00010)
                arg2
                (fp #b0 #b1000111000011111 #b01000)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1110010001000101 #b10100)
                expect
                (fp #b1 #b1000000010110000 #b00001)))
(assert (fp.leq (fp #b1 #b1000000010110000 #b00001)
                expect
                (fp #b1 #b0101011000001110 #b10010)))

(assert (not (= expect result)))

(check-sat)
(exit)
