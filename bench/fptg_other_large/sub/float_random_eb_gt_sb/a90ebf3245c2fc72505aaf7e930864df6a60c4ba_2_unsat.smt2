(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111101100011 #b01)
                arg1
                (fp #b0 #b011001001000 #b00)))
(assert (fp.leq (fp #b0 #b011001001000 #b00)
                arg1
                (fp #b0 #b101110001111 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b001110011100 #b01)
                arg2
                (fp #b0 #b101101010100 #b01)))
(assert (fp.leq (fp #b0 #b101101010100 #b01)
                arg2
                (fp #b0 #b111111111011 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101110011001 #b01)
                expect
                (fp #b1 #b101101010100 #b01)))
(assert (fp.leq (fp #b1 #b101101010100 #b01)
                expect
                (fp #b1 #b100111100101 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
