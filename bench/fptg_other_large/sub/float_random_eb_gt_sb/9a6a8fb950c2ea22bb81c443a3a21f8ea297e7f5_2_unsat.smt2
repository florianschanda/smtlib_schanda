(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10001011101 #b00010)
                arg1
                (fp #b1 #b01111111111 #b10100)))
(assert (fp.leq (fp #b1 #b01111111111 #b10100)
                arg1
                (fp #b0 #b01111000000 #b11010)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111000101 #b10101)
                arg2
                (fp #b1 #b11110101000 #b00101)))
(assert (fp.leq (fp #b1 #b11110101000 #b00101)
                arg2
                (fp #b1 #b11000001010 #b11011)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b10101101101 #b10001)
                expect
                (fp #b0 #b11110101000 #b00101)))
(assert (fp.leq (fp #b0 #b11110101000 #b00101)
                expect
                (fp #b0 #b11111101100 #b11010)))

(assert (not (= expect result)))

(check-sat)
(exit)
