; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10010010000 #b01000100)
                arg1
                (fp #b1 #b00000000000 #b00010111)))
(assert (fp.leq (fp #b1 #b00000000000 #b00010111)
                arg1
                (fp #b0 #b11001010011 #b01110101)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b00101110000 #b01111111)
                arg2
                (fp #b0 #b01111111111 #b00000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b00000000)
                arg2
                (fp #b0 #b11001110010 #b01100000)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11001010100 #b01010010)
                expect
                (fp #b1 #b01111111111 #b00000001)))
(assert (fp.leq (fp #b1 #b01111111111 #b00000001)
                expect
                (fp #b1 #b01111110010 #b01000000)))

(assert (= expect result))

(check-sat)
(exit)
