(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0100010000110011 #b1100)
                arg1
                (fp #b0 #b1011111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b1111)
                arg1
                (fp #b0 #b1101100101010000 #b1100)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1100111011101110 #b1110)
                arg2
                (fp #b1 #b0111111111111111 #b0010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b0010)
                arg2
                (fp #b1 #b0011110111100110 #b1001)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b0 #b0111110010010111 #b0111)
                expect
                (fp #b0 #b1011111111111111 #b0000)))
(assert (fp.leq (fp #b0 #b1011111111111111 #b0000)
                expect
                (fp #b0 #b1100011010101010 #b1110)))

(assert (= expect result))

(check-sat)
(exit)
