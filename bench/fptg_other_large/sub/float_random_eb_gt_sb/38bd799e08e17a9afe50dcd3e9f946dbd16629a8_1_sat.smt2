(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0110110101 #b110000)
                arg1
                (fp #b0 #b0111111111 #b000100)))
(assert (fp.leq (fp #b0 #b0111111111 #b000100)
                arg1
                (fp #b0 #b1000001011 #b111111)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101111010 #b010011)
                arg2
                (fp #b1 #b1000000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000)
                arg2
                (fp #b0 #b0110011011 #b110011)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0010110011 #b101110)
                expect
                (fp #b0 #b1000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000110 #b000000)
                expect
                (fp #b0 #b1100000011 #b010000)))

(assert (= expect result))

(check-sat)
(exit)
