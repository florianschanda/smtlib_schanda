(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10111011111 #b110100110)
                arg1
                (fp #b0 #b01111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b000000000)
                arg1
                (fp #b0 #b10000100000 #b000101101)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01110000100 #b111001000)
                arg2
                (fp #b1 #b00000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000001)
                arg2
                (fp #b0 #b11001100110 #b000010111)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10010101010 #b010111001)
                expect
                (fp #b0 #b01111111111 #b000000001)))
(assert (fp.leq (fp #b0 #b01111111111 #b000000001)
                expect
                (fp #b0 #b10110001100 #b000000011)))

(assert (= expect result))

(check-sat)
(exit)
