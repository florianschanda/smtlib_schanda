(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b101111100010 #b1010)
                arg1
                (fp #b1 #b000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000)
                arg1
                (fp #b0 #b001001000111 #b0111)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b010111000101 #b0000)
                arg2
                (fp #b0 #b100000000001 #b1000)))
(assert (fp.leq (fp #b0 #b100000000001 #b1000)
                arg2
                (fp #b0 #b111011101010 #b0011)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110111100111 #b0100)
                expect
                (fp #b1 #b100000000001 #b1000)))
(assert (fp.leq (fp #b1 #b100000000001 #b1000)
                expect
                (fp #b0 #b111101011111 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
