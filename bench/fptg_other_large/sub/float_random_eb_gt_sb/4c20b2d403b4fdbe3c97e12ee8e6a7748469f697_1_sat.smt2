(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b000110111000 #b011)
                arg2
                (fp #b0 #b001111111110 #b011)))
(assert (fp.leq (fp #b0 #b001111111110 #b011)
                arg2
                (fp #b0 #b110111110000 #b000)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
