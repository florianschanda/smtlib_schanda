(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10100111111111 #b11011)
                arg1
                (fp #b0 #b01000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b00000)
                arg1
                (fp #b0 #b11010111100100 #b11101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00101011011111 #b11011)
                arg2
                (fp #b0 #b00000000000000 #b11111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b11111)
                arg2
                (fp #b0 #b11101100111111 #b00010)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11011110011100 #b00000)
                expect
                (fp #b0 #b01000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b00000)
                expect
                (fp #b0 #b01100101011000 #b10000)))

(assert (= expect result))

(check-sat)
(exit)
