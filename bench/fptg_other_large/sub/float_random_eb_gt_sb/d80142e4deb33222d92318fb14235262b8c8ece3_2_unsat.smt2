(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101010000010 #b101001011)
                arg1
                (fp #b0 #b111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b000000000)
                arg1
                (fp #b0 #b111111111101 #b111001111)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b0 #b000010110000 #b011001110)
                arg2
                (fp #b0 #b100000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b100000001001 #b000000000)
                arg2
                (fp #b0 #b101011111011 #b111011100)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111000110111 #b010100101)
                expect
                (fp #b0 #b111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b000000000)
                expect
                (fp #b0 #b111111111101 #b101110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
