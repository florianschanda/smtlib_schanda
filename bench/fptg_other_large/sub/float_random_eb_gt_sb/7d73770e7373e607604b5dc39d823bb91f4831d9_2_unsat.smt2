; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1010111010 #b001010)
                arg1
                (fp #b1 #b1000000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000)
                arg1
                (fp #b0 #b0110010101 #b011010)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0100110000 #b010111)
                arg2
                (fp #b0 #b1111111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111)
                arg2
                (fp #b0 #b1111111111 #b000000)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
