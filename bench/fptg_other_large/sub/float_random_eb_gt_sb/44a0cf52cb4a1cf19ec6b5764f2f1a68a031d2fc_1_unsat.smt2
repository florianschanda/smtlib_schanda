(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010010110 #b0001)
                arg1
                (fp #b1 #b000000000 #b1000)))
(assert (fp.leq (fp #b1 #b000000000 #b1000)
                arg1
                (fp #b0 #b101101000 #b1010)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101011010 #b1110)
                arg2
                (fp #b1 #b101011000 #b1100)))
(assert (fp.leq (fp #b1 #b101011000 #b1100)
                arg2
                (fp #b0 #b101010100 #b1100)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b100000111 #b1011)
                expect
                (fp #b0 #b101011000 #b1011)))
(assert (fp.leq (fp #b0 #b101011000 #b1011)
                expect
                (fp #b0 #b110110011 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
