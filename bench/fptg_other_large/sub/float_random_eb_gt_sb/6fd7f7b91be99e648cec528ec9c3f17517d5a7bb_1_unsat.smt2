; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b01001001010110111 #b0100)
                arg1
                (fp #b0 #b10100100010111011 #b1101)))
(assert (fp.leq (fp #b0 #b10100100010111011 #b1101)
                arg1
                (fp #b0 #b10110101100111000 #b1100)))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b10100110001001000 #b0001)
                arg2
                (fp #b0 #b11111101110110010 #b0001)))
(assert (fp.leq (fp #b0 #b11111101110110010 #b0001)
                arg2
                (fp #b0 #b11111111010101000 #b0011)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11111110011000001 #b0111)
                expect
                (fp #b1 #b11111101110110010 #b0000)))
(assert (fp.leq (fp #b1 #b11111101110110010 #b0000)
                expect
                (fp #b0 #b11100110000010111 #b0100)))

(assert (not (= expect result)))

(check-sat)
(exit)
