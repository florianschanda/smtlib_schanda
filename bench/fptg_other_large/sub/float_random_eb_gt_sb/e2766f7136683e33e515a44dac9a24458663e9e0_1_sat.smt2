(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1000100000011010 #b11111)
                arg1
                (fp #b1 #b0111111111111111 #b00000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b00000)
                arg1
                (fp #b0 #b0100101000010111 #b10011)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1110101000000000 #b11101)
                arg2
                (fp #b0 #b0011010101100111 #b00000)))
(assert (fp.leq (fp #b0 #b0011010101100111 #b00000)
                arg2
                (fp #b0 #b1000011010111000 #b01000)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1011000010100011 #b01101)
                expect
                (fp #b1 #b0111111111111111 #b00000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b00000)
                expect
                (fp #b0 #b1011111101011011 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
