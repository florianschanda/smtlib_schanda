(assert (fp.leq (fp #b0 #b1011111111110 #b11111111111)
                arg2
                (fp #b0 #b1111100111110 #b01011001110)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1101000100001 #b10111011100)
                expect
                (fp #b1 #b1011111111110 #b11111111110)))
(assert (fp.leq (fp #b1 #b1011111111110 #b11111111110)
                expect
                (fp #b1 #b0010000111011 #b01000100110)))

(assert (not (= expect result)))

(check-sat)
