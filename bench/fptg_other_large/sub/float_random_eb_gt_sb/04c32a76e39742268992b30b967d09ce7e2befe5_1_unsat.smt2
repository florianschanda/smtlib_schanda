(assert (fp.leq (fp #b1 #b01011101110 #b11110)
                expect
                (fp #b0 #b00000000000 #b01001)))
(assert (fp.leq (fp #b0 #b00000000000 #b01001)
                expect
                (fp #b0 #b10000110000 #b01111)))

(assert (not (= expect result)))

