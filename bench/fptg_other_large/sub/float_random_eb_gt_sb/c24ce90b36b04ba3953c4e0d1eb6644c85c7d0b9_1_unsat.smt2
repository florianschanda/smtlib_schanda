; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11101001010101 #b1001010101)
                arg1
                (fp #b1 #b11010101001111 #b0000010000)))
(assert (fp.leq (fp #b1 #b11010101001111 #b0000010000)
                arg1
                (fp #b0 #b11100111011010 #b0011000010)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11111111111110 #b0010110001)
                arg2
                (fp #b1 #b11111111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000)
                arg2
                (fp #b1 #b11010011101110 #b0110100010)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b0 #b00111000010011 #b0001111110)
                expect
                (fp #b0 #b11111111111100 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111111100 #b1111111111)
                expect
                (fp #b0 #b11111111111110 #b1101001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
