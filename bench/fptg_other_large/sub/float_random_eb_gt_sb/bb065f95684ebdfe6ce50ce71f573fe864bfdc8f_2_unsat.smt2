(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0010001111100011 #b01000)
                arg1
                (fp #b0 #b0000000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00001)
                arg1
                (fp #b0 #b0001111111100100 #b11011)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1010100000111111 #b01110)
                arg2
                (fp #b1 #b0111111111111111 #b00000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b00000)
                arg2
                (fp #b0 #b1110010010001100 #b10001)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0001011101000011 #b11010)
                expect
                (fp #b0 #b0111111111111111 #b00001)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b00001)
                expect
                (fp #b0 #b1101001101100100 #b01011)))

(assert (not (= expect result)))

(check-sat)
(exit)
