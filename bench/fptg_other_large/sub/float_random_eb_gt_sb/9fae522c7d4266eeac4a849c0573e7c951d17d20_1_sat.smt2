(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011111000 #b00)
                arg1
                (fp #b0 #b001111111 #b00)))
(assert (fp.leq (fp #b0 #b001111111 #b00)
                arg1
                (fp #b0 #b010001000 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b000111010 #b00)
                arg2
                (fp #b1 #b000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000 #b00)
                arg2
                (fp #b0 #b100010000 #b11)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111001010 #b01)
                expect
                (fp #b0 #b001111111 #b00)))
(assert (fp.leq (fp #b0 #b001111111 #b00)
                expect
                (fp #b0 #b101011001 #b01)))

(assert (= expect result))

(check-sat)
(exit)
