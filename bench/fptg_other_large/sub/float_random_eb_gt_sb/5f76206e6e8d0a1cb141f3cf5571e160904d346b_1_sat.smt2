(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b011011011001 #b1001000000)
                arg1
                (fp #b0 #b011111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b011111111111 #b1001100100)
                arg1
                (fp #b0 #b100000101010 #b0100111011)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101001000110 #b0111000011)
                arg2
                (fp #b1 #b011111111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b011111111111 #b0000100111)
                arg2
                (fp #b1 #b011100101011 #b1100010011)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b011000100001 #b0011111110)
                expect
                (fp #b0 #b100000000000 #b0101000101)))
(assert (fp.leq (fp #b0 #b100000000000 #b0101000101)
                expect
                (fp #b0 #b111011011010 #b0001110100)))

(assert (= expect result))

(check-sat)
(exit)
