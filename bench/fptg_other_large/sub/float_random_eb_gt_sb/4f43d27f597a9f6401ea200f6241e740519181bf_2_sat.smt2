(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10100110111011100 #b110)
                arg1
                (fp #b0 #b01110110100010001 #b001)))
(assert (fp.leq (fp #b0 #b01110110100010001 #b001)
                arg1
                (fp #b0 #b01111100001110010 #b100)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b00111110110010001 #b111)
                arg2
                (fp #b0 #b01111111111111111 #b000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b000)
                arg2
                (fp #b0 #b10011000001101111 #b100)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11010010100011000 #b001)
                expect
                (fp #b1 #b01111111111111111 #b000)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b000)
                expect
                (fp #b0 #b00010100011010000 #b011)))

(assert (= expect result))

(check-sat)
(exit)
