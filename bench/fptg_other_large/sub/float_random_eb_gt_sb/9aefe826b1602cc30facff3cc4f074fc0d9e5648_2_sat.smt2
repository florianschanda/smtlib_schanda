; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b110101010000100011 #b0110000)
                arg1
                (fp #b1 #b010000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b010000000000000000 #b0000000)
                arg1
                (fp #b0 #b000101111100010101 #b1001100)))

(declare-const arg2 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b100000000110101000 #b1110001)
                arg2
                (fp #b1 #b011111111111111111 #b0001101)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b0001101)
                arg2
                (fp #b0 #b101010111101101101 #b1010000)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b001100110000111011 #b0100001)
                expect
                (fp #b0 #b011111111111111111 #b0001101)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b0001101)
                expect
                (fp #b0 #b110111000100110110 #b1111000)))

(assert (= expect result))

(check-sat)
(exit)
