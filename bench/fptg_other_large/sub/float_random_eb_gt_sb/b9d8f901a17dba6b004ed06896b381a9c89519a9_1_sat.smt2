(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0010001001 #b010)
                arg1
                (fp #b0 #b0100000000 #b000)))
(assert (fp.leq (fp #b0 #b0100000000 #b000)
                arg1
                (fp #b0 #b0110010011 #b010)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100011000 #b100)
                arg2
                (fp #b0 #b0000000000 #b011)))
(assert (fp.leq (fp #b0 #b0000000000 #b011)
                arg2
                (fp #b0 #b0111110010 #b011)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000111001 #b001)
                expect
                (fp #b0 #b0011111111 #b111)))
(assert (fp.leq (fp #b0 #b0011111111 #b111)
                expect
                (fp #b0 #b1110011011 #b100)))

(assert (= expect result))

(check-sat)
(exit)
