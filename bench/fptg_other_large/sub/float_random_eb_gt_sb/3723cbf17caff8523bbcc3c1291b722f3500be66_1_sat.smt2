(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001111001 #b0010)
                arg1
                (fp #b1 #b000000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000000 #b0100)
                arg1
                (fp #b0 #b110010011 #b1000)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b001111110 #b1101)
                arg2
                (fp #b0 #b111011110 #b1000)))
(assert (fp.leq (fp #b0 #b111011110 #b1000)
                arg2
                (fp #b0 #b111111011 #b0111)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111100110 #b0101)
                expect
                (fp #b1 #b111011110 #b1000)))
(assert (fp.leq (fp #b1 #b111011110 #b1000)
                expect
                (fp #b1 #b010111000 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
