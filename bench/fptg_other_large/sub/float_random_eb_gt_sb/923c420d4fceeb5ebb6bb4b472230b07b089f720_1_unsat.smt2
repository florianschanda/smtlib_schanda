(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101110011001 #b10)
                arg1
                (fp #b1 #b101010111010 #b11)))
(assert (fp.leq (fp #b1 #b101010111010 #b11)
                arg1
                (fp #b0 #b000100110111 #b11)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000011111000 #b00)
                arg2
                (fp #b0 #b100000000001 #b10)))
(assert (fp.leq (fp #b0 #b100000000001 #b10)
                arg2
                (fp #b0 #b100110101101 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101101101001 #b00)
                expect
                (fp #b1 #b101010111010 #b11)))
(assert (fp.leq (fp #b1 #b101010111010 #b11)
                expect
                (fp #b1 #b010001110110 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
