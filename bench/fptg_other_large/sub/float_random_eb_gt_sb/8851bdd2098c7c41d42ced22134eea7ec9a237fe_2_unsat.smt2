(assert (fp.leq (fp #b0 #b111011001 #b011000)
                arg2
                (fp #b0 #b111110100 #b101010)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111011110 #b001001)
                expect
                (fp #b1 #b111011001 #b011000)))
(assert (fp.leq (fp #b1 #b111011001 #b011000)
                expect
                (fp #b1 #b110001001 #b010111)))

(assert (not (= expect result)))

