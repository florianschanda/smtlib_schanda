; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101101011 #b1010)
                arg1
                (fp #b1 #b100000011 #b1110)))
(assert (fp.leq (fp #b1 #b100000011 #b1110)
                arg1
                (fp #b1 #b011100100 #b1111)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101111010 #b1100)
                arg2
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg2
                (fp #b0 #b110101111 #b1000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111100 #b0110)
                expect
                (fp #b1 #b100000011 #b1111)))
(assert (fp.leq (fp #b1 #b100000011 #b1111)
                expect
                (fp #b0 #b111011110 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
