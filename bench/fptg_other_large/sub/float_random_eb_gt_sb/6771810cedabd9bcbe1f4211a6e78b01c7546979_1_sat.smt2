(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1100001111001110 #b10110001)
                arg1
                (fp #b1 #b1000000000000111 #b10110100)))
(assert (fp.leq (fp #b1 #b1000000000000111 #b10110100)
                arg1
                (fp #b0 #b0001010111110000 #b10001001)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1010100001001000 #b00111011)
                arg2
                (fp #b1 #b1001110111011111 #b10000011)))
(assert (fp.leq (fp #b1 #b1001110111011111 #b10000011)
                arg2
                (fp #b0 #b0011111000101100 #b00010101)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0000001111101111 #b00110101)
                expect
                (fp #b0 #b1001110111011111 #b10000010)))
(assert (fp.leq (fp #b0 #b1001110111011111 #b10000010)
                expect
                (fp #b0 #b1101101101110001 #b00110100)))

(assert (= expect result))

(check-sat)
(exit)
