(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11001011010111 #b1001)
                arg1
                (fp #b1 #b00000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100)
                arg1
                (fp #b0 #b10011100110011 #b0101)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111111111110 #b0011)
                arg2
                (fp #b1 #b11111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000)
                arg2
                (fp #b1 #b10100010000010 #b1000)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01110000101011 #b0111)
                expect
                (fp #b0 #b11111111111101 #b0000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000)
                expect
                (fp #b0 #b11111111111110 #b1010)))

(assert (not (= expect result)))

(check-sat)
(exit)
