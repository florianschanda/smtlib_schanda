(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11111100010 #b000100)
                arg1
                (fp #b1 #b10110110010 #b011101)))
(assert (fp.leq (fp #b1 #b10110110010 #b011101)
                arg1
                (fp #b0 #b10010010001 #b010010)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b00010001010 #b011100)
                arg2
                (fp #b1 #b00000000001 #b000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b000000)
                arg2
                (fp #b0 #b10001100101 #b010011)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11011101100 #b010111)
                expect
                (fp #b1 #b10110110010 #b011100)))
(assert (fp.leq (fp #b1 #b10110110010 #b011100)
                expect
                (fp #b1 #b10000001111 #b000001)))

(assert (= expect result))

(check-sat)
(exit)
