(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0010100011001010 #b0)
                arg1
                (fp #b0 #b0111111111111111 #b0)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b0)
                arg1
                (fp #b0 #b1001101111001110 #b0)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0101100000010010 #b1)
                arg2
                (fp #b0 #b0000000000000001 #b0)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b0)
                arg2
                (fp #b0 #b1001010011101110 #b0)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0100000011001000 #b1)
                expect
                (fp #b0 #b0111111111111110 #b1)))
(assert (fp.leq (fp #b0 #b0111111111111110 #b1)
                expect
                (fp #b0 #b1110011001011001 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
