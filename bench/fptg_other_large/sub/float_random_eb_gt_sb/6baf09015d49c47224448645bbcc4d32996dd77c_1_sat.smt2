(assert (fp.leq (fp #b1 #b1000000000000 #b100000)
                arg2
                (fp #b0 #b1001000111000 #b111100)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b0 #b0011110110001 #b010011)
                expect
                (fp #b0 #b1000000000000 #b011111)))
(assert (fp.leq (fp #b0 #b1000000000000 #b011111)
                expect
                (fp #b0 #b1011110101100 #b101110)))

(assert (= expect result))

(check-sat)
