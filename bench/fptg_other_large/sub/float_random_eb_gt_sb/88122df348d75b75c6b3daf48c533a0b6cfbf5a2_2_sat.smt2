; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10101111100001 #b10010111)
                arg1
                (fp #b0 #b10000000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b10000000000010 #b00100000)
                arg1
                (fp #b0 #b11011011011100 #b10101100)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b01100000101110 #b10010000)
                arg2
                (fp #b0 #b00000000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b11111111)
                arg2
                (fp #b0 #b00101100011110 #b11011010)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b0 #b01100111110000 #b01011111)
                expect
                (fp #b0 #b10000000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b10000000000010 #b00100000)
                expect
                (fp #b0 #b11110000001110 #b11001011)))

(assert (= expect result))

(check-sat)
(exit)
