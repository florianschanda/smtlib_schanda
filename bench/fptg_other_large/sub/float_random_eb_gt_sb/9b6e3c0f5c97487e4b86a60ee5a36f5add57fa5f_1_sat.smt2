(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01010000000000101 #b1001000)
                arg1
                (fp #b1 #b00000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0000000)
                arg1
                (fp #b0 #b11010010101011111 #b0111111)))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b11000101011010010 #b1101100)
                arg2
                (fp #b1 #b00000000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000000001 #b0000000)
                arg2
                (fp #b0 #b11010000101001011 #b1001110)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b00111001100111011 #b1110101)
                expect
                (fp #b0 #b00000000000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000000001 #b0000000)
                expect
                (fp #b0 #b10010001010101110 #b0001110)))

(assert (= expect result))

(check-sat)
(exit)
