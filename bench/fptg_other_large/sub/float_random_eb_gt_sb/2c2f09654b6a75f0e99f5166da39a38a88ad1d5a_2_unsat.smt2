(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001110010 #b01110)
                arg1
                (fp #b1 #b0111111111 #b10100)))
(assert (fp.leq (fp #b1 #b0111111111 #b10100)
                arg1
                (fp #b0 #b0101001010 #b11111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0010111111 #b01000)
                arg2
                (fp #b0 #b1000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000101 #b00000)
                arg2
                (fp #b0 #b1101111101 #b00101)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111001110 #b01100)
                expect
                (fp #b1 #b1000000101 #b00001)))
(assert (fp.leq (fp #b1 #b1000000101 #b00001)
                expect
                (fp #b0 #b0100001111 #b01001)))

(assert (not (= expect result)))

(check-sat)
(exit)
