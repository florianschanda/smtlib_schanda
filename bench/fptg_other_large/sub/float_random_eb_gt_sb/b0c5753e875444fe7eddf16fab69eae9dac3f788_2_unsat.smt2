(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01011010111 #b0000)
                arg1
                (fp #b1 #b01000000000 #b0000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000)
                arg1
                (fp #b0 #b01001000100 #b0100)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00110100110 #b0100)
                arg2
                (fp #b0 #b10000000011 #b0001)))
(assert (fp.leq (fp #b0 #b10000000011 #b0001)
                arg2
                (fp #b0 #b11001100000 #b1001)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000011011 #b0001)
                expect
                (fp #b1 #b10000000011 #b0010)))
(assert (fp.leq (fp #b1 #b10000000011 #b0010)
                expect
                (fp #b1 #b00011110001 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
