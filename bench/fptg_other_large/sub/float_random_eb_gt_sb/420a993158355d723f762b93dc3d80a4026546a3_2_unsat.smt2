(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0101001010 #b10101)
                arg1
                (fp #b1 #b0000000000 #b00001)))
(assert (fp.leq (fp #b1 #b0000000000 #b00001)
                arg1
                (fp #b0 #b1101010111 #b11010)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011101010 #b11010)
                arg2
                (fp #b1 #b0010011100 #b00011)))
(assert (fp.leq (fp #b1 #b0010011100 #b00011)
                arg2
                (fp #b0 #b1001010000 #b00100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101101010 #b01001)
                expect
                (fp #b0 #b0010011100 #b00011)))
(assert (fp.leq (fp #b0 #b0010011100 #b00011)
                expect
                (fp #b0 #b1010110000 #b00010)))

(assert (not (= expect result)))

(check-sat)
(exit)
