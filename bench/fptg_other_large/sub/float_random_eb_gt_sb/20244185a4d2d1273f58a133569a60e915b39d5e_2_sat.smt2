(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011111110011 #b1101)
                arg1
                (fp #b0 #b100000000011 #b0110)))
(assert (fp.leq (fp #b0 #b100000000011 #b0110)
                arg1
                (fp #b0 #b110100010000 #b0110)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110101010000 #b1011)
                arg2
                (fp #b1 #b011111111111 #b0110)))
(assert (fp.leq (fp #b1 #b011111111111 #b0110)
                arg2
                (fp #b1 #b000101110110 #b0001)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b001101010001 #b1010)
                expect
                (fp #b0 #b100000000011 #b1000)))
(assert (fp.leq (fp #b0 #b100000000011 #b1000)
                expect
                (fp #b0 #b101101011010 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
