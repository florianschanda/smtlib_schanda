(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b0 #b010100011010001010 #b1000111)
                arg1
                (fp #b0 #b100000000000000011 #b1110000)))
(assert (fp.leq (fp #b0 #b100000000000000011 #b1110000)
                arg1
                (fp #b0 #b110111011111111010 #b0001010)))

(declare-const arg2 (_ FloatingPoint 18 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001111111001010001 #b0010101)
                expect
                (fp #b0 #b000000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0000000)
                expect
                (fp #b0 #b111000010000101111 #b1010010)))

(assert (= expect result))

(check-sat)
(exit)
