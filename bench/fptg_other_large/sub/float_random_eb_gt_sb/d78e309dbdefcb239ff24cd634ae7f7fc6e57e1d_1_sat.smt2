(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0100010110 #b0)
                arg1
                (fp #b0 #b0100000000 #b0)))
(assert (fp.leq (fp #b0 #b0100000000 #b0)
                arg1
                (fp #b0 #b1101001000 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101110011 #b0)
                arg2
                (fp #b0 #b0111111111 #b1)))
(assert (fp.leq (fp #b0 #b0111111111 #b1)
                arg2
                (fp #b0 #b1011001001 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1111100111 #b0)
                expect
                (fp #b1 #b0111111111 #b0)))
(assert (fp.leq (fp #b1 #b0111111111 #b0)
                expect
                (fp #b0 #b1101011000 #b0)))

(assert (= expect result))

(check-sat)
(exit)
