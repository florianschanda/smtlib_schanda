(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01000101000001 #b011)
                arg1
                (fp #b0 #b01010110000011 #b010)))
(assert (fp.leq (fp #b0 #b01010110000011 #b010)
                arg1
                (fp #b0 #b10001110101010 #b011)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b01101011010011 #b101)
                arg2
                (fp #b0 #b10000000000011 #b000)))
(assert (fp.leq (fp #b0 #b10000000000011 #b000)
                arg2
                (fp #b0 #b11010110111000 #b011)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10000000010110 #b100)
                expect
                (fp #b1 #b10000000000010 #b111)))
(assert (fp.leq (fp #b1 #b10000000000010 #b111)
                expect
                (fp #b1 #b01011000011001 #b000)))

(assert (= expect result))

(check-sat)
(exit)
