(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011110011 #b0011)
                arg1
                (fp #b0 #b0111100111 #b1100)))
(assert (fp.leq (fp #b0 #b0111100111 #b1100)
                arg1
                (fp #b0 #b1100111011 #b1111)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1000100000 #b0111)
                arg2
                (fp #b1 #b1000000011 #b0001)))
(assert (fp.leq (fp #b1 #b1000000011 #b0001)
                arg2
                (fp #b1 #b0000001010 #b0011)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101000001 #b0010)
                expect
                (fp #b0 #b1000000011 #b0010)))
(assert (fp.leq (fp #b0 #b1000000011 #b0010)
                expect
                (fp #b0 #b1000001010 #b0101)))

(assert (not (= expect result)))

(check-sat)
(exit)
