;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01011110010 #b1100001)
                arg1
                (fp #b0 #b01101111001 #b1110110)))
(assert (fp.leq (fp #b0 #b01101111001 #b1110110)
                arg1
                (fp #b0 #b10001011101 #b0010001)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01101001111 #b0111001)
                arg2
                (fp #b0 #b00000000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111)
                arg2
                (fp #b0 #b01010000010 #b1101010)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00000001011 #b0001101)
                expect
                (fp #b0 #b01101111001 #b1110110)))
(assert (fp.leq (fp #b0 #b01101111001 #b1110110)
                expect
                (fp #b0 #b11111011011 #b0110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
