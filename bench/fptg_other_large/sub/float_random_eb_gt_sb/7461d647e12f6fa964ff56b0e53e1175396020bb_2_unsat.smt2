(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01001011001001 #b001)
                arg1
                (fp #b0 #b01010110000011 #b010)))
(assert (fp.leq (fp #b0 #b01010110000011 #b010)
                arg1
                (fp #b0 #b10010101101100 #b100)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111010110 #b111)
                arg2
                (fp #b1 #b11010001111111 #b011)))
(assert (fp.leq (fp #b1 #b11010001111111 #b011)
                arg2
                (fp #b1 #b10111000011111 #b000)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b01011100100000 #b111)
                expect
                (fp #b0 #b11010001111111 #b100)))
(assert (fp.leq (fp #b0 #b11010001111111 #b100)
                expect
                (fp #b0 #b11110011111011 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
