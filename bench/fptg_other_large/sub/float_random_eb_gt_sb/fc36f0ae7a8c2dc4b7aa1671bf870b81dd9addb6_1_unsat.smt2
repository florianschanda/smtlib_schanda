(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b01001110010000 #b11)
                arg1
                (fp #b0 #b01111111111111 #b01)))
(assert (fp.leq (fp #b0 #b01111111111111 #b01)
                arg1
                (fp #b0 #b11001101111000 #b00)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11011011111000 #b10)
                arg2
                (fp #b1 #b10000000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000000010 #b00)
                arg2
                (fp #b0 #b11011111111001 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b01101001111010 #b01)
                expect
                (fp #b0 #b10000000000010 #b00)))
(assert (fp.leq (fp #b0 #b10000000000010 #b00)
                expect
                (fp #b0 #b11100011010001 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
