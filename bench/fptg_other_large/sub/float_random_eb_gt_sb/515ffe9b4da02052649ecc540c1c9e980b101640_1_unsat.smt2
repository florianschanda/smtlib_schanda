(assert (fp.leq (fp #b0 #b011000010010011 #b11101010101)
                arg2
                (fp #b0 #b100111111010111 #b10110111011)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b101011011111000 #b11100000000)
                expect
                (fp #b1 #b011000010010011 #b11101010100)))
(assert (fp.leq (fp #b1 #b011000010010011 #b11101010100)
                expect
                (fp #b0 #b000100000011111 #b00110001100)))

(assert (not (= expect result)))

(check-sat)
