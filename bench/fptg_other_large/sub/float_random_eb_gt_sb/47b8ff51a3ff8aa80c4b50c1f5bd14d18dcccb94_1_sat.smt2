(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01101111000 #b01111100)
                arg1
                (fp #b0 #b00000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b01000000)
                arg1
                (fp #b0 #b11100000100 #b01010101)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00111011001 #b01100000)
                arg2
                (fp #b0 #b00111111100 #b00000000)))
(assert (fp.leq (fp #b0 #b00111111100 #b00000000)
                arg2
                (fp #b0 #b10101111111 #b00000001)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11110101011 #b11110011)
                expect
                (fp #b1 #b00111111011 #b11111111)))
(assert (fp.leq (fp #b1 #b00111111011 #b11111111)
                expect
                (fp #b0 #b00110111100 #b10001101)))

(assert (= expect result))

(check-sat)
(exit)
