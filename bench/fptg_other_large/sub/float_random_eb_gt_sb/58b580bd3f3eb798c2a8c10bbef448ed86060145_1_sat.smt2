(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111111111101 #b01011)
                arg1
                (fp #b1 #b11111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b00000)
                arg1
                (fp #b0 #b10110001001110 #b00100)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01110001100111 #b11000)
                arg2
                (fp #b0 #b10111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b11111)
                arg2
                (fp #b0 #b11111100110000 #b01000)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111111111101 #b01101)
                expect
                (fp #b1 #b11111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b00000)
                expect
                (fp #b1 #b11000011100011 #b01001)))

(assert (= expect result))

(check-sat)
(exit)
