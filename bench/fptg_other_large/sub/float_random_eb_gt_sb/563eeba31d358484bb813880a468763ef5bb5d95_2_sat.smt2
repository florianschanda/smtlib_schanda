(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b101010000111 #b1011010)
                arg1
                (fp #b1 #b011111111111 #b0100111)))
(assert (fp.leq (fp #b1 #b011111111111 #b0100111)
                arg1
                (fp #b0 #b111010000000 #b1000111)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b010101111100 #b1100111)
                arg2
                (fp #b1 #b000000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000011)
                arg2
                (fp #b0 #b000010111111 #b0011010)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110101010010 #b0110101)
                expect
                (fp #b1 #b011111111111 #b0100111)))
(assert (fp.leq (fp #b1 #b011111111111 #b0100111)
                expect
                (fp #b1 #b010011100010 #b0000001)))

(assert (= expect result))

(check-sat)
(exit)
