(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b000110011100000010 #b00110011)
                arg1
                (fp #b0 #b001111111111111100 #b00000000)))
(assert (fp.leq (fp #b0 #b001111111111111100 #b00000000)
                arg1
                (fp #b0 #b101101100001100101 #b00101010)))

(declare-const arg2 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b110010110011011010 #b00000111)
                arg2
                (fp #b1 #b011111001101100100 #b10110000)))
(assert (fp.leq (fp #b1 #b011111001101100100 #b10110000)
                arg2
                (fp #b1 #b010000111100110010 #b00111101)))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b001110001010100000 #b01011010)
                expect
                (fp #b0 #b011111001101100100 #b10110000)))
(assert (fp.leq (fp #b0 #b011111001101100100 #b10110000)
                expect
                (fp #b0 #b111110101101001101 #b00001010)))

(assert (= expect result))

(check-sat)
(exit)
