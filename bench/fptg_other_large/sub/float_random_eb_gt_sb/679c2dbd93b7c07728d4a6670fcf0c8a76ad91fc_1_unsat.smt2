(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00111110001000 #b100)
                arg1
                (fp #b1 #b00000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b001)
                arg1
                (fp #b0 #b01111110011101 #b010)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b01001100100100 #b011)
                arg2
                (fp #b0 #b11000110000010 #b111)))
(assert (fp.leq (fp #b0 #b11000110000010 #b111)
                arg2
                (fp #b0 #b11100110100101 #b101)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11101011010011 #b001)
                expect
                (fp #b1 #b11000110000010 #b111)))
(assert (fp.leq (fp #b1 #b11000110000010 #b111)
                expect
                (fp #b0 #b11001011110110 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
