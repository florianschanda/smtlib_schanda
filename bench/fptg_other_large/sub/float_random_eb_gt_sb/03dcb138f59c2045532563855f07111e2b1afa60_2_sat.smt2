(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0100000010011011 #b01000)
                arg1
                (fp #b0 #b0000000001000110 #b01000)))
(assert (fp.leq (fp #b0 #b0000000001000110 #b01000)
                arg1
                (fp #b0 #b1011001001000011 #b01100)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0011110001100010 #b11000)
                arg2
                (fp #b0 #b0000000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00001)
                arg2
                (fp #b0 #b1001011110101011 #b00100)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1010111010101111 #b11101)
                expect
                (fp #b0 #b0000000001000110 #b01000)))
(assert (fp.leq (fp #b0 #b0000000001000110 #b01000)
                expect
                (fp #b0 #b0110100101001111 #b01110)))

(assert (= expect result))

(check-sat)
(exit)
