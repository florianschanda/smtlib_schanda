(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b000110000 #b111)
                arg1
                (fp #b0 #b101100000 #b010)))
(assert (fp.leq (fp #b0 #b101100000 #b010)
                arg1
                (fp #b0 #b111000000 #b000)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000110100 #b001)
                arg2
                (fp #b0 #b100000000 #b100)))
(assert (fp.leq (fp #b0 #b100000000 #b100)
                arg2
                (fp #b0 #b110001100 #b100)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b000011000 #b000)
                expect
                (fp #b0 #b101100000 #b001)))
(assert (fp.leq (fp #b0 #b101100000 #b001)
                expect
                (fp #b0 #b110000110 #b101)))

(assert (= expect result))

(check-sat)
(exit)
