(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11011011001 #b00100000)
                arg1
                (fp #b0 #b01111111111 #b00010011)))
(assert (fp.leq (fp #b0 #b01111111111 #b00010011)
                arg1
                (fp #b0 #b10111001011 #b11010111)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01110001001 #b00101010)
                arg2
                (fp #b1 #b00000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b00000000000 #b01111101)
                arg2
                (fp #b0 #b00111001000 #b01000100)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11000001111 #b10011110)
                expect
                (fp #b0 #b01111111111 #b00010011)))
(assert (fp.leq (fp #b0 #b01111111111 #b00010011)
                expect
                (fp #b0 #b11111000010 #b01000010)))

(assert (= expect result))

(check-sat)
(exit)
