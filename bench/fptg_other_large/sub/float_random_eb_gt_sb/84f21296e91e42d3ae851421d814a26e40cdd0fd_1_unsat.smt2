(assert (fp.leq (fp #b0 #b1000000000111 #b0000000)
                arg2
                (fp #b0 #b1111110110111 #b1011101)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1010010001010 #b0011100)
                expect
                (fp #b1 #b1000000000110 #b1111111)))
(assert (fp.leq (fp #b1 #b1000000000110 #b1111111)
                expect
                (fp #b0 #b1111010001111 #b1010001)))

(assert (not (= expect result)))

(check-sat)
