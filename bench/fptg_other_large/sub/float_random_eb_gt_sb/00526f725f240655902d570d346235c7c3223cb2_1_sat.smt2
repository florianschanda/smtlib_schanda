(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0111111100010011 #b111011111)
                arg1
                (fp #b0 #b0100001001110101 #b101001110)))
(assert (fp.leq (fp #b0 #b0100001001110101 #b101001110)
                arg1
                (fp #b0 #b1111101110011010 #b110010001)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1011000101000111 #b001101011)
                arg2
                (fp #b1 #b0000000000000001 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b000000000)
                arg2
                (fp #b0 #b0000100111010110 #b011001100)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0011110110100101 #b110100111)
                expect
                (fp #b0 #b0100001001110101 #b101001110)))
(assert (fp.leq (fp #b0 #b0100001001110101 #b101001110)
                expect
                (fp #b0 #b1011010110010010 #b000000100)))

(assert (= expect result))

(check-sat)
(exit)
