; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b110100111100000 #b011110000)
                arg1
                (fp #b1 #b100000000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b100000000001000 #b011100001)
                arg1
                (fp #b1 #b010011100101010 #b001101110)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b101110001110000 #b000101010)
                arg2
                (fp #b1 #b100100010100111 #b100011111)))
(assert (fp.leq (fp #b1 #b100100010100111 #b100011111)
                arg2
                (fp #b1 #b011111001111111 #b000101011)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b0 #b000000100100110 #b011101111)
                expect
                (fp #b0 #b100100010100111 #b100011111)))
(assert (fp.leq (fp #b0 #b100100010100111 #b100011111)
                expect
                (fp #b0 #b110010001000101 #b110110101)))

(assert (= expect result))

(check-sat)
(exit)
