(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00110001100 #b1000011)
                arg1
                (fp #b0 #b00000000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111)
                arg1
                (fp #b0 #b10000001111 #b0001101)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10100110101 #b0110110)
                arg2
                (fp #b1 #b10000000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000000101 #b1100000)
                arg2
                (fp #b0 #b10101010011 #b0100000)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b00001101111 #b1101101)
                expect
                (fp #b0 #b10000000101 #b1100001)))
(assert (fp.leq (fp #b0 #b10000000101 #b1100001)
                expect
                (fp #b0 #b11000101000 #b0110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
