(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b01010010010001 #b1110110)
                arg1
                (fp #b0 #b11100100110000 #b0100011)))
(assert (fp.leq (fp #b0 #b11100100110000 #b0100011)
                arg1
                (fp #b0 #b11111011010110 #b0010101)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10000000111011 #b1010010)
                arg2
                (fp #b1 #b01110111011010 #b1011101)))
(assert (fp.leq (fp #b1 #b01110111011010 #b1011101)
                arg2
                (fp #b0 #b10101000111110 #b1101101)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b00100100001100 #b1110000)
                expect
                (fp #b0 #b11100100110000 #b0100100)))
(assert (fp.leq (fp #b0 #b11100100110000 #b0100100)
                expect
                (fp #b0 #b11111110111110 #b1011111)))

(assert (= expect result))

(check-sat)
(exit)
