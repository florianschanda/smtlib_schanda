(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001101111011 #b10001001)
                arg1
                (fp #b0 #b000000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b000000000000 #b01010111)
                arg1
                (fp #b0 #b011101000111 #b00101110)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b010111100010 #b00100110)
                arg2
                (fp #b0 #b101111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b11111111)
                arg2
                (fp #b0 #b110110000100 #b00000001)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111111111101 #b00001100)
                expect
                (fp #b1 #b101111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b11111111)
                expect
                (fp #b0 #b010011001010 #b00000110)))

(assert (= expect result))

(check-sat)
(exit)
