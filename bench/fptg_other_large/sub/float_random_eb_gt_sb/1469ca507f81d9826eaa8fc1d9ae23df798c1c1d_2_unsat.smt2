(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100100000001101 #b110)
                arg1
                (fp #b1 #b000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000000 #b010)
                arg1
                (fp #b0 #b100111100111001 #b100)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110111110101100 #b000)
                arg2
                (fp #b1 #b011111111111111 #b000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b000)
                arg2
                (fp #b0 #b000001000001110 #b011)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b010100000110110 #b001)
                expect
                (fp #b0 #b011111111111111 #b000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b000)
                expect
                (fp #b0 #b110011000011101 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
