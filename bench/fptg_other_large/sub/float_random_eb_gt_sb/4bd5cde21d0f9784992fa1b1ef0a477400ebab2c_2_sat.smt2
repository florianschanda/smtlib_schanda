(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b011110111110001 #b10)
                arg1
                (fp #b0 #b101100000101110 #b00)))
(assert (fp.leq (fp #b0 #b101100000101110 #b00)
                arg1
                (fp #b0 #b111100000100111 #b00)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b000111001110011 #b10)
                arg2
                (fp #b1 #b000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01)
                arg2
                (fp #b0 #b110110001010001 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000000001101000 #b10)
                expect
                (fp #b0 #b101100000101110 #b01)))
(assert (fp.leq (fp #b0 #b101100000101110 #b01)
                expect
                (fp #b0 #b110011010001110 #b11)))

(assert (= expect result))

(check-sat)
(exit)
