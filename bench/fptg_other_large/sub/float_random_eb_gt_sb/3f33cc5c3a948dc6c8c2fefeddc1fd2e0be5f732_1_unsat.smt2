(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1011000010100000 #b0011)
                arg1
                (fp #b1 #b0011111111111110 #b0000)))
(assert (fp.leq (fp #b1 #b0011111111111110 #b0000)
                arg1
                (fp #b1 #b0000101101010001 #b0100)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0010101100100100 #b1101)
                arg2
                (fp #b1 #b0000000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0100)
                arg2
                (fp #b0 #b0000101100111011 #b0110)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1000110011110111 #b0011)
                expect
                (fp #b1 #b0011111111111101 #b1111)))
(assert (fp.leq (fp #b1 #b0011111111111101 #b1111)
                expect
                (fp #b1 #b0010110110000011 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
