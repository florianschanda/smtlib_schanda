(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11001101111 #b1)
                arg1
                (fp #b0 #b01001000101 #b1)))
(assert (fp.leq (fp #b0 #b01001000101 #b1)
                arg1
                (fp #b0 #b11100101110 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01000101011 #b1)
                arg2
                (fp #b0 #b01000000000 #b0)))
(assert (fp.leq (fp #b0 #b01000000000 #b0)
                arg2
                (fp #b0 #b10011010000 #b0)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10110011100 #b1)
                expect
                (fp #b0 #b01001000101 #b1)))
(assert (fp.leq (fp #b0 #b01001000101 #b1)
                expect
                (fp #b0 #b11110110010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
