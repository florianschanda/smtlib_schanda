(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1001011001011010 #b1101110)
                arg1
                (fp #b1 #b0000000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b0000000)
                arg1
                (fp #b0 #b1001011100010100 #b0100110)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1010100011110101 #b1100001)
                arg2
                (fp #b1 #b0111111111111111 #b1011000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b1011000)
                arg2
                (fp #b1 #b0011111110110010 #b1101100)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1000110111101110 #b1010101)
                expect
                (fp #b0 #b0111111111111111 #b1010111)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b1010111)
                expect
                (fp #b0 #b1011010010000001 #b1011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
