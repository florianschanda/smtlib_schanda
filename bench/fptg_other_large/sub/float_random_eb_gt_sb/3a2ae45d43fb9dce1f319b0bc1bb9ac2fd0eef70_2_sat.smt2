(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111011000 #b1000011)
                arg1
                (fp #b1 #b1000001011 #b0010110)))
(assert (fp.leq (fp #b1 #b1000001011 #b0010110)
                arg1
                (fp #b0 #b0001010000 #b0011011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010111000 #b0100010)
                arg2
                (fp #b1 #b1000000110 #b1010010)))
(assert (fp.leq (fp #b1 #b1000000110 #b1010010)
                arg2
                (fp #b0 #b0010100000 #b0001100)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111010111 #b1010100)
                expect
                (fp #b1 #b1000001011 #b0010000)))
(assert (fp.leq (fp #b1 #b1000001011 #b0010000)
                expect
                (fp #b1 #b0011101111 #b1001101)))

(assert (= expect result))

(check-sat)
(exit)
