(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0000111001 #b011000)
                arg1
                (fp #b0 #b0101000100 #b100010)))
(assert (fp.leq (fp #b0 #b0101000100 #b100010)
                arg1
                (fp #b0 #b1010110011 #b111111)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111001100 #b000100)
                arg2
                (fp #b1 #b1110000110 #b101111)))
(assert (fp.leq (fp #b1 #b1110000110 #b101111)
                arg2
                (fp #b1 #b1011101111 #b001001)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0110011111 #b001111)
                expect
                (fp #b0 #b1110000110 #b110000)))
(assert (fp.leq (fp #b0 #b1110000110 #b110000)
                expect
                (fp #b0 #b1111100010 #b111001)))

(assert (= expect result))

(check-sat)
(exit)
