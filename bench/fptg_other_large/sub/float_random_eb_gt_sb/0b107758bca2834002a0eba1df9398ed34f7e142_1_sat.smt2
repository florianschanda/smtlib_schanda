(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b101100010 #b1)
                arg1
                (fp #b1 #b001111111 #b1)))
(assert (fp.leq (fp #b1 #b001111111 #b1)
                arg1
                (fp #b0 #b100100101 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111111111 #b0)
                arg2
                (fp #b1 #b111111110 #b0)))
(assert (fp.leq (fp #b1 #b111111110 #b0)
                arg2
                (fp #b1 #b101000111 #b0)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b000010101 #b0)
                expect
                (fp #b0 #b111111101 #b1)))
(assert (fp.leq (fp #b0 #b111111101 #b1)
                expect
                (fp #b0 #b111111111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
