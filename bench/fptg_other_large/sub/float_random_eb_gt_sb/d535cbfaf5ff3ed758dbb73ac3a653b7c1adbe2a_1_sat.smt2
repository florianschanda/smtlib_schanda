; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1011010100110 #b1111)
                arg1
                (fp #b0 #b0000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0000)
                arg1
                (fp #b0 #b1000010111011 #b0110)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1111101110111 #b0000)
                arg2
                (fp #b1 #b1111100111000 #b1110)))
(assert (fp.leq (fp #b1 #b1111100111000 #b1110)
                arg2
                (fp #b0 #b1101010001100 #b0011)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b0011100100011 #b0010)
                expect
                (fp #b0 #b1111100111000 #b1110)))
(assert (fp.leq (fp #b0 #b1111100111000 #b1110)
                expect
                (fp #b0 #b1111110010000 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
