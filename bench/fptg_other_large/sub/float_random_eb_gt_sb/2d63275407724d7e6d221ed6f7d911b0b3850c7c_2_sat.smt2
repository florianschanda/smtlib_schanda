(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b11010101100010000 #b000100)
                arg1
                (fp #b1 #b10000000000000101 #b011101)))
(assert (fp.leq (fp #b1 #b10000000000000101 #b011101)
                arg1
                (fp #b0 #b00001100111000111 #b011101)))

(declare-const arg2 (_ FloatingPoint 17 7))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 17 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11111010000000100 #b000100)
                expect
                (fp #b1 #b00000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000000)
                expect
                (fp #b0 #b10110110111111101 #b100111)))

(assert (= expect result))

(check-sat)
(exit)
