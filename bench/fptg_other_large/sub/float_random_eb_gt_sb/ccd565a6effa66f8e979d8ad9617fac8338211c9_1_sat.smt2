(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b010001010011011 #b11011101)
                arg1
                (fp #b0 #b100000000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000000000010 #b00100000)
                arg1
                (fp #b0 #b101110010000100 #b00011100)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b110110010011101 #b10000000)
                arg2
                (fp #b1 #b100101011101101 #b00010001)))
(assert (fp.leq (fp #b1 #b100101011101101 #b00010001)
                arg2
                (fp #b0 #b110000000111001 #b01011011)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b0 #b001000010100001 #b10110000)
                expect
                (fp #b0 #b100101011101101 #b00010001)))
(assert (fp.leq (fp #b0 #b100101011101101 #b00010001)
                expect
                (fp #b0 #b110111001110010 #b00101010)))

(assert (= expect result))

(check-sat)
(exit)
