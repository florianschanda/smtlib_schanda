(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101010101 #b11)
                arg1
                (fp #b1 #b1100001110 #b00)))
(assert (fp.leq (fp #b1 #b1100001110 #b00)
                arg1
                (fp #b0 #b1101011010 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1000110110 #b11)
                arg2
                (fp #b1 #b0011010000 #b00)))
(assert (fp.leq (fp #b1 #b0011010000 #b00)
                arg2
                (fp #b0 #b0001001100 #b10)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110101011 #b10)
                expect
                (fp #b1 #b1100001101 #b11)))
(assert (fp.leq (fp #b1 #b1100001101 #b11)
                expect
                (fp #b0 #b0011100111 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
