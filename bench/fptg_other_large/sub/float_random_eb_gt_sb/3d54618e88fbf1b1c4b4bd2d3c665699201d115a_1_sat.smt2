(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1001101111011010 #b01100010010)
                arg1
                (fp #b0 #b0111111111111111 #b00000000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b00000000000)
                arg1
                (fp #b0 #b1010110001111000 #b10110000011)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0110011001011110 #b10111111011)
                arg2
                (fp #b0 #b1001110110010110 #b11011011000)))
(assert (fp.leq (fp #b0 #b1001110110010110 #b11011011000)
                arg2
                (fp #b0 #b1101011110100010 #b11101000000)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1010110111010100 #b11010010110)
                expect
                (fp #b1 #b1001110110010110 #b11011010111)))
(assert (fp.leq (fp #b1 #b1001110110010110 #b11011010111)
                expect
                (fp #b0 #b1100001001110011 #b00001001000)))

(assert (= expect result))

(check-sat)
(exit)
