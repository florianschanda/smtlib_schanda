(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110000010 #b110)
                arg1
                (fp #b1 #b1101101011 #b100)))
(assert (fp.leq (fp #b1 #b1101101011 #b100)
                arg1
                (fp #b0 #b1001011010 #b011)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111110001 #b011)
                arg2
                (fp #b0 #b0111111111 #b000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000)
                arg2
                (fp #b0 #b1001010111 #b010)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110001111 #b001)
                expect
                (fp #b1 #b1101101011 #b100)))
(assert (fp.leq (fp #b1 #b1101101011 #b100)
                expect
                (fp #b0 #b1100100011 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
