; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111110111001 #b11111)
                arg1
                (fp #b1 #b111101111011 #b10010)))
(assert (fp.leq (fp #b1 #b111101111011 #b10010)
                arg1
                (fp #b0 #b100011010001 #b00011)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100000110001 #b10110)
                arg2
                (fp #b1 #b010000000000 #b00000)))
(assert (fp.leq (fp #b1 #b010000000000 #b00000)
                arg2
                (fp #b0 #b110101100000 #b00101)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111101111 #b11011)
                expect
                (fp #b1 #b111101111011 #b10001)))
(assert (fp.leq (fp #b1 #b111101111011 #b10001)
                expect
                (fp #b0 #b110011010010 #b11010)))

(assert (not (= expect result)))

(check-sat)
(exit)
