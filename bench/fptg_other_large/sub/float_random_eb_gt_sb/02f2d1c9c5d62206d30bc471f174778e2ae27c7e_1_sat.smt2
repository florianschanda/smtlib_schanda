(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1010110001 #b00111)
                arg1
                (fp #b1 #b0000000000 #b01000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000)
                arg1
                (fp #b0 #b0001101010 #b01110)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011111110 #b01001)
                arg2
                (fp #b0 #b1111111101 #b00000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000)
                arg2
                (fp #b0 #b1111111101 #b11100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111110 #b10001)
                expect
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                expect
                (fp #b1 #b1000011001 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
