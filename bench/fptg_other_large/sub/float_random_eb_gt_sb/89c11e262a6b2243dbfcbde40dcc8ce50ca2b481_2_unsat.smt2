(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10001111000 #b1000011)
                arg1
                (fp #b1 #b01111111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100111)
                arg1
                (fp #b0 #b10111101011 #b1000100)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11000111101 #b0000110)
                arg2
                (fp #b1 #b10000000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000000101 #b1100000)
                arg2
                (fp #b1 #b00001010001 #b1010100)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00001101011 #b0101000)
                expect
                (fp #b0 #b10000000101 #b1011110)))
(assert (fp.leq (fp #b0 #b10000000101 #b1011110)
                expect
                (fp #b0 #b10001100101 #b1100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
