(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000)
                arg1
                (fp #b1 #b11111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111)
                arg1
                (fp #b0 #b01010000111000 #b1101)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
