(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0101101001101 #b00101100)
                arg1
                (fp #b1 #b0011111111100 #b00000000)))
(assert (fp.leq (fp #b1 #b0011111111100 #b00000000)
                arg1
                (fp #b1 #b0000101010100 #b10001001)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1111100101000 #b00011011)
                arg2
                (fp #b1 #b0001001111000 #b00110010)))
(assert (fp.leq (fp #b1 #b0001001111000 #b00110010)
                arg2
                (fp #b0 #b1011001111101 #b00001100)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1110111001001 #b01101110)
                expect
                (fp #b1 #b0011111111011 #b11111111)))
(assert (fp.leq (fp #b1 #b0011111111011 #b11111111)
                expect
                (fp #b0 #b1111110011000 #b11000101)))

(assert (= expect result))

(check-sat)
(exit)
