(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1010111101 #b00010101)
                arg1
                (fp #b1 #b0000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b11111111)
                arg1
                (fp #b0 #b1010111000 #b00001010)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111110 #b11000111)
                arg2
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                arg2
                (fp #b0 #b1010110001 #b00100111)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b1111001101 #b10111110)
                expect
                (fp #b0 #b1111111100 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111100 #b11111111)
                expect
                (fp #b0 #b1111111101 #b00110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
