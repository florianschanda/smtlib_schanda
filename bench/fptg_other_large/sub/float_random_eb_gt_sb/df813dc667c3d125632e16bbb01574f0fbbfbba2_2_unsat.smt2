; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111101101100 #b111)
                arg1
                (fp #b1 #b1110111101011 #b111)))
(assert (fp.leq (fp #b1 #b1110111101011 #b111)
                arg1
                (fp #b1 #b1000100010100 #b010)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1101011111010 #b110)
                arg2
                (fp #b1 #b0000000000000 #b111)))
(assert (fp.leq (fp #b1 #b0000000000000 #b111)
                arg2
                (fp #b0 #b0101110101011 #b011)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111001001010 #b100)
                expect
                (fp #b1 #b1110111101011 #b111)))
(assert (fp.leq (fp #b1 #b1110111101011 #b111)
                expect
                (fp #b1 #b1100011010011 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
