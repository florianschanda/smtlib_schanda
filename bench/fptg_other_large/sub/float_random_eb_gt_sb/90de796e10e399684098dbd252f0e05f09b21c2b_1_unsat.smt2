(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111011100 #b100111)
                arg1
                (fp #b0 #b000000000 #b111111)))
(assert (fp.leq (fp #b0 #b000000000 #b111111)
                arg1
                (fp #b0 #b101010100 #b001000)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110101001 #b000011)
                arg2
                (fp #b0 #b111001100 #b100100)))
(assert (fp.leq (fp #b0 #b111001100 #b100100)
                arg2
                (fp #b0 #b111100110 #b111111)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111010011 #b001010)
                expect
                (fp #b1 #b111001100 #b100011)))
(assert (fp.leq (fp #b1 #b111001100 #b100011)
                expect
                (fp #b1 #b101000010 #b000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
