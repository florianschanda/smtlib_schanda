; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110010000011 #b110011110)
                arg1
                (fp #b1 #b001111111011 #b011010100)))
(assert (fp.leq (fp #b1 #b001111111011 #b011010100)
                arg1
                (fp #b0 #b010000010111 #b011000111)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101101101110 #b001110001)
                arg2
                (fp #b0 #b000000000000 #b100001010)))
(assert (fp.leq (fp #b0 #b000000000000 #b100001010)
                arg2
                (fp #b0 #b111100111110 #b100001000)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110000110111 #b101010011)
                expect
                (fp #b1 #b001111111011 #b011010100)))
(assert (fp.leq (fp #b1 #b001111111011 #b011010100)
                expect
                (fp #b0 #b010100111101 #b010110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
