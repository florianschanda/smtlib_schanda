                arg2
                (fp #b1 #b10000111101101100 #b0)))
(assert (fp.leq (fp #b1 #b10000111101101100 #b0)
                arg2
                (fp #b0 #b01100010100101100 #b0)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b11111111111111111 #b0)
                expect
                (fp #b1 #b11111111111111100 #b1)))
(assert (fp.leq (fp #b1 #b11111111111111100 #b1)
                expect
                (fp #b1 #b00100011110100010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
