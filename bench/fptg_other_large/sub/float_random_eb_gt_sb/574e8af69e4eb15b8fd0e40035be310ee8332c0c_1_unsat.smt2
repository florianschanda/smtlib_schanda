;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b11111111111111110 #b0)
                arg1
                (fp #b1 #b11111111111111101 #b0)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b0)
                arg1
                (fp #b1 #b01110101011100111 #b1)))

