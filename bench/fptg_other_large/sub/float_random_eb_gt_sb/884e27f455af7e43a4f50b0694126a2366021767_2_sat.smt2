(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1110111100011010 #b1)
                arg1
                (fp #b1 #b1011111111111110 #b1)))
(assert (fp.leq (fp #b1 #b1011111111111110 #b1)
                arg1
                (fp #b1 #b1011100100101011 #b0)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0011000010110101 #b1)
                arg2
                (fp #b0 #b1000010111101110 #b0)))
(assert (fp.leq (fp #b0 #b1000010111101110 #b0)
                arg2
                (fp #b0 #b1100010010011010 #b1)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111111110111000 #b0)
                expect
                (fp #b1 #b1011111111111111 #b0)))
(assert (fp.leq (fp #b1 #b1011111111111111 #b0)
                expect
                (fp #b0 #b0010100010011001 #b1)))

(assert (= expect result))

(check-sat)
(exit)
