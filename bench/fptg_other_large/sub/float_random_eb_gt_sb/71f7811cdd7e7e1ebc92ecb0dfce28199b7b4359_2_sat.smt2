(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111110 #b010011)
                arg1
                (fp #b1 #b111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000000)
                arg1
                (fp #b1 #b000001101011011 #b110110)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b110111010011000 #b101110)
                arg2
                (fp #b1 #b100000000000110 #b000000)))
(assert (fp.leq (fp #b1 #b100000000000110 #b000000)
                arg2
                (fp #b0 #b100000011110110 #b111001)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111101 #b000011)
                expect
                (fp #b1 #b111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000000)
                expect
                (fp #b1 #b111100011000000 #b000110)))

(assert (= expect result))

(check-sat)
(exit)
