(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001100111 #b000111)
                arg1
                (fp #b0 #b100110110 #b111011)))
(assert (fp.leq (fp #b0 #b100110110 #b111011)
                arg1
                (fp #b0 #b100111001 #b100111)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b001001111 #b010100)
                arg2
                (fp #b0 #b111001100 #b100100)))
(assert (fp.leq (fp #b0 #b111001100 #b100100)
                arg2
                (fp #b0 #b111101100 #b001100)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111010000 #b011000)
                expect
                (fp #b1 #b111001100 #b100100)))
(assert (fp.leq (fp #b1 #b111001100 #b100100)
                expect
                (fp #b0 #b100001001 #b011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
