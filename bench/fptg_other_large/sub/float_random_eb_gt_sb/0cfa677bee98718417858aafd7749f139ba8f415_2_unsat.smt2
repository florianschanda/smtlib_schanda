(assert (fp.leq (fp #b1 #b10001100110100001 #b0011111)
                arg2
                (fp #b1 #b01010101100100011 #b1100101)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b10010001010101100 #b0110001)
                expect
                (fp #b0 #b10001100110100001 #b0100000)))
(assert (fp.leq (fp #b0 #b10001100110100001 #b0100000)
                expect
                (fp #b0 #b10110001100010011 #b1001010)))

(assert (not (= expect result)))

(check-sat)
