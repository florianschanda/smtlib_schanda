; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00010101001 #b101000101)
                arg1
                (fp #b0 #b10000011111 #b110011111)))
(assert (fp.leq (fp #b0 #b10000011111 #b110011111)
                arg1
                (fp #b0 #b11010101101 #b101110011)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00110110011 #b000111110)
                arg2
                (fp #b0 #b11101111001 #b001010110)))
(assert (fp.leq (fp #b0 #b11101111001 #b001010110)
                arg2
                (fp #b0 #b11110100010 #b100001001)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111111100 #b001001001)
                expect
                (fp #b1 #b11101111001 #b001010101)))
(assert (fp.leq (fp #b1 #b11101111001 #b001010101)
                expect
                (fp #b1 #b10000101001 #b101101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
