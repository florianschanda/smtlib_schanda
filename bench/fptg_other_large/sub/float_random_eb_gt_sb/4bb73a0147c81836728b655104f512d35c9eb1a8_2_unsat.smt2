(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01000110101 #b10)
                arg1
                (fp #b0 #b00000000000 #b11)))
(assert (fp.leq (fp #b0 #b00000000000 #b11)
                arg1
                (fp #b0 #b01000001000 #b11)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10110110010 #b11)
                arg2
                (fp #b1 #b01111111111 #b00)))
(assert (fp.leq (fp #b1 #b01111111111 #b00)
                arg2
                (fp #b1 #b00011110001 #b01)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b01010000001 #b01)
                expect
                (fp #b0 #b01111111111 #b01)))
(assert (fp.leq (fp #b0 #b01111111111 #b01)
                expect
                (fp #b0 #b10000011101 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
