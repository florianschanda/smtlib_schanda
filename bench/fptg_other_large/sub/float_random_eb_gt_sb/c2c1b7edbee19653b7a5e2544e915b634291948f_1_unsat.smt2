(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111000011110 #b100000)
                arg1
                (fp #b0 #b001111111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111111101 #b000000)
                arg1
                (fp #b0 #b110110010100 #b111000)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100001111111 #b011000)
                arg2
                (fp #b0 #b000000000000 #b010000)))
(assert (fp.leq (fp #b0 #b000000000000 #b010000)
                arg2
                (fp #b0 #b101011011101 #b010010)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101000001111 #b110001)
                expect
                (fp #b0 #b001111111100 #b111111)))
(assert (fp.leq (fp #b0 #b001111111100 #b111111)
                expect
                (fp #b0 #b101010110101 #b001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
