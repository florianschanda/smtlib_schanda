(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b011111011 #b0101)
                arg1
                (fp #b1 #b000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000 #b0001)
                arg1
                (fp #b0 #b011000111 #b1011)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110011110 #b0011)
                arg2
                (fp #b1 #b011111111 #b0000)))
(assert (fp.leq (fp #b1 #b011111111 #b0000)
                arg2
                (fp #b1 #b011011011 #b0000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010101110 #b0101)
                expect
                (fp #b0 #b011111110 #b1111)))
(assert (fp.leq (fp #b0 #b011111110 #b1111)
                expect
                (fp #b0 #b111010011 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
