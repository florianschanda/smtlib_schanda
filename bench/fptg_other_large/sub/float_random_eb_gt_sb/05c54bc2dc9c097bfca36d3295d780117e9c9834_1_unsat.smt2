(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10110001011 #b1110010)
                arg1
                (fp #b1 #b01111111111 #b0100111)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100111)
                arg1
                (fp #b0 #b01110001001 #b0111001)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10001110101 #b1100100)
                arg2
                (fp #b1 #b10000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000000)
                arg2
                (fp #b1 #b01111101010 #b1000011)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01010100101 #b0101101)
                expect
                (fp #b0 #b10000000110 #b1111110)))
(assert (fp.leq (fp #b0 #b10000000110 #b1111110)
                expect
                (fp #b0 #b10000100011 #b0011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
