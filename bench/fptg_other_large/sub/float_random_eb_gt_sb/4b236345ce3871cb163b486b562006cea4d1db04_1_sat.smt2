(declare-const expect (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b001110001001001100 #b1101111110)
                expect
                (fp #b0 #b101111111111111110 #b1111111110)))
(assert (fp.leq (fp #b0 #b101111111111111110 #b1111111110)
                expect
                (fp #b0 #b111111011001001001 #b0110101000)))

(assert (= expect result))

(check-sat)
