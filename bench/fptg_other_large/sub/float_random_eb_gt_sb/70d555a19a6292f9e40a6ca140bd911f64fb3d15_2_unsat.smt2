; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1101010010100001 #b1100101001111)
                arg1
                (fp #b1 #b1100100011010100 #b1010010000110)))
(assert (fp.leq (fp #b1 #b1100100011010100 #b1010010000110)
                arg1
                (fp #b0 #b0001110101011101 #b1010100110111)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1011001101101000 #b0111110110010)
                arg2
                (fp #b1 #b0000000000000000 #b0011111001000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0011111001000)
                arg2
                (fp #b0 #b1010010111111010 #b1010011111101)))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1101110100111011 #b1111001101001)
                expect
                (fp #b1 #b1100100011010100 #b1010010000110)))
(assert (fp.leq (fp #b1 #b1100100011010100 #b1010010000110)
                expect
                (fp #b1 #b1010100001101011 #b0100101111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
