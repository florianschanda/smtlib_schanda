(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b001100000001 #b00101)
                arg1
                (fp #b1 #b000000000000 #b00111)))
(assert (fp.leq (fp #b1 #b000000000000 #b00111)
                arg1
                (fp #b0 #b101110101001 #b10000)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100101101001 #b01000)
                arg2
                (fp #b0 #b101111011000 #b00010)))
(assert (fp.leq (fp #b0 #b101111011000 #b00010)
                arg2
                (fp #b0 #b111110010100 #b00101)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111100000100 #b10001)
                expect
                (fp #b1 #b101111011000 #b00011)))
(assert (fp.leq (fp #b1 #b101111011000 #b00011)
                expect
                (fp #b1 #b001000000100 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
