; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1010010100011 #b0001110)
                arg1
                (fp #b1 #b1000010101110 #b0101001)))
(assert (fp.leq (fp #b1 #b1000010101110 #b0101001)
                arg1
                (fp #b0 #b1010101010100 #b0100000)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1110111001011 #b0000110)
                arg2
                (fp #b1 #b0111111111111 #b0001101)))
(assert (fp.leq (fp #b1 #b0111111111111 #b0001101)
                arg2
                (fp #b0 #b1010010101100 #b0000010)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111110010001 #b0010011)
                expect
                (fp #b1 #b1000010101110 #b0101001)))
(assert (fp.leq (fp #b1 #b1000010101110 #b0101001)
                expect
                (fp #b0 #b1111011010100 #b0101000)))

(assert (= expect result))

(check-sat)
(exit)
