                arg2
                (fp #b0 #b1111111110 #b0)))
(assert (fp.leq (fp #b0 #b1111111110 #b0)
                arg2
                (fp #b0 #b1111111110 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1111111111 #b0)
                expect
                (fp #b1 #b1111111110 #b1)))
(assert (fp.leq (fp #b1 #b1111111110 #b1)
                expect
                (fp #b1 #b0111100000 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
