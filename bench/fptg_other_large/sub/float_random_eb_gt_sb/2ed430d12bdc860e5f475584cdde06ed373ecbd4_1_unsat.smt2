; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b0 #b00001010001010101 #b1)
                arg1
                (fp #b0 #b01111111111111111 #b1)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b1)
                arg1
                (fp #b0 #b10111101111001101 #b1)))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b10010000110000011 #b1)
                arg2
                (fp #b1 #b10000000000000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000000000000 #b1)
                arg2
                (fp #b0 #b10101010110101000 #b1)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b00101101000000110 #b0)
                expect
                (fp #b0 #b10000000000000001 #b0)))
(assert (fp.leq (fp #b0 #b10000000000000001 #b0)
                expect
                (fp #b0 #b11010101011101011 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
