(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b01110010011000 #b01)
                arg1
                (fp #b0 #b00000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01)
                arg1
                (fp #b0 #b11001000001001 #b11)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11100010010101 #b00)
                arg2
                (fp #b0 #b00000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01)
                arg2
                (fp #b0 #b00100100101100 #b00)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11011110000101 #b11)
                expect
                (fp #b1 #b00000000000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00)
                expect
                (fp #b0 #b10001101101000 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
