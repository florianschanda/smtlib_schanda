(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110011100 #b1011101)
                arg1
                (fp #b1 #b0000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000001)
                arg1
                (fp #b0 #b0100111011 #b1011111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100110110 #b1111110)
                arg2
                (fp #b1 #b1011011101 #b1100100)))
(assert (fp.leq (fp #b1 #b1011011101 #b1100100)
                arg2
                (fp #b1 #b0111001011 #b1111011)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010010110 #b1011111)
                expect
                (fp #b0 #b1011011101 #b1100011)))
(assert (fp.leq (fp #b0 #b1011011101 #b1100011)
                expect
                (fp #b0 #b1111111000 #b1000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
