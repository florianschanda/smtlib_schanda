; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b0110001111100 #b0110001001)
                arg1
                (fp #b0 #b0000000000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1111111000)
                arg1
                (fp #b0 #b1010001100010 #b1010110110)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1101011110111 #b0101110010)
                arg2
                (fp #b0 #b1010101000010 #b0000100000)))
(assert (fp.leq (fp #b0 #b1010101000010 #b0000100000)
                arg2
                (fp #b0 #b1110001101011 #b0011000011)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1111000000101 #b0110001001)
                expect
                (fp #b1 #b1010101000010 #b0000100000)))
(assert (fp.leq (fp #b1 #b1010101000010 #b0000100000)
                expect
                (fp #b0 #b0010010111100 #b1101110101)))

(assert (= expect result))

(check-sat)
(exit)
