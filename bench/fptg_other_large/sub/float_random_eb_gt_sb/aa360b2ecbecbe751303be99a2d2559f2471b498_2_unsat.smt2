; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1011000011101 #b10101)
                arg1
                (fp #b1 #b1000010000001 #b00101)))
(assert (fp.leq (fp #b1 #b1000010000001 #b00101)
                arg1
                (fp #b0 #b1110001001000 #b11110)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1100100110111 #b00000)
                arg2
                (fp #b1 #b0000001100111 #b00000)))
(assert (fp.leq (fp #b1 #b0000001100111 #b00000)
                arg2
                (fp #b0 #b1111011000101 #b10011)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000111011010 #b01001)
                expect
                (fp #b1 #b1000010000001 #b00101)))
(assert (fp.leq (fp #b1 #b1000010000001 #b00101)
                expect
                (fp #b1 #b0011011001110 #b10100)))

(assert (not (= expect result)))

(check-sat)
(exit)
