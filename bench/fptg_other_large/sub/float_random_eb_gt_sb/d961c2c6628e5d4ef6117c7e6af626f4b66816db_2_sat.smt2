(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b100101110000011 #b10001001000)
                arg1
                (fp #b1 #b011111111111111 #b11001010001)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11001010001)
                arg1
                (fp #b0 #b001010111001010 #b11110100011)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001111011000101 #b00100001000)
                expect
                (fp #b1 #b000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000)
                expect
                (fp #b0 #b011010000100111 #b11001001011)))

(assert (= expect result))

(check-sat)
(exit)
