(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1001011101000 #b01010110)
                arg1
                (fp #b0 #b0000000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b01000000)
                arg1
                (fp #b0 #b1100001101101 #b01000100)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1111111111111 #b00000000)
                arg2
                (fp #b1 #b1111111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b11111111)
                arg2
                (fp #b0 #b1011100001010 #b01000010)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b0 #b0010111001101 #b11001000)
                expect
                (fp #b0 #b1111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11111111)
                expect
                (fp #b0 #b1111111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
