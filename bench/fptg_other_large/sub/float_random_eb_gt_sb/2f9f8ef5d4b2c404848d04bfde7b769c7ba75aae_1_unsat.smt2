(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111011 #b0010100)
                arg1
                (fp #b1 #b1100011110 #b0100010)))
(assert (fp.leq (fp #b1 #b1100011110 #b0100010)
                arg1
                (fp #b1 #b1011101011 #b0100111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110010000 #b1010110)
                arg2
                (fp #b1 #b1000011110 #b1111100)))
(assert (fp.leq (fp #b1 #b1000011110 #b1111100)
                arg2
                (fp #b0 #b0001000001 #b0000111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101110010 #b0101110)
                expect
                (fp #b1 #b1100011110 #b0100001)))
(assert (fp.leq (fp #b1 #b1100011110 #b0100001)
                expect
                (fp #b1 #b0101001011 #b1101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
