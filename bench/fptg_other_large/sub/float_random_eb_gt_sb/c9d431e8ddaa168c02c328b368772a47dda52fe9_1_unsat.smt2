(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11001111110 #b11)
                arg1
                (fp #b0 #b00110100101 #b01)))
(assert (fp.leq (fp #b0 #b00110100101 #b01)
                arg1
                (fp #b0 #b11100010000 #b11)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11110011010 #b10)
                arg2
                (fp #b0 #b01111111111 #b11)))
(assert (fp.leq (fp #b0 #b01111111111 #b11)
                arg2
                (fp #b0 #b10000000011 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10010111100 #b10)
                expect
                (fp #b1 #b01111111111 #b10)))
(assert (fp.leq (fp #b1 #b01111111111 #b10)
                expect
                (fp #b0 #b10011011101 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
