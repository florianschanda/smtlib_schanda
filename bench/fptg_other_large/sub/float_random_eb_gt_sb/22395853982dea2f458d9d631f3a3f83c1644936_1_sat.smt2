; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b000001001011110011 #b10001)
                arg1
                (fp #b0 #b011111111111111111 #b00111)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b00111)
                arg1
                (fp #b0 #b110000001101011001 #b10010)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b0 #b011010111001110011 #b01111)
                arg2
                (fp #b0 #b100000000000000011 #b00110)))
(assert (fp.leq (fp #b0 #b100000000000000011 #b00110)
                arg2
                (fp #b0 #b110101101110100010 #b01010)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b110110000001100000 #b01111)
                expect
                (fp #b1 #b100000000000000011 #b00011)))
(assert (fp.leq (fp #b1 #b100000000000000011 #b00011)
                expect
                (fp #b0 #b001111001110011000 #b11111)))

(assert (= expect result))

(check-sat)
(exit)
