(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01111110110 #b1)
                arg1
                (fp #b0 #b11001001100 #b1)))
(assert (fp.leq (fp #b0 #b11001001100 #b1)
                arg1
                (fp #b0 #b11001101110 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11111011001 #b1)
                arg2
                (fp #b1 #b11100001000 #b0)))
(assert (fp.leq (fp #b1 #b11100001000 #b0)
                arg2
                (fp #b0 #b01100000110 #b0)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b10001111011 #b0)
                expect
                (fp #b0 #b11100001000 #b0)))
(assert (fp.leq (fp #b0 #b11100001000 #b0)
                expect
                (fp #b0 #b11100100000 #b1)))

(assert (= expect result))

(check-sat)
(exit)
