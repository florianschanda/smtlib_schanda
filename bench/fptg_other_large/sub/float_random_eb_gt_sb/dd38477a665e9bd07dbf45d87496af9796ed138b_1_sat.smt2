(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0101001100 #b011001)
                arg1
                (fp #b0 #b0000000000 #b000110)))
(assert (fp.leq (fp #b0 #b0000000000 #b000110)
                arg1
                (fp #b0 #b0000001111 #b111010)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111011001 #b101111)
                arg2
                (fp #b0 #b0100000000 #b000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b000000)
                arg2
                (fp #b0 #b0110001110 #b101110)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0100110011 #b111111)
                expect
                (fp #b1 #b0011111111 #b111111)))
(assert (fp.leq (fp #b1 #b0011111111 #b111111)
                expect
                (fp #b0 #b1011100100 #b110000)))

(assert (= expect result))

(check-sat)
(exit)
