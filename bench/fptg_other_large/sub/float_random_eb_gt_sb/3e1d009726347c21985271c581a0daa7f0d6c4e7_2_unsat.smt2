(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111011010 #b1000)
                arg1
                (fp #b0 #b1000000010 #b0000)))
(assert (fp.leq (fp #b0 #b1000000010 #b0000)
                arg1
                (fp #b0 #b1010001001 #b1100)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101101100 #b1101)
                arg2
                (fp #b1 #b0100000000 #b0000)))
(assert (fp.leq (fp #b1 #b0100000000 #b0000)
                arg2
                (fp #b0 #b0011111010 #b1010)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0001000000 #b0000)
                expect
                (fp #b0 #b1000000010 #b0001)))
(assert (fp.leq (fp #b0 #b1000000010 #b0001)
                expect
                (fp #b0 #b1111001001 #b1101)))

(assert (not (= expect result)))

(check-sat)
(exit)
