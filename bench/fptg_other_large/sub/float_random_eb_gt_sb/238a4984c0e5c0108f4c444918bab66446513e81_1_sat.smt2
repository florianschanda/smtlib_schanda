(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11011111010000101 #b10010)
                arg1
                (fp #b0 #b01111111111111111 #b00000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b00000)
                arg1
                (fp #b0 #b10111100111010111 #b01000)))

(declare-const arg2 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b00001111000111111 #b10000)
                arg2
                (fp #b1 #b00000000000000001 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000000001 #b00000)
                arg2
                (fp #b0 #b11101100110000100 #b00011)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b00110011111101110 #b11101)
                expect
                (fp #b0 #b01111111111111111 #b00000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b00000)
                expect
                (fp #b0 #b10011001101101100 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
