; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0010001110111011 #b01)
                arg1
                (fp #b0 #b0111111111111111 #b11)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b11)
                arg1
                (fp #b0 #b1100010011111000 #b00)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1110110111011011 #b11)
                arg2
                (fp #b1 #b1110101111001111 #b00)))
(assert (fp.leq (fp #b1 #b1110101111001111 #b00)
                arg2
                (fp #b1 #b0100000111110010 #b00)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b0 #b1000101011111000 #b00)
                expect
                (fp #b0 #b1110101111001111 #b00)))
(assert (fp.leq (fp #b0 #b1110101111001111 #b00)
                expect
                (fp #b0 #b1111000001111110 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
