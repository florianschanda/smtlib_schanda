(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b101111000011010 #b100)
                arg1
                (fp #b1 #b000000000000000 #b111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b111)
                arg1
                (fp #b0 #b101011110100000 #b110)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b011011101111101 #b101)
                arg2
                (fp #b0 #b011111111111111 #b000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b000)
                arg2
                (fp #b0 #b100101101010111 #b001)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111000010111011 #b100)
                expect
                (fp #b1 #b011111111111111 #b000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b000)
                expect
                (fp #b1 #b011010101001000 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
