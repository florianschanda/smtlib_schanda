(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100101111100 #b010010)
                arg1
                (fp #b1 #b000000000000 #b000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b000001)
                arg1
                (fp #b0 #b010010100001 #b100010)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111111111111 #b000000)
                arg2
                (fp #b1 #b111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b111111)
                arg2
                (fp #b0 #b010010101100 #b001101)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b001100110011 #b001101)
                expect
                (fp #b0 #b111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111111)
                expect
                (fp #b0 #b111111111111 #b000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
