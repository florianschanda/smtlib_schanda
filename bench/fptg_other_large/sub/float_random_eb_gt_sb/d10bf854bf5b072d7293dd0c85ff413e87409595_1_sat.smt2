(assert (fp.leq (fp #b1 #b011111111 #b0000)
                arg2
                (fp #b1 #b000000011 #b0100)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110000011 #b1000)
                expect
                (fp #b1 #b100000011 #b1111)))
(assert (fp.leq (fp #b1 #b100000011 #b1111)
                expect
                (fp #b1 #b010101111 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
