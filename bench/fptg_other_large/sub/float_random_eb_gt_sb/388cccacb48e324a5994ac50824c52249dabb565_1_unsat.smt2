; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b101111101001100 #b1011)
                arg1
                (fp #b0 #b001111111111110 #b0000)))
(assert (fp.leq (fp #b0 #b001111111111110 #b0000)
                arg1
                (fp #b0 #b100110110010100 #b0101)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b001011011010000 #b1110)
                arg2
                (fp #b0 #b100000000000100 #b0000)))
(assert (fp.leq (fp #b0 #b100000000000100 #b0000)
                arg2
                (fp #b0 #b101001111101010 #b1111)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111111111100001 #b0001)
                expect
                (fp #b1 #b100000000000011 #b1111)))
(assert (fp.leq (fp #b1 #b100000000000011 #b1111)
                expect
                (fp #b0 #b100001000100110 #b0001)))

(assert (not (= expect result)))

(check-sat)
(exit)
