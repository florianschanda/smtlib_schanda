(assert (fp.leq (fp #b0 #b0100000000000000 #b0000000000000)
                arg2
                (fp #b0 #b1100100011010101 #b1001001101101)))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1010101110111101 #b0101100010101)
                expect
                (fp #b0 #b1100110100100110 #b0010110100001)))
(assert (fp.leq (fp #b0 #b1100110100100110 #b0010110100001)
                expect
                (fp #b0 #b1111001010111001 #b1111001011001)))

(assert (= expect result))

(check-sat)
