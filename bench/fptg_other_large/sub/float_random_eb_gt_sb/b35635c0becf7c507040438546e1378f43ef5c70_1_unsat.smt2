; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1010110110101 #b00101001)
                arg2
                (fp #b1 #b1000000000111 #b11010011)))
(assert (fp.leq (fp #b1 #b1000000000111 #b11010011)
                arg2
                (fp #b1 #b0100011110111 #b11101100)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
