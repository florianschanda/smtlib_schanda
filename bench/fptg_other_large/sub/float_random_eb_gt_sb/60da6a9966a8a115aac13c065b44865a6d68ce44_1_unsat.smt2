                arg2
                (fp #b1 #b000000000000000000 #b111111)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b111111)
                arg2
                (fp #b0 #b000110011110100001 #b110001)))

(declare-const result (_ FloatingPoint 18 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b110101010110011101 #b111000)
                expect
                (fp #b1 #b001111111111111111 #b111111)))
(assert (fp.leq (fp #b1 #b001111111111111111 #b111111)
                expect
                (fp #b0 #b110000111100110001 #b011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
