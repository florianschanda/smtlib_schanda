;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b011011011111001010 #b101110)
                arg1
                (fp #b1 #b010000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b010000000000000000 #b000000)
                arg1
