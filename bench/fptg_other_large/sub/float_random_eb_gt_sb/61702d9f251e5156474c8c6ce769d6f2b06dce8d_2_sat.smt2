(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b0 #b000001010000110100 #b010110)
                arg1
                (fp #b0 #b001111111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111111111111101 #b000000)
                arg1
                (fp #b0 #b111000101101110010 #b010100)))

(declare-const arg2 (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b101001000101100110 #b010000)
                arg2
                (fp #b1 #b000000000000000001 #b000000)))
(assert (fp.leq (fp #b1 #b000000000000000001 #b000000)
                arg2
                (fp #b0 #b000001011000000000 #b000000)))

(declare-const result (_ FloatingPoint 18 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b110110001010011010 #b101110)
                expect
                (fp #b0 #b001111111111111101 #b000001)))
(assert (fp.leq (fp #b0 #b001111111111111101 #b000001)
                expect
                (fp #b0 #b010101110100010110 #b010000)))

(assert (= expect result))

(check-sat)
(exit)
