(assert (fp.leq (fp #b1 #b1000000000101 #b010001)
                arg2
                (fp #b1 #b0100101011001 #b011101)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1110011111110 #b010001)
                expect
                (fp #b1 #b1000001000100 #b011111)))
(assert (fp.leq (fp #b1 #b1000001000100 #b011111)
                expect
                (fp #b1 #b0111110011010 #b110011)))

(assert (not (= expect result)))

