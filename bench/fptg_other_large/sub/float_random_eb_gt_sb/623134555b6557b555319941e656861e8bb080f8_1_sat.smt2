(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1111101011010 #b01001)
                arg1
                (fp #b1 #b1011111111110 #b11111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b11111)
                arg1
                (fp #b0 #b1100101110101 #b11010)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1111111000010 #b10100)
                arg2
                (fp #b1 #b1011101101101 #b10000)))
(assert (fp.leq (fp #b1 #b1011101101101 #b10000)
                arg2
                (fp #b1 #b0010111111100 #b01110)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1110000010110 #b00100)
                expect
                (fp #b1 #b1011111111110 #b11110)))
(assert (fp.leq (fp #b1 #b1011111111110 #b11110)
                expect
                (fp #b1 #b0100101100011 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
