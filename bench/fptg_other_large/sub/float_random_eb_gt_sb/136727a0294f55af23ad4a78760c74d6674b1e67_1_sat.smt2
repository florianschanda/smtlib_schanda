; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b0 #b000011111110110 #b10010101101)
                arg1
                (fp #b0 #b111111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b11111111111)
                arg1
                (fp #b0 #b111111111111111 #b00000000000)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b110010110101000 #b00111000001)
                arg2
                (fp #b0 #b010000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b010000000000000 #b00000000000)
                arg2
                (fp #b0 #b011101101011111 #b01000000011)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b0 #b010110000111001 #b00111011100)
                expect
                (fp #b0 #b111111111111110 #b11111111110)))
(assert (fp.leq (fp #b0 #b111111111111110 #b11111111110)
                expect
                (fp #b0 #b111111111111111 #b00000000000)))

(assert (= expect result))

(check-sat)
(exit)
