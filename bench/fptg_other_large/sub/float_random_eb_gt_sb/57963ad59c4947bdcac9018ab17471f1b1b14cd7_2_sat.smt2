(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0011101101 #b01110111)
                arg1
                (fp #b0 #b0000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b11111111)
                arg1
                (fp #b0 #b1011110101 #b11010111)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001111010 #b01100000)
                arg2
                (fp #b0 #b1011111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1011111110 #b11111111)
                arg2
                (fp #b0 #b1100000000 #b10110110)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1100110111 #b11110010)
                expect
                (fp #b1 #b1011111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b11111111)
                expect
                (fp #b0 #b0111000011 #b00000010)))

(assert (= expect result))

(check-sat)
(exit)
