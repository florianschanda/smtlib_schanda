(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101011111000 #b10)
                arg1
                (fp #b1 #b100000000000 #b10)))
(assert (fp.leq (fp #b1 #b100000000000 #b10)
                arg1
                (fp #b0 #b011010101001 #b00)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b010001100001 #b10)
                arg2
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg2
                (fp #b0 #b011001110111 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100111000000 #b00)
                expect
                (fp #b1 #b100000000000 #b10)))
(assert (fp.leq (fp #b1 #b100000000000 #b10)
                expect
                (fp #b1 #b000100011001 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
