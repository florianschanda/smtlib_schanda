; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11101010110110 #b010001)
                arg1
                (fp #b1 #b10101101111101 #b011011)))
(assert (fp.leq (fp #b1 #b10101101111101 #b011011)
                arg1
                (fp #b1 #b10101100000001 #b111001)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11101010101011 #b011101)
                arg2
                (fp #b1 #b00111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b00111111111101 #b000000)
                arg2
                (fp #b0 #b00110000011010 #b110101)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11011001100111 #b000000)
                expect
                (fp #b1 #b10101101111101 #b011011)))
(assert (fp.leq (fp #b1 #b10101101111101 #b011011)
                expect
                (fp #b1 #b01110011010101 #b011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
