; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 15))
(assert (fp.leq (fp #b1 #b111111001000100111 #b00111000001111)
                arg1
                (fp #b1 #b000000000000000000 #b00111010110000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00111010110000)
                arg1
                (fp #b0 #b111011100101100010 #b11110110101110)))

(declare-const arg2 (_ FloatingPoint 18 15))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 18 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
