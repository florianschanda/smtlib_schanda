(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0101010100 #b00)
                arg1
                (fp #b0 #b1000000001 #b10)))
(assert (fp.leq (fp #b0 #b1000000001 #b10)
                arg1
                (fp #b0 #b1110001100 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0011101110 #b11)
                arg2
                (fp #b0 #b1001001001 #b10)))
(assert (fp.leq (fp #b0 #b1001001001 #b10)
                arg2
                (fp #b0 #b1100010010 #b00)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101110100 #b00)
                expect
                (fp #b1 #b1001001001 #b10)))
(assert (fp.leq (fp #b1 #b1001001001 #b10)
                expect
                (fp #b0 #b0010101000 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
