(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101110010 #b01100001)
                arg1
                (fp #b1 #b0110011001 #b01001011)))
(assert (fp.leq (fp #b1 #b0110011001 #b01001011)
                arg1
                (fp #b1 #b0101110110 #b00100010)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101101000 #b10011110)
                arg2
                (fp #b1 #b1010011001 #b11101111)))
(assert (fp.leq (fp #b1 #b1010011001 #b11101111)
                arg2
                (fp #b0 #b1010101101 #b10000001)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1010011011 #b00011101)
                expect
                (fp #b0 #b1010011001 #b11101110)))
(assert (fp.leq (fp #b0 #b1010011001 #b11101110)
                expect
                (fp #b0 #b1100100001 #b10111100)))

(assert (= expect result))

(check-sat)
(exit)
