; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0111010100001 #b100)
                arg1
                (fp #b0 #b0111111111111 #b000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b000)
                arg1
                (fp #b0 #b1101101000010 #b101)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0101101010010 #b000)
                arg2
                (fp #b0 #b0000000000000 #b011)))
(assert (fp.leq (fp #b0 #b0000000000000 #b011)
                arg2
                (fp #b0 #b0001001100100 #b000)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110011001100 #b100)
                expect
                (fp #b0 #b0111111111111 #b000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b000)
                expect
                (fp #b0 #b1100000111000 #b000)))

(assert (= expect result))

(check-sat)
(exit)
