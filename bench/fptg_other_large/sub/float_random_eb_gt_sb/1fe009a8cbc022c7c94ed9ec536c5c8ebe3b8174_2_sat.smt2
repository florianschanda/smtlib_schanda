; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b010111001110110 #b110010010)
                arg1
                (fp #b0 #b111111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b000000000)
                arg1
                (fp #b0 #b111111111111101 #b001011000)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b000101000000110 #b011110101)
                arg2
                (fp #b0 #b100000000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b100000000001000 #b001010110)
                arg2
                (fp #b0 #b100001100101100 #b010001011)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b0 #b010100110001010 #b011101111)
                expect
                (fp #b0 #b111111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b000000000)
                expect
                (fp #b0 #b111111111111110 #b011010111)))

(assert (= expect result))

(check-sat)
(exit)
