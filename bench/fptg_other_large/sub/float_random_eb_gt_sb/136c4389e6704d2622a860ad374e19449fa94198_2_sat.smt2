; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b11001101100000010 #b11001001101101)
                arg1
                (fp #b0 #b00000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b01000000000000)
                arg1
                (fp #b0 #b10001110111101001 #b01011001111001)))

(declare-const arg2 (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b10011001110001000 #b01111101000000)
                arg2
                (fp #b0 #b01101000111010110 #b01001110111010)))
(assert (fp.leq (fp #b0 #b01101000111010110 #b01001110111010)
                arg2
                (fp #b0 #b11111011011101001 #b00100001000001)))

(declare-const result (_ FloatingPoint 17 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b10010011001011110 #b11010100110110)
                expect
                (fp #b1 #b01101000111010110 #b01001110111010)))
(assert (fp.leq (fp #b1 #b01101000111010110 #b01001110111010)
                expect
                (fp #b0 #b01110010101010101 #b01010010001011)))

(assert (= expect result))

(check-sat)
(exit)
