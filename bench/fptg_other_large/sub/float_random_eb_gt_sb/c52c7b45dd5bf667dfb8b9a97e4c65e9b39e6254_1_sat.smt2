; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0010011111110 #b001000100)
                arg1
                (fp #b0 #b1000000001000 #b110100101)))
(assert (fp.leq (fp #b0 #b1000000001000 #b110100101)
                arg1
                (fp #b0 #b1000111010111 #b000111000)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1000001000111 #b100011011)
                arg2
                (fp #b0 #b0000000000001 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000001 #b000000000)
                arg2
                (fp #b0 #b0110011111001 #b101111110)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b0 #b0010000011001 #b011110110)
                expect
                (fp #b0 #b1000000001000 #b110100100)))
(assert (fp.leq (fp #b0 #b1000000001000 #b110100100)
                expect
                (fp #b0 #b1001100000001 #b111001000)))

(assert (= expect result))

(check-sat)
(exit)
