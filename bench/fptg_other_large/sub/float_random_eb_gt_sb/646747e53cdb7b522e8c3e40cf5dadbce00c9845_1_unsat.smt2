(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0101000100 #b00100)
                arg1
                (fp #b1 #b0000000000 #b11111)))
(assert (fp.leq (fp #b1 #b0000000000 #b11111)
                arg1
                (fp #b0 #b0111110000 #b11011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110111011 #b11110)
                arg2
                (fp #b1 #b1000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000101 #b00000)
                arg2
                (fp #b0 #b0101110001 #b11001)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011100011 #b01000)
                expect
                (fp #b0 #b1000000100 #b11111)))
(assert (fp.leq (fp #b0 #b1000000100 #b11111)
                expect
                (fp #b0 #b1010010100 #b10111)))

(assert (not (= expect result)))

(check-sat)
(exit)
