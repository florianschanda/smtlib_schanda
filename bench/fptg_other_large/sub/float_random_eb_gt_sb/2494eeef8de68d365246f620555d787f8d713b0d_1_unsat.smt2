(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b0 #b0001001111111 #b1)
                arg1
                (fp #b0 #b0111111111111 #b1)))
(assert (fp.leq (fp #b0 #b0111111111111 #b1)
                arg1
                (fp #b0 #b1100011011100 #b1)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1100110000011 #b1)
                arg2
                (fp #b1 #b1000000000000 #b1)))
(assert (fp.leq (fp #b1 #b1000000000000 #b1)
                arg2
                (fp #b1 #b0111111011110 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b0011111011000 #b0)
                expect
                (fp #b0 #b1000000000001 #b0)))
(assert (fp.leq (fp #b0 #b1000000000001 #b0)
                expect
                (fp #b0 #b1111111010000 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
