; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b00011001100111 #b0100000110)
                arg1
                (fp #b0 #b10011100100010 #b1011110010)))
(assert (fp.leq (fp #b0 #b10011100100010 #b1011110010)
                arg1
                (fp #b0 #b11100000111001 #b1100011111)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b10011100101000 #b1101100101)
                arg2
                (fp #b1 #b01111111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0000000000)
                arg2
                (fp #b1 #b00010010010011 #b0010101000)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b00001011001000 #b1010011001)
                expect
                (fp #b0 #b10011100100010 #b1011110010)))
(assert (fp.leq (fp #b0 #b10011100100010 #b1011110010)
                expect
                (fp #b0 #b11100110001000 #b1001101100)))

(assert (= expect result))

(check-sat)
(exit)
