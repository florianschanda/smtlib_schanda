(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110111000001 #b10)
                arg1
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg1
                (fp #b0 #b100000010101 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100000101100 #b01)
                arg2
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg2
                (fp #b0 #b100111100010 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001001110010 #b01)
                expect
                (fp #b0 #b000000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000000 #b00)
                expect
                (fp #b0 #b110111101110 #b11)))

(assert (= expect result))

(check-sat)
(exit)
