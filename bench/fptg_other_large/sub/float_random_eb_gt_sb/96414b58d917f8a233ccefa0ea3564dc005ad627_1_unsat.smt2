; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110101010011000 #b1)
                arg1
                (fp #b0 #b100000000000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000000000 #b1)
                arg1
                (fp #b0 #b111100101010010 #b1)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110110011011001 #b1)
                arg2
                (fp #b1 #b100101000101110 #b0)))
(assert (fp.leq (fp #b1 #b100101000101110 #b0)
                arg2
                (fp #b0 #b000010000101010 #b1)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b0 #b001011110110000 #b1)
                expect
                (fp #b0 #b100101000101110 #b0)))
(assert (fp.leq (fp #b0 #b100101000101110 #b0)
                expect
                (fp #b0 #b111101000101010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
