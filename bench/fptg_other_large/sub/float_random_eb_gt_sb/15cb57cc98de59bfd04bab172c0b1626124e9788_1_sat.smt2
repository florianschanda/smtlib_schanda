(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111110011 #b10)
                arg1
                (fp #b1 #b000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000 #b10)
                arg1
                (fp #b0 #b111101001 #b10)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100101000 #b01)
                arg2
                (fp #b0 #b000110111 #b11)))
(assert (fp.leq (fp #b0 #b000110111 #b11)
                arg2
                (fp #b0 #b100000110 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111011001 #b10)
                expect
                (fp #b1 #b000110111 #b11)))
(assert (fp.leq (fp #b1 #b000110111 #b11)
                expect
                (fp #b0 #b001110101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
