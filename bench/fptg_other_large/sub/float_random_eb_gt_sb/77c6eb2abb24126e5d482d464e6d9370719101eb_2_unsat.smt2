(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100000000 #b111001)
                arg1
                (fp #b0 #b010000000 #b000000)))
(assert (fp.leq (fp #b0 #b010000000 #b000000)
                arg1
                (fp #b0 #b100000010 #b101100)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011000010 #b010110)
                arg2
                (fp #b1 #b000000000 #b111111)))
(assert (fp.leq (fp #b1 #b000000000 #b111111)
                arg2
                (fp #b0 #b100001110 #b001110)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001010000 #b111001)
                expect
                (fp #b0 #b010000000 #b000001)))
(assert (fp.leq (fp #b0 #b010000000 #b000001)
                expect
                (fp #b0 #b010011010 #b100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
