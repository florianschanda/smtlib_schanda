(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111111110100 #b0)
                arg1
                (fp #b0 #b0001101011010 #b0)))
(assert (fp.leq (fp #b0 #b0001101011010 #b0)
                arg1
                (fp #b0 #b0101000011100 #b1)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1000110000010 #b1)
                arg2
                (fp #b1 #b0000000000000 #b1)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1)
                arg2
                (fp #b0 #b0111111110101 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1101011110111 #b0)
                expect
                (fp #b0 #b0001101011010 #b0)))
(assert (fp.leq (fp #b0 #b0001101011010 #b0)
                expect
                (fp #b0 #b1111010011110 #b1)))

(assert (= expect result))

(check-sat)
(exit)
