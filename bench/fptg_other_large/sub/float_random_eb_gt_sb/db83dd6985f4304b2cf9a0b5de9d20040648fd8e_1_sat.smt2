(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11110111110 #b001)
                arg1
                (fp #b0 #b00000000000 #b111)))
(assert (fp.leq (fp #b0 #b00000000000 #b111)
                arg1
                (fp #b0 #b01100011110 #b011)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111111111 #b000)
                arg2
                (fp #b1 #b11111111110 #b111)))
(assert (fp.leq (fp #b1 #b11111111110 #b111)
                arg2
                (fp #b0 #b00100101110 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00110110100 #b101)
                expect
                (fp #b0 #b11111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111)
                expect
                (fp #b0 #b11111111111 #b000)))

(assert (= expect result))

(check-sat)
(exit)
