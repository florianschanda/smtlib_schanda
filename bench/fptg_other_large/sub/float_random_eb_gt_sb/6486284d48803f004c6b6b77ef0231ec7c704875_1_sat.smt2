(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b010100110110101 #b0000001)
                arg1
                (fp #b0 #b000000000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1100101)
                arg1
                (fp #b0 #b011110111101101 #b1100101)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b000011011010000 #b0011110)
                arg2
                (fp #b0 #b000100101010100 #b0110101)))
(assert (fp.leq (fp #b0 #b000100101010100 #b0110101)
                arg2
                (fp #b0 #b101010110011011 #b1100011)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b011110000111000 #b0011111)
                expect
                (fp #b1 #b000100101010100 #b0110100)))
(assert (fp.leq (fp #b1 #b000100101010100 #b0110100)
                expect
                (fp #b0 #b001111010101010 #b1011101)))

(assert (= expect result))

(check-sat)
(exit)
