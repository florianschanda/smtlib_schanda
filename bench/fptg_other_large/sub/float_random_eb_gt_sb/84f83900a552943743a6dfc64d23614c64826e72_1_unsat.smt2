; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -NAN

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b0100011001010 #b0001101100)
                arg1
                (fp #b0 #b1000000001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b1000000001001 #b1101010000)
                arg1
                (fp #b0 #b1001101000010 #b0011000011)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
