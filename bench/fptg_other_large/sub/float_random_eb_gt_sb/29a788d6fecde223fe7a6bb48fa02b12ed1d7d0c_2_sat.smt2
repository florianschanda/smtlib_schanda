; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b110001010001011001 #b00010)
                arg1
                (fp #b1 #b001000110101010001 #b10101)))
(assert (fp.leq (fp #b1 #b001000110101010001 #b10101)
                arg1
                (fp #b0 #b001111101010001100 #b01010)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111010101110001011 #b11001)
                arg2
                (fp #b1 #b100000000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b100000000000000101 #b00000)
                arg2
                (fp #b0 #b111110100111110101 #b11000)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b110111000010101000 #b00110)
                expect
                (fp #b0 #b100000000000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000000000101 #b00000)
                expect
                (fp #b0 #b100110001001000101 #b10101)))

(assert (= expect result))

(check-sat)
(exit)
