(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00000000111 #b11110011)
                arg1
                (fp #b0 #b10000000111 #b11000011)))
(assert (fp.leq (fp #b0 #b10000000111 #b11000011)
                arg1
                (fp #b0 #b11111011101 #b00100000)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11001100011 #b11011100)
                arg2
                (fp #b1 #b10000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b10000001000 #b00000000)
                arg2
                (fp #b0 #b11100010011 #b10101111)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b01110011011 #b01111011)
                expect
                (fp #b0 #b10000001000 #b11100010)))
(assert (fp.leq (fp #b0 #b10000001000 #b11100010)
                expect
                (fp #b0 #b11011110101 #b01111010)))

(assert (= expect result))

(check-sat)
(exit)
