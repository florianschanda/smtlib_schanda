; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b010010011010011 #b10110)
                arg1
                (fp #b0 #b010101111001100 #b11100)))
(assert (fp.leq (fp #b0 #b010101111001100 #b11100)
                arg1
                (fp #b0 #b111100101000110 #b10110)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111100001100100 #b11000)
                arg2
                (fp #b1 #b111100001010101 #b01001)))
(assert (fp.leq (fp #b1 #b111100001010101 #b01001)
                arg2
                (fp #b0 #b001000111000000 #b00111)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b011001010111010 #b00111)
                expect
                (fp #b0 #b111100001010101 #b01010)))
(assert (fp.leq (fp #b0 #b111100001010101 #b01010)
                expect
                (fp #b0 #b111101000000110 #b11111)))

(assert (not (= expect result)))

(check-sat)
(exit)
