(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110110010011 #b0010)
                arg1
                (fp #b0 #b111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111)
                arg1
                (fp #b0 #b111111111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b001011111001 #b0011)
                arg2
                (fp #b0 #b011101111100 #b0100)))
(assert (fp.leq (fp #b0 #b011101111100 #b0100)
                arg2
                (fp #b0 #b111010101110 #b1110)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111001011011 #b1100)
                expect
                (fp #b0 #b111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111)
                expect
                (fp #b0 #b111111111111 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
