(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0110110100101110 #b1100100110)
                arg1
                (fp #b0 #b0000000000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100000000)
                arg1
                (fp #b0 #b1001001101100000 #b1110000101)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1000110111001011 #b1000011000)
                arg2
                (fp #b1 #b0111111111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b0000000000)
                arg2
                (fp #b1 #b0111101010011101 #b0000001011)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1101111111011111 #b1011010100)
                expect
                (fp #b0 #b0111111111111111 #b0000000001)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b0000000001)
                expect
                (fp #b0 #b1111100100000101 #b0011010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
