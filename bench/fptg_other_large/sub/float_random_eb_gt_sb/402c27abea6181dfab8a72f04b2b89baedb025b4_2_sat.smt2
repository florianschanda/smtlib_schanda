(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1110011010010 #b0000111)
                arg1
                (fp #b0 #b0000101101101 #b1111101)))
(assert (fp.leq (fp #b0 #b0000101101101 #b1111101)
                arg1
                (fp #b0 #b1100010100110 #b0110001)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1001101100110 #b0111001)
                arg2
                (fp #b1 #b0000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1101110)
                arg2
                (fp #b0 #b1001011101001 #b1011000)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1100111111110 #b1011101)
                expect
                (fp #b0 #b0000101101101 #b1111110)))
(assert (fp.leq (fp #b0 #b0000101101101 #b1111110)
                expect
                (fp #b0 #b1010011101111 #b0111010)))

(assert (= expect result))

(check-sat)
(exit)
