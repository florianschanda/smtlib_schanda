;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b01001010101001 #b00001011011)
                arg1
                (fp #b0 #b00111111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b00111111111010 #b01101010000)
                arg1
                (fp #b0 #b01111110110011 #b00101111100)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11111111111111 #b00000000000)
                arg2
                (fp #b1 #b11111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11111111111)
                arg2
                (fp #b0 #b10000000001001 #b00001101111)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11000011110011 #b01010110000)
                expect
                (fp #b0 #b11111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b11111111111)
                expect
                (fp #b0 #b11111111111111 #b00000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
