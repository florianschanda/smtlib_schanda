(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10010111001110 #b100)
                arg1
                (fp #b0 #b10000000000011 #b000)))
(assert (fp.leq (fp #b0 #b10000000000011 #b000)
                arg1
                (fp #b0 #b10100010000010 #b000)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01000111111001 #b011)
                arg2
                (fp #b1 #b00000000000000 #b011)))
(assert (fp.leq (fp #b1 #b00000000000000 #b011)
                arg2
                (fp #b0 #b00100011001110 #b101)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00000000110111 #b100)
                expect
                (fp #b0 #b10000000000011 #b001)))
(assert (fp.leq (fp #b0 #b10000000000011 #b001)
                expect
                (fp #b0 #b10101010100010 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
