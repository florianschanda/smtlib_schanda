(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001011101 #b0100)
                arg1
                (fp #b0 #b0111111111 #b0100)))
(assert (fp.leq (fp #b0 #b0111111111 #b0100)
                arg1
                (fp #b0 #b1111001010 #b0001)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110100100 #b0101)
                arg2
                (fp #b0 #b0010001111 #b0001)))
(assert (fp.leq (fp #b0 #b0010001111 #b0001)
                arg2
                (fp #b0 #b0011000010 #b0100)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0110001100 #b1100)
                expect
                (fp #b0 #b0111111111 #b0011)))
(assert (fp.leq (fp #b0 #b0111111111 #b0011)
                expect
                (fp #b0 #b1101110111 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
