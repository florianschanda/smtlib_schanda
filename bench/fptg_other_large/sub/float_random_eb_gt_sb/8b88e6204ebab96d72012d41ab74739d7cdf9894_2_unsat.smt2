;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0011001010001110 #b1001011)
                arg1
                (fp #b1 #b0000000000000000 #b0111101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0111101)
                arg1
                (fp #b0 #b1100110001101011 #b1001010)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1101110100001101 #b0100110)
                arg2
                (fp #b1 #b1001010010010010 #b0010001)))
(assert (fp.leq (fp #b1 #b1001010010010010 #b0010001)
                arg2
                (fp #b0 #b0110000110101111 #b1111101)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b0 #b0011111011011100 #b0100011)
                expect
                (fp #b0 #b1001010010010010 #b0010001)))
(assert (fp.leq (fp #b0 #b1001010010010010 #b0010001)
                expect
                (fp #b0 #b1100001011010100 #b0001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
