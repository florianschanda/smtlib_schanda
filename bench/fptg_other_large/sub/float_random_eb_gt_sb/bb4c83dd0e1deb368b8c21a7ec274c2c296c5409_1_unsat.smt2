(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10101010010 #b0001)
                arg1
                (fp #b0 #b00000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001)
                arg1
                (fp #b0 #b10100111110 #b0100)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01000000100 #b0110)
                arg2
                (fp #b0 #b01111101110 #b1100)))
(assert (fp.leq (fp #b0 #b01111101110 #b1100)
                arg2
                (fp #b0 #b10011110011 #b0010)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000011010 #b0001)
                expect
                (fp #b1 #b01111101110 #b1011)))
(assert (fp.leq (fp #b1 #b01111101110 #b1011)
                expect
                (fp #b0 #b11000101001 #b1110)))

(assert (not (= expect result)))

(check-sat)
(exit)
