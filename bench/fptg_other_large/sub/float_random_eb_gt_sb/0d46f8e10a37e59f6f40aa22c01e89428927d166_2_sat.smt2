(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111011100 #b10000110)
                arg1
                (fp #b1 #b1101010010 #b01101101)))
(assert (fp.leq (fp #b1 #b1101010010 #b01101101)
                arg1
                (fp #b1 #b1011100111 #b10100011)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0010000011 #b01010100)
                arg2
                (fp #b0 #b0111111111 #b11100111)))
(assert (fp.leq (fp #b0 #b0111111111 #b11100111)
                arg2
                (fp #b0 #b1010110011 #b01101101)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111100011 #b01111100)
                expect
                (fp #b1 #b1101010010 #b01101110)))
(assert (fp.leq (fp #b1 #b1101010010 #b01101110)
                expect
                (fp #b0 #b1100010101 #b10000000)))

(assert (= expect result))

(check-sat)
(exit)
