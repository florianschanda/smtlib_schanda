; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111111101 #b011001110)
                arg1
                (fp #b1 #b11111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b000000000)
                arg1
                (fp #b0 #b10011100110 #b101010100)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00000101010 #b110000010)
                arg2
                (fp #b0 #b01000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b000000000)
                arg2
                (fp #b0 #b11011100001 #b000010100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111111101 #b100110001)
                expect
                (fp #b1 #b11111111101 #b000000001)))
(assert (fp.leq (fp #b1 #b11111111101 #b000000001)
                expect
                (fp #b1 #b00111101110 #b100000011)))

(assert (= expect result))

(check-sat)
(exit)
