; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11110011000110111 #b011110110110000)
                arg1
                (fp #b0 #b10001111011101011 #b100000100100101)))
(assert (fp.leq (fp #b0 #b10001111011101011 #b100000100100101)
                arg1
                (fp #b0 #b10111001110110000 #b101110001010101)))

(declare-const arg2 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b01011111010111101 #b111111110011100)
                arg2
                (fp #b0 #b00000000000000001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000001 #b000000000000000)
                arg2
                (fp #b0 #b00101100010111101 #b001011000101011)))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b01001010111011110 #b000010111001100)
                expect
                (fp #b0 #b10001111011101011 #b100000100100100)))
(assert (fp.leq (fp #b0 #b10001111011101011 #b100000100100100)
                expect
                (fp #b0 #b11001100001110100 #b011111100010010)))

(assert (= expect result))

(check-sat)
(exit)
