(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101011100 #b100010)
                arg1
                (fp #b0 #b000000000 #b000001)))
(assert (fp.leq (fp #b0 #b000000000 #b000001)
                arg1
                (fp #b0 #b100111001 #b101100)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111111110 #b110101)
                arg2
                (fp #b1 #b101111110 #b111111)))
(assert (fp.leq (fp #b1 #b101111110 #b111111)
                arg2
                (fp #b0 #b110011110 #b010011)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110011110 #b000110)
                expect
                (fp #b0 #b101111111 #b000000)))
(assert (fp.leq (fp #b0 #b101111111 #b000000)
                expect
                (fp #b0 #b110010001 #b111001)))

(assert (= expect result))

(check-sat)
(exit)
