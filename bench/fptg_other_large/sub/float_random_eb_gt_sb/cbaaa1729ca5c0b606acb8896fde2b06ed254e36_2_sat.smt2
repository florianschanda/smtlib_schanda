(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110011101010 #b01)
                arg1
                (fp #b1 #b101101111101 #b10)))
(assert (fp.leq (fp #b1 #b101101111101 #b10)
                arg1
                (fp #b0 #b001100110100 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111110011110 #b01)
                arg2
                (fp #b1 #b101100110010 #b10)))
(assert (fp.leq (fp #b1 #b101100110010 #b10)
                arg2
                (fp #b0 #b011110001010 #b01)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111011110010 #b00)
                expect
                (fp #b1 #b101101111101 #b10)))
(assert (fp.leq (fp #b1 #b101101111101 #b10)
                expect
                (fp #b0 #b110000111110 #b00)))

(assert (= expect result))

(check-sat)
(exit)
