(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b011101011010011 #b110)
                arg1
                (fp #b0 #b101111111111110 #b111)))
(assert (fp.leq (fp #b0 #b101111111111110 #b111)
                arg1
                (fp #b0 #b111100001011101 #b011)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b010011000111001 #b001)
                arg2
                (fp #b0 #b000000000000000 #b111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b111)
                arg2
                (fp #b0 #b000111011101011 #b010)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b010001001000110 #b001)
                expect
                (fp #b0 #b101111111111110 #b111)))
(assert (fp.leq (fp #b0 #b101111111111110 #b111)
                expect
                (fp #b0 #b111000010100010 #b011)))

(assert (= expect result))

(check-sat)
(exit)
