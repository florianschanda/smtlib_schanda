(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0001000000 #b0101)
                arg1
                (fp #b0 #b1001111100 #b0001)))
(assert (fp.leq (fp #b0 #b1001111100 #b0001)
                arg1
                (fp #b0 #b1100101011 #b1001)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0011111010 #b0111)
                arg2
                (fp #b0 #b0000000000 #b0001)))
(assert (fp.leq (fp #b0 #b0000000000 #b0001)
                arg2
                (fp #b0 #b1111101011 #b0001)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0011100000 #b1011)
                expect
                (fp #b0 #b1001111100 #b0001)))
(assert (fp.leq (fp #b0 #b1001111100 #b0001)
                expect
                (fp #b0 #b1111010100 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
