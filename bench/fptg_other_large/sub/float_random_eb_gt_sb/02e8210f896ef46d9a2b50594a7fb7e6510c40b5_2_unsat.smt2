(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b00011011011 #b10)
                arg1
                (fp #b0 #b10110101100 #b10)))
(assert (fp.leq (fp #b0 #b10110101100 #b10)
                arg1
                (fp #b0 #b11010001101 #b10)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11110101011 #b00)
                arg2
                (fp #b1 #b00000000001 #b00)))
(assert (fp.leq (fp #b1 #b00000000001 #b00)
                arg2
                (fp #b0 #b01000001010 #b00)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11011101011 #b00)
                expect
                (fp #b0 #b10110101100 #b11)))
(assert (fp.leq (fp #b0 #b10110101100 #b11)
                expect
                (fp #b0 #b11011000000 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
