(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b0100101101101101 #b100101111)
                arg1
                (fp #b0 #b0111111111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b111111100)
                arg1
                (fp #b0 #b1001100110101010 #b111001001)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0110101011101001 #b100100010)
                expect
                (fp #b0 #b0000000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000)
                expect
                (fp #b0 #b0111000010101111 #b100010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
