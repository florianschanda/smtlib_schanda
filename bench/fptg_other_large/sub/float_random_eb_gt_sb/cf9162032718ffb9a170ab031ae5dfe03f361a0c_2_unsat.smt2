(assert (fp.leq (fp #b0 #b001111111111100 #b0110101)
                arg2
                (fp #b0 #b110010001000111 #b1010011)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b010111001000111 #b1110110)
                expect
                (fp #b1 #b001111111111100 #b0110101)))
(assert (fp.leq (fp #b1 #b001111111111100 #b0110101)
                expect
                (fp #b0 #b101011001100100 #b0100111)))

(assert (not (= expect result)))

(check-sat)
