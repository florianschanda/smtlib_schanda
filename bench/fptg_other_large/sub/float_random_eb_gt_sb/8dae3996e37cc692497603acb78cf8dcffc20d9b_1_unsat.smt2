(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b001101101111000 #b1110)
                arg2
                (fp #b0 #b100000000000001 #b1000)))
(assert (fp.leq (fp #b0 #b100000000000001 #b1000)
                arg2
                (fp #b0 #b101101000110010 #b1010)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
