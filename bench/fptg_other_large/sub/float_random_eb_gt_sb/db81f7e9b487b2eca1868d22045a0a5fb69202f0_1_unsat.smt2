                arg2
                (fp #b1 #b10000000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000000010 #b00)
                arg2
                (fp #b1 #b01110111011010 #b10)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b00101111011000 #b10)
                expect
                (fp #b0 #b10000000000010 #b11)))
(assert (fp.leq (fp #b0 #b10000000000010 #b11)
                expect
                (fp #b0 #b11011011011011 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
