;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b01010000100000 #b01)
                arg1
                (fp #b0 #b10000000000001 #b10)))
(assert (fp.leq (fp #b0 #b10000000000001 #b10)
                arg1
