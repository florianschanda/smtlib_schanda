(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b011101001000 #b1)
                arg1
                (fp #b0 #b111111100010 #b1)))
(assert (fp.leq (fp #b0 #b111111100010 #b1)
                arg1
                (fp #b0 #b111111111011 #b0)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b0 #b001010000101 #b1)
                arg2
                (fp #b0 #b101111111110 #b1)))
(assert (fp.leq (fp #b0 #b101111111110 #b1)
                arg2
                (fp #b0 #b110010111101 #b0)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b001010011010 #b1)
                expect
                (fp #b0 #b111111100010 #b1)))
(assert (fp.leq (fp #b0 #b111111100010 #b1)
                expect
                (fp #b0 #b111111111100 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
