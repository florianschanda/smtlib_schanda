(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b00000010111101 #b001111)
                arg1
                (fp #b0 #b10000000000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000000000110 #b000000)
                arg1
                (fp #b0 #b10111011101010 #b100110)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11111111111101 #b000100)
                arg2
                (fp #b1 #b11111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000000)
                arg2
                (fp #b1 #b01011000111010 #b111101)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b11101111000001 #b011100)
                expect
                (fp #b0 #b11111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b000000)
                expect
                (fp #b0 #b11111111111110 #b111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
