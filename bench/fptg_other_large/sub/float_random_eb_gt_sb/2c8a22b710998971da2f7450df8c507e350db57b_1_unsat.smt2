; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111001101 #b0011100)
                arg1
                (fp #b1 #b001111100 #b0110101)))
(assert (fp.leq (fp #b1 #b001111100 #b0110101)
                arg1
                (fp #b0 #b010010101 #b0001100)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b001110100 #b0010100)
                arg2
                (fp #b0 #b100000110 #b0000001)))
(assert (fp.leq (fp #b0 #b100000110 #b0000001)
                arg2
                (fp #b0 #b101100100 #b0011010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111001111 #b0111001)
                expect
                (fp #b1 #b100000110 #b0000001)))
(assert (fp.leq (fp #b1 #b100000110 #b0000001)
                expect
                (fp #b0 #b010111111 #b1100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
