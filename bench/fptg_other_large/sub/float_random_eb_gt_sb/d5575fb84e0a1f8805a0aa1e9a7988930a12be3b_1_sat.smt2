(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b110111010011 #b01101101)
                arg1
                (fp #b0 #b111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000)
                arg1
                (fp #b0 #b111111111110 #b00100111)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111111011100 #b11111100)
                arg2
                (fp #b1 #b110101111111 #b00100000)))
(assert (fp.leq (fp #b1 #b110101111111 #b00100000)
                arg2
                (fp #b1 #b001011100010 #b11001001)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011100111010 #b01100101)
                expect
                (fp #b0 #b111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000)
                expect
                (fp #b0 #b111111111110 #b11110000)))

(assert (= expect result))

(check-sat)
(exit)
