(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b000111100010 #b0001)
                arg1
                (fp #b0 #b000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b000000000000 #b0001)
                arg1
                (fp #b0 #b011100000011 #b1100)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110100100010 #b1001)
                arg2
                (fp #b1 #b101111011001 #b1100)))
(assert (fp.leq (fp #b1 #b101111011001 #b1100)
                arg2
                (fp #b1 #b100110000111 #b0010)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b010101100111 #b1100)
                expect
                (fp #b0 #b101111011001 #b1101)))
(assert (fp.leq (fp #b0 #b101111011001 #b1101)
                expect
                (fp #b0 #b111101001001 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
