(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11011000111001 #b1011)
                arg1
                (fp #b1 #b00000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100)
                arg1
                (fp #b0 #b10000001000111 #b0110)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10101111001001 #b1100)
                arg2
                (fp #b1 #b10000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b0000)
                arg2
                (fp #b1 #b00001001100101 #b1000)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11100000001110 #b0111)
                expect
                (fp #b0 #b10000000000011 #b1111)))
(assert (fp.leq (fp #b0 #b10000000000011 #b1111)
                expect
                (fp #b0 #b10000100001011 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
