(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b011010111100 #b1001111100)
                arg1
                (fp #b0 #b011111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b011111111111 #b1001100100)
                arg1
                (fp #b0 #b100111101010 #b1000010011)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111111111111 #b0000000000)
                arg2
                (fp #b1 #b111111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b1111111111)
                arg2
                (fp #b1 #b001010100001 #b1111010111)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
