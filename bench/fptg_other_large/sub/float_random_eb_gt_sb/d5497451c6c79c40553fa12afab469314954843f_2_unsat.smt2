(assert (fp.leq (fp #b1 #b1010011110011 #b011011)
                arg2
                (fp #b1 #b1010001000011 #b100100)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0111110111010 #b011011)
                expect
                (fp #b0 #b1010011110011 #b011100)))
(assert (fp.leq (fp #b0 #b1010011110011 #b011100)
                expect
                (fp #b0 #b1011001110000 #b011100)))

(assert (not (= expect result)))

(check-sat)
