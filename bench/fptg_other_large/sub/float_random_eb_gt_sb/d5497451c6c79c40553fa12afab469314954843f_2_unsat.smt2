;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1100101101111 #b100110)
                arg1
                (fp #b0 #b0000000000000 #b000001)))
