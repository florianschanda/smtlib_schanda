(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101011010101110 #b10111)
                arg1
                (fp #b1 #b100010000001100 #b11011)))
(assert (fp.leq (fp #b1 #b100010000001100 #b11011)
                arg1
                (fp #b0 #b111100010010100 #b11101)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101110010101100 #b10110)
                arg2
                (fp #b1 #b100000000000010 #b11000)))
(assert (fp.leq (fp #b1 #b100000000000010 #b11000)
                arg2
                (fp #b1 #b000101101000010 #b10101)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b110010010110110 #b00111)
                expect
                (fp #b1 #b100010000001100 #b11011)))
(assert (fp.leq (fp #b1 #b100010000001100 #b11011)
                expect
                (fp #b0 #b010110100000110 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
