(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111011011001011 #b00)
                arg1
                (fp #b1 #b100000000000000 #b10)))
(assert (fp.leq (fp #b1 #b100000000000000 #b10)
                arg1
                (fp #b1 #b010101001010011 #b00)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b001001010111110 #b00)
                arg2
                (fp #b0 #b111111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00)
                arg2
                (fp #b0 #b111111111111110 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111111111111110 #b01)
                expect
                (fp #b1 #b111111111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00)
                expect
                (fp #b1 #b001000000101100 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
