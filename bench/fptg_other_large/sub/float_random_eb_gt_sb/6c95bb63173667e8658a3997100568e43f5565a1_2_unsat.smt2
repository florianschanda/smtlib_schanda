(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10101011100 #b111110011)
                arg1
                (fp #b1 #b01000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b000000000)
                arg1
                (fp #b0 #b01001100011 #b011100100)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01011000010 #b000101101)
                arg2
                (fp #b1 #b01000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b000000000)
                arg2
                (fp #b0 #b10001100110 #b100101100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00010110001 #b010001000)
                expect
                (fp #b1 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000000)
                expect
                (fp #b0 #b00011001100 #b100010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
