; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00000001111010 #b110011111)
                arg1
                (fp #b0 #b10010011001111 #b110110001)))
(assert (fp.leq (fp #b0 #b10010011001111 #b110110001)
                arg1
                (fp #b0 #b10010110111000 #b011000010)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10110011110000 #b101011000)
                arg2
                (fp #b1 #b01111111111111 #b001111111)))
(assert (fp.leq (fp #b1 #b01111111111111 #b001111111)
                arg2
                (fp #b0 #b01011001101101 #b010001001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10001001111101 #b010110001)
                expect
                (fp #b0 #b10010011001111 #b110110010)))
(assert (fp.leq (fp #b0 #b10010011001111 #b110110010)
                expect
                (fp #b0 #b11001010101111 #b001000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
