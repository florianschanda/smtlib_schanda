; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1010010001110001 #b000011)
                arg1
                (fp #b1 #b0000000000000000 #b111111)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b111111)
                arg1
                (fp #b0 #b1010001001010001 #b110001)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1000001110100011 #b001101)
                arg2
                (fp #b0 #b1000000000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000000000110 #b000000)
                arg2
                (fp #b0 #b1001000011000010 #b111101)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1010001110001000 #b011111)
                expect
                (fp #b1 #b1000000000000110 #b000001)))
(assert (fp.leq (fp #b1 #b1000000000000110 #b000001)
                expect
                (fp #b1 #b0101101001000100 #b101011)))

(assert (= expect result))

(check-sat)
(exit)
