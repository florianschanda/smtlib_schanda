(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1011001110001100 #b101111)
                arg1
                (fp #b1 #b1000000000000101 #b011101)))
(assert (fp.leq (fp #b1 #b1000000000000101 #b011101)
                arg1
                (fp #b0 #b1110110000100001 #b111000)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0101110001101001 #b001000)
                arg2
                (fp #b1 #b0000000000000001 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b000000)
                arg2
                (fp #b0 #b0001001111010000 #b010010)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1011010101110101 #b111000)
                expect
                (fp #b1 #b1000000000000101 #b011101)))
(assert (fp.leq (fp #b1 #b1000000000000101 #b011101)
                expect
                (fp #b0 #b0101110101011110 #b000101)))

(assert (= expect result))

(check-sat)
(exit)
