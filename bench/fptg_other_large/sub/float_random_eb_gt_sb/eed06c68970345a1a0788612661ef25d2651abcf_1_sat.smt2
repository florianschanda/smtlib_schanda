                arg2
                (fp #b1 #b0101100110000 #b1110100101)))
(assert (fp.leq (fp #b1 #b0101100110000 #b1110100101)
                arg2
                (fp #b1 #b0100100001110 #b0011100011)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1101000001110 #b1010010011)
                expect
                (fp #b0 #b0101100110000 #b1110100101)))
(assert (fp.leq (fp #b0 #b0101100110000 #b1110100101)
                expect
                (fp #b0 #b1011101100101 #b1101011100)))

(assert (= expect result))

(check-sat)
(exit)
