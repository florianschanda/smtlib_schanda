;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1101001011000 #b0010110110)
                arg1
                (fp #b0 #b0001000101101 #b0110110110)))
(assert (fp.leq (fp #b0 #b0001000101101 #b0110110110)
                arg1
                (fp #b0 #b1110101011001 #b1100110010)))

