(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111000 #b1010000)
                arg1
                (fp #b1 #b111011000 #b0110010)))
(assert (fp.leq (fp #b1 #b111011000 #b0110010)
                arg1
                (fp #b0 #b001001000 #b1001101)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b010101001 #b0110100)
                arg2
                (fp #b0 #b100000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000111 #b0000000)
                arg2
                (fp #b0 #b110100001 #b0011010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111101011 #b1011010)
                expect
                (fp #b1 #b111011000 #b0110010)))
(assert (fp.leq (fp #b1 #b111011000 #b0110010)
                expect
                (fp #b1 #b010101100 #b1010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
