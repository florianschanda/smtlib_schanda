(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111010010 #b1011101)
                arg1
                (fp #b1 #b0010100011 #b0100100)))
(assert (fp.leq (fp #b1 #b0010100011 #b0100100)
                arg1
                (fp #b0 #b0110010101 #b0100001)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101100111 #b1001101)
                arg2
                (fp #b1 #b1010010000 #b1110100)))
(assert (fp.leq (fp #b1 #b1010010000 #b1110100)
                arg2
                (fp #b0 #b1011001010 #b0111110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0000100111 #b1001000)
                expect
                (fp #b0 #b1010010000 #b1110011)))
(assert (fp.leq (fp #b0 #b1010010000 #b1110011)
                expect
                (fp #b0 #b1100110101 #b1000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
