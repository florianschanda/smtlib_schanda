                (fp #b0 #b0000000000000001 #b0000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b0000)
                arg2
                (fp #b0 #b0111000001111100 #b1111)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0001001101010111 #b1001)
                expect
                (fp #b1 #b0000000000000001 #b1000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b1000)
                expect
                (fp #b0 #b1110111110010100 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
