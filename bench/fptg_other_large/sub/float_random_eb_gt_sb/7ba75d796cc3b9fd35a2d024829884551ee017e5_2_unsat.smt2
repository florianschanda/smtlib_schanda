;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b0 #b0101001111101100 #b111000010100)
                arg1
                (fp #b0 #b1111101110100110 #b000010011010)))
(assert (fp.leq (fp #b0 #b1111101110100110 #b000010011010)
                arg1
                (fp #b0 #b1111101110111111 #b100000110001)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b0 #b1001011001101111 #b101111101011)
                arg2
                (fp #b0 #b1111111111111110 #b111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000)
                expect
                (fp #b1 #b1111111111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111)
                expect
                (fp #b0 #b0001011110011010 #b001010001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
