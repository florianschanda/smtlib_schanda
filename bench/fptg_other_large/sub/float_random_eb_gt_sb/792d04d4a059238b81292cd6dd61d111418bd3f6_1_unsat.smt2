(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101110000111 #b110)
                arg1
                (fp #b1 #b001111111110 #b011)))
(assert (fp.leq (fp #b1 #b001111111110 #b011)
                arg1
                (fp #b1 #b001010011011 #b011)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111010100010 #b010)
                arg2
                (fp #b1 #b110111010111 #b101)))
(assert (fp.leq (fp #b1 #b110111010111 #b101)
                arg2
                (fp #b1 #b000011001010 #b101)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b100110010010 #b001)
                expect
                (fp #b0 #b110111010111 #b100)))
(assert (fp.leq (fp #b0 #b110111010111 #b100)
                expect
                (fp #b0 #b111111010011 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
