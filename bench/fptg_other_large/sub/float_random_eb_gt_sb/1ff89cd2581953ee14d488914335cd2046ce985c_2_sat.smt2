(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110101111010 #b110)
                arg1
                (fp #b0 #b0000000000000 #b111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b111)
                arg1
                (fp #b0 #b1100001101010 #b010)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1010111100100 #b011)
                arg2
                (fp #b1 #b1000000000010 #b100)))
(assert (fp.leq (fp #b1 #b1000000000010 #b100)
                arg2
                (fp #b0 #b1011011100011 #b100)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0011100110101 #b100)
                expect
                (fp #b0 #b1000000000010 #b101)))
(assert (fp.leq (fp #b0 #b1000000000010 #b101)
                expect
                (fp #b0 #b1000100101010 #b000)))

(assert (= expect result))

(check-sat)
(exit)
