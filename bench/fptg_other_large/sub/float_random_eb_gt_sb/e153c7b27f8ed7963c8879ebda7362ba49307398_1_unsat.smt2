(assert (fp.leq (fp #b1 #b011111111111111 #b0000)
                arg2
                (fp #b1 #b001111001110110 #b0010)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b100010000010111 #b1111)
                expect
                (fp #b0 #b101111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b101111111111110 #b1111)
                expect
                (fp #b0 #b111010010101000 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
