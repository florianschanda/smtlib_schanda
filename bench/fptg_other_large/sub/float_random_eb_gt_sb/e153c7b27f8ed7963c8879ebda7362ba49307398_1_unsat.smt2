(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b000111011000011 #b0101)
                arg1
                (fp #b0 #b101111111111110 #b1111)))
