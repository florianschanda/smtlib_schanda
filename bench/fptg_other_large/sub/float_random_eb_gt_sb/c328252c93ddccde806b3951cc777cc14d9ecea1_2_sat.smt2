(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b011101001111 #b00011)
                arg1
                (fp #b0 #b011111111111 #b00111)))
(assert (fp.leq (fp #b0 #b011111111111 #b00111)
                arg1
                (fp #b0 #b110100110100 #b00100)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b0 #b000000010000 #b11000)
                arg2
                (fp #b0 #b100010000111 #b10000)))
(assert (fp.leq (fp #b0 #b100010000111 #b10000)
                arg2
                (fp #b0 #b111100111110 #b11100)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b101111000110 #b10001)
                expect
                (fp #b1 #b100010000111 #b10000)))
(assert (fp.leq (fp #b1 #b100010000111 #b10000)
                expect
                (fp #b0 #b111001110001 #b01110)))

(assert (= expect result))

(check-sat)
(exit)
