(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000111001 #b0000110)
                arg1
                (fp #b0 #b101111110 #b1111111)))
(assert (fp.leq (fp #b0 #b101111110 #b1111111)
                arg1
                (fp #b0 #b110110110 #b1010010)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101111011 #b0100100)
                arg2
                (fp #b1 #b100110111 #b1110100)))
(assert (fp.leq (fp #b1 #b100110111 #b1110100)
                arg2
                (fp #b1 #b011001101 #b1000111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010001100 #b0111110)
                expect
                (fp #b0 #b101111111 #b0000000)))
(assert (fp.leq (fp #b0 #b101111111 #b0000000)
                expect
                (fp #b0 #b110101101 #b0010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
