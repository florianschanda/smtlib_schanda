; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11100001000 #b1000)
                arg1
                (fp #b1 #b00000000000 #b0001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001)
                arg1
                (fp #b0 #b11101001010 #b0101)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111110011 #b1001)
                arg2
                (fp #b1 #b10000000011 #b1110)))
(assert (fp.leq (fp #b1 #b10000000011 #b1110)
                arg2
                (fp #b1 #b01000101010 #b1110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01000110011 #b0101)
                expect
                (fp #b0 #b10000000011 #b1110)))
(assert (fp.leq (fp #b0 #b10000000011 #b1110)
                expect
                (fp #b0 #b11100010110 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
