; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00111110010010 #b11000)
                arg1
                (fp #b1 #b00000000000000 #b00111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00111)
                arg1
                (fp #b0 #b11100000101100 #b00101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11101111000111 #b00101)
                arg2
                (fp #b1 #b01111111111111 #b00000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00000)
                arg2
                (fp #b0 #b10010000100011 #b11001)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b00011110110010 #b11000)
                expect
                (fp #b0 #b01111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b01111111111110 #b11111)
                expect
                (fp #b0 #b11100111110100 #b01111)))

(assert (not (= expect result)))

(check-sat)
(exit)
