; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11101110111100 #b0100101)
                arg1
                (fp #b1 #b00111111111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111111111100 #b0110101)
                arg1
                (fp #b0 #b01000010101110 #b0101101)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01000011000011 #b0000100)
                arg2
                (fp #b0 #b01011011111010 #b0000001)))
(assert (fp.leq (fp #b0 #b01011011111010 #b0000001)
                arg2
                (fp #b0 #b01100000100101 #b0111001)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10011100000101 #b1010010)
                expect
                (fp #b1 #b01011011111010 #b0000010)))
(assert (fp.leq (fp #b1 #b01011011111010 #b0000010)
                expect
                (fp #b0 #b00000001011000 #b1001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
