(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100110010 #b00111)
                arg1
                (fp #b1 #b1100001011 #b01010)))
(assert (fp.leq (fp #b1 #b1100001011 #b01010)
                arg1
                (fp #b0 #b1000000011 #b10111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0110111010 #b11011)
                arg2
                (fp #b1 #b0100000000 #b00000)))
(assert (fp.leq (fp #b1 #b0100000000 #b00000)
                arg2
                (fp #b0 #b0001100001 #b00100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111110011 #b01001)
                expect
                (fp #b1 #b1100001011 #b01010)))
(assert (fp.leq (fp #b1 #b1100001011 #b01010)
                expect
                (fp #b1 #b1000101000 #b00101)))

(assert (= expect result))

(check-sat)
(exit)
