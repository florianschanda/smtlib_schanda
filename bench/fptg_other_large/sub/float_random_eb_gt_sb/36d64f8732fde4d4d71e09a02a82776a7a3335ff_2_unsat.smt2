(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b001011111011 #b010110011)
                arg1
                (fp #b1 #b000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b010000000)
                arg1
                (fp #b0 #b010111100010 #b100100111)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110110100111 #b010111011)
                arg2
                (fp #b1 #b011111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b000000000)
                arg2
                (fp #b1 #b010101110111 #b101000111)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b011110001110 #b001001111)
                expect
                (fp #b0 #b011111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b000000000)
                expect
                (fp #b0 #b100100100011 #b111110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
