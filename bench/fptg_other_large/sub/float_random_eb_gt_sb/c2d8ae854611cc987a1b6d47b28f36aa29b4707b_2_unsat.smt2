(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b001100101101 #b00111011)
                arg1
                (fp #b0 #b001111111100 #b00000000)))
(assert (fp.leq (fp #b0 #b001111111100 #b00000000)
                arg1
                (fp #b0 #b111101000111 #b01001111)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001000101111 #b01110010)
                arg2
                (fp #b1 #b000000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000001)
                arg2
                (fp #b0 #b101100111011 #b00000110)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001000010111 #b11110000)
                expect
                (fp #b0 #b001111111100 #b00000001)))
(assert (fp.leq (fp #b0 #b001111111100 #b00000001)
                expect
                (fp #b0 #b011101100100 #b00101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
