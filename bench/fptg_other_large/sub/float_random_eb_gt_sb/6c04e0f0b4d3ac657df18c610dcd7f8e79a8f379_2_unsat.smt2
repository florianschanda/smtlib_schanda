;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0001101010111110 #b00100)
                arg1
                (fp #b0 #b0010011101101011 #b10100)))
(assert (fp.leq (fp #b0 #b0010011101101011 #b10100)
                arg1
                (fp #b0 #b1011101100010111 #b11111)))

