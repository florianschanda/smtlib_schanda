(assert (fp.leq (fp #b1 #b1100011011010111 #b10000)
                arg2
                (fp #b1 #b1000000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000000000101 #b00000)
                arg2
                (fp #b0 #b1010100001011011 #b10110)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0000101000001001 #b11000)
                expect
                (fp #b0 #b1000000000000101 #b00001)))
(assert (fp.leq (fp #b0 #b1000000000000101 #b00001)
                expect
                (fp #b0 #b1001011111100101 #b00001)))

(assert (not (= expect result)))

(check-sat)
(exit)
