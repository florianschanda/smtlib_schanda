(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0111111010 #b01110100)
                arg1
                (fp #b0 #b0000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000001)
                arg1
                (fp #b0 #b1010110010 #b01010101)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0100010110 #b01000111)
                arg2
                (fp #b0 #b0010011101 #b00010101)))
(assert (fp.leq (fp #b0 #b0010011101 #b00010101)
                arg2
                (fp #b0 #b0110101101 #b01011000)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110000000 #b01000010)
                expect
                (fp #b1 #b0010011101 #b00010101)))
(assert (fp.leq (fp #b1 #b0010011101 #b00010101)
                expect
                (fp #b0 #b0101100101 #b00001101)))

(assert (= expect result))

(check-sat)
(exit)
