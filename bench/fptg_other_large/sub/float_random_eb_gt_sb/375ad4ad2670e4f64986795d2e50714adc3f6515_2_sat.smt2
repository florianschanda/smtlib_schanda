; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00111010110 #b001111010)
                arg1
                (fp #b0 #b01111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b000000000)
                arg1
                (fp #b0 #b10100101111 #b111101011)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01001011000 #b111110111)
                arg2
                (fp #b0 #b00000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b111111111)
                arg2
                (fp #b0 #b00110001000 #b101111010)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01111011001 #b010110011)
                expect
                (fp #b0 #b01111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b000000000)
                expect
                (fp #b0 #b10110001011 #b111110010)))

(assert (= expect result))

(check-sat)
(exit)
