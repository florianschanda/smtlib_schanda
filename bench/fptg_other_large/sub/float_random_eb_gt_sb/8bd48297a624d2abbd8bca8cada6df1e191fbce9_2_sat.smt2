(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1010100101101 #b1010111)
                arg1
                (fp #b0 #b0000000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000001 #b0000000)
                arg1
                (fp #b0 #b0100110010000 #b1101110)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b0 #b0010101111100 #b0111111)
                arg2
                (fp #b0 #b0011111111100 #b0110101)))
(assert (fp.leq (fp #b0 #b0011111111100 #b0110101)
                arg2
                (fp #b0 #b0100001001000 #b0010010)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1110110010011 #b1011011)
                expect
                (fp #b1 #b0011111111100 #b0110101)))
(assert (fp.leq (fp #b1 #b0011111111100 #b0110101)
                expect
                (fp #b0 #b1100010110001 #b0011001)))

(assert (= expect result))

(check-sat)
(exit)
