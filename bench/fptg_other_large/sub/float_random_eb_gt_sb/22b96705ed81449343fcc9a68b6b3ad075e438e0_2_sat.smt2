(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0101100111 #b01000001)
                arg1
                (fp #b0 #b0000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b10100110)
                arg1
                (fp #b0 #b1101011000 #b01001001)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110100011 #b01001110)
                arg2
                (fp #b0 #b0010011101 #b00010101)))
(assert (fp.leq (fp #b0 #b0010011101 #b00010101)
                arg2
                (fp #b0 #b0111110101 #b00101000)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1010011010 #b10010011)
                expect
                (fp #b1 #b0010011101 #b00010101)))
(assert (fp.leq (fp #b1 #b0010011101 #b00010101)
                expect
                (fp #b0 #b0001001100 #b11001000)))

(assert (= expect result))

(check-sat)
(exit)
