(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001101010011 #b01110000)
                arg1
                (fp #b0 #b000000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b000000000000 #b01010111)
                arg1
                (fp #b0 #b001111111000 #b10110111)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110110101000 #b01111110)
                arg2
                (fp #b0 #b111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111)
                arg2
                (fp #b0 #b111111111111 #b00000000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000)
                expect
                (fp #b1 #b111111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111)
                expect
                (fp #b1 #b110001101011 #b01100011)))

(assert (= expect result))

(check-sat)
(exit)
