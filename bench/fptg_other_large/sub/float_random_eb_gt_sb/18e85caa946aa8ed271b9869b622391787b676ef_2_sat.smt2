; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b0101100010101111 #b1001010001101)
                arg1
                (fp #b0 #b0000000000000000 #b0000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000000001)
                arg1
                (fp #b0 #b1000100000000100 #b0110000101001)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1010011010100111 #b1010011011110)
                arg2
                (fp #b1 #b1001000001010010 #b0001111001110)))
(assert (fp.leq (fp #b1 #b1001000001010010 #b0001111001110)
                arg2
                (fp #b0 #b1010101001000111 #b1001011110110)))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1001101110101001 #b1011011001101)
                expect
                (fp #b0 #b1001000001010010 #b0001111001111)))
(assert (fp.leq (fp #b0 #b1001000001010010 #b0001111001111)
                expect
                (fp #b0 #b1011000001010111 #b1000111110000)))

(assert (= expect result))

(check-sat)
(exit)
