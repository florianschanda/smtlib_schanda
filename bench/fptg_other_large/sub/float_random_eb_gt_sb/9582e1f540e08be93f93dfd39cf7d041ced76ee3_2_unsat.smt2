(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1000001100 #b0)
                arg1
                (fp #b1 #b0011111111 #b1)))
(assert (fp.leq (fp #b1 #b0011111111 #b1)
                arg1
                (fp #b0 #b0101101110 #b0)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0111011001 #b0)
                arg2
                (fp #b0 #b0111111111 #b0)))
(assert (fp.leq (fp #b0 #b0111111111 #b0)
                arg2
                (fp #b0 #b1000011110 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1010011111 #b1)
                expect
                (fp #b1 #b0111111111 #b1)))
(assert (fp.leq (fp #b1 #b0111111111 #b1)
                expect
                (fp #b0 #b1110000001 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
