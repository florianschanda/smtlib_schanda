(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11101011100 #b00)
                arg1
                (fp #b1 #b10111110011 #b10)))
(assert (fp.leq (fp #b1 #b10111110011 #b10)
                arg1
                (fp #b0 #b00111010010 #b11)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01010000000 #b01)
                arg2
                (fp #b0 #b00000000000 #b11)))
(assert (fp.leq (fp #b0 #b00000000000 #b11)
                arg2
                (fp #b0 #b01110000010 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11100100000 #b01)
                expect
                (fp #b1 #b10111110011 #b11)))
(assert (fp.leq (fp #b1 #b10111110011 #b11)
                expect
                (fp #b0 #b00111101001 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
