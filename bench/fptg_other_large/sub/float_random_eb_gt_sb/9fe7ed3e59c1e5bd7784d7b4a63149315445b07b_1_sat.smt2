(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11000101101010 #b110000101)
                arg1
                (fp #b0 #b10010011001111 #b110110001)))
(assert (fp.leq (fp #b0 #b10010011001111 #b110110001)
                arg1
                (fp #b0 #b10110110011100 #b001101010)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11100110010001 #b100100000)
                expect
                (fp #b0 #b10010011010000 #b110110001)))
(assert (fp.leq (fp #b0 #b10010011010000 #b110110001)
                expect
                (fp #b0 #b11011010110001 #b100101111)))

(assert (= expect result))

(check-sat)
(exit)
