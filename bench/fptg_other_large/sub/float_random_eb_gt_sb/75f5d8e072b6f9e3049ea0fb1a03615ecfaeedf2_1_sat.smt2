; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11010110101110 #b00110010010)
                arg1
                (fp #b0 #b10000000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b10000000001011 #b00000000000)
                arg1
                (fp #b0 #b11000100111011 #b11110011011)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b0 #b10100111011000 #b10011010101)
                arg2
                (fp #b0 #b11111011011000 #b11001110100)))
(assert (fp.leq (fp #b0 #b11111011011000 #b11001110100)
                arg2
                (fp #b0 #b11111100001111 #b01101000101)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11111100111101 #b00111100100)
                expect
                (fp #b1 #b11111011011000 #b11001110011)))
(assert (fp.leq (fp #b1 #b11111011011000 #b11001110011)
                expect
                (fp #b1 #b11011011111001 #b00110111110)))

(assert (= expect result))

(check-sat)
(exit)
