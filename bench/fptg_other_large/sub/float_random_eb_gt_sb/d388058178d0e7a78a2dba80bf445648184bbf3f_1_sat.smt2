(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b00000001101100 #b010100)
                arg1
                (fp #b1 #b00000000000000 #b010000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000)
                arg1
                (fp #b0 #b00001011100101 #b110110)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11111111111111 #b000000)
                arg2
                (fp #b1 #b11111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111111)
                arg2
                (fp #b0 #b01101010110111 #b011110)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b11100010001101 #b101000)
                expect
                (fp #b0 #b11111111111110 #b111110)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111110)
                expect
                (fp #b0 #b11111111111111 #b000000)))

(assert (= expect result))

(check-sat)
(exit)
