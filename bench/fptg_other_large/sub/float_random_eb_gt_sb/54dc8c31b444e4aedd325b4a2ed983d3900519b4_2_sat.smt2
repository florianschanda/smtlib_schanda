(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b0 #b010101010001011 #b1101000)
                arg1
                (fp #b0 #b111111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b0000000)
                arg1
                (fp #b0 #b111111111111101 #b1001110)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b0 #b010010111101011 #b1011000)
                arg2
                (fp #b0 #b011000011110101 #b1011100)))
(assert (fp.leq (fp #b0 #b011000011110101 #b1011100)
                arg2
                (fp #b0 #b101100000111001 #b1001010)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b011101000000110 #b1100110)
                expect
                (fp #b0 #b111111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b0000000)
                expect
                (fp #b0 #b111111111111110 #b1000100)))

(assert (= expect result))

(check-sat)
(exit)
