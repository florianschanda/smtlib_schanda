; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101111101 #b00110)
                arg1
                (fp #b1 #b000000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000000 #b00001)
                arg1
                (fp #b0 #b110000101 #b01100)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b000000111 #b00100)
                arg2
                (fp #b0 #b011111111 #b00000)))
(assert (fp.leq (fp #b0 #b011111111 #b00000)
                arg2
                (fp #b0 #b111000110 #b10011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110101101 #b11011)
                expect
                (fp #b1 #b011111111 #b00000)))
(assert (fp.leq (fp #b1 #b011111111 #b00000)
                expect
                (fp #b0 #b110100100 #b11010)))

(assert (not (= expect result)))

(check-sat)
(exit)
