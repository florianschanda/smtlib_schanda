(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011111110 #b01111)
                arg1
                (fp #b0 #b0000000000 #b11101)))
(assert (fp.leq (fp #b0 #b0000000000 #b11101)
                arg1
                (fp #b0 #b1110101000 #b10000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0110111010 #b11000)
                arg2
                (fp #b0 #b0100000000 #b00000)))
(assert (fp.leq (fp #b0 #b0100000000 #b00000)
                arg2
                (fp #b0 #b0100001101 #b10100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011001011 #b10011)
                expect
                (fp #b1 #b0100000000 #b00000)))
(assert (fp.leq (fp #b1 #b0100000000 #b00000)
                expect
                (fp #b1 #b0011101100 #b11110)))

(assert (not (= expect result)))

(check-sat)
(exit)
