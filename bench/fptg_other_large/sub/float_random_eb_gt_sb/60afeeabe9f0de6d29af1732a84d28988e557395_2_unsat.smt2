; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111010011001 #b1)
                arg1
                (fp #b1 #b1110111010001 #b0)))
(assert (fp.leq (fp #b1 #b1110111010001 #b0)
                arg1
                (fp #b1 #b1101101110111 #b0)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b0111100010110 #b0)
                arg2
                (fp #b1 #b0010011110110 #b0)))
(assert (fp.leq (fp #b1 #b0010011110110 #b0)
                arg2
                (fp #b0 #b1011011000011 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1110111110111 #b0)
                expect
                (fp #b1 #b1110111010001 #b0)))
(assert (fp.leq (fp #b1 #b1110111010001 #b0)
                expect
                (fp #b1 #b0000111010000 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
