(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10011111010 #b111111110)
                arg1
                (fp #b0 #b00000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b010000000)
                arg1
                (fp #b0 #b00001000100 #b110010001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10011001000 #b111001001)
                arg2
                (fp #b1 #b10000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b10000001001 #b000000000)
                arg2
                (fp #b1 #b00111011111 #b100000110)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11100110011 #b000000010)
                expect
                (fp #b0 #b10000001001 #b000000001)))
(assert (fp.leq (fp #b0 #b10000001001 #b000000001)
                expect
                (fp #b0 #b11101110111 #b011110100)))

(assert (= expect result))

(check-sat)
(exit)
