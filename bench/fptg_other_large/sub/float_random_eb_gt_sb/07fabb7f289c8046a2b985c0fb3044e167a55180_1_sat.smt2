;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0001110100001100 #b11110010110001)
                arg1
                (fp #b0 #b0000000000000001 #b00000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b00000000000000)
                arg1
                (fp #b0 #b0000100110001001 #b10111100111010)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1001100010010100 #b01010001110100)
                arg2
                (fp #b1 #b1000111001001011 #b11000011011001)))
(assert (fp.leq (fp #b1 #b1000111001001011 #b11000011011001)
                arg2
                (fp #b1 #b0101110001010010 #b10100010010000)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1000001011101101 #b10101111101011)
                expect
                (fp #b0 #b1000111001001011 #b11000011011001)))
(assert (fp.leq (fp #b0 #b1000111001001011 #b11000011011001)
                expect
                (fp #b0 #b1100111011001100 #b10111001011010)))

(assert (= expect result))

(check-sat)
(exit)
