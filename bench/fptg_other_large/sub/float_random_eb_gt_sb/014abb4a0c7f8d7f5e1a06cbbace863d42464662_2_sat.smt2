(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111101011 #b001100)
                arg1
                (fp #b1 #b100111110 #b110101)))
(assert (fp.leq (fp #b1 #b100111110 #b110101)
                arg1
                (fp #b1 #b100101000 #b100001)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b001000001 #b010010)
                arg2
                (fp #b0 #b011111111 #b111101)))
(assert (fp.leq (fp #b0 #b011111111 #b111101)
                arg2
                (fp #b0 #b110010010 #b101101)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101010000 #b101001)
                expect
                (fp #b1 #b100111110 #b110110)))
(assert (fp.leq (fp #b1 #b100111110 #b110110)
                expect
                (fp #b0 #b100110011 #b100010)))

(assert (= expect result))

(check-sat)
(exit)
