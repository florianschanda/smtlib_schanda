(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11110010010 #b1110)
                arg1
                (fp #b1 #b11100000011 #b0100)))
(assert (fp.leq (fp #b1 #b11100000011 #b0100)
                arg1
                (fp #b1 #b00011110110 #b0110)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00111011111 #b0000)
                arg2
                (fp #b0 #b00111111110 #b0000)))
(assert (fp.leq (fp #b0 #b00111111110 #b0000)
                arg2
                (fp #b0 #b10111010001 #b1000)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11110000000 #b0001)
                expect
                (fp #b1 #b11100000011 #b0100)))
(assert (fp.leq (fp #b1 #b11100000011 #b0100)
                expect
                (fp #b0 #b11111100011 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
