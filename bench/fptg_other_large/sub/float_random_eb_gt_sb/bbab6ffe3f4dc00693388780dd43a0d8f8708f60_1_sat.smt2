(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0000100001 #b110000)
                arg1
                (fp #b1 #b0000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000)
                arg1
                (fp #b0 #b1100001001 #b110011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111100001 #b101010)
                arg2
                (fp #b0 #b0000000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000)
                arg2
                (fp #b0 #b0110001101 #b111010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0110110001 #b110001)
                expect
                (fp #b1 #b0000000000 #b010000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000)
                expect
                (fp #b0 #b0100010010 #b111000)))

(assert (= expect result))

(check-sat)
(exit)
