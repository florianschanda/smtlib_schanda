(assert (fp.leq (fp #b1 #b100000000000111 #b11010011)
                arg2
                (fp #b0 #b000101001000101 #b11101011)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b0 #b001000101110100 #b11000010)
                expect
                (fp #b0 #b100000000000111 #b11010011)))
(assert (fp.leq (fp #b0 #b100000000000111 #b11010011)
                expect
                (fp #b0 #b111100010000100 #b10011010)))

(assert (not (= expect result)))

