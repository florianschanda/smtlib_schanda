(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b101011011010110 #b11011001000)
                arg1
                (fp #b0 #b010000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b010000000000000 #b00000000000)
                arg1
                (fp #b0 #b110001001111010 #b01010000111)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b101101010001001 #b11001110011)
                arg2
                (fp #b1 #b100000000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000000001011 #b00000000000)
                arg2
                (fp #b0 #b010001001110010 #b10100110100)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b111111001110111 #b11001000110)
                expect
                (fp #b0 #b100000000001011 #b00000000001)))
(assert (fp.leq (fp #b0 #b100000000001011 #b00000000001)
                expect
                (fp #b0 #b101101111011111 #b00101110011)))

(assert (= expect result))

(check-sat)
(exit)
