(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111111 #b00)
                arg1
                (fp #b1 #b11111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111110 #b11)
                arg1
                (fp #b1 #b01110110110 #b11)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11000011111 #b01)
                arg2
                (fp #b1 #b01111111111 #b00)))
(assert (fp.leq (fp #b1 #b01111111111 #b00)
                arg2
                (fp #b1 #b00010011011 #b11)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111111 #b00)
                expect
                (fp #b1 #b11111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111110 #b11)
                expect
                (fp #b1 #b01010010101 #b01)))

(assert (= expect result))

(check-sat)
(exit)
