(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1010010111000100 #b1001001)
                arg1
                (fp #b1 #b0000000000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b1111010)
                arg1
                (fp #b0 #b1010101101011100 #b1111111)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0111000100001110 #b0110001)
                expect
                (fp #b1 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000)
                expect
                (fp #b0 #b0100011011000011 #b0111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
