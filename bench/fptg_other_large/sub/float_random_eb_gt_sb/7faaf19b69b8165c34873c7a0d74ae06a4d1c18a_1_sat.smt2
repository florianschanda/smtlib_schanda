(assert (fp.leq (fp #b1 #b111111111111111101 #b000000000000000)
                arg2
                (fp #b1 #b001110000111101000 #b111000100011001)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b001001011000011101 #b011110010100001)
                expect
                (fp #b0 #b111111111111111100 #b111111111111111)))
(assert (fp.leq (fp #b0 #b111111111111111100 #b111111111111111)
                expect
                (fp #b0 #b111111111111111101 #b000011111110101)))

(assert (= expect result))

(check-sat)
