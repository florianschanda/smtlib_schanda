; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10111010001011000 #b100)
                arg1
                (fp #b1 #b00000000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b001)
                arg1
                (fp #b0 #b00000101001001010 #b100)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01110011001000001 #b110)
                arg2
                (fp #b1 #b00000000000000000 #b011)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b011)
                arg2
                (fp #b0 #b11111100101001101 #b010)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b00011001111010100 #b101)
                expect
                (fp #b0 #b00000000000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b010)
                expect
                (fp #b0 #b00001101101000110 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
