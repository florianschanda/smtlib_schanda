(assert (fp.leq (fp #b0 #b10000000001000 #b110010011000)
                arg2
                (fp #b0 #b10110011001101 #b000000000001)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b10001111011000 #b000111000100)
                expect
                (fp #b1 #b10000000001000 #b110010011001)))
(assert (fp.leq (fp #b1 #b10000000001000 #b110010011001)
                expect
                (fp #b0 #b11100101100100 #b101111001011)))

(assert (= expect result))

(check-sat)
