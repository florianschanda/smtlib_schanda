(assert (fp.leq (fp #b0 #b11111111111111101 #b000000000)
                arg2
                (fp #b0 #b11111111111111101 #b110011100)))

(declare-const result (_ FloatingPoint 17 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b11111111111111110 #b001111100)
                expect
                (fp #b1 #b11111111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b000000000)
                expect
                (fp #b0 #b01011001101100000 #b011001010)))

(assert (not (= expect result)))

(check-sat)
