(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0010010101 #b00000)
                arg1
                (fp #b0 #b1000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000101 #b00000)
                arg1
                (fp #b0 #b1011001000 #b00101)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0001101001 #b00101)
                arg2
                (fp #b1 #b0000000000 #b11111)))
(assert (fp.leq (fp #b1 #b0000000000 #b11111)
                arg2
                (fp #b0 #b0100011101 #b11001)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0100000100 #b00011)
                expect
                (fp #b0 #b1000000101 #b00001)))
(assert (fp.leq (fp #b0 #b1000000101 #b00001)
                expect
                (fp #b0 #b1111110101 #b00111)))

(assert (not (= expect result)))

(check-sat)
(exit)
