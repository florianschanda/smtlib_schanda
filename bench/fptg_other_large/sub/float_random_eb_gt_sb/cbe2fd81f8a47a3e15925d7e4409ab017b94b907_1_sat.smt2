(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001000101 #b1010)
                arg1
                (fp #b0 #b000000000 #b1111)))
(assert (fp.leq (fp #b0 #b000000000 #b1111)
                arg1
                (fp #b0 #b100100110 #b0010)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111101 #b0001)
                arg2
                (fp #b1 #b001111110 #b0000)))
(assert (fp.leq (fp #b1 #b001111110 #b0000)
                arg2
                (fp #b0 #b110111110 #b0000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001010111 #b0011)
                expect
                (fp #b0 #b001111110 #b0000)))
(assert (fp.leq (fp #b0 #b001111110 #b0000)
                expect
                (fp #b0 #b101111101 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
