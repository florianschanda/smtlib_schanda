; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101110101100 #b101101011)
                arg1
                (fp #b1 #b100010000101 #b001100101)))
(assert (fp.leq (fp #b1 #b100010000101 #b001100101)
                arg1
                (fp #b0 #b110011100100 #b110110000)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110110001001 #b010001101)
                arg2
                (fp #b0 #b100000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b100000001000 #b001010110)
                arg2
                (fp #b0 #b111100111101 #b101010101)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101110000001 #b111101111)
                expect
                (fp #b1 #b100010000101 #b001100110)))
(assert (fp.leq (fp #b1 #b100010000101 #b001100110)
                expect
                (fp #b0 #b100110000010 #b110111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
