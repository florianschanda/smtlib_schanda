(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b010011100010 #b10000001)
                arg1
                (fp #b0 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000)
                arg1
                (fp #b0 #b111100111111 #b11001011)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000100101010 #b00010110)
                arg2
                (fp #b1 #b000000000000 #b00100111)))
(assert (fp.leq (fp #b1 #b000000000000 #b00100111)
                arg2
                (fp #b0 #b101101001011 #b00011000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010001010000 #b00000000)
                expect
                (fp #b0 #b000000000000 #b00100111)))
(assert (fp.leq (fp #b0 #b000000000000 #b00100111)
                expect
                (fp #b0 #b011101011011 #b00011110)))

(assert (= expect result))

(check-sat)
(exit)
