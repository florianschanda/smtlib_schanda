(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b001100011111 #b0100)
                arg1
                (fp #b0 #b000000000000 #b1111)))
(assert (fp.leq (fp #b0 #b000000000000 #b1111)
                arg1
                (fp #b0 #b001110010100 #b0001)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111100101100 #b0011)
                arg2
                (fp #b1 #b101111011001 #b1100)))
(assert (fp.leq (fp #b1 #b101111011001 #b1100)
                arg2
                (fp #b0 #b111100001000 #b0001)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b001001101010 #b0100)
                expect
                (fp #b0 #b101111011001 #b1100)))
(assert (fp.leq (fp #b0 #b101111011001 #b1100)
                expect
                (fp #b0 #b111000110110 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
