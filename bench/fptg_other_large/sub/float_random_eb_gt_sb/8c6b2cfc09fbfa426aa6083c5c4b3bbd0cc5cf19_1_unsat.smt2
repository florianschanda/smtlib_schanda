(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b010100000011001001 #b110)
                arg1
                (fp #b0 #b011111111111111111 #b100)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b100)
                arg1
                (fp #b0 #b110011111111111101 #b111)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b001111001111000010 #b001)
                arg2
                (fp #b1 #b000000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b010)
                arg2
                (fp #b0 #b101011000110010001 #b101)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b011000111101000100 #b110)
                expect
                (fp #b0 #b011111111111111111 #b100)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b100)
                expect
                (fp #b0 #b101100111101110101 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
