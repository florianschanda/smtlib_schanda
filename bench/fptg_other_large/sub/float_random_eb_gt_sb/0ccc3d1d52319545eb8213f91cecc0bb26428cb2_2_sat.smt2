(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b111110100100000 #b01111010)
                arg1
                (fp #b1 #b101000111110000 #b10111000)))
(assert (fp.leq (fp #b1 #b101000111110000 #b10111000)
                arg1
                (fp #b0 #b111010101100001 #b01111010)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b110000011100010 #b01000010)
                arg2
                (fp #b1 #b100000000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b100000000001000 #b00000000)
                arg2
                (fp #b0 #b010000001011001 #b01100110)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b110111010011110 #b00110101)
                expect
                (fp #b1 #b101000111110000 #b10111000)))
(assert (fp.leq (fp #b1 #b101000111110000 #b10111000)
                expect
                (fp #b1 #b100010111110000 #b11111111)))

(assert (= expect result))

(check-sat)
(exit)
