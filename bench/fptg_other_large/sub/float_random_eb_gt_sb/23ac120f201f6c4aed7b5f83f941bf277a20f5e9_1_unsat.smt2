;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01100001011000 #b0110001)
                arg1
                (fp #b0 #b10000000000101 #b0101100)))
(assert (fp.leq (fp #b0 #b10000000000101 #b0101100)
