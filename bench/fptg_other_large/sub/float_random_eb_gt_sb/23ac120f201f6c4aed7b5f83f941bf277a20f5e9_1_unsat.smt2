                arg2
                (fp #b0 #b00000000000000 #b1100000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1100000)
                arg2
                (fp #b0 #b01111011100001 #b0001011)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10000111111010 #b1010101)
                expect
                (fp #b0 #b10000000000101 #b0101011)))
(assert (fp.leq (fp #b0 #b10000000000101 #b0101011)
                expect
                (fp #b0 #b10001011101000 #b0010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
