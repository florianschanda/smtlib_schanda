(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111110101 #b00)
                arg1
                (fp #b1 #b1001111010 #b10)))
(assert (fp.leq (fp #b1 #b1001111010 #b10)
                arg1
                (fp #b0 #b1111001111 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111101001 #b11)
                arg2
                (fp #b1 #b0111111111 #b10)))
(assert (fp.leq (fp #b1 #b0111111111 #b10)
                arg2
                (fp #b1 #b0000100011 #b10)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110011111 #b00)
                expect
                (fp #b1 #b1001111010 #b01)))
(assert (fp.leq (fp #b1 #b1001111010 #b01)
                expect
                (fp #b0 #b1111011111 #b10)))

(assert (= expect result))

(check-sat)
(exit)
