; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b01110111000000 #b011111101)
                arg1
                (fp #b0 #b00000000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b111100110)
                arg1
                (fp #b0 #b11001010000011 #b000110110)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b0 #b00011010000001 #b001110101)
                arg2
                (fp #b0 #b10000000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b10000000001000 #b001010110)
                arg2
                (fp #b0 #b10101000000101 #b101100001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11100001000110 #b011101011)
                expect
                (fp #b1 #b10000000001000 #b001010101)))
(assert (fp.leq (fp #b1 #b10000000001000 #b001010101)
                expect
                (fp #b0 #b11011110100101 #b111000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
