(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100111000 #b1100)
                arg1
                (fp #b0 #b011111111 #b0110)))
(assert (fp.leq (fp #b0 #b011111111 #b0110)
                arg1
                (fp #b0 #b100111111 #b1000)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b011011110 #b1001)
                arg2
                (fp #b1 #b001111110 #b0000)))
(assert (fp.leq (fp #b1 #b001111110 #b0000)
                arg2
                (fp #b0 #b111100101 #b1010)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111110 #b0011)
                expect
                (fp #b0 #b011111111 #b0110)))
(assert (fp.leq (fp #b0 #b011111111 #b0110)
                expect
                (fp #b0 #b100111000 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
