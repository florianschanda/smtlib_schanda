(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b00011010101011 #b00111110)
                arg1
                (fp #b0 #b10111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b11111111)
                arg1
                (fp #b0 #b11101111111001 #b00111011)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b01111010100001 #b01110100)
                arg2
                (fp #b1 #b01000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b01000000000000 #b00000000)
                arg2
                (fp #b0 #b01001111110011 #b11000010)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11010010111000 #b11011101)
                expect
                (fp #b0 #b10111111111111 #b00000000)))
(assert (fp.leq (fp #b0 #b10111111111111 #b00000000)
                expect
                (fp #b0 #b11001101000111 #b00000001)))

(assert (= expect result))

(check-sat)
(exit)
