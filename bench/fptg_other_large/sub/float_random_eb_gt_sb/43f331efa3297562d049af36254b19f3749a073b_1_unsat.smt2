; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11101000110011 #b0101011)
                arg1
                (fp #b1 #b10111111000010 #b0100000)))
(assert (fp.leq (fp #b1 #b10111111000010 #b0100000)
                arg1
                (fp #b1 #b01100011111111 #b1110010)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10110011000101 #b0111000)
                arg2
                (fp #b1 #b01110111011010 #b1011101)))
(assert (fp.leq (fp #b1 #b01110111011010 #b1011101)
                arg2
                (fp #b0 #b10010110011110 #b1011101)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11110111110111 #b0100101)
                expect
                (fp #b1 #b10111111000010 #b0011111)))
(assert (fp.leq (fp #b1 #b10111111000010 #b0011111)
                expect
                (fp #b0 #b10010010011011 #b1000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
