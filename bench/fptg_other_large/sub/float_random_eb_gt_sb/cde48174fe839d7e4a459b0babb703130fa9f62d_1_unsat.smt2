;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00010110100 #b001000011)
                arg1
                (fp #b0 #b00111111011 #b011010100)))
(assert (fp.leq (fp #b0 #b00111111011 #b011010100)
                arg1
                (fp #b0 #b11000011101 #b010110011)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10101111010 #b011100110)
                arg2
                (fp #b0 #b01111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b000000000)
                arg2
                (fp #b0 #b10000011110 #b110001111)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11011111110 #b101101000)
                expect
                (fp #b1 #b01111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b01111111110 #b111111111)
                expect
                (fp #b0 #b11111111010 #b101011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
