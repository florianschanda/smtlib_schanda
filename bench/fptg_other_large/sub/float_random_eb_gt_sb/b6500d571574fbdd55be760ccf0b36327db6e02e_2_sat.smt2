(assert (fp.leq (fp #b0 #b0111000111011 #b0010)
                arg2
                (fp #b0 #b1110101000101 #b1001)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1111000100011 #b0111)
                expect
                (fp #b1 #b1011111111111 #b0000)))
(assert (fp.leq (fp #b1 #b1011111111111 #b0000)
                expect
                (fp #b0 #b0011000010001 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
