; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100100110000 #b1110110100)
                arg1
                (fp #b0 #b110010010101 #b0001100011)))
(assert (fp.leq (fp #b0 #b110010010101 #b0001100011)
                arg1
                (fp #b0 #b111110111001 #b1101110101)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100011010000 #b1111000010)
                arg2
                (fp #b1 #b011111111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b011111111111 #b0011111110)
                arg2
                (fp #b0 #b100010000111 #b0001010110)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b011100000110 #b0011001101)
                expect
                (fp #b0 #b110010010101 #b0001100100)))
(assert (fp.leq (fp #b0 #b110010010101 #b0001100100)
                expect
                (fp #b0 #b110011000110 #b1000001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
