; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1110110110100 #b000110110)
                arg1
                (fp #b0 #b1111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111111111)
                arg1
                (fp #b0 #b1111111111111 #b000000000)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101011110010 #b000010011)
                arg2
                (fp #b1 #b0000000000000 #b000001001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000001001)
                arg2
                (fp #b0 #b0001001100100 #b100010011)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
