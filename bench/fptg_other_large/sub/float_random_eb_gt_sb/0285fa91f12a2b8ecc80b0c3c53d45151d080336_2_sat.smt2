(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11011011011 #b11001101)
                arg1
                (fp #b1 #b10000011011 #b11010010)))
(assert (fp.leq (fp #b1 #b10000011011 #b11010010)
                arg1
                (fp #b0 #b10101111000 #b01001110)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11000100010 #b01000110)
                arg2
                (fp #b1 #b01011011110 #b01001101)))
(assert (fp.leq (fp #b1 #b01011011110 #b01001101)
                arg2
                (fp #b1 #b00011011101 #b10010111)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11010010011 #b01011111)
                expect
                (fp #b1 #b10000011011 #b11010010)))
(assert (fp.leq (fp #b1 #b10000011011 #b11010010)
                expect
                (fp #b0 #b00001100100 #b10111111)))

(assert (= expect result))

(check-sat)
(exit)
