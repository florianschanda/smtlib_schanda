(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10001110111111 #b100110)
                arg1
                (fp #b0 #b10111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b111111)
                arg1
                (fp #b0 #b11110001111111 #b111100)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10110011111000 #b011111)
                arg2
                (fp #b1 #b00000000000000 #b111110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b111110)
                arg2
                (fp #b0 #b10110100100110 #b101110)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b01011000110101 #b010001)
                expect
                (fp #b0 #b10111111111111 #b000000)))
(assert (fp.leq (fp #b0 #b10111111111111 #b000000)
                expect
                (fp #b0 #b11110010110100 #b000001)))

(assert (= expect result))

(check-sat)
(exit)
