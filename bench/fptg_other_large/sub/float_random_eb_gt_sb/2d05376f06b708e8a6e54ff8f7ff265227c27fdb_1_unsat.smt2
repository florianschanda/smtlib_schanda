                arg2
                (fp #b0 #b111111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111111111111)
                arg2
                (fp #b0 #b111111111111111 #b0000000000000)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b111111111111110 #b1111111111111)
                expect
                (fp #b1 #b111111111111110 #b1111111111110)))
(assert (fp.leq (fp #b1 #b111111111111110 #b1111111111110)
                expect
                (fp #b1 #b000000011111001 #b1010001011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
