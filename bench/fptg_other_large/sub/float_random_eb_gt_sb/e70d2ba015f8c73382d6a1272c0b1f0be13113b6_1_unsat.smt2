(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1111011011101 #b10101111)
                arg2
                (fp #b1 #b1011111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b11111111)
                arg2
                (fp #b0 #b1110111101000 #b10011111)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
