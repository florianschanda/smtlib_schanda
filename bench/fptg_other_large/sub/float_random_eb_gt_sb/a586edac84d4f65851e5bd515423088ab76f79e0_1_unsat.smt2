; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +ZERO

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100000011 #b11)
                arg1
                (fp #b1 #b100000001 #b00)))
(assert (fp.leq (fp #b1 #b100000001 #b00)
                arg1
                (fp #b0 #b111110010 #b11)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b100001011 #b00)
                arg2
                (fp #b0 #b000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000 #b00)
                arg2
                (fp #b0 #b010001110 #b01)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110010001 #b10)
                expect
                (fp #b1 #b100000001 #b00)))
(assert (fp.leq (fp #b1 #b100000001 #b00)
                expect
                (fp #b1 #b010110010 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
