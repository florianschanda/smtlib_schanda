                arg2
                (fp #b1 #b000000000000001 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0000)
                arg2
                (fp #b0 #b000001110001010 #b1011)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b101001011011010 #b0000)
                expect
                (fp #b0 #b000000000000000 #b1100)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1100)
                expect
                (fp #b0 #b000001100001111 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
