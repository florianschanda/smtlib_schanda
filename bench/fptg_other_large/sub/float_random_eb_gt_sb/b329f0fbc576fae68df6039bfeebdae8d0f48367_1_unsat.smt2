(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b011100101101 #b0100011)
                arg1
                (fp #b0 #b100000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000000111 #b0000000)
                arg1
                (fp #b0 #b100101001110 #b1101111)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b011001111110 #b1001101)
                arg2
                (fp #b1 #b000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b0000000)
                arg2
                (fp #b0 #b011001000001 #b1000000)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110010010011 #b0100111)
                expect
                (fp #b0 #b100000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000000111 #b0000000)
                expect
                (fp #b0 #b110101001110 #b0101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
