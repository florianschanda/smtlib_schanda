; Format: FLOAT64
; Arg1: -ZERO
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01110010111 #b0111110111100000101010000011010101100010100001011000)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00101001001 #b0011011110001001010000010110110000100101101010010001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111010111 #b1101110011110001000110001111100110110000010001101111)
                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b10111101110 #b0100000111111101011010100101100000011010000101111001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100100010 #b0100100110011111110100101000000111001111000111111101)
                expect
                (fp #b1 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                expect
                (fp #b0 #b00101011000 #b0011100110110101110101010101010000111000011011011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
