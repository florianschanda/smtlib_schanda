                arg2
                (fp #b0 #b10010001011 #b0110000111010010101101101000111000010110010100111011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100010110 #b0010111010111000100001111111000000101100010000101011)
                expect
