(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010001101 #b1011000001010110111111110100000011001111001111011010)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b11110000111 #b1000100011110001111000100100010101110000010100101100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01001001010 #b1111000010010101111111000000110000101111001001010111)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b10010110001 #b0100000000101000011010101101111010110111110010101100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01101011101 #b0101000111010010110001101101001111001100101001100011)
                expect
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                expect
                (fp #b0 #b11010100010 #b1110110001101000100011111001011000001011110011010110)))

(assert (= expect result))

(check-sat)
(exit)
