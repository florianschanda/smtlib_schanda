; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000101000 #b0101001010111010100110000000000011101011001011011001)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100001010 #b0111010010010101110101101010011111111100111011011011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111010111 #b1101010001000101111001101010010000111001000111010011)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b01011100010 #b0011101000000100010000010001011101101000111101101111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000010110 #b1101101100011011010110100101110001111101101000001001)
                expect
                (fp #b0 #b10000110011 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10000110011 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11100000010 #b0110100010101101000000100011100100110100101111101111)))

(assert (= expect result))

(check-sat)
(exit)
