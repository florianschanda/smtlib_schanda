(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01001111111 #b0100001001100101000001110101100010111000100001000011)
                arg2
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)
                arg2
                (fp #b0 #b11011010000 #b0111100001010000010011100110011111110000000011111110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
