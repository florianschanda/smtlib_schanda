; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100000000 #b1000011110101001011110111001111011110110111001000101)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b11001101011 #b0110101100011100101110100100001101111010100110011100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010011010 #b0100110001111000100001000101001000011110111011000001)
                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01101100100 #b1110101101101101000011101011010001110010010010011101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100001101 #b1010010001100010111001001011101110111100110011010000)
                expect
                (fp #b0 #b00000000001 #b1101111111010100101110100010000101100101011000001110)))
(assert (fp.leq (fp #b0 #b00000000001 #b1101111111010100101110100010000101100101011000001110)
                expect
                (fp #b0 #b11101101011 #b0000011010010010110101000101111100101010000010011110)))

(assert (= expect result))

(check-sat)
(exit)
