(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111101101 #b0000000000111101111111011000101100110000011111011010)
                expect
                (fp #b0 #b01111111110 #b1111111111111111111111111111111111111111111111111111)))
