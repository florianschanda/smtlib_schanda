                arg2
                (fp #b0 #b01110110011 #b0010101111100101111010001100110001101001010011001101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00010111100 #b1001011001001110001111110010011011011100110110100110)
                expect
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10100111001 #b0110011111100001001001000110000101111111001010110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
