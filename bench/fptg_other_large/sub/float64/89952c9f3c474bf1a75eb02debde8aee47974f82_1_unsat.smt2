; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01100111100 #b0111010000011100011101010101101011011100000111100100)
                arg2
                (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)))
(assert (fp.leq (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)
                arg2
                (fp #b0 #b11111010010 #b1011101000110010000111001110110111011010000100101101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
