; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01000011110 #b0000111110101100111001100001000100000100011000001001)
                arg1
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                arg1
                (fp #b0 #b11011110011 #b0001100010101011000001101111010111110111001110010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11100011100 #b1011010101010101111010101111111000110101101011000100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00110101110 #b0111011000110111011101000010000101101010101001011101)
                expect
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(assert (= expect result))

(check-sat)
(exit)
