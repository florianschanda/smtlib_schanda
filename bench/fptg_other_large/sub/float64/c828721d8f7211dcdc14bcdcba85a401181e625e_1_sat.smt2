(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111110000 #b1110100101110100111110110011010010011010100100010000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010000111 #b0110011100000100110100111001011100000001001000100010)
                expect
                (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)))
