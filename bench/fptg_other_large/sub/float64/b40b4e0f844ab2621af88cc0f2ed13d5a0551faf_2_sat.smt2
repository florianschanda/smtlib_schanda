(assert (fp.leq (fp #b1 #b11010100100 #b0010011110010101100101001100111101100100010100011110)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11100101111 #b1000100010000011100011010110001010110000110011001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111010111 #b0011001000010011000110100101000100011100011111000010)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b10101010000 #b0011001000001110010010011000001011000010110000000001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010000101 #b0001111110011110000111010101010111011000010010100100)
                expect
                (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                expect
                (fp #b0 #b10101001000 #b1101101010101001110010101011011101111111010000101111)))

(assert (= expect result))

(check-sat)
(exit)
