; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0111111001001100101111100001011000110100000011011100)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b10010110110 #b0111111000110010011011011100110011001001001010010000)))

(declare-const arg2 Float64)
