                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111110 #b1100010110100011010100110000100110001001011111100110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1101100000000100001000000010111100110001001000100000)
                expect
                (fp #b1 #b11111111110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01111111000 #b1001100110101010110001001011001111101010001001001111)))

(assert (= expect result))

(check-sat)
(exit)
