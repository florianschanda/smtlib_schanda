; Format: FLOAT64
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110111011 #b1100110111100100101100000000010110100001010011111000)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01001111010 #b1011000111010100001001000001101100000101110111110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01100011110 #b0100110010010010101000001111000111111011100100010001)
                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01111110110 #b1100011001001101111100101101011011011111001000100001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111110010 #b1100100100010101111100101000001100000010010101100011)
                expect
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010110110 #b1101001010111010110011000111010011100011000010111010)))

(assert (= expect result))

(check-sat)
(exit)
