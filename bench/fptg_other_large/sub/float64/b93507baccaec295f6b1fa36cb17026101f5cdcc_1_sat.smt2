; Format: FLOAT64
; Arg1: +ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00100011110 #b1101101100000000110011000011000011000110110110000111)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110111011 #b1000101000101111100111010001001000011011100110100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110010000 #b0101110100110011000010100010000000011101011000110000)
                arg2
                (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)))
(assert (fp.leq (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)
                arg2
                (fp #b1 #b00111110111 #b1101110001011111110111111111001101010100101110000000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10010100101 #b1001010000011111111011001110101110100110001011000100)
                expect
                (fp #b0 #b11001101100 #b1011101100001101100011110010111010001111111010000001)))
(assert (fp.leq (fp #b0 #b11001101100 #b1011101100001101100011110010111010001111111010000001)
                expect
                (fp #b0 #b11010101010 #b1100010000010101111001010111010100001100011011111000)))

(assert (= expect result))

(check-sat)
(exit)
