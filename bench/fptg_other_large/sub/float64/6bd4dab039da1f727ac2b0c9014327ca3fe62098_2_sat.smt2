; Format: FLOAT64
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00001011010 #b1011100001110001101110000101000011001110101101100000)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10010101110 #b0100110110101011111001100110101001101101100010101101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001010110 #b1101011011101000011101100100011010000000100100101000)
                arg2
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b00111101001 #b1011110001001010101011000111010011001011110010010000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101001101 #b1111010100101100100111100111010000110010001111111101)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11001100101 #b1001101111000101000001011100111011100100000101010001)))

(assert (= expect result))

(check-sat)
(exit)
