                arg2
                (fp #b0 #b11111000101 #b1111010110100000111001100011010001011101111110101110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111010111 #b1011110000101110011001000011101100000000110100001010)
