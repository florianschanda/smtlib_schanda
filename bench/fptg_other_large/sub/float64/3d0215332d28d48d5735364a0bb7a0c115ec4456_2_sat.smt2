; Format: FLOAT64
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110011111 #b0111101010101001000001100000110000100000001111011110)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01101110011 #b1111000011001110110101111111010001110000111100111000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010100100 #b0101100100110100000010111111100111000011011011100001)
                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11101101010 #b1110110010111001101011101010100111001100100011101111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011110111 #b1000000001010001011010100011101001111000110000110111)
                expect
                (fp #b1 #b10111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10110010111 #b0100110110110001110110011011100010001011010001001010)))

(assert (= expect result))

(check-sat)
(exit)
