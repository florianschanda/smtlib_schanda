(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110101010 #b1001000100111101011011110101101100010000000101000010)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b10110011010 #b0000100111101101110010110010100001101000101010000111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111100001 #b0001110001010010011101010110000100111001000111010011)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b01010010001 #b1010001010010110010011101010010000101001001000000111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00110100100 #b0110100010110000000001110101000100011111101100101110)
                expect
                (fp #b0 #b10000110011 #b1010110010000100101011101010011000100101110101110110)))
(assert (fp.leq (fp #b0 #b10000110011 #b1010110010000100101011101010011000100101110101110110)
                expect
                (fp #b0 #b10010011100 #b1100111110101010000000100110110000101101011111010101)))

(assert (= expect result))

(check-sat)
(exit)
