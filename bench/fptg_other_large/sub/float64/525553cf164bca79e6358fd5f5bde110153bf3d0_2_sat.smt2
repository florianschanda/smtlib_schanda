(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00011001101 #b1000100100010000110010000001100011010101010011110000)
                arg1
                (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)
                arg1
                (fp #b0 #b01011101111 #b0111010110000111000101001100110111111101111100111011)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01001000010 #b1000100010001101011111100001111000101110110101111001)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000001000 #b1010000011001001111001111010110000111110100101110001)))

(assert (= expect result))

(check-sat)
(exit)
