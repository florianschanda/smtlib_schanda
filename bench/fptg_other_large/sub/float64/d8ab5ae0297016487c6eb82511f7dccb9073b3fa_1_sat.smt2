; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010000101 #b1111110110010000010000110100001000001011000000011110)
                arg1
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg1
                (fp #b0 #b11100110001 #b1010110101110000010010000011000010010010001100110011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000001110 #b0011000000101010010111001001011100001110101001100010)
                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11110101100 #b0010110110010111001100001111001011001000010101111011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000001010 #b1100000111110011001001101111011011011111000111100010)
                expect
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011011)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011011)
                expect
                (fp #b0 #b01110100000 #b0100110010010100000111111010011101011111110100001110)))

(assert (= expect result))

(check-sat)
(exit)
