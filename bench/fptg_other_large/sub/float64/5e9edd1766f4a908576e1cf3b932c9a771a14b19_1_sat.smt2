(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010011110 #b1000111001110010101011101110100001110001000100111000)
                arg1
                (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)))
(assert (fp.leq (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)
                arg1
                (fp #b0 #b01010010101 #b1111111110110011101111101010001110000101010011111111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111010110 #b1010010001100011000011100111100011110001100110111111)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00011110011 #b0011101010010110110110101010100000110101001010100100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110000000 #b1101110101111010101101111001010001100010000010010100)
                expect
                (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)))
(assert (fp.leq (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)
                expect
                (fp #b0 #b01101111110 #b0100111111101000000010101001110010101000000111011000)))

(assert (= expect result))

(check-sat)
(exit)
