(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b10100110010 #b1000110000101110001110001110101010101110111010010110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101010100 #b1100001100010010011100100000100111110010110111001101)
                expect
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000100)))
