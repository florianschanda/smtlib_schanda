; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001100110 #b0101010101000001100000111111100000000001000001100010)
                arg1
                (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)))
(assert (fp.leq (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)
                arg1
                (fp #b0 #b01001101111 #b1001001001010000101011110100100111011001101111110111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010010011 #b1110010001100100001110110101011110000110011010010010)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b01100011110 #b1101010010111111011111101100011111110110111110001111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101010000 #b1000001110110011011111110001011111011000011111111011)
                expect
                (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)))
(assert (fp.leq (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)
                expect
                (fp #b0 #b00010011011 #b1000100101001101010101100011110001001010101111001011)))

(assert (= expect result))

(check-sat)
(exit)
