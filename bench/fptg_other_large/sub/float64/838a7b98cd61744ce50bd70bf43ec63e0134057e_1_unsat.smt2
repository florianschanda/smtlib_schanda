; Format: FLOAT64
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00001000101 #b0111111101000010001000111001001001100011001100011101)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01110111000 #b0001001110110000110100101011101000101101001001001010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011100110 #b0010010010001110010010100000001101001110011011010001)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b01010011101 #b0010110011011100010101100111111101011010100000000111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100000100 #b1010000010100011101111111101011110100010011010011111)
                expect
                (fp #b0 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b0 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                expect
                (fp #b0 #b01011001001 #b1001111010000000100011100011011110010001001011110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
