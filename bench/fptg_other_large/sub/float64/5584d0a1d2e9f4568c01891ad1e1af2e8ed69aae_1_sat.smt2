(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01100101011 #b1110110011011110001110101101110011110010010111000011)
                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000011011 #b0100101011010110111110110101111111001011010000110111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00000001100 #b1111010010110011110100101010101111011001111001010001)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011010111)))
