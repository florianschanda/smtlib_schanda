; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101010010 #b0010001101000000101110100110101000110110111100010010)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10011100000 #b0001011010011001011101001001001111101001100101111110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00011111000 #b1010000000100000100110100001000000010000101000111100)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11110000011 #b0011001000110000110010000110111010110110101110110101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010100101 #b0110001101011111000100110001100111111110001101001111)
                expect
                (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                expect
                (fp #b0 #b00100001010 #b0000110000011011100100000100000010010100010100111110)))

(assert (= expect result))

(check-sat)
(exit)
