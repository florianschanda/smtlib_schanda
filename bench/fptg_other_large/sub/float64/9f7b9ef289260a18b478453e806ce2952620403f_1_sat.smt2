; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110010111 #b0110001010100100110100011000000100101001001110101000)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b00101010000 #b1100111100001000000101011011000010101110110000000011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01011000000 #b1010110100001000101100101011010110101011011001110101)
                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b10001110110 #b1001100001100101101010000000010011000111001011100101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110101110 #b1100111101000001100110000010110010011011010100111111)
                expect
                (fp #b1 #b01110100100 #b1010011010011101110001111011010101000010101110111010)))
(assert (fp.leq (fp #b1 #b01110100100 #b1010011010011101110001111011010101000010101110111010)
                expect
                (fp #b0 #b01011010111 #b0001000001000100001111010011101100000010011010011111)))

(assert (= expect result))

(check-sat)
(exit)
