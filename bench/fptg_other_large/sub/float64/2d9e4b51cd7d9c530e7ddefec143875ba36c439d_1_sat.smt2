                arg2
                (fp #b0 #b10111011000 #b0011111001010001101110111001010011001011011110001011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000101110 #b0111111110011111010010100001011011011000000010100010)
                expect
