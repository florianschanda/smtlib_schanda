(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010000100 #b1011001001111001010001110111001010000000110110011110)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01110011000 #b0010000110001010111011000011000010110001110001110111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00001101111 #b0110100011011010011001000101110101111010001011100000)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b10101111101 #b0111001011001011001010100101011010101100111010011010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000101101 #b0110001010000110111110010000000001001001100010010010)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                expect
                (fp #b1 #b01010101101 #b0101111100010110000010001001101111111001101110111100)))

(assert (= expect result))

(check-sat)
(exit)
