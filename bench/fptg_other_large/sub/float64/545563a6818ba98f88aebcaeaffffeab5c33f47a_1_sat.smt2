(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111001001 #b1001001011011011011111010001010101011011111101001110)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111000111 #b1111001110000010111001011001010000011111100000000110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001011101 #b1101111000110100100101101101101010010100110000010100)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b10000001111 #b0010110110111010001110011110111101001100011001111010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100100000 #b1010111100001000000111111000001010101101010010010110)
                expect
                (fp #b0 #b10000110011 #b1010110010000100101011101010011000100101110101110110)))
(assert (fp.leq (fp #b0 #b10000110011 #b1010110010000100101011101010011000100101110101110110)
                expect
                (fp #b0 #b10111100100 #b0010010101011001011000011000111010101101011011101000)))

(assert (= expect result))

(check-sat)
(exit)
