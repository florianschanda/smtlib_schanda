; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101010101 #b1010010111110101110100100010100001011010011000010000)
                arg1
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                arg1
                (fp #b1 #b00110111000 #b1011010011000011100110011110010101110011010110011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011101101 #b0111111111010110010111001010111001100111011100100010)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01011000100 #b0100100111100000011100011100001101010101110010010000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010111101 #b0011000011111100010000001101101000010111010101110101)
                expect
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010101)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010101)
                expect
                (fp #b0 #b01101110101 #b1011110110000011101011101000111010110011111110010000)))

(assert (= expect result))

(check-sat)
(exit)
