(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011101101 #b0101001010011101011010000000000100110000000110000010)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b0 #b00010001100 #b1101011001011111011010000100001001001011011100001110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00100000100 #b1100111111101011011000101000011111001110101100011101)
                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11101000011 #b1110000010010010110001001101010100000010101010111100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000101001 #b1010010100100101111111000100110101010110100010001111)
                expect
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                expect
                (fp #b1 #b10001011101 #b0000011110011001111100011001111010011010010101100100)))

(assert (= expect result))

(check-sat)
(exit)
