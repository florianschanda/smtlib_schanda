; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100001000 #b0011110011111111010100101110000101010100111101111001)
                arg1
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                arg1
                (fp #b0 #b10000110010 #b1001010101110011101100100101100110110011011000000001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111101111 #b1110110011100011001100100001101101110011111000011100)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b01101100110 #b1101000001100101111011101110110000011011111010110001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100001110 #b1010001011110101111100000010111000000010111110100111)
                expect
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                expect
                (fp #b0 #b11010010100 #b1100101010101100011000000000011000001111111010111110)))

(assert (= expect result))

(check-sat)
(exit)
