(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111011101 #b1101010001100101010010001010111111101000110000111000)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b1 #b01110110001 #b1110111010101001110111110111101110101011010001110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01101110001 #b0101100100000100100010111111000011111011101000100010)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111101 #b1001111100001001110100010110110111001001011010011000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1011011100101001110001001011101111111000110011100000)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01100100101 #b1010110010111010010100111100101101000101110100000111)))

(assert (= expect result))

(check-sat)
(exit)
