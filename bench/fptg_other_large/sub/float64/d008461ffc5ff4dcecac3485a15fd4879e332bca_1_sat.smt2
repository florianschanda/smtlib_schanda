; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101000010 #b0101011111000100001100101111000111100100000101110000)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00001010101 #b0010101110100110111101001001010100010100000101001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110100001 #b1111010001001000011001000000000110001010111101001101)
                arg2
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b0 #b11000001110 #b0011110000010100101101011101100110100011100001111101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111111101 #b1010011010011011110111101001100000101111111001001000)
                expect
                (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001001)))
(assert (fp.leq (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001001)
                expect
                (fp #b0 #b11101011111 #b0101111101011110000111001010100001100110001010010010)))

(assert (= expect result))

(check-sat)
(exit)
