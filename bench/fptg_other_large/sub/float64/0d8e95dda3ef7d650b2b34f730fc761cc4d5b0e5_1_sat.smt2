; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001100000 #b0110001000100111100001010111101001110000111101010111)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b00011000110 #b1111101010100101010001011111011100011011011011110110)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00010000110 #b0111010111000110100111000001100101100000000111011100)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10111000110 #b1011101110110000100011110001110010001011001110000110)))

(assert (= expect result))

(check-sat)
(exit)
