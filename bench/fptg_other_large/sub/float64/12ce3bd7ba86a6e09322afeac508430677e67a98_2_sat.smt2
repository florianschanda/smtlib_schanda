; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111011101 #b0111100100110111001100011000011110101100010010101101)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b0 #b11000100000 #b1110010000101001100111101011001101100100111110110000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010110010 #b1111011111010000111111100011110001010011011110111100)
                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b01000001010 #b1001000010000111001111000110011010110010000001101110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100000001 #b1111100010011001001010101010011110100110000010001011)
                expect
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                expect
                (fp #b1 #b01110110101 #b1111000110110101100001000100100001111111101001101011)))

(assert (= expect result))

(check-sat)
(exit)
