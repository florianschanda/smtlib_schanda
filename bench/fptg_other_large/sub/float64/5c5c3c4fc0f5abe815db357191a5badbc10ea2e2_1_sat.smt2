; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001110111 #b1110001000011000100000101111010000000111111001110010)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11100000000 #b1000011011100101111010101100010001110010100000001100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111010101 #b0101010111110001010110101011111010101011011101010111)
                arg2
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b0 #b01101100111 #b1111010110011010111100110111110010001111010101001110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011011010 #b0100101110101101101001110010111100110001010011111101)
                expect
                (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                expect
                (fp #b0 #b11101101100 #b1001000000100010001110111110100101010100101011111110)))

(assert (= expect result))

(check-sat)
(exit)
