; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000001000 #b1100000110100000110011101100011110000011010000111011)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11100100010 #b0101101010000011101100010000000101001001101110001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111001110 #b0010101101110001010101000100101100000110100001001000)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b10010010001 #b0011111111001011111001101101110010110100000011001110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010101000 #b1001101110001101110001111011101111100010000011010001)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                expect
                (fp #b1 #b01000111010 #b0001001101110011010100001100001101100111100011011100)))

(assert (= expect result))

(check-sat)
(exit)
