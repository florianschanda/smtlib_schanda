                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11010111000 #b0110011110011110010010010110111110000111111001100010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011101000 #b1000001010001000100110111000000111010010010001000111)
                expect
                (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110110)))
(assert (fp.leq (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110110)
                expect
                (fp #b0 #b00100100001 #b0011110011111100111110111111010001110100111101110010)))

(assert (= expect result))

(check-sat)
(exit)
