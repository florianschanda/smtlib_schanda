                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11010110110 #b1111001110100001111100000000100011101100101011001011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111100111 #b0001011000100000101101111111111000110110101000100001)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001110)))
