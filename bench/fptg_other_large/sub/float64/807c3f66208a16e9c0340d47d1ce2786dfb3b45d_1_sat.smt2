                arg2
                (fp #b1 #b00011011110 #b0011011011111101001111010001111111010000101110101000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10010100000 #b0000011101110011101111000100101101011110011100010011)
                expect
                (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
