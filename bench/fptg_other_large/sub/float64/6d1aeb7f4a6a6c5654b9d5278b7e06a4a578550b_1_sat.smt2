; Format: FLOAT64
; Arg1: +INT_BOUNDARY
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01001111110 #b1101110111000100100110010010001001111111100011101101)
                arg1
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110000101 #b0100011101011000010010000100001111100111100010110111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01000010100 #b0001010101011011001010111010011000110011001100011100)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100100010 #b1101001110111010100011010010100110001000110101010101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10101011101 #b1111101110101101001110110111010100010100110100101100)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01000010010 #b1001100010011000010111010101100010011010110101100110)))

(assert (= expect result))

(check-sat)
(exit)
