;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101110010 #b1011000110010100100010100001111011101010010000101111)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01111100010 #b0000100010111000011100010011100110110100001111110010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00100101100 #b1101111101111011101101001000101010000110111110011110)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11111111000 #b1000000101111101010001111100110010000010101110111111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100110001 #b1110101101001001101111100101100000111101011000101010)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                expect
                (fp #b0 #b01110101110 #b1011010011111010110011110000100001010010010001011011)))

(assert (= expect result))

(check-sat)
(exit)
