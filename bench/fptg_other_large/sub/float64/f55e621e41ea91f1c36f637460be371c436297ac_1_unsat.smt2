;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001101010 #b0100001000101000110000000100001001001100111101111001)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b00100010110 #b0111110000011101110101111100010000101101110100000110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111101101 #b0011000010000001010101011001010001101110011110101010)
                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01011000011 #b1101101111000011100000000010111111010001011100111100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111001000 #b0010011110000100110000001011100110100100010110111100)
                expect
                (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b00101001011 #b1100111011111111011001111011111010111111111111111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
