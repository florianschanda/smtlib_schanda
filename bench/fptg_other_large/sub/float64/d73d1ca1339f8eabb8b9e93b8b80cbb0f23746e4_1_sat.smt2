(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01111100110 #b1101011000010000000000110110010000111000101010010001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111000011 #b0010111010110100101100100101110000100001001010000001)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
