                arg2
                (fp #b0 #b11100110110 #b0011100011111101001000100000101011110100101001010100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011011000 #b1101001001110100111001111011111110111010100110011100)
                expect
