; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010101110 #b1101001110010000001001000100110110110001011011000111)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b10110100110 #b0111111001001110010110010010100111001110000110100101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01000110000 #b0101011000100100000111100000000101100111001010111100)
                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00100101000 #b1010100010100110110011010100101001110000110101101000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010111011 #b0010001011001101000001011010101110000100111001101010)
                expect
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000100)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000100)
                expect
                (fp #b0 #b11011011110 #b1010010010100010000111100000010111010011111111000101)))

(assert (= expect result))

(check-sat)
(exit)
