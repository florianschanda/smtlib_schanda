; Format: FLOAT64
; Arg1: +NAN
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00011110000 #b0010100101110001111111000101010001011010111100100100)
                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b11101110111 #b0111001001000010001100100100101011001001100011010111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
