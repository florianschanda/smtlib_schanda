(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010111000 #b1101011110010010001001111100100110000110101000000100)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11101110000 #b1010111001100101001110010110110100011001010000110111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b1 #b01001111101 #b0111010011000110110010110110100111010001000011111011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b11110010010 #b0101000100010010011100101111100110100100001010010111)
                expect
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(assert (= expect result))

(check-sat)
(exit)
