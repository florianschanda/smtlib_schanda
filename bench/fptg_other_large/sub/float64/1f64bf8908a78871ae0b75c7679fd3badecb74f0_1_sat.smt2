(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101110100 #b1100001010010101111111111001101101101101100101100110)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10111011001 #b0011001010101111110010010110101011010001110011100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00001111110 #b0000110011100010000110010100000101100001101000111000)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b10001010111 #b1001100001110110010010101001001110110011010010000011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010111101 #b1100000101101000010010011101100101011010010000100000)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)
                expect
                (fp #b0 #b11001110111 #b1111011110010000010001110010110111110110101101101000)))

(assert (= expect result))

(check-sat)
(exit)
