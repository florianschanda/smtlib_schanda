; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101010001 #b1001000011000000111001000110010011101100000010101111)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b01000110110 #b1101001100101100110110010010011001000111010100110011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01101101111 #b0000010100010111011101011000010001011101010001101110)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b10110000001 #b0101001011110000010010000000001011001001000101100011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111011010 #b0111001000111110011100011011000101000010101110111110)
                expect
                (fp #b0 #b00000000000 #b0110110101001110100110111011100000011010011101110101)))
(assert (fp.leq (fp #b0 #b00000000000 #b0110110101001110100110111011100000011010011101110101)
                expect
                (fp #b0 #b01000000100 #b1000111111111010110010001011000000001110110110011100)))

(assert (= expect result))

(check-sat)
(exit)
