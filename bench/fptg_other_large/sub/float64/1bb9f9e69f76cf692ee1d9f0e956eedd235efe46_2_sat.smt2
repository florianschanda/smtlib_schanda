(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001101111 #b0100000010010010110101001010100111101111011101110011)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b0 #b01111110101 #b1011010110100101111010110110100101010100011110100110)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10101111010 #b1101000111111110111011111011010000101001111100110111)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00011111100 #b1011111110101000110001101100100011010001000000000101)))

(assert (= expect result))

(check-sat)
(exit)
