                arg2
                (fp #b0 #b01001000100 #b0111011001011001010101101001100100101111010011111010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111100010 #b1100000011110100110011010000001101100010101101010100)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111110)))
