; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000011011 #b0110011001000101010110101111110100110011011111111011)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10111110100 #b1101011101011111111001110011000110001111100110111110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01011011010 #b0101111010100001111010010101101100101011000001111110)
                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11101010110 #b1001000111111101000110001011010001111010001011010111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100110000 #b0000111001110100010010001001101010100011101000001100)
                expect
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b0 #b01011100110 #b1011001101110010001110010110111111000000110100101011)))

(assert (= expect result))

(check-sat)
(exit)
