; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00011111110 #b0110000001110011111000101011010111101100000110001010)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10011011000 #b0111100100110100101100100010111011010110001011001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11000010010 #b0101100101001100011001001001101010000100101001111000)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b10111101100 #b0001110111111010011101110011100000000110100111001000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111010111 #b1000010010010111011000110010011100000110001011000001)
                expect
                (fp #b0 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b0 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                expect
                (fp #b0 #b11101101100 #b0110011100110101101010101110111111010010000010011110)))

(assert (= expect result))

(check-sat)
(exit)
