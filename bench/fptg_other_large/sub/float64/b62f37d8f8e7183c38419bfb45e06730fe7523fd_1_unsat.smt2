                arg2
                (fp #b0 #b11111011001 #b1011101100101000001010010010111001001110001010100000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101100111 #b1111111111100010101011100000010110001011100111111100)
                expect
