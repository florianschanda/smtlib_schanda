; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00011101011 #b1001111111101100100011000110111110000101010110010001)
                arg1
                (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)))
(assert (fp.leq (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)
                arg1
                (fp #b0 #b11001111010 #b1110010000100011000001101000011011110011101110001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00101111101 #b0100111001001011011101101110101000101110001001000000)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100100111 #b0100111011100101011000010100110110001000000101001111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110000000 #b0100010011010000100000010011001101000011001000100000)
                expect
                (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b01000110001 #b0110001110011110000001100100010001100010011001100110)))

(assert (= expect result))

(check-sat)
(exit)
