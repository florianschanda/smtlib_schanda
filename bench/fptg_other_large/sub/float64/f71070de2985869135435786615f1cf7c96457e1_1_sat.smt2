; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11000111010 #b1011000111010111001100110001101110111010000011100001)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00000111010 #b1101101011001111101000010110110110110010110111000000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011110011 #b0000111111001000111011101010100111000110011110111111)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b1 #b00100011001 #b0110101110011000101111010011110000101111101010001010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111000011 #b1111000111111011010110101111101100010110110010010100)
                expect
                (fp #b0 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b0 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                expect
                (fp #b0 #b10100111101 #b0101111000000110001000110100101000111101011010001000)))

(assert (= expect result))

(check-sat)
(exit)
