                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11010010101 #b0100110100001011010101111111111101011011111110111010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101110000 #b0011011110010101101011100110010010111101111111110101)
                expect
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
