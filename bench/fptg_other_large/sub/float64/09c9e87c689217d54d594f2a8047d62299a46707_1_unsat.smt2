; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11100111111 #b1111000101101000110011010111011101011101100111111011)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01011000110 #b0100101010111110110110101010001001000011101011010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11000010101 #b0001010111100000111101110101111101110100110000100011)
                arg2
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11101000000 #b1110101111010110001101101111000111101111011100011110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010011101 #b1111000101100101000101001101010100000000010100111001)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11110001110 #b0011101011101011110010110010111010101111110111001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
