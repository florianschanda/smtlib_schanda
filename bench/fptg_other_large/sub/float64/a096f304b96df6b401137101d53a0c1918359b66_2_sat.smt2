                arg2
                (fp #b0 #b11101101010 #b1111100101000100000010001100101010011110110010011111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010101001 #b1101110111111001100101001001010101110011000100110110)
                expect
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
