; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01000010100 #b0011000111101100101000110100000011010001101000000001)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01100101000 #b1011001001011010110010100100010011010000001101001111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01011011101 #b1001001111101011100001000101111101010011111100100111)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b11110100001 #b1010100010001000111110101010100110101000010000001101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00101011111 #b1111101100100100111000110100000010010101101010000100)
                expect
                (fp #b0 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b0 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                expect
                (fp #b0 #b01110011101 #b0010010100011101010110100110111100101011101101010110)))

(assert (= expect result))

(check-sat)
(exit)
