(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +ZERO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01100011111 #b0110101101100100101100010011000010001010110000010011)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01110111101 #b0010110110101111111010010111000100010101100001010000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100111101 #b1101110101100100101011010011100001110001001011100010)
                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00000100010 #b0110010000101000001111101000000110001000010110010110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010011100 #b1110101001000110010111100110111100110101101001111011)
                expect
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01010011110 #b0111000101010111000011100101000110110101010100100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
