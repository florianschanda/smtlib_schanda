; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101010010 #b1011100110111111000100011000010000101100100110001110)
                arg1
                (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)))
(assert (fp.leq (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)
                arg1
                (fp #b0 #b00100110111 #b0011101011010111110001011101010110101000100110100111)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
