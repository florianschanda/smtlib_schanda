                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11111000000 #b0100001011010010010010001011100110011010111110010100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110101100 #b1000100101111001011011010100001101110011110000011100)
                expect
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11010100100 #b0100101101110100101100000001010100101000101111011000)))

(assert (= expect result))

(check-sat)
