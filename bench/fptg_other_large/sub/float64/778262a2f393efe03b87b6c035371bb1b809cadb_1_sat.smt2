(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001110001 #b1100101111011100100010011100000110100000011111111010)
                arg1
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg1
                (fp #b0 #b00010101000 #b1100000111111001001101001100100100100011110010010001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011111000 #b1110111101111101010110110000011001000110110001010111)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b10101001101 #b0011101010001100100000101011110010001100011000011001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110000011 #b0001111011000101110010000011000001011100011000110101)
                expect
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011011)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011011)
                expect
                (fp #b0 #b11111101011 #b1010100110100010000110010100011111011001111000110011)))

(assert (= expect result))

(check-sat)
(exit)
