(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010000111 #b0111000100100110011001000011101000110010100011000111)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b11100001010 #b1000111111101100000110010010111100100011101110000100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01100101100 #b1001111110010001010110000111011011000110101111100111)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11110100111 #b0101001101010101000110001001001110100001111010000001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001111110 #b0100001111110011100100111110001101110110101111100000)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001110)))
(assert (fp.leq (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001110)
                expect
                (fp #b0 #b10101111111 #b0011000011110010110111100100011001010001101010000110)))

(assert (= expect result))

(check-sat)
(exit)
