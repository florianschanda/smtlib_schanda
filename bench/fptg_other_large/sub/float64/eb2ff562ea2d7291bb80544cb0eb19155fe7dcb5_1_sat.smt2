(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111110001 #b0110100111111011100011000101111010001101001110010100)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b11011001011 #b1011011011100011110011100010010100101001111000100100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01000010100 #b1111000000011111010001011111100001000100101001100111)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b10011010000 #b0010010111010100111011111101101010101010010100111001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111010100 #b0111000001011100001011100110000000000000011111101010)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)
                expect
                (fp #b0 #b00011010101 #b0000100001011011110111010101111000010100010010011110)))

(assert (= expect result))

(check-sat)
(exit)
