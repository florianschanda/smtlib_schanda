                arg2
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                arg2
                (fp #b0 #b11010000010 #b0010001110000000111000001001010110011100101010011100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100000000 #b0101001000100001100011101000011100111010010110000101)
                expect
                (fp #b1 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b1 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                expect
                (fp #b0 #b00100101100 #b0111010011010111110001100011101000111000110101101010)))

(assert (= expect result))

(check-sat)
(exit)
