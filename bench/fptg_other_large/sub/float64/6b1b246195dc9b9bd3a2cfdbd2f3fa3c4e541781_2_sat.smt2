(assert (fp.leq (fp #b1 #b00001110100 #b1101001000000110111100001001000000101101011011011110)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11001000000 #b1111111100010001101111011110000000110000011001100001)))

