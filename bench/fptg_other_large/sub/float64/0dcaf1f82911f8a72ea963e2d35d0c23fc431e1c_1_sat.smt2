                arg2
                (fp #b0 #b10100010110 #b1001110000011111100011000010000000100101100100010011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010001110 #b1010000100011110010111110001101101011010100011011111)
                expect
