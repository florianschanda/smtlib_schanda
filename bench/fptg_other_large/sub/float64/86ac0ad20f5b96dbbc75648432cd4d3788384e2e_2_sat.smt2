; Format: FLOAT64
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110010010 #b0100111111011100110000011000111010011011011011100100)
                arg1
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00000001110 #b0010111100110110010110110100110111010010101010110010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100010110 #b0100000001011110100111001000000101101010001110111100)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b11010010000 #b1001001111000000010101100010100011010111001001100100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00010000100 #b1010010001011101011100110101011010101010110000000010)
                expect
                (fp #b0 #b01001100100 #b1001000011101000110011011000111100000110101101010110)))
(assert (fp.leq (fp #b0 #b01001100100 #b1001000011101000110011011000111100000110101101010110)
                expect
                (fp #b0 #b10000011110 #b1111111100000000100011000000110110101110001000100100)))

(assert (= expect result))

(check-sat)
(exit)
