(assert (fp.leq (fp #b1 #b10100100110 #b0101011100001001111100000101011110001001111010110110)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01001110100 #b1101000001010101010111001011000111000110100011011000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101010011 #b0010100010111100100110000010011001111101011111111100)
                expect
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                expect
                (fp #b1 #b01010101001 #b0000011000011010000000101011110110010000101101111101)))

(assert (= expect result))

(check-sat)
