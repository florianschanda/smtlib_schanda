                arg2
                (fp #b0 #b10011000100 #b0011011000011100000010110010101000110100110100111101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01111110110 #b1001100011110111111000111010011110010000010111001011)
                expect
