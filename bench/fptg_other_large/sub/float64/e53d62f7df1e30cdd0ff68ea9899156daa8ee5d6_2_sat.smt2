                arg1
                (fp #b0 #b11101110111 #b0000100001000101100011100100001001100101111000000101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01011010000 #b1100001111111001010101100001110110000000010111010001)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b00111001101 #b0000000001000011110001011101001101000101001111101001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01110101101 #b0001100110100110011001001011100110010011010001101111)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011001)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011001)
                expect
                (fp #b0 #b11000001101 #b1010101111110010111000110101110010000001100101011100)))

(assert (= expect result))

(check-sat)
(exit)
