; Format: FLOAT64
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111000 #b1011100100111001011101011100101010101111101011000000)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00011100100 #b1010110100111100100001100101101010111101111101111000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00010000101 #b0111001110110000010000100011001010010100011001101001)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11101011101 #b0100001101011011000010101011101101100101110000110010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010001110 #b0000000000111000001101100001100111100101100011101110)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                expect
                (fp #b0 #b00110101011 #b0100101010100110001110101010001011100000101110011101)))

(assert (= expect result))

(check-sat)
(exit)
