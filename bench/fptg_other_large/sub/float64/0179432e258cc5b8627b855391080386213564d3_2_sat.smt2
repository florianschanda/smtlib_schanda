                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00111001110 #b1100001001010011111101001100101001001000111101100001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011101111 #b1100001000000110001110111111011111010101101001001000)
                expect
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10111001110 #b0111011000100010001101010001100000001111111111001000)))

(assert (= expect result))

(check-sat)
(exit)
