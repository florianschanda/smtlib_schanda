                arg2
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10001000011 #b0010011010011010000100100111111001001001111001010101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000010001 #b1011101010000001101000010111010010111010111110010101)
                expect
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01101000100 #b0111000000100000001100010010101101101111111001111011)))

(assert (= expect result))

(check-sat)
(exit)
