(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011110011 #b0001001101100001000010001010110111001001001110000011)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11010010001 #b1111011110110101100100100111011100001011000010110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01011000000 #b0100111101000001111001111111110110000001010100001100)
                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b11110101000 #b1001010101001010101100000000101101100100111011010010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101000111 #b1000111100110001010001101011010110110011101001001100)
                expect
                (fp #b1 #b10100100011 #b0001001011100110011011111011010000011110111000111101)))
(assert (fp.leq (fp #b1 #b10100100011 #b0001001011100110011011111011010000011110111000111101)
                expect
                (fp #b1 #b00101001001 #b0010111011010110100100110111101000001100101101000101)))

(assert (= expect result))

(check-sat)
(exit)
