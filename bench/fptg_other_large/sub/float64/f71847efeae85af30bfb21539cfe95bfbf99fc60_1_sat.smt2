(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11010010110 #b1100000000001110110100011001100011011110001011010010)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11000101111 #b1111100110111100101111111111100100111011101100000010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001111110 #b1101111100100101011111000110010101101110000100100111)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b1 #b10011010000 #b1100011000000010000111001110001101111000001000101010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100101001 #b1000000011111100011000001001011001010001010111010001)
                expect
                (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                expect
                (fp #b0 #b10100110000 #b0001100111000011110011011001101100100101010110001100)))

(assert (= expect result))

(check-sat)
(exit)
