                arg2
                (fp #b0 #b11010100111 #b0100111000100001110010000000000010010110100011000010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101110000 #b1011101111110111111000110001000011011101001001011010)
