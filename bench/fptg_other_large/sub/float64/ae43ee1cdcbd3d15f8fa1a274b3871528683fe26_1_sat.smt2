                arg2
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10010111000 #b1110100101001101110001000110001000001010100010001100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011000111 #b1111101111011111011010010010001100000001101001110011)
                expect
                (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)))
