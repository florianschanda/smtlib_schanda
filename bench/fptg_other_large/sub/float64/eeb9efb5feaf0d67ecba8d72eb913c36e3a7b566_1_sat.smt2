(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010010010 #b1011110001101111001011111100110101100011111011010010)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110110100 #b1000001101101000111010010000001111010101000011101111)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
