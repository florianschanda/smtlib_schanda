                arg1
                (fp #b0 #b11101100100 #b0001010010001010011100100001000011001110000111110111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111110110 #b1100101110110001110101011110010111010010000110110001)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111110 #b1010111000000110011110010011110000000011100111011100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0111010000000011011010110010011110000110010011000011)
                expect
                (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b01010100011 #b0100101111010010001011101100011000010110001111001111)))

(assert (= expect result))

(check-sat)
(exit)
