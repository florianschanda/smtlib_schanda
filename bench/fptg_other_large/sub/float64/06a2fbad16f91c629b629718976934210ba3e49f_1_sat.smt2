; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010101101 #b1000101000111111011101110000011010100100011101111110)
                arg1
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg1
                (fp #b0 #b11101000100 #b1010100110000001110101100000101100011110111101001011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011000001 #b0001101011010000011110011110011010110001101001011010)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11001101110 #b0110001101100111001001100011010011100100010001111001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111111011 #b0101101101100111000101100001111101101111000111111001)
                expect
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011011)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011011)
                expect
                (fp #b0 #b11011010110 #b0001101110000010011010000100000101111110000000110111)))

(assert (= expect result))

(check-sat)
(exit)
