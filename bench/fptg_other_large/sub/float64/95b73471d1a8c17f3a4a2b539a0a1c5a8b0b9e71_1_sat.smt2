; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01111110111 #b1110100110111101101001010011100010111111111011111011)
                arg1
                (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)))
(assert (fp.leq (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)
                arg1
                (fp #b0 #b01010100101 #b1000110111001110111011110111101000011101100100001000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001111011 #b0000101011011001011001100010000001011011110010101101)
                arg2
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01100100110 #b0000010110101001111010110111000110011001010010110011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110010000 #b1110100111100001100101011101110000010101001110011000)
                expect
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10110111011 #b0010011000101101101010010010011001100001000010010100)))

(assert (= expect result))

(check-sat)
(exit)
