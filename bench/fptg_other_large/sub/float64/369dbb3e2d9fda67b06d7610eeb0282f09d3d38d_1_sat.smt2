; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101110000 #b1100110000101111001111001011110101110101011100101111)
                arg1
                (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)))
(assert (fp.leq (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)
                arg1
                (fp #b0 #b10000101100 #b0100100010000100111011100000110111011100100011011101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00001011000 #b0100000111101001110010010100100001110010110110010010)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11111010010 #b0010000000101100101011110010010010010101000110101010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010100100 #b1100101000111100101110000000001010011011110101000010)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)
                expect
                (fp #b0 #b01101110111 #b1001101111111100111111010010110100111100100001001000)))

(assert (= expect result))

(check-sat)
(exit)
