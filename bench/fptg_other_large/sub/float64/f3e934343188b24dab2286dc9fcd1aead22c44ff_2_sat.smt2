; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011100011 #b1001001010000000110010001000101100001110010011001001)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b0 #b00100100101 #b0010101011101001000110101000100101010100100001011001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101000011 #b1011100010101010110000010111010001011011111111010100)
                arg2
                (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)))
(assert (fp.leq (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)
                arg2
                (fp #b1 #b00101000110 #b0101100010001001011111011011110001101001110000111001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101000000 #b1110110110101011101000111110111010011001100101111100)
                expect
                (fp #b0 #b11011110101 #b1111001110110000110000000000001000011000111011100101)))
(assert (fp.leq (fp #b0 #b11011110101 #b1111001110110000110000000000001000011000111011100101)
                expect
                (fp #b0 #b11100111000 #b1110101011111110001001100101011011011010000010100010)))

(assert (= expect result))

(check-sat)
(exit)
