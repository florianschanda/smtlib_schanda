(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010010110 #b1000101001000000011001011011111100100101111001100010)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b11101000111 #b0110011110110000110011111101000101011101001011010100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00010101011 #b1000111101010110000000100011010000110100001010001100)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11101100001 #b0010000111100010100011101000100110001100110111010101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000100000 #b0101101010100011001001010100001111100000001100011000)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                expect
                (fp #b0 #b01010000101 #b1100100010000000010010111111101110111010000001110100)))

(assert (= expect result))

(check-sat)
(exit)
