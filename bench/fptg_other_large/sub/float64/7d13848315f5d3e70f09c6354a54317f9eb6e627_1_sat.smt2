; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101001001 #b1011000010101010100010110000011110101110111110111000)
                arg1
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                arg1
                (fp #b0 #b11100100010 #b0011110110111000000001000110011000001010001111011001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01011111110 #b0101111001011000111101010111110101001000001011000111)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11011111001 #b0100111010001101110101011010010011111011001111101001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110001011 #b1010110010111011100111000101111100010000110010001010)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001110)))
(assert (fp.leq (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001110)
                expect
                (fp #b0 #b10100110010 #b1001000001101110000001010001100011011001110000001110)))

(assert (= expect result))

(check-sat)
(exit)
