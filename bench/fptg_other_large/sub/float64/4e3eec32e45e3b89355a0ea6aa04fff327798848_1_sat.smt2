                arg2
                (fp #b0 #b01110001110 #b1100111111000010101110010101010001101110001010101110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01011001001 #b1000110100111100010001001001110000110000101000111110)
                expect
                (fp #b0 #b10000110001 #b1011001110000111100110000001000000010101101000101111)))
