(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110110101 #b1101110100000010010011001110100001000111101111110010)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11100110100 #b1001010000101001110101111100111001100100001111111111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100010110 #b0011101000101101111110110011001100011000011001101011)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b0 #b01001001101 #b0101111100000001011001111100100100110010110100111111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01001100101 #b1111110111100101001100110101100001111000000011111111)
                expect
                (fp #b0 #b10000110001 #b1011001110000111100110000001000000010101101000101111)))
(assert (fp.leq (fp #b0 #b10000110001 #b1011001110000111100110000001000000010101101000101111)
                expect
                (fp #b0 #b11010000111 #b1110011010011000011010011000111100010100101110111010)))

(assert (= expect result))

(check-sat)
(exit)
