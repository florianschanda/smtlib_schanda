                arg2
                (fp #b0 #b10111110111 #b1110010101111110000010110011100001111000011101000010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000101010 #b0011001100011111100011000001111100000100010111001100)
                expect
                (fp #b1 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
