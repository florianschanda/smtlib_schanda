(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011011110 #b0001101101111100010001000100101101100010100010100100)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b00100001100 #b0101110010001001011010011011101100110000000111111000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010011110 #b1001000000000000010101000000001011001010111000111001)
                arg2
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b1 #b00100111110 #b0011001001101000011000110011111111100000010010001000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101101111 #b1101000111011001010110111000110011010111101011111001)
                expect
                (fp #b0 #b10111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000010000 #b0101101100111010100001111011010110101000001111010101)))

(assert (= expect result))

(check-sat)
(exit)
