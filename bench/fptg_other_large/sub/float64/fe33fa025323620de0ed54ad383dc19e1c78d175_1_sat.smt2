(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110110101 #b1100100010101000000000010000001001011100001000110101)
                arg1
                (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)))
(assert (fp.leq (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)
                arg1
                (fp #b0 #b11011111001 #b1101000100010101101011010010000010000110110110000010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01001011100 #b1011110001111001111110000100110101001011111101111110)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b10110000010 #b0010010000011110101011101001110011010101000100010101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010001001 #b1000011001111011001110111001000101000110010000100001)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)
                expect
                (fp #b0 #b10010101110 #b1110011100111000001101000011011110001110111100000100)))

(assert (= expect result))

(check-sat)
(exit)
