(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +INFINITY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01111011111 #b0110110111111100100010010100100110001000101010010101)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10100110100 #b0001011110101110110110101110000111111101110000110010)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
