(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b00111010000 #b1001110001101000100101111001001101011100101110010110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010001011 #b1010011011110010010111010000100000100110001101000010)
                expect
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111110)))
