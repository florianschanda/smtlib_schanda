                arg2
                (fp #b0 #b11010111001 #b0001001010111101011010010011010011110100110101011000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000100000 #b0100000101100101011001010000000110110100111000110100)
                expect
