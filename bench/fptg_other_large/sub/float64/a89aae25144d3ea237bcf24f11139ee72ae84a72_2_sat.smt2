; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001111010 #b0000011000011110110110000001010100001001010010100111)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100100100 #b0010000110101101100111010000100110001011010111101000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00011010101 #b0100111001101011010101000111100100110100011110101100)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11011011001 #b0000111100000101100010010100101111000000101000110100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001110011 #b0111110001100001010011100001011110011100011101011000)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                expect
                (fp #b0 #b00110110111 #b1110001101100011000110100101010101111010001001111111)))

(assert (= expect result))

(check-sat)
(exit)
