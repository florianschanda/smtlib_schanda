; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00011111100 #b1000011011000110111111100101111100110011110100100001)
                arg1
                (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)
                arg1
                (fp #b0 #b11000010001 #b0110100011111100101000011100101111110011000110001010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00000000001 #b1010110100110001101111110111111101001100011010110101)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10001100011 #b0011101100011010010001110100010000100010110110101011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111000110 #b0001110011110100100110011110000000110010010110111010)
                expect
                (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110010)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110010)
                expect
                (fp #b0 #b10011000001 #b0111111010000111000100001111100001100100010111111010)))

(assert (= expect result))

(check-sat)
(exit)
