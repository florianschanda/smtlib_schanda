; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110011110 #b0101111111100010101001010001001000110000101010111000)
                arg1
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)
                arg1
                (fp #b1 #b00110101000 #b0011100100010111010010111111000001010001000111010011)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10011111010 #b1110001110101111110100011101111001000100010000111011)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01101011111 #b0110001001011111011110000101000011011110100110001010)))

(assert (= expect result))

(check-sat)
(exit)
