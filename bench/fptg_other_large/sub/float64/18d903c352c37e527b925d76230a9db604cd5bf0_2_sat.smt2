(assert (fp.leq (fp #b1 #b11101011111 #b1011111100010101110011111110010001010011011001000001)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11010011000 #b0110110100010100011100110101111011111010011111111001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000100100 #b0101001110110101111001111100110110011001000110011100)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000111110 #b0011100111111001111110000100111010000101011110100011)))

(assert (= expect result))

(check-sat)
(exit)
