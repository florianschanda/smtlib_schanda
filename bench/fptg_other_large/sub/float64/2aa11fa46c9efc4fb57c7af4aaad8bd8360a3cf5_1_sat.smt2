(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0000100001110101010011010100010000010101001111010001)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10010000001 #b0000010010011000110111010101100101110000011011010001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011000111 #b0011011111111001001101000011100011101111000100110101)
                arg2
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10011001001 #b0001100001110001000010010111111111110110101111100000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1000011110010001010010100001100010110110010011010110)
                expect
                (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b00010010101 #b1100010100010011100100000011010111001111010011101001)))

(assert (= expect result))

(check-sat)
(exit)
