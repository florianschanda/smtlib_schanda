(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001011011 #b0101011111010111011110000000111000111100100100011111)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b11010001101 #b0001011101010100100000101011110010110100011101111110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111110101 #b0010111011011101100101011100111110110010101100111110)
                expect
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                expect
                (fp #b0 #b10101101011 #b1010010101111000000000010101000011111111010010110011)))

(assert (= expect result))

(check-sat)
(exit)
