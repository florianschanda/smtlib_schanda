(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -ZERO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101001011 #b1010011000000110011000010111011101110100100111001001)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b00010011101 #b1000000101011010111101111111111110111101111110000110)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00011101001 #b0110010101000100100111011101010000011010110011011101)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00010010011 #b1111100101101101010111001110011011010110000000101101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001101110 #b0100010001001010110011111001001101011111100011111010)
                expect
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                expect
                (fp #b0 #b10101100011 #b1001000011100000101100001011011110110100101110000010)))

(assert (= expect result))

(check-sat)
(exit)
