; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100010000 #b1011111110001100111010111010010101010101111111101100)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b1 #b01100011111 #b1110010001101100010101001011010110000111111001001010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110001011 #b1111100010101101111010011001110011011111100110100111)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10110101010 #b1101100010011011111101110001001101010100111101111010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100100001 #b0101010000100011001000000110001111111110110001110101)
                expect
                (fp #b1 #b10000110100 #b0000000001110010011110000011110101101110101100100011)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000001110010011110000011110101101110101100100011)
                expect
                (fp #b0 #b10100001011 #b1010011101101000100101001011001011100100101001101010)))

(assert (= expect result))

(check-sat)
(exit)
