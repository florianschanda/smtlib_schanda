                arg1
                (fp #b0 #b11100100110 #b0100001101110111111101011000010111101010001000110010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01111010011 #b1001100000000000000000100111011011001001000110000110)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000000110 #b0000001010100001000010110111101010111011010001110100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010101100 #b1011100110011010100110100011001000001010000010010010)
                expect
                (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111110)))
