(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010010011 #b1001011011101000001001101110011000011011101000011100)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11100011000 #b0110110001100101101001110010000010100000110111011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101100011 #b1101000101011101010111000001000101000111000100001101)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111101 #b1010110010001011010110101100000101001000000010011101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0100110000101100000001000100100101011000111001111001)
                expect
                (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11011010000 #b0001101001110011100111101001000001100010111111010111)))

(assert (= expect result))

(check-sat)
(exit)
