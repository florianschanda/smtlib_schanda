                arg2
                (fp #b0 #b11010110000 #b0000001100000110001100001111110000000111110111011010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111010 #b0010111111101101111011101010011000011010100101110000)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
