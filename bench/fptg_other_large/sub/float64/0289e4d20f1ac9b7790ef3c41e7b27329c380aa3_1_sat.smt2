; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011100011 #b0010101111101100101111101001101111001011110101110101)
                arg1
                (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)))
(assert (fp.leq (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)
                arg1
                (fp #b0 #b10000001001 #b0111010101001100101100011101010011001000000100101111)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
