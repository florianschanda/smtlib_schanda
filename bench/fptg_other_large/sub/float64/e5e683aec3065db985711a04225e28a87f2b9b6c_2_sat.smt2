                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b01111110110 #b0110101101111111101010001110001000010100001010001100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01100001101 #b0010111111010010010001110101010110111111011011111110)
                expect
                (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111111001)))
(assert (fp.leq (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111111001)
                expect
                (fp #b0 #b11110100000 #b1011100110010110111100001110011010001111010001011001)))

(assert (= expect result))

(check-sat)
(exit)
