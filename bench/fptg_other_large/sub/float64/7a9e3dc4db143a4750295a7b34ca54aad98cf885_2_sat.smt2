(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000101011 #b0100111111001111110111110101000010010000011011000111)
                arg1
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)
                arg1
                (fp #b0 #b11111010110 #b1001010001001110100100001100111000111011001101100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011001001 #b1011001101001011101111111100001010111101000110101110)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11001010000 #b0100010101000111100001100010111011100101001100001101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110111100 #b0101100000000011000111010111100111010000011010100000)
                expect
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110101)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110101)
                expect
                (fp #b0 #b11110101100 #b0111111001011011110100100001001001100111100010111000)))

(assert (= expect result))

(check-sat)
(exit)
