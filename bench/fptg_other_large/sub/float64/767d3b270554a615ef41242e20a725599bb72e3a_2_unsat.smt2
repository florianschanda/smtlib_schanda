                arg2
                (fp #b1 #b01011101110 #b1000110110100001010111111100111010000100000111101101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00111111110 #b0011011011110111011001010000100001101100100010000011)
