; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010011010 #b0111010001101000001000111110011101111110001000001111)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b00001100110 #b0011011100011111011110001110111100101001011011000101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b10000111000 #b1101011101101111110101110100011101001100001100001000)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b10111101000 #b1010000001011100000110100110011001101010111011100111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100111001 #b1111010110100001001101010111011110111011110011010011)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                expect
                (fp #b0 #b00101110011 #b0110101000000110011000011110101110100110000001111010)))

(assert (= expect result))

(check-sat)
(exit)
