                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b11001010100 #b1001000101100110101011001101010010010101110110111000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010101010 #b0011011000100001101110011100001110001011001011011100)
                expect
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b1 #b00111111000 #b0110110110100110000101100100101100111011010100011100)))

(assert (= expect result))

(check-sat)
(exit)
