                arg2
                (fp #b0 #b11000001110 #b1001011001111101010100010100100011001100001101111001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01110100110 #b0111100101101111111010110000111100101010111101001101)
                expect
                (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
