(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010101001 #b1011000110110011001001011110110110011001001111111101)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b0 #b10000100100 #b1001101000111111001111010101011101001000111011100010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01101001000 #b1010000011001000101110101011100011100011011111100001)
                arg2
                (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)))
(assert (fp.leq (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)
                arg2
                (fp #b0 #b00011000001 #b1001000110010001000101111110010011101010101001101001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110100001 #b0001101110010000100110001011100000111010101111001111)
                expect
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011110)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011110)
                expect
                (fp #b0 #b10110101110 #b1111011100100110000011111001100011001011111110011101)))

(assert (= expect result))

(check-sat)
(exit)
