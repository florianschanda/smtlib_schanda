                arg2
                (fp #b0 #b11101011100 #b0001000000101000001100000000100101110010000001000111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111001110 #b0100010010111010100011101110001100101111001101010111)
