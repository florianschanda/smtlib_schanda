; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000010110 #b1000000100010011101111110011111101100111000110011010)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b01100011100 #b1100110110001001111101110110101000101100010000011101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b10011110001 #b1001110000001000001000110000101101001000110100100101)
                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b11001000101 #b1111100111010010100001011101101100110011000100000100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111100000 #b0010100010000110011000111100001001110011001100100100)
                expect
                (fp #b1 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b1 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                expect
                (fp #b0 #b00110101110 #b0101000001111001001001010101100001111101000011111000)))

(assert (= expect result))

(check-sat)
(exit)
