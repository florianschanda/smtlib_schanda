; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00000101111 #b0110010110000110000110011110000100111101111000000000)
                arg1
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                arg1
                (fp #b0 #b10110110001 #b0100101100010011011001001101000000111010011101001010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111000111 #b1000100010100001011001011100110101000010000001011101)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b01001010001 #b0111011010100001100011010000001100100000010010011111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00110101000 #b1001101101011110110000000011110000011110011000100100)
                expect
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100001)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100001)
                expect
                (fp #b0 #b10111110101 #b0111010101001110100101010011010001100101100000110101)))

(assert (= expect result))

(check-sat)
(exit)
