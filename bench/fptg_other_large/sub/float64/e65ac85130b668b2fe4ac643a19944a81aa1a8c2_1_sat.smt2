(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110000000 #b0001001000101001101011001101001101110010111110001100)
                arg1
                (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)))
(assert (fp.leq (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)
                arg1
                (fp #b0 #b11001001101 #b1011011011100110001101111101001101101111011000100111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101111100 #b1111000101101100010101011111011000010001100000101110)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11100100010 #b1000101011110110000000100010110011100011010011100111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001000001 #b0110001011000100111101001101100001000011101011000101)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100001101011)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100001101011)
                expect
                (fp #b0 #b01110110111 #b1000011100100011001100010000110101111011011100001100)))

(assert (= expect result))

(check-sat)
(exit)
