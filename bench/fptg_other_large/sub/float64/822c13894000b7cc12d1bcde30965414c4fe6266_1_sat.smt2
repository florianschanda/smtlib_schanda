                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10110011010 #b0011111110101010000110000010011000000010100111111100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00101011011 #b0011110110011011010010111101001111110010110110111010)
                expect
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
