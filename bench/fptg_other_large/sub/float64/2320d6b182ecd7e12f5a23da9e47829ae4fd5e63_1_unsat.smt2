                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11001011000 #b1000010101010101010101011111000000101011011011000011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111010110 #b1010010001100011000110110011000101101101011100011011)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001110)))
