; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1111011010010000011101111101011011100110001110101011)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10000001010 #b1011100111000011111011101101111110000010010001011101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111000001 #b1000110010101011100100101001111100010011001100001011)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11100100100 #b0110011110110110110101101001111000001010000111110100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0010010100111001101001010110111101111111100000001000)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b1 #b11110110100 #b1101100110011010111010110111000011010010000101011100)))

(assert (= expect result))

(check-sat)
(exit)
