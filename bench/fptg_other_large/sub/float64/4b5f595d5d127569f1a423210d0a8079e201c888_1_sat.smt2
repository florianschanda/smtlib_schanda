;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101010011 #b0100111001110101011000111111001101110100110000001001)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11010011100 #b0110010001010000010001001101101101000101100001010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100101111 #b1000110101011111000001101111101110011100001101001101)
                arg2
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b1 #b01111010101 #b0101010101111010111100011101111001101110101000001001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b11011010101 #b1000011100010000100100100110100110011101111010001011)
                expect
                (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001001)))
(assert (fp.leq (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001001)
                expect
                (fp #b0 #b11100110001 #b1100110111110001100111000110000101010000010111111010)))

(assert (= expect result))

(check-sat)
(exit)
