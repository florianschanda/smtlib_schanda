; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11110110111 #b0001000010011111011110011001100010001100000000110100)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111010000 #b0010110101101111101111100010111000111101101100000110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11000001110 #b0010100001111001010000001010000010001110100100100001)
                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b01000111010 #b1101101100000010011100000001000000101101111000111001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111011000 #b1101000001011001111101010010001100011010110000101110)
                expect
                (fp #b0 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                expect
                (fp #b0 #b10011100010 #b0100011001100100001111001111100000110001011000000011)))

(assert (= expect result))

(check-sat)
(exit)
