(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000110000 #b0100100100101011111010011101110111000110011110101001)
                arg1
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11011001111 #b0010000011000101000111101000101110110101010000011110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10101100100 #b1110111000000111000000101011011101001100010110010001)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b10011111000 #b0000110101001010001010110100010011001111000000111111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001100111 #b0000010111000011011110000101111000111000010101011101)
                expect
                (fp #b0 #b10111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11101000100 #b1010110000011110000010011010011110000111111110011100)))

(assert (= expect result))

(check-sat)
(exit)
