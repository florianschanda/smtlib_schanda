; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110011011 #b1000101110010011110110100111010100111001001001001011)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b00001000001 #b1011110011000010001001100100101111111000110100101011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00100101000 #b0001110100011110110001010001110001001000111010100011)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b10110000110 #b1010111011100101111110101100100110101001111111001110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001101101 #b0001001110011110000000110110101001110101111010010110)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01001101011 #b0100010100100111000100000111111100001110100000001110)))

(assert (= expect result))

(check-sat)
(exit)
