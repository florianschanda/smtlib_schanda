; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101110011 #b1101000100011001010110000011111110110111110100111100)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b11010001110 #b0111010000101101111001101011110110010101101110001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111010100 #b0111111001110101000110111101010011001111100100100000)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b01100010011 #b1111000011101111100111011011001010111110100011000110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011011011 #b0100001010000010101100111011111100100010000010010111)
                expect
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101110)
                expect
                (fp #b0 #b11110010110 #b0000101111111010010011111111101101010110010100110001)))

(assert (= expect result))

(check-sat)
(exit)
