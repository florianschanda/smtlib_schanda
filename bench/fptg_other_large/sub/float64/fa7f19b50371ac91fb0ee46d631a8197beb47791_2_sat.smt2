; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010000010 #b1100100010011111001101101011010111100001010110100001)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b10110110001 #b0100110110010111001001011001100110100010011111011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00110110000 #b1000101100011111110000011001010111000011001111000010)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11111101001 #b0101101101111011001000101101111001100001100010010001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001101101 #b1000111111001101111010111110101000000000110001010010)
                expect
                (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                expect
                (fp #b1 #b00001101000 #b0011101011000110110111110010011011010010001101110111)))

(assert (= expect result))

(check-sat)
(exit)
