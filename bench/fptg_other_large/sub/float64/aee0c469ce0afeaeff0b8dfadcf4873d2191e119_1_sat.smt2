(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10010110111 #b0111111000100101000010011100100000110000111011101100)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110000000 #b0100101111101101000110000010001110100000000100100110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100000110 #b1011110001010000111111011010111011111010101000110101)
                arg2
                (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)))
(assert (fp.leq (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)
                arg2
                (fp #b1 #b11010100100 #b0011100101110011111101111011101001111101101101111100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011101100 #b0011110101110011110010001111011110111111011101100100)
                expect
                (fp #b0 #b11011110101 #b1111001110110000110000000000001000011000111011100101)))
(assert (fp.leq (fp #b0 #b11011110101 #b1111001110110000110000000000001000011000111011100101)
                expect
                (fp #b0 #b11110001111 #b1111010110110010001111010001111110001100011101000110)))

(assert (= expect result))

(check-sat)
(exit)
