; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110101010 #b1000010111001011011100100001100110010011011000010111)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b00101001101 #b0100010011100110110000001001101010100010011101010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00011010110 #b1100011001011100110011111000000001001100110100111010)
                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000000100 #b0000000010110000001110100010110000011111001110111110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110100000 #b0111001011111110101111011111110001000101000011000001)
                expect
                (fp #b1 #b00000000001 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000001 #b1100010010101010101011011100100001001011100000001100)
                expect
                (fp #b0 #b01100000100 #b0011110001011011010111001101001111000101000011011011)))

(assert (= expect result))

(check-sat)
(exit)
