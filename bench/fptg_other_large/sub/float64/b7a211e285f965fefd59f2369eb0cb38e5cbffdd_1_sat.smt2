; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101111001 #b1011111100101100000100011111001010101011101111111000)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b11001011111 #b1101011011011011010101111000011101101101110010011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110000000 #b0110100001110101111100001000001001110000100010100010)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01000001011 #b1100010011101001101100010111000010010001000111101011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110100100 #b0001011011100000000010000100100110101000100111000111)
                expect
                (fp #b0 #b00000000000 #b0011111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b0011111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b10111010100 #b1111101110101110110111110001101000100110111111100000)))

(assert (= expect result))

(check-sat)
(exit)
