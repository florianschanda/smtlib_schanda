(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101110000 #b0111001110110001010001111111101101110100111100101001)
                arg2
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b0 #b01100110110 #b1010011010011010000100000000100010100101100101000101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10011111001 #b1000000000111111100011010011101010110110010111111101)
                expect
                (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                expect
                (fp #b0 #b11111010010 #b1001001010101111100001010101100110000111111110110111)))

(assert (= expect result))

(check-sat)
(exit)
