; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -ONE

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0101011101110010001101110001000110000100000011101000)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10110011011 #b1000010000100111101110101110010010011000100110111000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001100001 #b0001011000100110111001010001110110000111110001111111)
                arg2
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b01101011101 #b1001101011000010001111000000101001111000011001111000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b1000001101101010101111101001001110000111101010001111)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b00101111000 #b0111000101001101100001000111111001000101001011011001)))

(assert (= expect result))

(check-sat)
(exit)
