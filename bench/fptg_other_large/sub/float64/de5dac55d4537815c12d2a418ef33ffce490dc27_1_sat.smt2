                arg2
                (fp #b0 #b10101010001 #b1101111100110100000000101111000100111001000001101001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100101011 #b1000110001111101011011000111001000111110111101111111)
                expect
                (fp #b1 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
