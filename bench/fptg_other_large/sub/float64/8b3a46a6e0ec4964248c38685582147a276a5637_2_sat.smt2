                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11110010110 #b0100110100010011111100101010001110101001101100001110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000010011 #b0110111000001111000000000000011100000101010111100010)
                expect
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
