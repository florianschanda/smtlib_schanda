(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10101011111 #b0111010010001010010000001110100100110011001110011100)
                arg2
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01001011000 #b1111111101010001101100010110111000000001111110010011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010110100 #b0110010111011000000000000000111111000110100100110110)
                expect
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01001111001 #b0101101011010000000110010000010011110011011101111001)))

(assert (= expect result))

(check-sat)
(exit)
