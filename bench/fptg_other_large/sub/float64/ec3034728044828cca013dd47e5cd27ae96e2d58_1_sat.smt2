(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01001110101 #b0011001110010110101111000111001001010110011111010101)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11110001110 #b1000010110100110111110010110100001010111000110110011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001110100 #b1010111000001111011100011110010000011111111111101001)
                expect
                (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                expect
                (fp #b0 #b10110101111 #b0001001010011110111010111011110110100011100010011001)))

(assert (= expect result))

(check-sat)
(exit)
