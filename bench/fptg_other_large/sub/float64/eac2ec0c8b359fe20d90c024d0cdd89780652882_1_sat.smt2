; Format: FLOAT64
; Arg1: +ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010011111 #b1001101001100100000101001110110000100111010011111101)
                arg1
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11000010011 #b1000011011010110111110101111001111100111000011110000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011101000 #b0000010111110001010000000101111110011010110001010010)
                arg2
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01011011111 #b1000010111111000101011110111110011001101010001000101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111110101 #b0110001011101100111110110100101000010010000001001111)
                expect
                (fp #b0 #b01111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b01111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b10001011000 #b1111101110101010010101010000111011100111000101110101)))

(assert (= expect result))

(check-sat)
(exit)
