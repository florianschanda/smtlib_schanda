; Format: FLOAT64
; Arg1: -LARGEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10100010010 #b0010011010010100001000100011000000101010110111011011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00001001101 #b0010011010001111000100101101010111111111000010010101)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11011001011 #b1011000111110000011010000000110111100111011111111010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b1 #b01000111110 #b0001010010001011010010011111101111000111011010000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
