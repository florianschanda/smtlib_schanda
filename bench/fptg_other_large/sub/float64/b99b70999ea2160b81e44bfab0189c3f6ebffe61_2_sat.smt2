                arg2
                (fp #b0 #b11100111000 #b0001001100000010001010101000000101100101101110011110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110001100 #b0011001011110000011111111010100001110101111101010100)
                expect
