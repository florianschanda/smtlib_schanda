; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0100010111101010111110100011111011001111010011001001)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11001010000 #b1000011001110001011010000110000100011000000101010100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010001111 #b1010010001110101110001000111101110010101010100001111)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b10101011110 #b0100110011111110010000011110111111000110001111011000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0010100100011100000010010101000010010101101101010110)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00110000100 #b0001101011001101000111110101011001001110001010000010)))

(assert (= expect result))

(check-sat)
(exit)
