; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101010001 #b0011101000011001011110100100101101100100110111010110)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b10000100100 #b0000000001110111101111000010010101110001100101000001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b10111110111 #b1000110110101000011110100101110101010010011000100111)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111101 #b0100000000111101000110111000100010101011111001000100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1111011000100001000101001011111010000111010101010010)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b1 #b00010111100 #b0010101110010001001001100100001111010110000101111100)))

(assert (= expect result))

(check-sat)
(exit)
