; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111010100 #b1111101010110101100000111011101011111011110110010000)
                arg1
                (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)))
(assert (fp.leq (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)
                arg1
                (fp #b0 #b10010101000 #b1110010101110000000100110011110000011111011101001001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010000110 #b1100101111011110010010100111110010100001001001010001)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10100110010 #b0001111111100011000011010110111000000100001110111101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111101000 #b1101000100000111101010001100111100101001101011101001)
                expect
                (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110110)))
(assert (fp.leq (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110110)
                expect
                (fp #b1 #b01001010011 #b0000011100101000100100011110001111101100110011011100)))

(assert (= expect result))

(check-sat)
(exit)
