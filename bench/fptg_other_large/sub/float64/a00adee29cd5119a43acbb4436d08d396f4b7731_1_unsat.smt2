                arg2
                (fp #b0 #b11101011010 #b0110010110110101001110011111100101010111101000110011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000011011 #b1101101111000010110101010110101111000111110010111000)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
