(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111111111 #b1111010101001001100010100100010101001001000001000001)
                arg1
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                arg1
                (fp #b0 #b01100101010 #b1010011110111100001110001111101000000111110100110111)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
