; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010111101 #b1010000101110101001100001001000000011100111011111100)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01000010101 #b0111111010011111110100100100011111010101100000101101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111000000 #b0010101001101000001001101100011100111101011001101010)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b01000000001 #b0010101000010000101000111001110101010100001111100001)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00011011101 #b1011100100001001011011011000111011111110001110000111)
                expect
                (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111110111)))
(assert (fp.leq (fp #b0 #b10100100001 #b1001101000111100100101110000100111110100101111110111)
                expect
                (fp #b0 #b11001001110 #b1101111101110110100011001001111110011111110110010111)))

(assert (= expect result))

(check-sat)
(exit)
