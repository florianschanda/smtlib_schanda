; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01101001100 #b1111011000010111011100110000000110001110010000111110)
                arg1
                (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)))
(assert (fp.leq (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)
                arg1
                (fp #b0 #b11001100111 #b0111000001000000011110011110110001100011010111101101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111100000 #b1000011001011010010010001000011101101010101111101100)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11000111111 #b1110110011010001001110010000010111001101110011110100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011011101 #b1010011100100010001101011011000100100101110111101110)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001110)))
(assert (fp.leq (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001110)
                expect
                (fp #b0 #b00101001011 #b1111001011001011111111111011010010010111011010001110)))

(assert (= expect result))

(check-sat)
(exit)
