                (fp #b0 #b11110111010 #b0010001110011001010000101110101011000011011010100100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001110101 #b1100011000011011001010000011011101000110000001101011)
                expect
