                arg2
                (fp #b0 #b10111110011 #b1111010001000000100101111101010111010011000001010111)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100001001 #b1001001011001100100111001000011111010110011111001101)
                expect
