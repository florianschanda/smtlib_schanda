                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b1 #b10010110110 #b1011001110101110111000011100001110110110100011110011)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10100111011 #b0011110101010000000110010010000110111100110110001010)
                expect
                (fp #b0 #b11011110011 #b1101111100011011111110101010000000001000001111001001)))
