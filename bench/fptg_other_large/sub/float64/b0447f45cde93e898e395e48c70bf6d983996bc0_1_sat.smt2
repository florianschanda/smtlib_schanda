; Format: FLOAT64
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011001101 #b0000101101111100011011000011001011011011000001101011)
                arg1
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10100011000 #b0011010110100001100010110011010011001011101011101110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011001000 #b1001010100001001100101001101111000010111000100010011)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b00101011100 #b1101011111101100100010011100110001111110000111110101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000110011 #b0001001111110100101010001010111100011001001100100100)
                expect
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b0 #b01001001000 #b0000101111010111011001010011010000110110011000101101)))

(assert (= expect result))

(check-sat)
(exit)
