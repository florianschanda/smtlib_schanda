(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01011010011 #b0100111010001101000001011101100010110111100111011110)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01011100010 #b0111001011111011111101111001101101100101110011101001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0100001001100110100101010000110011110010000000111011)
                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00101011111 #b1100101111100001001100111001110101110100001111110000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00110011101 #b1011111000110100000011001011011110111111101101001011)
                expect
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111111110 #b1101011000000011101011101011111110010010101100010010)))

(assert (= expect result))

(check-sat)
(exit)
