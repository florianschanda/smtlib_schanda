(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010011011 #b1101000001011011111011011100111010100010101111101010)
                arg1
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00101011101 #b1011111100001000000101110000001011110011011110101110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101011011 #b1111000001011111111111111001101111010111101000101011)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b10010100100 #b0000010011011111010100010011010011000000010100001000)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101100011 #b1010111011101000111011111000010001001001100111100111)
                expect
                (fp #b0 #b10000110011 #b1010110010000100101011101010011000100101110101110110)))
(assert (fp.leq (fp #b0 #b10000110011 #b1010110010000100101011101010011000100101110101110110)
                expect
                (fp #b0 #b10100110101 #b0111001111101100100101100101000011001101010001101100)))

(assert (= expect result))

(check-sat)
(exit)
