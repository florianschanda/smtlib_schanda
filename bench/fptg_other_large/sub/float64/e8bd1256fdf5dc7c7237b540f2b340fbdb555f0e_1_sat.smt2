; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011101011 #b0010010011101000110000111000101011001001101100100100)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b11101000101 #b0000001011001101011100010001010011101010000101001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00010010111 #b1110001001110010100110001100010001001010101110101011)
                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b11010010011 #b0010010101110011101100000010011101010010100110000010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110100010 #b1111000001111010000011101011110111110001000111110101)
                expect
                (fp #b1 #b10110101101 #b1111010110101011010111001000001101011100110011110100)))
(assert (fp.leq (fp #b1 #b10110101101 #b1111010110101011010111001000001101011100110011110100)
                expect
                (fp #b1 #b00001011101 #b0101110111111001110001101010111110110100100010010001)))

(assert (= expect result))

(check-sat)
(exit)
