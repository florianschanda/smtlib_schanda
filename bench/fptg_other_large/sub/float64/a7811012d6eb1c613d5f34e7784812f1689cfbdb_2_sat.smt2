; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010010100 #b0100111111011001110000000110001000000110111010010010)
                arg1
                (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)))
(assert (fp.leq (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)
                arg1
                (fp #b0 #b11001011110 #b1100100010111010100111110001111011110011101011100010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111010111 #b0101100100100111101010000110110000010010001111010010)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11101101101 #b1101011001101000100011101100110101001010101111000101)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101001110 #b1111001100011111001001000100010110011000110110100011)
                expect
                (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b1 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                expect
                (fp #b0 #b10111111011 #b0000100011010110101111110100010111010111110010011010)))

(assert (= expect result))

(check-sat)
(exit)
