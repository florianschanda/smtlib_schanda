; Format: FLOAT64
; Arg1: +ONE
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01010111010 #b1100000101111000101001111010001110100111101011111100)
                arg1
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11011001110 #b0100001101101110010001001100111001101001111011100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110011000 #b0010100110100110010101001001011001010011000000001001)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111101 #b1100111000111010101001110110000001011001110011110010)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0001011010101101100010100100000100001101000100000111)
                expect
                (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b01011101010 #b1100111010000101000100011001000110101011100010100110)))

(assert (= expect result))

(check-sat)
(exit)
