(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111000000 #b0100000100010000101100111001100110011110111000100000)
                arg1
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11001110100 #b0101000001010111101111110000101000011001101001000101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b10000000011 #b0010010000001011010111000110111000000001101010100100)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b10001111111 #b0000100111000001100100000011110011111100001010000100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101101101 #b1000101101011010110010001011000011011100100110100001)
                expect
                (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)))
(assert (fp.leq (fp #b1 #b10000101110 #b1001011011001011000100011100111101001001100010011111)
                expect
                (fp #b0 #b01110110101 #b0011100101010011110011111101001111001110000100001000)))

(assert (= expect result))

(check-sat)
(exit)
