; Format: FLOAT64
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011001101 #b0101011010100001011111000100001000001011010111100101)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b00001000000 #b0111110110111110101010011000110101100010001010010111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10101111001 #b0011000000010111111111100010111100001010100011101100)
                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b0 #b10001100010 #b0000011010010001010001100001001101101101010101000110)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01111001000 #b1000101000010101010011100111110111001000111001110101)
                expect
                (fp #b0 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                expect
                (fp #b0 #b10011001001 #b1000011111101001001000001000010000111000100100101101)))

(assert (= expect result))

(check-sat)
(exit)
