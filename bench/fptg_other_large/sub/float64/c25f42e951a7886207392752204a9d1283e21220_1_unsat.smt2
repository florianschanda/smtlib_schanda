                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100011100 #b1110011001001001001100000010010100000111000010000100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111010 #b1011011110101110000100100111001000010110101110000000)
                expect
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)))
