; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01001111011 #b1001101100011010001001000110111011111110110011101100)
                arg1
                (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)))
(assert (fp.leq (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)
                arg1
                (fp #b0 #b10010100100 #b1110101011101001001110011110000111110110001101001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01000101011 #b0110111111110011001010111011100011001010001000000000)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11011010111 #b0000101010000101010111100110010010100110001101000100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111110111 #b1110000001101010000111000100001010100000101010011110)
                expect
                (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b1 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                expect
                (fp #b0 #b00000000101 #b1000100001010010001111000111100010101110110111000011)))

(assert (= expect result))

(check-sat)
(exit)
