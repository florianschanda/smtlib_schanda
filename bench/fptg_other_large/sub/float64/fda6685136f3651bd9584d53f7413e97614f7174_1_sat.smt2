(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: SUB
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101000101 #b1011010010001000010101011011000101110010001011011100)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100001110 #b1000110001111011001111001111011110111000111001010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100111101 #b1000010011010000001110110001010101111101001001011100)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b10110001001 #b1111000010110110100101100111111011010101010100000100)))

(declare-const result Float64)
(assert (= result (fp.sub rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001001110 #b0001111011100001111101111000001110110010100000101101)
                expect
                (fp #b1 #b00111111111 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00111111111 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11000010110 #b1100111101001001100111111111011000110101110010010011)))

(assert (= expect result))

(check-sat)
(exit)
