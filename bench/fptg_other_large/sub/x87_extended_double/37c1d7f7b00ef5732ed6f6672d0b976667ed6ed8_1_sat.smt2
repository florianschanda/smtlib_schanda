(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110110000001110 #b000001101100011100000101010110100101010001110000101110100111101)
                arg1
                (fp #b1 #b101111111111110 #b111111111111111111111111111111111111111111111111111111111111111)))
