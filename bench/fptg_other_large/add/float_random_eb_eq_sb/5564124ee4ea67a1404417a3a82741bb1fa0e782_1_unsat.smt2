(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001100 #b011011111)
                arg1
                (fp #b0 #b0000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b111100110)
                arg1
                (fp #b0 #b0111111011 #b010100000)))

(declare-const arg2 (_ FloatingPoint 10 10))
