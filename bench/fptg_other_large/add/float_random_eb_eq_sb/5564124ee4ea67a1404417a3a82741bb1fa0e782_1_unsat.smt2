                arg2
                (fp #b1 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111111)
                arg2
                (fp #b0 #b1110101100 #b101010010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100000010 #b000100001)
                expect
                (fp #b1 #b1011111110 #b111111110)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111110)
                expect
                (fp #b0 #b0111010111 #b100101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
