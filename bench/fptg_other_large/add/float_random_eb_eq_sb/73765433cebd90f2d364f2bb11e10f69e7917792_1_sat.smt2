(assert (fp.leq (fp #b0 #b00101100101110 #b1000111100011)
                arg2
                (fp #b0 #b11011010010000 #b1101011001011)))
(assert (fp.leq (fp #b0 #b11011010010000 #b1101011001011)
                arg2
                (fp #b0 #b11111110011010 #b0001100011001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00010000101101 #b1000110111000)
                expect
                (fp #b0 #b11011010010000 #b1101011001010)))
(assert (fp.leq (fp #b0 #b11011010010000 #b1101011001010)
                expect
                (fp #b0 #b11110111010000 #b1101110111101)))

(assert (= expect result))

(check-sat)
(exit)
