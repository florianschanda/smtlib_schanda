(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001011110 #b00101110)
                arg1
                (fp #b0 #b010000000 #b00000000)))
(assert (fp.leq (fp #b0 #b010000000 #b00000000)
                arg1
                (fp #b0 #b011100001 #b10110001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101110 #b00100100)
                arg2
                (fp #b1 #b100000111 #b11010011)))
(assert (fp.leq (fp #b1 #b100000111 #b11010011)
                arg2
                (fp #b0 #b101110000 #b01110000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010100 #b10000011)
                expect
                (fp #b1 #b100000111 #b11010010)))
(assert (fp.leq (fp #b1 #b100000111 #b11010010)
                expect
                (fp #b1 #b011110000 #b11110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
