; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00101011110 #b1110000010)
                arg1
                (fp #b0 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000001010 #b0000000000)
                arg1
                (fp #b0 #b10100001011 #b0100000110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101000101 #b0111100110)
                arg2
                (fp #b1 #b11011001000 #b1000000010)))
(assert (fp.leq (fp #b1 #b11011001000 #b1000000010)
                arg2
                (fp #b0 #b01001101010 #b0010010100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100100110 #b0100001111)
                expect
                (fp #b1 #b11011001000 #b1000000001)))
(assert (fp.leq (fp #b1 #b11011001000 #b1000000001)
                expect
                (fp #b1 #b00010001110 #b0101111000)))

(assert (= expect result))

(check-sat)
(exit)
