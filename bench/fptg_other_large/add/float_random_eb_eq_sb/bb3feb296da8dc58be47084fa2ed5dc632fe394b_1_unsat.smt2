; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101110 #b01001100)
                arg1
                (fp #b0 #b000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b000000000 #b10100110)
                arg1
                (fp #b0 #b111010011 #b01110100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100111 #b11000001)
                arg2
                (fp #b1 #b010000111 #b11101000)))
(assert (fp.leq (fp #b1 #b010000111 #b11101000)
                arg2
                (fp #b0 #b010011100 #b01000011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010010101 #b01001101)
                expect
                (fp #b1 #b010000111 #b11100111)))
(assert (fp.leq (fp #b1 #b010000111 #b11100111)
                expect
                (fp #b0 #b001010100 #b10101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
