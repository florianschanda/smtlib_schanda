; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010001000 #b1101000111)
                arg1
                (fp #b1 #b10000000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000100000)
                arg1
                (fp #b0 #b11010011101 #b1001000111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110101101 #b0000010101)
                arg2
                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b1 #b11101010100 #b1111001110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111101110 #b0111011001)
                expect
                (fp #b1 #b11110001011 #b0011101011)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101011)
                expect
                (fp #b0 #b01110111000 #b1001110000)))

(assert (= expect result))

(check-sat)
(exit)
