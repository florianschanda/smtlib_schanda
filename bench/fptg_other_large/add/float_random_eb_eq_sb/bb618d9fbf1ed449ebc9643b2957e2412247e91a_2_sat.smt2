; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100010111 #b1011000010)
                arg1
                (fp #b0 #b00101101011 #b1101010101)))
(assert (fp.leq (fp #b0 #b00101101011 #b1101010101)
                arg1
                (fp #b0 #b11011011000 #b1011000001)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00101101101 #b1010001111)
                arg2
                (fp #b0 #b00111111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111111011 #b0000000000)
                arg2
                (fp #b0 #b01111110010 #b0111010010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00100000011 #b1111011000)
                expect
                (fp #b0 #b00111111011 #b0000000001)))
(assert (fp.leq (fp #b0 #b00111111011 #b0000000001)
                expect
                (fp #b0 #b01011110110 #b0001100111)))

(assert (= expect result))

(check-sat)
(exit)
