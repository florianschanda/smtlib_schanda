                (fp #b1 #b00000000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000)
                arg2
                (fp #b0 #b01110010000 #b1001101001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01011000101 #b1110010100)
                expect
                (fp #b1 #b01010111000 #b1100000000)))
(assert (fp.leq (fp #b1 #b01010111000 #b1100000000)
                expect
                (fp #b0 #b01100001001 #b1001110111)))

(assert (not (= expect result)))

(check-sat)
