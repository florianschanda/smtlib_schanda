(assert (fp.leq (fp #b1 #b101001011 #b00101100)
                arg2
                (fp #b1 #b100101100 #b10000011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100000 #b00011111)
                expect
                (fp #b1 #b101001011 #b00101011)))
(assert (fp.leq (fp #b1 #b101001011 #b00101011)
                expect
                (fp #b1 #b100100101 #b11001010)))

(assert (not (= expect result)))

(check-sat)
