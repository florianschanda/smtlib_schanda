                arg2
                (fp #b1 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b00000000000)
                arg2
                (fp #b0 #b100101110010 #b10010010101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110101001 #b00101100111)
                expect
                (fp #b0 #b111001001001 #b10011000001)))
(assert (fp.leq (fp #b0 #b111001001001 #b10011000001)
                expect
                (fp #b0 #b111101010010 #b00010010100)))

(assert (not (= expect result)))

(check-sat)
