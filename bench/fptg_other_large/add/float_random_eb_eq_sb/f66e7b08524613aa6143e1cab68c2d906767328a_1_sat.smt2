; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101001001110 #b10101000111)
                arg1
                (fp #b0 #b000000000000 #b00100000110)))
(assert (fp.leq (fp #b0 #b000000000000 #b00100000110)
                arg1
                (fp #b0 #b010111110010 #b01101101111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101111000101 #b10010011001)
                arg2
                (fp #b1 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000000000)
                arg2
                (fp #b0 #b100101101001 #b11000110001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100000100100 #b10100110110)
                expect
                (fp #b1 #b011111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b011111111110 #b11111111111)
                expect
                (fp #b0 #b010111100010 #b00111110100)))

(assert (= expect result))

(check-sat)
(exit)
