(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010101 #b11110101)
                arg1
                (fp #b1 #b011111111 #b01010101)))
(assert (fp.leq (fp #b1 #b011111111 #b01010101)
                arg1
                (fp #b0 #b110100000 #b01000011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010111 #b11100001)
                expect
                (fp #b1 #b100000000 #b01010101)))
(assert (fp.leq (fp #b1 #b100000000 #b01010101)
                expect
                (fp #b0 #b101001010 #b11011010)))

(assert (= expect result))

(check-sat)
(exit)
