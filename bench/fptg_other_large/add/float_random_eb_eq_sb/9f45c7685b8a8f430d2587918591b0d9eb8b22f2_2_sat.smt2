;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100110011 #b01011111001)
                arg1
                (fp #b1 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000001011 #b00000000000)
                arg1
                (fp #b1 #b100000000100 #b10100111001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101101011 #b10010011110)
                arg2
                (fp #b0 #b010000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b010000000000 #b00000000000)
                arg2
                (fp #b0 #b100000110001 #b01100000111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011100011 #b11000010100)
                expect
                (fp #b1 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000001011 #b00000000000)
                expect
                (fp #b0 #b000100111111 #b10001110010)))

(assert (= expect result))

(check-sat)
(exit)
