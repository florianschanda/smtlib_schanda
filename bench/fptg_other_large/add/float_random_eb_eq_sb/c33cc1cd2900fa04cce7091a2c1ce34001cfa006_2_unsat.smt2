; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100011111 #b01110110)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b0 #b000000001 #b11101100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010110101 #b10101111)
                arg2
                (fp #b1 #b001111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111100 #b00000000)
                arg2
                (fp #b0 #b001000110 #b11001111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101101 #b11100110)
                expect
                (fp #b1 #b010101010 #b00110000)))
(assert (fp.leq (fp #b1 #b010101010 #b00110000)
                expect
                (fp #b0 #b000011100 #b00111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
