                arg2
                (fp #b0 #b100011010011011 #b01011000101111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001010101101000 #b01011011011001)
                expect
                (fp #b0 #b100000000001011 #b01111101111100)))
(assert (fp.leq (fp #b0 #b100000000001011 #b01111101111100)
                expect
                (fp #b0 #b111010111111100 #b01011010101101)))

(assert (= expect result))

