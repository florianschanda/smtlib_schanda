(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000000 #b10001100)
                arg1
                (fp #b1 #b011111111 #b01010101)))
(assert (fp.leq (fp #b1 #b011111111 #b01010101)
                arg1
                (fp #b0 #b111100110 #b10011010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010101 #b11101101)
                arg2
                (fp #b1 #b010000111 #b11101000)))
(assert (fp.leq (fp #b1 #b010000111 #b11101000)
                arg2
                (fp #b0 #b110011010 #b00110100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010100 #b11110010)
                expect
                (fp #b1 #b011111111 #b01010110)))
(assert (fp.leq (fp #b1 #b011111111 #b01010110)
                expect
                (fp #b0 #b101101111 #b11010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
