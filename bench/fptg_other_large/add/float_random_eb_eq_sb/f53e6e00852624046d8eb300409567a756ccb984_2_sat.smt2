(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011101001 #b10000111)
                arg1
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg1
                (fp #b0 #b001001000 #b10111010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011000001 #b11100111)
                arg2
                (fp #b0 #b110100001 #b11100010)))
(assert (fp.leq (fp #b0 #b110100001 #b11100010)
                arg2
                (fp #b0 #b111010110 #b01011010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011100111 #b00001110)
                expect
                (fp #b0 #b110100001 #b11100011)))
(assert (fp.leq (fp #b0 #b110100001 #b11100011)
                expect
                (fp #b0 #b111110010 #b01011110)))

(assert (= expect result))

(check-sat)
(exit)
