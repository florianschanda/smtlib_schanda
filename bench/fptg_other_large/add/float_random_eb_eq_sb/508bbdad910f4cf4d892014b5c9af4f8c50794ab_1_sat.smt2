(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011011000 #b01100011)
                arg1
                (fp #b0 #b100011101 #b01011000)))
(assert (fp.leq (fp #b0 #b100011101 #b01011000)
                arg1
                (fp #b0 #b111110100 #b01111011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111010110 #b00001011)
                arg2
                (fp #b1 #b011111111 #b10011100)))
(assert (fp.leq (fp #b1 #b011111111 #b10011100)
                arg2
                (fp #b1 #b000110001 #b00001100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001100100 #b10010100)
                expect
                (fp #b0 #b100011101 #b01010111)))
(assert (fp.leq (fp #b0 #b100011101 #b01010111)
                expect
                (fp #b0 #b111000000 #b00011111)))

(assert (= expect result))

(check-sat)
(exit)
