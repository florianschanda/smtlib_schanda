; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101010 #b01001100)
                arg1
                (fp #b1 #b101000011 #b10111100)))
(assert (fp.leq (fp #b1 #b101000011 #b10111100)
                arg1
                (fp #b0 #b100011000 #b01011000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010010000 #b10011111)
                arg2
                (fp #b0 #b000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000 #b00000001)
                arg2
                (fp #b0 #b011011001 #b11010100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100100 #b11000101)
                expect
                (fp #b1 #b101000011 #b10111011)))
(assert (fp.leq (fp #b1 #b101000011 #b10111011)
                expect
                (fp #b0 #b000110111 #b01001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
