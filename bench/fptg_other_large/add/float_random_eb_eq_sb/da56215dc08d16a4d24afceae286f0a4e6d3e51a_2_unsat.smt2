                arg2
                (fp #b0 #b011100001111 #b00011111111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001101010001 #b00101101101)
                expect
                (fp #b0 #b011111111111 #b01110010111)))
(assert (fp.leq (fp #b0 #b011111111111 #b01110010111)
                expect
                (fp #b0 #b110011000000 #b00111001001)))

(assert (not (= expect result)))

(check-sat)
