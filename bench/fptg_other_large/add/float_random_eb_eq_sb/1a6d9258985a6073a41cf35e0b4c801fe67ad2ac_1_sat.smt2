                (fp #b1 #b10010100010 #b0000000111)))
(assert (fp.leq (fp #b1 #b10010100010 #b0000000111)
                arg2
                (fp #b1 #b01101111110 #b1100000111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01111100101 #b1000111011)
                expect
                (fp #b0 #b10111111110 #b1111111110)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111110)
                expect
                (fp #b0 #b11101000000 #b1000011001)))

(assert (= expect result))

(check-sat)
(exit)
