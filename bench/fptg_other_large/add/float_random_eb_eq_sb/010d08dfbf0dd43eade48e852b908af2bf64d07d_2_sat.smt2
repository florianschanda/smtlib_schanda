(assert (fp.leq (fp #b0 #b0000000000000000 #b100100100100110)
                arg2
                (fp #b0 #b0101110001010010 #b001010101111110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010010111010011 #b001011010100001)
                expect
                (fp #b0 #b0100000000000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000000000000001)
                expect
                (fp #b0 #b0101010010110110 #b100000001100110)))

(assert (= expect result))

(check-sat)
