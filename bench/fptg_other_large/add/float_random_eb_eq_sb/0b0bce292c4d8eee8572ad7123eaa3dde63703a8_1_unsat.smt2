; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10101001001 #b1101011101)
                arg1
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b01011011111 #b1110101111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001000110 #b0011101111)
                arg2
                (fp #b1 #b10010100010 #b0000000111)))
(assert (fp.leq (fp #b1 #b10010100010 #b0000000111)
                arg2
                (fp #b0 #b10001001011 #b0101010011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111010010 #b1011010011)
                expect
                (fp #b1 #b10010100010 #b0000000111)))
(assert (fp.leq (fp #b1 #b10010100010 #b0000000111)
                expect
                (fp #b0 #b00100010010 #b1111101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
