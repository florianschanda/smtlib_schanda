(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b100010011110101 #b11100001011011)
                expect
                (fp #b0 #b111111111111110 #b11111111111110)))
(assert (fp.leq (fp #b0 #b111111111111110 #b11111111111110)
                expect
                (fp #b0 #b111111111111111 #b00000000000000)))

(assert (= expect result))

(check-sat)
