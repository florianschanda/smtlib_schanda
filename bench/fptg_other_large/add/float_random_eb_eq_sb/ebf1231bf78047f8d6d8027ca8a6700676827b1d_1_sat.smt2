; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111001101110010 #b110101110100001)
                arg1
                (fp #b1 #b1111001000110110 #b011010010000011)))
(assert (fp.leq (fp #b1 #b1111001000110110 #b011010010000011)
                arg1
                (fp #b0 #b0011110111000000 #b100001110010111)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101011010000101 #b001011110000111)
                arg2
                (fp #b0 #b1011111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b111111111111111)
                arg2
                (fp #b0 #b1111110011010010 #b100111010101100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111101010100001 #b001011100110100)
                expect
                (fp #b1 #b1111001000110110 #b011010010000010)))
(assert (fp.leq (fp #b1 #b1111001000110110 #b011010010000010)
                expect
                (fp #b1 #b0001100011101001 #b111111001110010)))

(assert (= expect result))

(check-sat)
(exit)
