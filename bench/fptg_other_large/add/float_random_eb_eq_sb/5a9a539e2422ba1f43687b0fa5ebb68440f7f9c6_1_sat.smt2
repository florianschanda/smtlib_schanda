(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101000111 #b111101110)
                arg1
                (fp #b0 #b1000001000 #b110100101)))
(assert (fp.leq (fp #b0 #b1000001000 #b110100101)
                arg1
                (fp #b0 #b1001101100 #b001110001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100000100 #b111111010)
                arg2
                (fp #b1 #b1010000101 #b111101000)))
(assert (fp.leq (fp #b1 #b1010000101 #b111101000)
                arg2
                (fp #b1 #b1000101010 #b100101011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100111111 #b010010111)
                expect
                (fp #b1 #b1010000101 #b111100111)))
(assert (fp.leq (fp #b1 #b1010000101 #b111100111)
                expect
                (fp #b0 #b1111010011 #b001101101)))

(assert (= expect result))

(check-sat)
(exit)
