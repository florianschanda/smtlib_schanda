(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011100111 #b110011000)
                expect
                (fp #b0 #b0111111111 #b111111000)))
(assert (fp.leq (fp #b0 #b0111111111 #b111111000)
                expect
