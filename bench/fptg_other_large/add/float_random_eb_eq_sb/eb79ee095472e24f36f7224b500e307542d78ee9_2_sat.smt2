                arg2
                (fp #b1 #b011111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111 #b00000000)
                arg2
                (fp #b1 #b000000101 #b11110000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111100 #b11010110)
                expect
                (fp #b1 #b011111111 #b00000001)))
(assert (fp.leq (fp #b1 #b011111111 #b00000001)
                expect
                (fp #b0 #b000010011 #b01111100)))

(assert (= expect result))

(check-sat)
(exit)
