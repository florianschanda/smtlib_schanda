;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111000100011 #b0000100000111)
                arg1
                (fp #b1 #b01111111111111 #b1100001000110)))
(assert (fp.leq (fp #b1 #b01111111111111 #b1100001000110)
                arg1
                (fp #b0 #b01001111111001 #b1011101001011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110000111011 #b0101011110100)
                arg2
                (fp #b1 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b10000000001101 #b0000000000000)
                arg2
                (fp #b1 #b00100010010111 #b1001101110011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000011110110 #b1000100111111)
                expect
                (fp #b1 #b10000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b10000000001101 #b0000000000000)
                expect
                (fp #b0 #b11011110100000 #b1011111101111)))

(assert (= expect result))

(check-sat)
(exit)
