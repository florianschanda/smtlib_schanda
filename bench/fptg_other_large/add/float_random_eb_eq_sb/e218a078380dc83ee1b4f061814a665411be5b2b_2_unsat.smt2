                arg2
                (fp #b0 #b0000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b0000000000 #b100101010)
                arg2
                (fp #b0 #b0100011111 #b000110000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100011011 #b101001110)
                expect
                (fp #b0 #b0110000111 #b111010110)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010110)
                expect
                (fp #b0 #b0111101000 #b110111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
