(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b11110010101)
                expect
                (fp #b1 #b111111111100 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111100 #b11111111111)
                expect
                (fp #b1 #b100001011101 #b01110100100)))

(assert (not (= expect result)))

