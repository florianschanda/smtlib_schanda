; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011001000 #b111000101)
                arg1
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b0100011011 #b101001001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111010010 #b011001010)
                arg2
                (fp #b0 #b0111111111 #b111110111)))
(assert (fp.leq (fp #b0 #b0111111111 #b111110111)
                arg2
                (fp #b0 #b1111001010 #b101110010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011111011 #b010011010)
                expect
                (fp #b0 #b0111111111 #b111110110)))
(assert (fp.leq (fp #b0 #b0111111111 #b111110110)
                expect
                (fp #b0 #b1001011111 #b110110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
