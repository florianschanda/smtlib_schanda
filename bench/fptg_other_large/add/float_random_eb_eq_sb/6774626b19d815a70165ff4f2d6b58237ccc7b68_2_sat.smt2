(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001011101000 #b11101100010)
                arg1
                (fp #b0 #b011111111111 #b10010001101)))
(assert (fp.leq (fp #b0 #b011111111111 #b10010001101)
                arg1
                (fp #b0 #b101101111000 #b11101111001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000100011001 #b10011101101)
                arg2
                (fp #b0 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000000)
                arg2
                (fp #b0 #b111111111110 #b10110011100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010000110111 #b10011101000)
                expect
                (fp #b0 #b111111111101 #b00000000001)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000001)
                expect
                (fp #b0 #b111111111101 #b11111001110)))

(assert (= expect result))

(check-sat)
(exit)
