; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100011110 #b0000110011)
                arg1
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b01001100111 #b1101001011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001101011 #b1110110011)
                arg2
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                arg2
                (fp #b0 #b00001101101 #b1111101110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110110000 #b0000010000)
                expect
                (fp #b1 #b10000001001 #b1111111111)))
(assert (fp.leq (fp #b1 #b10000001001 #b1111111111)
                expect
                (fp #b1 #b01101000110 #b0010100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
