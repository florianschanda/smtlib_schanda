(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011100011 #b001100000)
                arg1
                (fp #b1 #b0000001001 #b000100110)))
(assert (fp.leq (fp #b1 #b0000001001 #b000100110)
                arg1
                (fp #b0 #b1101100011 #b100101111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101100100 #b001110101)
                arg2
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg2
                (fp #b0 #b0010001011 #b010000011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101000000 #b010011010)
                expect
                (fp #b1 #b0000001001 #b000100110)))
(assert (fp.leq (fp #b1 #b0000001001 #b000100110)
                expect
                (fp #b0 #b1000110101 #b111001100)))

(assert (= expect result))

(check-sat)
(exit)
