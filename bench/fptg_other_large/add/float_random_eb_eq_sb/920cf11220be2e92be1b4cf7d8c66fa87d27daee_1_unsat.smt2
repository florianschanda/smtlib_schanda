                (fp #b1 #b011111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111 #b00000000)
                arg2
                (fp #b0 #b111010011 #b00111110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b101110011 #b00101000)
                expect
                (fp #b0 #b101111110 #b11111110)))
(assert (fp.leq (fp #b0 #b101111110 #b11111110)
                expect
                (fp #b0 #b110011100 #b11001000)))

(assert (not (= expect result)))

(check-sat)
