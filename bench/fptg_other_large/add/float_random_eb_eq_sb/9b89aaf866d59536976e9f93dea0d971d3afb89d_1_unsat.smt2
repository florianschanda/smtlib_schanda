; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110111100111000 #b110111010010100)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                arg1
                (fp #b0 #b1011110010001110 #b001111010010000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101010100100110 #b001000100100100)
                arg2
                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b0 #b1111100101101101 #b110011011111001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0000010100011000 #b111000101001111)
                expect
                (fp #b0 #b0011111111111000 #b011010100000100)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000100)
                expect
                (fp #b0 #b1010100001100001 #b001000100000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
