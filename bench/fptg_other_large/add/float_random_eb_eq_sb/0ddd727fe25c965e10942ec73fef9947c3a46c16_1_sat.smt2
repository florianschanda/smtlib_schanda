(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101110111 #b001000101)
                arg1
                (fp #b1 #b1001110111 #b101110111)))
(assert (fp.leq (fp #b1 #b1001110111 #b101110111)
                arg1
                (fp #b0 #b1000111111 #b110100100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011111011 #b001001000)
                arg2
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                arg2
                (fp #b0 #b1011011001 #b010101101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000101 #b110101011)
                expect
                (fp #b1 #b1001110111 #b101110110)))
(assert (fp.leq (fp #b1 #b1001110111 #b101110110)
                expect
                (fp #b0 #b0110101010 #b101101100)))

(assert (= expect result))

(check-sat)
(exit)
