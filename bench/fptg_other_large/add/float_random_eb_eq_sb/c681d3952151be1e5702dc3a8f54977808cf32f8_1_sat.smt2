;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00100110001 #b1111100111)
                arg1
                (fp #b0 #b11111011001 #b1110100110)))
(assert (fp.leq (fp #b0 #b11111011001 #b1110100110)
                arg1
                (fp #b0 #b11111111011 #b0110001101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010111110 #b1110101100)
                arg2
                (fp #b1 #b10000000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000000111 #b0011100100)
                arg2
                (fp #b0 #b11101010010 #b1100000010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110111100 #b0101001111)
                expect
                (fp #b0 #b11111011001 #b1110100101)))
(assert (fp.leq (fp #b0 #b11111011001 #b1110100101)
                expect
                (fp #b0 #b11111111000 #b1101000010)))

(assert (= expect result))

(check-sat)
(exit)
