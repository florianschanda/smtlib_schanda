;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001101110101 #b00010100001)
                arg1
                (fp #b1 #b000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b000000000000 #b11011000100)
                arg1
