(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b111001110000 #b11001111101)
                arg2
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                arg2
                (fp #b0 #b110100100001 #b01110101111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100100101 #b01100101110)
                expect
                (fp #b1 #b000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b000000000000 #b11011000100)
                expect
                (fp #b0 #b010010101001 #b10001000011)))

(assert (= expect result))

(check-sat)
(exit)
