(assert (fp.leq (fp #b0 #b01111111111 #b0010110101)
                arg2
                (fp #b0 #b11000110111 #b1001100011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01111011100 #b0111100111)
                expect
                (fp #b0 #b01111111111 #b0010110100)))
(assert (fp.leq (fp #b0 #b01111111111 #b0010110100)
                expect
                (fp #b0 #b10001001010 #b0111111110)))

(assert (= expect result))

(check-sat)
