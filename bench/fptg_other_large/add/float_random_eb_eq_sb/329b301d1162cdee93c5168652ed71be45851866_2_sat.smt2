; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110000 #b10101010)
                arg1
                (fp #b0 #b100110001 #b00100001)))
(assert (fp.leq (fp #b0 #b100110001 #b00100001)
                arg1
                (fp #b0 #b110011001 #b10100101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001111100 #b01000011)
                arg2
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg2
                (fp #b0 #b110101001 #b01100011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010110011 #b11011111)
                expect
                (fp #b0 #b100110001 #b00100010)))
(assert (fp.leq (fp #b0 #b100110001 #b00100010)
                expect
                (fp #b0 #b111010100 #b11011000)))

(assert (= expect result))

(check-sat)
(exit)
