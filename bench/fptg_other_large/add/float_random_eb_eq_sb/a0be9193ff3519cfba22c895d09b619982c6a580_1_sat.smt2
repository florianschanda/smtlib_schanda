; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010101101 #b01011110)
                arg1
                (fp #b0 #b010010111 #b01000011)))
(assert (fp.leq (fp #b0 #b010010111 #b01000011)
                arg1
                (fp #b0 #b111011111 #b10100000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010001 #b10110011)
                arg2
                (fp #b1 #b000000000 #b00100111)))
(assert (fp.leq (fp #b1 #b000000000 #b00100111)
                arg2
                (fp #b0 #b111010010 #b00010010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100101111 #b11110010)
                expect
                (fp #b0 #b010010111 #b01000010)))
(assert (fp.leq (fp #b0 #b010010111 #b01000010)
                expect
                (fp #b0 #b101110110 #b00000010)))

(assert (= expect result))

(check-sat)
(exit)
