; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110100110 #b100100011)
                arg1
                (fp #b0 #b1000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b1000000111 #b000111000)
                arg1
                (fp #b0 #b1000010000 #b101100101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                arg2
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                arg2
                (fp #b1 #b0011011010 #b000111101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                expect
                (fp #b1 #b1111111110 #b111111110)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111110)
                expect
                (fp #b0 #b1100110101 #b100101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
