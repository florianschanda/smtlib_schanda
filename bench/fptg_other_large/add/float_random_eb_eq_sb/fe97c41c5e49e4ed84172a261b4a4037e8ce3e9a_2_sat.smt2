(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010010110 #b0000100001)
                arg1
                (fp #b1 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111)
                arg1
                (fp #b0 #b00100000100 #b1001000000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011001111 #b1011011000)
                arg2
                (fp #b1 #b10000000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b10000000111 #b0011100100)
                arg2
                (fp #b0 #b11111011001 #b0100011000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001100010 #b0100001011)
                expect
                (fp #b1 #b10111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b10111111111 #b0000000000)
                expect
                (fp #b0 #b00100100011 #b1001000100)))

(assert (= expect result))

(check-sat)
(exit)
