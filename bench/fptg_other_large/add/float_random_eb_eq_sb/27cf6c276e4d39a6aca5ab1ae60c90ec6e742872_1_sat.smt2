; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00101001101001 #b1001101010001)
                arg1
                (fp #b0 #b00000000000001 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b0000000000000)
                arg1
                (fp #b0 #b10011011000001 #b1010011110110)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010000010110 #b1010101101110)
                arg2
                (fp #b1 #b11000001100001 #b0001111011101)))
(assert (fp.leq (fp #b1 #b11000001100001 #b0001111011101)
                arg2
                (fp #b0 #b11110111111100 #b1100001001100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010110010010 #b1111101111110)
                expect
                (fp #b1 #b11000001100001 #b0001111011100)))
(assert (fp.leq (fp #b1 #b11000001100001 #b0001111011100)
                expect
                (fp #b0 #b10000011101011 #b1001000101111)))

(assert (= expect result))

(check-sat)
(exit)
