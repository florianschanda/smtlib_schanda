;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011001110 #b01010101011)
                arg1
                (fp #b0 #b110100101001 #b10011011000)))
(assert (fp.leq (fp #b0 #b110100101001 #b10011011000)
                arg1
                (fp #b0 #b110110110101 #b11000110101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000110101111 #b10101111110)
                arg2
                (fp #b1 #b000000000000 #b01101101001)))
(assert (fp.leq (fp #b1 #b000000000000 #b01101101001)
                arg2
                (fp #b0 #b001100111110 #b00000111110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000010010 #b01111100110)
                expect
                (fp #b0 #b110100101001 #b10011010111)))
(assert (fp.leq (fp #b0 #b110100101001 #b10011010111)
                expect
                (fp #b0 #b110110100001 #b11001001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
