; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00001100101 #b0010111001)
                arg1
                (fp #b0 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111)
                arg1
                (fp #b0 #b11101111000 #b0000100001)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00111011001 #b0111000100)
                arg2
                (fp #b0 #b10000000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000000111 #b1011011100)
                arg2
                (fp #b0 #b10100011001 #b1110100000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000010101 #b1100101010)
                expect
                (fp #b0 #b10111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b10111111111 #b0000000000)
                expect
                (fp #b0 #b11001101011 #b1111011000)))

(assert (= expect result))

(check-sat)
(exit)
