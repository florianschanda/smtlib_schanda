; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011001101 #b00111010)
                arg1
                (fp #b0 #b100000111 #b11000011)))
(assert (fp.leq (fp #b0 #b100000111 #b11000011)
                arg1
                (fp #b0 #b111001011 #b10101001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100011100 #b11010010)
                arg2
                (fp #b1 #b000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111111)
                arg2
                (fp #b0 #b110100110 #b00111111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100100 #b10001000)
                expect
                (fp #b0 #b100000111 #b11000010)))
(assert (fp.leq (fp #b0 #b100000111 #b11000010)
                expect
                (fp #b0 #b111000110 #b01010011)))

(assert (= expect result))

(check-sat)
(exit)
