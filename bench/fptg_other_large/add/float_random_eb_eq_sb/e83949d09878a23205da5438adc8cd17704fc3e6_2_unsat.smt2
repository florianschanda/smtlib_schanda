; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100100 #b00100111)
                arg1
                (fp #b0 #b100110001 #b00100001)))
(assert (fp.leq (fp #b0 #b100110001 #b00100001)
                arg1
                (fp #b0 #b101001110 #b10010000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b000111110 #b11100110)
                arg2
                (fp #b0 #b110100001 #b11100010)))
(assert (fp.leq (fp #b0 #b110100001 #b11100010)
                arg2
                (fp #b0 #b111010000 #b01101100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101111 #b11100110)
                expect
                (fp #b0 #b110100001 #b11100011)))
(assert (fp.leq (fp #b0 #b110100001 #b11100011)
                expect
                (fp #b0 #b111111000 #b11010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
