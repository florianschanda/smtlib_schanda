;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001010 #b10001101)
                arg1
                (fp #b1 #b010101000 #b01111011)))
(assert (fp.leq (fp #b1 #b010101000 #b01111011)
                arg1
                (fp #b0 #b100100111 #b00001111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b10111010)
                arg2
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg2
                (fp #b1 #b000010001 #b01011010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b10010101)
                expect
                (fp #b1 #b111111101 #b00000001)))
(assert (fp.leq (fp #b1 #b111111101 #b00000001)
                expect
                (fp #b0 #b111001010 #b11110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
