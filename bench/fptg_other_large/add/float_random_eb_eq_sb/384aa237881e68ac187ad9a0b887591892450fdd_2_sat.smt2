(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111001010 #b00011111101)
                arg1
                (fp #b1 #b110110011100 #b00111011110)))
(assert (fp.leq (fp #b1 #b110110011100 #b00111011110)
                arg1
                (fp #b0 #b110100110010 #b00001010111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110011001 #b11000100110)
                arg2
                (fp #b0 #b101101010110 #b10000100000)))
(assert (fp.leq (fp #b0 #b101101010110 #b10000100000)
                arg2
                (fp #b0 #b111010011101 #b10111100010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111001000011 #b10011001010)
                expect
                (fp #b1 #b110110011100 #b00111011110)))
(assert (fp.leq (fp #b1 #b110110011100 #b00111011110)
                expect
                (fp #b1 #b000101100110 #b01011101101)))

(assert (= expect result))

(check-sat)
(exit)
