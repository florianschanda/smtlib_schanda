                arg2
                (fp #b0 #b10110010001 #b0110101010)))
(assert (fp.leq (fp #b0 #b10110010001 #b0110101010)
                arg2
                (fp #b0 #b10110110000 #b1010100011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001011011 #b0000000000)
                expect
                (fp #b0 #b10110010001 #b0110101001)))
(assert (fp.leq (fp #b0 #b10110010001 #b0110101001)
                expect
                (fp #b0 #b11011011111 #b1110110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
