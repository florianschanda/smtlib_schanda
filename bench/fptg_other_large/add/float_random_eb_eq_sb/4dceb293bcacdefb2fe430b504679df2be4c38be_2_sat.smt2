; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b110010011 #b01100011)
                arg1
                (fp #b0 #b111000010 #b00111001)))
(assert (fp.leq (fp #b0 #b111000010 #b00111001)
                arg1
                (fp #b0 #b111100100 #b11010010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011001101 #b10100101)
                arg2
                (fp #b0 #b000001010 #b00011001)))
(assert (fp.leq (fp #b0 #b000001010 #b00011001)
                arg2
                (fp #b0 #b001010111 #b00000101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b101111001 #b00110011)
                expect
                (fp #b0 #b111000010 #b00111010)))
(assert (fp.leq (fp #b0 #b111000010 #b00111010)
                expect
                (fp #b0 #b111010111 #b00010011)))

(assert (= expect result))

(check-sat)
(exit)
