; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011001100 #b01000110)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b0 #b110110001 #b11110001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010011 #b01010001)
                arg2
                (fp #b1 #b100000111 #b10010100)))
(assert (fp.leq (fp #b1 #b100000111 #b10010100)
                arg2
                (fp #b0 #b110111000 #b00111110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001010 #b01101001)
                expect
                (fp #b1 #b100000111 #b10010101)))
(assert (fp.leq (fp #b1 #b100000111 #b10010101)
                expect
                (fp #b1 #b001100110 #b11001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
