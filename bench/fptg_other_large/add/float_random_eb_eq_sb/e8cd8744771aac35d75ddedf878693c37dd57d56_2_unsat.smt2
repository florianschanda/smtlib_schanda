(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010001010 #b0010001000)
                arg1
                (fp #b0 #b10000001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10000001001 #b1010000111)
                arg1
                (fp #b0 #b10101010011 #b1101000100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10111101010 #b0101100101)
                expect
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b11101010111 #b1001110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
