                arg2
                (fp #b0 #b00000000000000 #b1111111111111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111111111111)
                arg2
                (fp #b0 #b11110100101011 #b0011001010000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000110011101 #b0010011110010)
                expect
                (fp #b1 #b00111111111111 #b1111111111111)))
(assert (fp.leq (fp #b1 #b00111111111111 #b1111111111111)
                expect
                (fp #b0 #b01010110100010 #b1111111101111)))

(assert (= expect result))

(check-sat)
(exit)
