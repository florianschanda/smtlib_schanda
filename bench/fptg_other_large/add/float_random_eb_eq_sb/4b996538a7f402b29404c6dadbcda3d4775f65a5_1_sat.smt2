;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111101 #b0111100010)
                arg1
                (fp #b1 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000)
                arg1
                (fp #b0 #b10110111101 #b0000100011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00001111001 #b1000111100)
                arg2
                (fp #b0 #b00000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110100111)
                arg2
                (fp #b0 #b11100100101 #b1110100111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111110 #b0001110000)
                expect
                (fp #b1 #b11111111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111)
                expect
                (fp #b0 #b00100001101 #b1011110101)))

(assert (= expect result))

(check-sat)
(exit)
