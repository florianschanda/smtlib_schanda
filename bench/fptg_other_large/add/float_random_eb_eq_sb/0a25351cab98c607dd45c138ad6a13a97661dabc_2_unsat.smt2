(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111110100 #b111100010)
                arg1
                (fp #b1 #b1101101100 #b100010000)))
(assert (fp.leq (fp #b1 #b1101101100 #b100010000)
                arg1
                (fp #b1 #b0000000001 #b110100010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000110111 #b100110111)
                arg2
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg2
                (fp #b0 #b1001000000 #b100110011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110001111 #b010000100)
                expect
                (fp #b1 #b1101101100 #b100010001)))
(assert (fp.leq (fp #b1 #b1101101100 #b100010001)
                expect
                (fp #b0 #b0010110011 #b110000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
