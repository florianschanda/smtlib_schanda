(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011111100011100 #b101000110111100)
                arg1
                (fp #b0 #b0000000000000000 #b101011011111011)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b101011011111011)
                arg1
                (fp #b0 #b1101010100101110 #b100001110110010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101011001010110 #b000001111011101)
                arg2
                (fp #b1 #b1100010001011010 #b111000111000010)))
(assert (fp.leq (fp #b1 #b1100010001011010 #b111000111000010)
                arg2
                (fp #b0 #b0111100110101100 #b110111111101111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110010000110010 #b010010110100101)
                expect
                (fp #b1 #b1100010001011010 #b111000111000001)))
(assert (fp.leq (fp #b1 #b1100010001011010 #b111000111000001)
                expect
                (fp #b0 #b1010000111110001 #b100010101000011)))

(assert (= expect result))

(check-sat)
(exit)
