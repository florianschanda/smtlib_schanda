(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1011010101 #b111100101)
                arg1
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                arg1
                (fp #b0 #b0110010010 #b011110000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111110011 #b111110110)
                arg2
                (fp #b1 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b1 #b0011111011 #b011010100)
                arg2
                (fp #b0 #b1011101110 #b000000110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011100111 #b011111011)
                expect
                (fp #b1 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b1 #b0011111011 #b011010100)
                expect
                (fp #b1 #b0010001001 #b000011101)))

(assert (= expect result))

(check-sat)
(exit)
