; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101001011101000 #b00001001100110)
                arg1
                (fp #b0 #b000000000000000 #b11111111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111111111111)
                arg1
                (fp #b0 #b011101111110110 #b01010110000110)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101010011001010 #b11011111011011)
                arg2
                (fp #b0 #b001000111100010 #b01001111000000)))
(assert (fp.leq (fp #b0 #b001000111100010 #b01001111000000)
                arg2
                (fp #b0 #b101100101100100 #b10000101100100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b000100101010110 #b10001010010011)
                expect
                (fp #b0 #b001000111100010 #b01001111000000)))
(assert (fp.leq (fp #b0 #b001000111100010 #b01001111000000)
                expect
                (fp #b0 #b110111011110010 #b00110100001000)))

(assert (= expect result))

(check-sat)
(exit)
