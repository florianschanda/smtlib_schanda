; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001010011 #b1001001001)
                arg1
                (fp #b1 #b01100100100 #b1111100011)))
(assert (fp.leq (fp #b1 #b01100100100 #b1111100011)
                arg1
                (fp #b1 #b00011101011 #b0100010000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01110001101 #b0111000011)
                arg2
                (fp #b0 #b01111111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111111111 #b0010110101)
                arg2
                (fp #b0 #b10101001011 #b1001111100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110101111 #b1100111101)
                expect
                (fp #b0 #b01111111111 #b0010110100)))
(assert (fp.leq (fp #b0 #b01111111111 #b0010110100)
                expect
                (fp #b0 #b11100000100 #b1010101111)))

(assert (= expect result))

(check-sat)
(exit)
