; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011000 #b11000101)
                arg1
                (fp #b1 #b101000011 #b10111100)))
(assert (fp.leq (fp #b1 #b101000011 #b10111100)
                arg1
                (fp #b0 #b010001000 #b10110010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010100111 #b10001011)
                arg2
                (fp #b1 #b000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b000000000 #b00000001)
                arg2
                (fp #b0 #b100001000 #b11010110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000100 #b10100111)
                expect
                (fp #b1 #b101000011 #b10111101)))
(assert (fp.leq (fp #b1 #b101000011 #b10111101)
                expect
                (fp #b0 #b111110011 #b01111110)))

(assert (= expect result))

(check-sat)
(exit)
