(assert (fp.leq (fp #b1 #b101111010001 #b00011001110)
                arg2
                (fp #b1 #b101001111100 #b10100010001)))
(assert (fp.leq (fp #b1 #b101001111100 #b10100010001)
                arg2
                (fp #b1 #b001011101101 #b00011000100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101010011101 #b00001001110)
                expect
                (fp #b1 #b101001111100 #b10100010000)))
(assert (fp.leq (fp #b1 #b101001111100 #b10100010000)
                expect
                (fp #b0 #b100000011110 #b11110101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
