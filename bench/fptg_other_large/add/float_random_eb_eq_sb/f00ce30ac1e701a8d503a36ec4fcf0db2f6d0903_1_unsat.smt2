(assert (fp.leq (fp #b0 #b10000110110110 #b0101110110001)
                arg2
                (fp #b0 #b10010100111010 #b0110100101111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000001100101 #b0011100111101)
                expect
                (fp #b0 #b10000110110110 #b0101110110000)))
(assert (fp.leq (fp #b0 #b10000110110110 #b0101110110000)
                expect
                (fp #b0 #b11001111011100 #b0001010111000)))

(assert (not (= expect result)))

(check-sat)
