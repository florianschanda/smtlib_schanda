;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000001111 #b10000001)
                arg1
                (fp #b0 #b000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b000000000 #b01010111)
                arg1
                (fp #b0 #b111011101 #b00101001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010111111 #b11100000)
                arg2
                (fp #b0 #b011111111 #b11100111)))
(assert (fp.leq (fp #b0 #b011111111 #b11100111)
                arg2
                (fp #b0 #b110011010 #b01101100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011010 #b00011110)
                expect
                (fp #b0 #b011111111 #b11101000)))
(assert (fp.leq (fp #b0 #b011111111 #b11101000)
                expect
                (fp #b0 #b100000101 #b01110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
