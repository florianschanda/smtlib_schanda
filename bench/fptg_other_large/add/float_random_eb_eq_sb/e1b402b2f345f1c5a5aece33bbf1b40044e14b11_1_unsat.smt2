; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101100000 #b101001110)
                arg1
                (fp #b1 #b0000000001 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b000000000)
                arg1
                (fp #b0 #b0110011111 #b111101010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001001011 #b110110001)
                arg2
                (fp #b0 #b1100101101 #b000000001)))
(assert (fp.leq (fp #b0 #b1100101101 #b000000001)
                arg2
                (fp #b0 #b1101000010 #b100010100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1011010101 #b000101100)
                expect
                (fp #b0 #b1100101101 #b000000000)))
(assert (fp.leq (fp #b0 #b1100101101 #b000000000)
                expect
                (fp #b0 #b1111111011 #b111001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
