; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011110100 #b11101010011)
                arg1
                (fp #b1 #b100000001010 #b01101011101)))
(assert (fp.leq (fp #b1 #b100000001010 #b01101011101)
                arg1
                (fp #b0 #b110011110001 #b00000011100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100010111000 #b11100101011)
                arg2
                (fp #b1 #b011111111111 #b00110001010)))
(assert (fp.leq (fp #b1 #b011111111111 #b00110001010)
                arg2
                (fp #b0 #b001001011010 #b11011001011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101010111 #b00101011001)
                expect
                (fp #b1 #b100000001010 #b01101011110)))
(assert (fp.leq (fp #b1 #b100000001010 #b01101011110)
                expect
                (fp #b1 #b011010001101 #b01000110010)))

(assert (= expect result))

(check-sat)
(exit)
