; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010110 #b00001011)
                arg1
                (fp #b0 #b100011101 #b01011000)))
(assert (fp.leq (fp #b0 #b100011101 #b01011000)
                arg1
                (fp #b0 #b101011010 #b00111000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100101 #b10100110)
                arg2
                (fp #b0 #b110100001 #b11100010)))
(assert (fp.leq (fp #b0 #b110100001 #b11100010)
                arg2
                (fp #b0 #b110110100 #b10101001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010110111 #b10001011)
                expect
                (fp #b0 #b110100001 #b11100011)))
(assert (fp.leq (fp #b0 #b110100001 #b11100011)
                expect
                (fp #b0 #b111101100 #b00010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
