;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110101 #b01110001)
                arg1
                (fp #b0 #b000000001 #b00000000)))
(assert (fp.leq (fp #b0 #b000000001 #b00000000)
                arg1
                (fp #b0 #b111111010 #b01011011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010100100 #b01111000)
                arg2
                (fp #b1 #b001010110 #b00101000)))
(assert (fp.leq (fp #b1 #b001010110 #b00101000)
                arg2
                (fp #b0 #b000001101 #b10101101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011111100 #b11001111)
                expect
                (fp #b1 #b001010110 #b00100111)))
(assert (fp.leq (fp #b1 #b001010110 #b00100111)
                expect
                (fp #b0 #b110010111 #b00110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
