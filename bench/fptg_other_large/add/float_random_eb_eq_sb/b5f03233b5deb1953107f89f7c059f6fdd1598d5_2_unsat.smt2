(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b10101000010)
                expect
                (fp #b1 #b111111111101 #b00000000001)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000001)
                expect
                (fp #b1 #b000001000011 #b01011001100)))

(assert (not (= expect result)))

(check-sat)
