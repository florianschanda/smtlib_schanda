; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111101 #b0001011101)
                arg1
                (fp #b1 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000)
                arg1
                (fp #b0 #b11110010101 #b0010100111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01111001100 #b0101101001)
                arg2
                (fp #b0 #b11010110000 #b1101010111)))
(assert (fp.leq (fp #b0 #b11010110000 #b1101010111)
                arg2
                (fp #b0 #b11110001101 #b0000001111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111101 #b1100110101)
                expect
                (fp #b1 #b11111111100 #b1111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111)
                expect
                (fp #b1 #b11111010101 #b1110011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
