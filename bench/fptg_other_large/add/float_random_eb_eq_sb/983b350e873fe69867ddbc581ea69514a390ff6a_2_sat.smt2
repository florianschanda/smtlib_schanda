                arg2
                (fp #b1 #b000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000 #b01111101)
                arg2
                (fp #b0 #b101100111 #b00011100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000010 #b01101101)
                expect
                (fp #b1 #b101000011 #b10111101)))
(assert (fp.leq (fp #b1 #b101000011 #b10111101)
                expect
                (fp #b0 #b100011100 #b00000110)))

(assert (= expect result))

(check-sat)
(exit)
