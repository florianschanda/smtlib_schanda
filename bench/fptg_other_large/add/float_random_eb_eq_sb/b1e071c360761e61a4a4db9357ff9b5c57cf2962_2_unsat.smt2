;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101010111 #b100010000)
                arg1
                (fp #b1 #b1001110101 #b100001111)))
(assert (fp.leq (fp #b1 #b1001110101 #b100001111)
                arg1
                (fp #b0 #b0000100111 #b001001111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111110 #b011111001)
                arg2
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg2
                (fp #b0 #b1000101010 #b000001101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b101011111)
                expect
                (fp #b1 #b1111111101 #b000000001)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000001)
                expect
                (fp #b0 #b1111110011 #b100111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
