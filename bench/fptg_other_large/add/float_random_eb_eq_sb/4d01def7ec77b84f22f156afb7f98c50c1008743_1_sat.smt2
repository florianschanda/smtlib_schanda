                (fp #b0 #b0000000000000001 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b000000000000000)
                arg2
                (fp #b0 #b1101010110101111 #b111110000111101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100011011000010 #b000001110001111)
                expect
                (fp #b1 #b0011111111111000 #b011010100000100)))
(assert (fp.leq (fp #b1 #b0011111111111000 #b011010100000100)
                expect
                (fp #b0 #b1100111111011001 #b001100000011100)))

(assert (= expect result))

(check-sat)
