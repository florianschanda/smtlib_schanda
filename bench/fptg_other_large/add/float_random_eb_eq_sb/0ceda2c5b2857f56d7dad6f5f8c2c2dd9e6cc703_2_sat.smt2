(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100101 #b11110010)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b0 #b001001000 #b00110000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001100 #b11111010)
                arg2
                (fp #b1 #b101001011 #b00101100)))
(assert (fp.leq (fp #b1 #b101001011 #b00101100)
                arg2
                (fp #b0 #b101110110 #b11010000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010100 #b11011111)
                expect
                (fp #b1 #b101001011 #b00101101)))
(assert (fp.leq (fp #b1 #b101001011 #b00101101)
                expect
                (fp #b0 #b101001111 #b11001100)))

(assert (= expect result))

(check-sat)
(exit)
