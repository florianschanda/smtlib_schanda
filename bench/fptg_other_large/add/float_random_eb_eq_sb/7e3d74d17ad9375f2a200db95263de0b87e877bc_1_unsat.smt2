; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100100101 #b11110010111)
                arg1
                (fp #b1 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b11111111111)
                arg1
                (fp #b0 #b110011110010 #b00101011110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100011011 #b10111010111)
                arg2
                (fp #b0 #b000000000000 #b10101111011)))
(assert (fp.leq (fp #b0 #b000000000000 #b10101111011)
                arg2
                (fp #b0 #b000000010100 #b10010001000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111001000000 #b01010010000)
                expect
                (fp #b1 #b101111111110 #b11111111110)))
(assert (fp.leq (fp #b1 #b101111111110 #b11111111110)
                expect
                (fp #b0 #b101111010101 #b11000111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
