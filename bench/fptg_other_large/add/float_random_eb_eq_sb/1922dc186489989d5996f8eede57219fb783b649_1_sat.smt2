(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110011 #b11000001)
                arg1
                (fp #b0 #b000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b000000000 #b11111111)
                arg1
                (fp #b0 #b101111110 #b11110010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011111100 #b10010100)
                arg2
                (fp #b0 #b101111010 #b00100100)))
(assert (fp.leq (fp #b0 #b101111010 #b00100100)
                arg2
                (fp #b0 #b111100010 #b10010000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010111000 #b11001110)
                expect
                (fp #b0 #b101111010 #b00100100)))
(assert (fp.leq (fp #b0 #b101111010 #b00100100)
                expect
                (fp #b0 #b111110000 #b11101111)))

(assert (= expect result))

(check-sat)
(exit)
