                arg1
                (fp #b1 #b101111110 #b11111111)))
(assert (fp.leq (fp #b1 #b101111110 #b11111111)
                arg1
                (fp #b1 #b001111010 #b10001001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100000 #b10100010)
                arg2
                (fp #b1 #b100000111 #b10010100)))
(assert (fp.leq (fp #b1 #b100000111 #b10010100)
                arg2
                (fp #b0 #b110100010 #b01111111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001010 #b10111010)
                expect
                (fp #b1 #b101111111 #b00000000)))
(assert (fp.leq (fp #b1 #b101111111 #b00000000)
                expect
                (fp #b0 #b001001110 #b10001100)))

(assert (= expect result))

(check-sat)
(exit)
