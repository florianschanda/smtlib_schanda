(assert (fp.leq (fp #b1 #b01000011101 #b0111100011)
                arg2
                (fp #b1 #b00001110000 #b0011010110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111000001 #b1110000100)
                expect
                (fp #b1 #b10000001000 #b1101001011)))
(assert (fp.leq (fp #b1 #b10000001000 #b1101001011)
                expect
                (fp #b0 #b10001100100 #b1100110000)))

(assert (not (= expect result)))

(check-sat)
