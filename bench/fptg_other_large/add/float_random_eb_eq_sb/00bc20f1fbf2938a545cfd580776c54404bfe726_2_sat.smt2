(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011111010 #b10011100)
                arg1
                (fp #b1 #b010101000 #b01111011)))
(assert (fp.leq (fp #b1 #b010101000 #b01111011)
                arg1
                (fp #b0 #b101111000 #b00111001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000011010 #b01010011)
                arg2
                (fp #b0 #b011111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111 #b00000000)
                arg2
                (fp #b0 #b100111001 #b01000101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000001100 #b10110110)
                expect
                (fp #b0 #b011111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111 #b00000000)
                expect
                (fp #b0 #b110110110 #b10110000)))

(assert (= expect result))

(check-sat)
(exit)
