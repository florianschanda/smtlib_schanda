                arg2
                (fp #b0 #b1011001000110111 #b110100010011001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0001110001101110 #b001010001101101)
                expect
                (fp #b0 #b1000111110000101 #b010000010010010)))
(assert (fp.leq (fp #b0 #b1000111110000101 #b010000010010010)
                expect
                (fp #b0 #b1001000010001110 #b110110001101010)))

(assert (= expect result))

(check-sat)
(exit)
