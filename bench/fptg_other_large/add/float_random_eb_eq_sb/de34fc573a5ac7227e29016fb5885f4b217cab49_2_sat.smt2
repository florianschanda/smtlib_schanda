                expect
                (fp #b1 #b0111111111111111 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b000000000000001)
                expect
                (fp #b1 #b0001110000100001 #b100010011101000)))

(assert (= expect result))

(check-sat)
