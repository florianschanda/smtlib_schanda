; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100110101 #b0000000011)
                arg1
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b00100110000 #b1010110111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001101110 #b0110110010)
                arg2
                (fp #b1 #b00111111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b00111111011 #b0000000000)
                arg2
                (fp #b0 #b11101101001 #b0011101111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011110110 #b0100010110)
                expect
                (fp #b1 #b00111111010 #b1111111111)))
(assert (fp.leq (fp #b1 #b00111111010 #b1111111111)
                expect
                (fp #b0 #b11011111010 #b0110111011)))

(assert (= expect result))

(check-sat)
(exit)
