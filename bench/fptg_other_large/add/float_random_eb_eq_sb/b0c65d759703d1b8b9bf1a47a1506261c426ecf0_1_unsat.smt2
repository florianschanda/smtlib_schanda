(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000010 #b00011000)
                arg1
                (fp #b1 #b101000011 #b10111100)))
(assert (fp.leq (fp #b1 #b101000011 #b10111100)
                arg1
                (fp #b0 #b001100000 #b10110101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000010000 #b11101101)
                arg2
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg2
                (fp #b0 #b011001010 #b11111111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100000 #b01100100)
                expect
                (fp #b1 #b101000011 #b10111011)))
(assert (fp.leq (fp #b1 #b101000011 #b10111011)
                expect
                (fp #b0 #b100011001 #b00110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
