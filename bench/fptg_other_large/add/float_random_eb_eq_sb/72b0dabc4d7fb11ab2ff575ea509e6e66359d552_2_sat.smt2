(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000101011100 #b11101001010)
                arg1
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                arg1
                (fp #b0 #b100001100100 #b00100111011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110110100 #b10011010001)
                arg2
                (fp #b1 #b100000110101 #b00101100111)))
(assert (fp.leq (fp #b1 #b100000110101 #b00101100111)
                arg2
                (fp #b1 #b010101101101 #b10010111010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110001001100 #b10100101010)
                expect
                (fp #b1 #b100000110101 #b00101100111)))
(assert (fp.leq (fp #b1 #b100000110101 #b00101100111)
                expect
                (fp #b0 #b011110011110 #b00001101011)))

(assert (= expect result))

(check-sat)
(exit)
