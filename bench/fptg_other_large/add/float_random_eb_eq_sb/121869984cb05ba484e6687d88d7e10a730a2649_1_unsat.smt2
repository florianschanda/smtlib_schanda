(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                arg2
                (fp #b0 #b00011010001 #b0000001111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001010000 #b0101000111)
                expect
                (fp #b1 #b10000001001 #b1111111111)))
(assert (fp.leq (fp #b1 #b10000001001 #b1111111111)
                expect
                (fp #b0 #b00100010000 #b0111110101)))

(assert (not (= expect result)))

(check-sat)
