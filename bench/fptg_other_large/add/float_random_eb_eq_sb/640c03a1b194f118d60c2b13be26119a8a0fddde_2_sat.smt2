                arg2
                (fp #b1 #b011111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111 #b00000000)
                arg2
                (fp #b0 #b010010001 #b11111000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100110 #b00000110)
                expect
                (fp #b1 #b100010111 #b00001110)))
(assert (fp.leq (fp #b1 #b100010111 #b00001110)
                expect
                (fp #b1 #b011100001 #b00010111)))

(assert (= expect result))

(check-sat)
(exit)
