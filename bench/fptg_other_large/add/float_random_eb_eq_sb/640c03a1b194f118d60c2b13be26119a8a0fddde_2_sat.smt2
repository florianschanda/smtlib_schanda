(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100111 #b01100100)
                arg1
                (fp #b1 #b100010111 #b00001101)))
