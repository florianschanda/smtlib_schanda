;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010100111 #b1000011111)
                arg1
                (fp #b0 #b00000000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111000)
                arg1
                (fp #b0 #b11110110011 #b1101000110)))

(declare-const arg2 (_ FloatingPoint 11 11))
