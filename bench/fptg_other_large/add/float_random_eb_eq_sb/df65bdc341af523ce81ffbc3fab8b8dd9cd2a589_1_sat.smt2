                arg2
                (fp #b1 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000)
                arg2
                (fp #b1 #b01011001101 #b0000001010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100010110 #b0110011010)
                expect
                (fp #b1 #b01111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b01111111110 #b1111111111)
                expect
                (fp #b0 #b11101011010 #b1010111001)))

(assert (= expect result))

(check-sat)
(exit)
