                (fp #b1 #b100000111 #b10010100)))
(assert (fp.leq (fp #b1 #b100000111 #b10010100)
                arg2
                (fp #b1 #b100000010 #b01111110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001101 #b01101100)
                expect
                (fp #b1 #b100000111 #b10010011)))
(assert (fp.leq (fp #b1 #b100000111 #b10010011)
                expect
                (fp #b1 #b001001001 #b00100001)))

(assert (= expect result))

(check-sat)
