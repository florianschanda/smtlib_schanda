; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011111110 #b110111010)
                arg1
                (fp #b0 #b1011100011 #b101000100)))
(assert (fp.leq (fp #b0 #b1011100011 #b101000100)
                arg1
                (fp #b0 #b1101100101 #b101110100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010111111 #b000101011)
                arg2
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg2
                (fp #b0 #b1101101000 #b000110000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0111110110 #b110010011)
                expect
                (fp #b0 #b1011100011 #b101000101)))
(assert (fp.leq (fp #b0 #b1011100011 #b101000101)
                expect
                (fp #b0 #b1100111000 #b010001100)))

(assert (= expect result))

(check-sat)
(exit)
