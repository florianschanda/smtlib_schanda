                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg2
                (fp #b0 #b111010010 #b11000111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010001101 #b10100111)
                expect
                (fp #b0 #b100000111 #b11111111)))
(assert (fp.leq (fp #b0 #b100000111 #b11111111)
                expect
                (fp #b0 #b101001111 #b11011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
