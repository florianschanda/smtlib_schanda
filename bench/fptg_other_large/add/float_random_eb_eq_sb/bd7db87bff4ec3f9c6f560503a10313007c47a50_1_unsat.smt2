(assert (fp.leq (fp #b1 #b1001010100000 #b010101110110)
                expect
                (fp #b1 #b0111111111111 #b101110111110)))
(assert (fp.leq (fp #b1 #b0111111111111 #b101110111110)
                expect
                (fp #b0 #b1000010101010 #b111010000101)))

(assert (not (= expect result)))

