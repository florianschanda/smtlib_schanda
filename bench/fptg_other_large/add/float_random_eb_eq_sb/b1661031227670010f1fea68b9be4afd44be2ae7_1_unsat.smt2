(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b001010001)
                arg1
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg1
                (fp #b0 #b0011101010 #b101010010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0111011011 #b000001010)
                arg2
                (fp #b0 #b1001110111 #b101110100)))
(assert (fp.leq (fp #b0 #b1001110111 #b101110100)
                arg2
                (fp #b0 #b1011111000 #b111010000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b111110110)
                expect
                (fp #b1 #b1111111100 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111100 #b111111111)
                expect
                (fp #b1 #b0001111100 #b011110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
