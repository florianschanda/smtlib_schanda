; Format: FLOAT64
; Arg1: -ONE
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110011001 #b1011001010101100100101101111101010111100010001100001)
                arg1
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100111011 #b0101011100101111010000111101110010100110110000001000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011011101 #b0101010111100100000111001000010111100101011110100011)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b01011100011 #b0100011010111010001110101000100101011011000100010000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110101111 #b1100001101100100000000001110010010110001000000111100)
                expect
                (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b00111101110 #b0100110001010111010111111010010001010100110010101011)))

(assert (= expect result))

(check-sat)
(exit)
