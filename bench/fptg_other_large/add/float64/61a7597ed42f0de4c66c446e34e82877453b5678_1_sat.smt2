                arg2
                (fp #b0 #b11111010101 #b0001101001001111110110011010101101000111110000111011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01111011100 #b0011000110101110100111111111010001010000001111111111)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111110)))
