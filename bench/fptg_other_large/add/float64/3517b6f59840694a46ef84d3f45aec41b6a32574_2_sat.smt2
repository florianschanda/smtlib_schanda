(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                arg2
                (fp #b0 #b01100011001 #b0011101001010110010110110101010110000110101001110110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00010010000 #b1000010000101100010011111011111010001010010010011000)
                expect
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                expect
                (fp #b0 #b01111001011 #b1110000101001111101101010011011010111001101110100110)))

(assert (= expect result))

(check-sat)
(exit)
