                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b1 #b00101000101 #b1010011010101111001111101010010111000111010010100010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110011101 #b0011100001001111110100111010000001011110000101000111)
                expect
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100011)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100011)
                expect
                (fp #b1 #b00001001101 #b1011110110101001111110111000111001101000001010011111)))

(assert (= expect result))

(check-sat)
(exit)
