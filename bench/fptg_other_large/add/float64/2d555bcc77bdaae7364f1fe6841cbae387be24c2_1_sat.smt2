                arg2
                (fp #b0 #b00110001011 #b0001011000101111011011110111101010111000111111101011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001010100 #b1010001111010101011010011100101101010001110010111111)
                expect
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010000)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010000)
                expect
                (fp #b0 #b11111011000 #b0101100101100101001001011110010010101100010111010101)))

(assert (= expect result))

(check-sat)
(exit)
