; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111100101 #b0010101011110000000110101001001001110000000001001101)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00011001100 #b0110101111001101011011011010001000111110010010011110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010010110 #b0000100011010110110010110010001101000110011000100010)
                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b10110110011 #b1111100100111000001110100100101011100011101011110000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00001100110 #b0011010101110100100100000111010000010000111100011111)
                expect
                (fp #b0 #b00000000001 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000001 #b1111101000110101011000111011010001110111100111010001)
                expect
                (fp #b0 #b01011111100 #b1101010001100100010101011011000101000011011000001010)))

(assert (= expect result))

(check-sat)
(exit)
