(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110010100 #b0011010100001101000000101010110110110101101110010010)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101100010 #b1110110001010101000000110110011011101110010001010001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110100001 #b0100001100111111010100011111100110110110101001010000)
                expect
                (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101100)))
(assert (fp.leq (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101100)
                expect
                (fp #b0 #b11011111011 #b0111001001100110101000011010000000100011011100001110)))

(assert (= expect result))

(check-sat)
(exit)
