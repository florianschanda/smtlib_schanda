; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111010101 #b1011001101111010101000101010000101101000001001101001)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100111101 #b1101111111111101011111101111101011010001010110100000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01101011011 #b1100100101000110101101111010111001001000100100100001)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b10100001110 #b0110111110101011010100111011100011001100010110110110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01000110000 #b0001001000110011110110101010000100110101000100010100)
                expect
                (fp #b0 #b00000000001 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000001 #b1010101000100010100101010110010011001010101001101111)
                expect
                (fp #b0 #b01101010001 #b0110110010101110001011110011010110001011001101101110)))

(assert (= expect result))

(check-sat)
(exit)
