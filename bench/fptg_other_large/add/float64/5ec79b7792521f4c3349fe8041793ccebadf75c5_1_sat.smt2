; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000010000 #b1010001011001101011111011000101111100001000101000101)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b00110101010 #b1101011110111111011111000111110001111101001101101110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101001010 #b0101001000110100110111101011110001001101101101101011)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b00110010011 #b0101100101000110001110100110110111100000010010110000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010110011 #b1100001001001010000001000001111110110011111000110011)
                expect
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101110)
                expect
                (fp #b0 #b10001100000 #b0010101100010000110101010101010011100011010011010101)))

(assert (= expect result))

(check-sat)
(exit)
