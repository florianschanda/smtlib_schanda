;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00100110110 #b0010001100011101111100100011001110011111000101010110)
                arg1
                (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)))
(assert (fp.leq (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)
                arg1
                (fp #b0 #b10100001011 #b0011100110101011010001010101000010010100011010111000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010100011 #b0000110111011010101100011100000110111001001110011010)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b11110111010 #b0010001110011001010000101110101011000011011010100100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101011110 #b0110110000010000001000010111010001011101111101110111)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110110)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110110)
                expect
                (fp #b1 #b01010101010 #b0111001010011111110101101101110101101011110111100000)))

(assert (= expect result))

(check-sat)
(exit)
