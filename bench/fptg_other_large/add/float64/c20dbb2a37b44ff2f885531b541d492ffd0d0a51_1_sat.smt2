(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101011101 #b0110111011000010111111011001111101010110101111001111)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10011000110 #b1111110001100100011010110011001100001100001011011101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00000010111 #b0011001000100101011000111010011000011111000101000011)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b00011101100 #b0100011100100000011110101101110001000100000111000011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001110001 #b0111001111101111110110110000000100010011011111111001)
                expect
                (fp #b1 #b00111111111 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00111111111 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b00000100011 #b0111100011110000101110101100010101100000111100110011)))

(assert (= expect result))

(check-sat)
(exit)
