                arg2
                (fp #b0 #b10111000111 #b0110000110110011001001110100011100000001001011110111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001111001 #b1000010110110111001110101100011000010000010101110011)
                expect
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010100)))
