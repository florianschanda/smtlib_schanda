(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011001010 #b0111111001101100010011100010010001010000101011001110)
                arg1
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b1 #b01010101100 #b1011010100001101010100011110100000100001111111001000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000111110 #b0000000011000010111111110011000101101001111011001010)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01011111000 #b0101011101001011110110111010100000000101110001000111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000001011 #b1111000010011111100100001000100001110111110000000001)
                expect
                (fp #b1 #b10111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01010010000 #b1011111110111010000100101010010110101100110111000000)))

(assert (= expect result))

(check-sat)
(exit)
