; Format: FLOAT64
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010010111 #b1011000011101110000011101101101101100010000101101001)
                arg1
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b1 #b00011000100 #b1111011000000110110111111111010011001110111111110010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100000100 #b0100110111100001101010001101000011110100111110100101)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101010111 #b0000111010110111001111001101000000011101101000101000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101101100 #b0011001000101101000110110110010100111000111111001001)
                expect
                (fp #b1 #b10111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b01100101101 #b1100101110010100111101110111111110001010000111110111)))

(assert (= expect result))

(check-sat)
(exit)
