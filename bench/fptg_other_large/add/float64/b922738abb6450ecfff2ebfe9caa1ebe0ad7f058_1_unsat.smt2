; Format: FLOAT64
; Arg1: +NAN
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000000000 #b0111000111011010001100000001110011010111111101101110)
                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11011010010 #b1110001011101110001100101100100111010010010110001101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
