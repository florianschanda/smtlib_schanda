                arg2
                (fp #b1 #b01010110100 #b0011101100010100111011111100101101111011110010000011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111100100 #b1101110110010100010101001111010011011111011001000011)
                expect
