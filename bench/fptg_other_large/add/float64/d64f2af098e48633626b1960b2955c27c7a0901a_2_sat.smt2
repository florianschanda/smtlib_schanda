; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000101100 #b0110101100001110101000011111011001000001111111100011)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b10100100110 #b1010100110011110000111000001110111110001101110000011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100001101 #b0011000000010011010000010110100011111000110000101001)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01000101011 #b1110101011101111011011001010100001001011100110111100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101011001 #b1100111101100100100010001111110101000011010111111110)
                expect
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b00101101101 #b1010000111011100110101101110000101110010110110001011)))

(assert (= expect result))

(check-sat)
(exit)
