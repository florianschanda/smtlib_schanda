(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10000001101 #b1000011111111001111111100101010010111111110110110010)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11010110010 #b1101010000101010101000000011100011000110001111110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001011000 #b0101001101110000110011101101100110011000010010111110)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b10111000111 #b1010010111010110001100110011011001001010101001111011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000111101 #b0010101100000101011111011000100111110100111110011001)
                expect
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                expect
                (fp #b0 #b01100000010 #b1101100000000100100111111001001010000100001001001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
