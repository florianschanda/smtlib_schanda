;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000011100 #b0000010011110010101011011111010110010111101110111100)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01011111101 #b1010110000110101110001100010101010001011001001011101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b10100000101 #b1101010110100110001101101010100011100100010100100110)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111110 #b1101010010010000110100011001111100001111010011111100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00010110110 #b0110110011011000111010011011010001100110100001101110)
                expect
                (fp #b0 #b11111111100 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111100 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111111101 #b0000101001111100011001011011010001000000010000100101)))

(assert (= expect result))

(check-sat)
(exit)
