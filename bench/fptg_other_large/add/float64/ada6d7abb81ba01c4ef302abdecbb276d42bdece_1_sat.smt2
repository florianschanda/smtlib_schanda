; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110011110 #b0101111111100010101001010001001000110000101010111000)
                arg1
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)
                arg1
                (fp #b1 #b00110101000 #b0011100100010111010010111111000001010001000111010011)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001111100 #b1111000111010111111010100101000011001110110100000101)
                expect
                (fp #b1 #b10000000000 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b10000000000 #b0010100110010101011001111101111001110101011010110000)
                expect
                (fp #b0 #b10010101101 #b0010111101111111010101111100100100010001101000001101)))

(assert (= expect result))

(check-sat)
(exit)
