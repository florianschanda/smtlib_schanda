; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01111111010 #b0001010000100011010001001111101000000001001011101100)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b10010110100 #b1101111001000001001001111011110010001010100100111011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010110111 #b1111111011101000000100101111001011111010000010001111)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11001110111 #b1110111111110110100001111100111111111101011111011100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001101110 #b1110101110010001010111100010110101001101010110010100)
                expect
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10101101100 #b0000101100101100001110101110010111010110111011001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
