; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000111101 #b0000100100110110111100111011101110001111000101101010)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01101000000 #b1000010000110110110010110100010110010100100111001100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010001111 #b0001001100100110110110111011000111110000011000110101)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b00111101011 #b1100011010111111011001101110100010001110101100000100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001101101 #b1000000001011000101100010100110001111001001100111101)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110110)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110110)
                expect
                (fp #b1 #b00010000101 #b0000100001101010100101011010100111010111000001010010)))

(assert (= expect result))

(check-sat)
(exit)
