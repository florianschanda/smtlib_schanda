                arg2
                (fp #b1 #b01101111110 #b0010011001110001111011101010011011101011100010101101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010000011 #b0010011011100010111010100011111110101011010110101100)
                expect
