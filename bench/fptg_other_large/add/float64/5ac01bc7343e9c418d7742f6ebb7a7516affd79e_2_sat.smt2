; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010000111 #b0111000100100110011001000011101000110010100011000111)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b11100001010 #b1000111111101100000110010010111100100011101110000100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01100101100 #b1001111110010001010110000111011011000110101111100111)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11110100111 #b0101001101010101000110001001001110100001111010000001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01000010010 #b1011000101100110110101001010010110101000010011101011)
                expect
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101010000)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101010000)
                expect
                (fp #b0 #b10110010101 #b1101001010001011011111101001101100110011101100010101)))

(assert (= expect result))

(check-sat)
(exit)
