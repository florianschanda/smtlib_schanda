(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b11010110101 #b0001000001011001000110011100010001001011011110101010)
                arg1
