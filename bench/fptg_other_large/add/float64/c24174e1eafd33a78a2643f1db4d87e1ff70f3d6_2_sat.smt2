; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100111101 #b1010111010100001000000010111011001000110011100111000)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01011110100 #b0010101110110111010100010110000000101101010100000001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00101010011 #b1010010010110010000001101010000110100010101010110101)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b10100011011 #b0101011101001010011111000101111110001110010100001110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010111100 #b0100110110100010110110010111111111011001101111001101)
                expect
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110110)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110110)
                expect
                (fp #b0 #b11000010100 #b1010111000110011110000011111110010110110001000000111)))

(assert (= expect result))

(check-sat)
(exit)
