; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001110100 #b0100000101111010100000110100011000101011000110000011)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01001101001 #b1111001001101101111011100101000110111111011110110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00111110010 #b0110100000110011011100111110011101110111000101100110)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b10001001010 #b1101010001111010111100001100001010111000001011000110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00100111001 #b1000011000110010000101001010010001100000101001100111)
                expect
                (fp #b0 #b00111111111 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00111111111 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b01000010000 #b1111100110010001101111010100010100011111010010111011)))

(assert (= expect result))

(check-sat)
(exit)
