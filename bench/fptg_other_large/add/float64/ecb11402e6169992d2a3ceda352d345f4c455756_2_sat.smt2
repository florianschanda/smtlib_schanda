; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000010111 #b0000111011101100010101011010111011111101111011001010)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10001000101 #b0010100100011000100100010010110111001001100100100010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001110111 #b1100011011001101110101110111000101011111001110110010)
                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01011001100 #b1010101100000101000110111100100001101001010100010010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101010100 #b1100000010000100111000110100110010100111101101110100)
                expect
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b1 #b00101011010 #b1111000101100110100110111010111110010001110101010100)))

(assert (= expect result))

(check-sat)
(exit)
