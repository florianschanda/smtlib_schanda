                arg2
                (fp #b0 #b11111101011 #b0101000111101110100011011101101001001111000100100100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00100011011 #b1110001001111000110100001001111001001110001110011010)
                expect
