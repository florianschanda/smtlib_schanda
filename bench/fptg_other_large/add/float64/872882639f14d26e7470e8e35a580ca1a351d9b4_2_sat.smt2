                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11101011011 #b1001001110010101100001111000111110010000111101001101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110000010 #b1110100100011001001110111101100001001000100010111111)
                expect
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11000111100 #b1010100001011101000000101011101100011000001011100010)))

(assert (= expect result))

(check-sat)
(exit)
