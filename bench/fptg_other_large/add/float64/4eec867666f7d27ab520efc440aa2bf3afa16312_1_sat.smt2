; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110000111 #b1000010010000100111000101100101101100000100001111100)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b10100011100 #b0010000010000001000010111111011101001111000000111000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110001101 #b0111011100001111110101000001010110100010011010111000)
                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100000010 #b1101010111101011100100100011001100110000101010001001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101010010 #b0011010001110101111010001010011111001101001100111101)
                expect
                (fp #b0 #b00000000000 #b1110100111010101111011010011011000000100101010010011)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110100111010101111011010011011000000100101010010011)
                expect
                (fp #b0 #b10011010111 #b0110110100100000001111110100101010000000010101101101)))

(assert (= expect result))

(check-sat)
(exit)
