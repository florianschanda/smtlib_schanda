(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101111111 #b1111010000001110000110001011001010110001100011101011)
                arg2
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10011101111 #b1100011001011111100111110010101110110011001111111000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10000101111 #b0101111101000011111100010111100101011010100101001010)
                expect
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                expect
                (fp #b0 #b11000000111 #b0011000000101110001111001010111010001010000111101000)))

(assert (= expect result))

(check-sat)
(exit)
