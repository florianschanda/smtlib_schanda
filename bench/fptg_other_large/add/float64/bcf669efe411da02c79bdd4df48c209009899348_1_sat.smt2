(assert (fp.leq (fp #b1 #b00110010101 #b1100100011110011011011011011001111001100110000110111)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00001110001 #b0100011110111001000001010110000000111001011101011000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00001110110 #b0100100001100100000011001011000011010110001000111110)
                expect
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00101000101 #b1001001100101011010010111111010110001000001111110111)))

(assert (= expect result))

(check-sat)
(exit)
