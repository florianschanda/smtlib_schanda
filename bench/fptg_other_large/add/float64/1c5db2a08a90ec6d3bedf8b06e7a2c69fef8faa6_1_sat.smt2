;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01011010011 #b0001111011011011110101000011110101011110010100100110)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110010101 #b1100000111110010110101101101100100101011110110011111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000010011 #b0101000001010110110111111010100100000010101110110100)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00111101010 #b0101011101000111001000100011101000011010010000110110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00010111000 #b1101111101011111101110010001101100111101001101010111)
                expect
                (fp #b0 #b00111100101 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00111100101 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b10110011010 #b0011011011100011010011001011010000100100000011110110)))

(assert (= expect result))

(check-sat)
(exit)
