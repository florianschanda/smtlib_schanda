                arg1
                (fp #b0 #b10110100111 #b0000011011110111001000100010001110010110011011110001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00110100000 #b1100001000011100011000001001101110110100110001000001)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11011101111 #b0111111011000101010101011100100100010010000000010011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010111110 #b0011101101001100001111111001011111101011001000100000)
                expect
                (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000001)))
(assert (fp.leq (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000001)
                expect
                (fp #b0 #b01010000011 #b1010011111111110100100000110101110001110100001110000)))

(assert (= expect result))

(check-sat)
(exit)
