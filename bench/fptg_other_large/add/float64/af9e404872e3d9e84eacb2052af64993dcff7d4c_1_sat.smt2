(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101110000 #b1001101111100000001101000011011010001010101010111110)
                arg1
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)
                arg1
                (fp #b0 #b11011110100 #b0011100010010011000101100111000111110110111011010011)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
