(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -ONE
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100001111 #b0001111000011111110110110011110001100110100110101000)
                arg1
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10110111011 #b1001010010011011100001001000001010111010010010110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00110001110 #b0111100011010111011100100101111011001110101111000111)
                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000000101 #b1011111111010111000011010010100000101011011011100011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000010111 #b0010010111101101100111100100010010001111110101001000)
                expect
                (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b01101010010 #b0001111001100100010101100010111000011010111000011111)))

(assert (= expect result))

(check-sat)
(exit)
