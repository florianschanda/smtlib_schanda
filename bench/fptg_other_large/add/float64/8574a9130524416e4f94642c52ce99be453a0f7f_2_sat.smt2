; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00011011000 #b1111010101100001100000101110100000101000110111011010)
                arg1
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)
                arg1
                (fp #b0 #b11111001101 #b0100100110110101010111000101101100000101101001111011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00001010000 #b1111111000111101101001011010111100010010001111001110)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b01011111111 #b0001001110110111000110011110111011011011100111011111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011110001 #b0010011110001001111111101001001101011010111111011001)
                expect
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110101)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110101)
                expect
                (fp #b0 #b11011010010 #b0011010010001100010111100010010001011011101001011110)))

(assert (= expect result))

(check-sat)
(exit)
