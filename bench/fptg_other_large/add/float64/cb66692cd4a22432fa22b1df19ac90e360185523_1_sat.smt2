(assert (fp.leq (fp #b1 #b11100000100 #b0000010101101010110101010101000010100000011110011110)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00000101111 #b1000011110010001111100011111111100001110011111110010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100011110 #b1110001101001101010110111100010000001100100001011100)
                expect
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                expect
                (fp #b0 #b10111010010 #b1100110101010110110111101101111111101101010111001011)))

(assert (= expect result))

(check-sat)
(exit)
