                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01110110001 #b0100000111001011100111111110000101100100100011000110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111101110 #b0110001101010001000100101011000100111101100101000000)
                expect
                (fp #b1 #b00111100101 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00111100101 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11010111101 #b0010011101111101000101100110111001001010000110011101)))

(assert (= expect result))

(check-sat)
(exit)
