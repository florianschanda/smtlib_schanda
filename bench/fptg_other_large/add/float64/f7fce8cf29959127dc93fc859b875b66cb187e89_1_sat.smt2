; Format: FLOAT64
; Arg1: +ONE
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01111110011 #b0100010101000010101110101010010000001111010110010110)
                arg1
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111000001 #b0111011101001000101010001011000010000111001001110100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100110000 #b1011001000101001101100011001010011110001001100011100)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b1 #b01011101000 #b0001101011110010000000000010010100111111001111101101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101011001 #b0010010110000101101110010110001011000011100111000001)
                expect
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111110111)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111110111)
                expect
                (fp #b0 #b00110011111 #b0000011000111111001010110011101101010110111010110101)))

(assert (= expect result))

(check-sat)
(exit)
