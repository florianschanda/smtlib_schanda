                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b1 #b01101100110 #b1001111010001110000011001101001010110000011101101111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01010100111 #b1010101110000000101101011100011100100000000000011110)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011010111)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011010111)
                expect
                (fp #b0 #b10100010111 #b1000111110101011010101011101000001110111000111111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
