; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000001101 #b0100010100011011100010001011110000001010111100100000)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11000011001 #b0100110010110110010110111001011011001000000000101001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b1010000110011111111011111011101101010110010001001010)
                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101110001 #b0001010101001111011011011011100111111010000011000110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0011101010101100000110100010110011111011001111101011)
                expect
                (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11100101001 #b1011000110001111111100100010111000110110001001111100)))

(assert (= expect result))

(check-sat)
(exit)
