                arg2
                (fp #b0 #b00101111101 #b1100101101001111111010111100100010100110101101000100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000110001 #b1100100111110111001001010000010111010111000101000100)
                expect
                (fp #b1 #b00000000001 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000001 #b0110110101001110100110111011100000011010011101110110)
                expect
                (fp #b0 #b10000110110 #b0101111001011010100001111010010110011110010110100111)))

(assert (= expect result))

(check-sat)
(exit)
