(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111010001 #b1001011011101000101100101010011100101001001100010000)
                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b1 #b00000110110 #b0001100010000011100111010001111001100110011101010001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010000011 #b0011110111111011110100100011001100101011110100010011)
                expect
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100011)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100011)
                expect
                (fp #b0 #b01010111001 #b1011010001101101010111000100011100101111111111111101)))

(assert (= expect result))

(check-sat)
(exit)
