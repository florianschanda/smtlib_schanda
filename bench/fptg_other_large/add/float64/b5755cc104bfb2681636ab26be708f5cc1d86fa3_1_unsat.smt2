; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1111011010010000011101111101011011100110001110101011)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10000001010 #b1011100111000011111011101101111110000010010001011101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111000001 #b1000110010101011100100101001111100010011001100001011)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11100100100 #b0110011110110110110101101001111000001010000111110100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1110110111110110011001101011100001101001000010101110)
                expect
                (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111100 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b00000010010 #b0100111000011111100000011111100010101000011101100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
