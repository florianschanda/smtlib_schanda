; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101011110 #b0010001111110110100000101000101010010001001001011010)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111100010 #b1101000000110111001101101101011111100001110010111001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01001011111 #b0000111001011010011110001100111110010110101110110101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b1 #b01110111101 #b1000011100000001111001101111001111011001001110100101)))

(assert (= expect result))

(check-sat)
(exit)
