                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11001111111 #b1000011001001111111010010100000100110000110111110100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01111101000 #b1111110010100011100100010001110011000000010111110111)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011010111)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011010111)
                expect
                (fp #b0 #b11111001101 #b0010101011110111110001101010111011011000010011100011)))

(assert (= expect result))

(check-sat)
(exit)
