;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011110010 #b0111011001101000111011010011001000111101000000010011)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b00000100100 #b0111010001010010101010010100101101011000010101001010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00110011101 #b1110111111000010110101100011010011111000110110101011)
                arg2
                (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)))
(assert (fp.leq (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)
                arg2
                (fp #b0 #b10110011011 #b0111011010111011101011111010110111000110011010110100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010011011 #b0000111111110000110100101011011111100011000011101111)
                expect
                (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011010)))
(assert (fp.leq (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011010)
                expect
                (fp #b0 #b10010010010 #b1011110100001101110111101001100101010010011001011110)))

(assert (= expect result))

(check-sat)
(exit)
