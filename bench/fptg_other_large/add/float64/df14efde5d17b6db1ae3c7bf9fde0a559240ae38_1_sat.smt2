(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111100000 #b0000010111111110000100111011000001111010010001111110)
                arg1
                (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)))
(assert (fp.leq (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)
                arg1
                (fp #b0 #b00100001111 #b1101100100101001101101100011000001101011111101010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101010110 #b0000101010010001011101000101110101001000101111111100)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b10011011101 #b1101011101111001010010011000011100011001110001011110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111001 #b0100110110011111111111001111110011101111010100000010)
                expect
                (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110110)))
(assert (fp.leq (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110110)
                expect
                (fp #b0 #b01100010001 #b0000111111011001010001011010101011111000001011111101)))

(assert (= expect result))

(check-sat)
(exit)
