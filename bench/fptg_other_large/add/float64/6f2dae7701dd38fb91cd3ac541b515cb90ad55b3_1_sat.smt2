(assert (fp.leq (fp #b1 #b00110100100 #b1000100111011000011101111000110001001001011111101100)
                expect
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010010001 #b1001010100111001100010100100001010000110011011100111)))

(assert (= expect result))

(check-sat)
