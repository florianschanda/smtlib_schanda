; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111100 #b0101011100101101011100011110110111110011101011000001)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b00010010000 #b1111010100000110101011001011001100011101001011101100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00110011100 #b1001001101000110010000111000111010000111010100001100)
                arg2
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11011010101 #b1101101111111000010010110101110110110001110001111111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011011001 #b0010100111101111111000011010110001100100000011101001)
                expect
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10000111010 #b1001111000110011010110110011111100010100010111110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
