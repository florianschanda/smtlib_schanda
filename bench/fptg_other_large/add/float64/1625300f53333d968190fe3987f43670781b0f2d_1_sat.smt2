; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000011010 #b0110000001010011001010110011110100101000101011111011)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b10011110111 #b0110110111100000011011110110100011101101011001010000)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01010001111 #b1011000101101101100101101110000001000100010000000110)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01110100101 #b0010110101010011001010101100001010010011010001001010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00011001011 #b0111110011001100011011000000011001001011100000111001)
                expect
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                expect
                (fp #b0 #b10100101110 #b1100111001100001110011000100110111001010111100001110)))

(assert (= expect result))

(check-sat)
(exit)
