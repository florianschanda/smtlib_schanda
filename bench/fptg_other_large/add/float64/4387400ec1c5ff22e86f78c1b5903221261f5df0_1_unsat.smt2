; Format: FLOAT64
; Arg1: +ZERO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11011010111 #b0001010001101001101011110001000101010011011011110100)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00110100001 #b0111011011110101111001001001010110101011111001010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00110100100 #b1011101101001101010001101111110101101100101000111111)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11011111101 #b1101000011100111100100111101111110010000100100000011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000100100 #b0111100011100110011110000000011101110000110111011010)
                expect
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                expect
                (fp #b0 #b11111001100 #b0111111101000101110001101011111001111011111011111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
