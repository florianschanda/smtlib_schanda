(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                arg2
                (fp #b0 #b10110101110 #b0001100111100111100110110111110000010001010010100010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001000010 #b0011011101111100110111011010000101101010011000000000)
                expect
