; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01000011110 #b1101101000110100000100110101011001100111000101011000)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10110110101 #b0100110111101111011001100001001101101101100010010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00110100110 #b1000011000111111011010101011010110110000100111100010)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11000011010 #b1101000110111001110101001111011110001010111001001011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011000010 #b0110101110001010101001101011001110010001010100011001)
                expect
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b0 #b01011100011 #b1000010100000001010100010010111100111000100100011011)))

(assert (= expect result))

(check-sat)
(exit)
