                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b1 #b00100011101 #b0100101011100101001101001111110100010101111011010101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001011011 #b0101101001011100101111101011110001011101101111100011)
                expect
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000101111)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000101111)
                expect
                (fp #b1 #b01110010000 #b0010010110001010011110101000011000011010111110011101)))

(assert (= expect result))

(check-sat)
(exit)
