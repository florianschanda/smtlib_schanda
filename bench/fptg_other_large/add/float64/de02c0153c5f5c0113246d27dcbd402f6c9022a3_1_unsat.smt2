                arg2
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b01111001101 #b0101001011010100001011010011101010011001000001101000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010100100 #b1110010001011110111010010011010101100000111011100111)
                expect
                (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11001110011 #b0010101011000110010001011001000110100010001100001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
