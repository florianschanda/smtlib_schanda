; Format: FLOAT64
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110000000 #b1111100111111101011000111010111000100111000110100110)
                arg1
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10001010110 #b1101101111111100011100100101111100101001010010001001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001010111 #b0110001000111011100100001111000001100000101111001111)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b10011110000 #b0000100110101110111001111001000111100001001101010110)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00100001011 #b0011011001100111000011100010101111000100011110001110)
                expect
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110100)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110100)
                expect
                (fp #b0 #b11001110000 #b1101110110000110100000011010000010110101100010001101)))

(assert (= expect result))

(check-sat)
(exit)
