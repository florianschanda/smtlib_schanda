                arg2
                (fp #b0 #b11110110000 #b1111110001010111101001110111101001000010000000001100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00101100010 #b1101010011001001110111111110100011101011110100011110)
