; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00111110010 #b1100011101110011101101100110001001111001010101110010)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01111011011 #b1111011100101010010111000001011011110001110001000100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00011001010 #b0011110001010101001000010000110011001100110010000100)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01110001001 #b1011101110101001101000100101001001110110010100011111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00011001011 #b0001001110001010011111011111101000111011001001001100)
                expect
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01011011110 #b0110101111000100101001111001011010011100101000111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
