; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -ONE

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11111001101 #b1000001100110110101101000011110000011101001001010000)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00110010010 #b0111101101011000010001011001001001011100100001001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001001000 #b0101101110001010110001101001010110100110110101011001)
                arg2
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10110111101 #b0011010011100010011111100001001010001000001001010011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111010010 #b1100110111111101011001110010001100010110110100100100)
                expect
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00010101111 #b1110111110011001100110011010000010001110011000100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
