                arg2
                (fp #b0 #b11011011111 #b0001100001100111111010011101110010011100101001100111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01010100100 #b0001001101110111100011111101011110000111000111001110)
                expect
