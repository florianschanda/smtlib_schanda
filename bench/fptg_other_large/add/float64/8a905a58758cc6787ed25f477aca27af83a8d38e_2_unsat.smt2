                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101110110 #b0011011011111000000010101111000011100011101011111111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01100111110 #b1000110010001111100001010101110000101100000100000011)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
