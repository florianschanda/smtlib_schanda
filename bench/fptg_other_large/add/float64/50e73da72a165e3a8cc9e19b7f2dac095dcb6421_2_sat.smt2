                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00110110011 #b1011001111000011111001011010001110010001110001110010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100010000 #b0110001111100000000001011011110101010000011111001000)
                expect
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110001)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110001)
                expect
                (fp #b0 #b01001101010 #b1011110000000110010010110010001100000001100110101100)))

(assert (= expect result))

(check-sat)
(exit)
