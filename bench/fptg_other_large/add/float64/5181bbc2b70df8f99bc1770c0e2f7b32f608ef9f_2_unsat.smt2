; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000011001 #b0001010010101100011110110011111111111100010100000011)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b11010110110 #b0110010010100000011111100110101101101110010110000101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0011101001100001001101001111111101001101011011000010)
                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00111000000 #b0011011100110001011110101011000011101100011010001111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0110001000010000111101001000101000011001111101000110)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11101110101 #b1000101010001000101111110000110010001000110101000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
