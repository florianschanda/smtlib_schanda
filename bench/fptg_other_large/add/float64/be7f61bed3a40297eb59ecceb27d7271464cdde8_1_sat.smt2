                arg2
                (fp #b0 #b11111011001 #b0101101011001101101100001010101101110110000111011011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101001000 #b1101010000000010000011010111100100101010000000111111)
                expect
