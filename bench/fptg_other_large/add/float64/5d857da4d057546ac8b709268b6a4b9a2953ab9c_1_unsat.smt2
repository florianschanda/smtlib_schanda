; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10111110001 #b1010001100101010111111010001111000110101100100110110)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01101111111 #b0011111011001011000110100010011110000110011010000110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100110000 #b1110110110110101101110010110011011010110001100000001)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b0 #b00000101101 #b0010011110010101100011001000110011001110111011111101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101011110 #b0010111000101001101001000111111100110000010110110001)
                expect
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                expect
                (fp #b0 #b10001101111 #b1001000011010001000111000010111110101011011000110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
