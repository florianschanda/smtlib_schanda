; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001100100 #b1110111101010111100001101110010101000101111011111100)
                arg1
                (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)))
(assert (fp.leq (fp #b1 #b10100111111 #b1110100111100110100111100010000011010110011100000011)
                arg1
                (fp #b0 #b10010100111 #b1101010100110011111000010000011011011111100100011110)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
