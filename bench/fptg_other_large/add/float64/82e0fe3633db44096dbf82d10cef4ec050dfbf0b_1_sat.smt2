(assert (fp.leq (fp #b0 #b01010100011 #b1001001011011001101001001100010010101100100110010110)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000010110 #b1011001100110110000111001100011001010011001010100001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000000011 #b1001111011010010001001100101010011001010101101010010)
                expect
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010101)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010101)
                expect
                (fp #b0 #b01001010101 #b0111011011111100011010110010010100010101010111000001)))

(assert (= expect result))

(check-sat)
(exit)
