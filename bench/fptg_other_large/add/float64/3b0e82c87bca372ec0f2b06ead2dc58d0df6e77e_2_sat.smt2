(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b0 #b01000001011 #b1010101100011001111001100000100111000100100101100100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101000011 #b1110011000001011101001100001001101001010100111101011)
                expect
