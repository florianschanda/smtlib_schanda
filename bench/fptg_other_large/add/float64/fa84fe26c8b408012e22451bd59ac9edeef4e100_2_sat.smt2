                arg2
                (fp #b0 #b11101000010 #b1110101111010010100101100100011110010001100101111100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10010011100 #b1001000011110100110101110100010100100010011111101110)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
