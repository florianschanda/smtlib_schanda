                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b01111011101 #b1101001011010001100100011100100000010011110100111000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010110110 #b1001111101101100110101100001110111001000110000110100)
                expect
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b00011011110 #b0000001111101011010110001010111100001011000000110100)))

(assert (= expect result))

(check-sat)
(exit)
