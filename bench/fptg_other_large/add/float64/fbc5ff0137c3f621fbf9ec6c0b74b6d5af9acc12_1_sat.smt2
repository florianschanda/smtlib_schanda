(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101011011 #b1111000001011111111111111001101111010111101000101011)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b10010100100 #b0000010011011111010100010011010011000000010100001000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011011000 #b0010101110111010001111110111111100011100010011000001)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                expect
                (fp #b0 #b01101110110 #b1111101011101010100111110100100000000111001110011111)))

(assert (= expect result))

(check-sat)
(exit)
