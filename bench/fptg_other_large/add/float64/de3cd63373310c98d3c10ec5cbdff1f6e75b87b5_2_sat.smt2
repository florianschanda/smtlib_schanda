(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001101111 #b1011101010010110101100011011000001101011001100000101)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b1 #b00001100101 #b0000101111100100101100010110110011000111110011001110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101100001 #b0010101111111101101001001101001010001011110111000101)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00111010000 #b0000000110000001110000001000100111101001001010000000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111011100 #b1011110111110101010101010011110110001111101011011101)
                expect
                (fp #b1 #b10000110100 #b1010001000101000001011000010010110000111001111010000)))
(assert (fp.leq (fp #b1 #b10000110100 #b1010001000101000001011000010010110000111001111010000)
                expect
                (fp #b1 #b01000001000 #b0101110001111110101111011101111011011111000101111110)))

(assert (= expect result))

(check-sat)
(exit)
