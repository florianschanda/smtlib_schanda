(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101111001 #b1111111001001110110111100100111101001100000110110100)
                arg1
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg1
                (fp #b1 #b00011111100 #b0101001100101101111111100011001100000101010100101000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01000000000 #b0010100011001111101110001111010101000110001000011001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
