                arg2
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01011100100 #b1011111010101011000001111100100101100001011011011101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100010000 #b1010000101111110000010001011100111001010100010100110)
                expect
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01010111101 #b1100111010011010001010011010101110001011100101001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
