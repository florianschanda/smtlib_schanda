(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100101100 #b0101001010001100011101001100101010010111001010111011)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01000100010 #b1011000111000101011100011110001011111111011011111001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100110001 #b0001100101011011111011101101000001001101100001010000)
                expect
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11010001110 #b0100100011111110110101000101111101111110001000011010)))

(assert (= expect result))

(check-sat)
(exit)
