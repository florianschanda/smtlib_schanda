; Format: FLOAT64
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110001000 #b1110011110000001000010111111101001110110010010101100)
                arg1
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01110100001 #b0110101001111011010111101101101010100100110100101000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b10000101111 #b1011000010000011011111111110101010110001010010100111)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111101 #b1101011011001101101001100101111110111110100000000101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01001111011 #b0000100001000110111000100101010100111100001111010100)
                expect
                (fp #b0 #b11111111100 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111100 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111111110 #b0011000010100111010110001011011110101100110000101011)))

(assert (= expect result))

(check-sat)
(exit)
