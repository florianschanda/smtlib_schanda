                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11010110011 #b0010100110011000011101111101101110100001000000001010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00011100000 #b0111101101110101111110111011110100100010110101011101)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b0 #b11000100010 #b1101110111010011100111111000100100001100001111010100)))

(assert (= expect result))

(check-sat)
(exit)
