; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01101000010 #b0101110000110001111011110001011000011001010011101101)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b10110001100 #b1000111010001110011011001111110010101010011101101011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110110000 #b0101000011000100010100010001011000001010111011110111)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b01010110010 #b0110011110011010100101001110100001111011110000011101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111011001 #b1010000111010111010011110010101100110110001000110101)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011010111)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011010111)
                expect
                (fp #b0 #b11011101110 #b1111001111101010010110111011110110001111100010010001)))

(assert (= expect result))

(check-sat)
(exit)
