                arg2
                (fp #b0 #b10100100110 #b0100000101000011101101010011010001011110011001110101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00110101111 #b1010000101011010111110110100011100010111000111111011)
                expect
