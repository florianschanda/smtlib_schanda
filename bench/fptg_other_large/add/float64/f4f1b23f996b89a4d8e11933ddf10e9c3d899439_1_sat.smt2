; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000101111 #b0101110110000010010101000110000111001111011000011011)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01101111000 #b0100110000110110011100101010110011101110111111111100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110010000 #b1110111110111111010111011100110011100110111011010100)
                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b11100100010 #b0101011100011110010110110010110000101111000010111010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111110110 #b0110000111111110011001110101101100010111101011000011)
                expect
                (fp #b1 #b00000000000 #b0000010111001010100111000100101110001000011000101111)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000010111001010100111000100101110001000011000101111)
                expect
                (fp #b0 #b01111000010 #b0000011011100111100100111011001100111001001111010001)))

(assert (= expect result))

(check-sat)
(exit)
