; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110110100 #b0101011111011010110011101000111000101110011001111101)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00110011111 #b1100110001010000101010110010011110100000011100010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01110111111 #b0000000010000101011010111011101010011101101110111101)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b10010010010 #b1001000110001100101110011101101011010100111000110011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011110011 #b1000010101001111111101010000100100110000000010100001)
                expect
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11100000000 #b0001000010000011110001101011111101100010100011000100)))

(assert (= expect result))

(check-sat)
(exit)
