; Format: FLOAT64
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101010110 #b1010101000011100101110101110001011011010001010101000)
                arg2
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)
                arg2
                (fp #b0 #b10101010010 #b0111111110001101101010111110100110101111010110000010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
