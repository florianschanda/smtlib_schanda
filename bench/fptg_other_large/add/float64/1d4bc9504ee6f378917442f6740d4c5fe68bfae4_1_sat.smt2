                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10101110111 #b1100001110010111010101010010001011100000110101100101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01001000100 #b1000010110100010001110000011000011110000110110000100)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11010101100 #b1100000111000100000001100000110010111001001111101011)))

(assert (= expect result))

(check-sat)
(exit)
