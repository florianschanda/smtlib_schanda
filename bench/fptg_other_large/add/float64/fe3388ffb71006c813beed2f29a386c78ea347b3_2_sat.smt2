                arg2
                (fp #b0 #b01101010011 #b1100001011101100110101001010000101000100011110000011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100000000 #b1011000101001100010011001000001010000100011111101110)
                expect
