(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001001101 #b0100000101000100110010001000010010101100100110001110)
                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000100111 #b0000110001000110000000110011101100111011001111100010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01100000101 #b1110111000000111011111100001001000110100001000000101)
                expect
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110101)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110101)
                expect
                (fp #b0 #b11010001001 #b1110100011000110011101000111000001010100000010111001)))

(assert (= expect result))

(check-sat)
(exit)
