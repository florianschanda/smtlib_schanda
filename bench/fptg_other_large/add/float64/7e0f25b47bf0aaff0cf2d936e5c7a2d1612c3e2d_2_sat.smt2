; Format: FLOAT64
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111010010 #b1101001101000000001011110100011001100111000001000001)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b00011011010 #b1001100001110001111010001000010011111110110111000111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11000101000 #b1011001011110110000000111111011001010001011110001101)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00101100110 #b0110001110011111100111100010000000111110000100100001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110010000 #b0110101000110101011101101011101011111101100011110000)
                expect
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b00101001011 #b1001000000111001101000100101100110001000101100000000)))

(assert (= expect result))

(check-sat)
(exit)
