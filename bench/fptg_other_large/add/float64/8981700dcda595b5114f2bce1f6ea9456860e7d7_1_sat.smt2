                arg2
                (fp #b0 #b10010111110 #b1011011011011101111001101111001011101100100000000001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00100110101 #b0110011110001001110101001101111101001001001110101111)
                expect
