; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001010111 #b0110101100101101100000111000100010010001110110000001)
                arg1
                (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)))
(assert (fp.leq (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)
                arg1
                (fp #b0 #b11110001100 #b0101000010100101111101111011001101101000000010110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00000010001 #b0001011111111011000110010110101100010010110010011011)
                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11001110110 #b0000011000011010010010110011110000010101101111010100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00101010000 #b1100111100000011110100011000100101011111100100011101)
                expect
                (fp #b0 #b10111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000101011 #b1111011111101010111010100110001110010011000000111110)))

(assert (= expect result))

(check-sat)
(exit)
