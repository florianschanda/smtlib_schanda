;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01001001000 #b1110111100111100110011000010010011100011100001100101)
                arg1
                (fp #b0 #b11100110111 #b0001101001011001100011011000100011001100010101111001)))
(assert (fp.leq (fp #b0 #b11100110111 #b0001101001011001100011011000100011001100010101111001)
                arg1
                (fp #b0 #b11111010001 #b0001010010000111110011111100100000011001001110111011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01001011100 #b1110100001101011000001100000010010100001111110110111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b1 #b10010000101 #b0100011010010011001100101101011001000111110010100111)))

(assert (= expect result))

(check-sat)
(exit)
