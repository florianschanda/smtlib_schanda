; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010000100 #b0101110101101011001011101010100010101010101101001100)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01110101110 #b1001010011101011000101110110011110000101101010101111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101100000 #b0010000010001110011000011101110101010111100000010010)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b01001011001 #b0100000111001111110100011000010111110011101110001101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00101010100 #b1110101000011101100011000000010100010110110111011100)
                expect
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01111001011 #b0111000010100100111100100100001100111111001101110100)))

(assert (= expect result))

(check-sat)
(exit)
