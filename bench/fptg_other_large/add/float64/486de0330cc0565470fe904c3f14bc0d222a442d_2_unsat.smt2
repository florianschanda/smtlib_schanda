                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101000111 #b1010100010110110111101000010101101010101011110011111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011101000 #b1000011100100110110110000001011100100101101110110001)
                expect
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10111001100 #b1000101011001101011001111001011011101100111010011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
