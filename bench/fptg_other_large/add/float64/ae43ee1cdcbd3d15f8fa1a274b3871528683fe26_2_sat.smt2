                arg2
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10010111000 #b1110100101001101110001000110001000001010100010001100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00110001110 #b1111011110111110110100100100011000000011010011100100)
                expect
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11101000000 #b0000101110010010101100011101010111110110100010000000)))

(assert (= expect result))

(check-sat)
