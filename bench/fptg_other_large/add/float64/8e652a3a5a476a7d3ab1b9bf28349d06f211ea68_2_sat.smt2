;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010001101 #b1001000100111110010010101110101011010000011001100101)
                arg1
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                arg1
                (fp #b0 #b10111000000 #b1111110101010000110101010011111001011011000111011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b1100011000010110111110101001001100000110100100011110)
                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11001010100 #b0110110100110101011010101011000011111001111101011010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0100100111001011111000110000101011111110110111110111)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b1 #b00110100110 #b1000111011000110111001000000001001000111111011010001)))

(assert (= expect result))

(check-sat)
(exit)
