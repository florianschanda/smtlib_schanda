; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000101000 #b0101001010111010100110000000000011101011001011011001)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100001010 #b0111010010010101110101101010011111111100111011011011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111010111 #b1101010001000101111001101010010000111001000111010011)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b01011100010 #b0011101000000100010000010001011101101000111101101111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100000100 #b0000000000001011110010110000101010110101101111000011)
                expect
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10010101011 #b1101001000100101111011100001101100100100111001001010)))

(assert (= expect result))

(check-sat)
(exit)
