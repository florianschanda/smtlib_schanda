(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10100111100 #b0010110110001110000011101111001100100100000110111101)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11100110110 #b1010010111111111010111000111100001001110111010101011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110011101 #b1111011001110001000100000110110101000000110101100111)
                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100110011 #b0001110000111001001011111100001111000000111000101100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110110110 #b0111010011010100001011101010100001010000001011100101)
                expect
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11010001100 #b1100000110101111011110110011100000100011010100011100)))

(assert (= expect result))

(check-sat)
(exit)
