(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110010111 #b0010100001100111010111100010110011001100100110000011)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b00111010111 #b1011010101101111100010100111010101010110001101010101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100010001 #b0011000011001111001111101101011101111110111001000000)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110101)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110101)
                expect
                (fp #b0 #b00100001000 #b1001111000110001010111101111101011001101100001000101)))

(assert (= expect result))

(check-sat)
(exit)
