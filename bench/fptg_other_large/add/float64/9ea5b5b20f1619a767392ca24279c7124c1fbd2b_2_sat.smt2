                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11011101010 #b0101011000101011111111111010011101101110110001001000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010000100 #b1001101010101100001010100000011101101101000101111001)
                expect
                (fp #b0 #b10000110100 #b1001111010010101011101111111111001111110011111111011)))
(assert (fp.leq (fp #b0 #b10000110100 #b1001111010010101011101111111111001111110011111111011)
                expect
                (fp #b0 #b11011000000 #b1111000110111111100000000011011101111100100110111010)))

(assert (= expect result))

(check-sat)
(exit)
