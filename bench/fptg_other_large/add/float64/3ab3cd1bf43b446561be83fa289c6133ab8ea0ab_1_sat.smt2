; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00011010110 #b0101000010001110011101011101110000011011110000010001)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10010110111 #b1101100101001101110111000100100110001110010110010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100111100 #b1101001111111100000101101010010101001001111001011101)
                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00001001000 #b0100110111100110001001101111001111101010110001000001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001101000 #b1100101001010111011111011011100111101011000100000001)
                expect
                (fp #b1 #b00111100101 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00111100101 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111110110 #b1011101000101110001101001110001000011011010011111010)))

(assert (= expect result))

(check-sat)
(exit)
