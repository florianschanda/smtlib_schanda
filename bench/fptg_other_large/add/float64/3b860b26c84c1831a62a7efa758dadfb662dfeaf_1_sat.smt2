; Format: FLOAT64
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010100000 #b1001011111010011010011010101001111011001111110110101)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b01100100110 #b1010010100100111111000011011101100111100001000100010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111001110 #b0100111110100000001100001110111010001110101010011101)
                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00110110101 #b0010011001011101110100101000100111010111110010001111)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100000110 #b1111010000010111111100001011001101000010110010011001)
                expect
                (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b01011000100 #b0010010110011111001110111101110010010100011010111010)))

(assert (= expect result))

(check-sat)
(exit)
