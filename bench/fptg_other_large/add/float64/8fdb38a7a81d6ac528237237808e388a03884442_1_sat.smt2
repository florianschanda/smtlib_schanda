(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101001110 #b0010001100101010101001010000110101001101100111001100)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b01111101011 #b1111011001111010000110101001000100100001000010101001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011010011 #b1100010100111110011100000101010011011110001111100010)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b1 #b01101100101 #b0000110110101001111010101111101110001101111110001000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000111100 #b1000101000000111001011101110011111010010011101000011)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110110)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110110)
                expect
                (fp #b1 #b00010100101 #b1000001001101101111111010010110111110110000010010110)))

(assert (= expect result))

(check-sat)
(exit)
