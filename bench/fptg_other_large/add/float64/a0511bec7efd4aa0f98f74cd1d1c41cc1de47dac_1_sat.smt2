(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -INFINITY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111100111 #b1000000000111110010110100101001101101100011100111111)
                arg1
                (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)))
(assert (fp.leq (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)
                arg1
                (fp #b0 #b10000110000 #b1100110011100010001011111000011111011110001011000110)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
