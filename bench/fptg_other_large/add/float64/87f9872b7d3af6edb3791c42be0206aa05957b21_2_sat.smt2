; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101011101 #b0010001000110001100111010100011110111000000111000011)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01011110100 #b1100010000101011001011110100001010101010100010011100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01010111101 #b1111011011100110101110110010110011001001011010001101)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10001111110 #b1111110111100000110001000000000101111110101011111101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01010110001 #b0101001001000100010111011011001001001101101000010001)
                expect
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11011011101 #b0011100110101100001011110100011100100001101100110010)))

(assert (= expect result))

(check-sat)
(exit)
