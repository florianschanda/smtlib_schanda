                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b01111110100 #b1010000111011100011110011011000101100011010010111001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00111011111 #b1100010101000101010000101110100010001100000110100010)
                expect
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111100)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111100)
                expect
                (fp #b0 #b10101001111 #b1101010100110111000011110101000011111001010001101100)))

(assert (= expect result))

(check-sat)
(exit)
