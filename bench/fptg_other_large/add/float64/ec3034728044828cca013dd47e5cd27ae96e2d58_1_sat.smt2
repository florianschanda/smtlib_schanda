(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000011111 #b0100001111101000100001100100011110110000101100000000)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00110000011 #b0010011110110010001000000011101000000111011101011111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01001110101 #b0011001110010110101111000111001001010110011111010101)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11110001110 #b1000010110100110111110010110100001010111000110110011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00100100111 #b0001010111101011100000011000110011011101010101110000)
                expect
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110100)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110100)
                expect
                (fp #b0 #b11111100011 #b0110110010000010110011000010010110101101111111100101)))

(assert (= expect result))

(check-sat)
(exit)
