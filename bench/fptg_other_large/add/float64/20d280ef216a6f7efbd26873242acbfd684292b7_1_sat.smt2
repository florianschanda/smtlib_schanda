; Format: FLOAT64
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111011101 #b1101000100000001111111101111011001001011001011110110)
                arg1
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01100000000 #b1001001101001110010100000001001011111101010011100111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001000010 #b1011101011111100011100011001000001001101001001110011)
                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b1 #b00101000001 #b0011101111110000111101110001110000000001100010010000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010010110 #b1001011101001100100011011101100111110110000110101000)
                expect
                (fp #b1 #b10000000000 #b0110010101001100100100100100101101110000001111100010)))
(assert (fp.leq (fp #b1 #b10000000000 #b0110010101001100100100100100101101110000001111100010)
                expect
                (fp #b0 #b10000010101 #b0101110010101011000111011111101111101110000010000010)))

(assert (= expect result))

(check-sat)
(exit)
