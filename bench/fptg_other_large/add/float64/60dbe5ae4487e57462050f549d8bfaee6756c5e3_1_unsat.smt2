(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10101110110 #b1001001001111100010000000000101101001101011010100000)
                arg2
                (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)))
(assert (fp.leq (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)
                arg2
                (fp #b0 #b11001111110 #b0100100101101101001010011001111110110000101001001100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
