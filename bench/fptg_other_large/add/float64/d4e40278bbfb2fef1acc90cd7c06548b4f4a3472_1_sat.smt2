                arg2
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                arg2
                (fp #b0 #b01011101100 #b1110011001100111111000101100111001101110100010101001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101100011 #b1001110000100001011111101110110000010100110010010101)
                expect
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b1 #b00101110101 #b1101000100110001000111001110010111001001111110111111)))

(assert (= expect result))

(check-sat)
(exit)
