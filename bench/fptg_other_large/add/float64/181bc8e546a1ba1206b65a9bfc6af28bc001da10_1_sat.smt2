; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011101000 #b0111101011010001011000100100111110111010110001101110)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b00010010000 #b1100111101110010010110111110100100111100100001100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01010100111 #b1011100001010011010110111101001111001011000000010000)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100101111 #b0000000000100000100101010110111010111011001000001000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011000110 #b0111111000110111101011110100010111000001001010000110)
                expect
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b10110101101 #b0110111011111101100110010111011100100100111111000001)))

(assert (= expect result))

(check-sat)
(exit)
