; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00100110110 #b0101101010000010000111010010001000110001000011011011)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11111110110 #b1001101110011110101010010001110101110111011111110000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00111111011 #b0101011100101100001101011110000111000111010011010101)
                arg2
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                arg2
                (fp #b0 #b10101110000 #b1100001010010100100001000100011111100011100111100100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001111001 #b0100101101111101101100001111111001100000000111000111)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                expect
                (fp #b0 #b11110111111 #b0100001010000001101000000011001100001000000101101101)))

(assert (= expect result))

(check-sat)
(exit)
