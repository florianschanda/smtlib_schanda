; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10101011010 #b1001001111110011001010000111100111100100001010111011)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01110101010 #b1011001101100000000111001010100011110001101101001111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110000010 #b1110000111001101010100001110100101100010010110000110)
                arg2
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b0 #b11011101011 #b0100101110000001101111000111111111000000111101100100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100000110 #b0100000101100101001001111010110010111000000011100001)
                expect
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                expect
                (fp #b1 #b00001011111 #b1001100011101011010111001100011010110100110101011101)))

(assert (= expect result))

(check-sat)
(exit)
