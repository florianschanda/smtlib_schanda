                arg2
                (fp #b1 #b00000101011 #b0101000001001001011101110001101000011101011101110000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011011100 #b0010000111101100100111011110100111001000101101110001)
                expect
