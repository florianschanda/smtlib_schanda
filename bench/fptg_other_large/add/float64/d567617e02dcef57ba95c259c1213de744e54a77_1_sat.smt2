                arg2
                (fp #b0 #b11011010000 #b0100011111000000001001000011011000111010100010000011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110101001 #b0001011011101000000101010011101000001011110101100111)
                expect
