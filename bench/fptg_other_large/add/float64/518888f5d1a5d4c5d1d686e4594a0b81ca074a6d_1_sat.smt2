; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00100111001 #b0000001110010001010000100101101110100001100100101000)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11101000011 #b0000010001101001100010010011111000101000101010001100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011001110 #b0000000010000111110011000110000100011000000011000001)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b11110110010 #b1001100111010111010100110011001110000001110011001010)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101110000 #b1001010101000101100111010011100010101100001100010011)
                expect
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111110111)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111110111)
                expect
                (fp #b0 #b01001010000 #b1100110111111100100000011110001100011010101101100011)))

(assert (= expect result))

(check-sat)
(exit)
