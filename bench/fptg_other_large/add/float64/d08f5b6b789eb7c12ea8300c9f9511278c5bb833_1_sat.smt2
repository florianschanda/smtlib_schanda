; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11010100011 #b0010001111100111010111011011000100111101011111110011)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11000011001 #b0011110001010001010101101000011101010000100101101011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001001000 #b1101111100010100100001001110100011000001011011110100)
                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b1 #b00010010010 #b0101010010111000001111001011001000111000001110100100)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101100000 #b0110000011111000111100000011100000110111100010001111)
                expect
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                expect
                (fp #b1 #b01111101110 #b0000011101100010000111111101110101100011000111001001)))

(assert (= expect result))

(check-sat)
(exit)
