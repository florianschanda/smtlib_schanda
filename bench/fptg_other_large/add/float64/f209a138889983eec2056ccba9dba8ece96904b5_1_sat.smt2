(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110011100 #b1010001000100010010001111011111101001011101010000000)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b11110010001 #b0111100100001110111110101101010001011101100101001000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010000011 #b0101110000010111011011000101101000000001111101101000)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10010000000 #b0111011100000110011010011100011111101000100011000101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110000001 #b0000000010001101111110010110001000111001111110110011)
                expect
                (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b00010001001 #b1000010000110111010000101111000100101111011001111010)))

(assert (= expect result))

(check-sat)
(exit)
