(assert (fp.leq (fp #b1 #b11111010110 #b0110010111100000010110010001000101000110010011011011)
                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01111100010 #b1110011001000101101111010010011010010101111001100001)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01000011100 #b1110000011001101011111111111101111011110010000100100)
                expect
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)
                expect
                (fp #b0 #b11100101000 #b0001110000011101110011110010010001110110010001101100)))

(assert (= expect result))

(check-sat)
(exit)
