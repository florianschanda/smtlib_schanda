(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001000111 #b1111100110011010101001101111010101111000101011111001)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b10010011010 #b1011101000101010000110011110100010010110011101001101)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000100111 #b1010001011000000100001110100110100101010100101010011)
                expect
                (fp #b1 #b00000000000 #b0101010111011101011010101001101100110101010110010001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0101010111011101011010101001101100110101010110010001)
                expect
                (fp #b0 #b10111010110 #b1010101100100010010110110100110001010010110000110101)))

(assert (= expect result))

(check-sat)
(exit)
