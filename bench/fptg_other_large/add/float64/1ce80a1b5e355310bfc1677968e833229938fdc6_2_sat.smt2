; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00010100100 #b0000000000111111010001101100111001010011110001111101)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11011111110 #b0001101010101000100001100010111010100000111100010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00111000010 #b1110111100000111010100010001100100010101100111110010)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b10001111000 #b0011000101101010011101100000001101010010101101100011)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110011101 #b1100110100011000100001111100101101010000011000111010)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011001)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011001)
                expect
                (fp #b0 #b11101001001 #b1000001111101101110111010011100001001110110000000111)))

(assert (= expect result))

(check-sat)
(exit)
