; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100110110 #b0011110110111111000011101010100100110001001111011000)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b01111111100 #b0110101110100010011011100001010101011010001011100100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00111010100 #b0100100111001111010010101001000011001010010010010100)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b10100111100 #b0110101110001101010111001111011000111111011011111000)))

(declare-const result Float64)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00011010100 #b0100101001010111011111110011100101001001000010000101)
                expect
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001110)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001110)
                expect
                (fp #b0 #b11010101010 #b0101000000011100011111011010100000100111111010011011)))

(assert (= expect result))

(check-sat)
(exit)
