                arg2
                (fp #b0 #b10011110 #b0011110100101010111100000000101)))
(assert (fp.leq (fp #b0 #b10011110 #b0011110100101010111100000000101)
                arg2
                (fp #b0 #b11110010 #b0000000110010111001011011110010)))

(declare-const result (_ FloatingPoint 8 32))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 32))
(assert (fp.leq (fp #b1 #b00111110 #b0001000000001010110011111111011)
                expect
                (fp #b0 #b10011110 #b0011110100101010111100000000100)))
(assert (fp.leq (fp #b0 #b10011110 #b0011110100101010111100000000100)
                expect
                (fp #b0 #b11001000 #b0010101110001010110110111011111)))

(assert (= expect result))

(check-sat)
