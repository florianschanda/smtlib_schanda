(declare-const expect (_ FloatingPoint 11 12))
(assert (fp.leq (fp #b1 #b00001110010 #b00100000110)
                expect
                (fp #b0 #b10111111110 #b11111111110)))
(assert (fp.leq (fp #b0 #b10111111110 #b11111111110)
                expect
                (fp #b0 #b11010010101 #b10001111101)))

(assert (not (= expect result)))

