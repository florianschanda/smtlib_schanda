(assert (fp.leq (fp #b1 #b1010000011 #b11000100100001)
                arg2
                (fp #b1 #b1000110101 #b11001010111000)))

(declare-const result (_ FloatingPoint 10 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 15))
(assert (fp.leq (fp #b1 #b1101100000 #b00010010111010)
                expect
                (fp #b1 #b1010000011 #b11000100100001)))
(assert (fp.leq (fp #b1 #b1010000011 #b11000100100001)
                expect
                (fp #b0 #b0111010010 #b01011101101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
