; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 39))
(assert (fp.leq (fp #b0 #b011000 #b10001110111111001001010100100111101101)
                arg1
                (fp #b0 #b011111 #b01111000011111111111000101010011000010)))
(assert (fp.leq (fp #b0 #b011111 #b01111000011111111111000101010011000010)
                arg1
                (fp #b0 #b101000 #b01110010111111100001001010011011101111)))

(declare-const arg2 (_ FloatingPoint 6 39))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 6 39))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 6 39))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
