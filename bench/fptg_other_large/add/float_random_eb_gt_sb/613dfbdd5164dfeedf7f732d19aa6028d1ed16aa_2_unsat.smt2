(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0000101011101 #b101)
                arg1
                (fp #b0 #b0111111111111 #b111)))
(assert (fp.leq (fp #b0 #b0111111111111 #b111)
                arg1
                (fp #b0 #b1000000010010 #b100)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0010011000001 #b001)
                expect
                (fp #b1 #b0000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000)
                expect
                (fp #b0 #b0001110110111 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
