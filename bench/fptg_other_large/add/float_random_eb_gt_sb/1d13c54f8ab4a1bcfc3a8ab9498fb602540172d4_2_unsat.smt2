;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0101101010 #b110100)
                arg1
                (fp #b1 #b0010100010 #b001101)))
(assert (fp.leq (fp #b1 #b0010100010 #b001101)
                arg1
                (fp #b0 #b0001000111 #b111011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1110111111 #b110000)
                arg2
                (fp #b1 #b1000000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000)
                arg2
                (fp #b0 #b0111011010 #b101000)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1010110110 #b101101)
                expect
                (fp #b1 #b1000000110 #b000001)))
(assert (fp.leq (fp #b1 #b1000000110 #b000001)
                expect
                (fp #b0 #b1010101011 #b000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
