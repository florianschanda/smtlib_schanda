; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b010111000110110 #b011110)
                arg1
                (fp #b1 #b001000000101010 #b100001)))
(assert (fp.leq (fp #b1 #b001000000101010 #b100001)
                arg1
                (fp #b0 #b001001010011110 #b110001)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110001110000000 #b111110)
                expect
                (fp #b0 #b000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000000)
                expect
                (fp #b0 #b000001010110100 #b101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
