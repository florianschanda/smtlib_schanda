(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11110101101110 #b1101)
                arg1
                (fp #b1 #b11101001101111 #b0011)))
(assert (fp.leq (fp #b1 #b11101001101111 #b0011)
                arg1
                (fp #b1 #b10110110011110 #b0100)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001001101111 #b1101)
                expect
                (fp #b1 #b00000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000)
                expect
                (fp #b0 #b00110111001000 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
