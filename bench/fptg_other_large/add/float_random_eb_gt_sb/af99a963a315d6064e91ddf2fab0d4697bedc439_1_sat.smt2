(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0011011110001010 #b00110000111000)
                arg1
                (fp #b0 #b0000101000010100 #b10000100101101)))
(assert (fp.leq (fp #b0 #b0000101000010100 #b10000100101101)
                arg1
                (fp #b0 #b1111010011101101 #b00001100111111)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1000110110001100 #b00010100010100)
                arg2
                (fp #b0 #b0000000000000001 #b00000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b00000000000000)
                arg2
                (fp #b0 #b0100011010110001 #b00101110110001)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0101001110100000 #b11010000100100)
                expect
                (fp #b0 #b0000101000010100 #b10000100101101)))
(assert (fp.leq (fp #b0 #b0000101000010100 #b10000100101101)
                expect
                (fp #b0 #b1111011011011000 #b00100001011101)))

(assert (= expect result))

(check-sat)
(exit)
