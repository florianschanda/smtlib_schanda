(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1000001101 #b10)
                arg1
                (fp #b0 #b0111111111 #b11)))
(assert (fp.leq (fp #b0 #b0111111111 #b11)
                arg1
                (fp #b0 #b1101110111 #b00)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101111101 #b00)
                arg2
                (fp #b0 #b1110000001 #b01)))
(assert (fp.leq (fp #b0 #b1110000001 #b01)
                arg2
                (fp #b0 #b1111011111 #b10)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0111111101 #b01)
                expect
                (fp #b0 #b1110000001 #b10)))
(assert (fp.leq (fp #b0 #b1110000001 #b10)
                expect
                (fp #b0 #b1110100001 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
