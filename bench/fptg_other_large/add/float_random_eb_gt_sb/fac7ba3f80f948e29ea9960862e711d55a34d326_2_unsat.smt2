(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000100001 #b0111)
                arg1
                (fp #b0 #b100000010 #b0000)))
(assert (fp.leq (fp #b0 #b100000010 #b0000)
                arg1
                (fp #b0 #b110100101 #b1001)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100001000 #b0101)
                arg2
                (fp #b0 #b001111110 #b0000)))
(assert (fp.leq (fp #b0 #b001111110 #b0000)
                arg2
                (fp #b0 #b110100110 #b1101)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b010100001 #b0111)
                expect
                (fp #b0 #b100000010 #b0001)))
(assert (fp.leq (fp #b0 #b100000010 #b0001)
                expect
                (fp #b0 #b111010000 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
