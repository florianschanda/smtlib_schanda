; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b000101110010011111 #b0)
                arg1
                (fp #b0 #b100000000000000001 #b0)))
(assert (fp.leq (fp #b0 #b100000000000000001 #b0)
                arg1
                (fp #b0 #b101010001100010111 #b0)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0)
                arg2
                (fp #b1 #b111111111111111110 #b0)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b0)
                arg2
                (fp #b1 #b001011101100000111 #b1)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111110 #b0)
                expect
                (fp #b1 #b111111111111111101 #b1)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b1)
                expect
                (fp #b1 #b000010111111000000 #b0)))

(assert (= expect result))

(check-sat)
(exit)
