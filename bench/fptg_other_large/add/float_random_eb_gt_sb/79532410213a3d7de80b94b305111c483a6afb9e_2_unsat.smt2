;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10011110001111 #b01110)
                arg1
                (fp #b1 #b01111010011101 #b00000)))
(assert (fp.leq (fp #b1 #b01111010011101 #b00000)
                arg1
                (fp #b0 #b00001001000110 #b00101)))

