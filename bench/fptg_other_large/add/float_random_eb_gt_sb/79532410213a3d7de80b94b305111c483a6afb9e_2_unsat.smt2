(assert (fp.leq (fp #b1 #b10110100000011 #b10101)
                arg2
                (fp #b1 #b00111111111101 #b01101)))
(assert (fp.leq (fp #b1 #b00111111111101 #b01101)
                arg2
                (fp #b0 #b01000000100111 #b01100)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10110001000001 #b00110)
                expect
                (fp #b1 #b01111010011101 #b00001)))
(assert (fp.leq (fp #b1 #b01111010011101 #b00001)
                expect
                (fp #b1 #b01100011110000 #b01111)))

(assert (not (= expect result)))

(check-sat)
(exit)
