; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b100101000111111 #b01111110)
                arg1
                (fp #b1 #b011111111111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b00000000)
                arg1
                (fp #b0 #b101001111110111 #b01011000)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b000001011101111 #b01110011)
                arg2
                (fp #b0 #b000000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000001)
                arg2
                (fp #b0 #b001010001010110 #b01101100)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b100110010100110 #b00011110)
                expect
                (fp #b1 #b011111111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b011111111111110 #b11111111)
                expect
                (fp #b0 #b111100100001110 #b00110111)))

(assert (= expect result))

(check-sat)
(exit)
