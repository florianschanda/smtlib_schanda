; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b0100000011000 #b1101)
                arg1
                (fp #b0 #b1000000000010 #b0000)))
(assert (fp.leq (fp #b0 #b1000000000010 #b0000)
                arg1
                (fp #b0 #b1110110000010 #b1101)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1111111111110 #b0111)
                arg2
                (fp #b1 #b1111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b0000)
                arg2
                (fp #b0 #b0111001001101 #b1111)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1111111111110 #b1110)
                expect
                (fp #b1 #b1111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b0000)
                expect
                (fp #b0 #b1010000100111 #b0001)))

(assert (not (= expect result)))

(check-sat)
(exit)
