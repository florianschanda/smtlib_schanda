(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0101010001000 #b001100)
                arg1
                (fp #b0 #b1000000000011 #b011000)))
(assert (fp.leq (fp #b0 #b1000000000011 #b011000)
                arg1
                (fp #b0 #b1000111001011 #b100100)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111100101101 #b010001)
                arg2
                (fp #b0 #b0000000000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b111111)
                arg2
                (fp #b0 #b0101000001011 #b100101)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0110011100010 #b000011)
                expect
                (fp #b0 #b1000000000011 #b011000)))
(assert (fp.leq (fp #b0 #b1000000000011 #b011000)
                expect
                (fp #b0 #b1100000011001 #b011000)))

(assert (= expect result))

(check-sat)
(exit)
