; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b0 #b01000001100001001 #b10110110)
                arg1
                (fp #b0 #b10001011000110010 #b00001010)))
(assert (fp.leq (fp #b0 #b10001011000110010 #b00001010)
                arg1
                (fp #b0 #b10001100011110110 #b01010000)))

(declare-const arg2 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b11000100100100101 #b00111011)
                arg2
                (fp #b0 #b00000000000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00111011)
                arg2
                (fp #b0 #b00011110100101010 #b00011101)))

(declare-const result (_ FloatingPoint 17 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b01110100010010000 #b00010100)
                expect
                (fp #b0 #b10001011000110010 #b00001011)))
(assert (fp.leq (fp #b0 #b10001011000110010 #b00001011)
                expect
                (fp #b0 #b10010010011110111 #b10000110)))

(assert (= expect result))

(check-sat)
(exit)
