; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b0 #b0100011100111 #b00100001)
                arg1
                (fp #b0 #b1011111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1011111111110 #b11111111)
                arg1
                (fp #b0 #b1101100110010 #b00111111)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0001111010001 #b01111011)
                arg2
                (fp #b0 #b0001101101100 #b00000001)))
(assert (fp.leq (fp #b0 #b0001101101100 #b00000001)
                arg2
                (fp #b0 #b1100101001100 #b00010001)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1001101001001 #b11111110)
                expect
                (fp #b0 #b1011111111111 #b00000000)))
(assert (fp.leq (fp #b0 #b1011111111111 #b00000000)
                expect
                (fp #b0 #b1111000100010 #b10100111)))

(assert (= expect result))

(check-sat)
(exit)
