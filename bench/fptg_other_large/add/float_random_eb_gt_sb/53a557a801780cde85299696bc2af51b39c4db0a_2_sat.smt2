(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111101 #b100100)
                arg1
                (fp #b1 #b111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000000)
                arg1
                (fp #b1 #b111000000101100 #b000100)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b010010101001101 #b001001)
                arg2
                (fp #b1 #b010000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b000000)
                arg2
                (fp #b0 #b001001100111110 #b011011)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111101 #b010110)
                expect
                (fp #b1 #b111111111111101 #b000001)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000001)
                expect
                (fp #b0 #b100001111100010 #b111111)))

(assert (= expect result))

(check-sat)
(exit)
