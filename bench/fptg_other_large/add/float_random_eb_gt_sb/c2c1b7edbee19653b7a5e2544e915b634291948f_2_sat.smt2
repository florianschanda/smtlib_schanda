(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111000011110 #b100000)
                arg1
                (fp #b0 #b001111111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111111101 #b000000)
                arg1
                (fp #b0 #b110110010100 #b111000)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100001111111 #b011000)
                arg2
                (fp #b0 #b000000000000 #b010000)))
(assert (fp.leq (fp #b0 #b000000000000 #b010000)
                arg2
                (fp #b0 #b101011011101 #b010010)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101010101110 #b100011)
                expect
                (fp #b0 #b001111111101 #b000001)))
(assert (fp.leq (fp #b0 #b001111111101 #b000001)
                expect
                (fp #b0 #b101111010010 #b110000)))

(assert (= expect result))

(check-sat)
(exit)
