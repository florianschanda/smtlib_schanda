; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1101101001011001 #b010010101001)
                arg1
                (fp #b1 #b1000000000001100 #b000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001100 #b000000000000)
                arg1
                (fp #b0 #b0011010100111101 #b110100010010)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b0010110101011111 #b110110001111)
                arg2
                (fp #b0 #b0000000000000000 #b000011110000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000011110000)
                arg2
                (fp #b0 #b0000000110000011 #b010101101011)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1011000101001101 #b001101101100)
                expect
                (fp #b1 #b1000000000001011 #b111111111111)))
(assert (fp.leq (fp #b1 #b1000000000001011 #b111111111111)
                expect
                (fp #b0 #b0001000011000110 #b010100101011)))

(assert (= expect result))

(check-sat)
(exit)
