; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0101101101 #b000111)
                arg1
                (fp #b0 #b1000000101 #b000111)))
(assert (fp.leq (fp #b0 #b1000000101 #b000111)
                arg1
                (fp #b0 #b1010101000 #b101011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1011010000 #b110010)
                arg2
                (fp #b0 #b1000000101 #b101000)))
(assert (fp.leq (fp #b0 #b1000000101 #b101000)
                arg2
                (fp #b0 #b1010110001 #b001001)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0001111000 #b000000)
                expect
                (fp #b0 #b1000000110 #b010111)))
(assert (fp.leq (fp #b0 #b1000000110 #b010111)
                expect
                (fp #b0 #b1101111111 #b100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
