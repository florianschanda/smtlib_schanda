; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b110001011001100000 #b0101)
                arg1
                (fp #b1 #b010011010000101000 #b1010)))
(assert (fp.leq (fp #b1 #b010011010000101000 #b1010)
                arg1
                (fp #b0 #b100110001010111111 #b1001)))

(declare-const arg2 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b110100000010001111 #b1111)
                arg2
                (fp #b0 #b010000000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b010000000000000000 #b0000)
                arg2
                (fp #b0 #b100110000000100011 #b0110)))

(declare-const result (_ FloatingPoint 18 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b101011011011001111 #b0010)
                expect
                (fp #b1 #b010011010000101000 #b1010)))
(assert (fp.leq (fp #b1 #b010011010000101000 #b1010)
                expect
                (fp #b0 #b110010101100101011 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
