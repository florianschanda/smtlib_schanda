(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11110101010000 #b01100)
                arg1
                (fp #b1 #b11011101001010 #b01100)))
(assert (fp.leq (fp #b1 #b11011101001010 #b01100)
                arg1
                (fp #b0 #b00111111100000 #b11111)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10011000110111 #b10000)
                arg2
                (fp #b0 #b00111111111101 #b01101)))
(assert (fp.leq (fp #b0 #b00111111111101 #b01101)
                arg2
                (fp #b0 #b11010100001010 #b01000)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111000001110 #b10011)
                expect
                (fp #b1 #b11011101001010 #b01100)))
(assert (fp.leq (fp #b1 #b11011101001010 #b01100)
                expect
                (fp #b0 #b01110000000111 #b10110)))

(assert (= expect result))

(check-sat)
(exit)
