(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +NAN

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111011000001111 #b0001100)
                arg1
                (fp #b1 #b111010110110011 #b1001011)))
(assert (fp.leq (fp #b1 #b111010110110011 #b1001011)
                arg1
                (fp #b1 #b110010001111110 #b1111110)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
