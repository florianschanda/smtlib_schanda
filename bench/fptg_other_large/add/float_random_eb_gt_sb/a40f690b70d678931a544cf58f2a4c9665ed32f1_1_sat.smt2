(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101000111 #b0010001)
                arg1
                (fp #b1 #b100000110 #b0110001)))
(assert (fp.leq (fp #b1 #b100000110 #b0110001)
                arg1
                (fp #b1 #b001110001 #b1010001)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010000100 #b1100011)
                arg2
                (fp #b1 #b010000000 #b0000000)))
(assert (fp.leq (fp #b1 #b010000000 #b0000000)
                arg2
                (fp #b0 #b000000110 #b1010111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101110010 #b1100101)
                expect
                (fp #b1 #b100000110 #b0110001)))
(assert (fp.leq (fp #b1 #b100000110 #b0110001)
                expect
                (fp #b0 #b010100010 #b0000100)))

(assert (= expect result))

(check-sat)
(exit)
