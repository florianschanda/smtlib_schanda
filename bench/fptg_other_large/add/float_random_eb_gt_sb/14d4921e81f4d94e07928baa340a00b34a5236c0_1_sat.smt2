(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b0010000111101 #b0)
                arg1
                (fp #b1 #b0000000000000 #b1)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1)
                arg1
                (fp #b0 #b1010100111001 #b0)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1010010000001 #b1)
                arg2
                (fp #b0 #b1000000000000 #b1)))
(assert (fp.leq (fp #b0 #b1000000000000 #b1)
                arg2
                (fp #b0 #b1000011101010 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b0 #b0011001101110 #b0)
                expect
                (fp #b0 #b1000000000000 #b0)))
(assert (fp.leq (fp #b0 #b1000000000000 #b0)
                expect
                (fp #b0 #b1101110010111 #b1)))

(assert (= expect result))

(check-sat)
(exit)
