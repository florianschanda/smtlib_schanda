(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1000011110011 #b1001001)
                arg1
                (fp #b0 #b1111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b0000000)
                arg1
                (fp #b0 #b1111111111110 #b1001100)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b0 #b0101000010100 #b0111000)
                arg2
                (fp #b0 #b1101000100110 #b0001111)))
(assert (fp.leq (fp #b0 #b1101000100110 #b0001111)
                arg2
                (fp #b0 #b1110100010101 #b1100000)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0000010001000 #b0001001)
                expect
                (fp #b0 #b1111111111101 #b0000001)))
(assert (fp.leq (fp #b0 #b1111111111101 #b0000001)
                expect
                (fp #b0 #b1111111111101 #b0101101)))

(assert (= expect result))

(check-sat)
(exit)
