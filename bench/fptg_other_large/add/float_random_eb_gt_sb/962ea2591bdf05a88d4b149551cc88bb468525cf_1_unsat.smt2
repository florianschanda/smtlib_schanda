;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1011001110011 #b1100100)
                arg1
                (fp #b1 #b0111111111111 #b0101111)))
(assert (fp.leq (fp #b1 #b0111111111111 #b0101111)
