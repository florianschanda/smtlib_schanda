                arg2
                (fp #b0 #b1111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b0000000)
                arg2
                (fp #b0 #b1111111111101 #b0111110)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b0 #b0010010101001 #b1000110)
                expect
                (fp #b0 #b1111111111100 #b1111111)))
(assert (fp.leq (fp #b0 #b1111111111100 #b1111111)
                expect
                (fp #b0 #b1111111111110 #b0010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
