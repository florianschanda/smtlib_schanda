(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001010010 #b00101)
                arg1
                (fp #b1 #b0010110100 #b00001)))
(assert (fp.leq (fp #b1 #b0010110100 #b00001)
                arg1
                (fp #b0 #b0101110111 #b11001)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100010110 #b10111)
                arg2
                (fp #b1 #b1011111110 #b11111)))
(assert (fp.leq (fp #b1 #b1011111110 #b11111)
                arg2
                (fp #b1 #b0110001000 #b00101)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111001110 #b10110)
                expect
                (fp #b1 #b1011111111 #b00000)))
(assert (fp.leq (fp #b1 #b1011111111 #b00000)
                expect
                (fp #b0 #b0001101011 #b01011)))

(assert (not (= expect result)))

(check-sat)
(exit)
