(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0000010011 #b11)
                arg1
                (fp #b0 #b1001010100 #b00)))
(assert (fp.leq (fp #b0 #b1001010100 #b00)
                arg1
                (fp #b0 #b1011010001 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111001111 #b11)
                expect
                (fp #b1 #b0000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000 #b00)
                expect
                (fp #b0 #b1010100100 #b11)))

(assert (= expect result))

(check-sat)
(exit)
