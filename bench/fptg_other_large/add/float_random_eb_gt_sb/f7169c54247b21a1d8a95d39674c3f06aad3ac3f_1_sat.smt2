(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0001011110 #b01)
                arg1
                (fp #b0 #b0011111111 #b00)))
(assert (fp.leq (fp #b0 #b0011111111 #b00)
                arg1
                (fp #b0 #b0111011001 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0000111100 #b00)
                arg2
                (fp #b0 #b0000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000 #b10)
                arg2
                (fp #b0 #b1111100010 #b01)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0011101000 #b11)
                expect
                (fp #b0 #b0011111111 #b00)))
(assert (fp.leq (fp #b0 #b0011111111 #b00)
                expect
                (fp #b0 #b1110000100 #b01)))

(assert (= expect result))

(check-sat)
(exit)
