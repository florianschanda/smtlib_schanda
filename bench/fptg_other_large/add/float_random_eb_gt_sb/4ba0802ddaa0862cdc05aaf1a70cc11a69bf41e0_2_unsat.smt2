(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0111010011100110 #b11110111110)
                expect
                (fp #b0 #b0111111111111111 #b00000000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b00000000000)
                expect
                (fp #b0 #b1111101010001011 #b00001000011)))

(assert (not (= expect result)))

(check-sat)
