(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10011000010 #b0010)
                arg1
                (fp #b1 #b10010110111 #b0011)))
(assert (fp.leq (fp #b1 #b10010110111 #b0011)
                arg1
                (fp #b1 #b10001100000 #b0110)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10110000111 #b0110)
                arg2
                (fp #b0 #b10101000111 #b1110)))
(assert (fp.leq (fp #b0 #b10101000111 #b1110)
                arg2
                (fp #b0 #b10111000001 #b0101)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00011101110 #b1001)
                expect
                (fp #b0 #b10101000111 #b1110)))
(assert (fp.leq (fp #b0 #b10101000111 #b1110)
                expect
                (fp #b0 #b11000000111 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
