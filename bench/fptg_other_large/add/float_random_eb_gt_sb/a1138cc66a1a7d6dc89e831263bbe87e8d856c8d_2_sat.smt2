(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01101100011 #b1)
                arg1
                (fp #b0 #b10000000001 #b0)))
(assert (fp.leq (fp #b0 #b10000000001 #b0)
                arg1
                (fp #b0 #b11011101110 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11101111000 #b1)
                arg2
                (fp #b0 #b11111111101 #b0)))
(assert (fp.leq (fp #b0 #b11111111101 #b0)
                arg2
                (fp #b0 #b11111111110 #b1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11000111001 #b1)
                expect
                (fp #b0 #b11111111101 #b1)))
(assert (fp.leq (fp #b0 #b11111111101 #b1)
                expect
                (fp #b0 #b11111111110 #b1)))

(assert (= expect result))

(check-sat)
(exit)
