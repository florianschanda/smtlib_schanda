(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101001101 #b001)
                arg1
                (fp #b0 #b101111110 #b111)))
(assert (fp.leq (fp #b0 #b101111110 #b111)
                arg1
                (fp #b0 #b110000101 #b011)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101110110 #b010)
                arg2
                (fp #b1 #b100000011 #b000)))
(assert (fp.leq (fp #b1 #b100000011 #b000)
                arg2
                (fp #b0 #b000111100 #b011)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110010111 #b011)
                expect
                (fp #b0 #b101111110 #b110)))
(assert (fp.leq (fp #b0 #b101111110 #b110)
                expect
                (fp #b0 #b110010100 #b100)))

(assert (= expect result))

(check-sat)
(exit)
