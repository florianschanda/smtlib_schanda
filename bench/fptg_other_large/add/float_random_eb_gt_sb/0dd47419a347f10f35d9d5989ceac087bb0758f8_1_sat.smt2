; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b00011011100110011 #b0)
                arg1
                (fp #b0 #b11010011011000011 #b1)))
(assert (fp.leq (fp #b0 #b11010011011000011 #b1)
                arg1
                (fp #b0 #b11101001001100011 #b1)))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b00101010110000010 #b0)
                arg2
                (fp #b1 #b00000000000000001 #b0)))
(assert (fp.leq (fp #b1 #b00000000000000001 #b0)
                arg2
                (fp #b0 #b01100111110010010 #b1)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b01110101110011001 #b0)
                expect
                (fp #b0 #b11010011011000011 #b0)))
(assert (fp.leq (fp #b0 #b11010011011000011 #b0)
                expect
                (fp #b0 #b11101010100111110 #b1)))

(assert (= expect result))

(check-sat)
(exit)
