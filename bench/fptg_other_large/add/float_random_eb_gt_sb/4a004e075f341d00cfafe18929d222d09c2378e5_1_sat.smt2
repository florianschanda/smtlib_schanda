                (fp #b0 #b0100000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b0100000000000 #b00000000000)
                arg2
                (fp #b0 #b1100110101111 #b10001111000)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1101011111011 #b00111111010)
                expect
                (fp #b0 #b0011111111111 #b11111111111)))
(assert (fp.leq (fp #b0 #b0011111111111 #b11111111111)
                expect
                (fp #b0 #b1100010111101 #b00111101111)))

(assert (= expect result))

(check-sat)
(exit)
