(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011000000 #b101)
                arg1
                (fp #b1 #b010000000 #b000)))
(assert (fp.leq (fp #b1 #b010000000 #b000)
                arg1
                (fp #b0 #b000000011 #b011)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000000111 #b000)
                arg2
                (fp #b0 #b011111111 #b110)))
(assert (fp.leq (fp #b0 #b011111111 #b110)
                arg2
                (fp #b0 #b110001101 #b101)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111000011 #b011)
                expect
                (fp #b0 #b011111111 #b110)))
(assert (fp.leq (fp #b0 #b011111111 #b110)
                expect
                (fp #b0 #b110001100 #b001)))

(assert (= expect result))

(check-sat)
(exit)
