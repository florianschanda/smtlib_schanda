; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000100110011 #b00110011)
                arg1
                (fp #b0 #b000000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b000000000000 #b01010111)
                arg1
                (fp #b0 #b100100100111 #b01000101)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011100100100 #b11101111)
                arg2
                (fp #b0 #b111110111101 #b10100111)))
(assert (fp.leq (fp #b0 #b111110111101 #b10100111)
                arg2
                (fp #b0 #b111111010001 #b01110010)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111111001001 #b00110100)
                expect
                (fp #b0 #b111110111101 #b10101000)))
(assert (fp.leq (fp #b0 #b111110111101 #b10101000)
                expect
                (fp #b0 #b111111100110 #b11010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
