; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b10111001110010010 #b10001010)
                arg1
                (fp #b1 #b10110111010101000 #b10000100)))
(assert (fp.leq (fp #b1 #b10110111010101000 #b10000100)
                arg1
                (fp #b0 #b10000101111001110 #b10011011)))

(declare-const arg2 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b01011001000111111 #b11011010)
                arg2
                (fp #b0 #b00000000000000001 #b00000000)))
(assert (fp.leq (fp #b0 #b00000000000000001 #b00000000)
                arg2
                (fp #b0 #b10011100110001011 #b01011011)))

(declare-const result (_ FloatingPoint 17 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b11001001111110000 #b00110100)
                expect
                (fp #b1 #b10110111010101000 #b10000011)))
(assert (fp.leq (fp #b1 #b10110111010101000 #b10000011)
                expect
                (fp #b0 #b00010001000000100 #b00111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
