(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b0 #b01000110111111101 #b011)
                arg1
                (fp #b0 #b01111111111111111 #b100)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b100)
                arg1
                (fp #b0 #b10000101101001000 #b101)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11010101011100100 #b010)
                expect
                (fp #b1 #b00000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000)
                expect
                (fp #b0 #b11010000110011110 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
