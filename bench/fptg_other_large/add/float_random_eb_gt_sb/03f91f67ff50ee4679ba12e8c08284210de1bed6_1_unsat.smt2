(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111001011101 #b11101010)
                arg1
                (fp #b1 #b011011001101 #b00000000)))
(assert (fp.leq (fp #b1 #b011011001101 #b00000000)
                arg1
                (fp #b0 #b100010011000 #b01011010)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b100110001000 #b10111011)
                arg2
                (fp #b0 #b111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111)
                arg2
                (fp #b0 #b111111111111 #b00000000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011010000010 #b10011111)
                expect
                (fp #b0 #b111111111110 #b11111110)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111110)
                expect
                (fp #b0 #b111111111111 #b00000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
