; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11000010101 #b01000110)
                arg1
                (fp #b0 #b10000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b10000001000 #b00000000)
                arg1
                (fp #b0 #b11000001001 #b00001010)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01001000111 #b00110000)
                arg2
                (fp #b1 #b00000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000001)
                arg2
                (fp #b0 #b11010100001 #b01001101)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00011111111 #b01010000)
                expect
                (fp #b0 #b10000000111 #b11111111)))
(assert (fp.leq (fp #b0 #b10000000111 #b11111111)
                expect
                (fp #b0 #b10110011000 #b11111001)))

(assert (= expect result))

(check-sat)
(exit)
