                arg2
                (fp #b0 #b01111111111111111 #b000000101)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b000000101)
                arg2
                (fp #b0 #b10000001101000111 #b111110101)))

(declare-const result (_ FloatingPoint 17 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b10011111010101001 #b101100011)
                expect
                (fp #b0 #b01111111111111111 #b000000100)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b000000100)
                expect
                (fp #b0 #b11000111110100011 #b110001110)))

(assert (= expect result))

(check-sat)
(exit)
