(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110100100 #b00010)
                arg1
                (fp #b1 #b011111111 #b10100)))
(assert (fp.leq (fp #b1 #b011111111 #b10100)
                arg1
                (fp #b0 #b011110001 #b00011)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101011100 #b11001)
                arg2
                (fp #b1 #b000000000 #b10110)))
(assert (fp.leq (fp #b1 #b000000000 #b10110)
                arg2
                (fp #b0 #b100011110 #b10010)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100001101 #b00001)
                expect
                (fp #b1 #b011111111 #b10101)))
(assert (fp.leq (fp #b1 #b011111111 #b10101)
                expect
                (fp #b0 #b111101101 #b00011)))

(assert (= expect result))

(check-sat)
(exit)
