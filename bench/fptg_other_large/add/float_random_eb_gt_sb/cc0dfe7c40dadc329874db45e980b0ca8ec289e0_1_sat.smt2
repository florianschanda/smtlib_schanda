(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0100011011 #b00011)
                arg1
                (fp #b0 #b0111111111 #b00111)))
(assert (fp.leq (fp #b0 #b0111111111 #b00111)
                arg1
                (fp #b0 #b1001110010 #b11100)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0101011100 #b11101)
                arg2
                (fp #b1 #b0000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000)
                arg2
                (fp #b0 #b0111100001 #b00101)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0111011010 #b01011)
                expect
                (fp #b0 #b0111111111 #b00111)))
(assert (fp.leq (fp #b0 #b0111111111 #b00111)
                expect
                (fp #b0 #b1100101010 #b11011)))

(assert (= expect result))

(check-sat)
(exit)
