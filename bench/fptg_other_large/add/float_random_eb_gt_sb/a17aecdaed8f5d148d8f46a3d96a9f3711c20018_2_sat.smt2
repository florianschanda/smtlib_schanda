; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1111111001110 #b00010)
                arg1
                (fp #b1 #b1111010100000 #b01000)))
(assert (fp.leq (fp #b1 #b1111010100000 #b01000)
                arg1
                (fp #b1 #b1010100101001 #b01111)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0101100111110 #b01100)
                arg2
                (fp #b1 #b0000000000000 #b11111)))
(assert (fp.leq (fp #b1 #b0000000000000 #b11111)
                arg2
                (fp #b0 #b0100111110100 #b00010)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1111011101000 #b10010)
                expect
                (fp #b1 #b1111010100000 #b01001)))
(assert (fp.leq (fp #b1 #b1111010100000 #b01001)
                expect
                (fp #b0 #b1100111110000 #b10010)))

(assert (= expect result))

(check-sat)
(exit)
