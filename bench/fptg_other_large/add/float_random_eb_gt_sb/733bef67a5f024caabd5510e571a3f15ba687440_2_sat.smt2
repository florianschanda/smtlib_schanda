; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1110001000 #b11110011)
                arg1
                (fp #b1 #b0110011001 #b01001011)))
(assert (fp.leq (fp #b1 #b0110011001 #b01001011)
                arg1
                (fp #b0 #b0000101011 #b10011001)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1100001111 #b11011110)
                arg2
                (fp #b1 #b1000000111 #b11010011)))
(assert (fp.leq (fp #b1 #b1000000111 #b11010011)
                arg2
                (fp #b1 #b0111111010 #b00000100)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001100111 #b11101011)
                expect
                (fp #b1 #b1000000111 #b11010100)))
(assert (fp.leq (fp #b1 #b1000000111 #b11010100)
                expect
                (fp #b0 #b1100001001 #b10001101)))

(assert (= expect result))

(check-sat)
(exit)
