; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b010101101100110001 #b10111)
                arg1
                (fp #b0 #b111111111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b11111)
                arg1
                (fp #b0 #b111111111111111111 #b00000)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b100000010000001101 #b10101)
                arg2
                (fp #b1 #b010000000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b010000000000000000 #b00000)
                arg2
                (fp #b0 #b000111100101110011 #b00001)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b0 #b001010010101110100 #b00000)
                expect
                (fp #b0 #b111111111111111110 #b11110)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b11110)
                expect
                (fp #b0 #b111111111111111111 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
