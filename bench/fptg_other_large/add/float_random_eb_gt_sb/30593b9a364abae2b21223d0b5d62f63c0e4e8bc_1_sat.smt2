(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111011 #b1001000)
                arg1
                (fp #b1 #b101111110 #b1111111)))
(assert (fp.leq (fp #b1 #b101111110 #b1111111)
                arg1
                (fp #b1 #b101001101 #b0010010)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b010101010 #b1100100)
                arg2
                (fp #b0 #b101100111 #b0101001)))
(assert (fp.leq (fp #b0 #b101100111 #b0101001)
                arg2
                (fp #b0 #b101110010 #b0011111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110010010 #b0010111)
                expect
                (fp #b1 #b101111110 #b1111110)))
(assert (fp.leq (fp #b1 #b101111110 #b1111110)
                expect
                (fp #b0 #b001011101 #b0011010)))

(assert (= expect result))

(check-sat)
(exit)
