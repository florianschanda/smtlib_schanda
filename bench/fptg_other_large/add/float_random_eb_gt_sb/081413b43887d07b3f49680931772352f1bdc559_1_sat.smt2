                (fp #b0 #b001111111111001 #b0110101000001)))
(assert (fp.leq (fp #b0 #b001111111111001 #b0110101000001)
                arg2
                (fp #b0 #b100000101101000 #b1110010100101)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b101100111000011 #b0011110001000)
                expect
                (fp #b1 #b001111111111111 #b1111101001010)))
(assert (fp.leq (fp #b1 #b001111111111111 #b1111101001010)
                expect
                (fp #b0 #b100010110101010 #b0111001110111)))

(assert (= expect result))

(check-sat)
(exit)
