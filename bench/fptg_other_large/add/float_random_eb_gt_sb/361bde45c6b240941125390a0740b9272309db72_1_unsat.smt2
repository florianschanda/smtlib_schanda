; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110101011 #b1001111)
                arg1
                (fp #b0 #b110111110 #b0101110)))
(assert (fp.leq (fp #b0 #b110111110 #b0101110)
                arg1
                (fp #b0 #b111000101 #b0110010)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110011110 #b1101010)
                arg2
                (fp #b1 #b010101110 #b0111000)))
(assert (fp.leq (fp #b1 #b010101110 #b0111000)
                arg2
                (fp #b1 #b000011101 #b1101010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b011100101 #b0010111)
                expect
                (fp #b0 #b110111110 #b0101101)))
(assert (fp.leq (fp #b0 #b110111110 #b0101101)
                expect
                (fp #b0 #b111110111 #b0100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
