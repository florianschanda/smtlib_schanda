(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00110010010000 #b111)
                arg1
                (fp #b0 #b00000000000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b110)
                arg1
                (fp #b0 #b00000001101100 #b101)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b00001111000010 #b011)
                arg2
                (fp #b0 #b11111111111101 #b000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b000)
                arg2
                (fp #b0 #b11111111111101 #b100)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b10010001110100 #b110)
                expect
                (fp #b0 #b11111111111101 #b000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b000)
                expect
                (fp #b0 #b11111111111110 #b001)))

(assert (= expect result))

(check-sat)
(exit)
