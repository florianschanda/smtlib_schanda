(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10001000010 #b01)
                arg1
                (fp #b0 #b00000000000 #b11)))
(assert (fp.leq (fp #b0 #b00000000000 #b11)
                arg1
                (fp #b0 #b01101010000 #b00)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11110010100 #b10)
                arg2
                (fp #b1 #b10001001100 #b01)))
(assert (fp.leq (fp #b1 #b10001001100 #b01)
                arg2
                (fp #b1 #b00111010111 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10101101000 #b00)
                expect
                (fp #b1 #b10001001100 #b00)))
(assert (fp.leq (fp #b1 #b10001001100 #b00)
                expect
                (fp #b1 #b00001100000 #b01)))

(assert (= expect result))

(check-sat)
(exit)
