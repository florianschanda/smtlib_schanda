; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0101101110011101 #b1001100)
                arg1
                (fp #b0 #b0100000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b0000000)
                arg1
                (fp #b0 #b1111010000000100 #b0100110)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1011011100000010 #b0101010)
                arg2
                (fp #b1 #b1001101111011001 #b1100110)))
(assert (fp.leq (fp #b1 #b1001101111011001 #b1100110)
                arg2
                (fp #b0 #b0000011011010001 #b0010111)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1011000111110001 #b1011101)
                expect
                (fp #b1 #b1001101111011001 #b1100101)))
(assert (fp.leq (fp #b1 #b1001101111011001 #b1100101)
                expect
                (fp #b1 #b0110011111011111 #b0001001)))

(assert (= expect result))

(check-sat)
(exit)
