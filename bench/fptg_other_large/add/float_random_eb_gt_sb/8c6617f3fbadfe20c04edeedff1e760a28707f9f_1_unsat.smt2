; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110000010 #b100000)
                arg1
                (fp #b1 #b101111110 #b111111)))
(assert (fp.leq (fp #b1 #b101111110 #b111111)
                arg1
                (fp #b1 #b100001101 #b101011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b000101111 #b111100)
                arg2
                (fp #b0 #b011111111 #b000000)))
(assert (fp.leq (fp #b0 #b011111111 #b000000)
                arg2
                (fp #b0 #b100010110 #b001101)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110000100 #b111000)
                expect
                (fp #b1 #b101111110 #b111110)))
(assert (fp.leq (fp #b1 #b101111110 #b111110)
                expect
                (fp #b1 #b001100110 #b111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
