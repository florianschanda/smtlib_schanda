; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1000100001100 #b1101011)
                arg1
                (fp #b0 #b1111000101010 #b0001100)))
(assert (fp.leq (fp #b0 #b1111000101010 #b0001100)
                arg1
                (fp #b0 #b1111001011010 #b1011101)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0001110101000 #b0110101)
                arg2
                (fp #b0 #b1000000000110 #b0000001)))
(assert (fp.leq (fp #b0 #b1000000000110 #b0000001)
                arg2
                (fp #b0 #b1100001100001 #b0000111)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b0 #b0111110111111 #b1010011)
                expect
                (fp #b0 #b1111000101010 #b0001101)))
(assert (fp.leq (fp #b0 #b1111000101010 #b0001101)
                expect
                (fp #b0 #b1111110101000 #b1011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
