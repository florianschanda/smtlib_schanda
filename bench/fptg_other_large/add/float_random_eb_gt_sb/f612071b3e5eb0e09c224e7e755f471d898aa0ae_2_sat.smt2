; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1101010100100100 #b10101011)
                arg1
                (fp #b1 #b1101000001000111 #b00010000)))
(assert (fp.leq (fp #b1 #b1101000001000111 #b00010000)
                arg1
                (fp #b0 #b0100000110111011 #b00011011)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0001011111001101 #b10101111)
                arg2
                (fp #b1 #b0000000000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b00000000)
                arg2
                (fp #b0 #b0100111010011110 #b11000100)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1101110110000000 #b00010101)
                expect
                (fp #b1 #b1101000001000111 #b00010001)))
(assert (fp.leq (fp #b1 #b1101000001000111 #b00010001)
                expect
                (fp #b1 #b0000111101011111 #b01110111)))

(assert (= expect result))

(check-sat)
(exit)
