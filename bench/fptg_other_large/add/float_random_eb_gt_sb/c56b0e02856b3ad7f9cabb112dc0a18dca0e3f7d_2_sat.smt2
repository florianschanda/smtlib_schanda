(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11011101011000 #b1011)
                arg1
                (fp #b1 #b00000000000001 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000001 #b0000)
                arg1
                (fp #b0 #b01101001011010 #b1101)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01010101000010 #b0101)
                arg2
                (fp #b1 #b00111111111110 #b0000)))
(assert (fp.leq (fp #b1 #b00111111111110 #b0000)
                arg2
                (fp #b0 #b01100101010111 #b1100)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10010011100000 #b1000)
                expect
                (fp #b1 #b00111111111110 #b0001)))
(assert (fp.leq (fp #b1 #b00111111111110 #b0001)
                expect
                (fp #b0 #b11000010000110 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
