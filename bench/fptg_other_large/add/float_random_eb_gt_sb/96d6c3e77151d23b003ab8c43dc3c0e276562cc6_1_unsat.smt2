                (fp #b0 #b1000000000001010 #b11000001011)))
(assert (fp.leq (fp #b0 #b1000000000001010 #b11000001011)
                arg1
                (fp #b0 #b1001110101011001 #b00011001010)))

(declare-const arg2 (_ FloatingPoint 16 12))
