                arg2
                (fp #b1 #b1111111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b00000000000)
                arg2
                (fp #b0 #b1001001011010111 #b00101011111)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111111111111110 #b00100001111)
                expect
                (fp #b1 #b1111111111111100 #b11111111111)))
(assert (fp.leq (fp #b1 #b1111111111111100 #b11111111111)
                expect
                (fp #b1 #b0000100110000001 #b00011010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
