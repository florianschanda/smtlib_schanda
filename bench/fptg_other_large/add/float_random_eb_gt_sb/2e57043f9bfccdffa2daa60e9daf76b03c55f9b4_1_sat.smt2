(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111111111111 #b00)
                arg2
                (fp #b1 #b1111111111110 #b11)))
(assert (fp.leq (fp #b1 #b1111111111110 #b11)
                arg2
                (fp #b0 #b0101001010001 #b00)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111111111110 #b11)
                expect
                (fp #b1 #b1111111111110 #b10)))
(assert (fp.leq (fp #b1 #b1111111111110 #b10)
                expect
                (fp #b1 #b1011001000011 #b11)))

(assert (= expect result))

(check-sat)
(exit)
