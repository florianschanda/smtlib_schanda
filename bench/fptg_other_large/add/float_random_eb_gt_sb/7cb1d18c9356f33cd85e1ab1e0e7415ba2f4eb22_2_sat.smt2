; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b11010100111001011 #b10100111010)
                arg1
                (fp #b0 #b00101001111101100 #b00100001000)))
(assert (fp.leq (fp #b0 #b00101001111101100 #b00100001000)
                arg1
                (fp #b0 #b01000001011111111 #b10100011110)))

(declare-const arg2 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b11001111110000100 #b01110001111)
                arg2
                (fp #b1 #b01000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b01000000000000000 #b00000000000)
                arg2
                (fp #b0 #b10111110010011000 #b00000000000)))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b10100001100111001 #b10110010001)
                expect
                (fp #b1 #b01000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b01000000000000000 #b00000000000)
                expect
                (fp #b0 #b01100101010111011 #b11000110001)))

(assert (= expect result))

(check-sat)
(exit)
