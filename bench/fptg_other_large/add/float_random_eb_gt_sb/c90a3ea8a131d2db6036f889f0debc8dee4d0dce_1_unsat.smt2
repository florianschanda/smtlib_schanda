; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0111101100001001 #b0)
                arg1
                (fp #b1 #b0011111111111111 #b1)))
(assert (fp.leq (fp #b1 #b0011111111111111 #b1)
                arg1
                (fp #b0 #b1001100011001000 #b1)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0100111100000000 #b1)
                arg2
                (fp #b0 #b1011010110010010 #b1)))
(assert (fp.leq (fp #b0 #b1011010110010010 #b1)
                arg2
                (fp #b0 #b1111101110100110 #b1)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1010010111111111 #b0)
                expect
                (fp #b0 #b1011010110010010 #b0)))
(assert (fp.leq (fp #b0 #b1011010110010010 #b0)
                expect
                (fp #b0 #b1011111110110011 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
