(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1010100010011000 #b0)
                arg1
                (fp #b1 #b1000000000000000 #b1)))
(assert (fp.leq (fp #b1 #b1000000000000000 #b1)
                arg1
                (fp #b1 #b0111101111101101 #b0)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0011010100000100 #b1)
                arg2
                (fp #b0 #b0100000000000000 #b0)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b0)
                arg2
                (fp #b0 #b1111011100010000 #b1)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1001011001011010 #b1)
                expect
                (fp #b1 #b1000000000000000 #b0)))
(assert (fp.leq (fp #b1 #b1000000000000000 #b0)
                expect
                (fp #b0 #b1011001111000101 #b1)))

(assert (= expect result))

(check-sat)
(exit)
