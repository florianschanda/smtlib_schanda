(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b110000011 #b0)
                arg1
                (fp #b1 #b100100100 #b0)))
(assert (fp.leq (fp #b1 #b100100100 #b0)
                arg1
                (fp #b0 #b111111000 #b1)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b010000001 #b0)
                arg2
                (fp #b0 #b100000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000 #b1)
                arg2
                (fp #b0 #b100101101 #b0)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b101010111 #b0)
                expect
                (fp #b1 #b100100011 #b1)))
(assert (fp.leq (fp #b1 #b100100011 #b1)
                expect
                (fp #b0 #b001010100 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
