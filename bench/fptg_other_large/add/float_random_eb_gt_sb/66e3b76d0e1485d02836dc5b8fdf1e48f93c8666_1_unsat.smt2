                (fp #b0 #b100000000000111 #b01101001)))
(assert (fp.leq (fp #b0 #b100000000000111 #b01101001)
                arg2
                (fp #b0 #b111100010011000 #b01111101)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b000001101100100 #b01011101)
                expect
                (fp #b0 #b100000000000111 #b01101000)))
(assert (fp.leq (fp #b0 #b100000000000111 #b01101000)
                expect
                (fp #b0 #b100110101011000 #b11110001)))

(assert (not (= expect result)))

(check-sat)
