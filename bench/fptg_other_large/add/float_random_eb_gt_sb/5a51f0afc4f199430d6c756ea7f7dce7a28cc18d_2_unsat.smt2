; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111101111010111 #b1110)
                arg1
                (fp #b1 #b000000000000000 #b1111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1111)
                arg1
                (fp #b0 #b100001111001011 #b0110)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b101010101001100 #b1011)
                arg2
                (fp #b0 #b000000000000000 #b1111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1111)
                arg2
                (fp #b0 #b010110100010000 #b0000)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110110111100100 #b0100)
                expect
                (fp #b1 #b000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000)
                expect
                (fp #b0 #b111000100110011 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
