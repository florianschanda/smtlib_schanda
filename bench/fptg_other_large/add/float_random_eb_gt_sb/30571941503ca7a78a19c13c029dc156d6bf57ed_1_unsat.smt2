(assert (fp.leq (fp #b1 #b100000110 #b000000)
                arg2
                (fp #b1 #b011111011 #b001111)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b001010110 #b111010)
                expect
                (fp #b0 #b111011100 #b100100)))
(assert (fp.leq (fp #b0 #b111011100 #b100100)
                expect
                (fp #b0 #b111100010 #b101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
