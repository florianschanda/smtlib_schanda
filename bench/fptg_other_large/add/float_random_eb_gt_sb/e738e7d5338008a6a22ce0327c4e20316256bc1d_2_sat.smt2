(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11000011000 #b11110000)
                arg1
                (fp #b0 #b10000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b10000001000 #b00000000)
                arg1
                (fp #b0 #b10001100011 #b11001111)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01101100111 #b01011010)
                arg2
                (fp #b0 #b11100000100 #b11111000)))
(assert (fp.leq (fp #b0 #b11100000100 #b11111000)
                arg2
                (fp #b0 #b11110001010 #b01110101)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b10000101000 #b11100111)
                expect
                (fp #b0 #b11100000100 #b11111001)))
(assert (fp.leq (fp #b0 #b11100000100 #b11111001)
                expect
                (fp #b0 #b11110000001 #b10101110)))

(assert (= expect result))

(check-sat)
(exit)
