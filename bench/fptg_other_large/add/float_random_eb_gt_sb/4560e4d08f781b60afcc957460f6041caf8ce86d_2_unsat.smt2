(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b101010101100101111 #b0010)
                arg1
                (fp #b1 #b011111111111111111 #b1010)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b1010)
                arg1
                (fp #b0 #b000001000100001000 #b1111)))

(declare-const arg2 (_ FloatingPoint 18 5))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 18 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101000111010011001 #b1110)
                expect
                (fp #b1 #b000000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000)
                expect
                (fp #b0 #b111100010111100010 #b0001)))

(assert (not (= expect result)))

(check-sat)
(exit)
