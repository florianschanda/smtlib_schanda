(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b1000010100 #b10100111)
                arg1
                (fp #b0 #b1010111000 #b11100101)))
(assert (fp.leq (fp #b0 #b1010111000 #b11100101)
                arg1
                (fp #b0 #b1111101010 #b01000001)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111111 #b00000000)
                arg2
                (fp #b1 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111111)
                arg2
                (fp #b1 #b0100111010 #b11001010)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111110 #b11111111)
                expect
                (fp #b1 #b1111111110 #b11111110)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111110)
                expect
                (fp #b1 #b0010001001 #b01000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
