(assert (fp.leq (fp #b0 #b1011101100101101 #b1011111011)
                arg2
                (fp #b0 #b1110000110110011 #b1101001100)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b0 #b0010111011010100 #b0100011000)
                expect
                (fp #b0 #b1011101100101101 #b1011111010)))
(assert (fp.leq (fp #b0 #b1011101100101101 #b1011111010)
                expect
                (fp #b0 #b1111101011101101 #b1000100100)))

(assert (= expect result))

(check-sat)
