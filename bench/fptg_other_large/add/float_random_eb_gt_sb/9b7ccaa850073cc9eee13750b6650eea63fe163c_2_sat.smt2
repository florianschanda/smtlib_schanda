(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b011100111001010100 #b110)
                arg1
                (fp #b1 #b000011010111000111 #b001)))
(assert (fp.leq (fp #b1 #b000011010111000111 #b001)
                arg1
                (fp #b0 #b100011101111001110 #b011)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001110011100010011 #b110)
                expect
                (fp #b1 #b000000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b000)
                expect
                (fp #b0 #b110010011000111001 #b010)))

(assert (= expect result))

(check-sat)
(exit)
