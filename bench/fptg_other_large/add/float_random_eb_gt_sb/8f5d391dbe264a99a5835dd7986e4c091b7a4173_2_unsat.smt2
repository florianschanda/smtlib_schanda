; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111010001010 #b01111)
                arg1
                (fp #b1 #b00000000000000 #b00001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00001)
                arg1
                (fp #b0 #b10101000111101 #b01111)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11010000001101 #b11000)
                arg2
                (fp #b1 #b01010100101010 #b10001)))
(assert (fp.leq (fp #b1 #b01010100101010 #b10001)
                arg2
                (fp #b1 #b00100100000111 #b01101)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10000100100110 #b01000)
                expect
                (fp #b1 #b01010100101010 #b10010)))
(assert (fp.leq (fp #b1 #b01010100101010 #b10010)
                expect
                (fp #b0 #b00100011000001 #b11001)))

(assert (not (= expect result)))

(check-sat)
(exit)
