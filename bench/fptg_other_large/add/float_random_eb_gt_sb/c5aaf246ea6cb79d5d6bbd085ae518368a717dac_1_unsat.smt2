(assert (fp.leq (fp #b1 #b000101000001 #b100110100)
                arg2
                (fp #b0 #b100101101101 #b100000100)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b011111010101 #b010111001)
                expect
                (fp #b0 #b101101011101 #b000111101)))
(assert (fp.leq (fp #b0 #b101101011101 #b000111101)
                expect
                (fp #b0 #b110110101110 #b101011010)))

(assert (not (= expect result)))

(check-sat)
