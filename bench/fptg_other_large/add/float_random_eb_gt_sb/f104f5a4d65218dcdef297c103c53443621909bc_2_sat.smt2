(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b10010100110101111 #b1)
                arg1
                (fp #b1 #b00000000000000001 #b0)))
(assert (fp.leq (fp #b1 #b00000000000000001 #b0)
                arg1
                (fp #b0 #b11100111100000101 #b0)))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b01110001110110101 #b0)
                arg2
                (fp #b1 #b01000000000000000 #b0)))
(assert (fp.leq (fp #b1 #b01000000000000000 #b0)
                arg2
                (fp #b0 #b00011000101111011 #b0)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b11010111010110011 #b0)
                expect
                (fp #b1 #b01000000000000000 #b1)))
(assert (fp.leq (fp #b1 #b01000000000000000 #b1)
                expect
                (fp #b1 #b00000100111111010 #b1)))

(assert (= expect result))

(check-sat)
(exit)
