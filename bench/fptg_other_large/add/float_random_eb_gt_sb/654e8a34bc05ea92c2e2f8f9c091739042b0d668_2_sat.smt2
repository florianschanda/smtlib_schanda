; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b101100100101101 #b10111101100)
                arg1
                (fp #b0 #b111100000010011 #b00010110101)))
(assert (fp.leq (fp #b0 #b111100000010011 #b00010110101)
                arg1
                (fp #b0 #b111101110110001 #b11111010011)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b011110010011101 #b11000100001)
                arg2
                (fp #b0 #b000000000000001 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b00000000000)
                arg2
                (fp #b0 #b110100110101111 #b00101010100)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b001111000110100 #b11100000000)
                expect
                (fp #b0 #b111100000010011 #b00010110110)))
(assert (fp.leq (fp #b0 #b111100000010011 #b00010110110)
                expect
                (fp #b0 #b111100000110110 #b11001010111)))

(assert (= expect result))

(check-sat)
(exit)
