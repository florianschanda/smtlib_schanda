(assert (fp.leq (fp #b0 #b101111111111111110 #b1111)
                arg2
                (fp #b0 #b111000100111011101 #b1100)))

(declare-const result (_ FloatingPoint 18 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b0 #b000101001111100110 #b0100)
                expect
                (fp #b0 #b101111111111111110 #b1110)))
(assert (fp.leq (fp #b0 #b101111111111111110 #b1110)
                expect
                (fp #b0 #b111111111100111011 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
