(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11110001000 #b11)
                arg1
                (fp #b1 #b01111111111 #b01)))
(assert (fp.leq (fp #b1 #b01111111111 #b01)
                arg1
                (fp #b1 #b01011100000 #b00)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01101110011 #b10)
                arg2
                (fp #b1 #b01000000000 #b00)))
(assert (fp.leq (fp #b1 #b01000000000 #b00)
                arg2
                (fp #b0 #b11010010110 #b11)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11110010000 #b00)
                expect
                (fp #b1 #b01111111111 #b10)))
(assert (fp.leq (fp #b1 #b01111111111 #b10)
                expect
                (fp #b0 #b01111011110 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
