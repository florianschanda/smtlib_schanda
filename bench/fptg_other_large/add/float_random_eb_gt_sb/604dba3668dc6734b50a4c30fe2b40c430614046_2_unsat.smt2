; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011000101 #b1101110)
                arg1
                (fp #b1 #b001111100 #b0110101)))
(assert (fp.leq (fp #b1 #b001111100 #b0110101)
                arg1
                (fp #b1 #b001010110 #b0011100)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111010011 #b1100011)
                arg2
                (fp #b1 #b010101110 #b0111000)))
(assert (fp.leq (fp #b1 #b010101110 #b0111000)
                arg2
                (fp #b0 #b001011100 #b0101001)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110001111 #b0101001)
                expect
                (fp #b1 #b010101110 #b0111001)))
(assert (fp.leq (fp #b1 #b010101110 #b0111001)
                expect
                (fp #b0 #b111000001 #b1000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
