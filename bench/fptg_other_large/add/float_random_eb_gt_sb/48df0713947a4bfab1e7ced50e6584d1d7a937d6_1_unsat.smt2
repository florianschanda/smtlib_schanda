(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 13))
(assert (fp.leq (fp #b1 #b110000111110110111 #b011110100011)
                arg1
                (fp #b1 #b010000000100110011 #b110111111110)))
(assert (fp.leq (fp #b1 #b010000000100110011 #b110111111110)
                arg1
