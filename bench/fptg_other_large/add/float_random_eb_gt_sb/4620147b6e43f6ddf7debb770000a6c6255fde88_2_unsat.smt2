(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b100101010101001000 #b0)
                arg1
                (fp #b0 #b100000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000000000000 #b1)
                arg1
                (fp #b0 #b110011111000100101 #b0)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b101101000110100100 #b1)
                arg2
                (fp #b0 #b111101000111010010 #b1)))
(assert (fp.leq (fp #b0 #b111101000111010010 #b1)
                arg2
                (fp #b0 #b111101100010000110 #b1)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b010011110101000110 #b0)
                expect
                (fp #b0 #b111101000111010011 #b0)))
(assert (fp.leq (fp #b0 #b111101000111010011 #b0)
                expect
                (fp #b0 #b111110101010000010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
