; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b10000111001 #b100)
                arg1
                (fp #b0 #b10111111110 #b111)))
(assert (fp.leq (fp #b0 #b10111111110 #b111)
                arg1
                (fp #b0 #b11000001100 #b000)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11100111001 #b100)
                arg2
                (fp #b1 #b00000000001 #b000)))
(assert (fp.leq (fp #b1 #b00000000001 #b000)
                arg2
                (fp #b0 #b01000011101 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10000101110 #b001)
                expect
                (fp #b0 #b10111111110 #b110)))
(assert (fp.leq (fp #b0 #b10111111110 #b110)
                expect
                (fp #b0 #b11010111011 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
