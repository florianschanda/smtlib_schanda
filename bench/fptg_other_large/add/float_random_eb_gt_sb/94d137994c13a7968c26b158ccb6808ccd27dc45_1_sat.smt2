(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b001100110111 #b00101)
                arg1
                (fp #b1 #b000000000000 #b11011)))
(assert (fp.leq (fp #b1 #b000000000000 #b11011)
                arg1
                (fp #b0 #b000011001000 #b00010)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b0 #b001011011111 #b00111)
                arg2
                (fp #b0 #b010000000000 #b00000)))
(assert (fp.leq (fp #b0 #b010000000000 #b00000)
                arg2
                (fp #b0 #b111011111110 #b00010)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b010010011101 #b00000)
                expect
                (fp #b0 #b001111111111 #b11111)))
(assert (fp.leq (fp #b0 #b001111111111 #b11111)
                expect
                (fp #b0 #b100000001011 #b10111)))

(assert (= expect result))

(check-sat)
(exit)
