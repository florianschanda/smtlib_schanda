(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1111000101 #b0010011)
                arg1
                (fp #b1 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000)
                arg1
                (fp #b0 #b0000110110 #b0001011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0100110010 #b0110001)
                arg2
                (fp #b0 #b1011111110 #b1111111)))
(assert (fp.leq (fp #b0 #b1011111110 #b1111111)
                arg2
                (fp #b0 #b1100011110 #b0111100)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110011100 #b1000100)
                expect
                (fp #b0 #b1011111110 #b1111111)))
(assert (fp.leq (fp #b0 #b1011111110 #b1111111)
                expect
                (fp #b0 #b1101100100 #b1000110)))

(assert (= expect result))

(check-sat)
(exit)
