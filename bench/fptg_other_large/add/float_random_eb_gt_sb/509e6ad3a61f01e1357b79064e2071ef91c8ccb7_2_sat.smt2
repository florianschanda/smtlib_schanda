(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0101001101110011 #b0)
                arg1
                (fp #b0 #b0010101100010000 #b0)))
(assert (fp.leq (fp #b0 #b0010101100010000 #b0)
                arg1
                (fp #b0 #b1000000100111101 #b1)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0001011000010001 #b1)
                arg2
                (fp #b0 #b1111111111111101 #b0)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b0)
                arg2
                (fp #b0 #b1111111111111110 #b0)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0001111001011010 #b0)
                expect
                (fp #b0 #b1111111111111101 #b1)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b1)
                expect
                (fp #b0 #b1111111111111111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
