                arg2
                (fp #b0 #b10011000100011010 #b000)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b0 #b01000101000100111 #b011)
                expect
                (fp #b0 #b10010110110000011 #b101)))
(assert (fp.leq (fp #b0 #b10010110110000011 #b101)
                expect
                (fp #b0 #b10011100110110010 #b010)))

(assert (not (= expect result)))

