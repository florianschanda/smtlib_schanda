(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00000101010 #b0101100)
                arg1
                (fp #b0 #b00000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b00000000000 #b1011100)
                arg1
                (fp #b0 #b01001001000 #b1111100)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10110010000 #b0001111)
                arg2
                (fp #b0 #b01011001011 #b0010000)))
(assert (fp.leq (fp #b0 #b01011001011 #b0010000)
                arg2
                (fp #b0 #b10101101111 #b0001100)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11010111000 #b1011110)
                expect
                (fp #b0 #b01011001011 #b0010001)))
(assert (fp.leq (fp #b0 #b01011001011 #b0010001)
                expect
                (fp #b0 #b01011011001 #b1100111)))

(assert (= expect result))

(check-sat)
(exit)
