(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111000100 #b11010)
                arg1
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg1
                (fp #b0 #b101100101 #b10100)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b000110001 #b11101)
                arg2
                (fp #b0 #b100000100 #b00011)))
(assert (fp.leq (fp #b0 #b100000100 #b00011)
                arg2
                (fp #b0 #b111010001 #b01001)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100000 #b00001)
                expect
                (fp #b0 #b100000101 #b10001)))
(assert (fp.leq (fp #b0 #b100000101 #b10001)
                expect
                (fp #b0 #b110011011 #b00011)))

(assert (= expect result))

(check-sat)
(exit)
