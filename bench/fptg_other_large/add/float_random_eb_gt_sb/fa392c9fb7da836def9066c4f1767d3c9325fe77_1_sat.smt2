(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011011111 #b11011)
                arg1
                (fp #b1 #b0000000000 #b11111)))
(assert (fp.leq (fp #b1 #b0000000000 #b11111)
                arg1
                (fp #b0 #b1101000010 #b01001)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0111011111 #b11000)
                arg2
                (fp #b0 #b0011011111 #b10111)))
(assert (fp.leq (fp #b0 #b0011011111 #b10111)
                arg2
                (fp #b0 #b1001100001 #b11001)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0001000101 #b01000)
                expect
                (fp #b0 #b0011011111 #b10110)))
(assert (fp.leq (fp #b0 #b0011011111 #b10110)
                expect
                (fp #b0 #b1100101111 #b10100)))

(assert (= expect result))

(check-sat)
(exit)
