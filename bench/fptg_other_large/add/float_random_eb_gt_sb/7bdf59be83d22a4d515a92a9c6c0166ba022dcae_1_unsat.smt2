(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b00011100010010101 #b101)
                expect
                (fp #b0 #b11111111111111100 #b111)))
(assert (fp.leq (fp #b0 #b11111111111111100 #b111)
                expect
                (fp #b0 #b11111111111111110 #b110)))

(assert (not (= expect result)))

