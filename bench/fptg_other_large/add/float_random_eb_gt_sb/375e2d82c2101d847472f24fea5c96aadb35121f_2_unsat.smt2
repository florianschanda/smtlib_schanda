(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0011011001 #b0)
                arg1
                (fp #b0 #b1000000000 #b1)))
(assert (fp.leq (fp #b0 #b1000000000 #b1)
                arg1
                (fp #b0 #b1101001000 #b0)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101111001 #b0)
                arg2
                (fp #b0 #b0011111111 #b1)))
(assert (fp.leq (fp #b0 #b0011111111 #b1)
                arg2
                (fp #b0 #b0100110111 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0010110001 #b0)
                expect
                (fp #b0 #b1000000001 #b0)))
(assert (fp.leq (fp #b0 #b1000000001 #b0)
                expect
                (fp #b0 #b1100100011 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
