(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1100101101001 #b01011)
                arg1
                (fp #b0 #b0000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00001)
                arg1
                (fp #b0 #b1100110101111 #b11110)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0110011101011 #b01011)
                arg2
                (fp #b0 #b1000000000100 #b00011)))
(assert (fp.leq (fp #b0 #b1000000000100 #b00011)
                arg2
                (fp #b0 #b1101001011110 #b01100)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0000110100100 #b01001)
                expect
                (fp #b0 #b1000000000100 #b00100)))
(assert (fp.leq (fp #b0 #b1000000000100 #b00100)
                expect
                (fp #b0 #b1101111111010 #b01101)))

(assert (= expect result))

(check-sat)
(exit)
