(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0001011000 #b1011)
                arg1
                (fp #b0 #b1000000010 #b0000)))
(assert (fp.leq (fp #b0 #b1000000010 #b0000)
                arg1
                (fp #b0 #b1100111001 #b1101)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0110110001 #b0110)
                arg2
                (fp #b1 #b0010101101 #b0110)))
(assert (fp.leq (fp #b1 #b0010101101 #b0110)
                arg2
                (fp #b0 #b0100110000 #b0110)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0010101000 #b1100)
                expect
                (fp #b0 #b1000000001 #b1111)))
(assert (fp.leq (fp #b0 #b1000000001 #b1111)
                expect
                (fp #b0 #b1111100000 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
