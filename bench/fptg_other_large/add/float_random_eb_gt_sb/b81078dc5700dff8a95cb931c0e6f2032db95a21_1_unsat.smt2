; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000101000101 #b01100011)
                arg1
                (fp #b0 #b011111111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001001)
                arg1
                (fp #b0 #b100111110101 #b01110001)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010111000100 #b00001000)
                arg2
                (fp #b1 #b010000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b00000000)
                arg2
                (fp #b0 #b011111100100 #b00111001)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b010101101010 #b01000101)
                expect
                (fp #b0 #b011111111111 #b11001000)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001000)
                expect
                (fp #b0 #b101110000001 #b11100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
