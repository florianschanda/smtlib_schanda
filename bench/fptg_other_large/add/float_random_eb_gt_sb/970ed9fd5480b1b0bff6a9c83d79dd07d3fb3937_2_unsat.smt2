(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100010100100 #b11100)
                arg1
                (fp #b0 #b010111000100 #b10001)))
(assert (fp.leq (fp #b0 #b010111000100 #b10001)
                arg1
                (fp #b0 #b011111110010 #b11101)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b010000100100 #b00101)
                arg2
                (fp #b0 #b100010000111 #b10000)))
(assert (fp.leq (fp #b0 #b100010000111 #b10000)
                arg2
                (fp #b0 #b101001110100 #b00100)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b110110000110 #b00100)
                expect
                (fp #b0 #b100010000111 #b10001)))
(assert (fp.leq (fp #b0 #b100010000111 #b10001)
                expect
                (fp #b0 #b100011011101 #b01011)))

(assert (not (= expect result)))

(check-sat)
(exit)
