(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0101101110 #b110)
                arg1
                (fp #b0 #b1111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111)
                arg1
                (fp #b0 #b1111111111 #b000)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000100110 #b101)
                arg2
                (fp #b1 #b1000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000011 #b000)
                arg2
                (fp #b1 #b0011111001 #b011)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0001001010 #b001)
                expect
                (fp #b0 #b1111111110 #b110)))
(assert (fp.leq (fp #b0 #b1111111110 #b110)
                expect
                (fp #b0 #b1111111110 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
