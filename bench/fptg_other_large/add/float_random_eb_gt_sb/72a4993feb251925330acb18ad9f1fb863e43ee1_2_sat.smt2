(assert (fp.leq (fp #b1 #b001111001000 #b001010)
                arg2
                (fp #b0 #b101101011011 #b101000)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111111111101 #b101110)
                expect
                (fp #b1 #b111111111101 #b000001)))
(assert (fp.leq (fp #b1 #b111111111101 #b000001)
                expect
                (fp #b1 #b101110011111 #b011111)))

(assert (= expect result))

(check-sat)
(exit)
