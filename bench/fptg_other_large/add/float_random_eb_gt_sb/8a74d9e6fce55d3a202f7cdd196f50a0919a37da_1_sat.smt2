; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b011111101011011010 #b0110000000)
                arg1
                (fp #b0 #b001010011111000011 #b0100001000)))
(assert (fp.leq (fp #b0 #b001010011111000011 #b0100001000)
                arg1
                (fp #b0 #b010001101000011011 #b0101011110)))

(declare-const arg2 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b101011110100101010 #b0100001000)
                arg2
                (fp #b1 #b100000000000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b100000000000001010 #b0000000000)
                arg2
                (fp #b1 #b001110101101000001 #b0101111000)))

(declare-const result (_ FloatingPoint 18 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b110001100011100000 #b0100010001)
                expect
                (fp #b1 #b100000000000001001 #b1111111111)))
(assert (fp.leq (fp #b1 #b100000000000001001 #b1111111111)
                expect
                (fp #b0 #b000101010101100000 #b0010000110)))

(assert (= expect result))

(check-sat)
(exit)
