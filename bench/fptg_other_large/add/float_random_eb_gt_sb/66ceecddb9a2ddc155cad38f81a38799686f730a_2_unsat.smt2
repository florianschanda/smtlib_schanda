; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000000101 #b000)
                arg1
                (fp #b0 #b0000000000 #b111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111)
                arg1
                (fp #b0 #b1000101001 #b101)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0101011111 #b000)
                arg2
                (fp #b0 #b1000000001 #b000)))
(assert (fp.leq (fp #b0 #b1000000001 #b000)
                arg2
                (fp #b0 #b1101010110 #b001)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0110001111 #b100)
                expect
                (fp #b0 #b1000000001 #b001)))
(assert (fp.leq (fp #b0 #b1000000001 #b001)
                expect
                (fp #b0 #b1110111010 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
