; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1101111101110 #b0)
                arg1
                (fp #b0 #b0011111111111 #b1)))
(assert (fp.leq (fp #b0 #b0011111111111 #b1)
                arg1
                (fp #b0 #b1100101000100 #b0)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1010111111100 #b1)
                arg2
                (fp #b0 #b0000000000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0)
                arg2
                (fp #b0 #b1011001000101 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111100011111 #b1)
                expect
                (fp #b0 #b0011111111111 #b1)))
(assert (fp.leq (fp #b0 #b0011111111111 #b1)
                expect
                (fp #b0 #b1001010000001 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
