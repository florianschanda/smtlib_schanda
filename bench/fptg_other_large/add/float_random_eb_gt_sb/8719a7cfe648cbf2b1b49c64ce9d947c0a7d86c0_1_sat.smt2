; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11011110100 #b01000110)
                arg1
                (fp #b1 #b00111111100 #b00000000)))
(assert (fp.leq (fp #b1 #b00111111100 #b00000000)
                arg1
                (fp #b0 #b01010010011 #b10111111)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b01101000010 #b10101011)
                arg2
                (fp #b0 #b10000000111 #b01000010)))
(assert (fp.leq (fp #b0 #b10000000111 #b01000010)
                arg2
                (fp #b0 #b10100100001 #b01010100)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01000111000 #b00110010)
                expect
                (fp #b0 #b10000000111 #b01000001)))
(assert (fp.leq (fp #b0 #b10000000111 #b01000001)
                expect
                (fp #b0 #b10101110110 #b11111011)))

(assert (= expect result))

(check-sat)
(exit)
