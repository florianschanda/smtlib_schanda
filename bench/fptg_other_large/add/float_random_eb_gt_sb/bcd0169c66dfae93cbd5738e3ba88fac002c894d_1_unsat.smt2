; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1001100111101 #b01)
                arg1
                (fp #b1 #b0111111111111 #b01)))
(assert (fp.leq (fp #b1 #b0111111111111 #b01)
                arg1
                (fp #b1 #b0000100001010 #b10)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0000111110101 #b00)
                arg2
                (fp #b0 #b0000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00)
                arg2
                (fp #b0 #b1010010100110 #b01)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1000110010001 #b10)
                expect
                (fp #b1 #b0111111111111 #b01)))
(assert (fp.leq (fp #b1 #b0111111111111 #b01)
                expect
                (fp #b0 #b0100111101001 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
