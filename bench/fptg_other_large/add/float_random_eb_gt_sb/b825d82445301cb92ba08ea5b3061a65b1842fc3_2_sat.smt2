(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1101001101111011 #b11101010)
                arg1
                (fp #b1 #b1001011110111110 #b11110101)))
(assert (fp.leq (fp #b1 #b1001011110111110 #b11110101)
                arg1
                (fp #b0 #b1000000101010011 #b11100001)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0100110110011101 #b00010001)
                arg2
                (fp #b0 #b0000000000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b11111111)
                arg2
                (fp #b0 #b1110101111100101 #b01010010)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1101000101011110 #b01101101)
                expect
                (fp #b1 #b1001011110111110 #b11110101)))
(assert (fp.leq (fp #b1 #b1001011110111110 #b11110101)
                expect
                (fp #b1 #b0100011000000100 #b11011011)))

(assert (= expect result))

(check-sat)
(exit)
