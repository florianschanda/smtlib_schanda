(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110101100001 #b0110)
                arg1
                (fp #b1 #b100000000001 #b1000)))
(assert (fp.leq (fp #b1 #b100000000001 #b1000)
                arg1
                (fp #b0 #b111011011101 #b1001)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011110110110 #b1001)
                arg2
                (fp #b0 #b000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b000000000000 #b0001)
                arg2
                (fp #b0 #b001001011110 #b0110)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100001110011 #b1110)
                expect
                (fp #b1 #b100000000001 #b0111)))
(assert (fp.leq (fp #b1 #b100000000001 #b0111)
                expect
                (fp #b0 #b111010000101 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
