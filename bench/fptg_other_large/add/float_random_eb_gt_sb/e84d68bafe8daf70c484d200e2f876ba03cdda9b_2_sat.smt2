(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b001111001101 #b011)
                arg1
                (fp #b0 #b100000111110 #b101)))
(assert (fp.leq (fp #b0 #b100000111110 #b101)
                arg1
                (fp #b0 #b111010001000 #b011)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010110001010 #b000)
                arg2
                (fp #b0 #b111111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111111101 #b000)
                arg2
                (fp #b0 #b111111111110 #b011)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b100000111110 #b001)
                expect
                (fp #b0 #b111111111101 #b001)))
(assert (fp.leq (fp #b0 #b111111111101 #b001)
                expect
                (fp #b0 #b111111111110 #b111)))

(assert (= expect result))

(check-sat)
(exit)
