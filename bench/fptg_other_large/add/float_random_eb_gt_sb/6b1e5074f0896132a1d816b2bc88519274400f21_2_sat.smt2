(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b0 #b101110100100 #b11011)
                arg1
                (fp #b0 #b111011101000 #b01001)))
(assert (fp.leq (fp #b0 #b111011101000 #b01001)
                arg1
                (fp #b0 #b111111111000 #b00111)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111011010011 #b10110)
                arg2
                (fp #b0 #b000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000000000 #b01000)
                arg2
                (fp #b0 #b000010010000 #b01011)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b000011111010 #b00111)
                expect
                (fp #b0 #b111011101000 #b01010)))
(assert (fp.leq (fp #b0 #b111011101000 #b01010)
                expect
                (fp #b0 #b111111111010 #b01100)))

(assert (= expect result))

(check-sat)
(exit)
