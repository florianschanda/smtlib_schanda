(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101000101 #b1)
                arg1
                (fp #b1 #b0000000000 #b1)))
(assert (fp.leq (fp #b1 #b0000000000 #b1)
                arg1
                (fp #b0 #b1111101110 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0001001001 #b1)
                arg2
                (fp #b0 #b0111111111 #b1)))
(assert (fp.leq (fp #b0 #b0111111111 #b1)
                arg2
                (fp #b0 #b1011101001 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0010101111 #b0)
                expect
                (fp #b0 #b0111111111 #b0)))
(assert (fp.leq (fp #b0 #b0111111111 #b0)
                expect
                (fp #b0 #b1010010111 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
