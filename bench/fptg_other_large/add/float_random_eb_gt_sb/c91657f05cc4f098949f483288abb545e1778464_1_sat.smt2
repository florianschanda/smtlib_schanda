(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b011111111111000 #b1101100)
                arg1
                (fp #b1 #b010000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b0000000)
                arg1
                (fp #b1 #b000001001000001 #b1101100)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101100010011001 #b0110001)
                arg2
                (fp #b0 #b000000000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b0000000)
                arg2
                (fp #b0 #b101011111101001 #b0001010)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101000100101101 #b1101100)
                expect
                (fp #b1 #b001111111111111 #b1111111)))
(assert (fp.leq (fp #b1 #b001111111111111 #b1111111)
                expect
                (fp #b1 #b000110111111101 #b0011010)))

(assert (= expect result))

(check-sat)
(exit)
