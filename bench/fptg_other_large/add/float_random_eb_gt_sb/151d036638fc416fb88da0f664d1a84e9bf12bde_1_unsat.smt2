; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0101100010110 #b011)
                arg1
                (fp #b1 #b0000000000001 #b000)))
(assert (fp.leq (fp #b1 #b0000000000001 #b000)
                arg1
                (fp #b0 #b0110011011100 #b101)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b1110110011100 #b110)
                arg2
                (fp #b0 #b1111111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111)
                arg2
                (fp #b0 #b1111111111111 #b000)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b1000011000011 #b111)
                expect
                (fp #b0 #b1111111111110 #b110)))
(assert (fp.leq (fp #b0 #b1111111111110 #b110)
                expect
                (fp #b0 #b1111111111111 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
