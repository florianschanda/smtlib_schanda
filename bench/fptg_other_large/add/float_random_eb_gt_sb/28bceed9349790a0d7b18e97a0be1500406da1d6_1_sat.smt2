                arg2
                (fp #b1 #b000101000001 #b100110100)))
(assert (fp.leq (fp #b1 #b000101000001 #b100110100)
                arg2
                (fp #b0 #b110101001111 #b011101011)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b011010010111 #b111100110)
                expect
                (fp #b1 #b000101000001 #b100110011)))
(assert (fp.leq (fp #b1 #b000101000001 #b100110011)
                expect
                (fp #b0 #b110110000010 #b011100100)))

(assert (= expect result))

(check-sat)
(exit)
