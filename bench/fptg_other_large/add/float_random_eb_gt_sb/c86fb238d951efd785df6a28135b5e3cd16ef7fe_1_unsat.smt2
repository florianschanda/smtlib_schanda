(assert (fp.leq (fp #b1 #b001111111111111101 #b01101)
                arg2
                (fp #b0 #b010011010001000100 #b11111)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b101101010100101110 #b11110)
                expect
                (fp #b1 #b100000000000000100 #b10101)))
(assert (fp.leq (fp #b1 #b100000000000000100 #b10101)
                expect
                (fp #b0 #b010110000101011110 #b00001)))

(assert (not (= expect result)))

