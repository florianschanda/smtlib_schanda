(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b000011001111 #b1011101011)
                arg1
                (fp #b0 #b001101000001 #b1001000000)))
(assert (fp.leq (fp #b0 #b001101000001 #b1001000000)
                arg1
                (fp #b0 #b010101000101 #b0101111000)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100110001100 #b0111101111)
                arg2
                (fp #b1 #b011111111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b011111111111 #b0011111110)
                arg2
                (fp #b0 #b100010001100 #b0010011111)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101110101001 #b0101000000)
                expect
                (fp #b1 #b011111111111 #b0011111101)))
(assert (fp.leq (fp #b1 #b011111111111 #b0011111101)
                expect
                (fp #b0 #b101111100100 #b1100011001)))

(assert (= expect result))

(check-sat)
(exit)
