; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111001011101110 #b01)
                arg1
                (fp #b1 #b110011010101010 #b01)))
(assert (fp.leq (fp #b1 #b110011010101010 #b01)
                arg1
                (fp #b1 #b101100111011111 #b00)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b110100101110100 #b10)
                arg2
                (fp #b1 #b101111111000010 #b01)))
(assert (fp.leq (fp #b1 #b101111111000010 #b01)
                arg2
                (fp #b1 #b000000100110110 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111011001001101 #b00)
                expect
                (fp #b1 #b110011010101010 #b10)))
(assert (fp.leq (fp #b1 #b110011010101010 #b10)
                expect
                (fp #b0 #b111001011111011 #b11)))

(assert (= expect result))

(check-sat)
(exit)
