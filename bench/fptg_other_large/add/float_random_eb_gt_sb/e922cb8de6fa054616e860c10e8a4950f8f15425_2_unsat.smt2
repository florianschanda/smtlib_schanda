(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001111101 #b1100)
                arg1
                (fp #b0 #b0111111111 #b0110)))
(assert (fp.leq (fp #b0 #b0111111111 #b0110)
                arg1
                (fp #b0 #b1001011111 #b0011)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1010000011 #b0010)
                arg2
                (fp #b0 #b1000000011 #b0001)))
(assert (fp.leq (fp #b0 #b1000000011 #b0001)
                arg2
                (fp #b0 #b1011111101 #b1011)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110100000 #b0011)
                expect
                (fp #b0 #b1000000011 #b0011)))
(assert (fp.leq (fp #b0 #b1000000011 #b0011)
                expect
                (fp #b0 #b1010111111 #b1110)))

(assert (not (= expect result)))

(check-sat)
(exit)
