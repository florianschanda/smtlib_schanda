(assert (fp.leq (fp #b1 #b10111111111111110 #b11111)
                arg2
                (fp #b1 #b00001010100001001 #b10011)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11000100111000110 #b10110)
                expect
                (fp #b1 #b10111111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b10111111111111110 #b11111)
                expect
                (fp #b0 #b11010110010010001 #b00001)))

(assert (= expect result))

