(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110111001 #b11010)
                arg1
                (fp #b1 #b0111111111 #b10110)))
(assert (fp.leq (fp #b1 #b0111111111 #b10110)
                arg1
                (fp #b0 #b1111010101 #b00010)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111101 #b00111)
                arg2
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                arg2
                (fp #b1 #b1100000101 #b10000)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111101 #b01101)
                expect
                (fp #b1 #b1111111101 #b00001)))
(assert (fp.leq (fp #b1 #b1111111101 #b00001)
                expect
                (fp #b0 #b1001101001 #b01100)))

(assert (= expect result))

(check-sat)
(exit)
