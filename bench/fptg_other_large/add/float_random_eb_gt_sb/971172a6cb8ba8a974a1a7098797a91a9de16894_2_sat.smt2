(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1110000010111000 #b1)
                arg1
                (fp #b1 #b1011111111111110 #b1)))
(assert (fp.leq (fp #b1 #b1011111111111110 #b1)
                arg1
                (fp #b0 #b0011101111010001 #b0)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111111111000000 #b1)
                arg2
                (fp #b1 #b0100000000000000 #b0)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0)
                arg2
                (fp #b0 #b0001100011001010 #b1)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1101101111011000 #b1)
                expect
                (fp #b1 #b1011111111111111 #b0)))
(assert (fp.leq (fp #b1 #b1011111111111111 #b0)
                expect
                (fp #b1 #b0010100110001110 #b0)))

(assert (= expect result))

(check-sat)
(exit)
