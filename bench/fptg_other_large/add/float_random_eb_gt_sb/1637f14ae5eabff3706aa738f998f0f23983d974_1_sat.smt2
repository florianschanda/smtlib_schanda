                (fp #b0 #b1101000110011111 #b01100010)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1101100111100011 #b10001110)
                arg2
                (fp #b1 #b0111111111111111 #b00000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b00000000)
                arg2
                (fp #b1 #b0010010001010001 #b10010000)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0010100100110100 #b00000001)
                expect
                (fp #b0 #b1000000000000010 #b00000000)))
(assert (fp.leq (fp #b0 #b1000000000000010 #b00000000)
                expect
                (fp #b0 #b1111110100001110 #b10101100)))

(assert (= expect result))

(check-sat)
(exit)
