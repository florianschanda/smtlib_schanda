                (fp #b0 #b00000000000000 #b1100000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1100000)
                arg2
                (fp #b0 #b01111011100001 #b0001011)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10001000000100 #b0101101)
                expect
                (fp #b0 #b10000000000101 #b0101101)))
(assert (fp.leq (fp #b0 #b10000000000101 #b0101101)
                expect
                (fp #b0 #b10001100100011 #b0100011)))

(assert (= expect result))

(check-sat)
