(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0111010110 #b10100101)
                arg1
                (fp #b0 #b0000000001 #b00000000)))
(assert (fp.leq (fp #b0 #b0000000001 #b00000000)
                arg1
                (fp #b0 #b0111001110 #b00000000)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101011101 #b00010101)
                arg2
                (fp #b0 #b1000000111 #b01101001)))
(assert (fp.leq (fp #b0 #b1000000111 #b01101001)
                arg2
                (fp #b0 #b1001000101 #b00110001)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000011000 #b01111110)
                expect
                (fp #b0 #b1000000111 #b01101010)))
(assert (fp.leq (fp #b0 #b1000000111 #b01101010)
                expect
                (fp #b0 #b1111010010 #b11011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
