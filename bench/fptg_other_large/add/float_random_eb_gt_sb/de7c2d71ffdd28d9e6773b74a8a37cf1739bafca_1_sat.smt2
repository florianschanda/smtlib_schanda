(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10101101010 #b000011)
                arg1
                (fp #b1 #b10000000101 #b110111)))
(assert (fp.leq (fp #b1 #b10000000101 #b110111)
                arg1
                (fp #b0 #b01000011001 #b101100)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b10110001111 #b101011)
                arg2
                (fp #b0 #b11111111110 #b111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111111)
                arg2
                (fp #b0 #b11111111111 #b000000)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b00001000100 #b101001)
                expect
                (fp #b0 #b11111111110 #b111110)))
(assert (fp.leq (fp #b0 #b11111111110 #b111110)
                expect
                (fp #b0 #b11111111110 #b111111)))

(assert (= expect result))

(check-sat)
(exit)
