                (fp #b1 #b0111111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b0111111111111 #b0000000000)
                arg2
                (fp #b0 #b0101111000100 #b1100011110)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1101001011111 #b0101001110)
                expect
                (fp #b1 #b0111111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b0111111111110 #b1111111111)
                expect
                (fp #b0 #b1110000011100 #b0111110001)))

(assert (= expect result))

(check-sat)
(exit)
