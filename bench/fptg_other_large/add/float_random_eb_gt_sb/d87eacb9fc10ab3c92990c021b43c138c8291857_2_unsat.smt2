; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110000110 #b011)
                arg1
                (fp #b1 #b101111110 #b111)))
(assert (fp.leq (fp #b1 #b101111110 #b111)
                arg1
                (fp #b1 #b101010100 #b101)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111100110 #b001)
                arg2
                (fp #b1 #b010110110 #b011)))
(assert (fp.leq (fp #b1 #b010110110 #b011)
                arg2
                (fp #b0 #b110111000 #b111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111010000 #b010)
                expect
                (fp #b1 #b101111111 #b000)))
(assert (fp.leq (fp #b1 #b101111111 #b000)
                expect
                (fp #b0 #b001010100 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
