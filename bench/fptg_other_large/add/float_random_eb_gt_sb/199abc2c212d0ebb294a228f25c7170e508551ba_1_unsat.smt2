(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11010010110100 #b111)
                arg1
                (fp #b1 #b10110001111111 #b000)))
(assert (fp.leq (fp #b1 #b10110001111111 #b000)
                arg1
                (fp #b0 #b01010000001100 #b100)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b10010100000001 #b100)
                arg2
                (fp #b0 #b11111111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111)
                arg2
                (fp #b0 #b11111111111111 #b000)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b00100110101010 #b111)
                expect
                (fp #b0 #b11111111111110 #b110)))
(assert (fp.leq (fp #b0 #b11111111111110 #b110)
                expect
                (fp #b0 #b11111111111111 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
