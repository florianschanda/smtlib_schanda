(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                arg1
                (fp #b1 #b111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111)
                arg1
                (fp #b0 #b111111001 #b10000)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100101111 #b01000)
                arg2
                (fp #b1 #b000000001 #b00000)))
(assert (fp.leq (fp #b1 #b000000001 #b00000)
                arg2
                (fp #b0 #b010010001 #b11010)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
