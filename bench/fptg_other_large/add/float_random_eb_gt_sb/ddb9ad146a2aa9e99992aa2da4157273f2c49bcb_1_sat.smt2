; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b00111000000010111 #b01011)
                arg1
                (fp #b1 #b00000000000000000 #b00111)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00111)
                arg1
                (fp #b0 #b11011001101111011 #b11001)))

(declare-const arg2 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b0 #b00001111000100110 #b00001)
                arg2
                (fp #b0 #b01000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b01000000000000000 #b00000)
                arg2
                (fp #b0 #b01010101000000000 #b10011)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11011001000111101 #b10001)
                expect
                (fp #b0 #b00111111111111111 #b11111)))
(assert (fp.leq (fp #b0 #b00111111111111111 #b11111)
                expect
                (fp #b0 #b10010001100011000 #b01100)))

(assert (= expect result))

(check-sat)
(exit)
