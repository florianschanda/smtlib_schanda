; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b011100001100 #b111101)
                arg1
                (fp #b0 #b111011011010 #b001101)))
(assert (fp.leq (fp #b0 #b111011011010 #b001101)
                arg1
                (fp #b0 #b111100001100 #b010111)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b001001111001 #b110011)
                arg2
                (fp #b0 #b011111111111 #b000110)))
(assert (fp.leq (fp #b0 #b011111111111 #b000110)
                arg2
                (fp #b0 #b111100011000 #b111100)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100000010111 #b001101)
                expect
                (fp #b0 #b111011011010 #b001110)))
(assert (fp.leq (fp #b0 #b111011011010 #b001110)
                expect
                (fp #b0 #b111100010111 #b101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
