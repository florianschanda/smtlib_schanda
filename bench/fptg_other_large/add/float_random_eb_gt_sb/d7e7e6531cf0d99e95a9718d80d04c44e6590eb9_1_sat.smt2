(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b100101001 #b11)
                arg1
                (fp #b0 #b101111110 #b11)))
(assert (fp.leq (fp #b0 #b101111110 #b11)
                arg1
                (fp #b0 #b110101110 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101000010 #b01)
                arg2
                (fp #b1 #b011111111 #b00)))
(assert (fp.leq (fp #b1 #b011111111 #b00)
                arg2
                (fp #b1 #b010101010 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100010100 #b11)
                expect
                (fp #b0 #b101111110 #b10)))
(assert (fp.leq (fp #b0 #b101111110 #b10)
                expect
                (fp #b0 #b110110111 #b01)))

(assert (= expect result))

(check-sat)
(exit)
