(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b1010011010 #b101)
                arg1
                (fp #b0 #b1100000011 #b000)))
(assert (fp.leq (fp #b0 #b1100000011 #b000)
                arg1
                (fp #b0 #b1100100111 #b011)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0101111110 #b011)
                arg2
                (fp #b0 #b0111111111 #b000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000)
                arg2
                (fp #b0 #b1010001100 #b001)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0101100100 #b111)
                expect
                (fp #b0 #b1100000011 #b001)))
(assert (fp.leq (fp #b0 #b1100000011 #b001)
                expect
                (fp #b0 #b1110001110 #b000)))

(assert (= expect result))

(check-sat)
(exit)
