(assert (fp.leq (fp #b1 #b010000000000 #b0000000000)
                arg2
                (fp #b0 #b111011011101 #b1110110101)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b000001100010 #b1011101110)
                expect
                (fp #b0 #b100000001001 #b1010000110)))
(assert (fp.leq (fp #b0 #b100000001001 #b1010000110)
                expect
                (fp #b0 #b101010000000 #b1101001001)))

(assert (not (= expect result)))

(check-sat)
