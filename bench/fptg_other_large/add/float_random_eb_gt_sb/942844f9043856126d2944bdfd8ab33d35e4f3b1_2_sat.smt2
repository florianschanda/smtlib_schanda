; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1111100010111 #b11011011)
                arg1
                (fp #b0 #b1111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11111111)
                arg1
                (fp #b0 #b1111111111111 #b00000000)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1110011101110 #b00101010)
                arg2
                (fp #b1 #b0101110110010 #b11011110)))
(assert (fp.leq (fp #b1 #b0101110110010 #b11011110)
                arg2
                (fp #b0 #b0011000110101 #b00100011)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b0 #b0011010001100 #b10010010)
                expect
                (fp #b0 #b1111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11111111)
                expect
                (fp #b0 #b1111111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
