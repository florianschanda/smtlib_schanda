(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111111101 #b010)
                arg1
                (fp #b1 #b0000000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000000 #b010)
                arg1
                (fp #b0 #b1110100010 #b101)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111001010 #b110)
                arg2
                (fp #b0 #b0000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000 #b010)
                arg2
                (fp #b0 #b0010111011 #b010)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1011100110 #b001)
                expect
                (fp #b1 #b0000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000)
                expect
                (fp #b0 #b1011011010 #b011)))

(assert (= expect result))

(check-sat)
(exit)
