(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b011101100 #b1101111)
                arg1
                (fp #b0 #b100000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000111 #b0000000)
                arg1
                (fp #b0 #b100101010 #b0011011)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111001101 #b0111111)
                arg2
                (fp #b0 #b101111110 #b1111111)))
(assert (fp.leq (fp #b0 #b101111110 #b1111111)
                arg2
                (fp #b0 #b110111010 #b1000011)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b101111100 #b0101001)
                expect
                (fp #b0 #b101111111 #b0000000)))
(assert (fp.leq (fp #b0 #b101111111 #b0000000)
                expect
                (fp #b0 #b111110101 #b1001010)))

(assert (= expect result))

(check-sat)
(exit)
