(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1110010010110001 #b00)
                arg2
                (fp #b1 #b0000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01)
                arg2
                (fp #b0 #b0100000111010000 #b01)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
