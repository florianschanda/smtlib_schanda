(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111111111101 #b10)
                arg1
                (fp #b1 #b111111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111111101 #b00)
                arg1
                (fp #b1 #b001000011011 #b10)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110100101110 #b00)
                arg2
                (fp #b0 #b011101110010 #b01)))
(assert (fp.leq (fp #b0 #b011101110010 #b01)
                arg2
                (fp #b0 #b101111101000 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111111111101 #b01)
                expect
                (fp #b1 #b111111111100 #b11)))
(assert (fp.leq (fp #b1 #b111111111100 #b11)
                expect
                (fp #b1 #b110000101110 #b11)))

(assert (= expect result))

(check-sat)
(exit)
