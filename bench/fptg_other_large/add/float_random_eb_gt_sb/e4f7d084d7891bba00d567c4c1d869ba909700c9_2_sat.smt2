(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11010101110101 #b010010100)
                arg1
                (fp #b0 #b00001101000101 #b110110110)))
(assert (fp.leq (fp #b0 #b00001101000101 #b110110110)
                arg1
                (fp #b0 #b01010010001001 #b101001110)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00001011101100 #b011101010)
                arg2
                (fp #b0 #b10000000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b10000000001001 #b000000000)
                arg2
                (fp #b0 #b11011101101000 #b111100110)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b01110000011000 #b101011000)
                expect
                (fp #b0 #b10000000001001 #b000000001)))
(assert (fp.leq (fp #b0 #b10000000001001 #b000000001)
                expect
                (fp #b0 #b11001001111111 #b101111100)))

(assert (= expect result))

(check-sat)
(exit)
