; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11010110011 #b11111010)
                arg1
                (fp #b0 #b00000000001 #b00000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b00000000)
                arg1
                (fp #b0 #b01001011101 #b10000010)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11001111111 #b11011010)
                arg2
                (fp #b1 #b01011011110 #b01001101)))
(assert (fp.leq (fp #b1 #b01011011110 #b01001101)
                arg2
                (fp #b0 #b11000000011 #b01100111)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10100100111 #b10001110)
                expect
                (fp #b1 #b01011011110 #b01001100)))
(assert (fp.leq (fp #b1 #b01011011110 #b01001100)
                expect
                (fp #b0 #b01101101001 #b11011101)))

(assert (= expect result))

(check-sat)
(exit)
