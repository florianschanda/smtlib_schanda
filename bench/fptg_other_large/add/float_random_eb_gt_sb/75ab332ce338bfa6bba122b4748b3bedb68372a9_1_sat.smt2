(assert (fp.leq (fp #b1 #b11111010110011 #b11010011101)
                expect
                (fp #b1 #b10000000001010 #b11111111110)))
(assert (fp.leq (fp #b1 #b10000000001010 #b11111111110)
                expect
                (fp #b0 #b01100101111011 #b01101101000)))

(assert (= expect result))

