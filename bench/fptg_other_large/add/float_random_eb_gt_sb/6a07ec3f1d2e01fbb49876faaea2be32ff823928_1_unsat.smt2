(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110110101110011 #b1)
                arg1
                (fp #b1 #b100000000000000 #b1)))
(assert (fp.leq (fp #b1 #b100000000000000 #b1)
                arg1
                (fp #b0 #b111010100110000 #b1)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b0 #b010111011110100 #b0)
                arg2
                (fp #b0 #b111011000010110 #b0)))
(assert (fp.leq (fp #b0 #b111011000010110 #b0)
                arg2
                (fp #b0 #b111011101100111 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b001100111110100 #b1)
                expect
                (fp #b0 #b111011000010101 #b1)))
(assert (fp.leq (fp #b0 #b111011000010101 #b1)
                expect
                (fp #b0 #b111111000000010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
