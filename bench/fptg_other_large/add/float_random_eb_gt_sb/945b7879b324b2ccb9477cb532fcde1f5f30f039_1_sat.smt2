; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111111111110 #b1100011)
                arg1
                (fp #b1 #b1111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b0000000)
                arg1
                (fp #b1 #b0111100000110 #b1001110)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0001101101011 #b1001000)
                arg2
                (fp #b0 #b0000000000000 #b1011101)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1011101)
                arg2
                (fp #b0 #b0110111011011 #b0110001)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111111111110 #b1111010)
                expect
                (fp #b1 #b1111111111100 #b1111111)))
(assert (fp.leq (fp #b1 #b1111111111100 #b1111111)
                expect
                (fp #b0 #b0001100101010 #b1100100)))

(assert (= expect result))

(check-sat)
(exit)
