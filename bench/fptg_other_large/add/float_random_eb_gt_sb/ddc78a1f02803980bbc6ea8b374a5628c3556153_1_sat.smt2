(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00101011001 #b01101000)
                arg1
                (fp #b0 #b00000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000000)
                arg1
                (fp #b0 #b01001110000 #b01101000)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11111111101 #b00110101)
                arg2
                (fp #b1 #b11101010000 #b11100110)))
(assert (fp.leq (fp #b1 #b11101010000 #b11100110)
                arg2
                (fp #b0 #b10101010110 #b11010011)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11101011110 #b11001010)
                expect
                (fp #b1 #b11101010000 #b11100110)))
(assert (fp.leq (fp #b1 #b11101010000 #b11100110)
                expect
                (fp #b0 #b00010100100 #b01111000)))

(assert (= expect result))

(check-sat)
(exit)
