(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011101100 #b1111)
                arg1
                (fp #b1 #b1000000001 #b0100)))
(assert (fp.leq (fp #b1 #b1000000001 #b0100)
                arg1
                (fp #b1 #b0010010100 #b0110)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0011011011 #b1010)
                arg2
                (fp #b0 #b0010001001 #b0100)))
(assert (fp.leq (fp #b0 #b0010001001 #b0100)
                arg2
                (fp #b0 #b0100001100 #b1110)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111001110 #b1001)
                expect
                (fp #b1 #b1000000001 #b0011)))
(assert (fp.leq (fp #b1 #b1000000001 #b0011)
                expect
                (fp #b1 #b0010001011 #b1110)))

(assert (not (= expect result)))

(check-sat)
(exit)
