(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b000011100 #b0)
                arg1
                (fp #b0 #b100000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000 #b1)
                arg1
                (fp #b0 #b110101100 #b1)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b001100101 #b1)
                arg2
                (fp #b0 #b111111110 #b0)))
(assert (fp.leq (fp #b0 #b111111110 #b0)
                arg2
                (fp #b0 #b111111110 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001001010 #b0)
                expect
                (fp #b0 #b111111110 #b1)))
(assert (fp.leq (fp #b0 #b111111110 #b1)
                expect
                (fp #b0 #b111111111 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
