;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00111000111101 #b011101000)
                arg1
                (fp #b0 #b10111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b111111111)
                arg1
