(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00011101001011 #b110001100)
                arg2
                (fp #b0 #b00000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000000000)
                arg2
                (fp #b0 #b00011110000000 #b101000001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11111111101101 #b101110000)
                expect
                (fp #b0 #b10111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b111111111)
                expect
                (fp #b0 #b11010100000101 #b011101010)))

(assert (= expect result))

(check-sat)
(exit)
