(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10011110010 #b0010)
                arg1
                (fp #b1 #b10011011000 #b0100)))
(assert (fp.leq (fp #b1 #b10011011000 #b0100)
                arg1
                (fp #b0 #b00101100001 #b1111)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b01000100110 #b1001)
                arg2
                (fp #b0 #b10101110011 #b1001)))
(assert (fp.leq (fp #b0 #b10101110011 #b1001)
                arg2
                (fp #b0 #b11100001000 #b0110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b10001110110 #b0100)
                expect
                (fp #b0 #b10101110011 #b1001)))
(assert (fp.leq (fp #b0 #b10101110011 #b1001)
                expect
                (fp #b0 #b10111001011 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
