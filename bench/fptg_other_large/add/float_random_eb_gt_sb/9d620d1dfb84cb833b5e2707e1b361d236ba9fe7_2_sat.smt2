                arg2
                (fp #b1 #b001111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b001111111111101 #b000000)
                arg2
                (fp #b0 #b010001010010111 #b101110)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b011101010111010 #b100100)
                expect
                (fp #b1 #b001111111111101 #b000001)))
(assert (fp.leq (fp #b1 #b001111111111101 #b000001)
                expect
                (fp #b0 #b100110111001011 #b011101)))

(assert (= expect result))

(check-sat)
(exit)
