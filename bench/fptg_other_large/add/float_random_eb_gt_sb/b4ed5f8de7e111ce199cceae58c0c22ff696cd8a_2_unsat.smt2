; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1100100000110 #b1101101)
                arg1
                (fp #b1 #b0111111111111 #b0101111)))
(assert (fp.leq (fp #b1 #b0111111111111 #b0101111)
                arg1
                (fp #b0 #b0011100110101 #b1100101)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1000010010110 #b0001001)
                arg2
                (fp #b0 #b0000000000000 #b1100000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1100000)
                arg2
                (fp #b0 #b1000011110100 #b0000111)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1100000000101 #b0011001)
                expect
                (fp #b1 #b0111111111111 #b0101111)))
(assert (fp.leq (fp #b1 #b0111111111111 #b0101111)
                expect
                (fp #b1 #b0111001111010 #b1010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
