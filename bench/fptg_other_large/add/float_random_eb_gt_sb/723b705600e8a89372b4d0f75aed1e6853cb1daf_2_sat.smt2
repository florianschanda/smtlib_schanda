(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10000010001010100 #b10)
                arg1
                (fp #b0 #b00000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b01)
                arg1
                (fp #b0 #b11111110000001111 #b00)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10000010111110010 #b01)
                arg2
                (fp #b1 #b00000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b01)
                arg2
                (fp #b0 #b01100101100101010 #b10)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11010101010110001 #b10)
                expect
                (fp #b1 #b00000000000000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00)
                expect
                (fp #b0 #b10010010111010011 #b00)))

(assert (= expect result))

(check-sat)
(exit)
