(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011110111 #b1010)
                arg1
                (fp #b1 #b0111111111 #b0111)))
(assert (fp.leq (fp #b1 #b0111111111 #b0111)
                arg1
                (fp #b1 #b0101110011 #b0001)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101101100 #b1010)
                arg2
                (fp #b1 #b1000000011 #b0001)))
(assert (fp.leq (fp #b1 #b1000000011 #b0001)
                arg2
                (fp #b0 #b1100011110 #b1101)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111100010 #b0110)
                expect
                (fp #b1 #b1000000011 #b0011)))
(assert (fp.leq (fp #b1 #b1000000011 #b0011)
                expect
                (fp #b1 #b0101000011 #b1110)))

(assert (not (= expect result)))

(check-sat)
(exit)
