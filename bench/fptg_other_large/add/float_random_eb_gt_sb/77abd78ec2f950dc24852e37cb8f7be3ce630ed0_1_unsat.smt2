                arg2
                (fp #b1 #b0001101001 #b000011)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1000011110 #b000100)
                expect
                (fp #b1 #b0101110001 #b011011)))
(assert (fp.leq (fp #b1 #b0101110001 #b011011)
                expect
                (fp #b0 #b0011110000 #b111110)))

(assert (not (= expect result)))

(check-sat)
