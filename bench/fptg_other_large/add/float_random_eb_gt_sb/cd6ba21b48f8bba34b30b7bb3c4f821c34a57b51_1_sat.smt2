; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0111011110001 #b110110001)
                arg1
                (fp #b0 #b0010001011010 #b001000000)))
(assert (fp.leq (fp #b0 #b0010001011010 #b001000000)
                arg1
                (fp #b0 #b1100001100100 #b000000111)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1001101101001 #b010110011)
                arg2
                (fp #b1 #b0111111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111111 #b000000000)
                arg2
                (fp #b1 #b0010001110000 #b011100110)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101101010101 #b111111011)
                expect
                (fp #b1 #b0111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b0111111111110 #b111111111)
                expect
                (fp #b0 #b1100110011000 #b100010100)))

(assert (= expect result))

(check-sat)
(exit)
