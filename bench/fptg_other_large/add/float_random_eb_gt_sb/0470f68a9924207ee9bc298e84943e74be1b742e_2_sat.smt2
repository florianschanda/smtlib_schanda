(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101110001 #b110)
                arg1
                (fp #b0 #b000000000 #b010)))
(assert (fp.leq (fp #b0 #b000000000 #b010)
                arg1
                (fp #b0 #b111100010 #b101)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010011010 #b100)
                arg2
                (fp #b0 #b010000000 #b000)))
(assert (fp.leq (fp #b0 #b010000000 #b000)
                arg2
                (fp #b0 #b111010011 #b101)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100000111 #b010)
                expect
                (fp #b0 #b010000000 #b001)))
(assert (fp.leq (fp #b0 #b010000000 #b001)
                expect
                (fp #b0 #b111001111 #b100)))

(assert (= expect result))

(check-sat)
(exit)
