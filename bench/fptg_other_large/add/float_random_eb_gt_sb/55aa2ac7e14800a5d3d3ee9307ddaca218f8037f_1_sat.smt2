(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b00010001100 #b111101)
                arg1
                (fp #b0 #b00111111101 #b000000)))
(assert (fp.leq (fp #b0 #b00111111101 #b000000)
                arg1
                (fp #b0 #b10100000001 #b100101)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11110110111 #b011101)
                arg2
                (fp #b1 #b10000000101 #b010001)))
(assert (fp.leq (fp #b1 #b10000000101 #b010001)
                arg2
                (fp #b0 #b11111000011 #b010100)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10100001100 #b110010)
                expect
                (fp #b1 #b10000000101 #b010000)))
(assert (fp.leq (fp #b1 #b10000000101 #b010000)
                expect
                (fp #b0 #b01000001101 #b101111)))

(assert (= expect result))

(check-sat)
(exit)
