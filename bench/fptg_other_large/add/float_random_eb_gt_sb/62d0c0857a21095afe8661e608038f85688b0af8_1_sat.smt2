(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010001101 #b0110110)
                arg1
                (fp #b1 #b000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b000000000 #b0000001)
                arg1
                (fp #b0 #b100110101 #b0000000)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b010001000 #b1001001)
                arg2
                (fp #b0 #b111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b111111101 #b0000000)
                arg2
                (fp #b0 #b111111101 #b0000101)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b000101011 #b1110000)
                expect
                (fp #b0 #b111111100 #b1111111)))
(assert (fp.leq (fp #b0 #b111111100 #b1111111)
                expect
                (fp #b0 #b111111101 #b0010101)))

(assert (= expect result))

(check-sat)
(exit)
