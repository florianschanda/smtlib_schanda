; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110101100011 #b011)
                arg1
                (fp #b0 #b0000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000 #b010)
                arg1
                (fp #b0 #b1001100000101 #b011)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1010000110110 #b110)
                arg2
                (fp #b0 #b0111111111111 #b110)))
(assert (fp.leq (fp #b0 #b0111111111111 #b110)
                arg2
                (fp #b0 #b1011101000110 #b111)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0011001100011 #b110)
                expect
                (fp #b0 #b0111111111111 #b111)))
(assert (fp.leq (fp #b0 #b0111111111111 #b111)
                expect
                (fp #b0 #b1101001110111 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
