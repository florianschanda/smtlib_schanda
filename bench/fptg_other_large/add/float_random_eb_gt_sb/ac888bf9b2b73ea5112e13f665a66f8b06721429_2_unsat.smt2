; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100111010 #b101)
                arg1
                (fp #b1 #b100101010 #b101)))
(assert (fp.leq (fp #b1 #b100101010 #b101)
                arg1
                (fp #b1 #b010001110 #b110)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111111 #b000)
                arg2
                (fp #b1 #b111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111110 #b111)
                arg2
                (fp #b0 #b000011110 #b011)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
