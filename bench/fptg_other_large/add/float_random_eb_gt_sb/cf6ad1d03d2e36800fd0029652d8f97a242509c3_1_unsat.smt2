; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111001011 #b0101111)
                arg1
                (fp #b1 #b000000001 #b1111100)))
(assert (fp.leq (fp #b1 #b000000001 #b1111100)
                arg1
                (fp #b0 #b000110111 #b1000001)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110011111 #b1001100)
                arg2
                (fp #b1 #b101111000 #b1001110)))
(assert (fp.leq (fp #b1 #b101111000 #b1001110)
                arg2
                (fp #b0 #b001001001 #b0101001)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111110101 #b1111011)
                expect
                (fp #b1 #b101111000 #b1001110)))
(assert (fp.leq (fp #b1 #b101111000 #b1001110)
                expect
                (fp #b1 #b000111000 #b0011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
