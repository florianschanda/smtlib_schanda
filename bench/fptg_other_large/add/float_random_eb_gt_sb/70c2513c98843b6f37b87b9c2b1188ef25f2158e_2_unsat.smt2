; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11011001010 #b000100)
                arg1
                (fp #b0 #b10001110010 #b010101)))
(assert (fp.leq (fp #b0 #b10001110010 #b010101)
                arg1
                (fp #b0 #b11101101100 #b110001)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11101101111 #b001101)
                arg2
                (fp #b0 #b00000000000 #b111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b111111)
                arg2
                (fp #b0 #b01110100011 #b001000)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b01110110100 #b111101)
                expect
                (fp #b0 #b10001110010 #b010110)))
(assert (fp.leq (fp #b0 #b10001110010 #b010110)
                expect
                (fp #b0 #b11001011100 #b000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
