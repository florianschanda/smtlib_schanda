(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111000011 #b0100)
                arg1
                (fp #b1 #b0111111111 #b0000)))
(assert (fp.leq (fp #b1 #b0111111111 #b0000)
                arg1
                (fp #b0 #b0110001100 #b1101)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001010011 #b1111)
                arg2
                (fp #b1 #b0000000001 #b0000)))
(assert (fp.leq (fp #b1 #b0000000001 #b0000)
                arg2
                (fp #b0 #b0101010000 #b1011)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101010001 #b0010)
                expect
                (fp #b1 #b0111111111 #b0001)))
(assert (fp.leq (fp #b1 #b0111111111 #b0001)
                expect
                (fp #b1 #b0101110110 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
