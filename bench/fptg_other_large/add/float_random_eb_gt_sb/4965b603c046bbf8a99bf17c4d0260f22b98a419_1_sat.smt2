(assert (fp.leq (fp #b0 #b00101110101111000 #b1111001)
                arg2
                (fp #b0 #b01111111100010110 #b0011011)))
(assert (fp.leq (fp #b0 #b01111111100010110 #b0011011)
                arg2
                (fp #b0 #b11110111000011110 #b1110111)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b11000101000100110 #b1010000)
                expect
                (fp #b1 #b10010101100000000 #b1110100)))
(assert (fp.leq (fp #b1 #b10010101100000000 #b1110100)
                expect
                (fp #b0 #b10010110010011110 #b0111001)))

(assert (= expect result))

(check-sat)
(exit)
