(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b010110111100 #b011011)
                arg1
                (fp #b1 #b010001011101 #b101111)))
(assert (fp.leq (fp #b1 #b010001011101 #b101111)
                arg1
                (fp #b0 #b100100101010 #b000100)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111101001010 #b001000)
                arg2
                (fp #b1 #b101111100011 #b101101)))
(assert (fp.leq (fp #b1 #b101111100011 #b101101)
                arg2
                (fp #b0 #b011001011101 #b111011)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101111111101 #b001000)
                expect
                (fp #b1 #b101111100011 #b101110)))
(assert (fp.leq (fp #b1 #b101111100011 #b101110)
                expect
                (fp #b1 #b001110100000 #b011111)))

(assert (= expect result))

(check-sat)
(exit)
