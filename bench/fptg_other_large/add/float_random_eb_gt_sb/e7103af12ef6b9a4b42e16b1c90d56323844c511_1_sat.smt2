                arg2
                (fp #b0 #b110001100001101 #b11101000)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b010100110100001 #b00100001)
                expect
                (fp #b0 #b011100001111000 #b10001001)))
(assert (fp.leq (fp #b0 #b011100001111000 #b10001001)
                expect
                (fp #b0 #b110000111000101 #b01011111)))

(assert (= expect result))

(check-sat)
