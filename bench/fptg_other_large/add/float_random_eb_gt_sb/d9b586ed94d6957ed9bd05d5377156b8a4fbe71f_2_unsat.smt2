                (fp #b1 #b0000000000000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b00000000000)
                arg2
                (fp #b0 #b1101000111100001 #b11001110111)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1000010100001000 #b00100011011)
                expect
                (fp #b1 #b0100101001010101 #b01010010010)))
(assert (fp.leq (fp #b1 #b0100101001010101 #b01010010010)
                expect
                (fp #b0 #b0101011000011100 #b01011111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
