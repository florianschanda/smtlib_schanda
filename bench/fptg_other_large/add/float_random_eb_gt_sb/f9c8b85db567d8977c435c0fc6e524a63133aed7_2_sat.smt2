;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10101110110011 #b10001111011)
                arg1
                (fp #b1 #b00000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b11111111111)
                arg1
                (fp #b0 #b00010001101101 #b11010111001)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b01001101000001 #b10111010010)
                arg2
                (fp #b1 #b01000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b01000000000000 #b00000000000)
                arg2
                (fp #b1 #b00110010110011 #b11001010001)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10011110111111 #b10000101011)
                expect
                (fp #b1 #b01000000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b01000000000000 #b00000000001)
                expect
                (fp #b0 #b11001101011100 #b10000101100)))

(assert (= expect result))

(check-sat)
(exit)
