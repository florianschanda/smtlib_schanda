; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b101111000000100 #b100010)
                arg1
                (fp #b0 #b000000000000000 #b000110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000110)
                arg1
                (fp #b0 #b000101101010111 #b110011)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b100011100100001 #b100111)
                arg2
                (fp #b0 #b011111111111111 #b000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b000000)
                arg2
                (fp #b0 #b111010000110110 #b000011)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b011001101001011 #b110001)
                expect
                (fp #b0 #b011111111111111 #b000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b000000)
                expect
                (fp #b0 #b100010101010100 #b010010)))

(assert (= expect result))

(check-sat)
(exit)
