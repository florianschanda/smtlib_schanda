(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1010110011 #b11100010)
                arg1
                (fp #b0 #b0100000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b00000000)
                arg1
                (fp #b0 #b1101111100 #b11010110)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111010 #b01101100)
                arg2
                (fp #b0 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000000)
                arg2
                (fp #b0 #b0011010000 #b11001110)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1100001001 #b00111111)
                expect
                (fp #b0 #b0100000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0100000000 #b00000001)
                expect
                (fp #b0 #b1100101000 #b10010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
