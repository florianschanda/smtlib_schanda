(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101011000 #b0111)
                arg1
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg1
                (fp #b0 #b010100010 #b0011)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101010111 #b0000)
                arg2
                (fp #b1 #b100000011 #b1110)))
(assert (fp.leq (fp #b1 #b100000011 #b1110)
                arg2
                (fp #b0 #b011110010 #b0111)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110011001 #b0101)
                expect
                (fp #b1 #b100000011 #b1101)))
(assert (fp.leq (fp #b1 #b100000011 #b1101)
                expect
                (fp #b1 #b011110001 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
