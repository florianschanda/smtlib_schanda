(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111101111 #b0111)
                arg1
                (fp #b1 #b110100000 #b0010)))
(assert (fp.leq (fp #b1 #b110100000 #b0010)
                arg1
                (fp #b1 #b010011011 #b0111)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110010111 #b1111)
                arg2
                (fp #b0 #b011111111 #b0110)))
(assert (fp.leq (fp #b0 #b011111111 #b0110)
                arg2
                (fp #b0 #b111111010 #b0010)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111101010 #b0000)
                expect
                (fp #b1 #b110100000 #b0001)))
(assert (fp.leq (fp #b1 #b110100000 #b0001)
                expect
                (fp #b1 #b011111001 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
