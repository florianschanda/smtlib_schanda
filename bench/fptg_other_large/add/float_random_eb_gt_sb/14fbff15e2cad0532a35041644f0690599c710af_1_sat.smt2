(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10010110101110 #b111001011)
                arg1
                (fp #b0 #b10010011001111 #b110110001)))
(assert (fp.leq (fp #b0 #b10010011001111 #b110110001)
                arg1
                (fp #b0 #b11111011011110 #b111000110)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10001010110000 #b111100100)
                arg2
                (fp #b1 #b00000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000000)
                arg2
                (fp #b0 #b01001101100001 #b001101111)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00101100000001 #b010001000)
                expect
                (fp #b0 #b10010011001111 #b110110000)))
(assert (fp.leq (fp #b0 #b10010011001111 #b110110000)
                expect
                (fp #b0 #b11011000011101 #b010101011)))

(assert (= expect result))

(check-sat)
(exit)
