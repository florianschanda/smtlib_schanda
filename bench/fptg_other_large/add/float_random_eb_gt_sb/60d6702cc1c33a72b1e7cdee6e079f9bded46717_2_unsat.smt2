(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b1001000101 #b000)
                arg1
                (fp #b0 #b1011111110 #b111)))
(assert (fp.leq (fp #b0 #b1011111110 #b111)
                arg1
                (fp #b0 #b1110111001 #b101)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0000101001 #b000)
                arg2
                (fp #b0 #b1111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111)
                arg2
                (fp #b0 #b1111111111 #b000)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
