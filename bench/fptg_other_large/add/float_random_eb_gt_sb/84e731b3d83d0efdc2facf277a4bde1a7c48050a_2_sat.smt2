(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1101101000101 #b00)
                arg1
                (fp #b0 #b0011000111100 #b11)))
(assert (fp.leq (fp #b0 #b0011000111100 #b11)
                arg1
                (fp #b0 #b1000110001011 #b10)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b1000011111001 #b00)
                arg2
                (fp #b0 #b1110111111111 #b10)))
(assert (fp.leq (fp #b0 #b1110111111111 #b10)
                arg2
                (fp #b0 #b1111011110011 #b11)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0101110110000 #b10)
                expect
                (fp #b0 #b1110111111111 #b11)))
(assert (fp.leq (fp #b0 #b1110111111111 #b11)
                expect
                (fp #b0 #b1111100000101 #b11)))

(assert (= expect result))

(check-sat)
(exit)
