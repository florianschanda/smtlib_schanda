(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111110 #b110010)
                arg1
                (fp #b1 #b1111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000)
                arg1
                (fp #b1 #b1000001000 #b011101)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b1011100101 #b010010)
                arg2
                (fp #b0 #b1100000110 #b011010)))
(assert (fp.leq (fp #b0 #b1100000110 #b011010)
                arg2
                (fp #b0 #b1100010000 #b010001)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111110 #b011110)
                expect
                (fp #b1 #b1111111100 #b111111)))
(assert (fp.leq (fp #b1 #b1111111100 #b111111)
                expect
                (fp #b1 #b1000110011 #b010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
