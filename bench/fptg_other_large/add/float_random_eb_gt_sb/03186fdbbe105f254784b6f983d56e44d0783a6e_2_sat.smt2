(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0110010111010101 #b010110)
                arg1
                (fp #b0 #b0001001110110010 #b000000)))
(assert (fp.leq (fp #b0 #b0001001110110010 #b000000)
                arg1
                (fp #b0 #b1100111010011111 #b111111)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0101110111011100 #b110101)
                expect
                (fp #b1 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000)
                expect
                (fp #b0 #b0111110100111100 #b000100)))

(assert (= expect result))

(check-sat)
(exit)
