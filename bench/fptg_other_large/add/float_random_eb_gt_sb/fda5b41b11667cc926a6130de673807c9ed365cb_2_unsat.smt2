(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b001100000 #b00)
                arg1
                (fp #b0 #b100000001 #b10)))
(assert (fp.leq (fp #b0 #b100000001 #b10)
                arg1
                (fp #b0 #b100110100 #b10)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100010010 #b00)
                arg2
                (fp #b0 #b000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000 #b01)
                arg2
                (fp #b0 #b001001110 #b11)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b001110110 #b11)
                expect
                (fp #b0 #b100000001 #b11)))
(assert (fp.leq (fp #b0 #b100000001 #b11)
                expect
                (fp #b0 #b110101001 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
