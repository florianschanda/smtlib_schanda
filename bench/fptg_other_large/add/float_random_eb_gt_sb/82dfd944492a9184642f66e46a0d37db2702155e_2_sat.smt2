(assert (fp.leq (fp #b1 #b10001110000 #b11001111)
                arg2
                (fp #b0 #b11111000100 #b00011001)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11111111110 #b10101111)
                expect
                (fp #b1 #b11111111101 #b00000001)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000001)
                expect
                (fp #b0 #b01010101110 #b01111001)))

(assert (= expect result))

(check-sat)
(exit)
