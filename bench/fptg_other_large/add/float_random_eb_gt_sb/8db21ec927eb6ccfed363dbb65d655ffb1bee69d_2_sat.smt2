(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b010100100110111 #b00011)
                arg1
                (fp #b0 #b011111111111111 #b00111)))
(assert (fp.leq (fp #b0 #b011111111111111 #b00111)
                arg1
                (fp #b0 #b100011000010000 #b01110)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101110010111000 #b01101)
                arg2
                (fp #b0 #b001111111111101 #b01101)))
(assert (fp.leq (fp #b0 #b001111111111101 #b01101)
                arg2
                (fp #b0 #b111101110001101 #b01110)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111010001010001 #b00100)
                expect
                (fp #b0 #b011111111111111 #b01000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b01000)
                expect
                (fp #b0 #b101011100101100 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
