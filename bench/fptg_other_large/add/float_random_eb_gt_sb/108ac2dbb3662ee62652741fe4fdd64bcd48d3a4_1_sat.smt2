(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111001101 #b1100)
                arg1
                (fp #b1 #b000000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000000 #b0100)
                arg1
                (fp #b0 #b111100000 #b0111)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b000101110 #b1000)
                arg2
                (fp #b0 #b011111111 #b0110)))
(assert (fp.leq (fp #b0 #b011111111 #b0110)
                arg2
                (fp #b0 #b100111001 #b1001)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b011000001 #b0000)
                expect
                (fp #b0 #b011111111 #b0101)))
(assert (fp.leq (fp #b0 #b011111111 #b0101)
                expect
                (fp #b0 #b101101111 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
