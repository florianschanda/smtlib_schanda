(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1001000010010100 #b00000)
                arg1
                (fp #b1 #b1000000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000000000101 #b00000)
                arg1
                (fp #b0 #b0000101111110001 #b11100)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1101011100111111 #b01111)
                arg2
                (fp #b1 #b0111111111111111 #b01000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b01000)
                arg2
                (fp #b1 #b0100000110101001 #b11011)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1101100100100011 #b11000)
                expect
                (fp #b1 #b1000000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000000000101 #b00000)
                expect
                (fp #b0 #b0010111000100011 #b10100)))

(assert (= expect result))

(check-sat)
(exit)
