; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111010011000 #b000000)
                arg1
                (fp #b0 #b011111111111 #b111111)))
(assert (fp.leq (fp #b0 #b011111111111 #b111111)
                arg1
                (fp #b0 #b111011111001 #b100111)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111000110010 #b110101)
                arg2
                (fp #b0 #b001011000100 #b000011)))
(assert (fp.leq (fp #b0 #b001011000100 #b000011)
                arg2
                (fp #b0 #b110100000000 #b101100)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b000000110101 #b001011)
                expect
                (fp #b0 #b011111111111 #b111111)))
(assert (fp.leq (fp #b0 #b011111111111 #b111111)
                expect
                (fp #b0 #b111100011011 #b000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
