                arg2
                (fp #b0 #b0111111111 #b01100111)))
(assert (fp.leq (fp #b0 #b0111111111 #b01100111)
                arg2
                (fp #b0 #b1000011110 #b01010001)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101010111 #b00100100)
                expect
                (fp #b0 #b0111111111 #b01100110)))
(assert (fp.leq (fp #b0 #b0111111111 #b01100110)
                expect
                (fp #b0 #b1010000101 #b10011001)))

(assert (= expect result))

(check-sat)
(exit)
