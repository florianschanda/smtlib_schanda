; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b011001100010 #b1101)
                arg1
                (fp #b0 #b111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111)
                arg1
                (fp #b0 #b111111111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110010100011 #b0001)
                arg2
                (fp #b1 #b100000111000 #b1010)))
(assert (fp.leq (fp #b1 #b100000111000 #b1010)
                arg2
                (fp #b0 #b110011000101 #b0001)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110100110100 #b1101)
                expect
                (fp #b0 #b111111111110 #b1110)))
(assert (fp.leq (fp #b0 #b111111111110 #b1110)
                expect
                (fp #b0 #b111111111111 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
