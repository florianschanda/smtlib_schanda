(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110110001010 #b101)
                arg1
                (fp #b1 #b0000000000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000000000 #b010)
                arg1
                (fp #b0 #b0001000100100 #b000)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1100000000010 #b000)
                arg2
                (fp #b0 #b1000100110101 #b000)))
(assert (fp.leq (fp #b0 #b1000100110101 #b000)
                arg2
                (fp #b0 #b1000110010001 #b001)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0101001011110 #b100)
                expect
                (fp #b0 #b1000100110100 #b111)))
(assert (fp.leq (fp #b0 #b1000100110100 #b111)
                expect
                (fp #b0 #b1000100111100 #b110)))

(assert (= expect result))

(check-sat)
(exit)
