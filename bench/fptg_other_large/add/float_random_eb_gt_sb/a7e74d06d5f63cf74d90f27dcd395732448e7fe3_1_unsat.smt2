                arg2
                (fp #b1 #b000000000 #b111111)))
(assert (fp.leq (fp #b1 #b000000000 #b111111)
                arg2
                (fp #b0 #b111101010 #b000000)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101001110 #b111010)
                expect
                (fp #b0 #b001111100 #b111111)))
(assert (fp.leq (fp #b0 #b001111100 #b111111)
                expect
                (fp #b0 #b011010110 #b110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
