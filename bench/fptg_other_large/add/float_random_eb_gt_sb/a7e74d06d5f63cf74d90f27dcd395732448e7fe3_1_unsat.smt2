;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110010110 #b110000)
                arg1
                (fp #b0 #b001111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111101 #b000000)
                arg1
