(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1110111000101 #b10111110)
                expect
                (fp #b1 #b0011111111100 #b00000001)))
(assert (fp.leq (fp #b1 #b0011111111100 #b00000001)
                expect
                (fp #b0 #b1111110010100 #b00100111)))

(assert (= expect result))

(check-sat)
