(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1011100110 #b1)
                arg1
                (fp #b1 #b0111111111 #b0)))
(assert (fp.leq (fp #b1 #b0111111111 #b0)
                arg1
                (fp #b0 #b1111010000 #b0)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0101001111 #b1)
                arg2
                (fp #b0 #b1011111110 #b1)))
(assert (fp.leq (fp #b0 #b1011111110 #b1)
                arg2
                (fp #b0 #b1101110001 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b1001100110 #b1)
                expect
                (fp #b0 #b1011111110 #b0)))
(assert (fp.leq (fp #b0 #b1011111110 #b0)
                expect
                (fp #b0 #b1100110101 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
