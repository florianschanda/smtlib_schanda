; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11110000010111101 #b01)
                arg1
                (fp #b1 #b01000000000000000 #b00)))
(assert (fp.leq (fp #b1 #b01000000000000000 #b00)
                arg1
                (fp #b0 #b00011001111111111 #b01)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11011110101100010 #b11)
                arg2
                (fp #b1 #b01111101000100010 #b10)))
(assert (fp.leq (fp #b1 #b01111101000100010 #b10)
                arg2
                (fp #b0 #b01101000101010001 #b00)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11100111101011101 #b00)
                expect
                (fp #b1 #b01111101000100010 #b10)))
(assert (fp.leq (fp #b1 #b01111101000100010 #b10)
                expect
                (fp #b0 #b11110111111101000 #b01)))

(assert (= expect result))

(check-sat)
(exit)
