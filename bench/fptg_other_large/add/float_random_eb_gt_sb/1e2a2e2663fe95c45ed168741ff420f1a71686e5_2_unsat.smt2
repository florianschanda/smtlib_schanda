(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b00111110100 #b10)
                arg1
                (fp #b0 #b01100011101 #b10)))
(assert (fp.leq (fp #b0 #b01100011101 #b10)
                arg1
                (fp #b0 #b11111110001 #b11)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01110111000 #b10)
                arg2
                (fp #b0 #b10000000001 #b00)))
(assert (fp.leq (fp #b0 #b10000000001 #b00)
                arg2
                (fp #b0 #b10011111010 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01001001110 #b10)
                expect
                (fp #b0 #b10000000001 #b01)))
(assert (fp.leq (fp #b0 #b10000000001 #b01)
                expect
                (fp #b0 #b10011101000 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
