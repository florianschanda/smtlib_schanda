(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0110001100 #b1)
                arg1
                (fp #b0 #b1000000011 #b1)))
(assert (fp.leq (fp #b0 #b1000000011 #b1)
                arg1
                (fp #b0 #b1101101001 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1100110111 #b1)
                arg2
                (fp #b1 #b0000000000 #b1)))
(assert (fp.leq (fp #b1 #b0000000000 #b1)
                arg2
                (fp #b0 #b0001000010 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0101100100 #b0)
                expect
                (fp #b0 #b1000000011 #b0)))
(assert (fp.leq (fp #b0 #b1000000011 #b0)
                expect
                (fp #b0 #b1111011110 #b0)))

(assert (= expect result))

(check-sat)
(exit)
