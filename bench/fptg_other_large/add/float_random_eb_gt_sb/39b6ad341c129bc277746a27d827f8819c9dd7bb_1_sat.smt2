; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0011111101110101 #b00000)
                arg1
                (fp #b0 #b1000000000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000000000101 #b00000)
                arg1
                (fp #b0 #b1010101101011000 #b11101)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1001101100010001 #b11111)
                arg2
                (fp #b1 #b0010101011010101 #b11101)))
(assert (fp.leq (fp #b1 #b0010101011010101 #b11101)
                arg2
                (fp #b0 #b0010101000010101 #b11001)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1011110011000110 #b10110)
                expect
                (fp #b0 #b1000000000000100 #b11111)))
(assert (fp.leq (fp #b0 #b1000000000000100 #b11111)
                expect
                (fp #b0 #b1110111100101000 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
