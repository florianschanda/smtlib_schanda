(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11011001110000 #b11010)
                arg1
                (fp #b1 #b10111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b11111)
                arg1
                (fp #b1 #b10100011001011 #b10000)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00100010010011 #b01111)
                arg2
                (fp #b0 #b10000000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000000101 #b00000)
                arg2
                (fp #b0 #b10101101011111 #b11111)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11011001011000 #b11111)
                expect
                (fp #b1 #b10111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b11111)
                expect
                (fp #b1 #b00101100010001 #b00010)))

(assert (= expect result))

(check-sat)
(exit)
