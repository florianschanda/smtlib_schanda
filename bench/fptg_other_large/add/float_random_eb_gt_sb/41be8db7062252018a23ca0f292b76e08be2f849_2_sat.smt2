;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101100101111110 #b1100010)
                arg1
                (fp #b0 #b000000000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b0000000)
