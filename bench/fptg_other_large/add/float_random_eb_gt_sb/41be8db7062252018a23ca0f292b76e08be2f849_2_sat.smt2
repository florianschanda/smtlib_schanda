                arg2
                (fp #b0 #b100000000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000000000111 #b0000000)
                arg2
                (fp #b0 #b111011010110111 #b1000111)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b011000100010100 #b0000111)
                expect
                (fp #b0 #b100000000000111 #b0000001)))
(assert (fp.leq (fp #b0 #b100000000000111 #b0000001)
                expect
                (fp #b0 #b111000011010011 #b1010010)))

(assert (= expect result))

(check-sat)
(exit)
