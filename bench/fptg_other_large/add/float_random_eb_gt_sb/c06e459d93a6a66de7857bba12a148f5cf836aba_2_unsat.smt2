; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1010111101000 #b011)
                arg1
                (fp #b1 #b0100000000000 #b000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b000)
                arg1
                (fp #b0 #b1110011110110 #b111)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1010101010000 #b011)
                arg2
                (fp #b1 #b1000000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000000011 #b000)
                arg2
                (fp #b0 #b1111110111011 #b010)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110011011101 #b110)
                expect
                (fp #b1 #b1000000000011 #b001)))
(assert (fp.leq (fp #b1 #b1000000000011 #b001)
                expect
                (fp #b0 #b0100011000111 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
