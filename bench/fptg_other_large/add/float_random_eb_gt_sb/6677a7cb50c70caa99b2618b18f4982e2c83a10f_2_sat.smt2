(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b010011000 #b0101)
                arg1
                (fp #b0 #b110001000 #b1110)))
(assert (fp.leq (fp #b0 #b110001000 #b1110)
                arg1
                (fp #b0 #b110100011 #b1110)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010110111 #b1000)
                arg2
                (fp #b0 #b100000001 #b1000)))
(assert (fp.leq (fp #b0 #b100000001 #b1000)
                arg2
                (fp #b0 #b110000110 #b0111)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101100010 #b0100)
                expect
                (fp #b0 #b110001000 #b1111)))
(assert (fp.leq (fp #b0 #b110001000 #b1111)
                expect
                (fp #b0 #b111100100 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
