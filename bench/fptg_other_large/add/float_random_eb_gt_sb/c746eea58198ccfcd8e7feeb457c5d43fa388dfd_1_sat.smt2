(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b00010110101011 #b1011011)
                arg1
                (fp #b0 #b00000000000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111111)
                arg1
                (fp #b0 #b11011100000110 #b1001110)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10010100010000 #b0011010)
                arg2
                (fp #b1 #b01110111011010 #b1011101)))
(assert (fp.leq (fp #b1 #b01110111011010 #b1011101)
                arg2
                (fp #b1 #b01011100000011 #b1101011)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11101010001010 #b0001001)
                expect
                (fp #b1 #b01110111011010 #b1011100)))
(assert (fp.leq (fp #b1 #b01110111011010 #b1011100)
                expect
                (fp #b0 #b11000110111101 #b0011110)))

(assert (= expect result))

(check-sat)
(exit)
