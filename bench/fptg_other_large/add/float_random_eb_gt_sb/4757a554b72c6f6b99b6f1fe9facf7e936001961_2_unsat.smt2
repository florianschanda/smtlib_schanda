; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000111111 #b00101111)
                arg1
                (fp #b0 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000000)
                arg1
                (fp #b0 #b1111111110 #b00010000)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111110 #b01110100)
                arg2
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                arg2
                (fp #b0 #b1000010110 #b01000010)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1110111011 #b11111100)
                expect
                (fp #b1 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000000)
                expect
                (fp #b0 #b1010000100 #b01100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
