(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111001110 #b1000)
                arg1
                (fp #b1 #b101111110 #b1111)))
(assert (fp.leq (fp #b1 #b101111110 #b1111)
                arg1
                (fp #b0 #b001101101 #b1110)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100000110 #b1010)
                arg2
                (fp #b0 #b001111110 #b0000)))
(assert (fp.leq (fp #b0 #b001111110 #b0000)
                arg2
                (fp #b0 #b010000011 #b1001)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111110001 #b0101)
                expect
                (fp #b1 #b101111110 #b1110)))
(assert (fp.leq (fp #b1 #b101111110 #b1110)
                expect
                (fp #b0 #b100110000 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
