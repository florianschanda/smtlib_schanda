(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b000111110111111 #b0000)
                arg1
                (fp #b0 #b001011000101011 #b0110)))
(assert (fp.leq (fp #b0 #b001011000101011 #b0110)
                arg1
                (fp #b0 #b101011101000001 #b1111)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b100111101000000 #b1110)
                arg2
                (fp #b1 #b010101001001111 #b1111)))
(assert (fp.leq (fp #b1 #b010101001001111 #b1111)
                arg2
                (fp #b0 #b110010011110111 #b0011)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111010111110010 #b1000)
                expect
                (fp #b1 #b010101001001111 #b1110)))
(assert (fp.leq (fp #b1 #b010101001001111 #b1110)
                expect
                (fp #b0 #b001010010110001 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
