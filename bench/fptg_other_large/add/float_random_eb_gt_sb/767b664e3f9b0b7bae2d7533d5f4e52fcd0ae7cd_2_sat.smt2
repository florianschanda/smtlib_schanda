(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001000001 #b110110)
                arg1
                (fp #b0 #b100000101 #b000111)))
(assert (fp.leq (fp #b0 #b100000101 #b000111)
                arg1
                (fp #b0 #b110011010 #b100100)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111101100 #b101110)
                arg2
                (fp #b1 #b000000001 #b000000)))
(assert (fp.leq (fp #b1 #b000000001 #b000000)
                arg2
                (fp #b0 #b100000110 #b000110)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b001001001 #b011000)
                expect
                (fp #b0 #b100000101 #b000111)))
(assert (fp.leq (fp #b0 #b100000101 #b000111)
                expect
                (fp #b0 #b111111000 #b000011)))

(assert (= expect result))

(check-sat)
(exit)
