(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b0101001101111111 #b001)
                arg1
                (fp #b0 #b1111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000)
                arg1
                (fp #b0 #b1111111111111101 #b011)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0011000110000100 #b011)
                arg2
                (fp #b0 #b0000000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010)
                arg2
                (fp #b0 #b1000110011000111 #b110)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1011110110000101 #b010)
                expect
                (fp #b0 #b1111111111111101 #b001)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b001)
                expect
                (fp #b0 #b1111111111111110 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
