(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b011000111000 #b00)
                arg1
                (fp #b1 #b001111111111 #b00)))
(assert (fp.leq (fp #b1 #b001111111111 #b00)
                arg1
                (fp #b0 #b001110000011 #b11)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b001000010000 #b11)
                arg2
                (fp #b0 #b010011100001 #b01)))
(assert (fp.leq (fp #b0 #b010011100001 #b01)
                arg2
                (fp #b0 #b100110010010 #b11)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b001010010000 #b00)
                expect
                (fp #b0 #b010011100001 #b00)))
(assert (fp.leq (fp #b0 #b010011100001 #b00)
                expect
                (fp #b0 #b011010010011 #b11)))

(assert (= expect result))

(check-sat)
(exit)
