(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00101000000011 #b010)
                arg1
                (fp #b0 #b00000000000000 #b001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b001)
                arg1
                (fp #b0 #b10101111001000 #b011)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01101110101110 #b101)
                arg2
                (fp #b0 #b01111111111111 #b110)))
(assert (fp.leq (fp #b0 #b01111111111111 #b110)
                arg2
                (fp #b0 #b11110011101010 #b111)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111010100011 #b111)
                expect
                (fp #b0 #b01111111111111 #b110)))
(assert (fp.leq (fp #b0 #b01111111111111 #b110)
                expect
                (fp #b0 #b11000000110000 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
