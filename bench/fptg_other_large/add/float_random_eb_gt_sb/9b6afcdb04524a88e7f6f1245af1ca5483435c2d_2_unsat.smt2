(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01011001101001 #b1000)
                arg1
                (fp #b0 #b10011111011000 #b1110)))
(assert (fp.leq (fp #b0 #b10011111011000 #b1110)
                arg1
                (fp #b0 #b10100101100000 #b0111)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b0 #b10001111000001 #b0000)
                arg2
                (fp #b0 #b10111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b1111)
                arg2
                (fp #b0 #b11110001111010 #b1001)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10111110101011 #b1011)
                expect
                (fp #b0 #b10111111111111 #b0000)))
(assert (fp.leq (fp #b0 #b10111111111111 #b0000)
                expect
                (fp #b0 #b11000001101000 #b1110)))

(assert (not (= expect result)))

(check-sat)
(exit)
