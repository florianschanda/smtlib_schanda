(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0001011111 #b011101)
                arg1
                (fp #b0 #b1000000011 #b011000)))
(assert (fp.leq (fp #b0 #b1000000011 #b011000)
                arg1
                (fp #b0 #b1111000101 #b010011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1000000010 #b011010)
                arg2
                (fp #b1 #b0100000000 #b000000)))
(assert (fp.leq (fp #b1 #b0100000000 #b000000)
                arg2
                (fp #b0 #b1100011001 #b001111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111110011 #b000111)
                expect
                (fp #b0 #b1000000011 #b011000)))
(assert (fp.leq (fp #b0 #b1000000011 #b011000)
                expect
                (fp #b0 #b1100001101 #b111010)))

(assert (= expect result))

(check-sat)
(exit)
