; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01010110011 #b101)
                arg1
                (fp #b0 #b10000000011 #b000)))
(assert (fp.leq (fp #b0 #b10000000011 #b000)
                arg1
                (fp #b0 #b10010111100 #b000)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10011000000 #b111)
                arg2
                (fp #b1 #b10000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000011 #b000)
                arg2
                (fp #b1 #b01000001010 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10111001110 #b011)
                expect
                (fp #b1 #b00000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000)
                expect
                (fp #b0 #b11011010001 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
