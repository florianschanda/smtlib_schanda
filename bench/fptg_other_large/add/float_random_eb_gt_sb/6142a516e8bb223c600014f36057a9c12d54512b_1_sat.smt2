; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11011100111100 #b11001100100)
                arg1
                (fp #b0 #b00000000000001 #b00000000000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b00000000000)
                arg1
                (fp #b0 #b11100100000001 #b10000001000)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b01100011010111 #b01010001001)
                arg2
                (fp #b1 #b00111111111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b00111111111010 #b01101010000)
                arg2
                (fp #b0 #b10000011011100 #b10101001111)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b01110010101111 #b01001001101)
                expect
                (fp #b1 #b00111111111010 #b01101001111)))
(assert (fp.leq (fp #b1 #b00111111111010 #b01101001111)
                expect
                (fp #b1 #b00001111110001 #b01010010001)))

(assert (= expect result))

(check-sat)
(exit)
