; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0001011111000 #b1111010)
                arg1
                (fp #b0 #b0011111111100 #b0110101)))
(assert (fp.leq (fp #b0 #b0011111111100 #b0110101)
                arg1
                (fp #b0 #b0100000111011 #b0110001)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1011100000000 #b0100000)
                arg2
                (fp #b0 #b0111111111111 #b0000001)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0000001)
                arg2
                (fp #b0 #b1110000100100 #b1001010)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0101010100001 #b0001111)
                expect
                (fp #b0 #b0111111111111 #b0000001)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0000001)
                expect
                (fp #b0 #b1111010011111 #b1000001)))

(assert (= expect result))

(check-sat)
(exit)
