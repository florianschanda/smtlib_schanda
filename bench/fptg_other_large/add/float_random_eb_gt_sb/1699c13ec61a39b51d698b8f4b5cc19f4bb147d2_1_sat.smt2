;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b000001000100001 #b01001101)
                arg1
                (fp #b0 #b001111111111100 #b00000000)))
(assert (fp.leq (fp #b0 #b001111111111100 #b00000000)
                arg1
                (fp #b0 #b110011111100100 #b01010111)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b011111110010111 #b01010001)
                arg2
                (fp #b1 #b000000000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01111101)
                arg2
                (fp #b0 #b010110110101111 #b00010101)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b111010000001101 #b00011110)
                expect
                (fp #b0 #b001111111111011 #b11111111)))
(assert (fp.leq (fp #b0 #b001111111111011 #b11111111)
                expect
                (fp #b0 #b111011111000010 #b11110110)))

(assert (= expect result))

(check-sat)
(exit)
