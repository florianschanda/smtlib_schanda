(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010101100011 #b00100010)
                arg1
                (fp #b0 #b001111111100 #b00000000)))
(assert (fp.leq (fp #b0 #b001111111100 #b00000000)
                arg1
                (fp #b0 #b100001111110 #b10000101)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b001001101000 #b11110010)
                arg2
                (fp #b0 #b011111111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b00000000)
                arg2
                (fp #b0 #b110011111101 #b00010111)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101101001010 #b00100011)
                expect
                (fp #b0 #b011111111111 #b00000001)))
(assert (fp.leq (fp #b0 #b011111111111 #b00000001)
                expect
                (fp #b0 #b101100000000 #b00100101)))

(assert (= expect result))

(check-sat)
(exit)
