(assert (fp.leq (fp #b0 #b1100000001001100 #b001011)
                arg2
                (fp #b0 #b1101101111001111 #b010001)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0101000000101000 #b110100)
                expect
                (fp #b0 #b1100000001001100 #b001100)))
(assert (fp.leq (fp #b0 #b1100000001001100 #b001100)
                expect
                (fp #b0 #b1110011000010011 #b100001)))

(assert (not (= expect result)))

(check-sat)
