(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000010101 #b1111)
                arg1
                (fp #b0 #b01010001101 #b0011)))
(assert (fp.leq (fp #b0 #b01010001101 #b0011)
                arg1
                (fp #b0 #b10111000010 #b0100)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00010010110 #b0011)
                arg2
                (fp #b1 #b00000000000 #b1110)))
(assert (fp.leq (fp #b1 #b00000000000 #b1110)
                arg2
                (fp #b0 #b01101011011 #b1101)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01000001100 #b0001)
                expect
                (fp #b0 #b01010001101 #b0010)))
(assert (fp.leq (fp #b0 #b01010001101 #b0010)
                expect
                (fp #b0 #b10001010110 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
