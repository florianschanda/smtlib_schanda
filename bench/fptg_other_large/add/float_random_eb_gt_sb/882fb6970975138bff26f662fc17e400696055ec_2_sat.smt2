; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00010110001 #b1101100)
                arg1
                (fp #b0 #b01101111001 #b1110110)))
(assert (fp.leq (fp #b0 #b01101111001 #b1110110)
                arg1
                (fp #b0 #b11001000010 #b0101100)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00010001010 #b1100100)
                arg2
                (fp #b1 #b00000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000001)
                arg2
                (fp #b0 #b00100010110 #b1010000)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00011110111 #b0101111)
                expect
                (fp #b0 #b01101111001 #b1110110)))
(assert (fp.leq (fp #b0 #b01101111001 #b1110110)
                expect
                (fp #b0 #b11010111101 #b1100110)))

(assert (= expect result))

(check-sat)
(exit)
