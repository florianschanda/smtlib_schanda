(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111011101010111 #b11001)
                arg1
                (fp #b1 #b010000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b00000)
                arg1
                (fp #b0 #b011011010010010 #b01011)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b110111000010110 #b01110)
                arg2
                (fp #b0 #b000000000000001 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b00000)
                arg2
                (fp #b0 #b110101000111001 #b00100)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101111110110100 #b11000)
                expect
                (fp #b1 #b001111111111111 #b11111)))
(assert (fp.leq (fp #b1 #b001111111111111 #b11111)
                expect
                (fp #b0 #b101100000011001 #b01001)))

(assert (= expect result))

(check-sat)
(exit)
