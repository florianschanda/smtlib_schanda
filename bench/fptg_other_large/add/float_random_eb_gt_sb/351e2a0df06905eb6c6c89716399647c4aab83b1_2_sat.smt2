(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b0 #b00010101100000 #b1)
                arg1
                (fp #b0 #b10000000000001 #b0)))
(assert (fp.leq (fp #b0 #b10000000000001 #b0)
                arg1
                (fp #b0 #b11010000111011 #b1)))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b10011100011110 #b0)
                arg2
                (fp #b0 #b00000000000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1)
                arg2
                (fp #b0 #b00001110010111 #b1)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b10110110010011 #b1)
                expect
                (fp #b0 #b10000000000001 #b1)))
(assert (fp.leq (fp #b0 #b10000000000001 #b1)
                expect
                (fp #b0 #b10011111010100 #b0)))

(assert (= expect result))

(check-sat)
(exit)
