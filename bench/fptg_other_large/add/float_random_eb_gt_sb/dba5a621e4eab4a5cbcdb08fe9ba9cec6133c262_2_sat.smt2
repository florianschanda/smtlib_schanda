; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110101010 #b11100)
                arg1
                (fp #b0 #b0000000001 #b00000)))
(assert (fp.leq (fp #b0 #b0000000001 #b00000)
                arg1
                (fp #b0 #b0110111010 #b10101)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0110100000 #b10101)
                arg2
                (fp #b0 #b1000000100 #b00011)))
(assert (fp.leq (fp #b0 #b1000000100 #b00011)
                arg2
                (fp #b0 #b1111011101 #b11010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011000001 #b11100)
                expect
                (fp #b0 #b1000000100 #b00100)))
(assert (fp.leq (fp #b0 #b1000000100 #b00100)
                expect
                (fp #b0 #b1101001110 #b00001)))

(assert (= expect result))

(check-sat)
(exit)
