                arg2
                (fp #b0 #b0000000000001 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000001 #b000000)
                arg2
                (fp #b0 #b1111011000000 #b000100)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b0 #b0101010101011 #b110100)
                expect
                (fp #b0 #b0111111111111 #b000100)))
(assert (fp.leq (fp #b0 #b0111111111111 #b000100)
                expect
                (fp #b0 #b1101101110100 #b100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
