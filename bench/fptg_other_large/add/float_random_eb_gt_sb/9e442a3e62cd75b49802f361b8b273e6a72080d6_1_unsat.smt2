;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b0 #b0100001010111 #b010000)
                arg1
                (fp #b0 #b0111111111111 #b000100)))
(assert (fp.leq (fp #b0 #b0111111111111 #b000100)
                arg1
