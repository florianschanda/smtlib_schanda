(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110111111 #b0101101)
                arg1
                (fp #b1 #b101111110 #b1111111)))
(assert (fp.leq (fp #b1 #b101111110 #b1111111)
                arg1
                (fp #b0 #b100010011 #b1110110)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b001001111 #b1100001)
                arg2
                (fp #b0 #b100000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000111 #b0000000)
                arg2
                (fp #b0 #b111111000 #b0101010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111001000 #b1000101)
                expect
                (fp #b1 #b101111110 #b1111110)))
(assert (fp.leq (fp #b1 #b101111110 #b1111110)
                expect
                (fp #b1 #b100111011 #b0001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
