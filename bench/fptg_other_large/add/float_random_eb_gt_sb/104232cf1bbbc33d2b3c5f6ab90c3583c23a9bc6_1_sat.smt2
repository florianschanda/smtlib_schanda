; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101001000 #b0001100)
                arg1
                (fp #b0 #b000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b000000001 #b0000000)
                arg1
                (fp #b0 #b001011110 #b1110101)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011110000 #b1100001)
                arg2
                (fp #b1 #b000000000 #b1111111)))
(assert (fp.leq (fp #b1 #b000000000 #b1111111)
                arg2
                (fp #b0 #b010001011 #b0011011)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010111011 #b1001011)
                expect
                (fp #b0 #b000000000 #b0000001)))
(assert (fp.leq (fp #b0 #b000000000 #b0000001)
                expect
                (fp #b0 #b111011111 #b1100101)))

(assert (= expect result))

(check-sat)
(exit)
