(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -ONE

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11100100100 #b0001)
                arg1
                (fp #b1 #b01111111111 #b0111)))
(assert (fp.leq (fp #b1 #b01111111111 #b0111)
                arg1
                (fp #b0 #b10100101101 #b0110)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11010001110 #b1100)
                arg2
                (fp #b1 #b01111111111 #b0000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000)
                arg2
                (fp #b1 #b00111001111 #b0011)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11100101001 #b0011)
                expect
                (fp #b1 #b10000000000 #b0011)))
(assert (fp.leq (fp #b1 #b10000000000 #b0011)
                expect
                (fp #b1 #b00000010101 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
