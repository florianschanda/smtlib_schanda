(assert (fp.leq (fp #b0 #b0111000111011 #b0010)
                arg2
                (fp #b0 #b1001111100111 #b1110)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1000111111011 #b0011)
                expect
                (fp #b0 #b0111000111011 #b0010)))
(assert (fp.leq (fp #b0 #b0111000111011 #b0010)
                expect
                (fp #b0 #b1100011001111 #b1000)))

(assert (= expect result))

(check-sat)
