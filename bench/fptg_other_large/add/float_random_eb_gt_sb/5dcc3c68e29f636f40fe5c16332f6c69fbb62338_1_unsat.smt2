; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: ADD
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11101001011111 #b00000001)
                arg1
                (fp #b1 #b11001011010000 #b10101000)))
(assert (fp.leq (fp #b1 #b11001011010000 #b10101000)
                arg1
                (fp #b0 #b11110011110101 #b10010010)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10111010101110 #b00100101)
                arg2
                (fp #b0 #b00000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000001)
                arg2
                (fp #b0 #b11011111010111 #b11101110)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11111001001011 #b10000010)
                expect
                (fp #b1 #b11001011010000 #b10100111)))
(assert (fp.leq (fp #b1 #b11001011010000 #b10100111)
                expect
                (fp #b0 #b10101010100010 #b01000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
