(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b110010010100100 #b100001101110101100001000101111111101111010101000011111100010110)
                arg1
                (fp #b1 #b000000000000000 #b111111111111111111111111111111111111111111111111111111111111111)))
