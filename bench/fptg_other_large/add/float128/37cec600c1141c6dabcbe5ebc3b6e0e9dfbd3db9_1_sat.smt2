;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b100100000001001 #b1101011111000011000001010110101110010101100000110110111011100110010111111010011100100000010110010110011000101110)
                arg2
                (fp #b1 #b000000000000000 #b1000001010000000110100000001010111101011011000101001111000000110100111111000101011000110001101010101101011011111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1000001010000000110100000001010111101011011000101001111000000110100111111000101011000110001101010101101011011111)
                arg2
                (fp #b0 #b111011001001010 #b0011110011001101011101011110110011000101100110101001101111000010100100010100110000011101000110100011010010110010)))

(declare-const result Float128)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
