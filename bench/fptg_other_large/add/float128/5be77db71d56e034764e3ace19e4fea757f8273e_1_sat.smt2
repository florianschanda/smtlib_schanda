(assert (fp.leq (fp #b0 #b011111111111111 #b1100000001001001000111111010001010001001010001000011101111100110010101000010110000010111000000000010100110111001)
                arg2
                (fp #b0 #b100000100011011 #b0011111001000111000010011111001001111010001011100011010100110011101111010100101110010001000101000011111000110110)))

(declare-const result Float128)
(assert (= result (fp.add rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
