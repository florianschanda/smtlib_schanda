(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b111011111 #b0010)
                arg1
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg1
                (fp #b0 #b001110101 #b0111)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.abs arg1)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110011100 #b0110)
                expect
                (fp #b0 #b000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000)
                expect
                (fp #b0 #b100011001 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
