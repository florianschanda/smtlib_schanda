; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO

; Redundancy: True
; Validation for: ABS
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10110111111 #b0111000100)
                arg1
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                arg1
                (fp #b0 #b11011110100 #b0110010000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.abs arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11000011010 #b1100110010)
                expect
                (fp #b0 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b10111001101 #b0001111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
