                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b0 #b00000101011 #b1011111101110010010110011000100010000000010111001011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110111001 #b1010111110000100101101110101110100011111000100001010)
                expect
                (fp #b0 #b00000000000 #b1001100000101111110111111101011001111000111110011011)))
(assert (fp.leq (fp #b0 #b00000000000 #b1001100000101111110111111101011001111000111110011011)
                expect
                (fp #b0 #b10000010011 #b0000001000001101101011011111010100100001000000111010)))

(assert (= expect result))

(check-sat)
(exit)
