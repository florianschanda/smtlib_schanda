                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b11001100001 #b0010111101010111000110101001010101110101010100101111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010110010 #b0111111110111101000110101000111100010111010001010001)
                expect
                (fp #b1 #b00001010001 #b0000010101000101100011001001010100111000111110000011)))
(assert (fp.leq (fp #b1 #b00001010001 #b0000010101000101100011001001010100111000111110000011)
                expect
                (fp #b0 #b10100000100 #b1001010000101111000110010000111001101000001101010011)))

(assert (= expect result))

(check-sat)
(exit)
