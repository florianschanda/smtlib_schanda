(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000010010 #b0110001010011111111100101101010100111001001110111100)
                arg1
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110111010 #b0011101001110110001111011001100111000101100010011000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011010011 #b1100010011111000111111000101101110001111000101111010)
                arg2
                (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)))
(assert (fp.leq (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)
                arg2
                (fp #b1 #b00100001000 #b1111100011000110100010100010111000100101110000001110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001001010 #b0011011111001011111000111010100001011100101110100000)
                expect
                (fp #b1 #b00111000110 #b0010011111010110100101010111011001010000000111101001)))
(assert (fp.leq (fp #b1 #b00111000110 #b0010011111010110100101010111011001010000000111101001)
                expect
                (fp #b0 #b00001001111 #b0001111010000100011111100101001000001110000110111110)))

(assert (= expect result))

(check-sat)
(exit)
