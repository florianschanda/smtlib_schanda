; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001111010 #b1000001100100000001101100111111111101101011011100000)
                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b11100111111 #b0110001100100110110110000011011101001000111010011111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
