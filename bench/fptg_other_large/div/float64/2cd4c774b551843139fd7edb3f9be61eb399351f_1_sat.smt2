                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11011011010 #b0010011110100101110101101001111001011000000101111010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101111001 #b0111000001011101011011001011000011100001000100111101)
                expect
                (fp #b0 #b00000110110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000110110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00100001110 #b0101110001101100010110001011010111100011101001000101)))

(assert (= expect result))

(check-sat)
(exit)
