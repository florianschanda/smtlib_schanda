                arg2
                (fp #b0 #b01011101111 #b1000101101000111100011111110000001010001101110001110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01011011010 #b1111010110001100101000010111001011011100111011100101)
                expect
