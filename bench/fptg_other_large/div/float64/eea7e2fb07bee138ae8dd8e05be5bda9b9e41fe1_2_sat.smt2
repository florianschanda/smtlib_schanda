(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000110011 #b0100010011110010111000010010011010111111001101001101)
                arg2
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100001000 #b1110111010000111001110010010111010101100100000000011)
                expect
                (fp #b0 #b00000110011 #b0000010000110011001001010110110101100011111110100001)))
(assert (fp.leq (fp #b0 #b00000110011 #b0000010000110011001001010110110101100011111110100001)
                expect
                (fp #b0 #b00101010100 #b0101000111100110110001111001000100011011100000111101)))

(assert (= expect result))

(check-sat)
(exit)
