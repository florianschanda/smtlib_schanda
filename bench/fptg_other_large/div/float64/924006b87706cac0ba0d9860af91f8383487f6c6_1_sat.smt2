                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11001110111 #b0111011001000101010011011010101001101111111111100010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101001101 #b0010010001110001011110011110010101101000000101110100)
                expect
                (fp #b1 #b10000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11001001010 #b0000110001110010100101111111101100010011010001110110)))

(assert (= expect result))

(check-sat)
(exit)
