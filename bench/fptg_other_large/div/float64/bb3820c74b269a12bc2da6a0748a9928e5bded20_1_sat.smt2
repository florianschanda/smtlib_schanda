; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00011110101 #b1000110001100010110111010000101010000000000011001111)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b01100000111 #b0100101101010011011010101110010001100000000111100001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10101001101 #b1101001010011101110010000110100001011000110110100110)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b00000011010 #b1010001001001001000001010111111010100111001010010100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00011011111 #b1011111010101111010110100110010111100011111110010100)
                expect
                (fp #b0 #b01111001011 #b1111011000101101111010100001000001011100001010010111)))
(assert (fp.leq (fp #b0 #b01111001011 #b1111011000101101111010100001000001011100001010010111)
                expect
                (fp #b0 #b10100101100 #b1110001110111000111011001011111000011001010101000100)))

(assert (= expect result))

(check-sat)
(exit)
