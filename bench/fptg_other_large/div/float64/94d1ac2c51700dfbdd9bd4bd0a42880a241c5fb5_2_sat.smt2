; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001110100 #b0100000101111010100000110100011000101011000110000011)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01001101001 #b1111001001101101111011100101000110111111011110110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00111110010 #b0110100000110011011100111110011101110111000101100110)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b10001001010 #b1101010001111010111100001100001010111000001011000110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010110000 #b1101101100011100111100110101111110001011010010111111)
                expect
                (fp #b1 #b10111111111 #b0010101111000111100000110011001011010010101000111100)))
(assert (fp.leq (fp #b1 #b10111111111 #b0010101111000111100000110011001011010010101000111100)
                expect
                (fp #b0 #b01110100111 #b1100010010100011100110110100001111111110110001101100)))

(assert (= expect result))

(check-sat)
(exit)
