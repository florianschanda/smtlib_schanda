(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b01010111011 #b0011110100001010000101011000101001110010000110001110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01000011101 #b0111111010100001000101110111001001100000001110110011)
                expect
