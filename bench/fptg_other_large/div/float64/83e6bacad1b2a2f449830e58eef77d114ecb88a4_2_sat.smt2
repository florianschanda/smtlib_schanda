; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100000011 #b0100100101110010110100100110100100001111111111100000)
                arg1
                (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)
                arg1
                (fp #b0 #b11000100110 #b1010111100100101010001100010101101000100100010100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00100111001 #b0010010000101100100010110111010001011101000110011100)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10011011110 #b0101101101101011011110111010000110101001000001010111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011011110 #b1001000101000011011011111110001000111010001011011111)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b00011001010 #b1100111000110100011010000010100100110111101011010000)))

(assert (= expect result))

(check-sat)
(exit)
