                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b01101011000 #b1100010011100111010000001010100010111100110111111101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011001111 #b1100010100010011101000010111100111001100010101010101)
                expect
                (fp #b0 #b00111111111 #b0001110111001111011000100111110110000000000000001001)))
(assert (fp.leq (fp #b0 #b00111111111 #b0001110111001111011000100111110110000000000000001001)
                expect
                (fp #b0 #b10011110001 #b1011101100101001111011000110010110000010100101111100)))

(assert (= expect result))

(check-sat)
(exit)
