; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000000001 #b1001011110100101111001001000011101011001110101011111)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01011011011 #b1110100000001111011101101111100011111111010110111011)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00101011000 #b0100111010011010111010000111000100111010101111111001)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000100011 #b1100100010101100101010101010000000101001001100111101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
