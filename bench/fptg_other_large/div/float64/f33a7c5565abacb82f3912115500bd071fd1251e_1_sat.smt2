; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01001101000 #b1001000000110011110001110101101100100011011001101110)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b11111111001 #b0100111000111101101101011111100011001111100111110010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00111001011 #b0011100000101101111100111110100010010010100101110100)
                arg2
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                arg2
                (fp #b0 #b11101011010 #b1111011011000110110110101000110010010010100000101000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00001011011 #b1000010110000010000001010011011000110011010110110001)
                expect
                (fp #b0 #b01001111001 #b0110100001101111100001010100100110001100010000011000)))
(assert (fp.leq (fp #b0 #b01001111001 #b0110100001101111100001010100100110001100010000011000)
                expect
                (fp #b0 #b01010111010 #b1100100111001011111000110100011001001110110000011010)))

(assert (= expect result))

(check-sat)
(exit)
