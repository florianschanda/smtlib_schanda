(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010111010 #b1000110101000111011011110011001001000010010101100010)
                expect
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10011101100 #b1100101111011110111110001110011100100111100000001010)))

(assert (= expect result))

(check-sat)
(exit)
