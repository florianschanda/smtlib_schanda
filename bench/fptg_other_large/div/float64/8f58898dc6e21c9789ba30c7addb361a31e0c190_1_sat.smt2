                (fp #b0 #b11011000001 #b1100100001001110100111110001001000110101011000011100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010110001 #b0101010000111111100000101101010010100110001111000011)
