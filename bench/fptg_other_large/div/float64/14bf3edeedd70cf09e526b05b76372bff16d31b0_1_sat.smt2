; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110011001 #b1101000111010010110000000110101111111111110001101110)
                arg1
                (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)
                arg1
                (fp #b0 #b10111001011 #b0010111100110001101111010010010000110101001101111010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011010001 #b0011100110011100110110110110010000100000011101101110)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00000001101 #b1100101011101100010010110111000011101101110001111000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111011101 #b1100001010000001000011011001001110110011001010010011)
                expect
                (fp #b0 #b10010000001 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b0 #b10010000001 #b1001010101101111110010101001101111101101000000101011)
                expect
                (fp #b0 #b11010101010 #b0001100101100101000001110100011010100100110001111101)))

(assert (= expect result))

(check-sat)
(exit)
