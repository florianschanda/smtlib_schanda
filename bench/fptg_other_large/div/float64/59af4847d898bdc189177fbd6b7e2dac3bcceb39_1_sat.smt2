                arg2
                (fp #b0 #b10011110101 #b1111100111001000011101010111001011100100001010111111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001000110 #b1011001101110011101010110011101111010110001111101101)
                expect
                (fp #b0 #b01111111111 #b1000000100110011001001001100010011001101101000101110)))
(assert (fp.leq (fp #b0 #b01111111111 #b1000000100110011001001001100010011001101101000101110)
                expect
                (fp #b0 #b11110011101 #b1101010000010000000110011110111000101000000101011001)))

(assert (= expect result))

(check-sat)
(exit)
