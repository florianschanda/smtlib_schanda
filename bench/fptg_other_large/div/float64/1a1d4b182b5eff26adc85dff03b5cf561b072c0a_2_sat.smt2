; Format: FLOAT64
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01010010000 #b1010000111011010100011011000010011101101001101101001)
                arg1
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110000010 #b0010111110111101001100011000111101000000100000111011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00110011011 #b1010111000110010011001100011011011011111101010101100)
                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b11111011011 #b1100010110010001001001110111110101001101100010110011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111101011 #b0001010000000110111001100110011000010111000010101110)
                expect
                (fp #b0 #b01010000101 #b0000010101000101100011001001010100111000111110000100)))
(assert (fp.leq (fp #b0 #b01010000101 #b0000010101000101100011001001010100111000111110000100)
                expect
                (fp #b0 #b10000000001 #b0010111011110000110101001010001001010111101111001101)))

(assert (= expect result))

(check-sat)
(exit)
