                arg2
                (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)))
(assert (fp.leq (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)
                arg2
                (fp #b0 #b00000110111 #b1111110001001000001010110011000110010001100001010100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010100000 #b1100100010011001000010101110101010010100001111000111)
                expect
                (fp #b0 #b11011011111 #b0100111101010101000010100010100011010011101001111010)))
(assert (fp.leq (fp #b0 #b11011011111 #b0100111101010101000010100010100011010011101001111010)
                expect
                (fp #b0 #b11111100010 #b0001000100111111111001011101101001100100100000011011)))

(assert (= expect result))

(check-sat)
(exit)
