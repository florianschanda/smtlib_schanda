; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00000010011 #b0010011101011001000001100110111111011001110100000011)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10000111100 #b0000000101011001010000110000010011010010010010111011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010010111 #b0111110100110010110100101000100001111101000101111101)
                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b11101000001 #b1011111010100101011000110001010010000100111111110110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101101001 #b0010111101000101000100000111111010010101010111110010)
                expect
                (fp #b1 #b00111100101 #b0001110111001111011000100111110110000000000000001000)))
(assert (fp.leq (fp #b1 #b00111100101 #b0001110111001111011000100111110110000000000000001000)
                expect
                (fp #b1 #b00010001100 #b0010101111110001010110001100010110100000000000011111)))

(assert (= expect result))

(check-sat)
(exit)
