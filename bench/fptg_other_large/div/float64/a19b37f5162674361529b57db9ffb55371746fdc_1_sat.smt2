(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111111100 #b0101000110100101101011101011011010110010000001101010)
                arg1
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)
                arg1
                (fp #b0 #b11101001111 #b1101010111100000101011110111100111100101010000101110)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00101101100 #b0000110000011001100011100110110001010101100100000000)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11110101111 #b1001010000011100001110100010000110000110110111011001)))

(assert (= expect result))

(check-sat)
(exit)
