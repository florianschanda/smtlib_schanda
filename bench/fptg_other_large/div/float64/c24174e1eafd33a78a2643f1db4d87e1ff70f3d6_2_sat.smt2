                arg2
                (fp #b0 #b10100011011 #b0101011101001010011111000101111110001110010100001110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101000011 #b1000100000111011111101001100000101101110010111101101)
                expect
