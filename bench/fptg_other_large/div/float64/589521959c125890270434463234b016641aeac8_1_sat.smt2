                (fp #b0 #b10011000010 #b1000001000000010000100100101101100101101010110001111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00001100111 #b0101001100001010101101100000010001110111100101000111)
