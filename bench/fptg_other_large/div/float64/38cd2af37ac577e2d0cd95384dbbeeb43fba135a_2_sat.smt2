; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01111100001 #b1011011010111100010000010101111101101110000110010101)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10101100110 #b1101011000110101010101001000111001010010101100000001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100100011 #b0010110100010000010100010110010101010011011100111101)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b01000000111 #b1010101010111111100100001011111110001110000100001101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001011100 #b1110100001100100100110111101011111011000000010101101)
                expect
                (fp #b1 #b10111111110 #b1000000100110011001001001100010011001101101000110000)))
(assert (fp.leq (fp #b1 #b10111111110 #b1000000100110011001001001100010011001101101000110000)
                expect
                (fp #b1 #b00101111001 #b1111101101001000011110000010101100100111100110101101)))

(assert (= expect result))

(check-sat)
(exit)
