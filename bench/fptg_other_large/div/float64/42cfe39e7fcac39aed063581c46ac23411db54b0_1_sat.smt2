(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101001101 #b0011101111001011110010100011100101010100100100001110)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b00101110110 #b1101101110000111100101111010001000111110100100100000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111110001 #b0100110011100100101010010111101011000110001001011110)
                arg2
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b1 #b10100011111 #b1110110010111111001110111101000101110001001000010100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01001011011 #b0010011000100101100000111000111110110000001101000000)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00010010000 #b0110110110011011110001111111001100011010111100001111)))

(assert (= expect result))

(check-sat)
(exit)
