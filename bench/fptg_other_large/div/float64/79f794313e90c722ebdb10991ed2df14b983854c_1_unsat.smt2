(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b10101011111 #b0001001110000110001011000110110000000001000001110110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110111111 #b1001101111010000101010000010111111010100000110000111)
                expect
                (fp #b1 #b00100101110 #b0010100010011000111000001100001110110010100000001011)))
(assert (fp.leq (fp #b1 #b00100101110 #b0010100010011000111000001100001110110010100000001011)
                expect
                (fp #b0 #b11100011111 #b0000101001100000111111100110011010001111100010011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
