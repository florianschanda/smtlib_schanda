; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010001110 #b1011111110010111100011110101111100111100010100001000)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11000101000 #b0000000110100111010000110010010110101100000111111101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011111001 #b0010010001001101001100011011011101010111001011001000)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b0 #b01110001110 #b1100111111000010101110010101010001101110001010101110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100000010 #b1001111110110110100011000110101111011101100000000010)
                expect
                (fp #b0 #b00111001101 #b0010110011110010110100010000100000001110001001000000)))
(assert (fp.leq (fp #b0 #b00111001101 #b0010110011110010110100010000100000001110001001000000)
                expect
                (fp #b0 #b01111011101 #b1010011000010110010100011010000101111111111011000101)))

(assert (= expect result))

(check-sat)
(exit)
