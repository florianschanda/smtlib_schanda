; Format: FLOAT64
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001101001 #b0111110001010101111011000011110100001100001001110001)
                arg1
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10111101100 #b1110101010001011100111101001011010000100100001011001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110101110 #b1111111101110011011000011101000000101101111011010100)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b1 #b00100011101 #b0100101011100101001101001111110100010101111011010101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010110111 #b1011010010111001011111101011110001011101101111100011)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10011010011 #b0100000110000100101101011001101000010000010010111110)))

(assert (= expect result))

(check-sat)
(exit)
