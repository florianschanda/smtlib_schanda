(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -INFINITY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01000101100 #b1111000101111100110000110010000111101001101001001001)
                arg1
                (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)
                arg1
                (fp #b0 #b10001001100 #b1110101100010000110100111100000101110110110110011010)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00110000011 #b0011000111111100111110110110000010001100100011011110)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00111010101 #b1100000110010101000001010110110101011010000110010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
