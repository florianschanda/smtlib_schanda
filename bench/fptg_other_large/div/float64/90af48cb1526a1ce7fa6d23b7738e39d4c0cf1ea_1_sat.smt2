; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100001111 #b0110110100100111101110101000011001011110011001001010)
                arg1
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg1
                (fp #b0 #b00101010011 #b0010111100010000000011111100010010000100001000010100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101001001 #b1100101110100001011011111001110011110011010100100011)
                arg2
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011011111 #b0101100001110110001011101101010101010011101000101010)
                expect
                (fp #b1 #b00000000000 #b0101101011011011001101101011101011010100001010000111)))
(assert (fp.leq (fp #b1 #b00000000000 #b0101101011011011001101101011101011010100001010000111)
                expect
                (fp #b0 #b00100111110 #b0000001011110111111011001110111111100000010000101011)))

(assert (= expect result))

(check-sat)
(exit)
