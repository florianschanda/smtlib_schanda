; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100111110 #b1001101010001110101010001010101010010110101100100010)
                arg1
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)
                arg1
                (fp #b0 #b10100011000 #b0010111100100110111001000101011010110010110111100101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01010111001 #b0011010101111100111000111110010110001101011110110111)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b00011010110 #b0110110110110100001100011001011100010111111010101010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10010111001 #b1110111100011000100001100100100110000110100001110000)
                expect
                (fp #b0 #b11111111110 #b0010001111100000001011001000001110001000111000100001)))
(assert (fp.leq (fp #b0 #b11111111110 #b0010001111100000001011001000001110001000111000100001)
                expect
                (fp #b0 #b11111111110 #b1000000001000101100001011000001100011011010000000011)))

(assert (= expect result))

(check-sat)
(exit)
