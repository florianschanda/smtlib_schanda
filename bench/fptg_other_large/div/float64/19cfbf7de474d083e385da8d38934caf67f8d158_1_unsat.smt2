(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110101011 #b0111101110101101110000010001111100101110001011100110)
                arg2
                (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)))
(assert (fp.leq (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)
                arg2
                (fp #b1 #b01001101100 #b0111000011110110111000110110000100111001111001001001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00011000101 #b1001011111110101010101011100110001000000000000001001)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10101111110 #b0010011110111010001101000101010010100000100000110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
