; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010011101 #b0101101110101110110000011101011110000000001110000000)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b11100100110 #b1101000111001000100010111000111000001001100000001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11000011111 #b1000101000111101110100001001011000001011111101111001)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b01101001100 #b1110110000100000001101001001111011111011000111011100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01001000010 #b1000001001110110100101100001001011010001110100110000)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00111001100 #b1100101000000010110000111111000011100010011110101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
