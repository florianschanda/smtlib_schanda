(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110011000 #b0011111111001110000111100100000101100100111111100110)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10111010110 #b1010011110011100001001101111001011111010000001011011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101110111 #b0111010000110111111000011111111101100100111110011001)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b1 #b01010110100 #b0011101100010100111011111100101101111011110010000011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001111011 #b1111010101000101000001101010101100101011000001111010)
                expect
                (fp #b1 #b00110110011 #b0010110011110010110100010000100000001110001001000000)))
(assert (fp.leq (fp #b1 #b00110110011 #b0010110011110010110100010000100000001110001001000000)
                expect
                (fp #b0 #b10001000010 #b1110100011111111000000001011111011100000001100000110)))

(assert (= expect result))

(check-sat)
(exit)
