; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110101110 #b0101001001011001010110011010011101110101010100111001)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b11011100011 #b1011110010101011110111000010001101010001001101000001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100100111 #b0011100000001000001101111011011000000110000001011001)
                arg2
                (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)))
(assert (fp.leq (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)
                arg2
                (fp #b0 #b10010001101 #b0100010100110101001111001010100101110000001011101110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010010100 #b0110111001101011011010000010100100110011011111111110)
                expect
                (fp #b1 #b00111101101 #b0011100110010011001010110001101000010010101001010101)))
(assert (fp.leq (fp #b1 #b00111101101 #b0011100110010011001010110001101000010010101001010101)
                expect
                (fp #b0 #b00101000000 #b0101001101100101111100000010101000011001000111110010)))

(assert (= expect result))

(check-sat)
(exit)
