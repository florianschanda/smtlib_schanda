                arg1
                (fp #b0 #b11111000100 #b1100011100011001110001010011011101100101100110100000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01010011110 #b1111000111010100100010101111011000000011010100100101)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b10111010011 #b0001101010000110001110100000101011101100011111101000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100110000 #b1101011011110010000100111000000011111110001011000011)
                expect
                (fp #b0 #b10011010000 #b0011101101011001001011000000001000111101100000000101)))
(assert (fp.leq (fp #b0 #b10011010000 #b0011101101011001001011000000001000111101100000000101)
                expect
                (fp #b0 #b11000011101 #b0111011011010101000111011000100011000011010011111001)))

(assert (= expect result))

(check-sat)
(exit)
