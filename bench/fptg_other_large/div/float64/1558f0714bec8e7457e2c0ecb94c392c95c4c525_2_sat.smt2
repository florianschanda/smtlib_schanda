(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01111111100 #b0001010000011001011000111101101101011011010010001010)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01101101100 #b1100000001101101110011011011001111001010101110000011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00111011100 #b1100110010110010110101101101100010000010001110100111)
                arg2
                (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)))
(assert (fp.leq (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)
                arg2
                (fp #b0 #b01000000001 #b1000101001100110110001000000110000111101010000101100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111011100 #b1110000000011001001101100000111001001111110000101101)
                expect
                (fp #b0 #b10010010001 #b0100111101010101000010100010100011010011101001111011)))
(assert (fp.leq (fp #b0 #b10010010001 #b0100111101010101000010100010100011010011101001111011)
                expect
                (fp #b0 #b11100010000 #b0001011000101101000111101000000110000001001001101001)))

(assert (= expect result))

(check-sat)
(exit)
