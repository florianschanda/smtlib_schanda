(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00110011000 #b1011110101001010101101101000011100011001011010010000)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11001001110 #b1101101011100000011101110101000111101111111110101000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001111100 #b0111000001011001110101101111101110100110011110100111)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b01001110000 #b0110111101100111000001000110001101010101010101000100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
