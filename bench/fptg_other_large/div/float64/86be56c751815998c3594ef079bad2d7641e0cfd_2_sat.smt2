                arg2
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b00011010011 #b0101111000111010001010000001011011011111101001110001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110101010 #b1111101010101111110110010010111010111110000100000100)
                expect
                (fp #b0 #b10111111101 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b10111111101 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11011001001 #b0001011100000101000100110000101010110000000110000110)))

(assert (= expect result))

(check-sat)
