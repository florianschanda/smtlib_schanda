(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011001001 #b1011000100010111000101001011100101000100111000111101)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b00100101100 #b1001110011001101011001111111101000000000000000100111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101101100 #b1101110100001100100011010111001110010111110100101100)
                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b10111110001 #b1001000010011000010101000101110011010010011011011111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00010101010 #b1001000010110101110100001111011000000111100100100010)
                expect
                (fp #b0 #b00000100111 #b0011011000100100111010011100111001110011000100110100)))
(assert (fp.leq (fp #b0 #b00000100111 #b0011011000100100111010011100111001110011000100110100)
                expect
                (fp #b0 #b11011100000 #b1100011111010101101000111001101100110111100010110111)))

(assert (= expect result))

(check-sat)
(exit)
