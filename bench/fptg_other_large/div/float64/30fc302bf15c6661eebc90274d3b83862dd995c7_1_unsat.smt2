(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001000011 #b1011001010111001101010110000010000000100010110000100)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b10010111001 #b1000101000101111110000010000011111010000100001001111)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00100001101 #b1011011001001000000101111010110000101000101000111010)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11001011010 #b0000110100001010101010100111101001111010101000000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
