(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110100110 #b1010010000100000100110000010101101001010101001100000)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10110100000 #b1011111000011101100100001000101101110010011010000100)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b10010011111 #b0011110000111100001101111001101011110010001011000111)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11110111010 #b1110101100000110100100100001100011010110001011111111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
