(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -ZERO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01000000110 #b1000001000000001111000101000001110100010101011001001)
                arg1
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                arg1
                (fp #b0 #b10010010001 #b1000111001000001101100011101011101001001110011110001)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01101101111 #b0010100100110110011011001111111100100010001111110010)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100110000 #b1001001111111101110101001000001100010001101000111110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
