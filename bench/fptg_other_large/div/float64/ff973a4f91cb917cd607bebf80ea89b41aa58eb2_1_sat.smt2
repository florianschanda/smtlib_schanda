; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b10010101000 #b0010111010111100100110101111001011001111100100011011)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11101110111 #b1101110111101001001101011100001100011011000011010000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000010100 #b1110001111010111101011100011101111001000010101000011)
                arg2
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01100111100 #b0010011101100010100001111010111000011110010111001110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101001000 #b0100101000001101110101011100000101101110100111011111)
                expect
                (fp #b1 #b11011111110 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b1 #b11011111110 #b1111010100011001100100010111000110110110111011011000)
                expect
                (fp #b0 #b10000001100 #b0011010110011110000100110010010100001110111111010111)))

(assert (= expect result))

(check-sat)
(exit)
