; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00001011101 #b1101000111110100101111010000011011110001100010111011)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b10100110000 #b1101001111011100001010011101100000010011001000001110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111010001 #b0011101111011110011111110001101011100100100101010000)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b10011001001 #b0100001110111010101011111000101010001010111110000100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010010010 #b0100100100111100110100111111001101110010100001000011)
                expect
                (fp #b0 #b00101100111 #b0100011011101111110011001110011101101111110010000010)))
(assert (fp.leq (fp #b0 #b00101100111 #b0100011011101111110011001110011101101111110010000010)
                expect
                (fp #b0 #b01110001010 #b0101100000001001011111010010111110111010011010110101)))

(assert (= expect result))

(check-sat)
(exit)
