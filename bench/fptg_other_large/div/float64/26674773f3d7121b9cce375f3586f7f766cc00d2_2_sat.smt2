; Format: FLOAT64
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110010010 #b1110110010110011111110100101000101010011010111011110)
                arg1
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111111101 #b1000011110110010001110100011110101000010110001100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101111101 #b0011110101111001111011011011001111101010110000000000)
                arg2
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b0 #b01000111000 #b1011000101010111100101111011000001001000001111001010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111010101 #b0101000100111100110111110101000100111011000001101011)
                expect
                (fp #b1 #b10100001000 #b0001000110010011000001101100010010000010011000111101)))
(assert (fp.leq (fp #b1 #b10100001000 #b0001000110010011000001101100010010000010011000111101)
                expect
                (fp #b1 #b00111100110 #b0101010000010010010010000001101110110101000000011101)))

(assert (= expect result))

(check-sat)
(exit)
