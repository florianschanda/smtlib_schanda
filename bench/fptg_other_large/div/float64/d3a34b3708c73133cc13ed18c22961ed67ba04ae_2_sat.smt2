; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111110000 #b0000100111110010010001100010000100101110101101000011)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b11111101001 #b0100100100010000101100101011010011101110101001000100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001100001 #b0101011001110111010011110100011111011111100000000101)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b00110010111 #b1111011000011001010010101111110111001000110101011001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101110011 #b1110100011101010010110001111010010000001100100011011)
                expect
                (fp #b1 #b01111001011 #b1111011000101101111010100001000001011100001010011000)))
(assert (fp.leq (fp #b1 #b01111001011 #b1111011000101101111010100001000001011100001010011000)
                expect
                (fp #b0 #b10000010001 #b1001111010100100001101001111010110110111011001011000)))

(assert (= expect result))

(check-sat)
(exit)
