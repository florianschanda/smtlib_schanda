; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010011111 #b1010010011000001101111111011011001101111111001010000)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01010111110 #b1101110101001001001011100110011111111010000010010111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011111101 #b1100111000111011101000111101011001110001001000110110)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b01010001010 #b1001111011011010001011010111000001101111110111110101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000000001 #b1000110001000011000010000001001010111010010100000110)
                expect
                (fp #b1 #b10111100100 #b1000000100110011001001001100010011001101101000110000)))
(assert (fp.leq (fp #b1 #b10111100100 #b1000000100110011001001001100010011001101101000110000)
                expect
                (fp #b0 #b01110010101 #b0010011111001000101000100101010100001110111110100011)))

(assert (= expect result))

(check-sat)
(exit)
