(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01000111011 #b1111101000000011001011001000010110100101111110001011)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b01011000001 #b1101100110000010110001111000010110100101010111110110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
