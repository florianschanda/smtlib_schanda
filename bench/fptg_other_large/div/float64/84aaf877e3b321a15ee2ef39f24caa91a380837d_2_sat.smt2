(assert (fp.leq (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)
                arg2
                (fp #b1 #b10111001101 #b0010111011111111010000010001011000001101011001000010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001011001 #b0000111110000010111110001001001011100001000001110101)
                expect
                (fp #b1 #b10110001111 #b0010011111010110100101010111011001010000000111101010)))
