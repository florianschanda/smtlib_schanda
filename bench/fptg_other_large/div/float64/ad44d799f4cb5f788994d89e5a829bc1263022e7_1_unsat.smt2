; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010011011 #b0101000110010001100010100000101110011111110100110111)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b11101101001 #b0110111010000111111010000100010110110001010010011011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b10000110011 #b1011110100010000010000101111001001101100011110100101)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100110101 #b0001011011110010110111100011101000001100101010000111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000111010 #b1110000010110011111101000001010111101111100000110101)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01001100111 #b0110010111110000100011111111001111001001010110111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
