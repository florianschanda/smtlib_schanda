(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011011001 #b1100011111010010100111111101000100101011000100110111)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
