; Format: FLOAT64
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011011001 #b0011000111101100011110010001011000111111000110111101)
                arg1
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01010000001 #b0000110000111110100110111101111111101110001011000100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01010001000 #b0010101010001000011110111011111110111000000101010100)
                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01110110010 #b1100001011001101110011101110101100111000111000001000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b11001110010 #b1100110010101100110110111101100000011000000100110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
