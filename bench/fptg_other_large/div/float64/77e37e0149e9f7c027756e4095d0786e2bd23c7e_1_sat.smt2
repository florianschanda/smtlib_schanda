                arg1
                (fp #b0 #b00010110011 #b0110010011100101011100100100001100011111011101111011)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110100001 #b1000100000001010101010000010001101011010010100110110)
                expect
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010100101 #b0001110101100011110110100011000110011010010110110000)))

(assert (= expect result))

(check-sat)
(exit)
