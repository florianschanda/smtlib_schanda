; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110000101 #b0011100010100101010100000001000110011100111011111011)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100101100 #b0001000110001000001100100111111100110110010100111010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01001111010 #b0100111000110101111000111100001010000101000100110001)
                arg2
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)
                arg2
                (fp #b0 #b11010011111 #b0111100101100001111110100011011101010110000111000011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111011001 #b0011001001101011011011001010101001111010100110100111)
                expect
                (fp #b1 #b00000000000 #b1001000111100011101111111000010110000010001000101100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1001000111100011101111111000010110000010001000101100)
                expect
                (fp #b0 #b01111100010 #b1011111010110010001000010100101111011011001010011001)))

(assert (= expect result))

(check-sat)
(exit)
