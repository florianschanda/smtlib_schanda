; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001100111 #b0011011001101011010011010000001011101110000001111100)
                arg1
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                arg1
                (fp #b1 #b00010111010 #b1111110101010100011000110111101001111010110010101110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01100100000 #b0000101001110000010101111001101100100110001000011010)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b01010100100 #b1000111101010000100001010001110101011001111011000010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
