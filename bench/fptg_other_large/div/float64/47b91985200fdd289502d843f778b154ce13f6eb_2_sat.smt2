; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111110011 #b1000111011001001111010100011111000110000110010100101)
                arg1
                (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)))
(assert (fp.leq (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)
                arg1
                (fp #b0 #b11101001111 #b1100001010000111001111110100011111101111110000011100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00110101001 #b0101000011110000111110001111011111100001011111011001)
                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10010001001 #b0100111110111010110000001011111111001011000100111010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
