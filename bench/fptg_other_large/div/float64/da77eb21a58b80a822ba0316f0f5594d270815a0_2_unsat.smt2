(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000100010 #b0111001001101111011010101110000011110111100111011110)
                arg1
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01111000010 #b0011000111100010101000101001001111111010011110001011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011011001 #b0111001000010101110001010101111101110000010000011001)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11110100100 #b0000100000111001011111100100010011111100000001010011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
