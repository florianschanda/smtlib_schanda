; Format: FLOAT64
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111011 #b1100011011011000110101011000111110000100110000011111)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10001100100 #b0001001110010111010101000011100001010110001011011100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010100001 #b0000000011101010101110100010110011101001011110011111)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b00000001010 #b1100000000111001010001101101010111101101110010001101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011101001 #b1101011100111000000001110000101010101110100101010000)
                expect
                (fp #b1 #b10000110010 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b1 #b10000110010 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b0 #b00111110100 #b1100011000110010011110001111001110001001011010100110)))

(assert (= expect result))

(check-sat)
(exit)
