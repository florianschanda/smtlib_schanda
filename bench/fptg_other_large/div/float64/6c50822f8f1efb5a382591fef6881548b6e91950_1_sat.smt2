; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01001100100 #b0000000111110011111001100100100100110010000011110000)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11101011100 #b1001000100101011100111101011111101010011110001001001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000110011 #b1001100101101110000110100110110110000000110110000011)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b1 #b01101100110 #b1001111010001110000011001101001010110000011101101111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110111111 #b0001000101110100111001110001000100000000101011000111)
                expect
                (fp #b1 #b10011001101 #b0010011010001010101000001110001100110010000010101011)))
(assert (fp.leq (fp #b1 #b10011001101 #b0010011010001010101000001110001100110010000010101011)
                expect
                (fp #b1 #b00001101110 #b0110011001011000001110010110001110010001110001000111)))

(assert (= expect result))

(check-sat)
(exit)
