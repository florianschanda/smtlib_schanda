; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110011101 #b0001001101110001000100101101111101100100101001011110)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b01000001001 #b0011100100101001001101111001111111111001000010110001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010110001 #b1001000000010010101110111001101101111111101001010000)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10110100001 #b0011010110101000011110001000101111110011110010000010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11001000111 #b0001000101001100101110011001110011101101110110011101)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000100001 #b1111011100100000111000001101011011110110010000000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
