(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010011101 #b0010100010000100001001100011001001110101101101100100)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b01101111010 #b0010011101100111111001010000111110010100011111011100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011111101 #b0110011101010100000110100110110110011111101111000101)
                arg2
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01001010110 #b1111000010111111101011111101101010100000110000010100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001111010 #b1001001000000111000011111101001001101110011111111010)
                expect
                (fp #b0 #b01000011001 #b1000100101010101010110111001000010010111000000011000)))
(assert (fp.leq (fp #b0 #b01000011001 #b1000100101010101010110111001000010010111000000011000)
                expect
                (fp #b0 #b11011000110 #b1110011100101101100011111010101100000000010001110001)))

(assert (= expect result))

(check-sat)
(exit)
