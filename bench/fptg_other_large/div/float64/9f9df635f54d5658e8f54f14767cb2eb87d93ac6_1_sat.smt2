(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101000000 #b1000101000000001000011000101110101000101000111111111)
                arg1
                (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)))
