; Format: FLOAT64
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000001010 #b1100100010101010110101000110101100101000101101000010)
                arg1
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11101111100 #b0111001010000010111000110110100001011110110000101111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011111110 #b1111000110101111100101110001011011101011001000010110)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b11010100001 #b1011010001000000010100011011011010010101101000101111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b11100111011 #b0000110110111100001101010110101010001010011011010000)
                expect
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(assert (= expect result))

(check-sat)
(exit)
