; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010100100 #b0110011011000110110101001111011000001000001110110011)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10000111111 #b1101001111110111100000111001000010110010110011111000)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00000011011 #b0011001110111111000011010110111010001101001101111100)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01111101001 #b0101010001101111000011010011000111011000000111111100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
