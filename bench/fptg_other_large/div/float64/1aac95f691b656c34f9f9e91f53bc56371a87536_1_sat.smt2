;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010110110 #b1011100110110011010111000011001000101100100100010110)
                arg1
                (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)
                arg1
                (fp #b0 #b01110111001 #b1101100101000011011000100001011000000010101110001111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01000011111 #b0101000011010010001001110100101010111110100000100010)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b00100100000 #b1011111011110001010000110111101101101100011010111001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010011100 #b0111000001011000000000011011110001001000011001101110)
                expect
                (fp #b1 #b10010000010 #b0011000100000111000011111001101010100010001000010111)))
(assert (fp.leq (fp #b1 #b10010000010 #b0011000100000111000011111001101010100010001000010111)
                expect
                (fp #b1 #b00111111001 #b0111000100110111101100100000110000111000111111101100)))

(assert (= expect result))

(check-sat)
(exit)
