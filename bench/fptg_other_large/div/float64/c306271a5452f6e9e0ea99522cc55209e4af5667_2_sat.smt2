; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111101101 #b1000100001101101011010011011000110011010101101110000)
                arg1
                (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)))
(assert (fp.leq (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)
                arg1
                (fp #b0 #b01100111010 #b0000000011100001010100100001000110001101100000101101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00010001100 #b1110001101100010010011011100100110100110101110011100)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00010100000 #b1011101000000001111001110000101010100101110000101011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
