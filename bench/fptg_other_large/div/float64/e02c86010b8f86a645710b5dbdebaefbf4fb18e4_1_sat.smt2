; Format: FLOAT64
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00001101110 #b1010110100110111001010111101001101110001011000011100)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11001011011 #b1111000100010000100101000001001111111011010000101010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01101011110 #b1110111010000100010011001011111111110010101011010000)
                arg2
                (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)))
(assert (fp.leq (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)
                arg2
                (fp #b0 #b10010010100 #b1010100010110001000101101011100011100111010001111111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01110111111 #b1000100100110000111011000010011001010111100011000010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10001001100 #b0001101110110100100111100100010101111100000100110101)))

(assert (= expect result))

(check-sat)
(exit)
