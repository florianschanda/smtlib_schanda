; Format: FLOAT64
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b11010111001 #b0010110110101011001001011000100010000100101001110111)
                arg1
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001100110 #b0001100111000010001111011100110110011001100000011001)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b1 #b01011101110 #b0100110000110001010010101100010000101111110111011011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111010100 #b0011101110101001011101110001101100000011000000110001)
                expect
                (fp #b1 #b11111001010 #b0011000111011111011000100010111000010010110011110101)))
(assert (fp.leq (fp #b1 #b11111001010 #b0011000111011111011000100010111000010010110011110101)
                expect
                (fp #b1 #b11011001001 #b1111100001111001101000100100101101000101101110011101)))

(assert (= expect result))

(check-sat)
(exit)
