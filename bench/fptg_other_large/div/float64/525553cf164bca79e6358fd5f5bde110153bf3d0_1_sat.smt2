(assert (fp.leq (fp #b1 #b00001010010 #b1100000101101000111111011100111100011110011110100010)
                expect
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000100010 #b1111011010100001011110001100001010001001111111110001)))

(assert (= expect result))

(check-sat)
