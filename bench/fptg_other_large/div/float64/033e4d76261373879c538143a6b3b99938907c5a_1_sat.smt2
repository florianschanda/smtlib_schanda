; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011101100 #b1010100111101110001000110000110011100101100110111111)
                arg1
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg1
                (fp #b0 #b01011010010 #b1000101001001111001001100001101001011000110111000111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011001101 #b0010100010111111000100110111110010001000110011100100)
                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b11010000001 #b0000110100110000100111110100110111101011111011110110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01001111101 #b1101100111111101110100101010101111100110101101001010)
                expect
                (fp #b0 #b01111111110 #b1001010110111110100110001000111011010010101101100111)))
(assert (fp.leq (fp #b0 #b01111111110 #b1001010110111110100110001000111011010010101101100111)
                expect
                (fp #b0 #b11001101001 #b1111100110000110101111010001100100101111010011101100)))

(assert (= expect result))

(check-sat)
(exit)
