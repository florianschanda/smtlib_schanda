; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111110001 #b1100001010110101000011001010101000100000000111110010)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01011000000 #b1000100110111101111001101101010000000000010100100000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01000110101 #b1101111110010111001111110000111001101001010100111110)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b11101011110 #b0110100110100010000000100100111000110110011100010010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001110010 #b1111100000011001110010111111010100011111100101110100)
                expect
                (fp #b1 #b10111111110 #b1111011000101101111010100001000001011100001010011000)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111011000101101111010100001000001011100001010011000)
                expect
                (fp #b1 #b10111111101 #b0000111010000011110100111011000100101001010010001100)))

(assert (= expect result))

(check-sat)
(exit)
