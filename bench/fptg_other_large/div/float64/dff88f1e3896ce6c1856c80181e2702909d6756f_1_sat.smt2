; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111010010 #b1011110100011101110000111001011011100110100111111001)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b00111111011 #b1100000110010100100001100110111000001001000110001011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100111110 #b1110111111000011010010000011111110110101010100001100)
                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00000101100 #b1000111010101000010111100001000110010010001010111001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111010011 #b1110001101110001110010111000111110001011010111010001)
                expect
                (fp #b1 #b10000000000 #b1000100101010101010110111001000010010111000000011000)))
(assert (fp.leq (fp #b1 #b10000000000 #b1000100101010101010110111001000010010111000000011000)
                expect
                (fp #b1 #b00010001100 #b1111100010101000011101010101101000000010110011100010)))

(assert (= expect result))

(check-sat)
(exit)
