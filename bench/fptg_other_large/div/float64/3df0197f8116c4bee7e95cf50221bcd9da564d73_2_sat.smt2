(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01100010101 #b1011110110000100010100001010001010100101000000001110)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100111111 #b1011110110101110011110111001101111010111001111000001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01010010001 #b1011000001011011110001010011110010100001000110000101)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b00001011111 #b1111110001001101000110000001000100111000010101001111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101011110 #b0110101010000101000111000111011011010101010100100111)
                expect
                (fp #b1 #b01111111111 #b1111011000101101111010100001000001011100001010011000)))
(assert (fp.leq (fp #b1 #b01111111111 #b1111011000101101111010100001000001011100001010011000)
                expect
                (fp #b1 #b01011101011 #b0110010110100000000111001100010011100001011001101110)))

(assert (= expect result))

(check-sat)
(exit)
