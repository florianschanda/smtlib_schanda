;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010110011 #b1100110110000011100010111111101001110011000000001010)
                arg1
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110101010 #b0100000100001001111101100000001110100101101011001001)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b00111110110 #b1111111011111000100001001000101101110010010110111000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101100001 #b1100110111010110100111000010001110001010001111110111)
                expect
                (fp #b1 #b11011011100 #b0011111110000000110111001001011110100100011011110110)))
(assert (fp.leq (fp #b1 #b11011011100 #b0011111110000000110111001001011110100100011011110110)
                expect
                (fp #b1 #b01010101011 #b1100111000000010010100101011111011000010011101001111)))

(assert (= expect result))

(check-sat)
(exit)
