                arg2
                (fp #b1 #b00011011110 #b0011011011111101001111010001111111010000101110101000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00110101111 #b0111110001000110001000011101101001010000110001110110)
