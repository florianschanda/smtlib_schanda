; Format: FLOAT64
; Arg1: -INT_BOUNDARY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010000110 #b0100100001001110111011001010110001101000011011110011)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b01010011011 #b1100101100101011000001100111001011111011111001110101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01110100111 #b0011001101100101011100101001111100010111111001000100)
                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11101000010 #b1110101111010010100101100100011110010001100101111100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100110011 #b0110101111011011111110011011001000110111100001011010)
                expect
                (fp #b1 #b01000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000110100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00010101011 #b0010001001111110111001100110110101100011100100100000)))

(assert (= expect result))

(check-sat)
(exit)
