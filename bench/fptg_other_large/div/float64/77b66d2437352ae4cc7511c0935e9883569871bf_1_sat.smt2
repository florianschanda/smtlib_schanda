                arg2
                (fp #b0 #b00101110101 #b1010000001101110110010100111100111011111001000101001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0001001110011010001100010110111010110110101001101110)
