(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101000110 #b1010101110011001010111100011101111011011101101010110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001011101 #b1010111011001001001011001011011111000000110101001110)
                expect
                (fp #b1 #b01111001101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111001101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010010001 #b1010111011011010001110100001111110000111110111101101)))

(assert (= expect result))

(check-sat)
(exit)
