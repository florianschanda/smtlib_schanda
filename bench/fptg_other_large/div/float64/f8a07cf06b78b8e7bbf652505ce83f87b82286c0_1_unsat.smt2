                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00101110010 #b1010101110000111100111101011100000000000001101101110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b11001101100 #b0100000100100010011100010001111101001100001000010111)
                expect
                (fp #b0 #b11111111101 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b0 #b11111111101 #b0110101101101100110110101110101101010000101000011100)
                expect
                (fp #b0 #b11111111110 #b0100100000110000101000000011010101000100101111010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
