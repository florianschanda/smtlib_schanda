                arg2
                (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)))
(assert (fp.leq (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)
                arg2
                (fp #b0 #b11010111010 #b0000011011110111000000011001110111101110101011101100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00100101001 #b0101001010100000011000011010000010110000100010110100)
                expect
                (fp #b0 #b01010101010 #b0100111101010101000010100010100011010011101001111010)))
(assert (fp.leq (fp #b0 #b01010101010 #b0100111101010101000010100010100011010011101001111010)
                expect
                (fp #b0 #b10101110001 #b0011110010011101100010101000111100111010011111100000)))

(assert (= expect result))

(check-sat)
(exit)
