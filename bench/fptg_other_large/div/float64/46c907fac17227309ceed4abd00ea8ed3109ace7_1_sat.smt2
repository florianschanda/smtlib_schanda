; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01011000000 #b0111001111010100010001111000011100001010110000111011)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b10111111101 #b0101001111101101111010000001100100111001001010101111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000110110 #b1000101111101001111011000110111011001110100100000110)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b11100000101 #b0000001010001101101100111001001000100010100100011111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100101000 #b0001000010001110110111011110111010100101100010000110)
                expect
                (fp #b1 #b10010101111 #b0110110110100111111110111111111101100010010011001000)))
(assert (fp.leq (fp #b1 #b10010101111 #b0110110110100111111110111111111101100010010011001000)
                expect
                (fp #b0 #b00000011100 #b0100101001000010010101001100100101100010100010011110)))

(assert (= expect result))

(check-sat)
(exit)
