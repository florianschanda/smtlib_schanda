; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011011110 #b0001101101111100010001000100101101100010100010100100)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b00100001100 #b0101110010001001011010011011101100110000000111111000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010011110 #b1001000000000000010101000000001011001010111000111001)
                arg2
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b1 #b00100111110 #b0011001001101000011000110011111111100000010010001000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00001111000 #b0110000110001110010010110111010101110010011111011000)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01111110010 #b0101001110010000011111011101111101111111011100001100)))

(assert (= expect result))

(check-sat)
(exit)
