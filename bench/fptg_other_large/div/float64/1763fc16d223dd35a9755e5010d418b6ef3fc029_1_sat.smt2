(assert (fp.leq (fp #b1 #b01001000101 #b1101110001111000001010100111011010110011111010010010)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01100010001 #b0100000110110101011010111010000011110100001110011011)))

