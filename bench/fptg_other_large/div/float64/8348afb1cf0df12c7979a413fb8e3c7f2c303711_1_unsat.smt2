; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01011110000 #b0010000111101111011111100000001010010100100001011010)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111011000 #b0110001011000010000010000100010000011111111010110110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100011010 #b0101000011100111111100101011110011001110100110010010)
                arg2
                (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)))
(assert (fp.leq (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)
                arg2
                (fp #b0 #b10110100010 #b0111001010000010101011001111101100110110100000010000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11111111100 #b1011101011000000101011111111100100001100001010001000)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00110101001 #b1010110010110001010111111010000000000001000000111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
