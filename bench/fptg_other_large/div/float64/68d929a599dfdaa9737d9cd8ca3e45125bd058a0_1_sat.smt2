(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110100110 #b0001111111110110101000001001011001100111011001101010)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00001111001 #b0111100100010110010010100101110101111010001111011111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111100010 #b1101000111011001101010111001010001101001010111100110)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b01011111011 #b1111101001010100010010111101010011101010001011110000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111110010 #b0001100111101111101111011011111001001011111011011101)
                expect
                (fp #b0 #b01110011010 #b0100011011101111110011001110011101101111110010000010)))
(assert (fp.leq (fp #b0 #b01110011010 #b0100011011101111110011001110011101101111110010000010)
                expect
                (fp #b0 #b10111111110 #b1000100000110000100011100111110001010000111000001110)))

(assert (= expect result))

(check-sat)
(exit)
