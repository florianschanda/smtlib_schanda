; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101001100 #b1100111010100001010011001110011011011011100111101110)
                arg1
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100011011 #b1111001011100110010100001010011011101011011000010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100001111 #b0001011111110010100111100001101111101010111101110111)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b00101100001 #b1000101110000111001010100001010011110101100100110000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111101110 #b1011011111111101010110111000110000101011100110110001)
                expect
                (fp #b1 #b10111100100 #b1111011000101101111010100001000001011100001010011000)))
(assert (fp.leq (fp #b1 #b10111100100 #b1111011000101101111010100001000001011100001010011000)
                expect
                (fp #b0 #b00111100110 #b1001000110010000101010111100000111101010101000100001)))

(assert (= expect result))

(check-sat)
(exit)
