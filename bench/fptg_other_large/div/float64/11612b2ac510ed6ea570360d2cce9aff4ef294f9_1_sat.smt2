; Format: FLOAT64
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b1 #b01000000110 #b0000111111110110100100101100111000111001011100101010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011101101 #b0001010100110010110100110100000111010110011001001010)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b01000101100 #b0100101110110001101000101111001000101101100001101110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10011011011 #b1010101010001000101101001100011001000011001100010011)
                expect
                (fp #b0 #b11011011100 #b0011111110000000110111001001011110100100011011110101)))
(assert (fp.leq (fp #b0 #b11011011100 #b0011111110000000110111001001011110100100011011110101)
                expect
                (fp #b0 #b11111011111 #b1010000000000011000011000100110101010100001101100001)))

(assert (= expect result))

(check-sat)
(exit)
