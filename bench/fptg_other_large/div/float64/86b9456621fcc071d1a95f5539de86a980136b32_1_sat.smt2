                arg2
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00011100111 #b0111111110011011100101101001100111110000110000110000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101110010 #b0110111001110110000000001110111110000100110101000101)
                expect
                (fp #b1 #b00111111111 #b1011111110101001011101000100001011001010110000011110)))
(assert (fp.leq (fp #b1 #b00111111111 #b1011111110101001011101000100001011001010110000011110)
                expect
                (fp #b0 #b00010111101 #b1001111110110000001010110101010001000000011001011010)))

(assert (= expect result))

(check-sat)
(exit)
