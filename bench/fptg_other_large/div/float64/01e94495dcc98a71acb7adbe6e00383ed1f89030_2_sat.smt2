; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110110011 #b1001101100110110010010001001010000110111100101111011)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b10101001001 #b0011100110110001010101110001101101010001100000101010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111001110 #b1101110011100110101010000000111011111110011011101011)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b1 #b10000001111 #b0011100010001010010011011110111101111001010100100111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000101110 #b1010000100001100100001000100010010100010110111011111)
                expect
                (fp #b1 #b10010110001 #b0110011111000101000010010100100011101011110000001001)))
(assert (fp.leq (fp #b1 #b10010110001 #b0110011111000101000010010100100011101011110000001001)
                expect
                (fp #b0 #b10110011110 #b1000011001100001111111010001001010110011111000110110)))

(assert (= expect result))

(check-sat)
(exit)
