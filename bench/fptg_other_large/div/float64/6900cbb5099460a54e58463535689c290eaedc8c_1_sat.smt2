; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00001111001 #b1010110111101010011011010111101010111001100100011000)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b10010111001 #b0000101100010111000100101000010011110001000001111011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001100110 #b1111000001011111111000011000100111101000000000110111)
                arg2
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01011111110 #b0110110100110110011010001111001101101101111000001011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000011010 #b0100111110111011111000011011111100010010110001101111)
                expect
                (fp #b0 #b00111111100 #b0110001010100001001011001001111110110101011011010000)))
(assert (fp.leq (fp #b0 #b00111111100 #b0110001010100001001011001001111110110101011011010000)
                expect
                (fp #b0 #b11101110111 #b0110100010101100110110001001100100000010010001101001)))

(assert (= expect result))

(check-sat)
(exit)
