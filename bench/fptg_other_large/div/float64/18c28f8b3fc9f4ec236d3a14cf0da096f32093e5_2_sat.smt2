; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111000001 #b1001100110100000100011010000010011100001010010010010)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b10011000110 #b0011001101000000111011010000101111111111111110000011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00001111001 #b0100011111000010000010100100010011000111100000000110)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b10011101110 #b0011010100100001111011101011011101100100101100110010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00001001000 #b0001111000001000110100011000011100001000001111010101)
                expect
                (fp #b0 #b01111111111 #b1000000111001001111101101001011111100100100101001111)))
(assert (fp.leq (fp #b0 #b01111111111 #b1000000111001001111101101001011111100100100101001111)
                expect
                (fp #b0 #b10101111101 #b0110111001110001011111011111110101101111111010100100)))

(assert (= expect result))

(check-sat)
(exit)
