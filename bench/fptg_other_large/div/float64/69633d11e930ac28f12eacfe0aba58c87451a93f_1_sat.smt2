(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b1 #b00111011100 #b1011111001100001111111100111001001111000000110100010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00000101100 #b0000010110101001100001100011110010000110101011000011)
                expect
                (fp #b0 #b00110011011 #b0100011011101111110011001110011101101111110010000010)))
(assert (fp.leq (fp #b0 #b00110011011 #b0100011011101111110011001110011101101111110010000010)
                expect
                (fp #b0 #b01010010111 #b0001000011100000110010100101100011110111000111011111)))

(assert (= expect result))

(check-sat)
(exit)
