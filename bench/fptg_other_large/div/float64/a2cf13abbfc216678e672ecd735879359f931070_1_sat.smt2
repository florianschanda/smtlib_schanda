                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11110110000 #b1111110001010111101001110111101001000010000000001100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00000101111 #b1100010100010000011000011000100100011001001010110111)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01100100000 #b0101000010110011001100110110101111100101001000011000)))

(assert (= expect result))

(check-sat)
(exit)
