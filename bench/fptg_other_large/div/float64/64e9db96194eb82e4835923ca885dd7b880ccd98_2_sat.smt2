; Format: FLOAT64
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001001010 #b0000010101000001001100100100011011100110001001000010)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00000110011 #b1000001101010010001111010000110011010011101001100101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00010010010 #b1011000000001100001101010111000011110110100000101010)
                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b11101110001 #b0000111010100011010011000100111101001100000011001010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100000010 #b1001000010010101001001100001010000011111101110001111)
                expect
                (fp #b1 #b01010000101 #b0000010101000101100011001001010100111000111110000100)))
(assert (fp.leq (fp #b1 #b01010000101 #b0000010101000101100011001001010100111000111110000100)
                expect
                (fp #b0 #b11110010001 #b0000001001010010101001000100111011111110001100011110)))

(assert (= expect result))

(check-sat)
(exit)
