; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110101010 #b1101001101000011101100000000001100010001110111110011)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b10011101000 #b0011101001100101001111100110110000011111000101011110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01010000100 #b0101111111000111010100100000000000100111111110000110)
                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b10000111010 #b0000100010000101011001011001111011110011011110110101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01111111001 #b1011100111110100101000000111001111100101100001111100)
                expect
                (fp #b1 #b00000100111 #b0011011000100100111010011100111001110011000100110101)))
(assert (fp.leq (fp #b1 #b00000100111 #b0011011000100100111010011100111001110011000100110101)
                expect
                (fp #b0 #b01011011101 #b0110010001111111010001001110100110111111100111110110)))

(assert (= expect result))

(check-sat)
(exit)
