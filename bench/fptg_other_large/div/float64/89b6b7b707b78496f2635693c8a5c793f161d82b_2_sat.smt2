                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11000011110 #b0110100000101101010110111111000011111101011111000010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010100011 #b1110111100001000100111100101010001001100010011101101)
                expect
                (fp #b1 #b01111001111 #b0100001000110101001110011001111000110000101000111010)))
(assert (fp.leq (fp #b1 #b01111001111 #b0100001000110101001110011001111000110000101000111010)
                expect
                (fp #b0 #b00110011110 #b0010011000100110110111010110010000100011110001001001)))

(assert (= expect result))

(check-sat)
(exit)
