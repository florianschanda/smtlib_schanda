(assert (fp.leq (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)
                arg2
                (fp #b0 #b10100001010 #b0011100101010100010010110000100000111111101011101010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101101010 #b1001010001111000101010101010000010101010000010101100)
                expect
                (fp #b1 #b00111111111 #b0100101011111001100101101000000110010110111000111011)))
(assert (fp.leq (fp #b1 #b00111111111 #b0100101011111001100101101000000110010110111000111011)
                expect
                (fp #b0 #b11000010011 #b0110101011011101000111001100100010001000000000001100)))

(assert (= expect result))

(check-sat)
(exit)
