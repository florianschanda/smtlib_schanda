; Format: FLOAT64
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010111111 #b1100101001110001101000000010000101100010101001111100)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11010000100 #b0001110000110000111111100101101000110001100100010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00011111001 #b0100011101000101011110111000010111010110100001010110)
                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b10100000000 #b1101100000110101101100110010011111001100011111001000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00100001100 #b0010010011000110101010010100000101101011101000010110)
                expect
                (fp #b1 #b00001011011 #b0011011000100100111010011100111001110011000100110011)))
(assert (fp.leq (fp #b1 #b00001011011 #b0011011000100100111010011100111001110011000100110011)
                expect
                (fp #b1 #b00000011001 #b1110011001100000001101010011110100001101111110110000)))

(assert (= expect result))

(check-sat)
(exit)
