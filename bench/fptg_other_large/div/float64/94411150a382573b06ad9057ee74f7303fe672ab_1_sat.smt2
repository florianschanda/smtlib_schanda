(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11010110011 #b0001100001011010101001010111010110010101111101100110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01000000111 #b0001010100100011100010110001000101000011110101001010)
                expect
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11010111101 #b0010101010001010011001110010101100001010001110010100)))

(assert (= expect result))

(check-sat)
(exit)
