                arg2
                (fp #b0 #b10111011000 #b0110110011111010101100100010010110110001100101001010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01000101010 #b0101000000010010001011101101101100001110101010000101)
                expect
