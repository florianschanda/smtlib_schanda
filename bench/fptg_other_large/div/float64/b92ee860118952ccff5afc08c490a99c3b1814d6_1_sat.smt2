; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010111101 #b1010000101110101001100001001000000011100111011111100)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01000010101 #b0111111010011111110100100100011111010101100000101101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111000000 #b0010101001101000001001101100011100111101011001101010)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b01000000001 #b0010101000010000101000111001110101010100001111100001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110000110 #b0010101110111011101101001001011001010101111001101110)
                expect
                (fp #b0 #b00011000011 #b0011111110000000110111001001011110100100011011110110)))
(assert (fp.leq (fp #b0 #b00011000011 #b0011111110000000110111001001011110100100011011110110)
                expect
                (fp #b0 #b11001111000 #b0101001001011111110000010111010110100011011110100001)))

(assert (= expect result))

(check-sat)
(exit)
