; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00100110101 #b1101110100000111001001011011100111000101101111110000)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11100011111 #b1100110101111101011001100110100010100101010110000010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110110101 #b0010111101110000110110001011111100001000111111110100)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b01101010110 #b0011101111000001100111100101010011100100001001110101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011110111 #b0011000011010110001000000111000000011100000010011111)
                expect
                (fp #b1 #b10011001011 #b0010101101011100010110111101111000010011000010110100)))
(assert (fp.leq (fp #b1 #b10011001011 #b0010101101011100010110111101111000010011000010110100)
                expect
                (fp #b0 #b01000101010 #b1001100010110100011010000110001111101000000010101100)))

(assert (= expect result))

(check-sat)
(exit)
