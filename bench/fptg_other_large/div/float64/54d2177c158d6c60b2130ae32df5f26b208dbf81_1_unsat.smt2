(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -NAN

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010110011 #b0010100000111111000011100111110110110111101100001000)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b1 #b00011001001 #b1101101100100010000110010001100010101011001100001101)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
