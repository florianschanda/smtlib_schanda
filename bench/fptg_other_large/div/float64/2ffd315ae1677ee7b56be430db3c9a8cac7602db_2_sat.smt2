                arg2
                (fp #b0 #b00011001001 #b1100001110010101111101111100010011100110010110100011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011000001 #b0100101001000111000100100101001010101110000001101110)
                expect
