;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001011110 #b0111000101101010010100011001110001000001101111100111)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b00100111110 #b0101010100101101100111110000000110001101001010011100)))

