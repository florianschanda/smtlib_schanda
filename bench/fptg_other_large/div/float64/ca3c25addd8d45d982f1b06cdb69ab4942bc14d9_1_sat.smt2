(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001110010 #b0011000011100001100100100010000000100101000011011110)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11100110011 #b1110101001010000011000111001001001011011100110000110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01001111101 #b0101010110100011001111111111011010101000101000110001)
                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b11110101001 #b0100100011101101010011001011010010100001110000000101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000111011 #b1111111000101001110000010100000110110110100000110001)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01011100101 #b1011110101100001111101011011001111100011100101100001)))

(assert (= expect result))

(check-sat)
(exit)
