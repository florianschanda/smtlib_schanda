(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011110001 #b0011001111100100000000010011100101010010111011111010)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00010110011 #b1011101100110111001001101101000110000000100010011111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00110110111 #b0001000110110000101110100110110011111010011000001001)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11110110110 #b1011101111010101011111011010110011100000000110001010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101101001 #b1000001101011100001101110100011101100000011110001100)
                expect
                (fp #b1 #b00110110110 #b0100001000110101001110011001111000110000101000111010)))
(assert (fp.leq (fp #b1 #b00110110110 #b0100001000110101001110011001111000110000101000111010)
                expect
                (fp #b0 #b11011000011 #b1101101000011100111001101000000100101100001001100111)))

(assert (= expect result))

(check-sat)
(exit)
