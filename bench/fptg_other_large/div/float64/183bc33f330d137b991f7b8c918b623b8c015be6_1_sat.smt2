; Format: FLOAT64
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110001101 #b0010111011000010110010011110100110010100101101101001)
                arg1
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01000010000 #b0100110110111111001010100101100101101001000111100101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00110101010 #b1011100110111001001011000000011000110010011101110100)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b10111101111 #b0000110011111100111001111000100000000101101001011101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011001110 #b0101111111001111000001010100001011000011010001111000)
                expect
                (fp #b1 #b01100101101 #b0010100010011000111000001100001110110010100000001011)))
(assert (fp.leq (fp #b1 #b01100101101 #b0010100010011000111000001100001110110010100000001011)
                expect
                (fp #b0 #b10110110011 #b1001100100000001111011010000011011001011111100011011)))

(assert (= expect result))

(check-sat)
(exit)
