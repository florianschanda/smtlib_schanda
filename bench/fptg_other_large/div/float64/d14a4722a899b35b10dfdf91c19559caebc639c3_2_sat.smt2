; Format: FLOAT64
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b10011001111 #b0111100110111001101010011111000010000011010110111011)
                arg1
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01100100000 #b1011101001001001100101100100001101111000001110011110)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11011001010 #b1111001000011010110010001111110100010100101010011011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00111100010 #b0011011101111111111001101000100110001100011001110000)
                expect
                (fp #b0 #b11111001111 #b0100001000110101001110011001111000110000101000111010)))
(assert (fp.leq (fp #b0 #b11111001111 #b0100001000110101001110011001111000110000101000111010)
                expect
                (fp #b0 #b11111110001 #b1001011100000000100011100111100000100000111101110100)))

(assert (= expect result))

(check-sat)
(exit)
