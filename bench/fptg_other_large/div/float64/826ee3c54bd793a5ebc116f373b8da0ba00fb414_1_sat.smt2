                (fp #b0 #b10011111100 #b1001001010100011010110101111110110010011100000001011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100110110 #b0101110110111011100111011110011111000111010101101010)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b01101010011 #b0111010010100001010000010111111111100010111110000001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110100101 #b0101101011101010110000001101110011011000001010111011)
                expect
                (fp #b1 #b01100010000 #b0100010010111110101101010110110000011011101111011001)))
(assert (fp.leq (fp #b1 #b01100010000 #b0100010010111110101101010110110000011011101111011001)
                expect
                (fp #b0 #b00000110111 #b1011011011000011101110000001111000100000011010010101)))

(assert (= expect result))

(check-sat)
(exit)
