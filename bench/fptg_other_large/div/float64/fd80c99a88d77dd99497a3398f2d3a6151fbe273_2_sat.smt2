                arg2
                (fp #b1 #b01010100000 #b0000010100101100000011001110100001000111100111100110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100100001 #b0111100001110111110100100101001010100001011111010011)
                expect
