; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011101011 #b1110111101011010101010111001001101000110100100011100)
                arg1
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)
                arg1
                (fp #b1 #b01110110101 #b1110000010110011010110110101001101111011110100011010)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001011000 #b0110100000010101001101111010110000111111110101011101)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11101101000 #b1011110110100101011101011010000111110101011100101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
