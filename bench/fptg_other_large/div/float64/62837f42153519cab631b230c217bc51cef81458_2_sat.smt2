(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111100110 #b1001101111111100011110010011101100010110010100001111)
                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b1 #b00110101100 #b0010101111111010101110001111011111001101001000000001)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00000101011 #b0100010010001100100010100000000111101011000001000111)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01001111001 #b0010001000010010111111110100111101110111000100110000)))

(assert (= expect result))

(check-sat)
(exit)
