; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010010000 #b1011101110011101100001010011001100001001000100000000)
                arg1
                (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)
                arg1
                (fp #b0 #b01011000111 #b0111000010010111111100111111101001110000000000010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111101000 #b1111110101101011000101010010010000100111100101000111)
                arg2
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                arg2
                (fp #b0 #b11101110000 #b0100111010010101110010000001000110000110010011100101)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010000110 #b1010001100010000110101100110001010110111111101000100)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10100100110 #b1100010000000100101010000001001001111100000111011101)))

(assert (= expect result))

(check-sat)
(exit)
