;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000110101 #b0001101000101000000010000010000010110110111010011110)
                arg1
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                arg1
                (fp #b0 #b00001110000 #b0101000001000100110101000110010001011110101111010000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00000111010 #b0100111101001000101010110010100010110001000101010000)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b10100001010 #b0011011111000111111111010011110010001111011110100010)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010000011 #b0011111000011101110101001010001010000101000000001100)
                expect
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(assert (= expect result))

(check-sat)
(exit)
