; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
