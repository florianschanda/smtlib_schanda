                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b00111010000 #b1001110001101000100101111001001101011100101110010110)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00101110100 #b0101100100001101101000101111011111011001110010111100)
                expect
                (fp #b0 #b01111001011 #b0000000000000000000000000000000000000000000000000010)))
(assert (fp.leq (fp #b0 #b01111001011 #b0000000000000000000000000000000000000000000000000010)
                expect
                (fp #b0 #b10011001000 #b0001101101010010011001011110110111010010100011000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
