; Format: FLOAT64
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00001001011 #b0101111101000011100110001101110100111111101010100110)
                arg1
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111111101 #b0011101110101011111110100111110110011001011111001100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01111101100 #b0101010010110101001111110001110010011010000011010000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000100001 #b0011100110100000001111001110110100000110011100111011)
                expect
                (fp #b1 #b01111111101 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b01111111101 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01100011111 #b0100000000100101111110101000000010010011001111001000)))

(assert (= expect result))

(check-sat)
(exit)
