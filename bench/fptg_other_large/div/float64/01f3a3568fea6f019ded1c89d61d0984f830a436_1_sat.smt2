; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110101000 #b1001011100110011110110001001011111100100001100000100)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b00000111011 #b0111000010110110001011000010111001001010101001010100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01011110000 #b1101010100000011111101100001101010011010111111010010)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01111001111 #b0111101011001010011100110000111011000110110110010011)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00001101000 #b0110101101001011011101010000100111110100101011001110)
                expect
                (fp #b0 #b01111111011 #b0110001010100001001011001001111110110101011011010000)))
(assert (fp.leq (fp #b0 #b01111111011 #b0110001010100001001011001001111110110101011011010000)
                expect
                (fp #b0 #b10101101010 #b0010010000101110111111110011111001000110100000111001)))

(assert (= expect result))

(check-sat)
(exit)
