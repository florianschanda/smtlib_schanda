(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111010 #b1101111011101001111000111100100010101110101111101111)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10011100000 #b1110001001111100110011101101010110110010000011101000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110000010 #b0100011010110011110110010101100010110110001100000001)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b01110000011 #b0001010101110101010011010110001100101010110011110111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010100001 #b0100001011100000001111001101111000111101110011001001)
                expect
                (fp #b0 #b10111100101 #b0010101111000111100000110011001011010010101000111100)))
(assert (fp.leq (fp #b0 #b10111100101 #b0010101111000111100000110011001011010010101000111100)
                expect
                (fp #b0 #b11110001111 #b1111011000011100000111010001011110001011100010011001)))

(assert (= expect result))

(check-sat)
(exit)
