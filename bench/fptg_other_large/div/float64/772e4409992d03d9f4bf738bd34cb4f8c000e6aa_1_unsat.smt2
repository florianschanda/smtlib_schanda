                arg2
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11010110011 #b1111000111101111010001001001011011100110011011011100)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11000101001 #b1010001100111110011010000100010101110101000011001011)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10100110000 #b1010110010011101100101010000001101110101111000011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
