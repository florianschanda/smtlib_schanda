(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01110111000 #b1101101011001111101001011010100000011101000010111111)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b00011011110 #b1101101000110011100111000110011001000010100011001110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001001000 #b1111001101100100000000000000100110111001111110001100)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11000101101 #b0111101011011101000010011100110100011011010100000000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011100011 #b1010001010011101110110000110011111100110010100101001)
                expect
                (fp #b1 #b00111010000 #b0100001000110101001110011001111000110000101000111010)))
(assert (fp.leq (fp #b1 #b00111010000 #b0100001000110101001110011001111000110000101000111010)
                expect
                (fp #b1 #b00001000001 #b1101000100000100110110001001010010101001000101011100)))

(assert (= expect result))

(check-sat)
(exit)
