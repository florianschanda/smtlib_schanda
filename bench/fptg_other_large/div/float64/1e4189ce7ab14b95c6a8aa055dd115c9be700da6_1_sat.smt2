; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -ONE

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011111111 #b1101000101101111001011110010011110100000000110011101)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b1 #b00111101100 #b1001110101101111000110010000000001000011000110010110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110010000 #b0110101001011100111000011000101101010010110111011011)
                arg2
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01000000111 #b0011101000111010011111100100001010010000011111011111)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100001011 #b1010100011001000000110001110101001010001010010000100)
                expect
                (fp #b0 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b0 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                expect
                (fp #b0 #b11000000000 #b0100010011100101100010011000110010011010001100001001)))

(assert (= expect result))

(check-sat)
(exit)
