(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b1 #b11111011011 #b0010101010011100001011111010100111100100000100010011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000101111 #b0011000010111001110110011110000001010011000101000010)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b00110100000 #b0011101100011010001011000010011000001101001100100000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
