(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b1110010101110001000100011010110100111001110000001010)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b01000101001 #b1010010010010111111000111001110011101110001100000101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01100000111 #b0001011100011001001001000010000000000111000100111111)
                arg2
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const result Float64)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111101010 #b1001011100101111000100001010010110110010110100010100)
                expect
                (fp #b1 #b01111111101 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b01111111101 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01100100101 #b1011001111000100101101011000100001001001101011001100)))

(assert (= expect result))

(check-sat)
(exit)
