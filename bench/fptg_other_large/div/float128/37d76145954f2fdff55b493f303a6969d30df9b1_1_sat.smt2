                arg2
                (fp #b0 #b010111000111000 #b0000011110001000001101010100011011011111001010110010111100100001100011000010101111000110000110000101110101110000)))

(declare-const result Float128)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float128)
