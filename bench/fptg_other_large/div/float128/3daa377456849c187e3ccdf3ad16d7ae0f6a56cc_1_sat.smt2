                (fp #b0 #b111111111111110 #b1100001100010111100001111110010110011010111000000001101010100111111111010010111100110111101011001111010011110000)))

(declare-const result Float128)
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
