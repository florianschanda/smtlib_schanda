                (fp #b0 #b100011001001111 #b000000010010010011010000110100010000011010110110101101101011100)))

(declare-const result (_ FloatingPoint 15 64))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 64))
