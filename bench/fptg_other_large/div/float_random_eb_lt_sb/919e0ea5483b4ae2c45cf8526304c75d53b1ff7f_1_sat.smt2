; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 32))
(assert (fp.leq (fp #b1 #b11111110110010 #b0100000011100100101011100110100)
                arg1
                (fp #b1 #b01111111111111 #b0100110010101011100000010010101)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0100110010101011100000010010101)
                arg1
                (fp #b0 #b01010000010000 #b1110100100011110100011110110010)))

(declare-const arg2 (_ FloatingPoint 14 32))
(assert (fp.leq (fp #b1 #b10110110101101 #b0000001011000000010011001000100)
                arg2
                (fp #b0 #b00000000000000 #b1111101000110101011000111011100)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111101000110101011000111011100)
                arg2
                (fp #b0 #b01110010010001 #b1001111100101110101001010001011)))

(declare-const result (_ FloatingPoint 14 32))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 32))
(assert (fp.leq (fp #b1 #b11111111111101 #b1101111100110111111010100011010)
                expect
                (fp #b1 #b11111111111101 #b0101010001011110101111010110011)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0101010001011110101111010110011)
                expect
                (fp #b1 #b10111110001100 #b0110010001100010011001101110101)))

(assert (= expect result))

(check-sat)
(exit)
