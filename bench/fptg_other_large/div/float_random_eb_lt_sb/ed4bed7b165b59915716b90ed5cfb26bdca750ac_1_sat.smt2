                arg2
                (fp #b0 #b11111111110 #b111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111111111111111111111111111111)
                arg2
                (fp #b0 #b11111111111 #b000000000000000000000000000000)))

(declare-const result (_ FloatingPoint 11 31))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 31))
(assert (fp.leq (fp #b1 #b01001010001 #b101110110111001101101010001111)
                expect
                (fp #b0 #b00010111000 #b001100100000100100101001000101)))
(assert (fp.leq (fp #b0 #b00010111000 #b001100100000100100101001000101)
                expect
                (fp #b0 #b00110111110 #b100100011000000000010101101010)))

(assert (= expect result))

(check-sat)
(exit)
