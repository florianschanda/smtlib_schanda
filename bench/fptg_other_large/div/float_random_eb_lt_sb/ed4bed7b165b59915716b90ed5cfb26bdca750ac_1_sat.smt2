(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 31))
(assert (fp.leq (fp #b1 #b00100110111 #b000010111111010010101101110100)
