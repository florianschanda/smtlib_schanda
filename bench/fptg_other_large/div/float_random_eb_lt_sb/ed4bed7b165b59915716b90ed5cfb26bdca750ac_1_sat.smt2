                (fp #b0 #b10010111000 #b001100100000100100101001000101)))
(assert (fp.leq (fp #b0 #b10010111000 #b001100100000100100101001000101)
                arg1
                (fp #b0 #b11110001100 #b111011001000100111010001001001)))

