(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 12))
(assert (fp.leq (fp #b1 #b1011011001 #b00001011100)
                arg1
                (fp #b1 #b0011111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b0011111010 #b01101010000)
                arg1
                (fp #b0 #b0011110011 #b11011110101)))

(declare-const arg2 (_ FloatingPoint 10 12))
(assert (fp.leq (fp #b1 #b1010111111 #b11010011011)
                arg2
                (fp #b0 #b1111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000000000)
                arg2
                (fp #b0 #b1111111110 #b00000001010)))

(declare-const result (_ FloatingPoint 10 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 12))
(assert (fp.leq (fp #b1 #b1000110010 #b01110101101)
                expect
                (fp #b1 #b0000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000000001)
                expect
                (fp #b0 #b0100101010 #b10100010000)))

(assert (= expect result))

(check-sat)
(exit)
