(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 29))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 5 29))
(assert (fp.leq (fp #b0 #b00001 #b0010101011100011110000010101)
                arg2
                (fp #b0 #b01111 #b0111101100000100110111100110)))
(assert (fp.leq (fp #b0 #b01111 #b0111101100000100110111100110)
                arg2
                (fp #b0 #b11010 #b0111110101111100111001110000)))

(declare-const result (_ FloatingPoint 5 29))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 29))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
