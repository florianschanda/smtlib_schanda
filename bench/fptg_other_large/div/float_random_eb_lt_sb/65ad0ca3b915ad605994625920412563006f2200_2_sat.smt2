(assert (fp.leq (fp #b0 #b100011001 #b0010010111001101000)
                arg2
                (fp #b0 #b100100010 #b0000111101111111010)))

(declare-const result (_ FloatingPoint 9 20))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 20))
(assert (fp.leq (fp #b1 #b010000000 #b0101111000000000110)
                expect
                (fp #b0 #b001001110 #b1001101010000011011)))
(assert (fp.leq (fp #b0 #b001001110 #b1001101010000011011)
                expect
                (fp #b0 #b101001011 #b0100110010110011101)))

(assert (= expect result))

(check-sat)
