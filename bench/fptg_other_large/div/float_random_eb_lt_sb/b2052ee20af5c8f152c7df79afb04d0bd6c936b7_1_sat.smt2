; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 33))
(assert (fp.leq (fp #b1 #b10110110 #b01001001101111010111110111100110)
                arg1
                (fp #b1 #b10010110 #b11001001111000001111111000000000)))
(assert (fp.leq (fp #b1 #b10010110 #b11001001111000001111111000000000)
                arg1
                (fp #b1 #b01101100 #b01110001010100000010100011100110)))

(declare-const arg2 (_ FloatingPoint 8 33))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 8 33))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 33))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
