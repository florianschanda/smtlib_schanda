(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 15))
(assert (fp.leq (fp #b1 #b0001011110 #b00000010111101)
                arg2
                (fp #b0 #b0101100000 #b01100010011101)))
(assert (fp.leq (fp #b0 #b0101100000 #b01100010011101)
                arg2
                (fp #b0 #b1100100011 #b01011110100100)))

(declare-const result (_ FloatingPoint 10 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 15))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
