(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 13))
(assert (fp.leq (fp #b1 #b1110000000 #b010000001000)
                arg1
                (fp #b1 #b0000000000 #b000000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000001)
                arg1
                (fp #b0 #b0000111011 #b111000011010)))

(declare-const arg2 (_ FloatingPoint 10 13))
(assert (fp.leq (fp #b1 #b1101000000 #b110000111100)
                arg2
                (fp #b1 #b1001110001 #b001010001001)))
(assert (fp.leq (fp #b1 #b1001110001 #b001010001001)
                arg2
                (fp #b0 #b0111000001 #b010101011100)))

(declare-const result (_ FloatingPoint 10 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 13))
(assert (fp.leq (fp #b1 #b1011010101 #b000110100101)
                expect
                (fp #b0 #b0000000000 #b000000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000001)
                expect
                (fp #b0 #b1110011000 #b000101101000)))

(assert (= expect result))

(check-sat)
(exit)
