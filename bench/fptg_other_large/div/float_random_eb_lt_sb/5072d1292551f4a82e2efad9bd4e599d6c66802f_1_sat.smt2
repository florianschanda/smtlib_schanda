(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 40))
(assert (fp.leq (fp #b1 #b11000111110101 #b011001110101101101000110101101010011000)
                arg1
                (fp #b1 #b00111111101100 #b011010100000100111100110011001111111010)))
(assert (fp.leq (fp #b1 #b00111111101100 #b011010100000100111100110011001111111010)
                arg1
                (fp #b0 #b01010000001011 #b011100110010010101101110010010000110110)))

(declare-const arg2 (_ FloatingPoint 14 40))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 14 40))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 40))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
