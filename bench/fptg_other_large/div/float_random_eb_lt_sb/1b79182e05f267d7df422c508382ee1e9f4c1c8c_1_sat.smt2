; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 18))
(assert (fp.leq (fp #b1 #b110111110 #b01101001111011110)
                arg1
                (fp #b1 #b000000000 #b01010101001100111)))
(assert (fp.leq (fp #b1 #b000000000 #b01010101001100111)
                arg1
                (fp #b0 #b110111000 #b10101010100001101)))

(declare-const arg2 (_ FloatingPoint 9 18))
(assert (fp.leq (fp #b1 #b001110111 #b10100111001110011)
                arg2
                (fp #b0 #b011111111 #b00110010011011000)))
(assert (fp.leq (fp #b0 #b011111111 #b00110010011011000)
                arg2
                (fp #b0 #b111111101 #b01110000010111011)))

(declare-const result (_ FloatingPoint 9 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 18))
(assert (fp.leq (fp #b1 #b000010010 #b01101011000001111)
                expect
                (fp #b1 #b000000000 #b01000111001011100)))
(assert (fp.leq (fp #b1 #b000000000 #b01000111001011100)
                expect
                (fp #b0 #b000101011 #b00011110100100110)))

(assert (= expect result))

(check-sat)
(exit)
