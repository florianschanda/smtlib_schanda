(declare-const expect (_ FloatingPoint 8 32))
(assert (fp.leq (fp #b1 #b11001110 #b1110100101101111111011111110101)
                expect
                (fp #b1 #b00000000 #b0000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000000000000000000000001)
                expect
                (fp #b0 #b00001111 #b1011110010001001001110111000001)))

(assert (= expect result))

(check-sat)
