;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 54))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 3 54))
(assert (fp.leq (fp #b1 #b101 #b00111010101010110001101101010010001111011111110100101)
                arg2
                (fp #b1 #b011 #b00000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b011 #b00000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b011 #b01111100010111000010000101000001000100100111011001100)))

(declare-const result (_ FloatingPoint 3 54))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 54))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
