(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 39))
(assert (fp.leq (fp #b1 #b11111101 #b00011111101001000110001110101011111100)
                arg1
                (fp #b1 #b11111101 #b00000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111101 #b00000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00101001 #b11000000100010100111111111000011111111)))

(declare-const arg2 (_ FloatingPoint 8 39))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 8 39))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 39))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
