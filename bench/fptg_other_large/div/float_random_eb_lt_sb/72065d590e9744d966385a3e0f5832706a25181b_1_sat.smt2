(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 40))
(assert (fp.leq (fp #b1 #b1000001011 #b100101110111000100100110100010100001101)
                arg1
                (fp #b1 #b0000000000 #b110001001010101010101101110010000001100)))
(assert (fp.leq (fp #b1 #b0000000000 #b110001001010101010101101110010000001100)
                arg1
                (fp #b0 #b1001110100 #b010000001110111011000101111001011110101)))

(declare-const arg2 (_ FloatingPoint 10 40))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 10 40))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 40))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
