(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 40))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 2 40))
(assert (fp.leq (fp #b1 #b00 #b001111110011001111100111100011010001000)
                arg2
                (fp #b1 #b00 #b000000000000000000010110101000001001111)))
(assert (fp.leq (fp #b1 #b00 #b000000000000000000010110101000001001111)
                arg2
                (fp #b0 #b10 #b111001100110001101010101000011100001100)))

(declare-const result (_ FloatingPoint 2 40))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 40))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
