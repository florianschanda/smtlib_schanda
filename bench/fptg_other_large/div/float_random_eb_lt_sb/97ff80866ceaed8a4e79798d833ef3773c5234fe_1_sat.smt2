(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 24))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 24))
(assert (fp.leq (fp #b1 #b011100000001011 #b00110100110110100010101)
                arg2
                (fp #b0 #b111111111111101 #b00000000000000000000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00000000000000000000000)
                arg2
                (fp #b0 #b111111111111110 #b10101111000001010000011)))

(declare-const result (_ FloatingPoint 15 24))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 24))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
