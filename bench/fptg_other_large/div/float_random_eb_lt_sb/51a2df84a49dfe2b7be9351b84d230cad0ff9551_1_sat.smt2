; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 31))
(assert (fp.leq (fp #b1 #b1011111101111011 #b110101010011100000011001001001)
                arg1
                (fp #b0 #b0101001010011111 #b101110001111110110010010101001)))
(assert (fp.leq (fp #b0 #b0101001010011111 #b101110001111110110010010101001)
                arg1
                (fp #b0 #b0111001101111110 #b001111110001011000111011001101)))

(declare-const arg2 (_ FloatingPoint 16 31))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 31))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 31))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0001010101000100 #b101010010011110110111100010011)
                expect
                (fp #b1 #b0000000000000000 #b000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000000000000000000)
                expect
                (fp #b0 #b1111011000010100 #b101100111110111001001001110100)))

(assert (= expect result))

(check-sat)
(exit)
