; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 37))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 37))
(assert (fp.leq (fp #b0 #b010111111100 #b110100010010101101101011011100110001)
                arg2
                (fp #b0 #b011111111111 #b000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b000000000000000000000000000000000000)
                arg2
                (fp #b0 #b110011101010 #b011100111110010001000111110110001001)))

(declare-const result (_ FloatingPoint 12 37))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 37))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
