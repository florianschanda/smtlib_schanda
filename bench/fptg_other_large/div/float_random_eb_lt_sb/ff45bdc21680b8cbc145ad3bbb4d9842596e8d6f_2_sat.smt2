; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 31))
(assert (fp.leq (fp #b1 #b1110101110 #b100100100010100000110000110101)
                arg1
                (fp #b1 #b0111111111 #b000101001100101010111110110010)))
(assert (fp.leq (fp #b1 #b0111111111 #b000101001100101010111110110010)
                arg1
                (fp #b0 #b0010100011 #b110010101000111011010100010001)))

(declare-const arg2 (_ FloatingPoint 10 31))
(assert (fp.leq (fp #b1 #b0011001100 #b011101111100001100101001111101)
                arg2
                (fp #b0 #b0000000000 #b111101000110101011000111011111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111101000110101011000111011111)
                arg2
                (fp #b0 #b1010111001 #b010000101110011110010000100110)))

(declare-const result (_ FloatingPoint 10 31))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 31))
(assert (fp.leq (fp #b1 #b1111111110 #b001010111000110011000111011011)
                expect
                (fp #b1 #b1111111101 #b001000011110100010111011010011)))
(assert (fp.leq (fp #b1 #b1111111101 #b001000011110100010111011010011)
                expect
                (fp #b1 #b0110100001 #b100000010100011110110111011001)))

(assert (= expect result))

(check-sat)
(exit)
