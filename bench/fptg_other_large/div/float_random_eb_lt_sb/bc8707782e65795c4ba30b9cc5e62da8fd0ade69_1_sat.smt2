(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 28))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 28))
(assert (fp.leq (fp #b0 #b001101000010110 #b101110010100110101110010011)
                arg2
                (fp #b0 #b100111100001100 #b001011100110011011000111110)))
(assert (fp.leq (fp #b0 #b100111100001100 #b001011100110011011000111110)
                arg2
                (fp #b0 #b110000001110000 #b100011111010000011110101010)))

(declare-const result (_ FloatingPoint 15 28))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 28))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
