(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 31))
(assert (fp.leq (fp #b1 #b000000100110 #b101010010100101011011100101000)
                arg1
                (fp #b0 #b011111111111 #b000111111111110001011011011000)))
(assert (fp.leq (fp #b0 #b011111111111 #b000111111111110001011011011000)
                arg1
                (fp #b0 #b110000011101 #b110101010101010000001000100100)))

(declare-const arg2 (_ FloatingPoint 12 31))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 12 31))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 31))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
