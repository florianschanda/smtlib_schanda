(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 15))
(assert (fp.leq (fp #b1 #b11001110111 #b10101000110011)
                arg1
                (fp #b1 #b11001001111 #b01000110000100)))
(assert (fp.leq (fp #b1 #b11001001111 #b01000110000100)
                arg1
                (fp #b1 #b00001101001 #b11000101101110)))

(declare-const arg2 (_ FloatingPoint 11 15))
(assert (fp.leq (fp #b1 #b11111111011 #b11111001101111)
                arg2
                (fp #b1 #b00000000001 #b00000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b00000000000000)
                arg2
                (fp #b0 #b00011110100 #b01111100010011)))

(declare-const result (_ FloatingPoint 11 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 15))
(assert (fp.leq (fp #b1 #b11111110001 #b01011000101101)
                expect
                (fp #b0 #b11111111110 #b11111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b11111111111111)
                expect
                (fp #b0 #b11111111111 #b00000000000000)))

(assert (= expect result))

(check-sat)
(exit)
