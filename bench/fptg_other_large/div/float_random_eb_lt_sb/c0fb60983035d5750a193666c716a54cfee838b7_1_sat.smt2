;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 50))
(assert (fp.leq (fp #b1 #b11110 #b1111111111111110010101111011000001110000100000100)
                arg1
                (fp #b1 #b11110 #b1111111111111110001001110010100010100110111001110)))
(assert (fp.leq (fp #b1 #b11110 #b1111111111111110001001110010100010100110111001110)
                arg1
                (fp #b1 #b00010 #b1110010101101110110000111010110100101000111000010)))

(declare-const arg2 (_ FloatingPoint 5 50))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 5 50))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 50))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00101 #b1001010001100110001011011101000011000101101010100)
                expect
                (fp #b1 #b00000 #b0000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000 #b0000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010 #b0110100010110010001101100011101001001110111111000)))

(assert (= expect result))

(check-sat)
(exit)
