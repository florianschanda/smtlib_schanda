(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -ZERO
; Arg2: -ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 20))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1011000010 #b0110101101000111110)
                arg1
                (fp #b1 #b0000000000 #b0000000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000000000000000)
                arg1
                (fp #b0 #b1110001000 #b1101010100011011000)))

(declare-const arg2 (_ FloatingPoint 10 20))
(assert (fp.leq (fp #b1 #b1101111000 #b1010000100101101010)
                arg2
                (fp #b1 #b0111111111 #b0000000000000000000)))
(assert (fp.leq (fp #b1 #b0111111111 #b0000000000000000000)
                arg2
                (fp #b0 #b1000101101 #b1101001110001111110)))

(declare-const result (_ FloatingPoint 10 20))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 20))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1001000111 #b0011110010101011111)
                expect
                (fp #b0 #b0000000000 #b0000000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000000000000000)
                expect
                (fp #b0 #b1111111010 #b1001100011010001001)))

(assert (= expect result))

(check-sat)
(exit)
