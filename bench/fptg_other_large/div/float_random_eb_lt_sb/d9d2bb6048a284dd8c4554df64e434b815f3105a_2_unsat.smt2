                (fp #b0 #b0000000000000001 #b000000000000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b000000000000000000000000)
                arg2
                (fp #b0 #b0001010011111011 #b010011111001001101100101)))

(declare-const result (_ FloatingPoint 16 25))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 25))
