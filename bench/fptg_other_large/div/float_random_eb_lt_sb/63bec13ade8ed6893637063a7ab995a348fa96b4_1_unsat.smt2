(assert (fp.leq (fp #b1 #b011111111 #b110011000011011)
                arg2
                (fp #b1 #b000001101 #b100100011101101)))

(declare-const result (_ FloatingPoint 9 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 16))
(assert (fp.leq (fp #b1 #b100000011 #b110111000011010)
                expect
                (fp #b0 #b111111100 #b000111001100111)))
(assert (fp.leq (fp #b0 #b111111100 #b000111001100111)
                expect
                (fp #b0 #b111111101 #b101000000000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
