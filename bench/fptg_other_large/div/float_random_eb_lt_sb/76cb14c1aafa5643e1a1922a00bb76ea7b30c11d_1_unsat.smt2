(assert (fp.leq (fp #b1 #b0100111001 #b1101111101100)
                expect
                (fp #b0 #b0000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000000000)
                expect
                (fp #b0 #b1011010111 #b1111100011111)))

(assert (not (= expect result)))

