;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 29))
(assert (fp.leq (fp #b1 #b01000100 #b1010011100001000000011100001)
                arg1
                (fp #b1 #b00010011 #b0001001010101101111110010010)))
(assert (fp.leq (fp #b1 #b00010011 #b0001001010101101111110010010)
                arg1
                (fp #b0 #b11011101 #b0010110011110010001110100101)))

(declare-const arg2 (_ FloatingPoint 8 29))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 8 29))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 29))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10000100 #b1110010011001111000111010000)
                expect
                (fp #b1 #b00000000 #b0000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b0000000000000000000000000000)
                expect
                (fp #b0 #b00011010 #b0010001010000100001110011011)))

(assert (= expect result))

(check-sat)
(exit)
