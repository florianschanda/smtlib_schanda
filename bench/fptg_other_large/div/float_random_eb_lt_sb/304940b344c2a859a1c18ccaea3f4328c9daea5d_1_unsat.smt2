                arg2
                (fp #b0 #b01010110110110 #b11101111011100001000000101011111)))

(declare-const result (_ FloatingPoint 14 33))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 33))
