(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 40))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 40))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b110111111010 #b000101001011110101001111110001101010100)
                arg2
                (fp #b1 #b000000000000 #b000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b001111001111 #b010101100110110111100110100001110110000)))

(declare-const result (_ FloatingPoint 12 40))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 40))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
