; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 18))
(assert (fp.leq (fp #b1 #b0111100000 #b11100011001101001)
                arg1
                (fp #b1 #b0000000000 #b01000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000000000000000)
                arg1
                (fp #b0 #b0110100011 #b01000101110110111)))

(declare-const arg2 (_ FloatingPoint 10 18))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0101111101 #b00001001010001000)
                arg2
                (fp #b0 #b0000000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000000000000000)
                arg2
                (fp #b0 #b0100100011 #b01011010100010100)))

(declare-const result (_ FloatingPoint 10 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 18))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
