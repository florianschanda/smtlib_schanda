(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10101111011 #b1100)
                arg1
                (fp #b1 #b00111111110 #b0000)))
(assert (fp.leq (fp #b1 #b00111111110 #b0000)
                arg1
                (fp #b1 #b00001101110 #b0101)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10100010110 #b1010)
                arg2
                (fp #b1 #b00000000000 #b1110)))
(assert (fp.leq (fp #b1 #b00000000000 #b1110)
                arg2
                (fp #b0 #b01011010110 #b0110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b10000101111 #b1111)
                expect
                (fp #b0 #b10111111100 #b0011)))
(assert (fp.leq (fp #b0 #b10111111100 #b0011)
                expect
                (fp #b0 #b11000110001 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
