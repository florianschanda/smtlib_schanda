; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111011 #b0010100)
                arg1
                (fp #b1 #b1100011110 #b0100010)))
(assert (fp.leq (fp #b1 #b1100011110 #b0100010)
                arg1
                (fp #b1 #b1011101011 #b0100111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110010000 #b1010110)
                arg2
                (fp #b1 #b1000011110 #b1111100)))
(assert (fp.leq (fp #b1 #b1000011110 #b1111100)
                arg2
                (fp #b0 #b0001000001 #b0000111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0111110001 #b1111001)
                expect
                (fp #b0 #b1011111110 #b0100101)))
(assert (fp.leq (fp #b0 #b1011111110 #b0100101)
                expect
                (fp #b0 #b1111001110 #b1011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
