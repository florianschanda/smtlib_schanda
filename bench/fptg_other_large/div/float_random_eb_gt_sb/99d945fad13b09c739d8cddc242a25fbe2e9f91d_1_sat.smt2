(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10011100100 #b100)
                arg1
                (fp #b1 #b00000000001 #b000)))
(assert (fp.leq (fp #b1 #b00000000001 #b000)
                arg1
                (fp #b0 #b10011010011 #b010)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10001011001 #b110)
                arg2
                (fp #b0 #b01111111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111111 #b101)
                arg2
                (fp #b0 #b11011100010 #b100)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10010111100 #b100)
                expect
                (fp #b1 #b00000000000 #b100)))
(assert (fp.leq (fp #b1 #b00000000000 #b100)
                expect
                (fp #b0 #b10001011101 #b000)))

(assert (= expect result))

(check-sat)
(exit)
