(assert (fp.leq (fp #b0 #b0000000000000 #b11)
                arg2
                (fp #b0 #b0111111010010 #b01)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0001001001010 #b10)
                expect
