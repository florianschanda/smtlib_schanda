(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1001001001010 #b0000111011)
                arg1
                (fp #b0 #b0111111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b0111111111111 #b1001100100)
                arg1
                (fp #b0 #b1110111111011 #b0111000101)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1011110000010 #b1111001000)
                arg2
                (fp #b1 #b0000000000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1111111111)
                arg2
                (fp #b0 #b0010010100010 #b1011000100)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1111111111101 #b1010110000)
                expect
                (fp #b1 #b1111111111101 #b1001100101)))
(assert (fp.leq (fp #b1 #b1111111111101 #b1001100101)
                expect
                (fp #b0 #b1011011011100 #b0100001101)))

(assert (= expect result))

(check-sat)
(exit)
