; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b011001011111 #b101100111)
                arg1
                (fp #b0 #b000000000000 #b011110111)))
(assert (fp.leq (fp #b0 #b000000000000 #b011110111)
                arg1
                (fp #b0 #b101010001111 #b111110001)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110010111011 #b100000101)
                arg2
                (fp #b1 #b100000001000 #b100111000)))
(assert (fp.leq (fp #b1 #b100000001000 #b100111000)
                arg2
                (fp #b0 #b101010011100 #b110011111)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110100100100 #b010001100)
                expect
                (fp #b1 #b000000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b000000001)
                expect
                (fp #b0 #b011011111001 #b000100001)))

(assert (= expect result))

(check-sat)
(exit)
