(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011000110 #b101011)
                arg1
                (fp #b1 #b001111101 #b000000)))
(assert (fp.leq (fp #b1 #b001111101 #b000000)
                arg1
                (fp #b0 #b010000011 #b100000)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111111111 #b000000)
                arg2
                (fp #b1 #b111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111110 #b111111)
                arg2
                (fp #b1 #b101100001 #b100011)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011111100 #b001111)
                expect
                (fp #b0 #b000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000)
                expect
                (fp #b0 #b011000010 #b000100)))

(assert (= expect result))

(check-sat)
(exit)
