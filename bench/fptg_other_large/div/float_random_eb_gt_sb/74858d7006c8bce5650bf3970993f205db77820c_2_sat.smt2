; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b111011000010010001 #b11100101)
                arg1
                (fp #b1 #b011111111111111111 #b00100101)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b00100101)
                arg1
                (fp #b0 #b000000000001111010 #b10110001)))

(declare-const arg2 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b111111001010001000 #b00000110)
                arg2
                (fp #b1 #b100000000000000111 #b11010011)))
(assert (fp.leq (fp #b1 #b100000000000000111 #b11010011)
                arg2
                (fp #b1 #b010010010011010110 #b00001101)))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b011000000000010011 #b10011101)
                expect
                (fp #b0 #b011111111111110110 #b01000010)))
(assert (fp.leq (fp #b0 #b011111111111110110 #b01000010)
                expect
                (fp #b0 #b110110000010011101 #b10001111)))

(assert (= expect result))

(check-sat)
(exit)
