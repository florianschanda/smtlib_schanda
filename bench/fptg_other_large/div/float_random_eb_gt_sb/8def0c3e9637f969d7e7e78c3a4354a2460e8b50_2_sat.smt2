(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b010110010001101001 #b1110110)
                arg1
                (fp #b0 #b000000000000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b1100101)
                arg1
                (fp #b0 #b001011101110101101 #b1100110)))

(declare-const arg2 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b100000011101010100 #b0111110)
                arg2
                (fp #b1 #b000000000000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000011)
                arg2
                (fp #b0 #b011101111100101100 #b0011001)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b101101111110010101 #b1001010)
                expect
                (fp #b1 #b100000000000000100 #b0000111)))
(assert (fp.leq (fp #b1 #b100000000000000100 #b0000111)
                expect
                (fp #b0 #b110000111101011010 #b1010101)))

(assert (= expect result))

(check-sat)
(exit)
