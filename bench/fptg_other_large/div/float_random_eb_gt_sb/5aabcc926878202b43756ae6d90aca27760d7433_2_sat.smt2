(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00000101101101 #b0110)
                arg1
                (fp #b0 #b00000000000001 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b0000)
                arg1
                (fp #b0 #b01101101011100 #b0001)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01111000101101 #b1010)
                arg2
                (fp #b1 #b00000000000000 #b1110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1110)
                arg2
                (fp #b0 #b11010100100000 #b0011)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11100001001001 #b1001)
                expect
                (fp #b1 #b01111111111111 #b0011)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0011)
                expect
                (fp #b0 #b00011010110011 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
