(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011111101110 #b111)
                arg1
                (fp #b0 #b100000000010 #b111)))
(assert (fp.leq (fp #b0 #b100000000010 #b111)
                arg1
                (fp #b0 #b100001001110 #b011)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010101001101 #b110)
                arg2
                (fp #b0 #b000000000000 #b110)))
(assert (fp.leq (fp #b0 #b000000000000 #b110)
                arg2
                (fp #b0 #b000001110010 #b010)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011001010111 #b101)
                expect
                (fp #b0 #b111111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111)
                expect
                (fp #b0 #b111111111111 #b000)))

(assert (= expect result))

(check-sat)
(exit)
