(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1011001000110100 #b111)
                arg1
                (fp #b1 #b1000111101011111 #b101)))
(assert (fp.leq (fp #b1 #b1000111101011111 #b101)
                arg1
                (fp #b1 #b0111001010111111 #b000)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b0000000110011101 #b100)
                arg2
                (fp #b0 #b1000000000000000 #b100)))
(assert (fp.leq (fp #b0 #b1000000000000000 #b100)
                arg2
                (fp #b0 #b1010100010111100 #b101)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111000111011101 #b000)
                expect
                (fp #b1 #b1000111101011110 #b001)))
(assert (fp.leq (fp #b1 #b1000111101011110 #b001)
                expect
                (fp #b1 #b0000101111011001 #b110)))

(assert (= expect result))

(check-sat)
(exit)
