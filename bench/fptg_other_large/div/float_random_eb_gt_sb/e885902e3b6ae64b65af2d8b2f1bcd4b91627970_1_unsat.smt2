(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10011000010 #b0010)
                arg1
                (fp #b1 #b10010110111 #b0011)))
(assert (fp.leq (fp #b1 #b10010110111 #b0011)
                arg1
                (fp #b1 #b10001100000 #b0110)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10110000111 #b0110)
                arg2
                (fp #b0 #b10101000111 #b1110)))
(assert (fp.leq (fp #b0 #b10101000111 #b1110)
                arg2
                (fp #b0 #b10111000001 #b0101)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11011101101 #b1110)
                expect
                (fp #b1 #b01101101110 #b0100)))
(assert (fp.leq (fp #b1 #b01101101110 #b0100)
                expect
                (fp #b0 #b10110001001 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
