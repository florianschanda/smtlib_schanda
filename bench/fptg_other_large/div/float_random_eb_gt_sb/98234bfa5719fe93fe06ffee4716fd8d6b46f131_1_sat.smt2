(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11000101010 #b010111001)
                arg1
                (fp #b1 #b00000000000 #b100100111)))
(assert (fp.leq (fp #b1 #b00000000000 #b100100111)
                arg1
                (fp #b0 #b00101010000 #b000000010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000101101 #b100111110)
                expect
                (fp #b0 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000000)
                expect
                (fp #b0 #b10000111100 #b000110110)))

(assert (= expect result))

(check-sat)
(exit)
