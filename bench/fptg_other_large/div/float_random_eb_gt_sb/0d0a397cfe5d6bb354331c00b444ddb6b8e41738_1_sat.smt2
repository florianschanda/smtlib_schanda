(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b00111110000111000 #b111110)
                arg1
                (fp #b1 #b00100100000000010 #b010101)))
(assert (fp.leq (fp #b1 #b00100100000000010 #b010101)
                arg1
                (fp #b0 #b00101111100000111 #b000000)))

(declare-const arg2 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b11010110010001111 #b000101)
                arg2
                (fp #b0 #b01101011011111001 #b001010)))
(assert (fp.leq (fp #b0 #b01101011011111001 #b001010)
                arg2
                (fp #b0 #b10100110101010001 #b010001)))

(declare-const result (_ FloatingPoint 17 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b11011100100010101 #b001110)
                expect
                (fp #b1 #b00111000100001000 #b001001)))
(assert (fp.leq (fp #b1 #b00111000100001000 #b001001)
                expect
                (fp #b0 #b01001010110110010 #b111000)))

(assert (= expect result))

(check-sat)
(exit)
