; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1101010001 #b010)
                arg1
                (fp #b1 #b1010111001 #b001)))
(assert (fp.leq (fp #b1 #b1010111001 #b001)
                arg1
                (fp #b0 #b0111000001 #b001)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001001111 #b000)
                arg2
                (fp #b1 #b0111111111 #b000)))
(assert (fp.leq (fp #b1 #b0111111111 #b000)
                arg2
                (fp #b0 #b0011100101 #b010)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0001000000 #b001)
                expect
                (fp #b0 #b1010111001 #b001)))
(assert (fp.leq (fp #b0 #b1010111001 #b001)
                expect
                (fp #b0 #b1100010011 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
