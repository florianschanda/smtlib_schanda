(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111111 #b00)
                arg1
                (fp #b1 #b11111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111110 #b11)
                arg1
                (fp #b0 #b11111100010 #b01)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11011011010 #b11)
                arg2
                (fp #b1 #b10010110011 #b10)))
(assert (fp.leq (fp #b1 #b10010110011 #b10)
                arg2
                (fp #b0 #b00101110100 #b01)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b00100001110 #b11)
                expect
                (fp #b0 #b11101001010 #b00)))
(assert (fp.leq (fp #b0 #b11101001010 #b00)
                expect
                (fp #b0 #b11110010100 #b10)))

(assert (= expect result))

(check-sat)
(exit)
