; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111001011 #b00111)
                arg1
                (fp #b1 #b000000000 #b11011)))
(assert (fp.leq (fp #b1 #b000000000 #b11011)
                arg1
                (fp #b0 #b011110100 #b11000)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110010011 #b11101)
                arg2
                (fp #b0 #b000101011 #b10011)))
(assert (fp.leq (fp #b0 #b000101011 #b10011)
                arg2
                (fp #b0 #b101101001 #b00001)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011111101 #b11011)
                expect
                (fp #b1 #b011010100 #b00010)))
(assert (fp.leq (fp #b1 #b011010100 #b00010)
                expect
                (fp #b0 #b110000111 #b10110)))

(assert (not (= expect result)))

(check-sat)
(exit)
