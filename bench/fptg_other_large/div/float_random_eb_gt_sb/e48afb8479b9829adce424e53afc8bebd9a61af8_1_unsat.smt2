(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100000 #b10100)
                arg1
                (fp #b1 #b111100000 #b00011)))
(assert (fp.leq (fp #b1 #b111100000 #b00011)
                arg1
                (fp #b0 #b010001101 #b11000)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011101010 #b00101)
                arg2
                (fp #b0 #b000000001 #b00000)))
(assert (fp.leq (fp #b0 #b000000001 #b00000)
                arg2
                (fp #b0 #b000101110 #b00110)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                expect
                (fp #b1 #b111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111)
                expect
                (fp #b1 #b110111110 #b10101)))

(assert (not (= expect result)))

(check-sat)
(exit)
