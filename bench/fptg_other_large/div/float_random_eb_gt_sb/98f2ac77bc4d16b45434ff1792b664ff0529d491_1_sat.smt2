(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01100100110011011 #b101)
                arg1
                (fp #b0 #b01001010101010000 #b100)))
(assert (fp.leq (fp #b0 #b01001010101010000 #b100)
                arg1
                (fp #b0 #b01101010011010111 #b000)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10000001100010100 #b101)
                arg2
                (fp #b1 #b00111111111111110 #b011)))
(assert (fp.leq (fp #b1 #b00111111111111110 #b011)
                arg2
                (fp #b0 #b10101100010011101 #b001)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10011010100111110 #b111)
                expect
                (fp #b1 #b10001010101010001 #b000)))
(assert (fp.leq (fp #b1 #b10001010101010001 #b000)
                expect
                (fp #b0 #b10010011100011101 #b000)))

(assert (= expect result))

(check-sat)
(exit)
