(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100000110001 #b01)
                arg1
                (fp #b0 #b000000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000000 #b10)
                arg1
                (fp #b0 #b000111000011 #b11)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111111111111 #b00)
                arg2
                (fp #b1 #b111111111110 #b11)))
(assert (fp.leq (fp #b1 #b111111111110 #b11)
                arg2
                (fp #b1 #b100111001100 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110011010111 #b01)
                expect
                (fp #b1 #b000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000 #b01)
                expect
                (fp #b0 #b110101011000 #b00)))

(assert (= expect result))

(check-sat)
(exit)
