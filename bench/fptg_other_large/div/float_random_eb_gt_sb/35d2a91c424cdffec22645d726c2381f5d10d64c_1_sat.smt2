(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10111001011 #b0000111)
                arg1
                (fp #b1 #b01001000111 #b0100111)))
(assert (fp.leq (fp #b1 #b01001000111 #b0100111)
                arg1
                (fp #b0 #b01000100101 #b0100001)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11011101000 #b0001010)
                arg2
                (fp #b0 #b01111111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000001)
                arg2
                (fp #b0 #b10100001001 #b1110011)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01001100100 #b0011000)
                expect
                (fp #b1 #b01001000111 #b0100101)))
(assert (fp.leq (fp #b1 #b01001000111 #b0100101)
                expect
                (fp #b0 #b11001110100 #b1001100)))

(assert (= expect result))

(check-sat)
(exit)
