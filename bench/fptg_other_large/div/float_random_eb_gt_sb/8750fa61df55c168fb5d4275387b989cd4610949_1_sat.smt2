(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b00000110010001 #b01010010)
                arg1
                (fp #b0 #b10011101011000 #b11010000)))
(assert (fp.leq (fp #b0 #b10011101011000 #b11010000)
                arg1
                (fp #b0 #b11011001011100 #b11001110)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01011001110000 #b10101011)
                expect
                (fp #b0 #b00000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000000)
                expect
                (fp #b0 #b10101100010010 #b01001101)))

(assert (= expect result))

(check-sat)
(exit)
