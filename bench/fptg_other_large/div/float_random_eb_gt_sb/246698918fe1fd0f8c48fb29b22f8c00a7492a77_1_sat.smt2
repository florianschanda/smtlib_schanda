(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b0 #b001000100101000 #b1)
                arg1
                (fp #b0 #b010000000000000 #b0)))
(assert (fp.leq (fp #b0 #b010000000000000 #b0)
                arg1
                (fp #b0 #b110011010101100 #b0)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b100101010101000 #b1)
                arg2
                (fp #b0 #b011000000111010 #b1)))
(assert (fp.leq (fp #b0 #b011000000111010 #b1)
                arg2
                (fp #b0 #b100011100011000 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110011010111110 #b0)
                expect
                (fp #b0 #b010111111000100 #b0)))
(assert (fp.leq (fp #b0 #b010111111000100 #b0)
                expect
                (fp #b0 #b101100101001111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
