;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111111 #b000000)
                arg1
                (fp #b1 #b111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111111)
                arg1
                (fp #b1 #b101001110001101 #b010111)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b110000000000000 #b111001)
                arg2
                (fp #b1 #b101101011110011 #b100001)))
(assert (fp.leq (fp #b1 #b101101011110011 #b100001)
                arg2
                (fp #b1 #b011000001100101 #b010111)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b101110110000101 #b010000)
                expect
                (fp #b0 #b110010100001010 #b010100)))
(assert (fp.leq (fp #b0 #b110010100001010 #b010100)
                expect
                (fp #b0 #b111010010110010 #b100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
