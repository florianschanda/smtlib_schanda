(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101011100 #b11)
                arg1
                (fp #b0 #b011111111 #b00)))
(assert (fp.leq (fp #b0 #b011111111 #b00)
                arg1
                (fp #b0 #b100001001 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b010111101 #b10)
                arg2
                (fp #b0 #b111111110 #b11)))
(assert (fp.leq (fp #b0 #b111111110 #b11)
                arg2
                (fp #b0 #b111111111 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b001110101 #b01)
                expect
                (fp #b0 #b000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000 #b01)
                expect
                (fp #b0 #b100100101 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
