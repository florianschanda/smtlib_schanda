(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01110111010101101 #b101)
                arg1
                (fp #b1 #b00111111111111110 #b011)))
(assert (fp.leq (fp #b1 #b00111111111111110 #b011)
                arg1
                (fp #b0 #b11000010010010110 #b011)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b0 #b10110100111101101 #b110)
                arg2
                (fp #b0 #b11111111111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b111)
                arg2
                (fp #b0 #b11111111111111111 #b000)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11011001111101111 #b111)
                expect
                (fp #b1 #b00000000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b001)
                expect
                (fp #b0 #b10000111001011001 #b011)))

(assert (= expect result))

(check-sat)
(exit)
