(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110000110101 #b01)
                arg1
                (fp #b0 #b101101001101 #b00)))
(assert (fp.leq (fp #b0 #b101101001101 #b00)
                arg1
                (fp #b0 #b111110011110 #b11)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110011100000 #b11)
                arg2
                (fp #b1 #b100111011111 #b01)))
(assert (fp.leq (fp #b1 #b100111011111 #b01)
                arg2
                (fp #b0 #b110110101000 #b11)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101101001000 #b11)
                expect
                (fp #b1 #b100101101100 #b11)))
(assert (fp.leq (fp #b1 #b100101101100 #b11)
                expect
                (fp #b0 #b011011110011 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
