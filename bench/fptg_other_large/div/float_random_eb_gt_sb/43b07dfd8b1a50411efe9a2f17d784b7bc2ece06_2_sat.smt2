(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11110011010001 #b101)
                arg1
                (fp #b1 #b00000111001001 #b011)))
(assert (fp.leq (fp #b1 #b00000111001001 #b011)
                arg1
                (fp #b0 #b00011111101110 #b111)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00010000001000 #b111)
                arg2
                (fp #b0 #b10000000000000 #b100)))
(assert (fp.leq (fp #b0 #b10000000000000 #b100)
                arg2
                (fp #b0 #b11101100011110 #b001)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11100111011111 #b010)
                expect
                (fp #b1 #b00000111000111 #b111)))
(assert (fp.leq (fp #b1 #b00000111000111 #b111)
                expect
                (fp #b0 #b10110000010101 #b001)))

(assert (= expect result))

(check-sat)
(exit)
