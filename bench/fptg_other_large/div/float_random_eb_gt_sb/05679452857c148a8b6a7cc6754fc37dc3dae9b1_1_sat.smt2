(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b0101110011000010 #b100011110101)
                arg1
                (fp #b0 #b1001101000110111 #b010110101101)))
(assert (fp.leq (fp #b0 #b1001101000110111 #b010110101101)
                arg1
                (fp #b0 #b1011011011110001 #b100111001101)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1010011010110100 #b010101110001)
                arg2
                (fp #b1 #b0111111101100101 #b010101010000)))
(assert (fp.leq (fp #b1 #b0111111101100101 #b010101010000)
                arg2
                (fp #b0 #b0100011001010010 #b011111000011)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1001101110011110 #b101101101100)
                expect
                (fp #b1 #b1001101011010001 #b000001000101)))
(assert (fp.leq (fp #b1 #b1001101011010001 #b000001000101)
                expect
                (fp #b0 #b1000010010100101 #b010100111000)))

(assert (= expect result))

(check-sat)
(exit)
