; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10111100110 #b011000110)
                arg1
                (fp #b1 #b10000001000 #b101100010)))
(assert (fp.leq (fp #b1 #b10000001000 #b101100010)
                arg1
                (fp #b1 #b00001101111 #b110010101)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11101100111 #b110110100)
                arg2
                (fp #b1 #b10111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b111111111)
                arg2
                (fp #b0 #b00011111010 #b101001100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01000001000 #b100001000)
                expect
                (fp #b0 #b01000001000 #b101100011)))
(assert (fp.leq (fp #b0 #b01000001000 #b101100011)
                expect
                (fp #b0 #b01000010111 #b100011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
