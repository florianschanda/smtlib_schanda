(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b0110011100100000 #b011100110)
                expect
                (fp #b0 #b1000000000001000 #b000000100)))
(assert (fp.leq (fp #b0 #b1000000000001000 #b000000100)
                expect
                (fp #b0 #b1010100010111011 #b100101000)))

(assert (not (= expect result)))

