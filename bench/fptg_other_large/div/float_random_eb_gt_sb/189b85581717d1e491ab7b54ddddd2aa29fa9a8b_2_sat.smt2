; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111111000101100 #b0100)
                arg1
                (fp #b1 #b110001000010100 #b1010)))
(assert (fp.leq (fp #b1 #b110001000010100 #b1010)
                arg1
                (fp #b1 #b010101101010111 #b1000)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110001101101110 #b1101)
                arg2
                (fp #b0 #b110010111010010 #b0010)))
(assert (fp.leq (fp #b0 #b110010111010010 #b0010)
                arg2
                (fp #b0 #b111110100110011 #b1011)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b011110011011111 #b0111)
                expect
                (fp #b1 #b011110001000001 #b1000)))
(assert (fp.leq (fp #b1 #b011110001000001 #b1000)
                expect
                (fp #b0 #b100110011011110 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
