; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01000110110110 #b010)
                arg1
                (fp #b1 #b00000000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010)
                arg1
                (fp #b0 #b10001000010001 #b010)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10000011001000 #b001)
                arg2
                (fp #b0 #b00000000000000 #b001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b001)
                arg2
                (fp #b0 #b01000101100001 #b001)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10100010101001 #b000)
                expect
                (fp #b1 #b10000000000000 #b000)))
(assert (fp.leq (fp #b1 #b10000000000000 #b000)
                expect
                (fp #b1 #b01001110110110 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
