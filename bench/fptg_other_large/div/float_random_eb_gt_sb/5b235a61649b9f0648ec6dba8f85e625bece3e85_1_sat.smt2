(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111010111 #b111)
                arg1
                (fp #b1 #b000000000 #b001)))
(assert (fp.leq (fp #b1 #b000000000 #b001)
                arg1
                (fp #b0 #b101010011 #b110)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011110100 #b101)
                arg2
                (fp #b1 #b000000001 #b000)))
(assert (fp.leq (fp #b1 #b000000001 #b000)
                arg2
                (fp #b0 #b010010110 #b000)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b001011001 #b010)
                expect
                (fp #b0 #b011111100 #b000)))
(assert (fp.leq (fp #b0 #b011111100 #b000)
                expect
                (fp #b0 #b101000111 #b101)))

(assert (= expect result))

(check-sat)
(exit)
