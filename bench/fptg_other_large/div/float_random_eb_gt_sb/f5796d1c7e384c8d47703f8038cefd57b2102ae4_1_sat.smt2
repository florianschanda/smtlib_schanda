(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1000011111001 #b100)
                arg1
                (fp #b1 #b0100101011001 #b101)))
(assert (fp.leq (fp #b1 #b0100101011001 #b101)
                arg1
                (fp #b0 #b0100010001100 #b100)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1101100101011 #b101)
                arg2
                (fp #b1 #b1000000000010 #b100)))
(assert (fp.leq (fp #b1 #b1000000000010 #b100)
                arg2
                (fp #b0 #b0000011101000 #b100)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1011000100010 #b111)
                expect
                (fp #b0 #b0100101010110 #b000)))
(assert (fp.leq (fp #b0 #b0100101010110 #b000)
                expect
                (fp #b0 #b0111100101101 #b001)))

(assert (= expect result))

(check-sat)
(exit)
