(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00010010101110001 #b010110101)
                expect
                (fp #b0 #b00000000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b000000000)
                expect
                (fp #b0 #b01011001101001110 #b011010011)))

(assert (not (= expect result)))

