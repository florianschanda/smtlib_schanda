(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b101011000011 #b0101)
                arg1
                (fp #b1 #b011111111111 #b1010)))
(assert (fp.leq (fp #b1 #b011111111111 #b1010)
                arg1
                (fp #b0 #b001110011110 #b0101)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b000010001010 #b1101)
                arg2
                (fp #b0 #b101111111110 #b1111)))
(assert (fp.leq (fp #b0 #b101111111110 #b1111)
                arg2
                (fp #b0 #b110010100110 #b0001)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011110000100 #b0011)
                expect
                (fp #b1 #b001111111111 #b1010)))
(assert (fp.leq (fp #b1 #b001111111111 #b1010)
                expect
                (fp #b0 #b110100011110 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
