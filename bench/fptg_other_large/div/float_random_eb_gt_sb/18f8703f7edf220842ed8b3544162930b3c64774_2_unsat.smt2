; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b101101011100001 #b011001)
                arg1
                (fp #b1 #b000000000000000 #b111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b111111)
                arg1
                (fp #b0 #b010000011110001 #b000101)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111100001101100 #b010010)
                arg2
                (fp #b1 #b110101111000011 #b101001)))
(assert (fp.leq (fp #b1 #b110101111000011 #b101001)
                arg2
                (fp #b0 #b100000100001000 #b010010)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b000011000101110 #b011110)
                expect
                (fp #b0 #b000000000000000 #b000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000001)
                expect
                (fp #b0 #b010011100100110 #b000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
