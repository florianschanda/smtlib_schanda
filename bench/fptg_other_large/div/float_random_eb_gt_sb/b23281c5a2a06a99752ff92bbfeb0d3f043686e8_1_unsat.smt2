; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b111111001010100 #b11100000110)
                arg1
                (fp #b0 #b100000000001010 #b10001010101)))
(assert (fp.leq (fp #b0 #b100000000001010 #b10001010101)
                arg1
                (fp #b0 #b100110110001001 #b10011000100)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b111110110100010 #b01101010100)
                arg2
                (fp #b1 #b111001001001101 #b00011101001)))
(assert (fp.leq (fp #b1 #b111001001001101 #b00011101001)
                arg2
                (fp #b1 #b110001100010001 #b11000110011)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b110011100001000 #b11001011001)
                expect
                (fp #b1 #b000110110111100 #b01100010010)))
(assert (fp.leq (fp #b1 #b000110110111100 #b01100010010)
                expect
                (fp #b0 #b010101001011010 #b01011111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
