(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00001111001 #b01100011)
                arg1
                (fp #b0 #b11111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b00000000)
                arg1
                (fp #b0 #b11111111110 #b00010011)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b01010111111 #b11110110)
                arg2
                (fp #b0 #b11111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b11111111)
                arg2
                (fp #b0 #b11111111111 #b00000000)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b00111111110 #b01010111)
                expect
                (fp #b0 #b01111111101 #b00000001)))
(assert (fp.leq (fp #b0 #b01111111101 #b00000001)
                expect
                (fp #b0 #b10000011100 #b00011101)))

(assert (= expect result))

(check-sat)
(exit)
