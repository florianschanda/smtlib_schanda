; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b110001001001000111 #b1)
                arg1
                (fp #b0 #b000000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b1)
                arg1
                (fp #b0 #b001001111100010011 #b1)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b101111010010101001 #b0)
                arg2
                (fp #b0 #b111111111111111101 #b0)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0)
                arg2
                (fp #b0 #b111111111111111101 #b1)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001110111010010111 #b0)
                expect
                (fp #b0 #b000000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0)
                expect
                (fp #b0 #b000110011001000110 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
