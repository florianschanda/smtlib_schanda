(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b0 #b00110010000101 #b011001011)
                arg1
                (fp #b0 #b01111111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b01111111111111 #b111111100)
                arg1
                (fp #b0 #b11001100010001 #b001000100)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01100111011000 #b110110100)
                expect
                (fp #b1 #b00000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b000000000)
                expect
                (fp #b0 #b00000110011000 #b000011001)))

(assert (= expect result))

(check-sat)
(exit)
