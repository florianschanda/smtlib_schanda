;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11111111111111110 #b010110011011001)
                arg1
                (fp #b1 #b11111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b000000000000000)
                arg1
                (fp #b1 #b01101110011010111 #b001101011000101)))

(declare-const arg2 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b0 #b00101100000111000 #b110110001000101)
                arg2
                (fp #b0 #b11111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b111111111111111)
                arg2
                (fp #b0 #b11111111111111111 #b000000000000000)))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b10100001011001111 #b011111101000101)
                expect
                (fp #b1 #b01111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111111101 #b000000000000000)
                expect
                (fp #b0 #b11111101110100111 #b001000111010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
