(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100110011 #b10010)
                arg1
                (fp #b0 #b001111101 #b01101)))
(assert (fp.leq (fp #b0 #b001111101 #b01101)
                arg1
                (fp #b0 #b101110001 #b11110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111110000 #b10000)
                arg2
                (fp #b0 #b111111101 #b00000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000)
                arg2
                (fp #b0 #b111111101 #b00011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110110011 #b11110)
                expect
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                expect
                (fp #b0 #b101101100 #b10110)))

(assert (= expect result))

(check-sat)
(exit)
