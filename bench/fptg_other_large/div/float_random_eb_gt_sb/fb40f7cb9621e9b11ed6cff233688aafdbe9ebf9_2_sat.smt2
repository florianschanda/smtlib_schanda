(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100111000000 #b11)
                arg1
                (fp #b0 #b001111111111 #b00)))
(assert (fp.leq (fp #b0 #b001111111111 #b00)
                arg1
                (fp #b0 #b111000110000 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b100110010110 #b01)
                arg2
                (fp #b0 #b101111111110 #b11)))
(assert (fp.leq (fp #b0 #b101111111110 #b11)
                arg2
                (fp #b0 #b110101011001 #b01)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111101100011 #b00)
                expect
                (fp #b0 #b000000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000000 #b10)
                expect
                (fp #b0 #b111001001001 #b11)))

(assert (= expect result))

(check-sat)
(exit)
