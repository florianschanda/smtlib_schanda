                (fp #b0 #b00010101001 #b11001)))
(assert (fp.leq (fp #b0 #b00010101001 #b11001)
                arg2
                (fp #b0 #b10100111110 #b00011)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111010111 #b10110)
                expect
                (fp #b1 #b11101010100 #b00011)))
(assert (fp.leq (fp #b1 #b11101010100 #b00011)
                expect
                (fp #b1 #b00000111000 #b01110)))

(assert (not (= expect result)))

(check-sat)
(exit)
