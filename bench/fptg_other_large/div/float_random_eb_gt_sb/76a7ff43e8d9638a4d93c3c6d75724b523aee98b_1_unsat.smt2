; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11011011011100 #b110010100)
                arg1
                (fp #b1 #b10000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b10000000001001 #b000000000)
                arg1
                (fp #b0 #b11010100111101 #b111101110)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11011000011101 #b100111001)
                expect
                (fp #b0 #b00000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000000000)
                expect
                (fp #b0 #b10000100101111 #b010101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
