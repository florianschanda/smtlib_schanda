(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b100101011011100 #b1101111)
                arg1
                (fp #b0 #b111100000110100 #b1001111)))
(assert (fp.leq (fp #b0 #b111100000110100 #b1001111)
                arg1
                (fp #b0 #b111100010010010 #b0111010)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b0 #b000100101110111 #b1000010)
                arg2
                (fp #b0 #b010000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b010000000000000 #b0000000)
                arg2
                (fp #b0 #b010101011001000 #b1000010)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
