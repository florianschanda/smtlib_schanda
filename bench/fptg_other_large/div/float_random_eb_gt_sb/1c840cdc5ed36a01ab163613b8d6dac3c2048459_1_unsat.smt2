(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b010011011111101010 #b10011)
                arg1
                (fp #b0 #b000000000000000001 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000000001 #b00000)
                arg1
                (fp #b0 #b001101001001000000 #b11111)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
