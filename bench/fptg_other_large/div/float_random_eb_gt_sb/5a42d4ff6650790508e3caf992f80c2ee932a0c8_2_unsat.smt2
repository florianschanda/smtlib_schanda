; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111010110 #b0110)
                arg1
                (fp #b1 #b110100000 #b0010)))
(assert (fp.leq (fp #b1 #b110100000 #b0010)
                arg1
                (fp #b1 #b100111000 #b1011)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111000010 #b1110)
                arg2
                (fp #b1 #b001111110 #b0000)))
(assert (fp.leq (fp #b1 #b001111110 #b0000)
                arg2
                (fp #b1 #b000110001 #b0001)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
