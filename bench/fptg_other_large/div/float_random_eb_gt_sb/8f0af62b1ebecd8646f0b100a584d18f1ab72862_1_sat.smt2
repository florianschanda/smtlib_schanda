(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111010011100 #b10)
                arg1
                (fp #b1 #b100000000000 #b10)))
(assert (fp.leq (fp #b1 #b100000000000 #b10)
                arg1
                (fp #b1 #b011000111011 #b00)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b000001111010 #b11)
                arg2
                (fp #b0 #b010011100001 #b01)))
(assert (fp.leq (fp #b0 #b010011100001 #b01)
                arg2
                (fp #b0 #b110111001110 #b01)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111111010110 #b01)
                expect
                (fp #b1 #b101100011110 #b00)))
(assert (fp.leq (fp #b1 #b101100011110 #b00)
                expect
                (fp #b1 #b001111111001 #b11)))

(assert (= expect result))

(check-sat)
(exit)
