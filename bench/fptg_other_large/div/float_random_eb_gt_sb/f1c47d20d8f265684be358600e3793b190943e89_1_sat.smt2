(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0000101101011110 #b00100011)
                arg1
                (fp #b0 #b0000000000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b10100110)
                arg1
                (fp #b0 #b0000110111011000 #b00000101)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1111000011011011 #b11100010)
                expect
                (fp #b0 #b0000000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000)
                expect
                (fp #b0 #b0001110000110111 #b10111000)))

(assert (= expect result))

(check-sat)
(exit)
