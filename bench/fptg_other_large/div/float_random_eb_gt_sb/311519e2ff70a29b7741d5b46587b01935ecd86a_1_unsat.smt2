(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101101001 #b011111)
                arg1
                (fp #b0 #b1000000101 #b000111)))
(assert (fp.leq (fp #b0 #b1000000101 #b000111)
                arg1
                (fp #b0 #b1010000000 #b010011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1011000010 #b011011)
                arg2
                (fp #b0 #b1000000001 #b100000)))
(assert (fp.leq (fp #b0 #b1000000001 #b100000)
                arg2
                (fp #b0 #b1011110010 #b110111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0011111010 #b101001)
                expect
                (fp #b0 #b1000000010 #b011110)))
(assert (fp.leq (fp #b0 #b1000000010 #b011110)
                expect
                (fp #b0 #b1110111110 #b111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
