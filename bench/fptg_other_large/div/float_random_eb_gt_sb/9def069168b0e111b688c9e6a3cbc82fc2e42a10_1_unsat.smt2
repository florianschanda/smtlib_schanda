(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001010000 #b1)
                arg1
                (fp #b0 #b000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000 #b1)
                arg1
                (fp #b0 #b100111111 #b1)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111100110 #b0)
                arg2
                (fp #b1 #b100000001 #b0)))
(assert (fp.leq (fp #b1 #b100000001 #b0)
                arg2
                (fp #b0 #b000000000 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111101001 #b1)
                expect
                (fp #b1 #b000000000 #b0)))
(assert (fp.leq (fp #b1 #b000000000 #b0)
                expect
                (fp #b0 #b001011010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
