; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b001100000011011 #b000)
                arg1
                (fp #b0 #b000000000000000 #b111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b111)
                arg1
                (fp #b0 #b110100010110100 #b110)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111111110011010 #b110)
                arg2
                (fp #b1 #b111111101101110 #b110)))
(assert (fp.leq (fp #b1 #b111111101101110 #b110)
                arg2
                (fp #b1 #b001110000101100 #b010)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b010000011011111 #b100)
                expect
                (fp #b1 #b000000000000000 #b001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b001)
                expect
                (fp #b0 #b000001011000100 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
