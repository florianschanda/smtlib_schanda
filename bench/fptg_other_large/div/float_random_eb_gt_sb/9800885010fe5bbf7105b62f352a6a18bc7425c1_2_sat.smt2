(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100110111 #b001011)
                arg1
                (fp #b0 #b010000000 #b000000)))
(assert (fp.leq (fp #b0 #b010000000 #b000000)
                arg1
                (fp #b0 #b100010000 #b000100)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110010001 #b100110)
                arg2
                (fp #b1 #b101111110 #b111111)))
(assert (fp.leq (fp #b1 #b101111110 #b111111)
                arg2
                (fp #b0 #b110111110 #b000010)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110110001 #b000101)
                expect
                (fp #b1 #b000000000 #b100001)))
(assert (fp.leq (fp #b1 #b000000000 #b100001)
                expect
                (fp #b0 #b000001000 #b010001)))

(assert (= expect result))

(check-sat)
(exit)
