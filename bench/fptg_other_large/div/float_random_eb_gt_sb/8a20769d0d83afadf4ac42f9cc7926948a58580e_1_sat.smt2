(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b010011001 #b010110)
                arg1
                (fp #b0 #b101001010 #b110011)))
(assert (fp.leq (fp #b0 #b101001010 #b110011)
                arg1
                (fp #b0 #b111001001 #b010011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001101001 #b000000)
                arg2
                (fp #b0 #b011111111 #b111101)))
(assert (fp.leq (fp #b0 #b011111111 #b111101)
                arg2
                (fp #b0 #b111010000 #b100001)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b000001001 #b101110)
                expect
                (fp #b0 #b101001001 #b110101)))
(assert (fp.leq (fp #b0 #b101001001 #b110101)
                expect
                (fp #b0 #b111111001 #b011111)))

(assert (= expect result))

(check-sat)
(exit)
