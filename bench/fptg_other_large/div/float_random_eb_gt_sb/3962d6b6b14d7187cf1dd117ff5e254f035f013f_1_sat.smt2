(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b01100001001101 #b1)
                arg1
                (fp #b0 #b00000000000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1)
                arg1
                (fp #b0 #b01010101010011 #b0)))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11000101111100 #b0)
                arg2
                (fp #b0 #b10111111111110 #b1)))
(assert (fp.leq (fp #b0 #b10111111111110 #b1)
                arg2
                (fp #b0 #b11111000100100 #b0)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00001101010000 #b0)
                expect
                (fp #b0 #b00000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0)
                expect
                (fp #b0 #b01011100000110 #b0)))

(assert (= expect result))

(check-sat)
(exit)
