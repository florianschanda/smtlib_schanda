(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111101001001 #b110)
                arg1
                (fp #b1 #b00000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b001)
                arg1
                (fp #b0 #b00100111101010 #b000)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10011001110101 #b000)
                arg2
                (fp #b1 #b10000000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000000011 #b000)
                arg2
                (fp #b0 #b00000100010100 #b110)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01111101101011 #b110)
                expect
                (fp #b0 #b00000000000000 #b001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b001)
                expect
                (fp #b0 #b01001000011010 #b000)))

(assert (= expect result))

(check-sat)
(exit)
