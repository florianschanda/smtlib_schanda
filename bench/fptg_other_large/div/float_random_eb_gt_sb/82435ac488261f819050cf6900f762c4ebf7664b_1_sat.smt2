(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b001111011110110 #b1010110)
                arg1
                (fp #b0 #b111100000110100 #b1001111)))
(assert (fp.leq (fp #b0 #b111100000110100 #b1001111)
                arg1
                (fp #b0 #b111100100000010 #b1010001)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101010111011011 #b0001000)
                arg2
                (fp #b0 #b000000000000000 #b1111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1111111)
                arg2
                (fp #b0 #b010101000000111 #b1100101)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b000110100100100 #b1110000)
                expect
                (fp #b0 #b111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111111)
                expect
                (fp #b0 #b111111111111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
