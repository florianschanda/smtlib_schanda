; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101011010 #b1011100)
                arg1
                (fp #b1 #b000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b000000000 #b0100000)
                arg1
                (fp #b0 #b110001110 #b1010001)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110000111 #b1111011)
                arg2
                (fp #b0 #b000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b000000001 #b0000000)
                arg2
                (fp #b0 #b110111100 #b0011100)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111110000 #b1101000)
                expect
                (fp #b1 #b011111101 #b0000000)))
(assert (fp.leq (fp #b1 #b011111101 #b0000000)
                expect
                (fp #b0 #b100110011 #b0111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
