; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b011001101110 #b011100)
                arg1
                (fp #b0 #b101111111110 #b111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b111111)
                arg1
                (fp #b0 #b111100100110 #b000001)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b100100011110 #b010000)
                arg2
                (fp #b0 #b101110001101 #b100010)))
(assert (fp.leq (fp #b0 #b101110001101 #b100010)
                arg2
                (fp #b0 #b111010111000 #b001110)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100000001100 #b000100)
                expect
                (fp #b0 #b100001110000 #b010010)))
(assert (fp.leq (fp #b0 #b100001110000 #b010010)
                expect
                (fp #b0 #b100110001000 #b111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
