; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1000110010111110 #b00011001110110)
                arg1
                (fp #b0 #b0100000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b00000000000000)
                arg1
                (fp #b0 #b1000110100001101 #b00011100011010)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0000010101010101 #b01101010000010)
                arg2
                (fp #b0 #b1111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b00000000000000)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1101010010100010 #b10111101111011)
                expect
                (fp #b0 #b0000000000000000 #b00000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000000001)
                expect
                (fp #b0 #b0011110110001011 #b11110011101000)))

(assert (= expect result))

(check-sat)
(exit)
