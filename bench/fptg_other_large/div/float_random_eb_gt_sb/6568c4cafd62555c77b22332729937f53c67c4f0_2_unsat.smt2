(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b0 #b10110100001010 #b111000101)
                arg1
                (fp #b0 #b11111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111111111)
                arg1
                (fp #b0 #b11111111111111 #b000000000)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10011111010010 #b101011110)
                arg2
                (fp #b1 #b00000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000000)
                arg2
                (fp #b0 #b01101111010111 #b101001001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
