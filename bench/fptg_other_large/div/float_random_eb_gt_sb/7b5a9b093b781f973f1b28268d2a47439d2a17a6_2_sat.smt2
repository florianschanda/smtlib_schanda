(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b001010000 #b00001)
                arg1
                (fp #b0 #b011111111 #b10111)))
(assert (fp.leq (fp #b0 #b011111111 #b10111)
                arg1
                (fp #b0 #b111110000 #b01001)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111011110 #b01101)
                arg2
                (fp #b1 #b000000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111)
                arg2
                (fp #b0 #b011111001 #b01111)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                expect
                (fp #b1 #b111111101 #b11001)))
(assert (fp.leq (fp #b1 #b111111101 #b11001)
                expect
                (fp #b0 #b000111111 #b01011)))

(assert (= expect result))

(check-sat)
(exit)
