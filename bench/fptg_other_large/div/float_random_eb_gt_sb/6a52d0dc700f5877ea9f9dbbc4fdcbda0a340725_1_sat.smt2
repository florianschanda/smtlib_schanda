(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1110101110 #b10111101)
                arg1
                (fp #b1 #b0111111111 #b00100101)))
(assert (fp.leq (fp #b1 #b0111111111 #b00100101)
                arg1
                (fp #b1 #b0101001000 #b10000101)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0011011011 #b10100101)
                arg2
                (fp #b1 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000000)
                arg2
                (fp #b0 #b0001111011 #b00110101)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0100000110 #b00110000)
                expect
                (fp #b0 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111111)
                expect
                (fp #b0 #b1111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
