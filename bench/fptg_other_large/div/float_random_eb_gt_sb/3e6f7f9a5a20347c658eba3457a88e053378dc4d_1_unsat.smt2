;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101001110110011 #b1101100)
                arg1
                (fp #b1 #b100000000000110 #b0110001)))
(assert (fp.leq (fp #b1 #b100000000000110 #b0110001)
                arg1
                (fp #b1 #b000000110001111 #b1011100)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111011101101111 #b1010010)
                arg2
                (fp #b0 #b011000011110101 #b1011100)))
(assert (fp.leq (fp #b0 #b011000011110101 #b1011100)
                arg2
                (fp #b0 #b101001010111010 #b0111011)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101000010110000 #b1000011)
                expect
                (fp #b1 #b100111100001111 #b1001101)))
(assert (fp.leq (fp #b1 #b100111100001111 #b1001101)
                expect
                (fp #b0 #b100110110100011 #b1000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
