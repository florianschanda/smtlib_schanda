(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1001111001010 #b001011001)
                arg1
                (fp #b1 #b0111111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111111 #b000000000)
                arg1
                (fp #b1 #b0110000101011 #b110110011)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1111111001011 #b100010000)
                arg2
                (fp #b0 #b1000000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b1000000001000 #b001010110)
                arg2
                (fp #b0 #b1110101111000 #b010110011)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101001101101 #b010010011)
                expect
                (fp #b1 #b0111111110101 #b101101101)))
(assert (fp.leq (fp #b1 #b0111111110101 #b101101101)
                expect
                (fp #b1 #b0001011000001 #b111100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
