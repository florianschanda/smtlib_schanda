;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b0 #b00011001011011 #b11000111011)
                arg1
                (fp #b0 #b10000000001010 #b11000001011)))
(assert (fp.leq (fp #b0 #b10000000001010 #b11000001011)
                arg1
                (fp #b0 #b10101110001111 #b10001010000)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b00010111001010 #b10100110101)
                arg2
                (fp #b1 #b00000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b01000000000)
                arg2
                (fp #b0 #b00110011011010 #b00100101110)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11111111111111 #b00000000000)
                expect
                (fp #b1 #b11111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11111111111)
                expect
                (fp #b1 #b10000001011101 #b01101110110)))

(assert (= expect result))

(check-sat)
(exit)
