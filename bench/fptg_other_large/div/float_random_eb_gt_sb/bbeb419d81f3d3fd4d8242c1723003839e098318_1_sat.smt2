(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b0 #b010101101110100111 #b010001100)
                arg1
                (fp #b0 #b101100101001111111 #b111000010)))
(assert (fp.leq (fp #b0 #b101100101001111111 #b111000010)
                arg1
                (fp #b0 #b111110000110011010 #b001010101)))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b011000000101111011 #b010010010)
                arg2
                (fp #b1 #b000000000000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b000000001)
                arg2
                (fp #b0 #b001000000010010011 #b100100111)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111111111111111111 #b000000000)
                expect
                (fp #b1 #b111111111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b111111111)
                expect
                (fp #b1 #b011000000011110000 #b011100111)))

(assert (= expect result))

(check-sat)
(exit)
