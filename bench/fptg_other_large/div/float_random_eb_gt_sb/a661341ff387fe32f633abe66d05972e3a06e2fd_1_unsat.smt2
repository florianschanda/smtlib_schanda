(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b011111111100001 #b00)
                arg1
                (fp #b0 #b111111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00)
                arg1
                (fp #b0 #b111111111111110 #b00)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b010000100001111 #b11)
                arg2
                (fp #b0 #b101111111111110 #b11)))
(assert (fp.leq (fp #b0 #b101111111111110 #b11)
                arg2
                (fp #b0 #b110001100000100 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b110011101101001 #b10)
                expect
                (fp #b0 #b101111111111101 #b00)))
(assert (fp.leq (fp #b0 #b101111111111101 #b00)
                expect
                (fp #b0 #b111110111010111 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
