                arg2
                (fp #b0 #b001111111111100 #b0110101)))
(assert (fp.leq (fp #b0 #b001111111111100 #b0110101)
                arg2
                (fp #b0 #b101000011010110 #b1000000)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
