(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11000110100 #b10)
                arg1
                (fp #b1 #b01111111111 #b01)))
(assert (fp.leq (fp #b1 #b01111111111 #b01)
                arg1
                (fp #b0 #b11010101000 #b00)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10100100010 #b10)
                arg2
                (fp #b1 #b00000000000 #b11)))
(assert (fp.leq (fp #b1 #b00000000000 #b11)
                arg2
                (fp #b0 #b11010111001 #b11)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b10101110010 #b10)
                expect
                (fp #b0 #b11111111101 #b11)))
(assert (fp.leq (fp #b0 #b11111111101 #b11)
                expect
                (fp #b0 #b11111111110 #b10)))

(assert (= expect result))

(check-sat)
(exit)
