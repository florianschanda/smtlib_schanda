(assert (fp.leq (fp #b0 #b1101111001010100 #b11001101001)
                arg2
                (fp #b0 #b1110101101111010 #b11011111011)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1000000100011010 #b00111000100)
                expect
                (fp #b1 #b0000000000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000001)
                expect
                (fp #b0 #b1101001110100001 #b01110100111)))

(assert (= expect result))

(check-sat)
