(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111111111 #b000)
                arg1
                (fp #b1 #b1111111110 #b111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111)
                arg1
                (fp #b1 #b0001111000 #b010)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100101111 #b011)
                arg2
                (fp #b0 #b0111111111 #b101)))
(assert (fp.leq (fp #b0 #b0111111111 #b101)
                arg2
                (fp #b0 #b1000001101 #b111)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111111110 #b011)
                expect
                (fp #b1 #b1111111110 #b001)))
(assert (fp.leq (fp #b1 #b1111111110 #b001)
                expect
                (fp #b1 #b0100110011 #b100)))

(assert (= expect result))

(check-sat)
(exit)
