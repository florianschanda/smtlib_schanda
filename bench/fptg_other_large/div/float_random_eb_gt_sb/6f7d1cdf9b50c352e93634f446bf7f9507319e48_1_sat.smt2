                arg2
                (fp #b0 #b0110111001101 #b000100)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1101111000011 #b010010)
                expect
                (fp #b1 #b0111111111101 #b000010)))
(assert (fp.leq (fp #b1 #b0111111111101 #b000010)
                expect
                (fp #b0 #b0000011001010 #b000101)))

(assert (= expect result))

(check-sat)
