(assert (fp.leq (fp #b1 #b100000011010 #b0000011100)
                arg2
                (fp #b0 #b000000000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b000000000000 #b0001110101)
                arg2
                (fp #b0 #b011000111001 #b0100011111)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111111111011 #b1101010000)
                expect
                (fp #b0 #b111111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111111111)
                expect
                (fp #b0 #b111111111111 #b0000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
