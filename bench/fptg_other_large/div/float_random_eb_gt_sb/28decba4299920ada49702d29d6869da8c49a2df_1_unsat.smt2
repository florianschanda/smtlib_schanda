;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b010101100110 #b1110100101)
                arg1
                (fp #b0 #b101111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b1111111111)
