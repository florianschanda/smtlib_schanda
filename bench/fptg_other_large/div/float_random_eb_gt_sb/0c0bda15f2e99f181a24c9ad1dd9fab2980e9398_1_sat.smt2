;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10001110110110 #b00011011)
                arg1
                (fp #b1 #b10000000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b10000000001000 #b00000000)
                arg1
                (fp #b0 #b11010100010100 #b11000011)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10011101110010 #b00010111)
                arg2
                (fp #b1 #b00000000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b00000000000001 #b00000000)
                arg2
                (fp #b0 #b11110000000010 #b10111110)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11111010110110 #b11100001)
                expect
                (fp #b0 #b11111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b11111111)
                expect
                (fp #b0 #b11111111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
