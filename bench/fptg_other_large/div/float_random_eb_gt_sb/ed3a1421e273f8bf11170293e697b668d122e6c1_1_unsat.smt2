(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111110111001 #b0101001100)
                arg1
                (fp #b1 #b100000001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b100000001000 #b1101001010)
                arg1
                (fp #b0 #b001000111101 #b1000101001)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001111011010 #b0011101010)
                expect
                (fp #b1 #b000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000000)
                expect
                (fp #b0 #b001111101001 #b0010101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
