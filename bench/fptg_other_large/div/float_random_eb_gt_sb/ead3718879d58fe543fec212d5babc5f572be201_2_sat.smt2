(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10010101010001111 #b011)
                arg1
                (fp #b1 #b00000000000000000 #b110)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b110)
                arg1
                (fp #b0 #b11010100011111011 #b101)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01001000101100111 #b010)
                arg2
                (fp #b1 #b00111111111111110 #b011)))
(assert (fp.leq (fp #b1 #b00111111111111110 #b011)
                arg2
                (fp #b0 #b00100000100000110 #b001)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b00111001001100100 #b010)
                expect
                (fp #b0 #b01000000000000001 #b001)))
(assert (fp.leq (fp #b0 #b01000000000000001 #b001)
                expect
                (fp #b0 #b11100011011000000 #b110)))

(assert (= expect result))

(check-sat)
(exit)
