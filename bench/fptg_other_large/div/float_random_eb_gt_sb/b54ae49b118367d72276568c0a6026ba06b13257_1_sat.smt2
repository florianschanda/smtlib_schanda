(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1010110010000100 #b01101100010)
                arg1
                (fp #b0 #b0101000010011101 #b00100110100)))
(assert (fp.leq (fp #b0 #b0101000010011101 #b00100110100)
                arg1
                (fp #b0 #b1010101011110111 #b01101100110)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1110100100110000 #b11111001010)
                arg2
                (fp #b1 #b1011111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b1011111111111110 #b11111111111)
                arg2
                (fp #b1 #b0001001110011110 #b00011001000)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0111000000001110 #b01100011000)
                expect
                (fp #b1 #b0001000010011101 #b00100110100)))
(assert (fp.leq (fp #b1 #b0001000010011101 #b00100110100)
                expect
                (fp #b0 #b0111111100101000 #b10100001001)))

(assert (= expect result))

(check-sat)
(exit)
