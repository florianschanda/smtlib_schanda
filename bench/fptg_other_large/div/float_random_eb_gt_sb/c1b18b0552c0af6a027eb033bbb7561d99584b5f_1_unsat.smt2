(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11010001010001 #b111)
                arg1
                (fp #b1 #b00000000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010)
                arg1
                (fp #b0 #b00011000001010 #b000)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01000001110110 #b101)
                arg2
                (fp #b0 #b10111111111110 #b111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b111)
                arg2
                (fp #b0 #b11001011111100 #b101)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000100100001 #b000)
                expect
                (fp #b1 #b00000000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b000)
                expect
                (fp #b0 #b01010101101110 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
