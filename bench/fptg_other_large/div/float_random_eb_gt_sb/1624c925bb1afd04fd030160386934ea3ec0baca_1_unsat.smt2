; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b000000111000 #b101110010)
                arg1
                (fp #b0 #b000000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b111111111)
                arg1
                (fp #b0 #b010101001011 #b010010111)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b011111101110 #b101100000)
                arg2
                (fp #b1 #b000000000000 #b010000100)))
(assert (fp.leq (fp #b1 #b000000000000 #b010000100)
                arg2
                (fp #b0 #b001101000010 #b000101111)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b100011010110 #b101111011)
                expect
                (fp #b1 #b100000000000 #b111011111)))
(assert (fp.leq (fp #b1 #b100000000000 #b111011111)
                expect
                (fp #b0 #b001110010000 #b011110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
