; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10101101111000 #b100001)
                arg1
                (fp #b1 #b10000000000101 #b011101)))
(assert (fp.leq (fp #b1 #b10000000000101 #b011101)
                arg1
                (fp #b0 #b11110010100100 #b011001)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b00111010110000 #b111101)
                arg2
                (fp #b0 #b01111111111111 #b000110)))
(assert (fp.leq (fp #b0 #b01111111111111 #b000110)
                arg2
                (fp #b0 #b11110110110110 #b001111)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10110111010100 #b101011)
                expect
                (fp #b1 #b10000000000101 #b010101)))
(assert (fp.leq (fp #b1 #b10000000000101 #b010101)
                expect
                (fp #b0 #b10101010011010 #b100010)))

(assert (= expect result))

(check-sat)
(exit)
