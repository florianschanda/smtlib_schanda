(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101101010011 #b0110101101)
                arg1
                (fp #b1 #b100010110011 #b1100100001)))
(assert (fp.leq (fp #b1 #b100010110011 #b1100100001)
                arg1
                (fp #b0 #b011111100011 #b1110011110)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100100001101 #b0000111010)
                expect
                (fp #b1 #b011111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b0000000000)
                expect
                (fp #b0 #b000001111100 #b0001100111)))

(assert (= expect result))

(check-sat)
(exit)
