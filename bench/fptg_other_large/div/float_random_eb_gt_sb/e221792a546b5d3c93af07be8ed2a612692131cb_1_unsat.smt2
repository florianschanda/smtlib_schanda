(assert (fp.leq (fp #b1 #b1001000011011 #b100100)
                expect
                (fp #b0 #b0000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000)
                expect
                (fp #b0 #b1010011100010 #b100011)))

(assert (not (= expect result)))

(check-sat)
