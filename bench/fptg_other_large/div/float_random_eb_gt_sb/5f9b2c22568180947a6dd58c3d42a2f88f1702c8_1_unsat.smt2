(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1001111000011 #b0)
                arg1
                (fp #b1 #b1000001111111 #b0)))
(assert (fp.leq (fp #b1 #b1000001111111 #b0)
                arg1
                (fp #b1 #b0011010111001 #b1)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b0100110111000 #b1)
                arg2
                (fp #b0 #b0000000000000 #b1)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1)
                arg2
                (fp #b0 #b0001101110100 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111111111111 #b0)
                expect
                (fp #b1 #b1111111111110 #b1)))
(assert (fp.leq (fp #b1 #b1111111111110 #b1)
                expect
                (fp #b1 #b0111011001001 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
