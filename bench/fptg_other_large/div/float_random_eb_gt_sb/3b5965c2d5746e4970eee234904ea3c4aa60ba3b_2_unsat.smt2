; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1101000010110110 #b001011001000)
                arg1
                (fp #b1 #b1011110100000011 #b111010000011)))
(assert (fp.leq (fp #b1 #b1011110100000011 #b111010000011)
                arg1
                (fp #b0 #b1101000000111110 #b110111110110)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1100110010010000 #b110101100011)
                arg2
                (fp #b1 #b1010000010100100 #b001111010011)))
(assert (fp.leq (fp #b1 #b1010000010100100 #b001111010011)
                arg2
                (fp #b0 #b0111011000010111 #b011001001010)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b0 #b0111000100010011 #b101110110001)
                expect
                (fp #b0 #b1001110001011110 #b100010100001)))
(assert (fp.leq (fp #b0 #b1001110001011110 #b100010100001)
                expect
                (fp #b0 #b1011001001000100 #b011000000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
