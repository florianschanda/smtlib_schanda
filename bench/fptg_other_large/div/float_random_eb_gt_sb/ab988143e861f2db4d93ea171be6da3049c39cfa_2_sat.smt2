(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101010001 #b01)
                arg1
                (fp #b0 #b0111111111 #b01)))
(assert (fp.leq (fp #b0 #b0111111111 #b01)
                arg1
                (fp #b0 #b1101011011 #b01)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1000010011 #b11)
                arg2
                (fp #b1 #b0111111111 #b10)))
(assert (fp.leq (fp #b1 #b0111111111 #b10)
                arg2
                (fp #b0 #b1101000100 #b11)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101101011 #b01)
                expect
                (fp #b1 #b0111111110 #b11)))
(assert (fp.leq (fp #b1 #b0111111110 #b11)
                expect
                (fp #b0 #b0001111111 #b01)))

(assert (= expect result))

(check-sat)
(exit)
