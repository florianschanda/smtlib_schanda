; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110111011 #b10001)
                arg1
                (fp #b1 #b1011111110 #b11111)))
(assert (fp.leq (fp #b1 #b1011111110 #b11111)
                arg1
                (fp #b1 #b0111100100 #b10111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1010000110 #b01110)
                arg2
                (fp #b1 #b1000100100 #b11110)))
(assert (fp.leq (fp #b1 #b1000100100 #b11110)
                arg2
                (fp #b0 #b0000111010 #b11011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001011100 #b01001)
                expect
                (fp #b0 #b1011011001 #b00000)))
(assert (fp.leq (fp #b0 #b1011011001 #b00000)
                expect
                (fp #b0 #b1110101111 #b00101)))

(assert (not (= expect result)))

(check-sat)
(exit)
