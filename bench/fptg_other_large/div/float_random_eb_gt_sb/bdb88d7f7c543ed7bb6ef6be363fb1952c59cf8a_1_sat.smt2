(assert (fp.leq (fp #b0 #b0110010001100 #b011110)
                arg2
                (fp #b0 #b1111011111001 #b100011)))
(assert (fp.leq (fp #b0 #b1111011111001 #b100011)
                arg2
                (fp #b0 #b1111110101100 #b101000)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1001101001000 #b110011)
                expect
                (fp #b1 #b0000100001010 #b111000)))
(assert (fp.leq (fp #b1 #b0000100001010 #b111000)
                expect
                (fp #b0 #b0011001000111 #b111111)))

(assert (= expect result))

(check-sat)
(exit)
