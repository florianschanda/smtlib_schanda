(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b00101110011110 #b00)
                arg1
                (fp #b0 #b11100000001000 #b01)))
(assert (fp.leq (fp #b0 #b11100000001000 #b01)
                arg1
                (fp #b0 #b11110000010000 #b10)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11110010111011 #b11)
                arg2
                (fp #b0 #b00000000000001 #b00)))
(assert (fp.leq (fp #b0 #b00000000000001 #b00)
                arg2
                (fp #b0 #b01000100100111 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b00010001100111 #b01)
                expect
                (fp #b0 #b11111111111110 #b11)))
(assert (fp.leq (fp #b0 #b11111111111110 #b11)
                expect
                (fp #b0 #b11111111111111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
