(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111110111 #b0010)
                arg1
                (fp #b1 #b1011111110 #b1111)))
(assert (fp.leq (fp #b1 #b1011111110 #b1111)
                arg1
                (fp #b1 #b0001100100 #b0100)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1000011110 #b1101)
                expect
                (fp #b1 #b0000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000)
                expect
                (fp #b0 #b1000000100 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
