; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b110010100111000 #b110000100001)
                arg1
                (fp #b0 #b011111111111111 #b111000000111)))
(assert (fp.leq (fp #b0 #b011111111111111 #b111000000111)
                arg1
                (fp #b0 #b111111101110011 #b100011110011)))

(declare-const arg2 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b0 #b011000010101101 #b100010100111)
                arg2
                (fp #b0 #b111111111111110 #b111111111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b111111111111)
                arg2
                (fp #b0 #b111111111111111 #b000000000000)))

(declare-const result (_ FloatingPoint 15 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b010100101001010 #b100010001011)
                expect
                (fp #b0 #b000000000000000 #b011110000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b011110000001)
                expect
                (fp #b0 #b100011011010110 #b101001110101)))

(assert (= expect result))

(check-sat)
(exit)
