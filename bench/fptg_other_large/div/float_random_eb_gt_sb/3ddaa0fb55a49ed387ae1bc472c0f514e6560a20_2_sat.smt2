(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111001010010000 #b00)
                arg1
                (fp #b0 #b101100000101110 #b00)))
(assert (fp.leq (fp #b0 #b101100000101110 #b00)
                arg1
                (fp #b0 #b110101000101011 #b10)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b110100010011100 #b01)
                arg2
                (fp #b1 #b011111111111111 #b10)))
(assert (fp.leq (fp #b1 #b011111111111111 #b10)
                arg2
                (fp #b0 #b010000111000101 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b101110010011010 #b01)
                expect
                (fp #b1 #b101100000101101 #b10)))
(assert (fp.leq (fp #b1 #b101100000101101 #b10)
                expect
                (fp #b0 #b001011110001111 #b11)))

(assert (= expect result))

(check-sat)
(exit)
