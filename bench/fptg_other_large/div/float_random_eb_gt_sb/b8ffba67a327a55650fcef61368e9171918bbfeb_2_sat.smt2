(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111111 #b00000000)
                arg1
                (fp #b1 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111111)
                arg1
                (fp #b0 #b0110111101 #b11101100)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b1000101111 #b10100101)
                arg2
                (fp #b0 #b1100000110 #b00110011)))
(assert (fp.leq (fp #b0 #b1100000110 #b00110011)
                arg2
                (fp #b0 #b1101000110 #b10000101)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111001111 #b01111000)
                expect
                (fp #b1 #b1011110111 #b10101011)))
(assert (fp.leq (fp #b1 #b1011110111 #b10101011)
                expect
                (fp #b0 #b0100010100 #b10110110)))

(assert (= expect result))

(check-sat)
(exit)
