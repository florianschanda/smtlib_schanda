(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00001111010 #b101001100)
                arg1
                (fp #b0 #b00000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b111111111)
                arg1
                (fp #b0 #b00000011111 #b100000100)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11010111100 #b110101101)
                arg2
                (fp #b0 #b11011011010 #b110111000)))
(assert (fp.leq (fp #b0 #b11011011010 #b110111000)
                arg2
                (fp #b0 #b11110011110 #b010010001)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00100011000 #b111001100)
                expect
                (fp #b0 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000000)
                expect
                (fp #b0 #b10101101110 #b011010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
