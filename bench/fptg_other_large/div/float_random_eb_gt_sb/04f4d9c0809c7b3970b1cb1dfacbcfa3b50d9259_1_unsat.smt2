(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111110110101 #b0011011010)
                arg1
                (fp #b1 #b000000000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b0000000000)
                arg1
                (fp #b0 #b001000100100 #b1001000001)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111111111101 #b0100111111)
                arg2
                (fp #b1 #b111111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b0000000000)
                arg2
                (fp #b0 #b001010100001 #b0101010101)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100011011011 #b0110100000)
                expect
                (fp #b0 #b000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000000000)
                expect
                (fp #b0 #b111000110011 #b1101100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
