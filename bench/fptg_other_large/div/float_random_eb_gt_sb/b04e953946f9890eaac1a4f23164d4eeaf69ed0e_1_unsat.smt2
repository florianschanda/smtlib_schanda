; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10101111110011111 #b010)
                arg1
                (fp #b1 #b01111111111111111 #b101)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b101)
                arg1
                (fp #b1 #b01101011111101111 #b000)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00111000000000010 #b000)
                expect
                (fp #b1 #b00000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000)
                expect
                (fp #b0 #b11010110101100101 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
