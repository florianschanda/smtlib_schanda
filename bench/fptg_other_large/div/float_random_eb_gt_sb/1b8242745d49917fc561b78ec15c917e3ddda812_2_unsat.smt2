; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100000001011 #b0011100)
                arg1
                (fp #b1 #b011111111111 #b0000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b0000000)
                arg1
                (fp #b0 #b101100001001 #b1010111)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110100110001 #b1000111)
                arg2
                (fp #b1 #b101111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b1111111)
                arg2
                (fp #b0 #b101000000001 #b1001110)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b101001101000 #b1111001)
                expect
                (fp #b0 #b001111111111 #b0000001)))
(assert (fp.leq (fp #b0 #b001111111111 #b0000001)
                expect
                (fp #b0 #b100101100100 #b0000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
