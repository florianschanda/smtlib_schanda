(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000111101011 #b00001001)
                arg1
                (fp #b1 #b000000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111)
                arg1
                (fp #b0 #b111000101110 #b10010010)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111001010100 #b10101111)
                arg2
                (fp #b1 #b001010010010 #b00110111)))
(assert (fp.leq (fp #b1 #b001010010010 #b00110111)
                arg2
                (fp #b1 #b000010100101 #b11101000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010001001000 #b10001111)
                expect
                (fp #b0 #b010101101101 #b10100100)))
(assert (fp.leq (fp #b0 #b010101101101 #b10100100)
                expect
                (fp #b0 #b101111100000 #b10001010)))

(assert (= expect result))

(check-sat)
(exit)
