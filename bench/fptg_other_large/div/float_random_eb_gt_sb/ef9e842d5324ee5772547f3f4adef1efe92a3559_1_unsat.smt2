(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b001001010011010 #b01001)
                arg1
                (fp #b0 #b100000000000001 #b00000)))
(assert (fp.leq (fp #b0 #b100000000000001 #b00000)
                arg1
                (fp #b0 #b111011101000011 #b00101)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101001000100110 #b00110)
                arg2
                (fp #b1 #b011111111111111 #b00110)))
(assert (fp.leq (fp #b1 #b011111111111111 #b00110)
                arg2
                (fp #b1 #b000000110110100 #b00010)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101010000110000 #b10010)
                expect
                (fp #b1 #b100000000000000 #b10101)))
(assert (fp.leq (fp #b1 #b100000000000000 #b10101)
                expect
                (fp #b1 #b011111001010111 #b11011)))

(assert (not (= expect result)))

(check-sat)
(exit)
