(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110001011 #b11010)
                arg1
                (fp #b0 #b000000000 #b00001)))
(assert (fp.leq (fp #b0 #b000000000 #b00001)
                arg1
                (fp #b0 #b010110110 #b11001)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b000010001 #b00110)
                arg2
                (fp #b0 #b000000000 #b10100)))
(assert (fp.leq (fp #b0 #b000000000 #b10100)
                arg2
                (fp #b0 #b111101000 #b01101)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b000001101 #b01011)
                expect
                (fp #b0 #b011111010 #b10100)))
(assert (fp.leq (fp #b0 #b011111010 #b10100)
                expect
                (fp #b0 #b101011010 #b00101)))

(assert (= expect result))

(check-sat)
(exit)
