                arg2
                (fp #b0 #b10000000000000011 #b0001)))
(assert (fp.leq (fp #b0 #b10000000000000011 #b0001)
                arg2
                (fp #b0 #b10010111000010110 #b1000)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b00100100111111111 #b0000)
                expect
                (fp #b0 #b10100100010110111 #b1011)))
(assert (fp.leq (fp #b0 #b10100100010110111 #b1011)
                expect
                (fp #b0 #b10101011000000000 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
