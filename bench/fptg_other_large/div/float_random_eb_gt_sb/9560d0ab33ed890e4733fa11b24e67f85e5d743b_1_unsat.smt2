                arg2
                (fp #b1 #b00010100101000110 #b10)))
(assert (fp.leq (fp #b1 #b00010100101000110 #b10)
                arg2
                (fp #b1 #b00000010111010000 #b10)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11111111111111111 #b00)
                expect
                (fp #b1 #b11111111111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111111111110 #b11)
                expect
                (fp #b0 #b11000011101011101 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
