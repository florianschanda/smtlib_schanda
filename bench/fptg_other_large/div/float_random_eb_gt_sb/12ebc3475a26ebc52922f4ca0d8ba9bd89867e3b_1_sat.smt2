(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b0 #b1101101101010111 #b1101101111)
                arg1
                (fp #b0 #b1111111111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111111111)
                arg1
                (fp #b0 #b1111111111111111 #b0000000000)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0101000001100101 #b0101000110)
                expect
                (fp #b1 #b0000000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000000)
                expect
                (fp #b0 #b1111100111001010 #b0101011100)))

(assert (= expect result))

(check-sat)
(exit)
