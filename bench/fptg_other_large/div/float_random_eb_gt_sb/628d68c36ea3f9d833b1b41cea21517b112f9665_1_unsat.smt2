; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b0 #b0101011010101100 #b101111)
                arg1
                (fp #b0 #b1101110010000001 #b100010)))
(assert (fp.leq (fp #b0 #b1101110010000001 #b100010)
                arg1
                (fp #b0 #b1111001110001110 #b110001)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0111011000111001 #b010010)
                expect
                (fp #b1 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000)
                expect
                (fp #b0 #b1111010101010111 #b101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
