;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11100010110 #b01111000)
                arg1
                (fp #b0 #b00000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b00000000000 #b01010111)
                arg1
                (fp #b0 #b00010110000 #b00110100)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10010001010 #b00011011)
                arg2
                (fp #b0 #b00000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b00000000000 #b01000011)
                arg2
                (fp #b0 #b00011001000 #b11100011)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b00001001010 #b01011011)
                expect
                (fp #b0 #b01111111111 #b01001100)))
(assert (fp.leq (fp #b0 #b01111111111 #b01001100)
                expect
                (fp #b0 #b10001111101 #b11000111)))

(assert (= expect result))

(check-sat)
(exit)
