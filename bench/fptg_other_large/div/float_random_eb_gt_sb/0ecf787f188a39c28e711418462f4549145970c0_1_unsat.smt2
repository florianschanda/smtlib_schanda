(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b00010110110 #b100)
                arg1
                (fp #b0 #b01010010101 #b011)))
(assert (fp.leq (fp #b0 #b01010010101 #b011)
                arg1
                (fp #b0 #b10011101000 #b100)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01110100010 #b110)
                expect
                (fp #b1 #b00000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000)
                expect
                (fp #b0 #b01101011010 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
