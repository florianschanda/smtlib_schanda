                arg2
                (fp #b0 #b0001100000010100 #b011100000100)))
(assert (fp.leq (fp #b0 #b0001100000010100 #b011100000100)
                arg2
                (fp #b0 #b0101010011101100 #b110100001000)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b0 #b0011110100111010 #b111111101010)
                expect
                (fp #b0 #b1110011111101010 #b010011100000)))
(assert (fp.leq (fp #b0 #b1110011111101010 #b010011100000)
                expect
                (fp #b0 #b1110110101000000 #b111101100110)))

(assert (= expect result))

(check-sat)
(exit)
