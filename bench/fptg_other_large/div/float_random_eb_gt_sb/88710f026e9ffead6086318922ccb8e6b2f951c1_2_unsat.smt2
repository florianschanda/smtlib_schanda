; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110101101 #b11100)
                arg1
                (fp #b0 #b000000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000)
                arg1
                (fp #b0 #b111011000 #b10011)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101100001 #b11101)
                arg2
                (fp #b1 #b000000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111)
                arg2
                (fp #b0 #b111100101 #b11010)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101110111 #b11000)
                expect
                (fp #b1 #b011111101 #b00010)))
(assert (fp.leq (fp #b1 #b011111101 #b00010)
                expect
                (fp #b0 #b010101110 #b10100)))

(assert (not (= expect result)))

(check-sat)
(exit)
