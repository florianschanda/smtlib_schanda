; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11100001010100110 #b11)
                arg1
                (fp #b1 #b10111111111111110 #b11)))
(assert (fp.leq (fp #b1 #b10111111111111110 #b11)
                arg1
                (fp #b1 #b00001100011010010 #b11)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10011111111000100 #b11)
                arg2
                (fp #b1 #b00000000000000000 #b11)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b11)
                arg2
                (fp #b0 #b00000010111101110 #b11)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b0 #b11011100010110101 #b00)
                expect
                (fp #b0 #b11111111111111110 #b11)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b11)
                expect
                (fp #b0 #b11111111111111111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
