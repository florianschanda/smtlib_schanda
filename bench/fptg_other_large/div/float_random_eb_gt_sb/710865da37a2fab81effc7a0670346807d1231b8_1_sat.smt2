; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b1 #b01111010101100011 #b0111100100101)
                arg1
                (fp #b1 #b01011001010001111 #b1001001111110)))
(assert (fp.leq (fp #b1 #b01011001010001111 #b1001001111110)
                arg1
                (fp #b1 #b00001101101011100 #b1110111011011)))

(declare-const arg2 (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b1 #b11101100001100110 #b1111010110001)
                arg2
                (fp #b0 #b10000000010010000 #b0101110011100)))
(assert (fp.leq (fp #b0 #b10000000010010000 #b0101110011100)
                arg2
                (fp #b0 #b10111011111110110 #b1001011111101)))

(declare-const result (_ FloatingPoint 17 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b1 #b10110110111011010 #b1011111011111)
                expect
                (fp #b1 #b01011000111111110 #b0010100001100)))
(assert (fp.leq (fp #b1 #b01011000111111110 #b0010100001100)
                expect
                (fp #b1 #b01010101011000100 #b0110000111011)))

(assert (= expect result))

(check-sat)
(exit)
