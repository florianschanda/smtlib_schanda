; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0001010011101011 #b00000)
                arg1
                (fp #b0 #b1000011111110001 #b10110)))
(assert (fp.leq (fp #b0 #b1000011111110001 #b10110)
                arg1
                (fp #b0 #b1011001100100111 #b11011)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1001010101001001 #b00001)
                arg2
                (fp #b0 #b0111111111111111 #b11010)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b11010)
                arg2
                (fp #b0 #b1111011111001101 #b01011)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0000000000100111 #b10001)
                expect
                (fp #b0 #b1000011111110000 #b11100)))
(assert (fp.leq (fp #b0 #b1000011111110000 #b11100)
                expect
                (fp #b0 #b1001011111100001 #b10000)))

(assert (= expect result))

(check-sat)
(exit)
