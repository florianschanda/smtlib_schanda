(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b011110011 #b000)
                arg1
                (fp #b0 #b111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111101 #b000)
                arg1
                (fp #b0 #b111111110 #b010)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b111110111 #b111)
                arg2
                (fp #b0 #b000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000 #b000)
                arg2
                (fp #b0 #b110000101 #b110)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
