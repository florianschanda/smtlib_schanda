; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0)
                arg1
                (fp #b1 #b111111111111111110 #b1)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1)
                arg1
                (fp #b1 #b011110011111011101 #b1)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b110101011010000111 #b1)
                arg2
                (fp #b0 #b000000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b1)
                arg2
                (fp #b0 #b010100010010011010 #b0)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0)
                expect
                (fp #b1 #b111111111111111110 #b1)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1)
                expect
                (fp #b0 #b011010111100110101 #b1)))

(assert (= expect result))

(check-sat)
(exit)
