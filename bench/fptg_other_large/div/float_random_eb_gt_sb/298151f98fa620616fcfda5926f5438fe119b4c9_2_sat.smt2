; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01010001011110 #b11011)
                arg1
                (fp #b0 #b11000000100001 #b01110)))
(assert (fp.leq (fp #b0 #b11000000100001 #b01110)
                arg1
                (fp #b0 #b11010000001001 #b10111)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b01010010110101 #b10010)
                arg2
                (fp #b0 #b01110100101111 #b01011)))
(assert (fp.leq (fp #b0 #b01110100101111 #b01011)
                arg2
                (fp #b0 #b01111000111000 #b10000)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b10000110100000 #b10011)
                expect
                (fp #b0 #b11001011110001 #b00011)))
(assert (fp.leq (fp #b0 #b11001011110001 #b00011)
                expect
                (fp #b0 #b11110001010100 #b01100)))

(assert (= expect result))

(check-sat)
(exit)
