(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110111011 #b10001)
                arg1
                (fp #b1 #b1011111110 #b11111)))
(assert (fp.leq (fp #b1 #b1011111110 #b11111)
                arg1
                (fp #b1 #b0111100100 #b10111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1010000110 #b01110)
                arg2
                (fp #b1 #b1000100100 #b11110)))
(assert (fp.leq (fp #b1 #b1000100100 #b11110)
                arg2
                (fp #b0 #b0000111010 #b11011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0100111011 #b10011)
                expect
                (fp #b0 #b1011011001 #b00001)))
(assert (fp.leq (fp #b0 #b1011011001 #b00001)
                expect
                (fp #b0 #b1101010100 #b00001)))

(assert (= expect result))

(check-sat)
(exit)
