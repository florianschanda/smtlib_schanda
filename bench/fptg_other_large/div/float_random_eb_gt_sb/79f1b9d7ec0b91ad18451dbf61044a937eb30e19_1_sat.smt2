(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100110011000000 #b000)
                arg1
                (fp #b1 #b100000000000011 #b000)))
(assert (fp.leq (fp #b1 #b100000000000011 #b000)
                arg1
                (fp #b1 #b010110101111000 #b100)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101100010100010 #b011)
                expect
                (fp #b0 #b000000000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000)
                expect
                (fp #b0 #b100001111111001 #b101)))

(assert (= expect result))

(check-sat)
(exit)
