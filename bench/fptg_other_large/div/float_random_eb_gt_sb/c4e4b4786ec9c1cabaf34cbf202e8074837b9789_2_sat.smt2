; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b00110010100101 #b0100001101)
                arg1
                (fp #b0 #b00000000000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b0000000000)
                arg1
                (fp #b0 #b11111110001101 #b1010000110)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11000001001100 #b0010111000)
                arg2
                (fp #b1 #b00000000000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0101011111)
                arg2
                (fp #b0 #b10100101011001 #b1000000001)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b10110110100100 #b1110101000)
                expect
                (fp #b1 #b10000000000000 #b0111010110)))
(assert (fp.leq (fp #b1 #b10000000000000 #b0111010110)
                expect
                (fp #b0 #b11101100010101 #b1110100010)))

(assert (= expect result))

(check-sat)
(exit)
