(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111011010 #b000)
                arg1
                (fp #b1 #b1000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000011 #b000)
                arg1
                (fp #b0 #b1111111001 #b000)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000000100 #b100)
                arg2
                (fp #b1 #b0100000000 #b000)))
(assert (fp.leq (fp #b1 #b0100000000 #b000)
                arg2
                (fp #b0 #b1001001001 #b101)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010100101 #b010)
                expect
                (fp #b0 #b1100000010 #b000)))
(assert (fp.leq (fp #b0 #b1100000010 #b000)
                expect
                (fp #b0 #b1111110011 #b010)))

(assert (= expect result))

(check-sat)
(exit)
