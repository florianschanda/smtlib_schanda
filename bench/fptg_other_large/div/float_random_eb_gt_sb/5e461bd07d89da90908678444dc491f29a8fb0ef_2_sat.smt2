(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110110010 #b0100)
                arg1
                (fp #b1 #b101111110 #b1111)))
(assert (fp.leq (fp #b1 #b101111110 #b1111)
                arg1
                (fp #b1 #b010000011 #b0101)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001010001 #b1111)
                arg2
                (fp #b1 #b000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000 #b0001)
                arg2
                (fp #b0 #b011011001 #b1000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
