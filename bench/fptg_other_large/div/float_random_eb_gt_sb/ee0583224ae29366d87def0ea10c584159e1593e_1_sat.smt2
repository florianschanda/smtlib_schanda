(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1001011001000 #b10000)
                arg1
                (fp #b1 #b0100000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b00000)
                arg1
                (fp #b0 #b1001100100111 #b10011)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1111110010101 #b00100)
                arg2
                (fp #b1 #b1101001000010 #b10000)))
(assert (fp.leq (fp #b1 #b1101001000010 #b10000)
                arg2
                (fp #b0 #b1000110010110 #b11010)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1011000111001 #b10001)
                expect
                (fp #b0 #b0000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000)
                expect
                (fp #b0 #b1100110111100 #b10011)))

(assert (= expect result))

(check-sat)
(exit)
