(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111100101110 #b1011110)
                arg2
                (fp #b1 #b111011010010 #b1000011)))
(assert (fp.leq (fp #b1 #b111011010010 #b1000011)
                arg2
                (fp #b1 #b100111000011 #b1010010)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
