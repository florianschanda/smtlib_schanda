(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b010111000110101 #b01000)
                arg1
                (fp #b1 #b000000000000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00001)
                arg1
                (fp #b0 #b110000101111000 #b00011)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111101101101110 #b11111)
                arg2
                (fp #b1 #b100000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b100000000000101 #b00000)
                arg2
                (fp #b0 #b100110011011110 #b10101)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010000110001011 #b11100)
                expect
                (fp #b0 #b000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000)
                expect
                (fp #b0 #b010010000011010 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
