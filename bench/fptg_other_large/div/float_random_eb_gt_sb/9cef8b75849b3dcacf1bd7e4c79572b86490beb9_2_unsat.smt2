                arg2
                (fp #b1 #b011111111 #b1011000)))
(assert (fp.leq (fp #b1 #b011111111 #b1011000)
                arg2
                (fp #b0 #b101111110 #b0011100)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100101110 #b0011011)
                expect
                (fp #b0 #b110001111 #b0010101)))
(assert (fp.leq (fp #b0 #b110001111 #b0010101)
                expect
                (fp #b0 #b111101111 #b1110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
