;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b01001001110111 #b000101010)
                arg1
                (fp #b1 #b00000000000000 #b111111111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b111111111)
                arg1
                (fp #b0 #b00011010100010 #b001010110)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11111111111111 #b000000000)
                arg2
                (fp #b1 #b11111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111111111)
                arg2
                (fp #b1 #b10011100110011 #b010000001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11001100000110 #b111011110)
                expect
                (fp #b0 #b00000000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000000001)
                expect
                (fp #b0 #b00000010011110 #b111101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
