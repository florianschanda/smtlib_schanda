;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b010111100111001 #b1101011010)
                arg1
                (fp #b1 #b010000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b0000000000)
                arg1
                (fp #b0 #b100111101001011 #b1000011001)))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b101111000101011 #b0101010011)
                arg2
                (fp #b1 #b000000000000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0101011111)
                arg2
                (fp #b0 #b011110100110011 #b1111111011)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b0 #b101010111010101 #b1100000001)
                expect
                (fp #b0 #b101111111111111 #b0111010110)))
(assert (fp.leq (fp #b0 #b101111111111111 #b0111010110)
                expect
                (fp #b0 #b111111110011001 #b0101111011)))

(assert (= expect result))

(check-sat)
(exit)
