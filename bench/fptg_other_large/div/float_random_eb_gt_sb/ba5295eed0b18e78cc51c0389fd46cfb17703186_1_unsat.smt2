(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b1001100000100 #b001)
                arg2
                (fp #b1 #b0000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000)
                arg2
                (fp #b0 #b1110010000010 #b011)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
