(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1011010011011111 #b110)
                arg1
                (fp #b1 #b1011000101110000 #b000)))
(assert (fp.leq (fp #b1 #b1011000101110000 #b000)
                arg1
                (fp #b0 #b0110000101101001 #b010)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1010100000111001 #b010)
                arg2
                (fp #b1 #b0011111111111110 #b011)))
(assert (fp.leq (fp #b1 #b0011111111111110 #b011)
                arg2
                (fp #b0 #b0010011110000000 #b011)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1011101000010110 #b001)
                expect
                (fp #b0 #b1111000101110000 #b100)))
(assert (fp.leq (fp #b0 #b1111000101110000 #b100)
                expect
                (fp #b0 #b1111110111100101 #b000)))

(assert (= expect result))

(check-sat)
(exit)
