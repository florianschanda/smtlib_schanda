(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b001101111 #b100011)
                arg1
                (fp #b0 #b001111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111101 #b000000)
                arg1
                (fp #b0 #b010111001 #b100110)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101111111 #b010101)
                arg2
                (fp #b1 #b101111010 #b011000)))
(assert (fp.leq (fp #b1 #b101111010 #b011000)
                arg2
                (fp #b0 #b101001001 #b001010)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100001000 #b011011)
                expect
                (fp #b1 #b000000001 #b011101)))
(assert (fp.leq (fp #b1 #b000000001 #b011101)
                expect
                (fp #b0 #b100100010 #b001001)))

(assert (= expect result))

(check-sat)
(exit)
