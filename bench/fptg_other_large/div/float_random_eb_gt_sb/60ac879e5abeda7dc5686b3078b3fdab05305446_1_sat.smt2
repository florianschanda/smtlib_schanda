(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1100110100100001 #b00)
                arg1
                (fp #b1 #b1000000000000001 #b00)))
(assert (fp.leq (fp #b1 #b1000000000000001 #b00)
                arg1
                (fp #b0 #b0000010000100100 #b01)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1100001100010101 #b10)
                arg2
                (fp #b1 #b0000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01)
                arg2
                (fp #b0 #b1000111100011110 #b10)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b0 #b0100001101110111 #b01)
                expect
                (fp #b0 #b1111111111111110 #b11)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11)
                expect
                (fp #b0 #b1111111111111111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
