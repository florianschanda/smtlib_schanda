                arg2
                (fp #b1 #b010000000 #b000)))
(assert (fp.leq (fp #b1 #b010000000 #b000)
                arg2
                (fp #b0 #b111110000 #b010)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100000001 #b110)
                expect
                (fp #b1 #b011001110 #b110)))
(assert (fp.leq (fp #b1 #b011001110 #b110)
                expect
                (fp #b0 #b000101010 #b100)))

(assert (= expect result))

(check-sat)
(exit)
