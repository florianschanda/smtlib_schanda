(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111000 #b11001101)
                arg1
                (fp #b0 #b0100000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b00000000)
                arg1
                (fp #b0 #b1001001100 #b11110001)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1010011010 #b01101101)
                arg2
                (fp #b1 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b1000001000 #b00000000)
                arg2
                (fp #b0 #b0011101001 #b11010011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101010001 #b00100000)
                expect
                (fp #b1 #b0011110111 #b00000000)))
(assert (fp.leq (fp #b1 #b0011110111 #b00000000)
                expect
                (fp #b0 #b0011111111 #b00001110)))

(assert (= expect result))

(check-sat)
(exit)
