(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1101100100101 #b1001100011)
                arg1
                (fp #b0 #b0111111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b0111111111111 #b1001100100)
                arg1
                (fp #b0 #b1011101011000 #b0010011111)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b0100110100101 #b1100000110)
                arg2
                (fp #b1 #b0000000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0100000000)
                arg2
                (fp #b0 #b0101000001010 #b0100010000)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1111111111111 #b0000000000)
                expect
                (fp #b1 #b1111111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b1111111111)
                expect
                (fp #b0 #b0001000110011 #b1101001111)))

(assert (= expect result))

(check-sat)
(exit)
