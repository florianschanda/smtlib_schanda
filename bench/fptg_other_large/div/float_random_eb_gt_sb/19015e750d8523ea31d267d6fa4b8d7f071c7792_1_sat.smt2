(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01111010001 #b0000111)
                arg1
                (fp #b0 #b00010001101 #b1100010)))
(assert (fp.leq (fp #b0 #b00010001101 #b1100010)
                arg1
                (fp #b0 #b11100010000 #b0101101)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11111111101 #b0011101)
                arg2
                (fp #b1 #b11111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000)
                arg2
                (fp #b0 #b10011110110 #b0111001)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11011011001 #b1100010)
                expect
                (fp #b1 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000)
                expect
                (fp #b0 #b00111111111 #b0000101)))

(assert (= expect result))

(check-sat)
(exit)
