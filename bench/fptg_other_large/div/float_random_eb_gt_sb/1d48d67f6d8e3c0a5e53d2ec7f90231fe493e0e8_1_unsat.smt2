; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00011100011 #b100111100)
                arg1
                (fp #b0 #b00000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b010000000)
                arg1
                (fp #b0 #b01010111111 #b110000010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b10000110110 #b011101000)
                arg2
                (fp #b0 #b11101111001 #b001010110)))
(assert (fp.leq (fp #b0 #b11101111001 #b001010110)
                arg2
                (fp #b0 #b11111110101 #b010010101)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10111110001 #b001100100)
                expect
                (fp #b0 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000000)
                expect
                (fp #b0 #b00010010100 #b110000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
