; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b01011001011000 #b10)
                arg1
                (fp #b0 #b00000000000000 #b10)))
(assert (fp.leq (fp #b0 #b00000000000000 #b10)
                arg1
                (fp #b0 #b01110110101101 #b11)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b01111001110001 #b10)
                arg2
                (fp #b1 #b00000000000000 #b01)))
(assert (fp.leq (fp #b1 #b00000000000000 #b01)
                arg2
                (fp #b0 #b10011010010110 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10100111101101 #b10)
                expect
                (fp #b1 #b10000000000000 #b00)))
(assert (fp.leq (fp #b1 #b10000000000000 #b00)
                expect
                (fp #b0 #b10000111111000 #b01)))

(assert (= expect result))

(check-sat)
(exit)
