(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1011000010111 #b0)
                arg1
                (fp #b1 #b0000000000001 #b0)))
(assert (fp.leq (fp #b1 #b0000000000001 #b0)
                arg1
                (fp #b0 #b0001000011000 #b0)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1010010110101 #b0)
                arg2
                (fp #b1 #b1000000000001 #b0)))
(assert (fp.leq (fp #b1 #b1000000000001 #b0)
                arg2
                (fp #b0 #b1000011001100 #b0)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1101111100001 #b0)
                expect
                (fp #b0 #b0000000000000 #b1)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1)
                expect
                (fp #b0 #b0010010101010 #b0)))

(assert (= expect result))

(check-sat)
(exit)
