(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1100101011 #b0000111)
                arg1
                (fp #b1 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000)
                arg1
                (fp #b0 #b1110011000 #b0000010)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110110100 #b1101110)
                arg2
                (fp #b1 #b1000000101 #b1100000)))
(assert (fp.leq (fp #b1 #b1000000101 #b1100000)
                arg2
                (fp #b0 #b0100101000 #b0011111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0011001010 #b0101101)
                expect
                (fp #b0 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000)
                expect
                (fp #b0 #b0110111100 #b1100111)))

(assert (= expect result))

(check-sat)
(exit)
