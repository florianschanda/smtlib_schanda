; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101110000010 #b101110100)
                arg1
                (fp #b1 #b011111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b000000000)
                arg1
                (fp #b1 #b001000111101 #b001011111)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111011100111 #b000001101)
                expect
                (fp #b0 #b000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000000000)
                expect
                (fp #b0 #b011110001110 #b010000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
