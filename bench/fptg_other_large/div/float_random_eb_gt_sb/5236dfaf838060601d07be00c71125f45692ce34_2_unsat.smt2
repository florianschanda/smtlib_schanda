(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101000011 #b110)
                arg1
                (fp #b1 #b000000000 #b110)))
(assert (fp.leq (fp #b1 #b000000000 #b110)
                arg1
                (fp #b0 #b110100110 #b111)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111110001 #b110)
                arg2
                (fp #b1 #b100011001 #b101)))
(assert (fp.leq (fp #b1 #b100011001 #b101)
                arg2
                (fp #b0 #b110100101 #b111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010101100 #b000)
                expect
                (fp #b0 #b000000000 #b001)))
(assert (fp.leq (fp #b0 #b000000000 #b001)
                expect
                (fp #b0 #b011110111 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
