; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10110001110101 #b01100011001)
                arg1
                (fp #b1 #b00000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b11111111111)
                arg1
                (fp #b0 #b01010111000011 #b00111110111)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10001011111101 #b11100010011)
                arg2
                (fp #b1 #b01111111111111 #b00110001010)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00110001010)
                arg2
                (fp #b0 #b11111101000110 #b01111000000)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11101100100001 #b11000101110)
                expect
                (fp #b0 #b00000000000000 #b11010110100)))
(assert (fp.leq (fp #b0 #b00000000000000 #b11010110100)
                expect
                (fp #b0 #b11000011010100 #b01101100000)))

(assert (= expect result))

(check-sat)
(exit)
