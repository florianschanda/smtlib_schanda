(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01011001000 #b00100)
                arg1
                (fp #b1 #b01000000000 #b00000)))
(assert (fp.leq (fp #b1 #b01000000000 #b00000)
                arg1
                (fp #b0 #b01000111101 #b11001)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111101 #b01000)
                arg2
                (fp #b1 #b11111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000)
                arg2
                (fp #b0 #b11111010101 #b01100)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01100111101 #b11111)
                expect
                (fp #b0 #b00000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000)
                expect
                (fp #b0 #b01011100100 #b00001)))

(assert (not (= expect result)))

(check-sat)
(exit)
