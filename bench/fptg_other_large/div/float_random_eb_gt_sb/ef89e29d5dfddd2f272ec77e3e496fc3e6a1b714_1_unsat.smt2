                (fp #b1 #b1010000010100100 #b001111010011)))
(assert (fp.leq (fp #b1 #b1010000010100100 #b001111010011)
                arg2
                (fp #b1 #b0010110011010101 #b101110111000)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0010100010111000 #b010101101101)
                expect
                (fp #b0 #b0000000000000000 #b000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000)
                expect
                (fp #b0 #b0001100110111111 #b101010110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
