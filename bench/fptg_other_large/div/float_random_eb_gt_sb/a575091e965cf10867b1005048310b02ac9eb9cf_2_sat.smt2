; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01100001100 #b10010)
                arg1
                (fp #b0 #b00000000000 #b11111)))
(assert (fp.leq (fp #b0 #b00000000000 #b11111)
                arg1
                (fp #b0 #b11010111011 #b01010)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b00010111110 #b10001)
                arg2
                (fp #b0 #b01111111111 #b00011)))
(assert (fp.leq (fp #b0 #b01111111111 #b00011)
                arg2
                (fp #b0 #b10000101100 #b10101)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01101001111 #b10001)
                expect
                (fp #b0 #b00000000000 #b11101)))
(assert (fp.leq (fp #b0 #b00000000000 #b11101)
                expect
                (fp #b0 #b11111011111 #b11010)))

(assert (= expect result))

(check-sat)
(exit)
