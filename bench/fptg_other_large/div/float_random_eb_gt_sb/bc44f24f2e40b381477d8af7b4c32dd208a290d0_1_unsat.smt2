(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0111100101 #b1110)
                arg1
                (fp #b1 #b0000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100)
                arg1
                (fp #b0 #b1000000000 #b1111)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101011100 #b1101)
                arg2
                (fp #b0 #b0010001001 #b0100)))
(assert (fp.leq (fp #b0 #b0010001001 #b0100)
                arg2
                (fp #b0 #b1111000100 #b1011)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1010001001 #b1001)
                expect
                (fp #b1 #b0101110100 #b1001)))
(assert (fp.leq (fp #b1 #b0101110100 #b1001)
                expect
                (fp #b0 #b0111010101 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
