(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011100100011 #b0010)
                arg1
                (fp #b1 #b010111000101 #b1001)))
(assert (fp.leq (fp #b1 #b010111000101 #b1001)
                arg1
                (fp #b0 #b110010010101 #b1100)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100100001001 #b1100)
                arg2
                (fp #b1 #b000000000000 #b1110)))
(assert (fp.leq (fp #b1 #b000000000000 #b1110)
                arg2
                (fp #b0 #b110010010100 #b1101)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b100010011111 #b1111)
                expect
                (fp #b0 #b110111000011 #b1101)))
(assert (fp.leq (fp #b0 #b110111000011 #b1101)
                expect
                (fp #b0 #b111011000011 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
