(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11100000011 #b1)
                arg1
                (fp #b0 #b00000000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000000 #b1)
                arg1
                (fp #b0 #b10111101001 #b0)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01110110101 #b0)
                arg2
                (fp #b1 #b00001110101 #b1)))
(assert (fp.leq (fp #b1 #b00001110101 #b1)
                arg2
                (fp #b0 #b11000000110 #b1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10001100100 #b0)
                expect
                (fp #b1 #b01110001001 #b1)))
(assert (fp.leq (fp #b1 #b01110001001 #b1)
                expect
                (fp #b0 #b00111111010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
