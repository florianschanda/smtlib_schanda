(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111100111 #b11)
                arg1
                (fp #b0 #b111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111101 #b00)
                arg1
                (fp #b0 #b111111110 #b10)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b010001011 #b00)
                arg2
                (fp #b1 #b000000001 #b00)))
(assert (fp.leq (fp #b1 #b000000001 #b00)
                arg2
                (fp #b0 #b011110100 #b01)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111111 #b00)
                expect
                (fp #b1 #b111111110 #b11)))
(assert (fp.leq (fp #b1 #b111111110 #b11)
                expect
                (fp #b1 #b111100010 #b11)))

(assert (= expect result))

(check-sat)
(exit)
