(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b01011011111000 #b01)
                arg1
                (fp #b0 #b00001000100100 #b11)))
(assert (fp.leq (fp #b0 #b00001000100100 #b11)
                arg1
                (fp #b0 #b10100100110101 #b00)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10011110010110 #b00)
                arg2
                (fp #b1 #b01100101011111 #b01)))
(assert (fp.leq (fp #b1 #b01100101011111 #b01)
                arg2
                (fp #b0 #b00100011111111 #b01)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111010111011 #b00)
                expect
                (fp #b1 #b00100011000100 #b10)))
(assert (fp.leq (fp #b1 #b00100011000100 #b10)
                expect
                (fp #b0 #b10011101000111 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
