                (fp #b0 #b0110110101001110 #b0001010)))
(assert (fp.leq (fp #b0 #b0110110101001110 #b0001010)
                arg2
                (fp #b0 #b0111001110111101 #b0000010)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1001001111110101 #b0100111)
                expect
                (fp #b0 #b1001001010110000 #b0011111)))
(assert (fp.leq (fp #b0 #b1001001010110000 #b0011111)
                expect
                (fp #b0 #b1011101110110111 #b0000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
