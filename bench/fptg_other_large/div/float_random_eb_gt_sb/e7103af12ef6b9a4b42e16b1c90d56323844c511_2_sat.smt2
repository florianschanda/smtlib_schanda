(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b111110010000101 #b00001111)
                arg1
                (fp #b1 #b001111111111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111111111100 #b00000000)
                arg1
                (fp #b1 #b001000101000010 #b11001110)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b000110001101011 #b01000110)
                arg2
                (fp #b0 #b011100001111000 #b10001010)))
(assert (fp.leq (fp #b0 #b011100001111000 #b10001010)
                arg2
                (fp #b0 #b110001100001101 #b11101000)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b100000011010101 #b11110011)
                expect
                (fp #b1 #b010011110000010 #b01001101)))
(assert (fp.leq (fp #b1 #b010011110000010 #b01001101)
                expect
                (fp #b0 #b010000010000011 #b11101001)))

(assert (= expect result))

(check-sat)
(exit)
