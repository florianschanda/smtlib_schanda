;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110110000 #b110110)
                arg1
                (fp #b0 #b101111110 #b111111)))
(assert (fp.leq (fp #b0 #b101111110 #b111111)
                arg1
                (fp #b0 #b111010001 #b000001)))

(declare-const arg2 (_ FloatingPoint 9 7))
