                arg2
                (fp #b0 #b111011001 #b011000)))
(assert (fp.leq (fp #b0 #b111011001 #b011000)
                arg2
                (fp #b0 #b111110100 #b101010)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001011101 #b010100)
                expect
                (fp #b0 #b010100100 #b011100)))
(assert (fp.leq (fp #b0 #b010100100 #b011100)
                expect
                (fp #b0 #b111010010 #b110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
