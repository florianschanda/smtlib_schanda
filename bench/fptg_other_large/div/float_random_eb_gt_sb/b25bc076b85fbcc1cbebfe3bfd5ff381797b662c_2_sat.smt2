(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110100100 #b110)
                arg1
                (fp #b1 #b0111111111 #b101)))
(assert (fp.leq (fp #b1 #b0111111111 #b101)
                arg1
                (fp #b0 #b0110100011 #b101)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0000001011 #b110)
                arg2
                (fp #b0 #b0111111111 #b110)))
(assert (fp.leq (fp #b0 #b0111111111 #b110)
                arg2
                (fp #b0 #b1010101110 #b110)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001110100 #b000)
                expect
                (fp #b1 #b0111111110 #b111)))
(assert (fp.leq (fp #b1 #b0111111110 #b111)
                expect
                (fp #b0 #b1010110011 #b111)))

(assert (= expect result))

(check-sat)
(exit)
