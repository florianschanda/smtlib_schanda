; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1111111111111110 #b00010)
                arg1
                (fp #b1 #b1111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b00000)
                arg1
                (fp #b1 #b0000011000001000 #b00011)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0001000000111011 #b01111)
                arg2
                (fp #b0 #b1000000000000011 #b00110)))
(assert (fp.leq (fp #b0 #b1000000000000011 #b00110)
                arg2
                (fp #b0 #b1001000101111010 #b11010)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1111111111111010 #b00110)
                expect
                (fp #b1 #b1111111111111000 #b10101)))
(assert (fp.leq (fp #b1 #b1111111111111000 #b10101)
                expect
                (fp #b0 #b0111101100110111 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
