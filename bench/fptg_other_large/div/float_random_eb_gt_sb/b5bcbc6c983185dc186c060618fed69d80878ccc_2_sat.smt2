;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11001000110100110 #b01000)
                arg1
                (fp #b0 #b00000000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00001)
                arg1
                (fp #b0 #b11111000100100110 #b01001)))

(declare-const arg2 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b00110110010000011 #b11000)
                arg2
                (fp #b0 #b00000000000000000 #b10101)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b10101)
                arg2
                (fp #b0 #b01010000101111010 #b00000)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11000101000010001 #b00101)
                expect
                (fp #b0 #b01111111111111010 #b10001)))
(assert (fp.leq (fp #b0 #b01111111111111010 #b10001)
                expect
                (fp #b0 #b10001000010100000 #b10000)))

(assert (= expect result))

(check-sat)
(exit)
