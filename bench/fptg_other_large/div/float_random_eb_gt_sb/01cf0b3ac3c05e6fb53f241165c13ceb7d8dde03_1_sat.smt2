(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0001111111010011 #b0101010)
                arg1
                (fp #b0 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000)
                arg1
                (fp #b0 #b1000010110000000 #b1111000)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
