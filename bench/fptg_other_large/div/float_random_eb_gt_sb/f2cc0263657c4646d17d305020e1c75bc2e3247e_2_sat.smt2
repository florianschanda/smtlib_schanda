(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1111001101001100 #b01001101)
                arg1
                (fp #b1 #b1110111101000000 #b00011011)))
(assert (fp.leq (fp #b1 #b1110111101000000 #b00011011)
                arg1
                (fp #b1 #b1110101010000000 #b00011100)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1001101111101110 #b10111010)
                arg2
                (fp #b1 #b0000000000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b00000000)
                arg2
                (fp #b0 #b1010101011101000 #b11001011)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
