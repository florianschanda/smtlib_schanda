(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10010100111 #b00010)
                arg1
                (fp #b1 #b01111111111 #b10100)))
(assert (fp.leq (fp #b1 #b01111111111 #b10100)
                arg1
                (fp #b0 #b10001100100 #b10100)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11010101010 #b01010)
                expect
                (fp #b1 #b01111111111 #b00000)))
(assert (fp.leq (fp #b1 #b01111111111 #b00000)
                expect
                (fp #b0 #b00010010100 #b11001)))

(assert (not (= expect result)))

(check-sat)
(exit)
