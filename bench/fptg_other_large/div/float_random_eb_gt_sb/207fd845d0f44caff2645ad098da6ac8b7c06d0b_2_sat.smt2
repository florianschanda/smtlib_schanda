(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1001001001111110 #b01011100011011)
                arg1
                (fp #b1 #b0101100101001010 #b01001001111110)))
(assert (fp.leq (fp #b1 #b0101100101001010 #b01001001111110)
                arg1
                (fp #b1 #b0100100011100000 #b10110001001101)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1011010111101001 #b01101011011010)
                arg2
                (fp #b1 #b0000000000000000 #b11111111111111)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b11111111111111)
                arg2
                (fp #b0 #b0101010000010000 #b10011110100111)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b0 #b0101101001100010 #b00100100001101)
                expect
                (fp #b0 #b1101100101001000 #b01001010000000)))
(assert (fp.leq (fp #b0 #b1101100101001000 #b01001010000000)
                expect
                (fp #b0 #b1101110000111111 #b00101001111010)))

(assert (= expect result))

(check-sat)
(exit)
