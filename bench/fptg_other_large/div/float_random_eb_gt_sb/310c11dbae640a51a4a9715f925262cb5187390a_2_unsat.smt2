; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1111000011100011 #b001110110)
                arg1
                (fp #b1 #b1000110000011101 #b010111100)))
(assert (fp.leq (fp #b1 #b1000110000011101 #b010111100)
                arg1
                (fp #b1 #b1000101100110011 #b100001100)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b1010010100110011 #b111110000)
                arg2
                (fp #b0 #b1111011001011011 #b101000001)))
(assert (fp.leq (fp #b0 #b1111011001011011 #b101000001)
                arg2
                (fp #b0 #b1111101011101011 #b110010111)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110010011101110 #b100110000)
                expect
                (fp #b1 #b0001010111000000 #b101011101)))
(assert (fp.leq (fp #b1 #b0001010111000000 #b101011101)
                expect
                (fp #b0 #b0011101100010111 #b110100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
