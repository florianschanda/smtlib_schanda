(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1110101110000110 #b011)
                arg1
                (fp #b0 #b0000000000000000 #b001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b001)
                arg1
                (fp #b0 #b1011010100010000 #b101)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0110001001101111 #b000)
                arg2
                (fp #b0 #b0000000000000000 #b111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111)
                arg2
                (fp #b0 #b0000011000010111 #b101)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111001001111100 #b110)
                expect
                (fp #b0 #b0111111111111100 #b001)))
(assert (fp.leq (fp #b0 #b0111111111111100 #b001)
                expect
                (fp #b0 #b1001001001111100 #b111)))

(assert (= expect result))

(check-sat)
(exit)
