(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1011111001000 #b0010)
                arg1
                (fp #b1 #b0100000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b0000)
                arg1
                (fp #b0 #b0100011101111 #b1101)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0110111111010 #b1000)
                arg2
                (fp #b0 #b0111111111111 #b1101)))
(assert (fp.leq (fp #b0 #b0111111111111 #b1101)
                arg2
                (fp #b0 #b1101110000110 #b1011)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1100011101010 #b1110)
                expect
                (fp #b1 #b0011111111111 #b0001)))
(assert (fp.leq (fp #b1 #b0011111111111 #b0001)
                expect
                (fp #b0 #b0000011101111 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
