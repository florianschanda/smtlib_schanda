(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b0 #b011110101100110 #b0)
                arg1
                (fp #b0 #b111111111111110 #b1)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1)
