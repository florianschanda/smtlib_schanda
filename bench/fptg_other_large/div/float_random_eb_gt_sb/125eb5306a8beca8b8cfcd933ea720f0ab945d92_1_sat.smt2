                (fp #b1 #b111111111111101 #b0)))
(assert (fp.leq (fp #b1 #b111111111111101 #b0)
                arg2
                (fp #b0 #b001111111001011 #b1)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b111100100100000 #b1)
                expect
                (fp #b1 #b100000000000000 #b1)))
(assert (fp.leq (fp #b1 #b100000000000000 #b1)
                expect
                (fp #b0 #b001001011101010 #b0)))

(assert (= expect result))

(check-sat)
(exit)
