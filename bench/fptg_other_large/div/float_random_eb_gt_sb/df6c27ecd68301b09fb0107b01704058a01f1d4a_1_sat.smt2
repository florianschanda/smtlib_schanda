(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0101001100 #b111)
                arg1
                (fp #b0 #b1100100110 #b011)))
(assert (fp.leq (fp #b0 #b1100100110 #b011)
                arg1
                (fp #b0 #b1110101110 #b001)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0001110011 #b100)
                expect
                (fp #b0 #b0000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000)
                expect
                (fp #b0 #b0100001101 #b100)))

(assert (= expect result))

(check-sat)
(exit)
