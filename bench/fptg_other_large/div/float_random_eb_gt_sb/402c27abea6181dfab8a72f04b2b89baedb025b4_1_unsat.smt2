(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1001011100000 #b0001010)
                expect
                (fp #b1 #b1000101101100 #b0010011)))
(assert (fp.leq (fp #b1 #b1000101101100 #b0010011)
                expect
                (fp #b0 #b1111001011100 #b1011010)))

(assert (not (= expect result)))

