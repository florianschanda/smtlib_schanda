(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101000101111 #b011)
                arg1
                (fp #b1 #b000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000 #b010)
                arg1
                (fp #b0 #b100010001111 #b111)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100011011101 #b101)
                expect
                (fp #b1 #b000000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000000 #b000)
                expect
                (fp #b0 #b010110010111 #b001)))

(assert (= expect result))

(check-sat)
(exit)
