(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1111000100000110 #b11111100101011)
                arg1
                (fp #b1 #b1101110110111100 #b01000011110001)))
(assert (fp.leq (fp #b1 #b1101110110111100 #b01000011110001)
                arg1
                (fp #b1 #b0100101001100101 #b10011001001000)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1100001010110011 #b00111010001001)
                arg2
                (fp #b1 #b1011110011000011 #b11101100010011)))
(assert (fp.leq (fp #b1 #b1011110011000011 #b11101100010011)
                arg2
                (fp #b1 #b1001101011111101 #b01010111000011)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1011001010000111 #b00001011000001)
                expect
                (fp #b0 #b1010000011110111 #b01010000101111)))
(assert (fp.leq (fp #b0 #b1010000011110111 #b01010000101111)
                expect
                (fp #b0 #b1011010110010111 #b11110101101101)))

(assert (= expect result))

(check-sat)
(exit)
