; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b000101001101011 #b11100110100)
                arg1
                (fp #b0 #b000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000)
                arg1
                (fp #b0 #b010000010101010 #b01110101100)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b110101000101001 #b00001100111)
                arg2
                (fp #b1 #b100000000001010 #b01000101000)))
(assert (fp.leq (fp #b1 #b100000000001010 #b01000101000)
                arg2
                (fp #b0 #b100111001010100 #b00000011101)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100111011110111 #b11110111101)
                expect
                (fp #b1 #b000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000)
                expect
                (fp #b0 #b111001000011111 #b01101001011)))

(assert (= expect result))

(check-sat)
(exit)
