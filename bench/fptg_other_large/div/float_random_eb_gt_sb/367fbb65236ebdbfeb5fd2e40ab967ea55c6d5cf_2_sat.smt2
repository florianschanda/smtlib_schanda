(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110010001 #b010)
                arg1
                (fp #b1 #b011111111 #b000)))
(assert (fp.leq (fp #b1 #b011111111 #b000)
                arg1
                (fp #b0 #b010100110 #b110)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010111111 #b011)
                arg2
                (fp #b0 #b011111111 #b101)))
(assert (fp.leq (fp #b0 #b011111111 #b101)
                arg2
                (fp #b0 #b101011010 #b001)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100000010 #b100)
                expect
                (fp #b1 #b011111110 #b010)))
(assert (fp.leq (fp #b1 #b011111110 #b010)
                expect
                (fp #b0 #b010000011 #b101)))

(assert (= expect result))

(check-sat)
(exit)
