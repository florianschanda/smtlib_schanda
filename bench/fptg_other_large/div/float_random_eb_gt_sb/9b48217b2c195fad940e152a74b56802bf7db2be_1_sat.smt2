(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000011111100 #b1000010)
                arg1
                (fp #b1 #b000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b0000000)
                arg1
                (fp #b0 #b111101101000 #b1001001)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b0 #b011101010010 #b1100111)
                arg2
                (fp #b0 #b100000000110 #b1110011)))
(assert (fp.leq (fp #b0 #b100000000110 #b1110011)
                arg2
                (fp #b0 #b110110000010 #b0101111)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100000111000 #b1011010)
                expect
                (fp #b1 #b000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000)
                expect
                (fp #b0 #b001101110000 #b0001101)))

(assert (= expect result))

(check-sat)
(exit)
