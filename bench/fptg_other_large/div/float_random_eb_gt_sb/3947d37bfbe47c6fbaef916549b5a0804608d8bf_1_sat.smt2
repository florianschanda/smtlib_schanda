(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b0 #b010110010000001 #b01100111)
                arg1
                (fp #b0 #b011111111111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b00000000)
                arg1
                (fp #b0 #b110100011011011 #b11111111)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000011100010011 #b01000101)
                expect
                (fp #b1 #b000000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000)
                expect
                (fp #b0 #b100111000101110 #b11101001)))

(assert (= expect result))

(check-sat)
(exit)
