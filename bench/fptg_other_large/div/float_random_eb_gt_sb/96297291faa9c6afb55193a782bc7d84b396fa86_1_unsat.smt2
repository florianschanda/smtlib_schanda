(assert (fp.leq (fp #b1 #b000000000000001 #b0)
                arg2
                (fp #b0 #b111000001000011 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b011011100010000 #b0)
                expect
                (fp #b0 #b111111111111110 #b1)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1)
                expect
                (fp #b0 #b111111111111111 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
