(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b101011100 #b01110)
                arg1
                (fp #b0 #b101111110 #b11111)))
(assert (fp.leq (fp #b0 #b101111110 #b11111)
                arg1
                (fp #b0 #b110000011 #b10110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111010011 #b01011)
                arg2
                (fp #b1 #b000000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000)
                arg2
                (fp #b0 #b111001011 #b00010)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                expect
                (fp #b1 #b111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111)
                expect
                (fp #b0 #b110100110 #b01110)))

(assert (not (= expect result)))

(check-sat)
(exit)
