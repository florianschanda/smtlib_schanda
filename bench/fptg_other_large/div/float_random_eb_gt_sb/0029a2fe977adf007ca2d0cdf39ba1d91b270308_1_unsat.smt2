(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0000001100 #b0000111)
                arg1
                (fp #b1 #b0000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b0000000000 #b1111010)
                arg1
                (fp #b0 #b0011001100 #b0100011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0100110100 #b0110111)
                expect
                (fp #b0 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000)
                expect
                (fp #b0 #b1110000101 #b1011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
