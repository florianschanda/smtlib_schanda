(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10101101110111 #b0100)
                arg1
                (fp #b1 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0001)
                arg1
                (fp #b0 #b01101011011111 #b0001)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11100110000010 #b0000)
                arg2
                (fp #b1 #b11001011000101 #b0111)))
(assert (fp.leq (fp #b1 #b11001011000101 #b0111)
                arg2
                (fp #b1 #b10001001111000 #b0100)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00001110010101 #b0110)
                expect
                (fp #b0 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0001)
                expect
                (fp #b0 #b01110100000001 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
