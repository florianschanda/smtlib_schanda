;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10111111010 #b11111101)
                arg1
                (fp #b1 #b10111101110 #b11010110)))
(assert (fp.leq (fp #b1 #b10111101110 #b11010110)
                arg1
                (fp #b0 #b10110011000 #b11001111)))

