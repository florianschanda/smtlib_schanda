(assert (fp.leq (fp #b1 #b11001010001 #b01110101)
                arg2
                (fp #b1 #b10111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b11111111)
                arg2
                (fp #b0 #b10100001001 #b10110100)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01011010110 #b00010100)
                expect
                (fp #b0 #b01111101110 #b11010110)))
(assert (fp.leq (fp #b0 #b01111101110 #b11010110)
                expect
                (fp #b0 #b11001000011 #b11010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
