(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011001100 #b10100)
                arg1
                (fp #b0 #b000000000 #b11001)))
(assert (fp.leq (fp #b0 #b000000000 #b11001)
                arg1
                (fp #b0 #b110000010 #b10011)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b000001010 #b01100)
                arg2
                (fp #b0 #b011111111 #b11010)))
(assert (fp.leq (fp #b0 #b011111111 #b11010)
                arg2
                (fp #b0 #b101101110 #b11101)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100011001 #b10010)
                expect
                (fp #b0 #b000000000 #b01101)))
(assert (fp.leq (fp #b0 #b000000000 #b01101)
                expect
                (fp #b0 #b111100001 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
