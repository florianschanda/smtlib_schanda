; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0000100001111111 #b101010001)
                arg1
                (fp #b0 #b0111111111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b111111100)
                arg1
                (fp #b0 #b1111000101111101 #b111110101)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0110000100111100 #b100101010)
                expect
                (fp #b0 #b0000000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000)
                expect
                (fp #b0 #b0101000001110111 #b000010011)))

(assert (= expect result))

(check-sat)
(exit)
