(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111101 #b0010110)
                arg1
                (fp #b1 #b1111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b0000000)
                arg1
                (fp #b0 #b1001001110 #b1001111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110001111 #b0101111)
                arg2
                (fp #b0 #b1110101001 #b0101010)))
(assert (fp.leq (fp #b0 #b1110101001 #b0101010)
                arg2
                (fp #b0 #b1111011001 #b0010111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110000000 #b0101010)
                expect
                (fp #b1 #b1001010010 #b1000001)))
(assert (fp.leq (fp #b1 #b1001010010 #b1000001)
                expect
                (fp #b0 #b1100001111 #b0100100)))

(assert (= expect result))

(check-sat)
(exit)
