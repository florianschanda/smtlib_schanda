(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b0111100101111010 #b001111111)
                arg1
                (fp #b0 #b1111111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111)
                arg1
                (fp #b0 #b1111111111111111 #b000000000)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0101010100111111 #b110110000)
                arg2
                (fp #b0 #b0011111111111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111111111011 #b011010100)
                arg2
                (fp #b0 #b1010001011100011 #b011010001)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
