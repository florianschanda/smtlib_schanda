(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b011001010110111 #b0000010001110)
                arg1
                (fp #b1 #b000000000000000 #b0000000000001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000000001)
                arg1
                (fp #b0 #b110100001110001 #b1001010110010)))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b110000110101010 #b0111010111111)
                arg2
                (fp #b1 #b101111111111110 #b1111111111111)))
(assert (fp.leq (fp #b1 #b101111111111110 #b1111111111111)
                arg2
                (fp #b0 #b101001110011011 #b0110001011000)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001110010110100 #b1000110110011)
                expect
                (fp #b0 #b000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000000000)
                expect
                (fp #b0 #b011011110010000 #b1101110010010)))

(assert (= expect result))

(check-sat)
(exit)
