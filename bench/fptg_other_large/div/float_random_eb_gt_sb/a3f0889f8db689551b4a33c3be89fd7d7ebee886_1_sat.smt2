; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11010100110 #b001)
                arg1
                (fp #b1 #b10110111010 #b001)))
(assert (fp.leq (fp #b1 #b10110111010 #b001)
                arg1
                (fp #b0 #b11001111111 #b100)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00011111100 #b100)
                arg2
                (fp #b0 #b10110000110 #b100)))
(assert (fp.leq (fp #b0 #b10110000110 #b100)
                arg2
                (fp #b0 #b11100101110 #b001)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11101010001 #b011)
                expect
                (fp #b1 #b10000110010 #b100)))
(assert (fp.leq (fp #b1 #b10000110010 #b100)
                expect
                (fp #b0 #b11100110011 #b010)))

(assert (= expect result))

(check-sat)
(exit)
