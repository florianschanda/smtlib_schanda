(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100110100110 #b01000011)
                arg1
                (fp #b0 #b000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000001)
                arg1
                (fp #b0 #b100001100101 #b01111110)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101111111011 #b00111111)
                arg2
                (fp #b1 #b101111110000 #b00001011)))
(assert (fp.leq (fp #b1 #b101111110000 #b00001011)
                arg2
                (fp #b0 #b001001100000 #b00010101)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100011010011 #b01100000)
                expect
                (fp #b1 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000)
                expect
                (fp #b0 #b110011000111 #b01101101)))

(assert (= expect result))

(check-sat)
(exit)
