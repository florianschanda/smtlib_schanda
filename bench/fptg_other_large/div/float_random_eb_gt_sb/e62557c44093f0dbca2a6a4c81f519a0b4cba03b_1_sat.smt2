; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b0 #b01100011000100100 #b10111010010)
                arg1
                (fp #b0 #b10011001100111011 #b10110101101)))
(assert (fp.leq (fp #b0 #b10011001100111011 #b10110101101)
                arg1
                (fp #b0 #b11110100111110100 #b00110000110)))

(declare-const arg2 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b01100110110101011 #b00110110100)
                arg2
                (fp #b1 #b01000011001110110 #b10100110011)))
(assert (fp.leq (fp #b1 #b01000011001110110 #b10100110011)
                arg2
                (fp #b0 #b00111010111000001 #b11111010101)))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b11100111001111110 #b10010001110)
                expect
                (fp #b1 #b11010110011000100 #b00001001001)))
(assert (fp.leq (fp #b1 #b11010110011000100 #b00001001001)
                expect
                (fp #b1 #b10001000101001101 #b00111101011)))

(assert (= expect result))

(check-sat)
(exit)
