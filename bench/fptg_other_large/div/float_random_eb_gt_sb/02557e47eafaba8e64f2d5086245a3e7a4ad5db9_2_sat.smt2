                arg2
                (fp #b1 #b1111111111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b1111111111)
                arg2
                (fp #b0 #b1010111100011001 #b1100011010)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0011111000111100 #b1111101101)
                expect
                (fp #b0 #b0000000000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000001)
                expect
                (fp #b0 #b1001111110010000 #b0011110111)))

(assert (= expect result))

(check-sat)
(exit)
