;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0110111100000011 #b1111111011)
                arg1
                (fp #b1 #b0000000000000001 #b0000000000)))
