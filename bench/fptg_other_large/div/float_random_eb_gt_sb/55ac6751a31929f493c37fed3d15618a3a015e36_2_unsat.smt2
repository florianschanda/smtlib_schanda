(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b001010011 #b011)
                arg1
                (fp #b0 #b001111110 #b011)))
(assert (fp.leq (fp #b0 #b001111110 #b011)
                arg1
                (fp #b0 #b111100011 #b010)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010101001 #b010)
                arg2
                (fp #b1 #b000101100 #b111)))
(assert (fp.leq (fp #b1 #b000101100 #b111)
                arg2
                (fp #b0 #b011001011 #b001)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110110111 #b011)
                expect
                (fp #b1 #b101010000 #b100)))
(assert (fp.leq (fp #b1 #b101010000 #b100)
                expect
                (fp #b0 #b011111100 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
