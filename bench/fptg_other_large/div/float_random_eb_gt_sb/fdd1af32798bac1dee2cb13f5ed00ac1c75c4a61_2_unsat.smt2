(assert (fp.leq (fp #b0 #b111010111110011000 #b001110)
                arg2
                (fp #b0 #b111011011100010001 #b101000)))

(declare-const result (_ FloatingPoint 18 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b001110011111010110 #b001000)
                expect
                (fp #b1 #b000101000001100110 #b100111)))
(assert (fp.leq (fp #b1 #b000101000001100110 #b100111)
                expect
                (fp #b0 #b111111000011010001 #b001010)))

(assert (not (= expect result)))

(check-sat)
