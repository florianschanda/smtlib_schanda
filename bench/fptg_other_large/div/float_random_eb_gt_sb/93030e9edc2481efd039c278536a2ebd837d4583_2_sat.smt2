(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11010011110 #b010)
                arg1
                (fp #b1 #b10000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000011 #b000)
                arg1
                (fp #b1 #b01011011000 #b000)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11110111001 #b000)
                arg2
                (fp #b1 #b10000000010 #b001)))
(assert (fp.leq (fp #b1 #b10000000010 #b001)
                arg2
                (fp #b1 #b01111000010 #b100)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01110001110 #b100)
                expect
                (fp #b0 #b01111111111 #b111)))
(assert (fp.leq (fp #b0 #b01111111111 #b111)
                expect
                (fp #b0 #b10001101100 #b111)))

(assert (= expect result))

(check-sat)
(exit)
