(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11100001000 #b1000)
                arg1
                (fp #b1 #b00000000000 #b0001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001)
                arg1
                (fp #b0 #b11101001010 #b0101)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111110011 #b1001)
                arg2
                (fp #b1 #b10000000011 #b1110)))
(assert (fp.leq (fp #b1 #b10000000011 #b1110)
                arg2
                (fp #b1 #b01000101010 #b1110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00100100101 #b1010)
                expect
                (fp #b0 #b00000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000)
                expect
                (fp #b0 #b11100111000 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
