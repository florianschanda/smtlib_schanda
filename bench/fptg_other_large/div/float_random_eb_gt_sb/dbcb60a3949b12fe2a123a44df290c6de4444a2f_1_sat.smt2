(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110110111010111 #b011)
                arg1
                (fp #b1 #b000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000000 #b010)
                arg1
                (fp #b0 #b011110101010100 #b110)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b011101110110011 #b110)
                arg2
                (fp #b0 #b001011000110111 #b101)))
(assert (fp.leq (fp #b0 #b001011000110111 #b101)
                arg2
                (fp #b0 #b011101000011001 #b011)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100100010110011 #b110)
                expect
                (fp #b1 #b010100111000110 #b001)))
(assert (fp.leq (fp #b1 #b010100111000110 #b001)
                expect
                (fp #b0 #b001011111101010 #b000)))

(assert (= expect result))

(check-sat)
(exit)
