(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1011001011110 #b001)
                arg1
                (fp #b1 #b0111111111111 #b101)))
(assert (fp.leq (fp #b1 #b0111111111111 #b101)
                arg1
                (fp #b0 #b1010100010100 #b000)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0100100111101 #b000)
                arg2
                (fp #b1 #b0000000000000 #b010)))
(assert (fp.leq (fp #b1 #b0000000000000 #b010)
                arg2
                (fp #b0 #b1001001000000 #b101)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b1100010111100 #b111)
                expect
                (fp #b0 #b1111111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111)
                expect
                (fp #b0 #b1111111111111 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
