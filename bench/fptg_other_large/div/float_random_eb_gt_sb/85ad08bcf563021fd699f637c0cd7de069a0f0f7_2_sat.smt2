(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0010001001 #b11110011)
                arg1
                (fp #b0 #b0000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000001)
                arg1
                (fp #b0 #b1001000111 #b00101001)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110010010 #b00000011)
                arg2
                (fp #b1 #b0000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b11111111)
                arg2
                (fp #b0 #b0001010011 #b11011100)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000010000 #b10110010)
                expect
                (fp #b1 #b0111110111 #b00000010)))
(assert (fp.leq (fp #b1 #b0111110111 #b00000010)
                expect
                (fp #b1 #b0110011001 #b10101010)))

(assert (= expect result))

(check-sat)
(exit)
