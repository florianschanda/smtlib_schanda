; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b011100100011 #b1000110000)
                arg1
                (fp #b1 #b000000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0100000000)
                arg1
                (fp #b0 #b010001111010 #b0110100000)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101111000010 #b0100111100)
                expect
                (fp #b1 #b000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000000)
                expect
                (fp #b0 #b101010000000 #b1101100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
