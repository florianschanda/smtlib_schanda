(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0010011111000010 #b101)
                arg1
                (fp #b0 #b0000000000000000 #b001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b001)
                arg1
                (fp #b0 #b0010110110101010 #b001)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0010010101010000 #b110)
                arg2
                (fp #b0 #b1011010100110111 #b010)))
(assert (fp.leq (fp #b0 #b1011010100110111 #b010)
                arg2
                (fp #b0 #b1011100001000101 #b000)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1100100110010111 #b110)
                expect
                (fp #b0 #b0000000000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000)
                expect
                (fp #b0 #b0001000110101000 #b000)))

(assert (= expect result))

(check-sat)
(exit)
