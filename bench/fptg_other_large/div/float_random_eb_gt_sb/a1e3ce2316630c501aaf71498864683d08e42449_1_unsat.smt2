(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b101100001 #b1110101)
                arg1
                (fp #b1 #b000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000000)
                arg1
                (fp #b0 #b110110111 #b0111000)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111110101 #b1000111)
                arg2
                (fp #b1 #b100110111 #b1110100)))
(assert (fp.leq (fp #b1 #b100110111 #b1110100)
                arg2
                (fp #b1 #b010000111 #b1110101)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110010000 #b1101011)
                expect
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                expect
                (fp #b0 #b011110010 #b0101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
