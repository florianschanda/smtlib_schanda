                (fp #b0 #b000000000000000000 #b1011101)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b1011101)
                arg2
                (fp #b0 #b110011100100001000 #b0000100)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b101110011011101000 #b0111110)
                expect
                (fp #b0 #b101111111111111010 #b1111010)))
(assert (fp.leq (fp #b0 #b101111111111111010 #b1111010)
                expect
                (fp #b0 #b110010110110001011 #b1100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
