; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1000011100110000 #b01111110011)
                arg1
                (fp #b0 #b1011010000110111 #b10111000010)))
(assert (fp.leq (fp #b0 #b1011010000110111 #b10111000010)
                arg1
                (fp #b0 #b1011110111111000 #b11010000101)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1100010001110100 #b10110011001)
                expect
                (fp #b0 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000000)
                expect
                (fp #b0 #b1000100001100101 #b00010000001)))

(assert (= expect result))

(check-sat)
(exit)
