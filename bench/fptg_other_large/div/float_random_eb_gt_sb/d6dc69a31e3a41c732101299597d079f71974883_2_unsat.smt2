(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100100011 #b0010101)
                arg1
                (fp #b0 #b1000000101 #b0101100)))
(assert (fp.leq (fp #b0 #b1000000101 #b0101100)
                arg1
                (fp #b0 #b1110110110 #b0001010)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100000000 #b0011010)
                arg2
                (fp #b0 #b0000010101 #b1000010)))
(assert (fp.leq (fp #b0 #b0000010101 #b1000010)
                arg2
                (fp #b0 #b0001110001 #b1000101)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b1110000011 #b0000001)
                expect
                (fp #b0 #b1111101110 #b1100011)))
(assert (fp.leq (fp #b0 #b1111101110 #b1100011)
                expect
                (fp #b0 #b1111111011 #b0001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
