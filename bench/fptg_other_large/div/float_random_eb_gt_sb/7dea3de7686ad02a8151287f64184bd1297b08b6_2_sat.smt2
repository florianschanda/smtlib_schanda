(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00001001101 #b1101)
                arg1
                (fp #b0 #b00000000000 #b1110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110)
                arg1
                (fp #b0 #b11011100101 #b0111)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000011001 #b1111)
                arg2
                (fp #b1 #b00000000000 #b1111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111)
                arg2
                (fp #b0 #b10010010101 #b1001)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11000000010 #b1110)
                expect
                (fp #b1 #b01111111110 #b1110)))
(assert (fp.leq (fp #b1 #b01111111110 #b1110)
                expect
                (fp #b0 #b11001110011 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
