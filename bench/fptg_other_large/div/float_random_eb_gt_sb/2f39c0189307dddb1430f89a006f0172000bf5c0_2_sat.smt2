(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0101110111100011 #b00001001)
                arg1
                (fp #b1 #b0011111111111100 #b00000000)))
(assert (fp.leq (fp #b1 #b0011111111111100 #b00000000)
                arg1
                (fp #b0 #b1011101000111000 #b10101100)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1011101011100110 #b01110111)
                arg2
                (fp #b1 #b1000111000111000 #b00011111)))
(assert (fp.leq (fp #b1 #b1000111000111000 #b00011111)
                arg2
                (fp #b0 #b0110111101001001 #b00101001)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0001011100010010 #b01010000)
                expect
                (fp #b0 #b0011000111000010 #b11001001)))
(assert (fp.leq (fp #b0 #b0011000111000010 #b11001001)
                expect
                (fp #b0 #b1010011000001111 #b00011010)))

(assert (= expect result))

(check-sat)
(exit)
