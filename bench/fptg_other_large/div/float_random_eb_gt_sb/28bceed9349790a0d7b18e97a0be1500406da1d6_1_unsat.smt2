; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b011110011100 #b100011001)
                arg1
                (fp #b0 #b000000000000 #b011110111)))
(assert (fp.leq (fp #b0 #b000000000000 #b011110111)
                arg1
                (fp #b0 #b100011000100 #b111001110)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b010100000001 #b111111001)
                arg2
                (fp #b1 #b000101000001 #b100110100)))
(assert (fp.leq (fp #b1 #b000101000001 #b100110100)
                arg2
                (fp #b0 #b110101001111 #b011101011)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111111101010 #b010111010)
                expect
                (fp #b1 #b011010111101 #b001101000)))
(assert (fp.leq (fp #b1 #b011010111101 #b001101000)
                expect
                (fp #b1 #b010001110001 #b101000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
