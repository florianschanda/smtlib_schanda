(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b1001010101000 #b00)
                arg1
                (fp #b0 #b1011110001100 #b00)))
(assert (fp.leq (fp #b0 #b1011110001100 #b00)
                arg1
                (fp #b0 #b1110011100100 #b00)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0111011001011 #b00)
                arg2
                (fp #b0 #b1000000000001 #b10)))
(assert (fp.leq (fp #b0 #b1000000000001 #b10)
                arg2
                (fp #b0 #b1111000111001 #b10)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0001010010101 #b01)
                expect
                (fp #b0 #b1011110001001 #b10)))
(assert (fp.leq (fp #b0 #b1011110001001 #b10)
                expect
                (fp #b0 #b1100101000101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
