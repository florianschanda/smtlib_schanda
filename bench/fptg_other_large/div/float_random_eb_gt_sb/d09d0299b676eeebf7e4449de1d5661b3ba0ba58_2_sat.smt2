; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b0 #b100110011001 #b101010001)
                arg1
                (fp #b0 #b101101011101 #b000111110)))
(assert (fp.leq (fp #b0 #b101101011101 #b000111110)
                arg1
                (fp #b0 #b111000011000 #b000110110)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110111110101 #b011100001)
                arg2
                (fp #b1 #b011111111111 #b010001010)))
(assert (fp.leq (fp #b1 #b011111111111 #b010001010)
                arg2
                (fp #b0 #b110001011110 #b011010010)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111001100101 #b100001100)
                expect
                (fp #b1 #b101101011100 #b110001001)))
(assert (fp.leq (fp #b1 #b101101011100 #b110001001)
                expect
                (fp #b0 #b110010011111 #b100111000)))

(assert (= expect result))

(check-sat)
(exit)
