; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b110110111011111 #b00100100)
                arg1
                (fp #b1 #b101101111000001 #b01100111)))
(assert (fp.leq (fp #b1 #b101101111000001 #b01100111)
                arg1
                (fp #b0 #b100000001000000 #b10011001)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b101011100000000 #b11110101)
                arg2
                (fp #b1 #b011100010000001 #b01001010)))
(assert (fp.leq (fp #b1 #b011100010000001 #b01001010)
                arg2
                (fp #b0 #b100011010011010 #b01111101)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b0 #b010101010111001 #b10100101)
                expect
                (fp #b0 #b110001100111111 #b00010111)))
(assert (fp.leq (fp #b0 #b110001100111111 #b00010111)
                expect
                (fp #b0 #b110111000111001 #b01101101)))

(assert (= expect result))

(check-sat)
(exit)
