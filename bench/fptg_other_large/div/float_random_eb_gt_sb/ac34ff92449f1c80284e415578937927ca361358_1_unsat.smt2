(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00001101100 #b1010000)
                arg1
                (fp #b0 #b00000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000)
                arg1
                (fp #b0 #b00000010000 #b1010000)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10111000011 #b1010010)
                expect
                (fp #b1 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000)
                expect
                (fp #b0 #b10100011010 #b0110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
