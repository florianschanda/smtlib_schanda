; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b111111000110001111 #b0101011010)
                arg1
                (fp #b1 #b001111111111111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b001111111111111011 #b0000000000)
                arg1
                (fp #b0 #b001010111110111000 #b1100111011)))

(declare-const arg2 (_ FloatingPoint 18 11))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101110111011011111 #b1001001100)
                expect
                (fp #b0 #b000000000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0000000000)
                expect
                (fp #b0 #b100010001010000101 #b1001111100)))

(assert (= expect result))

(check-sat)
(exit)
