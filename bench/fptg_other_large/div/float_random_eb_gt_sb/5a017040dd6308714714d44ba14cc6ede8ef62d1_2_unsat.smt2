(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111101100011 #b101)
                arg1
                (fp #b1 #b100000000011 #b000)))
(assert (fp.leq (fp #b1 #b100000000011 #b000)
                arg1
                (fp #b0 #b011011100010 #b100)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111111111111 #b000)
                arg2
                (fp #b1 #b111111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111111110 #b111)
                arg2
                (fp #b1 #b110000110100 #b000)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111011000001 #b001)
                expect
                (fp #b0 #b000000000011 #b001)))
(assert (fp.leq (fp #b0 #b000000000011 #b001)
                expect
                (fp #b0 #b000110010111 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
