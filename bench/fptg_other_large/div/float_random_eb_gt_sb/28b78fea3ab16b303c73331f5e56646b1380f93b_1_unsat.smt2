(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b000101001000 #b10)
                arg1
                (fp #b0 #b110010000111 #b10)))
(assert (fp.leq (fp #b0 #b110010000111 #b10)
                arg1
                (fp #b0 #b111111010001 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b011001001100 #b10)
                arg2
                (fp #b0 #b101111111110 #b11)))
(assert (fp.leq (fp #b0 #b101111111110 #b11)
                arg2
                (fp #b0 #b110111100000 #b01)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b011101101101 #b00)
                expect
                (fp #b0 #b100010000111 #b10)))
(assert (fp.leq (fp #b0 #b100010000111 #b10)
                expect
                (fp #b0 #b110000110110 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
