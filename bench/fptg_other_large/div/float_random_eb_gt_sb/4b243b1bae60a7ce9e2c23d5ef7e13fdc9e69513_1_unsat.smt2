;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b00110011011100 #b110110)
                arg1
                (fp #b0 #b10000000000101 #b000111)))
(assert (fp.leq (fp #b0 #b10000000000101 #b000111)
