                (fp #b1 #b00101000010101 #b110001)))
(assert (fp.leq (fp #b1 #b00101000010101 #b110001)
                arg2
                (fp #b0 #b10010101111000 #b001000)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11101011000111 #b000000)
                expect
                (fp #b1 #b11010111101110 #b010000)))
(assert (fp.leq (fp #b1 #b11010111101110 #b010000)
                expect
                (fp #b0 #b10010101010101 #b010000)))

(assert (not (= expect result)))

(check-sat)
