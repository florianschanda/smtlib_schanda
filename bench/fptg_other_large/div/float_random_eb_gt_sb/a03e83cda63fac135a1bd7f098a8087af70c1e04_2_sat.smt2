(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010110011111 #b000)
                arg1
                (fp #b1 #b010000000000 #b000)))
(assert (fp.leq (fp #b1 #b010000000000 #b000)
                arg1
                (fp #b1 #b000100010011 #b111)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010010110011 #b010)
                arg2
                (fp #b0 #b000000000000 #b110)))
(assert (fp.leq (fp #b0 #b000000000000 #b110)
                arg2
                (fp #b0 #b101101100000 #b110)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111001011100 #b101)
                expect
                (fp #b1 #b101111111110 #b011)))
(assert (fp.leq (fp #b1 #b101111111110 #b011)
                expect
                (fp #b0 #b101111101011 #b100)))

(assert (= expect result))

(check-sat)
(exit)
