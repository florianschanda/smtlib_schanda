(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b011101101111 #b1011)
                arg1
                (fp #b0 #b111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111)
                arg1
                (fp #b0 #b111111111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b001000100010 #b1110)
                arg2
                (fp #b0 #b000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b000000000000 #b0001)
                arg2
                (fp #b0 #b110111010100 #b0001)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b010111101100 #b1101)
                expect
                (fp #b0 #b111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111)
                expect
                (fp #b0 #b111111111111 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
