(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111010 #b01001)
                arg1
                (fp #b1 #b111100000 #b00011)))
(assert (fp.leq (fp #b1 #b111100000 #b00011)
                arg1
                (fp #b0 #b101001101 #b00000)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000001100 #b11101)
                expect
                (fp #b1 #b000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000)
                expect
                (fp #b0 #b101000000 #b11111)))

(assert (= expect result))

(check-sat)
(exit)
