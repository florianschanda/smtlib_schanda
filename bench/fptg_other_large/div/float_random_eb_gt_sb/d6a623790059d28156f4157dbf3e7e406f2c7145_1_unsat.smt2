(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00110110110 #b000010010)
                arg1
                (fp #b0 #b00000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000001)
                arg1
                (fp #b0 #b01010000100 #b101100011)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111111111 #b000000000)
                arg2
                (fp #b1 #b11111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b111111111)
                arg2
                (fp #b0 #b00001000100 #b010101101)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01010100101 #b000100011)
                expect
                (fp #b1 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000000)
                expect
                (fp #b0 #b01110011010 #b010011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
