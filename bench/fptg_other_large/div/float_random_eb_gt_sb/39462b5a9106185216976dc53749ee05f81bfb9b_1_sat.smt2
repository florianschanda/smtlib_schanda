; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0000010110100010 #b1000)
                arg1
                (fp #b1 #b0000000000000001 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b0000)
                arg1
                (fp #b0 #b1010000000100010 #b0001)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1100001100011011 #b1010)
                arg2
                (fp #b1 #b1000000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000000000000100 #b0000)
                arg2
                (fp #b1 #b0000111101000001 #b0101)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1011100000101011 #b1111)
                expect
                (fp #b0 #b0000000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000)
                expect
                (fp #b0 #b0111011110001111 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
