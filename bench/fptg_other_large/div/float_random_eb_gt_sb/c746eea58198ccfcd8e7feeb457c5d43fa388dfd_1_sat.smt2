; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b00010110101011 #b1011011)
                arg1
                (fp #b0 #b00000000000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111111)
                arg1
                (fp #b0 #b11011100000110 #b1001110)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10010100010000 #b0011010)
                arg2
                (fp #b1 #b01110111011010 #b1011101)))
(assert (fp.leq (fp #b1 #b01110111011010 #b1011101)
                arg2
                (fp #b1 #b01011100000011 #b1101011)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11011000010111 #b1110010)
                expect
                (fp #b1 #b00001000100101 #b0010011)))
(assert (fp.leq (fp #b1 #b00001000100101 #b0010011)
                expect
                (fp #b0 #b11011010111101 #b0000100)))

(assert (= expect result))

(check-sat)
(exit)
