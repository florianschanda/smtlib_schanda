(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11110010001111 #b1111110)
                arg1
                (fp #b1 #b10111111000010 #b0100000)))
(assert (fp.leq (fp #b1 #b10111111000010 #b0100000)
                arg1
                (fp #b0 #b10001110100101 #b0110100)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11010000010111 #b0101110)
                arg2
                (fp #b0 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111)
                arg2
                (fp #b0 #b11111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10011001101111 #b0110101)
                expect
                (fp #b1 #b00111111000010 #b0100000)))
(assert (fp.leq (fp #b1 #b00111111000010 #b0100000)
                expect
                (fp #b0 #b01111000101010 #b0000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
