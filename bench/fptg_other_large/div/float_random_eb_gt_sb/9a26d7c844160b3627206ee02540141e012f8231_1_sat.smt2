(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b011101000111000 #b01110000)
                arg1
                (fp #b0 #b000010101110110 #b10110110)))
(assert (fp.leq (fp #b0 #b000010101110110 #b10110110)
                arg1
                (fp #b0 #b100010110110010 #b10110101)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110000110001010 #b01001110)
                expect
                (fp #b0 #b000000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000)
                expect
                (fp #b0 #b000000101110001 #b10000101)))

(assert (= expect result))

(check-sat)
(exit)
