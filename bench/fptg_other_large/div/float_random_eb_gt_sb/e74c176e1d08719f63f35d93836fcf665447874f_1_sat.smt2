(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00111000110001 #b0000)
                arg1
                (fp #b0 #b00000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000)
                arg1
                (fp #b0 #b10011100111001 #b0101)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11101110010100 #b1001)
                expect
                (fp #b0 #b00000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000)
                expect
                (fp #b0 #b10000110001101 #b0010)))

(assert (= expect result))

(check-sat)
(exit)
