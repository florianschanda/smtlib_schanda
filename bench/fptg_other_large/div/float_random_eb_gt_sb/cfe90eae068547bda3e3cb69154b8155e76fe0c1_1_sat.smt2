; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b0 #b00101110000100001 #b01)
                arg1
                (fp #b0 #b01111111111111111 #b11)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b11)
                arg1
                (fp #b0 #b10110011100010111 #b11)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10110111001010101 #b10)
                arg2
                (fp #b1 #b10000000000000001 #b10)))
(assert (fp.leq (fp #b1 #b10000000000000001 #b10)
                arg2
                (fp #b0 #b01010101011000010 #b11)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11000010001000010 #b00)
                expect
                (fp #b1 #b01111111111111101 #b00)))
(assert (fp.leq (fp #b1 #b01111111111111101 #b00)
                expect
                (fp #b0 #b10011011111101100 #b00)))

(assert (= expect result))

(check-sat)
(exit)
