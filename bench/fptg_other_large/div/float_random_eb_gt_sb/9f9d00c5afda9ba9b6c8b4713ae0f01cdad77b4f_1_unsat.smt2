(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111011101111110 #b11001110010)
                arg1
                (fp #b0 #b1000000000001010 #b10001010101)))
(assert (fp.leq (fp #b0 #b1000000000001010 #b10001010101)
                arg1
                (fp #b0 #b1100011101011001 #b00000100000)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111110100001001 #b00100010111)
                arg2
                (fp #b1 #b0000000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01000000000)
                arg2
                (fp #b0 #b1010000100000011 #b01011010000)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000000000)
                expect
                (fp #b1 #b1111111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111111111)
                expect
                (fp #b0 #b1011011100010001 #b10101010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
