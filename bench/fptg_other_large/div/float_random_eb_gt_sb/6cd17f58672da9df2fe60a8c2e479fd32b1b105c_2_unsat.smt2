(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0011011100 #b01101)
                arg1
                (fp #b0 #b1111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111)
                arg1
                (fp #b0 #b1111111111 #b00000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001011100 #b00001)
                arg2
                (fp #b1 #b0111111111 #b01000)))
(assert (fp.leq (fp #b1 #b0111111111 #b01000)
                arg2
                (fp #b0 #b0110101000 #b00011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111110 #b11001)
                expect
                (fp #b1 #b1111111110 #b10011)))
(assert (fp.leq (fp #b1 #b1111111110 #b10011)
                expect
                (fp #b1 #b0100001110 #b00010)))

(assert (not (= expect result)))

(check-sat)
(exit)
