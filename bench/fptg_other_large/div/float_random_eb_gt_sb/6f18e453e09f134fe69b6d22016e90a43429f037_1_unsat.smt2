(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111110 #b100)
                arg1
                (fp #b1 #b11111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000)
                arg1
                (fp #b1 #b01101100010000 #b101)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11001001101000 #b101)
                arg2
                (fp #b1 #b10111111111110 #b111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b111)
                arg2
                (fp #b1 #b01011101111010 #b000)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b10101010110111 #b000)
                expect
                (fp #b0 #b10111111111101 #b000)))
(assert (fp.leq (fp #b0 #b10111111111101 #b000)
                expect
                (fp #b0 #b11000010000111 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
