                arg2
                (fp #b0 #b0101100111111 #b011100)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1101110010111 #b010101)
                expect
                (fp #b1 #b1011111111011 #b010110)))
(assert (fp.leq (fp #b1 #b1011111111011 #b010110)
                expect
                (fp #b1 #b0001100011100 #b100011)))

(assert (= expect result))

(check-sat)
