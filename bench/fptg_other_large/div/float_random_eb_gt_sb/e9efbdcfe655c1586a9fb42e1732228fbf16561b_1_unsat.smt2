(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b001011001111 #b000)
                arg1
                (fp #b1 #b000000000000 #b110)))
(assert (fp.leq (fp #b1 #b000000000000 #b110)
                arg1
                (fp #b0 #b110101100000 #b101)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b100100010111 #b000)
                arg2
                (fp #b0 #b111111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111111101 #b000)
                arg2
                (fp #b0 #b111111111110 #b001)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011010010011 #b110)
                expect
                (fp #b1 #b000000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000000 #b000)
                expect
                (fp #b0 #b000001101101 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
