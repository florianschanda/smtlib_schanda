(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b000110010000 #b1100)
                arg1
                (fp #b1 #b000000000000 #b1000)))
(assert (fp.leq (fp #b1 #b000000000000 #b1000)
                arg1
                (fp #b0 #b001011011110 #b1110)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111111111110 #b1001)
                arg2
                (fp #b1 #b111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111111101 #b0000)
                arg2
                (fp #b1 #b010000011111 #b0101)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000011100000 #b0100)
                expect
                (fp #b0 #b000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000)
                expect
                (fp #b0 #b000010001110 #b1101)))

(assert (not (= expect result)))

(check-sat)
(exit)
