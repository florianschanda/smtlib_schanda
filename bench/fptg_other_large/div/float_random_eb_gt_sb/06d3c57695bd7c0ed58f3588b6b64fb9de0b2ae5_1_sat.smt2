(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b001101000011010011 #b1101110010010)
                arg1
                (fp #b1 #b001011001010001101 #b1001001111101)))
(assert (fp.leq (fp #b1 #b001011001010001101 #b1001001111101)
                arg1
                (fp #b0 #b110011000110000000 #b0001010111011)))

(declare-const arg2 (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b110101001001011100 #b1100011110010)
                arg2
                (fp #b1 #b000000000000000000 #b0011111001000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0011111001000)
                arg2
                (fp #b0 #b011000011110111111 #b1101000001100)))

(declare-const result (_ FloatingPoint 18 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b0 #b000000100011001100 #b1111111101011)
                expect
                (fp #b0 #b101011001010001101 #b1001111101000)))
(assert (fp.leq (fp #b0 #b101011001010001101 #b1001111101000)
                expect
                (fp #b0 #b110010110100111011 #b1111000110000)))

(assert (= expect result))

(check-sat)
(exit)
