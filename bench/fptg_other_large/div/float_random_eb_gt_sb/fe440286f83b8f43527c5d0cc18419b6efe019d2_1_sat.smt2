(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101010100111 #b1010000001)
                arg1
                (fp #b1 #b000000000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b0000000000)
                arg1
                (fp #b0 #b100110000001 #b0001110100)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b000000011001 #b1011001111)
                arg2
                (fp #b0 #b100000001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b100000001001 #b0100111000)
                arg2
                (fp #b0 #b110110111111 #b1010111100)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000011010010 #b0010010100)
                expect
                (fp #b1 #b000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000000)
                expect
                (fp #b0 #b101011010011 #b0010010011)))

(assert (= expect result))

(check-sat)
(exit)
