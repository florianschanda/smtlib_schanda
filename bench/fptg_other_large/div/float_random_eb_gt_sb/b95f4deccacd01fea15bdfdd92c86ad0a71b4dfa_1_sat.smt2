; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10011111111 #b1)
                arg1
                (fp #b0 #b01000000000 #b0)))
(assert (fp.leq (fp #b0 #b01000000000 #b0)
                arg1
                (fp #b0 #b11100111101 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b00001000110 #b0)
                arg2
                (fp #b0 #b10000011001 #b0)))
(assert (fp.leq (fp #b0 #b10000011001 #b0)
                arg2
                (fp #b0 #b11001100110 #b1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b00000010001 #b1)
                expect
                (fp #b0 #b00111100110 #b0)))
(assert (fp.leq (fp #b0 #b00111100110 #b0)
                expect
                (fp #b0 #b11101101010 #b1)))

(assert (= expect result))

(check-sat)
(exit)
