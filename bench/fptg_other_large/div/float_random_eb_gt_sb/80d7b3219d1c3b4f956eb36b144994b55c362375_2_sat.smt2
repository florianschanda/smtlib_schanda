(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b01111101010111 #b11011)
                arg1
                (fp #b0 #b00000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01000)
                arg1
                (fp #b0 #b10110011000011 #b00011)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01010001000101 #b00000)
                arg2
                (fp #b0 #b10111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b11111)
                arg2
                (fp #b0 #b11111000110011 #b00111)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10010110111011 #b10100)
                expect
                (fp #b0 #b00000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00001)
                expect
                (fp #b0 #b01101001001011 #b00101)))

(assert (= expect result))

(check-sat)
(exit)
