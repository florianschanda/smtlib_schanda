; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b10001100101100111 #b1)
                arg1
                (fp #b0 #b00000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b1)
                arg1
                (fp #b0 #b10010100010001011 #b0)))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b10101001111111111 #b0)
                arg2
                (fp #b1 #b01111111111111111 #b1)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1)
                arg2
                (fp #b0 #b00010111100000111 #b0)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11011100110101111 #b1)
                expect
                (fp #b1 #b00000000000000000 #b0)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0)
                expect
                (fp #b0 #b00011001001110011 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
