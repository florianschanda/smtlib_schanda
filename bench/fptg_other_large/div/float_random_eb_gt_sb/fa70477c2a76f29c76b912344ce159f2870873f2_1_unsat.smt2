;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0111010110001000 #b11)
                arg1
                (fp #b0 #b1111111111111101 #b00)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b00)
                arg1
                (fp #b0 #b1111111111111110 #b11)))

(declare-const arg2 (_ FloatingPoint 16 3))
