                arg2
                (fp #b0 #b1011111111000000 #b11)))
(assert (fp.leq (fp #b0 #b1011111111000000 #b11)
                arg2
                (fp #b0 #b1110110110111100 #b10)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1110011111001001 #b00)
                expect
                (fp #b0 #b1100000000111011 #b00)))
(assert (fp.leq (fp #b0 #b1100000000111011 #b00)
                expect
                (fp #b0 #b1110100110101001 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
