(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111110010011 #b011101)
                arg1
                (fp #b0 #b011111111111 #b000100)))
(assert (fp.leq (fp #b0 #b011111111111 #b000100)
                arg1
                (fp #b0 #b100010010000 #b100100)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100100100111 #b111000)
                arg2
                (fp #b1 #b100000000000 #b100000)))
(assert (fp.leq (fp #b1 #b100000000000 #b100000)
                arg2
                (fp #b0 #b010110011101 #b101001)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111000100011 #b101000)
                expect
                (fp #b1 #b011111111101 #b011010)))
(assert (fp.leq (fp #b1 #b011111111101 #b011010)
                expect
                (fp #b0 #b001011010101 #b100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
