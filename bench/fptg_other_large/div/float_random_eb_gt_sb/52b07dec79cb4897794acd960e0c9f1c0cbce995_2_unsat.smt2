(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b111110011111 #b0)
                arg1
                (fp #b1 #b110101110001 #b0)))
(assert (fp.leq (fp #b1 #b110101110001 #b0)
                arg1
                (fp #b1 #b101010110001 #b0)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b0 #b001111100001 #b1)
                arg2
                (fp #b0 #b001111111111 #b1)))
(assert (fp.leq (fp #b0 #b001111111111 #b1)
                arg2
                (fp #b0 #b100111101001 #b1)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
