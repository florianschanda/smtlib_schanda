(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10110011011111 #b1110)
                arg1
                (fp #b0 #b10001110000011 #b0100)))
(assert (fp.leq (fp #b0 #b10001110000011 #b0100)
                arg1
                (fp #b0 #b11010001111000 #b0100)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111010011011 #b1011)
                arg2
                (fp #b0 #b00000000000000 #b1111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111)
                arg2
                (fp #b0 #b00001011110110 #b1010)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b0 #b00001010011011 #b0010)
                expect
                (fp #b0 #b11111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111)
                expect
                (fp #b0 #b11111111111111 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
