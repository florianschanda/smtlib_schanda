(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11100111111011 #b00100111)
                arg1
                (fp #b1 #b01111111111111 #b00100101)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00100101)
                arg1
                (fp #b1 #b01011110011111 #b00001111)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10000111011100 #b11000011)
                arg2
                (fp #b1 #b00000000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b00000000000000 #b01111101)
                arg2
                (fp #b0 #b00101011000010 #b11110101)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b0 #b10101010100100 #b11000100)
                expect
                (fp #b0 #b11111111111110 #b00101101)))
(assert (fp.leq (fp #b0 #b11111111111110 #b00101101)
                expect
                (fp #b0 #b11111111111110 #b00111010)))

(assert (= expect result))

(check-sat)
(exit)
