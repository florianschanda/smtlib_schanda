(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b000101110011 #b10010001)
                arg1
                (fp #b0 #b011111111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001001)
                arg1
                (fp #b0 #b101111101000 #b11000101)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010001010110 #b10000010)
                arg2
                (fp #b0 #b000000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b01000000)
                arg2
                (fp #b0 #b101001001001 #b00001010)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b101000000000 #b11010101)
                expect
                (fp #b0 #b111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111)
                expect
                (fp #b0 #b111111111111 #b00000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
