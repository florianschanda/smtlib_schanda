; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00001100001 #b000010101)
                arg1
                (fp #b0 #b00000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b00000000000 #b111100110)
                arg1
                (fp #b0 #b01101110001 #b000011110)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00000010011 #b111111110)
                arg2
                (fp #b0 #b11101110101 #b001001000)))
(assert (fp.leq (fp #b0 #b11101110101 #b001001000)
                arg2
                (fp #b0 #b11111110001 #b011011000)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11110111010 #b110001000)
                expect
                (fp #b0 #b00000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000001)
                expect
                (fp #b0 #b01111010110 #b000101101)))

(assert (= expect result))

(check-sat)
(exit)
