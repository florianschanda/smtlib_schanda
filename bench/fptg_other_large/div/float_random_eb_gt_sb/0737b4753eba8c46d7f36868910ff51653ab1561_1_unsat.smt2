(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10011100011 #b001)
                arg1
                (fp #b0 #b00000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000 #b010)
                arg1
                (fp #b0 #b11100000111 #b000)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01011011100 #b100)
                arg2
                (fp #b1 #b00000000000 #b101)))
(assert (fp.leq (fp #b1 #b00000000000 #b101)
                arg2
                (fp #b0 #b01001111000 #b111)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10101101000 #b111)
                expect
                (fp #b1 #b01111111101 #b100)))
(assert (fp.leq (fp #b1 #b01111111101 #b100)
                expect
                (fp #b0 #b01001011100 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
