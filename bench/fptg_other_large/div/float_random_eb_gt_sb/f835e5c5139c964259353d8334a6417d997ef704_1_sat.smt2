(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b1000000011 #b1011111)
                arg1
                (fp #b0 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b0000000)
                arg1
                (fp #b0 #b1111011101 #b1100101)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010101111 #b1011010)
                arg2
                (fp #b0 #b1110101001 #b0101010)))
(assert (fp.leq (fp #b0 #b1110101001 #b0101010)
                arg2
                (fp #b0 #b1110101011 #b0100000)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101000010 #b1111111)
                expect
                (fp #b0 #b0001011100 #b1000000)))
(assert (fp.leq (fp #b0 #b0001011100 #b1000000)
                expect
                (fp #b0 #b1000000001 #b1010000)))

(assert (= expect result))

(check-sat)
(exit)
