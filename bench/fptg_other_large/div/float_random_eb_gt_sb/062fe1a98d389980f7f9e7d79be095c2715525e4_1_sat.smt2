(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0000101011000 #b011011101)
                arg1
                (fp #b0 #b1000000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b1000000000111 #b000111000)
                arg1
                (fp #b0 #b1100001100010 #b000010111)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1111100110111 #b101011110)
                arg2
                (fp #b1 #b1000000001000 #b100111000)))
(assert (fp.leq (fp #b1 #b1000000001000 #b100111000)
                arg2
                (fp #b0 #b1010110101001 #b100101001)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101000000000 #b101100000)
                expect
                (fp #b1 #b0111111111101 #b011000001)))
(assert (fp.leq (fp #b1 #b0111111111101 #b011000001)
                expect
                (fp #b1 #b0100100100010 #b110100101)))

(assert (= expect result))

(check-sat)
(exit)
