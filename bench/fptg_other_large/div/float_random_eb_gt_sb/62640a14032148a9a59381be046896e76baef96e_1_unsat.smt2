; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b010110100110 #b110101000)
                arg1
                (fp #b0 #b100100101110 #b110100101)))
(assert (fp.leq (fp #b0 #b100100101110 #b110100101)
                arg1
                (fp #b0 #b110011011011 #b000001110)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b100101000011 #b011100111)
                expect
                (fp #b0 #b011111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b000000000)
                expect
                (fp #b0 #b111011101100 #b100000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
