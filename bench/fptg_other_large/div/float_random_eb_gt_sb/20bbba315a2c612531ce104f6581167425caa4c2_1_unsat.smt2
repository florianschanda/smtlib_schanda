; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100000001000 #b00101001)
                arg1
                (fp #b0 #b000000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b000000000000 #b10100110)
                arg1
                (fp #b0 #b000100001001 #b00010001)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111010110111 #b01110000)
                arg2
                (fp #b1 #b110101111111 #b00100000)))
(assert (fp.leq (fp #b1 #b110101111111 #b00100000)
                arg2
                (fp #b0 #b001011111011 #b11101100)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011101000111 #b01001000)
                expect
                (fp #b1 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000)
                expect
                (fp #b0 #b101101110001 #b01010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
