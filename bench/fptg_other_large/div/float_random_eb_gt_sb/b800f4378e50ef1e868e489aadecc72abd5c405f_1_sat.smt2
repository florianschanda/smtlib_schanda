(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01100001011 #b001)
                arg1
                (fp #b0 #b00000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000 #b010)
                arg1
                (fp #b0 #b11100101101 #b100)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b01011000101 #b001)
                arg2
                (fp #b0 #b10000000011 #b000)))
(assert (fp.leq (fp #b0 #b10000000011 #b000)
                arg2
                (fp #b0 #b11111000101 #b001)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10111111111 #b011)
                expect
                (fp #b0 #b00000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000)
                expect
                (fp #b0 #b01001000100 #b100)))

(assert (= expect result))

(check-sat)
(exit)
