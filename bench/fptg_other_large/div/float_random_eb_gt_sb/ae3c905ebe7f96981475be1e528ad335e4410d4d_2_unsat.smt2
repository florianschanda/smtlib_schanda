; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b011111010010111 #b0001011001)
                arg1
                (fp #b1 #b010000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b0000000000)
                arg1
                (fp #b1 #b001100010111011 #b0111010000)))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b100001100101000 #b1101001001)
                arg2
                (fp #b0 #b000000000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1111111111)
                arg2
                (fp #b0 #b010101001001110 #b1101000001)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b110100101111100 #b1010111000)
                expect
                (fp #b1 #b101111111111110 #b0000000010)))
(assert (fp.leq (fp #b1 #b101111111111110 #b0000000010)
                expect
                (fp #b0 #b000010110000011 #b0101011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
