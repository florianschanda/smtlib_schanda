(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00101011110 #b111)
                arg1
                (fp #b0 #b10000101111 #b111)))
(assert (fp.leq (fp #b0 #b10000101111 #b111)
                arg1
                (fp #b0 #b11100101001 #b110)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111011011 #b101)
                arg2
                (fp #b1 #b11111011010 #b011)))
(assert (fp.leq (fp #b1 #b11111011010 #b011)
                arg2
                (fp #b0 #b00110001011 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11001110001 #b011)
                expect
                (fp #b1 #b00001010100 #b011)))
(assert (fp.leq (fp #b1 #b00001010100 #b011)
                expect
                (fp #b0 #b10110110001 #b000)))

(assert (= expect result))

(check-sat)
(exit)
