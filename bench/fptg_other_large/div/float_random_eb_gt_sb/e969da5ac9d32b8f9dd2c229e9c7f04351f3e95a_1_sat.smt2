; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b001010101011 #b01)
                arg1
                (fp #b1 #b000000000001 #b00)))
(assert (fp.leq (fp #b1 #b000000000001 #b00)
                arg1
                (fp #b0 #b101111010100 #b11)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101110100001 #b10)
                arg2
                (fp #b0 #b000000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000000 #b10)
                arg2
                (fp #b0 #b001000011001 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110110101011 #b10)
                expect
                (fp #b1 #b100000000000 #b00)))
(assert (fp.leq (fp #b1 #b100000000000 #b00)
                expect
                (fp #b0 #b000011010110 #b01)))

(assert (= expect result))

(check-sat)
(exit)
