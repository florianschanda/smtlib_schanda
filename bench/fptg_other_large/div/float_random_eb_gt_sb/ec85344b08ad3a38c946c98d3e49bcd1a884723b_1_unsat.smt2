;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b0 #b100001000100001000 #b0100111001)
                arg1
                (fp #b0 #b111111111111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0000000000)
                arg1
                (fp #b0 #b111111111111111101 #b1001010001)))

(declare-const arg2 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b111111101110001000 #b0101101101)
                arg2
                (fp #b1 #b011111111111111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b0011111110)
                arg2
                (fp #b1 #b010001110110010110 #b1101011111)))

(declare-const result (_ FloatingPoint 18 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0101110101)
                expect
                (fp #b1 #b111111111111111100 #b1001101000)))
(assert (fp.leq (fp #b1 #b111111111111111100 #b1001101000)
                expect
                (fp #b1 #b011100010100101101 #b0111001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
