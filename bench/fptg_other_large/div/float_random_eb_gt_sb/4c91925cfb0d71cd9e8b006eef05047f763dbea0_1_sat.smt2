; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101011001 #b000001)
                arg1
                (fp #b1 #b1000000101 #b011101)))
(assert (fp.leq (fp #b1 #b1000000101 #b011101)
                arg1
                (fp #b0 #b1100011110 #b001111)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1100000101 #b011100)
                arg2
                (fp #b0 #b0011111101 #b000000)))
(assert (fp.leq (fp #b0 #b0011111101 #b000000)
                arg2
                (fp #b0 #b1011100100 #b100010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111001110 #b110011)
                expect
                (fp #b1 #b1100000111 #b011101)))
(assert (fp.leq (fp #b1 #b1100000111 #b011101)
                expect
                (fp #b0 #b1001011001 #b110011)))

(assert (= expect result))

(check-sat)
(exit)
