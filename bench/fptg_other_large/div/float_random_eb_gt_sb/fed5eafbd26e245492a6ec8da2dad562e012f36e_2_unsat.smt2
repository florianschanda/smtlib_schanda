(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b010100010000101010 #b000)
                arg1
                (fp #b0 #b011111111111111111 #b100)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b100)
                arg1
                (fp #b0 #b101010110010110100 #b110)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b000010011001000000 #b010)
                arg2
                (fp #b0 #b110111110110111110 #b011)))
(assert (fp.leq (fp #b0 #b110111110110111110 #b011)
                arg2
                (fp #b0 #b111100010000010100 #b101)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b101011101001010110 #b011)
                expect
                (fp #b0 #b001000001001000000 #b001)))
(assert (fp.leq (fp #b0 #b001000001001000000 #b001)
                expect
                (fp #b0 #b101101010101111011 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
