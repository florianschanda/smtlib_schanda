(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1111100001 #b111)
                arg1
                (fp #b1 #b0000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000)
                arg1
                (fp #b0 #b1001110100 #b000)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0011001110 #b011)
                arg2
                (fp #b0 #b1111111100 #b101)))
(assert (fp.leq (fp #b0 #b1111111100 #b101)
                arg2
                (fp #b0 #b1111111110 #b101)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1000110110 #b100)
                expect
                (fp #b1 #b0000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000)
                expect
                (fp #b0 #b0110010001 #b000)))

(assert (= expect result))

(check-sat)
(exit)
