; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b110010111101010 #b0111010011)
                arg1
                (fp #b0 #b010100001010011 #b0101010000)))
(assert (fp.leq (fp #b0 #b010100001010011 #b0101010000)
                arg1
                (fp #b0 #b011110101110000 #b1001011110)))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b111100101000000 #b1100000110)
                arg2
                (fp #b1 #b000000000000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0101011111)
                arg2
                (fp #b0 #b000101100100100 #b0010100011)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b110110111001010 #b1010111100)
                expect
                (fp #b1 #b110100001010010 #b1110111111)))
(assert (fp.leq (fp #b1 #b110100001010010 #b1110111111)
                expect
                (fp #b0 #b011110010110110 #b1101100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
