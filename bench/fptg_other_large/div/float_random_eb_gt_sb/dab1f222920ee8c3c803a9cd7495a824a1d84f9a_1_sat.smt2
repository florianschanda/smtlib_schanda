(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b010000001110110000 #b01100)
                arg1
                (fp #b1 #b010000000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b010000000000000000 #b00000)
                arg1
                (fp #b0 #b010001001001101101 #b01110)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001100001111001011 #b00000)
                expect
                (fp #b0 #b000000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000)
                expect
                (fp #b0 #b110110111001000111 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
