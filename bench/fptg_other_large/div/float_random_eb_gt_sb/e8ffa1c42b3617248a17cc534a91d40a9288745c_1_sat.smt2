(assert (fp.leq (fp #b1 #b101111011011111101 #b0100100000)
                expect
                (fp #b1 #b000000000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000000000)
                expect
                (fp #b0 #b111100000010100010 #b0001100110)))

(assert (= expect result))

