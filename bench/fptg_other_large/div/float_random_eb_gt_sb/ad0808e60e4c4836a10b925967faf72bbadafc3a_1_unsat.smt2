(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0000110010 #b1)
                arg1
                (fp #b0 #b1010001000 #b0)))
(assert (fp.leq (fp #b0 #b1010001000 #b0)
                arg1
                (fp #b0 #b1100000101 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
