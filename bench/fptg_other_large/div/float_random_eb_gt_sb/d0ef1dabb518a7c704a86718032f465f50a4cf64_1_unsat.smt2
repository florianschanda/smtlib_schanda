(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110101101010 #b100)
                arg1
                (fp #b0 #b011111111111 #b000)))
(assert (fp.leq (fp #b0 #b011111111111 #b000)
                arg1
                (fp #b0 #b100000101011 #b011)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000110101010 #b011)
                expect
                (fp #b0 #b000000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000)
                expect
                (fp #b0 #b001101001001 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
