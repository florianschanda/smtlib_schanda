;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b10110001001010001 #b1101)
                arg1
                (fp #b1 #b00010000001001001 #b0001)))
(assert (fp.leq (fp #b1 #b00010000001001001 #b0001)
                arg1
                (fp #b0 #b10101011000010111 #b1100)))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b10111001011011111 #b1001)
                arg2
                (fp #b0 #b00000000000000000 #b0111)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0111)
                arg2
                (fp #b0 #b11001100011000111 #b1110)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11011010010001100 #b1111)
                expect
                (fp #b1 #b10010000001001000 #b0100)))
(assert (fp.leq (fp #b1 #b10010000001001000 #b0100)
                expect
                (fp #b0 #b00111011011110011 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
