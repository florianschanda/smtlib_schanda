(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b01000000101 #b111010000)
                arg1
                (fp #b0 #b10110110101 #b110011001)))
(assert (fp.leq (fp #b0 #b10110110101 #b110011001)
                arg1
                (fp #b0 #b11110011110 #b111100010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11101011011 #b010100110)
                arg2
                (fp #b1 #b00000000001 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b000000000)
                arg2
                (fp #b0 #b10110001100 #b100100111)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111111111 #b000000000)
                expect
                (fp #b1 #b11111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b111111111)
                expect
                (fp #b1 #b10101110110 #b000011101)))

(assert (= expect result))

(check-sat)
(exit)
