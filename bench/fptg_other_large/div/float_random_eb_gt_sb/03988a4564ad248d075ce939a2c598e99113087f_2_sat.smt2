; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b00101110111110 #b110111010100)
                arg1
                (fp #b0 #b11110101011100 #b001000000000)))
(assert (fp.leq (fp #b0 #b11110101011100 #b001000000000)
                arg1
                (fp #b0 #b11111110001000 #b100100101011)))

(declare-const arg2 (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b10100101100010 #b111110000100)
                arg2
                (fp #b1 #b00111111111010 #b000000000000)))
(assert (fp.leq (fp #b1 #b00111111111010 #b000000000000)
                arg2
                (fp #b0 #b11010011000011 #b111001011001)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
