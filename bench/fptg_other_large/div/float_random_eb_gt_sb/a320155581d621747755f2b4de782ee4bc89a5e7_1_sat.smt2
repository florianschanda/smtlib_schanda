(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b10000000100000100 #b00000)
                arg1
                (fp #b1 #b00000000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00000)
                arg1
                (fp #b0 #b10001100101110100 #b00010)))

(declare-const arg2 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b01100110111110100 #b10010)
                arg2
                (fp #b1 #b00000000000000000 #b00001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00001)
                arg2
                (fp #b0 #b00000011111000011 #b01000)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11110011010110001 #b01011)
                expect
                (fp #b0 #b00000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00000)
                expect
                (fp #b0 #b10010110010110011 #b00100)))

(assert (= expect result))

(check-sat)
(exit)
