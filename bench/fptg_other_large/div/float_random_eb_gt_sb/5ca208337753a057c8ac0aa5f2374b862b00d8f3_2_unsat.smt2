; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b01111001110110110 #b011001)
                arg1
                (fp #b1 #b01000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b01000000000000000 #b000000)
                arg1
                (fp #b1 #b00011001110110101 #b111011)))

(declare-const arg2 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b10011001000101011 #b111100)
                arg2
                (fp #b1 #b10000000000000000 #b100000)))
(assert (fp.leq (fp #b1 #b10000000000000000 #b100000)
                arg2
                (fp #b0 #b01111100000000011 #b111001)))

(declare-const result (_ FloatingPoint 17 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b00111000111111111 #b111111)
                expect
                (fp #b0 #b00111111111111110 #b010110)))
(assert (fp.leq (fp #b0 #b00111111111111110 #b010110)
                expect
                (fp #b0 #b10000111111111111 #b010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
