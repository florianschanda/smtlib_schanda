(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000)
                arg1
                (fp #b1 #b11111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111)
                arg1
                (fp #b0 #b00001010101010 #b1111)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b0 #b01101111011111 #b0101)
                arg2
                (fp #b0 #b10010111111111 #b0110)))
(assert (fp.leq (fp #b0 #b10010111111111 #b0110)
                arg2
                (fp #b0 #b10110001110110 #b1011)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11110110101101 #b0101)
                expect
                (fp #b1 #b11100111111110 #b0110)))
(assert (fp.leq (fp #b1 #b11100111111110 #b0110)
                expect
                (fp #b0 #b01011011110010 #b1001)))

(assert (= expect result))

(check-sat)
(exit)
