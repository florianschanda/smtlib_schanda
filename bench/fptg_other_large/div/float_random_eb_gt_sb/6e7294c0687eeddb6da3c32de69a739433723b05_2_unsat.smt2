; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b10010000100011000 #b01000001110)
                arg1
                (fp #b1 #b10000011011111100 #b00010100110)))
(assert (fp.leq (fp #b1 #b10000011011111100 #b00010100110)
                arg1
                (fp #b1 #b00100101010001110 #b00101101010)))

(declare-const arg2 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b01010101001100111 #b10101111011)
                arg2
                (fp #b1 #b00000000000000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b00000000000000001 #b00000000000)
                arg2
                (fp #b0 #b10001000000100101 #b11010011101)))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
