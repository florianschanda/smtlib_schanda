; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b01111110100010 #b1111011100)
                arg1
                (fp #b0 #b01111111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0000000000)
                arg1
                (fp #b0 #b11100001011001 #b0111100110)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b01101101001010 #b0110101010)
                arg2
                (fp #b0 #b00000000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1110100111)
                arg2
                (fp #b0 #b11010000011101 #b1111000000)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b0 #b01110111011010 #b1000010011)
                expect
                (fp #b0 #b11111111111101 #b0001100010)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0001100010)
                expect
                (fp #b0 #b11111111111110 #b0010011001)))

(assert (= expect result))

(check-sat)
(exit)
