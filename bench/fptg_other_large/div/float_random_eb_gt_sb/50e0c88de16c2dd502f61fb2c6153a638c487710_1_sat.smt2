(assert (fp.leq (fp #b0 #b101011111010011000 #b1100)
                arg2
                (fp #b0 #b111100111110010110 #b0010)))

(declare-const result (_ FloatingPoint 18 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001101100100111011 #b1101)
                expect
                (fp #b1 #b000000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000)
                expect
                (fp #b0 #b110110001001011001 #b0001)))

(assert (= expect result))

(check-sat)
