                (fp #b0 #b0000000000000001 #b00000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b00000000000000)
                arg2
                (fp #b0 #b0110101100010000 #b01001101100001)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0101010111011110 #b00001110001110)
                expect
                (fp #b0 #b0000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000000000)
                expect
                (fp #b0 #b1100001001110100 #b10101010000110)))

(assert (= expect result))

(check-sat)
(exit)
