; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111111111111 #b00)
                arg1
                (fp #b1 #b11111111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11)
                arg1
                (fp #b0 #b11010001000101 #b10)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11010111110001 #b00)
                arg2
                (fp #b1 #b01111001100111 #b10)))
(assert (fp.leq (fp #b1 #b01111001100111 #b10)
                arg2
                (fp #b0 #b00111010010111 #b01)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
