(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0111110000101010 #b1100110)
                arg1
                (fp #b1 #b0000000000000000 #b0111101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0111101)
                arg1
                (fp #b0 #b1011100011100101 #b1010111)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1000010110110001 #b0010100)
                arg2
                (fp #b1 #b0111111111111111 #b0001101)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b0001101)
                arg2
                (fp #b0 #b1110001011101001 #b0100010)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0100110001110111 #b1100100)
                expect
                (fp #b0 #b0000000000000000 #b0111000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0111000)
                expect
                (fp #b0 #b0101001111000110 #b1101011)))

(assert (= expect result))

(check-sat)
(exit)
