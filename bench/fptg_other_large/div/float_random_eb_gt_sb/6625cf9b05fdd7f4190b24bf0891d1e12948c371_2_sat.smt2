(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11011010101 #b110101110)
                arg1
                (fp #b1 #b01000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b000000000)
                arg1
                (fp #b0 #b00111001100 #b000000011)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01111101101 #b101000000)
                arg2
                (fp #b1 #b00000000000 #b111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b111111111)
                arg2
                (fp #b0 #b11111010011 #b111000100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01000001101 #b010001111)
                expect
                (fp #b0 #b10111111110 #b000000010)))
(assert (fp.leq (fp #b0 #b10111111110 #b000000010)
                expect
                (fp #b0 #b11101010001 #b001100010)))

(assert (= expect result))

(check-sat)
(exit)
