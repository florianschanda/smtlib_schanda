(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010110110 #b0101110)
                arg1
                (fp #b1 #b000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000001 #b0000000)
                arg1
                (fp #b0 #b101011101 #b1111100)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000101011 #b0001000)
                arg2
                (fp #b0 #b100000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000111 #b0000000)
                arg2
                (fp #b0 #b111111000 #b0000010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001111001 #b0000110)
                expect
                (fp #b1 #b000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000000)
                expect
                (fp #b0 #b011011011 #b1011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
