; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b010001111110110111 #b011111010110000)
                arg1
                (fp #b1 #b000000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b000000000000001)
                arg1
                (fp #b0 #b110100001011111011 #b011110111110100)))

(declare-const arg2 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b100101110000000011 #b110110011100100)
                arg2
                (fp #b1 #b100000000000001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b100000000000001110 #b110110100010101)
                arg2
                (fp #b0 #b101100000111110101 #b110011110011010)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b010011010001110100 #b011110101101010)
                expect
                (fp #b0 #b000000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b000000000000001)
                expect
                (fp #b0 #b110010110010011111 #b110001100101000)))

(assert (= expect result))

(check-sat)
(exit)
