(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10101101110011 #b0010110)
                arg1
                (fp #b1 #b01111111111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0000000)
                arg1
                (fp #b0 #b10000001101110 #b0001001)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11011101011101 #b0001111)
                arg2
                (fp #b1 #b01111111111111 #b0001101)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0001101)
                arg2
                (fp #b0 #b01001001101000 #b1010011)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11001111110111 #b1110111)
                expect
                (fp #b0 #b01111111111110 #b1101001)))
(assert (fp.leq (fp #b0 #b01111111111110 #b1101001)
                expect
                (fp #b0 #b11010101100110 #b1011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
