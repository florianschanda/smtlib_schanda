(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b0 #b0100110001101101 #b0011100000)
                arg1
                (fp #b0 #b1011111111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b1111111111)
                arg1
                (fp #b0 #b1100111100011110 #b0101011000)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0000101101101001 #b1010100111)
                arg2
                (fp #b1 #b0000000000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000001)
                arg2
                (fp #b0 #b0011010011101100 #b1111001011)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
