(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010001010 #b0110100)
                arg1
                (fp #b0 #b0001010110 #b1010011)))
(assert (fp.leq (fp #b0 #b0001010110 #b1010011)
                arg1
                (fp #b0 #b0101000100 #b0110011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110011110 #b0110111)
                arg2
                (fp #b1 #b0000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000011)
                arg2
                (fp #b0 #b0101101001 #b0011010)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111001000 #b0000010)
                expect
                (fp #b1 #b1001011010 #b0001101)))
(assert (fp.leq (fp #b1 #b1001011010 #b0001101)
                expect
                (fp #b1 #b0100101001 #b1010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
