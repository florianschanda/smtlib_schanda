(assert (fp.leq (fp #b1 #b1101111100000 #b100000)
                expect
                (fp #b1 #b0000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000000)
                expect
                (fp #b0 #b1110011110101 #b011101)))

(assert (= expect result))

(check-sat)
