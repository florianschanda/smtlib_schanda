; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1110000100111 #b101111111)
                arg1
                (fp #b1 #b1101111000101 #b110101000)))
(assert (fp.leq (fp #b1 #b1101111000101 #b110101000)
                arg1
                (fp #b1 #b1010010100101 #b000101100)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1000010000010 #b101110111)
                arg2
                (fp #b1 #b0000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b010000000)
                arg2
                (fp #b0 #b1011101000001 #b111000010)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b0 #b0001111000100 #b001100001)
                expect
                (fp #b0 #b1111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111111111)
                expect
                (fp #b0 #b1111111111111 #b000000000)))

(assert (= expect result))

(check-sat)
(exit)
