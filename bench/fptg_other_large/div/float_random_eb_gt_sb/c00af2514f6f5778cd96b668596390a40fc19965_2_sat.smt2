(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101100101 #b1000100)
                arg1
                (fp #b1 #b100010011 #b1011010)))
(assert (fp.leq (fp #b1 #b100010011 #b1011010)
                arg1
                (fp #b0 #b101111111 #b1010010)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111110010 #b0000101)
                arg2
                (fp #b0 #b000000000 #b1111111)))
(assert (fp.leq (fp #b0 #b000000000 #b1111111)
                arg2
                (fp #b0 #b111001011 #b0001001)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
