(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b0 #b100110010000 #b00010)
                arg1
                (fp #b0 #b111011101000 #b01001)))
(assert (fp.leq (fp #b0 #b111011101000 #b01001)
                arg1
                (fp #b0 #b111100111010 #b11010)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111111111 #b00000)
                arg2
                (fp #b1 #b111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111)
                arg2
                (fp #b0 #b110001111101 #b01001)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b110101110111 #b01100)
                expect
                (fp #b1 #b011011101000 #b01010)))
(assert (fp.leq (fp #b1 #b011011101000 #b01010)
                expect
                (fp #b1 #b001011010011 #b10101)))

(assert (not (= expect result)))

(check-sat)
(exit)
