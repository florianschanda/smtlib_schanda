; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b10001101101110 #b11)
                arg1
                (fp #b0 #b10111111111110 #b11)))
(assert (fp.leq (fp #b0 #b10111111111110 #b11)
                arg1
                (fp #b0 #b11010101101001 #b01)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10110011010000 #b01)
                expect
                (fp #b0 #b00000000000000 #b00)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00)
                expect
                (fp #b0 #b11100110011000 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
