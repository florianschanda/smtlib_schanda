(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110001111100 #b111)
                arg1
                (fp #b1 #b011111111111 #b000)))
(assert (fp.leq (fp #b1 #b011111111111 #b000)
                arg1
                (fp #b0 #b010011111111 #b010)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101101010100 #b000)
                arg2
                (fp #b0 #b010101110101 #b111)))
(assert (fp.leq (fp #b0 #b010101110101 #b111)
                arg2
                (fp #b0 #b110000111100 #b110)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110100011001 #b100)
                expect
                (fp #b1 #b101010001000 #b001)))
(assert (fp.leq (fp #b1 #b101010001000 #b001)
                expect
                (fp #b1 #b011110001000 #b011)))

(assert (= expect result))

(check-sat)
(exit)
