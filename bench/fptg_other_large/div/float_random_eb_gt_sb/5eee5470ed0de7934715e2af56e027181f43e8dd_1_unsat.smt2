                arg2
                (fp #b0 #b000011010110010 #b1101110100000)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b100010000011100 #b1110001010000)
                expect
                (fp #b0 #b011111111111111 #b0011010000011)))
(assert (fp.leq (fp #b0 #b011111111111111 #b0011010000011)
                expect
                (fp #b0 #b100010101110101 #b0100110101001)))

(assert (not (= expect result)))

