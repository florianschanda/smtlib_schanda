(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b001001000101 #b011101110)
                arg1
                (fp #b0 #b000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000000000)
                arg1
                (fp #b0 #b111111111000 #b010011110)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b0 #b010001010000 #b001001000)
                arg2
                (fp #b0 #b101111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b111111111)
                arg2
                (fp #b0 #b111100111110 #b111111010)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011100111000 #b110001101)
                expect
                (fp #b0 #b000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000000000)
                expect
                (fp #b0 #b110000110001 #b101010010)))

(assert (= expect result))

(check-sat)
(exit)
