(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1000000100011000 #b00)
                arg1
                (fp #b0 #b0000000000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b10)
                arg1
                (fp #b0 #b1101000100101111 #b01)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1111111011100101 #b10)
                arg2
                (fp #b1 #b1000000000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000000000010 #b00)
                arg2
                (fp #b0 #b1110001101111110 #b10)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1000111001111101 #b01)
                expect
                (fp #b1 #b0000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01)
                expect
                (fp #b0 #b1100001011100101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
