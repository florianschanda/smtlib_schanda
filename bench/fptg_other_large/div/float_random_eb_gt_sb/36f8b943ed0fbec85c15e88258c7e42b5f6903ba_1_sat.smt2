(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100110110110111 #b100)
                arg1
                (fp #b0 #b011111111111111 #b000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b000)
                arg1
                (fp #b0 #b100100101000011 #b010)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110001011000101 #b010)
                arg2
                (fp #b1 #b101000010010100 #b101)))
(assert (fp.leq (fp #b1 #b101000010010100 #b101)
                arg2
                (fp #b1 #b001101000000100 #b000)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110110010010110 #b101)
                expect
                (fp #b1 #b010111101101001 #b001)))
(assert (fp.leq (fp #b1 #b010111101101001 #b001)
                expect
                (fp #b0 #b111000111011010 #b010)))

(assert (= expect result))

(check-sat)
(exit)
