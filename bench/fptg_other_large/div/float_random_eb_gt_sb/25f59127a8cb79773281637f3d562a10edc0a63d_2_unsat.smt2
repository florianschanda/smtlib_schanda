(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b00011100011011 #b101011)
                arg1
                (fp #b1 #b00000000000000 #b111111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b111111)
                arg1
                (fp #b0 #b10101010011111 #b011110)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b00001000101000 #b110011)
                arg2
                (fp #b1 #b00000000000000 #b111110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b111110)
                arg2
                (fp #b0 #b11011111010000 #b110101)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b01001110000100 #b101100)
                expect
                (fp #b0 #b01111111111111 #b000010)))
(assert (fp.leq (fp #b0 #b01111111111111 #b000010)
                expect
                (fp #b0 #b10100111100010 #b111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
