; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110100001110 #b1110101111)
                arg1
                (fp #b1 #b100010110011 #b1100100001)))
(assert (fp.leq (fp #b1 #b100010110011 #b1100100001)
                arg1
                (fp #b0 #b110101000000 #b0010101100)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111100110000 #b1111001110)
                arg2
                (fp #b1 #b100000000111 #b0011100100)))
(assert (fp.leq (fp #b1 #b100000000111 #b0011100100)
                arg2
                (fp #b0 #b011110101000 #b0101000111)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110001011011 #b1100100110)
                expect
                (fp #b0 #b100010101011 #b0111010101)))
(assert (fp.leq (fp #b0 #b100010101011 #b0111010101)
                expect
                (fp #b0 #b111011100001 #b1111110101)))

(assert (= expect result))

(check-sat)
(exit)
