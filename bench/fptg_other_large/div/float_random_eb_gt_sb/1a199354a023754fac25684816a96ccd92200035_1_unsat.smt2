; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110011010 #b10011)
                arg1
                (fp #b0 #b0111111111 #b00111)))
(assert (fp.leq (fp #b0 #b0111111111 #b00111)
                arg1
                (fp #b0 #b1000011101 #b00110)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100101010 #b00000)
                arg2
                (fp #b0 #b0111111111 #b00011)))
(assert (fp.leq (fp #b0 #b0111111111 #b00011)
                arg2
                (fp #b0 #b1101110001 #b11100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100100010 #b11111)
                expect
                (fp #b0 #b0111111111 #b00011)))
(assert (fp.leq (fp #b0 #b0111111111 #b00011)
                expect
                (fp #b0 #b1000001111 #b00010)))

(assert (not (= expect result)))

(check-sat)
(exit)
