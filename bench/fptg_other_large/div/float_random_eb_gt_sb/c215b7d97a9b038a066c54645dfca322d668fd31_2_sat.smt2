(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10111011111 #b110100110)
                arg1
                (fp #b0 #b01111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b000000000)
                arg1
                (fp #b0 #b10000100000 #b000101101)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01110000100 #b111001000)
                arg2
                (fp #b1 #b00000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000001)
                arg2
                (fp #b0 #b11001100110 #b000010111)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
