; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0111000111100111 #b110111)
                arg1
                (fp #b0 #b1101110000111100 #b001111)))
(assert (fp.leq (fp #b0 #b1101110000111100 #b001111)
                arg1
                (fp #b0 #b1110111001001011 #b111011)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b0 #b0001011110110010 #b111000)
                expect
                (fp #b0 #b0111111111111111 #b000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000000)
                expect
                (fp #b0 #b1010001101100110 #b010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
