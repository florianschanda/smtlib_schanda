(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110010010011000 #b0010)
                arg1
                (fp #b0 #b000000000000001 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b0000)
                arg1
                (fp #b0 #b110011011010101 #b0101)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b100010110010001 #b1111)
                arg2
                (fp #b1 #b000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000)
                arg2
                (fp #b0 #b101101001011101 #b0111)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
