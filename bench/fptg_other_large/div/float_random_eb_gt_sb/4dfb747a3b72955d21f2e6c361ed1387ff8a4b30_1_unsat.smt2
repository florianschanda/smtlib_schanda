(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0100111010 #b00)
                arg1
                (fp #b0 #b0000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000 #b01)
                arg1
                (fp #b0 #b0011000110 #b01)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110000101 #b11)
                arg2
                (fp #b1 #b0111111111 #b10)))
(assert (fp.leq (fp #b1 #b0111111111 #b10)
                arg2
                (fp #b0 #b0100010010 #b11)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1000111100 #b11)
                expect
                (fp #b1 #b0000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000 #b00)
                expect
                (fp #b0 #b1011101110 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
