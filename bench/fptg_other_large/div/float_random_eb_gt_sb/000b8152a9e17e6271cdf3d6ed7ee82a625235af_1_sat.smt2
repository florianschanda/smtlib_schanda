; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1111011000001 #b11010010)
                arg1
                (fp #b1 #b1001111101011 #b00010110)))
(assert (fp.leq (fp #b1 #b1001111101011 #b00010110)
                arg1
                (fp #b0 #b1000000101010 #b00111110)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1011111101000 #b11111001)
                expect
                (fp #b1 #b0111111111111 #b00000000)))
(assert (fp.leq (fp #b1 #b0111111111111 #b00000000)
                expect
                (fp #b0 #b0010100101010 #b10001110)))

(assert (= expect result))

(check-sat)
(exit)
