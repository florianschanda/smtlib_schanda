; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1010101000111100 #b1011100000)
                arg1
                (fp #b1 #b0001010010101011 #b1010100111)))
(assert (fp.leq (fp #b1 #b0001010010101011 #b1010100111)
                arg1
                (fp #b0 #b1111010001001001 #b1000001011)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b0 #b0000001100010011 #b1111010000)
                arg2
                (fp #b0 #b1011010000000011 #b1011100010)))
(assert (fp.leq (fp #b0 #b1011010000000011 #b1011100010)
                arg2
                (fp #b0 #b1101111111011110 #b1110100000)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0000001100110101 #b0010110101)
                expect
                (fp #b1 #b0000000000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000001)
                expect
                (fp #b0 #b1100100110000001 #b1111011011)))

(assert (= expect result))

(check-sat)
(exit)
