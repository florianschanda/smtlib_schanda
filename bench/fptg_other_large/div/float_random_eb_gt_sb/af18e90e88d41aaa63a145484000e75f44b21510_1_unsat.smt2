; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b00101100010 #b01011)
                arg1
                (fp #b0 #b10101110000 #b00100)))
(assert (fp.leq (fp #b0 #b10101110000 #b00100)
                arg1
                (fp #b0 #b10111011111 #b00110)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00110100011 #b11110)
                arg2
                (fp #b0 #b00010101001 #b11001)))
(assert (fp.leq (fp #b0 #b00010101001 #b11001)
                arg2
                (fp #b0 #b10000100010 #b00000)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11011110101 #b10000)
                expect
                (fp #b0 #b11111111110 #b11111)))
(assert (fp.leq (fp #b0 #b11111111110 #b11111)
                expect
                (fp #b0 #b11111111111 #b00000)))

(assert (not (= expect result)))

(check-sat)
(exit)
