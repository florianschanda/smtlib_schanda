(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0011010001 #b01001)
                arg1
                (fp #b0 #b1110001110 #b10110)))
(assert (fp.leq (fp #b0 #b1110001110 #b10110)
                arg1
                (fp #b0 #b1110010011 #b01111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0001011111 #b11110)
                arg2
                (fp #b0 #b0111111111 #b11010)))
(assert (fp.leq (fp #b0 #b0111111111 #b11010)
                arg2
                (fp #b0 #b1010100110 #b11101)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101010001 #b01110)
                expect
                (fp #b0 #b1110001101 #b11100)))
(assert (fp.leq (fp #b0 #b1110001101 #b11100)
                expect
                (fp #b0 #b1111011011 #b00111)))

(assert (= expect result))

(check-sat)
(exit)
