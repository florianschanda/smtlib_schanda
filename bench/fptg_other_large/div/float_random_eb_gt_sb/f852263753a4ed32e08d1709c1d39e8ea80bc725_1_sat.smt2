; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b0111010100100101 #b101000100010)
                arg1
                (fp #b1 #b0100000000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b000000000000)
                arg1
                (fp #b0 #b1111010111101111 #b000100011001)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1001001110101110 #b000011011011)
                expect
                (fp #b1 #b0000000000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000)
                expect
                (fp #b0 #b0001101100011111 #b110100110000)))

(assert (= expect result))

(check-sat)
(exit)
