(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b00001000101110101 #b00)
                arg1
                (fp #b0 #b00010101110110110 #b01)))
(assert (fp.leq (fp #b0 #b00010101110110110 #b01)
                arg1
                (fp #b0 #b10011111011000100 #b01)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10111011110110100 #b11)
                arg2
                (fp #b1 #b10000000000000001 #b10)))
(assert (fp.leq (fp #b1 #b10000000000000001 #b10)
                arg2
                (fp #b1 #b01011010000011001 #b00)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11111010001110111 #b01)
                expect
                (fp #b1 #b00010101110110011 #b11)))
(assert (fp.leq (fp #b1 #b00010101110110011 #b11)
                expect
                (fp #b0 #b00101110101111011 #b10)))

(assert (= expect result))

(check-sat)
(exit)
