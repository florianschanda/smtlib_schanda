(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b0 #b010101011001 #b0)
                arg1
                (fp #b0 #b011111111111 #b0)))
(assert (fp.leq (fp #b0 #b011111111111 #b0)
                arg1
                (fp #b0 #b100010100001 #b1)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b101001000101 #b1)
                arg2
                (fp #b0 #b101001100011 #b1)))
(assert (fp.leq (fp #b0 #b101001100011 #b1)
                arg2
                (fp #b0 #b111100101001 #b1)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b101110100100 #b1)
                expect
                (fp #b0 #b010110011010 #b0)))
(assert (fp.leq (fp #b0 #b010110011010 #b0)
                expect
                (fp #b0 #b100001011011 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
