(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0011100001100111 #b00000101111)
                arg1
                (fp #b0 #b0100000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b00000000000)
                arg1
                (fp #b0 #b1001110000001110 #b11011011001)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b1001000111111000 #b11010100010)
                arg2
                (fp #b0 #b1111111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111111)
                arg2
                (fp #b0 #b1111111111111111 #b00000000000)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1011100100111000 #b01111001101)
                expect
                (fp #b0 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000000)
                expect
                (fp #b0 #b0101010101010010 #b10101111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
