(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b010011100101001001 #b10011000)
                arg2
                (fp #b1 #b000000000000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b01000000)
                arg2
                (fp #b0 #b010001011000110110 #b00111101)))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
