(assert (fp.leq (fp #b1 #b0001000000011 #b10011000)
                expect
                (fp #b1 #b0000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00000000)
                expect
                (fp #b0 #b1000100100110 #b10100010)))

(assert (not (= expect result)))

