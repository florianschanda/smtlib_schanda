(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1000011110010 #b1111100001)
                arg1
                (fp #b0 #b1000110101100 #b0001000000)))
(assert (fp.leq (fp #b0 #b1000110101100 #b0001000000)
                arg1
                (fp #b0 #b1110000101000 #b0100110000)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1010001111010 #b1111110100)
                expect
                (fp #b0 #b0111111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0000000000)
                expect
                (fp #b0 #b1101110010001 #b1101110001)))

(assert (= expect result))

(check-sat)
(exit)
