; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b01010010010001 #b1110110)
                arg1
                (fp #b0 #b11100100110000 #b0100011)))
(assert (fp.leq (fp #b0 #b11100100110000 #b0100011)
                arg1
                (fp #b0 #b11111011010110 #b0010101)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10000000111011 #b1010010)
                arg2
                (fp #b1 #b01110111011010 #b1011101)))
(assert (fp.leq (fp #b1 #b01110111011010 #b1011101)
                arg2
                (fp #b0 #b10101000111110 #b1101101)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11110010000110 #b0001110)
                expect
                (fp #b1 #b11101101010100 #b0111101)))
(assert (fp.leq (fp #b1 #b11101101010100 #b0111101)
                expect
                (fp #b1 #b10110110110100 #b1011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
