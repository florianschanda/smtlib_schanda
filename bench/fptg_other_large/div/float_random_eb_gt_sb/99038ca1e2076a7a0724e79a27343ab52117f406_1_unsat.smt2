; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111111 #b000000)
                arg1
                (fp #b1 #b111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111111)
                arg1
                (fp #b1 #b010111001011000 #b111001)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b010001101000101 #b111110)
                arg2
                (fp #b0 #b000000000000001 #b000000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b000000)
                arg2
                (fp #b0 #b100110000111011 #b001010)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111111111111111 #b000000)
                expect
                (fp #b1 #b111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111111)
                expect
                (fp #b1 #b000000111001000 #b011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
