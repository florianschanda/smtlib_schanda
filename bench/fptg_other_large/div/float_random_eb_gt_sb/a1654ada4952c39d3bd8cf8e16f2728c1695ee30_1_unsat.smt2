(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0010100110010011 #b111111)
                arg1
                (fp #b1 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000)
                arg1
                (fp #b0 #b0001010101011000 #b110100)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0101000011111110 #b101011)
                expect
                (fp #b1 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000)
                expect
                (fp #b0 #b0100100100010000 #b001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
