(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1101111100111 #b0011)
                arg1
                (fp #b0 #b1110101110110 #b1011)))
(assert (fp.leq (fp #b0 #b1110101110110 #b1011)
                arg1
                (fp #b0 #b1111000110111 #b0010)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1000010001100 #b1011)
                arg2
                (fp #b1 #b0111111111111 #b0110)))
(assert (fp.leq (fp #b1 #b0111111111111 #b0110)
                arg2
                (fp #b1 #b0100011110001 #b0111)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1111011010001 #b0110)
                expect
                (fp #b1 #b1110101110110 #b0100)))
(assert (fp.leq (fp #b1 #b1110101110110 #b0100)
                expect
                (fp #b0 #b0101110000011 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
