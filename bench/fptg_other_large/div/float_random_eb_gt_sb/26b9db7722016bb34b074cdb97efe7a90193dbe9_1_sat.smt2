(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00111010111 #b100011000)
                arg1
                (fp #b0 #b10000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b10000000111 #b000111000)
                arg1
                (fp #b0 #b10011100010 #b011111110)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01000000111 #b010010100)
                expect
                (fp #b1 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000000)
                expect
                (fp #b0 #b01000110100 #b010010000)))

(assert (= expect result))

(check-sat)
(exit)
