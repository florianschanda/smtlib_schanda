(assert (fp.leq (fp #b1 #b00111111111010 #b01101010000)
                arg2
                (fp #b0 #b11110110010001 #b10100000011)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b01010101101011 #b10111000100)
                expect
                (fp #b0 #b00111111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b00111111111010 #b01101010000)
                expect
                (fp #b0 #b01110101110000 #b00111100110)))

(assert (not (= expect result)))

(check-sat)
