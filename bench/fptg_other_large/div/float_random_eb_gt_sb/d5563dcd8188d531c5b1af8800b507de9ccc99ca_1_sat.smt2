(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101100111000110 #b00100)
                arg1
                (fp #b1 #b001111111111101 #b01101)))
(assert (fp.leq (fp #b1 #b001111111111101 #b01101)
                arg1
                (fp #b0 #b000011111101111 #b11001)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
