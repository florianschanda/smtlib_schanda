; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b010011101 #b0)
                arg1
                (fp #b0 #b100101001 #b1)))
(assert (fp.leq (fp #b0 #b100101001 #b1)
                arg1
                (fp #b0 #b111111000 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b001100110 #b0)
                arg2
                (fp #b0 #b111010011 #b1)))
(assert (fp.leq (fp #b0 #b111010011 #b1)
                arg2
                (fp #b0 #b111101111 #b0)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001101110 #b0)
                expect
                (fp #b0 #b001010101 #b0)))
(assert (fp.leq (fp #b0 #b001010101 #b0)
                expect
                (fp #b0 #b010111010 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
