(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111110100 #b000)
                arg1
                (fp #b1 #b100011111 #b011)))
(assert (fp.leq (fp #b1 #b100011111 #b011)
                arg1
                (fp #b1 #b001001111 #b011)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111001 #b000)
                arg2
                (fp #b1 #b111111000 #b110)))
(assert (fp.leq (fp #b1 #b111111000 #b110)
                arg2
                (fp #b0 #b010100110 #b101)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000011100 #b001)
                expect
                (fp #b0 #b000100101 #b100)))
(assert (fp.leq (fp #b0 #b000100101 #b100)
                expect
                (fp #b0 #b001010110 #b001)))

(assert (= expect result))

(check-sat)
(exit)
