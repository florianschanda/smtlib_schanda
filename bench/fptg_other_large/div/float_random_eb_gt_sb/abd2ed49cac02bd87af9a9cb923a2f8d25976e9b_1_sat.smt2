(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011010101 #b11010)
                arg1
                (fp #b0 #b1000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000101 #b00000)
                arg1
                (fp #b0 #b1001001001 #b00111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001100000 #b11011)
                arg2
                (fp #b0 #b0000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00001)
                arg2
                (fp #b0 #b1110001111 #b01010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b1010111000 #b00100)
                expect
                (fp #b0 #b1111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111)
                expect
                (fp #b0 #b1111111111 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
