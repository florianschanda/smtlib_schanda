(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010100011010 #b01001010)
                arg1
                (fp #b0 #b000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000001)
                arg1
                (fp #b0 #b110001000100 #b00110001)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b011111100011 #b01111111)
                arg2
                (fp #b0 #b100000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100000001000 #b00000000)
                arg2
                (fp #b0 #b101010110010 #b11010100)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011000100000 #b01011111)
                expect
                (fp #b0 #b000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000001)
                expect
                (fp #b0 #b010000111100 #b01000010)))

(assert (= expect result))

(check-sat)
(exit)
