; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110100111 #b111001)
                arg1
                (fp #b1 #b000000000 #b111111)))
(assert (fp.leq (fp #b1 #b000000000 #b111111)
                arg1
                (fp #b0 #b000110010 #b100110)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111110101 #b011010)
                arg2
                (fp #b1 #b100110001 #b110001)))
(assert (fp.leq (fp #b1 #b100110001 #b110001)
                arg2
                (fp #b1 #b010100010 #b111011)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111011101 #b111010)
                expect
                (fp #b0 #b000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000)
                expect
                (fp #b0 #b011010010 #b010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
