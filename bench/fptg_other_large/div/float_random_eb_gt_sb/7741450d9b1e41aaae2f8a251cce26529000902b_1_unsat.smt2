(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0001100010 #b11100)
                arg1
                (fp #b0 #b0011111101 #b01101)))
(assert (fp.leq (fp #b0 #b0011111101 #b01101)
                arg1
                (fp #b0 #b0111011101 #b11001)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100110101 #b11011)
                arg2
                (fp #b1 #b0111111111 #b00110)))
(assert (fp.leq (fp #b1 #b0111111111 #b00110)
                arg2
                (fp #b1 #b0101001001 #b10100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111001001 #b00111)
                expect
                (fp #b1 #b0011111101 #b00101)))
(assert (fp.leq (fp #b1 #b0011111101 #b00101)
                expect
                (fp #b0 #b1000011100 #b01111)))

(assert (not (= expect result)))

(check-sat)
(exit)
