; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110000111001 #b010000011)
                arg1
                (fp #b1 #b100000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b100000001000 #b011100001)
                arg1
                (fp #b0 #b111000101011 #b101101010)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111001001010 #b001000001)
                arg2
                (fp #b1 #b000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b010000000)
                arg2
                (fp #b0 #b110010100111 #b011000010)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b0 #b111110110100 #b001010111)
                expect
                (fp #b0 #b111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111111111)
                expect
                (fp #b0 #b111111111111 #b000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
