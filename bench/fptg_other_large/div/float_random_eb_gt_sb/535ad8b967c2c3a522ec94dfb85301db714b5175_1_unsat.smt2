;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b00110001001000 #b0100100)
                arg1
                (fp #b0 #b00111111111100 #b0110101)))
(assert (fp.leq (fp #b0 #b00111111111100 #b0110101)
