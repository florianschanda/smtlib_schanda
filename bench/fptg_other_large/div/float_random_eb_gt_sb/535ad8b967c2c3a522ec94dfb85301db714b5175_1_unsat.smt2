                (fp #b0 #b10111111110011 #b1011011)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10101101110111 #b1011101)
                arg2
                (fp #b1 #b00000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000001 #b0000000)
                arg2
                (fp #b0 #b00000010010011 #b0000010)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11011111101011 #b1000010)
                expect
                (fp #b1 #b10111111111010 #b0110101)))
(assert (fp.leq (fp #b1 #b10111111111010 #b0110101)
                expect
                (fp #b0 #b01101010110101 #b0001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
