(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001111001 #b001)
                arg1
                (fp #b0 #b0010011110 #b111)))
(assert (fp.leq (fp #b0 #b0010011110 #b111)
                arg1
                (fp #b0 #b0111101000 #b101)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0101001111 #b111)
                arg2
                (fp #b0 #b1111111100 #b101)))
(assert (fp.leq (fp #b0 #b1111111100 #b101)
                arg2
                (fp #b0 #b1111111101 #b111)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0110010110 #b010)
                expect
                (fp #b0 #b0000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000)
                expect
                (fp #b0 #b0010111001 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
