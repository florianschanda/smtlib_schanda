(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110101111 #b01)
                arg1
                (fp #b1 #b1010011110 #b11)))
(assert (fp.leq (fp #b1 #b1010011110 #b11)
                arg1
                (fp #b0 #b1100111101 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0101101010 #b01)
                arg2
                (fp #b1 #b0011010000 #b00)))
(assert (fp.leq (fp #b1 #b0011010000 #b00)
                arg2
                (fp #b0 #b1101000011 #b11)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b1010101010 #b01)
                expect
                (fp #b0 #b1111001101 #b11)))
(assert (fp.leq (fp #b0 #b1111001101 #b11)
                expect
                (fp #b0 #b1111101010 #b11)))

(assert (= expect result))

(check-sat)
(exit)
