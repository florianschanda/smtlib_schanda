(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000111000 #b01111)
                arg1
                (fp #b1 #b0010110100 #b00001)))
(assert (fp.leq (fp #b1 #b0010110100 #b00001)
                arg1
                (fp #b0 #b1111000010 #b01010)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101100001 #b00111)
                arg2
                (fp #b1 #b1000100100 #b11110)))
(assert (fp.leq (fp #b1 #b1000100100 #b11110)
                arg2
                (fp #b0 #b1110110010 #b00100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0101101001 #b00100)
                expect
                (fp #b0 #b0010001110 #b00010)))
(assert (fp.leq (fp #b0 #b0010001110 #b00010)
                expect
                (fp #b0 #b0101110111 #b01110)))

(assert (= expect result))

(check-sat)
(exit)
