(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0110001111 #b01)
                arg1
                (fp #b1 #b0000000000 #b11)))
(assert (fp.leq (fp #b1 #b0000000000 #b11)
                arg1
                (fp #b0 #b0110011110 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1010111010 #b10)
                arg2
                (fp #b1 #b0000000001 #b00)))
(assert (fp.leq (fp #b1 #b0000000001 #b00)
                arg2
                (fp #b0 #b1111010110 #b10)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0010111100 #b00)
                expect
                (fp #b0 #b0111111110 #b10)))
(assert (fp.leq (fp #b0 #b0111111110 #b10)
                expect
                (fp #b0 #b1111000101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
