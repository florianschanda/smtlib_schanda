;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10100101111100 #b10010)
                arg1
                (fp #b0 #b10000000000100 #b01100)))
(assert (fp.leq (fp #b0 #b10000000000100 #b01100)
