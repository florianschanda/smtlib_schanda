(assert (fp.leq (fp #b0 #b01110101100101 #b10101)
                arg2
                (fp #b0 #b10000000000011 #b00110)))
(assert (fp.leq (fp #b0 #b10000000000011 #b00110)
                arg2
                (fp #b0 #b11101100001101 #b01110)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b00011001011111 #b10000)
                expect
                (fp #b0 #b10000000000000 #b00110)))
(assert (fp.leq (fp #b0 #b10000000000000 #b00110)
                expect
                (fp #b0 #b11000010011010 #b10111)))

(assert (= expect result))

(check-sat)
(exit)
