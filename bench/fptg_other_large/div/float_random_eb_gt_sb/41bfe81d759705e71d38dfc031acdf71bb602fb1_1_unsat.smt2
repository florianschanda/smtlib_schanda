(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b001010101101101 #b1100110111101)
                arg2
                (fp #b1 #b000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000000000)
                arg2
                (fp #b0 #b001110001101001 #b1111110111110)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
