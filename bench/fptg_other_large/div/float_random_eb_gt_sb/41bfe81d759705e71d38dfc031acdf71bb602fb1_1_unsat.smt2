(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b110100110010101 #b1100011001100)
                arg1
                (fp #b1 #b010000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b0000000000000)
                arg1
