;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b100000001100100 #b0010000011)
                arg1
                (fp #b1 #b011111111111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b011111111111111 #b1111110100)
                arg1
                (fp #b1 #b000011001001100 #b0101100010)))

