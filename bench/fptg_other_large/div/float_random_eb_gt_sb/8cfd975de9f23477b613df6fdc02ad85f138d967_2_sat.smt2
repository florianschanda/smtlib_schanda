                arg2
                (fp #b1 #b011111111111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b011111111111111 #b0000100111)
                arg2
                (fp #b0 #b101100100011111 #b1010010011)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b000100010000101 #b1111100010)
                expect
                (fp #b0 #b011111111111111 #b1110101010)))
(assert (fp.leq (fp #b0 #b011111111111111 #b1110101010)
                expect
                (fp #b0 #b110011110011101 #b0111001011)))

(assert (= expect result))

(check-sat)
(exit)
