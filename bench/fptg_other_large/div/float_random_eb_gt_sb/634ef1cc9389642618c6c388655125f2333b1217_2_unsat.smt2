(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1010100100110111 #b110)
                arg1
                (fp #b0 #b0000000000000001 #b000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b000)
                arg1
                (fp #b0 #b1000111000001100 #b100)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0001011101001110 #b111)
                arg2
                (fp #b0 #b0000000000000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110)
                arg2
                (fp #b0 #b0111101101001100 #b011)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1000100110011001 #b111)
                expect
                (fp #b0 #b0111111111111111 #b011)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b011)
                expect
                (fp #b0 #b1111111100110110 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
