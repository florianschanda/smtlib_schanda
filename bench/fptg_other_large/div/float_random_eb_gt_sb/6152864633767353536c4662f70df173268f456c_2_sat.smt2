(assert (fp.leq (fp #b1 #b000100111011010110 #b11000)
                arg1
                (fp #b0 #b101001110100101010 #b11110)))
(assert (fp.leq (fp #b0 #b101001110100101010 #b11110)
                arg1
                (fp #b0 #b111000001100110001 #b01100)))

