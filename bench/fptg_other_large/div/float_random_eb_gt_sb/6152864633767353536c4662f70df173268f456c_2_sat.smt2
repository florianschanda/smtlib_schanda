                arg2
                (fp #b1 #b101000010011011111 #b00111)))
(assert (fp.leq (fp #b1 #b101000010011011111 #b00111)
                arg2
                (fp #b0 #b100011010010101010 #b10011)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b100011101001010110 #b10010)
                expect
                (fp #b1 #b100001100001001010 #b10011)))
(assert (fp.leq (fp #b1 #b100001100001001010 #b10011)
                expect
                (fp #b0 #b010101000111011101 #b01110)))

(assert (= expect result))

(check-sat)
(exit)
