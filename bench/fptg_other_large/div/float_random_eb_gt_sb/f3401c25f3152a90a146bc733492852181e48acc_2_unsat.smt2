(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101101011100 #b01)
                arg1
                (fp #b0 #b000000000001 #b00)))
(assert (fp.leq (fp #b0 #b000000000001 #b00)
                arg1
                (fp #b0 #b001000001110 #b11)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110010011101 #b00)
                arg2
                (fp #b1 #b100000000010 #b00)))
(assert (fp.leq (fp #b1 #b100000000010 #b00)
                arg2
                (fp #b0 #b100100000101 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000010001001 #b00)
                expect
                (fp #b1 #b000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000 #b01)
                expect
                (fp #b0 #b000100011000 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
