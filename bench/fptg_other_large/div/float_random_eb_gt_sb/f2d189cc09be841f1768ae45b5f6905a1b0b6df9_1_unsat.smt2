; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11100011110 #b00111011)
                arg1
                (fp #b1 #b01111111111 #b00000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b00000000)
                arg1
                (fp #b1 #b01111000110 #b01011010)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10011001100 #b01111100)
                arg2
                (fp #b1 #b10000000111 #b10010100)))
(assert (fp.leq (fp #b1 #b10000000111 #b10010100)
                arg2
                (fp #b0 #b01011011101 #b11111000)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11100001010 #b01001010)
                expect
                (fp #b0 #b01111110110 #b01000100)))
(assert (fp.leq (fp #b0 #b01111110110 #b01000100)
                expect
                (fp #b0 #b10100001010 #b01111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
