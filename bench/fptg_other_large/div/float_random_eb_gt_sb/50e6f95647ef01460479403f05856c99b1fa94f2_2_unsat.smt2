;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1100011111 #b11101100)
                arg1
                (fp #b1 #b0110011001 #b01001011)))
(assert (fp.leq (fp #b1 #b0110011001 #b01001011)
                arg1
                (fp #b1 #b0010101101 #b01110110)))

(declare-const arg2 (_ FloatingPoint 10 9))
