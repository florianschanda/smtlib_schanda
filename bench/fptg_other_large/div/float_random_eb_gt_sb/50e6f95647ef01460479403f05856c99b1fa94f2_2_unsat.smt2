                arg2
                (fp #b0 #b0111111111 #b01100111)))
(assert (fp.leq (fp #b0 #b0111111111 #b01100111)
                arg2
                (fp #b0 #b1000011110 #b01010001)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101010111 #b01010000)
                expect
                (fp #b1 #b0110011000 #b11011001)))
(assert (fp.leq (fp #b1 #b0110011000 #b11011001)
                expect
                (fp #b0 #b0011110101 #b10111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
