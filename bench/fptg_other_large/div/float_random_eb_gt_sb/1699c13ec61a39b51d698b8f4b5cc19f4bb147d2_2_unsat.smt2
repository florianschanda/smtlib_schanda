(assert (fp.leq (fp #b1 #b000000000000000 #b01111101)
                arg2
                (fp #b0 #b010110110101111 #b00010101)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b111101101010101 #b11011101)
                expect
                (fp #b1 #b101111111111011 #b00000111)))
(assert (fp.leq (fp #b1 #b101111111111011 #b00000111)
                expect
                (fp #b0 #b110010100110001 #b00011000)))

(assert (not (= expect result)))

(check-sat)
