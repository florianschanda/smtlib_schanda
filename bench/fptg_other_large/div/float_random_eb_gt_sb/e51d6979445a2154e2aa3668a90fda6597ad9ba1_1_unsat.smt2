;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11100000110111 #b00111011)
                arg1
                (fp #b1 #b01101110110011 #b01111010)))
(assert (fp.leq (fp #b1 #b01101110110011 #b01111010)
                arg1
                (fp #b0 #b10011110000010 #b10110001)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11111111111101 #b00010101)
                arg2
                (fp #b1 #b11111111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b00000000)
                arg2
                (fp #b0 #b11110111111110 #b00000110)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000010000011 #b01100001)
                expect
                (fp #b0 #b00000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000000)
                expect
                (fp #b0 #b11010111110100 #b10001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
