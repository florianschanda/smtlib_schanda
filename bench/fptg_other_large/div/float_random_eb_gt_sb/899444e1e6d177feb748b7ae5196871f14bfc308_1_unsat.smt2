(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111000010 #b1101011)
                arg1
                (fp #b1 #b110001111 #b1111011)))
(assert (fp.leq (fp #b1 #b110001111 #b1111011)
                arg1
                (fp #b0 #b010000111 #b1100110)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010001111 #b1100111)
                arg2
                (fp #b0 #b100000110 #b0000001)))
(assert (fp.leq (fp #b0 #b100000110 #b0000001)
                arg2
                (fp #b0 #b110101111 #b1100010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111100010 #b1011100)
                expect
                (fp #b1 #b110001000 #b1111001)))
(assert (fp.leq (fp #b1 #b110001000 #b1111001)
                expect
                (fp #b0 #b010001111 #b1000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
