; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b0 #b0001101000110 #b0011001)
                arg1
                (fp #b0 #b1000000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000000111 #b0000000)
                arg1
                (fp #b0 #b1011110110001 #b1010011)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111110000011 #b0110011)
                arg2
                (fp #b1 #b1111010011011 #b0001110)))
(assert (fp.leq (fp #b1 #b1111010011011 #b0001110)
                arg2
                (fp #b1 #b0111001011100 #b1000010)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0010100111000 #b1110110)
                expect
                (fp #b1 #b0000101101010 #b1100110)))
(assert (fp.leq (fp #b1 #b0000101101010 #b1100110)
                expect
                (fp #b0 #b0000100011001 #b1101011)))

(assert (= expect result))

(check-sat)
(exit)
