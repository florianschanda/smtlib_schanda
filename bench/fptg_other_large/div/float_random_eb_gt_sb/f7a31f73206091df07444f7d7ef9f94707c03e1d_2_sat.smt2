(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100111010110 #b001010)
                arg1
                (fp #b1 #b011111111111 #b000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b000000)
                arg1
                (fp #b1 #b011111000001 #b101010)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100111110010 #b100001)
                arg2
                (fp #b1 #b000000000000 #b101100)))
(assert (fp.leq (fp #b1 #b000000000000 #b101100)
                arg2
                (fp #b0 #b001001111011 #b010101)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b101000110011 #b110010)
                expect
                (fp #b0 #b111111111101 #b011110)))
(assert (fp.leq (fp #b0 #b111111111101 #b011110)
                expect
                (fp #b0 #b111111111110 #b100001)))

(assert (= expect result))

(check-sat)
(exit)
