; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b00001111001001 #b1000001011)
                arg1
                (fp #b0 #b10011100100010 #b1011110010)))
(assert (fp.leq (fp #b0 #b10011100100010 #b1011110010)
                arg1
                (fp #b0 #b11111110101001 #b1011110010)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00000010111100 #b0110001011)
                expect
                (fp #b0 #b00000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000)
                expect
                (fp #b0 #b10101111010000 #b0101011110)))

(assert (= expect result))

(check-sat)
(exit)
