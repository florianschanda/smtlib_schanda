; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101000111 #b1010110)
                arg1
                (fp #b0 #b100101000 #b1011100)))
(assert (fp.leq (fp #b0 #b100101000 #b1011100)
                arg1
                (fp #b0 #b111001101 #b0111001)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111000010 #b1001100)
                arg2
                (fp #b1 #b100000110 #b1010010)))
(assert (fp.leq (fp #b1 #b100000110 #b1010010)
                arg2
                (fp #b1 #b011001110 #b1100101)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101011101 #b0010101)
                expect
                (fp #b1 #b100100001 #b0000111)))
(assert (fp.leq (fp #b1 #b100100001 #b0000111)
                expect
                (fp #b0 #b011011110 #b1100101)))

(assert (= expect result))

(check-sat)
(exit)
