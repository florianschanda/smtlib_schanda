;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111111 #b00)
                arg1
                (fp #b1 #b11111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111110 #b11)
                arg1
                (fp #b0 #b00110011011 #b00)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111101 #b11)
                arg2
                (fp #b1 #b11111111101 #b00)))
(assert (fp.leq (fp #b1 #b11111111101 #b00)
                arg2
                (fp #b0 #b00111111000 #b01)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b01010110101 #b10)
                expect
                (fp #b0 #b10000000000 #b11)))
(assert (fp.leq (fp #b0 #b10000000000 #b11)
                expect
                (fp #b0 #b11110110011 #b11)))

(assert (= expect result))

(check-sat)
(exit)
