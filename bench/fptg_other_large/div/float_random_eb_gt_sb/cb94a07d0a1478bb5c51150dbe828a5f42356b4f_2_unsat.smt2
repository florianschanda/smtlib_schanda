(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010100100010 #b100)
                arg1
                (fp #b0 #b000000000001 #b000)))
(assert (fp.leq (fp #b0 #b000000000001 #b000)
                arg1
                (fp #b0 #b010011101010 #b100)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111101100111 #b100)
                arg2
                (fp #b1 #b100000000011 #b000)))
(assert (fp.leq (fp #b1 #b100000000011 #b000)
                arg2
                (fp #b0 #b011100101110 #b111)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010110010010 #b111)
                expect
                (fp #b1 #b000000000000 #b001)))
(assert (fp.leq (fp #b1 #b000000000000 #b001)
                expect
                (fp #b0 #b010001100100 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
