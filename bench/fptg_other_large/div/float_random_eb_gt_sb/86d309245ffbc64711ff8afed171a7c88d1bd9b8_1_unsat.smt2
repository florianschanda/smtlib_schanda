; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0101000011110 #b10)
                arg1
                (fp #b0 #b0000000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000000 #b10)
                arg1
                (fp #b0 #b1001010111001 #b11)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1101000010101 #b11)
                arg2
                (fp #b0 #b1000000000001 #b10)))
(assert (fp.leq (fp #b0 #b1000000000001 #b10)
                arg2
                (fp #b0 #b1010111000001 #b01)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0110111110111 #b01)
                expect
                (fp #b0 #b0000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00)
                expect
                (fp #b0 #b0111000001101 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
