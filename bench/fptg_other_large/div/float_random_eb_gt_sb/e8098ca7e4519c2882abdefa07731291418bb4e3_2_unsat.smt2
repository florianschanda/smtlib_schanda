;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b0111000000110110 #b010)
                arg1
                (fp #b0 #b0111111111111111 #b111)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b111)
                arg1
                (fp #b0 #b1001101010010110 #b010)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1000100001000011 #b001)
                arg2
                (fp #b1 #b0111111111111111 #b001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b001)
                arg2
                (fp #b0 #b0111010110111110 #b001)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1110111010000100 #b000)
                expect
                (fp #b1 #b0111111111111111 #b110)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110)
                expect
                (fp #b0 #b0001110111100001 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
