                expect
                (fp #b0 #b01111111111111 #b0010100010)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0010100010)
                expect
                (fp #b0 #b10110111010111 #b1000001000)))

(assert (= expect result))

