; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0110010010000010 #b110000)
                arg1
                (fp #b0 #b0111111111111111 #b000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000000)
                arg1
                (fp #b0 #b1101111011101010 #b000101)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0010110011001010 #b110001)
                arg2
                (fp #b0 #b1100000001001100 #b001011)))
(assert (fp.leq (fp #b0 #b1100000001001100 #b001011)
                arg2
                (fp #b0 #b1101101111001111 #b010001)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1100001110001001 #b011001)
                expect
                (fp #b0 #b0011111110110001 #b101101)))
(assert (fp.leq (fp #b0 #b0011111110110001 #b101101)
                expect
                (fp #b0 #b0101000111101100 #b100011)))

(assert (= expect result))

(check-sat)
(exit)
