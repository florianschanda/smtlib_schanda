(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10110011110110 #b0100)
                arg1
                (fp #b1 #b00111000110001 #b0111)))
(assert (fp.leq (fp #b1 #b00111000110001 #b0111)
                arg1
                (fp #b0 #b00000010111001 #b0001)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11100001011011 #b1110)
                arg2
                (fp #b0 #b10111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b1111)
                arg2
                (fp #b0 #b11001101111000 #b1011)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01101011000100 #b1101)
                expect
                (fp #b1 #b00000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000)
                expect
                (fp #b0 #b10000010001011 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
