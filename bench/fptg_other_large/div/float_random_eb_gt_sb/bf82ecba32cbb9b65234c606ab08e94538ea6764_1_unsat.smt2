                (fp #b1 #b1000000000000 #b10)))
(assert (fp.leq (fp #b1 #b1000000000000 #b10)
                arg2
                (fp #b1 #b0111100111101 #b00)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1011100111111 #b00)
                expect
                (fp #b1 #b0000000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00)
                expect
                (fp #b0 #b1011010001100 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
