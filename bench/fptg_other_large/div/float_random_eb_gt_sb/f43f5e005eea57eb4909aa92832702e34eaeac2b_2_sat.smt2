(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011010100 #b000011)
                arg1
                (fp #b0 #b001001101 #b011000)))
(assert (fp.leq (fp #b0 #b001001101 #b011000)
                arg1
                (fp #b0 #b101100111 #b111101)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111100010 #b111000)
                arg2
                (fp #b1 #b100110001 #b110001)))
(assert (fp.leq (fp #b1 #b100110001 #b110001)
                arg2
                (fp #b0 #b010101110 #b011000)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111010101 #b011101)
                expect
                (fp #b1 #b000011010 #b100100)))
(assert (fp.leq (fp #b1 #b000011010 #b100100)
                expect
                (fp #b0 #b111011000 #b010100)))

(assert (= expect result))

(check-sat)
(exit)
