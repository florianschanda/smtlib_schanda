; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b01001000101011 #b1101001100)
                arg1
                (fp #b0 #b00000000000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111111000)
                arg1
                (fp #b0 #b01110101110100 #b0010110001)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000000011000 #b0111011101)
                expect
                (fp #b1 #b00000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000)
                expect
                (fp #b0 #b11110010101111 #b1110110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
