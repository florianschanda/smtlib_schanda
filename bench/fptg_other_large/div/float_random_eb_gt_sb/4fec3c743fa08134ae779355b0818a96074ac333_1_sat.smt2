; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10100001101111 #b11000101)
                arg1
                (fp #b1 #b01111111111111 #b00000000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b00000000)
                arg1
                (fp #b1 #b01111001011110 #b10001011)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10010111111111 #b01001001)
                expect
                (fp #b1 #b00000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000000)
                expect
                (fp #b0 #b10011000111000 #b11101011)))

(assert (= expect result))

(check-sat)
(exit)
