(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001000000 #b0101)
                arg1
                (fp #b0 #b1000000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000000100 #b0000)
                arg1
                (fp #b0 #b1001101110 #b1010)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001100100 #b0100)
                arg2
                (fp #b1 #b1000000011 #b0001)))
(assert (fp.leq (fp #b1 #b1000000011 #b0001)
                arg2
                (fp #b0 #b0011000001 #b1001)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011100011 #b1010)
                expect
                (fp #b1 #b0111111111 #b1111)))
(assert (fp.leq (fp #b1 #b0111111111 #b1111)
                expect
                (fp #b0 #b0111111001 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
