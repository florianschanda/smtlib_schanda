(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100100110000 #b1110110100)
                arg1
                (fp #b0 #b110010010101 #b0001100011)))
(assert (fp.leq (fp #b0 #b110010010101 #b0001100011)
                arg1
                (fp #b0 #b111110111001 #b1101110101)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100011010000 #b1111000010)
                arg2
                (fp #b1 #b011111111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b011111111111 #b0011111110)
                arg2
                (fp #b0 #b100010000111 #b0001010110)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110101110100 #b1101011000)
                expect
                (fp #b1 #b110010010100 #b1100000111)))
(assert (fp.leq (fp #b1 #b110010010100 #b1100000111)
                expect
                (fp #b0 #b110111100001 #b1001010010)))

(assert (= expect result))

(check-sat)
(exit)
