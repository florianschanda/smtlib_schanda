(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111111110 #b11)
                arg1
                (fp #b1 #b1111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111101 #b00)
                arg1
                (fp #b0 #b1010001000 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1010010001 #b01)
                arg2
                (fp #b0 #b0000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000 #b01)
                arg2
                (fp #b0 #b1111100110 #b11)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111111111 #b00)
                expect
                (fp #b1 #b1111111110 #b11)))
(assert (fp.leq (fp #b1 #b1111111110 #b11)
                expect
                (fp #b1 #b0010110010 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
