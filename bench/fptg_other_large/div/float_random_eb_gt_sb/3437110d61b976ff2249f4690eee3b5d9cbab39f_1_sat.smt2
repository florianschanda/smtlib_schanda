(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1000110101 #b011010)
                arg1
                (fp #b0 #b1101111110 #b111000)))
(assert (fp.leq (fp #b0 #b1101111110 #b111000)
                arg1
                (fp #b0 #b1111100000 #b011111)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111000001 #b100100)
                arg2
                (fp #b1 #b1110101011 #b100010)))
(assert (fp.leq (fp #b1 #b1110101011 #b100010)
                arg2
                (fp #b0 #b0001001000 #b111101)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111010110 #b000000)
                expect
                (fp #b1 #b0111010010 #b001110)))
(assert (fp.leq (fp #b1 #b0111010010 #b001110)
                expect
                (fp #b0 #b0111000111 #b011110)))

(assert (= expect result))

(check-sat)
(exit)
