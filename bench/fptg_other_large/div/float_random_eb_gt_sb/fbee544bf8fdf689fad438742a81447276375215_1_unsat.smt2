(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b111110001001 #b0)
                arg1
                (fp #b1 #b100000100001 #b0)))
(assert (fp.leq (fp #b1 #b100000100001 #b0)
                arg1
                (fp #b1 #b010110000010 #b1)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b011000100110 #b0)
                arg2
                (fp #b1 #b001111111111 #b1)))
(assert (fp.leq (fp #b1 #b001111111111 #b1)
                arg2
                (fp #b0 #b011011111100 #b1)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b101000011101 #b0)
                expect
                (fp #b0 #b110000100000 #b0)))
(assert (fp.leq (fp #b0 #b110000100000 #b0)
                expect
                (fp #b0 #b110100101001 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
