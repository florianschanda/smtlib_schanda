; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b01010111000100 #b011110110011)
                arg1
                (fp #b1 #b00111111111010 #b000000000000)))
(assert (fp.leq (fp #b1 #b00111111111010 #b000000000000)
                arg1
                (fp #b0 #b10100110111011 #b101111010111)))

(declare-const arg2 (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b0 #b00101001100010 #b010101101000)
                arg2
                (fp #b0 #b10000000001000 #b110010011000)))
(assert (fp.leq (fp #b0 #b10000000001000 #b110010011000)
                arg2
                (fp #b0 #b10110011001101 #b000000000001)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b10010110110001 #b000110011100)
                expect
                (fp #b1 #b00111111110000 #b000111101000)))
(assert (fp.leq (fp #b1 #b00111111110000 #b000111101000)
                expect
                (fp #b0 #b11101100001001 #b011001101111)))

(assert (= expect result))

(check-sat)
(exit)
