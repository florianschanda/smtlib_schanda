(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11110101111 #b01011)
                arg1
                (fp #b1 #b00111111101 #b01101)))
(assert (fp.leq (fp #b1 #b00111111101 #b01101)
                arg1
                (fp #b1 #b00101110010 #b10110)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111111 #b00000)
                arg2
                (fp #b1 #b11111111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111111110 #b11111)
                arg2
                (fp #b1 #b00110000100 #b10100)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11100001110 #b11101)
                expect
                (fp #b0 #b00000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000)
                expect
                (fp #b0 #b00000111101 #b01010)))

(assert (not (= expect result)))

(check-sat)
(exit)
