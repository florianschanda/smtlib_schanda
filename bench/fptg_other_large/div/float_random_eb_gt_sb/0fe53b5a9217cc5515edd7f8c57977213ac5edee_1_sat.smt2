                (fp #b0 #b100000000000000110 #b0000001)))
(assert (fp.leq (fp #b0 #b100000000000000110 #b0000001)
                arg2
                (fp #b0 #b110101000011101010 #b0100000)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b000000001110111101 #b1111111)
                expect
                (fp #b0 #b011111111111111000 #b0101001)))
(assert (fp.leq (fp #b0 #b011111111111111000 #b0101001)
                expect
                (fp #b0 #b100011110111110010 #b0101000)))

(assert (= expect result))

(check-sat)
