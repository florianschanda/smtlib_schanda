(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0011100110100111 #b0001010)
                arg1
                (fp #b0 #b0111111111111111 #b1011110)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b1011110)
                arg1
                (fp #b0 #b1100101000010101 #b0111100)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0000111010101100 #b0101100)
                arg2
                (fp #b1 #b0000000000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000011)
                arg2
                (fp #b0 #b0101010100011000 #b1011110)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
