(assert (fp.leq (fp #b1 #b111111111110 #b1)
                arg2
                (fp #b0 #b100000101110 #b0)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b011101010001 #b0)
                expect
                (fp #b1 #b001111111111 #b0)))
(assert (fp.leq (fp #b1 #b001111111111 #b0)
                expect
                (fp #b1 #b001010000101 #b0)))

(assert (= expect result))

(check-sat)
(exit)
