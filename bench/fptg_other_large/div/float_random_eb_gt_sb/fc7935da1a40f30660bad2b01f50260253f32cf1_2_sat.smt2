; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1111101110010010 #b0011100011010)
                arg1
                (fp #b1 #b1000000000001100 #b0001100110010)))
(assert (fp.leq (fp #b1 #b1000000000001100 #b0001100110010)
                arg1
                (fp #b0 #b1100110100101000 #b0000010100110)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1001100101111101 #b0011111111010)
                arg2
                (fp #b0 #b0010001110110101 #b1001111000000)))
(assert (fp.leq (fp #b0 #b0010001110110101 #b1001111000000)
                arg2
                (fp #b0 #b1011000110000001 #b0111100101100)))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1111000010100011 #b0100010001110)
                expect
                (fp #b1 #b1101110001010101 #b0101110000111)))
(assert (fp.leq (fp #b1 #b1101110001010101 #b0101110000111)
                expect
                (fp #b1 #b0010011000110001 #b0001010110101)))

(assert (= expect result))

(check-sat)
(exit)
