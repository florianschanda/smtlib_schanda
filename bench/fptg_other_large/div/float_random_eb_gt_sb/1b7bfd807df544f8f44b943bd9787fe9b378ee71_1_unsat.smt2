(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101000110100 #b01000001)
                arg1
                (fp #b1 #b011011110110 #b01001000)))
(assert (fp.leq (fp #b1 #b011011110110 #b01001000)
                arg1
                (fp #b0 #b001111110100 #b01001000)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111111111101 #b00011100)
                arg2
                (fp #b1 #b111111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000)
                arg2
                (fp #b1 #b000011010011 #b01000110)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110001000000 #b11011101)
                expect
                (fp #b0 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000)
                expect
                (fp #b0 #b010111000000 #b00101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
