; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1000000111110001 #b00100000001111)
                arg1
                (fp #b0 #b1000000000001010 #b11100011010000)))
(assert (fp.leq (fp #b0 #b1000000000001010 #b11100011010000)
                arg1
                (fp #b0 #b1000110000110100 #b01101000001101)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1000110010001101 #b10101000110110)
                arg2
                (fp #b1 #b0000000000000001 #b00000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b00000000000000)
                arg2
                (fp #b0 #b1100110011000011 #b01110111001110)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000000000000)
                expect
                (fp #b1 #b1111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111111111111)
                expect
                (fp #b0 #b0101100111000110 #b11011000011000)))

(assert (= expect result))

(check-sat)
(exit)
