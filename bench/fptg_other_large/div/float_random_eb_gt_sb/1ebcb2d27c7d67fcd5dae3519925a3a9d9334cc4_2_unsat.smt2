;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111111110001001111 #b101111001)
                arg1
                (fp #b1 #b111110011110000011 #b010011101)))
(assert (fp.leq (fp #b1 #b111110011110000011 #b010011101)
                arg1
                (fp #b0 #b110010000111101101 #b101110010)))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b010101000111000101 #b001011110)
                arg2
                (fp #b0 #b000000000000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b100101010)
                arg2
                (fp #b0 #b001010011001011110 #b000111010)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
