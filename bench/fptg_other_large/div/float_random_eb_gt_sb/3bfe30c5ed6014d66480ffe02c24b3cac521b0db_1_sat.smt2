(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0100100011 #b00101010)
                arg1
                (fp #b0 #b0000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000001)
                arg1
                (fp #b0 #b0100110100 #b01011111)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1110000111 #b01110010)
                arg2
                (fp #b0 #b1000000111 #b01101001)))
(assert (fp.leq (fp #b0 #b1000000111 #b01101001)
                arg2
                (fp #b0 #b1111000100 #b00111100)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1110011101 #b00010100)
                expect
                (fp #b0 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000000)
                expect
                (fp #b0 #b0101111111 #b11101000)))

(assert (= expect result))

(check-sat)
(exit)
