(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11011111010000 #b10010)
                arg1
                (fp #b0 #b00000000000001 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b00000)
                arg1
                (fp #b0 #b10000100011011 #b01001)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01011111011001 #b11110)
                arg2
                (fp #b0 #b11111111111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00000)
                arg2
                (fp #b0 #b11111111111110 #b11011)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11010101000101 #b00110)
                expect
                (fp #b0 #b00000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00001)
                expect
                (fp #b0 #b11000111100001 #b11110)))

(assert (not (= expect result)))

(check-sat)
(exit)
