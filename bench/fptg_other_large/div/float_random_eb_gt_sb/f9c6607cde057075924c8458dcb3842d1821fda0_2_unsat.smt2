(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101010001 #b11)
                arg1
                (fp #b1 #b100000001 #b00)))
(assert (fp.leq (fp #b1 #b100000001 #b00)
                arg1
                (fp #b0 #b000100001 #b10)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100101010 #b10)
                arg2
                (fp #b1 #b100000000 #b10)))
(assert (fp.leq (fp #b1 #b100000000 #b10)
                arg2
                (fp #b0 #b111101111 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110011111 #b00)
                expect
                (fp #b0 #b011111111 #b10)))
(assert (fp.leq (fp #b0 #b011111111 #b10)
                expect
                (fp #b0 #b110010111 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
