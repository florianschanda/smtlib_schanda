                arg2
                (fp #b0 #b001100010010100000 #b000101000)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b110101110000000000 #b011010111)
                expect
                (fp #b0 #b011111111111110110 #b000000010)))
(assert (fp.leq (fp #b0 #b011111111111110110 #b000000010)
                expect
                (fp #b0 #b111101011001001100 #b111111111)))

(assert (not (= expect result)))

(check-sat)
