(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101010000 #b1)
                arg1
                (fp #b1 #b1000000001 #b0)))
(assert (fp.leq (fp #b1 #b1000000001 #b0)
                arg1
                (fp #b1 #b0010011011 #b0)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101001010 #b1)
                arg2
                (fp #b0 #b0000000000 #b1)))
(assert (fp.leq (fp #b0 #b0000000000 #b1)
                arg2
                (fp #b0 #b1000110100 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
