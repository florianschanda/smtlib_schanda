(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b11111110100101100 #b0)
                arg1
                (fp #b1 #b10111101000001001 #b0)))
(assert (fp.leq (fp #b1 #b10111101000001001 #b0)
                arg1
                (fp #b1 #b01010010111011101 #b0)))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b0 #b01111001101011110 #b1)
                arg2
                (fp #b0 #b10111111111111110 #b1)))
(assert (fp.leq (fp #b0 #b10111111111111110 #b1)
                arg2
                (fp #b0 #b11111101011100100 #b1)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b11110100010000001 #b0)
                expect
                (fp #b1 #b01111101000001001 #b1)))
(assert (fp.leq (fp #b1 #b01111101000001001 #b1)
                expect
                (fp #b0 #b00001000100101011 #b0)))

(assert (= expect result))

(check-sat)
(exit)
