(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0001111001 #b11111011)
                arg1
                (fp #b0 #b1000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b1000000010 #b00100000)
                arg1
                (fp #b0 #b1111100100 #b10011101)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111110100 #b11101010)
                arg2
                (fp #b1 #b1111011000 #b11001011)))
(assert (fp.leq (fp #b1 #b1111011000 #b11001011)
                arg2
                (fp #b1 #b0110110100 #b10100011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0111100111 #b10110101)
                expect
                (fp #b1 #b0000101000 #b01000010)))
(assert (fp.leq (fp #b1 #b0000101000 #b01000010)
                expect
                (fp #b1 #b0000001011 #b10001101)))

(assert (= expect result))

(check-sat)
(exit)
