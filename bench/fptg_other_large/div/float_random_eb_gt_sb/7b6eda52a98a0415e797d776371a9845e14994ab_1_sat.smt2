                (fp #b0 #b0000000000000000 #b00011110110011)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00011110110011)
                arg2
                (fp #b0 #b1100000001000011 #b00110110000111)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b0 #b0001000101010010 #b10010111101100)
                expect
                (fp #b0 #b1111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111111111)
                expect
                (fp #b0 #b1111111111111111 #b00000000000000)))

(assert (= expect result))

(check-sat)
