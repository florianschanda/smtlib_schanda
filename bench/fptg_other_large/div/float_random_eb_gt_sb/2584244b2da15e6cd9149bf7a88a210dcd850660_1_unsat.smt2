(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111111111 #b0000)
                arg1
                (fp #b1 #b111111110 #b1111)))
(assert (fp.leq (fp #b1 #b111111110 #b1111)
                arg1
                (fp #b1 #b110011010 #b0011)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111110100 #b0000)
                arg2
                (fp #b0 #b110001100 #b0100)))
(assert (fp.leq (fp #b0 #b110001100 #b0100)
                arg2
                (fp #b0 #b111001000 #b0110)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111001000 #b0111)
                expect
                (fp #b1 #b101110001 #b1000)))
(assert (fp.leq (fp #b1 #b101110001 #b1000)
                expect
                (fp #b0 #b001111100 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
