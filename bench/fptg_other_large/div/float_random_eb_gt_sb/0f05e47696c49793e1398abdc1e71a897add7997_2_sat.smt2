(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b110101010111 #b011011)
                arg1
                (fp #b0 #b011111111111 #b000100)))
(assert (fp.leq (fp #b0 #b011111111111 #b000100)
                arg1
                (fp #b0 #b100110101101 #b001000)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b010110001110 #b101110)
                arg2
                (fp #b0 #b100101010110 #b100101)))
(assert (fp.leq (fp #b0 #b100101010110 #b100101)
                arg2
                (fp #b0 #b111101000000 #b100111)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b000000111101 #b110111)
                expect
                (fp #b0 #b011010100111 #b010111)))
(assert (fp.leq (fp #b0 #b011010100111 #b010111)
                expect
                (fp #b0 #b111111101011 #b100000)))

(assert (= expect result))

(check-sat)
(exit)
