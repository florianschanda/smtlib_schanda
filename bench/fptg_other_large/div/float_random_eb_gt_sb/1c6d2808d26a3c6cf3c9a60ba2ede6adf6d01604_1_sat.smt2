(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0110110010101 #b0101011)
                arg1
                (fp #b0 #b1111000101010 #b0001100)))
(assert (fp.leq (fp #b0 #b1111000101010 #b0001100)
                arg1
                (fp #b0 #b1111000110001 #b0010101)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1100100000111 #b1000100)
                arg2
                (fp #b1 #b0000000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000001)
                arg2
                (fp #b0 #b1101111001010 #b0001101)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111111111111 #b0000000)
                expect
                (fp #b1 #b1111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b1111111)
                expect
                (fp #b0 #b1001111000001 #b1110111)))

(assert (= expect result))

(check-sat)
(exit)
