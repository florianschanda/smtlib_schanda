(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001001111 #b01001)
                arg1
                (fp #b0 #b0000000000 #b11101)))
(assert (fp.leq (fp #b0 #b0000000000 #b11101)
                arg1
                (fp #b0 #b1011011011 #b11110)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0101101111 #b00100)
                arg2
                (fp #b0 #b0000000000 #b10100)))
(assert (fp.leq (fp #b0 #b0000000000 #b10100)
                arg2
                (fp #b0 #b0001100111 #b00010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110110111 #b01101)
                expect
                (fp #b0 #b0111111111 #b01111)))
(assert (fp.leq (fp #b0 #b0111111111 #b01111)
                expect
                (fp #b0 #b1111000101 #b11000)))

(assert (not (= expect result)))

(check-sat)
(exit)
