(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01000001110 #b01)
                arg1
                (fp #b0 #b11100001110 #b01)))
(assert (fp.leq (fp #b0 #b11100001110 #b01)
                arg1
                (fp #b0 #b11111011110 #b10)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10101000010 #b00)
                arg2
                (fp #b1 #b00000000000 #b01)))
(assert (fp.leq (fp #b1 #b00000000000 #b01)
                arg2
                (fp #b0 #b00001011000 #b00)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111111 #b00)
                expect
                (fp #b1 #b11111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111110 #b11)
                expect
                (fp #b1 #b00110010000 #b00)))

(assert (= expect result))

(check-sat)
(exit)
