(assert (fp.leq (fp #b0 #b1000000000110 #b0000001)
                arg2
                (fp #b0 #b1100001100001 #b0000111)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b0 #b1011000100100 #b0001110)
                expect
