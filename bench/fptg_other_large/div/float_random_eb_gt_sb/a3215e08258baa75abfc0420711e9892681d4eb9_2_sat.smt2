(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11101000001010 #b010001)
                arg1
                (fp #b0 #b00111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b00111111111101 #b000000)
                arg1
                (fp #b0 #b10101010011000 #b011110)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10100110000110 #b011001)
                arg2
                (fp #b1 #b10000000000000 #b100000)))
(assert (fp.leq (fp #b1 #b10000000000000 #b100000)
                arg2
                (fp #b0 #b10000101101011 #b001010)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10111001001100 #b011001)
                expect
                (fp #b1 #b00111111111011 #b010110)))
(assert (fp.leq (fp #b1 #b00111111111011 #b010110)
                expect
                (fp #b1 #b00101011001000 #b110111)))

(assert (= expect result))

(check-sat)
(exit)
