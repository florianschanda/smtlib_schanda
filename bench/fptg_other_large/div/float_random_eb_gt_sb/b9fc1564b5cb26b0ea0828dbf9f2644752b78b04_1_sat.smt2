(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b001110101001010 #b0)
                arg1
                (fp #b1 #b000000000000000 #b1)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1)
                arg1
                (fp #b0 #b000110010001011 #b1)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b101000011000100 #b1)
                arg2
                (fp #b1 #b100000000000001 #b0)))
(assert (fp.leq (fp #b1 #b100000000000001 #b0)
                arg2
                (fp #b0 #b001101110110111 #b1)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010000100001111 #b0)
                expect
                (fp #b0 #b000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0)
                expect
                (fp #b0 #b111101000101111 #b1)))

(assert (= expect result))

(check-sat)
(exit)
