(assert (fp.leq (fp #b1 #b011111110100101 #b010101110000)
                arg2
                (fp #b0 #b111100101010111 #b111110111001)))

(declare-const result (_ FloatingPoint 15 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b001100011010110 #b111101101101)
                expect
                (fp #b0 #b010000001011001 #b011111100011)))
(assert (fp.leq (fp #b0 #b010000001011001 #b011111100011)
                expect
                (fp #b0 #b111010100111100 #b110010001011)))

(assert (= expect result))

(check-sat)
