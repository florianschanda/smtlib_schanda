(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1011110001000000 #b001110)
                arg1
                (fp #b1 #b0111111111111111 #b101110)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b101110)
                arg1
                (fp #b0 #b0110110100111100 #b010010)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1110101111111001 #b101011)
                arg2
                (fp #b1 #b1110100101011001 #b001111)))
(assert (fp.leq (fp #b1 #b1110100101011001 #b001111)
                arg2
                (fp #b1 #b0011000110010110 #b011101)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1000110001011101 #b010011)
                expect
                (fp #b0 #b0001011010100101 #b011001)))
(assert (fp.leq (fp #b0 #b0001011010100101 #b011001)
                expect
                (fp #b0 #b1111100011010000 #b001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
