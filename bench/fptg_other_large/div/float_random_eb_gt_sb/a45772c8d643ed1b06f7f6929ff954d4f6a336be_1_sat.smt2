; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11100100110 #b00010101)
                arg1
                (fp #b0 #b01111111111 #b00010011)))
(assert (fp.leq (fp #b0 #b01111111111 #b00010011)
                arg1
                (fp #b0 #b10111001101 #b00111010)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10110010011 #b11101101)
                arg2
                (fp #b0 #b11000101010 #b01101110)))
(assert (fp.leq (fp #b0 #b11000101010 #b01101110)
                arg2
                (fp #b0 #b11100011110 #b10011011)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10000110101 #b11100100)
                expect
                (fp #b0 #b00111010011 #b10000000)))
(assert (fp.leq (fp #b0 #b00111010011 #b10000000)
                expect
                (fp #b0 #b01010011010 #b01011001)))

(assert (= expect result))

(check-sat)
(exit)
