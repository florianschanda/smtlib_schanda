(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111010011 #b011000)
                arg1
                (fp #b0 #b001111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111101 #b000000)
                arg1
                (fp #b0 #b101100011 #b110000)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b011001011 #b000101)
                arg2
                (fp #b0 #b100000001 #b100000)))
(assert (fp.leq (fp #b0 #b100000001 #b100000)
                arg2
                (fp #b0 #b101110011 #b100011)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001000000 #b011011)
                expect
                (fp #b0 #b001111010 #b010101)))
(assert (fp.leq (fp #b0 #b001111010 #b010101)
                expect
                (fp #b0 #b100000001 #b111011)))

(assert (= expect result))

(check-sat)
(exit)
