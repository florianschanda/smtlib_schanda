(assert (fp.leq (fp #b0 #b01000000000000000 #b00000000000000)
                arg2
                (fp #b0 #b11100110000100011 #b11000101111110)))

(declare-const result (_ FloatingPoint 17 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 15))
