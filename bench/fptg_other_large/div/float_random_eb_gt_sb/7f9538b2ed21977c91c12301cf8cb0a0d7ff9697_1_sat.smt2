; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111111 #b000)
                arg1
                (fp #b0 #b100000011 #b011)))
(assert (fp.leq (fp #b0 #b100000011 #b011)
                arg1
                (fp #b0 #b100001011 #b000)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b001001110 #b101)
                arg2
                (fp #b0 #b100000001 #b000)))
(assert (fp.leq (fp #b0 #b100000001 #b000)
                arg2
                (fp #b0 #b100001101 #b110)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010010111 #b110)
                expect
                (fp #b0 #b100000001 #b011)))
(assert (fp.leq (fp #b0 #b100000001 #b011)
                expect
                (fp #b0 #b110100000 #b100)))

(assert (= expect result))

(check-sat)
(exit)
