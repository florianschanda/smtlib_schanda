; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111111101 #b10100)
                arg1
                (fp #b1 #b111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000)
                arg1
                (fp #b1 #b001100101111 #b10101)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111111110 #b10000)
                arg2
                (fp #b1 #b111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000)
                arg2
                (fp #b0 #b011101001101 #b01110)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b0 #b000010101001 #b10000)
                expect
                (fp #b0 #b011111111111 #b00000)))
(assert (fp.leq (fp #b0 #b011111111111 #b00000)
                expect
                (fp #b0 #b110110110011 #b01101)))

(assert (= expect result))

(check-sat)
(exit)
