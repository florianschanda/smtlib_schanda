(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11010010001100 #b010101101)
                arg1
                (fp #b1 #b11001011001011 #b101100111)))
(assert (fp.leq (fp #b1 #b11001011001011 #b101100111)
                arg1
                (fp #b0 #b11001001010110 #b011011100)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b01010110010110 #b011011100)
                arg2
                (fp #b0 #b01000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b000000000)
                arg2
                (fp #b0 #b01000001110001 #b100111110)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11111111111111 #b000000000)
                expect
                (fp #b1 #b11111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111111111)
                expect
                (fp #b0 #b01010100000000 #b111000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
