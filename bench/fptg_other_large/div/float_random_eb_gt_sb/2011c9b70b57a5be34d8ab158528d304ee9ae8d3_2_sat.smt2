(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0110110001 #b11100)
                arg1
                (fp #b0 #b1000000001 #b00000)))
(assert (fp.leq (fp #b0 #b1000000001 #b00000)
                arg1
                (fp #b0 #b1101010000 #b01010)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110101101 #b11001)
                arg2
                (fp #b0 #b1000000100 #b00011)))
(assert (fp.leq (fp #b0 #b1000000100 #b00011)
                arg2
                (fp #b0 #b1100011101 #b10000)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111110111 #b11110)
                expect
                (fp #b0 #b0111111011 #b11011)))
(assert (fp.leq (fp #b0 #b0111111011 #b11011)
                expect
                (fp #b0 #b1000011001 #b01110)))

(assert (= expect result))

(check-sat)
(exit)
