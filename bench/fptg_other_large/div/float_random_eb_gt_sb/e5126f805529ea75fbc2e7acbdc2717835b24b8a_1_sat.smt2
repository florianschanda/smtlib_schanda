; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 10))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00111111100100101 #b000010001)
                arg1
                (fp #b1 #b00000000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000000000)
                arg1
                (fp #b0 #b11010010011110001 #b110001000)))

(declare-const arg2 (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b10000010010011101 #b010110111)
                arg2
                (fp #b1 #b00000000000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000000001)
                arg2
                (fp #b0 #b00010001011101110 #b110110101)))

(declare-const result (_ FloatingPoint 17 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00011101010011101 #b011101111)
                expect
                (fp #b0 #b00000000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b000000000)
                expect
                (fp #b0 #b00011010001100000 #b110110110)))

(assert (= expect result))

(check-sat)
(exit)
