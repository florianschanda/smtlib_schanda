(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b010110111100 #b011011)
                arg1
                (fp #b1 #b010001011101 #b101111)))
(assert (fp.leq (fp #b1 #b010001011101 #b101111)
                arg1
                (fp #b0 #b100100101010 #b000100)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111101001010 #b001000)
                arg2
                (fp #b1 #b101111100011 #b101101)))
(assert (fp.leq (fp #b1 #b101111100011 #b101101)
                arg2
                (fp #b0 #b011001011101 #b111011)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101110001101 #b001001)
                expect
                (fp #b0 #b000001111001 #b000010)))
(assert (fp.leq (fp #b0 #b000001111001 #b000010)
                expect
                (fp #b0 #b000110000011 #b101101)))

(assert (= expect result))

(check-sat)
(exit)
