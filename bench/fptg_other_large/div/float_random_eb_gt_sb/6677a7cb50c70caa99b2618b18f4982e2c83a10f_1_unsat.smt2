; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b010011000 #b0101)
                arg1
                (fp #b0 #b110001000 #b1110)))
(assert (fp.leq (fp #b0 #b110001000 #b1110)
                arg1
                (fp #b0 #b110100011 #b1110)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010110111 #b1000)
                arg2
                (fp #b0 #b100000001 #b1000)))
(assert (fp.leq (fp #b0 #b100000001 #b1000)
                arg2
                (fp #b0 #b110000110 #b0111)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010101101 #b0110)
                expect
                (fp #b0 #b110000110 #b0100)))
(assert (fp.leq (fp #b0 #b110000110 #b0100)
                expect
                (fp #b0 #b110100001 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
