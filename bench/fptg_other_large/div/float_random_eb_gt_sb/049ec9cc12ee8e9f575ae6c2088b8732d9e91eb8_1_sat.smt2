; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b0 #b01000110111111101 #b011)
                arg1
                (fp #b0 #b01111111111111111 #b100)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b100)
                arg1
                (fp #b0 #b10000101101001000 #b101)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11011100100111001 #b010)
                expect
                (fp #b1 #b01111111111111111 #b000)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b000)
                expect
                (fp #b1 #b00101101100010011 #b101)))

(assert (= expect result))

(check-sat)
(exit)
