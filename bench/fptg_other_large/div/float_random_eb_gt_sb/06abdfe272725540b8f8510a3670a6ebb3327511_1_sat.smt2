(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0100101001000011 #b1001111110)
                arg1
                (fp #b1 #b0011111111111011 #b0000000000)))
(assert (fp.leq (fp #b1 #b0011111111111011 #b0000000000)
                arg1
                (fp #b1 #b0000111000011111 #b1000111011)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1000001110111101 #b1111001000)
                expect
                (fp #b1 #b0000000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000000)
                expect
                (fp #b0 #b1000001011010100 #b1110111011)))

(assert (= expect result))

(check-sat)
(exit)
