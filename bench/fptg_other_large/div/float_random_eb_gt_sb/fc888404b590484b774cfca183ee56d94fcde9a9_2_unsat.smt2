; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110111101 #b001100)
                arg1
                (fp #b0 #b011111111 #b000000)))
(assert (fp.leq (fp #b0 #b011111111 #b000000)
                arg1
                (fp #b0 #b101011001 #b101011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100110100 #b100111)
                arg2
                (fp #b0 #b100000001 #b100000)))
(assert (fp.leq (fp #b0 #b100000001 #b100000)
                arg2
                (fp #b0 #b110001001 #b111011)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b010111011 #b011111)
                expect
                (fp #b0 #b011111100 #b010110)))
(assert (fp.leq (fp #b0 #b011111100 #b010110)
                expect
                (fp #b0 #b100101001 #b110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
