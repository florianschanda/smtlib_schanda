(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111111011110 #b001)
                arg1
                (fp #b1 #b011111111111 #b101)))
(assert (fp.leq (fp #b1 #b011111111111 #b101)
                arg1
                (fp #b0 #b000010001000 #b000)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110000010101 #b111)
                arg2
                (fp #b0 #b000000000000 #b011)))
(assert (fp.leq (fp #b0 #b000000000000 #b011)
                arg2
                (fp #b0 #b100101110010 #b000)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111111111111 #b000)
                expect
                (fp #b1 #b111111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111111110 #b111)
                expect
                (fp #b0 #b110001101110 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
