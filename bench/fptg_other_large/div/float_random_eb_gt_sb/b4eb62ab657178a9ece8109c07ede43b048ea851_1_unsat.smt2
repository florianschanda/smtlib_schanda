(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b001100100101 #b000110)
                arg1
                (fp #b0 #b011000111100 #b010111)))
(assert (fp.leq (fp #b0 #b011000111100 #b010111)
                arg1
                (fp #b0 #b100111100010 #b110010)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
