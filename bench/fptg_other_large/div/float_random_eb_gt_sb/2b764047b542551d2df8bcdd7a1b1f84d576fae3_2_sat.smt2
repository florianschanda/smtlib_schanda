(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110101000001 #b0011011)
                arg1
                (fp #b1 #b000000000000 #b0111101)))
(assert (fp.leq (fp #b1 #b000000000000 #b0111101)
                arg1
                (fp #b0 #b011001010010 #b0000000)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110100111101 #b1001111)
                arg2
                (fp #b0 #b000000000000 #b1111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b1111111)
                arg2
                (fp #b0 #b011010111101 #b1011001)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b101010101011 #b0001011)
                expect
                (fp #b1 #b011111111101 #b1110110)))
(assert (fp.leq (fp #b1 #b011111111101 #b1110110)
                expect
                (fp #b1 #b000100110111 #b1110101)))

(assert (= expect result))

(check-sat)
(exit)
