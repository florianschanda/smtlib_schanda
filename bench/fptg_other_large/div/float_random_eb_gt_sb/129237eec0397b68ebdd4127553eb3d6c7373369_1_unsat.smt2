(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101000101 #b10001)
                arg1
                (fp #b1 #b000000000 #b11011)))
(assert (fp.leq (fp #b1 #b000000000 #b11011)
                arg1
                (fp #b0 #b101111000 #b00110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011000101 #b00111)
                arg2
                (fp #b1 #b000000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111)
                arg2
                (fp #b0 #b111111010 #b11110)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b000011101 #b10001)
                expect
                (fp #b0 #b011111110 #b10111)))
(assert (fp.leq (fp #b0 #b011111110 #b10111)
                expect
                (fp #b0 #b110001110 #b11011)))

(assert (not (= expect result)))

(check-sat)
(exit)
