; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b0 #b10110000001110 #b0011001101)
                arg1
                (fp #b0 #b11010101110011 #b1100111000)))
(assert (fp.leq (fp #b0 #b11010101110011 #b1100111000)
                arg1
                (fp #b0 #b11110100110111 #b1111001011)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01110000011100 #b0010001101)
                expect
                (fp #b0 #b00000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000)
                expect
                (fp #b0 #b11110001001010 #b0010000011)))

(assert (= expect result))

(check-sat)
(exit)
