(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111110000001 #b1000)
                arg1
                (fp #b1 #b011111111111 #b1010)))
(assert (fp.leq (fp #b1 #b011111111111 #b1010)
                arg1
                (fp #b1 #b011011001010 #b1011)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111001010010 #b1110)
                arg2
                (fp #b1 #b110110010101 #b1001)))
(assert (fp.leq (fp #b1 #b110110010101 #b1001)
                arg2
                (fp #b1 #b000100100101 #b1000)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011101111101 #b1001)
                expect
                (fp #b0 #b001001101001 #b0001)))
(assert (fp.leq (fp #b0 #b001001101001 #b0001)
                expect
                (fp #b0 #b111011101011 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
