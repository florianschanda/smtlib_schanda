(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b110100101001000110 #b1110)
                arg1
                (fp #b1 #b101111111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b101111111111111110 #b1111)
                arg1
                (fp #b0 #b000011011110100100 #b1101)))

(declare-const arg2 (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b111010001010101100 #b0001)
                arg2
                (fp #b0 #b101100000111101101 #b1001)))
(assert (fp.leq (fp #b0 #b101100000111101101 #b1001)
                arg2
                (fp #b0 #b111111110011011110 #b1111)))

(declare-const result (_ FloatingPoint 18 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 5))
(assert (fp.leq (fp #b1 #b101100011110011101 #b0010)
                expect
                (fp #b1 #b100011111000010000 #b0100)))
(assert (fp.leq (fp #b1 #b100011111000010000 #b0100)
                expect
                (fp #b0 #b111010010110001110 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
