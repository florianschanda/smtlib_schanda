(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01111001111001 #b0101011)
                arg1
                (fp #b0 #b00000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000)
                arg1
                (fp #b0 #b00011100010111 #b1101010)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b11010101101011 #b1011101)
                arg2
                (fp #b0 #b11111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000000)
                arg2
                (fp #b0 #b11111111111110 #b0101001)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01100001001100 #b0011010)
                expect
                (fp #b0 #b00000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000)
                expect
                (fp #b0 #b11011010011011 #b0100111)))

(assert (= expect result))

(check-sat)
(exit)
