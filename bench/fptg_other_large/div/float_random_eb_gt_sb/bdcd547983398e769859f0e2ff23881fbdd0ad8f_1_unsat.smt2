(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1101000010100 #b110)
                arg1
                (fp #b0 #b0000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000 #b010)
                arg1
                (fp #b0 #b0010010100100 #b010)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111111111101 #b010)
                arg2
                (fp #b1 #b1111111111101 #b000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b000)
                arg2
                (fp #b1 #b0000111001111 #b010)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111011011111 #b010)
                expect
                (fp #b1 #b0000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000)
                expect
                (fp #b0 #b1101110101011 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
