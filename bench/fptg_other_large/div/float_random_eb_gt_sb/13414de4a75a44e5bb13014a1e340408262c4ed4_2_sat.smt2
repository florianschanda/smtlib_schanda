(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b10101010010 #b0001111)
                arg1
                (fp #b0 #b11110010101 #b0001011)))
(assert (fp.leq (fp #b0 #b11110010101 #b0001011)
                arg1
                (fp #b0 #b11110100101 #b1111101)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01000000010 #b1101101)
                arg2
                (fp #b1 #b00111111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111111100 #b0110101)
                arg2
                (fp #b1 #b00111110111 #b1010001)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
