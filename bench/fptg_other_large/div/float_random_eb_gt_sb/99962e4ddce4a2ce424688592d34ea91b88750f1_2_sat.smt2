(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b101110001001011 #b00)
                arg1
                (fp #b0 #b011111111111111 #b01)))
(assert (fp.leq (fp #b0 #b011111111111111 #b01)
                arg1
                (fp #b0 #b111111111010011 #b00)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b100110110011110 #b10)
                arg2
                (fp #b1 #b001001011000111 #b11)))
(assert (fp.leq (fp #b1 #b001001011000111 #b11)
                arg2
                (fp #b0 #b101101101101111 #b01)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b110111111101001 #b10)
                expect
                (fp #b1 #b110110100110110 #b10)))
(assert (fp.leq (fp #b1 #b110110100110110 #b10)
                expect
                (fp #b1 #b001111010001100 #b00)))

(assert (= expect result))

(check-sat)
(exit)
