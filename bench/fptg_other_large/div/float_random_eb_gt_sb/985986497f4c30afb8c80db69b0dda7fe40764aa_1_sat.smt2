; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10111100011000 #b01111001000)
                arg1
                (fp #b1 #b00000000000000 #b10011011110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b10011011110)
                arg1
                (fp #b0 #b10010000101001 #b01101110001)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00000111100001 #b10011111110)
                arg2
                (fp #b0 #b00000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000000000)
                arg2
                (fp #b0 #b01111010000110 #b00110010001)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
