(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b0 #b0100100011000101 #b0100)
                arg1
                (fp #b0 #b0100111011111000 #b1100)))
(assert (fp.leq (fp #b0 #b0100111011111000 #b1100)
                arg1
                (fp #b0 #b0111111011000101 #b0000)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0100101001011010 #b0001)
                arg2
                (fp #b0 #b0111111111111111 #b0110)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b0110)
                arg2
                (fp #b0 #b1000011010001110 #b0111)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0011110100001000 #b0011)
                expect
                (fp #b0 #b0100111011111000 #b0100)))
(assert (fp.leq (fp #b0 #b0100111011111000 #b0100)
                expect
                (fp #b0 #b0101000110001101 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
