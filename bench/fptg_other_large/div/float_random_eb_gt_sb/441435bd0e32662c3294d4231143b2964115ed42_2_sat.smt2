(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110011110011 #b01)
                arg1
                (fp #b1 #b011110100111 #b11)))
(assert (fp.leq (fp #b1 #b011110100111 #b11)
                arg1
                (fp #b0 #b110011100001 #b11)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b001101111110 #b11)
                arg2
                (fp #b0 #b111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111101 #b00)
                arg2
                (fp #b0 #b111111111110 #b01)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101011110000 #b11)
                expect
                (fp #b1 #b000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000 #b01)
                expect
                (fp #b0 #b001100110000 #b11)))

(assert (= expect result))

(check-sat)
(exit)
