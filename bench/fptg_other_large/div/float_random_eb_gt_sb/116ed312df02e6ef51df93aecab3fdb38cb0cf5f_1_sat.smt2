(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111010011 #b10)
                arg1
                (fp #b1 #b010000000 #b00)))
(assert (fp.leq (fp #b1 #b010000000 #b00)
                arg1
                (fp #b0 #b111001000 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b000100011 #b01)
                arg2
                (fp #b1 #b000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000 #b10)
                arg2
                (fp #b0 #b101001011 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b101100100 #b10)
                expect
                (fp #b0 #b101111111 #b00)))
(assert (fp.leq (fp #b0 #b101111111 #b00)
                expect
                (fp #b0 #b111010101 #b01)))

(assert (= expect result))

(check-sat)
(exit)
