(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01011101011 #b110)
                arg1
                (fp #b0 #b11111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111)
                arg1
                (fp #b0 #b11111111111 #b000)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11011110010 #b001)
                arg2
                (fp #b1 #b00000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000 #b001)
                arg2
                (fp #b0 #b11100010111 #b000)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111111111 #b000)
                expect
                (fp #b1 #b11111111110 #b111)))
(assert (fp.leq (fp #b1 #b11111111110 #b111)
                expect
                (fp #b0 #b01011001010 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
