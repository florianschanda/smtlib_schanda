; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0110001111000)
                arg1
                (fp #b1 #b111111111111111101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0000000000000)
                arg1
                (fp #b1 #b110101001001110101 #b1000111100011)))

(declare-const arg2 (_ FloatingPoint 18 14))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110000001010010111 #b0000010000101)
                expect
                (fp #b0 #b000000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0000000000000)
                expect
                (fp #b0 #b000011011010010110 #b0111000000011)))

(assert (= expect result))

(check-sat)
(exit)
