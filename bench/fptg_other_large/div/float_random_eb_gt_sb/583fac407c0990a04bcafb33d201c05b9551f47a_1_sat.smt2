; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ONE
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10010011101001 #b101101001)
                arg1
                (fp #b1 #b01111111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b000000000)
                arg1
                (fp #b0 #b11011110100010 #b111010011)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11001010111101 #b100101110)
                arg2
                (fp #b0 #b00000000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010000000)
                arg2
                (fp #b0 #b01101001011010 #b101010100)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11111111111111 #b000000000)
                expect
                (fp #b1 #b11111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111111111)
                expect
                (fp #b0 #b00011111101101 #b011100011)))

(assert (= expect result))

(check-sat)
(exit)
