; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b0001001001101001 #b010010001111)
                arg1
                (fp #b0 #b0000000000000000 #b111111111111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111111111111)
                arg1
                (fp #b0 #b0111001110110101 #b001101111111)))

(declare-const arg2 (_ FloatingPoint 16 13))
