                arg2
                (fp #b0 #b1111111111111110 #b111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1110101001111110 #b010001101101)
                expect
                (fp #b0 #b0000000000000000 #b000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000001)
                expect
                (fp #b0 #b0010101100100101 #b100011001110)))

(assert (= expect result))

(check-sat)
(exit)
