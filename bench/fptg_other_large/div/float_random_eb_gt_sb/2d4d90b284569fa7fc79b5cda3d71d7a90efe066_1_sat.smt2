(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1100100000000 #b10)
                arg1
                (fp #b1 #b0111111111111 #b01)))
(assert (fp.leq (fp #b1 #b0111111111111 #b01)
                arg1
                (fp #b0 #b1101011111000 #b11)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0101111110000 #b10)
                arg2
                (fp #b1 #b0101000010101 #b10)))
(assert (fp.leq (fp #b1 #b0101000010101 #b10)
                arg2
                (fp #b0 #b0000010110010 #b10)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0011011111111 #b10)
                expect
                (fp #b0 #b1010111101000 #b10)))
(assert (fp.leq (fp #b0 #b1010111101000 #b10)
                expect
                (fp #b0 #b1101010111100 #b00)))

(assert (= expect result))

(check-sat)
(exit)
