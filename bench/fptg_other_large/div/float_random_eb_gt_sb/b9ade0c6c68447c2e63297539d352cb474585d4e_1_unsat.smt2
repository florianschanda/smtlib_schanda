;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b000110010110000 #b00)
                arg1
                (fp #b0 #b100000000000001 #b10)))
(assert (fp.leq (fp #b0 #b100000000000001 #b10)
                arg1
                (fp #b0 #b110001110101011 #b00)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b100100110101111 #b00)
                arg2
                (fp #b0 #b011111111111111 #b11)))
(assert (fp.leq (fp #b0 #b011111111111111 #b11)
                arg2
                (fp #b0 #b110001110111001 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000110100011101 #b10)
                expect
                (fp #b0 #b100000000000000 #b10)))
(assert (fp.leq (fp #b0 #b100000000000000 #b10)
                expect
                (fp #b0 #b101010100000000 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
