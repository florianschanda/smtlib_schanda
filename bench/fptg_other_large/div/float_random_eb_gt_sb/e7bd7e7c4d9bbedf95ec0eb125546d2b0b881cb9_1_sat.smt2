; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b110111011100000101 #b11001)
                arg1
                (fp #b1 #b110111001011110111 #b01010)))
(assert (fp.leq (fp #b1 #b110111001011110111 #b01010)
                arg1
                (fp #b0 #b111110000100001001 #b10101)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b101111110000001000 #b10001)
                arg2
                (fp #b0 #b000000000000000000 #b10100)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b10100)
                arg2
                (fp #b0 #b100001110110000010 #b01011)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111111111111111111 #b00000)
                expect
                (fp #b1 #b111111111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b11111)
                expect
                (fp #b0 #b101101110000010101 #b01101)))

(assert (= expect result))

(check-sat)
(exit)
