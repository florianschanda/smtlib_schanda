(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b00100011100001 #b0)
                arg1
                (fp #b0 #b11001100000000 #b1)))
(assert (fp.leq (fp #b0 #b11001100000000 #b1)
                arg1
                (fp #b0 #b11010001110000 #b0)))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11010100101000 #b1)
                expect
                (fp #b1 #b00000000000000 #b0)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0)
                expect
                (fp #b0 #b10010010101010 #b1)))

(assert (= expect result))

(check-sat)
(exit)
