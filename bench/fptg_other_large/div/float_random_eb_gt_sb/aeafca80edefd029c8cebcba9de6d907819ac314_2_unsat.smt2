(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b0 #b0010010001001010 #b1010011)
                arg1
                (fp #b0 #b1011100010000111 #b0111110)))
(assert (fp.leq (fp #b0 #b1011100010000111 #b0111110)
                arg1
                (fp #b0 #b1101011001000001 #b1101000)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1100010111100111 #b0011100)
                arg2
                (fp #b1 #b1001010010010010 #b0010001)))
(assert (fp.leq (fp #b1 #b1001010010010010 #b0010001)
                arg2
                (fp #b0 #b0100011010000000 #b0111001)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1101110001110011 #b1111110)
                expect
                (fp #b1 #b1010001111110100 #b0101000)))
(assert (fp.leq (fp #b1 #b1010001111110100 #b0101000)
                expect
                (fp #b0 #b1101100000011100 #b0111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
