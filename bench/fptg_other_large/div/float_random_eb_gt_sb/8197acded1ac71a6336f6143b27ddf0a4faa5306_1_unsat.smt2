(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0101100010101 #b00)
                arg1
                (fp #b0 #b1110011111010 #b00)))
(assert (fp.leq (fp #b0 #b1110011111010 #b00)
                arg1
                (fp #b0 #b1111011001000 #b00)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111010011001 #b10)
                arg2
                (fp #b0 #b0110110011100 #b01)))
(assert (fp.leq (fp #b0 #b0110110011100 #b01)
                arg2
                (fp #b0 #b1111100011100 #b11)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0111001110101 #b11)
                expect
                (fp #b0 #b1111101011100 #b10)))
(assert (fp.leq (fp #b0 #b1111101011100 #b10)
                expect
                (fp #b0 #b1111111001111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
