(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b010010001101 #b0110110001)
                arg1
                (fp #b0 #b000000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b1111111111)
                arg1
                (fp #b0 #b011000001011 #b1010100110)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b001011101100 #b1000101100)
                arg2
                (fp #b0 #b100101111101 #b1011011110)))
(assert (fp.leq (fp #b0 #b100101111101 #b1011011110)
                arg2
                (fp #b0 #b110011101101 #b1101100000)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b001010011101 #b1000011100)
                expect
                (fp #b0 #b000000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000000001)
                expect
                (fp #b0 #b101100011000 #b1100010110)))

(assert (= expect result))

(check-sat)
(exit)
