(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b101111101011 #b0100)
                arg1
                (fp #b1 #b000000000000 #b0011)))
(assert (fp.leq (fp #b1 #b000000000000 #b0011)
                arg1
                (fp #b0 #b000011011011 #b0100)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b010001001101 #b0111)
                arg2
                (fp #b0 #b110110000111 #b0001)))
(assert (fp.leq (fp #b0 #b110110000111 #b0001)
                arg2
                (fp #b0 #b111011111000 #b0000)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110010111101 #b0010)
                expect
                (fp #b1 #b000000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000000 #b0001)
                expect
                (fp #b0 #b110000101010 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
