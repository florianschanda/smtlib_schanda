; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101100101001 #b01)
                arg1
                (fp #b0 #b011100001010 #b01)))
(assert (fp.leq (fp #b0 #b011100001010 #b01)
                arg1
                (fp #b0 #b110000000100 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000101100000 #b00)
                arg2
                (fp #b0 #b100000000001 #b00)))
(assert (fp.leq (fp #b0 #b100000000001 #b00)
                arg2
                (fp #b0 #b100010010111 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100010111111 #b00)
                expect
                (fp #b0 #b011100001000 #b01)))
(assert (fp.leq (fp #b0 #b011100001000 #b01)
                expect
                (fp #b0 #b111110101011 #b00)))

(assert (= expect result))

(check-sat)
(exit)
