(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b00100110001111101 #b100101110)
                arg1
                (fp #b1 #b00010100100000000 #b010100111)))
(assert (fp.leq (fp #b1 #b00010100100000000 #b010100111)
                arg1
                (fp #b0 #b10011101110110101 #b011001001)))

(declare-const arg2 (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b01010110101010010 #b100010110)
                arg2
                (fp #b0 #b10110011111011010 #b011100010)))
(assert (fp.leq (fp #b0 #b10110011111011010 #b011100010)
                arg2
                (fp #b0 #b11101001001000011 #b001110001)))

(declare-const result (_ FloatingPoint 17 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10011011011000011 #b110111100)
                expect
                (fp #b1 #b00000000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000000000)
                expect
                (fp #b0 #b10111011110101000 #b001011010)))

(assert (= expect result))

(check-sat)
(exit)
