(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101101000010111010 #b10001000100010010)
                expect
                (fp #b1 #b101100111100110011 #b01001100001101011)))
(assert (fp.leq (fp #b1 #b101100111100110011 #b01001100001101011)
                expect
                (fp #b1 #b011010110100001111 #b11000001000100001)))

(assert (= expect result))

(check-sat)
