(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011100 #b00001111)
                arg1
                (fp #b0 #b011111111 #b00010011)))
(assert (fp.leq (fp #b0 #b011111111 #b00010011)
                arg1
                (fp #b0 #b100101001 #b10110100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101111 #b00001110)
                arg2
                (fp #b1 #b101010010 #b00100101)))
(assert (fp.leq (fp #b1 #b101010010 #b00100101)
                arg2
                (fp #b1 #b001100101 #b10110111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100001 #b10000100)
                expect
                (fp #b1 #b010101011 #b11100000)))
(assert (fp.leq (fp #b1 #b010101011 #b11100000)
                expect
                (fp #b0 #b100111111 #b10011111)))

(assert (= expect result))

(check-sat)
(exit)
