(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110100000110001 #b100110101001111)
                arg2
                (fp #b0 #b0000000000000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100100100100110)
                arg2
                (fp #b0 #b0101110001010010 #b001010101111110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b1001101000101101 #b000100101100110)
                expect
                (fp #b0 #b1011111111111110 #b101111111111011)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b101111111111011)
                expect
                (fp #b0 #b1101010010110000 #b000000000110000)))

(assert (= expect result))

(check-sat)
(exit)
