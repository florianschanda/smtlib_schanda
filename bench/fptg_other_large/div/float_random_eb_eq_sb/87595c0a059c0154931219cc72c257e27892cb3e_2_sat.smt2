(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001000111 #b0101110001)
                arg1
                (fp #b1 #b01111111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1111110100)
                arg1
                (fp #b0 #b11111011011 #b0101011011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01000001001 #b0110010010)
                arg2
                (fp #b0 #b11010110000 #b1101010111)))
(assert (fp.leq (fp #b0 #b11010110000 #b1101010111)
                arg2
                (fp #b0 #b11100101010 #b0101000111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110101110 #b1011000101)
                expect
                (fp #b1 #b00101001110 #b0001010110)))
(assert (fp.leq (fp #b1 #b00101001110 #b0001010110)
                expect
                (fp #b0 #b10010101011 #b1101110100)))

(assert (= expect result))

(check-sat)
(exit)
