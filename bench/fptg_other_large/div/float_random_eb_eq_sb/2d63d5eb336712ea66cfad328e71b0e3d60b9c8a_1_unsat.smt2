; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01111111000 #b0100011100)
                arg1
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                arg1
                (fp #b0 #b11001101101 #b0010001010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00001100100 #b0110100000)
                arg2
                (fp #b0 #b10000001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10000001001 #b0100111000)
                arg2
                (fp #b0 #b10101111001 #b0110100011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00011111001 #b1110000100)
                expect
                (fp #b0 #b11000111101 #b1010011001)))
(assert (fp.leq (fp #b0 #b11000111101 #b1010011001)
                expect
                (fp #b0 #b11011110000 #b1010100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
