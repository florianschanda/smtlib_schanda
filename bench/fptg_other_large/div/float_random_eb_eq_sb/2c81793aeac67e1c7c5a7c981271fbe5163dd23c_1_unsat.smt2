; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111111011 #b110010001)
                arg1
                (fp #b1 #b0110111010 #b000100010)))
(assert (fp.leq (fp #b1 #b0110111010 #b000100010)
                arg1
                (fp #b0 #b0011011100 #b000110010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110011100 #b111001101)
                expect
                (fp #b1 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111 #b000000000)
                expect
                (fp #b0 #b1001100111 #b001010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
