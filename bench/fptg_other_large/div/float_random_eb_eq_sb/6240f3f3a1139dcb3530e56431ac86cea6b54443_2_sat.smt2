; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001111010100101 #b111011011000001)
                arg1
                (fp #b1 #b1000000000001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b1000000000001110 #b011110011001111)
                arg1
                (fp #b1 #b0011111111000100 #b110101100101001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010101010111100 #b010000011010000)
                arg2
                (fp #b0 #b1000000000001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b1000000000001100 #b010011110100100)
                arg2
                (fp #b0 #b1110011111110010 #b110000000001100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001100101001011 #b101000101000000)
                expect
                (fp #b1 #b1000000000000001 #b001000000101010)))
(assert (fp.leq (fp #b1 #b1000000000000001 #b001000000101010)
                expect
                (fp #b1 #b0110101110011101 #b100001011001101)))

(assert (= expect result))

(check-sat)
(exit)
