(assert (fp.leq (fp #b1 #b11000100001111010 #b1100011100000010)
                arg2
                (fp #b0 #b10010000111111111 #b1101110100000100)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10111001010011110 #b0100011011111010)
                expect
                (fp #b1 #b00111011110010001 #b1100101010000010)))
(assert (fp.leq (fp #b1 #b00111011110010001 #b1100101010000010)
                expect
                (fp #b0 #b00001101101111111 #b1010101111101001)))

(assert (= expect result))

(check-sat)
