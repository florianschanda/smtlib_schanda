; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101111101101011 #b10011110000011)
                arg1
                (fp #b1 #b000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000000)
                arg1
                (fp #b0 #b101001001010110 #b11000110111110)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001101110110100 #b10001011101010)
                arg2
                (fp #b0 #b111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b11111111111111)
                arg2
                (fp #b0 #b111111111111111 #b00000000000000)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100111010001011 #b11001111001001)
                expect
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b011100000010110 #b00000011001000)))

(assert (= expect result))

(check-sat)
(exit)
