; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
