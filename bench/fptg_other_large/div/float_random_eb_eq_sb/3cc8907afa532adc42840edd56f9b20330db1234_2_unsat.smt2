;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010111100100 #b0111100010110)
                arg1
                (fp #b0 #b10111011100110 #b0010111000010)))
(assert (fp.leq (fp #b0 #b10111011100110 #b0010111000010)
                arg1
                (fp #b0 #b11110100000101 #b1001001010111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000000100100 #b1111001011000)
                arg2
                (fp #b1 #b10000000001100 #b1000110111100)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1000110111100)
                arg2
                (fp #b0 #b11011010111111 #b1111110101011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111100001110 #b0011100101010)
                expect
                (fp #b1 #b10111011011000 #b1000010010111)))
(assert (fp.leq (fp #b1 #b10111011011000 #b1000010010111)
                expect
                (fp #b0 #b00001001000000 #b0101100001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
