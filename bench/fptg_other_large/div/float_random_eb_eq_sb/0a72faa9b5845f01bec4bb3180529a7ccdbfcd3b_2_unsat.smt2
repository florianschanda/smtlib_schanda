; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010110111 #b01111000)
                arg1
                (fp #b0 #b111000010 #b00111001)))
(assert (fp.leq (fp #b0 #b111000010 #b00111001)
                arg1
                (fp #b0 #b111100111 #b11001111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000111010 #b11010100)
                arg2
                (fp #b0 #b011111111 #b11100111)))
(assert (fp.leq (fp #b0 #b011111111 #b11100111)
                arg2
                (fp #b0 #b110100011 #b01010110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011011110 #b10101011)
                expect
                (fp #b0 #b111000001 #b01001010)))
(assert (fp.leq (fp #b0 #b111000001 #b01001010)
                expect
                (fp #b0 #b111000101 #b00100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
