(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011110001 #b01001010)
                arg1
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg1
                (fp #b0 #b000101001 #b01101000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001001 #b10111011)
                arg2
                (fp #b1 #b101101100 #b10101111)))
(assert (fp.leq (fp #b1 #b101101100 #b10101111)
                arg2
                (fp #b1 #b000111011 #b11010010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010111110 #b10110001)
                expect
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                expect
                (fp #b0 #b110001100 #b01101000)))

(assert (= expect result))

(check-sat)
(exit)
