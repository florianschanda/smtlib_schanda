;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001011100011110 #b111000110000101)
                arg1
                (fp #b1 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b000000000000000)
                arg1
                (fp #b0 #b1101001101100000 #b110101010101010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111110000101010 #b011111001000000)
                arg2
                (fp #b1 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b1 #b0001001000011110 #b110010010110001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b1010101100101100 #b010000101000011)
                expect
                (fp #b0 #b1100000000000101 #b011010100000101)))
(assert (fp.leq (fp #b0 #b1100000000000101 #b011010100000101)
                expect
                (fp #b0 #b1101110101010100 #b100000110011010)))

(assert (= expect result))

(check-sat)
(exit)
