(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0101100000011111 #b111101101110011)
                arg1
                (fp #b0 #b1101000000101101 #b100100100100101)))
(assert (fp.leq (fp #b0 #b1101000000101101 #b100100100100101)
                arg1
                (fp #b0 #b1111011111011010 #b111000101001000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0010111011000101 #b111111101000000)
                arg2
                (fp #b0 #b1000000000001100 #b010011110100100)))
(assert (fp.leq (fp #b0 #b1000000000001100 #b010011110100100)
                arg2
                (fp #b0 #b1000100010000111 #b001101110001001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101110101101100 #b111101101101011)
                expect
                (fp #b0 #b1101000000100000 #b001100110010100)))
(assert (fp.leq (fp #b0 #b1101000000100000 #b001100110010100)
                expect
                (fp #b0 #b1101111110011011 #b011001100101001)))

(assert (= expect result))

(check-sat)
(exit)
