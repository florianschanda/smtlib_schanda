(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0011101110101 #b010100110111)
                arg1
                (fp #b0 #b0000000000000 #b000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000001)
                arg1
                (fp #b0 #b0100111001010 #b001011010101)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
