(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111101 #b11110000001000)
                arg1
                (fp #b1 #b111111111111101 #b00000000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00000000000000)
                arg1
                (fp #b0 #b010110101100001 #b00011010100001)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000101111000101 #b11001111010010)
                arg2
                (fp #b0 #b000000000000000 #b11111111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111111111111)
                arg2
                (fp #b0 #b110110001111000 #b11001000011101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
