; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111101 #b0100111111)
                arg1
                (fp #b1 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000)
                arg1
                (fp #b0 #b01110110101 #b0101001000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10100000101 #b0101100001)
                expect
                (fp #b0 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b00100011100 #b1110001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
