; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b11011010101)
                arg1
                (fp #b1 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000000)
                arg1
                (fp #b1 #b101100101010 #b00010100010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100001100011 #b10000101001)
                arg2
                (fp #b1 #b000000000000 #b10001001100)))
(assert (fp.leq (fp #b1 #b000000000000 #b10001001100)
                arg2
                (fp #b0 #b111111001101 #b11110010111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b101110100110 #b00000001010)
                expect
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                expect
                (fp #b0 #b111111111111 #b00000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
