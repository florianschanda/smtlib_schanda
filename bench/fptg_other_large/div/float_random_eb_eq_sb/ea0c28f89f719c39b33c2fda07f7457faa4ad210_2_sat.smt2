(assert (fp.leq (fp #b1 #b1000000001011 #b100011010111)
                arg2
                (fp #b1 #b0000011111100 #b110100000100)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1001000100101 #b100101111101)
                expect
                (fp #b0 #b1110110110000 #b010000011111)))
(assert (fp.leq (fp #b0 #b1110110110000 #b010000011111)
                expect
                (fp #b0 #b1111110011010 #b110111111111)))

(assert (= expect result))

(check-sat)
