; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11000011101000000 #b1100100001010100)
                arg1
                (fp #b1 #b01010110010100011 #b1010010011111000)))
(assert (fp.leq (fp #b1 #b01010110010100011 #b1010010011111000)
                arg1
                (fp #b0 #b10011111011010001 #b1011011101110111)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11000000011110010 #b0100100110000100)
                arg2
                (fp #b1 #b10000000000001110 #b0001100010111110)))
(assert (fp.leq (fp #b1 #b10000000000001110 #b0001100010111110)
                arg2
                (fp #b1 #b00111000010100001 #b0111101010000011)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b00011011100000101 #b0110100110011001)
                expect
                (fp #b0 #b01010110010010100 #b0111111111011110)))
(assert (fp.leq (fp #b0 #b01010110010010100 #b0111111111011110)
                expect
                (fp #b0 #b10110100001011011 #b1111010110101100)))

(assert (= expect result))

(check-sat)
(exit)
