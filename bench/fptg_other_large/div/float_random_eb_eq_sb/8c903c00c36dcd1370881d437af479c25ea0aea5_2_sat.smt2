(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110111010110010 #b100110010000110)
                arg1
                (fp #b0 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000000000000000)
                arg1
                (fp #b0 #b0110111110000000 #b110111111101101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0111001100001110 #b010101001111101)
                arg2
                (fp #b1 #b0000000000000000 #b110111110100111)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b110111110100111)
                arg2
                (fp #b0 #b0010100011011111 #b100011101011101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110000001010110 #b000011110011101)
                expect
                (fp #b1 #b1011111111111110 #b001001010111110)))
(assert (fp.leq (fp #b1 #b1011111111111110 #b001001010111110)
                expect
                (fp #b1 #b0001010111110100 #b100100110110010)))

(assert (= expect result))

(check-sat)
(exit)
