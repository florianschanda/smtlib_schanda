; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b100111000 #b10101111)
                arg1
                (fp #b0 #b111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000000)
                arg1
                (fp #b0 #b111111110 #b00101111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001111101 #b01110110)
                arg2
                (fp #b0 #b011111111 #b11100111)))
(assert (fp.leq (fp #b0 #b011111111 #b11100111)
                arg2
                (fp #b0 #b111000000 #b10011100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000101 #b10010010)
                expect
                (fp #b0 #b111111100 #b00001110)))
(assert (fp.leq (fp #b0 #b111111100 #b00001110)
                expect
                (fp #b0 #b111111100 #b01010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
