; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                arg1
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                arg1
                (fp #b0 #b101011100 #b11001011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011000011 #b10110110)
                arg2
                (fp #b0 #b111011111 #b11011111)))
(assert (fp.leq (fp #b0 #b111011111 #b11011111)
                arg2
                (fp #b0 #b111100101 #b00100110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000010 #b01000110)
                expect
                (fp #b1 #b100011110 #b00010010)))
(assert (fp.leq (fp #b1 #b100011110 #b00010010)
                expect
                (fp #b1 #b000001010 #b11101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
