                (fp #b1 #b0000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010000000000000)
                arg2
                (fp #b0 #b1011000110010000 #b010010011010011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0001011100111100 #b110010111011101)
                expect
                (fp #b0 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111111)
                expect
                (fp #b0 #b1111111111111111 #b000000000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
