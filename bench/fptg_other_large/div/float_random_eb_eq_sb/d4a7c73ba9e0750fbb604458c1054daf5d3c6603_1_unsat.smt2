; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b011110111101101100 #b11010100100110101)
                arg2
                (fp #b1 #b010011000011001011 #b01110100011010001)))
(assert (fp.leq (fp #b1 #b010011000011001011 #b01110100011010001)
                arg2
                (fp #b1 #b001110010111011001 #b10111110110101100)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
