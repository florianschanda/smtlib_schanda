; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010101000 #b0011011011)
                arg1
                (fp #b1 #b01000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000)
                arg1
                (fp #b1 #b00000100111 #b1010010100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101100011 #b0110110100)
                arg2
                (fp #b1 #b00000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000101100)
                arg2
                (fp #b0 #b10101010010 #b1100010011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00000001100 #b1001101011)
                expect
                (fp #b0 #b10111111110 #b1101011110)))
(assert (fp.leq (fp #b0 #b10111111110 #b1101011110)
                expect
                (fp #b0 #b11110011110 #b1001010000)))

(assert (= expect result))

(check-sat)
(exit)
