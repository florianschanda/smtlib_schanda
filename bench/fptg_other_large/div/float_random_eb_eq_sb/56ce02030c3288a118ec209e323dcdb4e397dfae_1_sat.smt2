; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000111000101111 #b110011111101111)
                arg1
                (fp #b0 #b1001111110100001 #b101000110011100)))
(assert (fp.leq (fp #b0 #b1001111110100001 #b101000110011100)
                arg1
                (fp #b0 #b1010100101110110 #b110111101011110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000000011000101 #b000001000011000)
                arg2
                (fp #b1 #b0000000000000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b000000000000000)
                arg2
                (fp #b0 #b0001010010111101 #b111101011000100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000000)
                expect
                (fp #b1 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111111)
                expect
                (fp #b0 #b1001100110101010 #b100000111110111)))

(assert (= expect result))

(check-sat)
(exit)
