(assert (fp.leq (fp #b0 #b110000000001111100 #b01011100110011100)
                arg2
                (fp #b0 #b111010000011000110 #b10100110110111011)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101000100110000010 #b00111000101101101)
                expect
                (fp #b0 #b001111111110000010 #b01100010101100000)))
(assert (fp.leq (fp #b0 #b001111111110000010 #b01100010101100000)
                expect
                (fp #b0 #b100111010111111000 #b00111111010110011)))

(assert (= expect result))

(check-sat)
(exit)
