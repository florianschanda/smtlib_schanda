; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111101110 #b0011010101)
                arg1
                (fp #b0 #b11010100000 #b0100011001)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011001)
                arg1
                (fp #b0 #b11100111110 #b1000101000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100111001 #b1110111101)
                expect
                (fp #b0 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000)
                expect
                (fp #b0 #b10101000100 #b1010011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
