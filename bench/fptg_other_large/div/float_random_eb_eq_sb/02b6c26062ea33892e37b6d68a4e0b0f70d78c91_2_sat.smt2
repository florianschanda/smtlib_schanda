; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111110100001 #b0001011010000)
                arg1
                (fp #b1 #b11111010101000 #b1111010011101)))
(assert (fp.leq (fp #b1 #b11111010101000 #b1111010011101)
                arg1
                (fp #b1 #b10101000111011 #b0010110011111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011001000000 #b1101011101101)
                arg2
                (fp #b1 #b00000111110111 #b1110101001101)))
(assert (fp.leq (fp #b1 #b00000111110111 #b1110101001101)
                arg2
                (fp #b0 #b11101001111011 #b0010010001011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
