(assert (fp.leq (fp #b1 #b0111111111111 #b100101100010)
                arg2
                (fp #b0 #b0011001000111 #b000011111101)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101011101000 #b010001011010)
                expect
                (fp #b1 #b1000000000111 #b111110100010)))
(assert (fp.leq (fp #b1 #b1000000000111 #b111110100010)
                expect
                (fp #b0 #b1110001110111 #b101011100000)))

(assert (not (= expect result)))

