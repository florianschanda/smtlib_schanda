                expect
                (fp #b1 #b001111100010110 #b10000010010111)))
(assert (fp.leq (fp #b1 #b001111100010110 #b10000010010111)
                expect
                (fp #b0 #b011000110000110 #b00110100101000)))

(assert (not (= expect result)))

