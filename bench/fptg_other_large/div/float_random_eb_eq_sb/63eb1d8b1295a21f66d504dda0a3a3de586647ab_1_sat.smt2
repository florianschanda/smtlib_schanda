(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100011111 #b010101110)
                arg1
                (fp #b0 #b1101001001 #b011010100)))
(assert (fp.leq (fp #b0 #b1101001001 #b011010100)
                arg1
                (fp #b0 #b1111110110 #b101110000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101000111 #b110111111)
                arg2
                (fp #b1 #b0000000000 #b010000100)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000100)
                arg2
                (fp #b0 #b1001011111 #b011011100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                expect
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                expect
                (fp #b1 #b1011001010 #b111011110)))

(assert (= expect result))

(check-sat)
(exit)
