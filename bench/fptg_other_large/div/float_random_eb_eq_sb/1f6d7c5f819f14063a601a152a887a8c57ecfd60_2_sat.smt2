(assert (fp.leq (fp #b1 #b0010010111010 #b110111100110)
                arg2
                (fp #b0 #b1001101010110 #b110110001111)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1001011001111 #b001010001000)
                expect
                (fp #b1 #b0101101000011 #b000100100000)))
(assert (fp.leq (fp #b1 #b0101101000011 #b000100100000)
                expect
                (fp #b0 #b1100010110110 #b111000111111)))

(assert (= expect result))

(check-sat)
