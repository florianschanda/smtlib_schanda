                arg2
                (fp #b1 #b110111011101000 #b10110101010101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010110000001000 #b10101101111100)
                expect
                (fp #b0 #b000000000000000 #b00000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000001)
                expect
                (fp #b0 #b111101100010110 #b11001011001000)))

(assert (not (= expect result)))

(check-sat)
