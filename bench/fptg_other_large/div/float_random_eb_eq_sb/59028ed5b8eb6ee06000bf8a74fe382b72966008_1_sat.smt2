                arg2
                (fp #b0 #b00111000000 #b0011010110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110100110 #b1101001110)
                expect
                (fp #b1 #b01111111111 #b0001100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0001100100)
                expect
                (fp #b1 #b01100001110 #b1110000010)))

(assert (= expect result))

