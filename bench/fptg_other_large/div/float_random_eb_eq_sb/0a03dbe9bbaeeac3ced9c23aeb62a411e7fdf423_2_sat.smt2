; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010101010011100 #b011100110011110)
                arg1
                (fp #b0 #b1101001101010010 #b010010110011010)))
(assert (fp.leq (fp #b0 #b1101001101010010 #b010010110011010)
                arg1
                (fp #b0 #b1111010110000001 #b100001111011010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111011000110111 #b111110001100110)
                arg2
                (fp #b1 #b0111111111101011 #b110010100110100)))
(assert (fp.leq (fp #b1 #b0111111111101011 #b110010100110100)
                arg2
                (fp #b0 #b0000001011010010 #b001010001000101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111001001101111 #b111101100101000)
                expect
                (fp #b1 #b1101001101100101 #b011100011110111)))
(assert (fp.leq (fp #b1 #b1101001101100101 #b011100011110111)
                expect
                (fp #b0 #b1111111100101101 #b111011000100111)))

(assert (= expect result))

(check-sat)
(exit)
