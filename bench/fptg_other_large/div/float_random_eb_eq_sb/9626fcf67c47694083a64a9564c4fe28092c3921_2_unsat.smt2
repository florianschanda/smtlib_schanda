(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110000011 #b111000000)
                expect
                (fp #b0 #b0000000000 #b000001100)))
(assert (fp.leq (fp #b0 #b0000000000 #b000001100)
                expect
                (fp #b0 #b1110011111 #b111101110)))

(assert (not (= expect result)))

