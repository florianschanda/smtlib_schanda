;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11001001010111 #b1001110111100)
                arg1
                (fp #b1 #b01111111111111 #b0000000000000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0000000000000)
                arg1
                (fp #b1 #b00001100001010 #b1100100011011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00011101111000 #b1001101010100)
                arg2
                (fp #b0 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000000000)
                arg2
                (fp #b0 #b00010100000000 #b1010110110100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
