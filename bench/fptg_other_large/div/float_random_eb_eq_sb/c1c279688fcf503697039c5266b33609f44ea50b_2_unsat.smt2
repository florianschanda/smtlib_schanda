; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100111101 #b0001011000)
                arg1
                (fp #b0 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000001010 #b0000000000)
                arg1
                (fp #b0 #b10011011010 #b1001010001)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001110101 #b1001111000)
                arg2
                (fp #b0 #b00000000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000)
                arg2
                (fp #b0 #b10101011011 #b0000010100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
