(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110001101 #b111101100)
                arg1
                (fp #b0 #b1000001000 #b110100101)))
(assert (fp.leq (fp #b0 #b1000001000 #b110100101)
                arg1
                (fp #b0 #b1011010000 #b110011101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001110110 #b001111100)
                arg2
                (fp #b1 #b0111111111 #b010001010)))
(assert (fp.leq (fp #b1 #b0111111111 #b010001010)
                arg2
                (fp #b0 #b0101010100 #b111011101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011001101 #b001011101)
                expect
                (fp #b1 #b1000001000 #b011011111)))
(assert (fp.leq (fp #b1 #b1000001000 #b011011111)
                expect
                (fp #b1 #b0011001110 #b010001111)))

(assert (= expect result))

(check-sat)
(exit)
