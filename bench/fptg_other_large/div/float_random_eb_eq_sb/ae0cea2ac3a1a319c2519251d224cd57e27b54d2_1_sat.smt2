; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100000100011 #b11010001111)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b1 #b000011010010 #b10111110101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011110100111 #b01111100000)
                arg2
                (fp #b1 #b000000000000 #b01101101001)))
(assert (fp.leq (fp #b1 #b000000000000 #b01101101001)
                arg2
                (fp #b0 #b101110100100 #b10100110000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001100100000 #b11000101110)
                expect
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                expect
                (fp #b0 #b111111111111 #b00000000000)))

(assert (= expect result))

(check-sat)
(exit)
