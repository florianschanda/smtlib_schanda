(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000001 #b00010110)
                arg1
                (fp #b1 #b001111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111100 #b00000000)
                arg1
                (fp #b0 #b011100101 #b11011001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100010 #b10000110)
                arg2
                (fp #b0 #b000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b000000000 #b00111011)
                arg2
                (fp #b0 #b101101010 #b11010011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001010 #b01101111)
                expect
                (fp #b1 #b101111100 #b00010101)))
(assert (fp.leq (fp #b1 #b101111100 #b00010101)
                expect
                (fp #b0 #b110001100 #b00000100)))

(assert (= expect result))

(check-sat)
(exit)
