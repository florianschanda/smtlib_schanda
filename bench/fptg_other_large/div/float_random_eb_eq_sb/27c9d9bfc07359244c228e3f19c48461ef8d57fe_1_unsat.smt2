(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100110011 #b00011101111)
                arg1
                (fp #b1 #b110100111101 #b10101101000)))
(assert (fp.leq (fp #b1 #b110100111101 #b10101101000)
                arg1
                (fp #b1 #b011111000010 #b11011001110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010001101 #b11100010110)
                arg2
                (fp #b0 #b101101010110 #b10000100000)))
(assert (fp.leq (fp #b0 #b101101010110 #b10000100000)
                arg2
                (fp #b0 #b110110101001 #b10101001101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110111110 #b11011110010)
                expect
                (fp #b1 #b100111100110 #b00011011000)))
(assert (fp.leq (fp #b1 #b100111100110 #b00011011000)
                expect
                (fp #b0 #b100100110011 #b10011110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
