; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100001110010011 #b101101101101110)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b1 #b0110011111000111 #b001000000011100)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0100010111100111 #b100100001110101)
                expect
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b1101010110100101 #b000010001111111)))

(assert (= expect result))

(check-sat)
(exit)
