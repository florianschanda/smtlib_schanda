; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010001110 #b00000001)
                arg1
                (fp #b0 #b111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000000)
                arg1
                (fp #b0 #b111111110 #b00101111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001111 #b10100100)
                arg2
                (fp #b1 #b100000111 #b10010100)))
(assert (fp.leq (fp #b1 #b100000111 #b10010100)
                arg2
                (fp #b1 #b010000101 #b01110010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111100 #b11010110)
                expect
                (fp #b1 #b111110100 #b01000101)))
(assert (fp.leq (fp #b1 #b111110100 #b01000101)
                expect
                (fp #b1 #b011010011 #b01111100)))

(assert (= expect result))

(check-sat)
(exit)
