(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000010 #b00001001)
                arg1
                (fp #b1 #b011111111 #b00100101)))
(assert (fp.leq (fp #b1 #b011111111 #b00100101)
                arg1
                (fp #b0 #b010011000 #b01001010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100111 #b01001110)
                arg2
                (fp #b1 #b101001011 #b00101100)))
(assert (fp.leq (fp #b1 #b101001011 #b00101100)
                arg2
                (fp #b0 #b000111100 #b00001000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111010000 #b01011100)
                expect
                (fp #b0 #b010110010 #b11110100)))
(assert (fp.leq (fp #b0 #b010110010 #b11110100)
                expect
                (fp #b0 #b100000011 #b00011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
