; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111011011 #b11100100110)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b0 #b000010011100 #b10101000101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000000)
                arg2
                (fp #b1 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111111)
                arg2
                (fp #b0 #b011111110101 #b11111100110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100011010111 #b10111000000)
                expect
                (fp #b0 #b000000100000 #b01101001100)))
(assert (fp.leq (fp #b0 #b000000100000 #b01101001100)
                expect
                (fp #b0 #b011000001000 #b00011110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
