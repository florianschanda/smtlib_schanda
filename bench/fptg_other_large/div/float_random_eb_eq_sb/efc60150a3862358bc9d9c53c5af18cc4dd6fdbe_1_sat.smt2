; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01011101101101 #b1101101001101)
                arg1
                (fp #b1 #b00000000000000 #b1000011100010)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1000011100010)
                arg1
                (fp #b0 #b11010001110110 #b0111110100000)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011010101110 #b0111011001100)
                arg2
                (fp #b0 #b10000110110110 #b0101110110001)))
(assert (fp.leq (fp #b0 #b10000110110110 #b0101110110001)
                arg2
                (fp #b0 #b11100111011100 #b1111000110010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01110010000100 #b1011101101100)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b00001001001111 #b1101010010100)))

(assert (= expect result))

(check-sat)
(exit)
