;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b001001110010101 #b11010101000110)
                arg1
                (fp #b0 #b011111111111111 #b01110001110010)))
(assert (fp.leq (fp #b0 #b011111111111111 #b01110001110010)
                arg1
                (fp #b0 #b101011001011110 #b11011100001111)))

