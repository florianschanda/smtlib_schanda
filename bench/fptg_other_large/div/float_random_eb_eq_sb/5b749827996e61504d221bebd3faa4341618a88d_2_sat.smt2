                arg2
                (fp #b0 #b111101111010010 #b10111001100110)))
(assert (fp.leq (fp #b0 #b111101111010010 #b10111001100110)
                arg2
                (fp #b0 #b111111010000011 #b00100110101010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b000000110100010 #b01000100111011)
                expect
                (fp #b0 #b000010000101011 #b10101100110000)))
(assert (fp.leq (fp #b0 #b000010000101011 #b10101100110000)
                expect
                (fp #b0 #b010100111111111 #b10101000001011)))

(assert (= expect result))

(check-sat)
(exit)
