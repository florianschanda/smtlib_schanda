(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001101001 #b0111110111)
                arg1
                (fp #b1 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b10000001011 #b0100101111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01111110001 #b1101101111)
                arg2
                (fp #b1 #b00010101100 #b0100111000)))
(assert (fp.leq (fp #b1 #b00010101100 #b0100111000)
                arg2
                (fp #b0 #b10010101110 #b1100100001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000111001 #b1000100000)
                expect
                (fp #b0 #b01101010011 #b1000100000)))
(assert (fp.leq (fp #b0 #b01101010011 #b1000100000)
                expect
                (fp #b0 #b10110011101 #b0100000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
