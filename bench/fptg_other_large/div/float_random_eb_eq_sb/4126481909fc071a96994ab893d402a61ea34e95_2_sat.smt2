; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000100100011011 #b10000101111100)
                arg1
                (fp #b0 #b111111101001001 #b01000110100101)))
(assert (fp.leq (fp #b0 #b111111101001001 #b01000110100101)
                arg1
                (fp #b0 #b111111110101100 #b11001010000001)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101101100011 #b11000011101100)
                arg2
                (fp #b1 #b010000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b00000000000000)
                arg2
                (fp #b0 #b100011110100000 #b00101100100110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
