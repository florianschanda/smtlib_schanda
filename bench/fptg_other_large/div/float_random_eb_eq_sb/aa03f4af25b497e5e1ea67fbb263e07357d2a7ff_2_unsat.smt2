; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111110 #b0101110010)
                arg1
                (fp #b1 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000)
                arg1
                (fp #b1 #b10111001101 #b0001010001)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001111011 #b0111011101)
                arg2
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg2
                (fp #b0 #b11100000000 #b0010001011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
