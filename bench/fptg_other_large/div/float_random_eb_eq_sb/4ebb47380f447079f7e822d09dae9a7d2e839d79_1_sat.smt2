                arg2
                (fp #b0 #b0100000110110 #b010000101101)))
(assert (fp.leq (fp #b0 #b0100000110110 #b010000101101)
                arg2
                (fp #b0 #b0101001010000 #b000110111100)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111110000101 #b001011000111)
                expect
                (fp #b0 #b1101000000101 #b010010100110)))
(assert (fp.leq (fp #b0 #b1101000000101 #b010010100110)
                expect
                (fp #b0 #b1110110100010 #b000110111000)))

(assert (= expect result))

(check-sat)
(exit)
