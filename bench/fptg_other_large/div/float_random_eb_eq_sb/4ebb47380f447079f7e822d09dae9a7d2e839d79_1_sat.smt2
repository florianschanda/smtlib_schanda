;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1001101011110 #b001001111100)
                arg1
                (fp #b0 #b1001000111100 #b101000001010)))
(assert (fp.leq (fp #b0 #b1001000111100 #b101000001010)
                arg1
                (fp #b0 #b1001110000001 #b000100010101)))

