; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b00010000111)
                arg1
                (fp #b1 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000000)
                arg1
                (fp #b0 #b110001011110 #b01011000001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100100001 #b10110000101)
                arg2
                (fp #b0 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000001)
                arg2
                (fp #b0 #b111001001011 #b01111101101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000000)
                expect
                (fp #b1 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111111)
                expect
                (fp #b1 #b001101111101 #b00100111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
