                arg2
                (fp #b0 #b00000000000000 #b0110101110101)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0110101110101)
                arg2
                (fp #b0 #b00101000111100 #b0110011001001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010001001110 #b0101000110010)
                expect
                (fp #b0 #b11010100011110 #b0000111101110)))
(assert (fp.leq (fp #b0 #b11010100011110 #b0000111101110)
                expect
                (fp #b0 #b11110010010000 #b0111011000001)))

(assert (= expect result))

(check-sat)
(exit)
