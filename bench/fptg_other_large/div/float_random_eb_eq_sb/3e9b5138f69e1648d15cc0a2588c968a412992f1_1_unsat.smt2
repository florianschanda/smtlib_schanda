; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110111 #b01010110)
                arg1
                (fp #b0 #b000011000 #b11110110)))
(assert (fp.leq (fp #b0 #b000011000 #b11110110)
                arg1
                (fp #b0 #b111100001 #b10010100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011110010 #b11010011)
                expect
                (fp #b0 #b011111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111 #b00000000)
                expect
                (fp #b0 #b101010110 #b10100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
