(assert (fp.leq (fp #b1 #b001111111010 #b01101010000)
                arg2
                (fp #b0 #b101111111111 #b00001111001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111011011 #b00011011001)
                expect
                (fp #b1 #b110000000100 #b00011100000)))
(assert (fp.leq (fp #b1 #b110000000100 #b00011100000)
                expect
                (fp #b0 #b010001001011 #b11111001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
