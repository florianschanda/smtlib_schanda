(assert (fp.leq (fp #b1 #b000000000000 #b01101101001)
                arg2
                (fp #b0 #b111101001101 #b10011001011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101110111 #b00001001001)
                expect
                (fp #b1 #b101111111001 #b10101000101)))
(assert (fp.leq (fp #b1 #b101111111001 #b10101000101)
                expect
                (fp #b1 #b001100001010 #b01001000110)))

(assert (not (= expect result)))

