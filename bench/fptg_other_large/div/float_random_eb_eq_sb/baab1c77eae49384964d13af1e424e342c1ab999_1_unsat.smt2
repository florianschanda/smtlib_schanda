; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100000010 #b100111110)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b1001111101 #b100111000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001010010 #b101101111)
                arg2
                (fp #b0 #b1000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b1000001000 #b001010110)
                arg2
                (fp #b0 #b1101100011 #b011000011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111000 #b100110011)
                expect
                (fp #b0 #b0101111110 #b101000111)))
(assert (fp.leq (fp #b0 #b0101111110 #b101000111)
                expect
                (fp #b0 #b1010110010 #b010101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
