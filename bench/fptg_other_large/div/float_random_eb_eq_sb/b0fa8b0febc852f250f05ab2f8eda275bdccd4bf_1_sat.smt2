(declare-const arg2 (_ FloatingPoint 16 16))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011100011100100 #b001000111101111)
                expect
                (fp #b1 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b000000000000000)
                expect
                (fp #b0 #b0000011101010001 #b110100011001100)))

(assert (= expect result))

(check-sat)
(exit)
