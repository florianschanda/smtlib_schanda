(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11110101001100100 #b1110111010001000)
                arg2
                (fp #b1 #b10111111111111110 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b10111111111111110 #b1111111111111111)
                arg2
                (fp #b1 #b10001000001101011 #b0011111101000100)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
