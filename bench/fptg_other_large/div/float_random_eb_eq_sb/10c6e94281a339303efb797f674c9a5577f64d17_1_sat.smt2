; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110001101 #b1100111001)
                arg1
                (fp #b1 #b00000000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000000 #b1110100001)
                arg1
                (fp #b0 #b10101000110 #b1000111111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b10110011010 #b1110101010)
                arg2
                (fp #b0 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111)
                arg2
                (fp #b0 #b11110001101 #b1011100110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11100100110 #b0110001101)
                expect
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b11100010101 #b0101111100)))

(assert (= expect result))

(check-sat)
(exit)
