                (fp #b1 #b11110001011 #b0011101010)))
(assert (fp.leq (fp #b1 #b11110001011 #b0011101010)
                arg2
                (fp #b1 #b11010000111 #b0111001011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000001001 #b0101001100)
                expect
                (fp #b1 #b00101001011 #b0101011111)))
(assert (fp.leq (fp #b1 #b00101001011 #b0101011111)
                expect
                (fp #b0 #b00101000011 #b1001011110)))

(assert (not (= expect result)))

(check-sat)
