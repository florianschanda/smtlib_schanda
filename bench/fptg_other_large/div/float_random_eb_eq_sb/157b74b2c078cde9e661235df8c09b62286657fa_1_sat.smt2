; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1001100110101 #b111000000101)
                arg1
                (fp #b1 #b0100000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b000000000000)
                arg1
                (fp #b0 #b1000011011111 #b100011111000)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1010011010111 #b011100111111)
                arg2
                (fp #b1 #b1000011101100 #b010000011011)))
(assert (fp.leq (fp #b1 #b1000011101100 #b010000011011)
                arg2
                (fp #b1 #b0101111011101 #b010110100011)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111001111011 #b110011100010)
                expect
                (fp #b0 #b0011100010010 #b100101110111)))
(assert (fp.leq (fp #b0 #b0011100010010 #b100101110111)
                expect
                (fp #b0 #b0111001000111 #b100100111001)))

(assert (= expect result))

(check-sat)
(exit)
