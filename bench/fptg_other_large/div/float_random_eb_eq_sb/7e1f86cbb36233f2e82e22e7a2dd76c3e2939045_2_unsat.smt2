;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111100111111000000 #b10100101111011000)
                arg1
                (fp #b1 #b100000000000001101 #b01001011100100000)))
(assert (fp.leq (fp #b1 #b100000000000001101 #b01001011100100000)
                arg1
                (fp #b1 #b010101111110111100 #b01100000001100110)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111001111110110110 #b01010110011100101)
                arg2
                (fp #b1 #b101001000001001110 #b00011110010011000)))
(assert (fp.leq (fp #b1 #b101001000001001110 #b00011110010011000)
                arg2
                (fp #b1 #b000101101001101001 #b11110011101000101)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110100010100001000 #b10010110111111100)
                expect
                (fp #b0 #b010110111110111110 #b00101000011110100)))
(assert (fp.leq (fp #b0 #b010110111110111110 #b00101000011110100)
                expect
                (fp #b0 #b101100001001011100 #b10101111100101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
