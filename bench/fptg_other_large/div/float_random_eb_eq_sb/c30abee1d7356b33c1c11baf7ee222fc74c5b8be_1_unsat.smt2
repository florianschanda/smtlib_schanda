; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000001010110 #b00000001110)
                arg1
                (fp #b0 #b000000000000 #b10010110110)))
(assert (fp.leq (fp #b0 #b000000000000 #b10010110110)
                arg1
                (fp #b0 #b101111010011 #b10001100010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110011110 #b10111101010)
                expect
                (fp #b1 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000000000)
                expect
                (fp #b1 #b011011100111 #b00000100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
