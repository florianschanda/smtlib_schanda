(assert (fp.leq (fp #b0 #b100000001000 #b10100111100)
                arg2
                (fp #b0 #b111001010100 #b10011010111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100100110000 #b10110111110)
                expect
                (fp #b0 #b100000000001 #b00110101011)))
(assert (fp.leq (fp #b0 #b100000000001 #b00110101011)
                expect
                (fp #b0 #b100000001010 #b00001000011)))

(assert (= expect result))

(check-sat)
