;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0001110111011010 #b101011010100000)
                arg1
                (fp #b0 #b0000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010000000000000)
                arg1
                (fp #b0 #b1000001001010110 #b000111010010001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101111101001010 #b100101011011000)
                arg2
                (fp #b0 #b0000000000000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100100100100110)
                arg2
                (fp #b0 #b0001010100011111 #b100001001000000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001001011101100 #b001100100011101)
                expect
                (fp #b0 #b0111111111111101 #b101111111111011)))
(assert (fp.leq (fp #b0 #b0111111111111101 #b101111111111011)
                expect
                (fp #b0 #b1111110010101110 #b101011110000000)))

(assert (= expect result))

(check-sat)
(exit)
