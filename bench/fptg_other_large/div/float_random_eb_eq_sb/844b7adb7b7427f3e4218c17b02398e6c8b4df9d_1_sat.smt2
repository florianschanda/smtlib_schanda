(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1110110100000 #b000010100111)
                arg1
                (fp #b1 #b0000000000000 #b111011011010)))
