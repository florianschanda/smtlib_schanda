(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1001000010101 #b011100111111)
                expect
                (fp #b1 #b0000000000000 #b000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000000000000)
                expect
                (fp #b0 #b1011111100100 #b100100000110)))

(assert (= expect result))

(check-sat)
(exit)
