(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00101110100 #b0111010001)
                arg1
                (fp #b0 #b01000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000)
                arg1
                (fp #b0 #b01111101100 #b1100000010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000100111 #b0100101010)
                arg2
                (fp #b1 #b01111111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011111110)
                arg2
                (fp #b0 #b10010011100 #b1100110110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100010110 #b0101110011)
                expect
                (fp #b1 #b00111111111 #b1001101001)))
(assert (fp.leq (fp #b1 #b00111111111 #b1001101001)
                expect
                (fp #b1 #b00110100111 #b0101100010)))

(assert (= expect result))

(check-sat)
(exit)
