; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110111111110000 #b011000000100010)
                arg1
                (fp #b1 #b1000000000001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b1000000000001110 #b011110011001111)
                arg1
                (fp #b0 #b1001010111101100 #b001110101110011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010101011010100 #b010101000110101)
                arg2
                (fp #b0 #b0000000000000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010000010001101)
                arg2
                (fp #b0 #b1011010001101100 #b000111011101001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000000)
                expect
                (fp #b1 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111111)
                expect
                (fp #b0 #b1001111000100110 #b011010010101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
