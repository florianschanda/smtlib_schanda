(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000100110000 #b0110101001111)
                arg1
                (fp #b1 #b10000000001100 #b1111100010101)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1111100010101)
                arg1
                (fp #b0 #b11010011101001 #b1111011111001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10010110111110 #b1101110110100)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b10010100010000 #b1101111111110)))

(assert (= expect result))

(check-sat)
(exit)
