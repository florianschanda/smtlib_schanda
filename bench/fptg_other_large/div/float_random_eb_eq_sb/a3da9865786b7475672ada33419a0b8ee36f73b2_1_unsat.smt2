                arg2
                (fp #b0 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000000000)
                arg2
                (fp #b0 #b1111111101 #b011100101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011110101 #b100110000)
                expect
                (fp #b1 #b0101101110 #b100010000)))
(assert (fp.leq (fp #b1 #b0101101110 #b100010000)
                expect
                (fp #b1 #b0001000110 #b100110001)))

(assert (not (= expect result)))

(check-sat)
(exit)
