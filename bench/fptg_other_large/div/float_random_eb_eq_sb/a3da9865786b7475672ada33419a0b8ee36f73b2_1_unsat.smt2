(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110100000 #b110010100)
                arg1
                (fp #b1 #b1101101100 #b100010000)))
(assert (fp.leq (fp #b1 #b1101101100 #b100010000)
