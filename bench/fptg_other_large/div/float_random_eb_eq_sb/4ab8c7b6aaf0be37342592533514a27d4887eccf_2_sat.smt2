(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110111110001001 #b10010001000111)
                arg1
                (fp #b1 #b100000100101000 #b00100010100001)))
(assert (fp.leq (fp #b1 #b100000100101000 #b00100010100001)
                arg1
                (fp #b0 #b011011101000010 #b00000100010101)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011011100100110 #b11000101100000)
                arg2
                (fp #b0 #b011111111111111 #b00100111100001)))
(assert (fp.leq (fp #b0 #b011111111111111 #b00100111100001)
                arg2
                (fp #b0 #b110001111010011 #b10111010001101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100110000010011 #b11010011011110)
                expect
                (fp #b1 #b100000100100111 #b11110111010110)))
(assert (fp.leq (fp #b1 #b100000100100111 #b11110111010110)
                expect
                (fp #b0 #b101000001100111 #b00100000001111)))

(assert (= expect result))

(check-sat)
(exit)
