(assert (fp.leq (fp #b0 #b1100110011111 #b000010101100)
                arg2
                (fp #b0 #b1111111010100 #b111001110100)))
(assert (fp.leq (fp #b0 #b1111111010100 #b111001110100)
                arg2
                (fp #b0 #b1111111110111 #b000000110110)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0110000011100 #b100111111101)
                expect
                (fp #b1 #b0011110100010 #b001001101000)))
(assert (fp.leq (fp #b1 #b0011110100010 #b001001101000)
                expect
                (fp #b1 #b0010101011111 #b100110010101)))

(assert (= expect result))

(check-sat)
(exit)
