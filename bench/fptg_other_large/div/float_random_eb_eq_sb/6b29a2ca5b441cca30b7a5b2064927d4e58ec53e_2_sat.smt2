;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100111001101 #b000010011100)
                arg1
                (fp #b1 #b1011101111000 #b000110000100)))
(assert (fp.leq (fp #b1 #b1011101111000 #b000110000100)
                arg1
                (fp #b0 #b0110001001001 #b100010000000)))

