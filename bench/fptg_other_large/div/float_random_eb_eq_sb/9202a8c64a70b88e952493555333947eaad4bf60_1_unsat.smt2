                arg2
                (fp #b0 #b1100010011111011 #b001011101011111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110011111101011 #b010101100110110)
                expect
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                expect
                (fp #b0 #b1101110111011000 #b101001001101110)))

(assert (not (= expect result)))

(check-sat)
