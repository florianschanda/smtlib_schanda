(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100110011 #b11010000101)
                arg1
                (fp #b1 #b100000001010 #b01101011101)))
(assert (fp.leq (fp #b1 #b100000001010 #b01101011101)
                arg1
                (fp #b0 #b000110000111 #b01110110101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001011101111 #b10110100000)
                arg2
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                arg2
                (fp #b0 #b111111111111 #b00000000000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100101110 #b10011010111)
                expect
                (fp #b1 #b000000001010 #b01101011110)))
(assert (fp.leq (fp #b1 #b000000001010 #b01101011110)
                expect
                (fp #b0 #b100001110000 #b11000010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
