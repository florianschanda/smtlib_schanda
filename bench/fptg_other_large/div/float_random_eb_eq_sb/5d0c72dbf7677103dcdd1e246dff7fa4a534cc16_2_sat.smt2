; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0111110111 #b100100011)
                arg1
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                arg1
                (fp #b0 #b1010011010 #b011110110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0000111110 #b111010100)
                arg2
                (fp #b0 #b0011101101 #b011110011)))
(assert (fp.leq (fp #b0 #b0011101101 #b011110011)
                arg2
                (fp #b0 #b0100101011 #b001010111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101011001 #b101101100)
                expect
                (fp #b0 #b1100010000 #b010110111)))
(assert (fp.leq (fp #b0 #b1100010000 #b010110111)
                expect
                (fp #b0 #b1101100100 #b010001100)))

(assert (= expect result))

(check-sat)
(exit)
