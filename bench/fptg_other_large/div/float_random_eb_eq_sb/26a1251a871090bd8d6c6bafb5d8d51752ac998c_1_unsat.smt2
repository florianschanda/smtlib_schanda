(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110000111101111001 #b10011110011000001)
                arg1
                (fp #b1 #b001111111111110111 #b01101010000010100)))
(assert (fp.leq (fp #b1 #b001111111111110111 #b01101010000010100)
                arg1
                (fp #b0 #b010110100111001010 #b11101111101001011)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111110110110000111 #b10000000100101100)
                expect
                (fp #b1 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b110110101110100000 #b11110011001111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
