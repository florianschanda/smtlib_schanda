(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100111100111011 #b001011010101001)
                arg1
                (fp #b1 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b000000000000000)
                arg1
                (fp #b1 #b0000110000100100 #b010010111010010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011000110100011 #b011111111001000)
                arg2
                (fp #b1 #b0001100001101011 #b001110100011101)))
(assert (fp.leq (fp #b1 #b0001100001101011 #b001110100011101)
                arg2
                (fp #b0 #b0010110101000110 #b010100100001000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010111001010010 #b101000000011001)
                expect
                (fp #b0 #b1010011110010011 #b101000010010000)))
(assert (fp.leq (fp #b0 #b1010011110010011 #b101000010010000)
                expect
                (fp #b0 #b1111010110001001 #b011110000001001)))

(assert (= expect result))

(check-sat)
(exit)
