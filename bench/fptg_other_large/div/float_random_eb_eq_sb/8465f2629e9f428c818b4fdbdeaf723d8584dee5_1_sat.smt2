; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000110010 #b0101100101)
                arg1
                (fp #b1 #b01111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011010000)
                arg1
                (fp #b0 #b01110100001 #b1001010111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101001101 #b0110001111)
                arg2
                (fp #b1 #b10000001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10000001000 #b0100001100)
                arg2
                (fp #b0 #b01001000110 #b1001101010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000100111 #b1101110001)
                expect
                (fp #b0 #b01111110101 #b1110100000)))
(assert (fp.leq (fp #b0 #b01111110101 #b1110100000)
                expect
                (fp #b0 #b10100110000 #b1010100101)))

(assert (= expect result))

(check-sat)
(exit)
