; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011001 #b11110010)
                arg1
                (fp #b1 #b101000011 #b10111100)))
(assert (fp.leq (fp #b1 #b101000011 #b10111100)
                arg1
                (fp #b1 #b001100001 #b00011001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110100 #b11010000)
                arg2
                (fp #b1 #b011111111 #b10011100)))
(assert (fp.leq (fp #b1 #b011111111 #b10011100)
                arg2
                (fp #b0 #b100110110 #b11100100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101000 #b10001101)
                expect
                (fp #b0 #b101000011 #b00010011)))
(assert (fp.leq (fp #b0 #b101000011 #b00010011)
                expect
                (fp #b0 #b110101010 #b10101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
