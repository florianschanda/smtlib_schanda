;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101110 #b00011001)
                arg1
                (fp #b0 #b011111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111 #b00000000)
                arg1
                (fp #b0 #b111000011 #b10000110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001000 #b00110000)
                arg2
                (fp #b1 #b101001011 #b00101100)))
(assert (fp.leq (fp #b1 #b101001011 #b00101100)
                arg2
                (fp #b1 #b011010111 #b00100111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000111 #b11110100)
                expect
                (fp #b1 #b010110010 #b10110101)))
(assert (fp.leq (fp #b1 #b010110010 #b10110101)
                expect
                (fp #b1 #b010011111 #b00000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
