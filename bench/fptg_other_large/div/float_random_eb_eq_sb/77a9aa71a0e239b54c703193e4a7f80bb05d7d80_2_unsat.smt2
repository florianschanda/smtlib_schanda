(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011010 #b10011011)
                arg1
                (fp #b1 #b010101000 #b01111011)))
(assert (fp.leq (fp #b1 #b010101000 #b01111011)
                arg1
                (fp #b1 #b000010000 #b10000101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011011 #b00111111)
                arg2
                (fp #b1 #b101101100 #b10101111)))
(assert (fp.leq (fp #b1 #b101101100 #b10101111)
                arg2
                (fp #b0 #b000110011 #b11110111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011100000 #b11000001)
                expect
                (fp #b0 #b000111010 #b11000011)))
(assert (fp.leq (fp #b0 #b000111010 #b11000011)
                expect
                (fp #b0 #b110111010 #b01001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
