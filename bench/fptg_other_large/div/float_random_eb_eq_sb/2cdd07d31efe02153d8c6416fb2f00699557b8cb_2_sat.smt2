(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110111101110010 #b100010110111101)
                expect
                (fp #b1 #b0111111111111111 #b001000110010011)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b001000110010011)
                expect
                (fp #b0 #b1110010111110110 #b110010010101110)))

(assert (= expect result))

(check-sat)
