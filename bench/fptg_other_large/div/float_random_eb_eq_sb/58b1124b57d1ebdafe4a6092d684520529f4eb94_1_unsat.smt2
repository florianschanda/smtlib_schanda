(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111111110 #b1011100110111)
                expect
                (fp #b1 #b11111111111110 #b1010101110101)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1010101110101)
                expect
                (fp #b0 #b01010100111001 #b1011001001100)))

(assert (not (= expect result)))

