(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111110000111 #b110100011101101)
                arg1
                (fp #b1 #b0111111111111111 #b011000110111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b011000110111010)
