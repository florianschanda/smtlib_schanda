; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b010111101000101110 #b10101001100110101)
                arg1
                (fp #b1 #b010101100101000110 #b01001001111100000)))
(assert (fp.leq (fp #b1 #b010101100101000110 #b01001001111100000)
                arg1
                (fp #b0 #b001101101100011011 #b01101100111011110)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110011011101110011 #b00110110001001000)
                arg2
                (fp #b1 #b101001000001001110 #b00011110010011000)))
(assert (fp.leq (fp #b1 #b101001000001001110 #b00011110010011000)
                arg2
                (fp #b0 #b001101001001101110 #b11100001010111110)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100100101000100011 #b00010111001001010)
                expect
                (fp #b0 #b001100100011110111 #b00100111000001100)))
(assert (fp.leq (fp #b0 #b001100100011110111 #b00100111000001100)
                expect
                (fp #b0 #b110111100111011100 #b10001010000011100)))

(assert (= expect result))

(check-sat)
(exit)
