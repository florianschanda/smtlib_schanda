(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011110000001 #b10100110000)
                arg1
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg1
                (fp #b0 #b111101010101 #b01111100101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000010000101 #b10010011100)
                arg2
                (fp #b0 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b100000001011 #b00000000000)
                arg2
                (fp #b0 #b110001110000 #b00011111111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010101101111 #b00100111011)
                expect
                (fp #b1 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000001)
                expect
                (fp #b0 #b001111001000 #b01110000110)))

(assert (= expect result))

(check-sat)
(exit)
