(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011100101 #b0100110111)
                arg1
                (fp #b1 #b10010111000 #b0110101101)))
(assert (fp.leq (fp #b1 #b10010111000 #b0110101101)
                arg1
                (fp #b1 #b00000101100 #b1111110000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01101000001 #b1010000000)
                arg2
                (fp #b0 #b10110000110 #b0001100011)))
(assert (fp.leq (fp #b0 #b10110000110 #b0001100011)
                arg2
                (fp #b0 #b10111001100 #b1010000001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000101111 #b1011110011)
                expect
                (fp #b1 #b01100110001 #b0100101100)))
(assert (fp.leq (fp #b1 #b01100110001 #b0100101100)
                expect
                (fp #b0 #b01110001011 #b1000000001)))

(assert (= expect result))

(check-sat)
(exit)
