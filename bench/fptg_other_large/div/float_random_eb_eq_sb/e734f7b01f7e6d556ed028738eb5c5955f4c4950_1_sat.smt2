(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011111100 #b000101100)
                arg1
                (fp #b1 #b0111111111 #b100111111)))
(assert (fp.leq (fp #b1 #b0111111111 #b100111111)
                arg1
                (fp #b0 #b0001001000 #b010010011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0110011100 #b110000100)
                expect
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                expect
                (fp #b0 #b1011111010 #b100000000)))

(assert (= expect result))

(check-sat)
(exit)
