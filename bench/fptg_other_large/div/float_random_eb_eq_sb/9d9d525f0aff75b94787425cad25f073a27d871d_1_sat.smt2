(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000111100 #b111000100)
                arg1
                (fp #b1 #b1000001000 #b101100010)))
(assert (fp.leq (fp #b1 #b1000001000 #b101100010)
                arg1
                (fp #b0 #b0101000100 #b011000001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001001111 #b101001111)
                arg2
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg2
                (fp #b1 #b0110110101 #b000100100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100111001 #b111110101)
                expect
                (fp #b0 #b0111111110 #b101100010)))
(assert (fp.leq (fp #b0 #b0111111110 #b101100010)
                expect
                (fp #b0 #b1101111111 #b001011111)))

(assert (= expect result))

(check-sat)
(exit)
