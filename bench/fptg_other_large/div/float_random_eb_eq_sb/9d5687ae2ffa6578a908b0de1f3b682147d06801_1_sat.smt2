(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010000 #b00111000)
                arg1
                (fp #b1 #b011111111 #b00100101)))
(assert (fp.leq (fp #b1 #b011111111 #b00100101)
                arg1
                (fp #b0 #b001100100 #b00110011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100001 #b11000110)
                arg2
                (fp #b1 #b001010110 #b00101000)))
(assert (fp.leq (fp #b1 #b001010110 #b00101000)
                arg2
                (fp #b0 #b111000000 #b10011011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011110 #b11000011)
                expect
                (fp #b0 #b110100111 #b11111010)))
(assert (fp.leq (fp #b0 #b110100111 #b11111010)
                expect
                (fp #b0 #b110111110 #b01011111)))

(assert (= expect result))

(check-sat)
(exit)
