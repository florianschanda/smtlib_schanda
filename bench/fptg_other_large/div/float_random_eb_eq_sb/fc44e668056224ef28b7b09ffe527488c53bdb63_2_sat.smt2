(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111010101 #b10100111011)
                arg1
                (fp #b1 #b011111111111 #b11001010001)))
(assert (fp.leq (fp #b1 #b011111111111 #b11001010001)
                arg1
                (fp #b0 #b110100111011 #b01101010001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000000)
                arg2
                (fp #b1 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111111)
                arg2
                (fp #b1 #b101101000000 #b01100110000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100000011001 #b11010011001)
                expect
                (fp #b0 #b000000000000 #b01110010101)))
(assert (fp.leq (fp #b0 #b000000000000 #b01110010101)
                expect
                (fp #b0 #b011001111110 #b10101001111)))

(assert (= expect result))

(check-sat)
(exit)
