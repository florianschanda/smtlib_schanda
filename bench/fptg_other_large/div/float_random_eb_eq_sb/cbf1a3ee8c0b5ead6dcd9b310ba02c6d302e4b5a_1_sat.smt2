                arg2
                (fp #b0 #b00000000000000 #b0000000000001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000001)
                arg2
                (fp #b0 #b10000111011001 #b0111110100010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01111101000000 #b1111111101110)
                expect
                (fp #b0 #b11111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111111111)
                expect
                (fp #b0 #b11111111111111 #b0000000000000)))

(assert (= expect result))

(check-sat)
(exit)
