(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011100101100110 #b111010100001000)
                arg1
                (fp #b1 #b0000000000000000 #b111111111111111)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b111111111111111)
                arg1
                (fp #b0 #b0110100111110011 #b111010110001101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010111110110110 #b001111000111100)
                arg2
                (fp #b1 #b0000000000000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b001010111010001)
                arg2
                (fp #b0 #b1001101110000001 #b010010011011011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110111011000111 #b001011011001010)
                expect
                (fp #b0 #b1000000000000001 #b011101110111110)))
(assert (fp.leq (fp #b0 #b1000000000000001 #b011101110111110)
                expect
                (fp #b0 #b1100111010110000 #b110011010000001)))

(assert (= expect result))

(check-sat)
(exit)
