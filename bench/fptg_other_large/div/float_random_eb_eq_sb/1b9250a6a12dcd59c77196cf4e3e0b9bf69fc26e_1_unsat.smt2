(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110100100 #b1010011111)
                arg1
                (fp #b1 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000)
                arg1
                (fp #b0 #b11001101011 #b0001000011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110100100 #b0000001001)
                arg2
                (fp #b1 #b11110100000 #b1100010110)))
(assert (fp.leq (fp #b1 #b11110100000 #b1100010110)
                arg2
                (fp #b1 #b00100100001 #b1111101111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101110110 #b0101010011)
                expect
                (fp #b0 #b00001011101 #b0010000100)))
(assert (fp.leq (fp #b0 #b00001011101 #b0010000100)
                expect
                (fp #b0 #b11101111111 #b1010101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
