(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010000100 #b1001100001)
                arg1
                (fp #b0 #b10000001001 #b1101010000)))
(assert (fp.leq (fp #b0 #b10000001001 #b1101010000)
                arg1
                (fp #b0 #b11110010001 #b1010100110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111111010 #b1011100100)
                arg2
                (fp #b0 #b00000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110100111)
                arg2
                (fp #b0 #b00101100000 #b0000000110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00011010100 #b1110111010)
                expect
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000)))

(assert (= expect result))

(check-sat)
(exit)
