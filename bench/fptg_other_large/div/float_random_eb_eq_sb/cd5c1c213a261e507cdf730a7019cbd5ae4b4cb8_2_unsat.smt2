; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011011101 #b01101111111)
                arg1
                (fp #b1 #b010000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b00000000000)
                arg1
                (fp #b0 #b011001111111 #b11101101100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111100100 #b10000101010)
                arg2
                (fp #b1 #b011111111111 #b00110001010)))
(assert (fp.leq (fp #b1 #b011111111111 #b00110001010)
                arg2
                (fp #b0 #b001111111100 #b10010011101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000010100010 #b11110100101)
                expect
                (fp #b0 #b001111111111 #b10101101100)))
(assert (fp.leq (fp #b0 #b001111111111 #b10101101100)
                expect
                (fp #b0 #b101010010000 #b01010010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
