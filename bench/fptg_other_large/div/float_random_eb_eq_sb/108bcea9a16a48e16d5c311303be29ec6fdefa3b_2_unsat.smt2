; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110101010000000 #b00011000011000)
                arg1
                (fp #b1 #b100000100101000 #b00100010100001)))
(assert (fp.leq (fp #b1 #b100000100101000 #b00100010100001)
                arg1
                (fp #b0 #b001110010111111 #b00100110011000)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011111110011101 #b10111111100001)
                arg2
                (fp #b1 #b000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000000)
                arg2
                (fp #b0 #b001001101001110 #b10100010111100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
