(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000101010 #b1110110111)
                arg1
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b00100101100 #b1111001110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110000001 #b0101010101)
                arg2
                (fp #b0 #b00000000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001110101)
                arg2
                (fp #b0 #b01001011000 #b0110000011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000011011 #b0000010000)
                expect
                (fp #b0 #b10000000010 #b0001011111)))
(assert (fp.leq (fp #b0 #b10000000010 #b0001011111)
                expect
                (fp #b0 #b10010001010 #b0011101100)))

(assert (= expect result))

(check-sat)
(exit)
