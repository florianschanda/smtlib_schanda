(assert (fp.leq (fp #b0 #b10000000111 #b1011011100)
                arg2
                (fp #b0 #b11011001101 #b0111011101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110001100 #b0001001101)
                expect
                (fp #b0 #b00111110010 #b0010101011)))
(assert (fp.leq (fp #b0 #b00111110010 #b0010101011)
                expect
                (fp #b0 #b11100101001 #b1101111000)))

(assert (not (= expect result)))

