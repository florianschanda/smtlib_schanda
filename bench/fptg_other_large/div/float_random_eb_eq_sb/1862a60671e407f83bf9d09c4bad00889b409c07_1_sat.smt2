                arg2
                (fp #b0 #b10110000110 #b0001100011)))
(assert (fp.leq (fp #b0 #b10110000110 #b0001100011)
                arg2
                (fp #b0 #b11010000111 #b0011110101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101000110 #b0111001010)
                expect
                (fp #b0 #b01010000010 #b1010101010)))
(assert (fp.leq (fp #b0 #b01010000010 #b1010101010)
                expect
                (fp #b0 #b10010101011 #b1101000100)))

(assert (= expect result))

(check-sat)
(exit)
