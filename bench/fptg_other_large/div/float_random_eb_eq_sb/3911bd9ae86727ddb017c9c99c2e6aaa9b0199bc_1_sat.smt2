(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110010010 #b1000101100)
                arg1
                (fp #b1 #b01111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011010000)
                arg1
                (fp #b0 #b01011111111 #b0010011110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110001111 #b1001010000)
                arg2
                (fp #b0 #b01111001011 #b1100000011)))
(assert (fp.leq (fp #b0 #b01111001011 #b1100000011)
                arg2
                (fp #b0 #b10110101110 #b0110100111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111011110 #b1011111010)
                expect
                (fp #b1 #b10000110010 #b0101111101)))
(assert (fp.leq (fp #b1 #b10000110010 #b0101111101)
                expect
                (fp #b0 #b10101000100 #b1010111101)))

(assert (= expect result))

(check-sat)
(exit)
