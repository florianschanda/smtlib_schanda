(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000111100 #b11101010)
                arg1
                (fp #b1 #b000000000 #b00010111)))
(assert (fp.leq (fp #b1 #b000000000 #b00010111)
                arg1
                (fp #b0 #b101101000 #b10111100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001100011 #b10001010)
                arg2
                (fp #b0 #b011111111 #b11100111)))
(assert (fp.leq (fp #b0 #b011111111 #b11100111)
                arg2
                (fp #b0 #b101001000 #b11011100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011101 #b11011111)
                expect
                (fp #b1 #b000000000 #b00001101)))
(assert (fp.leq (fp #b1 #b000000000 #b00001101)
                expect
                (fp #b0 #b000001000 #b10100110)))

(assert (= expect result))

(check-sat)
(exit)
