; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101011101 #b0010111000)
                arg1
                (fp #b1 #b10000000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000100000)
                arg1
                (fp #b0 #b11100111000 #b0100010100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011011001 #b1010000010)
                arg2
                (fp #b1 #b01000011101 #b0111100011)))
(assert (fp.leq (fp #b1 #b01000011101 #b0111100011)
                arg2
                (fp #b0 #b01010101111 #b1101010111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00110100000 #b1000111110)
                expect
                (fp #b0 #b10111101000 #b0110011100)))
(assert (fp.leq (fp #b0 #b10111101000 #b0110011100)
                expect
                (fp #b0 #b11110101001 #b0000011101)))

(assert (= expect result))

(check-sat)
(exit)
