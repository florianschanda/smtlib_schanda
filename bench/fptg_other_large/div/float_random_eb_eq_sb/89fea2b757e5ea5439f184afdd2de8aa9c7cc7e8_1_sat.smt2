; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111001111101 #b11000101111)
                arg1
                (fp #b1 #b011111111111 #b11001010001)))
(assert (fp.leq (fp #b1 #b011111111111 #b11001010001)
                arg1
                (fp #b0 #b110001001110 #b00101101011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100010100 #b00100110100)
                arg2
                (fp #b0 #b100000001000 #b10100111100)))
(assert (fp.leq (fp #b0 #b100000001000 #b10100111100)
                arg2
                (fp #b0 #b101110101011 #b01011111010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101000111110 #b01100000000)
                expect
                (fp #b1 #b011111110110 #b00010100111)))
(assert (fp.leq (fp #b1 #b011111110110 #b00010100111)
                expect
                (fp #b0 #b001110001111 #b10101011001)))

(assert (= expect result))

(check-sat)
(exit)
