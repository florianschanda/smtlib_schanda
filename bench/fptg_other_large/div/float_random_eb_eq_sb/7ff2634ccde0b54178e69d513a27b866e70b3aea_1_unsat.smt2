                (fp #b0 #b01111111111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100011010)
                arg2
                (fp #b0 #b11011111001 #b1110111010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110110101 #b0101111100)
                expect
                (fp #b1 #b10000000110 #b1001110111)))
(assert (fp.leq (fp #b1 #b10000000110 #b1001110111)
                expect
                (fp #b1 #b01001101001 #b0111110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
