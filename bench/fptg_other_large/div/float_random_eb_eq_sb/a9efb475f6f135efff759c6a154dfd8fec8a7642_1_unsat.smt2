; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011110001 #b110110000)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b0110001001 #b110000010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011011010 #b101000011)
                arg2
                (fp #b1 #b0110100111 #b001011001)))
(assert (fp.leq (fp #b1 #b0110100111 #b001011001)
                arg2
                (fp #b1 #b0110000100 #b011010100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111110011 #b101011101)
                expect
                (fp #b1 #b0111011111 #b101000011)))
(assert (fp.leq (fp #b1 #b0111011111 #b101000011)
                expect
                (fp #b0 #b1100011100 #b001010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
