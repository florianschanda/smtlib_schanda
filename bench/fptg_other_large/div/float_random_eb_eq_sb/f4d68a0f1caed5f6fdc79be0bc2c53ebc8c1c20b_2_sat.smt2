(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01110110011 #b1111001000)
                arg1
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b00010100101 #b1010100010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00100010100 #b1100110001)
                arg2
                (fp #b0 #b10000000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000000111 #b1011011100)
                arg2
                (fp #b0 #b11100101110 #b0001110000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00000001011 #b1011101101)
                expect
                (fp #b0 #b00000000000 #b0000000011)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000011)
                expect
                (fp #b0 #b01011101101 #b1001101000)))

(assert (= expect result))

(check-sat)
(exit)
