(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110111110 #b001100101)
                arg1
                (fp #b1 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0100000000 #b000000000)
                arg1
                (fp #b0 #b0010011001 #b101111111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100100010 #b101110000)
                arg2
                (fp #b1 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b111111111)
                arg2
                (fp #b0 #b0010011001 #b111001110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010011110 #b101101110)
                expect
                (fp #b0 #b1011111110 #b000000010)))
(assert (fp.leq (fp #b0 #b1011111110 #b000000010)
                expect
                (fp #b0 #b1111000010 #b100101101)))

(assert (= expect result))

(check-sat)
(exit)
