(assert (fp.leq (fp #b1 #b1101111001100001 #b011101100001111)
                arg2
                (fp #b0 #b1011110110101010 #b110111000011000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111011100001011 #b001011000100101)
                expect
                (fp #b1 #b1010000110011010 #b010111100101100)))
(assert (fp.leq (fp #b1 #b1010000110011010 #b010111100101100)
                expect
                (fp #b0 #b1010100011110110 #b100000000111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
