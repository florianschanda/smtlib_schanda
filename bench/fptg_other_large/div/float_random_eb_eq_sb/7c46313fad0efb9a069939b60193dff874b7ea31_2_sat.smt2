; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010110110 #b00010101011)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b0 #b011000111101 #b00100001100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000100110 #b10011101010)
                arg2
                (fp #b1 #b100000001001 #b01000011110)))
(assert (fp.leq (fp #b1 #b100000001001 #b01000011110)
                arg2
                (fp #b0 #b011100100100 #b10000010000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010111110000 #b10101010010)
                expect
                (fp #b0 #b100000010110 #b00011101111)))
(assert (fp.leq (fp #b0 #b100000010110 #b00011101111)
                expect
                (fp #b0 #b101110000001 #b10111101000)))

(assert (= expect result))

(check-sat)
(exit)
