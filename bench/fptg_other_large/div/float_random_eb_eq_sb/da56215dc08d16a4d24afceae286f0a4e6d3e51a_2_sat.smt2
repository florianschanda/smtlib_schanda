; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111010111 #b10110010011)
                arg1
                (fp #b0 #b011111111111 #b01110010110)))
(assert (fp.leq (fp #b0 #b011111111111 #b01110010110)
                arg1
                (fp #b0 #b101110000010 #b11111000101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101001010001 #b00110101101)
                arg2
                (fp #b0 #b000000000000 #b10101111011)))
(assert (fp.leq (fp #b0 #b000000000000 #b10101111011)
                arg2
                (fp #b0 #b011100001111 #b00011111111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010101011010 #b10011101100)
                expect
                (fp #b0 #b111111111110 #b00001110101)))
(assert (fp.leq (fp #b0 #b111111111110 #b00001110101)
                expect
                (fp #b0 #b111111111110 #b11010011010)))

(assert (= expect result))

(check-sat)
(exit)
