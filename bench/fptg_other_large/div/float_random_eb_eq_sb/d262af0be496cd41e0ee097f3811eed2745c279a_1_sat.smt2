(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000100110 #b01001000)
                arg1
                (fp #b1 #b000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000)
                arg1
                (fp #b0 #b000011111 #b10111001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010000011 #b10000010)
                arg2
                (fp #b0 #b100000111 #b01000010)))
(assert (fp.leq (fp #b0 #b100000111 #b01000010)
                arg2
                (fp #b0 #b100110001 #b00010101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000100101 #b11100100)
                expect
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                expect
                (fp #b0 #b011101010 #b00000111)))

(assert (= expect result))

(check-sat)
(exit)
