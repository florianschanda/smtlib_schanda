; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011001 #b01111001)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b0 #b101111100 #b11110010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111100 #b11010010)
                arg2
                (fp #b1 #b001010110 #b00101000)))
(assert (fp.leq (fp #b1 #b001010110 #b00101000)
                arg2
                (fp #b1 #b001001100 #b00111110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001011010 #b11111011)
                expect
                (fp #b0 #b101010011 #b00000110)))
(assert (fp.leq (fp #b0 #b101010011 #b00000110)
                expect
                (fp #b0 #b110010100 #b01111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
