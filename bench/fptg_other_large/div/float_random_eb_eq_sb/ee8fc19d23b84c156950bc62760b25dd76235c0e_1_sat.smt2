; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001001010101 #b00001001001)
                arg1
                (fp #b1 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000001)
                arg1
                (fp #b0 #b101111011100 #b01101111000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000011100001 #b11110110000)
                arg2
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg2
                (fp #b0 #b111001011101 #b00011110011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000010001000 #b01101101111)
                expect
                (fp #b0 #b011111110100 #b00000000001)))
(assert (fp.leq (fp #b0 #b011111110100 #b00000000001)
                expect
                (fp #b0 #b110111111110 #b01101100000)))

(assert (= expect result))

(check-sat)
(exit)
