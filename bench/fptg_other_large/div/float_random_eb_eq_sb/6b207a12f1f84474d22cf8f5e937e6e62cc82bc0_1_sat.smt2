;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0000000101111110 #b000110001011110)
                arg1
                (fp #b0 #b1000000000001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b000110010000101)
                arg1
                (fp #b0 #b1100011111001100 #b001101010101110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101010111000110 #b011011110100100)
                expect
                (fp #b0 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000000000000000)
                expect
                (fp #b0 #b1101111001011010 #b101010100011111)))

(assert (= expect result))

(check-sat)
(exit)
