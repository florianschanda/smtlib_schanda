(assert (fp.leq (fp #b0 #b000111110001 #b10101100110)
                arg2
                (fp #b0 #b011111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b011111111111 #b01111100000)
                arg2
                (fp #b0 #b110010101100 #b10100011000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100001110010 #b01101001010)
                expect
                (fp #b0 #b011111111110 #b01011000111)))
(assert (fp.leq (fp #b0 #b011111111110 #b01011000111)
                expect
                (fp #b0 #b110000000011 #b11011100110)))

(assert (= expect result))

(check-sat)
(exit)
