; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100110101001100 #b11010110101100)
                arg1
                (fp #b1 #b100000000001100 #b11101100010010)))
(assert (fp.leq (fp #b1 #b100000000001100 #b11101100010010)
                arg1
                (fp #b1 #b010100101101000 #b01110100010101)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b101011100001100 #b10011011000011)
                arg2
                (fp #b0 #b111101111010010 #b10111001100110)))
(assert (fp.leq (fp #b0 #b111101111010010 #b10111001100110)
                arg2
                (fp #b0 #b111111101111100 #b01110000001010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110011101010011 #b11010011011101)
                expect
                (fp #b1 #b000010000111001 #b00011101011001)))
(assert (fp.leq (fp #b1 #b000010000111001 #b00011101011001)
                expect
                (fp #b0 #b100000111100001 #b10001000100110)))

(assert (= expect result))

(check-sat)
(exit)
