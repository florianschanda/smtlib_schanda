                arg2
                (fp #b0 #b1111111111111 #b000000000000)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1000101111000 #b001001100000)
                expect
                (fp #b0 #b0111011011001 #b000011011010)))
(assert (fp.leq (fp #b0 #b0111011011001 #b000011011010)
                expect
                (fp #b0 #b1010000110111 #b101111101101)))

(assert (not (= expect result)))

