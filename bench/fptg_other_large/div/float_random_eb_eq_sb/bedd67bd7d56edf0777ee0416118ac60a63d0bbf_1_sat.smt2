(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100111100 #b011001101)
                arg1
                (fp #b1 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000001)
                arg1
                (fp #b0 #b0000110100 #b010010100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001011001 #b100110100)
                arg2
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg2
                (fp #b0 #b1011110001 #b010110111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1110000101 #b101100110)
                expect
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0000100001 #b100111110)))

(assert (= expect result))

(check-sat)
(exit)
