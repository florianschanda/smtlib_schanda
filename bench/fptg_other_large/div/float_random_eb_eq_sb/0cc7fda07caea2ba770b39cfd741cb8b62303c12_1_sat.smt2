                arg2
                (fp #b0 #b101101100001100 #b11001100100001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111000000011110 #b10100001111011)
                expect
                (fp #b1 #b011000110110001 #b01101001100100)))
(assert (fp.leq (fp #b1 #b011000110110001 #b01101001100100)
                expect
                (fp #b0 #b110100011101010 #b11101011001011)))

(assert (= expect result))

(check-sat)
