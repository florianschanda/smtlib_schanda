(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110000001111 #b0100100000010)
                arg1
                (fp #b1 #b10001011000011 #b0100010110000)))
(assert (fp.leq (fp #b1 #b10001011000011 #b0100010110000)
                arg1
                (fp #b0 #b11110000110111 #b0000111001011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000100000110 #b1010001110111)
                arg2
                (fp #b1 #b01111111111111 #b0100110110011)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0100110110011)
                arg2
                (fp #b0 #b10111101011000 #b0010011001001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110100011101 #b1111010100010)
                expect
                (fp #b0 #b10001011000010 #b1111001110010)))
(assert (fp.leq (fp #b0 #b10001011000010 #b1111001110010)
                expect
                (fp #b0 #b10101100100100 #b1111101110000)))

(assert (= expect result))

(check-sat)
(exit)
