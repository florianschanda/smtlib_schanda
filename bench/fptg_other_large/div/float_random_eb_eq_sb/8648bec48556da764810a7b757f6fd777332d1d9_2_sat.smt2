(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011100101 #b011111101)
                arg1
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg1
                (fp #b1 #b0110111010 #b011000000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000001101 #b111011111)
                arg2
                (fp #b1 #b1000000111 #b001100100)))
(assert (fp.leq (fp #b1 #b1000000111 #b001100100)
                arg2
                (fp #b0 #b1000010100 #b100100100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001111011 #b111011100)
                expect
                (fp #b0 #b1000000000 #b101011001)))
(assert (fp.leq (fp #b0 #b1000000000 #b101011001)
                expect
                (fp #b0 #b1001101110 #b000000001)))

(assert (= expect result))

(check-sat)
(exit)
