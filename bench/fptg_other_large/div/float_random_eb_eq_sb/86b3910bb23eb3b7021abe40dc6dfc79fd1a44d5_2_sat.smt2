;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110011001111 #b1100001011001)
                arg1
                (fp #b1 #b11101110010101 #b1000100010010)))
(assert (fp.leq (fp #b1 #b11101110010101 #b1000100010010)
                arg1
                (fp #b0 #b10001010110000 #b0001001011010)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111101110111 #b0100000000000)
                arg2
                (fp #b1 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b1 #b00111111111001 #b0110101000001)
                arg2
                (fp #b1 #b00010000011011 #b1001110001001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
