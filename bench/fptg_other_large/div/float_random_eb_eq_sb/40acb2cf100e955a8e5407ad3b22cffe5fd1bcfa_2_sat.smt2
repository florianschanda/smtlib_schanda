(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010010010000 #b01001001010)
                arg1
                (fp #b0 #b101111101111 #b00110110010)))
(assert (fp.leq (fp #b0 #b101111101111 #b00110110010)
                arg1
                (fp #b0 #b111001111100 #b10011101111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110000110 #b10111101100)
                arg2
                (fp #b0 #b011111111111 #b10011001100)))
(assert (fp.leq (fp #b0 #b011111111111 #b10011001100)
                arg2
                (fp #b0 #b111010110101 #b11100100000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000010011 #b01010000101)
                expect
                (fp #b0 #b101111101110 #b10000100000)))
(assert (fp.leq (fp #b0 #b101111101110 #b10000100000)
                expect
                (fp #b0 #b110011010001 #b00100100100)))

(assert (= expect result))

(check-sat)
(exit)
