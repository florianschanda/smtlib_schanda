; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010010100001111 #b101101000111010)
                arg1
                (fp #b0 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111111)
                arg1
                (fp #b0 #b1111111111111111 #b000000000000000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110111010011000 #b100100010001001)
                arg2
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                arg2
                (fp #b0 #b0100011101100001 #b000111000110101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000000)
                expect
                (fp #b1 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111111)
                expect
                (fp #b1 #b0010001000100011 #b010110100100101)))

(assert (= expect result))

(check-sat)
(exit)
