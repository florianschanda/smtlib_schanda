;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100001010111111 #b110010101101101)
                arg1
                (fp #b1 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b000000000000000)
                arg1
                (fp #b1 #b0001101011101110 #b101100001000100)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111110001100101 #b010100100101010)
                arg2
                (fp #b0 #b0011001100000010 #b101011011101100)))
(assert (fp.leq (fp #b0 #b0011001100000010 #b101011011101100)
                arg2
                (fp #b0 #b0111001111100101 #b101110001001111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100110101111010 #b011000000101011)
                expect
                (fp #b1 #b1100110011111011 #b001100001110110)))
(assert (fp.leq (fp #b1 #b1100110011111011 #b001100001110110)
                expect
                (fp #b0 #b1011001001101110 #b000111111001110)))

(assert (= expect result))

(check-sat)
(exit)
