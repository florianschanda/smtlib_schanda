(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000011010 #b1011111111)
                arg1
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                arg1
                (fp #b0 #b11111111111 #b0000000000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101100101 #b0110000101)
                arg2
                (fp #b1 #b01000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000)
                arg2
                (fp #b0 #b11011010010 #b0010101010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
