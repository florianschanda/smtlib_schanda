; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001110111011 #b01111110101)
                arg1
                (fp #b0 #b011001101100 #b01001001000)))
(assert (fp.leq (fp #b0 #b011001101100 #b01001001000)
                arg1
                (fp #b0 #b110010011100 #b10101100000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011000011 #b11111001110)
                arg2
                (fp #b1 #b110001100101 #b10101001100)))
(assert (fp.leq (fp #b1 #b110001100101 #b10101001100)
                arg2
                (fp #b1 #b011110000100 #b01110011100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010110101010 #b10010100010)
                expect
                (fp #b1 #b001000000101 #b10001011111)))
(assert (fp.leq (fp #b1 #b001000000101 #b10001011111)
                expect
                (fp #b0 #b011010010000 #b10100011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
