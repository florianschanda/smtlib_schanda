;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01000010100101 #b1111110011010)
                arg1
                (fp #b0 #b10000000001011 #b1011101000110)))
(assert (fp.leq (fp #b0 #b10000000001011 #b1011101000110)
                arg1
                (fp #b0 #b10110001001010 #b0001000110101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010111100000 #b1010000010010)
                arg2
                (fp #b0 #b00000000000000 #b1111111111111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111111111111)
                arg2
                (fp #b0 #b01110100101101 #b0101111011000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
