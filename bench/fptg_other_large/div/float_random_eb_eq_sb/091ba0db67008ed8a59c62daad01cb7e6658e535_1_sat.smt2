; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111110011011111 #b10001011010000)
                arg1
                (fp #b0 #b110011011101010 #b10010110100010)))
(assert (fp.leq (fp #b0 #b110011011101010 #b10010110100010)
                arg1
                (fp #b0 #b110011111100001 #b00001011000100)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010110001110010 #b00101110101010)
                expect
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b011011111110011 #b00010110000111)))

(assert (= expect result))

(check-sat)
(exit)
