(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111010001010 #b110110010110010)
                arg1
                (fp #b1 #b1111001000110110 #b011010010000011)))
(assert (fp.leq (fp #b1 #b1111001000110110 #b011010010000011)
                arg1
                (fp #b1 #b0011000000100001 #b110010010010010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011010011110101 #b001111110011101)
                arg2
                (fp #b0 #b0011001100000010 #b101011011101100)))
(assert (fp.leq (fp #b0 #b0011001100000010 #b101011011101100)
                arg2
                (fp #b0 #b0100100001111100 #b110111011000010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000000)
                expect
                (fp #b1 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111111)
                expect
                (fp #b0 #b1011111101110100 #b101100101001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
