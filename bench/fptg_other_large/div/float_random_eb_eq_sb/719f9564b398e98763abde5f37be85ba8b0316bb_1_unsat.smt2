(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100111001011111 #b01011101101101)
                expect
                (fp #b0 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b111110111101001 #b01011000110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
