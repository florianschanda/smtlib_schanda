(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100100011 #b10000011)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b0 #b100010010 #b10111011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111010011 #b00100011)
                arg2
                (fp #b1 #b000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b000000001 #b00000000)
                arg2
                (fp #b0 #b101111001 #b01101010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110000100 #b11111010)
                expect
                (fp #b0 #b110101000 #b00101111)))
(assert (fp.leq (fp #b0 #b110101000 #b00101111)
                expect
                (fp #b0 #b111111110 #b01011001)))

(assert (= expect result))

(check-sat)
(exit)
