; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111011 #b00001001)
                arg1
                (fp #b0 #b100000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000010 #b00100000)
                arg1
                (fp #b0 #b100100111 #b10110001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010011000 #b01110010)
                arg2
                (fp #b0 #b100000111 #b01000010)))
(assert (fp.leq (fp #b0 #b100000111 #b01000010)
                arg2
                (fp #b0 #b101001010 #b10111000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110100 #b11011001)
                expect
                (fp #b0 #b011111001 #b11001001)))
(assert (fp.leq (fp #b0 #b011111001 #b11001001)
                expect
                (fp #b0 #b110111001 #b00010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
