; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b100010100011010100 #b01001011110111101)
                arg1
                (fp #b1 #b011111111111111111 #b01001001101111010)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b01001001101111010)
                arg1
                (fp #b1 #b011001001101010111 #b11001101000011111)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101100100100011111 #b11011010110111100)
                expect
                (fp #b0 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b000101001110110011 #b00100001010111101)))

(assert (= expect result))

(check-sat)
(exit)
