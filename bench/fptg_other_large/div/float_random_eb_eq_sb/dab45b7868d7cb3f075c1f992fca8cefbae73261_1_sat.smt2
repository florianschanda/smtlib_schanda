; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001000101110000 #b111001100010111)
                arg1
                (fp #b1 #b0000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010000000000000)
                arg1
                (fp #b0 #b0111000110101111 #b000101011111010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011010101110100 #b010011101011110)
                arg2
                (fp #b0 #b0000000000000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100100100100110)
                arg2
                (fp #b0 #b1101111011010011 #b000010100111110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100111000000000 #b100000100011010)
                expect
                (fp #b1 #b0111111111111101 #b101111111111011)))
(assert (fp.leq (fp #b1 #b0111111111111101 #b101111111111011)
                expect
                (fp #b0 #b0111110001001010 #b011110000010011)))

(assert (= expect result))

(check-sat)
(exit)
