                arg2
                (fp #b0 #b0101001101111001 #b001011011101111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100110110110100 #b100000000011010)
                expect
                (fp #b0 #b0110011110010010 #b101000010010001)))
(assert (fp.leq (fp #b0 #b0110011110010010 #b101000010010001)
                expect
                (fp #b0 #b1001011111100111 #b100111011101101)))

(assert (not (= expect result)))

