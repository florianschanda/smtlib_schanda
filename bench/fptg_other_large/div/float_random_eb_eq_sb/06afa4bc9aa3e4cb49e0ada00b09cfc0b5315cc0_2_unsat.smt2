;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000001001001101 #b10101011010100)
                arg1
                (fp #b0 #b111111101001001 #b01000110100101)))
(assert (fp.leq (fp #b0 #b111111101001001 #b01000110100101)
                arg1
                (fp #b0 #b111111111011000 #b01000001011001)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000111010101100 #b11101110101001)
                arg2
                (fp #b0 #b000000000000001 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b00000000000000)
                arg2
                (fp #b0 #b010111011000101 #b00001111000010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
