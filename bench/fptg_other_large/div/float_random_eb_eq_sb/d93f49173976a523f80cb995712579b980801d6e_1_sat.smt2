(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100010000 #b01011000001)
                arg1
                (fp #b1 #b010011011101 #b01111010101)))
(assert (fp.leq (fp #b1 #b010011011101 #b01111010101)
                arg1
                (fp #b0 #b101000110011 #b01000100101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000100010101 #b00100000101)
                arg2
                (fp #b0 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b11111111111)
                arg2
                (fp #b0 #b111010001110 #b01110110011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011111001 #b11111000101)
                expect
                (fp #b1 #b000011011101 #b01111010101)))
(assert (fp.leq (fp #b1 #b000011011101 #b01111010101)
                expect
                (fp #b0 #b001100110101 #b11010100110)))

(assert (= expect result))

(check-sat)
(exit)
