(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100110000100 #b1101100000110)
                arg1
                (fp #b1 #b10000000001100 #b0001100110010)))
(assert (fp.leq (fp #b1 #b10000000001100 #b0001100110010)
                arg1
                (fp #b0 #b01010100000110 #b1000010001011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00101010101110 #b1011000111101)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b10000101110111 #b1100101011001)))

(assert (= expect result))

(check-sat)
(exit)
