(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001110111 #b0000010101)
                arg1
                (fp #b0 #b01111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000)
                arg1
                (fp #b0 #b11000101101 #b0111010010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110101110 #b1110111001)
                arg2
                (fp #b0 #b10000000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000000111 #b1011011100)
                arg2
                (fp #b0 #b11010011001 #b0100001000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110110110 #b0111011000)
                expect
                (fp #b0 #b01111110110 #b0010101010)))
(assert (fp.leq (fp #b0 #b01111110110 #b0010101010)
                expect
                (fp #b0 #b10110010111 #b1111010101)))

(assert (= expect result))

(check-sat)
(exit)
