                arg2
                (fp #b0 #b111011111 #b11011111)))
(assert (fp.leq (fp #b0 #b111011111 #b11011111)
                arg2
                (fp #b0 #b111111110 #b00111110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101011 #b11001010)
                expect
                (fp #b0 #b011100001 #b01001111)))
(assert (fp.leq (fp #b0 #b011100001 #b01001111)
                expect
                (fp #b0 #b101111110 #b00000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
