(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1111011101001010 #b011001110101100)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                arg1
                (fp #b0 #b0100000110101101 #b011100110001101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1110110001101001 #b101010001011101)
                expect
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b1111110001011110 #b001101110010101)))

(assert (= expect result))

(check-sat)
(exit)
