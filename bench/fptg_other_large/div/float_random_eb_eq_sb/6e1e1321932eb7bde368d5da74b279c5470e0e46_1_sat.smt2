(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00100000110010 #b0001001100010)
                arg1
                (fp #b0 #b00000000000000 #b1101100101001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1101100101001)
                arg1
                (fp #b0 #b10010100111111 #b0101000100101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01101011000000 #b0011100001100)
                arg2
                (fp #b0 #b11011111000000 #b0111001101001)))
(assert (fp.leq (fp #b0 #b11011111000000 #b0111001101001)
                arg2
                (fp #b0 #b11101001001110 #b0011000100001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01101110100101 #b1111001001000)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b01101001000111 #b0010111110001)))

(assert (= expect result))

(check-sat)
(exit)
