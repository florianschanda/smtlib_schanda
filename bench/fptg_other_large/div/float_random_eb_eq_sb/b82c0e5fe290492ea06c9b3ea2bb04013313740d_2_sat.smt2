;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011101001110 #b01010010110)
                arg1
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                arg1
                (fp #b0 #b011011011010 #b00110110000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011100001011 #b11011110100)
                arg2
                (fp #b0 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b11111111111)
                arg2
                (fp #b0 #b000110100101 #b11001010110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110001011 #b00110001010)
                expect
                (fp #b1 #b111011010101 #b00000111100)))
(assert (fp.leq (fp #b1 #b111011010101 #b00000111100)
                expect
                (fp #b0 #b110001001110 #b11101101100)))

(assert (= expect result))

(check-sat)
(exit)
