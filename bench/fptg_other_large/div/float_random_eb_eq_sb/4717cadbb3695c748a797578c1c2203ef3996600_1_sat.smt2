;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001101000 #b01011110)
                arg1
                (fp #b0 #b100000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000010 #b00100000)
                arg1
                (fp #b0 #b110110100 #b00110100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111001 #b10101011)
                arg2
                (fp #b1 #b010000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000 #b00000000)
                arg2
                (fp #b0 #b110001100 #b10000001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101011 #b00111111)
                expect
                (fp #b1 #b110000001 #b00100000)))
(assert (fp.leq (fp #b1 #b110000001 #b00100000)
                expect
                (fp #b0 #b101101000 #b01111111)))

(assert (= expect result))

(check-sat)
(exit)
