                (fp #b0 #b0010100011 #b000000000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011111111 #b100001011)
                arg2
                (fp #b0 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000001)
                arg2
                (fp #b0 #b1100101011 #b001111101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101101111 #b111111011)
                expect
                (fp #b1 #b1100000010 #b011010100)))
(assert (fp.leq (fp #b1 #b1100000010 #b011010100)
                expect
                (fp #b1 #b0001011010 #b010000000)))

(assert (= expect result))

(check-sat)
(exit)
