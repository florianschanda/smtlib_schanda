                expect
                (fp #b1 #b0110011000100101 #b011101101001010)))
(assert (fp.leq (fp #b1 #b0110011000100101 #b011101101001010)
                expect
                (fp #b1 #b0000000001100100 #b100011100100101)))

(assert (= expect result))

