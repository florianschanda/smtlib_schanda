(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100110000001101 #b011101111100011)
                expect
                (fp #b1 #b0001101111101010 #b100100000010000)))
(assert (fp.leq (fp #b1 #b0001101111101010 #b100100000010000)
                expect
                (fp #b0 #b1101100000111000 #b101010000010110)))

(assert (not (= expect result)))

(check-sat)
