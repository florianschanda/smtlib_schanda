                arg2
                (fp #b0 #b000000111001 #b00111001101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101111111010 #b00101101011)
                expect
                (fp #b1 #b011111111111 #b01110101100)))
(assert (fp.leq (fp #b1 #b011111111111 #b01110101100)
                expect
                (fp #b0 #b010011001101 #b00111110000)))

(assert (not (= expect result)))

(check-sat)
