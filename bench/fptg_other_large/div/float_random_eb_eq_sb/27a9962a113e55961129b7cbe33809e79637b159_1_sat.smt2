; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111001110101 #b11100100000)
                arg1
                (fp #b0 #b000000000000 #b01000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b01000000000)
                arg1
                (fp #b0 #b111101000110 #b10110100110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010001010011 #b10010100001)
                arg2
                (fp #b0 #b011010001000 #b01001001111)))
(assert (fp.leq (fp #b0 #b011010001000 #b01001001111)
                arg2
                (fp #b0 #b100110110100 #b01101001000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101010010001 #b10101011001)
                expect
                (fp #b0 #b000101110101 #b10001101010)))
(assert (fp.leq (fp #b0 #b000101110101 #b10001101010)
                expect
                (fp #b0 #b111001011111 #b00101000110)))

(assert (= expect result))

(check-sat)
(exit)
