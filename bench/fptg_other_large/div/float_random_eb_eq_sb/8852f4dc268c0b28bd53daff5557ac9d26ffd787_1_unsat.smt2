; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111101101011100 #b10111001111100)
                arg1
                (fp #b1 #b000000000000000 #b00000000000001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000001)
                arg1
                (fp #b0 #b111111100100010 #b01100011001111)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000100000100011 #b11111101011000)
                expect
                (fp #b0 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b001101110001001 #b10010100100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
