; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00101101011 #b1000010100)
                arg1
                (fp #b1 #b00000000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000000 #b1110100001)
                arg1
                (fp #b0 #b00001011101 #b1110110110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011110000 #b0101100011)
                arg2
                (fp #b1 #b01111111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000100111)
                arg2
                (fp #b0 #b10011100010 #b1001001111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110100010 #b1010010100)
                expect
                (fp #b0 #b00000000000 #b1101111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111)
                expect
                (fp #b0 #b01010101111 #b1010110110)))

(assert (= expect result))

(check-sat)
(exit)
