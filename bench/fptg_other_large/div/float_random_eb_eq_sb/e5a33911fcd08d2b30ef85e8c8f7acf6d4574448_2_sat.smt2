; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100101001 #b1001010001)
                arg1
                (fp #b1 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000)
                arg1
                (fp #b0 #b11100110100 #b1010011101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00000101111 #b1110010001)
                arg2
                (fp #b0 #b01111111111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100011010)
                arg2
                (fp #b0 #b10010111110 #b0111111001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101010111 #b1100011010)
                expect
                (fp #b1 #b00000000000 #b0011001001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0011001001)
                expect
                (fp #b0 #b01010111100 #b0110000001)))

(assert (= expect result))

(check-sat)
(exit)
