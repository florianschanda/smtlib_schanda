(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b10100101)
                arg1
                (fp #b1 #b101111110 #b11111111)))
(assert (fp.leq (fp #b1 #b101111110 #b11111111)
                arg1
                (fp #b0 #b011010110 #b00101010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100000000 #b10010111)
                arg2
                (fp #b0 #b000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b000000000 #b11111111)
                arg2
                (fp #b0 #b110011010 #b01101011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                expect
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                expect
                (fp #b0 #b010010101 #b11000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
