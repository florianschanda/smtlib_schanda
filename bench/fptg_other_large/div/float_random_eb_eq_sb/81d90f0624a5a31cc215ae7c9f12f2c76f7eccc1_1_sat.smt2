(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010010010 #b10100111)
                arg1
                (fp #b0 #b100000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000010 #b00100000)
                arg1
                (fp #b0 #b101110001 #b00001001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010111010 #b10011100)
                arg2
                (fp #b0 #b000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b000000000 #b01000011)
                arg2
                (fp #b0 #b101111101 #b00101011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111010111 #b10011110)
                expect
                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                expect
                (fp #b0 #b111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
