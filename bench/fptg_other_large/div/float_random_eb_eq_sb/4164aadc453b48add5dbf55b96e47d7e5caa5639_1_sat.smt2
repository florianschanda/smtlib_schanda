; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101110000 #b0000010110)
                arg1
                (fp #b1 #b10010111000 #b0110101101)))
(assert (fp.leq (fp #b1 #b10010111000 #b0110101101)
                arg1
                (fp #b1 #b01100000111 #b0001000110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100011001 #b1111001001)
                arg2
                (fp #b1 #b01000011101 #b0111100011)))
(assert (fp.leq (fp #b1 #b01000011101 #b0111100011)
                arg2
                (fp #b0 #b10111010110 #b0010100000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01011000000 #b0111110001)
                expect
                (fp #b0 #b11010011001 #b1110110110)))
(assert (fp.leq (fp #b0 #b11010011001 #b1110110110)
                expect
                (fp #b0 #b11111000001 #b0110000000)))

(assert (= expect result))

(check-sat)
(exit)
