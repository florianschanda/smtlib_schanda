(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b000100001 #b10000101)
                arg1
                (fp #b0 #b100011101 #b01011000)))
(assert (fp.leq (fp #b0 #b100011101 #b01011000)
                arg1
                (fp #b0 #b111101011 #b01100110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101110010 #b11110100)
                arg2
                (fp #b1 #b011111111 #b00010001)))
(assert (fp.leq (fp #b1 #b011111111 #b00010001)
                arg2
                (fp #b0 #b101110111 #b01110001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111111 #b01000101)
                expect
                (fp #b1 #b100011101 #b01000010)))
(assert (fp.leq (fp #b1 #b100011101 #b01000010)
                expect
                (fp #b1 #b010101001 #b11101011)))

(assert (= expect result))

(check-sat)
(exit)
