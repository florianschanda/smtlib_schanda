(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110010000 #b00010101110)
                arg1
                (fp #b0 #b111001001001 #b10011000010)))
(assert (fp.leq (fp #b0 #b111001001001 #b10011000010)
                arg1
                (fp #b0 #b111110100001 #b11010001011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101111000011 #b10001110011)
                arg2
                (fp #b1 #b011001001110 #b00100110001)))
(assert (fp.leq (fp #b1 #b011001001110 #b00100110001)
                arg2
                (fp #b0 #b100111001111 #b11010001011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b00110000001)
                expect
                (fp #b1 #b111111111010 #b01100011010)))
(assert (fp.leq (fp #b1 #b111111111010 #b01100011010)
                expect
                (fp #b0 #b100000010101 #b11101100101)))

(assert (= expect result))

(check-sat)
(exit)
