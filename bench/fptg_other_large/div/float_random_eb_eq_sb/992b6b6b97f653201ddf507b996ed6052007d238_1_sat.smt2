(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11011000010101101 #b1001110000000101)
                expect
                (fp #b1 #b00000000000000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0000000000000000)
                expect
                (fp #b0 #b00100101011000101 #b1111100011100010)))

(assert (= expect result))

(check-sat)
(exit)
