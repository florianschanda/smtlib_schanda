(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101101111 #b10110010)
                arg1
                (fp #b1 #b101000011 #b10111100)))
(assert (fp.leq (fp #b1 #b101000011 #b10111100)
                arg1
                (fp #b0 #b000001001 #b10011001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011101 #b00110010)
                arg2
                (fp #b1 #b000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b000000001 #b00000000)
                arg2
                (fp #b0 #b111010110 #b10001100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b000011010 #b01101011)
                expect
                (fp #b0 #b111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111111)
                expect
                (fp #b0 #b111111111 #b00000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
