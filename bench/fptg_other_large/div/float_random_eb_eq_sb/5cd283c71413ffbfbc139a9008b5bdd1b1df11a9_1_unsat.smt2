; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000001110100 #b0111010010111)
                arg1
                (fp #b1 #b01111111111111 #b1100001000110)))
(assert (fp.leq (fp #b1 #b01111111111111 #b1100001000110)
                arg1
                (fp #b0 #b10110001110010 #b0111111111101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00100001011111 #b0000001011110)
                arg2
                (fp #b0 #b11111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111111111)
                arg2
                (fp #b0 #b11111111111111 #b0000000000000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010010010011 #b0101000011110)
                expect
                (fp #b1 #b00000000000000 #b0111000010001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111000010001)
                expect
                (fp #b0 #b10100100111010 #b0011101111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
