(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111110001 #b0101001011)
                arg1
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                arg1
                (fp #b0 #b11000000110 #b0011000000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111100100 #b0001110110)
                arg2
                (fp #b1 #b01111111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011111110)
                arg2
                (fp #b0 #b11111100000 #b1110110110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01011010100 #b0100110101)
                expect
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b11110000001 #b1111100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
