; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001101 #b11110001)
                arg1
                (fp #b1 #b100000111 #b10110100)))
(assert (fp.leq (fp #b1 #b100000111 #b10110100)
                arg1
                (fp #b1 #b010011001 #b01100100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011100 #b01101101)
                arg2
                (fp #b1 #b011111111 #b00010001)))
(assert (fp.leq (fp #b1 #b011111111 #b00010001)
                arg2
                (fp #b0 #b001110011 #b01110001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010110010 #b11011000)
                expect
                (fp #b0 #b100000111 #b10011000)))
(assert (fp.leq (fp #b0 #b100000111 #b10011000)
                expect
                (fp #b0 #b110011100 #b11100111)))

(assert (= expect result))

(check-sat)
(exit)
