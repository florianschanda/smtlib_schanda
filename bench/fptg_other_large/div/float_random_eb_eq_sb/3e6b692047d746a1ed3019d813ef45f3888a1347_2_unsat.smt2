(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010011000100001 #b01100001010110)
                expect
                (fp #b0 #b100000000010110 #b00011101001110)))
(assert (fp.leq (fp #b0 #b100000000010110 #b00011101001110)
                expect
                (fp #b0 #b110111111100100 #b01101100011111)))

(assert (not (= expect result)))

