                (fp #b0 #b101101010110 #b10000100000)))
(assert (fp.leq (fp #b0 #b101101010110 #b10000100000)
                arg2
                (fp #b0 #b101111110011 #b01101111110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000100101110 #b11000100011)
                expect
                (fp #b0 #b101011110010 #b00001101011)))
(assert (fp.leq (fp #b0 #b101011110010 #b00001101011)
                expect
                (fp #b0 #b110000111110 #b01000100110)))

(assert (not (= expect result)))

(check-sat)
