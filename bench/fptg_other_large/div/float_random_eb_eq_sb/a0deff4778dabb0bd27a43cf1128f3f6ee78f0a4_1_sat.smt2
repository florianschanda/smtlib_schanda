; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01111011100000 #b0100000011100)
                arg1
                (fp #b0 #b01111111111111 #b0111001100001)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0111001100001)
                arg1
                (fp #b0 #b10000001110001 #b1010101011111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00010101000101 #b1100110101001)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b01111101101011 #b1111100101000)))

(assert (= expect result))

(check-sat)
(exit)
