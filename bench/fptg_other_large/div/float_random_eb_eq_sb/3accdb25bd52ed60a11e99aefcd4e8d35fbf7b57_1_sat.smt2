; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100111100 #b101110000)
                arg1
                (fp #b0 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000001)
                arg1
                (fp #b0 #b1100110010 #b011100111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110001 #b100101000)
                arg2
                (fp #b0 #b0000110011 #b101111111)))
(assert (fp.leq (fp #b0 #b0000110011 #b101111111)
                arg2
                (fp #b0 #b0111001100 #b011101000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100100110 #b111011001)
                expect
                (fp #b0 #b0111000011 #b001001001)))
(assert (fp.leq (fp #b0 #b0111000011 #b001001001)
                expect
                (fp #b0 #b1110001111 #b111101101)))

(assert (= expect result))

(check-sat)
(exit)
