; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101101001111 #b00101011000)
                arg1
                (fp #b1 #b000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b000000000000 #b11011000100)
                arg1
                (fp #b0 #b111111101100 #b01001010101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b101100001010 #b10000001101)
                arg2
                (fp #b0 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b11111111111)
                arg2
                (fp #b0 #b111011110011 #b01101111100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b100000010010 #b00000100111)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b010000011000 #b00000010101)))

(assert (= expect result))

(check-sat)
(exit)
