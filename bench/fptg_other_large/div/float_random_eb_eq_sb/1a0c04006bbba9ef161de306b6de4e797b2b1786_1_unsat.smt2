;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111010110000 #b1011011010100)
                arg1
                (fp #b1 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b1111111111111)
                arg1
                (fp #b1 #b01001111111010 #b1010011001110)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10011110010001 #b0101100000010)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b00011100010011 #b1000100110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
