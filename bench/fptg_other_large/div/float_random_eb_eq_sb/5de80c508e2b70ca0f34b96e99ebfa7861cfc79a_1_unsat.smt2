; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111011000 #b01000110111)
                arg1
                (fp #b1 #b010011011101 #b01111010101)))
(assert (fp.leq (fp #b1 #b010011011101 #b01111010101)
                arg1
                (fp #b0 #b011011001001 #b10010100000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011011100010 #b01110000101)
                expect
                (fp #b0 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b00000000000)
                expect
                (fp #b0 #b111001011001 #b01000110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
