                arg2
                (fp #b1 #b1011111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1011111111111110 #b111111111111111)
                arg2
                (fp #b0 #b0001100110100000 #b100110110101000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100100011110110 #b011000000000001)
                expect
                (fp #b0 #b0011111111111111 #b011000110111010)))
(assert (fp.leq (fp #b0 #b0011111111111111 #b011000110111010)
                expect
                (fp #b0 #b1101101100101000 #b111011101011001)))

(assert (= expect result))

(check-sat)
(exit)
