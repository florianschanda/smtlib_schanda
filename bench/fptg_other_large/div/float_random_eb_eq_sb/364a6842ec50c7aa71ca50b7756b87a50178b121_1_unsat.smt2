; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01011001011 #b0101111111)
                arg1
                (fp #b0 #b01111111111 #b0101111011)))
(assert (fp.leq (fp #b0 #b01111111111 #b0101111011)
                arg1
                (fp #b0 #b10101010000 #b0111111010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011011010 #b0111010110)
                arg2
                (fp #b0 #b10000001001 #b0100111000)))
(assert (fp.leq (fp #b0 #b10000001001 #b0100111000)
                arg2
                (fp #b0 #b10110101101 #b1100011100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000010101 #b1011100001)
                expect
                (fp #b0 #b01111110101 #b0000110011)))
(assert (fp.leq (fp #b0 #b01111110101 #b0000110011)
                expect
                (fp #b0 #b10011101010 #b0010110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
