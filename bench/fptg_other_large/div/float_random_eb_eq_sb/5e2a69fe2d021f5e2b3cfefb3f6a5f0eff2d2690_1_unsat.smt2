                arg2
                (fp #b1 #b11001110001100 #b1000111110111)))
(assert (fp.leq (fp #b1 #b11001110001100 #b1000111110111)
                arg2
                (fp #b1 #b00111000101110 #b1111100101100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111010101110 #b0110101110101)
                expect
                (fp #b1 #b10101100011111 #b1111111001000)))
(assert (fp.leq (fp #b1 #b10101100011111 #b1111111001000)
                expect
                (fp #b0 #b10110110111111 #b0110110001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
