; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111100101 #b000101000)
                arg1
                (fp #b0 #b0000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b111100110)
                arg1
                (fp #b0 #b1100000111 #b111000010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111000011 #b101111001)
                arg2
                (fp #b0 #b0000000000 #b100001010)))
(assert (fp.leq (fp #b0 #b0000000000 #b100001010)
                arg2
                (fp #b0 #b0001011011 #b010101101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0010000001 #b011110100)
                expect
                (fp #b0 #b0111111111 #b110100111)))
(assert (fp.leq (fp #b0 #b0111111111 #b110100111)
                expect
                (fp #b0 #b1110110100 #b111100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
