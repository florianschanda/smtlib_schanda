;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111001111 #b0001010010)
                arg1
                (fp #b0 #b00000000000 #b1111111000)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111000)
                arg1
                (fp #b0 #b11110101101 #b1011000010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000100000 #b1010101101)
                arg2
                (fp #b1 #b01000011101 #b0111100011)))
(assert (fp.leq (fp #b1 #b01000011101 #b0111100011)
                arg2
                (fp #b1 #b00011000101 #b0110011110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101101011 #b0011001010)
                expect
                (fp #b1 #b00111100010 #b0101100101)))
(assert (fp.leq (fp #b1 #b00111100010 #b0101100101)
                expect
                (fp #b0 #b10001001010 #b1000000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
