(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000011101 #b001101110)
                arg1
                (fp #b1 #b0111111111 #b111000101)))
(assert (fp.leq (fp #b1 #b0111111111 #b111000101)
                arg1
                (fp #b1 #b0110100000 #b001000101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000111011 #b110001000)
                arg2
                (fp #b1 #b0111111111 #b001111111)))
(assert (fp.leq (fp #b1 #b0111111111 #b001111111)
                arg2
                (fp #b1 #b0011111011 #b001110100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0010000000 #b110101001)
                expect
                (fp #b0 #b0111111111 #b100000101)))
(assert (fp.leq (fp #b0 #b0111111111 #b100000101)
                expect
                (fp #b0 #b1101000011 #b100101000)))

(assert (= expect result))

(check-sat)
(exit)
