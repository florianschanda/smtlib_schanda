                (fp #b0 #b10011101111010100 #b1011100110011010)))
(assert (fp.leq (fp #b0 #b10011101111010100 #b1011100110011010)
                arg2
                (fp #b0 #b11100110110011000 #b1000111011010101)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10111101000100001 #b0001111111010000)
                expect
                (fp #b1 #b01100010000101010 #b0001100011001111)))
(assert (fp.leq (fp #b1 #b01100010000101010 #b0001100011001111)
                expect
                (fp #b0 #b10101110010011011 #b1011100100000101)))

(assert (= expect result))

(check-sat)
(exit)
