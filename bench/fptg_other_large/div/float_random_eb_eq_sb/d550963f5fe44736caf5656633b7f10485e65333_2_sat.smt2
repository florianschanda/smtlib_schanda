;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010011000111010 #b01010110011110)
                arg1
                (fp #b1 #b001100101010000 #b01001010000001)))
(assert (fp.leq (fp #b1 #b001100101010000 #b01001010000001)
                arg1
                (fp #b0 #b011101011100100 #b00011101011010)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011010011110100 #b10010111111111)
                arg2
                (fp #b0 #b011111111111111 #b00100111100001)))
(assert (fp.leq (fp #b0 #b011111111111111 #b00100111100001)
                arg2
                (fp #b0 #b100011110001100 #b00110101111011)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111110110110001 #b00011110011010)
                expect
                (fp #b1 #b001100101010000 #b00011101111001)))
(assert (fp.leq (fp #b1 #b001100101010000 #b00011101111001)
                expect
                (fp #b0 #b011110000111100 #b00000100001000)))

(assert (= expect result))

(check-sat)
(exit)
