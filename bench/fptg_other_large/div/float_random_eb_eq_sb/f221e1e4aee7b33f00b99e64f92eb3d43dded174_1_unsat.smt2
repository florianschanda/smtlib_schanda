; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001101111 #b10101011)
                arg1
                (fp #b1 #b000000000 #b00010111)))
(assert (fp.leq (fp #b1 #b000000000 #b00010111)
                arg1
                (fp #b0 #b100101000 #b10100000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001001 #b01001101)
                arg2
                (fp #b0 #b000011101 #b00011110)))
(assert (fp.leq (fp #b0 #b000011101 #b00011110)
                arg2
                (fp #b0 #b110100111 #b00100101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011000 #b10010101)
                expect
                (fp #b1 #b011011111 #b01001001)))
(assert (fp.leq (fp #b1 #b011011111 #b01001001)
                expect
                (fp #b1 #b000100111 #b00100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
