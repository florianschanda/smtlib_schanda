                arg2
                (fp #b0 #b10110000110 #b0001100011)))
(assert (fp.leq (fp #b0 #b10110000110 #b0001100011)
                arg2
                (fp #b0 #b10111010011 #b0101010100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001101101 #b0010010010)
                expect
                (fp #b1 #b01101100011 #b1011111101)))
(assert (fp.leq (fp #b1 #b01101100011 #b1011111101)
                expect
                (fp #b0 #b00000101110 #b0100110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
