;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011000100 #b1110011000)
                arg1
                (fp #b1 #b10011101010 #b1110101001)))
(assert (fp.leq (fp #b1 #b10011101010 #b1110101001)
