(assert (fp.leq (fp #b0 #b0111111111111 #b010011101010)
                arg2
                (fp #b0 #b1001111000011 #b010110010111)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1011110101101 #b001111010101)
                expect
                (fp #b1 #b1010000101011 #b111110111001)))
(assert (fp.leq (fp #b1 #b1010000101011 #b111110111001)
                expect
                (fp #b1 #b0011100111000 #b011100010101)))

(assert (not (= expect result)))

(check-sat)
