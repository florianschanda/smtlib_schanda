;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100111111 #b10101101001)
                arg1
                (fp #b1 #b000000000000 #b10011011110)))
(assert (fp.leq (fp #b1 #b000000000000 #b10011011110)
                arg1
                (fp #b0 #b110010011001 #b00100110111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011111111 #b11100101011)
                arg2
                (fp #b1 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b00000000000)
                arg2
                (fp #b0 #b110111100000 #b11101011011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b011111001011 #b00110010101)
                expect
                (fp #b0 #b011111111110 #b00110111100)))
(assert (fp.leq (fp #b0 #b011111111110 #b00110111100)
                expect
                (fp #b0 #b101001001010 #b00111000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
