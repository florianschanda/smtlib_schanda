(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100100010100010 #b011100001101111)
                arg1
                (fp #b1 #b1000000000001110 #b011110011001111)))
(assert (fp.leq (fp #b1 #b1000000000001110 #b011110011001111)
                arg1
                (fp #b1 #b0100100110110111 #b011011110001111)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000011100111000 #b000011101011000)
                arg2
                (fp #b0 #b0000000000000000 #b100100100100110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100100100100110)
                arg2
                (fp #b0 #b1110000110000110 #b000000000111001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
