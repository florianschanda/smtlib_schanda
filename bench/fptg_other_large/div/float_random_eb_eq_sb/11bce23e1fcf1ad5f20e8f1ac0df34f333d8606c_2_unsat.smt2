(assert (fp.leq (fp #b1 #b10000000000100 #b1100100000000)
                arg2
                (fp #b0 #b00001110101100 #b1001000011101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000110000000 #b0010110110110)
                expect
                (fp #b0 #b01111111111001 #b0001111101111)))
(assert (fp.leq (fp #b0 #b01111111111001 #b0001111101111)
                expect
                (fp #b0 #b11010010110110 #b0011100000101)))

(assert (not (= expect result)))

(check-sat)
