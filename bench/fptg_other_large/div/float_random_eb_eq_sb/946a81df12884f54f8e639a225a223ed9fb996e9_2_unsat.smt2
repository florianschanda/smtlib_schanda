; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111110 #b0100011101)
                arg1
                (fp #b1 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000)
                arg1
                (fp #b1 #b00100111100 #b0011100000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01010011011 #b0111101001)
                arg2
                (fp #b0 #b01111111111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100011010)
                arg2
                (fp #b0 #b10001011101 #b0100111001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111101 #b0011000001)
                expect
                (fp #b1 #b11111111100 #b1001000110)))
(assert (fp.leq (fp #b1 #b11111111100 #b1001000110)
                expect
                (fp #b1 #b11010110100 #b0101110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
