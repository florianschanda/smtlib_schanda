                (fp #b1 #b011111111 #b00000000)))
(assert (fp.leq (fp #b1 #b011111111 #b00000000)
                arg2
                (fp #b1 #b011011000 #b01110010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001101010 #b10101001)
                expect
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                expect
                (fp #b0 #b110101011 #b10000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
