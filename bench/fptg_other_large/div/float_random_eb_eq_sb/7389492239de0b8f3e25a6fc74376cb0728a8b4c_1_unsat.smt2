;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100110011 #b011010000)
                arg1
                (fp #b1 #b1001110101 #b100001111)))
(assert (fp.leq (fp #b1 #b1001110101 #b100001111)
                arg1
                (fp #b1 #b0101110010 #b100101010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101110101 #b001001000)
                arg2
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg2
                (fp #b1 #b0001110101 #b000111100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101000110 #b000111000)
                expect
                (fp #b0 #b1001101011 #b100001111)))
(assert (fp.leq (fp #b0 #b1001101011 #b100001111)
                expect
                (fp #b0 #b1010100000 #b111111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
