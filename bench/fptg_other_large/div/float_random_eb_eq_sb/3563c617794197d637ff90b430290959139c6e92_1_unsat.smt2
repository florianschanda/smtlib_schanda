; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010111110 #b10011001)
                arg1
                (fp #b1 #b000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b000000001 #b00000000)
                arg1
                (fp #b0 #b101100111 #b11100110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010101 #b10000010)
                arg2
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg2
                (fp #b0 #b111010010 #b11000111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111001000 #b01011000)
                expect
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                expect
                (fp #b0 #b100011110 #b00101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
