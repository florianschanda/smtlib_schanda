; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110000000110 #b1111101011000)
                arg1
                (fp #b0 #b01010100011110 #b1100100010010)))
(assert (fp.leq (fp #b0 #b01010100011110 #b1100100010010)
                arg1
                (fp #b0 #b10011000110001 #b1100001101000)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110100110000 #b1010001101010)
                arg2
                (fp #b1 #b11110011011010 #b1000011100000)))
(assert (fp.leq (fp #b1 #b11110011011010 #b1000011100000)
                arg2
                (fp #b1 #b01111000011011 #b1101000110101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00111101110011 #b0100000010110)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b00001111110011 #b1110110010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
