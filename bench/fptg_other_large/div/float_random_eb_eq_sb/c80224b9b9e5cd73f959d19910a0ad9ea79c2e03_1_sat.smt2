; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100011100 #b1010111101)
                arg1
                (fp #b1 #b01100100100 #b1111100011)))
(assert (fp.leq (fp #b1 #b01100100100 #b1111100011)
                arg1
                (fp #b0 #b11011100010 #b1010011110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110000110 #b1000000001)
                arg2
                (fp #b0 #b00000000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001110101)
                arg2
                (fp #b0 #b01101111110 #b0110001011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101110110 #b1100101010)
                expect
                (fp #b1 #b11100100110 #b0001010000)))
(assert (fp.leq (fp #b1 #b11100100110 #b0001010000)
                expect
                (fp #b0 #b10011011110 #b0101100001)))

(assert (= expect result))

(check-sat)
(exit)
