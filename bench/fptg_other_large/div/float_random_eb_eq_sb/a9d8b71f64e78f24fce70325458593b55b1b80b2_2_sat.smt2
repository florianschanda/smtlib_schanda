(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101111000010011101 #b10110111011111001)
                expect
                (fp #b1 #b001111111110010011 #b01110111110001101)))
(assert (fp.leq (fp #b1 #b001111111110010011 #b01110111110001101)
                expect
                (fp #b0 #b110101001101010101 #b00000011001110110)))

(assert (= expect result))

(check-sat)
