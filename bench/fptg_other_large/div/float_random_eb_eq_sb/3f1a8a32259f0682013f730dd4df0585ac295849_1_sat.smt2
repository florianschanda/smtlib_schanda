(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101110 #b11110110)
                arg1
                (fp #b1 #b011111111 #b01010101)))
(assert (fp.leq (fp #b1 #b011111111 #b01010101)
                arg1
                (fp #b1 #b010100100 #b00010000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010010001 #b10100101)
                arg2
                (fp #b0 #b100000111 #b01101001)))
(assert (fp.leq (fp #b0 #b100000111 #b01101001)
                arg2
                (fp #b0 #b100110111 #b01110100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100011 #b10000111)
                expect
                (fp #b1 #b011110110 #b11100011)))
(assert (fp.leq (fp #b1 #b011110110 #b11100011)
                expect
                (fp #b1 #b000110001 #b11000100)))

(assert (= expect result))

(check-sat)
(exit)
