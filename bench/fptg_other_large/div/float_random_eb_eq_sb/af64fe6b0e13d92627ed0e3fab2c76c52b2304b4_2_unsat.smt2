; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101000101101 #b01001001110)
                arg1
                (fp #b0 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b11111111111)
                arg1
                (fp #b0 #b100101000010 #b10001111001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000011011011 #b01010110100)
                arg2
                (fp #b0 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b100000001011 #b00000000000)
                arg2
                (fp #b0 #b110111001101 #b11011010011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101100111 #b11010111010)
                expect
                (fp #b0 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000001)
                expect
                (fp #b0 #b000001100101 #b01001101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
