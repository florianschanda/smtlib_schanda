; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000110001 #b01101000101)
                arg1
                (fp #b1 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b11111111111)
                arg1
                (fp #b0 #b101110011000 #b10110111111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010001101 #b00101000010)
                arg2
                (fp #b1 #b101001111100 #b10100010001)))
(assert (fp.leq (fp #b1 #b101001111100 #b10100010001)
                arg2
                (fp #b0 #b011110101010 #b11011011001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110000001 #b11110111111)
                expect
                (fp #b0 #b100110000001 #b00111001100)))
(assert (fp.leq (fp #b0 #b100110000001 #b00111001100)
                expect
                (fp #b0 #b111110011110 #b11101111101)))

(assert (= expect result))

(check-sat)
(exit)
