; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111011110001001 #b10011110100001)
                arg1
                (fp #b0 #b110011011101010 #b10010110100010)))
(assert (fp.leq (fp #b0 #b110011011101010 #b10010110100010)
                arg1
                (fp #b0 #b111010111100101 #b11000100011000)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111011100010100 #b00111010000010)
                arg2
                (fp #b1 #b001111111111001 #b00000000000000)))
(assert (fp.leq (fp #b1 #b001111111111001 #b00000000000000)
                arg2
                (fp #b0 #b110100011111100 #b10001001001001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
