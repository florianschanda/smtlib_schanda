                arg2
                (fp #b1 #b1000000000001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b1000000000001110 #b100101100101100)
                arg2
                (fp #b1 #b0000111001001101 #b100100000101100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000110010111010 #b100110011001110)
                expect
                (fp #b0 #b0010000000011010 #b101101100111010)))
(assert (fp.leq (fp #b0 #b0010000000011010 #b101101100111010)
                expect
                (fp #b0 #b1000100011011010 #b001101001000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
