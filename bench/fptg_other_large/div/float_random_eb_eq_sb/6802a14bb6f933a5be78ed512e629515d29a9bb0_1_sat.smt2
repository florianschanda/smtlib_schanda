; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b011011010100 #b00011100000)
                arg1
                (fp #b0 #b101000111000 #b00001000010)))
(assert (fp.leq (fp #b0 #b101000111000 #b00001000010)
                arg1
                (fp #b0 #b101100101110 #b11000101100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101110111 #b00000000100)
                arg2
                (fp #b1 #b100000110101 #b00101100111)))
(assert (fp.leq (fp #b1 #b100000110101 #b00101100111)
                arg2
                (fp #b1 #b011100011001 #b01100011110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011111010 #b00100000010)
                expect
                (fp #b1 #b101000000001 #b11000001101)))
(assert (fp.leq (fp #b1 #b101000000001 #b11000001101)
                expect
                (fp #b0 #b010101001110 #b01110001101)))

(assert (= expect result))

(check-sat)
(exit)
