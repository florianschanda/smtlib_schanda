(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100001001 #b100101011)
                arg1
                (fp #b1 #b0000001001 #b000100110)))
(assert (fp.leq (fp #b1 #b0000001001 #b000100110)
                arg1
                (fp #b0 #b0000100010 #b111000011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110111 #b001101100)
                arg2
                (fp #b1 #b1110100100 #b011110101)))
(assert (fp.leq (fp #b1 #b1110100100 #b011110101)
                arg2
                (fp #b0 #b1010101100 #b000001010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0101111110 #b010000101)
                expect
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                expect
                (fp #b0 #b1010100100 #b111111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
