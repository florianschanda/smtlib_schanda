(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100001110 #b0001110001)
                arg1
                (fp #b1 #b01100100100 #b1111100011)))
(assert (fp.leq (fp #b1 #b01100100100 #b1111100011)
                arg1
                (fp #b0 #b01000110110 #b1111010000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00001000110 #b1101001011)
                expect
                (fp #b0 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b00111001100 #b1110010111)))

(assert (= expect result))

(check-sat)
(exit)
