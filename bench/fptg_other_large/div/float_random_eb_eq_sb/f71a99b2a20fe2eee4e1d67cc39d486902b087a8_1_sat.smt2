; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000111100 #b110001111)
                arg1
                (fp #b0 #b1000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b1000000111 #b000111000)
                arg1
                (fp #b0 #b1110101000 #b101101011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110010111 #b110111011)
                arg2
                (fp #b1 #b0111001011 #b101101101)))
(assert (fp.leq (fp #b1 #b0111001011 #b101101101)
                arg2
                (fp #b1 #b0011100100 #b001010011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011100 #b000000110)
                expect
                (fp #b1 #b1000111010 #b010010111)))
(assert (fp.leq (fp #b1 #b1000111010 #b010010111)
                expect
                (fp #b0 #b1101100011 #b101101110)))

(assert (= expect result))

(check-sat)
(exit)
