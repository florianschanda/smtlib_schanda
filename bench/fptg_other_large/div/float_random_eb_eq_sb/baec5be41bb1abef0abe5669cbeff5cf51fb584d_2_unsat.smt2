                arg2
                (fp #b0 #b000001010 #b00011001)))
(assert (fp.leq (fp #b0 #b000001010 #b00011001)
                arg2
                (fp #b0 #b111110111 #b11000000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b10001011)
                expect
                (fp #b1 #b111111100 #b10001110)))
(assert (fp.leq (fp #b1 #b111111100 #b10001110)
                expect
                (fp #b1 #b100110101 #b01101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
