(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110000000111001 #b000111011001010)
                expect
                (fp #b0 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000000000000000)
                expect
                (fp #b0 #b1110001110001011 #b110110111100101)))

(assert (= expect result))

(check-sat)
(exit)
