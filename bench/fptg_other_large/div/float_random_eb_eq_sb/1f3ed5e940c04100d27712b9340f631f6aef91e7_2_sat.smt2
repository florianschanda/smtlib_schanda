; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00110110011 #b1011111011)
                arg1
                (fp #b0 #b00111111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111111011 #b0000000000)
                arg1
                (fp #b0 #b11100111000 #b0000011111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00100010111 #b0011011000)
                arg2
                (fp #b0 #b11111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000)
                arg2
                (fp #b0 #b11111111110 #b1011110010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00100001111 #b1011000110)
                expect
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b11010111011 #b1111101111)))

(assert (= expect result))

(check-sat)
(exit)
