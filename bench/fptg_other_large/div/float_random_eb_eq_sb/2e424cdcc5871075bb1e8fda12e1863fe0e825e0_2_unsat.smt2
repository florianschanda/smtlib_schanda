(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101111010111111 #b010011010000111)
                arg1
                (fp #b1 #b0000000000000000 #b100101111110110)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b100101111110110)
                arg1
                (fp #b0 #b1011100100010100 #b011011101101110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101001111010101 #b000011011011001)
                arg2
                (fp #b1 #b1100011100100110 #b011000011011000)))
(assert (fp.leq (fp #b1 #b1100011100100110 #b011000011011000)
                arg2
                (fp #b0 #b0000101000100111 #b101000110111011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110111000100110 #b101100111010010)
                expect
                (fp #b0 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000001)
                expect
                (fp #b0 #b0101101101001101 #b100011010111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
