;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1001101100101 #b111011011100)
                arg1
                (fp #b0 #b1000000001011 #b010101111110)))
(assert (fp.leq (fp #b0 #b1000000001011 #b010101111110)
                arg1
                (fp #b0 #b1101110100110 #b010100101101)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100100000101 #b010101010010)
                arg2
                (fp #b0 #b0000000000000 #b000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000001)
                arg2
                (fp #b0 #b0000000110000 #b111001100101)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
