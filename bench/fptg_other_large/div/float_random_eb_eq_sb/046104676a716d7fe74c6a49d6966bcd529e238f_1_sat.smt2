                arg2
                (fp #b0 #b100110010 #b10110001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010111100 #b11101110)
                expect
                (fp #b1 #b010000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000 #b00000000)
                expect
                (fp #b0 #b011011100 #b01111100)))

(assert (= expect result))

(check-sat)
(exit)
