; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b001010100001111 #b01110011101011)
                arg1
                (fp #b0 #b011111111111111 #b01110001110010)))
(assert (fp.leq (fp #b0 #b011111111111111 #b01110001110010)
                arg1
                (fp #b0 #b101000111110100 #b01111000111111)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001000011010000 #b11011101111000)
                arg2
                (fp #b1 #b000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01000000000000)
                arg2
                (fp #b0 #b101000011100110 #b01111011001101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
