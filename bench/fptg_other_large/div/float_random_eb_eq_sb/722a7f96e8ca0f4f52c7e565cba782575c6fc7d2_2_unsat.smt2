(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001001001 #b1100010100)
                expect
                (fp #b1 #b01000001000 #b0011110001)))
(assert (fp.leq (fp #b1 #b01000001000 #b0011110001)
                expect
                (fp #b0 #b11000010101 #b1110001001)))

(assert (not (= expect result)))

