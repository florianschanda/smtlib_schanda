; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001110001100 #b0100001101001)
                arg1
                (fp #b1 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b1 #b00111111111001 #b0110101000001)
                arg1
                (fp #b0 #b00010110111110 #b1011111010011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b00010011010000 #b0100101000101)
                arg2
                (fp #b0 #b10000000001100 #b1001111110101)))
(assert (fp.leq (fp #b0 #b10000000001100 #b1001111110101)
                arg2
                (fp #b0 #b10010000100100 #b0110010001111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111000000000 #b0100001000000)
                expect
                (fp #b1 #b00111111101011 #b1011110111111)))
(assert (fp.leq (fp #b1 #b00111111101011 #b1011110111111)
                expect
                (fp #b0 #b10100111000000 #b1110110100110)))

(assert (= expect result))

(check-sat)
(exit)
