; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10110110011001110 #b0000100000010100)
                arg1
                (fp #b0 #b01111111111111111 #b0000111000011000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b0000111000011000)
                arg1
                (fp #b0 #b10011010010000111 #b1011001110010101)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11011000001010101 #b1011100011100111)
                arg2
                (fp #b1 #b11000100001111010 #b1100011100000010)))
(assert (fp.leq (fp #b1 #b11000100001111010 #b1100011100000010)
                arg2
                (fp #b1 #b00011010010111100 #b1000011110010001)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b01000101100010110 #b0111110110100001)
                expect
                (fp #b1 #b00111011110000011 #b0010111111101101)))
(assert (fp.leq (fp #b1 #b00111011110000011 #b0010111111101101)
                expect
                (fp #b0 #b01111100110100111 #b0100010100110011)))

(assert (= expect result))

(check-sat)
(exit)
