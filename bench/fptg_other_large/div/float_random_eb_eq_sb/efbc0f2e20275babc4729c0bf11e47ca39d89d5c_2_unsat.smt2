; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000100010 #b00010100)
                arg1
                (fp #b0 #b000011000 #b11110110)))
(assert (fp.leq (fp #b0 #b000011000 #b11110110)
                arg1
                (fp #b0 #b010101000 #b01101011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010000 #b00101001)
                arg2
                (fp #b1 #b110000111 #b00001010)))
(assert (fp.leq (fp #b1 #b110000111 #b00001010)
                arg2
                (fp #b1 #b001100011 #b10011100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111010111 #b11110111)
                expect
                (fp #b1 #b000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b000000000 #b00000001)
                expect
                (fp #b0 #b101110101 #b10011100)))

(assert (not (= expect result)))

(check-sat)
(exit)
