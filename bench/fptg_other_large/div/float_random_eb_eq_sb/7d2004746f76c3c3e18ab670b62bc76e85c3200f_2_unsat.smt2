(assert (fp.leq (fp #b1 #b0111111111 #b001111111)
                arg2
                (fp #b1 #b0011100111 #b111000111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011101001 #b100111001)
                expect
                (fp #b1 #b0111111110 #b100110101)))
(assert (fp.leq (fp #b1 #b0111111110 #b100110101)
                expect
                (fp #b0 #b1100100000 #b000110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
