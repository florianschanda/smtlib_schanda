(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0111000010000100 #b001001011101000)
                arg1
                (fp #b0 #b1000111110000101 #b010000010010011)))
(assert (fp.leq (fp #b0 #b1000111110000101 #b010000010010011)
                arg1
                (fp #b0 #b1110101111101000 #b100001011001011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101011100000100 #b001100101001101)
                arg2
                (fp #b1 #b1100011100100110 #b011000011011000)))
(assert (fp.leq (fp #b1 #b1100011100100110 #b011000011011000)
                arg2
                (fp #b1 #b0100001010001100 #b011001100110101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101110111011100 #b001001111011000)
                expect
                (fp #b1 #b0100100001011101 #b110100001110011)))
(assert (fp.leq (fp #b1 #b0100100001011101 #b110100001110011)
                expect
                (fp #b0 #b0011101000011001 #b011001100000000)))

(assert (= expect result))

(check-sat)
(exit)
