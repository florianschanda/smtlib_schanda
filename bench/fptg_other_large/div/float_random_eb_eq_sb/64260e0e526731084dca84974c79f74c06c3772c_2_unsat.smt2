; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011111011100101 #b111000110111010)
                arg1
                (fp #b1 #b1010000010000110 #b100100010011101)))
(assert (fp.leq (fp #b1 #b1010000010000110 #b100100010011101)
                arg1
                (fp #b0 #b1000010010111000 #b010010010100001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111110010001011 #b111010000000000)
                arg2
                (fp #b1 #b1010010000010100 #b010001111001010)))
(assert (fp.leq (fp #b1 #b1010010000010100 #b010001111001010)
                arg2
                (fp #b1 #b1001010011010010 #b110110100101111)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100011010010100 #b001110001010101)
                expect
                (fp #b0 #b0111110001110001 #b001110011001000)))
(assert (fp.leq (fp #b0 #b0111110001110001 #b001110011001000)
                expect
                (fp #b0 #b1111101110010011 #b001100011100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
