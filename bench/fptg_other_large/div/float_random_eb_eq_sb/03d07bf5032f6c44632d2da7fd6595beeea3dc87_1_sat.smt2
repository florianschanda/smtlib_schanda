(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000000100 #b11011001)
                arg1
                (fp #b1 #b000000000 #b00010111)))
(assert (fp.leq (fp #b1 #b000000000 #b00010111)
                arg1
                (fp #b0 #b100011011 #b10101100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100100110 #b11111010)
                arg2
                (fp #b1 #b000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111111)
                arg2
                (fp #b0 #b011101000 #b01101001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011010001 #b10011101)
                expect
                (fp #b0 #b011111011 #b01110001)))
(assert (fp.leq (fp #b0 #b011111011 #b01110001)
                expect
                (fp #b0 #b110010001 #b11101110)))

(assert (= expect result))

(check-sat)
(exit)
