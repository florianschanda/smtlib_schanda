(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110110001100 #b1110111101100)
                arg1
                (fp #b1 #b01111111111111 #b1100001000110)))
(assert (fp.leq (fp #b1 #b01111111111111 #b1100001000110)
                arg1
                (fp #b0 #b00101010110110 #b0100001100001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10001000110100 #b1111100001101)
                arg2
                (fp #b0 #b01111111111111 #b1001100111111)))
(assert (fp.leq (fp #b0 #b01111111111111 #b1001100111111)
                arg2
                (fp #b0 #b11000110110001 #b1101001001000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100000101111 #b0101110100101)
                expect
                (fp #b1 #b01111111111111 #b0001100100100)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0001100100100)
                expect
                (fp #b0 #b11111010111100 #b0011000000001)))

(assert (= expect result))

(check-sat)
(exit)
