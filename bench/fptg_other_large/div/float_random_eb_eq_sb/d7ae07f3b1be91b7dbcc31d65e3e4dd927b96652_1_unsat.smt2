(assert (fp.leq (fp #b1 #b01111111111111 #b0100110110011)
                arg2
                (fp #b0 #b00010001000110 #b1011111101010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10101000101001 #b1110011111000)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b00111000100000 #b1000011101100)))

(assert (not (= expect result)))

