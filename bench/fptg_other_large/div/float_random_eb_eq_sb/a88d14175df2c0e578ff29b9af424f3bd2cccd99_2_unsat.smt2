;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101110101110100 #b00101110101101)
                arg1
                (fp #b1 #b001100101010000 #b01001010000001)))
(assert (fp.leq (fp #b1 #b001100101010000 #b01001010000001)
                arg1
                (fp #b0 #b000000010011000 #b11011101111010)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111110111010010 #b11101100010001)
                arg2
                (fp #b1 #b111110011001010 #b11101100011010)))
(assert (fp.leq (fp #b1 #b111110011001010 #b11101100011010)
                arg2
                (fp #b1 #b100110100000011 #b00001000011110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000110100100110 #b11000100001101)
                expect
                (fp #b0 #b000000000000000 #b00000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000001)
                expect
                (fp #b0 #b111101001011100 #b00001011111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
