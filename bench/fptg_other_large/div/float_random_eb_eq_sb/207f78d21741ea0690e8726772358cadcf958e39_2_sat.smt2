(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000101100 #b111111111)
                arg1
                (fp #b1 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b111111111)
                arg1
                (fp #b0 #b0001111011 #b101111100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010010000 #b110101000)
                arg2
                (fp #b1 #b1000000111 #b001100100)))
(assert (fp.leq (fp #b1 #b1000000111 #b001100100)
                arg2
                (fp #b1 #b0011101111 #b000011010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101000000 #b000010001)
                expect
                (fp #b0 #b0000000000 #b000000010)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000010)
                expect
                (fp #b0 #b0101000100 #b110010100)))

(assert (= expect result))

(check-sat)
(exit)
