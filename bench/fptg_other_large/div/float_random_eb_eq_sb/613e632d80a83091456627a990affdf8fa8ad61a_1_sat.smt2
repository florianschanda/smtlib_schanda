; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011101001011 #b1001110001001)
                arg1
                (fp #b0 #b01010100011110 #b1100100010010)))
(assert (fp.leq (fp #b0 #b01010100011110 #b1100100010010)
                arg1
                (fp #b0 #b11010010100111 #b0001100001101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110001000011 #b0000000000000)
                arg2
                (fp #b1 #b11100110110100 #b1101101000111)))
(assert (fp.leq (fp #b1 #b11100110110100 #b1101101000111)
                arg2
                (fp #b1 #b00101000101100 #b1010101111011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11111010010111 #b0100001100011)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b11011010101111 #b1011101110000)))

(assert (= expect result))

(check-sat)
(exit)
