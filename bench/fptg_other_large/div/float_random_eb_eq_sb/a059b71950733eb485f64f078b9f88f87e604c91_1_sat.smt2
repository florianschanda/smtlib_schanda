(assert (fp.leq (fp #b1 #b10111111111110 #b1111111111111)
                arg2
                (fp #b0 #b10111101110100 #b1001010111110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001000001100 #b0100010011110)
                expect
                (fp #b0 #b10111010101000 #b1111010011101)))
(assert (fp.leq (fp #b0 #b10111010101000 #b1111010011101)
                expect
                (fp #b0 #b11101111101011 #b0011111111110)))

(assert (= expect result))

(check-sat)
