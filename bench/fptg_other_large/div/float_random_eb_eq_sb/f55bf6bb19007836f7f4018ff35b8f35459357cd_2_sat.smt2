(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111101010 #b00010111)
                arg1
                (fp #b1 #b100000111 #b10110100)))
(assert (fp.leq (fp #b1 #b100000111 #b10110100)
                arg1
                (fp #b0 #b100111111 #b10100101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011010111 #b11111111)
                arg2
                (fp #b0 #b011111111 #b01100111)))
(assert (fp.leq (fp #b0 #b011111111 #b01100111)
                arg2
                (fp #b0 #b101111111 #b01001101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011111 #b10101011)
                expect
                (fp #b1 #b100000111 #b00110111)))
(assert (fp.leq (fp #b1 #b100000111 #b00110111)
                expect
                (fp #b0 #b000010111 #b01110000)))

(assert (= expect result))

(check-sat)
(exit)
