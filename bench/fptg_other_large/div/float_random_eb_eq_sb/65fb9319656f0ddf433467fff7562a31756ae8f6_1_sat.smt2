; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110001110110 #b00010101111)
                arg1
                (fp #b1 #b010011011101 #b01111010101)))
(assert (fp.leq (fp #b1 #b010011011101 #b01111010101)
                arg1
                (fp #b0 #b000011110100 #b11010011100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011011011101 #b10011110111)
                arg2
                (fp #b1 #b011001001110 #b00100110001)))
(assert (fp.leq (fp #b1 #b011001001110 #b00100110001)
                arg2
                (fp #b0 #b011010001000 #b11110010111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100111110 #b10011100101)
                expect
                (fp #b0 #b011010001110 #b01001001100)))
(assert (fp.leq (fp #b0 #b011010001110 #b01001001100)
                expect
                (fp #b0 #b011100001110 #b11011010011)))

(assert (= expect result))

(check-sat)
(exit)
