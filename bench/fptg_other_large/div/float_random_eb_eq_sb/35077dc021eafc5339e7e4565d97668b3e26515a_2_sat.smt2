; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111001000010 #b1010110110110)
                arg1
                (fp #b0 #b01111111111111 #b0000000000000)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0000000000000)
                arg1
                (fp #b0 #b11010010101101 #b0101010111011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00010111010010 #b1111110100110)
                arg2
                (fp #b1 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100000000000)
                arg2
                (fp #b0 #b11001111100100 #b0010100011110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
