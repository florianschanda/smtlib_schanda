; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000001101000 #b01011111011)
                arg1
                (fp #b0 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000001)
                arg1
                (fp #b0 #b011001011100 #b00100000011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101111100110 #b10000001110)
                arg2
                (fp #b1 #b011111111111 #b01111111010)))
(assert (fp.leq (fp #b1 #b011111111111 #b01111111010)
                arg2
                (fp #b0 #b111100110101 #b00110100111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000110111101 #b00110110010)
                expect
                (fp #b1 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000001)
                expect
                (fp #b0 #b001101101000 #b00011010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
