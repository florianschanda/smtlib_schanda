                arg2
                (fp #b1 #b00000000000000000 #b1010101111010010)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1010101111010010)
                arg2
                (fp #b0 #b11101001011010000 #b0000001100111110)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10011100011011101 #b1000110001100100)
                expect
                (fp #b1 #b01111111111111101 #b0111110101101011)))
(assert (fp.leq (fp #b1 #b01111111111111101 #b0111110101101011)
                expect
                (fp #b0 #b01110010110111110 #b0101001011011000)))

(assert (= expect result))

(check-sat)
(exit)
