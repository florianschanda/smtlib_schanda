;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b01000110111100100 #b1001010100011110)
                arg1
                (fp #b0 #b00000000000000000 #b0100000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0100000000000000)
                arg1
                (fp #b0 #b11000100100001011 #b0101100111100100)))

