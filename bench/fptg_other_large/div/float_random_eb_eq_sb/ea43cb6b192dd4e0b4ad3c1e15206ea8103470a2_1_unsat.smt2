(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110000000010010 #b01000010010000)
                arg2
                (fp #b1 #b100100000101011 #b10001111001110)))
(assert (fp.leq (fp #b1 #b100100000101011 #b10001111001110)
                arg2
                (fp #b0 #b101011100110011 #b00011000010000)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
