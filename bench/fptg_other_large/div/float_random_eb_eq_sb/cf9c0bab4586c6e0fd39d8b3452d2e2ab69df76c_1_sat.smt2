(assert (fp.leq (fp #b1 #b110001000010110110 #b10001101111111010)
                arg2
                (fp #b0 #b001010011000011000 #b00110111011111111)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101010000101011010 #b10010000101001011)
                expect
                (fp #b1 #b100010111111110101 #b10100111010101101)))
(assert (fp.leq (fp #b1 #b100010111111110101 #b10100111010101101)
                expect
                (fp #b0 #b111011111110011101 #b11001101111100100)))

(assert (= expect result))

(check-sat)
(exit)
