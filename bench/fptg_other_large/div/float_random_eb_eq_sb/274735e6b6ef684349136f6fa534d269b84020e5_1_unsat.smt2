(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg2
                (fp #b0 #b001111101 #b10000001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110100 #b10000110)
                expect
                (fp #b1 #b011111101 #b01110000)))
(assert (fp.leq (fp #b1 #b011111101 #b01110000)
                expect
                (fp #b0 #b011101010 #b10111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
