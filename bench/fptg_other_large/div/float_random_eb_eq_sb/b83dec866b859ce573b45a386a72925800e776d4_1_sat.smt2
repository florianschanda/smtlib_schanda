; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111010111011 #b00101010110)
                arg1
                (fp #b1 #b010011011101 #b01111010101)))
(assert (fp.leq (fp #b1 #b010011011101 #b01111010101)
                arg1
                (fp #b1 #b010010111011 #b01111101111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101010101 #b01111001010)
                arg2
                (fp #b1 #b011111111111 #b01111111010)))
(assert (fp.leq (fp #b1 #b011111111111 #b01111111010)
                arg2
                (fp #b1 #b010111101101 #b11001010101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001000000001 #b00101101110)
                expect
                (fp #b0 #b010011011100 #b11111001110)))
(assert (fp.leq (fp #b0 #b010011011100 #b11111001110)
                expect
                (fp #b0 #b100100000111 #b00011000110)))

(assert (= expect result))

(check-sat)
(exit)
