; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110110011 #b1111100100)
                arg1
                (fp #b1 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111)
                arg1
                (fp #b0 #b00110100100 #b0110101001)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00010001101 #b1100011010)
                arg2
                (fp #b0 #b11110111001 #b1110000101)))
(assert (fp.leq (fp #b0 #b11110111001 #b1110000101)
                arg2
                (fp #b0 #b11111001111 #b0011000011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100011110 #b0101000010)
                expect
                (fp #b1 #b01001000100 #b0001000000)))
(assert (fp.leq (fp #b1 #b01001000100 #b0001000000)
                expect
                (fp #b0 #b11110110111 #b1110111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
