; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010100100 #b110111110)
                arg1
                (fp #b1 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111 #b000000000)
                arg1
                (fp #b0 #b1110110101 #b000101011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100100111 #b000010010)
                arg2
                (fp #b0 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1011111110 #b111111111)
                arg2
                (fp #b0 #b1110100111 #b000011001)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011001 #b001100101)
                expect
                (fp #b1 #b0011111111 #b000000000)))
(assert (fp.leq (fp #b1 #b0011111111 #b000000000)
                expect
                (fp #b0 #b1100011100 #b011101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
