(assert (fp.leq (fp #b0 #b10000110110110 #b0101110110001)
                arg2
                (fp #b0 #b11001101111001 #b0011110100101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111100011110 #b1000111101111)
                expect
                (fp #b1 #b11111001000101 #b0111011011111)))
(assert (fp.leq (fp #b1 #b11111001000101 #b0111011011111)
                expect
                (fp #b0 #b11010010100011 #b0111000000001)))

(assert (= expect result))

(check-sat)
