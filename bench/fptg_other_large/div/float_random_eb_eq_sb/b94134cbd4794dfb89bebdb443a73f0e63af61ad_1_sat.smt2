; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111000001 #b00101001010)
                arg1
                (fp #b1 #b110100100011 #b00110111000)))
(assert (fp.leq (fp #b1 #b110100100011 #b00110111000)
                arg1
                (fp #b0 #b010101100100 #b11001010100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000000110010 #b10000101001)
                arg2
                (fp #b0 #b011111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b011111111111 #b01111100000)
                arg2
                (fp #b0 #b110001110110 #b01101100101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111011111000 #b11001011101)
                expect
                (fp #b1 #b110100100010 #b10100011000)))
(assert (fp.leq (fp #b1 #b110100100010 #b10100011000)
                expect
                (fp #b1 #b001100111111 #b11101110000)))

(assert (= expect result))

(check-sat)
(exit)
