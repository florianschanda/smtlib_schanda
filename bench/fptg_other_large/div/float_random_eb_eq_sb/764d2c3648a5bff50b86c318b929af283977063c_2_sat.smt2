(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111111 #b000000000)
                arg1
                (fp #b1 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111111)
                arg1
                (fp #b1 #b1101000010 #b101111001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011011001 #b011000111)
                arg2
                (fp #b0 #b1001110111 #b101110100)))
(assert (fp.leq (fp #b0 #b1001110111 #b101110100)
                arg2
                (fp #b0 #b1111011001 #b111010010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111010011 #b100111110)
                expect
                (fp #b1 #b1110000110 #b001010001)))
(assert (fp.leq (fp #b1 #b1110000110 #b001010001)
                expect
                (fp #b0 #b1000010100 #b110011111)))

(assert (= expect result))

(check-sat)
(exit)
