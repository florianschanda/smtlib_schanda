(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110001000 #b011000101)
                arg1
                (fp #b0 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b0111000000 #b101010110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001101001 #b100000111)
                arg2
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg2
                (fp #b0 #b1010110001 #b110111110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000011101 #b110101000)
                expect
                (fp #b0 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000001)
                expect
                (fp #b0 #b0000010110 #b000001010)))

(assert (= expect result))

(check-sat)
(exit)
