(assert (fp.leq (fp #b1 #b10000000000100 #b1100100000000)
                arg2
                (fp #b1 #b00000010111001 #b1111111000110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000100101111 #b0010010110000)
                expect
                (fp #b1 #b00000000000000 #b0000001111101)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000001111101)
                expect
                (fp #b0 #b01101111110100 #b1110001111111)))

(assert (not (= expect result)))

(check-sat)
