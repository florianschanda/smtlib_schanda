; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111100010110010 #b000101111101010)
                arg1
                (fp #b1 #b1010111011011110 #b001000011101111)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101111)
                arg1
                (fp #b0 #b1010100011001101 #b010101100100100)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110100101011010 #b110010011001001)
                arg2
                (fp #b1 #b1101111001100001 #b011101100001111)))
(assert (fp.leq (fp #b1 #b1101111001100001 #b011101100001111)
                arg2
                (fp #b0 #b1001100101111001 #b000000010100100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111100010110 #b001001000000000)
                expect
                (fp #b0 #b0101000001111011 #b100011001011010)))
(assert (fp.leq (fp #b0 #b0101000001111011 #b100011001011010)
                expect
                (fp #b0 #b0101111000100100 #b001111000101011)))

(assert (= expect result))

(check-sat)
(exit)
