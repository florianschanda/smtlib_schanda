; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111110110 #b010100100)
                arg1
                (fp #b0 #b0000000000 #b011110111)))
(assert (fp.leq (fp #b0 #b0000000000 #b011110111)
                arg1
                (fp #b0 #b1110001100 #b010001111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110011111 #b101010101)
                arg2
                (fp #b0 #b0000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b0000000000 #b100101010)
                arg2
                (fp #b0 #b0010001000 #b110111100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001100010 #b010010111)
                expect
                (fp #b0 #b0111111110 #b101010001)))
(assert (fp.leq (fp #b0 #b0111111110 #b101010001)
                expect
                (fp #b0 #b1110111100 #b101001100)))

(assert (= expect result))

(check-sat)
(exit)
