; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000011100 #b11110100)
                arg1
                (fp #b0 #b100110001 #b00100001)))
(assert (fp.leq (fp #b0 #b100110001 #b00100001)
                arg1
                (fp #b0 #b101010110 #b01101001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110111 #b10011110)
                arg2
                (fp #b0 #b011111111 #b01100111)))
(assert (fp.leq (fp #b0 #b011111111 #b01100111)
                arg2
                (fp #b0 #b100010100 #b01001000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011011 #b10101110)
                expect
                (fp #b0 #b100110000 #b10011100)))
(assert (fp.leq (fp #b0 #b100110000 #b10011100)
                expect
                (fp #b0 #b111000110 #b10001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
