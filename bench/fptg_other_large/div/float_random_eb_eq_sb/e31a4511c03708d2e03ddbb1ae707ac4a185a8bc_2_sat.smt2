; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111101100000111 #b01001111000100)
                arg1
                (fp #b0 #b110011011101010 #b10010110100010)))
(assert (fp.leq (fp #b0 #b110011011101010 #b10010110100010)
                arg1
                (fp #b0 #b111001100111100 #b11001001001011)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110100011100010 #b11001110111111)
                arg2
                (fp #b1 #b011111111111111 #b11111000010000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11111000010000)
                arg2
                (fp #b0 #b100100100100011 #b11001101001100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110110100111110 #b01000001000000)
                expect
                (fp #b1 #b110011011101001 #b10011100110010)))
(assert (fp.leq (fp #b1 #b110011011101001 #b10011100110010)
                expect
                (fp #b0 #b011011101011101 #b11011100111000)))

(assert (= expect result))

(check-sat)
(exit)
