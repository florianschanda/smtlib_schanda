; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011000011 #b10101011)
                arg1
                (fp #b0 #b000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b000000000 #b11111111)
                arg1
                (fp #b0 #b101110101 #b01000001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010110010 #b00011101)
                arg2
                (fp #b0 #b100000111 #b01000010)))
(assert (fp.leq (fp #b0 #b100000111 #b01000010)
                arg2
                (fp #b0 #b101100101 #b11101001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100100010 #b00111111)
                expect
                (fp #b0 #b000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000)
                expect
                (fp #b0 #b011100011 #b11001110)))

(assert (not (= expect result)))

(check-sat)
(exit)
