(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100001 #b000100011)
                arg1
                (fp #b0 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000001)
                arg1
                (fp #b0 #b0110100100 #b100111110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010110000 #b001000001)
                arg2
                (fp #b0 #b1000000111 #b000000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b000000000)
                arg2
                (fp #b0 #b1001001000 #b010101101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0111110100 #b010011000)
                expect
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0100010001 #b001000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
