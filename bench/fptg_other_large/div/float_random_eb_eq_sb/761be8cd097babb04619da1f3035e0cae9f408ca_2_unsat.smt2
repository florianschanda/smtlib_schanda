;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011010111 #b010001111)
                arg1
                (fp #b0 #b0011011111 #b110111010)))
(assert (fp.leq (fp #b0 #b0011011111 #b110111010)
                arg1
                (fp #b0 #b1010010001 #b011101001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011101111 #b011101100)
                arg2
                (fp #b0 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111011 #b011010100)
                arg2
                (fp #b0 #b0101000011 #b110101110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001000110 #b111100001)
                expect
                (fp #b0 #b0111100011 #b010100011)))
(assert (fp.leq (fp #b0 #b0111100011 #b010100011)
                expect
                (fp #b0 #b1000101000 #b001001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
