(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111011011011001 #b01010001001000)
                expect
                (fp #b1 #b011111111111111 #b00000000000000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b00000000000000)
                expect
                (fp #b1 #b011110001010110 #b11011001101000)))

(assert (= expect result))

(check-sat)
(exit)
