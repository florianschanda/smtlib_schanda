; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: DIV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110101101 #b11111000110)
                arg1
                (fp #b1 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b11111111111)
                arg1
                (fp #b1 #b101110001110 #b11000110100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011110110 #b01110110110)
                arg2
                (fp #b1 #b011111111111 #b01111111010)))
(assert (fp.leq (fp #b1 #b011111111111 #b01111111010)
                arg2
                (fp #b1 #b000010100000 #b00100100110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.div rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100000011110 #b01000110000)
                expect
                (fp #b0 #b101111111110 #b01010101111)))
(assert (fp.leq (fp #b0 #b101111111110 #b01010101111)
                expect
                (fp #b0 #b111000111100 #b01000001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
