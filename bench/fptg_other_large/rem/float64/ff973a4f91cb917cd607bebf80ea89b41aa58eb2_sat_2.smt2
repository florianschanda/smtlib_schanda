; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b10010101000 #b0010111010111100100110101111001011001111100100011011)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11101110111 #b1101110111101001001101011100001100011011000011010000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000010100 #b1110001111010111101011100011101111001000010101000011)
                arg2
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01100111100 #b0010011101100010100001111010111000011110010111001110)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10100100100 #b0010100000110111010110011100000101101110100111011111)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01100001100 #b0010101010110111101001001001011011000101111010110000)))

(assert (= expect result))

(check-sat)
(exit)
