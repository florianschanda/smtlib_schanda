                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11001111111 #b1000011001001111111010010100000100110000110111110100)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00100111101 #b0110010000000100111010001010011101100101100011011010)
                expect
                (fp #b0 #b00000000000 #b0110110110111011011001111101010001100110010001011100)))
