                (fp #b0 #b10010110001 #b0100000000101000011010101101111010110111110010101100)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01111011110 #b0001101010110111101000110000010110101000111100001111)
                expect
