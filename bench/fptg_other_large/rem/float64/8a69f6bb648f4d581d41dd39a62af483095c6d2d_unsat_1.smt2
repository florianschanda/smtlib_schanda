; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110101011 #b0001001100110010110010011001000011000000011011000100)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11011101001 #b0110000111011100001011100100100100001101111101111110)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10010111000 #b1000011000001101010101101010100100101101111110001001)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01001111110 #b1010100000001011111011001100111111100011001001100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
