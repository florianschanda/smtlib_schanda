; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101101000 #b0000111111000111111101000000010001011010010001110110)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b00110111011 #b0001010111110001001001110010110000101011001000010111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100101000 #b1011000000100111001100011011011100111101000111011111)
                arg2
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b00011101111 #b0100110111101110110000001010100111010101010011010111)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01001110110 #b0100000110010100001101110011111010010011001010010101)
                expect
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                expect
                (fp #b0 #b01100000111 #b1111001010011100100100000101000111100101100110010001)))

(assert (= expect result))

(check-sat)
(exit)
