(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110110011 #b0010011100011001010001101011101100111111010101100011)
                expect
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01001110000 #b0000011100101010110000110011001001111101001110011010)))

(assert (= expect result))

(check-sat)
(exit)
