(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01101010101 #b0010101110010000000000110100000010100101111010010000)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b11011111011 #b0100000100110111010101101110111100010100111011111110)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001010001 #b1000001001110110100011101011111101010000011001110001)
                expect
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                expect
                (fp #b0 #b10101100000 #b0011111101010101110101001001000011001111101111111101)))

(assert (= expect result))

(check-sat)
(exit)
