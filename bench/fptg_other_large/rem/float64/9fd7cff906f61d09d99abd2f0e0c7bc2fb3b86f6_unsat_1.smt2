; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000101101 #b0001011000000101010001000011011110100111001001111010)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b1 #b00111011011 #b1101100110101011011100000101111001011100101001010010)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110010100 #b0110100001101001101101110010001101110000000101011111)
                expect
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                expect
                (fp #b1 #b10001000011 #b1000100011111111111100000001100110010001010010101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
