(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001111010 #b1000001100100000001101100111111111101101011011100000)
                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b11100111111 #b0110001100100110110110000011011101001000111010011111)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
