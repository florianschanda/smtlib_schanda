                arg2
                (fp #b0 #b01000001001 #b0110011010110100010110101100010000001001100010101101)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00110101101 #b0010100111010100001000110101001000010101010101111011)
                expect
