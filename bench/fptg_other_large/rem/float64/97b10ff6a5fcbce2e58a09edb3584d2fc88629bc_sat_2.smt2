;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000001100 #b1110001101000110100001001101010101001010101110101011)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b00010001001 #b1001011010100011111010000101001001110001001100001110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101010111 #b0000011011111000101010100000101100110000000000001111)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b01110011101 #b0101101100110001011001001100101010010101010111110011)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01011110001 #b0110100011010101001100011001000010101111001011110100)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00011011001 #b1010100100100111111001111000011000000011010111000000)))

(assert (= expect result))

(check-sat)
(exit)
