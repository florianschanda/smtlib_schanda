; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011110110 #b0000000001011000100111000001011100101011011101101010)
                arg1
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg1
                (fp #b0 #b01000001111 #b1010110000000101101100110100010110101111001000111011)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011001000 #b0001010000111010100101000100000001011011010000001011)
                expect
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                expect
                (fp #b1 #b00110101011 #b0001110111100010011000111110100001110001010000101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
