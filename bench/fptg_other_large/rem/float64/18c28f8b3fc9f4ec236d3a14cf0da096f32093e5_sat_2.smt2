;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111000001 #b1001100110100000100011010000010011100001010010010010)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b10011000110 #b0011001101000000111011010000101111111111111110000011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00001111001 #b0100011111000010000010100100010011000111100000000110)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b10011101110 #b0011010100100001111011101011011101100100101100110010)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110110111 #b1110000011011011000111001010010011001111111011100100)
                expect
                (fp #b0 #b00000000000 #b0100000001010110111100100110000111011110011000000100)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000001010110111100100110000111011110011000000100)
                expect
                (fp #b0 #b10101111110 #b0010010010111010100011011001001110101111100011010110)))

(assert (= expect result))

(check-sat)
(exit)
