; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010001111 #b0100110000110001011101011100000111001110111111110011)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
