(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00111011110 #b0000010001011111111000101000101100110001100000011011)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b10000001110 #b1000000001001101001010000011000110001100110010011110)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110111100 #b0110010110000001111101000101010100001001010110010111)
                expect
                (fp #b0 #b00000000000 #b0000010100000001101000000010101000101001111000010000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000010100000001101000000010101000101001111000010000)
                expect
                (fp #b0 #b10010001000 #b1010001100100111110001101010000011100011101001000110)))

(assert (= expect result))

(check-sat)
(exit)
