(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100110111 #b1001100101111001000010101001111001000111000010011010)
                arg1
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111111110 #b0110010010101000111000111010001110100000010111110111)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
