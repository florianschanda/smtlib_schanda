;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100101101 #b0111111001011100010000000100010101101010010110011000)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01100010110 #b0001111110101111101110010111010001110000010110011001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100101100 #b0101001010001100011101001100101010010111001010111011)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01000100010 #b1011000111000101011100011110001011111111011011111001)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01100101010 #b1111001100001111111011100000011101000100001000110111)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00110100011 #b1000111110011101010000110010011011001000100010011110)))

(assert (= expect result))

(check-sat)
(exit)
