; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110001000 #b0001001001101000001101011000110000101110111011101100)
                arg1
                (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)))
(assert (fp.leq (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)
                arg1
