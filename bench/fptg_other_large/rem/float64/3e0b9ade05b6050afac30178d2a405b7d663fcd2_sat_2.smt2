(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01001010000 #b0001000110011001101011111101111010101011011110111000)
                expect
                (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)))
(assert (fp.leq (fp #b0 #b01010010101 #b1111010111000111111011011110100101100001110110001001)
                expect
                (fp #b0 #b10011100111 #b0001110110010010001101000011001101110100111001010110)))

(assert (= expect result))

(check-sat)
(exit)
