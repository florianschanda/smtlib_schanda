(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +ONE
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01011111010 #b0010101001100001010110010101100011101011101001111010)
                arg1
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10101001001 #b1101011110011100001100000101010010011010111001111111)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
