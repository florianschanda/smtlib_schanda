(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01000110001 #b1000010101101101000001111110000010000101000110110000)
                arg1
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
