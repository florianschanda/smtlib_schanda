                arg2
                (fp #b0 #b00110111111 #b1100011101111111000101111010101011001100110011011010)))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100101100 #b1100100100010111011101110110110011000101100011110100)
                expect
                (fp #b1 #b01001100001 #b1110111101100010110011111001000001101001100010100000)))
