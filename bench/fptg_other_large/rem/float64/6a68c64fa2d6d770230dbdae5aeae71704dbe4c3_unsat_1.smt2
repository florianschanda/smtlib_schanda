; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010110000 #b0010110011011110111110110100111001111010111000100000)
                arg1
                (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)
                arg1
