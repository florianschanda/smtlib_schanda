; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001000001 #b0001110000000101101000000101010000011001010011110111)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b01000011100 #b0110011110100100101111100001101011001101010101101101)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110111000 #b1111100100011000111111111100110001110010111001000010)
                expect
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                expect
                (fp #b0 #b10101010000 #b1000110111101010101001111011100100100001111001100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
