(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010010001 #b1010010111100110010000101001111100010011110111110100)
                expect
                (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)
                expect
                (fp #b0 #b11111100010 #b1110111111010101010111100011101001111100111101100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
