; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b111000001010010 #b11011110)
                arg1
                (fp #b1 #b000000000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11111111)
                arg1
                (fp #b0 #b111010101010000 #b00111010)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b000100101111110 #b00010010)
                expect
                (fp #b1 #b000000000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11111111)
                expect
                (fp #b0 #b110101111010110 #b00011000)))

(assert (= expect result))

(check-sat)
(exit)
