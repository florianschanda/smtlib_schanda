(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110111111 #b1000110)
                expect
                (fp #b0 #b000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000 #b0100000)
                expect
                (fp #b0 #b010110000 #b0001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
