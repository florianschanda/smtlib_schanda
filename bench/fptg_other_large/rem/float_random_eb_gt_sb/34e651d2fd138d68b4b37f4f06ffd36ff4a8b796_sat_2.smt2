(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0101110001101111 #b0111011)
                arg1
                (fp #b1 #b0011111111111100 #b0110101)))
(assert (fp.leq (fp #b1 #b0011111111111100 #b0110101)
                arg1
                (fp #b0 #b0100010010110001 #b1100101)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
