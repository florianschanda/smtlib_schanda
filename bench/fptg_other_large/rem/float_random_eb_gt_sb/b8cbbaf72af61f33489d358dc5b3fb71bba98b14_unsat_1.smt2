(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00100111110001 #b11000)
                arg2
                (fp #b0 #b11001000111111 #b01001)))
(assert (fp.leq (fp #b0 #b11001000111111 #b01001)
                arg2
                (fp #b0 #b11100000110000 #b10000)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
