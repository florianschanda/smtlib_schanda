(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b110101101001 #b100)
                arg1
                (fp #b0 #b110110000001 #b010)))
(assert (fp.leq (fp #b0 #b110110000001 #b010)
                arg1
                (fp #b0 #b111000011100 #b111)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110011110001 #b110)
                expect
                (fp #b0 #b110110000001 #b010)))
(assert (fp.leq (fp #b0 #b110110000001 #b010)
                expect
                (fp #b0 #b111101011000 #b001)))

(assert (= expect result))

(check-sat)
(exit)
