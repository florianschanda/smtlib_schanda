;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111111111111 #b00000)
                arg1
                (fp #b1 #b11111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11111)
                arg1
