(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0011101001011111 #b00001011)
                arg1
                (fp #b0 #b0000000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000)
                arg1
                (fp #b0 #b1111011110110111 #b11010101)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1010010001110001 #b00001110)
                expect
                (fp #b0 #b0000000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000)
                expect
                (fp #b0 #b0101111100111011 #b00110100)))

(assert (= expect result))

(check-sat)
(exit)
