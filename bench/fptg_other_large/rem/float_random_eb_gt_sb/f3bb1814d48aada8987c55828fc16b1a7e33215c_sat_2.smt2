(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1100110000 #b0111)
                arg1
                (fp #b1 #b1000000001 #b0100)))
(assert (fp.leq (fp #b1 #b1000000001 #b0100)
