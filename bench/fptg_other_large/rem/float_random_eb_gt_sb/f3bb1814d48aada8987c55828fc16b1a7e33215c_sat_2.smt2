(assert (fp.leq (fp #b1 #b1100111000 #b0110)
                expect
                (fp #b1 #b0000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000)
                expect
                (fp #b0 #b0000000011 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
