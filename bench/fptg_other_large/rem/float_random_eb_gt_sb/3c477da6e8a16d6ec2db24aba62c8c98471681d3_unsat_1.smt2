(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11000011100 #b0)
                arg1
                (fp #b1 #b10000000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000000 #b1)
                arg1
                (fp #b0 #b01000000000 #b0)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10111101011 #b1)
                expect
                (fp #b1 #b10000000000 #b1)))
(assert (fp.leq (fp #b1 #b10000000000 #b1)
                expect
                (fp #b0 #b00101000110 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
