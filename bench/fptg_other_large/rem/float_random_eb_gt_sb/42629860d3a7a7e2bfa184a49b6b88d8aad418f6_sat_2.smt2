; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b000000100100100 #b1100101)
                arg1
                (fp #b0 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000)
                arg1
                (fp #b0 #b100001001000110 #b1101000)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111111111111110 #b1100111)
                arg2
                (fp #b1 #b111111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b0000000)
                arg2
                (fp #b1 #b010011010000111 #b1100101)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000111011011111 #b1011010)
                expect
                (fp #b0 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000)
                expect
                (fp #b0 #b010111010110110 #b1001101)))

(assert (= expect result))

(check-sat)
(exit)
