(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b0 #b010011100001101 #b1)
                arg2
                (fp #b0 #b101111111111110 #b1)))
(assert (fp.leq (fp #b0 #b101111111111110 #b1)
                arg2
                (fp #b0 #b111001111101010 #b1)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
