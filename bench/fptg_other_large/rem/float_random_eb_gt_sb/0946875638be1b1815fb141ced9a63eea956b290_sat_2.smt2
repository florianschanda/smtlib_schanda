(assert (fp.leq (fp #b1 #b011111100 #b0)
                expect
                (fp #b1 #b000000000 #b0)))
(assert (fp.leq (fp #b1 #b000000000 #b0)
                expect
                (fp #b0 #b111011010 #b1)))

(assert (= expect result))

(check-sat)
