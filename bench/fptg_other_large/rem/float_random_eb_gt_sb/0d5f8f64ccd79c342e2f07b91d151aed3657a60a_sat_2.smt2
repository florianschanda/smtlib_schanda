(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01111110011 #b01)
                expect
                (fp #b1 #b00000000000 #b10)))
(assert (fp.leq (fp #b1 #b00000000000 #b10)
                expect
                (fp #b0 #b01011010010 #b00)))

(assert (= expect result))

(check-sat)
(exit)
