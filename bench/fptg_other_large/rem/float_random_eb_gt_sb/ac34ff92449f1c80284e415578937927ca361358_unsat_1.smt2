; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00001101100 #b1010000)
                arg1
                (fp #b0 #b00000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000)
                arg1
                (fp #b0 #b00000010000 #b1010000)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00011110001 #b1000110)
                expect
                (fp #b0 #b00000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000)
                expect
                (fp #b0 #b01010010000 #b1011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
