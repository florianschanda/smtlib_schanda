(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01011101110 #b0000)
                arg1
                (fp #b0 #b01010001101 #b0011)))
(assert (fp.leq (fp #b0 #b01010001101 #b0011)
                arg1
                (fp #b0 #b01101111010 #b0111)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01110100011 #b0101)
                expect
                (fp #b0 #b01010001101 #b0011)))
(assert (fp.leq (fp #b0 #b01010001101 #b0011)
                expect
                (fp #b0 #b11000111011 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
