; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10111111100 #b1100)
                arg1
                (fp #b1 #b10000000001 #b1000)))
(assert (fp.leq (fp #b1 #b10000000001 #b1000)
                arg1
                (fp #b0 #b10111100101 #b1101)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10001010000 #b1000)
                expect
                (fp #b1 #b00000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000)
                expect
                (fp #b0 #b00110101001 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
