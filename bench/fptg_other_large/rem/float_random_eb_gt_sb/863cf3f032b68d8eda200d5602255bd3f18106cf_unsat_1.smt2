(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b0000011101111 #b1001)
                arg1
                (fp #b0 #b0000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0100)
                arg1
                (fp #b0 #b1010000010010 #b1101)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
