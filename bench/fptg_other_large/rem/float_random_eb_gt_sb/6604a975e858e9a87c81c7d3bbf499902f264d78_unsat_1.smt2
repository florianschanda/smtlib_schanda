(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10110111100 #b11101)
                arg2
                (fp #b1 #b00000000000 #b10001)))
(assert (fp.leq (fp #b1 #b00000000000 #b10001)
                arg2
                (fp #b0 #b10011101011 #b00000)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
