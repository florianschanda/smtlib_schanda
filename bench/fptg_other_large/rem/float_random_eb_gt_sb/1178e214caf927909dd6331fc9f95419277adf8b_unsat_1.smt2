(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000111110 #b010)
                arg2
                (fp #b0 #b111010101 #b011)))
(assert (fp.leq (fp #b0 #b111010101 #b011)
                arg2
                (fp #b0 #b111110111 #b010)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
