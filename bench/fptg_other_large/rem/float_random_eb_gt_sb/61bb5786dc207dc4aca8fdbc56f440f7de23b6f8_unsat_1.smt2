(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0100011100 #b010011)
                expect
                (fp #b1 #b0000000001 #b000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b000000)
                expect
                (fp #b0 #b0001101111 #b001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
