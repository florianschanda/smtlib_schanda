(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: +NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0000010011111111 #b1110)
                arg1
                (fp #b0 #b0111111111111111 #b0000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b0000)
                arg1
                (fp #b0 #b1001010110011100 #b1100)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
