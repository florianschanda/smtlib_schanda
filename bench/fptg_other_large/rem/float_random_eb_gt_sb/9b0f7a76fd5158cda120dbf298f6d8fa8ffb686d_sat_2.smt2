(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10011100000 #b000)
                arg1
                (fp #b1 #b00000000000 #b110)))
(assert (fp.leq (fp #b1 #b00000000000 #b110)
                arg1
                (fp #b0 #b00010000111 #b101)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10010001001 #b001)
                expect
                (fp #b1 #b00000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000)
                expect
                (fp #b0 #b11101011100 #b110)))

(assert (= expect result))

(check-sat)
(exit)
