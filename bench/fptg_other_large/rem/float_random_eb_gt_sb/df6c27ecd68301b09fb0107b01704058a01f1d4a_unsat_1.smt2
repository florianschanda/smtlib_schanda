(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0101001100 #b111)
                arg1
                (fp #b0 #b1100100110 #b011)))
(assert (fp.leq (fp #b0 #b1100100110 #b011)
                arg1
                (fp #b0 #b1110101110 #b001)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0011100111 #b001)
                expect
                (fp #b0 #b1100100110 #b011)))
(assert (fp.leq (fp #b0 #b1100100110 #b011)
                expect
                (fp #b0 #b1101111110 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
