(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00110101100101 #b011010011)
                expect
                (fp #b1 #b00000000000000 #b100100111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b100100111)
                expect
                (fp #b0 #b01110011100000 #b110001011)))

(assert (= expect result))

(check-sat)
(exit)
