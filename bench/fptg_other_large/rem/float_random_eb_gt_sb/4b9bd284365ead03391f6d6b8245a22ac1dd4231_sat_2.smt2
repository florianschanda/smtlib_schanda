(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111000 #b1010000)
                arg1
                (fp #b1 #b111011000 #b0110010)))
(assert (fp.leq (fp #b1 #b111011000 #b0110010)
