; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111101101001 #b111101)
                arg1
                (fp #b1 #b1111010111000 #b001010)))
(assert (fp.leq (fp #b1 #b1111010111000 #b001010)
                arg1
                (fp #b0 #b0100001011101 #b111110)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111110000011 #b001000)
                expect
                (fp #b1 #b1111010111000 #b001010)))
(assert (fp.leq (fp #b1 #b1111010111000 #b001010)
                expect
                (fp #b0 #b0100001110001 #b100010)))

(assert (= expect result))

(check-sat)
(exit)
