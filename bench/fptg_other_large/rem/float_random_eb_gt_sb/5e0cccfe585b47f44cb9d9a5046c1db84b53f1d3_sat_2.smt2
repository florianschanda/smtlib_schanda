; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b00000101001001001 #b001011101010111)
                arg2
                (fp #b0 #b10011001110110000 #b011110101101101)))
(assert (fp.leq (fp #b0 #b10011001110110000 #b011110101101101)
                arg2
                (fp #b0 #b10111000111000110 #b000001101001010)))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
