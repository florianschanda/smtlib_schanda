(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 13))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b11101000000110 #b100100101111)
                arg2
                (fp #b1 #b01111111111111 #b100101100010)))
(assert (fp.leq (fp #b1 #b01111111111111 #b100101100010)
                arg2
                (fp #b1 #b00011011001000 #b010000000011)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
