(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000011000 #b011)
                arg2
                (fp #b1 #b0111111111 #b101)))
(assert (fp.leq (fp #b1 #b0111111111 #b101)
                arg2
                (fp #b0 #b0010011010 #b011)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
