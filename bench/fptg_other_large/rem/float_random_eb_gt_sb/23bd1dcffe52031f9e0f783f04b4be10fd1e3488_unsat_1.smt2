(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1010100110100101 #b1000011)
                arg1
                (fp #b1 #b0000000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0100000)
                arg1
                (fp #b0 #b0001001110110100 #b0010110)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1101100101100110 #b0011101)
                expect
                (fp #b1 #b0000000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0100000)
                expect
                (fp #b0 #b1010010101010111 #b0011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
