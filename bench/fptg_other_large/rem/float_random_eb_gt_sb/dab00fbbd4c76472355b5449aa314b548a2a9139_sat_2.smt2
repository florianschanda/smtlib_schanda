(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b110000000010000010 #b100110000010000)
                arg2
                (fp #b0 #b000000000000000000 #b010000010001101)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b010000010001101)
                arg2
                (fp #b0 #b110111000100000101 #b011011010110111)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
