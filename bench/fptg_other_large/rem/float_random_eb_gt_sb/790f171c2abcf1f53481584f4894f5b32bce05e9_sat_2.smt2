; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b011100100100 #b11)
                arg1
                (fp #b0 #b101111000011 #b11)))
(assert (fp.leq (fp #b0 #b101111000011 #b11)
                arg1
                (fp #b0 #b111111010010 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b000110011100 #b10)
                arg2
                (fp #b0 #b000000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000000 #b00)
                arg2
                (fp #b0 #b110001000001 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
