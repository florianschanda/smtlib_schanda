(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b11111011110000010 #b00010101101)
                arg1
                (fp #b1 #b01111111111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b01100111111)
                arg1
                (fp #b0 #b11001110111001010 #b10001011100)))

(declare-const arg2 (_ FloatingPoint 17 12))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
