                arg2
                (fp #b0 #b001000100111010011 #b0110111)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
