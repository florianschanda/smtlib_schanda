(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b11101110111110011 #b1)
                arg2
                (fp #b1 #b01000000000000000 #b0)))
(assert (fp.leq (fp #b1 #b01000000000000000 #b0)
                arg2
                (fp #b0 #b01111110101111001 #b0)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
