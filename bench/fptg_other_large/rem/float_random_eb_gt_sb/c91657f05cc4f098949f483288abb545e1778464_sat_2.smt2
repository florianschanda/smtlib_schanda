(assert (fp.leq (fp #b1 #b101001001011101 #b0001000)
                expect
                (fp #b1 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000)
                expect
                (fp #b0 #b011001000011110 #b1010010)))

(assert (= expect result))

