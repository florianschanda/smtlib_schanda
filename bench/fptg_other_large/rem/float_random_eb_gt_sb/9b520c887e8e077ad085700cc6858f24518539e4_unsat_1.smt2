(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1111110110100 #b10100)
                arg2
                (fp #b0 #b0111111111111 #b11010)))
(assert (fp.leq (fp #b0 #b0111111111111 #b11010)
                arg2
                (fp #b0 #b1101101011011 #b00001)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
