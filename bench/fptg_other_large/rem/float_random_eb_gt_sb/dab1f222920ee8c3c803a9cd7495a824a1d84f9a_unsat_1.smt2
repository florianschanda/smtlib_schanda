(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111100001101011111 #b11101)
                expect
                (fp #b1 #b010000000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b010000000000000000 #b00000)
                expect
                (fp #b0 #b100110110111101110 #b11100)))

(assert (not (= expect result)))

(check-sat)
(exit)
