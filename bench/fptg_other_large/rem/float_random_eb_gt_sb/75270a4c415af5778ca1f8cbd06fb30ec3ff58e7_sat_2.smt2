(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0100110011 #b0100110)
                expect
                (fp #b1 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000)
                expect
                (fp #b0 #b0000100000 #b1110101)))

(assert (= expect result))

(check-sat)
(exit)
