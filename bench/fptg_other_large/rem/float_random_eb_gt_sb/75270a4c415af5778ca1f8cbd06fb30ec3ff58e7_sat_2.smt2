(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010110110 #b0110001)
                arg1
                (fp #b1 #b0111111111 #b0000000)))
(assert (fp.leq (fp #b1 #b0111111111 #b0000000)
