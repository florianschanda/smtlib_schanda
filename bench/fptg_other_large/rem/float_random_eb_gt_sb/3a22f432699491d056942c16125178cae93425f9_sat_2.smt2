;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1000111011 #b1)
                arg1
                (fp #b0 #b1000000000 #b1)))
(assert (fp.leq (fp #b0 #b1000000000 #b1)
                arg1
                (fp #b0 #b1111110101 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0101000010 #b0)
                arg2
                (fp #b1 #b0100001000 #b0)))
(assert (fp.leq (fp #b1 #b0100001000 #b0)
                arg2
                (fp #b1 #b0011010100 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0100001010 #b0)
                expect
                (fp #b0 #b0000000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000000 #b0)
                expect
                (fp #b0 #b1110110100 #b1)))

(assert (= expect result))

(check-sat)
(exit)
