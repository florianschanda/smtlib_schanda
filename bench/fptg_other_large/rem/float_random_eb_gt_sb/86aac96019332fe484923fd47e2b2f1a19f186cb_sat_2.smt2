;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0110011001101101 #b1010110111)
                arg1
                (fp #b0 #b0000000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000000)
                arg1
                (fp #b0 #b0111011110101001 #b0011010100)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1111111111111111 #b0000000000)
                arg2
                (fp #b1 #b1111111111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b1111111111)
                arg2
                (fp #b1 #b0001000000101110 #b1100100010)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1101010000000101 #b1101100101)
                expect
                (fp #b0 #b0000000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000000)
                expect
                (fp #b0 #b1101001000000011 #b1011101000)))

(assert (= expect result))

(check-sat)
(exit)
