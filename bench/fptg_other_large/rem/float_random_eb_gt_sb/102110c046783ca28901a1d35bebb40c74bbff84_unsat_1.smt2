(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111000101 #b01100)
                arg2
                (fp #b0 #b100000011 #b00110)))
(assert (fp.leq (fp #b0 #b100000011 #b00110)
                arg2
                (fp #b0 #b100010010 #b01111)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
