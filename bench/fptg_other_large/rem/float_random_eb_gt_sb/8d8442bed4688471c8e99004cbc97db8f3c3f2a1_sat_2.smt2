(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0001000100 #b1)
                arg1
                (fp #b0 #b0000000001 #b0)))
(assert (fp.leq (fp #b0 #b0000000001 #b0)
                arg1
                (fp #b0 #b0110010000 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b1000111001 #b1)
                arg2
                (fp #b1 #b0000000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000000 #b0)
                arg2
                (fp #b0 #b0010010111 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
