(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1011001011001000 #b10)
                expect
                (fp #b1 #b1000000000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000000000010 #b00)
                expect
                (fp #b1 #b0000110001011111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
