(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011010011 #b0100)
                arg2
                (fp #b1 #b0000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100)
                arg2
                (fp #b0 #b0001010000 #b0101)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
