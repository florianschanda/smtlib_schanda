; Format: FLOAT128
; Arg1: -INFINITY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b111001100100000 #b0111100001100111110101110111101100001011011001010100000110001111011101110101111100010110010001111010111100001100)
                arg2
                (fp #b1 #b100000001101101 #b1011001110000111100110000001111011110000000001010110100010010010010110100110011010111011001011111100001101010100)))
(assert (fp.leq (fp #b1 #b100000001101101 #b1011001110000111100110000001111011110000000001010110100010010010010110100110011010111011001011111100001101010100)
                arg2
                (fp #b0 #b111110110011001 #b0100101010110010000110011001011100001110101011010010100010100010110110000011110111101011011100111100100111000000)))

(declare-const result Float128)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
