(assert (fp.leq (fp #b0 #b100110011101101 #b1001111010110101001101000100001011010011010011010001011101011101110100111100000011011011001101011101100110110011)
                arg2
                (fp #b0 #b100110101000011 #b1110011100010110010101001101101100111111101001000010011010000011100010100000111010011101000010001001001010011101)))

(declare-const result Float128)
(assert (= result (fp.rem arg1 arg2)))

