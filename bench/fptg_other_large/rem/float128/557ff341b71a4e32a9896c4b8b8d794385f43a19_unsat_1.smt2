                (fp #b0 #b111100011100111 #b0001101011101100000010110001010111100100110011011000000011010011101100001001111001000001100111101100010011010000)))

(declare-const result Float128)
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect Float128)
