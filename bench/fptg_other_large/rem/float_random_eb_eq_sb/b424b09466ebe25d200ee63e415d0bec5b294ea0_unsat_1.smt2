(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b000100111111001010 #b11110101011111011)
                arg1
                (fp #b0 #b010100101001111011 #b11100011111101001)))
(assert (fp.leq (fp #b0 #b010100101001111011 #b11100011111101001)
                arg1
                (fp #b0 #b011010111001010000 #b00011000111000110)))

