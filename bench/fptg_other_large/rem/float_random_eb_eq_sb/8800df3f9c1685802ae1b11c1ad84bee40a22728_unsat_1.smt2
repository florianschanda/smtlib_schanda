; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110001100011100 #b111010010010001)
                arg2
                (fp #b1 #b1000000000001110 #b110110100010101)))
(assert (fp.leq (fp #b1 #b1000000000001110 #b110110100010101)
                arg2
                (fp #b0 #b0101110111000110 #b000000100100000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
