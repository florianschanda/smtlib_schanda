(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001000 #b000000101)
                arg1
                (fp #b1 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111111)
                arg1
                (fp #b0 #b1000100100 #b101000010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100100011 #b001011100)
                expect
                (fp #b1 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111111)
                expect
                (fp #b1 #b1010011110 #b110010111)))

(assert (= expect result))

(check-sat)
(exit)
