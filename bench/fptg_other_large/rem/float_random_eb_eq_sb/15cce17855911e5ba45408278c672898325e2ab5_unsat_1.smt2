;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111110100111111011 #b00101011111011010)
                arg1
                (fp #b0 #b000000000000000001 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000001 #b00000000000000000)
                arg1
