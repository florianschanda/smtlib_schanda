; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001100101 #b001100001)
                arg1
                (fp #b1 #b0111111111 #b111000101)))
(assert (fp.leq (fp #b1 #b0111111111 #b111000101)
                arg1
                (fp #b0 #b0101001101 #b001010011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110010101 #b110001000)
                expect
                (fp #b1 #b0111111111 #b111000101)))
(assert (fp.leq (fp #b1 #b0111111111 #b111000101)
                expect
                (fp #b0 #b1011010100 #b000111111)))

(assert (= expect result))

(check-sat)
(exit)
