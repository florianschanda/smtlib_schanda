(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -INFINITY

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111001011 #b00110101101)
                arg1
                (fp #b1 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b001111111010 #b01101010000)
                arg1
                (fp #b0 #b111001111000 #b00000101000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110001111 #b01011101100)
                expect
                (fp #b1 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b001111111010 #b01101010000)
                expect
                (fp #b0 #b011011011000 #b00001101111)))

(assert (= expect result))

(check-sat)
(exit)
