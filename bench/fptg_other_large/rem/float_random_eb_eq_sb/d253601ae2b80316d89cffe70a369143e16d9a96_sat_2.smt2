; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000100110000 #b0110101001111)
                arg1
                (fp #b1 #b10000000001100 #b1111100010101)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1111100010101)
                arg1
                (fp #b0 #b11010011101001 #b1111011111001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10010110001000 #b1111101011110)
                expect
                (fp #b1 #b10000000001100 #b1111100010101)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1111100010101)
                expect
                (fp #b0 #b10010000111001 #b0101010011110)))

(assert (= expect result))

(check-sat)
(exit)
