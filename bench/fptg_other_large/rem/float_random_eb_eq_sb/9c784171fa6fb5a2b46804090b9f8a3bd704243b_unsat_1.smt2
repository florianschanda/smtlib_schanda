; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101010111101101 #b01111010001100)
                arg2
                (fp #b1 #b001111111111001 #b00000000000000)))
(assert (fp.leq (fp #b1 #b001111111111001 #b00000000000000)
                arg2
                (fp #b0 #b110111111001110 #b10110010101010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
