(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00110101010 #b0111011001)
                arg1
                (fp #b0 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111)
                arg1
                (fp #b0 #b11101101101 #b1111011110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
