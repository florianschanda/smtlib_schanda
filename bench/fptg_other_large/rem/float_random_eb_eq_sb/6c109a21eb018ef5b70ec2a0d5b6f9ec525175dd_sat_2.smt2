(assert (fp.leq (fp #b1 #b100001001 #b10111100)
                expect
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                expect
                (fp #b0 #b001011010 #b10100001)))

(assert (= expect result))

(check-sat)
