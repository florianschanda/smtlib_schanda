; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110000 #b101111101)
                arg1
                (fp #b1 #b1000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b1000001000 #b011100001)
                arg1
                (fp #b0 #b0000000101 #b001101101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0111111100 #b001110000)
                arg2
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                arg2
                (fp #b0 #b0111000010 #b111110101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
