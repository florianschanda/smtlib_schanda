;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100001100 #b00000001)
                arg1
                (fp #b0 #b100000111 #b11000011)))
(assert (fp.leq (fp #b0 #b100000111 #b11000011)
                arg1
                (fp #b0 #b101011100 #b00111000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010000001 #b01110110)
                expect
                (fp #b0 #b100000111 #b11000011)))
(assert (fp.leq (fp #b0 #b100000111 #b11000011)
                expect
                (fp #b0 #b111000101 #b10100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
