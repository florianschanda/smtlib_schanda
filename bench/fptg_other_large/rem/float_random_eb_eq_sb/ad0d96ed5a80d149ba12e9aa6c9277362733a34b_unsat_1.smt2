; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1011100011010 #b000110001100)
                arg2
                (fp #b1 #b0011111111010 #b000000000000)))
(assert (fp.leq (fp #b1 #b0011111111010 #b000000000000)
                arg2
                (fp #b0 #b1100010001001 #b111111110000)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
