(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: +ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b000000111110100 #b10110011101010)
                arg2
                (fp #b0 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000000)
                arg2
                (fp #b0 #b000001010111100 #b01111001000110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
