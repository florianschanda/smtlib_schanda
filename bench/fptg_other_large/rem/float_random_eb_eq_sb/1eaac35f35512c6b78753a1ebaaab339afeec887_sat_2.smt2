(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011111100 #b0110001011)
                expect
                (fp #b1 #b10010111000 #b0110101101)))
(assert (fp.leq (fp #b1 #b10010111000 #b0110101101)
                expect
                (fp #b1 #b00011001000 #b0111001110)))

(assert (= expect result))

(check-sat)
