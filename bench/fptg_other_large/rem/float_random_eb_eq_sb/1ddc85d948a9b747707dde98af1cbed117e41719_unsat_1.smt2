; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b00010110010110 #b1011001101001)
                arg2
                (fp #b0 #b10000000001100 #b1001111110101)))
(assert (fp.leq (fp #b0 #b10000000001100 #b1001111110101)
                arg2
                (fp #b0 #b10111101011010 #b1011011111110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
