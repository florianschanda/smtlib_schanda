; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0000100010001110 #b110001111001110)
                arg1
                (fp #b0 #b1101000000101101 #b100100100100101)))
(assert (fp.leq (fp #b0 #b1101000000101101 #b100100100100101)
                arg1
                (fp #b0 #b1111010011101001 #b011111101000110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0011000111110000 #b011101000000001)
                expect
                (fp #b0 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b0110000100010001 #b010111000100011)))

(assert (= expect result))

(check-sat)
(exit)
