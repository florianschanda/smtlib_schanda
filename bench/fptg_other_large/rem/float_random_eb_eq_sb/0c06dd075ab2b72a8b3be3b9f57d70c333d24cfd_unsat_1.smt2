(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0100001100100 #b110101010000)
                arg1
                (fp #b1 #b0000000000001 #b000000000000)))
(assert (fp.leq (fp #b1 #b0000000000001 #b000000000000)
                arg1
                (fp #b0 #b1000001011101 #b001001001111)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
