; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100011011011 #b101011000111)
                arg1
                (fp #b1 #b1011101011000 #b100011101100)))
(assert (fp.leq (fp #b1 #b1011101011000 #b100011101100)
                arg1
                (fp #b1 #b1000111001110 #b110011101010)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
