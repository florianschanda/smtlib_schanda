(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110111111101 #b0010101110000)
                arg2
                (fp #b1 #b11100110110100 #b1101101000111)))
(assert (fp.leq (fp #b1 #b11100110110100 #b1101101000111)
                arg2
                (fp #b0 #b01001001111000 #b1111011010000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
