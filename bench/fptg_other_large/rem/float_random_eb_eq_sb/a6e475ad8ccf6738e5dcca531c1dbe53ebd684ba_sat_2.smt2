(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100110111 #b10001011101)
                arg2
                (fp #b0 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000001)
                arg2
                (fp #b0 #b111011100000 #b00011100111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
