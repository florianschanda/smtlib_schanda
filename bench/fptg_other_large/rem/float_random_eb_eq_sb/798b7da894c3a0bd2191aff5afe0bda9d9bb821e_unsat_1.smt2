(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10001100010101101 #b1000011111111100)
                arg2
                (fp #b1 #b00000000000000000 #b1111000111010011)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1111000111010011)
                arg2
                (fp #b0 #b00101010101011101 #b1011000111011100)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
