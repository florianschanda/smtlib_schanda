(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +NAN

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10000111001110010 #b0101011011101010)
                arg1
                (fp #b1 #b10000000000001110 #b0001111101100110)))
(assert (fp.leq (fp #b1 #b10000000000001110 #b0001111101100110)
                arg1
                (fp #b0 #b01001110111010101 #b0010101001011010)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
