(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100100000 #b01011111010)
                expect
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                expect
                (fp #b1 #b010010010111 #b00101000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
