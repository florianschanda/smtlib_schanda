(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010001101000011 #b010110111010001)
                arg2
                (fp #b1 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b0 #b1010010111110101 #b101111011010101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
