(assert (fp.leq (fp #b1 #b000000000000 #b01101101001)
                arg2
                (fp #b0 #b000001011111 #b10111111001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110101011000 #b01010111110)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b111010110011 #b10111101101)))

(assert (= expect result))

(check-sat)
