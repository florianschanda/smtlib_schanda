(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -ZERO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 44))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 44))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10010011011001 #b1100101110010011101000110110010000001001100)
                arg2
                (fp #b1 #b00000000000000 #b0000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00101100010000 #b1000100111111000110011010001101000000111101)))

(declare-const result (_ FloatingPoint 14 44))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 44))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
