; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 33))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 33))
(assert (fp.leq (fp #b1 #b11101101100000 #b10010100001111101001100100101001)
                arg2
                (fp #b1 #b10000000011101 #b10110011100001111001100000100000)))
(assert (fp.leq (fp #b1 #b10000000011101 #b10110011100001111001100000100000)
                arg2
                (fp #b0 #b01010110110110 #b11101111011100001000000101011111)))

(declare-const result (_ FloatingPoint 14 33))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 33))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
