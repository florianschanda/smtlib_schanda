(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 22))
(assert (fp.leq (fp #b1 #b100000011011101 #b010100010011101001101)
                arg2
                (fp #b0 #b110000000110110 #b001010111001100111100)))
