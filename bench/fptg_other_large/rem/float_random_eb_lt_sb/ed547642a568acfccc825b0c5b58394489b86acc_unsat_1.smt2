                arg2
                (fp #b0 #b111101000011110 #b101001111100001000101)))

(declare-const result (_ FloatingPoint 15 22))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 22))
