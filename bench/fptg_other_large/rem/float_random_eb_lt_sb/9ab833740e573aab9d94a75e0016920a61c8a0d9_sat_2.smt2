; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: REM
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 17))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 17))
(assert (fp.leq (fp #b1 #b11101011101 #b0001111000100011)
                arg2
                (fp #b1 #b01111111111 #b1011110111011110)))
(assert (fp.leq (fp #b1 #b01111111111 #b1011110111011110)
                arg2
                (fp #b1 #b01110010110 #b1100011011101011)))

(declare-const result (_ FloatingPoint 11 17))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
