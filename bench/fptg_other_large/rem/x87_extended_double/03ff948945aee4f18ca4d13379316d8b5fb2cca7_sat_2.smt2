                arg2
                (fp #b0 #b100000000111000 #b100001001001100011100000101100001111000111110101101011000000101)))

(declare-const result (_ FloatingPoint 15 64))
(assert (= result (fp.rem arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
