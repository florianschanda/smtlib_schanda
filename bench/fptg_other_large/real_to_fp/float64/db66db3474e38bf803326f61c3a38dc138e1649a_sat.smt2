; Format: FLOAT64
; Target class: -ZERO

; Redundancy: False
; Validation for: REAL_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Real)
(assert (<= arg1 0.0))
(assert (<= 0.0 arg1))

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01101011110 #b0101010110010110001011010011110110111100011110101101)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11101110110 #b0010001110100001100000001101110011010011000011110000)))

(assert (= expect result))

(check-sat)
(exit)
