; Format: FLOAT_RANDOM_EB_GT_SB
; Target class: +ZERO

; Redundancy: False
; Validation for: REAL_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Real)
(assert (<= arg1 0.0))
(assert (<= 0.0 arg1))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result ((_ to_fp 10 2) rm arg1)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0011110001 #b1)
                expect
                (fp #b0 #b0000000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000000 #b0)
                expect
                (fp #b0 #b1100011111 #b1)))

(assert (= expect result))

(check-sat)
(exit)
