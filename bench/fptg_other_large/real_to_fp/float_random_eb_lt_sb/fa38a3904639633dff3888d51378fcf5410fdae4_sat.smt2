(declare-const rm RoundingMode)

(declare-const arg1 Real)
(assert (<= arg1 0.0))
(assert (<= 0.0 arg1))

(declare-const result (_ FloatingPoint 6 36))
(assert (= result ((_ to_fp 6 36) rm arg1)))

