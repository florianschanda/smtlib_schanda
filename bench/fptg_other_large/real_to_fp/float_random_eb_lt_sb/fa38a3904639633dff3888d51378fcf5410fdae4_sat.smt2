(assert (fp.leq (fp #b1 #b001111 #b00100100000010101001101001011011101)
                expect
                (fp #b0 #b000000 #b00000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000000 #b00000000000000000000000000000000000)
                expect
                (fp #b0 #b100100 #b11100001110011010100101101100010000)))

(assert (= expect result))

(check-sat)
