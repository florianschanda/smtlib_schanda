; Format: FLOAT64
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b10011011001 #b0000110010001111100010101010011001010001101001111101)
                arg
                (fp #b1 #b01111111111 #b1101000110001101010000000001101100000010101110101011)))
(assert (fp.leq (fp #b1 #b01111111111 #b1101000110001101010000000001101100000010101110101011)
                arg
                (fp #b0 #b11111001001 #b1001001111001011001000001111010001111011110011001011)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b01000001)))
(assert (not (bvule #b01000011 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
