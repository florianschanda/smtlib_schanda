(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Target: bv48
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b10100101000 #b0101101001010100000010010101101100101001001111111100)
                arg
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg
                (fp #b0 #b10101101000 #b0010000110100110110101110101010000000010010001100011)))

(declare-const result (_ BitVec 48))
(assert (= result ((_ fp.to_ubv 48) rm arg)))

(declare-const expect (_ BitVec 48))
(assert (= expect #b000000000000000000000000000000000000000000000001))

(assert (= expect result))

(check-sat)
(exit)
