(assert (fp.leq (fp #b1 #b00010010001 #b1110011000000111011111110000001101100010010011101001)
                arg
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg
                (fp #b0 #b01010100100 #b0111000110001011000001110001110101111011000100011011)))

(declare-const result (_ BitVec 28))
(assert (= result ((_ fp.to_ubv 28) rm arg)))

(declare-const expect (_ BitVec 28))
(assert (= expect #b0100000101001001011010100001))

(assert (not (= expect result)))
