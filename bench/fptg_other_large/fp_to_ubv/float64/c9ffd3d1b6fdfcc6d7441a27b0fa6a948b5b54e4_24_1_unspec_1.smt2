; Format: FLOAT64
; Target: bv24
; Arg1: -ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b10001011110 #b0011001101101001100010110111011110010011100011101101)
                arg
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg
                (fp #b1 #b00000110001 #b1101110010110000000100100111100100010100010001111011)))

(declare-const result (_ BitVec 24))
(assert (= result ((_ fp.to_ubv 24) rm arg)))

(declare-const expect (_ BitVec 24))
(assert (not (bvule expect #b011111010011011100000000)))
(assert (not (bvule #b011111010011011100000010 expect)))

(assert (not (= expect result)))
