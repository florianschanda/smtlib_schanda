; Format: FLOAT64
; Target: bv8
; Arg1: +RANDOM_SUBNORMAL(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b01001100000 #b1010011100001110110001110001101111001010111011110000)
                arg
                (fp #b0 #b00000000000 #b0011100010001100001000101111110001110011001001100101)))
(assert (fp.leq (fp #b0 #b00000000000 #b0011100010001100001000101111110001110011001001100101)
                arg
                (fp #b0 #b11001111100 #b1010011001111110010011111010111010011111010100111110)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule #b00000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
