; Format: FLOAT64
; Target: bv7
; Arg1: +INFINITY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float64)
(assert (fp.isPositive arg))
(assert (fp.isInfinite arg))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (= expect #b1110001))

(assert (not (= expect result)))
