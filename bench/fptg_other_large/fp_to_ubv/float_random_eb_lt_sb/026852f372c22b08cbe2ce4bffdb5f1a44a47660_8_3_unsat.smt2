; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv8
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 3 61))
(assert (fp.leq (fp #b1 #b101 #b001100001010011010111010110010010000010011110101011101110100)
                arg
                (fp #b0 #b000 #b000000000000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b000 #b000000000000000000000000000000000000000000000000000000000001)
                arg
                (fp #b0 #b100 #b011101000000111100101111101010011101100110101111010100100100)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000000)))
(assert (not (bvule #b00000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
