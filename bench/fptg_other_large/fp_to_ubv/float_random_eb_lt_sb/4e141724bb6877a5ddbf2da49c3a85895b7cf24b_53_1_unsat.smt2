; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv53
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 7 32))
(assert (fp.leq (fp #b0 #b0010101 #b1110000100111110110111010010010)
                arg
                (fp #b0 #b0111111 #b1111000011111111111000110001010)))
(assert (fp.leq (fp #b0 #b0111111 #b1111000011111111111000110001010)
                arg
                (fp #b0 #b1101000 #b1101010011000111011000111010000)))

(declare-const result (_ BitVec 53))
(assert (= result ((_ fp.to_ubv 53) rm arg)))

(declare-const expect (_ BitVec 53))
(assert (not (bvule expect #b00000000000000000000000000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
