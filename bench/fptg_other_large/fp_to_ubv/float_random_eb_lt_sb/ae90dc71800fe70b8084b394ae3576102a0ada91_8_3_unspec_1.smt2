;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 10 29))
(assert (fp.leq (fp #b1 #b1101011110 #b0001000111101110111101111110)
                arg
                (fp #b1 #b0000000000 #b0011000000011000101010101000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0011000000011000101010101000)
                arg
                (fp #b0 #b0010010000 #b1101110000110110000000101000)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b11000011))

(assert (not (= expect result)))
