(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1011110100100 #b0000)
                arg
                (fp #b0 #b0111111111111 #b0110)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0110)
                arg
                (fp #b0 #b1000101111010 #b1101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000000)))
(assert (not (bvule #b00000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
