; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b00101111011001 #b00101)
                arg
                (fp #b0 #b01000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b00000)
                arg
                (fp #b0 #b01110000000111 #b01010)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_ubv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (= expect #b01))

(assert (not (= expect result)))

(check-sat)
(exit)
