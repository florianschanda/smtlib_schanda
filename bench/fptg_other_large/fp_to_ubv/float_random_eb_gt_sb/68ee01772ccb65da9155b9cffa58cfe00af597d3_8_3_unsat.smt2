; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b111011000100011011 #b111010000011000)
                arg
                (fp #b0 #b001000101000010010 #b100001001011000)))
(assert (fp.leq (fp #b0 #b001000101000010010 #b100001001011000)
                arg
                (fp #b0 #b001000111100000001 #b011100111110010)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00000001))

(assert (not (= expect result)))

(check-sat)
(exit)
