; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1001001000101011 #b001110)
                arg
                (fp #b1 #b0100110001101000 #b000010)))
(assert (fp.leq (fp #b1 #b0100110001101000 #b000010)
                arg
                (fp #b1 #b0100010101110001 #b000011)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b01100000000000010111110010011010))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
