(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11100001100101 #b00001)
                arg
                (fp #b1 #b10101101001101 #b11110)))
(assert (fp.leq (fp #b1 #b10101101001101 #b11110)
                arg
                (fp #b1 #b10101000110011 #b01011)))

(declare-const result (_ BitVec 32))
