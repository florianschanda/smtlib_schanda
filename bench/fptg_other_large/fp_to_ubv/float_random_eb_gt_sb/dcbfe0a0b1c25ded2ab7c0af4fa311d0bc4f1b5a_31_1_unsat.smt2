; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv31
; Arg1: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10111000001000 #b0111)
                arg
                (fp #b1 #b00000000000000 #b1000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1000)
                arg
                (fp #b0 #b01111100010010 #b1010)))

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_ubv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (not (bvule #b0000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
