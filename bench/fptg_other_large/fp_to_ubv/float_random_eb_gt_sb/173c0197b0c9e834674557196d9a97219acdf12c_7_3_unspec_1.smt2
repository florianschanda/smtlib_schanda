(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv7
; Arg1: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000100100 #b10111001)
                arg
                (fp #b1 #b0000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b00000000)
                arg
                (fp #b0 #b0011111101 #b01100111)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b1100111)))
(assert (not (bvule #b1101001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
