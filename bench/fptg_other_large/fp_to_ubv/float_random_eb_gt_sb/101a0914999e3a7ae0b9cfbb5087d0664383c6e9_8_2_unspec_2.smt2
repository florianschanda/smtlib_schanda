; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11100111000111 #b01101111101)
                arg
                (fp #b1 #b10000000000111 #b10110100000)))
(assert (fp.leq (fp #b1 #b10000000000111 #b10110100000)
                arg
                (fp #b0 #b01011101001010 #b11101111101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11000100)))
(assert (not (bvule #b11000110 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
