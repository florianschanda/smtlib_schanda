; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv1
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1011110111010101 #b00)
                arg
                (fp #b0 #b0100000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b00)
                arg
                (fp #b0 #b0111101111110000 #b10)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b1))

(assert (= expect result))

(check-sat)
(exit)
