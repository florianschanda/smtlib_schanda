; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv3
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000110111 #b11101)
                arg
                (fp #b1 #b1000000011 #b10110)))
(assert (fp.leq (fp #b1 #b1000000011 #b10110)
                arg
                (fp #b1 #b0101000000 #b10111)))

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b000)))
(assert (not (bvule #b010 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
