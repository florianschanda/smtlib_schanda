; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01011100010 #b10)
                arg
                (fp #b1 #b00110001011 #b00)))
(assert (fp.leq (fp #b1 #b00110001011 #b00)
                arg
                (fp #b0 #b10101101010 #b00)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b0101111100111101101001001111001000010101110010111001010111001000))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
