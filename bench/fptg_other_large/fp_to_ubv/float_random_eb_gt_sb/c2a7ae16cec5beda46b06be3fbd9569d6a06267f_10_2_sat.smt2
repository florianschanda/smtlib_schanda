(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b011011110 #b01010)
                arg
                (fp #b0 #b100000100 #b10000)))
(assert (fp.leq (fp #b0 #b100000100 #b10000)
                arg
                (fp #b0 #b111011101 #b01111)))

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_ubv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (not (bvule expect #b0000101111)))
(assert (not (bvule #b0000110001 expect)))

(assert (= expect result))

(check-sat)
(exit)
