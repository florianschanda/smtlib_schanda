(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b011101000001010 #b1011101101101)
                arg
                (fp #b1 #b000000000000001 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0000000000000)
                arg
                (fp #b0 #b110001110001110 #b0001001100010)))

(declare-const result (_ BitVec 53))
(assert (= result ((_ fp.to_ubv 53) rm arg)))

(declare-const expect (_ BitVec 53))
(assert (not (bvule expect #b00100011011100110000101101111111100011101000000101001)))
(assert (not (bvule #b00100011011100110000101101111111100011101000000101011 expect)))

(assert (not (= expect result)))
