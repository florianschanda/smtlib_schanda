; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv17
; Arg1: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111011011 #b01)
                arg
                (fp #b1 #b000000000 #b11)))
(assert (fp.leq (fp #b1 #b000000000 #b11)
                arg
                (fp #b0 #b111111010 #b10)))

(declare-const result (_ BitVec 17))
(assert (= result ((_ fp.to_ubv 17) rm arg)))

(declare-const expect (_ BitVec 17))
(assert (= expect #b10110100110110100))

(assert (= expect result))
