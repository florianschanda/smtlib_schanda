; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b01101110111110111 #b00100110)
                arg
                (fp #b1 #b00000000000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00000001)
                arg
                (fp #b0 #b10011000101000101 #b11010011)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b0001111010011100001111010010010001110110011111100000111010111100)))
(assert (not (bvule #b0001111010011100001111010010010001110110011111100000111010111110 expect)))

(assert (= expect result))
