(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: -ZERO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 5))
(assert (fp.isNegative arg))
(assert (fp.leq (fp #b1 #b111011111 #b0010)
                arg
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg
                (fp #b0 #b001110101 #b0111)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_ubv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule #b01 expect)))

(assert (= expect result))

(check-sat)
(exit)
