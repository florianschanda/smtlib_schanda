; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011101101 #b01)
                arg
                (fp #b1 #b000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000 #b01)
                arg
                (fp #b0 #b001100110 #b11)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b0001100101101101101111010001101011101000110000101100000000111111))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
