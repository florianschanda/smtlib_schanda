(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv4
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b0001001011000 #b0)
                arg
                (fp #b0 #b0000111101000 #b1)))
(assert (fp.leq (fp #b0 #b0000111101000 #b1)
                arg
                (fp #b0 #b0101111100010 #b0)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_ubv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (= expect #b0001))

(assert (= expect result))

(check-sat)
(exit)
