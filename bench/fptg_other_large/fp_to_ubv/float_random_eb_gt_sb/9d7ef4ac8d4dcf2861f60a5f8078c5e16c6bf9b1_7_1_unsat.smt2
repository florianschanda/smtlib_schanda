; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv7
; Arg1: +RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1000011111 #b0010101)
                arg
                (fp #b0 #b0000000000 #b1100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100110)
                arg
                (fp #b0 #b1000101100 #b1100100)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule #b0000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
