; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv20
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01000111010 #b10101)
                arg
                (fp #b0 #b01111111111 #b10111)))
(assert (fp.leq (fp #b0 #b01111111111 #b10111)
                arg
                (fp #b0 #b10000111001 #b01011)))

(declare-const result (_ BitVec 20))
(assert (= result ((_ fp.to_ubv 20) rm arg)))

(declare-const expect (_ BitVec 20))
(assert (= expect #b00000000000000000001))

(assert (not (= expect result)))

(check-sat)
(exit)
