; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b011000100 #b0)
                arg
                (fp #b0 #b100000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000 #b1)
                arg
                (fp #b0 #b101101101 #b0)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000010)))
(assert (not (bvule #b00000100 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
