(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01110100101 #b11011)
                arg
                (fp #b0 #b10000000100 #b11101)))
(assert (fp.leq (fp #b0 #b10000000100 #b11101)
                arg
                (fp #b0 #b10010001011 #b10001)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00111100)))
(assert (not (bvule #b00111110 expect)))

(assert (= expect result))

(check-sat)
(exit)
