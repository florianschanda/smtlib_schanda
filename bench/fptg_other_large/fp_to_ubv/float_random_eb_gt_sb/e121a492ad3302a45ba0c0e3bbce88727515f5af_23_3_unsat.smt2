; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv23
; Arg1: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111100100 #b0100111)
                arg
                (fp #b0 #b000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b000000000 #b1011100)
                arg
                (fp #b0 #b101011101 #b1100111)))

(declare-const result (_ BitVec 23))
(assert (= result ((_ fp.to_ubv 23) rm arg)))

(declare-const expect (_ BitVec 23))
(assert (not (bvule expect #b00000000000000000000000)))
(assert (not (bvule #b00000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
