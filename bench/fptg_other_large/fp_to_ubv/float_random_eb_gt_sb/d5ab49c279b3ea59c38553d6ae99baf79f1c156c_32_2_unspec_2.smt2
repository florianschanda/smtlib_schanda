(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101011000110 #b101000)
                arg
                (fp #b1 #b100101110100 #b011001)))
(assert (fp.leq (fp #b1 #b100101110100 #b011001)
                arg
                (fp #b0 #b001110110010 #b000100)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b01100011110010100011110011110111)))
(assert (not (bvule #b01100011110010100011110011111001 expect)))

(assert (= expect result))
