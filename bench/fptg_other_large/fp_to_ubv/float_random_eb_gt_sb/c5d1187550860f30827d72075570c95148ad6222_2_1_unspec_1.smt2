; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111111 #b00000)
                arg
                (fp #b1 #b1111111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111)
                arg
                (fp #b1 #b1010000001 #b00011)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_ubv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule expect #b01)))
(assert (not (bvule #b11 expect)))

(assert (not (= expect result)))
