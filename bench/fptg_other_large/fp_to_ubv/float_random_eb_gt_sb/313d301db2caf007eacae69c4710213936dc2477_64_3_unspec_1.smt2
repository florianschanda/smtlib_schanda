; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1000011001000100 #b010)
                arg
                (fp #b1 #b0010100110110010 #b011)))
(assert (fp.leq (fp #b1 #b0010100110110010 #b011)
                arg
                (fp #b0 #b1011010111010101 #b000)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b1100011101000110010011101001111000000001110100010111011100001110))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
