(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: +RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110110111010111 #b000000110)
                arg
                (fp #b0 #b0111111111111111 #b110010111)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b110010111)
                arg
                (fp #b0 #b1001111001001000 #b000111011)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_ubv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule expect #b01)))
(assert (not (bvule #b11 expect)))

(assert (= expect result))

(check-sat)
(exit)
