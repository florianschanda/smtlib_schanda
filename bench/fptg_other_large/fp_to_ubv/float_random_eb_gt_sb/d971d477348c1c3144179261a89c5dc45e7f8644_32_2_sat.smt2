(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0010101101011011 #b00011110000000)
                arg
                (fp #b1 #b0000000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01000000000000)
                arg
                (fp #b0 #b0100010110110110 #b01011100100110)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule #b00000000000000000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
