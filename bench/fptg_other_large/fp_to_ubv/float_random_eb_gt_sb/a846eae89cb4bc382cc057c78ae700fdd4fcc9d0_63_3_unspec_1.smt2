(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111000001110 #b111)
                arg
                (fp #b1 #b010000101100 #b100)))
(assert (fp.leq (fp #b1 #b010000101100 #b100)
                arg
                (fp #b0 #b110100111111 #b010)))

(declare-const result (_ BitVec 63))
(assert (= result ((_ fp.to_ubv 63) rm arg)))

(declare-const expect (_ BitVec 63))
(assert (= expect #b111001111010111011010111111110011100011111010110010000011101001))

(assert (not (= expect result)))
