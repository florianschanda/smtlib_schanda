; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001101010 #b0000001)
                arg
                (fp #b1 #b0000000000 #b1101100)))
(assert (fp.leq (fp #b1 #b0000000000 #b1101100)
                arg
                (fp #b0 #b1101000111 #b1011010)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b0101001001110010101101000101010101100101111111010010010010010000))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
