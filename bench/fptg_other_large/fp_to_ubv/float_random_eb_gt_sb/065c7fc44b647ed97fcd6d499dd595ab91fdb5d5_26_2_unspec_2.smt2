; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv26
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111101000 #b10101)
                arg
                (fp #b1 #b011111111 #b10110)))
(assert (fp.leq (fp #b1 #b011111111 #b10110)
                arg
                (fp #b1 #b001100101 #b10011)))

(declare-const result (_ BitVec 26))
(assert (= result ((_ fp.to_ubv 26) rm arg)))

(declare-const expect (_ BitVec 26))
(assert (not (bvule expect #b11010010000011101110100000)))
(assert (not (bvule #b11010010000011101110100010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
