; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b01101101101110010 #b10101001)
                arg
                (fp #b1 #b00000000000000000 #b00010110)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00010110)
                arg
                (fp #b0 #b00100001100001100 #b10111100)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1001111011010101100100110110010000110111011001111010101010001100)))
(assert (not (bvule #b1001111011010101100100110110010000110111011001111010101010001110 expect)))

(assert (not (= expect result)))
