; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b110111100110 #b11001)
                arg
                (fp #b1 #b001001100000 #b10001)))
(assert (fp.leq (fp #b1 #b001001100000 #b10001)
                arg
                (fp #b0 #b001011010100 #b01011)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b1011010100011011101000110010111011010110010001000111011111010000))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
