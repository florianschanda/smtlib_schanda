(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv1
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000000011000 #b01110100)
                arg
                (fp #b0 #b000110111011 #b01101011)))
(assert (fp.leq (fp #b0 #b000110111011 #b01101011)
                arg
                (fp #b0 #b010111011011 #b01100110)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))

(check-sat)
(exit)
