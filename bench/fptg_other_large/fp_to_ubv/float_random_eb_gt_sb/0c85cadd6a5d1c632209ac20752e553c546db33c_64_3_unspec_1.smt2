(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000011001 #b10001001)
                arg
                (fp #b1 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000000)
                arg
                (fp #b0 #b0110100011 #b10010111)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b1100011010101001001110110100010110100011101111111110011000110011))

(assert (not (= expect result)))
