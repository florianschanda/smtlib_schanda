; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00100110110011 #b000001001)
                arg
                (fp #b0 #b10010011001111 #b110110001)))
(assert (fp.leq (fp #b0 #b10010011001111 #b110110001)
                arg
                (fp #b0 #b11000001000001 #b101010011)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11011011011101001010000001011010)))
(assert (not (bvule #b11011011011101001010000001011100 expect)))

(assert (= expect result))
