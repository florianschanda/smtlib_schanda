(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv16
; Arg1: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b011101000001010 #b1011101101101)
                arg
                (fp #b1 #b000000000000001 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0000000000000)
                arg
                (fp #b0 #b110001110001110 #b0001001100010)))

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_ubv 16) rm arg)))

(declare-const expect (_ BitVec 16))
(assert (not (bvule expect #b1101000000111000)))
(assert (not (bvule #b1101000000111010 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
