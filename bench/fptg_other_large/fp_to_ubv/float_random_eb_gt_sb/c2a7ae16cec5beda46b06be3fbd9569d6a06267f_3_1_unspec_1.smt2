; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b011011110 #b01010)
                arg
                (fp #b0 #b100000100 #b10000)))
(assert (fp.leq (fp #b0 #b100000100 #b10000)
                arg
                (fp #b0 #b111011101 #b01111)))

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_ubv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b101)))
(assert (not (bvule #b111 expect)))

(assert (not (= expect result)))
