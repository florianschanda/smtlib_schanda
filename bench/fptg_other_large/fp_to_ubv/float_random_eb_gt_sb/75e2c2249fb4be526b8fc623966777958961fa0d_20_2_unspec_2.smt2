(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv20
; Arg1: -INFINITY

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 12 3))
(assert (fp.isNegative arg))
(assert (fp.isInfinite arg))

(declare-const result (_ BitVec 20))
(assert (= result ((_ fp.to_ubv 20) rm arg)))

(declare-const expect (_ BitVec 20))
(assert (not (bvule expect #b10001001010000111010)))
(assert (not (bvule #b10001001010000111100 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
