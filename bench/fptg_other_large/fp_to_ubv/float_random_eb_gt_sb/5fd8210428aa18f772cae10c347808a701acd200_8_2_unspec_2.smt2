; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10000101100111 #b01000101)
                arg
                (fp #b1 #b10000000000111 #b01111111)))
(assert (fp.leq (fp #b1 #b10000000000111 #b01111111)
                arg
                (fp #b1 #b00110100010011 #b10000101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00010100)))
(assert (not (bvule #b00010110 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
