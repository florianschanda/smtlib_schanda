; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101100100 #b1111100)
                arg
                (fp #b1 #b100000110 #b0011101)))
(assert (fp.leq (fp #b1 #b100000110 #b0011101)
                arg
                (fp #b0 #b001100001 #b1000011)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11101101)))
(assert (not (bvule #b11101111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
