; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01101000111 #b0)
                arg
                (fp #b0 #b00010001001 #b1)))
(assert (fp.leq (fp #b0 #b00010001001 #b1)
                arg
                (fp #b0 #b00011001011 #b1)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000001))

(assert (= expect result))

(check-sat)
(exit)
