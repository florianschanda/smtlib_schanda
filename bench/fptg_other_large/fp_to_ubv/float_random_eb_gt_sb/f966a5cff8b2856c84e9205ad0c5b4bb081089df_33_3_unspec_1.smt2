(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1010011010000 #b10)
                arg
                (fp #b1 #b0000000000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000000000 #b10)
                arg
                (fp #b0 #b1011011101010 #b10)))

(declare-const result (_ BitVec 33))
(assert (= result ((_ fp.to_ubv 33) rm arg)))

(declare-const expect (_ BitVec 33))
(assert (= expect #b100110010010000110001110000010000))

(assert (not (= expect result)))
