(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv46
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001101010 #b0000001)
                arg
                (fp #b1 #b0000000000 #b1101100)))
(assert (fp.leq (fp #b1 #b0000000000 #b1101100)
                arg
                (fp #b0 #b1101000111 #b1011010)))

(declare-const result (_ BitVec 46))
(assert (= result ((_ fp.to_ubv 46) rm arg)))

(declare-const expect (_ BitVec 46))
(assert (not (bvule expect #b0101001001110010101101000101010001001001000111)))
(assert (not (bvule #b0101001001110010101101000101010001001001001001 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
