; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv13
; Arg1: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01011100010 #b10)
                arg
                (fp #b1 #b00110001011 #b00)))
(assert (fp.leq (fp #b1 #b00110001011 #b00)
                arg
                (fp #b0 #b10101101010 #b00)))

(declare-const result (_ BitVec 13))
(assert (= result ((_ fp.to_ubv 13) rm arg)))

(declare-const expect (_ BitVec 13))
(assert (= expect #b1001001111001))

(assert (not (= expect result)))
