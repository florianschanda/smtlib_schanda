(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011010000 #b0001011)
                arg
                (fp #b1 #b0000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b0000000)
                arg
                (fp #b0 #b0111100100 #b1001111)))

(declare-const result (_ BitVec 39))
(assert (= result ((_ fp.to_ubv 39) rm arg)))

(declare-const expect (_ BitVec 39))
(assert (= expect #b101010001011111111000110010001111110001))

(assert (= expect result))
