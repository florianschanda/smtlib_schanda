(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv1
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01111100110110 #b1101)
                arg
                (fp #b0 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0001)
                arg
                (fp #b0 #b10100000111100 #b0101)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
