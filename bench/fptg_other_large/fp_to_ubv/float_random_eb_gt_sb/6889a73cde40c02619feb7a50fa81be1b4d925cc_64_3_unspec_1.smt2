(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010010010 #b000)
                arg
                (fp #b1 #b001111110 #b011)))
(assert (fp.leq (fp #b1 #b001111110 #b011)
                arg
                (fp #b0 #b011101010 #b000)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1100111010101011001111100011000100000101001000000000101011001011)))
(assert (not (bvule #b1100111010101011001111100011000100000101001000000000101011001101 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
