(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b11010110001011000 #b100000)
                arg
                (fp #b1 #b00100100000000010 #b010101)))
(assert (fp.leq (fp #b1 #b00100100000000010 #b010101)
                arg
                (fp #b0 #b00111010010000011 #b001011)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule #b00000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
