; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv5
; Arg1: +ZERO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 17 2))
(assert (fp.isPositive arg))
(assert (fp.leq (fp #b1 #b11000010110001010 #b1)
                arg
                (fp #b0 #b00000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0)
                arg
                (fp #b0 #b00101111100100001 #b0)))

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_ubv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (= expect #b00000))

(assert (not (= expect result)))

(check-sat)
(exit)
