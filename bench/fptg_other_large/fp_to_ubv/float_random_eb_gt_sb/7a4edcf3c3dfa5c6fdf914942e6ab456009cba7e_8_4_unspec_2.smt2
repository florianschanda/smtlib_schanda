;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b011101000001010 #b1011101101101)
                arg
                (fp #b1 #b000000000000001 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0000000000000)
                arg
                (fp #b0 #b110001110001110 #b0001001100010)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00111001))

(assert (= expect result))
