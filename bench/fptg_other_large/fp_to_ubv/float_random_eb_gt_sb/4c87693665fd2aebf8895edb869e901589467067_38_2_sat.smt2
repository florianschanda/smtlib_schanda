(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv38
; Arg1: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111001100100 #b100)
                arg
                (fp #b0 #b00000000000001 #b000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b000)
                arg
                (fp #b0 #b00101000101011 #b001)))

(declare-const result (_ BitVec 38))
(assert (= result ((_ fp.to_ubv 38) rm arg)))

(declare-const expect (_ BitVec 38))
(assert (not (bvule #b00000000000000000000000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
