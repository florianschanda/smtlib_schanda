; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b101011110110101 #b001)
                arg
                (fp #b1 #b001111111111110 #b011)))
(assert (fp.leq (fp #b1 #b001111111111110 #b011)
                arg
                (fp #b1 #b001101101001111 #b010)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_ubv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (= expect #b00))

(assert (= expect result))

(check-sat)
(exit)
