;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100010011000101 #b100)
                arg
                (fp #b1 #b010000000000000 #b000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b000)
                arg
                (fp #b0 #b010111111001101 #b000)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b0100010010110101001100101110111011011001111100111011110010111001))

(assert (= expect result))
