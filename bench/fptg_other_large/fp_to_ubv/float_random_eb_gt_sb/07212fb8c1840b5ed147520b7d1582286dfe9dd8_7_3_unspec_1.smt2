; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv7
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11000111001 #b1)
                arg
                (fp #b1 #b01110001101 #b0)))
(assert (fp.leq (fp #b1 #b01110001101 #b0)
                arg
                (fp #b0 #b11110101011 #b1)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (= expect #b1011111))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
