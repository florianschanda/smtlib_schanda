; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv26
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 18 17))
(assert (fp.leq (fp #b1 #b000011110100000101 #b1010001010111110)
                arg
                (fp #b1 #b000000000000000000 #b0000000000000001)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000000000000001)
                arg
                (fp #b0 #b000100000011100011 #b1110001110111010)))

(declare-const result (_ BitVec 26))
(assert (= result ((_ fp.to_ubv 26) rm arg)))

(declare-const expect (_ BitVec 26))
(assert (not (bvule expect #b10000010111111111000011001)))
(assert (not (bvule #b10000010111111111000011011 expect)))

(assert (not (= expect result)))
