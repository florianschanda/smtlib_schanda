(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv31
; Arg1: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10000001010 #b01000111)
                arg
                (fp #b1 #b00000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b00000000000 #b00010010)
                arg
                (fp #b0 #b01101100111 #b10010000)))

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_ubv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (not (bvule expect #b1011111000010001110011101000001)))
(assert (not (bvule #b1011111000010001110011101000011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
