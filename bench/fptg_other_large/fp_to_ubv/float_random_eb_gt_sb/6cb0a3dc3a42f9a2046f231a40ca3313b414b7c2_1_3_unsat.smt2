; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv1
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0010111110010 #b1001)
                arg
                (fp #b0 #b0110101001100 #b0100)))
(assert (fp.leq (fp #b0 #b0110101001100 #b0100)
                arg
                (fp #b0 #b1101011000000 #b0110)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b1))

(assert (not (= expect result)))

(check-sat)
(exit)
