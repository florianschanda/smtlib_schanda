; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b101101100000111 #b100011101100)
                arg
                (fp #b1 #b000001011011100 #b011000011110)))
(assert (fp.leq (fp #b1 #b000001011011100 #b011000011110)
                arg
                (fp #b0 #b100100101001101 #b111010001001)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000000))

(assert (= expect result))

(check-sat)
(exit)
