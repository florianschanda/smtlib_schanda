(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv28
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0110010101001 #b010)
                arg
                (fp #b0 #b0111011101010 #b101)))
(assert (fp.leq (fp #b0 #b0111011101010 #b101)
                arg
                (fp #b0 #b1111010001010 #b100)))

(declare-const result (_ BitVec 28))
(assert (= result ((_ fp.to_ubv 28) rm arg)))

(declare-const expect (_ BitVec 28))
(assert (not (bvule #b0000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
