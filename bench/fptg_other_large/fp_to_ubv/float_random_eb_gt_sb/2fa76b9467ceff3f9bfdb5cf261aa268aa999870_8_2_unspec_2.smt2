; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b0 #b0101010110001000 #b0100011001011)
                arg
                (fp #b0 #b1111111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111111111111)
                arg
                (fp #b0 #b1111111111111111 #b0000000000000)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00011111)))
(assert (not (bvule #b00100001 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
