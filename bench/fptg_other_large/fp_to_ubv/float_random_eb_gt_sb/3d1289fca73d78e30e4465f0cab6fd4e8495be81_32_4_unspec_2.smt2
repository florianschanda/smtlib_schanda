; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b01000101011110110 #b10101000001)
                arg
                (fp #b1 #b00000001001111010 #b11000001100)))
(assert (fp.leq (fp #b1 #b00000001001111010 #b11000001100)
                arg
                (fp #b0 #b10001001000101100 #b10000001110)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b10001101111001011000001000110001))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
