(declare-const arg (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b00111100100000 #b011110)
                arg
                (fp #b0 #b01111111111111 #b000110)))
(assert (fp.leq (fp #b0 #b01111111111111 #b000110)
                arg
                (fp #b0 #b11101011000101 #b001011)))

