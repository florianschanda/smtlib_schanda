; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv7
; Arg1: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b101000111110011 #b01101)
                arg
                (fp #b1 #b000000000000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11111)
                arg
                (fp #b0 #b100000011101101 #b01001)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_ubv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (= expect #b0100001))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
