(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0110101011101001 #b01111)
                arg
                (fp #b0 #b0000000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000)
                arg
                (fp #b0 #b1011111001110101 #b00011)))

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_ubv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (= expect #b00001))

(assert (= expect result))

(check-sat)
(exit)
