; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv40
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000001001011001 #b11)
                arg
                (fp #b0 #b011111111111111 #b11)))
(assert (fp.leq (fp #b0 #b011111111111111 #b11)
                arg
                (fp #b0 #b100001001001011 #b10)))

(declare-const result (_ BitVec 40))
(assert (= result ((_ fp.to_ubv 40) rm arg)))

(declare-const expect (_ BitVec 40))
(assert (not (bvule expect #b0000000000000000000000000000000000000000)))
(assert (not (bvule #b0000000000000000000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
