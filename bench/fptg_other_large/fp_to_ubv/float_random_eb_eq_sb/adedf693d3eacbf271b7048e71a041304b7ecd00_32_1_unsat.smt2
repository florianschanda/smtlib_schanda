(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010001101 #b100011100)
                arg
                (fp #b1 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000001)
                arg
                (fp #b0 #b1100100100 #b001111000)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule #b00000000000000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
