; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv30
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111100 #b111000010)
                arg
                (fp #b1 #b1000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b1000001000 #b011100001)
                arg
                (fp #b0 #b1001001010 #b111110010)))

(declare-const result (_ BitVec 30))
(assert (= result ((_ fp.to_ubv 30) rm arg)))

(declare-const expect (_ BitVec 30))
(assert (not (bvule expect #b010000000001000011101000111111)))
(assert (not (bvule #b010000000001000011101001000001 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
