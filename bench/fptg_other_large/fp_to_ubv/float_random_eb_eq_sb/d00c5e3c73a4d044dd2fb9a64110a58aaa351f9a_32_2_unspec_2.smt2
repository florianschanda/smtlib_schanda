; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b10001111)
                arg
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg
                (fp #b0 #b101011000 #b01000100)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00101000101011110010101110010000)))
(assert (not (bvule #b00101000101011110010101110010010 expect)))

(assert (= expect result))
