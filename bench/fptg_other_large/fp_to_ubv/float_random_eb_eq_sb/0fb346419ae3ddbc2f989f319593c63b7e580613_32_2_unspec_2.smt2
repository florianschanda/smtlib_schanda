; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100101010001 #b110101000100)
                arg
                (fp #b1 #b1011111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b111111111111)
                arg
                (fp #b1 #b1010100110101 #b001011111000)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b10100100011011101100101110100110)))
(assert (not (bvule #b10100100011011101100101110101000 expect)))

(assert (= expect result))
