;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011110101010011 #b101100010101000)
                arg
                (fp #b0 #b1000000000001101 #b111010100010010)))
(assert (fp.leq (fp #b0 #b1000000000001101 #b111010100010010)
                arg
                (fp #b0 #b1100101101110100 #b001011000101001)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000111)))
(assert (not (bvule #b00001001 expect)))

(assert (not (= expect result)))
