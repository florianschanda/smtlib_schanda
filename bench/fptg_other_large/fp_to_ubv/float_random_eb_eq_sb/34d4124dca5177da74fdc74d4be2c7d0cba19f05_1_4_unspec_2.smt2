(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100001001011101 #b11010111001100)
                arg
                (fp #b1 #b010010001010110 #b11000010000100)))
(assert (fp.leq (fp #b1 #b010010001010110 #b11000010000100)
                arg
                (fp #b0 #b011111111000101 #b00000100101000)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule #b1 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
