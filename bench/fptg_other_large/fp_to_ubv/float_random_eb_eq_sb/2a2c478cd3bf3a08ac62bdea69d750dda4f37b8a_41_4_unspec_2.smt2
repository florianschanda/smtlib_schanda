(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv41
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00111001010001 #b0101100011100)
                arg
                (fp #b1 #b00000101110111 #b1011000011110)))
(assert (fp.leq (fp #b1 #b00000101110111 #b1011000011110)
                arg
                (fp #b0 #b01001010110110 #b1000011000011)))

(declare-const result (_ BitVec 41))
(assert (= result ((_ fp.to_ubv 41) rm arg)))

(declare-const expect (_ BitVec 41))
(assert (not (bvule expect #b11110010110010100100101101011011111100110)))
(assert (not (bvule #b11110010110010100100101101011011111101000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
