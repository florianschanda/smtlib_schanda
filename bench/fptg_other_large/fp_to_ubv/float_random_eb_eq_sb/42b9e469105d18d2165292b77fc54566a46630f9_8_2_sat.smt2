(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10001011010110001 #b1100110101111101)
                arg
                (fp #b1 #b00000000000000001 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000001 #b0000000000000000)
                arg
                (fp #b0 #b00011010110001011 #b1001100010010101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule #b00000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
