; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv64
; Arg1: -RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010111111010 #b1010001010011)
                arg
                (fp #b1 #b00000000000000 #b0010101010110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0010101010110)
                arg
                (fp #b0 #b10111110011110 #b1001001111110)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111011101100110111011011100000010100110110111110001111010010111)))
(assert (not (bvule #b1111011101100110111011011100000010100110110111110001111010011001 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
