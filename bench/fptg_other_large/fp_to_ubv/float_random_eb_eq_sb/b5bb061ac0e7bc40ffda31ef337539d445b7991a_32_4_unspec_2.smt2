(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000011 #b011000001)
                arg
                (fp #b1 #b0001111000 #b100101001)))
(assert (fp.leq (fp #b1 #b0001111000 #b100101001)
                arg
                (fp #b1 #b0000001010 #b010111011)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00001000111111100100000101010110))

(assert (= expect result))
