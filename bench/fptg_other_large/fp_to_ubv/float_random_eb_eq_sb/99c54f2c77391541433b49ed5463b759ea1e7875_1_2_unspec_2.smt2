(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b010100101)
                arg
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg
                (fp #b0 #b0111101001 #b011001111)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_ubv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))
