(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100010000 #b100110101)
                arg
                (fp #b1 #b0000000000 #b110111001)))
(assert (fp.leq (fp #b1 #b0000000000 #b110111001)
                arg
                (fp #b0 #b1100010000 #b000110110)))

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_ubv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (= expect #b000000))

(assert (= expect result))

(check-sat)
(exit)
