; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv20
; Arg1: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001100 #b01111000)
                arg
                (fp #b1 #b100010111 #b00001101)))
(assert (fp.leq (fp #b1 #b100010111 #b00001101)
                arg
                (fp #b0 #b101010110 #b00011011)))

(declare-const result (_ BitVec 20))
(assert (= result ((_ fp.to_ubv 20) rm arg)))

(declare-const expect (_ BitVec 20))
(assert (not (bvule expect #b00001011100111001001)))
(assert (not (bvule #b00001011100111001011 expect)))

(assert (= expect result))
