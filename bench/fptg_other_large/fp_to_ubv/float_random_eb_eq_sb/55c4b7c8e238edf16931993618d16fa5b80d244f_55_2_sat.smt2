; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv55
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101011100 #b011111010)
                arg
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg
                (fp #b0 #b1110110100 #b000110101)))

(declare-const result (_ BitVec 55))
(assert (= result ((_ fp.to_ubv 55) rm arg)))

(declare-const expect (_ BitVec 55))
(assert (not (bvule #b0000000000000000000000000000000000000000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
