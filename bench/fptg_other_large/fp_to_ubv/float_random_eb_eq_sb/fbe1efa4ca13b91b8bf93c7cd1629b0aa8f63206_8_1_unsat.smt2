; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111011000010011011 #b01100001011111110)
                arg
                (fp #b1 #b001111111111110111 #b01101010000010100)))
(assert (fp.leq (fp #b1 #b001111111111110111 #b01101010000010100)
                arg
                (fp #b1 #b001011110010011100 #b01110011010110111)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00000000))

(assert (not (= expect result)))

(check-sat)
(exit)
