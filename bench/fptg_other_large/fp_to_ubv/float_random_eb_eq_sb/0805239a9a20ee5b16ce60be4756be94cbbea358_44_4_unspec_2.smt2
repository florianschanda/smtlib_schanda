; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv44
; Arg1: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101011011010111100 #b01111000100101001)
                arg
                (fp #b1 #b000000000000000001 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000001 #b00000000000000000)
                arg
                (fp #b0 #b000001101101001100 #b11000101111110000)))

(declare-const result (_ BitVec 44))
(assert (= result ((_ fp.to_ubv 44) rm arg)))

(declare-const expect (_ BitVec 44))
(assert (not (bvule expect #b11100101101010000110010111100101110111110000)))
(assert (not (bvule #b11100101101010000110010111100101110111110010 expect)))

(assert (= expect result))
