; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010000001 #b10101001)
                arg
                (fp #b0 #b111100000 #b00001111)))
(assert (fp.leq (fp #b0 #b111100000 #b00001111)
                arg
                (fp #b0 #b111101111 #b10110110)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b01001101)))
(assert (not (bvule #b01001111 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
