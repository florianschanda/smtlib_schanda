(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv10
; Arg1: -RANDOM_SUBNORMAL(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100101110 #b101011101)
                arg
                (fp #b1 #b0000000000 #b001011111)))
(assert (fp.leq (fp #b1 #b0000000000 #b001011111)
                arg
                (fp #b0 #b1010001100 #b111010011)))

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_ubv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (not (bvule expect #b1101101010)))
(assert (not (bvule #b1101101100 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
