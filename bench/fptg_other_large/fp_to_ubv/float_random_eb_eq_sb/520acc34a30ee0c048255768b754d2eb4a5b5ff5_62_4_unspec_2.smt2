; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv62
; Arg1: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110100100000110 #b01101000011010)
                arg
                (fp #b1 #b000000001011101 #b10111000000011)))
(assert (fp.leq (fp #b1 #b000000001011101 #b10111000000011)
                arg
                (fp #b0 #b101100010011100 #b10110100011011)))

(declare-const result (_ BitVec 62))
(assert (= result ((_ fp.to_ubv 62) rm arg)))

(declare-const expect (_ BitVec 62))
(assert (not (bvule expect #b11001000001010100001100100001001110001100000101000100010111111)))
(assert (not (bvule #b11001000001010100001100100001001110001100000101000100011000001 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
