; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010101100000101 #b01010011010001)
                arg
                (fp #b1 #b000000000000000 #b10010100011011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b10010100011011)
                arg
                (fp #b0 #b110001001000001 #b10110110101110)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b10110000))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
