(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv37
; Arg1: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001010010011001 #b01000001011101)
                arg
                (fp #b0 #b000000000000000 #b01110001001100)))
(assert (fp.leq (fp #b0 #b000000000000000 #b01110001001100)
                arg
                (fp #b0 #b011000110100011 #b10011101011101)))

(declare-const result (_ BitVec 37))
(assert (= result ((_ fp.to_ubv 37) rm arg)))

(declare-const expect (_ BitVec 37))
(assert (not (bvule expect #b0000000000000000000000000000000000000)))
(assert (not (bvule #b0000000000000000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
