; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv64
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000101 #b11100001)
                arg
                (fp #b1 #b011100101 #b11011111)))
(assert (fp.leq (fp #b1 #b011100101 #b11011111)
                arg
                (fp #b0 #b111100111 #b10011111)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_ubv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b1111101100100011111001011011100100101100101101011100111111100001))

(assert (not (= expect result)))
