; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110110011000011111 #b01001100101010010)
                arg
                (fp #b1 #b000000000000000000 #b01010101001100111)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b01010101001100111)
                arg
                (fp #b0 #b110110010110001101 #b11001001001100011)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00000000))

(assert (not (= expect result)))

(check-sat)
(exit)
