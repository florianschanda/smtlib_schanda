(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111101101101 #b0001101000011)
                arg
                (fp #b1 #b10000000001000 #b0101111010000)))
(assert (fp.leq (fp #b1 #b10000000001000 #b0101111010000)
                arg
                (fp #b0 #b11110001100101 #b1101110001001)))

(declare-const result (_ BitVec 26))
(assert (= result ((_ fp.to_ubv 26) rm arg)))

(declare-const expect (_ BitVec 26))
(assert (not (bvule expect #b00101100000011001111001011)))
(assert (not (bvule #b00101100000011001111001101 expect)))

(assert (= expect result))
