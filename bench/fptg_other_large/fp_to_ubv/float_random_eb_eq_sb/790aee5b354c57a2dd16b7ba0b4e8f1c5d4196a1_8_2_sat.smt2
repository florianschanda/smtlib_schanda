; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: +ONE

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0111110101010000 #b011100011100001)
                arg
                (fp #b0 #b0111111111111111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b000000000000000)
                arg
                (fp #b0 #b1011110011000110 #b100111100000010)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000000)))
(assert (not (bvule #b00000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
