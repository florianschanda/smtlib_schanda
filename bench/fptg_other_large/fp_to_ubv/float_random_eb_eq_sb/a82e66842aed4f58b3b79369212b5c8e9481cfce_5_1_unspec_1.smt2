; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv5
; Arg1: -RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101011010 #b011101010)
                arg
                (fp #b1 #b1100111001 #b001100001)))
(assert (fp.leq (fp #b1 #b1100111001 #b001100001)
                arg
                (fp #b0 #b1011000010 #b101011100)))

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_ubv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b10101)))
(assert (not (bvule #b10111 expect)))

(assert (not (= expect result)))
