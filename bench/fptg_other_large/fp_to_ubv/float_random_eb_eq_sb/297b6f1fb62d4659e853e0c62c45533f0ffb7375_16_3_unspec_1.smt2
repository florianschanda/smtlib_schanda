; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv16
; Arg1: -RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RNA)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001100010 #b000111101)
                arg
                (fp #b1 #b0000000000 #b001010110)))
(assert (fp.leq (fp #b1 #b0000000000 #b001010110)
                arg
                (fp #b0 #b0001101100 #b001010000)))

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_ubv 16) rm arg)))

(declare-const expect (_ BitVec 16))
(assert (= expect #b0100100100110000))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
