;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010111110111011 #b00011011011010)
                arg
                (fp #b1 #b010000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b00000000000000)
                arg
                (fp #b0 #b000000001000101 #b01000111001100)))

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_ubv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (= expect #b000000))

(assert (= expect result))

(check-sat)
(exit)
