;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0100100011011000 #b100101011100010)
                arg
                (fp #b0 #b1000000000001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b000110010000101)
                arg
                (fp #b0 #b1001101100101111 #b101101100001011)))

(declare-const result (_ BitVec 15))
(assert (= result ((_ fp.to_ubv 15) rm arg)))

(declare-const expect (_ BitVec 15))
(assert (not (bvule expect #b000010100101111)))
(assert (not (bvule #b000010100110001 expect)))

(assert (= expect result))
