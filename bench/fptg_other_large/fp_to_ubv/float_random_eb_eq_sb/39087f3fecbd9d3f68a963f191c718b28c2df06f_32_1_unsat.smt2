(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100101110 #b101011101)
                arg
                (fp #b1 #b0000000000 #b001011111)))
(assert (fp.leq (fp #b1 #b0000000000 #b001011111)
                arg
                (fp #b0 #b1010001100 #b111010011)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000000))

(assert (not (= expect result)))

(check-sat)
(exit)
