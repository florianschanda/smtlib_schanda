; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0101001101001 #b100111001011)
                arg
                (fp #b1 #b0000000000000 #b001011011101)))
(assert (fp.leq (fp #b1 #b0000000000000 #b001011011101)
                arg
                (fp #b0 #b1100110000101 #b001001111000)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00000000))

(assert (= expect result))

(check-sat)
(exit)
