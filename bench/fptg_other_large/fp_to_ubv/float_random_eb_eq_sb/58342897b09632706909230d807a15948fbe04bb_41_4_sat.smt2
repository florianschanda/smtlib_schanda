; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv41
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00111001101000 #b1011010010011)
                arg
                (fp #b0 #b00011001000010 #b1111000110001)))
(assert (fp.leq (fp #b0 #b00011001000010 #b1111000110001)
                arg
                (fp #b0 #b00101111011011 #b1101000110011)))

(declare-const result (_ BitVec 41))
(assert (= result ((_ fp.to_ubv 41) rm arg)))

(declare-const expect (_ BitVec 41))
(assert (not (bvule expect #b00000000000000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
