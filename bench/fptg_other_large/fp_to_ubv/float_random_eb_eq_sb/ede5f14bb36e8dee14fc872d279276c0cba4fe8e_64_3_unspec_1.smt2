(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1101011001101111010000110011000110101100011011010010100000000010)))
(assert (not (bvule #b1101011001101111010000110011000110101100011011010010100000000100 expect)))

(assert (not (= expect result)))
