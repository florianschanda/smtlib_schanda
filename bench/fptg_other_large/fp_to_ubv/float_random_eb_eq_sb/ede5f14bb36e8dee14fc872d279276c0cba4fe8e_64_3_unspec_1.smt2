(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b01011111110110111 #b0110001101111000)
                arg
                (fp #b1 #b00000000000000000 #b0010001110100101)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0010001110100101)
                arg
                (fp #b0 #b11001100111010011 #b1010100001010110)))

