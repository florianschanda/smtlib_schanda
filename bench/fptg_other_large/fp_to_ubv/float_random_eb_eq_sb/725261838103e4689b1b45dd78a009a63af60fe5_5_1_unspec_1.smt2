; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv5
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000011101011 #b1100100000110)
                arg
                (fp #b1 #b10000000001100 #b1111100010101)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1111100010101)
                arg
                (fp #b1 #b01111101000110 #b0010110010000)))

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_ubv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b01001)))
(assert (not (bvule #b01011 expect)))

(assert (not (= expect result)))
