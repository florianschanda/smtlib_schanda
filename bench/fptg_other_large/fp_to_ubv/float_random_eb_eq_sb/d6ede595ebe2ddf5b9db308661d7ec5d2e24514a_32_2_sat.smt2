; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100111111 #b00011110)
                arg
                (fp #b1 #b000000000 #b00011110)))
(assert (fp.leq (fp #b1 #b000000000 #b00011110)
                arg
                (fp #b0 #b000110010 #b11010011)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_ubv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000000))

(assert (= expect result))

(check-sat)
(exit)
