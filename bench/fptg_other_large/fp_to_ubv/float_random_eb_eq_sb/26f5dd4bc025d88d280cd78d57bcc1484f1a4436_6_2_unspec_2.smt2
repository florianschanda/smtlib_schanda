; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv6
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000111011 #b0011101110)
                arg
                (fp #b1 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111)
                arg
                (fp #b0 #b10110111101 #b1100110101)))

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_ubv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b100010)))
(assert (not (bvule #b100100 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
