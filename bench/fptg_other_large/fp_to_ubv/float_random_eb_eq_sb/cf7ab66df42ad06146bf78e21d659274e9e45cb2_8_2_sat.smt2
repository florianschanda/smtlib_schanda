;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110001011010101 #b01111001000101)
                arg
                (fp #b1 #b000000000000000 #b00111010110000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00111010110000)
                arg
                (fp #b0 #b100000011110000 #b01101110110110)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_ubv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00000000))

(assert (= expect result))

(check-sat)
(exit)
