(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv2
; Arg1: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01101011101100 #b0101111101100)
                arg
                (fp #b0 #b00000000000000 #b1101100101001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1101100101001)
                arg
                (fp #b0 #b11100001001110 #b0101100011111)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_ubv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule #b01 expect)))

(assert (= expect result))

(check-sat)
(exit)
