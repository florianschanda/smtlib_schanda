(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv4
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010101101111 #b00101001101)
                arg
                (fp #b0 #b011111111111 #b01110010110)))
(assert (fp.leq (fp #b0 #b011111111111 #b01110010110)
                arg
                (fp #b0 #b111110111111 #b10110100110)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_ubv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b0000)))
(assert (not (bvule #b0010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
