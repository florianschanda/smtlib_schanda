(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv2
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011010101110111 #b010000000111101)
                arg
                (fp #b0 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000000000000000)
                arg
                (fp #b0 #b1101010101010111 #b111100001001110)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_ubv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule #b01 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
