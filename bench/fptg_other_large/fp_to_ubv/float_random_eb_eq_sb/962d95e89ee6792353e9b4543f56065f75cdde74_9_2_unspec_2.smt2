; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv9
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100101011 #b00111000001)
                arg
                (fp #b0 #b100000001000 #b10111110100)))
(assert (fp.leq (fp #b0 #b100000001000 #b10111110100)
                arg
                (fp #b0 #b101001011000 #b01000110101)))

(declare-const result (_ BitVec 9))
(assert (= result ((_ fp.to_ubv 9) rm arg)))

(declare-const expect (_ BitVec 9))
(assert (not (bvule expect #b011110100)))
(assert (not (bvule #b011110110 expect)))

(assert (= expect result))
