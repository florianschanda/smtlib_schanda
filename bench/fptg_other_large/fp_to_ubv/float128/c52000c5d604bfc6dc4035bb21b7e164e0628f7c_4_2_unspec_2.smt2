; Format: FLOAT128
; Target: bv4
; Arg1: +NAN

; Redundancy: False
; Validation for: FP_TO_UBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float128)
(assert (fp.isNaN arg))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_ubv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b0111)))
(assert (not (bvule #b1001 expect)))

(assert (= expect result))
