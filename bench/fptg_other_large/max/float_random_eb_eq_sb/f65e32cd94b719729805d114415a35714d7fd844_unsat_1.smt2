                arg2
                (fp #b0 #b00000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110100111)
                arg2
                (fp #b0 #b00110001101 #b0100110011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00100111011 #b1010101001)
                expect
                (fp #b0 #b00000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110100111)
                expect
                (fp #b0 #b11111001001 #b1111001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
