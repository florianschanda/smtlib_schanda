(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101101100 #b101000000)
                arg1
                (fp #b1 #b1001110101 #b100001111)))
(assert (fp.leq (fp #b1 #b1001110101 #b100001111)
                arg1
                (fp #b0 #b0000101100 #b011100100)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0100011101 #b101110110)
                expect
                (fp #b0 #b1001110101 #b100001111)))
(assert (fp.leq (fp #b0 #b1001110101 #b100001111)
                expect
                (fp #b0 #b1100001111 #b001110000)))

(assert (= expect result))

(check-sat)
(exit)
