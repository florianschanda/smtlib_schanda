; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1001000000100111 #b100011111111101)
                arg1
                (fp #b1 #b1000000000001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b1000000000001010 #b001010101000000)
                arg1
                (fp #b0 #b1011011110101000 #b110001110001000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000110101011011 #b000110001101110)
                expect
                (fp #b1 #b1000000000001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b1000000000001010 #b001010101000000)
                expect
                (fp #b0 #b0110011100010100 #b000110010111111)))

(assert (= expect result))

(check-sat)
(exit)
