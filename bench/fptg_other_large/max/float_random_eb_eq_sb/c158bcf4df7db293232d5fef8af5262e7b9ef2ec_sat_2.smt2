(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010000001111 #b1010100010111)
                arg2
                (fp #b1 #b00000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111000000111)
                arg2
                (fp #b0 #b10110010001101 #b0001001001011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00011101101100 #b1110011011101)
                expect
                (fp #b1 #b00000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111000000111)
                expect
                (fp #b0 #b01110101001101 #b0001001011011)))

(assert (= expect result))

(check-sat)
(exit)
