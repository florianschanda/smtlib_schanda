; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011100110 #b011110000)
                arg1
                (fp #b0 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111011 #b011010100)
                arg1
                (fp #b0 #b1011010010 #b111110111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011000001 #b101011000)
                expect
                (fp #b0 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111011 #b011010100)
                expect
                (fp #b0 #b1011000001 #b001110001)))

(assert (= expect result))

(check-sat)
(exit)
