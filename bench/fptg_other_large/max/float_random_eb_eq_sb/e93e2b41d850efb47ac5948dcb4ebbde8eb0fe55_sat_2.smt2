(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11010010111011011 #b1110101010000000)
                arg1
                (fp #b1 #b10000000000001111 #b1111110001110101)))
(assert (fp.leq (fp #b1 #b10000000000001111 #b1111110001110101)
                arg1
                (fp #b1 #b00111101001101110 #b0010001011101010)))

