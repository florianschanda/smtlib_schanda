;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101000010110110 #b000010111100001)
                arg1
                (fp #b1 #b1010111011011110 #b001000011101111)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101111)
                arg1
                (fp #b0 #b0011011101011100 #b011010101011010)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110011111010111 #b001000000010010)
                expect
                (fp #b1 #b1010111011011110 #b001000011101111)))
(assert (fp.leq (fp #b1 #b1010111011011110 #b001000011101111)
                expect
                (fp #b1 #b0111101110001111 #b000000110001001)))

(assert (= expect result))

(check-sat)
(exit)
