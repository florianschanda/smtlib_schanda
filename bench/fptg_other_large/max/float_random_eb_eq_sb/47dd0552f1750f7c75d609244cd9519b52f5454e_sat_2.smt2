(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011110110 #b11100111000)
                arg2
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg2
                (fp #b0 #b001110101000 #b00101010100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011000110 #b10001110001)
                expect
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                expect
                (fp #b0 #b110000101010 #b11000010100)))

(assert (= expect result))

(check-sat)
(exit)
