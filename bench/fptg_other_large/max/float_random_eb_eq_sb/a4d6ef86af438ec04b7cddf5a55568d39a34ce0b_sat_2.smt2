(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111010001100 #b11100110110)
                arg2
                (fp #b1 #b100000001001 #b01000011110)))
(assert (fp.leq (fp #b1 #b100000001001 #b01000011110)
                arg2
                (fp #b1 #b011010011100 #b00001011111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101111110 #b01001010010)
                expect
                (fp #b1 #b100000001001 #b01000011110)))
(assert (fp.leq (fp #b1 #b100000001001 #b01000011110)
                expect
                (fp #b0 #b010110011111 #b00001011010)))

(assert (= expect result))

(check-sat)
(exit)
