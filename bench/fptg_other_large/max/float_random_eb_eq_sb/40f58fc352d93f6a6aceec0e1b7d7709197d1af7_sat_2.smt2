; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b010010001011011 #b00111011001100)
                arg2
                (fp #b0 #b100000000001110 #b00000000000000)))
(assert (fp.leq (fp #b0 #b100000000001110 #b00000000000000)
                arg2
                (fp #b0 #b101100011010101 #b11100000101100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111011010011011 #b00110010101001)
                expect
                (fp #b0 #b100000000001110 #b00000000000000)))
(assert (fp.leq (fp #b0 #b100000000001110 #b00000000000000)
                expect
                (fp #b0 #b100111010100011 #b11001101101101)))

(assert (= expect result))

(check-sat)
(exit)
