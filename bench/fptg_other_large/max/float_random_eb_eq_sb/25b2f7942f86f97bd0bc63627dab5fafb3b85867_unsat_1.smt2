(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100100 #b11111110)
                arg2
                (fp #b1 #b101111110 #b11111111)))
(assert (fp.leq (fp #b1 #b101111110 #b11111111)
                arg2
                (fp #b0 #b001000001 #b00100111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000000 #b01011101)
                expect
                (fp #b1 #b101111110 #b11111111)))
(assert (fp.leq (fp #b1 #b101111110 #b11111111)
                expect
                (fp #b1 #b010010010 #b00101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
