(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b100101111100110000 #b01100010000110100)
                arg1
                (fp #b0 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000000000000000)
                arg1
                (fp #b0 #b110010000011001001 #b00001010000110010)))

