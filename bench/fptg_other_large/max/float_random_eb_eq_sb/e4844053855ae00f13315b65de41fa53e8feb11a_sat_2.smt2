(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110101101 #b000010010)
                arg2
                (fp #b1 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0100000000 #b000000000)
                arg2
                (fp #b0 #b1110001010 #b001110111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101001111 #b001010101)
                expect
                (fp #b1 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0100000000 #b000000000)
                expect
                (fp #b0 #b1110110110 #b010100100)))

(assert (= expect result))

(check-sat)
(exit)
