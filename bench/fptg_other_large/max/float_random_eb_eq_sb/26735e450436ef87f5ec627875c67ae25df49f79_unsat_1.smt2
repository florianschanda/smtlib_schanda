; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110000000111 #b00010000001)
                arg2
                (fp #b1 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000000000)
                arg2
                (fp #b1 #b000111000000 #b01101101110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110000000 #b11111011110)
                expect
                (fp #b1 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b1 #b011111111111 #b00000000000)
                expect
                (fp #b1 #b010001111000 #b10001000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
