(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000101101010 #b00011111001)
                arg2
                (fp #b0 #b101110001000 #b10100011011)))
(assert (fp.leq (fp #b0 #b101110001000 #b10100011011)
                arg2
                (fp #b0 #b110000110110 #b01010001111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100100000 #b10100101000)
                expect
                (fp #b0 #b101110001000 #b10100011011)))
(assert (fp.leq (fp #b0 #b101110001000 #b10100011011)
                expect
                (fp #b0 #b111101001111 #b01111101001)))

(assert (= expect result))

(check-sat)
(exit)
