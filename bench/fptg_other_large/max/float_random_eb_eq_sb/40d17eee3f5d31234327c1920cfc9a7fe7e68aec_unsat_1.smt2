; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111010010 #b0100000001010)
                arg2
                (fp #b1 #b11110011011010 #b1000011100000)))
(assert (fp.leq (fp #b1 #b11110011011010 #b1000011100000)
                arg2
                (fp #b0 #b00100100101011 #b0111101101110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110110010101 #b1111010100110)
                expect
                (fp #b1 #b11110011011010 #b1000011100000)))
(assert (fp.leq (fp #b1 #b11110011011010 #b1000011100000)
                expect
                (fp #b0 #b01010001010100 #b0101100101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
