(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b111001101101001 #b11010010110101)
                arg2
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                arg2
                (fp #b0 #b100111100101110 #b01000000011000)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001100000011110 #b01010100010100)
                expect
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b110101011100001 #b11011010110111)))

(assert (= expect result))

(check-sat)
(exit)
