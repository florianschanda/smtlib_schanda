(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110111100000110 #b11011000100000)
                expect
                (fp #b1 #b100000000001101 #b11110010010110)))
(assert (fp.leq (fp #b1 #b100000000001101 #b11110010010110)
                expect
                (fp #b1 #b011111011000110 #b00110000011001)))

(assert (= expect result))

(check-sat)
(exit)
