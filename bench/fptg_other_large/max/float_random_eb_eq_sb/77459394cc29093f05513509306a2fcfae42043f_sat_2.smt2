(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010100 #b01110110)
                arg1
                (fp #b1 #b100000100 #b01111000)))
(assert (fp.leq (fp #b1 #b100000100 #b01111000)
                arg1
                (fp #b0 #b101000000 #b00110110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001010 #b00110101)
                expect
                (fp #b1 #b100000100 #b01111000)))
(assert (fp.leq (fp #b1 #b100000100 #b01111000)
                expect
                (fp #b1 #b000010110 #b10110011)))

(assert (= expect result))

(check-sat)
(exit)
