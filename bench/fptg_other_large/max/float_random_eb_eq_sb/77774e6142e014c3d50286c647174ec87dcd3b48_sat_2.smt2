; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011000111 #b00111101100)
                arg1
                (fp #b0 #b110100101001 #b10011011000)))
(assert (fp.leq (fp #b0 #b110100101001 #b10011011000)
                arg1
                (fp #b0 #b111011011101 #b10001001100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000001011111 #b00000100110)
                expect
                (fp #b0 #b110100101001 #b10011011000)))
(assert (fp.leq (fp #b0 #b110100101001 #b10011011000)
                expect
                (fp #b0 #b111101011111 #b00001101001)))

(assert (= expect result))

(check-sat)
(exit)
