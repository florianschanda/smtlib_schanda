(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010110001 #b101111010)
                arg2
                (fp #b1 #b1010000101 #b111101000)))
(assert (fp.leq (fp #b1 #b1010000101 #b111101000)
                arg2
                (fp #b1 #b0010010101 #b010010110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101101011 #b001101001)
                expect
                (fp #b1 #b1010000101 #b111101000)))
(assert (fp.leq (fp #b1 #b1010000101 #b111101000)
                expect
                (fp #b1 #b0101000010 #b100011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
