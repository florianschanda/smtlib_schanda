;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001111110000000 #b11001010010111)
                arg1
                (fp #b1 #b000000001011101 #b10111000000011)))
(assert (fp.leq (fp #b1 #b000000001011101 #b10111000000011)
                arg1
                (fp #b0 #b000101111100101 #b00010001011110)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
