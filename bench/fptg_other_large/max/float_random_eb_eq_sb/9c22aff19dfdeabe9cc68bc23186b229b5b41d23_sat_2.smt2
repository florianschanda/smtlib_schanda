(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00001101000 #b0100110110)
                expect
                (fp #b1 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b10010011111 #b0110100111)))

(assert (= expect result))

(check-sat)
(exit)
