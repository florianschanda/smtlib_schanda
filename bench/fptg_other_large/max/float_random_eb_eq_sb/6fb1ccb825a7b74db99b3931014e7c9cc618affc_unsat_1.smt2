; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1001000000000 #b110111110000)
                arg1
                (fp #b1 #b0010111000010 #b001011010010)))
(assert (fp.leq (fp #b1 #b0010111000010 #b001011010010)
                arg1
                (fp #b0 #b0010001111101 #b001010100000)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
