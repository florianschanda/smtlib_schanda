; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100010010 #b10101011011)
                arg1
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                arg1
                (fp #b0 #b101010000111 #b10000011100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100100100101 #b10100001010)
                expect
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                expect
                (fp #b0 #b001111101000 #b00010111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
