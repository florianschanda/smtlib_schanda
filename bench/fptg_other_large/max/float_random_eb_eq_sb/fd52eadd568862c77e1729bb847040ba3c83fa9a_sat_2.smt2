; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INT_BOUNDARY
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110111011 #b1101000110)
                arg1
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                arg1
                (fp #b1 #b01101101000 #b0111110110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111011000 #b0010111000)
                expect
                (fp #b1 #b10000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000001010 #b0000000000)
                expect
                (fp #b0 #b01001001111 #b0101110111)))

(assert (= expect result))

(check-sat)
(exit)
