(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111010110001 #b10110111001)
                arg2
                (fp #b1 #b100000110101 #b00101100111)))
(assert (fp.leq (fp #b1 #b100000110101 #b00101100111)
                arg2
                (fp #b0 #b000010011110 #b00100111011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101001010011 #b01011111010)
                expect
                (fp #b1 #b100000110101 #b00101100111)))
(assert (fp.leq (fp #b1 #b100000110101 #b00101100111)
                expect
                (fp #b0 #b110011011010 #b11110000111)))

(assert (= expect result))

(check-sat)
(exit)
