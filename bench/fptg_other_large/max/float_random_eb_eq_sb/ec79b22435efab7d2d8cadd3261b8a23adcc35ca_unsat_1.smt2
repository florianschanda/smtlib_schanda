(assert (fp.leq (fp #b1 #b11111001101101011 #b0010000100110100)
                arg1
                (fp #b0 #b00100010100001001 #b1100001001011000)))
(assert (fp.leq (fp #b0 #b00100010100001001 #b1100001001011000)
