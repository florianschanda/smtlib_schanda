                arg2
                (fp #b0 #b00000000000000 #b0010100010010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0010100010010)
                arg2
                (fp #b0 #b01001001010001 #b1000110001111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00011100011000 #b1100011101011)
                expect
                (fp #b0 #b00000000000000 #b0010100010010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0010100010010)
                expect
                (fp #b0 #b10011111100010 #b0111100011101)))

(assert (= expect result))

(check-sat)
(exit)
