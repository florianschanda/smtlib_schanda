(assert (fp.leq (fp #b1 #b0100010100011010 #b100100101111001)
                expect
                (fp #b0 #b1101001101010010 #b010010110011010)))
(assert (fp.leq (fp #b0 #b1101001101010010 #b010010110011010)
                expect
                (fp #b0 #b1101001111101101 #b010011010010010)))

(assert (= expect result))

(check-sat)
