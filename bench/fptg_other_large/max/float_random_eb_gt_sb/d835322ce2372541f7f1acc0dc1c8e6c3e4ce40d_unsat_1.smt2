; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111010011010111 #b0111)
                arg1
                (fp #b1 #b1110111101001100 #b0010)))
(assert (fp.leq (fp #b1 #b1110111101001100 #b0010)
                arg1
                (fp #b1 #b0111111001011101 #b0111)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111110100001000 #b0111)
                expect
                (fp #b1 #b1110111101001100 #b0010)))
(assert (fp.leq (fp #b1 #b1110111101001100 #b0010)
                expect
                (fp #b1 #b0000110101000001 #b1101)))

(assert (not (= expect result)))

(check-sat)
(exit)
