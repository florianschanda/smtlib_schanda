; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1100100101101101 #b10100100)
                arg2
                (fp #b1 #b0000000000000000 #b00100111)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00100111)
                arg2
                (fp #b0 #b1001001100111000 #b11001011)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1011001100010010 #b11110111)
                expect
                (fp #b1 #b0000000000000000 #b00100111)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00100111)
                expect
                (fp #b0 #b0010011001011110 #b01001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
