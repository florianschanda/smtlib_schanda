; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b000001101 #b00)
                arg1
                (fp #b1 #b000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000 #b10)
                arg1
                (fp #b0 #b100011011 #b10)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101001111 #b11)
                expect
                (fp #b1 #b000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000 #b10)
                expect
                (fp #b0 #b011001010 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
