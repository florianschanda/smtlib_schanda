(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10110111000010 #b011000)
                arg2
                (fp #b1 #b00000000000000 #b111111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b111111)
                arg2
                (fp #b0 #b10101001101001 #b111111)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11010001110100 #b011011)
                expect
                (fp #b1 #b00000000000000 #b111111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b111111)
                expect
                (fp #b0 #b01010101110010 #b001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
