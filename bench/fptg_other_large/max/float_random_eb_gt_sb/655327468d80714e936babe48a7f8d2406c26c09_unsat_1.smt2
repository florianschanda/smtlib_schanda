(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111101110 #b1)
                arg2
                (fp #b1 #b100000000 #b1)))
(assert (fp.leq (fp #b1 #b100000000 #b1)
                arg2
                (fp #b1 #b000110011 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b101100111 #b0)
                expect
                (fp #b1 #b100000000 #b1)))
(assert (fp.leq (fp #b1 #b100000000 #b1)
                expect
                (fp #b1 #b011011101 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
