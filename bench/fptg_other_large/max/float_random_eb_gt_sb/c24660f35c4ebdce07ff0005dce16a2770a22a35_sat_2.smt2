(assert (fp.leq (fp #b0 #b0000100111 #b00)
                expect
                (fp #b0 #b0100100101 #b00)))
(assert (fp.leq (fp #b0 #b0100100101 #b00)
                expect
                (fp #b0 #b1101101101 #b11)))

(assert (= expect result))

