(assert (fp.leq (fp #b0 #b1011111110 #b11)
                arg2
                (fp #b0 #b1101111110 #b10)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110001110 #b00)
                expect
                (fp #b0 #b1011111110 #b11)))
(assert (fp.leq (fp #b0 #b1011111110 #b11)
                expect
                (fp #b0 #b1110010101 #b01)))

(assert (= expect result))

