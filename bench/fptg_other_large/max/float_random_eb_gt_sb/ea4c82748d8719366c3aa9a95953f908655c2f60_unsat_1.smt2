; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111100101110 #b1011110)
                arg2
                (fp #b1 #b111011010010 #b1000011)))
(assert (fp.leq (fp #b1 #b111011010010 #b1000011)
                arg2
                (fp #b1 #b100111000011 #b1010010)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111101100111 #b0110000)
                expect
                (fp #b1 #b111011010010 #b1000011)))
(assert (fp.leq (fp #b1 #b111011010010 #b1000011)
                expect
                (fp #b0 #b111100010110 #b1101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
