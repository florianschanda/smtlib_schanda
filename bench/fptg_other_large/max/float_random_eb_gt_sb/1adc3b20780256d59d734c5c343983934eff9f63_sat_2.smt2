(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111001011 #b001110)
                expect
                (fp #b0 #b000000000 #b011111)))
(assert (fp.leq (fp #b0 #b000000000 #b011111)
                expect
                (fp #b0 #b011000100 #b011110)))

(assert (= expect result))

(check-sat)
(exit)
