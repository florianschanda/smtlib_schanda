(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0001001101010 #b100)
                arg2
                (fp #b1 #b0000000000000 #b101)))
(assert (fp.leq (fp #b1 #b0000000000000 #b101)
                arg2
                (fp #b0 #b1011101000010 #b111)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111111001101 #b101)
                expect
                (fp #b1 #b0000000000000 #b101)))
(assert (fp.leq (fp #b1 #b0000000000000 #b101)
                expect
                (fp #b0 #b1001100001010 #b000)))

(assert (= expect result))

(check-sat)
(exit)
