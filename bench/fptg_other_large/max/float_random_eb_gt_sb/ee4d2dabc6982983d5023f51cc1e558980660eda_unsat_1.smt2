(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11010001110 #b01000)
                arg2
                (fp #b1 #b01111111111 #b00110)))
(assert (fp.leq (fp #b1 #b01111111111 #b00110)
                arg2
                (fp #b0 #b01010100000 #b01110)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111100001 #b00101)
                expect
                (fp #b1 #b01111111111 #b00110)))
(assert (fp.leq (fp #b1 #b01111111111 #b00110)
                expect
                (fp #b0 #b00111011000 #b01111)))

(assert (not (= expect result)))

(check-sat)
(exit)
