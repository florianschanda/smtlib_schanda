                expect
                (fp #b1 #b1001110010000110 #b1000011011010)))
(assert (fp.leq (fp #b1 #b1001110010000110 #b1000011011010)
                expect
                (fp #b0 #b0100011010100101 #b1011111110001)))

(assert (not (= expect result)))

(check-sat)
