(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b10001101101110 #b11)
                arg1
                (fp #b0 #b10111111111110 #b11)))
(assert (fp.leq (fp #b0 #b10111111111110 #b11)
                arg1
                (fp #b0 #b11010101101001 #b01)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
