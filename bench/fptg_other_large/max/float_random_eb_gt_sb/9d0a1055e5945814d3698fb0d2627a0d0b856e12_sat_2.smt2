(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100001010 #b1110010)
                arg1
                (fp #b1 #b100000111 #b0000000)))
(assert (fp.leq (fp #b1 #b100000111 #b0000000)
                arg1
                (fp #b0 #b110011000 #b1100010)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110000011 #b1101100)
                expect
                (fp #b1 #b100000111 #b0000000)))
(assert (fp.leq (fp #b1 #b100000111 #b0000000)
                expect
                (fp #b0 #b101001010 #b0001110)))

(assert (= expect result))

(check-sat)
(exit)
