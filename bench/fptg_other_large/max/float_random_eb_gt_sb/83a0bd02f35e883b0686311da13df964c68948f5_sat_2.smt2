; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b110110110001000101 #b1101010)
                arg2
                (fp #b1 #b000000000000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000011)
                arg2
                (fp #b0 #b001111111001110101 #b0011100)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b110111101111101111 #b1000100)
                expect
                (fp #b1 #b000000000000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0000011)
                expect
                (fp #b0 #b010001111011101000 #b1101011)))

(assert (= expect result))

(check-sat)
(exit)
