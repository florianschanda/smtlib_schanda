(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b001101001 #b00101)
                arg1
                (fp #b0 #b110110110 #b01110)))
(assert (fp.leq (fp #b0 #b110110110 #b01110)
                arg1
                (fp #b0 #b111000101 #b10110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101101001 #b11100)
                expect
                (fp #b0 #b110110110 #b01110)))
(assert (fp.leq (fp #b0 #b110110110 #b01110)
                expect
                (fp #b0 #b111010101 #b00011)))

(assert (= expect result))

(check-sat)
(exit)
