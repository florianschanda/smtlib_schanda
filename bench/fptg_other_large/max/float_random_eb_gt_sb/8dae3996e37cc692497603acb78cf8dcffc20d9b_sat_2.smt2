(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b001101101111000 #b1110)
                arg2
                (fp #b0 #b100000000000001 #b1000)))
(assert (fp.leq (fp #b0 #b100000000000001 #b1000)
                arg2
                (fp #b0 #b101101000110010 #b1010)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b000001100011001 #b0101)
                expect
                (fp #b0 #b100000000000001 #b1000)))
(assert (fp.leq (fp #b0 #b100000000000001 #b1000)
                expect
                (fp #b0 #b110111111000101 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
