; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100000110111 #b0101111000)
                arg2
                (fp #b1 #b011111111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b011111111111 #b0000100111)
                arg2
                (fp #b0 #b001000010100 #b1010011011)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110000011110 #b0101110010)
                expect
                (fp #b1 #b011111111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b011111111111 #b0000100111)
                expect
                (fp #b0 #b010001111100 #b1110010010)))

(assert (= expect result))

(check-sat)
(exit)
