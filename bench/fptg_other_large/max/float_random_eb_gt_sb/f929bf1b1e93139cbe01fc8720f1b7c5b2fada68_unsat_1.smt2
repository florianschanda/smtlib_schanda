; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11110000101 #b11010)
                arg1
                (fp #b1 #b11101110000 #b10110)))
(assert (fp.leq (fp #b1 #b11101110000 #b10110)
                arg1
                (fp #b0 #b00110010100 #b10111)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111001101 #b00101)
                expect
                (fp #b1 #b11101110000 #b10110)))
(assert (fp.leq (fp #b1 #b11101110000 #b10110)
                expect
                (fp #b1 #b01001100001 #b00111)))

(assert (not (= expect result)))

(check-sat)
(exit)
