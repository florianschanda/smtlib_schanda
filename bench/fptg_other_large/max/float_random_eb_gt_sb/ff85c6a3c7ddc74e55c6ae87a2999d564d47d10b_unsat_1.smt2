; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1011101110111010 #b001001)
                arg2
                (fp #b1 #b0101100110110011 #b110000)))
(assert (fp.leq (fp #b1 #b0101100110110011 #b110000)
                arg2
                (fp #b0 #b1001100001010101 #b110001)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1110101001110001 #b101000)
                expect
                (fp #b1 #b0101100110110011 #b110000)))
(assert (fp.leq (fp #b1 #b0101100110110011 #b110000)
                expect
                (fp #b0 #b1011110110001001 #b110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
