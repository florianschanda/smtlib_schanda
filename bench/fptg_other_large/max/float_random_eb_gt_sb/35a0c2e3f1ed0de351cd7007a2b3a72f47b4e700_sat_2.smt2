(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1001111001 #b11)
                expect
                (fp #b0 #b0000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000 #b10)
                expect
                (fp #b0 #b1100011011 #b11)))

(assert (= expect result))

(check-sat)
(exit)
