; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110011000011 #b101)
                arg1
                (fp #b0 #b101111111110 #b111)))
(assert (fp.leq (fp #b0 #b101111111110 #b111)
                arg1
                (fp #b0 #b110000111110 #b001)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
