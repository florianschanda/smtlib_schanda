; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111100011 #b0011)
                arg1
                (fp #b1 #b000000000 #b1111)))
(assert (fp.leq (fp #b1 #b000000000 #b1111)
                arg1
                (fp #b0 #b111011110 #b1101)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001000001 #b0101)
                expect
                (fp #b1 #b000000000 #b1111)))
(assert (fp.leq (fp #b1 #b000000000 #b1111)
                expect
                (fp #b0 #b001110010 #b0001)))

(assert (not (= expect result)))

(check-sat)
(exit)
