(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b0 #b0110001001100 #b0)
                arg2
                (fp #b0 #b0111111111111 #b0)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0)
                arg2
                (fp #b0 #b1101000000011 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111011001010 #b0)
                expect
                (fp #b0 #b0111111111111 #b0)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0)
                expect
                (fp #b0 #b1110000110101 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
