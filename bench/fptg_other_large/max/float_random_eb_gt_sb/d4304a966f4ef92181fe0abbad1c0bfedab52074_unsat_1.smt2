                expect
                (fp #b0 #b000000000000000 #b111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b111111)
                expect
                (fp #b0 #b000011001101000 #b000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
