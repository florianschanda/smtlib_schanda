; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110001100 #b0010100)
                arg2
                (fp #b0 #b0000010101 #b1000010)))
(assert (fp.leq (fp #b0 #b0000010101 #b1000010)
                arg2
                (fp #b0 #b0011011001 #b0111011)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001100010 #b0111011)
                expect
                (fp #b0 #b0000010101 #b1000010)))
(assert (fp.leq (fp #b0 #b0000010101 #b1000010)
                expect
                (fp #b0 #b1010010001 #b0010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
