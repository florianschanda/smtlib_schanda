(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100100011110 #b1010)
                arg2
                (fp #b1 #b010000000000 #b0000)))
(assert (fp.leq (fp #b1 #b010000000000 #b0000)
                arg2
                (fp #b0 #b110111000001 #b0011)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100100111010 #b0100)
                expect
                (fp #b1 #b010000000000 #b0000)))
(assert (fp.leq (fp #b1 #b010000000000 #b0000)
                expect
                (fp #b0 #b011111000001 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
