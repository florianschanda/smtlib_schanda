(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1101111000101 #b10)
                arg2
                (fp #b0 #b1000000000010 #b00)))
(assert (fp.leq (fp #b0 #b1000000000010 #b00)
                arg2
                (fp #b0 #b1101100001101 #b11)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1010110010110 #b10)
                expect
                (fp #b0 #b1000000000010 #b00)))
(assert (fp.leq (fp #b0 #b1000000000010 #b00)
                expect
                (fp #b0 #b1001001111101 #b00)))

(assert (= expect result))

(check-sat)
(exit)
