; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0001010111110 #b0001110)
                arg2
                (fp #b0 #b0000000000000 #b1011101)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1011101)
                arg2
                (fp #b0 #b0000101110100 #b0110011)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
