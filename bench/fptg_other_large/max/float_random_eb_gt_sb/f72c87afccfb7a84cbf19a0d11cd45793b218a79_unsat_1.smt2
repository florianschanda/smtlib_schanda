(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110001100 #b01)
                arg2
                (fp #b1 #b001111111 #b00)))
(assert (fp.leq (fp #b1 #b001111111 #b00)
                arg2
                (fp #b0 #b111111100 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111101101 #b10)
                expect
                (fp #b1 #b001111111 #b00)))
(assert (fp.leq (fp #b1 #b001111111 #b00)
                expect
                (fp #b0 #b100000100 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
