                expect
                (fp #b0 #b00000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b000000000000001)
                expect
                (fp #b0 #b00111101011010110 #b000110101111111)))

(assert (not (= expect result)))

(check-sat)
