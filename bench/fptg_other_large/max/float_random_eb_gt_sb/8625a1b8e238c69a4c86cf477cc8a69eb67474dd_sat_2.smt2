(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100011001 #b0101)
                arg2
                (fp #b1 #b000101100 #b1010)))
(assert (fp.leq (fp #b1 #b000101100 #b1010)
                arg2
                (fp #b0 #b010101100 #b1011)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001000111 #b1111)
                expect
                (fp #b1 #b000101100 #b1010)))
(assert (fp.leq (fp #b1 #b000101100 #b1010)
                expect
                (fp #b0 #b011110000 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
