(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1110010100100100 #b00)
                arg2
                (fp #b1 #b0111111111111111 #b10)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b10)
                arg2
                (fp #b0 #b1110000010001010 #b01)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1100100000011001 #b10)
                expect
                (fp #b1 #b0111111111111111 #b10)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b10)
                expect
                (fp #b0 #b0111001111110101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
