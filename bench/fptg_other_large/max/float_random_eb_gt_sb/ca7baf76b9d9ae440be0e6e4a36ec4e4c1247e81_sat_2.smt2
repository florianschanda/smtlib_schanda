(assert (fp.leq (fp #b1 #b1100110010 #b10)
                expect
                (fp #b0 #b1100100010 #b01)))
(assert (fp.leq (fp #b0 #b1100100010 #b01)
                expect
                (fp #b0 #b1110011110 #b11)))

(assert (= expect result))

