(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0001101000 #b000)
                arg2
                (fp #b0 #b1111001111 #b110)))
(assert (fp.leq (fp #b0 #b1111001111 #b110)
                arg2
                (fp #b0 #b1111111001 #b011)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b1000101101 #b110)
                expect
                (fp #b0 #b1111001111 #b110)))
(assert (fp.leq (fp #b0 #b1111001111 #b110)
                expect
                (fp #b0 #b1111010100 #b101)))

(assert (= expect result))

(check-sat)
(exit)
