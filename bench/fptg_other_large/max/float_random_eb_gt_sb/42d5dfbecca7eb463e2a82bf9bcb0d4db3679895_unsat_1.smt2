; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1000001000001 #b0110101)
                arg2
                (fp #b0 #b1100011111110 #b1010011)))
(assert (fp.leq (fp #b0 #b1100011111110 #b1010011)
                arg2
                (fp #b0 #b1110101101000 #b0001101)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
