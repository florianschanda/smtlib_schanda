(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0111010110010000 #b0111)
                arg2
                (fp #b0 #b1000000110111010 #b1111)))
(assert (fp.leq (fp #b0 #b1000000110111010 #b1111)
                arg2
                (fp #b0 #b1100000001110100 #b1111)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1011001010011011 #b0101)
                expect
                (fp #b0 #b1000000110111010 #b1111)))
(assert (fp.leq (fp #b0 #b1000000110111010 #b1111)
                expect
                (fp #b0 #b1110110011101011 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
