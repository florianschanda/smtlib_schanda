; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0110111010 #b11111)
                arg1
                (fp #b1 #b0000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000)
                arg1
                (fp #b0 #b0010011001 #b10011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0001001000 #b10100)
                arg2
                (fp #b0 #b0011111101 #b01101)))
(assert (fp.leq (fp #b0 #b0011111101 #b01101)
                arg2
                (fp #b0 #b1000100111 #b00110)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111110000 #b11110)
                expect
                (fp #b0 #b0011111101 #b01101)))
(assert (fp.leq (fp #b0 #b0011111101 #b01101)
                expect
                (fp #b0 #b1111111000 #b10000)))

(assert (not (= expect result)))

(check-sat)
(exit)
