(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101001100 #b10111)
                arg2
                (fp #b1 #b000000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000000 #b00001)
                arg2
                (fp #b0 #b100011110 #b11000)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111001011 #b00011)
                expect
                (fp #b1 #b000000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000000 #b00001)
                expect
                (fp #b0 #b011100010 #b00111)))

(assert (not (= expect result)))

(check-sat)
(exit)
