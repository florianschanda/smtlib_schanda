; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1011000100110000 #b011)
                arg1
                (fp #b1 #b1000111101011111 #b101)))
(assert (fp.leq (fp #b1 #b1000111101011111 #b101)
                arg1
                (fp #b0 #b0010000001100010 #b001)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1110100110111101 #b010)
                expect
                (fp #b1 #b1000111101011111 #b101)))
(assert (fp.leq (fp #b1 #b1000111101011111 #b101)
                expect
                (fp #b0 #b1011111001100101 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
