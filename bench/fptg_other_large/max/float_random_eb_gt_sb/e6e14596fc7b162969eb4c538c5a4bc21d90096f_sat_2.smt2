(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1100010100110 #b10110)
                arg2
                (fp #b1 #b0000000000000 #b10110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b10110)
                arg2
                (fp #b0 #b1101001010000 #b00001)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0100101101101 #b00010)
                expect
                (fp #b1 #b0000000000000 #b10110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b10110)
                expect
                (fp #b0 #b0001111100010 #b01010)))

(assert (= expect result))

(check-sat)
(exit)
