(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b10010011110000001 #b10010110101100)
                arg2
                (fp #b1 #b00000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b10000010110010110 #b01110010001011)))

(declare-const result (_ FloatingPoint 17 15))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b10000101011011000 #b01110100010010)
                expect
                (fp #b1 #b00000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b01110111010011)
                expect
                (fp #b0 #b11101010110101001 #b01100101001001)))

(assert (= expect result))

(check-sat)
(exit)
