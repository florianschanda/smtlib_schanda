(assert (fp.leq (fp #b1 #b100111111 #b011)
                expect
                (fp #b1 #b000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000 #b000)
                expect
                (fp #b0 #b101000101 #b001)))

(assert (= expect result))

