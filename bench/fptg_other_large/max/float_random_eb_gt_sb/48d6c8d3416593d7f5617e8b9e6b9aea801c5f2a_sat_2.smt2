(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b000110000 #b1100)
                arg1
                (fp #b0 #b000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000)
                arg1
                (fp #b0 #b110111000 #b0100)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010111111 #b1110)
                expect
                (fp #b0 #b000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000)
                expect
                (fp #b0 #b101111000 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
