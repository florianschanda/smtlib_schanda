;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111111101 #b0)
                arg1
                (fp #b0 #b000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000 #b1)
                arg1
