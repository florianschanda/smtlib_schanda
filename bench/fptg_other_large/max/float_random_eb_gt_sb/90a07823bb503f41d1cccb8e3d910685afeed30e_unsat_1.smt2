                arg2
                (fp #b1 #b000000000 #b0)))
(assert (fp.leq (fp #b1 #b000000000 #b0)
                arg2
                (fp #b0 #b010011110 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001010000 #b0)
                expect
                (fp #b0 #b000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000 #b1)
                expect
                (fp #b0 #b111001000 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
