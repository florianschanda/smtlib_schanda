(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1100101010 #b01)
                arg1
                (fp #b1 #b1000000000 #b10)))
(assert (fp.leq (fp #b1 #b1000000000 #b10)
                arg1
                (fp #b0 #b0001111000 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0111011011 #b10)
                arg2
                (fp #b1 #b0000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000 #b00)
                arg2
                (fp #b0 #b1101110011 #b00)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0011100000 #b01)
                expect
                (fp #b1 #b0000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000 #b00)
                expect
                (fp #b0 #b0000001110 #b10)))

(assert (= expect result))

(check-sat)
(exit)
