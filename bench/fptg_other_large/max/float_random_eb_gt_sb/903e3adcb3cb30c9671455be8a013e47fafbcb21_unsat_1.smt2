(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1110100100101 #b0111)
                arg2
                (fp #b1 #b1000101101100 #b1000)))
(assert (fp.leq (fp #b1 #b1000101101100 #b1000)
                arg2
                (fp #b1 #b0010111010100 #b0101)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1111100000000 #b0001)
                expect
                (fp #b1 #b1000101101100 #b1000)))
(assert (fp.leq (fp #b1 #b1000101101100 #b1000)
                expect
                (fp #b0 #b0011001000100 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
