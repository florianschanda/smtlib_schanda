(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b110000101011110 #b010001)
                arg2
                (fp #b0 #b000000000000000 #b010000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b010000)
                arg2
                (fp #b0 #b110011110010110 #b101100)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b000111010011100 #b111111)
                expect
                (fp #b0 #b000000000000000 #b010000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b010000)
                expect
                (fp #b0 #b100001001110100 #b111000)))

(assert (= expect result))

(check-sat)
(exit)
