; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1110000001111001 #b0110)
                arg1
                (fp #b0 #b0000000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000)
                arg1
                (fp #b0 #b1000100010100100 #b1100)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1010101011101100 #b1101)
                arg2
                (fp #b0 #b0000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100)
                arg2
                (fp #b0 #b0111111000101101 #b0000)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0011010001010100 #b1110)
                expect
                (fp #b0 #b0000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100)
                expect
                (fp #b0 #b1111010100000011 #b0001)))

(assert (= expect result))

(check-sat)
(exit)
