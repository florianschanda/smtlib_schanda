; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1111001101011 #b00000000111)
                arg2
                (fp #b0 #b0111111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b01111100000)
                arg2
                (fp #b0 #b1110101111000 #b11101011010)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1000011011000 #b01000110111)
                expect
                (fp #b0 #b0111111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b01111100000)
                expect
                (fp #b0 #b1101110010101 #b10001100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
