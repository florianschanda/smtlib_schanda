(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b00011001100 #b111110)
                arg1
                (fp #b0 #b10100010101 #b110010)))
(assert (fp.leq (fp #b0 #b10100010101 #b110010)
                arg1
                (fp #b0 #b10111110110 #b110100)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
