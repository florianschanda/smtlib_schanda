(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b001011100111111 #b0111)
                arg1
                (fp #b0 #b000000000000000 #b1111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1111)
                arg1
                (fp #b0 #b001001000001001 #b0100)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b010001011011110 #b0011)
                expect
                (fp #b0 #b000000000000000 #b1111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1111)
                expect
                (fp #b0 #b010110100000110 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
