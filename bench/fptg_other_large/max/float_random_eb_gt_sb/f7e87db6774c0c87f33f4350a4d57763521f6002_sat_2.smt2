(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01101110101000 #b0011000)
                arg1
                (fp #b0 #b01000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b0000000)
                arg1
                (fp #b0 #b10000000101001 #b0110111)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11101000101001 #b1000101)
                expect
                (fp #b0 #b01000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b0000000)
                expect
                (fp #b0 #b11111000110001 #b0110010)))

(assert (= expect result))

(check-sat)
(exit)
