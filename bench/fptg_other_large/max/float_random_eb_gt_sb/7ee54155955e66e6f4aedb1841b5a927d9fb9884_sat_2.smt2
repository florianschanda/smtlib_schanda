; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b110010001000001 #b1011011)
                arg1
                (fp #b1 #b110001111101000 #b0000111)))
(assert (fp.leq (fp #b1 #b110001111101000 #b0000111)
                arg1
                (fp #b1 #b101111010001011 #b1100001)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
