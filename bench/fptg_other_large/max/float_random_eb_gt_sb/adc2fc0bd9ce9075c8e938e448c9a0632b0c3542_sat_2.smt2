; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1111000001011011 #b010001111)
                arg2
                (fp #b1 #b1001100010001100 #b111111011)))
(assert (fp.leq (fp #b1 #b1001100010001100 #b111111011)
                arg2
                (fp #b1 #b0011011001011011 #b110100001)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1100010000111010 #b111011000)
                expect
                (fp #b1 #b1001100010001100 #b111111011)))
(assert (fp.leq (fp #b1 #b1001100010001100 #b111111011)
                expect
                (fp #b0 #b1011001101010101 #b011111010)))

(assert (= expect result))

(check-sat)
(exit)
