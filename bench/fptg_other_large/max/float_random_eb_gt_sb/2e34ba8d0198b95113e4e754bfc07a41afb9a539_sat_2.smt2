(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001101110 #b010100)
                arg2
                (fp #b0 #b001111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111101 #b000000)
                arg2
                (fp #b0 #b110110011 #b011000)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111101101 #b101110)
                expect
                (fp #b0 #b001111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111101 #b000000)
                expect
                (fp #b0 #b101110110 #b101000)))

(assert (= expect result))

(check-sat)
(exit)
