(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1100101100010100 #b1000100100110)
                expect
                (fp #b1 #b0100000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0000000000000)
                expect
                (fp #b0 #b0010100011101100 #b0011010000001)))

(assert (= expect result))

(check-sat)
(exit)
