;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1101101101011011 #b1111100111000)
                arg1
                (fp #b1 #b0100000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0000000000000)
                arg1
