;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0010001000001)
                arg1
                (fp #b1 #b111111111111111101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b0000000000000)
                arg1
                (fp #b0 #b011000101110100000 #b0011000010100)))

(declare-const arg2 (_ FloatingPoint 18 14))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 14))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
