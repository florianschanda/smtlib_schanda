(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b101100100001 #b01110)
                arg1
                (fp #b1 #b011111111111 #b10110)))
(assert (fp.leq (fp #b1 #b011111111111 #b10110)
                arg1
                (fp #b0 #b001011011111 #b01011)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111110010101 #b00100)
                expect
                (fp #b1 #b011111111111 #b10110)))
(assert (fp.leq (fp #b1 #b011111111111 #b10110)
                expect
                (fp #b0 #b101011101001 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
