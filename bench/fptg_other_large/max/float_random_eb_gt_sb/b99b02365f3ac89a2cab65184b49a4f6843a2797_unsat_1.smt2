(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111101100 #b00)
                arg2
                (fp #b1 #b10000000001 #b10)))
(assert (fp.leq (fp #b1 #b10000000001 #b10)
                arg2
                (fp #b0 #b00101100011 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11001111000 #b01)
                expect
                (fp #b1 #b10000000001 #b10)))
(assert (fp.leq (fp #b1 #b10000000001 #b10)
                expect
                (fp #b0 #b10001101111 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
