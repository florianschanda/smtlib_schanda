(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101111100 #b01111)
                arg1
                (fp #b1 #b101101100 #b11000)))
(assert (fp.leq (fp #b1 #b101101100 #b11000)
                arg1
                (fp #b1 #b001101011 #b10001)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
