; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1010010001110 #b1010100)
                arg2
                (fp #b1 #b0000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0100000)
                arg2
                (fp #b0 #b0101010000000 #b1010001)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0101101110011 #b0111010)
                expect
                (fp #b1 #b0000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0100000)
                expect
                (fp #b0 #b0001101110000 #b1011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
