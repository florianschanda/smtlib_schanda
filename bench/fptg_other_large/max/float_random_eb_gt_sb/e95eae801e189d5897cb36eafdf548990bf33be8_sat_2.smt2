(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110110110010 #b0001101011)
                arg2
                (fp #b1 #b000000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0100000000)
                arg2
                (fp #b0 #b111010000101 #b0110101110)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111100101111 #b1001000111)
                expect
                (fp #b1 #b000000000000 #b0100000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b0100000000)
                expect
                (fp #b0 #b000000000100 #b1110101111)))

(assert (= expect result))

(check-sat)
(exit)
