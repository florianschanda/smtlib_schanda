; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b0 #b01110111111110 #b0110111011)
                arg2
                (fp #b0 #b11110000000000 #b1111001110)))
(assert (fp.leq (fp #b0 #b11110000000000 #b1111001110)
                arg2
                (fp #b0 #b11111100110000 #b1000010010)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b0 #b10001001100110 #b1101101110)
                expect
                (fp #b0 #b11110000000000 #b1111001110)))
(assert (fp.leq (fp #b0 #b11110000000000 #b1111001110)
                expect
                (fp #b0 #b11111000100010 #b1111111110)))

(assert (= expect result))

(check-sat)
(exit)
