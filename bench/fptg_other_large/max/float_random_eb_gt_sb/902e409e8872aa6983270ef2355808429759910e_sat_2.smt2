(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b00100111001 #b01110)
                arg1
                (fp #b0 #b11100000101 #b10001)))
(assert (fp.leq (fp #b0 #b11100000101 #b10001)
                arg1
                (fp #b0 #b11111000110 #b10101)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10110000011 #b10111)
                expect
                (fp #b0 #b11100000101 #b10001)))
(assert (fp.leq (fp #b0 #b11100000101 #b10001)
                expect
                (fp #b0 #b11101001101 #b00110)))

(assert (= expect result))

(check-sat)
(exit)
