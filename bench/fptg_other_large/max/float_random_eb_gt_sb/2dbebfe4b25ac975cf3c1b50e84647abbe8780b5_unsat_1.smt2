(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10010000011100 #b1111)
                arg2
                (fp #b1 #b10000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b0000)
                arg2
                (fp #b0 #b10100100000101 #b1000)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10010001010101 #b1111)
                expect
                (fp #b1 #b10000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b0000)
                expect
                (fp #b0 #b01000010110110 #b0111)))

(assert (not (= expect result)))

(check-sat)
(exit)
