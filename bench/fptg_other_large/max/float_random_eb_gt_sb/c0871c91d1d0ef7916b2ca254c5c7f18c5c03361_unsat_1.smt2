; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 18 13))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 13))
(assert (fp.leq (fp #b1 #b000101011100100011 #b101001101110)
                arg2
                (fp #b0 #b001111111111111010 #b000000000000)))
(assert (fp.leq (fp #b0 #b001111111111111010 #b000000000000)
                arg2
                (fp #b0 #b110110001111101101 #b010011000010)))

(declare-const result (_ FloatingPoint 18 13))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 13))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
