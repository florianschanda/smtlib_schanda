(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b011001100 #b0101011)
                arg2
                (fp #b0 #b100000110 #b0000001)))
(assert (fp.leq (fp #b0 #b100000110 #b0000001)
                arg2
                (fp #b0 #b101001000 #b0001110)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111100 #b0101000)
                expect
                (fp #b0 #b100000110 #b0000001)))
(assert (fp.leq (fp #b0 #b100000110 #b0000001)
                expect
                (fp #b0 #b101011010 #b0101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
