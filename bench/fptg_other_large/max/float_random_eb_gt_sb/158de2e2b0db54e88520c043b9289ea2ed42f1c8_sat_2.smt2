(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b100101011111110 #b0000)
                arg1
                (fp #b1 #b100001110001110 #b1001)))
(assert (fp.leq (fp #b1 #b100001110001110 #b1001)
                arg1
                (fp #b1 #b000100101111100 #b1111)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
