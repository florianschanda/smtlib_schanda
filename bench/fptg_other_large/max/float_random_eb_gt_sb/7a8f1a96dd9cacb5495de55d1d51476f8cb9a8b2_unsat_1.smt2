(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101100111 #b1011)
                arg2
                (fp #b1 #b100000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000100 #b0000)
                arg2
                (fp #b1 #b010011001 #b1011)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100111000 #b0001)
                expect
                (fp #b1 #b100000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000100 #b0000)
                expect
                (fp #b0 #b001110100 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
