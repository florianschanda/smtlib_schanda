(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b11000010101 #b1)
                arg1
                (fp #b0 #b11001001101 #b0)))
(assert (fp.leq (fp #b0 #b11001001101 #b0)
                arg1
                (fp #b0 #b11010001000 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b01000010011 #b1)
                expect
                (fp #b0 #b11001001101 #b0)))
(assert (fp.leq (fp #b0 #b11001001101 #b0)
                expect
                (fp #b0 #b11111011100 #b0)))

(assert (= expect result))

(check-sat)
(exit)
