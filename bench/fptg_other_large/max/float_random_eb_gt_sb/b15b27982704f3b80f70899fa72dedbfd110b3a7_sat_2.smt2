; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10011100000010 #b10100110)
                arg1
                (fp #b0 #b00000000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01010111)
                arg1
                (fp #b0 #b11010001001010 #b01010110)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b01111110000010 #b01001110)
                expect
                (fp #b0 #b00000000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01010111)
                expect
                (fp #b0 #b10111100101000 #b10000001)))

(assert (= expect result))

(check-sat)
(exit)
