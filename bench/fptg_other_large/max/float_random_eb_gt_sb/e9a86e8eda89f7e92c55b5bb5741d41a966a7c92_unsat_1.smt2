                expect
                (fp #b0 #b000000000000 #b111111)))
(assert (fp.leq (fp #b0 #b000000000000 #b111111)
                expect
                (fp #b0 #b101010111011 #b100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
