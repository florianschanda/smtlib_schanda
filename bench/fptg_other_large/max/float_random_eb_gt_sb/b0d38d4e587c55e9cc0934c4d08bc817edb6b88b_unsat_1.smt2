(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b01111001001110 #b1)
                arg2
                (fp #b0 #b01111111111111 #b0)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0)
                arg2
                (fp #b0 #b10101001111000 #b0)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b0 #b00001100100010 #b1)
                expect
                (fp #b0 #b01111111111111 #b0)))
(assert (fp.leq (fp #b0 #b01111111111111 #b0)
                expect
                (fp #b0 #b11010001101100 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
