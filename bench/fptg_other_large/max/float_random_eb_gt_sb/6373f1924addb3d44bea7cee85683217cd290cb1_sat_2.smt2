; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11000100111111 #b100110)
                arg2
                (fp #b1 #b10110111111001 #b001010)))
(assert (fp.leq (fp #b1 #b10110111111001 #b001010)
                arg2
                (fp #b0 #b10110000101110 #b010101)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
