(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b010100011100 #b11)
                arg2
                (fp #b0 #b100000000001 #b10)))
(assert (fp.leq (fp #b0 #b100000000001 #b10)
                arg2
                (fp #b0 #b101111111001 #b11)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101110001101 #b10)
                expect
                (fp #b0 #b100000000001 #b10)))
(assert (fp.leq (fp #b0 #b100000000001 #b10)
                expect
                (fp #b0 #b111100011010 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
