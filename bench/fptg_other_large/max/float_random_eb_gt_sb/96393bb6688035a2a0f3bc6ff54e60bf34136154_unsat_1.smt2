(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101101101 #b0101101)
                arg1
                (fp #b0 #b0111111111 #b0101011)))
(assert (fp.leq (fp #b0 #b0111111111 #b0101011)
                arg1
                (fp #b0 #b1110010101 #b0011111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1011000001 #b0010011)
                expect
                (fp #b0 #b0111111111 #b0101011)))
(assert (fp.leq (fp #b0 #b0111111111 #b0101011)
                expect
                (fp #b0 #b1110011001 #b1001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
