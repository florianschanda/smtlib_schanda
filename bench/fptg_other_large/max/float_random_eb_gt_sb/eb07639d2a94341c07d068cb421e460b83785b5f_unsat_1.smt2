(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b011100110 #b0010100)
                arg2
                (fp #b0 #b011110001 #b1010100)))
(assert (fp.leq (fp #b0 #b011110001 #b1010100)
                arg2
                (fp #b0 #b111010100 #b0011010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
