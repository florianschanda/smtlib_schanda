; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b000110000101010 #b1001100100)
                arg2
                (fp #b0 #b111010000110000 #b1100001111)))
(assert (fp.leq (fp #b0 #b111010000110000 #b1100001111)
                arg2
                (fp #b0 #b111101001100001 #b0000111001)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b0 #b100101100111011 #b1111111100)
                expect
                (fp #b0 #b111010000110000 #b1100001111)))
(assert (fp.leq (fp #b0 #b111010000110000 #b1100001111)
                expect
                (fp #b0 #b111011110011000 #b0011110110)))

(assert (= expect result))

(check-sat)
(exit)
