(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001010111 #b10110010)
                arg2
                (fp #b1 #b0111111111 #b00000000)))
(assert (fp.leq (fp #b1 #b0111111111 #b00000000)
                arg2
                (fp #b0 #b1000000110 #b11110100)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1101011101 #b10001111)
                expect
                (fp #b1 #b0111111111 #b00000000)))
(assert (fp.leq (fp #b1 #b0111111111 #b00000000)
                expect
                (fp #b0 #b1011001001 #b01001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
