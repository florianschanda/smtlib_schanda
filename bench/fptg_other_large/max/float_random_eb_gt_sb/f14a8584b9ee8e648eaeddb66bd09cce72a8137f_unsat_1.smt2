(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10111110101 #b0001011)
                expect
                (fp #b1 #b01111111111 #b0000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000)
                expect
                (fp #b1 #b01010111100 #b1000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
