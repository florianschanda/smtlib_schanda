(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100110100 #b111010)
                expect
                (fp #b0 #b111011010 #b011001)))
(assert (fp.leq (fp #b0 #b111011010 #b011001)
                expect
                (fp #b0 #b111011100 #b010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
