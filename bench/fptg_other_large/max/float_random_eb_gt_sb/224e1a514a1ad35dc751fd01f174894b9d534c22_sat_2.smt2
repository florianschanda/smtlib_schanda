; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000001011 #b01000)
                arg1
                (fp #b0 #b1011001100 #b10100)))
(assert (fp.leq (fp #b0 #b1011001100 #b10100)
                arg1
                (fp #b0 #b1011011100 #b00111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0110110011 #b10011)
                expect
                (fp #b0 #b1011001100 #b10100)))
(assert (fp.leq (fp #b0 #b1011001100 #b10100)
                expect
                (fp #b0 #b1011100111 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
