; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b101111000111110010 #b001111011110100)
                arg2
                (fp #b1 #b101001000001001110 #b000111100101000)))
(assert (fp.leq (fp #b1 #b101001000001001110 #b000111100101000)
                arg2
                (fp #b0 #b011011101111001001 #b011110000111001)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b101111010111011001 #b100110101010110)
                expect
                (fp #b1 #b101001000001001110 #b000111100101000)))
(assert (fp.leq (fp #b1 #b101001000001001110 #b000111100101000)
                expect
                (fp #b0 #b100000001110010001 #b011100001111001)))

(assert (= expect result))

(check-sat)
(exit)
