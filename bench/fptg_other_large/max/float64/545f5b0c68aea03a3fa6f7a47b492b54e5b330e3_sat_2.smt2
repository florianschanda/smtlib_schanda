(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010010001 #b0100111001100000010101000001000101110101000111111011)
                expect
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)
                expect
                (fp #b0 #b11011000010 #b1110111110001000010101000001001101000100010101001000)))

(assert (= expect result))

(check-sat)
(exit)
