; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00000111101 #b0101101010101101000111011110101101111100111001000110)
                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b10101001001 #b0100101101101010101001111111110101001000001010000010)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
