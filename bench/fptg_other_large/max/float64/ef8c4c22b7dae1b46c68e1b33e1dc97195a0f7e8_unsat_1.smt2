(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010000011 #b0111011001000101110100100110000010101001011101011000)
                expect
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01000001011 #b1111101001111000110110010011010001111000100100100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
