(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00011111101 #b0001111101000100100110110001001001011010011000101000)
                expect
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111111110 #b1001000111011111100100100110100001010010111010010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
