; Format: FLOAT64
; Arg1: -NAN
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01000100100 #b0100110110011000001110100000000010111001010111011000)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b10100010000 #b0001011101000111001101010010111010001110000001000111)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111001100 #b0101111010000100011111011001111100111111110000101010)
                expect
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                expect
                (fp #b0 #b11000001000 #b0001101010010010011010111010100110000110111001000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
