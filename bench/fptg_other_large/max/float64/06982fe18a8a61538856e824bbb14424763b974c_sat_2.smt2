(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -INFINITY
; Arg2: -ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b10101101111 #b1100001110001100000101010011100011001110011100111011)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01100011001 #b0100100001101100011111111011110010001000011000110111)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00110110100 #b1101100100000110100010010110011010110101110100110111)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00001011111 #b1001010100111001101000111110010111100100001111010111)))

(assert (= expect result))

(check-sat)
(exit)
