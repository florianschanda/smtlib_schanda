(assert (fp.leq (fp #b1 #b00100011111 #b0001011111111110000011110010001100010100001101000000)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11000000000 #b1000001101000100010100110100101010011100000110110010)))

(assert (= expect result))

(check-sat)
