(assert (fp.leq (fp #b1 #b10111100111 #b0110011001011010100000100110110100101001010110001010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10100111011 #b0101101110001111101001010101000111010100101000000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
