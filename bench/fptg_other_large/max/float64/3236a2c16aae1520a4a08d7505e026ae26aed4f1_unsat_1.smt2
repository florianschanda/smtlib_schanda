(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -INFINITY
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01010011000 #b0101010101100110111000100011101111111000110010001011)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11100111011 #b1000001111101100101010011100000111001011111001101110)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001000111 #b1111010100111010010100000111111010100110100100000010)
                expect
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                expect
                (fp #b0 #b11010011010 #b1000001110011000001111110001101111000001001011110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
