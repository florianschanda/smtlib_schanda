(assert (fp.leq (fp #b1 #b01001110011 #b0101110110100101100000111001100011011111100011011100)
                expect
                (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10000011001 #b1101101111000111001100011100110000111101101000011001)))

(assert (not (= expect result)))

