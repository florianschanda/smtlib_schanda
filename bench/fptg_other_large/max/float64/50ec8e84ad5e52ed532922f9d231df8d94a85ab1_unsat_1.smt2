                arg2
                (fp #b0 #b10011101010 #b1011001011100011111000100000000100001000100100011001)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00010100001 #b0011011001010110000100111010001011110000111111110011)
                expect
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
