(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011111110 #b0001100101101001000011010100011001010011010001000010)
                expect
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11110000010 #b1110111001101101101111000000111001100010101100101000)))

(assert (= expect result))

(check-sat)
(exit)
