; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +NAN

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101111010 #b1001000111101000010010101110100101001101101010001111)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b0 #b10110001110 #b0111000001111010100110111100010000010100100100010001)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010001001 #b0110110110111100110011110001111101101100110001101110)
                expect
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                expect
                (fp #b1 #b01001011010 #b1000001101100110011011100101010010111011101101000111)))

(assert (= expect result))

(check-sat)
(exit)
