(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00101000111 #b0111111110010110100001010101000101011000000111011111)
                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111110110 #b0100110010011110111001001100101100000110010001000111)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10000010010 #b1001000001101000101111000110000010011101001110110100)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11001101110 #b0000110000111110111011001100110011101101100101011100)))

(assert (= expect result))

(check-sat)
(exit)
