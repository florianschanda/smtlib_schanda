; Format: FLOAT64
; Arg1: +NAN
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00000111100 #b0100011100111111010001111000011101010101000000011110)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000110110 #b0100010100000100000011110010100100101101110110110010)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01011000001 #b0100000001111111101111101001001101000111000010010101)
                expect
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111001001 #b0110101001001010111010001100010111101110111110101011)))

(assert (= expect result))

(check-sat)
(exit)
