                (fp #b1 #b10010110010 #b1101001000111100111010011110100010110011000111010111)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010011100 #b0010100010011001000110001111110110010011001111111001)
                expect
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                expect
                (fp #b1 #b00101001010 #b1011111010111101110010100011011111111111110000100000)))

(assert (= expect result))

