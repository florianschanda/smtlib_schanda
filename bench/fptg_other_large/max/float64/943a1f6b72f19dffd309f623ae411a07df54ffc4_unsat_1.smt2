; Format: FLOAT64
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00000111000 #b0011001011101111111010011001000110100000001000000010)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11110100011 #b0101011010111110010001101111100010100111001101110101)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01111001011 #b0000111101110000011000101001101000101110110100110000)
                expect
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                expect
                (fp #b0 #b11011011111 #b0001101000100110100111001101001100000100110111111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
