; Format: FLOAT64
; Arg1: +NAN
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01010011110 #b1101110011011010001010101001100000011010010011000101)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
