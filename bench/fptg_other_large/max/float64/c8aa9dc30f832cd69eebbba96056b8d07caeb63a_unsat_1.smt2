                arg2
                (fp #b0 #b11110110100 #b0111001010111001111111000100101110111001010010000010)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111000110 #b1101110101110111111001101110011101000110010000101110)
                expect
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                expect
                (fp #b0 #b10101000000 #b1100011100000110101100010001000100011001101110000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
