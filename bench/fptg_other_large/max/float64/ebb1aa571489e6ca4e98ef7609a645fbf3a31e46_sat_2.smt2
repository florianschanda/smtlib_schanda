; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00000100010 #b0001100011100110110010100001001110111110110010110010)
                arg1
                (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)))
(assert (fp.leq (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)
                arg1
                (fp #b0 #b11101010000 #b0100000010110001110011010100000000100111011110000011)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
