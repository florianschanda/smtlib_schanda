(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01000111011 #b1111101000000011001011001000010110100101111110001011)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b01011000001 #b1101100110000010110001111000010110100101010111110110)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000111001 #b1011111101100110010010010001001001101011100001101001)
                expect
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                expect
                (fp #b0 #b10010001111 #b0101001000010000110111101010001110011001100001110101)))

(assert (= expect result))

(check-sat)
(exit)
