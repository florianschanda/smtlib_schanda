(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00010111001 #b1011111110000001000001111100111000000101000110101111)
                expect
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01001101011 #b0101110100110000101110010001011010010000100101001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
