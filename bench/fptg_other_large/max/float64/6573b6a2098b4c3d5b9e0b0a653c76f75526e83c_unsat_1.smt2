; Format: FLOAT64
; Arg1: -INFINITY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01100010011 #b1100101001010011011010100100101000101110000110001011)
                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111010111 #b1101101101011110010100101011011011100010101011110100)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000100100 #b0100000001101110110110111000011001110111011011110111)
                expect
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11011101101 #b1010010101010001001000110111011110110010111001100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
