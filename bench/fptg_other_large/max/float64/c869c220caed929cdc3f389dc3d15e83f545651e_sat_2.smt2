; Format: FLOAT64
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10110110011 #b1010011110111001010100111101110100111111011100100101)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10111110001 #b1011111011011000111100010000000110111001100010110010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111110010 #b0000001010111101110001011100010111100100101100010110)
                arg2
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                arg2
                (fp #b0 #b01110010011 #b1101100000010011110101111000010100101110011000100100)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101100111 #b0100100100001001011000000100110101101100100001110110)
                expect
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                expect
                (fp #b0 #b01111101001 #b0010010000100111101010111011001110110111000011111110)))

(assert (= expect result))

(check-sat)
(exit)
