; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011101011 #b1110111101011010101010111001001101000110100100011100)
                arg1
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)
                arg1
                (fp #b1 #b01110110101 #b1110000010110011010110110101001101111011110100011010)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
