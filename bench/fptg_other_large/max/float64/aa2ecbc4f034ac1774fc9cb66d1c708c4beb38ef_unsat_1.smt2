(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01000110011 #b1111001101101001010010111111010010111000110001101000)
                expect
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111111101 #b0100110101110100001000000101100100101100101000001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
