                arg2
                (fp #b0 #b00101010101 #b1000100111001011101110110010111101100010000110100100)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010101110 #b1011011010100010010000111011011010000011000011011100)
                expect
