(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110001000 #b1010010010101010010001001010101010000011010011010100)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
