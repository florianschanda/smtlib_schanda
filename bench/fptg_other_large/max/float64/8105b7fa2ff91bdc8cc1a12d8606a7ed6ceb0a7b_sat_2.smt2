                arg2
                (fp #b0 #b11001110100 #b1111100111011010001100000100011011100000110000001011)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00101010100 #b1100001100111101110110011001101010011111100001011111)
                expect
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                expect
                (fp #b0 #b11110110000 #b0010100010110100100111011110011110110101111001111110)))

(assert (= expect result))

(check-sat)
(exit)
