;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100001000 #b0100001001011001000100110100101111100000001001001111)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b11100100111 #b1111100110100001100001010111101101100110000110000111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0100101000101000100110011011010000000001111010000010)
                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00011111111 #b0001100010010011011100011000010010010000000000100101)))

(declare-const result Float64)
(assert (= result (fp.max arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001111000 #b0110101000001101111111110011010101110100101011111111)
                expect
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                expect
                (fp #b0 #b01011000010 #b0110110101010101000111110100000101010100000100001110)))

(assert (= expect result))

(check-sat)
(exit)
