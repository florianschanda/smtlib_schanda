;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 8 32))
(assert (fp.leq (fp #b1 #b11111000 #b1000100000110110011110011011101)
                arg1
                (fp #b1 #b10101010 #b1001110100111100110100100000011)))
(assert (fp.leq (fp #b1 #b10101010 #b1001110100111100110100100000011)
                arg1
                (fp #b0 #b00011101 #b0010110101110000010010011001111)))

(declare-const arg2 (_ FloatingPoint 8 32))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 8 32))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 32))
(assert (fp.leq (fp #b1 #b11111010 #b1111000001101000100010100110001)
                expect
                (fp #b1 #b10101010 #b1001110100111100110100100000011)))
(assert (fp.leq (fp #b1 #b10101010 #b1001110100111100110100100000011)
                expect
                (fp #b0 #b11110100 #b1101010110110011000000100101000)))

(assert (= expect result))

(check-sat)
(exit)
