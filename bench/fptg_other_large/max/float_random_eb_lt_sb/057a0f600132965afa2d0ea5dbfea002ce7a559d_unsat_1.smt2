(declare-const arg1 (_ FloatingPoint 9 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 15))
(assert (fp.leq (fp #b1 #b101000110 #b10100111000000)
                arg2
                (fp #b1 #b000110111 #b10000001010001)))
(assert (fp.leq (fp #b1 #b000110111 #b10000001010001)
                arg2
                (fp #b0 #b111000000 #b01111001001011)))

(declare-const result (_ FloatingPoint 9 15))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 15))
(assert (fp.leq (fp #b1 #b110111101 #b00101010100000)
                expect
                (fp #b1 #b000110111 #b10000001010001)))
(assert (fp.leq (fp #b1 #b000110111 #b10000001010001)
                expect
                (fp #b0 #b011111010 #b10100010100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
