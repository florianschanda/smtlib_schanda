(declare-const expect (_ FloatingPoint 10 26))
(assert (fp.leq (fp #b1 #b0111010011 #b1000101000010111010110001)
                expect
                (fp #b0 #b0000000000 #b1000100010100101100110010)))
(assert (fp.leq (fp #b0 #b0000000000 #b1000100010100101100110010)
                expect
                (fp #b0 #b0101011100 #b1011011001101011110001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
