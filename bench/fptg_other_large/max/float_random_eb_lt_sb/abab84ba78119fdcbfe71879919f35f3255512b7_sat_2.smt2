(declare-const expect (_ FloatingPoint 10 41))
(assert (fp.leq (fp #b1 #b1011001100 #b0111101111101100111110011001000110011000)
                expect
                (fp #b1 #b0111111111 #b1010010101101001000110101111000010011001)))
(assert (fp.leq (fp #b1 #b0111111111 #b1010010101101001000110101111000010011001)
                expect
                (fp #b0 #b1000011011 #b1101100000111001001101111110110111010010)))

(assert (= expect result))

