; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -ZERO

; Redundancy: True
; Validation for: MAX
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 17))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 17))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0010111001 #b1110000001110111)
                arg2
                (fp #b1 #b0000000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000000000000)
                arg2
                (fp #b0 #b0101100110 #b0011101001000000)))

(declare-const result (_ FloatingPoint 10 17))
(assert (= result (fp.max arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 17))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
