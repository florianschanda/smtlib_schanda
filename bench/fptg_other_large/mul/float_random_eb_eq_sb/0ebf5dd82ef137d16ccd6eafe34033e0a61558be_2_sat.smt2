(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0100101010110 #b000010000001)
                arg1
                (fp #b0 #b1000000001000 #b100100011000)))
(assert (fp.leq (fp #b0 #b1000000001000 #b100100011000)
                arg1
                (fp #b0 #b1100011110011 #b001011101011)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101001101101 #b100010101111)
                arg2
                (fp #b1 #b0111111111111 #b100101100010)))
(assert (fp.leq (fp #b1 #b0111111111111 #b100101100010)
                arg2
                (fp #b0 #b0011001000111 #b000011111101)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101001010001 #b011111010000)
                expect
                (fp #b1 #b1000000001001 #b001111101000)))
(assert (fp.leq (fp #b1 #b1000000001001 #b001111101000)
                expect
                (fp #b0 #b1110001011001 #b010001010000)))

(assert (= expect result))

(check-sat)
(exit)
