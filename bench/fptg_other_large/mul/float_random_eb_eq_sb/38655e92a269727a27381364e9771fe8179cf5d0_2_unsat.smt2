;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101110111 #b01101001)
                arg1
                (fp #b0 #b011111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111 #b11001001)
                arg1
                (fp #b0 #b110011101 #b01011101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101011 #b00111101)
                arg2
                (fp #b1 #b011111111 #b00010001)))
(assert (fp.leq (fp #b1 #b011111111 #b00010001)
                arg2
                (fp #b0 #b010011001 #b10001111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100010 #b11100100)
                expect
                (fp #b1 #b011111111 #b11101000)))
(assert (fp.leq (fp #b1 #b011111111 #b11101000)
                expect
                (fp #b1 #b011011100 #b10110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
