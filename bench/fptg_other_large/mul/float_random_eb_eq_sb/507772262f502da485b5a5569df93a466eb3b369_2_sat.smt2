; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100000110110100 #b110100010101100)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b0 #b0001001010000000 #b110111011101110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0111100001000100 #b001001101001100)
                arg2
                (fp #b0 #b1001100111011001 #b001111010110111)))
(assert (fp.leq (fp #b0 #b1001100111011001 #b001111010110111)
                arg2
                (fp #b0 #b1100010010001001 #b110000101011100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010000010000110 #b111000000111100)
                expect
                (fp #b1 #b1001100111011010 #b000111111111010)))
(assert (fp.leq (fp #b1 #b1001100111011010 #b000111111111010)
                expect
                (fp #b1 #b0110011111001101 #b111000010000101)))

(assert (= expect result))

(check-sat)
(exit)
