(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001111001 #b111001101)
                arg1
                (fp #b0 #b1001110010 #b011011010)))
(assert (fp.leq (fp #b0 #b1001110010 #b011011010)
                arg1
                (fp #b0 #b1010101101 #b111010011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1011101111 #b000010101)
                arg2
                (fp #b0 #b1100101101 #b000000001)))
(assert (fp.leq (fp #b0 #b1100101101 #b000000001)
                arg2
                (fp #b0 #b1110100001 #b011100000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000111101 #b011010110)
                expect
                (fp #b0 #b1110100000 #b011011100)))
(assert (fp.leq (fp #b0 #b1110100000 #b011011100)
                expect
                (fp #b0 #b1111010010 #b001000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
