                arg2
                (fp #b0 #b001110010 #b01010111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001110111 #b01011110)
                expect
                (fp #b0 #b101101000 #b10101011)))
(assert (fp.leq (fp #b0 #b101101000 #b10101011)
                expect
                (fp #b0 #b101110001 #b01100011)))

(assert (not (= expect result)))

(check-sat)
