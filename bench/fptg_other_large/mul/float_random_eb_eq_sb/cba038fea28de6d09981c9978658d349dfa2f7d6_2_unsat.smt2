(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100001001 #b100101011)
                arg1
                (fp #b1 #b0000001001 #b000100110)))
(assert (fp.leq (fp #b1 #b0000001001 #b000100110)
                arg1
                (fp #b0 #b0000100010 #b111000011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110111 #b001101100)
                arg2
                (fp #b1 #b1110100100 #b011110101)))
(assert (fp.leq (fp #b1 #b1110100100 #b011110101)
                arg2
                (fp #b0 #b1010101100 #b000001010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0110100011 #b101110000)
                expect
                (fp #b0 #b0110101110 #b100101110)))
(assert (fp.leq (fp #b0 #b0110101110 #b100101110)
                expect
                (fp #b0 #b1000100011 #b110100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
