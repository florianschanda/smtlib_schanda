                arg2
                (fp #b0 #b11010111010111 #b1100000011011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01000110110111 #b1100010111000)
                expect
                (fp #b1 #b00001000000100 #b0101001011000)))
(assert (fp.leq (fp #b1 #b00001000000100 #b0101001011000)
                expect
