(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001001101 #b1111101000)
                arg1
                (fp #b0 #b00000000000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001001100)
                arg1
                (fp #b0 #b01010100010 #b0110010001)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101000011 #b1010010110)
                arg2
                (fp #b1 #b00000000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000)
                arg2
                (fp #b0 #b00111101111 #b1101001000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101000011 #b1000100100)
                expect
                (fp #b1 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b11011010011 #b0100111001)))

(assert (= expect result))

(check-sat)
(exit)
