; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011100111 #b10010001100)
                arg1
                (fp #b0 #b011111111111 #b01110010110)))
(assert (fp.leq (fp #b0 #b011111111111 #b01110010110)
                arg1
                (fp #b0 #b101101110010 #b11001111110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111000101 #b10111010011)
                arg2
                (fp #b0 #b100000001000 #b10100111100)))
(assert (fp.leq (fp #b0 #b100000001000 #b10100111100)
                arg2
                (fp #b0 #b111010101110 #b11101111110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000110100000 #b11010110111)
                expect
                (fp #b0 #b100000001001 #b00110010110)))
(assert (fp.leq (fp #b0 #b100000001001 #b00110010110)
                expect
                (fp #b0 #b110110010000 #b00011100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
