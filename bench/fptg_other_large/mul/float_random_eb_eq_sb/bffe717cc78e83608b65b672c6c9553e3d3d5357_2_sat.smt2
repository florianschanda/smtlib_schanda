(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111101000 #b111111111)
                arg1
                (fp #b1 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b111111111)
                arg1
                (fp #b0 #b0100100111 #b011100011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101110000 #b011101011)
                arg2
                (fp #b0 #b0000000000 #b100001010)))
(assert (fp.leq (fp #b0 #b0000000000 #b100001010)
                arg2
                (fp #b0 #b0001010100 #b000111110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010101111 #b101111101)
                expect
                (fp #b1 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000001)
                expect
                (fp #b0 #b0101100100 #b010101101)))

(assert (= expect result))

(check-sat)
(exit)
