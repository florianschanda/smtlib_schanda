(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100000101110 #b1000000111100)
                arg1
                (fp #b1 #b10000000001100 #b0001100110010)))
(assert (fp.leq (fp #b1 #b10000000001100 #b0001100110010)
                arg1
                (fp #b0 #b00110100100100 #b1101100111000)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10010010011010 #b1101101110110)
                arg2
                (fp #b1 #b00000000000000 #b0011111001000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0011111001000)
                arg2
                (fp #b0 #b01100011010101 #b1000110101011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01000101000011 #b0000000100000)
                expect
                (fp #b0 #b00000000001100 #b0001000111011)))
(assert (fp.leq (fp #b0 #b00000000001100 #b0001000111011)
                expect
                (fp #b0 #b01000000101001 #b0010001101110)))

(assert (= expect result))

(check-sat)
(exit)
