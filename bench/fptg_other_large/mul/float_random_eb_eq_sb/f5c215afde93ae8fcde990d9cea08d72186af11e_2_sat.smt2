; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000010010 #b00000001)
                arg1
                (fp #b1 #b000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b000000001 #b00000000)
                arg1
                (fp #b0 #b010100110 #b01101110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011100100 #b01000011)
                arg2
                (fp #b0 #b001111100 #b00000000)))
(assert (fp.leq (fp #b0 #b001111100 #b00000000)
                arg2
                (fp #b0 #b100010011 #b11001100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101000101 #b11000111)
                expect
                (fp #b1 #b000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b000000000 #b00000001)
                expect
                (fp #b0 #b000100100 #b01100111)))

(assert (= expect result))

(check-sat)
(exit)
