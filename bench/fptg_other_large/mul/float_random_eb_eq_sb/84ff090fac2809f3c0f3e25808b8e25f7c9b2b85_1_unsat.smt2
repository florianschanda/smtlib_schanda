(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11001101101010 #b0001100010000)
                arg2
                (fp #b1 #b01111111111111 #b0100110110011)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0100110110011)
                arg2
                (fp #b0 #b01011000110001 #b1111010100010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
