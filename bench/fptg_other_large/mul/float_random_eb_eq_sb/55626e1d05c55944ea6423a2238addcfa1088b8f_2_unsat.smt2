; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110010010 #b110010010)
                arg1
                (fp #b1 #b1101101100 #b100010000)))
(assert (fp.leq (fp #b1 #b1101101100 #b100010000)
                arg1
                (fp #b1 #b0110000101 #b010010010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110101110 #b101110001)
                arg2
                (fp #b1 #b1010000101 #b111101000)))
(assert (fp.leq (fp #b1 #b1010000101 #b111101000)
                arg2
                (fp #b0 #b0010111101 #b010010101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110101000 #b111010111)
                expect
                (fp #b0 #b1111110011 #b011111110)))
(assert (fp.leq (fp #b0 #b1111110011 #b011111110)
                expect
                (fp #b0 #b1111111101 #b101110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
