;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111101011110 #b0111101011111)
                arg1
                (fp #b1 #b11111010101000 #b1111010011101)))
(assert (fp.leq (fp #b1 #b11111010101000 #b1111010011101)
                arg1
                (fp #b0 #b00011010011010 #b1001011000001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011100100000 #b1011010001011)
                arg2
                (fp #b1 #b10000000000100 #b1100100000000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b1100100000000)
                arg2
                (fp #b1 #b01111001110000 #b0111011111110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01111011100101 #b1010001100101)
                expect
                (fp #b0 #b11111010101110 #b1011111000011)))
(assert (fp.leq (fp #b0 #b11111010101110 #b1011111000011)
                expect
                (fp #b0 #b11111011111111 #b1011000010100)))

(assert (= expect result))

(check-sat)
(exit)
