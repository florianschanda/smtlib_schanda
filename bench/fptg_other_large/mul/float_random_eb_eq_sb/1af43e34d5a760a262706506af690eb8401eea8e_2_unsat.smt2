(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011001 #b01111111)
                arg1
                (fp #b1 #b101111110 #b11111111)))
(assert (fp.leq (fp #b1 #b101111110 #b11111111)
                arg1
                (fp #b1 #b001111010 #b10001001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100000 #b10100010)
                arg2
                (fp #b1 #b100000111 #b10010100)))
(assert (fp.leq (fp #b1 #b100000111 #b10010100)
                arg2
                (fp #b0 #b110100010 #b01111111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b101001011 #b00111100)
                expect
                (fp #b0 #b110000111 #b10010100)))
(assert (fp.leq (fp #b0 #b110000111 #b10010100)
                expect
                (fp #b0 #b111000100 #b11111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
