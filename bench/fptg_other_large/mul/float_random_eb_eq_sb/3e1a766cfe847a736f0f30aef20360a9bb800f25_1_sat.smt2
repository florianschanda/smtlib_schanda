; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101001111101 #b01000011110)
                arg1
                (fp #b1 #b100000001010 #b10010110001)))
(assert (fp.leq (fp #b1 #b100000001010 #b10010110001)
                arg1
                (fp #b0 #b001111110111 #b11110000101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010101110011 #b00011011101)
                arg2
                (fp #b0 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000001)
                arg2
                (fp #b0 #b110001100101 #b11010000100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011010100011 #b10101000000)
                expect
                (fp #b1 #b000000000001 #b10010110001)))
(assert (fp.leq (fp #b1 #b000000000001 #b10010110001)
                expect
                (fp #b0 #b011101100010 #b00100111100)))

(assert (= expect result))

(check-sat)
(exit)
