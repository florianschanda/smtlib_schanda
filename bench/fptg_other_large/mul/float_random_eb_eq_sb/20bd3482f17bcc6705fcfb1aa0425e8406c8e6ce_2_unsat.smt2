(assert (fp.leq (fp #b0 #b00000000000 #b0001110101)
                arg2
                (fp #b0 #b01110010000 #b0001011000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011000111 #b0110001001)
                expect
                (fp #b0 #b00000000000 #b0010111011)))
(assert (fp.leq (fp #b0 #b00000000000 #b0010111011)
                expect
                (fp #b0 #b01111011010 #b1110100101)))

(assert (not (= expect result)))

(check-sat)
