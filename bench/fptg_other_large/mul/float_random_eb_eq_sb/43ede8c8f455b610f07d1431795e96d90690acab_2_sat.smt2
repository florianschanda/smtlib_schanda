                arg2
                (fp #b0 #b00000000000 #b0001110101)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001110101)
                arg2
                (fp #b0 #b01111010100 #b0100111011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100010011 #b0011011000)
                expect
                (fp #b1 #b00011111110 #b0111011010)))
(assert (fp.leq (fp #b1 #b00011111110 #b0111011010)
                expect
                (fp #b0 #b01111001110 #b1011100101)))

(assert (= expect result))

(check-sat)
(exit)
