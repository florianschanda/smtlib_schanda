;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110000100 #b0110111101)
                arg1
                (fp #b1 #b10011111111 #b1001100110)))
(assert (fp.leq (fp #b1 #b10011111111 #b1001100110)
                arg1
                (fp #b1 #b00110111110 #b1111000100)))

