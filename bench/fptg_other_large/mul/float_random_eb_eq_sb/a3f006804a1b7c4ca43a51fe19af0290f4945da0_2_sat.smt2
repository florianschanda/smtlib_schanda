(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100010110 #b1110010100)
                arg1
                (fp #b1 #b01100100100 #b1111100011)))
(assert (fp.leq (fp #b1 #b01100100100 #b1111100011)
                arg1
                (fp #b0 #b01000011110 #b1100011010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11001110010 #b1000011100)
                arg2
                (fp #b1 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111)
                arg2
                (fp #b0 #b11011010100 #b1001101101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00110101000 #b1001000000)
                expect
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b00110110101 #b0001010110)))

(assert (= expect result))

(check-sat)
(exit)
