;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01011011011 #b1010010101)
                arg1
                (fp #b1 #b01000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000)
                arg1
                (fp #b0 #b00100001001 #b0000001001)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00001101101 #b1001010001)
                arg2
                (fp #b0 #b11111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100100100 #b1001011001)
                expect
                (fp #b1 #b10111111111 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111111111 #b1111111111)
                expect
                (fp #b0 #b01101010110 #b1011111010)))

(assert (= expect result))

(check-sat)
(exit)
