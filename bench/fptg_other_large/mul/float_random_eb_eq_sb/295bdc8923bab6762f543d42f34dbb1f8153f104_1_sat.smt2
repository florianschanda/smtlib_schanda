                arg2
                (fp #b1 #b0111111111111111 #b110011000011011)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110011000011011)
                arg2
                (fp #b1 #b0101101011011001 #b101101110000001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0111000111110011 #b011100100101111)
                expect
                (fp #b0 #b1010011110100001 #b000111001100101)))
(assert (fp.leq (fp #b0 #b1010011110100001 #b000111001100101)
                expect
                (fp #b0 #b1100000111001011 #b110101100101101)))

(assert (= expect result))

(check-sat)
(exit)
