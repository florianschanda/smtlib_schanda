(assert (fp.leq (fp #b1 #b0001011000100100 #b101101111111001)
                expect
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b0000001011101010 #b010100100000000)))

(assert (= expect result))

(check-sat)
