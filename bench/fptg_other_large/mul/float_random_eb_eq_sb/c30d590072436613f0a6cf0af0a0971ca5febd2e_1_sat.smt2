; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010010 #b01001110)
                arg1
                (fp #b1 #b101000011 #b10111100)))
(assert (fp.leq (fp #b1 #b101000011 #b10111100)
                arg1
                (fp #b0 #b001001111 #b01000100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111001 #b00101110)
                arg2
                (fp #b0 #b000001010 #b00011001)))
(assert (fp.leq (fp #b0 #b000001010 #b00011001)
                arg2
                (fp #b0 #b001111001 #b01101100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111011 #b00100110)
                expect
                (fp #b1 #b001001110 #b11100111)))
(assert (fp.leq (fp #b1 #b001001110 #b11100111)
                expect
                (fp #b0 #b000111000 #b11000111)))

(assert (= expect result))

(check-sat)
(exit)
