(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111110000 #b10110110)
                arg1
                (fp #b1 #b110101110 #b11110011)))
(assert (fp.leq (fp #b1 #b110101110 #b11110011)
                arg1
                (fp #b0 #b010100110 #b00010010)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010001110 #b01100011)
                arg2
                (fp #b0 #b101111010 #b00100100)))
(assert (fp.leq (fp #b0 #b101111010 #b00100100)
                arg2
                (fp #b0 #b111010100 #b01101001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                expect
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                expect
                (fp #b0 #b010001010 #b01111100)))

(assert (= expect result))

(check-sat)
(exit)
