; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101111010011111 #b11001101100010)
                arg1
                (fp #b0 #b101111100010110 #b10000010010110)))
(assert (fp.leq (fp #b0 #b101111100010110 #b10000010010110)
                arg1
                (fp #b0 #b111111011001011 #b00100010000101)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011001110000111 #b10110111001010)
                expect
                (fp #b0 #b111111000101110 #b00100011100010)))
(assert (fp.leq (fp #b0 #b111111000101110 #b00100011100010)
                expect
                (fp #b0 #b111111111010111 #b01100001110001)))

(assert (= expect result))

(check-sat)
(exit)
