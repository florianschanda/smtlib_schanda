(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11111010101011110 #b1011100010110110)
                arg1
                (fp #b0 #b01111111111111111 #b0100001101010000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b0100001101010000)
                arg1
                (fp #b0 #b10100100001101101 #b0101010000101101)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11010100100011111 #b0111000011011001)
                expect
                (fp #b1 #b01111111111111111 #b1001100001010010)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1001100001010010)
                expect
                (fp #b0 #b01011111101010101 #b0010010010010101)))

(assert (= expect result))

(check-sat)
(exit)
