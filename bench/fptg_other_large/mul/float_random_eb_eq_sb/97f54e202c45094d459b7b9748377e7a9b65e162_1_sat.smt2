(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110001110 #b1011111101)
                arg1
                (fp #b1 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b11101111001 #b0001111011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
