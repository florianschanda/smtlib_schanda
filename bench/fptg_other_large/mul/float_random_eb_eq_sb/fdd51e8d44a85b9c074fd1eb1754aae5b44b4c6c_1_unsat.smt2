; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00101010010 #b1010110011)
                arg1
                (fp #b0 #b11001001000 #b0001001110)))
(assert (fp.leq (fp #b0 #b11001001000 #b0001001110)
                arg1
                (fp #b0 #b11111011110 #b1001001110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01010101001 #b1100101111)
                arg2
                (fp #b0 #b01111111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b01111111111 #b0010110101)
                arg2
                (fp #b0 #b10100100000 #b1011010011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b11000011111 #b1101011000)
                expect
                (fp #b0 #b11001001000 #b0100010000)))
(assert (fp.leq (fp #b0 #b11001001000 #b0100010000)
                expect
                (fp #b0 #b11001001100 #b0000100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
