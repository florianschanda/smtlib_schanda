; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101001100 #b00100011)
                arg1
                (fp #b1 #b010101000 #b01111011)))
(assert (fp.leq (fp #b1 #b010101000 #b01111011)
                arg1
                (fp #b1 #b001101111 #b10000000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011000011 #b11011100)
                arg2
                (fp #b1 #b001010110 #b00101000)))
(assert (fp.leq (fp #b1 #b001010110 #b00101000)
                arg2
                (fp #b0 #b101000000 #b10010011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011110 #b10100000)
                expect
                (fp #b0 #b000000000 #b01101110)))
(assert (fp.leq (fp #b0 #b000000000 #b01101110)
                expect
                (fp #b0 #b101110111 #b10110011)))

(assert (not (= expect result)))

(check-sat)
(exit)
