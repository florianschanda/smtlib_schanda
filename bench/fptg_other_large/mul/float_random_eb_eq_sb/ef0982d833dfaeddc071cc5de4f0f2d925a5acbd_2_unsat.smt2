                arg2
                (fp #b0 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111111)
                arg2
                (fp #b0 #b1001001000 #b001010011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100101011 #b100100110)
                expect
                (fp #b0 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000001)
                expect
                (fp #b0 #b0011111010 #b110100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
