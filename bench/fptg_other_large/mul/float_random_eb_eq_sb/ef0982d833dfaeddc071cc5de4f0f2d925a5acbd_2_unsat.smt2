(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110111100 #b010010101)
                arg1
                (fp #b0 #b0000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b0000000000 #b111100110)
