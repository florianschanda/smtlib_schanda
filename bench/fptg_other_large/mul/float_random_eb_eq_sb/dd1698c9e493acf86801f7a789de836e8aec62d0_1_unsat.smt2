(assert (fp.leq (fp #b1 #b11010101001111 #b1110011001010)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b01110111110100 #b0100101011101)))

(assert (not (= expect result)))

