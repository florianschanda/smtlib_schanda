;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00010100101000 #b1001001101100)
                arg1
                (fp #b1 #b00000000000001 #b0000000000000)))
