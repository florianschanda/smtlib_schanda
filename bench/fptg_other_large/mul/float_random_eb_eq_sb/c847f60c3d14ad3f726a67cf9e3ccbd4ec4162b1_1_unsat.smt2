; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110010000100110 #b000010011001100)
                arg1
                (fp #b1 #b0000000000000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010010100000101)
                arg1
                (fp #b0 #b1000001011010000 #b001100010100001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000000)
                arg2
                (fp #b1 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111111)
                arg2
                (fp #b1 #b0110010110100000 #b000001000001010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010101010111111 #b011010001011011)
                expect
                (fp #b0 #b0111111111111111 #b001010000010011)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b001010000010011)
                expect
                (fp #b0 #b1110111010100011 #b011111011101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
