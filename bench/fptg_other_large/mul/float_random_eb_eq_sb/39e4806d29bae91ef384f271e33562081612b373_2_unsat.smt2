(assert (fp.leq (fp #b0 #b1000000000001011 #b111110110011000)
                arg2
                (fp #b0 #b1110010111100001 #b101110100100010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111001100 #b010100011111101)
                expect
                (fp #b1 #b1111001001000011 #b011001011010001)))
(assert (fp.leq (fp #b1 #b1111001001000011 #b011001011010001)
                expect
                (fp #b0 #b1011011000100101 #b011001000000111)))

(assert (not (= expect result)))

