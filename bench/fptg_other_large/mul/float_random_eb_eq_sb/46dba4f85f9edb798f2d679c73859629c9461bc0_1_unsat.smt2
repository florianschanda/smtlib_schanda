; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01111101000 #b1100101111)
                arg1
                (fp #b0 #b11010100000 #b0100011001)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011001)
                arg1
                (fp #b0 #b11011001010 #b1010001111)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101111111 #b0101101001)
                arg2
                (fp #b1 #b01000011101 #b0111100011)))
(assert (fp.leq (fp #b1 #b01000011101 #b0111100011)
                arg2
                (fp #b0 #b11001100110 #b0100010101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101100001 #b1100001110)
                expect
                (fp #b1 #b10010111110 #b1110000000)))
(assert (fp.leq (fp #b1 #b10010111110 #b1110000000)
                expect
                (fp #b0 #b01101111011 #b0101000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
