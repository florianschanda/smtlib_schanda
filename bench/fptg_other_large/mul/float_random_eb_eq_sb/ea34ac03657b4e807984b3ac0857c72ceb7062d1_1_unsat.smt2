(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111011010100 #b10100100100)
                arg1
                (fp #b1 #b110110011100 #b00111011110)))
(assert (fp.leq (fp #b1 #b110110011100 #b00111011110)
                arg1
                (fp #b0 #b110010010001 #b10100000100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110010000 #b10011000110)
                arg2
                (fp #b1 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b11111111111)
                arg2
                (fp #b1 #b010001000100 #b11010010000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011001110 #b00110001001)
                expect
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                expect
                (fp #b0 #b111111111111 #b00000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
