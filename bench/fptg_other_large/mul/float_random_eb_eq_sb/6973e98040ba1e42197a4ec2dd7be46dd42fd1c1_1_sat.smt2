; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101001111 #b100100111)
                arg1
                (fp #b1 #b1001110111 #b101110111)))
(assert (fp.leq (fp #b1 #b1001110111 #b101110111)
                arg1
                (fp #b0 #b1010011100 #b000111111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1111111101 #b010110001)
                arg2
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg2
                (fp #b0 #b0110101111 #b000001101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111000111 #b100001111)
                expect
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0000000110 #b110001010)))

(assert (= expect result))

(check-sat)
(exit)
