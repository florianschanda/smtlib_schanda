(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110101011 #b010000111)
                arg1
                (fp #b0 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111111)
                arg1
                (fp #b0 #b1001010100 #b101010101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001010101 #b001111000)
                arg2
                (fp #b1 #b0000000000 #b000001001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000001001)
                arg2
                (fp #b0 #b0000011111 #b100101101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110010101 #b111111101)
                expect
                (fp #b1 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000001)
                expect
                (fp #b0 #b1010001110 #b001110001)))

(assert (= expect result))

(check-sat)
(exit)
