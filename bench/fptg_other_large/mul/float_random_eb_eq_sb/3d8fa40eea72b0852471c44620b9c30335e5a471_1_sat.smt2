; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110010101 #b10011100101)
                arg1
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                arg1
                (fp #b1 #b000101000100 #b00110101100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110001100 #b10100010000)
                arg2
                (fp #b1 #b011111111111 #b01111111010)))
(assert (fp.leq (fp #b1 #b011111111111 #b01111111010)
                arg2
                (fp #b0 #b111010010001 #b10101111000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011100101010 #b10100110010)
                expect
                (fp #b0 #b011011010111 #b10001010000)))
(assert (fp.leq (fp #b0 #b011011010111 #b10001010000)
                expect
                (fp #b0 #b100000011111 #b00110000101)))

(assert (= expect result))

(check-sat)
(exit)
