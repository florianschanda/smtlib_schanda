(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000011000100 #b11110100010)
                arg1
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg1
                (fp #b0 #b101011111000 #b11000101101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b111010010010 #b11100110001)
                arg2
                (fp #b0 #b111110100111 #b00011101000)))
(assert (fp.leq (fp #b0 #b111110100111 #b00011101000)
                arg2
                (fp #b0 #b111111000011 #b11011111000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011111000010 #b11011111101)
                expect
                (fp #b1 #b011110101001 #b00011100111)))
(assert (fp.leq (fp #b1 #b011110101001 #b00011100111)
                expect
                (fp #b0 #b010011011001 #b00111001001)))

(assert (= expect result))

(check-sat)
(exit)
