;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11010000101010 #b1010001111010)
                arg1
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                arg1
                (fp #b0 #b11011001110010 #b0100010111011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00100001100001 #b0111001111101)
                arg2
                (fp #b0 #b10000110110110 #b0101110110001)))
(assert (fp.leq (fp #b0 #b10000110110110 #b0101110110001)
                arg2
                (fp #b0 #b10011101100010 #b0111111111101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11000110000100 #b0011011001010)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b10100100010011 #b1000001011100)))

(assert (= expect result))

(check-sat)
(exit)
