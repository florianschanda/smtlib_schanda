;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11100110011 #b1110010001)
                arg1
                (fp #b1 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b00101111111 #b1011001010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000111010 #b1000110000)
                arg2
                (fp #b1 #b01111111111 #b0011111110)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011111110)
                arg2
                (fp #b0 #b10110010011 #b1100010101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100011001 #b1010010100)
                expect
                (fp #b0 #b00000000001 #b0011111101)))
(assert (fp.leq (fp #b0 #b00000000001 #b0011111101)
                expect
                (fp #b0 #b00101010000 #b1100000111)))

(assert (= expect result))

(check-sat)
(exit)
