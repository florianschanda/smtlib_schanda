(assert (fp.leq (fp #b0 #b0000000000000000 #b111111111111111)
                arg2
                (fp #b0 #b0101101001110100 #b110101101001001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101000011110010 #b000101000100010)
                expect
                (fp #b0 #b0001111110100011 #b101000110011010)))
(assert (fp.leq (fp #b0 #b0001111110100011 #b101000110011010)
                expect
                (fp #b0 #b0110000000111110 #b011100100110000)))

(assert (= expect result))

(check-sat)
