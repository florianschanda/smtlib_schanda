                arg2
                (fp #b0 #b001011001011 #b00011010011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101000111011 #b10010010111)
                expect
                (fp #b1 #b001001000000 #b10000011110)))
(assert (fp.leq (fp #b1 #b001001000000 #b10000011110)
                expect
                (fp #b0 #b010101001000 #b00100001100)))

(assert (not (= expect result)))

