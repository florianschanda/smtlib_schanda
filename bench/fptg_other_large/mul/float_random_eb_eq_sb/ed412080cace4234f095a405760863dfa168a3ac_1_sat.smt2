(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111001100 #b111010101)
                arg1
                (fp #b1 #b1100001001 #b011011011)))
(assert (fp.leq (fp #b1 #b1100001001 #b011011011)
                arg1
                (fp #b1 #b0101010000 #b010100110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0010010100 #b011000100)
                arg2
                (fp #b0 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111011 #b011010100)
                arg2
                (fp #b0 #b0111111100 #b100001010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001101110 #b110110111)
                expect
                (fp #b1 #b1000000110 #b000000100)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000100)
                expect
                (fp #b1 #b0111110010 #b010100001)))

(assert (= expect result))

(check-sat)
(exit)
