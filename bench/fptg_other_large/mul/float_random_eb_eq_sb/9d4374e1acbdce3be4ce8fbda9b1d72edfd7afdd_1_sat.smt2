;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1110111001000 #b110110100011)
                arg1
                (fp #b1 #b1011101011000 #b100011101100)))
(assert (fp.leq (fp #b1 #b1011101011000 #b100011101100)
                arg1
                (fp #b1 #b1000111101110 #b000111001000)))

