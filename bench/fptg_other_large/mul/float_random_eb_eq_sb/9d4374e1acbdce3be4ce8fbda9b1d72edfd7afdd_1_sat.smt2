                arg2
                (fp #b0 #b1000000001010 #b100110101010)))
(assert (fp.leq (fp #b0 #b1000000001010 #b100110101010)
                arg2
                (fp #b0 #b1010111000000 #b010011011010)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1101010001001 #b010100010110)
                expect
                (fp #b1 #b1011101100100 #b001111111100)))
(assert (fp.leq (fp #b1 #b1011101100100 #b001111111100)
                expect
                (fp #b1 #b1011010111101 #b110100001100)))

(assert (= expect result))

(check-sat)
(exit)
