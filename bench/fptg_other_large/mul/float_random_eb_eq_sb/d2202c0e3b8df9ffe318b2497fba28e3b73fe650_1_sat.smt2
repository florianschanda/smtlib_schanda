; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011000110001 #b0110010111010)
                arg1
                (fp #b1 #b10000000001100 #b1111100010101)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1111100010101)
                arg1
                (fp #b0 #b11100001010000 #b1101011000011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000101101111 #b0010000110011)
                arg2
                (fp #b1 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b1 #b00111111111001 #b0110101000001)
                arg2
                (fp #b0 #b00110101010111 #b0101111011011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010000000010 #b0100110100110)
                expect
                (fp #b0 #b01000000000111 #b0110010011010)))
(assert (fp.leq (fp #b0 #b01000000000111 #b0110010011010)
                expect
                (fp #b0 #b10110011110010 #b1001000001101)))

(assert (= expect result))

(check-sat)
(exit)
