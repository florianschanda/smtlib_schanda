(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010101001011001 #b10010111001101)
                arg1
                (fp #b1 #b000000000000000 #b00111010110000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00111010110000)
                arg1
                (fp #b0 #b101001111100111 #b10011101110110)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100111011111110 #b00111101011011)
                arg2
                (fp #b1 #b000000000000000 #b00000000000001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000001)
                arg2
                (fp #b0 #b100000100111001 #b00001000010011)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100001111101000 #b10101101111001)
                expect
                (fp #b0 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b001110100001011 #b10000001011001)))

(assert (= expect result))

(check-sat)
(exit)
