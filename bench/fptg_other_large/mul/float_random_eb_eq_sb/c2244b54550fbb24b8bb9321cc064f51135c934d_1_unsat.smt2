;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10000101100110000 #b0101001011010110)
                arg1
                (fp #b1 #b01111111111111111 #b1110010001100101)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1110010001100101)
                arg1
                (fp #b0 #b00110110111011110 #b0110011111000111)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b0 #b00110110101101101 #b1001011011010110)
                expect
                (fp #b0 #b10000000000000000 #b1100101001000111)))
(assert (fp.leq (fp #b0 #b10000000000000000 #b1100101001000111)
                expect
                (fp #b0 #b10110100010001010 #b0001101111010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
