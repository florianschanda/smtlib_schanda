                arg2
                (fp #b1 #b01100100011101 #b1110110001100)))
(assert (fp.leq (fp #b1 #b01100100011101 #b1110110001100)
                arg2
                (fp #b0 #b10011010011111 #b0001101101101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100111010110 #b1101001001000)
                expect
                (fp #b1 #b10100000000101 #b0010001001111)))
(assert (fp.leq (fp #b1 #b10100000000101 #b0010001001111)
                expect
                (fp #b1 #b01111110111100 #b0000011000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
