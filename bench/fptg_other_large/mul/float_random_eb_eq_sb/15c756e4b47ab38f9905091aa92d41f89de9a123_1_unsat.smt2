;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11001100000000 #b1001010010001)
                arg1
                (fp #b0 #b10111011100110 #b0010111000010)))
(assert (fp.leq (fp #b0 #b10111011100110 #b0010111000010)
                arg1
                (fp #b0 #b11111110000000 #b1101000011101)))

(declare-const arg2 (_ FloatingPoint 14 14))
