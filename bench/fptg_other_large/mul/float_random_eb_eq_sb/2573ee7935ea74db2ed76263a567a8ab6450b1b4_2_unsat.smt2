; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011101101011 #b0101001100011)
                arg1
                (fp #b1 #b10000000001100 #b1111100010101)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1111100010101)
                arg1
                (fp #b0 #b11010100001101 #b0101000011010)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b00101101111011 #b0101000010011)
                arg2
                (fp #b0 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b0 #b00111111111001 #b0110101000001)
                arg2
                (fp #b0 #b10100011010111 #b0011001101001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100101101001 #b0110001000010)
                expect
                (fp #b1 #b01000000000111 #b0110010011011)))
(assert (fp.leq (fp #b1 #b01000000000111 #b0110010011011)
                expect
                (fp #b1 #b00111101011110 #b1101111010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
