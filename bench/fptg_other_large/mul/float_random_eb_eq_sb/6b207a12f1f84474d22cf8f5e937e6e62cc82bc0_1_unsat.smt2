(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0000000101111110 #b000110001011110)
                arg1
                (fp #b0 #b1000000000001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b000110010000101)
                arg1
                (fp #b0 #b1100011111001100 #b001101010101110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101010111100100 #b101000111100111)
                expect
                (fp #b0 #b1000000000011101 #b001101001000011)))
(assert (fp.leq (fp #b0 #b1000000000011101 #b001101001000011)
                expect
                (fp #b0 #b1101111100101110 #b000110011110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
