                (fp #b0 #b011111111111 #b00000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b00000000000)
                arg2
                (fp #b0 #b111100100111 #b10101101000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101000100011 #b00000001001)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b111111101111 #b00100110110)))

(assert (= expect result))

(check-sat)
