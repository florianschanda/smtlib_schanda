                (fp #b0 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b0 #b00111111111001 #b0110101000001)
                arg2
                (fp #b0 #b01000110111011 #b1001000111100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10101111101100 #b0101101101110)
                expect
                (fp #b1 #b01100101101001 #b0010100101100)))
(assert (fp.leq (fp #b1 #b01100101101001 #b0010100101100)
                expect
                (fp #b0 #b01000100100101 #b0010011101101)))

(assert (= expect result))

(check-sat)
