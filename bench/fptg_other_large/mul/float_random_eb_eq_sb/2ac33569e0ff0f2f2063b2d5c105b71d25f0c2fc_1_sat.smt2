                arg2
                (fp #b0 #b11010101110000 #b0100011011100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11110100001111 #b0010110010010)
                expect
                (fp #b1 #b00011110000001 #b1111011010110)))
(assert (fp.leq (fp #b1 #b00011110000001 #b1111011010110)
                expect
                (fp #b0 #b10001000000101 #b1001101010111)))

(assert (= expect result))

(check-sat)
