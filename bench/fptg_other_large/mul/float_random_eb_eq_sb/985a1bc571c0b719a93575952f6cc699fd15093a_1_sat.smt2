(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111011100010001 #b100000011001110)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b1 #b0001011101100010 #b001000000001110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0010001010100000 #b001001000011010)
                arg2
                (fp #b0 #b1011010110011111 #b101101010110110)))
(assert (fp.leq (fp #b0 #b1011010110011111 #b101101010110110)
                arg2
                (fp #b0 #b1110101111101100 #b010000011000000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111001100101010 #b000110000110001)
                expect
                (fp #b1 #b1011010110100000 #b100011001100110)))
(assert (fp.leq (fp #b1 #b1011010110100000 #b100011001100110)
                expect
                (fp #b1 #b0100000101110010 #b100100111000111)))

(assert (= expect result))

(check-sat)
(exit)
