                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b0 #b1100101110100100 #b011111010111010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0010001111101000 #b000110000010001)
                expect
                (fp #b0 #b1001001101001011 #b110101000110011)))
(assert (fp.leq (fp #b0 #b1001001101001011 #b110101000110011)
                expect
                (fp #b0 #b1111010001101101 #b000000010101111)))

(assert (= expect result))

(check-sat)
(exit)
