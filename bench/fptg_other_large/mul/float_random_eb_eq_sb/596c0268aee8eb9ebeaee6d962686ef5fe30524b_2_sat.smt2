                (fp #b0 #b0100110010000 #b011111000010)))
(assert (fp.leq (fp #b0 #b0100110010000 #b011111000010)
                arg2
                (fp #b0 #b0101110101110 #b111110001010)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0101010111101 #b000001110110)
                expect
                (fp #b0 #b0101101011010 #b000010000111)))
(assert (fp.leq (fp #b0 #b0101101011010 #b000010000111)
                expect
                (fp #b0 #b1110011110001 #b000101000110)))

(assert (= expect result))

(check-sat)
(exit)
