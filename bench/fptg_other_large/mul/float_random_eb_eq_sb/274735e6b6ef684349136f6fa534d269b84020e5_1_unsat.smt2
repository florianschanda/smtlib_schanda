(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010001110 #b11111001)
                arg1
                (fp #b1 #b000000000 #b00010111)))
(assert (fp.leq (fp #b1 #b000000000 #b00010111)
                arg1
                (fp #b0 #b010011000 #b10011110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010111 #b01101000)
                arg2
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg2
                (fp #b0 #b001111101 #b10000001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111011001 #b01000110)
                expect
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                expect
                (fp #b0 #b010110111 #b01110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
