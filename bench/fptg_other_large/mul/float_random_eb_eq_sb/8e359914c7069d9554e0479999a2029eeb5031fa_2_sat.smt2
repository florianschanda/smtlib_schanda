(assert (fp.leq (fp #b1 #b00000000000000000 #b1111111111111111)
                arg2
                (fp #b0 #b01000001000001100 #b1101101000111101)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10101110011000110 #b0110111011110111)
                expect
                (fp #b0 #b00000000000010001 #b1111110001110100)))
(assert (fp.leq (fp #b0 #b00000000000010001 #b1111110001110100)
                expect
                (fp #b0 #b10010010100100010 #b1000001010001001)))

(assert (= expect result))

(check-sat)
