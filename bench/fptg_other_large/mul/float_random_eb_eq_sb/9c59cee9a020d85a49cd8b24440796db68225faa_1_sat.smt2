(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000101111010 #b01111101110)
                arg1
                (fp #b0 #b011111111111 #b10010001101)))
(assert (fp.leq (fp #b0 #b011111111111 #b10010001101)
                arg1
                (fp #b0 #b110001110011 #b10110111111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010100110011 #b00010001010)
                expect
                (fp #b0 #b100000000000 #b00111011000)))
(assert (fp.leq (fp #b0 #b100000000000 #b00111011000)
                expect
                (fp #b0 #b101101101010 #b10010011111)))

(assert (= expect result))

(check-sat)
(exit)
