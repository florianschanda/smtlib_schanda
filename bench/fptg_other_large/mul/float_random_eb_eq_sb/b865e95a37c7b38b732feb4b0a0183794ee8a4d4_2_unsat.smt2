; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111101011 #b00101100100)
                arg1
                (fp #b1 #b110100111101 #b10101101000)))
(assert (fp.leq (fp #b1 #b110100111101 #b10101101000)
                arg1
                (fp #b0 #b101010101100 #b00100000010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011100010001 #b10011100100)
                arg2
                (fp #b1 #b000000000000 #b01101101001)))
(assert (fp.leq (fp #b1 #b000000000000 #b01101101001)
                arg2
                (fp #b0 #b110111100010 #b11010010101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011101001 #b00110011011)
                expect
                (fp #b0 #b010100111110 #b01101101110)))
(assert (fp.leq (fp #b0 #b010100111110 #b01101101110)
                expect
                (fp #b0 #b110011110110 #b10101100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
