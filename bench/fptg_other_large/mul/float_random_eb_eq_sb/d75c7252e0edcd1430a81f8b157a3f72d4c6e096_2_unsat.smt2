; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001000 #b01111110)
                arg1
                (fp #b0 #b000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b000000000 #b01010111)
                arg1
                (fp #b0 #b001101011 #b11011011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010001 #b01011001)
                arg2
                (fp #b1 #b101001011 #b00101100)))
(assert (fp.leq (fp #b1 #b101001011 #b00101100)
                arg2
                (fp #b0 #b100000110 #b10111000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110100011 #b11001110)
                expect
                (fp #b1 #b001001011 #b10011000)))
(assert (fp.leq (fp #b1 #b001001011 #b10011000)
                expect
                (fp #b0 #b101101011 #b01011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
