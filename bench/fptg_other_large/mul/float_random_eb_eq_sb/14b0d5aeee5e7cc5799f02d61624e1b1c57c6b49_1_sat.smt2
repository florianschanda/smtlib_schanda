(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111011101100010 #b111100011011110)
                arg1
                (fp #b1 #b1111001000110110 #b011010010000011)))
(assert (fp.leq (fp #b1 #b1111001000110110 #b011010010000011)
                arg1
                (fp #b0 #b0000100111011101 #b001101110111000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b1011101110001000 #b101010101101101)
                arg2
                (fp #b0 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000000)
                expect
                (fp #b1 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111111)
                expect
                (fp #b1 #b1011000110010100 #b110010101101011)))

(assert (= expect result))

(check-sat)
(exit)
