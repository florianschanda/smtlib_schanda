(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000001100 #b00111100)
                arg1
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg1
                (fp #b0 #b010001111 #b01110110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011000 #b00011000)
                arg2
                (fp #b1 #b100000111 #b11010011)))
(assert (fp.leq (fp #b1 #b100000111 #b11010011)
                arg2
                (fp #b0 #b011110011 #b10111111)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110001111 #b11101010)
                expect
                (fp #b1 #b000000111 #b11010011)))
(assert (fp.leq (fp #b1 #b000000111 #b11010011)
                expect
                (fp #b0 #b010000010 #b00000101)))

(assert (= expect result))

(check-sat)
(exit)
