(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b001111011110 #b01101000100)
                arg1
                (fp #b0 #b011111111111 #b01110010110)))
(assert (fp.leq (fp #b0 #b011111111111 #b01110010110)
                arg1
                (fp #b0 #b101000001011 #b11010010110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001001010101 #b01111111101)
                arg2
                (fp #b0 #b000000000000 #b10100101001)))
(assert (fp.leq (fp #b0 #b000000000000 #b10100101001)
                arg2
                (fp #b0 #b001101100111 #b01111000011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100000110 #b11101100111)
                expect
                (fp #b0 #b000000000000 #b11101111001)))
(assert (fp.leq (fp #b0 #b000000000000 #b11101111001)
                expect
                (fp #b0 #b011101001110 #b00111010000)))

(assert (= expect result))

(check-sat)
(exit)
