(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101110111110 #b1001101000010)
                arg1
                (fp #b1 #b01111111111111 #b0111100000110)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0111100000110)
                arg1
                (fp #b0 #b01111101011110 #b1101111010111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b00101111110001 #b0000010110100)
                expect
                (fp #b0 #b10000000000000 #b0001010001100)))
(assert (fp.leq (fp #b0 #b10000000000000 #b0001010001100)
                expect
                (fp #b0 #b10001101001110 #b0111100101010)))

(assert (= expect result))

(check-sat)
(exit)
