; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b011011010100 #b00011100000)
                arg1
                (fp #b0 #b101000111000 #b00001000010)))
(assert (fp.leq (fp #b0 #b101000111000 #b00001000010)
                arg1
                (fp #b0 #b101100101110 #b11000101100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101110111 #b00000000100)
                arg2
                (fp #b1 #b100000110101 #b00101100111)))
(assert (fp.leq (fp #b1 #b100000110101 #b00101100111)
                arg2
                (fp #b1 #b011100011001 #b01100011110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101101000100 #b00000101010)
                expect
                (fp #b1 #b101001101110 #b00110110100)))
(assert (fp.leq (fp #b1 #b101001101110 #b00110110100)
                expect
                (fp #b1 #b010010001010 #b10110010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
