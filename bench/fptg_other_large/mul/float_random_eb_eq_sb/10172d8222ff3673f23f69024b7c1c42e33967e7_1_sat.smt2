; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ONE
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011010100 #b110011000)
                arg1
                (fp #b1 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111 #b000000000)
                arg1
                (fp #b0 #b0000110101 #b011111011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001001001 #b011000000)
                arg2
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                arg2
                (fp #b1 #b0011011001 #b010000000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011100 #b111011101)
                expect
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                expect
                (fp #b0 #b1000011011 #b110101011)))

(assert (= expect result))

(check-sat)
(exit)
