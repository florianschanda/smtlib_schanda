                arg2
                (fp #b1 #b10000000000100 #b1100100000000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b1100100000000)
                arg2
                (fp #b1 #b00110111101010 #b0001011100101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10101110011110 #b1101011000011)
                expect
                (fp #b1 #b01010100100100 #b1001011010101)))
(assert (fp.leq (fp #b1 #b01010100100100 #b1001011010101)
                expect
                (fp #b0 #b10110000100110 #b1010011010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
