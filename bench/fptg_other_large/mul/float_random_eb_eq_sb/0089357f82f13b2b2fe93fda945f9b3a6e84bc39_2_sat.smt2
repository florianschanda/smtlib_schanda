(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001000100101 #b01011001100)
                arg1
                (fp #b0 #b100000001010 #b10001010101)))
(assert (fp.leq (fp #b0 #b100000001010 #b10001010101)
                arg1
                (fp #b0 #b111001100010 #b00110011110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101111010001 #b00011001110)
                arg2
                (fp #b1 #b101001111100 #b10100010001)))
(assert (fp.leq (fp #b1 #b101001111100 #b10100010001)
                arg2
                (fp #b1 #b001011101101 #b00011000100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110110011000 #b10101000100)
                expect
                (fp #b1 #b101010001000 #b01000010011)))
(assert (fp.leq (fp #b1 #b101010001000 #b01000010011)
                expect
                (fp #b1 #b000000100101 #b00001110101)))

(assert (= expect result))

(check-sat)
(exit)
