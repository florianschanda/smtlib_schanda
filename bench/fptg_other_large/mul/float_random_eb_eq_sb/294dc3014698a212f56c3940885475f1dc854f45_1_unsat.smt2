; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110110 #b001101000)
                arg1
                (fp #b1 #b1100001001 #b011011011)))
(assert (fp.leq (fp #b1 #b1100001001 #b011011011)
                arg1
                (fp #b0 #b1011110100 #b101110101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001000001 #b000101100)
                arg2
                (fp #b1 #b1000000111 #b001100100)))
(assert (fp.leq (fp #b1 #b1000000111 #b001100100)
                arg2
                (fp #b0 #b1011011001 #b010010000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011000 #b010101100)
                expect
                (fp #b0 #b1100010001 #b101101001)))
(assert (fp.leq (fp #b0 #b1100010001 #b101101001)
                expect
                (fp #b0 #b1110001100 #b011111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
