; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010011010010 #b1000100010100)
                arg1
                (fp #b1 #b01001010110101 #b1001010010001)))
(assert (fp.leq (fp #b1 #b01001010110101 #b1001010010001)
                arg1
                (fp #b0 #b00010011100110 #b0000001010101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00010000010111 #b1110110001001)
                arg2
                (fp #b1 #b00000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111000000111)
                arg2
                (fp #b0 #b11110000110011 #b0101010001010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01100000100001 #b1100001001000)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b01001001100100 #b1101010010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
