(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110000001110010 #b10110101110110)
                arg1
                (fp #b1 #b100000100101000 #b00100010100001)))
(assert (fp.leq (fp #b1 #b100000100101000 #b00100010100001)
                arg1
                (fp #b1 #b001101100101010 #b11111000000101)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b001010110111001 #b00101010011011)
                expect
                (fp #b0 #b100001001010001 #b01001001101011)))
(assert (fp.leq (fp #b0 #b100001001010001 #b01001001101011)
                expect
                (fp #b0 #b110010100011110 #b11111011000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
