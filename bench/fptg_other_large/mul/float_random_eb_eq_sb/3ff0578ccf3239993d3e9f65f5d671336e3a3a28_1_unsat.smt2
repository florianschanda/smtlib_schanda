; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011100100011011 #b11010000111001)
                arg1
                (fp #b1 #b000000001011101 #b10111000000011)))
(assert (fp.leq (fp #b1 #b000000001011101 #b10111000000011)
                arg1
                (fp #b0 #b100110100101010 #b11011001011111)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b010111000010111 #b10111111011000)
                arg2
                (fp #b0 #b111001110110110 #b01111010111101)))
(assert (fp.leq (fp #b0 #b111001110110110 #b01111010111101)
                arg2
                (fp #b0 #b111011101001110 #b01001000101010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101010100011000 #b00110011111111)
                expect
                (fp #b1 #b011010000010101 #b01000101101100)))
(assert (fp.leq (fp #b1 #b011010000010101 #b01000101101100)
                expect
                (fp #b0 #b011100010000111 #b11011001010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
