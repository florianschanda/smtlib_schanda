; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011111001100000 #b11011110000001)
                arg1
                (fp #b1 #b000000000000000 #b11111111111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11111111111111)
                arg1
                (fp #b0 #b011100101111100 #b00001001000100)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b011010011010000 #b11101101111101)
                arg2
                (fp #b0 #b110101101000010 #b01101010111010)))
(assert (fp.leq (fp #b0 #b110101101000010 #b01101010111010)
                arg2
                (fp #b0 #b111111011101111 #b11100000111111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101101100010001 #b11101001111111)
                expect
                (fp #b1 #b010101101000100 #b01101010111001)))
(assert (fp.leq (fp #b1 #b010101101000100 #b01101010111001)
                expect
                (fp #b0 #b000101010001111 #b11000101011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
