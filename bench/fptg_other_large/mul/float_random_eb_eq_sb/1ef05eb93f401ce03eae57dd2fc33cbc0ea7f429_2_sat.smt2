; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b010111110101111 #b00011000111000)
                arg1
                (fp #b0 #b111111101001001 #b01000110100101)))
(assert (fp.leq (fp #b0 #b111111101001001 #b01000110100101)
                arg1
                (fp #b0 #b111111111001011 #b10101100110110)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111010010110111 #b10001011000100)
                arg2
                (fp #b1 #b100000000001011 #b11001101101000)))
(assert (fp.leq (fp #b1 #b100000000001011 #b11001101101000)
                arg2
                (fp #b0 #b110011101110010 #b01100100001100)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111001100 #b10110000100000)
                expect
                (fp #b1 #b111111101010110 #b00100110011101)))
(assert (fp.leq (fp #b1 #b111111101010110 #b00100110011101)
                expect
                (fp #b1 #b111001111011101 #b10110000001100)))

(assert (= expect result))

(check-sat)
(exit)
