;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101101011100 #b00011100111)
                arg1
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                arg1
                (fp #b0 #b110101011001 #b01101010011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110111101111 #b11010011001)
                arg2
                (fp #b1 #b110001100101 #b10101001100)))
(assert (fp.leq (fp #b1 #b110001100101 #b10101001100)
                arg2
                (fp #b1 #b010111011101 #b01001111101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100110101000 #b10101010100)
                expect
                (fp #b1 #b100001100001 #b00101100111)))
(assert (fp.leq (fp #b1 #b100001100001 #b00101100111)
                expect
                (fp #b1 #b010101011010 #b00110111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
