(assert (fp.leq (fp #b0 #b0111111111 #b111110111)
                arg2
                (fp #b0 #b1011000011 #b111011011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101100010 #b100010001)
                expect
                (fp #b1 #b1001111000 #b101110000)))
(assert (fp.leq (fp #b1 #b1001111000 #b101110000)
                expect
                (fp #b1 #b0101101111 #b010111010)))

(assert (not (= expect result)))

(check-sat)
