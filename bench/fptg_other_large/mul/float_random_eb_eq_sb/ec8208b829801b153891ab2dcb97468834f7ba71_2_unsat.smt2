(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b11110011)
                arg1
                (fp #b1 #b001111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111100 #b00000000)
                arg1
                (fp #b0 #b101011111 #b00111100)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110011 #b11111110)
                arg2
                (fp #b0 #b000011101 #b00011110)))
(assert (fp.leq (fp #b0 #b000011101 #b00011110)
                arg2
                (fp #b0 #b010111000 #b11100011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001100 #b00010000)
                expect
                (fp #b1 #b000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b000000000 #b00000001)
                expect
                (fp #b0 #b111110111 #b01110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
