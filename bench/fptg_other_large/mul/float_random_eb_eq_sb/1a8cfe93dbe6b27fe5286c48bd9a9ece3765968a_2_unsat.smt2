(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111100 #b110101001)
                arg1
                (fp #b1 #b1001110111 #b101110111)))
(assert (fp.leq (fp #b1 #b1001110111 #b101110111)
                arg1
                (fp #b0 #b1001000101 #b110101101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110011111 #b010000000)
                arg2
                (fp #b1 #b1101111100 #b101100010)))
(assert (fp.leq (fp #b1 #b1101111100 #b101100010)
                arg2
                (fp #b0 #b1100111110 #b011011000)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101111001 #b000001001)
                expect
                (fp #b0 #b1111110101 #b011101111)))
(assert (fp.leq (fp #b0 #b1111110101 #b011101111)
                expect
                (fp #b0 #b1111111010 #b101011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
