(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101010001 #b11010010)
                arg1
                (fp #b1 #b100010111 #b00001101)))
(assert (fp.leq (fp #b1 #b100010111 #b00001101)
                arg1
                (fp #b1 #b010001011 #b01110110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010000 #b00110010)
                arg2
                (fp #b0 #b000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b000000000 #b00111011)
                arg2
                (fp #b0 #b111010110 #b11001011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101100010 #b11000101)
                expect
                (fp #b1 #b000010110 #b11101111)))
(assert (fp.leq (fp #b1 #b000010110 #b11101111)
                expect
                (fp #b0 #b111011101 #b01100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
