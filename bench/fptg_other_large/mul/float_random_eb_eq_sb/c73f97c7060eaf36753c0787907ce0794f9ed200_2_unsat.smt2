; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010001100111111 #b01001110001100)
                arg1
                (fp #b0 #b000101000010110 #b10000100101110)))
(assert (fp.leq (fp #b0 #b000101000010110 #b10000100101110)
                arg1
                (fp #b0 #b100110101111101 #b10001100111101)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110000010010011 #b00101110011110)
                arg2
                (fp #b1 #b000000000000001 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b00000000000000)
                arg2
                (fp #b0 #b011101011111000 #b11011101111111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b011010110110000 #b11101110010110)
                expect
                (fp #b1 #b000000000000000 #b00000000000001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000001)
                expect
                (fp #b0 #b111100100101111 #b11111111011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
