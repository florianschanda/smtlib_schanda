;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111111 #b00000000000000)
                arg1
                (fp #b1 #b111111111111110 #b11111111111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b11111111111111)
                arg1
                (fp #b0 #b100000010010000 #b00100010011001)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111111111110 #b00000011011001)
                arg2
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b010011001010111 #b11101001110111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b011001110101110 #b10000110101000)
                expect
                (fp #b0 #b011111111111111 #b11011101001011)))
(assert (fp.leq (fp #b0 #b011111111111111 #b11011101001011)
                expect
                (fp #b0 #b101100011010101 #b11011000010000)))

(assert (= expect result))

(check-sat)
(exit)
