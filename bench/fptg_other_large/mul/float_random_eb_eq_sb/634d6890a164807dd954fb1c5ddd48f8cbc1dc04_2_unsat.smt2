                (fp #b0 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b1111111111111)
                arg2
                (fp #b0 #b11111010001100 #b0000110110100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
