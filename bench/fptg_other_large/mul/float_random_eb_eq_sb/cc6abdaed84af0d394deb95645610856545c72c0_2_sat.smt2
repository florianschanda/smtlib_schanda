;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110101010001011 #b10010101010000)
                arg1
                (fp #b1 #b101110111000001 #b01000011110110)))
(assert (fp.leq (fp #b1 #b101110111000001 #b01000011110110)
                arg1
                (fp #b0 #b111010000000011 #b01100001011111)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110000110000100 #b01110011100100)
                arg2
                (fp #b0 #b100000000001100 #b01001010010010)))
(assert (fp.leq (fp #b0 #b100000000001100 #b01001010010010)
                arg2
                (fp #b0 #b101010111001000 #b10001011010111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110000001010000 #b00111111111010)
                expect
                (fp #b1 #b101110111001110 #b10100001110100)))
(assert (fp.leq (fp #b1 #b101110111001110 #b10100001110100)
                expect
                (fp #b0 #b000100100000010 #b11001000001010)))

(assert (= expect result))

(check-sat)
(exit)
