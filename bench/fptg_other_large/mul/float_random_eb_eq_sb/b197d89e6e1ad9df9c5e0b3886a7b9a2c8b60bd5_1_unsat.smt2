                arg2
                (fp #b0 #b010100010111 #b00110011000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010101010001 #b10000011001)
                expect
                (fp #b0 #b010110100101 #b11011001001)))
(assert (fp.leq (fp #b0 #b010110100101 #b11011001001)
                expect
                (fp #b0 #b101001011111 #b10100010000)))

(assert (not (= expect result)))

