; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b0 #b10001101001001110 #b1010101111010100)
                arg1
                (fp #b0 #b11010000001011000 #b0010010010001100)))
(assert (fp.leq (fp #b0 #b11010000001011000 #b0010010010001100)
                arg1
                (fp #b0 #b11101001001111010 #b0001000111101000)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b00011111000011000 #b1011100011100001)
                arg2
                (fp #b1 #b00000000000000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1111111111111111)
                arg2
                (fp #b0 #b01000001100011110 #b0010101011100111)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10111011100010111 #b0101000011010001)
                expect
                (fp #b1 #b01010000001011010 #b0010010010001010)))
(assert (fp.leq (fp #b1 #b01010000001011010 #b0010010010001010)
                expect
                (fp #b0 #b11100100011000010 #b0001110100110010)))

(assert (= expect result))

(check-sat)
(exit)
