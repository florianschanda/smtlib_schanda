; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b110110011 #b01100100)
                arg1
                (fp #b0 #b111000010 #b00111001)))
(assert (fp.leq (fp #b0 #b111000010 #b00111001)
                arg1
                (fp #b0 #b111011010 #b11100110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111010101 #b10111110)
                arg2
                (fp #b0 #b000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b000000000 #b01000011)
                arg2
                (fp #b0 #b101100101 #b01110001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001110010 #b11101011)
                expect
                (fp #b0 #b011000010 #b01000111)))
(assert (fp.leq (fp #b0 #b011000010 #b01000111)
                expect
                (fp #b0 #b011010010 #b00101111)))

(assert (= expect result))

(check-sat)
(exit)
