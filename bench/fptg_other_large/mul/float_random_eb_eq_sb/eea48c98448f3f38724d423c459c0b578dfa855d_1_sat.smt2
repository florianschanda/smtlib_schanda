(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110100001011111 #b00000100010011)
                arg1
                (fp #b1 #b100000100101000 #b00100010100001)))
(assert (fp.leq (fp #b1 #b100000100101000 #b00100010100001)
                arg1
                (fp #b0 #b010011101010101 #b11100100001111)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b010100000110000 #b00111011110111)
                arg2
                (fp #b0 #b100000000001100 #b01001010010010)))
(assert (fp.leq (fp #b0 #b100000000001100 #b01001010010010)
                arg2
                (fp #b0 #b110000000010001 #b01100001010101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110011110110000 #b00010111101110)
                expect
                (fp #b1 #b100000100110101 #b01110110110011)))
(assert (fp.leq (fp #b1 #b100000100110101 #b01110110110011)
                expect
                (fp #b0 #b101010000110111 #b01111101000011)))

(assert (= expect result))

(check-sat)
(exit)
