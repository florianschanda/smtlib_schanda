(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000000011111010 #b11011101100110)
                arg2
                (fp #b1 #b000000000000000 #b11111111111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11111111111111)
                arg2
                (fp #b0 #b100101100010010 #b10110111100001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110000011000100 #b10100011011010)
                expect
                (fp #b0 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b100110010110001 #b10111111000001)))

(assert (= expect result))

(check-sat)
(exit)
