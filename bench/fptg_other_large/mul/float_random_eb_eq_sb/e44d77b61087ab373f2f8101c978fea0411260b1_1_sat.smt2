(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111010001101 #b11110101010)
                arg1
                (fp #b1 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b001111111010 #b01101010000)
                arg1
                (fp #b0 #b000100000001 #b01000110001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101001101010 #b00101101010)
                arg2
                (fp #b1 #b000000000000 #b10001001100)))
(assert (fp.leq (fp #b1 #b000000000000 #b10001001100)
                arg2
                (fp #b0 #b100111000010 #b01000101011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010101000000 #b00110110001)
                expect
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b001001001111 #b11101100000)))

(assert (= expect result))

(check-sat)
(exit)
