; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00000101010 #b1010111010)
                arg1
                (fp #b0 #b11010100000 #b0100011001)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011001)
                arg1
                (fp #b0 #b11010111110 #b1010001011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010111100 #b1010100111)
                arg2
                (fp #b1 #b00010101100 #b0100111000)))
(assert (fp.leq (fp #b1 #b00010101100 #b0100111000)
                arg2
                (fp #b0 #b01001010010 #b0100110111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000110100 #b0001010101)
                expect
                (fp #b1 #b01101001101 #b1010100111)))
(assert (fp.leq (fp #b1 #b01101001101 #b1010100111)
                expect
                (fp #b0 #b01110010101 #b0110000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
