(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110110111 #b10001100010)
                arg1
                (fp #b1 #b000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b000000000000 #b11011000100)
                arg1
                (fp #b0 #b110110001101 #b10110101000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100111101 #b10000011110)
                arg2
                (fp #b1 #b011111111111 #b00110001010)))
(assert (fp.leq (fp #b1 #b011111111111 #b00110001010)
                arg2
                (fp #b0 #b111010011100 #b01011110101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110011000 #b01111111111)
                expect
                (fp #b0 #b000000000001 #b00000010001)))
(assert (fp.leq (fp #b0 #b000000000001 #b00000010001)
                expect
                (fp #b0 #b111100100000 #b01010010100)))

(assert (= expect result))

(check-sat)
(exit)
