                arg2
                (fp #b1 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b1 #b00111111111001 #b0110101000001)
                arg2
                (fp #b1 #b00001010100101 #b1111010000101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01111001100000 #b0101000101111)
                expect
                (fp #b0 #b01111111111001 #b0110101000001)))
(assert (fp.leq (fp #b0 #b01111111111001 #b0110101000001)
                expect
                (fp #b0 #b10000100010010 #b0000010110000)))

(assert (= expect result))

(check-sat)
(exit)
