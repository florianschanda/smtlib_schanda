; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000000001000 #b10010011110)
                arg1
                (fp #b1 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000001)
                arg1
                (fp #b0 #b101101001111 #b01111110101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101101111 #b11100001001)
                arg2
                (fp #b0 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000001 #b00000000000)
                arg2
                (fp #b0 #b011100111111 #b00010100101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110111000110 #b11110110101)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b111010010010 #b11000101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
