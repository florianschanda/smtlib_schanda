                arg2
                (fp #b0 #b001111100 #b00000000)))
(assert (fp.leq (fp #b0 #b001111100 #b00000000)
                arg2
                (fp #b0 #b110011100 #b10101001)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100001101 #b01101110)
                expect
                (fp #b1 #b000100101 #b01111011)))
(assert (fp.leq (fp #b1 #b000100101 #b01111011)
                expect
                (fp #b0 #b111001000 #b01011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
