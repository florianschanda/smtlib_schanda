; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110010001100001 #b100111010110101)
                arg1
                (fp #b1 #b0010000000101010 #b010110111111100)))
(assert (fp.leq (fp #b1 #b0010000000101010 #b010110111111100)
                arg1
                (fp #b0 #b1001000001011011 #b110111110100000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0000111010101110 #b001101001110101)
                arg2
                (fp #b0 #b0011001100000010 #b101011011101100)))
(assert (fp.leq (fp #b0 #b0011001100000010 #b101011011101100)
                arg2
                (fp #b0 #b1000000110000111 #b100001010010100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000100110000110 #b010001011111110)
                expect
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                expect
                (fp #b0 #b1100000010001110 #b111010100111011)))

(assert (= expect result))

(check-sat)
(exit)
