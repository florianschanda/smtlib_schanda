(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111100101101 #b100001111000)
                arg1
                (fp #b1 #b0111111111111 #b101110111111)))
(assert (fp.leq (fp #b1 #b0111111111111 #b101110111111)
                arg1
                (fp #b0 #b1011000101000 #b111100100010)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0111010101001 #b110011010101)
                arg2
                (fp #b1 #b0000000000000 #b101011101010)))
(assert (fp.leq (fp #b1 #b0000000000000 #b101011101010)
                arg2
                (fp #b0 #b1000000010001 #b100100010101)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0000001101000 #b101000100111)
                expect
                (fp #b0 #b0000000000001 #b001011101110)))
(assert (fp.leq (fp #b0 #b0000000000001 #b001011101110)
                expect
                (fp #b0 #b1010111101111 #b111001101110)))

(assert (= expect result))

(check-sat)
(exit)
