; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b00111110111111 #b1011110010111)
                arg1
                (fp #b0 #b10000000001011 #b1011101000110)))
(assert (fp.leq (fp #b0 #b10000000001011 #b1011101000110)
                arg1
                (fp #b0 #b10010010111100 #b0110101101011)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000011011010 #b0001101011100)
                arg2
                (fp #b1 #b10000000001100 #b1000110111100)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1000110111100)
                arg2
                (fp #b1 #b00110110110100 #b1001100010110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011010011001 #b0100101101000)
                expect
                (fp #b1 #b10000000011001 #b0101011110100)))
(assert (fp.leq (fp #b1 #b10000000011001 #b0101011110100)
                expect
                (fp #b0 #b00100100100010 #b0101100110100)))

(assert (= expect result))

(check-sat)
(exit)
