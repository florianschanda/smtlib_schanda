                arg2
                (fp #b0 #b11011100110010100 #b0110001101111100)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b00110000100100100 #b0010001001011000)
                expect
                (fp #b0 #b10000000000001111 #b0011001100101110)))
(assert (fp.leq (fp #b0 #b10000000000001111 #b0011001100101110)
                expect
                (fp #b0 #b11101111010001001 #b0111101000110011)))

(assert (= expect result))

(check-sat)
