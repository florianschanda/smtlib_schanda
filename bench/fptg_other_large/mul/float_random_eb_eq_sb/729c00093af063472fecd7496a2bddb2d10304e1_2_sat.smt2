(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111110011100111 #b111101100000100)
                arg1
                (fp #b0 #b0000000000000000 #b111110010011101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111110010011101)
                arg1
                (fp #b0 #b1100010010100100 #b011010101100000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100101110101100 #b101111101100111)
                arg2
                (fp #b1 #b1000000000001110 #b100101100101100)))
(assert (fp.leq (fp #b1 #b1000000000001110 #b100101100101100)
                arg2
                (fp #b0 #b1101100011111000 #b001011011001000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000110011110110 #b101100010100110)
                expect
                (fp #b1 #b0000000000010000 #b100010111001100)))
(assert (fp.leq (fp #b1 #b0000000000010000 #b100010111001100)
                expect
                (fp #b0 #b0010000110111001 #b110010111011000)))

(assert (= expect result))

(check-sat)
(exit)
