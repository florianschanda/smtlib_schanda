; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100111010000010 #b001000011111100)
                arg1
                (fp #b0 #b1011111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b111111111111111)
                arg1
                (fp #b0 #b1111000000010010 #b000100001010111)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100111000100101 #b010111001011000)
                arg2
                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b0 #b1011000100100110 #b100000011110011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0010100001101100 #b011101110010110)
                expect
                (fp #b0 #b0111111111111000 #b011010100000100)))
(assert (fp.leq (fp #b0 #b0111111111111000 #b011010100000100)
                expect
                (fp #b0 #b1110011010001101 #b111000011001100)))

(assert (= expect result))

(check-sat)
(exit)
