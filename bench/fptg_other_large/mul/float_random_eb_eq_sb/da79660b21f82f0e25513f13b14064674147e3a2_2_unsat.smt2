                (fp #b0 #b100000000001110 #b00000000000000)))
(assert (fp.leq (fp #b0 #b100000000001110 #b00000000000000)
                arg2
                (fp #b0 #b111000000111101 #b00000110100110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
