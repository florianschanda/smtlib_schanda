                arg2
                (fp #b0 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b1000001001 #b000000000)
                arg2
                (fp #b0 #b1010011111 #b110001010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000101 #b001110110)
                expect
                (fp #b1 #b0000000010 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000010 #b000000000)
                expect
                (fp #b0 #b0101011001 #b101111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
