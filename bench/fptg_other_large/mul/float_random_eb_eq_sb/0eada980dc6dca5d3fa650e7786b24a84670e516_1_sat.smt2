;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110010000 #b00010101110)
                arg1
                (fp #b0 #b111001001001 #b10011000010)))
(assert (fp.leq (fp #b0 #b111001001001 #b10011000010)
                arg1
                (fp #b0 #b111110100001 #b11010001011)))

(declare-const arg2 (_ FloatingPoint 12 12))
