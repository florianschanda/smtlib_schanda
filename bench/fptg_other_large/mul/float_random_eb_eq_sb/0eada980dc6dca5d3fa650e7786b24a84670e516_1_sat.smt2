                arg2
                (fp #b1 #b011001001110 #b00100110001)))
(assert (fp.leq (fp #b1 #b011001001110 #b00100110001)
                arg2
                (fp #b0 #b100111001111 #b11010001011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110101111000 #b00110101001)
                expect
                (fp #b1 #b110010011000 #b11010101000)))
(assert (fp.leq (fp #b1 #b110010011000 #b11010101000)
                expect
                (fp #b1 #b000001001110 #b00001110000)))

(assert (= expect result))

(check-sat)
(exit)
