(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010101011111 #b11100000001)
                arg2
                (fp #b1 #b000000000000 #b01101101001)))
(assert (fp.leq (fp #b1 #b000000000000 #b01101101001)
                arg2
                (fp #b0 #b010001100011 #b00110100001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010010100001 #b00111111010)
                expect
                (fp #b0 #b000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000001)
                expect
                (fp #b0 #b001111011010 #b11101111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
