;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101000100 #b11001010010)
                arg1
                (fp #b1 #b000000000000 #b10011011110)))
(assert (fp.leq (fp #b1 #b000000000000 #b10011011110)
                arg1
