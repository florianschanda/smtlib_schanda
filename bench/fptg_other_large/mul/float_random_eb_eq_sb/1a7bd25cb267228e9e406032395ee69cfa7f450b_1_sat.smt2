                arg2
                (fp #b0 #b100000000001100 #b01001010010010)))
(assert (fp.leq (fp #b0 #b100000000001100 #b01001010010010)
                arg2
                (fp #b0 #b111001100011110 #b11000010000000)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111100010100011 #b10001010001111)
                expect
                (fp #b1 #b001100101011101 #b10101001110001)))
(assert (fp.leq (fp #b1 #b001100101011101 #b10101001110001)
                expect
                (fp #b0 #b010000101011101 #b00010000000100)))

(assert (= expect result))

(check-sat)
(exit)
