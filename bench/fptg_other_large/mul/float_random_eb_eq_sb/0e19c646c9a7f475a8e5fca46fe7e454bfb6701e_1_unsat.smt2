(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010101 #b11000000)
                arg1
                (fp #b1 #b011111111 #b01010101)))
(assert (fp.leq (fp #b1 #b011111111 #b01010101)
                arg1
                (fp #b0 #b000111110 #b11100001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001101000 #b11001111)
                arg2
                (fp #b0 #b000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000000)
                arg2
                (fp #b0 #b100010100 #b01011011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001010000 #b01111111)
                expect
                (fp #b1 #b000000000 #b01010101)))
(assert (fp.leq (fp #b1 #b000000000 #b01010101)
                expect
                (fp #b0 #b001011010 #b00100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
