; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111111 #b00000000)
                arg1
                (fp #b1 #b111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111111)
                arg1
                (fp #b1 #b010111011 #b00011101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011010010 #b00000111)
                arg2
                (fp #b0 #b000011101 #b00011110)))
(assert (fp.leq (fp #b0 #b000011101 #b00011110)
                arg2
                (fp #b0 #b101111100 #b10000100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111000 #b01101000)
                expect
                (fp #b1 #b100011101 #b00011110)))
(assert (fp.leq (fp #b1 #b100011101 #b00011110)
                expect
                (fp #b1 #b000110101 #b10011001)))

(assert (= expect result))

(check-sat)
(exit)
