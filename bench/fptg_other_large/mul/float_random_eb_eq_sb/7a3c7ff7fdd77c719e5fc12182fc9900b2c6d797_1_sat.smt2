; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1100011011 #b101000010)
                arg1
                (fp #b0 #b1101001001 #b011010100)))
(assert (fp.leq (fp #b0 #b1101001001 #b011010100)
                arg1
                (fp #b0 #b1110100111 #b001110101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010110000 #b110010010)
                arg2
                (fp #b1 #b0000000000 #b000001001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000001001)
                arg2
                (fp #b0 #b0001000001 #b110011101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000101 #b101100111)
                expect
                (fp #b1 #b0101000101 #b100101110)))
(assert (fp.leq (fp #b1 #b0101000101 #b100101110)
                expect
                (fp #b0 #b1000110101 #b101011110)))

(assert (= expect result))

(check-sat)
(exit)
