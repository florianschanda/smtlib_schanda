; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001000111 #b0101110001)
                arg1
                (fp #b1 #b01111111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1111110100)
                arg1
                (fp #b0 #b11111011011 #b0101011011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01000001001 #b0110010010)
                arg2
                (fp #b0 #b11010110000 #b1101010111)))
(assert (fp.leq (fp #b0 #b11010110000 #b1101010111)
                arg2
                (fp #b0 #b11100101010 #b0101000111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011001111 #b1110010011)
                expect
                (fp #b1 #b11010110001 #b1101001100)))
(assert (fp.leq (fp #b1 #b11010110001 #b1101001100)
                expect
                (fp #b0 #b10000110001 #b1011100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
