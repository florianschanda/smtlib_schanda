; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100010101011101 #b100011001101010)
                arg1
                (fp #b1 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b0011111111111000 #b011010100000101)
                arg1
                (fp #b0 #b1001101001111001 #b011001000001101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100011101110101 #b101010110011101)
                arg2
                (fp #b0 #b0000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010000000000000)
                arg2
                (fp #b0 #b0010101011100110 #b111011110101000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0100111011100101 #b010010101010100)
                expect
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                expect
                (fp #b0 #b1100001100011001 #b001111111011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
