;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000010010 #b0010111111)
                arg1
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg1
                (fp #b0 #b00111100111 #b1110110011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00101010000 #b0001101100)
                arg2
                (fp #b1 #b00000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000101100)
                arg2
                (fp #b0 #b10100010001 #b0101001001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111000101 #b1101001001)
                expect
                (fp #b1 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b01111101001 #b0101001010)))

(assert (= expect result))

(check-sat)
(exit)
