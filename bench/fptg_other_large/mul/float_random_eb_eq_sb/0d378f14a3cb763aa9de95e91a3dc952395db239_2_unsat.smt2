(assert (fp.leq (fp #b0 #b1001100111011001 #b001111010110111)
                arg2
                (fp #b0 #b1101010000001001 #b111001111011001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0000110111100111 #b111011000000101)
                expect
                (fp #b0 #b1010100101011111 #b100011100011100)))
(assert (fp.leq (fp #b0 #b1010100101011111 #b100011100011100)
                expect
                (fp #b0 #b1101000100011100 #b111101001111101)))

(assert (not (= expect result)))

(check-sat)
