; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110010000 #b00100100010)
                arg1
                (fp #b1 #b110110011100 #b00111011110)))
(assert (fp.leq (fp #b1 #b110110011100 #b00111011110)
                arg1
                (fp #b0 #b101001111111 #b01101000001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b011001111101 #b01000011011)
                arg2
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                arg2
                (fp #b0 #b100110000111 #b00011100000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001111110010 #b10000100010)
                expect
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b000001001011 #b11110101110)))

(assert (= expect result))

(check-sat)
(exit)
