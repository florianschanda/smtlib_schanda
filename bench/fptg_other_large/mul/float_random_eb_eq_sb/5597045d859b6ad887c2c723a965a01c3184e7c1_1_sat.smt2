(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110101100100101000 #b01100101100100110)
                arg2
                (fp #b1 #b011111111111001100 #b10010100110000010)))
(assert (fp.leq (fp #b1 #b011111111111001100 #b10010100110000010)
                arg2
                (fp #b0 #b101110001110011001 #b10111100001110100)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
