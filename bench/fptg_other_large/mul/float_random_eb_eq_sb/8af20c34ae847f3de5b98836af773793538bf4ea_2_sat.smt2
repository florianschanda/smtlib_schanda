(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011011100 #b0111110010)
                arg1
                (fp #b1 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111)
                arg1
                (fp #b1 #b00011001110 #b1110101100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01000011001 #b1001000000)
                arg2
                (fp #b0 #b00000000000 #b1110100111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110100111)
                arg2
                (fp #b0 #b00001111011 #b1111011111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101100100 #b1011110001)
                expect
                (fp #b1 #b01000000000 #b1101001110)))
(assert (fp.leq (fp #b1 #b01000000000 #b1101001110)
                expect
                (fp #b0 #b00001001000 #b1100000101)))

(assert (= expect result))

(check-sat)
(exit)
