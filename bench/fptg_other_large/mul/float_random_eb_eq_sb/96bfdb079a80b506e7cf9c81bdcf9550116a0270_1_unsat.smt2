;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101110110 #b10000110)
                arg1
                (fp #b1 #b011111111 #b00100101)))
(assert (fp.leq (fp #b1 #b011111111 #b00100101)
                arg1
                (fp #b1 #b010011011 #b00000011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101111001 #b11111101)
                arg2
                (fp #b1 #b011111111 #b10011100)))
(assert (fp.leq (fp #b1 #b011111111 #b10011100)
                arg2
                (fp #b0 #b010010011 #b00110010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111100011 #b10001101)
                expect
                (fp #b0 #b011111111 #b11010111)))
(assert (fp.leq (fp #b0 #b011111111 #b11010111)
                expect
                (fp #b0 #b101101110 #b10100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
