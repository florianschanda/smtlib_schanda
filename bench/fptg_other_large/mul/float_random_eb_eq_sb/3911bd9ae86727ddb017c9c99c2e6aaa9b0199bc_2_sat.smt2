(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110010010 #b1000101100)
                arg1
                (fp #b1 #b01111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011010000)
                arg1
                (fp #b0 #b01011111111 #b0010011110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110001111 #b1001010000)
                arg2
                (fp #b0 #b01111001011 #b1100000011)))
(assert (fp.leq (fp #b0 #b01111001011 #b1100000011)
                arg2
                (fp #b0 #b10110101110 #b0110100111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10100001100 #b1001001101)
                expect
                (fp #b1 #b01111001100 #b0000111000)))
(assert (fp.leq (fp #b1 #b01111001100 #b0000111000)
                expect
                (fp #b0 #b10000110111 #b1011101000)))

(assert (= expect result))

(check-sat)
(exit)
