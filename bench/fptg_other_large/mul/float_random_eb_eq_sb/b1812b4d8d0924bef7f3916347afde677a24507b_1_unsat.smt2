(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1010010001 #b010001011)
                arg1
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                arg1
                (fp #b0 #b0110101011 #b100110000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110011000 #b010101111)
                arg2
                (fp #b1 #b1101111100 #b101100010)))
(assert (fp.leq (fp #b1 #b1101111100 #b101100010)
                arg2
                (fp #b1 #b0011111111 #b011010100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0011111011 #b000000010)
                expect
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0110011011 #b111100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
