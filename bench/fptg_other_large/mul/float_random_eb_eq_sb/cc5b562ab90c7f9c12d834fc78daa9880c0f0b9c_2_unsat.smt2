                arg2
                (fp #b0 #b100000010010100 #b10101110011111)))
(assert (fp.leq (fp #b0 #b100000010010100 #b10101110011111)
                arg2
                (fp #b0 #b110110100010101 #b11010111011001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111100100000101 #b11000011001110)
                expect
                (fp #b1 #b100000010010101 #b01001100100011)))
(assert (fp.leq (fp #b1 #b100000010010101 #b01001100100011)
                expect
                (fp #b0 #b111011111100111 #b10100111010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
