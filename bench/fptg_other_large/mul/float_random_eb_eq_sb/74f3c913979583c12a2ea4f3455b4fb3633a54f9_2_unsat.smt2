(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101011110 #b00011111)
                arg1
                (fp #b0 #b000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b000000000 #b10100110)
                arg1
                (fp #b0 #b110001100 #b10110001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011000101 #b01011110)
                arg2
                (fp #b0 #b000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b000000000 #b00111011)
                arg2
                (fp #b0 #b110011111 #b01000100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110101110 #b00001000)
                expect
                (fp #b0 #b000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000 #b00000001)
                expect
                (fp #b0 #b011110101 #b11000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
