; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010011110 #b110001001)
                arg1
                (fp #b0 #b1000001000 #b110100101)))
(assert (fp.leq (fp #b0 #b1000001000 #b110100101)
                arg1
                (fp #b0 #b1100010100 #b001100111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111100111 #b100000010)
                arg2
                (fp #b1 #b1101111100 #b101100010)))
(assert (fp.leq (fp #b1 #b1101111100 #b101100010)
                arg2
                (fp #b1 #b0101100111 #b000000111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011001 #b010001111)
                expect
                (fp #b1 #b1110000110 #b100010110)))
(assert (fp.leq (fp #b1 #b1110000110 #b100010110)
                expect
                (fp #b1 #b0100101110 #b100110000)))

(assert (= expect result))

(check-sat)
(exit)
