                arg2
                (fp #b0 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b000000000)
                arg2
                (fp #b0 #b1101000001 #b011000110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111010111 #b110001011)
                expect
                (fp #b0 #b1001001010 #b011010100)))
(assert (fp.leq (fp #b0 #b1001001010 #b011010100)
                expect
                (fp #b0 #b1111000001 #b000010101)))

(assert (= expect result))

(check-sat)
(exit)
