                arg2
                (fp #b0 #b00000000000000 #b1111111111111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111111111111)
                arg2
                (fp #b0 #b00101000010110 #b1011110010011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00011101111011 #b0100001010101)
                expect
                (fp #b0 #b01000000000000 #b1111111111101)))
(assert (fp.leq (fp #b0 #b01000000000000 #b1111111111101)
                expect
                (fp #b0 #b10110111111100 #b0100010101111)))

(assert (= expect result))

(check-sat)
(exit)
