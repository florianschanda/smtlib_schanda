; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b101111111000100 #b01001101110110)
                arg1
                (fp #b0 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000000)
                arg1
                (fp #b0 #b110011001101111 #b11010001001100)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101110100011001 #b11110100011010)
                arg2
                (fp #b1 #b100111001011010 #b11000011011010)))
(assert (fp.leq (fp #b1 #b100111001011010 #b11000011011010)
                arg2
                (fp #b0 #b101000101000011 #b00001111000001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101000001010000 #b01001110110100)
                expect
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                expect
                (fp #b0 #b010101101111000 #b00101100010000)))

(assert (= expect result))

(check-sat)
(exit)
