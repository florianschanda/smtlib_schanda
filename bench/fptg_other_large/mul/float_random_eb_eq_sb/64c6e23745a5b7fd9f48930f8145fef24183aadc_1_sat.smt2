(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01110101010 #b0100000000)
                arg1
                (fp #b0 #b00101101011 #b1101010101)))
(assert (fp.leq (fp #b0 #b00101101011 #b1101010101)
                arg1
                (fp #b0 #b01000110111 #b1001001101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110011001 #b0010010001)
                arg2
                (fp #b1 #b11011001000 #b1000000010)))
(assert (fp.leq (fp #b1 #b11011001000 #b1000000010)
                arg2
                (fp #b1 #b01100001111 #b0001110010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001000000 #b1111001110)
                expect
                (fp #b1 #b10000110101 #b0110000001)))
(assert (fp.leq (fp #b1 #b10000110101 #b0110000001)
                expect
                (fp #b1 #b10000001101 #b1101001011)))

(assert (= expect result))

(check-sat)
(exit)
