;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111101 #b010111000)
                arg1
                (fp #b1 #b1111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000000)
                arg1
                (fp #b1 #b0101101101 #b000111000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111000110 #b001011110)
                arg2
                (fp #b0 #b0000000000 #b100001010)))
(assert (fp.leq (fp #b0 #b0000000000 #b100001010)
                arg2
                (fp #b0 #b0000101110 #b010010010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111011100 #b000000001)
                expect
                (fp #b1 #b0111111110 #b000010100)))
(assert (fp.leq (fp #b1 #b0111111110 #b000010100)
                expect
                (fp #b0 #b0001100011 #b110101110)))

(assert (= expect result))

(check-sat)
(exit)
