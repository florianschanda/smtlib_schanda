; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101111111011 #b0100001010011)
                arg1
                (fp #b1 #b11101110010101 #b1000100010010)))
(assert (fp.leq (fp #b1 #b11101110010101 #b1000100010010)
                arg1
                (fp #b0 #b00010010101000 #b0101101010110)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111101010000 #b0001111011100)
                arg2
                (fp #b1 #b01100100011101 #b1110110001100)))
(assert (fp.leq (fp #b1 #b01100100011101 #b1110110001100)
                arg2
                (fp #b0 #b00010011100001 #b1101101001010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b00110010001110 #b0001010100011)
                expect
                (fp #b0 #b11010010110100 #b0111100110000)))
(assert (fp.leq (fp #b0 #b11010010110100 #b0111100110000)
                expect
                (fp #b0 #b11101111010110 #b0100011011000)))

(assert (= expect result))

(check-sat)
(exit)
