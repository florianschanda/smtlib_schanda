                arg2
                (fp #b0 #b110110000101 #b10010101101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111000001 #b11100000110)
                expect
                (fp #b1 #b111001001010 #b00110001101)))
(assert (fp.leq (fp #b1 #b111001001010 #b00110001101)
                expect
                (fp #b1 #b011001111110 #b01010100000)))

(assert (not (= expect result)))

