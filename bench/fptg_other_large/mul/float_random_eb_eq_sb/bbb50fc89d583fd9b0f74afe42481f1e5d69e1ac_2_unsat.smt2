(assert (fp.leq (fp #b1 #b000011111111 #b00000111010)
                arg2
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                arg2
                (fp #b0 #b111001100000 #b10011000000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110000000110 #b10010011001)
                expect
                (fp #b1 #b011111111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b011111111010 #b01101010000)
                expect
                (fp #b0 #b000111000000 #b00110001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
