                (fp #b0 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000001 #b00000000000)
                arg2
                (fp #b0 #b011011101001 #b11000010001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b000000010000 #b00010100011)
                expect
                (fp #b0 #b000000000001 #b10010001101)))
(assert (fp.leq (fp #b0 #b000000000001 #b10010001101)
                expect
                (fp #b0 #b011111000101 #b01110110010)))

(assert (= expect result))

(check-sat)
(exit)
