; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111101 #b10101001)
                arg1
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg1
                (fp #b1 #b001010101 #b00110011)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b000111011 #b00111011)
                arg2
                (fp #b1 #b000000000 #b00100111)))
(assert (fp.leq (fp #b1 #b000000000 #b00100111)
                arg2
                (fp #b0 #b011101101 #b00010110)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011111001 #b01111011)
                expect
                (fp #b0 #b011111100 #b00111000)))
(assert (fp.leq (fp #b0 #b011111100 #b00111000)
                expect
                (fp #b0 #b111000000 #b11001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
