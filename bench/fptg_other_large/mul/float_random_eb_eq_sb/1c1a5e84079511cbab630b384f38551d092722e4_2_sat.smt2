; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111101010110 #b10110111100)
                arg1
                (fp #b0 #b100000001010 #b10001010101)))
(assert (fp.leq (fp #b0 #b100000001010 #b10001010101)
                arg1
                (fp #b0 #b111110100100 #b01111001000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101011000111 #b01000011001)
                arg2
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg2
                (fp #b0 #b111000111111 #b10101101101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000001111 #b11011010000)
                expect
                (fp #b1 #b000000001100 #b10001010100)))
(assert (fp.leq (fp #b1 #b000000001100 #b10001010100)
                expect
                (fp #b0 #b011100000010 #b00100001011)))

(assert (= expect result))

(check-sat)
(exit)
