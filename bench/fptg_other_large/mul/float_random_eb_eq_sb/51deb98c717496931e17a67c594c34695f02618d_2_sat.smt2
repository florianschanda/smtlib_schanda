                arg2
                (fp #b1 #b110001000010110110 #b10001101111111010)))
(assert (fp.leq (fp #b1 #b110001000010110110 #b10001101111111010)
                arg2
                (fp #b1 #b000000000001001010 #b01111011011100010)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b000100110100001101 #b01100011011111111)
                expect
                (fp #b0 #b100001000010101111 #b00011001011011000)))
(assert (fp.leq (fp #b0 #b100001000010101111 #b00011001011011000)
                expect
                (fp #b0 #b100100100110010100 #b01000010110110111)))

(assert (= expect result))

(check-sat)
(exit)
