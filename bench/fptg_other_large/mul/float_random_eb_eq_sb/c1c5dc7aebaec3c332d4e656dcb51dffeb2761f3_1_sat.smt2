(assert (fp.leq (fp #b1 #b00000000000 #b0100000000)
                arg2
                (fp #b0 #b10011000010 #b1111110011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110011100 #b0101100001)
                expect
                (fp #b1 #b00011010111 #b1010011001)))
(assert (fp.leq (fp #b1 #b00011010111 #b1010011001)
                expect
                (fp #b0 #b10110011001 #b1111011101)))

(assert (= expect result))

(check-sat)
