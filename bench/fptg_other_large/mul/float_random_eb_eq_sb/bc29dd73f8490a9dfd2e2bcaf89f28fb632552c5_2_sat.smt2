; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110011100100011 #b11011011111101)
                arg1
                (fp #b0 #b100000000001010 #b11100011010000)))
(assert (fp.leq (fp #b0 #b100000000001010 #b11100011010000)
                arg1
                (fp #b0 #b101100100100111 #b00110001101110)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101001000011000 #b01010111111111)
                arg2
                (fp #b1 #b011111111111111 #b11000111110100)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11000111110100)
                arg2
                (fp #b0 #b100111011000000 #b11001101101111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110100110001111 #b00111000010101)
                expect
                (fp #b1 #b100000000001011 #b10101110001110)))
(assert (fp.leq (fp #b1 #b100000000001011 #b10101110001110)
                expect
                (fp #b0 #b001001100000000 #b10000111000000)))

(assert (= expect result))

(check-sat)
(exit)
