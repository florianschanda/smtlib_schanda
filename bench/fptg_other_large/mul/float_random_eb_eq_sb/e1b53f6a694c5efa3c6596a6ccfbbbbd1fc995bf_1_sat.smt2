; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010111100 #b1101100011)
                arg1
                (fp #b0 #b00000000000 #b0001001100)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001001100)
                arg1
                (fp #b0 #b01010100111 #b1000110011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001111101 #b0111110111)
                arg2
                (fp #b1 #b00000000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000000 #b0101011111)
                arg2
                (fp #b0 #b01001101111 #b0001110010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001100010 #b1001111100)
                expect
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b00011100101 #b1101111001)))

(assert (= expect result))

(check-sat)
(exit)
