(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110010010011010110 #b11001001011110110)
                expect
                (fp #b1 #b100111101101111001 #b00001001001110100)))
(assert (fp.leq (fp #b1 #b100111101101111001 #b00001001001110100)
                expect
                (fp #b0 #b100110000110110101 #b01011101110000001)))

(assert (not (= expect result)))

(check-sat)
