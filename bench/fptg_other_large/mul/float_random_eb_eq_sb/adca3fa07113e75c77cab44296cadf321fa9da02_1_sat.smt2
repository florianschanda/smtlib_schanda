                arg2
                (fp #b1 #b100100100010111 #b11000111001101)))
(assert (fp.leq (fp #b1 #b100100100010111 #b11000111001101)
                arg2
                (fp #b0 #b100111000101110 #b10000101100001)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111010001111110 #b11100111001000)
                expect
                (fp #b1 #b110100101111100 #b00000100010001)))
(assert (fp.leq (fp #b1 #b110100101111100 #b00000100010001)
                expect
                (fp #b0 #b011111001111100 #b11000111011010)))

(assert (= expect result))

(check-sat)
(exit)
