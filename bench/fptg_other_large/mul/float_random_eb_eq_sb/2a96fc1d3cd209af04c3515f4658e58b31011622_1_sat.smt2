(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110111001 #b110101110)
                arg1
                (fp #b1 #b0000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000000)
                arg1
                (fp #b0 #b0000111011 #b001001000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110101111 #b011001100)
                arg2
                (fp #b1 #b0000000000 #b010000100)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000100)
                arg2
                (fp #b0 #b0100100000 #b111101010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1011101111 #b000101111)
                expect
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0111100001 #b011010100)))

(assert (= expect result))

(check-sat)
(exit)
