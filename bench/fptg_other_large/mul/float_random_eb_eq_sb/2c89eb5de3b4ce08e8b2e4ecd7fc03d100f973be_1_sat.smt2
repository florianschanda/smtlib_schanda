(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b10001100)
                arg1
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg1
                (fp #b1 #b010011100 #b01000110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b101010110 #b01010000)
                arg2
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                arg2
                (fp #b0 #b001100110 #b11010000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100011111 #b00011110)
                expect
                (fp #b0 #b000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000)
                expect
                (fp #b0 #b100101001 #b01101100)))

(assert (= expect result))

(check-sat)
(exit)
