(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101100101001011 #b00101100110010)
                arg1
                (fp #b1 #b011111111111111 #b10001011100001)))
(assert (fp.leq (fp #b1 #b011111111111111 #b10001011100001)
                arg1
                (fp #b0 #b011100100101000 #b11100100011011)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110111010101111 #b10001100010111)
                arg2
                (fp #b1 #b100100000101011 #b10001111001110)))
(assert (fp.leq (fp #b1 #b100100000101011 #b10001111001110)
                arg2
                (fp #b0 #b111010010101000 #b01011011100101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b011001111011111 #b00011111011110)
                expect
                (fp #b0 #b100100000101100 #b00110100011001)))
(assert (fp.leq (fp #b0 #b100100000101100 #b00110100011001)
                expect
                (fp #b0 #b101010110100110 #b10110100101010)))

(assert (= expect result))

(check-sat)
(exit)
