(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01101010000100 #b0100001010111)
                arg1
                (fp #b0 #b11111010010100 #b0000010100011)))
(assert (fp.leq (fp #b0 #b11111010010100 #b0000010100011)
                arg1
                (fp #b0 #b11111011101011 #b0001010001101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111111110 #b1010011011110)
                arg2
                (fp #b1 #b11111111111101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000000)
                arg2
                (fp #b0 #b10000001110000 #b0011100100011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
