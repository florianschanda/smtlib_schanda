(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101101001101001 #b000100100100100)
                arg1
                (fp #b0 #b0000000000000000 #b111111111111111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111111111111111)
                arg1
                (fp #b0 #b1010101001101001 #b111101000101001)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0011110101111101 #b010100101000011)
                arg2
                (fp #b0 #b1011010110011111 #b101101010110110)))
(assert (fp.leq (fp #b0 #b1011010110011111 #b101101010110110)
                arg2
                (fp #b0 #b1110110011111000 #b110000000010011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100001001000010 #b010000000000101)
                expect
                (fp #b0 #b0011010110100001 #b101101010110100)))
(assert (fp.leq (fp #b0 #b0011010110100001 #b101101010110100)
                expect
                (fp #b0 #b1011100011011011 #b101101101100100)))

(assert (= expect result))

(check-sat)
(exit)
