; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100100101 #b010001111)
                arg1
                (fp #b0 #b1000001000 #b110100101)))
(assert (fp.leq (fp #b0 #b1000001000 #b110100101)
                arg1
                (fp #b0 #b1001110100 #b001000001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101001000 #b111110111)
                arg2
                (fp #b0 #b1000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b1000001000 #b001010110)
                arg2
                (fp #b0 #b1000101011 #b010011101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101010110 #b101111010)
                expect
                (fp #b0 #b1000010010 #b000100000)))
(assert (fp.leq (fp #b0 #b1000010010 #b000100000)
                expect
                (fp #b0 #b1011010000 #b001111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
