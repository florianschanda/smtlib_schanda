(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010100111001 #b1011001100101)
                arg1
                (fp #b1 #b10100101101110 #b1010010010001)))
(assert (fp.leq (fp #b1 #b10100101101110 #b1010010010001)
                arg1
                (fp #b1 #b01011010001001 #b1100101101001)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001110000110 #b0111110100010)
                arg2
                (fp #b0 #b01111111111111 #b1001100111111)))
(assert (fp.leq (fp #b0 #b01111111111111 #b1001100111111)
                arg2
                (fp #b0 #b11110010101011 #b0010010000000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10101101000010 #b0011011001000)
                expect
                (fp #b1 #b10100101101111 #b0101000010111)))
(assert (fp.leq (fp #b1 #b10100101101111 #b0101000010111)
                expect
                (fp #b1 #b01100001000111 #b1111011111101)))

(assert (= expect result))

(check-sat)
(exit)
