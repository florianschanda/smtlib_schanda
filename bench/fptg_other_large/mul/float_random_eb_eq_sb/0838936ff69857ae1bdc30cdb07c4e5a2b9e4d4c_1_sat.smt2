;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1000111000110 #b011000110000)
                arg1
                (fp #b1 #b0001001001011 #b111010001010)))
(assert (fp.leq (fp #b1 #b0001001001011 #b111010001010)
                arg1
                (fp #b0 #b1110010100111 #b101010110110)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0100101010111 #b100011011100)
                arg2
                (fp #b0 #b1111111111110 #b111111111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111111111111)
                arg2
                (fp #b0 #b1111111111111 #b000000000000)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100100001011 #b001100000001)
                expect
                (fp #b1 #b1001001001011 #b111010001001)))
(assert (fp.leq (fp #b1 #b1001001001011 #b111010001001)
                expect
                (fp #b1 #b0000110001000 #b111011100101)))

(assert (= expect result))

(check-sat)
(exit)
