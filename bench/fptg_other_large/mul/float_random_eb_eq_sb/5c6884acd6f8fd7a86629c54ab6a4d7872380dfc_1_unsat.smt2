; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101111110110 #b1111101101001)
                arg1
                (fp #b1 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b1111111111111)
                arg1
                (fp #b0 #b01100011000111 #b1101001010000)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101000000010 #b1101011101011)
                arg2
                (fp #b1 #b01111111111111 #b0100110110011)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0100110110011)
                arg2
                (fp #b0 #b01000100100110 #b0101010011101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b01010001010101 #b0001101101001)
                expect
                (fp #b0 #b10111111111111 #b0100110110010)))
(assert (fp.leq (fp #b0 #b10111111111111 #b0100110110010)
                expect
                (fp #b0 #b11001000110011 #b0111010010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
