(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00001111011 #b0100000001)
                arg1
                (fp #b0 #b01000001000 #b1000101010)))
(assert (fp.leq (fp #b0 #b01000001000 #b1000101010)
                arg1
                (fp #b0 #b11010001001 #b1011111000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010111100 #b1001101011)
                arg2
                (fp #b0 #b11010110000 #b1101010111)))
(assert (fp.leq (fp #b0 #b11010110000 #b1101010111)
                arg2
                (fp #b0 #b11110011110 #b0010001000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110000111 #b0100010001)
                expect
                (fp #b0 #b10010111010 #b0110100111)))
(assert (fp.leq (fp #b0 #b10010111010 #b0110100111)
                expect
                (fp #b0 #b10111111110 #b0111100010)))

(assert (= expect result))

(check-sat)
(exit)
