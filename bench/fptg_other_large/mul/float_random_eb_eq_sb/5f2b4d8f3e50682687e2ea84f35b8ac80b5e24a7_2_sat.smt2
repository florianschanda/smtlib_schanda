(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111110000111101 #b10100111000010)
                arg1
                (fp #b0 #b011111111111111 #b00011101010000)))
(assert (fp.leq (fp #b0 #b011111111111111 #b00011101010000)
                arg1
                (fp #b0 #b100010110001011 #b00100101011101)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b101101001000110 #b01101010100000)
                arg2
                (fp #b1 #b011111111101000 #b10010101000000)))
(assert (fp.leq (fp #b1 #b011111111101000 #b10010101000000)
                arg2
                (fp #b0 #b010001010110101 #b01110000110111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111010000100000 #b10110000000001)
                expect
                (fp #b1 #b011111111101000 #b11000011010010)))
(assert (fp.leq (fp #b1 #b011111111101000 #b11000011010010)
                expect
                (fp #b0 #b011110110100100 #b11110010111101)))

(assert (= expect result))

(check-sat)
(exit)
