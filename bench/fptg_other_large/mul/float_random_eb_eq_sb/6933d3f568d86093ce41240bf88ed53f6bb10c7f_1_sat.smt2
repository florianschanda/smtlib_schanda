;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0110011000010 #b110011000111)
                arg1
                (fp #b1 #b0000000000000 #b111111111111)))
(assert (fp.leq (fp #b1 #b0000000000000 #b111111111111)
                arg1
                (fp #b0 #b0101100011111 #b100001001111)))

