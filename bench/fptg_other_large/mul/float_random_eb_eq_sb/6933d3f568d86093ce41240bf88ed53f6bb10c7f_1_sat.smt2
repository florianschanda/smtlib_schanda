                arg2
                (fp #b1 #b0000000000000 #b000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000000000001)
                arg2
                (fp #b0 #b0101000011011 #b110001000000)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1010101111001 #b011110010011)
                expect
                (fp #b0 #b0000000000000 #b000000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000000000000)
                expect
                (fp #b0 #b0011000001010 #b111000110001)))

(assert (= expect result))

(check-sat)
(exit)
