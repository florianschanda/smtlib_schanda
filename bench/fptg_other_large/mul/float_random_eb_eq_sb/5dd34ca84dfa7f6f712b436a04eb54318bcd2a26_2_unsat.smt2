(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011111100 #b011100010)
                arg1
                (fp #b0 #b0100000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b000000000)
                arg1
                (fp #b0 #b1100110100 #b110101110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111110100 #b110001000)
                arg2
                (fp #b1 #b0000000001 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b000000000)
                arg2
                (fp #b0 #b1110110010 #b011101101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110100100 #b111010011)
                expect
                (fp #b1 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000001)
                expect
                (fp #b0 #b0100110011 #b011011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
