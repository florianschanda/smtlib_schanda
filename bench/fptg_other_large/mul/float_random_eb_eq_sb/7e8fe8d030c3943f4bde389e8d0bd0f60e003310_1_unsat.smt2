; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b010101010111 #b10101001111)
                arg1
                (fp #b0 #b111001001001 #b10011000010)))
(assert (fp.leq (fp #b0 #b111001001001 #b10011000010)
                arg1
                (fp #b0 #b111001101001 #b10110000000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011100010000 #b10110010010)
                arg2
                (fp #b0 #b101101010110 #b10000100000)))
(assert (fp.leq (fp #b0 #b101101010110 #b10000100000)
                arg2
                (fp #b0 #b101111110011 #b01101111110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000010010101 #b10001111000)
                expect
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                expect
                (fp #b0 #b111111111111 #b00000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
