;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b00110100000011101 #b1001100010010000)
                arg1
                (fp #b0 #b01111111111111111 #b0000111000011000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b0000111000011000)
                arg1
                (fp #b0 #b11100110111100000 #b1101001001000011)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11011101111010100 #b1100010101011111)
                expect
                (fp #b1 #b01111111111111111 #b0001110011110110)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0001110011110110)
                expect
                (fp #b1 #b01101111110001000 #b0110111000101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
