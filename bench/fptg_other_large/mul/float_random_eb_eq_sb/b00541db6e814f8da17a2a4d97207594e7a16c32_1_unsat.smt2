; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101101000100 #b0111011101110)
                arg1
                (fp #b1 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b1111111111111)
                arg1
                (fp #b0 #b01100111001100 #b1001000000101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111010001000 #b0110110010000)
                arg2
                (fp #b1 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b1111111111111)
                arg2
                (fp #b0 #b11011111101011 #b0101011101101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b11000011011101 #b1000011001101)
                expect
                (fp #b0 #b11111111111110 #b1111111111110)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111111110)
                expect
                (fp #b0 #b11111111111111 #b0000000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
