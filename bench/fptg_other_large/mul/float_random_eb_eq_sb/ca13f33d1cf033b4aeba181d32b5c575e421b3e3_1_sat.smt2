(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100010001110111 #b11101001110111)
                expect
                (fp #b1 #b100000000011011 #b10001100111101)))
(assert (fp.leq (fp #b1 #b100000000011011 #b10001100111101)
                expect
                (fp #b1 #b011001000011111 #b10001110101101)))

(assert (= expect result))

(check-sat)
