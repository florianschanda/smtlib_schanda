; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11001011011111 #b0011100000010)
                arg1
                (fp #b1 #b00000000000000 #b1010010010110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1010010010110)
                arg1
                (fp #b0 #b00100011110110 #b1110010100100)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b00101100101110 #b1000111100011)
                arg2
                (fp #b0 #b11011010010000 #b1101011001011)))
(assert (fp.leq (fp #b0 #b11011010010000 #b1101011001011)
                arg2
                (fp #b0 #b11111110011010 #b0001100011001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011000101010 #b1001101111010)
                expect
                (fp #b1 #b01011010010010 #b0010111010010)))
(assert (fp.leq (fp #b1 #b01011010010010 #b0010111010010)
                expect
                (fp #b0 #b01000110011100 #b1010011111110)))

(assert (= expect result))

(check-sat)
(exit)
