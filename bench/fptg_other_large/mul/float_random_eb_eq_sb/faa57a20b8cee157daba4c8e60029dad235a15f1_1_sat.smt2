(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111011001111 #b11000011111)
                arg1
                (fp #b1 #b110110011100 #b00111011110)))
(assert (fp.leq (fp #b1 #b110110011100 #b00111011110)
                arg1
                (fp #b1 #b110011100100 #b11111011111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111011100 #b10001011000)
                arg2
                (fp #b0 #b011010001000 #b01001001111)))
(assert (fp.leq (fp #b0 #b011010001000 #b01001001111)
                arg2
                (fp #b0 #b011101010100 #b00011100101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110111011 #b11110110001)
                expect
                (fp #b1 #b110000100101 #b10010110110)))
(assert (fp.leq (fp #b1 #b110000100101 #b10010110110)
                expect
                (fp #b1 #b101000110100 #b00000010101)))

(assert (= expect result))

(check-sat)
(exit)
