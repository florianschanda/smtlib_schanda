(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011110010000 #b0111001011001)
                arg1
                (fp #b1 #b00000000000000 #b0000000000001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000001)
                arg1
                (fp #b0 #b00100001100110 #b1011011011010)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00011100111111 #b0000101100110)
                arg2
                (fp #b1 #b00000000000000 #b0011111001000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0011111001000)
                arg2
                (fp #b0 #b01010000001011 #b0010100001010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010111111001 #b0001000010000)
                expect
                (fp #b0 #b00000000000000 #b0000000000001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000001)
                expect
                (fp #b0 #b10011111111110 #b1000001111100)))

(assert (= expect result))

(check-sat)
(exit)
