(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101001100 #b1000110100)
                arg1
                (fp #b0 #b10111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111)
                arg1
                (fp #b0 #b11111101000 #b1100000000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01011001110 #b1001111110)
                arg2
                (fp #b1 #b00000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000101100)
                arg2
                (fp #b0 #b00111001111 #b1110110000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101111001 #b1110100101)
                expect
                (fp #b1 #b01000000000 #b0001010111)))
(assert (fp.leq (fp #b1 #b01000000000 #b0001010111)
                expect
                (fp #b1 #b00100111010 #b0011011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
