; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0001001001111110 #b011011100110101)
                arg1
                (fp #b1 #b0000000000000000 #b100101111110110)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b100101111110110)
                arg1
                (fp #b0 #b0011100011101001 #b000111011000101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011010001001010 #b011100101101100)
                arg2
                (fp #b1 #b0111111111111111 #b110011000011011)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110011000011011)
                arg2
                (fp #b0 #b1010110100000010 #b001111011100011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0001001010010001 #b100011001101011)
                expect
                (fp #b0 #b0000000000000001 #b000100010001111)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b000100010001111)
                expect
                (fp #b0 #b0111110101100000 #b101110101110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
