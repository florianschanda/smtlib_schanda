; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1111111000 #b101000001)
                arg1
                (fp #b1 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111111)
                arg1
                (fp #b0 #b1000101111 #b110101110)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111110101 #b110010110)
                arg2
                (fp #b0 #b0000110011 #b101111111)))
(assert (fp.leq (fp #b0 #b0000110011 #b101111111)
                arg2
                (fp #b0 #b0001001110 #b111000100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000000010 #b101011010)
                expect
                (fp #b1 #b0100110011 #b101111110)))
(assert (fp.leq (fp #b1 #b0100110011 #b101111110)
                expect
                (fp #b0 #b1000101011 #b111110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
