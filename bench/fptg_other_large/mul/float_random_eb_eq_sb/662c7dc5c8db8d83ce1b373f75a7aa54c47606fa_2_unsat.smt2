(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b010111011 #b01010000)
                arg1
                (fp #b1 #b000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000 #b11111111)
                arg1
                (fp #b0 #b001110001 #b01100111)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001011001 #b10110110)
                arg2
                (fp #b1 #b000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000 #b01111101)
                arg2
                (fp #b0 #b011110010 #b01111000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b101110100 #b10000110)
                expect
                (fp #b0 #b000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b000000000 #b00000001)
                expect
                (fp #b0 #b100110011 #b11010110)))

(assert (not (= expect result)))

(check-sat)
(exit)
