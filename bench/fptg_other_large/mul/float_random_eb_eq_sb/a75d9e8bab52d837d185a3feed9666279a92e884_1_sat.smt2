; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111111101101101 #b01010110011000)
                arg1
                (fp #b1 #b000000000000000 #b00111010110000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00111010110000)
                arg1
                (fp #b0 #b001101110100000 #b01010101001011)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100000011101101 #b10111100001010)
                arg2
                (fp #b0 #b100000000001100 #b01001010010010)))
(assert (fp.leq (fp #b0 #b100000000001100 #b01001010010010)
                arg2
                (fp #b0 #b110000111011111 #b00010011010110)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100011001000010 #b10011001110000)
                expect
                (fp #b1 #b000000000001100 #b00101111001100)))
(assert (fp.leq (fp #b1 #b000000000001100 #b00101111001100)
                expect
                (fp #b0 #b011101001010111 #b00100001110011)))

(assert (= expect result))

(check-sat)
(exit)
