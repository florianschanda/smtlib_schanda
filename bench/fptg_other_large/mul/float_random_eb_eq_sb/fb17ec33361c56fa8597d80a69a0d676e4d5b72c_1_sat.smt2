(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100101111101 #b01000000001)
                arg1
                (fp #b1 #b011111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b011111111111 #b01100111111)
                arg1
                (fp #b1 #b011011100111 #b00010110000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011011110110 #b01001001010)
                arg2
                (fp #b0 #b011111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b011111111111 #b01111100000)
                arg2
                (fp #b0 #b111101100110 #b00010000001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101010110010 #b11111011111)
                expect
                (fp #b1 #b100000000000 #b00001011000)))
(assert (fp.leq (fp #b1 #b100000000000 #b00001011000)
                expect
                (fp #b0 #b100110001011 #b00011011011)))

(assert (= expect result))

(check-sat)
(exit)
