(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0110111100001 #b011111110000)
                arg1
                (fp #b0 #b0111111111111 #b001001111010)))
(assert (fp.leq (fp #b0 #b0111111111111 #b001001111010)
                arg1
                (fp #b0 #b1111110110100 #b010000111000)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b0001011000100 #b000110101011)
                expect
                (fp #b0 #b0111111111111 #b010101010111)))
(assert (fp.leq (fp #b0 #b0111111111111 #b010101010111)
                expect
                (fp #b0 #b1101110111011 #b101010011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
