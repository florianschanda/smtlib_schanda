                (fp #b0 #b011010001000 #b01001001111)))
(assert (fp.leq (fp #b0 #b011010001000 #b01001001111)
                arg2
                (fp #b0 #b101110110101 #b10101110101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011110101011 #b01100101110)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b100011100110 #b11110101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
