(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0000110000 #b111101000)
                arg1
                (fp #b0 #b0111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b0111111111 #b111111100)
                arg1
                (fp #b0 #b1111110110 #b111011011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0000010101 #b110100011)
                arg2
                (fp #b0 #b1001110111 #b101110100)))
(assert (fp.leq (fp #b0 #b1001110111 #b101110100)
                arg2
                (fp #b0 #b1011101100 #b001111110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111110101 #b000111001)
                expect
                (fp #b0 #b1001111000 #b101110001)))
(assert (fp.leq (fp #b0 #b1001111000 #b101110001)
                expect
                (fp #b0 #b1010100010 #b100110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
