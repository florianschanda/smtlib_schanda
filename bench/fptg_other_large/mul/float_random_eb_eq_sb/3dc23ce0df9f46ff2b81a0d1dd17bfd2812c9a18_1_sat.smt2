                (fp #b1 #b100110100100 #b11011001001)))
(assert (fp.leq (fp #b1 #b100110100100 #b11011001001)
                arg2
                (fp #b0 #b100001011110 #b00101010010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111110110 #b01010011001)
                expect
                (fp #b1 #b111111101111 #b01111001010)))
(assert (fp.leq (fp #b1 #b111111101111 #b01111001010)
                expect
                (fp #b0 #b111110010110 #b11101011100)))

(assert (= expect result))

(check-sat)
