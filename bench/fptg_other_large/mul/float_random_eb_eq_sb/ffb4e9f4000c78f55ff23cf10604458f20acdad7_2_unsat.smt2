                arg2
                (fp #b0 #b11000111011010 #b0100011000011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b0 #b10111111101101 #b0101010111010)
                expect
                (fp #b0 #b11000110110110 #b0101110110001)))
(assert (fp.leq (fp #b0 #b11000110110110 #b0101110110001)
                expect
                (fp #b0 #b11100101111111 #b0001100101100)))

(assert (not (= expect result)))

