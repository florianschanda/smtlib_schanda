(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110111101 #b000011001)
                arg1
                (fp #b1 #b1100001001 #b011011011)))
(assert (fp.leq (fp #b1 #b1100001001 #b011011011)
                arg1
                (fp #b1 #b1000010111 #b100011000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110101010 #b011010010)
                arg2
                (fp #b1 #b1101101000 #b001010101)))
(assert (fp.leq (fp #b1 #b1101101000 #b001010101)
                arg2
                (fp #b1 #b0101110111 #b101000101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1110101001 #b010100000)
                expect
                (fp #b0 #b1111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111111)
                expect
                (fp #b0 #b1111111111 #b000000000)))

(assert (= expect result))

(check-sat)
(exit)
