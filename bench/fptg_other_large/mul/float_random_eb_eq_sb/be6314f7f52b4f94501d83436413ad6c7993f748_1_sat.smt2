(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010101101 #b0011110011)
                arg1
                (fp #b1 #b00000000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000000 #b1110100001)
                arg1
                (fp #b0 #b10010100111 #b1111100000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01001100000 #b1000100100)
                arg2
                (fp #b0 #b00000000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000)
                arg2
                (fp #b0 #b11101100110 #b0001101010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01110100001 #b0100110111)
                expect
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b10110001111 #b0111010110)))

(assert (= expect result))

(check-sat)
(exit)
