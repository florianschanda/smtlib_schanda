                (fp #b0 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b0011111111111000 #b011010100000101)
                arg2
                (fp #b0 #b1011001000011110 #b100000110100011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0001100100100111 #b000110101000011)
                expect
                (fp #b0 #b1001000000100111 #b000111000111100)))
(assert (fp.leq (fp #b0 #b1001000000100111 #b000111000111100)
                expect
                (fp #b0 #b1111111111100001 #b110111100110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
