; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b0 #b00111111100111011 #b1100110011101000)
                arg1
                (fp #b0 #b10000000000001111 #b0010101011110000)))
(assert (fp.leq (fp #b0 #b10000000000001111 #b0010101011110000)
                arg1
                (fp #b0 #b11110011011101111 #b0110111100111010)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b0 #b01000011000010100 #b1001001111011101)
                expect
                (fp #b0 #b10000000000011111 #b0101110100010011)))
(assert (fp.leq (fp #b0 #b10000000000011111 #b0101110100010011)
                expect
                (fp #b0 #b11001011011111100 #b1011111001000111)))

(assert (= expect result))

(check-sat)
(exit)
