; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011110101 #b11010101)
                arg1
                (fp #b0 #b100110001 #b00100001)))
(assert (fp.leq (fp #b0 #b100110001 #b00100001)
                arg1
                (fp #b0 #b101011111 #b11100001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110010000 #b11001010)
                arg2
                (fp #b1 #b101001011 #b00101100)))
(assert (fp.leq (fp #b1 #b101001011 #b00101100)
                arg2
                (fp #b1 #b010011010 #b10011011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110100 #b10100001)
                expect
                (fp #b1 #b101111101 #b01010010)))
(assert (fp.leq (fp #b1 #b101111101 #b01010010)
                expect
                (fp #b1 #b010010001 #b11010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
