; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001000101 #b000100100)
                arg1
                (fp #b1 #b0000000001 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b000000000)
                arg1
                (fp #b0 #b0111110101 #b010101101)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0000110110 #b100001000)
                arg2
                (fp #b0 #b1000001000 #b001010110)))
(assert (fp.leq (fp #b0 #b1000001000 #b001010110)
                arg2
                (fp #b0 #b1101001010 #b111101011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111100111 #b011110011)
                expect
                (fp #b1 #b0000001010 #b001010110)))
(assert (fp.leq (fp #b1 #b0000001010 #b001010110)
                expect
                (fp #b0 #b0110000111 #b111110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
