(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101001010 #b111110000)
                arg1
                (fp #b0 #b0111111111 #b101000010)))
(assert (fp.leq (fp #b0 #b0111111111 #b101000010)
                arg1
                (fp #b0 #b1111001010 #b001101011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000001111 #b010011001)
                arg2
                (fp #b0 #b0000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b0000000000 #b100101010)
                arg2
                (fp #b0 #b0001110011 #b101011111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010110101 #b100111010)
                expect
                (fp #b0 #b0000000000 #b111100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b111100101)
                expect
                (fp #b0 #b1011011101 #b101110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
