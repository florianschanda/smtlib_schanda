; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111110100 #b00111000000)
                arg1
                (fp #b0 #b000000000000 #b10010110110)))
(assert (fp.leq (fp #b0 #b000000000000 #b10010110110)
                arg1
                (fp #b0 #b010011111110 #b00000110100)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100010101 #b01111001110)
                arg2
                (fp #b1 #b000000000001 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b00000000000)
                arg2
                (fp #b0 #b011110010111 #b11000000011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111001110110 #b10000110110)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b010001100011 #b10100011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
