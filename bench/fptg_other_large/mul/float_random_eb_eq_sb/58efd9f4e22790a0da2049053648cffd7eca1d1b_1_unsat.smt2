; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010100010 #b1110010101)
                arg1
                (fp #b1 #b10000001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10000001000 #b1101001010)
                arg1
                (fp #b0 #b01100100001 #b1001000101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010001101 #b1000010001)
                arg2
                (fp #b1 #b01111111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000100111)
                arg2
                (fp #b1 #b01110111110 #b0111001110)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110111000 #b0101101110)
                expect
                (fp #b0 #b10000001000 #b1110010001)))
(assert (fp.leq (fp #b0 #b10000001000 #b1110010001)
                expect
                (fp #b0 #b11001101100 #b1010100101)))

(assert (not (= expect result)))

(check-sat)
(exit)
