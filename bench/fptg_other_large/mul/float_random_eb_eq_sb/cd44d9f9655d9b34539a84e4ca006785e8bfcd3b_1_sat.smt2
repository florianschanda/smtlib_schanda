(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110011100 #b001010111)
                arg1
                (fp #b0 #b1001110010 #b011011010)))
(assert (fp.leq (fp #b0 #b1001110010 #b011011010)
                arg1
                (fp #b0 #b1100111100 #b111001111)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110110011 #b001101100)
                arg2
                (fp #b0 #b0000110011 #b101111111)))
(assert (fp.leq (fp #b0 #b0000110011 #b101111111)
                arg2
                (fp #b0 #b0100100000 #b010110101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0010010110 #b001101110)
                expect
                (fp #b0 #b0010100111 #b001111110)))
(assert (fp.leq (fp #b0 #b0010100111 #b001111110)
                expect
                (fp #b0 #b0101010111 #b111101110)))

(assert (= expect result))

(check-sat)
(exit)
