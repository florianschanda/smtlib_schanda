(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100000100001011 #b10100011100110)
                arg1
                (fp #b0 #b000000000000000 #b01110001001100)))
(assert (fp.leq (fp #b0 #b000000000000000 #b01110001001100)
                arg1
                (fp #b0 #b101100011101110 #b11110010011010)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
