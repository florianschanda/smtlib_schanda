(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b11010110011101100 #b0001101100010110)
                arg1
                (fp #b0 #b01111111111111111 #b0100001101010000)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b0100001101010000)
                arg1
                (fp #b0 #b10000010010110011 #b1011011000100000)))

(declare-const arg2 (_ FloatingPoint 17 17))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 17 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 17))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
