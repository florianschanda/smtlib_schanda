; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011110101 #b0001101101)
                arg1
                (fp #b1 #b10000001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10000001000 #b1101001010)
                arg1
                (fp #b0 #b01111101111 #b1000111101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10110011011 #b1101000111)
                arg2
                (fp #b1 #b10010100010 #b0000000111)))
(assert (fp.leq (fp #b1 #b10010100010 #b0000000111)
                arg2
                (fp #b0 #b00100111000 #b0100101010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01010110011 #b1000001001)
                expect
                (fp #b0 #b10010101011 #b1101010110)))
(assert (fp.leq (fp #b0 #b10010101011 #b1101010110)
                expect
                (fp #b0 #b11010001110 #b1001101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
