(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111100110 #b0101101001010)
                arg1
                (fp #b1 #b11111010101000 #b1111010011101)))
(assert (fp.leq (fp #b1 #b11111010101000 #b1111010011101)
                arg1
                (fp #b0 #b01010100110100 #b1011101001100)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010101110101 #b1001010100011)
                arg2
                (fp #b0 #b10000000001100 #b1110010010000)))
(assert (fp.leq (fp #b0 #b10000000001100 #b1110010010000)
                arg2
                (fp #b0 #b10001001010111 #b0001101010100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111100101000 #b0110010000100)
                expect
                (fp #b1 #b11111010110110 #b1101101000000)))
(assert (fp.leq (fp #b1 #b11111010110110 #b1101101000000)
                expect
                (fp #b0 #b00110010010011 #b1011110001101)))

(assert (= expect result))

(check-sat)
(exit)
