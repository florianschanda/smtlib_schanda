(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111011001110 #b0110010011110)
                arg1
                (fp #b1 #b10111111111110 #b1111111111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b1111111111111)
                arg1
                (fp #b0 #b01010011000010 #b1001010100101)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010001011011 #b0100110111000)
                arg2
                (fp #b1 #b00000111110111 #b1110101001101)))
(assert (fp.leq (fp #b1 #b00000111110111 #b1110101001101)
                arg2
                (fp #b0 #b10011100011111 #b0010010111101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10010101000110 #b1001110001101)
                expect
                (fp #b0 #b01000111110111 #b1110101001101)))
(assert (fp.leq (fp #b0 #b01000111110111 #b1110101001101)
                expect
                (fp #b0 #b11011000101000 #b0011100110111)))

(assert (= expect result))

(check-sat)
(exit)
