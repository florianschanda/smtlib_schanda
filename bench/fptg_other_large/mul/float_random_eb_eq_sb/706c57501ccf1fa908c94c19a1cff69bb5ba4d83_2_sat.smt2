;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1011000100000101 #b011110001101100)
                arg1
                (fp #b1 #b0000000000000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010010100000101)
                arg1
                (fp #b0 #b1110011011111010 #b010001110110011)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101110101111000 #b010110100101101)
                arg2
                (fp #b0 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010011101010000 #b001001101011011)
                expect
                (fp #b1 #b0111111111111111 #b001010000010100)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b001010000010100)
                expect
                (fp #b0 #b1001100101100110 #b100110101110101)))

(assert (= expect result))

(check-sat)
(exit)
