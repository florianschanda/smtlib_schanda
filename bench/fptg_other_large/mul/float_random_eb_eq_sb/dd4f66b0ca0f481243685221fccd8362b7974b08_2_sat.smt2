(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b100100010001 #b00111000110)
                arg1
                (fp #b0 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b11111111111)
                arg1
                (fp #b0 #b110100101011 #b11010011000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010110101100 #b10011011110)
                arg2
                (fp #b1 #b010010100111 #b00001001011)))
(assert (fp.leq (fp #b1 #b010010100111 #b00001001011)
                arg2
                (fp #b0 #b011000000000 #b00111010010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010001010 #b01101110100)
                expect
                (fp #b1 #b100010100111 #b00001001011)))
(assert (fp.leq (fp #b1 #b100010100111 #b00001001011)
                expect
                (fp #b0 #b000101110001 #b01001000000)))

(assert (= expect result))

(check-sat)
(exit)
