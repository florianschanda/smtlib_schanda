(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011011110101 #b0010001000100)
                arg1
                (fp #b1 #b01111111111111 #b1100001000110)))
(assert (fp.leq (fp #b1 #b01111111111111 #b1100001000110)
                arg1
                (fp #b1 #b01101000100000 #b1000011111110)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00001010101111 #b0110001000000)
                arg2
                (fp #b0 #b00001111100001 #b1001111010110)))
(assert (fp.leq (fp #b0 #b00001111100001 #b1001111010110)
                arg2
                (fp #b0 #b11011111100011 #b0000111010010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10111111101100 #b0101110011101)
                expect
                (fp #b1 #b00001111100010 #b0110110010100)))
(assert (fp.leq (fp #b1 #b00001111100010 #b0110110010100)
                expect
                (fp #b0 #b01010001100011 #b0101001011000)))

(assert (= expect result))

(check-sat)
(exit)
