;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100001100010 #b0010100110100)
                arg1
                (fp #b1 #b00000000000000 #b1010010010110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1010010010110)
                arg1
                (fp #b0 #b00010101101101 #b1111101010010)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001111111111 #b1010001011101)
                arg2
                (fp #b0 #b10000000001100 #b1110010010000)))
(assert (fp.leq (fp #b0 #b10000000001100 #b1110010010000)
                arg2
                (fp #b0 #b11100100011111 #b1100010100001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00001101101010 #b1100101010010)
                expect
                (fp #b1 #b00000000001110 #b0011011110110)))
(assert (fp.leq (fp #b1 #b00000000001110 #b0011011110110)
                expect
                (fp #b0 #b00001011010000 #b1101000101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
