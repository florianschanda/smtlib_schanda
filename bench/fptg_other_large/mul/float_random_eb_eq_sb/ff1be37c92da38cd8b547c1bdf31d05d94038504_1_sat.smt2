; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011010 #b111001101)
                arg1
                (fp #b0 #b1011100011 #b101000100)))
(assert (fp.leq (fp #b0 #b1011100011 #b101000100)
                arg1
                (fp #b0 #b1101000110 #b110011001)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001101110 #b100000111)
                arg2
                (fp #b1 #b0111001011 #b101101101)))
(assert (fp.leq (fp #b1 #b0111001011 #b101101101)
                arg2
                (fp #b0 #b1101101110 #b111000010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010111100 #b010100110)
                expect
                (fp #b1 #b1010110000 #b011001011)))
(assert (fp.leq (fp #b1 #b1010110000 #b011001011)
                expect
                (fp #b0 #b1010101111 #b110101011)))

(assert (= expect result))

(check-sat)
(exit)
