(assert (fp.leq (fp #b0 #b11011111000000 #b0111001101001)
                arg2
                (fp #b0 #b11100001010110 #b1100110010100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11101110111010 #b0111101110000)
                expect
                (fp #b1 #b11011111001101 #b1001100001100)))
(assert (fp.leq (fp #b1 #b11011111001101 #b1001100001100)
                expect
                (fp #b0 #b10110000010110 #b1111100111011)))

(assert (= expect result))

(check-sat)
