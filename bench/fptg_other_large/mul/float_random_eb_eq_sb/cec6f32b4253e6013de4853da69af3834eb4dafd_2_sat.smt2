; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100101100001 #b10100101101)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b1 #b010101100011 #b11010111111)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011011000 #b11010001001)
                arg2
                (fp #b1 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b11111111111)
                arg2
                (fp #b0 #b010000000100 #b10101011111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b100111011010 #b01100011001)
                expect
                (fp #b0 #b110000100000 #b01101001011)))
(assert (fp.leq (fp #b0 #b110000100000 #b01101001011)
                expect
                (fp #b0 #b111001010111 #b10101010010)))

(assert (= expect result))

(check-sat)
(exit)
