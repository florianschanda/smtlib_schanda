; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010110101100 #b01100101000)
                arg1
                (fp #b1 #b000000000000 #b10011011110)))
(assert (fp.leq (fp #b1 #b000000000000 #b10011011110)
                arg1
                (fp #b0 #b100101110001 #b00011010110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110011010101 #b10101101010)
                arg2
                (fp #b1 #b101001111100 #b10100010001)))
(assert (fp.leq (fp #b1 #b101001111100 #b10100010001)
                arg2
                (fp #b0 #b000011101100 #b10100111111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011110111111 #b00000111010)
                expect
                (fp #b0 #b001001111101 #b11111100111)))
(assert (fp.leq (fp #b0 #b001001111101 #b11111100111)
                expect
                (fp #b0 #b110110001011 #b01000101110)))

(assert (= expect result))

(check-sat)
(exit)
