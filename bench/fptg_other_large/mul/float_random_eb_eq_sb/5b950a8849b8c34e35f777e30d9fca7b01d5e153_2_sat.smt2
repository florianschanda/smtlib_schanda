(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111011111 #b10111101)
                arg1
                (fp #b1 #b100000100 #b01111000)))
(assert (fp.leq (fp #b1 #b100000100 #b01111000)
                arg1
                (fp #b0 #b001011011 #b10110110)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111001010 #b11110101)
                arg2
                (fp #b1 #b000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000 #b01111101)
                arg2
                (fp #b0 #b001101000 #b10001100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001100010 #b00110101)
                expect
                (fp #b0 #b000000101 #b01110000)))
(assert (fp.leq (fp #b0 #b000000101 #b01110000)
                expect
                (fp #b0 #b011011101 #b00101011)))

(assert (= expect result))

(check-sat)
(exit)
