;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101110100000 #b00101011101)
                arg1
                (fp #b0 #b000000000000 #b00100000110)))
(assert (fp.leq (fp #b0 #b000000000000 #b00100000110)
                arg1
                (fp #b0 #b111100100010 #b01101100000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110000100 #b10011001111)
                arg2
                (fp #b1 #b000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000000000)
                arg2
                (fp #b0 #b010111010111 #b11110100111)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110110010110 #b00011110101)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b110111011001 #b10011000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
