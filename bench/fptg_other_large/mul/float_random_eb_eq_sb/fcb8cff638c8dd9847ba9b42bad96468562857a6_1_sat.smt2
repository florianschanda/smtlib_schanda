; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0010111000011 #b111100110001)
                arg1
                (fp #b0 #b1000000001000 #b100100011000)))
(assert (fp.leq (fp #b0 #b1000000001000 #b100100011000)
                arg1
                (fp #b0 #b1111001110101 #b110110110001)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111111111101 #b100111110000)
                arg2
                (fp #b1 #b1111111111101 #b000000000000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b000000000000)
                arg2
                (fp #b1 #b0100111010110 #b010100101001)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111111111111 #b000000000000)
                expect
                (fp #b1 #b1111111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b111111111111)
                expect
                (fp #b0 #b1110011100001 #b100001101010)))

(assert (= expect result))

(check-sat)
(exit)
