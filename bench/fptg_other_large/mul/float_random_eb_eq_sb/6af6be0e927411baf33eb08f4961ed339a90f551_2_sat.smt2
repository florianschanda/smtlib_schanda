(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1010100110000 #b101011011100)
                arg1
                (fp #b0 #b1000000001011 #b010101111110)))
(assert (fp.leq (fp #b0 #b1000000001011 #b010101111110)
                arg1
                (fp #b0 #b1101111000110 #b000000101111)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b0100101001010 #b000010000101)
                expect
                (fp #b0 #b1000000010111 #b110011011111)))
(assert (fp.leq (fp #b0 #b1000000010111 #b110011011111)
                expect
                (fp #b0 #b1101100001011 #b000111011100)))

(assert (= expect result))

(check-sat)
(exit)
