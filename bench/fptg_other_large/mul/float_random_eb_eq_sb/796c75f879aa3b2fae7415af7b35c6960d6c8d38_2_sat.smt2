; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100101110110 #b1011100000100)
                arg1
                (fp #b0 #b00000000000000 #b1101100101001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1101100101001)
                arg1
                (fp #b0 #b00010010110001 #b0010011000111)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11001010110000 #b0001101010110)
                arg2
                (fp #b1 #b11000001100001 #b0001111011101)))
(assert (fp.leq (fp #b1 #b11000001100001 #b0001111011101)
                arg2
                (fp #b1 #b00111101010100 #b1001101000101)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001001100000 #b1111011011101)
                expect
                (fp #b1 #b01000001100010 #b1110011100001)))
(assert (fp.leq (fp #b1 #b01000001100010 #b1110011100001)
                expect
                (fp #b1 #b00010100010001 #b1011000000010)))

(assert (= expect result))

(check-sat)
(exit)
