(assert (fp.leq (fp #b1 #b00001111011010111 #b0111000001000110)
                expect
                (fp #b0 #b00000000000000000 #b0000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000000000000000)
                expect
                (fp #b0 #b00100100001001011 #b0011011101001000)))

(assert (= expect result))

(check-sat)
