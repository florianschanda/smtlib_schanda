; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b000111011111000100 #b01011101010111000)
                arg2
                (fp #b1 #b000000000000000000 #b11000100111101100)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b11000100111101100)
                arg2
                (fp #b0 #b010100000010110101 #b01000111101100110)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
