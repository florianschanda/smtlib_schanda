; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1100011110101 #b000010110111)
                arg1
                (fp #b1 #b1000000001000 #b010011111000)))
(assert (fp.leq (fp #b1 #b1000000001000 #b010011111000)
                arg1
                (fp #b0 #b1100111110111 #b010010000011)))

(declare-const arg2 (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1110111111001 #b110000001100)
                arg2
                (fp #b1 #b0000000000000 #b101011101010)))
(assert (fp.leq (fp #b1 #b0000000000000 #b101011101010)
                arg2
                (fp #b0 #b1001000010100 #b010111110100)))

(declare-const result (_ FloatingPoint 13 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1111001101100 #b100100000010)
                expect
                (fp #b0 #b0000000001001 #b110010011100)))
(assert (fp.leq (fp #b0 #b0000000001001 #b110010011100)
                expect
                (fp #b0 #b1010001011100 #b010110101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
