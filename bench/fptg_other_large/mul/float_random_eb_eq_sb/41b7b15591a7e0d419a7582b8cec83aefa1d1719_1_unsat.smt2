(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101011101 #b0010111000)
                arg1
                (fp #b1 #b10000000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000100000)
                arg1
                (fp #b0 #b11100111000 #b0100010100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11011011001 #b1010000010)
                arg2
                (fp #b1 #b01000011101 #b0111100011)))
(assert (fp.leq (fp #b1 #b01000011101 #b0111100011)
                arg2
                (fp #b0 #b01010101111 #b1101010111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00101011111 #b1101001100)
                expect
                (fp #b0 #b01000100101 #b1000010010)))
(assert (fp.leq (fp #b0 #b01000100101 #b1000010010)
                expect
                (fp #b0 #b11001011101 #b1010011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
