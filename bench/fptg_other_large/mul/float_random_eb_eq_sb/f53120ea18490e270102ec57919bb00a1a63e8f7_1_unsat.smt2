                arg2
                (fp #b1 #b011111111101000 #b10010101000000)))
(assert (fp.leq (fp #b1 #b011111111101000 #b10010101000000)
                arg2
                (fp #b0 #b000111110000011 #b01010010100010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b0 #b100110000100101 #b01011110101111)
                expect
                (fp #b0 #b101111111101000 #b10010100111111)))
(assert (fp.leq (fp #b0 #b101111111101000 #b10010100111111)
                expect
                (fp #b0 #b111111000101000 #b01100110110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
