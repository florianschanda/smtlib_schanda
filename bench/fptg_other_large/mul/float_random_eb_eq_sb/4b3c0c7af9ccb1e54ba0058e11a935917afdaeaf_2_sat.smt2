; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01010110100 #b0101101101)
                arg1
                (fp #b0 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000)
                arg1
                (fp #b0 #b11111001000 #b1010101101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00001100101 #b1010100110)
                arg2
                (fp #b0 #b00111111011 #b0000000000)))
(assert (fp.leq (fp #b0 #b00111111011 #b0000000000)
                arg2
                (fp #b0 #b11010100101 #b1011001001)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00101000111 #b0001011101)
                expect
                (fp #b0 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b11010101010 #b0100011001)))

(assert (= expect result))

(check-sat)
(exit)
