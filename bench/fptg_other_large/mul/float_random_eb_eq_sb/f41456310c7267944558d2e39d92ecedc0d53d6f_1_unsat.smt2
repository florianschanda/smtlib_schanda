; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011010101 #b10111101)
                arg1
                (fp #b1 #b000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b000000000 #b00010010)
                arg1
                (fp #b0 #b001111010 #b10101000)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011010110 #b00000000)
                arg2
                (fp #b0 #b000001010 #b00011001)))
(assert (fp.leq (fp #b0 #b000001010 #b00011001)
                arg2
                (fp #b0 #b111000011 #b00100010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111011110 #b01111011)
                expect
                (fp #b1 #b000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000000)
                expect
                (fp #b0 #b100000000 #b01111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
