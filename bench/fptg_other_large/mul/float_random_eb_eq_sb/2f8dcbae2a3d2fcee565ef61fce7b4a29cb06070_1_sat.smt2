(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10001011001 #b0100111100)
                arg1
                (fp #b1 #b10000001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b10000001000 #b1101001010)
                arg1
                (fp #b0 #b00100111101 #b1111010011)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01111010000 #b1110110000)
                arg2
                (fp #b0 #b01111111111 #b0100011010)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100011010)
                arg2
                (fp #b0 #b11110110011 #b1101100011)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111000001 #b0010001010)
                expect
                (fp #b1 #b10000001001 #b0010100101)))
(assert (fp.leq (fp #b1 #b10000001001 #b0010100101)
                expect
                (fp #b0 #b11110011010 #b1101111101)))

(assert (= expect result))

(check-sat)
(exit)
