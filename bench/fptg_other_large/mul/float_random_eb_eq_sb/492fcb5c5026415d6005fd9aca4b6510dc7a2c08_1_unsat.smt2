;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00011100010111 #b0100100001000)
                arg1
                (fp #b0 #b01010100011110 #b1100100010010)))
(assert (fp.leq (fp #b0 #b01010100011110 #b1100100010010)
                arg1
                (fp #b0 #b11011010011100 #b1110111000110)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01100100001111 #b1101101110010)
                arg2
                (fp #b0 #b00000000000000 #b0110101110101)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0110101110101)
                arg2
                (fp #b0 #b00101000111100 #b0110011001001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010110010100 #b1111010100011)
                expect
                (fp #b0 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b00100000001101 #b0011010001101)))

(assert (not (= expect result)))

(check-sat)
(exit)
