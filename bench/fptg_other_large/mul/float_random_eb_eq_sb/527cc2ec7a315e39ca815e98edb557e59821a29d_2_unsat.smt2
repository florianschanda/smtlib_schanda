;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111110110 #b0001110011)
                arg1
                (fp #b1 #b10000000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000100000)
                arg1
                (fp #b1 #b01011000000 #b0001111110)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00100000000 #b0111110000)
                arg2
                (fp #b0 #b10110010001 #b0110101010)))
(assert (fp.leq (fp #b0 #b10110010001 #b0110101010)
                arg2
                (fp #b0 #b11010000000 #b1110100101)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11000010000 #b1011011011)
                expect
                (fp #b1 #b10110011001 #b0111011000)))
(assert (fp.leq (fp #b1 #b10110011001 #b0111011000)
                expect
                (fp #b1 #b01101010000 #b1001010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
