; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001000111100 #b11010111000)
                arg1
                (fp #b0 #b101000111000 #b00001000010)))
(assert (fp.leq (fp #b0 #b101000111000 #b00001000010)
                arg1
                (fp #b0 #b110111011110 #b11110010011)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000111001000 #b10010111111)
                arg2
                (fp #b0 #b101110001000 #b10100011011)))
(assert (fp.leq (fp #b0 #b101110001000 #b10100011011)
                arg2
                (fp #b0 #b111011110010 #b01000010101)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001010101010 #b01001101100)
                expect
                (fp #b0 #b110111000001 #b10110001000)))
(assert (fp.leq (fp #b0 #b110111000001 #b10110001000)
                expect
                (fp #b0 #b111111011110 #b01100111001)))

(assert (= expect result))

(check-sat)
(exit)
