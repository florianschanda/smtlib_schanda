(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111001100111 #b01001101101)
                arg1
                (fp #b1 #b000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000000000)
                arg1
                (fp #b0 #b001000001111 #b10110101001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100101000 #b11100010110)
                arg2
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                arg2
                (fp #b0 #b111110101110 #b00111001011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b001000010110 #b10110110000)
                expect
                (fp #b1 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b011001110100 #b10000100100)))

(assert (= expect result))

(check-sat)
(exit)
