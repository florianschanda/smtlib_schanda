(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0101000101 #b111101101)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b1001010000 #b001110010)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111010 #b110110011)
                arg2
                (fp #b1 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b111111111)
                arg2
                (fp #b0 #b1011100001 #b101111110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101101100 #b010001110)
                expect
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0100111011 #b100110000)))

(assert (= expect result))

(check-sat)
(exit)
