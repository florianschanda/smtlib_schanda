(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01100101100 #b1000111011)
                arg1
                (fp #b1 #b01100100100 #b1111100011)))
(assert (fp.leq (fp #b1 #b01100100100 #b1111100011)
                arg1
                (fp #b0 #b11100110001 #b1110000100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10010000010 #b0110111111)
                arg2
                (fp #b0 #b00000000000 #b0100000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000)
                arg2
                (fp #b0 #b00001101011 #b0001111010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00001000101 #b1001111011)
                expect
                (fp #b1 #b00000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000001)
                expect
                (fp #b0 #b10111010110 #b0010000010)))

(assert (= expect result))

(check-sat)
(exit)
