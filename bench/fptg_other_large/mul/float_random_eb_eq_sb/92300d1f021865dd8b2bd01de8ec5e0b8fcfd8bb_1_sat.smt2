; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101011011001010 #b110011110000111)
                arg1
                (fp #b1 #b0000000000000000 #b100101111110110)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b100101111110110)
                arg1
                (fp #b0 #b1001001001000100 #b111000100010000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111110101010010 #b101000011000110)
                arg2
                (fp #b0 #b1001100111011001 #b001111010110111)))
(assert (fp.leq (fp #b0 #b1001100111011001 #b001111010110111)
                arg2
                (fp #b0 #b1100100111110100 #b011111001110001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101101111011101 #b111101100001101)
                expect
                (fp #b1 #b0001100111011010 #b011110001100000)))
(assert (fp.leq (fp #b1 #b0001100111011010 #b011110001100000)
                expect
                (fp #b1 #b0000011100011101 #b110010011010010)))

(assert (= expect result))

(check-sat)
(exit)
