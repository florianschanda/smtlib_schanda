(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101111101 #b001010010)
                arg1
                (fp #b1 #b1011111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111111)
                arg1
                (fp #b1 #b1000000101 #b001101000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000101111 #b010100000)
                arg2
                (fp #b1 #b0111111111 #b001111111)))
(assert (fp.leq (fp #b1 #b0111111111 #b001111111)
                arg2
                (fp #b0 #b0110001111 #b011101101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b1001001000 #b000001000)
                expect
                (fp #b0 #b1011111111 #b001111110)))
(assert (fp.leq (fp #b0 #b1011111111 #b001111110)
                expect
                (fp #b0 #b1100000111 #b111111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
