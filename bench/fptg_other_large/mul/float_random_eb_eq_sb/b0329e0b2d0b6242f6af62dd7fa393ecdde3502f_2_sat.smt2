(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000011100101010 #b111111000001010)
                arg1
                (fp #b1 #b0011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b1 #b0011111111111000 #b011010100000101)
                arg1
                (fp #b0 #b1011101000100000 #b100100010111110)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000000000000)
                arg2
                (fp #b1 #b1111111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111111111111)
                arg2
                (fp #b1 #b0000011110000100 #b110110011111101)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0110100101011101 #b010000110100101)
                expect
                (fp #b0 #b1011111111111000 #b011010100000101)))
(assert (fp.leq (fp #b0 #b1011111111111000 #b011010100000101)
                expect
                (fp #b0 #b1111010100100010 #b110110110110110)))

(assert (= expect result))

(check-sat)
(exit)
