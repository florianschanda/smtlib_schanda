; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110101010011010111 #b00100110010000100)
                arg1
                (fp #b1 #b011111111111111111 #b01001001101111010)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b01001001101111010)
                arg1
                (fp #b0 #b110001111100111000 #b01010011010010100)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110110100110100101 #b10100101000011010)
                arg2
                (fp #b1 #b110001000010110110 #b10001101111111010)))
(assert (fp.leq (fp #b1 #b110001000010110110 #b10001101111111010)
                arg2
                (fp #b1 #b100011010011010110 #b01111101011100010)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111110100011000000 #b01111100101011110)
                expect
                (fp #b0 #b110001000010110111 #b00000000010100000)))
(assert (fp.leq (fp #b0 #b110001000010110111 #b00000000010100000)
                expect
                (fp #b0 #b110011001011111101 #b11000011011011000)))

(assert (= expect result))

(check-sat)
(exit)
