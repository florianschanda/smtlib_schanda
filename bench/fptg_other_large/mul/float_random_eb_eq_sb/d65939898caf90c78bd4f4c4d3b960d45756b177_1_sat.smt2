; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010000101 #b0101111001)
                arg1
                (fp #b1 #b01111111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1111110100)
                arg1
                (fp #b1 #b01110111110 #b0110000101)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111111101 #b1000001101)
                arg2
                (fp #b1 #b00000000001 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000)
                arg2
                (fp #b0 #b00010111111 #b0100101111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b00001001011 #b1101111001)
                expect
                (fp #b0 #b00000000001 #b1111110100)))
(assert (fp.leq (fp #b0 #b00000000001 #b1111110100)
                expect
                (fp #b0 #b01100101110 #b1111101010)))

(assert (= expect result))

(check-sat)
(exit)
