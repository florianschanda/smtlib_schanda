;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111001110 #b11111100110)
                arg1
                (fp #b1 #b110100100011 #b00110111000)))
(assert (fp.leq (fp #b1 #b110100100011 #b00110111000)
                arg1
                (fp #b1 #b001100100010 #b00000101010)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111110111 #b00011100011)
                arg2
                (fp #b1 #b010010100111 #b00001001011)))
(assert (fp.leq (fp #b1 #b010010100111 #b00001001011)
                arg2
                (fp #b0 #b100010001001 #b11110100000)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000111001100 #b01001101000)
                expect
                (fp #b0 #b100111001011 #b01000010100)))
(assert (fp.leq (fp #b0 #b100111001011 #b01000010100)
                expect
                (fp #b0 #b110001001101 #b10010001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
