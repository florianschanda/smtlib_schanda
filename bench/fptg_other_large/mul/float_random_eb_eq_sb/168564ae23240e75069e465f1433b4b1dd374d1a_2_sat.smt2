; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110101111110001 #b010001111010110)
                arg1
                (fp #b1 #b1000000000001010 #b001010101000000)))
(assert (fp.leq (fp #b1 #b1000000000001010 #b001010101000000)
                arg1
                (fp #b0 #b0001110101011011 #b100010001001101)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101100001010110 #b001111010111101)
                arg2
                (fp #b1 #b1100010001011010 #b111000111000010)))
(assert (fp.leq (fp #b1 #b1100010001011010 #b111000111000010)
                arg2
                (fp #b1 #b0000110001110111 #b000110101111100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0101100011101000 #b010000100001011)
                expect
                (fp #b0 #b1100010001100110 #b000110011110011)))
(assert (fp.leq (fp #b0 #b1100010001100110 #b000110011110011)
                expect
                (fp #b0 #b1110101001111101 #b010110001001000)))

(assert (= expect result))

(check-sat)
(exit)
