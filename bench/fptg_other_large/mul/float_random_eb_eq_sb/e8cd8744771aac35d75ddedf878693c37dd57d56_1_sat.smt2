(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010001010 #b0010001000)
                arg1
                (fp #b0 #b10000001001 #b1010000111)))
(assert (fp.leq (fp #b0 #b10000001001 #b1010000111)
                arg1
                (fp #b0 #b10101010011 #b1101000100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10000110110 #b0100101011)
                expect
                (fp #b1 #b10000010100 #b0101010011)))
(assert (fp.leq (fp #b1 #b10000010100 #b0101010011)
                expect
                (fp #b1 #b00101011000 #b0111110001)))

(assert (= expect result))

(check-sat)
(exit)
