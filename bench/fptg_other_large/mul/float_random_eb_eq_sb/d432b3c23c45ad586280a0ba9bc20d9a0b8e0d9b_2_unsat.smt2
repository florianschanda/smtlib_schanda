; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11000100011101 #b0111010111000)
                arg1
                (fp #b1 #b00111111111001 #b0110101000001)))
(assert (fp.leq (fp #b1 #b00111111111001 #b0110101000001)
                arg1
                (fp #b0 #b11010111110010 #b1011000101000)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111101100000 #b1000100011110)
                arg2
                (fp #b1 #b00000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111000000111)
                arg2
                (fp #b0 #b11001111000110 #b1100000110011)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00000100011001 #b0111111001100)
                expect
                (fp #b0 #b00000000000000 #b0000000000001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000000001)
                expect
                (fp #b0 #b00100010101110 #b1000001011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
