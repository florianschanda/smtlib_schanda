                arg2
                (fp #b0 #b101111010 #b00100100)))
(assert (fp.leq (fp #b0 #b101111010 #b00100100)
                arg2
                (fp #b0 #b111100010 #b10010000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111001 #b00100101)
                expect
                (fp #b0 #b001111100 #b00100011)))
(assert (fp.leq (fp #b0 #b001111100 #b00100011)
                expect
                (fp #b0 #b011001101 #b10100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
