(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111011011 #b11100100110)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b0 #b000010011100 #b10101000101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000000)
                arg2
                (fp #b1 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111111)
                arg2
                (fp #b0 #b011111110101 #b11111100110)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b100111111010 #b10111110110)
                expect
                (fp #b0 #b111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111111)
                expect
                (fp #b0 #b111111111111 #b00000000000)))

(assert (= expect result))

(check-sat)
(exit)
