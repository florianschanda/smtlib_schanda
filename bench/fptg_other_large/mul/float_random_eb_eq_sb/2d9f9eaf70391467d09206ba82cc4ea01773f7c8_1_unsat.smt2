;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01111101100111 #b0101110110100)
                arg1
                (fp #b0 #b00000000000000 #b0100000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000000000)
                arg1
                (fp #b0 #b01110000100100 #b1000000101101)))

(declare-const arg2 (_ FloatingPoint 14 14))
