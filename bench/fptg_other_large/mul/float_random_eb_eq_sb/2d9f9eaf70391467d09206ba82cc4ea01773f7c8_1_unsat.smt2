                arg2
                (fp #b1 #b00000000000000 #b0011111001000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0011111001000)
                arg2
                (fp #b0 #b01110011101010 #b0000010100100)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11110100110001 #b0111010001001)
                expect
                (fp #b1 #b00000000000000 #b0000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000)
                expect
                (fp #b0 #b01111111011111 #b0100001000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
