;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111110001110100110 #b00100100101111011)
                arg1
                (fp #b1 #b111100100010101110 #b10100100000110111)))
(assert (fp.leq (fp #b1 #b111100100010101110 #b10100100000110111)
                arg1
                (fp #b0 #b011110010000000000 #b01110110110101100)))

(declare-const arg2 (_ FloatingPoint 18 18))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b0 #b100010010000100101 #b10100011001000100)
                expect
                (fp #b0 #b111111111111111110 #b11111111111111111)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b11111111111111111)
                expect
                (fp #b0 #b111111111111111111 #b00000000000000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
