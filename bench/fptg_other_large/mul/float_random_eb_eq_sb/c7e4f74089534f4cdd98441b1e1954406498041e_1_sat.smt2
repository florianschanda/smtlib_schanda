(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100110100 #b10100010001)
                arg1
                (fp #b1 #b000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111111)
                arg1
                (fp #b0 #b100010101101 #b11010100001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
