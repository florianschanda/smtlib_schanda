; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101000110110000 #b010100111100101)
                arg1
                (fp #b0 #b1000000000001110 #b000110010000101)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b000110010000101)
                arg1
                (fp #b0 #b1000010000001101 #b011010000100000)))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1100000110111011 #b000001101100001)
                arg2
                (fp #b1 #b1010010000010100 #b010001111001010)))
(assert (fp.leq (fp #b1 #b1010010000010100 #b010001111001010)
                arg2
                (fp #b0 #b0110000000111011 #b111000010100010)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110110111001111 #b010001001011111)
                expect
                (fp #b1 #b1010010000100011 #b011001111001111)))
(assert (fp.leq (fp #b1 #b1010010000100011 #b011001111001111)
                expect
                (fp #b0 #b0100101010010110 #b011010011001010)))

(assert (= expect result))

(check-sat)
(exit)
