(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111101011110000001 #b01001001010000100)
                expect
                (fp #b1 #b110000001110000011 #b10011100010011111)))
(assert (fp.leq (fp #b1 #b110000001110000011 #b10011100010011111)
                expect
                (fp #b1 #b101000110011110101 #b01000000101110101)))

(assert (not (= expect result)))

