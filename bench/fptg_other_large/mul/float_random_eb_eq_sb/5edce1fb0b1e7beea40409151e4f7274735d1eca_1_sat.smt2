(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011101010101110010 #b10001101110010011)
                expect
                (fp #b1 #b000000000000000000 #b00000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00000000000000000)
                expect
                (fp #b0 #b101010000110110001 #b00010000000111110)))

(assert (= expect result))

(check-sat)
