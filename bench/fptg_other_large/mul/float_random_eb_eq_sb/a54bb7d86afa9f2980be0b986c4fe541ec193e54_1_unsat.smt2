(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11110001000 #b0010101110)
                arg1
                (fp #b1 #b01111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0011010000)
                arg1
                (fp #b1 #b01001111010 #b1111011010)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10011111101 #b1100110101)
                arg2
                (fp #b0 #b00000000000 #b1111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111)
                arg2
                (fp #b0 #b01000110001 #b1101111100)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10101100010 #b1000001100)
                expect
                (fp #b1 #b00000000001 #b0011001110)))
(assert (fp.leq (fp #b1 #b00000000001 #b0011001110)
                expect
                (fp #b0 #b01101111011 #b1111000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
