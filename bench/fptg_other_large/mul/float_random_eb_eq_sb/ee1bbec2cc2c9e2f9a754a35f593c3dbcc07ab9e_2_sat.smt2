; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01001100101010 #b1011100101000)
                arg1
                (fp #b1 #b00000011011110 #b0111000011110)))
(assert (fp.leq (fp #b1 #b00000011011110 #b0111000011110)
                arg1
                (fp #b0 #b00111010111000 #b1100110111110)))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011001001110 #b0111000000001)
                arg2
                (fp #b1 #b10000000000100 #b1100100000000)))
(assert (fp.leq (fp #b1 #b10000000000100 #b1100100000000)
                arg2
                (fp #b0 #b01101100111101 #b0010000100111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10011100101000 #b1100011000011)
                expect
                (fp #b0 #b00000011100100 #b0100100010011)))
(assert (fp.leq (fp #b0 #b00000011100100 #b0100100010011)
                expect
                (fp #b0 #b10011100100000 #b0101110101100)))

(assert (= expect result))

(check-sat)
(exit)
