(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011011011 #b00001101)
                expect
                (fp #b1 #b000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b000000000 #b00000001)
                expect
                (fp #b0 #b111000001 #b11110111)))

(assert (= expect result))

(check-sat)
