(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111100010 #b1101000111011001101010111001010001101001010111100110)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b01011111011 #b1111101001010100010010111101010011101010001011110000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100100001 #b1111010011010001100010111111010011101001100100000110)
                expect
                (fp #b0 #b00001100101 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b0 #b00001100101 #b1001000011101000110011011000111100000110101101010101)
                expect
                (fp #b0 #b11001011001 #b1101101101000101001010100110010001011101001111010100)))

(assert (= expect result))

(check-sat)
(exit)
