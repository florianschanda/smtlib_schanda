(assert (fp.leq (fp #b0 #b01111000001 #b0001110111110100100011010101010011111100110101010111)
                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b11111000101 #b1111010110100000111001100011010001011101111110101110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10000001101 #b1100001110101100101101000111000010001110001000000110)
                expect
                (fp #b0 #b11000001000 #b0100100010100001010011011100001011101010100100100000)))
(assert (fp.leq (fp #b0 #b11000001000 #b0100100010100001010011011100001011101010100100100000)
                expect
                (fp #b0 #b11101010010 #b1000010000010000011000011111010110110111110010100011)))

(assert (= expect result))

(check-sat)
(exit)
