; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b10010011000 #b1111011110110101101000010010011101010001001011111000)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
