(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111001111 #b0111000100011100101001101010100111001010111101011001)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10101111100 #b0010110011100001010101101011100000010111111010111010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100000110 #b0010101010101000010100011001010000111001100000100101)
                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100111101 #b0000011110010101010100110100010010001010001000000101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010110001 #b0110000100011011011101101010000100000001011011011111)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b00011010110 #b0001001010100111000010100101010111111111101100011001)))

(assert (= expect result))

(check-sat)
(exit)
