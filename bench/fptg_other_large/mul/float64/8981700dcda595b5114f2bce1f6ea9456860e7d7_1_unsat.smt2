; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00011101000 #b0000100000001101100001010100001100101000010000000000)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b01110101110 #b1110111111000110101010010110100111001100110110011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010001101 #b1011100110110000101001000011000011011001100010111010)
                arg2
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b10010111110 #b1011011011011101111001101111001011101100100000000001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10010011010 #b0011001111000100111010100110111110100100100111011000)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01001000000 #b1101000010100011001001101100111001010100111101110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
