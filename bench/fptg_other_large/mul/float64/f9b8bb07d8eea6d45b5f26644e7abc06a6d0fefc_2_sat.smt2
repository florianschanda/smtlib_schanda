; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011101110 #b0101001011101110011110101011000011011110011100010010)
                arg1
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)
                arg1
                (fp #b1 #b00010000111 #b1000110000001101000000011110101000111001001110111100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101100001 #b1111101001000000110000110000101000010001010010110111)
                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01100011001 #b1111000110100000100111010000001011010000100011010101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00100000110 #b1000100001001111001111100100011111001000001011100111)
                expect
                (fp #b0 #b00000000001 #b0010100110010101011001111101111001110101011010101111)))
(assert (fp.leq (fp #b0 #b00000000001 #b0010100110010101011001111101111001110101011010101111)
                expect
                (fp #b0 #b00011011000 #b0100010101100011001101001110010010001001100001111110)))

(assert (= expect result))

(check-sat)
(exit)
