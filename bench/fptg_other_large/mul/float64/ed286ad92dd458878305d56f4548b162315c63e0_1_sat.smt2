                arg2
                (fp #b0 #b11011011100 #b1100011000101000011110100010101011110100010110000010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100111011 #b0111011100011110101001010001101011111100101001000010)
                expect
                (fp #b1 #b11000110011 #b0011110100101010111011111111110011111100111111110100)))
