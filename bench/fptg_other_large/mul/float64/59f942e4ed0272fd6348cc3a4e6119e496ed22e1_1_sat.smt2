; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101110111 #b1101000101011101100101100100000001110100110101001110)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b11101000100 #b1000111010000111010100011001110001100010000010111101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10100100011 #b1000001011111111111111010100000111001000001111111011)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b10000111011 #b1001111111111000101001100010000101000110101101100100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100010111 #b0111001101010100100010100101000110000100110000100110)
                expect
                (fp #b1 #b00000110100 #b1110011101010000101010110001111001110101111100000000)))
(assert (fp.leq (fp #b1 #b00000110100 #b1110011101010000101010110001111001110101111100000000)
                expect
                (fp #b0 #b10010110100 #b1010000001000010001100001110011111111101100101111010)))

(assert (= expect result))

(check-sat)
(exit)
