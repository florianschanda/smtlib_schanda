; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01011000101 #b1011001100010001001110010100010001110010011110001101)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00101101110 #b0101000000001101001000110001000111101001100011010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001111011 #b1001111011000001001011010101110111011010110011110000)
                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b0 #b01010010000 #b0010010110011110001100100010000001111010001101111100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110001101 #b1111110101111011111100100010100111001000100100101110)
                expect
                (fp #b0 #b00000000001 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b0 #b00000000001 #b0100101011010010001101011100011011111110011011100100)
                expect
                (fp #b0 #b11000101111 #b0011010111000010000001110111110110010110110011110111)))

(assert (= expect result))

(check-sat)
(exit)
