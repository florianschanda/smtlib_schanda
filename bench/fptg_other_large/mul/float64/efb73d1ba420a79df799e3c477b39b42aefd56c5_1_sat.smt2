                arg2
                (fp #b0 #b10110000100 #b1101100101110000001110010111100100010101000000100100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011011101 #b0010110110001000010110010101010111011101011101000100)
                expect
                (fp #b0 #b01010011001 #b1001000011101000110011011000111100000110101101010101)))
