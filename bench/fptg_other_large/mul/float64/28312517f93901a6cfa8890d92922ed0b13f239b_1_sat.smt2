; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b1100110101100101110000010001111110111110010111100100)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01001000100 #b1000000000101100000010000000001010011101111001010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101100001 #b1001101101101011011111001101110001011101001101011010)
                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b0 #b11100110000 #b0110110011000110010001111010000011111011000111010000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01000101001 #b1010000100111101100100100011000011010100101010001010)
                expect
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(assert (= expect result))

(check-sat)
(exit)
