; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011010110 #b0110010110101011010110011110001010001101011100000110)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b00010101110 #b1000001100001110011100100101111111010111001101100101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101010000 #b1101110111100100100101011000110100111000010010011111)
                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b01100101000 #b0000100000001010101000100101111111011101111000001001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101011100 #b0111110110111001000010000110010010000100011110010100)
                expect
                (fp #b1 #b00000000001 #b1001000011111000011110110010000011010010011011011001)))
(assert (fp.leq (fp #b1 #b00000000001 #b1001000011111000011110110010000011010010011011011001)
                expect
                (fp #b0 #b01010001101 #b1100010110101110110010101000111100110001100101010111)))

(assert (= expect result))

(check-sat)
(exit)
