(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101001101 #b0100011010101001010101100000011100011101001001101101)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
