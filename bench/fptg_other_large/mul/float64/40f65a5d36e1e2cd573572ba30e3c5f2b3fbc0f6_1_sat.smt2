; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111101101 #b0101101110111011110001111010110010100001011111000011)
                arg1
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg1
                (fp #b1 #b01110100001 #b0100111111111001111100100111110000001001101011000001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10101111000 #b1111111010110010101100111111010100010111101001011101)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b1 #b01001001000 #b1011010000001000011110010010100110101101111011100101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00011001011 #b1100110001000111001101001001101001111000011110000110)
                expect
                (fp #b0 #b10100100010 #b0010001100110001001011010100010111000010110110010000)))
(assert (fp.leq (fp #b0 #b10100100010 #b0010001100110001001011010100010111000010110110010000)
                expect
                (fp #b0 #b10110110001 #b1000001011000110001111111101101000010110011100101010)))

(assert (= expect result))

(check-sat)
(exit)
