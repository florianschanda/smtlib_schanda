; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +NAN

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001010011 #b1001011001110010111001101011000010001110001101010001)
                arg1
                (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)
                arg1
                (fp #b0 #b10110011110 #b1110000101111010100000000101101100110011011101011100)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
