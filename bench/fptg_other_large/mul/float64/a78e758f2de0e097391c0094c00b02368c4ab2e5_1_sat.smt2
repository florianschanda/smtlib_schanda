; Format: FLOAT64
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
