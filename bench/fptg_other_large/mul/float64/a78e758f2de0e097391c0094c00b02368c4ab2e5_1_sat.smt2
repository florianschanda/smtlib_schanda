                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b11011001100 #b0110111111011110001100111001010101001000011111110101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110110010 #b1010011101110111010100110001000010110001011011110000)
                expect
                (fp #b1 #b11110101101 #b1111010110101011010111001000001101011100110011110100)))
(assert (fp.leq (fp #b1 #b11110101101 #b1111010110101011010111001000001101011100110011110100)
                expect
                (fp #b0 #b01010001011 #b1111000000111001111110111011011111111111100011000111)))

(assert (= expect result))

(check-sat)
(exit)
