; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001000101 #b0111000111011011111000111101111101011001001000110011)
                arg1
                (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)
                arg1
                (fp #b0 #b01101001001 #b0010100011000010011110111001100100101010100100010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110010100 #b0011010100001101000000101010110110110101101110010010)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101100010 #b1110110001010101000000110110011011101110010001010001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000100100 #b1101100010101111000111001001010110100011101001111110)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11101111111 #b0000011111010110011011000011110000010000011100111100)))

(assert (= expect result))

(check-sat)
(exit)
