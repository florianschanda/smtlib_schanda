(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100100000 #b1100111100000000101110100001010100000000110010011110)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b10001001001 #b1101111110010010011011000001101010011011000011100111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110101010 #b0010100100111011101010000000010010001000001001111100)
                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b0 #b00000101011 #b1011111101110010010110011000100010000000010111001011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110111010 #b0111101101101111111110100101111000010111010001110000)
                expect
                (fp #b0 #b00000000000 #b1111111000100101100000010101011011110101000101001110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111000100101100000010101011011110101000101001110)
                expect
                (fp #b0 #b10000010100 #b1001100111100100001100111111011100010001011100000110)))

(assert (= expect result))

(check-sat)
(exit)
