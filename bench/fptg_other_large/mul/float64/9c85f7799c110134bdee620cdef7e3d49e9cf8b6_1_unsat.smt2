; Format: FLOAT64
; Arg1: -ZERO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11110010111 #b1100010111100011101010011000101001000100011111000001)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01101001010 #b1101001100110011011010100000001001001111001111011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101100011 #b0111001100000100011010100010110010110011011011111101)
                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00100101000 #b1011000000001101100100011001001001111000011101010100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000111101 #b1011110100111010101000100000110111001101010011001000)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00101100001 #b0010100111110101111101010110000010101111000100110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
