                arg2
                (fp #b1 #b01010010101 #b1011100101100101100111111000100110011010111100100111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111110111 #b0110000110000101011000101001101010101001110000101010)
                expect
                (fp #b0 #b00011101111 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b0 #b00011101111 #b1001101000111100100101110000100111110100101111111000)
                expect
                (fp #b0 #b10111001110 #b0100100001011100110111011000000101011011100000000001)))

(assert (= expect result))

(check-sat)
(exit)
