; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01000010001 #b0101010010010110000011111011110111010101001100100101)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b00001101001 #b1110000010110010010110001101001111110110001111111101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010011100 #b0010110000011100111010110010101110001100001010100000)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
