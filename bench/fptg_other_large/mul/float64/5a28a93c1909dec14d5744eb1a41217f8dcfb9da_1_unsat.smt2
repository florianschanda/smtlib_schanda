(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101100000 #b1101001101000001100000100111100011111110010010111010)
                arg1
                (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)))
(assert (fp.leq (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)
                arg1
                (fp #b0 #b10110010010 #b1010111011110010010011010000111100000000001001001000)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
