; Format: FLOAT64
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000000000 #b0011111010010100100100001010000100100111000100011000)
                arg1
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00110011111 #b0111110100100001001100110101111001101100011010011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11000001110 #b0110010001011001101111101111111111011110000011101011)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10011000001 #b1010110011101110101001111111001110100101100011110001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00110111001 #b0101100001100000010000011010001001000100001010011100)
                expect
                (fp #b0 #b00000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000110100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000011001 #b0010110001001001010001000111111010101001110111001011)))

(assert (= expect result))

(check-sat)
(exit)
