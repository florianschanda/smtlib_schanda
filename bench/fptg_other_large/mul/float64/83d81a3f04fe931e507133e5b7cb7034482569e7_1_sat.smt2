                arg2
                (fp #b1 #b01010110100 #b0011101100010100111011111100101101111011110010000011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000010110 #b0110111010110000001111111010001100100011100010001010)
                expect
                (fp #b1 #b01000011000 #b1011001110000111100110000001000000010101101000110000)))
