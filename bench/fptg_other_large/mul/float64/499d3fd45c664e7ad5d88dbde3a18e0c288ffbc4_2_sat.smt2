(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111011001 #b1011101011010110011100111100101001001101011000000001)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11001100110 #b0110000100010111001001000001011001001110000000001111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100011110 #b0001100001111001011011000100111001101110000101100011)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b00101111100 #b0001101111100111000000110100100111001011101110000110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000111110 #b0010111100000010111101000001111001110111111111011110)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11111110000 #b0101001011101000101101101001000110010010011011010000)))

(assert (= expect result))

(check-sat)
(exit)
