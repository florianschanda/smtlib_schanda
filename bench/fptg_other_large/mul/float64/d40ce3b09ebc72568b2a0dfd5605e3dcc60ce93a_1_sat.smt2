; Format: FLOAT64
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000001101 #b1110001010111011101011100001011110011111011101000000)
                arg1
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111111110 #b0001101100101111111011110001100011110110100100001100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001111010 #b1110001010001101110100111110110001000010101101001010)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b01001110111 #b1010110101110001110110011000101111001010111011011100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010011111 #b1111100001101110100010010101011100000100101001001000)
                expect
                (fp #b1 #b01111111101 #b1011010100111010011011101110000001101001110111011000)))
(assert (fp.leq (fp #b1 #b01111111101 #b1011010100111010011011101110000001101001110111011000)
                expect
                (fp #b1 #b01101011100 #b1010101011000011010001111010101100011000110110000111)))

(assert (= expect result))

(check-sat)
(exit)
