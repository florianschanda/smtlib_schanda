; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000100011 #b0110011001100000000111111010000010011101111001111100)
                arg1
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                arg1
                (fp #b0 #b10011111100 #b1001001010100011010110101111110110010011100000001011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100110110 #b0101110110111011100111011110011111000111010101101010)
                arg2
                (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)))
(assert (fp.leq (fp #b1 #b10100100001 #b1001101000111100100101110000100111110100101111111000)
                arg2
                (fp #b0 #b01101010011 #b0111010010100001010000010111111111100010111110000001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000000100 #b0010111011011101001111101110100111000000110110011101)
                expect
                (fp #b1 #b10101010101 #b1010000011110111011111110111001001000001011001010000)))
(assert (fp.leq (fp #b1 #b10101010101 #b1010000011110111011111110111001001000001011001010000)
                expect
                (fp #b1 #b10100100000 #b0000010111001000000111010010111010101111001111000000)))

(assert (= expect result))

(check-sat)
(exit)
