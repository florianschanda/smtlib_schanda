                arg1
                (fp #b0 #b01011010010 #b0101010100111101011001011111100011101100110111110000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00011110001 #b1000011000011111111010010111100010111001011001000001)
                arg2
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                arg2
                (fp #b0 #b11010111000 #b0111010111110001001010101111001010110010000011110001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011101011 #b1110100110100011111010000011000110110101001000101101)
                expect
                (fp #b1 #b11010010101 #b1000010011000101101010010100001100110001010110101110)))
(assert (fp.leq (fp #b1 #b11010010101 #b1000010011000101101010010100001100110001010110101110)
                expect
                (fp #b0 #b00011111001 #b1101110010000001011011100000101100011110101110110001)))

(assert (= expect result))

(check-sat)
(exit)
