                arg2
                (fp #b0 #b11001110011 #b0010111010101000000010001011111101000101101011111010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01110110000 #b1011011011000000001101000101100101111110011010101010)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00111001110 #b1110001100111101101001011011010000000100100110010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
