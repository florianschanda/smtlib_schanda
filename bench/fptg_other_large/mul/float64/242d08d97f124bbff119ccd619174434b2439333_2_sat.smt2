(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100000100 #b1011101101000000001100000100000011110010001101101001)
                arg1
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111111101 #b0101000101011000000001001000010110001111101111111100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01100100010 #b1001100100011011011101000111010001000111110110100111)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11110110001 #b1010100000101010110100100111101001110110101011011110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
