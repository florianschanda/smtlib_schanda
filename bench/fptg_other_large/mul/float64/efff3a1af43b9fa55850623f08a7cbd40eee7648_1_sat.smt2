(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00010110001 #b0110001011010000101100110000101011110010110111011110)
                arg1
                (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)))
(assert (fp.leq (fp #b0 #b00100010101 #b0010001100001001010110100000111111011101000100000010)
                arg1
                (fp #b0 #b01110000101 #b0101100000001011101010001001111011111000101001100100)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
