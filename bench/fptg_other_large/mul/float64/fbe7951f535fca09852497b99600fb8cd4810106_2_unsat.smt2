; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101000000 #b1101001110101010010000101000110110001001110100001111)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b0 #b10010001100 #b0110110001000011110110001001111001011010000101100111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00101011001 #b1000001101000100011010110001011100011001100000111010)
                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b11110101010 #b0011110000100010001001100100001110000111100010100000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100110010 #b1011011100100011011101001100001110000000100000001001)
                expect
                (fp #b1 #b11010011101 #b0000001001001001011100010010011100100000111010101110)))
(assert (fp.leq (fp #b1 #b11010011101 #b0000001001001001011100010010011100100000111010101110)
                expect
                (fp #b0 #b10100111101 #b1101000001100011010001100111010000011111111011101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
