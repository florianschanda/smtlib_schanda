; Format: FLOAT64
; Arg1: -LARGEST_NORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b1 #b10110000110 #b0011010010011010101000100001101010000100101001010111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011101110 #b1110001100110000111111111011001111100000110010101110)
                arg2
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b1 #b00111010101 #b1100001100101111000100110101111100110011110000100011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
