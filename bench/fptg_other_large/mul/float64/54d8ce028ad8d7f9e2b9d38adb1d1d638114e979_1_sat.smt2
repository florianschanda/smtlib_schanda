                arg2
                (fp #b0 #b10001001100 #b1011111110011111010111100011011000101011100010001101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001001110 #b1100011100110001010111010110011111000001010001100101)
                expect
                (fp #b1 #b10000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10000000000 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b00010001111 #b1001010001111011010000111100011010101100101111111001)))

(assert (= expect result))

(check-sat)
