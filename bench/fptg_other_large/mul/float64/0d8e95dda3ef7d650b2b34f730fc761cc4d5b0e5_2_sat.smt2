; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001100000 #b0110001000100111100001010111101001110000111101010111)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b00011000110 #b1111101010100101010001011111011100011011011011110110)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101100011 #b1000010100000111101100011011010010101010001100101100)
                expect
                (fp #b0 #b10001010110 #b1001100101111010011110011000000111101001111101110011)))
(assert (fp.leq (fp #b0 #b10001010110 #b1001100101111010011110011000000111101001111101110011)
                expect
                (fp #b0 #b10011010001 #b1000101010011100101000111110100101101100001010110010)))

(assert (= expect result))

(check-sat)
(exit)
