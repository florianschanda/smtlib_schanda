; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010111001 #b0010000000100110111010001100010111000111001000101110)
                arg1
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg1
                (fp #b0 #b00001111100 #b1110110011101110001100001011111100000101100101000100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00000111111 #b1111001000101010011010010001001011000101000010010111)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b10000111111 #b1100010110111111010011010101110011011001101101001111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010001101 #b0000101001010111111001000101101100010110100101101100)
                expect
                (fp #b0 #b00000110101 #b0001010101001111111101010011011010110000011001001011)))
(assert (fp.leq (fp #b0 #b00000110101 #b0001010101001111111101010011011010110000011001001011)
                expect
                (fp #b0 #b11100001011 #b1010111010100010011011010101100010101000001100101010)))

(assert (= expect result))

(check-sat)
(exit)
