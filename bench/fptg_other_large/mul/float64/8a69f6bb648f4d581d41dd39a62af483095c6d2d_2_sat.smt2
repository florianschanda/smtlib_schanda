(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00110101011 #b0001001100110010110010011001000011000000011011000100)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11011101001 #b0110000111011100001011100100100100001101111101111110)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00101110010 #b0000110000011010101011010101001001011011111100010001)
                expect
                (fp #b0 #b11000000000 #b1110101001101110100010101110101001101000011010101011)))
(assert (fp.leq (fp #b0 #b11000000000 #b1110101001101110100010101110101001101000011010101011)
                expect
                (fp #b0 #b11011011100 #b0100110000101100010010100000110010010010011010011011)))

(assert (= expect result))

(check-sat)
(exit)
