                arg2
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                arg2
                (fp #b1 #b01101100110 #b1001111010001110000011001101001010110000011101101111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10101011001 #b1000110110111101100110011101000011100111001010010011)
                expect
                (fp #b1 #b10100110010 #b1010101001000001111011100010001101001011100011011111)))
