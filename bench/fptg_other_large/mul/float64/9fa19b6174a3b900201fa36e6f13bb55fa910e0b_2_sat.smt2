(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010110010 #b0011001000000100010100110010100110100010000000010100)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11100100001 #b1110001001001011100011011100001110011011000100010111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111010 #b0111100001111001110110100001001000000100010101100010)
                arg2
                (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)))
(assert (fp.leq (fp #b1 #b11001101100 #b1011101100001101100011110010111010001111111010000001)
                arg2
                (fp #b0 #b10101010111 #b0101001001100111000001111010011001011111110000101100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111100110 #b0101111100111000101101101110100001100111110110101100)
                expect
                (fp #b1 #b11101101101 #b1011000110011110111001001010000001001011011011001100)))
(assert (fp.leq (fp #b1 #b11101101101 #b1011000110011110111001001010000001001011011011001100)
                expect
                (fp #b1 #b01100101100 #b0011101001110110011001110101011101100100110011010010)))

(assert (= expect result))

(check-sat)
(exit)
