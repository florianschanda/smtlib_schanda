(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b1 #b11001110011 #b0101111011000010111001111100111011101110001011000100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001111101 #b1101011101010100000011110101101101101011000001010110)
                expect
                (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b01111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b01100001001 #b1111010111011100111111110001110101101001001011101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
