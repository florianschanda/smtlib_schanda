; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01011101001 #b1011010010000100110010001111000011001100001001000100)
                arg1
                (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000111111111110001010011101111010011110010000110001)
                arg1
                (fp #b0 #b11110000000 #b1001010001100001011011000110101011011010110111001110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110110110 #b1000110100010100001011000111101000010110010111111001)
                arg2
                (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)))
(assert (fp.leq (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)
                arg2
                (fp #b0 #b10011001111 #b0011101000000100101111001000100101100011001110001110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01111000101 #b1100111111010010100001001111011001010000101010110010)
                expect
                (fp #b1 #b00101010011 #b1001111101001010011010010001110100110000101101101011)))
(assert (fp.leq (fp #b1 #b00101010011 #b1001111101001010011010010001110100110000101101101011)
                expect
                (fp #b0 #b10011110101 #b1010010000010000011001001011100011000100101001111011)))

(assert (= expect result))

(check-sat)
(exit)
