; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011010000 #b0111010010111101101011010111010000010111001010001100)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b0 #b01100110101 #b1100010010010000001010110011010101010110101010111011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110001001 #b1011100100100101110011101101110000001111110011010101)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b1 #b00010000110 #b0101110001110110111100001100010101010101100001011111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01111110010 #b0110010110110111000010111010000111100001000111101000)
                expect
                (fp #b0 #b10110101101 #b1001001010011111000011011011010111110011111011110010)))
(assert (fp.leq (fp #b0 #b10110101101 #b1001001010011111000011011011010111110011111011110010)
                expect
                (fp #b0 #b10111100110 #b1010110111001110010001101111100010110001110001110111)))

(assert (= expect result))

(check-sat)
(exit)
