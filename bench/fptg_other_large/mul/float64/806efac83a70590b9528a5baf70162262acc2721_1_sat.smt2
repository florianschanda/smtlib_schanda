; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +ZERO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010011001 #b1101011010001001110011110010001001000100110010100110)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b0 #b11011011111 #b1001111010011011111100000101001011010111111010001101)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11110010111 #b1001101111110010100101100100010101110110010001111010)
                arg2
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10110110011 #b1110001011110111000010010010011010010010011110110000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00010100011 #b1101010010100110010110110110001001011111011111111011)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111100111 #b1010110001000100110110011010111111101110100011111010)))

(assert (= expect result))

(check-sat)
(exit)
