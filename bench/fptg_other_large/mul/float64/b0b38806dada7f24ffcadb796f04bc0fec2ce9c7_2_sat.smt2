; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110001101 #b0101011001110110101111101100101011001100011001000011)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b01001011010 #b1011101001010000010011111110000010001101000100011000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100101000 #b0010100010011110111010010011010001001010100100010100)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b11101001100 #b1110010110111101111110110010010101101001111111000100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110100011 #b1000000010001010100111111000110001111010111010000101)
                expect
                (fp #b0 #b00000101011 #b1000011100000010110000110101111111001000011111110101)))
(assert (fp.leq (fp #b0 #b00000101011 #b1000011100000010110000110101111111001000011111110101)
                expect
                (fp #b0 #b11111111101 #b0100001011100011001010110110011110110000110001001101)))

(assert (= expect result))

(check-sat)
(exit)
