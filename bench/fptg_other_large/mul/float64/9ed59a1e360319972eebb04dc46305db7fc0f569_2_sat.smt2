; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001000000 #b0101010001100010101010000010110101010111110001100101)
                arg1
                (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)))
(assert (fp.leq (fp #b0 #b01111111111 #b1010001101010100101101000111111110000001010101101101)
                arg1
                (fp #b0 #b10000100111 #b1100111101000010100101011111000100100000110100010101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00010111011 #b0001101010110111101001110101100100110101101011001100)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b01001111100 #b0100101010010110001101010000111010111110011011011110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00010000111 #b0101111001000010000001001100101010101000100001111000)
                expect
                (fp #b0 #b00000000001 #b0001011010101110111001011101001000001010111010011110)))
(assert (fp.leq (fp #b0 #b00000000001 #b0001011010101110111001011101001000001010111010011110)
                expect
                (fp #b0 #b11110010100 #b1110111000101000001001111101111010100001111011010101)))

(assert (= expect result))

(check-sat)
(exit)
