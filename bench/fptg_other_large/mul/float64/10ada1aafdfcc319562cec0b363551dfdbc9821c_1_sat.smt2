; Format: FLOAT64
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110000111 #b1011010110000000001000011010110001111000001111010010)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b01110110110 #b0011101010001011000011011000000001100000001110100010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100011101 #b0001000100111000111001010011111010011010000011010011)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b01001001101 #b1000001100001111000000101000110010110111111011000100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001110101 #b0111010001100001100111011011001110110101001010110110)
                expect
                (fp #b0 #b00000110101 #b0000010100000001101000000010101000101001111000010000)))
(assert (fp.leq (fp #b0 #b00000110101 #b0000010100000001101000000010101000101001111000010000)
                expect
                (fp #b0 #b11110111001 #b0111000011010110101111100010110110000111000001111010)))

(assert (= expect result))

(check-sat)
(exit)
