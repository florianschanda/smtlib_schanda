(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101111110 #b1100011110100001010101111111010101000111101011001110)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b00001100011 #b1111100010001000010101111011101110100100110110111010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01000000110 #b1001100111001101001010010001011001011100110000100101)
                arg2
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000110000 #b0001011100001110100001011110010110010101110011100111)
                expect
                (fp #b1 #b10000000000 #b1000100101010101010110111001000010010111000000011000)))
(assert (fp.leq (fp #b1 #b10000000000 #b1000100101010101010110111001000010010111000000011000)
                expect
                (fp #b0 #b00111001000 #b0101000100011010101100001000101111110100100011100100)))

(assert (= expect result))

(check-sat)
(exit)
