(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100101110 #b1000100101011101101001100111101100000000100000101111)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b01001000110 #b1110011010111100101000010100111000010001101001111110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011000000 #b1011101001111111010101110111010111111101011111111101)
                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b00111010000 #b1001110001101000100101111001001101011100101110010110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01101000101 #b0101001101111001001011101000010000010011000110100010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11101011010 #b1000001010101001101001010011000100011011010100101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
