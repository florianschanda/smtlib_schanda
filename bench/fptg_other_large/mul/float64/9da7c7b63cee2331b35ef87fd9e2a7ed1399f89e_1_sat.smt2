                arg2
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)
                arg2
                (fp #b0 #b11010100111 #b0010111100111111000001100011110011111110101011110000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11100110101 #b0110100100111010111000100110011001100100111101111100)))

(assert (= expect result))

(check-sat)
(exit)
