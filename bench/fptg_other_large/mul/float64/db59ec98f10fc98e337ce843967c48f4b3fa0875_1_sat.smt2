(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010110000 #b0010011101100100111101000101011100100100110010000000)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b11100110110 #b1000110110000110100110011000101011011111010011110101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0010100110101111110110010101010001101111001100001111)
                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b10100111101 #b0001111100011010001010100101000010110001111101011110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011110000 #b0001001010000000100011011011101110110101001011111101)
                expect
                (fp #b0 #b01111001011 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111001011 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01111011110 #b0110010100101101000101110010110011011010111100100100)))

(assert (= expect result))

(check-sat)
(exit)
