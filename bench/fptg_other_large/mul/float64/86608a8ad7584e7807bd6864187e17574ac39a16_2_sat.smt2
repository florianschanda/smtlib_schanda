(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b1 #b01100001101 #b0001100011001000110100010010001011010101100100010110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111010010 #b0110000101101101101111111110001011011111101110111110)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b00111111110 #b0010110100001110010001001110011111110101010101100010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100110010 #b0111001010111100000110101000010101011101001010001001)
                expect
                (fp #b0 #b10000000000 #b0000010100000001101000000010101000101001111000010000)))
(assert (fp.leq (fp #b0 #b10000000000 #b0000010100000001101000000010101000101001111000010000)
                expect
                (fp #b0 #b11110001000 #b0111000100111101100000100100011011010010101000100011)))

(assert (= expect result))

(check-sat)
(exit)
