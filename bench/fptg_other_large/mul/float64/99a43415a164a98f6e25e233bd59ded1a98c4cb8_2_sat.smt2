; Format: FLOAT64
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010100000 #b1101000010010000111111011110010101111101010110111110)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b01101111110 #b0010001110010000001000111001101101011110011011101110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b10000010100 #b1101101110001110000000001101000010101110111000011011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011001111 #b0000111100011111110100110100010001011101011010111101)
                expect
                (fp #b0 #b10000000000 #b1111111111111111111111111111111111111111111111111110)))
(assert (fp.leq (fp #b0 #b10000000000 #b1111111111111111111111111111111111111111111111111110)
                expect
                (fp #b0 #b10110101011 #b0100011101101000010000000001101101100001010101111010)))

(assert (= expect result))

(check-sat)
(exit)
