; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00010000111 #b1000010111011010010010011010110101001110111110001100)
                arg1
                (fp #b0 #b11100110111 #b0001101001011001100011011000100011001100010101111001)))
(assert (fp.leq (fp #b0 #b11100110111 #b0001101001011001100011011000100011001100010101111001)
                arg1
                (fp #b0 #b11110001110 #b0110000110001010100101001000001011110010011010010001)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b11001000111 #b0001110010111001100110001001000000110101000000100001)
                expect
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(assert (= expect result))

(check-sat)
(exit)
