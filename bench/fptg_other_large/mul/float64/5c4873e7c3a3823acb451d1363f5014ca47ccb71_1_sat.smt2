(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001010111 #b1000100101100000110110111110110000010111011101001110)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b01111111100 #b1100110101010010100101011111110101111110111011101101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110011110 #b1101000101101000001110001011111110000010010111011111)
                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11000110010 #b0110101100011001010011111010011001110001100101101001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00010011001 #b1010100111011010000001110111010011000100110010101111)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00001100110 #b0101110111110100011011100011100101010101101011000010)))

(assert (= expect result))

(check-sat)
(exit)
