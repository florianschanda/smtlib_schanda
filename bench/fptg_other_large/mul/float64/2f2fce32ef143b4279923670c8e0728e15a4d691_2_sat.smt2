(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00001110100 #b0000101010010111100010011011110101001000000101011110)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11110110001 #b1110010111100101011101100010001110010110110010101011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101001010 #b1010110111101001100110001111100111100111000001101110)
                expect
                (fp #b1 #b10110011011 #b1111011011111101100110010011001110011011110110110000)))
