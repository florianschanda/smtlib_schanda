                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b11010100001 #b1011010001000000010100011011011010010101101000101111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00011001001 #b1001001010100001011010111001001100101001000100110110)
                expect
                (fp #b0 #b00111111111 #b1011010100111010011011101110000001101001110111010111)))
(assert (fp.leq (fp #b0 #b00111111111 #b1011010100111010011011101110000001101001110111010111)
                expect
                (fp #b0 #b01111010111 #b0010111110011000000010100101110010111100011110100101)))

(assert (= expect result))

(check-sat)
(exit)
