; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111101000 #b0110110100001011011111010101100010001000000111101110)
                arg1
                (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)))
(assert (fp.leq (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)
                arg1
                (fp #b0 #b10001100111 #b1011000110111001101001110011110111111110111011101101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00001111010 #b0111000010001000101111101111000010100100100100011100)
                arg2
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01100101111 #b0010101110101100011111010010101000001101100111101001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00111101111 #b0010111011001111011111111111000111111100111010001011)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00011110100 #b1110010110000100001001100110001010101110010010100010)))

(assert (= expect result))

(check-sat)
(exit)
