(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11011101011 #b0010111011100001011100111100000111001001010001100000)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10011101011 #b0010101001001101111110010101111011101000010110001001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01110101000 #b1100010100111110101000111001011101010110110000110100)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b11100010000 #b0001111010001111100101000011001111001000000000101111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110000110 #b0011111110101000101010001001011111000010010011110100)
                expect
                (fp #b0 #b00000110000 #b1001011011001011000100011100111101001001100010011110)))
(assert (fp.leq (fp #b0 #b00000110000 #b1001011011001011000100011100111101001001100010011110)
                expect
                (fp #b0 #b11101011101 #b0010111101100001111100101000010001101111100101101111)))

(assert (= expect result))

(check-sat)
(exit)
