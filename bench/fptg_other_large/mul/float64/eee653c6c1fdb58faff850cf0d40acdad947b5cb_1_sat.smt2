                arg2
                (fp #b0 #b11000101101 #b0111101011011101000010011100110100011011010100000000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010000100 #b0100111000001000000000000011011011001101011011000011)
                expect
                (fp #b1 #b01000101111 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b1 #b01000101111 #b1001011011001011000100011100111101001001100010100000)
                expect
                (fp #b1 #b00010100001 #b0010010110011010101100001100010111000001111111000010)))

(assert (= expect result))

(check-sat)
(exit)
