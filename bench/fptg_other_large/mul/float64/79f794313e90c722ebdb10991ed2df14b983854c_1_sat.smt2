(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b10101011111 #b0001001110000110001011000110110000000001000001110110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101110001 #b0010000010000011010010111000101010010111011110001001)
                expect
                (fp #b1 #b01011010001 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b1 #b01011010001 #b1011100111101011010100110100010000101101001101001111)
                expect
                (fp #b1 #b00000100100 #b1011111011011001101011101000100011100111011011011000)))

(assert (= expect result))

(check-sat)
(exit)
