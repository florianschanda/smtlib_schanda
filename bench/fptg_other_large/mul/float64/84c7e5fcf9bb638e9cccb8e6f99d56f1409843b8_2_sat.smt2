                arg2
                (fp #b0 #b11111010000 #b0110101101011100001101010110000000111101010011100011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111010110 #b0101010100000000010111100110000011001111110101001000)
