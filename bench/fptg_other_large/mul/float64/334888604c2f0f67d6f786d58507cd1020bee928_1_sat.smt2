; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111100001 #b1100101000100110110011111111100011110101010111011000)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b0 #b10011010110 #b0100000001111001001011010100011010111100100111101000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00011000100 #b1001010001010010100111010100001001100010110001011100)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b10110110001 #b1111001111001110000010010111000110110111011100101110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111100 #b1101000100111010011100111010101000111010001001110011)
                expect
                (fp #b1 #b11001001010 #b1001111100110110010111101010110000000001011010100000)))
(assert (fp.leq (fp #b1 #b11001001010 #b1001111100110110010111101010110000000001011010100000)
                expect
                (fp #b0 #b10110000000 #b1010111010000110000111010011011001001110010111111101)))

(assert (= expect result))

(check-sat)
(exit)
