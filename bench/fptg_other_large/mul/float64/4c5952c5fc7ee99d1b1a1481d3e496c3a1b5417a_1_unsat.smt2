; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b1010110110010100010110011111101001100110100110011101)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b10101100100 #b0000000001010100100101011010001110000100111110111100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00010011111 #b0010111001010111010001100001111111001100100110111000)
                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b10111000000 #b0000110111100100101000110101110011001011101101011101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b00001010100 #b0110100101111011101011101000001010100010101001010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
