; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000010000 #b1110111001010100100101111101101010010011000101010001)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b11010011011 #b1010100100101110100110011010000011110100101111110110)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10101000011 #b0111001010111000100100001100110110111101101010011110)
                expect
                (fp #b0 #b10111001001 #b0110110111011001111100111111001111101111001111001001)))
(assert (fp.leq (fp #b0 #b10111001001 #b0110110111011001111100111111001111101111001111001001)
                expect
                (fp #b0 #b11110101011 #b0101111011111010101100001001111011000010111011000000)))

(assert (= expect result))

(check-sat)
(exit)
