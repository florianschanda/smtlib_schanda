                arg2
                (fp #b1 #b01101000011 #b1111111000110000111010001111110000001111011011100010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011101010 #b0011110010000001101001100111001101100101010111010100)
                expect
