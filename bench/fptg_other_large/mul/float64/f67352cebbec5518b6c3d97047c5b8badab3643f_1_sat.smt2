(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00001001111 #b1100001011010101011110001011010110110100000010000000)))

(assert (= expect result))

(check-sat)
(exit)
