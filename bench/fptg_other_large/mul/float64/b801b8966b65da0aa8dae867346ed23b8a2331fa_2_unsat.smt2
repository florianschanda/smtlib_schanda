; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11000101001 #b1110011011001100101001101100100010001001111111010101)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b0 #b00000111100 #b1000000101011010110010100010010001011101011010011110)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011100001 #b1111010011000001011101010100101110001111001010111010)
                expect
                (fp #b0 #b10001100111 #b1001101011011011011110001011010101001010000000010111)))
(assert (fp.leq (fp #b0 #b10001100111 #b1001101011011011011110001011010101001010000000010111)
                expect
                (fp #b0 #b10001110010 #b1011000011000110000101000011110000000100100000011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
