                arg1
                (fp #b0 #b11011011110 #b1111100000111101110100101101010100011010111011101101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101001100 #b1001011011010011111000001000010101011000011011111001)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b01010100001 #b1010110101101111111011100010110001110101100101001101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110000000 #b0111000001011101110110111100000010011100110011000100)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10100110011 #b0111010111111110001110111010101000010111000001111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
