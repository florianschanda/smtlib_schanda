; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
