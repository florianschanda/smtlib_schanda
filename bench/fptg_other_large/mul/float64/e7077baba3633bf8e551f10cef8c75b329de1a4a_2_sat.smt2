;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101011111 #b1011011011110101001000001111100010011100001000001101)
                arg1
                (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)))
(assert (fp.leq (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)
                arg1
                (fp #b1 #b01001010011 #b0001010100100111110100100001100001111010001111111010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110110110 #b1111101100001100100010111000010101101010110100110011)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11111010000 #b1000011100000101010111101000000010011100011111110111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111010001 #b0110001110100100000000110010101010010110000110111100)
                expect
                (fp #b1 #b01011100111 #b1110100011011011010000010010011110101111111000000110)))
(assert (fp.leq (fp #b1 #b01011100111 #b1110100011011011010000010010011110101111111000000110)
                expect
                (fp #b0 #b11101101000 #b1011000111101111101110000001100100001001101000111010)))

(assert (= expect result))

(check-sat)
(exit)
