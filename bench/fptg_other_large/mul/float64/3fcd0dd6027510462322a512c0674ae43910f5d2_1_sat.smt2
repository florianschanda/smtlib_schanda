                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111111000 #b1011111011000000111001111000001111010111001101110110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000010110 #b0101100100100000011111101010000101001010101110110011)
                expect
                (fp #b1 #b01000000000 #b1000100101010101010110111001000010010111000000010111)))
