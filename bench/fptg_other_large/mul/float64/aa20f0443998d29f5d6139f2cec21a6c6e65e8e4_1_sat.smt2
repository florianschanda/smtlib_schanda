                arg2
                (fp #b0 #b11101110101 #b0001010111010110000110110111100000010000110110110010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101011001 #b0110011000010101111101010100011110001010000011001110)
