; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100001101 #b1111001111011000111000111111001100111100101001110101)
                arg1
                (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00111100110 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10101001001 #b1101001100101000011010001011100101001111100011010000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010001001 #b0001000001001110011011011000000100010000010101111011)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11010111000 #b0110011110011110010010010110111110000111111001100010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111010010 #b0000010100010001001100000001011010011010100110011110)
                expect
                (fp #b1 #b01000011010 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b1 #b01000011010 #b0011110100101010111011111111110011111100111111110101)
                expect
                (fp #b0 #b11011100010 #b0001111001001100010000011000100110111010010100111000)))

(assert (= expect result))

(check-sat)
(exit)
