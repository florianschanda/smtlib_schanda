; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111101000 #b1010110101111010000011000111010100000010001000001000)
                arg1
                (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)))
(assert (fp.leq (fp #b1 #b11111000101 #b0011101101001000001101010000110000000011111111110111)
                arg1
                (fp #b0 #b01100001011 #b0110110001100100100110000110011000110111101010101100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101001001 #b0011101101011111111101110111111001000011010010011010)
                arg2
                (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)))
(assert (fp.leq (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)
                arg2
                (fp #b0 #b10000101101 #b0110010111110100011110101111000110111111110100110010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
