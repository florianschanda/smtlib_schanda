                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b11101110010 #b1010001100110000000111100000001011000111000000111001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111100111 #b1001011000000100100110011111101001011110001101011101)
                expect
                (fp #b0 #b11000100100 #b0000110100001100001101101010010110000101001110110010)))
