; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01101000010 #b0101110000110001111011110001011000011001010011101101)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b10110001100 #b1000111010001110011011001111110010101010011101101011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110110000 #b0101000011000100010100010001011000001010111011110111)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b01010110010 #b0110011110011010100101001110100001111011110000011101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101101010 #b1101011101111000100111101111011110111011100101101011)
                expect
                (fp #b1 #b00100000000 #b1111111011100110001111111110010100000100000001000100)))
(assert (fp.leq (fp #b1 #b00100000000 #b1111111011100110001111111110010100000100000001000100)
                expect
                (fp #b0 #b00000011000 #b0001000100000110111000100011111111110010110000111110)))

(assert (= expect result))

(check-sat)
(exit)
