                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b10111010100 #b1010001100010101100010000100100011011101011110111110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00010101000 #b1010001000110111100101100010111000100110001001100110)
                expect
                (fp #b0 #b10010100101 #b1001110110011110011111101010110010101010000001011111)))
(assert (fp.leq (fp #b0 #b10010100101 #b1001110110011110011111101010110010101010000001011111)
                expect
                (fp #b0 #b11100011111 #b0011010111000011001011010101100101101010001010011011)))

(assert (= expect result))

(check-sat)
(exit)
