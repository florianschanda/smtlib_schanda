(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111000110 #b0001000000001010110001010111100011101011100011110100)
                arg2
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                arg2
                (fp #b0 #b11001011110 #b1101000100011100001101110100111110101011100010011010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10111110110 #b0110110100010000110011110101111011000010010001110011)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00111110001 #b0101111111100100011111111001101010010111001011011001)))

(assert (= expect result))

(check-sat)
(exit)
