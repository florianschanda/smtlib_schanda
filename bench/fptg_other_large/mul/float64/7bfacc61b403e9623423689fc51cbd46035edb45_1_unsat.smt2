(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110011011 #b1100010001011111001010110111001000110100101100111111)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b0 #b00001000111 #b1111111110000000100110101100111011000100001001100111)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
