(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101000000 #b1110110100011111000010110110101000010001110100110111)
                arg1
                (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)))
(assert (fp.leq (fp #b1 #b00000000000 #b0001011000101010000100101100100111111011010101101101)
                arg1
                (fp #b0 #b00000110010 #b0100111011010111110011101100010110111111001100011001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01110111010 #b1100100100100010111111101100101100001001100100011111)
                arg2
                (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)))
(assert (fp.leq (fp #b0 #b10000110011 #b0011110100101010111011111111110011111100111111110101)
                arg2
                (fp #b0 #b11110110011 #b1001110101110011011111011010100001000110011110101001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01000010111 #b0010000111000110111011101110010010010001011110001001)
                expect
                (fp #b1 #b00000110001 #b1011011101011101000011110010011000000011101001010010)))
(assert (fp.leq (fp #b1 #b00000110001 #b1011011101011101000011110010011000000011101001010010)
                expect
                (fp #b0 #b00001101110 #b1101111110111101101110111110111011111110100000001110)))

(assert (= expect result))

(check-sat)
(exit)
