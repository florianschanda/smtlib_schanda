(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11100000100 #b1100100101100101100101100101001100100100000111100000)
                arg1
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg1
                (fp #b1 #b00101110000 #b0100001001101011101011100001111010101100110101100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11000010001 #b1010010101100000000011110100000111111000100001011000)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b10010001110 #b0010111101000111011010001111101101000011011010010101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01111001100 #b0010000001000110100111000111011110001010000100011101)
                expect
                (fp #b0 #b00101000110 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b0 #b00101000110 #b1110000100001110110100100100110000010010100010001011)
                expect
                (fp #b0 #b10111110010 #b0110011111100100111000000100001111100110010001011010)))

(assert (= expect result))

(check-sat)
(exit)
