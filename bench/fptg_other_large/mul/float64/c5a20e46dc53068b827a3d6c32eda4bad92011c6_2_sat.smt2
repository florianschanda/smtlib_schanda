(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00011111100 #b1110011010010001110001100010101111011100111110001001)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b00001000001 #b1111000111111011110000100010011001101010100100110001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101101111 #b0000101110011000000101000001000001110111100100000100)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111110100 #b1011011110100100101000000001000101000000011011000110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101110101 #b1011000000001111110110001010000010000011011101101010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b00011111101 #b0110101010010010110110110000000101010110111011010101)))

(assert (= expect result))

(check-sat)
(exit)
