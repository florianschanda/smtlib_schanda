; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00101010011 #b0010111111010011011001100110010100001001000000101100)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11110111111 #b1100110110110000101000100101010110111000010100100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00000000001 #b1111000110001011110100011100100100111100010000100101)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b11110100000 #b1010100000110000010010100001100100101111100011110000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111001000 #b1110000010111010001110110111101100001100110110000000)
                expect
                (fp #b0 #b10111010001 #b1011000010000010110101101000000100010010011110001110)))
(assert (fp.leq (fp #b0 #b10111010001 #b1011000010000010110101101000000100010010011110001110)
                expect
                (fp #b0 #b11101111101 #b0101110011111010110110100100100011010011111110101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
