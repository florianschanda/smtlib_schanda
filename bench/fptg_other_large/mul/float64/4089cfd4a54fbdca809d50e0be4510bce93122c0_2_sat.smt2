                arg2
                (fp #b0 #b11001010001 #b0111101111010101010110011100110011000010100110100100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01001001111 #b0011000000010000000001000011111101100010101011100111)
                expect
