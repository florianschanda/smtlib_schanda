; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110110110 #b0001011010100000101110110010111000000010001010101000)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b10001101010 #b1010000101111000001101100001011001101010100111011011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b10010000110 #b1010101000100111001000100100011010010101011010101101)
                arg2
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                arg2
                (fp #b0 #b11100110110 #b0011100011111101001000100000101011110100101001010100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010100100 #b1100011011000010000001010101100111110110001101110001)
                expect
                (fp #b1 #b01001101011 #b0100110111110111111011100001010111001101011000001010)))
(assert (fp.leq (fp #b1 #b01001101011 #b0100110111110111111011100001010111001101011000001010)
                expect
                (fp #b0 #b11001101000 #b0101000101000011010101010001011000110011000011011101)))

(assert (= expect result))

(check-sat)
(exit)
