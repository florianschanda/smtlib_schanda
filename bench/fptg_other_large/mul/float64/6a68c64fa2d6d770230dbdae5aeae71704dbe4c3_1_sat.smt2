(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100010010 #b1100000001101011010000001000101100010101101101011011)
                expect
                (fp #b0 #b01111111111 #b0010000011111100000110001111110001101111101011010001)))
