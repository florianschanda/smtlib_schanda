                arg2
                (fp #b0 #b10110010110 #b0010101011100101101110111001011100100001101010011011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00001001001 #b0000010110111111001100000101110100100101110101111011)
                expect
                (fp #b0 #b01000000000 #b1111111111111111111111111111111111111111111111111110)))
