; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101000000 #b0110101110010111111000100100011101000011000111010110)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b00110110111 #b0100101111011110110101011010100110000001000001111110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010111011 #b1000001111101000101011110001011011110101111010100100)
                arg2
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
(assert (fp.leq (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)
                arg2
                (fp #b0 #b11111001101 #b0111110111101001111110010101000100101011001101001000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011000011 #b1101001011100101101110101010010011011010110110001101)
                expect
                (fp #b1 #b01011111010 #b1011101001101011111100000110001111000100100100000001)))
(assert (fp.leq (fp #b1 #b01011111010 #b1011101001101011111100000110001111000100100100000001)
                expect
                (fp #b0 #b10001001010 #b1101101110001101010011011011111011101010100101010111)))

(assert (= expect result))

(check-sat)
(exit)
