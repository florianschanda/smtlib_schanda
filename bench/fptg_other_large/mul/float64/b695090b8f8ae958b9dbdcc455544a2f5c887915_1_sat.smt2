                arg2
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10001100111 #b1010101001011110011000001010111000100000101010110001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11101000010 #b1111001001100111111110010001000010101111111111010000)
                expect
