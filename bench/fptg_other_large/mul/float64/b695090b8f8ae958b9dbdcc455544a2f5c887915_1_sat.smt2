(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00011101001 #b1111110111010011010110101011011001111111000001110111)))

(assert (= expect result))

(check-sat)
(exit)
