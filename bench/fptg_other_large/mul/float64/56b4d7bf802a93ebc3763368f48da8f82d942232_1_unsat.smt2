                arg2
                (fp #b0 #b01001000101 #b0010101000110010101000000100000000110010111110110011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001000100 #b1011000111001100010101100001111001011001010010001000)
                expect
