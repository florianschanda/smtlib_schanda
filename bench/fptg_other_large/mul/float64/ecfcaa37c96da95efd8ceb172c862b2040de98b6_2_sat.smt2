                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b00111011000 #b0100001111000011110101111110111010100000011001101000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100011010 #b1100010001111100001001101100010000000101110111111101)
                expect
                (fp #b0 #b01000000000 #b0101010001000101001010101100100110010101010011011110)))
