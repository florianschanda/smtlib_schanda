; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01011110101 #b0010011110011001001111101000000010000100010011000000)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11011001100 #b1010001100110000001010001001010100100000011110111100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001001111 #b1000001101000010110000011011100101100011111110001111)
                arg2
                (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)))
(assert (fp.leq (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)
                arg2
                (fp #b0 #b00111011000 #b0010100101010011000100101000101011001111110000010111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b11111010000 #b1011011100110110011100101110110111111110101100111110)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01110101110 #b1111100000001011011000110101010100110111110001101001)))

(assert (= expect result))

(check-sat)
(exit)
