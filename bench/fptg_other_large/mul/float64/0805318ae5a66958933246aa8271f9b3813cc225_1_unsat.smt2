                arg2
                (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)))
(assert (fp.leq (fp #b1 #b00101010011 #b1000011011011111010000101100000111101110011000110100)
                arg2
                (fp #b0 #b00001010100 #b0101101111101001100101110110101010101010101001010001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00110011001 #b0110101010100101101110111110110010000010101101001101)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11100111110 #b0100010111111011010110001111101010100111000010100100)))

(assert (not (= expect result)))

(check-sat)
(exit)
