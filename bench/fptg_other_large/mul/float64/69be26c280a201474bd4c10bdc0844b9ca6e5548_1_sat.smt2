; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010111000 #b0001110101100011001010010000111110100011101100001011)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11110011000 #b1100100010001000011110001011100001110110110100111010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01000110100 #b0101010000010001101001010111000010010010011011010010)
                arg2
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110000110 #b1111111111101100001010101011110111000010011001100100)
                expect
                (fp #b1 #b10111111111 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111111 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b01000110000 #b0011110001110101001111111011000010110100011011100111)))

(assert (= expect result))

(check-sat)
(exit)
