; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001001111 #b0111111010101010101111010001001110100100011010111000)
                arg1
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                arg1
                (fp #b0 #b10101001000 #b0011000010110101100101010011010111001011001111100000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011101010 #b1110011000101100000111110001110101010100010100010111)
                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b00101101000 #b0001011100111110001110101101100101011111010111100110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001010110 #b0001111101011000100110000011010110110101110110110001)
                expect
                (fp #b0 #b00000110100 #b1111110010100000011011001111010110010000100101011100)))
(assert (fp.leq (fp #b0 #b00000110100 #b1111110010100000011011001111010110010000100101011100)
                expect
                (fp #b0 #b10001010101 #b0001001010011001110101001110000010110001000100001001)))

(assert (= expect result))

(check-sat)
(exit)
