; Format: FLOAT64
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001011001 #b1001001101011101000000011111111010100000001010100001)
                arg1
                (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)))
(assert (fp.leq (fp #b1 #b10101101100 #b0011110010001001110001110011010001110100011101010110)
                arg1
                (fp #b0 #b01010101101 #b1001101010001101110011001011001101010011000111000110)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00111111011 #b1000101100000000000001010000101110110011110011000001)
                expect
                (fp #b0 #b11011011001 #b1000011101100100011011011111000001010000101010010000)))
(assert (fp.leq (fp #b0 #b11011011001 #b1000011101100100011011011111000001010000101010010000)
                expect
                (fp #b0 #b11101100011 #b0000000101001010111101111011010110000101001011110000)))

(assert (= expect result))

(check-sat)
(exit)
