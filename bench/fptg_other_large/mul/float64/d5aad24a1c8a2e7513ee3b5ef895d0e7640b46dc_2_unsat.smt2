(assert (fp.leq (fp #b1 #b10000100110 #b1011000111111010010110100010000000110111011001100111)
                arg2
                (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)))
(assert (fp.leq (fp #b0 #b10000101110 #b1001011011001011000100011100111101001001100010100000)
                arg2
                (fp #b0 #b10011110100 #b1000101011100111000101111011101010011111101011001010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100010101 #b0011111010110100001011001101001000101111000111101000)
                expect
                (fp #b1 #b10001100011 #b0000000110101100010101110010011001111110001111000000)))
