(assert (fp.leq (fp #b1 #b10111100011 #b1001100111111011110110101111010110001000101011011001)
                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b11001001000 #b0100000010011010001000101010111011011101011000011010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
