(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00111010101 #b0000001001000001010100111100000111110011100001010001)
                arg1
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)
                arg1
                (fp #b0 #b11011111010 #b0101110001011011011111100100010110100000110000011010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001111010 #b1001000000100100000110111001010010000001000100001011)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01000101100 #b0100101111010100101110001001111011010011011000111100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010001001 #b0111100010001101011010101110100111111001010011101100)
                expect
                (fp #b1 #b01010000110 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b1 #b01010000110 #b0101010010010010001010001101101100110111010110110100)
                expect
                (fp #b0 #b11100100100 #b0001101101101010110001101100000001000010100110010101)))

(assert (= expect result))

(check-sat)
(exit)
