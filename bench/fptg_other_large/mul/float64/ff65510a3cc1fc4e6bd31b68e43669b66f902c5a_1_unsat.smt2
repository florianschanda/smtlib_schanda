; Format: FLOAT64
; Arg1: +ZERO
; Arg2: +ONE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01000001001 #b0010101001011111010010010101011101010110111111010110)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10100001001 #b1001101100010100101101010101010100010011001101000111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001001111 #b1111110111001000000011011111110010011100000101110110)
                arg2
                (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100101101 #b0101001111111101000111101000010000101110111110111101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10011111111 #b1110001100010000100000101011101101010010001100111000)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00000111100 #b0101011100101010001100000110101010100001010010000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
