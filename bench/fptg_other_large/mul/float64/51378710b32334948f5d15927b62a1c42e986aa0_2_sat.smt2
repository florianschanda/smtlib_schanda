(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101001110 #b0100000001001111000000100101101111101110110010110010)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b00001011000 #b0011101011000010000111101110010010000000110101110001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001000011 #b1001100111101110010101010000000111001100000001000101)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b00001011010 #b1010011010101011011011110111111000111101010000110001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101010110 #b0000011001110001111010011000000011001100100010100011)
                expect
                (fp #b0 #b00000110101 #b0100100100110011010010001011100000011111010111110011)))
(assert (fp.leq (fp #b0 #b00000110101 #b0100100100110011010010001011100000011111010111110011)
                expect
                (fp #b0 #b11010111111 #b1101101101011010101001100101100101011111001011110111)))

(assert (= expect result))

(check-sat)
(exit)
