; Format: FLOAT64
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000001111 #b1000000001110110100000011011000000010100100110100000)
                arg1
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10010010011 #b1000011110001001111100110111000001101111101010101110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01100111100 #b1110001001001011010100100110111101010001000100011000)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b11000010111 #b0000111100100111000101011010011011110101000010001100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10010111101 #b1001110101101111100000001111000001010011100000010010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00101010011 #b1101010101011010000011001101101000001111000111111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
