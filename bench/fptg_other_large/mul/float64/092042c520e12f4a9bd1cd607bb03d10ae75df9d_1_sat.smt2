(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0100010111101010111110100011111011001111010011001001)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11001010000 #b1000011001110001011010000110000100011000000101010100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010001111 #b1010010001110101110001000111101110010101010100001111)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b10101011110 #b0100110011111110010000011110111111000110001111011000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00010100011 #b0111000000100101010011001101000100101011011010101100)
                expect
                (fp #b0 #b01111111110 #b0000010100000001101000000010101000101001111000010000)))
(assert (fp.leq (fp #b0 #b01111111110 #b0000010100000001101000000010101000101001111000010000)
                expect
                (fp #b0 #b11000000000 #b1001110001100001100101010100101001010110110010111101)))

(assert (= expect result))

(check-sat)
(exit)
