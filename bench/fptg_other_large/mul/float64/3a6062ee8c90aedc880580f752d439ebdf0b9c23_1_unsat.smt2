(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000000010 #b1000110011110101101111000011000100011011101000101110)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b11110101110 #b1011100100000011100010011100100100110010101011111001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
