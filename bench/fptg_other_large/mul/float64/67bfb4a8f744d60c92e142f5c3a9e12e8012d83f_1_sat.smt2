; Format: FLOAT64
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010000001 #b0000100010101000010110000111100000001100010001001111)
                arg1
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10101100100 #b0111111010010000101001111111110010000111011001001011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001101101 #b0111010010001010100001000000011100101110110011100011)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00001001110 #b1010101111100010111000000000110110000101011110111110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01001000011 #b1011100100110001011110011100101011101111010011111111)
                expect
                (fp #b1 #b01000110101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000110101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01101011110 #b1001110101010000011010111100101101100011010001001011)))

(assert (= expect result))

(check-sat)
(exit)
