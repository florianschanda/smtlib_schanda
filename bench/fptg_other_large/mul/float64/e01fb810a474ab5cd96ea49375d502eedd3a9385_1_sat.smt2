; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0101011000111000101011101011011001010000000100101011)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b1 #b11011010110 #b0111111100110100110011111110111011001000000111010001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10011000111 #b1001000100100011100110101000001111110011110001100011)
                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b10111111111 #b0000001110110110000000111100001100001110100111100111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b1 #b10111110011 #b0100001001101110111110000100111010011000111000000101)))

(assert (= expect result))

(check-sat)
(exit)
