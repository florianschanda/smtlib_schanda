(assert (fp.leq (fp #b1 #b11000010110 #b1111001110101010000100010010001111111111100000111110)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b00110101001 #b0100110001100000110100110000101011100100110101010000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110010001 #b0000101000000011000000011100111111001010110101111011)
                expect
                (fp #b1 #b11010111001 #b0001110100001010011100000000000111111001001111000011)))
