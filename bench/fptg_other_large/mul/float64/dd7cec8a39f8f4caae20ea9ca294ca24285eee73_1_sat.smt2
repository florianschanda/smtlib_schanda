(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b10010110011 #b0101101100010001001001111010001110111010101101011001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01100100011 #b1001011010010011011001101111111110111010000110100010)
                expect
                (fp #b0 #b10000000000 #b1111111111111111111111111111111111111111111111111101)))
(assert (fp.leq (fp #b0 #b10000000000 #b1111111111111111111111111111111111111111111111111101)
                expect
                (fp #b0 #b11000111100 #b0100101100110010010001100000100110011010000001101110)))

(assert (= expect result))

(check-sat)
(exit)
