(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101010001 #b1001000011000000111001000110010011101100000010101111)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b01000110110 #b1101001100101100110110010010011001000111010100110011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01101101111 #b0000010100010111011101011000010001011101010001101110)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b10110000001 #b0101001011110000010010000000001011001001000101100011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00011101101 #b0000001001110111111010101111110010010100001000100100)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11110111100 #b0110110110101001110100100000000101001000000011101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
