(assert (fp.leq (fp #b1 #b10100010110 #b1011110000101110010010001011000011001011101100110010)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01100100101 #b0100111010101001010011111010011111110001010100100101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00001111000 #b1010100000101101010100010100110001111100100001110100)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111011000 #b1011100010111011000001011100001011100110011011111111)))

(assert (= expect result))

(check-sat)
(exit)
