(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1011110101001110000011001001011011101010110011011100)
                arg1
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01000111001 #b1111001111010001001010010010010011000011101101100010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001110111 #b0100101000001111011010000000010001100011010010001101)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b01011011101 #b1010011010111010100110010000001010000101010100100011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
