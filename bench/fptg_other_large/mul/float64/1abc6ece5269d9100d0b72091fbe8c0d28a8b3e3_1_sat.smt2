(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01101000111 #b1101110100100101000011101110101000000100000101100000)
                arg1
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011110001 #b0011110101101101101010001111100100011110001010011110)
                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b10110000100 #b0101100110101100010000011000100011000011001110110001)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01010110011 #b1101110111111011101100011001110101001000001010100010)
                expect
                (fp #b0 #b10000000000 #b1111010001101010110001110110100011101111001110100001)))
(assert (fp.leq (fp #b0 #b10000000000 #b1111010001101010110001110110100011101111001110100001)
                expect
                (fp #b0 #b11100011111 #b0101100111101010010101001111010001010111001010011001)))

(assert (= expect result))

(check-sat)
(exit)
