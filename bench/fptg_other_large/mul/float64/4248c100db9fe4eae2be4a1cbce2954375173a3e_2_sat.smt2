(assert (fp.leq (fp #b0 #b01111111111 #b1000110000000100100100111111010001010001011010011011)
                arg2
                (fp #b0 #b11011001011 #b1110000011101111111111101100100101011000011001000100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101010111 #b1111110010000011111001111010111111000000000101001011)
                expect
                (fp #b0 #b00000000000 #b0110001100000001001001001111110100010100010110100111)))
