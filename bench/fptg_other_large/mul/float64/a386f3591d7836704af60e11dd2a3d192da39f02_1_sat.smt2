; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01001001100 #b0110010110110100110001100010111001100101111101111010)
                arg1
                (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)
                arg1
                (fp #b0 #b11010000100 #b0111111111101101111011110110100011011010001110000111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0111000000001100100000111000011110100111101101000000)
                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b10001010011 #b1000101101000000101011110110001010110001100001000111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00011010101 #b1011011000111111111110010100111000101101110100101110)
                expect
                (fp #b0 #b10010000001 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b0 #b10010000001 #b1001010101101111110010101001101111101101000000101011)
                expect
                (fp #b0 #b10110111101 #b0010010000000000010011001011111000100000111111001100)))

(assert (= expect result))

(check-sat)
(exit)
