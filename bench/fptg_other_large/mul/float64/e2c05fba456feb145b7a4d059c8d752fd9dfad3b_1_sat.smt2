; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00001001100 #b1000011001100101110011111111111001101100111000100111)
                arg1
                (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)
                arg1
                (fp #b0 #b10011000100 #b1001011011110001000000110000001111101001000110010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10111110110 #b1000000111011011010001111110111111011010111101000011)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b00001011101 #b0010110011001100100110111000011110100010111000111110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10100110001 #b0001011101001010001101000011100001010111100110111011)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010011100 #b0100111010111111111001011110000000110100101011011111)))

(assert (= expect result))

(check-sat)
(exit)
