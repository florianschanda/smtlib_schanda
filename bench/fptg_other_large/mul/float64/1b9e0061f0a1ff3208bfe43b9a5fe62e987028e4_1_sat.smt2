(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b00100000100 #b1111101011000000001011111111001111001101011110011100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011001011 #b1110001101111011001101111111100100011110010110100000)
                expect
                (fp #b0 #b01111000110 #b0100000101110010100111101001111010000011101100110101)))
