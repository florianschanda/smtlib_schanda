;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10101010110 #b0100100111111010110010101101110110011110000100011110)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b01110111100 #b1101000001001011000001000110111010101101110011000100)))

(declare-const arg2 Float64)
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01001001001 #b1100000110011010110010010010010110111000000111111101)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01110000000 #b0001100111110001011110110111110001011001101010110000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01110000110 #b0101011100000100000000000010100011001111011001110001)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10011110001 #b0100010111100001100100010000100010110110001100100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
