; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011000101 #b0010000000000110101100111000101001110011011011011000)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b1 #b01001011010 #b1001000111110011110010111010100111000101011101100001)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01111110110 #b0110011111111010000111100000000111100101100011100111)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b1 #b00011100011 #b1111100110000010110101100011000010001111110011100101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011011010 #b0101101101101110101111100000011001000100110101111101)
                expect
                (fp #b0 #b01010011000 #b1111101111100100011101110010111011010010101110001011)))
(assert (fp.leq (fp #b0 #b01010011000 #b1111101111100100011101110010111011010010101110001011)
                expect
                (fp #b0 #b11000101101 #b0101111101011001001000010001110001111001100110000010)))

(assert (= expect result))

(check-sat)
(exit)
