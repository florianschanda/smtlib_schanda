                arg2
                (fp #b0 #b01101110100 #b1100110000001101010000110101000101111101100001000000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101000000 #b1000000100000101000100010001101001110000100101011011)
                expect
                (fp #b1 #b01111111111 #b1011010100111010011011101110000001101001110111010111)))
(assert (fp.leq (fp #b1 #b01111111111 #b1011010100111010011011101110000001101001110111010111)
                expect
                (fp #b1 #b01100110010 #b1010100011111101011110111001100101100111010110000000)))

(assert (= expect result))

(check-sat)
