                arg1
                (fp #b1 #b01010101100 #b1011010100001101010100011110100000100001111111001000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000111110 #b0000000011000010111111110011000101101001111011001010)
                arg2
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01011111000 #b0101011101001011110110111010100000000101110001000111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100001111 #b1110111110000000000101110111000001000000010001100000)
                expect
                (fp #b0 #b01000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b01000000000 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b11111010000 #b1000001011011111110011100100111110110010110100000000)))

(assert (= expect result))

(check-sat)
(exit)
