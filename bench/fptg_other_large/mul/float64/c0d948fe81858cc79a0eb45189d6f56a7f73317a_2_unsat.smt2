                arg1
                (fp #b0 #b11101000000 #b1010110110110100111110011000001111101010101111100011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101100001 #b0001000100100111010110101110011110101101110100101110)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111101 #b0011111100001100011011101011011111000000011111110110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
