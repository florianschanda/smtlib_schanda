; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111011100 #b1101010000111100010110010110001100000100110000010110)
                arg1
                (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)
                arg1
                (fp #b0 #b01000000101 #b0010110011101010110110000101101100101111100100111101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100011100 #b0010000100110110010110001100111101001111111001010000)
                arg2
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011100101 #b1000111001001111100001011100101010011110000100100100)
                expect
                (fp #b1 #b10010000011 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b1 #b10010000011 #b1001010101101111110010101001101111101101000000101011)
                expect
                (fp #b0 #b01111011000 #b1011010000110001101111010101001110011011111110010011)))

(assert (= expect result))

(check-sat)
(exit)
