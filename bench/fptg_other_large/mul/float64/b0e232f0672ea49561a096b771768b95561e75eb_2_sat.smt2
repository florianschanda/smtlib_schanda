;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b00000101101 #b0001110011011000100010100110000110010000010101111111)
                arg1
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                arg1
                (fp #b0 #b11100000100 #b0100000010101100100101110000001000000101011011010100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01010011001 #b1001110000000100010100010110101011000110110100101100)
                arg2
                (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)))
(assert (fp.leq (fp #b0 #b01110100100 #b1010011010011101110001111011010101000010101110111011)
                arg2
                (fp #b0 #b01110110000 #b0010110110001011010111011010101001100111101001000101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01010100111 #b0000000010011001001000010000011010000001000011001001)
                expect
                (fp #b0 #b01111011000 #b1010110110001100101011100000110001000100111110011110)))
(assert (fp.leq (fp #b0 #b01111011000 #b1010110110001100101011100000110001000100111110011110)
                expect
                (fp #b0 #b11101100101 #b0001001011011100010110010011110101101000100111001000)))

(assert (= expect result))

(check-sat)
(exit)
