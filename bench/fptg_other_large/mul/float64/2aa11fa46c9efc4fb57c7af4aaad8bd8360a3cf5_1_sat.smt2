                arg2
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10011001001 #b0001100001110001000010010111111111110110101111100000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10000111001 #b1001111110011010010101100011110011101011100100010100)
                expect
                (fp #b0 #b10111111110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11101110011 #b1001001101100101010001110110011100111010111011000111)))

(assert (= expect result))

(check-sat)
(exit)
