; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101101110 #b0110000010111100011110010010100100001011110100011010)
                arg1
                (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)))
(assert (fp.leq (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)
                arg1
                (fp #b0 #b00011000100 #b0010011001101111011001011000001000001010010011000011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01001000001 #b1100111010101010111111100001000010000001010111101010)
                arg2
                (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b1111010110101011010111001000001101011100110011110101)
                arg2
                (fp #b0 #b11111110111 #b0011001010111010011010101000111110011110101000111000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010110110 #b1011001111111110110111010011111110100101000100010000)
                expect
                (fp #b1 #b10001100010 #b1000001010011101101110101111010000111001111111111010)))
(assert (fp.leq (fp #b1 #b10001100010 #b1000001010011101101110101111010000111001111111111010)
                expect
                (fp #b0 #b00100001001 #b1100101010001111011000010110101111000011111111101001)))

(assert (= expect result))

(check-sat)
(exit)
