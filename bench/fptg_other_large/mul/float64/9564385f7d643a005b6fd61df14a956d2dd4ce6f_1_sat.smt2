(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110110001 #b1010011111111111101010001011101011010001011000010010)
                arg1
                (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)))
(assert (fp.leq (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)
                arg1
                (fp #b0 #b01111111110 #b0100011010000100101000110000010010011110011001111101)))

(declare-const arg2 Float64)
(assert (= arg2 arg1))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00010011101 #b1000100110100011001101010001111000001110010110101100)
                expect
                (fp #b0 #b00101101000 #b0011000000010101101101011100101001110000010000001110)))
(assert (fp.leq (fp #b0 #b00101101000 #b0011000000010101101101011100101001110000010000001110)
                expect
                (fp #b0 #b01011011100 #b0000011001001100110010000011100001100000000010110101)))

(assert (= expect result))

(check-sat)
(exit)
