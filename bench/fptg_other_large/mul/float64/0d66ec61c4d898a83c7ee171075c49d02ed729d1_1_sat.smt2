; Format: FLOAT64
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110110001 #b0001101010011111110101001001111110100011010101111111)
                arg1
                (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b00100110010 #b1000001101000010011000110111111001011001011100000101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11011110110 #b0101011111110000001100100101011011010010010100110011)
                arg2
                (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1100101010011001001001001001011011100000011111000100)
                arg2
                (fp #b0 #b11001010100 #b1001000101100110101011001101010010010101110110111000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b10101010100 #b0010011101111001000011000111100011101001101001001100)
                expect
                (fp #b0 #b10111111111 #b1100101010011001001001001001011011100000011111000011)))
(assert (fp.leq (fp #b0 #b10111111111 #b1100101010011001001001001001011011100000011111000011)
                expect
                (fp #b0 #b11110110111 #b1011100110101011110000001010101110011010100001111100)))

(assert (= expect result))

(check-sat)
(exit)
