; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b0 #b01100000110 #b0100010100110001011000000010001100000000101010100101)
                arg1
                (fp #b0 #b11100110111 #b0001101001011001100011011000100011001100010101111001)))
(assert (fp.leq (fp #b0 #b11100110111 #b0001101001011001100011011000100011001100010101111001)
                arg1
                (fp #b0 #b11110101011 #b1010010000100111100100011010011001100011011100000010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11101001101 #b0100100010100101001011111010000110101000110111010011)
                arg2
                (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)))
(assert (fp.leq (fp #b1 #b11011110101 #b1111001110110000110000000000001000011000111011100101)
                arg2
                (fp #b0 #b00110101001 #b1010000101011001100010010110111110101101110000110101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
