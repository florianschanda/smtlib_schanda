; Format: FLOAT64
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11101011110 #b1110101110111101011010110111100011010110001101111100)
                arg1
                (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b11111111111 #b0000000000000000000000000000000000000000000000000000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001110100 #b0100000100111001110110111101110110101011101100101111)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b01000101100 #b0101011100111111110001111011011111111101010110010011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00100110100 #b1000111111110011001010101111011101011110011100010010)
                expect
                (fp #b0 #b10000000000 #b0101010001000101001010101100100110010101010011011101)))
(assert (fp.leq (fp #b0 #b10000000000 #b0101010001000101001010101100100110010101010011011101)
                expect
                (fp #b0 #b10110101010 #b1111111001101010011011100110001010000010110011111101)))

(assert (= expect result))

(check-sat)
(exit)
