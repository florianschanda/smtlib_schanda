; Format: FLOAT64
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11001010000 #b0101110110000111101101111011111011110111011110110100)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
(assert (fp.leq (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)
                arg1
                (fp #b0 #b11001101101 #b1010011010100100100001011011110111111100001001010100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10000001011 #b0101110011100110101010000100011111011111010011111001)
                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01100000001 #b1111011110010001010110000010001110111100101010000011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111100000 #b1111010010101000001001110000001101010001101100001001)
                expect
                (fp #b1 #b00011100110 #b0011001000001001001011101011000100110011001001000100)))
(assert (fp.leq (fp #b1 #b00011100110 #b0011001000001001001011101011000100110011001001000100)
                expect
                (fp #b0 #b01000001110 #b1100000001101110000010110010111001011100101101001011)))

(assert (= expect result))

(check-sat)
(exit)
