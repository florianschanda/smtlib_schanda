                arg2
                (fp #b0 #b01000001001 #b0110011010110100010110101100010000001001100010101101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011010110 #b0001010011101010000100011010100100001010101010111110)
                expect
