(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001001010 #b0000000101001011001011100010010010011100100001101100)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b1 #b00001110011 #b1011101010001111011100011000010101100001110100101010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00100001101 #b0010100001011001001000111110000110000110010100101100)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00110111111 #b0101101000000011000001001011010101101111100110001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
