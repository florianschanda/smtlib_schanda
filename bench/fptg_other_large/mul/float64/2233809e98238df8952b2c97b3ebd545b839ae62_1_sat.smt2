(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011101011 #b1110111101011010101010111001001101000110100100011100)
                arg1
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)
                arg1
                (fp #b1 #b01110110101 #b1110000010110011010110110101001101111011110100011010)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
