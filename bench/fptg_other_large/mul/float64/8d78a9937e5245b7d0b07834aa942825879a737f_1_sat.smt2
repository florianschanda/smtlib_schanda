; Format: FLOAT64
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10011001000 #b1110100000010010111010101110010101011111001101111011)
                arg1
                (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0110011110000111010000001011110110011010001010111010)
                arg1
                (fp #b0 #b01110001111 #b1111100001001110110111101100001001001100001001011000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1011000111100101000111001100100010100110110001111011)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b10110111011 #b0100010001001001011110011010001001001111000100010000)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01100100111 #b1100010001000110001000010001110010000101100111101011)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01100101110 #b0011100010101010101100010000000011011100000101110001)))

(assert (= expect result))

(check-sat)
(exit)
