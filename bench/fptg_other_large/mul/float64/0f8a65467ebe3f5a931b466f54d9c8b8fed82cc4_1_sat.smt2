; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01000010101 #b1110100001011001100110000001000000110001100110010101)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11111100011 #b0000110001100110111001001100101100010001011110110000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10010111001 #b1010011110111001100011001000011110001100110100000001)
                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11001111111 #b1000011001001111111010010100000100110000110111110100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001101101 #b1010101010110110101001101001111111111111010111101100)
                expect
                (fp #b1 #b00100000001 #b1111010100011001100100010111000110110110111011010110)))
(assert (fp.leq (fp #b1 #b00100000001 #b1111010100011001100100010111000110110110111011010110)
                expect
                (fp #b0 #b11111001001 #b0101011010010001100000001110011111111100100110000111)))

(assert (= expect result))

(check-sat)
(exit)
