(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01011000111 #b1100101111101010101101010110001001010000010000001000)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
