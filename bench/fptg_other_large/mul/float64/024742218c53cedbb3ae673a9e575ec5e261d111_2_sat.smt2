                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110010011001010101001101111)
                arg2
                (fp #b0 #b01001000100 #b1101100010001100100001101100110001001011000001001011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110111110 #b1110100101111000001000001001010111001101101100011010)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b10001000000 #b0011000111110110111001111111110011111111111100000111)))

(assert (= expect result))

(check-sat)
(exit)
