(assert (fp.leq (fp #b1 #b11100101001 #b1010111000011001010010111100111110111001100110110011)
                arg2
                (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)))
(assert (fp.leq (fp #b1 #b11011110011 #b1101111100011011111110101010000000001000001111001010)
                arg2
                (fp #b0 #b01000001011 #b1010101100011001111001100000100111000100100101100100)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011001100 #b0100101100111111011011011010011111001010110100101001)
                expect
                (fp #b1 #b01011110101 #b1010001011100111011111101101010111001000001000101011)))
