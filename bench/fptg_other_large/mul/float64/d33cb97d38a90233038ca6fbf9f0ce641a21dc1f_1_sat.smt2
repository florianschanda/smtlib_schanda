(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111000010 #b0111111111010110100000011000011000110001110111001000)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b0 #b01110110101 #b1010101110001000010101111110101111100011101110001111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111010000 #b1110100011100101010100001011111011110001000101111110)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b11011001111 #b0011010011001011011001001100001011010000011100100010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101111010 #b0101011000001010101001011101100000110111101010101111)
                expect
                (fp #b0 #b00000110100 #b0100101010100111111110010011110001111111011110001010)))
(assert (fp.leq (fp #b0 #b00000110100 #b0100101010100111111110010011110001111111011110001010)
                expect
                (fp #b0 #b10100111010 #b1001011010110100100000000101110001010100001100000111)))

(assert (= expect result))

(check-sat)
(exit)
