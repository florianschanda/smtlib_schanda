                arg2
                (fp #b0 #b11000111110 #b1010111011101111011101111000011010111001110010010111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100110010 #b1000010110100001010111101010001011010111101100001110)
                expect
                (fp #b1 #b00110101101 #b1111010110101011010111001000001101011100110011110101)))
