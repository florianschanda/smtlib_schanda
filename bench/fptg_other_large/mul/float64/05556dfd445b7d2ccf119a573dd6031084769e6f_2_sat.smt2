(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000010011 #b0000100100100110110010101010111110111011100100001011)
                arg1
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b10011011010 #b0100101001101111110010011110001111111111011001001101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01001010001 #b0010010001011011111100110101000001111010111010000000)
                arg2
                (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111101000110101011000111011010001110111100111010001)
                arg2
                (fp #b0 #b00111101110 #b1100101000110111111110111011000110110101011111101111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100100000 #b0101000100101000011001110000101000001000110001000110)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11001111000 #b1110100001101001010110111110100110000001001001011010)))

(assert (= expect result))

(check-sat)
(exit)
