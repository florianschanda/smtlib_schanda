; Format: FLOAT64
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010110000 #b1110000110001111101111010100000111110010010111001101)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg1
                (fp #b0 #b11010101001 #b1111110010101010100011101000100100100000001101011100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10001011100 #b0001100111110110000100011100111011001100011101100101)
                arg2
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101001100 #b0110010011101110011000111011001010111101101011110011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00011101100 #b0101100110010110001011110000100010010111101001011001)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b00010100011 #b1111000001001000110000001110100001100100010010000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
