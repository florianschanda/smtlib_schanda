                arg2
                (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b10111011011 #b1010011100110110011001010111111100111000101111010010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00100101101 #b1001010100111001011111000010001111011111010110111001)
                expect
                (fp #b0 #b01000000000 #b1111111111111111111111111111111111111111111111111101)))
