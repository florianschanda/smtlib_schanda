                arg2
                (fp #b0 #b01001001101 #b0101111100000001011001111100100100110010110100111111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111001100 #b1011010110100010011001001011011110011101100100110001)
                expect
                (fp #b0 #b00000110011 #b1011001110000111100110000001000000010101101000110000)))
