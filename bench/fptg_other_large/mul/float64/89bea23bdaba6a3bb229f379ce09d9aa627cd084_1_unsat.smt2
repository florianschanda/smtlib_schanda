                arg2
                (fp #b0 #b11011001001 #b1111010001100010000111011001011011111111111001011010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01110001111 #b1100001101101111010111011001111110111110110110010000)
                expect
