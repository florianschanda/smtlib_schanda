                arg2
                (fp #b0 #b11111111000 #b1000000101111101010001111100110010000010101110111111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011001010 #b1010110100100110111011011010001000100011111011100110)
                expect
                (fp #b0 #b00011010010 #b1011100111101011010100110100010000101101001101001101)))
