                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b10110001111 #b1000100111000010001011010110001011111100100010101110)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00101001000 #b1110100110001111001000101010000010011100010000101100)
                expect
                (fp #b1 #b00100100101 #b0001001011100110011011111011010000011110111000111100)))
(assert (fp.leq (fp #b1 #b00100100101 #b0001001011100110011011111011010000011110111000111100)
                expect
                (fp #b0 #b01011110011 #b0101100000110000000100111001101010110011111000111111)))

(assert (= expect result))

(check-sat)
(exit)
