(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010111001 #b0000001111010110110001001111110111111011001100110000)
                arg1
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b00001101111 #b0010110101101110010001000011011100001110100100001100)))

(declare-const arg2 Float64)
