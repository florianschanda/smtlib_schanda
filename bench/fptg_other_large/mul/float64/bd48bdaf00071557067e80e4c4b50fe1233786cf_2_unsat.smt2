; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101110100 #b1110011100000010100001001001000011110111111010010100)
                arg1
                (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)))
(assert (fp.leq (fp #b1 #b00010000011 #b1001010101101111110010101001101111101101000000101011)
                arg1
                (fp #b0 #b00110010101 #b1011110001010001001000011101100100111100000101110100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01011001011 #b0011000111101110010110001011110010110111010010100100)
                arg2
                (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)))
(assert (fp.leq (fp #b1 #b00000000000 #b0110110101001110100110111011100000011010011101110110)
                arg2
                (fp #b0 #b00000011011 #b0011011100010011001001001001110001111110001011100101)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10011101011 #b0000001001010100111100111010000111001100000000010000)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b01101111000 #b0101000001110001101011111010110001110110001110010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
