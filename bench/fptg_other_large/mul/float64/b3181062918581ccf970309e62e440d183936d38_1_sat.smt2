; Format: FLOAT64
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10010010001 #b1000011011101111010000001001111100110100011110101100)
                arg1
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00101101100 #b0100011010010101001010000100011111011011110011111011)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b0001010100101111011100011001011101110100111001010101)
                arg2
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10100110100 #b1100000111011010101100101010100100110100000111110010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111111100 #b0010100011011010101101000111001100000001010010110010)
                expect
                (fp #b0 #b10111111110 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10111111110 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11001011000 #b0111011000110011011000000000101110001000100000111010)))

(assert (= expect result))

(check-sat)
(exit)
