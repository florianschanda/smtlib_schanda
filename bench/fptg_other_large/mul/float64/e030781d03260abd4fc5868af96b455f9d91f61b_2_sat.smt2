(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010110101 #b1001011100111011100001001001101001011100010001111010)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b10100000101 #b1100001110000011011011101111100110101100010101001111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00110000110 #b0111110000110011100011111001001010011000001001101101)
                arg2
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b01000000000 #b0011111111101100110110111001101100001001110101001011)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00100100101 #b1101000011110011001010100010101011101001101001001111)
                expect
                (fp #b0 #b00000101100 #b1100100111100000111101011011101011001000110111111111)))
(assert (fp.leq (fp #b0 #b00000101100 #b1100100111100000111101011011101011001000110111111111)
                expect
                (fp #b0 #b00101110011 #b0100010111010000001110111010100100101011000000111111)))

(assert (= expect result))

(check-sat)
(exit)
