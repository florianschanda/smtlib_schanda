                arg2
                (fp #b0 #b11111100001 #b1010010011011111100111001110010010001011010001010010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100000011 #b0010101110000100011100111100101001000001101110100101)
                expect
