(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: PARTIAL
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01010011001 #b1000100001111010110010111001100011000000101110100101)
                arg1
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                arg1
                (fp #b0 #b11110000111 #b1000000110010010110111111000011101011111111011000100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11010000011 #b0101100011011110001011000111100111110110001010000100)
                arg2
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b01000100011 #b1000000010001010010010010111110110000111110110000010)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010110101 #b1011001000110101011011001110100101110101010000000010)
                expect
                (fp #b1 #b10100110100 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b1 #b10100110100 #b1111010100011001100100010111000110110110111011011000)
                expect
                (fp #b0 #b01101110101 #b1000111010000100111110011110111101011011100011101001)))

(assert (= expect result))

(check-sat)
(exit)
