(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00010001010 #b1110011000010100000101100100001111001011100111111000)))

(assert (= expect result))

(check-sat)
(exit)
