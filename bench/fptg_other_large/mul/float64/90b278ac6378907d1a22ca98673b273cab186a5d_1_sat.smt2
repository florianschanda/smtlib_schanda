; Format: FLOAT64
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b01101111101 #b0111011010111000101010101101111100110110110010111100)
                arg1
                (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)))
(assert (fp.leq (fp #b1 #b01010110011 #b1000101010010011110110000110111000000001000010100000)
                arg1
                (fp #b0 #b10000100011 #b0010100010000010110011001011110001111101011111010010)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b1 #b10001011100 #b0100101101001000101000001011011110010001011111011111)))

(declare-const result Float64)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100110110 #b0001100010011111111100100101010011100000100100100111)
                expect
                (fp #b0 #b11010110011 #b1000101010010011110110000110111000000001000010011111)))
(assert (fp.leq (fp #b0 #b11010110011 #b1000101010010011110110000110111000000001000010011111)
                expect
                (fp #b0 #b11111110000 #b1100000100110001000000101001111000001011001011100110)))

(assert (= expect result))

(check-sat)
(exit)
