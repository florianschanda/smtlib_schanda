(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b111111011000100 #b001000011100010000000000001110100000010100110010110010000001001)
                arg1
                (fp #b0 #b100100000110010 #b001000001001001011101011000100110011001001000100111111010001000)))
(assert (fp.leq (fp #b0 #b100100000110010 #b001000001001001011101011000100110011001001000100111111010001000)
                arg1
                (fp #b0 #b101110111011010 #b010110010100111000111101100100010101100011101001011000001101000)))

(declare-const arg2 (_ FloatingPoint 15 64))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 64))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
