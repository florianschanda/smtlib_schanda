;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b011110111000011 #b001111011110100101000011111011111001000110110111000101110111001)
                arg1
                (fp #b1 #b000000000000000 #b111111111111111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b111111111111111111111111111111111111111111111111111111111111111)
                arg1
                (fp #b0 #b000010001011011 #b101000101001110000000101010101000110000110011110101011010100100)))

(declare-const arg2 (_ FloatingPoint 15 64))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 64))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
