; Format: X87_EXTENDED_DOUBLE
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 64))
(assert (fp.leq (fp #b1 #b101101010110010 #b100000110001000010000011110101100101101010001001011010011101110)
                arg1
                (fp #b1 #b000000000000000 #b110001001010101010101101110010000000101011001001011100000001100)))
(assert (fp.leq (fp #b1 #b000000000000000 #b110001001010101010101101110010000000101011001001011100000001100)
                arg1
                (fp #b0 #b110110001011010 #b110101111101001101101101100011111011000111110111111110001101000)))

(declare-const arg2 (_ FloatingPoint 15 64))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 64))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 64))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
