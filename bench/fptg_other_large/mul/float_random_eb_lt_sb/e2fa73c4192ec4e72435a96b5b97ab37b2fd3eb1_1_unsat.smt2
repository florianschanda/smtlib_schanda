(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 17))
(assert (fp.leq (fp #b1 #b100100101111010 #b0010000000101011)
                arg1
                (fp #b1 #b000000000000000 #b1111111111111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1111111111111111)
                arg1
                (fp #b0 #b101001000101001 #b0100101101111111)))

(declare-const arg2 (_ FloatingPoint 15 17))
(assert (fp.leq (fp #b0 #b010100011110000 #b0111011000011101)
                arg2
                (fp #b0 #b101101011010000 #b0101101010110110)))
(assert (fp.leq (fp #b0 #b101101011010000 #b0101101010110110)
                arg2
                (fp #b0 #b111011100010111 #b0010001000001110)))

(declare-const result (_ FloatingPoint 15 17))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 17))
(assert (fp.leq (fp #b1 #b001110010000110 #b1000110010100101)
                expect
                (fp #b1 #b001101011010010 #b0101101010110100)))
(assert (fp.leq (fp #b1 #b001101011010010 #b0101101010110100)
                expect
                (fp #b0 #b101100001110100 #b0000100100011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
