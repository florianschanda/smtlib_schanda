(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 26))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 3 26))
(assert (fp.leq (fp #b1 #b001 #b1010011100010100010011010)
                arg2
                (fp #b0 #b000 #b1000110101011001010010110)))
(assert (fp.leq (fp #b0 #b000 #b1000110101011001010010110)
                arg2
                (fp #b0 #b101 #b1011111110000111110001001)))

(declare-const result (_ FloatingPoint 3 26))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 26))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
