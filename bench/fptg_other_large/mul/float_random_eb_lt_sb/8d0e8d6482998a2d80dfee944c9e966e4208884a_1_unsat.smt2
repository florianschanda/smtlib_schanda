; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +NAN
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 22))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 22))
(assert (fp.leq (fp #b1 #b1110011110 #b010000011110101011110)
                arg2
                (fp #b1 #b1011111110 #b111111111111111111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111111111111111111)
                arg2
                (fp #b0 #b0011011101 #b001101110011111001110)))

(declare-const result (_ FloatingPoint 10 22))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 22))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
