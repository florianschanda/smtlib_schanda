(declare-const arg2 (_ FloatingPoint 15 23))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 15 23))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 23))
(assert (fp.leq (fp #b1 #b111000101100100 #b0010111011101100100001)
                expect
                (fp #b1 #b110011110100100 #b0100111101101011111101)))
(assert (fp.leq (fp #b1 #b110011110100100 #b0100111101101011111101)
                expect
                (fp #b1 #b010101111010100 #b0001100111001100101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
