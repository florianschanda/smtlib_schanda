(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 23))
(assert (fp.leq (fp #b1 #b111001101101011 #b1010101011000010010000)
