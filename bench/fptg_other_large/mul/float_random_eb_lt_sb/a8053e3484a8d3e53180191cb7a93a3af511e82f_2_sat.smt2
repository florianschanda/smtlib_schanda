                arg2
                (fp #b1 #b11110 #b111111111111111000000000000)))
(assert (fp.leq (fp #b1 #b11110 #b111111111111111000000000000)
                arg2
                (fp #b1 #b10001 #b001000100100111101111110011)))

(declare-const result (_ FloatingPoint 5 28))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 5 28))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
