;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 16))
(assert (fp.leq (fp #b1 #b11000001000000 #b110010010101110)
                arg1
                (fp #b1 #b10111111111110 #b111111111111111)))
(assert (fp.leq (fp #b1 #b10111111111110 #b111111111111111)
                arg1
                (fp #b0 #b01010000010001 #b010101101100000)))

