                arg2
                (fp #b0 #b10000010000101 #b010101110011111)))
(assert (fp.leq (fp #b0 #b10000010000101 #b010101110011111)
                arg2
                (fp #b0 #b11101000010101 #b101110101011110)))

(declare-const result (_ FloatingPoint 14 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 16))
(assert (fp.leq (fp #b1 #b11100110100110 #b010001101111010)
                expect
                (fp #b1 #b11000010000101 #b010101110011111)))
(assert (fp.leq (fp #b1 #b11000010000101 #b010101110011111)
                expect
                (fp #b0 #b00010101111010 #b000001100010110)))

(assert (= expect result))

(check-sat)
(exit)
