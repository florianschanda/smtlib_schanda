(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 16))
(assert (fp.leq (fp #b1 #b111101000111011 #b011100101101000)
                arg1
                (fp #b1 #b110111011100000 #b001000011110001)))
(assert (fp.leq (fp #b1 #b110111011100000 #b001000011110001)
                arg1
                (fp #b0 #b101111110111000 #b000010100000011)))

(declare-const arg2 (_ FloatingPoint 15 16))
(assert (fp.leq (fp #b1 #b110000100100100 #b100010110110001)
                arg2
                (fp #b1 #b101111001100101 #b011101100010011)))
(assert (fp.leq (fp #b1 #b101111001100101 #b011101100010011)
                arg2
                (fp #b1 #b011000000011000 #b111011011011001)))

(declare-const result (_ FloatingPoint 15 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
