;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 8 26))
(assert (fp.leq (fp #b1 #b11001011 #b0011100011000001110000100)
                arg1
                (fp #b1 #b10010111 #b0001010000010110010100010)))
(assert (fp.leq (fp #b1 #b10010111 #b0001010000010110010100010)
                arg1
                (fp #b0 #b01110101 #b0111011000001011001100100)))

(declare-const arg2 (_ FloatingPoint 8 26))
(assert (fp.leq (fp #b0 #b01011100 #b0010100000100000111001000)
                arg2
                (fp #b0 #b10110110 #b1110001001011100110011010)))
(assert (fp.leq (fp #b0 #b10110110 #b1110001001011100110011010)
                arg2
                (fp #b0 #b11100000 #b1100011001011000111111011)))

(declare-const result (_ FloatingPoint 8 26))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 26))
(assert (fp.leq (fp #b1 #b11101011 #b0010111100111000000110110)
                expect
                (fp #b1 #b11001111 #b0000010000011011000011010)))
(assert (fp.leq (fp #b1 #b11001111 #b0000010000011011000011010)
                expect
                (fp #b1 #b00111111 #b0001100001000010100010010)))

(assert (= expect result))

(check-sat)
(exit)
