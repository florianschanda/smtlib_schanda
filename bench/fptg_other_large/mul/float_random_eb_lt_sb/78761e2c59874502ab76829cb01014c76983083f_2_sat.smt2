; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
