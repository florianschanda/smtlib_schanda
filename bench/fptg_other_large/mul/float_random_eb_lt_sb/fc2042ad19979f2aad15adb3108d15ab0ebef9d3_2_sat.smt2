                arg1
                (fp #b1 #b0011000100101 #b11010001101011101101111000111101110111101110111)))

(declare-const arg2 (_ FloatingPoint 13 48))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 13 48))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 48))
(assert (fp.leq (fp #b1 #b1110001001011 #b11000101111110010000110111001100110101011111111)
                expect
                (fp #b1 #b1100011011000 #b11100100101011100010101111111111101101000010101)))
(assert (fp.leq (fp #b1 #b1100011011000 #b11100100101011100010101111111111101101000010101)
                expect
                (fp #b0 #b1110001110100 #b01011000000010111110000011000000011011011001010)))

(assert (= expect result))

(check-sat)
(exit)
