; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +INFINITY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 34))
(assert (fp.leq (fp #b1 #b1101010000 #b100100001000000111101010101010111)
                arg1
                (fp #b0 #b0000000000 #b111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111111111111111111111111111111)
                arg1
                (fp #b0 #b0110001100 #b000110111101110110001100111010100)))

(declare-const arg2 (_ FloatingPoint 10 34))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 10 34))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 34))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
