; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 37))
(assert (fp.leq (fp #b1 #b1110 #b111111111111011001111110101001010101)
                arg1
                (fp #b1 #b1110 #b111111100111100100010011111001011000)))
(assert (fp.leq (fp #b1 #b1110 #b111111100111100100010011111001011000)
                arg1
                (fp #b0 #b0100 #b110100001101110110100011110010101101)))

(declare-const arg2 (_ FloatingPoint 4 37))
(assert (fp.leq (fp #b1 #b1010 #b000011010100001111111110010101011111)
                arg2
                (fp #b0 #b1110 #b111111100000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b1110 #b111111100000000000000000000000000000)
                arg2
                (fp #b0 #b1110 #b111111110001000011111011011001110011)))

(declare-const result (_ FloatingPoint 4 37))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 4 37))
(assert (fp.leq (fp #b1 #b1111 #b000000000000000000000000000000000000)
                expect
                (fp #b1 #b1110 #b111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b1110 #b111111111111111111111111111111111111)
                expect
                (fp #b0 #b0000 #b001111100011111100000110101010111100)))

(assert (= expect result))

(check-sat)
(exit)
