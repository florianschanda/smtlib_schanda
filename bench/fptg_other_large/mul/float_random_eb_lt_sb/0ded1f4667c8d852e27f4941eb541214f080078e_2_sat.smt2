(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 24))
(assert (fp.leq (fp #b1 #b100011001 #b10111011000010111111001)
