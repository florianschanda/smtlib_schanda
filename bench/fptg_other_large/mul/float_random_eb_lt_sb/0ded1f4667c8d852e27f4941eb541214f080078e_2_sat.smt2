                arg2
                (fp #b1 #b011111111 #b01110010101001111111010)))
(assert (fp.leq (fp #b1 #b011111111 #b01110010101001111111010)
                arg2
                (fp #b1 #b001110100 #b11111011111100011110100)))

(declare-const result (_ FloatingPoint 9 24))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 24))
(assert (fp.leq (fp #b1 #b110011110 #b01010001110111001100111)
                expect
                (fp #b0 #b010101110 #b00101111000100101000110)))
(assert (fp.leq (fp #b0 #b010101110 #b00101111000100101000110)
                expect
                (fp #b0 #b100010100 #b01010000001011101010110)))

(assert (= expect result))

(check-sat)
(exit)
