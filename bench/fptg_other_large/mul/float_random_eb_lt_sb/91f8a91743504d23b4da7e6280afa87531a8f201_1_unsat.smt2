; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -INFINITY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 37))
(assert (fp.leq (fp #b1 #b100 #b000010000001011001000010111111000010)
                arg1
                (fp #b0 #b011 #b000011110000111111111110001010111011)))
(assert (fp.leq (fp #b0 #b011 #b000011110000111111111110001010111011)
                arg1
                (fp #b0 #b101 #b000110101000000010010011110101110110)))

(declare-const arg2 (_ FloatingPoint 3 37))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 3 37))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 37))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
