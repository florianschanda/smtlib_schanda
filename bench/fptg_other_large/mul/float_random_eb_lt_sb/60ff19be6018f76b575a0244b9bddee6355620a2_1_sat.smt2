;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 30))
(assert (fp.leq (fp #b1 #b11110010 #b10101000011101000111100101011)
                arg1
                (fp #b1 #b00000000 #b01011000101010000100101110010)))
(assert (fp.leq (fp #b1 #b00000000 #b01011000101010000100101110010)
                arg1
                (fp #b0 #b01011010 #b10111100000010101110011000001)))

(declare-const arg2 (_ FloatingPoint 8 30))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11111011 #b10111111000001100001011111111)
                arg2
                (fp #b1 #b00000000 #b00000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000 #b00000000000000000000000000000)
                arg2
                (fp #b0 #b00000000 #b00111010011111010101100100110)))

(declare-const result (_ FloatingPoint 8 30))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 30))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00000001 #b11010100010110100011001100101)
                expect
                (fp #b0 #b00000000 #b00000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b00000000000000000000000000000)
                expect
                (fp #b0 #b00010011 #b11100111000110001110111001101)))

(assert (= expect result))

(check-sat)
(exit)
