(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 63))
(assert (fp.leq (fp #b0 #b00010001000 #b10111111100001101011000111100011001100001101100010110001001000)
                arg1
                (fp #b0 #b10011111000 #b00110010000010010010111010110001001100110010010001001010001000)))
(assert (fp.leq (fp #b0 #b10011111000 #b00110010000010010010111010110001001100110010010001001010001000)
                arg1
                (fp #b0 #b11100000000 #b11101110000011110110010111111100000110110010100000101001101010)))

(declare-const arg2 (_ FloatingPoint 11 63))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 63))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 63))
(assert (fp.leq (fp #b1 #b11110100100 #b10110101101111001001011101110100111000111100000001110100000000)
                expect
                (fp #b1 #b10111110001 #b01101101110110011111001111110011111011110011110010000010110010)))
(assert (fp.leq (fp #b1 #b10111110001 #b01101101110110011111001111110011111011110011110010000010110010)
                expect
                (fp #b0 #b00001100101 #b00011111001001000010111011111111111100101000000100101100011110)))

(assert (= expect result))

(check-sat)
(exit)
