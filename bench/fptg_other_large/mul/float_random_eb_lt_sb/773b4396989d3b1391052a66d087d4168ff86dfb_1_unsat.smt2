                (fp #b1 #b1111001111 #b101111000001101011101100011100011001011001011010010000000111011010101101100001100011000000010001110)))

(declare-const result (_ FloatingPoint 10 100))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 100))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
