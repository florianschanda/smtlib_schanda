; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 25))
(assert (fp.leq (fp #b1 #b101101000 #b010111011111110010100011)
                arg1
                (fp #b1 #b011111111 #b100110101101110100110010)))
(assert (fp.leq (fp #b1 #b011111111 #b100110101101110100110010)
                arg1
                (fp #b0 #b010000111 #b100000100000111101100000)))

(declare-const arg2 (_ FloatingPoint 9 25))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 25))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 25))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
