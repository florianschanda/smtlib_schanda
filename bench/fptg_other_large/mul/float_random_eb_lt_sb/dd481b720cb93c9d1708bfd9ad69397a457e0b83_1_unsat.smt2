; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 13))
(assert (fp.leq (fp #b1 #b110000010101 #b101001000000)
                arg1
                (fp #b1 #b101111111110 #b111111111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b111111111111)
                arg1
                (fp #b1 #b100011010111 #b000000111010)))

(declare-const arg2 (_ FloatingPoint 12 13))
(assert (fp.leq (fp #b1 #b101110011100 #b001110001110)
                arg2
                (fp #b1 #b000000000000 #b111111111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b111111111111)
                arg2
                (fp #b0 #b010011000101 #b000101010011)))

(declare-const result (_ FloatingPoint 12 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 13))
(assert (fp.leq (fp #b1 #b000101011110 #b110010011111)
                expect
                (fp #b0 #b010000000000 #b111111111101)))
(assert (fp.leq (fp #b0 #b010000000000 #b111111111101)
                expect
                (fp #b0 #b011111110111 #b001110001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
