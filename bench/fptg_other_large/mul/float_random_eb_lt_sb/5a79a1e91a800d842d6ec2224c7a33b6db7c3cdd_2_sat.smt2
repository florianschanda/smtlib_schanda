                arg2
                (fp #b0 #b011 #b00100111101101101010101000111101)))

(declare-const result (_ FloatingPoint 3 33))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 33))
(assert (fp.leq (fp #b1 #b000 #b10011001100111010101010001101010)
                expect
                (fp #b1 #b000 #b00011011010100111010011011101111)))
(assert (fp.leq (fp #b1 #b000 #b00011011010100111010011011101111)
                expect
                (fp #b0 #b101 #b10101100110001110011111001011111)))

(assert (= expect result))

(check-sat)
