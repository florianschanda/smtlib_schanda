                arg2
                (fp #b0 #b101101100 #b001111010110101011010110011110101)))
(assert (fp.leq (fp #b0 #b101101100 #b001111010110101011010110011110101)
                arg2
                (fp #b0 #b111010110 #b111010111110111100000100100010010)))

(declare-const result (_ FloatingPoint 9 34))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 34))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
