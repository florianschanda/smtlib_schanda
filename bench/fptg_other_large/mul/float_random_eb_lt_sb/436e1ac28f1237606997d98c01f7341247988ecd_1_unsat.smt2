(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 32))
(assert (fp.leq (fp #b1 #b11111000 #b1000100000110110011110011011101)
                arg1
                (fp #b1 #b10101010 #b1001110100111100110100100000011)))
(assert (fp.leq (fp #b1 #b10101010 #b1001110100111100110100100000011)
                arg1
                (fp #b0 #b00011101 #b0010110101110000010010011001111)))

(declare-const arg2 (_ FloatingPoint 8 32))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 8 32))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 32))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
