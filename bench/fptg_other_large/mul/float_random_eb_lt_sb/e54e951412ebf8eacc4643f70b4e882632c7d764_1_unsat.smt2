                arg2
                (fp #b1 #b110 #b111000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b110 #b111000000000000000000000000000000000000)
                arg2
                (fp #b1 #b000 #b110010100111001100101100100010011011010)))

(declare-const result (_ FloatingPoint 3 40))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 3 40))
(assert (fp.leq (fp #b1 #b111 #b000000000000000000000000000000000000000)
                expect
                (fp #b1 #b110 #b111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b110 #b111111111111111111111111111111111111111)
                expect
                (fp #b0 #b100 #b000100001010011110101000010111100111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
