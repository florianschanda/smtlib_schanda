(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 3 40))
(assert (fp.leq (fp #b1 #b100 #b111000001110001111101010101101000100000)
                arg1
                (fp #b0 #b110 #b111110110011001000001001001001001100111)))
(assert (fp.leq (fp #b0 #b110 #b111110110011001000001001001001001100111)
                arg1
                (fp #b0 #b110 #b111110111101110010011111110101010010111)))

(declare-const arg2 (_ FloatingPoint 3 40))
