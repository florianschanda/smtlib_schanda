; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 2 44))
(assert (fp.leq (fp #b0 #b01 #b1110101110000001101000010101000001010111010)
                arg1
                (fp #b0 #b10 #b1011110110011001000001001001011001001001000)))
(assert (fp.leq (fp #b0 #b10 #b1011110110011001000001001001011001001001000)
                arg1
                (fp #b0 #b10 #b1101100111001111100000010110010100111011101)))

(declare-const arg2 (_ FloatingPoint 2 44))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 2 44))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 44))
(assert (fp.leq (fp #b1 #b11 #b0000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b10 #b1111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b10 #b1111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b01 #b1110111111001000010010011010011101000001101)))

(assert (= expect result))

(check-sat)
(exit)
