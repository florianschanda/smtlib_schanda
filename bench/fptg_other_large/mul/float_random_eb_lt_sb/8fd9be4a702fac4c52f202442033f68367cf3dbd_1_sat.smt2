; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 40))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 40))
(assert (fp.leq (fp #b1 #b1010110010010 #b110000101010110001101010011101100110000)
                arg2
                (fp #b1 #b0011111110110 #b011001000100011110100000100001100011001)))
(assert (fp.leq (fp #b1 #b0011111110110 #b011001000100011110100000100001100011001)
                arg2
                (fp #b0 #b0100001110110 #b001110110100010001110001111111110101000)))

(declare-const result (_ FloatingPoint 13 40))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 40))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
