(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 8 26))
(assert (fp.leq (fp #b0 #b10100011 #b0110011010111010010101000)
                arg1
                (fp #b0 #b11111110 #b1111111111111111111111111)))
(assert (fp.leq (fp #b0 #b11111110 #b1111111111111111111111111)
                arg1
                (fp #b0 #b11111111 #b0000000000000000000000000)))

(declare-const arg2 (_ FloatingPoint 8 26))
(assert (fp.leq (fp #b1 #b11110001 #b1011010110100001111101110)
                arg2
                (fp #b0 #b00000000 #b1000110101011001010010110)))
(assert (fp.leq (fp #b0 #b00000000 #b1000110101011001010010110)
                arg2
                (fp #b0 #b10010111 #b1000000001001011010011101)))

(declare-const result (_ FloatingPoint 8 26))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 8 26))
(assert (fp.leq (fp #b1 #b01000111 #b0001111011011001011010001)
                expect
                (fp #b0 #b10000000 #b0001101010110010100101011)))
(assert (fp.leq (fp #b0 #b10000000 #b0001101010110010100101011)
                expect
                (fp #b0 #b10011000 #b0010010000101100100010011)))

(assert (= expect result))

(check-sat)
(exit)
