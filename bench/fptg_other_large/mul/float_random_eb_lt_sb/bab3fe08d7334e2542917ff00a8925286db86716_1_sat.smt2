;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 12))
(assert (fp.leq (fp #b1 #b1011011001 #b00001011100)
                arg1
                (fp #b1 #b0011111010 #b01101010000)))
(assert (fp.leq (fp #b1 #b0011111010 #b01101010000)
                arg1
                (fp #b0 #b0011110011 #b11011110101)))

(declare-const arg2 (_ FloatingPoint 10 12))
(assert (fp.leq (fp #b1 #b1010111111 #b11010011011)
                arg2
                (fp #b0 #b1111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000000000)
                arg2
                (fp #b0 #b1111111110 #b00000001010)))

(declare-const result (_ FloatingPoint 10 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 12))
(assert (fp.leq (fp #b1 #b1100100111 #b00111010000)
                expect
                (fp #b1 #b1011111000 #b01101010000)))
(assert (fp.leq (fp #b1 #b1011111000 #b01101010000)
                expect
                (fp #b1 #b1011110101 #b01111000010)))

(assert (= expect result))

(check-sat)
(exit)
