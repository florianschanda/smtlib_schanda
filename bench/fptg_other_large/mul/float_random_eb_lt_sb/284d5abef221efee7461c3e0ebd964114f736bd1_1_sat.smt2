(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 20))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 20))
(assert (fp.leq (fp #b1 #b111101011110110 #b1100100000111111101)
                arg2
                (fp #b1 #b010011000011100 #b0000111010001101001)))
(assert (fp.leq (fp #b1 #b010011000011100 #b0000111010001101001)
                arg2
                (fp #b0 #b110110011110101 #b1000101101000010000)))

(declare-const result (_ FloatingPoint 15 20))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 20))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
