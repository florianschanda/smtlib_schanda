(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 21))
(assert (fp.leq (fp #b1 #b1101100011 #b01111110110101000111)
                arg1
                (fp #b1 #b0101101010 #b00010101001001111110)))
(assert (fp.leq (fp #b1 #b0101101010 #b00010101001001111110)
                arg1
                (fp #b0 #b0011101111 #b10010011011100011110)))

(declare-const arg2 (_ FloatingPoint 10 21))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 10 21))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 21))
(assert (fp.leq (fp #b0 #b0010010100 #b00011100100111010100)
                expect
                (fp #b0 #b0011010101 #b00101100000011110110)))
(assert (fp.leq (fp #b0 #b0011010101 #b00101100000011110110)
                expect
                (fp #b0 #b0101010011 #b01011101000010101001)))

(assert (= expect result))

(check-sat)
(exit)
