(assert (fp.leq (fp #b1 #b0100000001 #b0110110010001000111110001)
                arg2
                (fp #b0 #b0101110101 #b1111010001110100010000010)))

(declare-const result (_ FloatingPoint 10 26))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 26))
(assert (fp.leq (fp #b1 #b1111010001 #b1000011011111011011000011)
                expect
                (fp #b1 #b0000000000 #b0000000000100000001110001)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000000100000001110001)
                expect
                (fp #b0 #b0101011001 #b1101010111000101001110101)))

(assert (= expect result))

(check-sat)
(exit)
