(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 12))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11101001001 #b01011100111)
                arg2
                (fp #b0 #b00000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000000000)
                arg2
                (fp #b0 #b11010100101 #b11010101000)))

(declare-const result (_ FloatingPoint 11 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 12))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
