                arg2
                (fp #b0 #b000010001011110 #b0010000101010001000101111101100001000011001100111100011010000010011001111111000010001101001010111010111100110110)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
