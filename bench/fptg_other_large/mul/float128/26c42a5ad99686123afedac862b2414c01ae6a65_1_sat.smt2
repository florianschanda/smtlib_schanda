;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.leq (fp #b1 #b011010001010110 #b0110111010000011111100001011100110110010001100110000101111111111101100101011110100000010111100000000010000000011)
                arg1
                (fp #b0 #b100100010010100 #b0010000010010010111010110001001100110010010001000010100100110011111111101000011101111110101110101111001000001000)))
(assert (fp.leq (fp #b0 #b100100010010100 #b0010000010010010111010110001001100110010010001000010100100110011111111101000011101111110101110101111001000001000)
                arg1
                (fp #b0 #b111010000101101 #b0011101101000001001110001011101111000110001101110110010110011101001101100000000000010011001010010101010101011111)))

(declare-const arg2 Float128)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
