;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b0 #b100101011001110 #b0100001111110101101100000010100010111000010110000000100111001010101000001111100100111111110011101101000100110001)
                arg2
                (fp #b0 #b101101011010000 #b0101101010110101110010000011010111001100111101000010110100111010000110110100001010111111010100110111000100101100)))
(assert (fp.leq (fp #b0 #b101101011010000 #b0101101010110101110010000011010111001100111101000010110100111010000110110100001010111111010100110111000100101100)
                arg2
                (fp #b0 #b101110010001111 #b1100011110111000101100001000000001101011011111100110000010001110101110000011000101110000000011001001110011001000)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
