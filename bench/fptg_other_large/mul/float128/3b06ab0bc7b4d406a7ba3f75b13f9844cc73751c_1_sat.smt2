; Format: FLOAT128
; Arg1: -INFINITY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b011101010101111 #b0011010000100001100111010110101100010101010010100000001111001010011101001010011001010111011010101101100100011000)
                arg2
                (fp #b0 #b000000000000000 #b1010101000100010100101010110010001000110100110010101010011011011000010011001110011000110111100101001100000010110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1010101000100010100101010110010001000110100110010101010011011011000010011001110011000110111100101001100000010110)
                arg2
                (fp #b0 #b100101101001010 #b1001110101100101100001000000001111011110000010011011011000110100101111010010000000101101100011000110111111111110)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
