; Format: FLOAT128
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b010111010010001 #b0010100010011011001110111001101110010110101001000101110010010101011110011001001110101110110010110010100011101100)
                arg2
                (fp #b0 #b011111111111111 #b0001001101110101101010100011111011101011011111010001001011111110010101001111011111010000011011001100000010100011)))
(assert (fp.leq (fp #b0 #b011111111111111 #b0001001101110101101010100011111011101011011111010001001011111110010101001111011111010000011011001100000010100011)
                arg2
                (fp #b0 #b110011011110010 #b1011100100110010110111011101100101101010000001001101110011101111110101101001000111001010001010111100000101010110)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
