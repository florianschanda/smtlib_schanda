(set-info :category "random")
(set-info :status sat)

; Format: FLOAT128
; Arg1: -INFINITY
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b010100111000110 #b0110110110010001100001101100111010011001000000001110110011001111111000011000011001111101000100000101111010100110)
                arg2
                (fp #b1 #b000000000000000 #b1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b001011101000111 #b0010111000011111110000000011010010101100011111011100000010010001010100111110001111011010000101100011100011100011)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
