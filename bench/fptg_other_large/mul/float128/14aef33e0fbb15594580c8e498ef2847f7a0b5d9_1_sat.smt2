; Format: FLOAT128
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.leq (fp #b1 #b111110101011001 #b0101101001100111011111010111011010000001000111110011001001101000011001001010011001111000001101110010111010110110)
                arg1
                (fp #b1 #b101011101110000 #b0001000011101101001001001100000100101000100010011101111101111011011010011101111101001011110000010100111011111110)))
(assert (fp.leq (fp #b1 #b101011101110000 #b0001000011101101001001001100000100101000100010011101111101111011011010011101111101001011110000010100111011111110)
                arg1
                (fp #b1 #b100010110001111 #b0111101101010011000110001011001000010001100110101000110100101000100110011000010001111000010011001001111001011011)))

(declare-const arg2 Float128)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
