; Format: FLOAT128
; Arg1: -INFINITY
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b0 #b011100001010000 #b0000000110011010011000000011100111110011100111000111010110000111000011011101100000111110001111100111011010100100)
                arg2
                (fp #b0 #b100000001101010 #b1001011011001011000100011111100100010011110100100101111110000100010101100101111100001110010011111001001100100000)))
(assert (fp.leq (fp #b0 #b100000001101010 #b1001011011001011000100011111100100010011110100100101111110000100010101100101111100001110010011111001001100100000)
                arg2
                (fp #b0 #b101000110100110 #b0011001110011101100110000010011100011001110101001010001110001000111110100011111000100110100110001010001111100011)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
