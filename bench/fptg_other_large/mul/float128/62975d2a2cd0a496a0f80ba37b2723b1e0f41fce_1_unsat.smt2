                (fp #b0 #b001011001111100 #b0010011111010100001110000010011011011000001110000110101010010101001111100010001100010010100100010001100011101100)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
