; Format: FLOAT128
; Arg1: +INFINITY
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b001000111100101 #b0101111100101010111110111011001011110101001101101010100000111111010110000111110011011111011101001001100111100001)
                arg2
                (fp #b1 #b000000000000000 #b1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b010100001001000 #b0011000000011110100111100111010111001000111001010110000000001101000001000010010000010011011100101101010010100001)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
