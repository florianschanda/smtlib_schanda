; Format: FLOAT128
; Arg1: -INFINITY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b000101000001100 #b0000100101011001100000100001100111001001001110001111001011011100110001010010011100011101000101111000111000010010)
                arg2
                (fp #b0 #b000000000000000 #b1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b000110111001101 #b0100000101011111110111101011110011000000100110100001101111110101110010110011011100000111100110110110010110010110)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
