; Format: FLOAT128
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +INFINITY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.leq (fp #b1 #b101010111100001 #b1010101101100110011100100000100001110011110011100100111110110101110011111001010001000100101011001001100111011000)
                arg1
                (fp #b1 #b011111111111111 #b1011011011001101110100110100111000110001010110111001011101011010100000010001100011100101110111001100000111011010)))
(assert (fp.leq (fp #b1 #b011111111111111 #b1011011011001101110100110100111000110001010110111001011101011010100000010001100011100101110111001100000111011010)
                arg1
                (fp #b0 #b100100001001111 #b0110001001111010100001111110100000100110110001011111111101011000110000000000010100111101111010011011010000110000)))

(declare-const arg2 Float128)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
