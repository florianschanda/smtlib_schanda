; Format: FLOAT128
; Arg1: +INFINITY
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b000010101001000 #b1011011111011011110001000001010010001011001101001010111111100101000100101110111111101010100101100000110001111001)
                arg2
                (fp #b1 #b000000000000000 #b1000001010000000110100000001010111101011011000101001111000000110100111111000101011000110001101010101101011011111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1000001010000000110100000001010111101011011000101001111000000110100111111000101011000110001101010101101011011111)
                arg2
                (fp #b0 #b011100011111110 #b0110001101001110100111001010101111111011000101011011111010000000110101101000000000100000001011001101110010110010)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
