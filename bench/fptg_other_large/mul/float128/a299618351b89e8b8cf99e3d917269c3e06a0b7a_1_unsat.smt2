;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.leq (fp #b1 #b001001000011010 #b1101111110001000110110001001110010110111101000100011011011000010010101000011010111001111010110111100110010000010)
                arg1
                (fp #b1 #b000000000000000 #b1100010010101010101011011100100000001010110010010111000000001110010000001111011101000011101000100100111010001001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1100010010101010101011011100100000001010110010010111000000001110010000001111011101000011101000100100111010001001)
                arg1
                (fp #b0 #b101011001110101 #b1001011100010101011011100100111110011010010010010111110111011001100101001110011011010101110100111111111100010010)))

(declare-const arg2 Float128)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
