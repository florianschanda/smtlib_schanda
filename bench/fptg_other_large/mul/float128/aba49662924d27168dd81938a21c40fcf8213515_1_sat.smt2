                (fp #b1 #b011111111111111 #b1001100101010110001111101111001110101000010110011001100101100010101101000110110011011010011001011100011001000110)))
(assert (fp.leq (fp #b1 #b011111111111111 #b1001100101010110001111101111001110101000010110011001100101100010101101000110110011011010011001011100011001000110)
                arg1
                (fp #b0 #b100110111011100 #b1001001111101100001000011000101000100011101000010001000110101010100111100001111000010001101111011011000011100110)))

(declare-const arg2 Float128)
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
