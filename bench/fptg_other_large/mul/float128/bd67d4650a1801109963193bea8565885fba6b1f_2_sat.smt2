                (fp #b1 #b111100110000011 #b1011010010000011010100001100000000111111111101111011010001001111001101111001101100110111011110010110000110101001)))
(assert (fp.leq (fp #b1 #b111100110000011 #b1011010010000011010100001100000000111111111101111011010001001111001101111001101100110111011110010110000110101001)
                arg1
                (fp #b0 #b110001110101110 #b0000001000000010100000111101110010011000001100100011001111110110010100010111000100110011100011010011100011101100)))

(declare-const arg2 Float128)
(assert (= arg2 arg1))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
