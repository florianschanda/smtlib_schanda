(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 Float128)
(assert (fp.leq (fp #b1 #b111111001010001 #b0000011100000100110100001110000101001010100011011101000000001001000000101001101010101100110001010111001100000100)
