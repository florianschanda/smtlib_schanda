; Format: FLOAT128
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 Float128)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b0 #b010000010001010 #b0101000010000101111010100011010000110110001110110110001100000010001110011100011101010101110101010100000001101101)
                arg2
                (fp #b0 #b011111111111111 #b1100000001001001000111111010001010001001010001000011101111100110010101000010110000010111000000000010100110111001)))
(assert (fp.leq (fp #b0 #b011111111111111 #b1100000001001001000111111010001010001001010001000011101111100110010101000010110000010111000000000010100110111001)
                arg2
                (fp #b0 #b101001101101110 #b1101010111010111000000111110010001010100100011001110001010000001001101010000001011010111001111001100011000011011)))

(declare-const result Float128)
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
