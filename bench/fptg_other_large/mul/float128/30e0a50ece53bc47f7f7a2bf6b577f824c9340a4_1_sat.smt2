(assert (fp.leq (fp #b1 #b000000000000000 #b0001011000101010000100101100100000010000001111110110101011010000110001000001101111011010100110111000110010100101)
                arg1
                (fp #b0 #b101010000010111 #b1111100011110100110000110100001111101011111011110100100101101101101111101010001110110011001010001101000111110000)))

(declare-const arg2 Float128)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

