;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b111101111010000011 #b01)
                arg1
                (fp #b1 #b000000000000000000 #b11)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b11)
                arg1
                (fp #b0 #b110011010100110111 #b10)))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b000100001001000011 #b00)
                arg2
                (fp #b0 #b101111110110110001 #b10)))
(assert (fp.leq (fp #b0 #b101111110110110001 #b10)
                arg2
                (fp #b0 #b111100111101010010 #b11)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b110100001010011101 #b11)
                expect
                (fp #b1 #b001111110110110011 #b01)))
(assert (fp.leq (fp #b1 #b001111110110110011 #b01)
                expect
                (fp #b0 #b110111001010011100 #b11)))

(assert (= expect result))

(check-sat)
(exit)
