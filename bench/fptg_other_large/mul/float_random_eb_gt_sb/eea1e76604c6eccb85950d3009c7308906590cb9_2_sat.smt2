(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1111011010001 #b0111011100)
                arg1
                (fp #b1 #b0000000000000 #b1111111111)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1111111111)
                arg1
                (fp #b0 #b1101100010011 #b0010001001)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1111110111100 #b0111001101)
                arg2
                (fp #b0 #b0000000000001 #b0000000000)))
(assert (fp.leq (fp #b0 #b0000000000001 #b0000000000)
                arg2
                (fp #b0 #b0100101000010 #b1011100100)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b0110000010011 #b0110011110)
                expect
                (fp #b1 #b0000000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000000001)
                expect
                (fp #b0 #b1011000110110 #b0011000101)))

(assert (= expect result))

(check-sat)
(exit)
