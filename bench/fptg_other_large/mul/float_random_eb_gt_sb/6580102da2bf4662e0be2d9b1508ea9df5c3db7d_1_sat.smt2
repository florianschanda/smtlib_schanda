; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1101000110000101 #b110100000)
                arg1
                (fp #b1 #b1000000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000000000001001 #b000000000)
                arg1
                (fp #b0 #b1111001010001101 #b011110110)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1101010110100101 #b100110100)
                arg2
                (fp #b0 #b0000000000000000 #b100001010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100001010)
                arg2
                (fp #b0 #b1000111100001110 #b011100001)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1011111110010010 #b101000001)
                expect
                (fp #b1 #b0000000000001010 #b000010100)))
(assert (fp.leq (fp #b1 #b0000000000001010 #b000010100)
                expect
                (fp #b0 #b0000001000110010 #b010101110)))

(assert (= expect result))

(check-sat)
(exit)
