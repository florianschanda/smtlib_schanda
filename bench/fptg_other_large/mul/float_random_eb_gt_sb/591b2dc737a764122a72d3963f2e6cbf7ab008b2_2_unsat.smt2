(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0110110010 #b0)
                arg1
                (fp #b1 #b0000000000 #b1)))
(assert (fp.leq (fp #b1 #b0000000000 #b1)
                arg1
                (fp #b0 #b1010011111 #b0)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0110100101 #b0)
                arg2
                (fp #b0 #b0000000000 #b1)))
(assert (fp.leq (fp #b0 #b0000000000 #b1)
                arg2
                (fp #b0 #b0001011011 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101101010 #b1)
                expect
                (fp #b1 #b0000000000 #b1)))
(assert (fp.leq (fp #b1 #b0000000000 #b1)
                expect
                (fp #b0 #b0101111100 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
