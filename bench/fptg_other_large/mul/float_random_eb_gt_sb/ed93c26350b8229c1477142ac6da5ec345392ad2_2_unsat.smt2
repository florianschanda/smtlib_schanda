                arg2
                (fp #b1 #b11111111111101 #b000000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000000000000)
                arg2
                (fp #b0 #b01011111010001 #b001110011010)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
