; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0001000100110 #b000010)
                arg1
                (fp #b0 #b0000000000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000001)
                arg1
                (fp #b0 #b0111110101100 #b110010)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1100111001110 #b100101)
                arg2
                (fp #b1 #b0101010011101 #b110101)))
(assert (fp.leq (fp #b1 #b0101010011101 #b110101)
                arg2
                (fp #b0 #b1001111110111 #b001000)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0110111000101 #b100110)
                expect
                (fp #b1 #b0000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000000)
                expect
                (fp #b0 #b1111111111001 #b101110)))

(assert (= expect result))

(check-sat)
(exit)
