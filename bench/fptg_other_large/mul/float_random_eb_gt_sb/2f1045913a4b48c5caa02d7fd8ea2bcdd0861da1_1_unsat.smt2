(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110011010010001 #b110)
                arg1
                (fp #b1 #b100000000000010 #b110)))
(assert (fp.leq (fp #b1 #b100000000000010 #b110)
                arg1
                (fp #b0 #b010011011101111 #b011)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b101100101111010 #b110)
                arg2
                (fp #b1 #b001110010100000 #b110)))
(assert (fp.leq (fp #b1 #b001110010100000 #b110)
                arg2
                (fp #b0 #b010001100111011 #b010)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100011010100101 #b010)
                expect
                (fp #b0 #b001110010100100 #b100)))
(assert (fp.leq (fp #b0 #b001110010100100 #b100)
                expect
                (fp #b0 #b011101010001010 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
