; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1000011110010 #b1111100001)
                arg1
                (fp #b0 #b1000110101100 #b0001000000)))
(assert (fp.leq (fp #b0 #b1000110101100 #b0001000000)
                arg1
                (fp #b0 #b1110000101000 #b0100110000)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b0001100100100 #b1100010010)
                expect
                (fp #b0 #b1001101011001 #b0010000100)))
(assert (fp.leq (fp #b0 #b1001101011001 #b0010000100)
                expect
                (fp #b0 #b1110001111000 #b0000110001)))

(assert (= expect result))

(check-sat)
(exit)
