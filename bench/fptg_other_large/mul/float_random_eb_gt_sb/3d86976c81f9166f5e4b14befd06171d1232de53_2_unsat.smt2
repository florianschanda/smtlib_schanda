(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b111101111010 #b0)
                arg1
                (fp #b1 #b001000101011 #b1)))
(assert (fp.leq (fp #b1 #b001000101011 #b1)
                arg1
                (fp #b0 #b001100011111 #b0)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b111100110110 #b0)
                arg2
                (fp #b0 #b100000000000 #b1)))
(assert (fp.leq (fp #b0 #b100000000000 #b1)
                arg2
                (fp #b0 #b101010111000 #b1)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b010110010000 #b1)
                expect
                (fp #b1 #b001000101101 #b1)))
(assert (fp.leq (fp #b1 #b001000101101 #b1)
                expect
                (fp #b0 #b110000010011 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
