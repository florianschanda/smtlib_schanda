(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001100100 #b011010)
                arg1
                (fp #b0 #b000000001 #b000000)))
(assert (fp.leq (fp #b0 #b000000001 #b000000)
                arg1
                (fp #b0 #b011111011 #b111110)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111110110 #b000010)
                arg2
                (fp #b1 #b000000000 #b010000)))
(assert (fp.leq (fp #b1 #b000000000 #b010000)
                arg2
                (fp #b0 #b110100101 #b011001)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001011010 #b101101)
                expect
                (fp #b1 #b000000000 #b000001)))
(assert (fp.leq (fp #b1 #b000000000 #b000001)
                expect
                (fp #b0 #b100101001 #b000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
