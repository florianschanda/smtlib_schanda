(assert (fp.leq (fp #b1 #b00000000000000000 #b111111111)
                arg2
                (fp #b0 #b10000000100101111 #b110101001)))

(declare-const result (_ FloatingPoint 17 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b11100010001000111 #b001010111)
                expect
                (fp #b0 #b00000000000000001 #b100111110)))
(assert (fp.leq (fp #b0 #b00000000000000001 #b100111110)
                expect
                (fp #b0 #b10111011001000011 #b110000101)))

(assert (not (= expect result)))

(check-sat)
