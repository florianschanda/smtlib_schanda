(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110001101 #b101)
                arg1
                (fp #b1 #b000000001 #b000)))
(assert (fp.leq (fp #b1 #b000000001 #b000)
                arg1
                (fp #b0 #b001101100 #b100)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011111110 #b101)
                arg2
                (fp #b1 #b000000000 #b111)))
(assert (fp.leq (fp #b1 #b000000000 #b111)
                arg2
                (fp #b0 #b001011000 #b000)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011101111 #b001)
                expect
                (fp #b0 #b000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000 #b000)
                expect
                (fp #b0 #b100110101 #b111)))

(assert (= expect result))

(check-sat)
(exit)
