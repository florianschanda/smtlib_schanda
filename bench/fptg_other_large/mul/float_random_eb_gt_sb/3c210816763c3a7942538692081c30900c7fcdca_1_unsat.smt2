                arg2
                (fp #b0 #b1011111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1011111111110 #b111111111)
                arg2
                (fp #b0 #b1100001100001 #b111101101)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0100100000000 #b001010111)
                expect
                (fp #b0 #b0110001011010 #b000111111)))
(assert (fp.leq (fp #b0 #b0110001011010 #b000111111)
                expect
                (fp #b0 #b1110100000010 #b011010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
