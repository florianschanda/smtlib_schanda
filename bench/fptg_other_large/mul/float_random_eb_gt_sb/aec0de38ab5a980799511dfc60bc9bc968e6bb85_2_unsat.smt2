; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b000111011101010111 #b010)
                arg1
                (fp #b0 #b011111111111111111 #b111)))
(assert (fp.leq (fp #b0 #b011111111111111111 #b111)
                arg1
                (fp #b0 #b111000100100011000 #b000)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b011011111000011010 #b110)
                arg2
                (fp #b0 #b111111000110111000 #b001)))
(assert (fp.leq (fp #b0 #b111111000110111000 #b001)
                arg2
                (fp #b0 #b111111111000100010 #b100)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b011111001100101110 #b110)
                expect
                (fp #b0 #b111111000110111001 #b001)))
(assert (fp.leq (fp #b0 #b111111000110111001 #b001)
                expect
                (fp #b0 #b111111011001110010 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
