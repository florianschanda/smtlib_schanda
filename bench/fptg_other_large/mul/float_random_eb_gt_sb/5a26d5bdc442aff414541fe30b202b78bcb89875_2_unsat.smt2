; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00100000100 #b1110)
                arg1
                (fp #b0 #b01111111111 #b0100)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100)
                arg1
                (fp #b0 #b11100110101 #b0011)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11011010111 #b0001)
                arg2
                (fp #b0 #b00000000000 #b1111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1111)
                arg2
                (fp #b0 #b01001001110 #b1000)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11101000100 #b1011)
                expect
                (fp #b0 #b00000000001 #b0011)))
(assert (fp.leq (fp #b0 #b00000000001 #b0011)
                expect
                (fp #b0 #b11100010010 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
