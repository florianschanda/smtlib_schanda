(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00111010111100 #b100)
                arg1
                (fp #b1 #b00000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b001)
                arg1
                (fp #b0 #b10001001100100 #b011)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10111110000111 #b110)
                arg2
                (fp #b0 #b00000000000000 #b110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b110)
                arg2
                (fp #b0 #b01101001011010 #b110)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01001111001100 #b001)
                expect
                (fp #b1 #b00000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b001)
                expect
                (fp #b0 #b00110100101000 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
