(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b001001000 #b00101)
                arg1
                (fp #b0 #b111111101 #b00000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000)
                arg1
                (fp #b0 #b111111110 #b01110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                arg2
                (fp #b1 #b111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111)
                arg2
                (fp #b0 #b100010011 #b10110)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                expect
                (fp #b1 #b111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111)
                expect
                (fp #b1 #b100010111 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
