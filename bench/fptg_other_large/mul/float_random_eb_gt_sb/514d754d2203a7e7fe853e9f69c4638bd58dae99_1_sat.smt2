(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10101001000 #b01101001)
                arg1
                (fp #b1 #b00000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b00000000000 #b00010010)
                arg1
                (fp #b0 #b00110110111 #b10110100)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00100011010 #b10110111)
                arg2
                (fp #b0 #b00000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b00000000000 #b01000011)
                arg2
                (fp #b0 #b00001100101 #b10010110)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10011010110 #b11010001)
                expect
                (fp #b1 #b00000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000000)
                expect
                (fp #b0 #b01101001001 #b00111110)))

(assert (= expect result))

(check-sat)
(exit)
