(assert (fp.leq (fp #b1 #b010000000000000000 #b000000)
                arg2
                (fp #b0 #b100101000010000000 #b000011)))

(declare-const result (_ FloatingPoint 18 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b100001110011101011 #b110101)
                expect
                (fp #b0 #b000000000000000000 #b000001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b000001)
                expect
                (fp #b0 #b111111000100010011 #b110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
