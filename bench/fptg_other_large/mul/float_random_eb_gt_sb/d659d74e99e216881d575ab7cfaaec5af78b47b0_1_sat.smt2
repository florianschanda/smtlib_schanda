(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b011001110000011 #b001)
                arg1
                (fp #b0 #b000000000000001 #b000)))
(assert (fp.leq (fp #b0 #b000000000000001 #b000)
                arg1
                (fp #b0 #b011001110111100 #b101)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110101011101010 #b110)
                arg2
                (fp #b0 #b000000000000000 #b001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b001)
                arg2
                (fp #b0 #b100000101101111 #b000)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111100111001001 #b111)
                expect
                (fp #b0 #b000000000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000)
                expect
                (fp #b0 #b000101001011000 #b100)))

(assert (= expect result))

(check-sat)
(exit)
