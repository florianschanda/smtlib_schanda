(assert (fp.leq (fp #b0 #b111110111101 #b10100111)
                arg2
                (fp #b0 #b111111010001 #b01110010)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b011100000111 #b00011101)
                expect
                (fp #b0 #b011110111110 #b00011111)))
(assert (fp.leq (fp #b0 #b011110111110 #b00011111)
                expect
                (fp #b0 #b110011000110 #b10110011)))

(assert (= expect result))

(check-sat)
(exit)
