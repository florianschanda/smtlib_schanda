; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10011011101100 #b1011011)
                arg1
                (fp #b0 #b00000000000000 #b1111111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111111)
                arg1
                (fp #b0 #b10010110011110 #b1000010)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111101011110 #b1110100)
                arg2
                (fp #b1 #b11100001110001 #b1101001)))
(assert (fp.leq (fp #b1 #b11100001110001 #b1101001)
                arg2
                (fp #b0 #b11100010001101 #b1110110)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10101111111010 #b0011110)
                expect
                (fp #b1 #b01100001110011 #b1100111)))
(assert (fp.leq (fp #b1 #b01100001110011 #b1100111)
                expect
                (fp #b0 #b10101001111011 #b0011100)))

(assert (= expect result))

(check-sat)
(exit)
