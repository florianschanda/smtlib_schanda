;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b010000011010000 #b001000001000)
                arg1
                (fp #b0 #b100000000001000 #b100100011000)))
(assert (fp.leq (fp #b0 #b100000000001000 #b100100011000)
                arg1
                (fp #b0 #b101100101011111 #b111001011101)))

(declare-const arg2 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b000010100010111 #b111100101010)
                arg2
                (fp #b0 #b100000111110110 #b101110110001)))
(assert (fp.leq (fp #b0 #b100000111110110 #b101110110001)
                arg2
                (fp #b0 #b110111010111111 #b010100010101)))

(declare-const result (_ FloatingPoint 15 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b010001010101010 #b011001100010)
                expect
                (fp #b0 #b100001000000000 #b010110111000)))
(assert (fp.leq (fp #b0 #b100001000000000 #b010110111000)
                expect
                (fp #b0 #b111111000110110 #b110011001110)))

(assert (= expect result))

(check-sat)
(exit)
