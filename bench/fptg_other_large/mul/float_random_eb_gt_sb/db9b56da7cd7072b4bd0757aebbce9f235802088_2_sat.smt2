(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10011011000 #b11)
                arg1
                (fp #b1 #b01111111111 #b01)))
(assert (fp.leq (fp #b1 #b01111111111 #b01)
                arg1
                (fp #b0 #b01111110111 #b10)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10010010000 #b11)
                arg2
                (fp #b0 #b11100001111 #b11)))
(assert (fp.leq (fp #b0 #b11100001111 #b11)
                arg2
                (fp #b0 #b11111110011 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111011 #b10)
                expect
                (fp #b1 #b11100010000 #b01)))
(assert (fp.leq (fp #b1 #b11100010000 #b01)
                expect
                (fp #b1 #b00101010100 #b00)))

(assert (= expect result))

(check-sat)
(exit)
