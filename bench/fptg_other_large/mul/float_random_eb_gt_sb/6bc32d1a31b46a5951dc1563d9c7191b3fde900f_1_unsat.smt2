(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b101100110 #b100)
                arg1
                (fp #b1 #b000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000 #b000)
                arg1
                (fp #b0 #b100100010 #b101)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111011001 #b000)
                arg2
                (fp #b1 #b100000010 #b001)))
(assert (fp.leq (fp #b1 #b100000010 #b001)
                arg2
                (fp #b0 #b001011100 #b111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100101000 #b110)
                expect
                (fp #b0 #b000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000 #b000)
                expect
                (fp #b0 #b111011101 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
