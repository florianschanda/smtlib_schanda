; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11111111111110 #b011110)
                arg1
                (fp #b1 #b11111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000000)
                arg1
                (fp #b0 #b10110100011110 #b010011)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11111111111110 #b010111)
                arg2
                (fp #b1 #b11111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000000)
                arg2
                (fp #b1 #b10001100000110 #b111101)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
