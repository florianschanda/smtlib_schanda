;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111111010 #b1110)
                arg1
                (fp #b1 #b111111010 #b1011)))
(assert (fp.leq (fp #b1 #b111111010 #b1011)
                arg1
                (fp #b1 #b100110110 #b1000)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001000000 #b0110)
                arg2
                (fp #b1 #b000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000 #b0001)
                arg2
                (fp #b0 #b000011100 #b0000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111111010 #b0101)
                expect
                (fp #b0 #b011111000 #b1011)))
(assert (fp.leq (fp #b0 #b011111000 #b1011)
                expect
                (fp #b0 #b101001100 #b0111)))

(assert (not (= expect result)))

(check-sat)
(exit)
