;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11011100000001 #b110011)
                arg1
                (fp #b0 #b11111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111111)
                arg1
                (fp #b0 #b11111111111111 #b000000)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b10110100111001 #b011100)
                arg2
                (fp #b0 #b10111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b111111)
                arg2
                (fp #b0 #b11101110010100 #b010011)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b01111011110011 #b110010)
                expect
                (fp #b0 #b11111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111111)
                expect
                (fp #b0 #b11111111111111 #b000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
