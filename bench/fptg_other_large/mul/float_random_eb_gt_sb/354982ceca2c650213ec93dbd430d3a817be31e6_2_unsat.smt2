(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1011110110101 #b11)
                arg1
                (fp #b0 #b0000000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000000 #b01)
                arg1
                (fp #b0 #b0000101000000 #b01)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1100000100101 #b10)
                arg2
                (fp #b0 #b0111111111111 #b01)))
(assert (fp.leq (fp #b0 #b0111111111111 #b01)
                arg2
                (fp #b0 #b1101100010111 #b11)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0000111011101 #b11)
                expect
                (fp #b0 #b0000000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000000 #b10)
                expect
                (fp #b0 #b0111111101010 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
