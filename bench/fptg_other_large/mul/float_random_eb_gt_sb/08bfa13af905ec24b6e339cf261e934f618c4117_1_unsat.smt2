                arg2
                (fp #b1 #b1011101100010 #b011)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1001100011000 #b011)
                expect
                (fp #b1 #b0111111111100 #b000)))
(assert (fp.leq (fp #b1 #b0111111111100 #b000)
                expect
                (fp #b1 #b0000001011110 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
