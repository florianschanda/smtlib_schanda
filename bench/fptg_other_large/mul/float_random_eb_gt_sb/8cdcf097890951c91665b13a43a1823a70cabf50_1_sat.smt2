(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00010011000 #b11110111)
                arg1
                (fp #b0 #b00000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b00000000000 #b10100110)
                arg1
                (fp #b0 #b01111000100 #b10101000)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10000001100 #b01101110)
                arg2
                (fp #b0 #b00000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b00000000000 #b00111011)
                arg2
                (fp #b0 #b10010011111 #b11000110)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11111100000 #b00010110)
                expect
                (fp #b0 #b00000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000000)
                expect
                (fp #b0 #b00111000011 #b11001001)))

(assert (= expect result))

(check-sat)
(exit)
