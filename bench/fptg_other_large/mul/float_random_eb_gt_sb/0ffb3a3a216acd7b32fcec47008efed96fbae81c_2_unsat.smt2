                arg2
                (fp #b1 #b000000000000001 #b000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b000000)
                arg2
                (fp #b0 #b010001111110111 #b110111)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b101100111001000 #b011001)
                expect
                (fp #b1 #b000000000000000 #b000001)))
(assert (fp.leq (fp #b1 #b000000000000000 #b000001)
                expect
                (fp #b0 #b000010110011110 #b110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
