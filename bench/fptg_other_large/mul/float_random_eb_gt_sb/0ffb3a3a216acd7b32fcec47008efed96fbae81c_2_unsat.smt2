(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b010010101111111 #b100110)
                arg1
                (fp #b0 #b000000000000000 #b010000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b010000)
                arg1
                (fp #b0 #b000111001010011 #b110000)))

