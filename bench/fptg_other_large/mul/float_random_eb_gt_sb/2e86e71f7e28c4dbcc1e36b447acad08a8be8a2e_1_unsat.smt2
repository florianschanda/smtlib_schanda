(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011110110 #b0101)
                arg1
                (fp #b0 #b0000000000 #b1111)))
(assert (fp.leq (fp #b0 #b0000000000 #b1111)
                arg1
                (fp #b0 #b0011000010 #b0010)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110101010 #b0001)
                arg2
                (fp #b1 #b0000000000 #b0001)))
(assert (fp.leq (fp #b1 #b0000000000 #b0001)
                arg2
                (fp #b0 #b0010011101 #b0000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0110011101 #b1101)
                expect
                (fp #b1 #b0000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000)
                expect
                (fp #b0 #b0100111101 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
