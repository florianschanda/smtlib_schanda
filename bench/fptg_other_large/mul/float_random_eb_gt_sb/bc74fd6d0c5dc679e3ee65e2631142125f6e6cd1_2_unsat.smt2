(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b01101111010100000 #b1110011)
                arg1
                (fp #b1 #b00010011110011111 #b0011010)))
(assert (fp.leq (fp #b1 #b00010011110011111 #b0011010)
                arg1
                (fp #b0 #b11111010010110011 #b0101011)))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b01111100100100000 #b0011111)
                expect
                (fp #b0 #b00000000000000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000001)
                expect
                (fp #b0 #b10011101011001010 #b1001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
