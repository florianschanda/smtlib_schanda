                (fp #b1 #b0000000000001 #b00000)))
(assert (fp.leq (fp #b1 #b0000000000001 #b00000)
                arg2
                (fp #b0 #b1100011110101 #b10101)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0000111101101 #b11010)
                expect
                (fp #b1 #b0000000000000 #b00001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00001)
                expect
                (fp #b0 #b1011110011111 #b01011)))

(assert (not (= expect result)))

(check-sat)
(exit)
