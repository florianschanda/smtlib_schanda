(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b01101110001 #b100111)
                arg1
                (fp #b1 #b00000000000 #b100100)))
(assert (fp.leq (fp #b1 #b00000000000 #b100100)
                arg1
                (fp #b0 #b11111101001 #b011001)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b00101101100 #b111111)
                arg2
                (fp #b1 #b00000000000 #b010000)))
(assert (fp.leq (fp #b1 #b00000000000 #b010000)
                arg2
                (fp #b0 #b10100111110 #b100010)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01010100100 #b001010)
                expect
                (fp #b0 #b00000000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000)
                expect
                (fp #b0 #b10010100111 #b111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
