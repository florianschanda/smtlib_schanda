(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110001110101010 #b0101)
                arg1
                (fp #b1 #b000000000000000 #b1000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1000)
                arg1
                (fp #b0 #b111001110011000 #b1101)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b111001111010010 #b1010)
                arg2
                (fp #b1 #b000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000)
                arg2
                (fp #b0 #b010001101101100 #b0001)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000011111001010 #b1011)
                expect
                (fp #b0 #b000000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000)
                expect
                (fp #b0 #b101001001000000 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
