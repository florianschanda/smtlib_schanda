(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1110101011111 #b01110)
                arg1
                (fp #b1 #b0100000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b00000)
                arg1
                (fp #b0 #b0110111010110 #b00010)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1010001010100 #b11111)
                arg2
                (fp #b1 #b0000000000000 #b01000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b01000)
                arg2
                (fp #b0 #b1101100010101 #b01011)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1110001111000 #b10101)
                expect
                (fp #b0 #b0000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000)
                expect
                (fp #b0 #b1000000011000 #b11110)))

(assert (= expect result))

(check-sat)
(exit)
