(assert (fp.leq (fp #b1 #b01111111111 #b0000000)
                arg2
                (fp #b1 #b01110001101 #b1101111)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01101110100 #b0100100)
                expect
                (fp #b1 #b00000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000)
                expect
                (fp #b0 #b10100010000 #b0111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
