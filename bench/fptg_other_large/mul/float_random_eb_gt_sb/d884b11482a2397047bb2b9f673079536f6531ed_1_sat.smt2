(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000111001 #b0000110)
                arg1
                (fp #b0 #b101111110 #b1111111)))
(assert (fp.leq (fp #b0 #b101111110 #b1111111)
                arg1
                (fp #b0 #b110110110 #b1010010)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101111011 #b0100100)
                arg2
                (fp #b1 #b100110111 #b1110100)))
(assert (fp.leq (fp #b1 #b100110111 #b1110100)
                arg2
                (fp #b1 #b011001101 #b1000111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111100110 #b1100011)
                expect
                (fp #b1 #b110110111 #b1110011)))
(assert (fp.leq (fp #b1 #b110110111 #b1110011)
                expect
                (fp #b1 #b001001100 #b1110101)))

(assert (= expect result))

(check-sat)
(exit)
