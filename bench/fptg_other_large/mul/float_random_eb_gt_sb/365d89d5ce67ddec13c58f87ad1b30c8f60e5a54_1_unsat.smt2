; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000)
                arg1
                (fp #b1 #b1111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111)
                arg1
                (fp #b0 #b0001100100110100 #b011100)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b0 #b0001010001010001 #b111100)
                arg2
                (fp #b0 #b1000000000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000000000110 #b000000)
                arg2
                (fp #b0 #b1111111010010010 #b100010)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000)
                expect
                (fp #b1 #b1111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111)
                expect
                (fp #b1 #b0001100111100100 #b001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
