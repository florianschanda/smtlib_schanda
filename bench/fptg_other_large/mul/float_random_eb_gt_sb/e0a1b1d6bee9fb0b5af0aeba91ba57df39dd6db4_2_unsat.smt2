(assert (fp.leq (fp #b0 #b1101000100110 #b0001111)
                arg2
                (fp #b0 #b1110011101111 #b0100111)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1101111110101 #b0010101)
                expect
                (fp #b1 #b1101000101101 #b1000110)))
(assert (fp.leq (fp #b1 #b1101000101101 #b1000110)
                expect
                (fp #b1 #b0000000010100 #b0000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
