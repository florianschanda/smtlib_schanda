; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b0 #b0010110010010 #b00101111)
                arg1
                (fp #b0 #b1000101001111 #b00110111)))
(assert (fp.leq (fp #b0 #b1000101001111 #b00110111)
                arg1
                (fp #b0 #b1011100010011 #b00011010)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b0 #b0010110011011 #b10000010)
                arg2
                (fp #b0 #b0111111111111 #b01100111)))
(assert (fp.leq (fp #b0 #b0111111111111 #b01100111)
                arg2
                (fp #b0 #b1000011110101 #b01111111)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0101001000000 #b00000011)
                expect
                (fp #b0 #b1000101001111 #b10110101)))
(assert (fp.leq (fp #b0 #b1000101001111 #b10110101)
                expect
                (fp #b0 #b1001010011100 #b10101110)))

(assert (= expect result))

(check-sat)
(exit)
