(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1000001001 #b1)
                arg1
                (fp #b0 #b0010010000 #b0)))
(assert (fp.leq (fp #b0 #b0010010000 #b0)
                arg1
                (fp #b0 #b0100010110 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1101000001 #b1)
                arg2
                (fp #b1 #b0000101111 #b1)))
(assert (fp.leq (fp #b1 #b0000101111 #b1)
                arg2
                (fp #b0 #b0001111000 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101011111 #b1)
                expect
                (fp #b1 #b0000000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000000 #b0)
                expect
                (fp #b0 #b0110011011 #b1)))

(assert (= expect result))

(check-sat)
(exit)
