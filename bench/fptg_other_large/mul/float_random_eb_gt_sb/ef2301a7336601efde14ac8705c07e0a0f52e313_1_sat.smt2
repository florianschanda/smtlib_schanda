(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010111001 #b110)
                arg1
                (fp #b0 #b000000000 #b001)))
(assert (fp.leq (fp #b0 #b000000000 #b001)
                arg1
                (fp #b0 #b010010011 #b011)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101001110 #b001)
                arg2
                (fp #b0 #b001111110 #b011)))
(assert (fp.leq (fp #b0 #b001111110 #b011)
                arg2
                (fp #b0 #b100111100 #b001)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001010111 #b110)
                expect
                (fp #b0 #b000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000 #b000)
                expect
                (fp #b0 #b110010011 #b011)))

(assert (= expect result))

(check-sat)
(exit)
