(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011111110 #b0010010)
                arg1
                (fp #b0 #b0111111111 #b0101011)))
(assert (fp.leq (fp #b0 #b0111111111 #b0101011)
                arg1
                (fp #b0 #b1010100100 #b1111000)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0001101010 #b0101011)
                arg2
                (fp #b1 #b0000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b0000000000 #b1101110)
                arg2
                (fp #b0 #b0000011000 #b0100011)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0000100111 #b0011101)
                expect
                (fp #b1 #b0000000001 #b0010010)))
(assert (fp.leq (fp #b1 #b0000000001 #b0010010)
                expect
                (fp #b0 #b0001001110 #b1011010)))

(assert (= expect result))

(check-sat)
(exit)
