(assert (fp.leq (fp #b0 #b00011111000010 #b001111110011)
                arg2
                (fp #b0 #b10101101101010 #b000110010111)))

(declare-const result (_ FloatingPoint 14 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 13))
(assert (fp.leq (fp #b1 #b10110001001011 #b001010101010)
                expect
                (fp #b1 #b10010100010110 #b001100110111)))
(assert (fp.leq (fp #b1 #b10010100010110 #b001100110111)
                expect
                (fp #b0 #b00001001011101 #b100010010001)))

(assert (= expect result))

(check-sat)
