(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b01100010111 #b01110110)
                arg1
                (fp #b0 #b11110000101 #b10011001)))
(assert (fp.leq (fp #b0 #b11110000101 #b10011001)
                arg1
                (fp #b0 #b11110111101 #b10010100)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10001000010 #b11010001)
                arg2
                (fp #b0 #b10000000111 #b01000010)))
(assert (fp.leq (fp #b0 #b10000000111 #b01000010)
                arg2
                (fp #b0 #b10011000011 #b00000011)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01011010011 #b10101010)
                expect
                (fp #b0 #b11110001110 #b00000010)))
(assert (fp.leq (fp #b0 #b11110001110 #b00000010)
                expect
                (fp #b0 #b11111001110 #b01101101)))

(assert (= expect result))

(check-sat)
(exit)
