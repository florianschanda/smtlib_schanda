(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111000001010 #b001111)
                arg1
                (fp #b0 #b000000000000 #b000110)))
(assert (fp.leq (fp #b0 #b000000000000 #b000110)
                arg1
                (fp #b0 #b101110101000 #b010100)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101000010001 #b010101)
                arg2
                (fp #b0 #b111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111111)
                arg2
                (fp #b0 #b111111111111 #b000000)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111010010011 #b001111)
                expect
                (fp #b0 #b011111111101 #b100000)))
(assert (fp.leq (fp #b0 #b011111111101 #b100000)
                expect
                (fp #b0 #b111110010010 #b111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
