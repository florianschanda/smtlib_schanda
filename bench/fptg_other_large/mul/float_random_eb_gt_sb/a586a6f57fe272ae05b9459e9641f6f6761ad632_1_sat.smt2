(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b100111000000001 #b100010100)
                arg1
                (fp #b0 #b000000000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b111111111)
                arg1
                (fp #b0 #b101111101000010 #b010011100)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b100100100011100 #b001101010)
                arg2
                (fp #b1 #b011111111111111 #b001111111)))
(assert (fp.leq (fp #b1 #b011111111111111 #b001111111)
                arg2
                (fp #b0 #b101111100011011 #b011101110)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b011011101101010 #b010001010)
                expect
                (fp #b1 #b000000000000001 #b001111101)))
(assert (fp.leq (fp #b1 #b000000000000001 #b001111101)
                expect
                (fp #b0 #b101011101100110 #b110010111)))

(assert (= expect result))

(check-sat)
(exit)
