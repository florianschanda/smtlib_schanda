(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10111011111 #b1010101)
                arg1
                (fp #b1 #b01111111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111111 #b0101111)
                arg1
                (fp #b1 #b01101000100 #b1111110)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11011100110 #b0100110)
                arg2
                (fp #b1 #b10111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b1111111)
                arg2
                (fp #b0 #b10111110110 #b1111101)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b00100011110 #b0000110)
                expect
                (fp #b0 #b10111111111 #b0101110)))
(assert (fp.leq (fp #b0 #b10111111111 #b0101110)
                expect
                (fp #b0 #b11101001100 #b0010111)))

(assert (= expect result))

(check-sat)
(exit)
