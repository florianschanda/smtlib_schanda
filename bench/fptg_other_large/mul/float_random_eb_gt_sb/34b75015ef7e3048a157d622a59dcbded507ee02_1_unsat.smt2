(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b10011011110001001 #b0101000)
                arg1
                (fp #b1 #b01111111111111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0101111)
