                arg2
                (fp #b1 #b01111111111111111 #b1011000)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1011000)
                arg2
                (fp #b1 #b01010011111001001 #b1101000)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b01001101101100001 #b1000111)
                expect
                (fp #b0 #b10000000000000000 #b0010011)))
(assert (fp.leq (fp #b0 #b10000000000000000 #b0010011)
                expect
                (fp #b0 #b11010100010000111 #b1010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
