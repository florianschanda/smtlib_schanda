(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b010111010 #b100001)
                arg1
                (fp #b0 #b000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000)
                arg1
                (fp #b0 #b000111111 #b111011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b101111110 #b111111)
                arg2
                (fp #b0 #b111001100 #b100100)))
(assert (fp.leq (fp #b0 #b111001100 #b100100)
                arg2
                (fp #b0 #b111111000 #b101111)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101111110 #b000110)
                expect
                (fp #b0 #b000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000)
                expect
                (fp #b0 #b011000010 #b100110)))

(assert (= expect result))

(check-sat)
(exit)
