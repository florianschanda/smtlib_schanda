(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b00111100000 #b010)
                arg1
                (fp #b0 #b01111111111 #b100)))
(assert (fp.leq (fp #b0 #b01111111111 #b100)
                arg1
                (fp #b0 #b11111110111 #b011)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00111001011 #b010)
                arg2
                (fp #b1 #b00000000000 #b011)))
(assert (fp.leq (fp #b1 #b00000000000 #b011)
                arg2
                (fp #b0 #b01111100101 #b111)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01001001011 #b000)
                expect
                (fp #b1 #b00000000000 #b101)))
(assert (fp.leq (fp #b1 #b00000000000 #b101)
                expect
                (fp #b0 #b11000000010 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
