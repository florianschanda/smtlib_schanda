; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b0001010101101 #b1)
                arg1
                (fp #b1 #b0000000000001 #b0)))
(assert (fp.leq (fp #b1 #b0000000000001 #b0)
                arg1
                (fp #b0 #b1000100011110 #b0)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1010110100110 #b0)
                arg2
                (fp #b0 #b0000000000001 #b0)))
(assert (fp.leq (fp #b0 #b0000000000001 #b0)
                arg2
                (fp #b0 #b0100000011010 #b0)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1100111110110 #b0)
                expect
                (fp #b1 #b0000000000000 #b1)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1)
                expect
                (fp #b0 #b1110010000100 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
