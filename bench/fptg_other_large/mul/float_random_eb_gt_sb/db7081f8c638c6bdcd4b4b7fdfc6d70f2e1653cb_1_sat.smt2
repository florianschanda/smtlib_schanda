(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00100011100 #b00100)
                arg1
                (fp #b0 #b11010111000 #b11101)))
(assert (fp.leq (fp #b0 #b11010111000 #b11101)
                arg1
                (fp #b0 #b11110111100 #b01110)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11100111011 #b10000)
                arg2
                (fp #b0 #b00000001001 #b00010)))
(assert (fp.leq (fp #b0 #b00000001001 #b00010)
                arg2
                (fp #b0 #b00010011100 #b00110)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01010110100 #b10001)
                expect
                (fp #b0 #b01011000011 #b00000)))
(assert (fp.leq (fp #b0 #b01011000011 #b00000)
                expect
                (fp #b0 #b11110100111 #b11011)))

(assert (= expect result))

(check-sat)
(exit)
