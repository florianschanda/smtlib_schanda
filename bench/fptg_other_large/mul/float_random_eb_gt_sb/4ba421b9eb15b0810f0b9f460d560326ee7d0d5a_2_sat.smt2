(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b010000000010 #b1000101111)
                arg1
                (fp #b0 #b010011011001 #b1110010011)))
(assert (fp.leq (fp #b0 #b010011011001 #b1110010011)
                arg1
                (fp #b0 #b110010100100 #b0101111110)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110001111110 #b1110111010)
                expect
                (fp #b0 #b000110110100 #b1100101100)))
(assert (fp.leq (fp #b0 #b000110110100 #b1100101100)
                expect
                (fp #b0 #b110011101001 #b1100011000)))

(assert (= expect result))

(check-sat)
(exit)
