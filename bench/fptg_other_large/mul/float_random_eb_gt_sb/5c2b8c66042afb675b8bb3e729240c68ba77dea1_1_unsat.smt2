(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b00111001111 #b0000101)
                arg1
                (fp #b0 #b11110100001 #b1001001)))
(assert (fp.leq (fp #b0 #b11110100001 #b1001001)
                arg1
                (fp #b0 #b11111000111 #b1110000)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01110111110 #b1011100)
                arg2
                (fp #b0 #b11001010001 #b0111100)))
(assert (fp.leq (fp #b0 #b11001010001 #b0111100)
                arg2
                (fp #b0 #b11010101010 #b0010110)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10001110000 #b1011000)
                expect
                (fp #b0 #b11111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111)
                expect
                (fp #b0 #b11111111111 #b0000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
