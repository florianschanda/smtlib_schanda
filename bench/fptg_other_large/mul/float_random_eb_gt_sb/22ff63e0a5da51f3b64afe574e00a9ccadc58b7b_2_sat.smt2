                (fp #b0 #b101111000101110101 #b01101101)))
(assert (fp.leq (fp #b0 #b101111000101110101 #b01101101)
                arg2
                (fp #b0 #b111110101011111010 #b01010100)))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b100011011010010000 #b10110000)
                expect
                (fp #b0 #b011001000010000010 #b10100101)))
(assert (fp.leq (fp #b0 #b011001000010000010 #b10100101)
                expect
                (fp #b0 #b101110100110000111 #b10001110)))

(assert (= expect result))

(check-sat)
