(assert (fp.leq (fp #b0 #b111010101101 #b0110001011)
                arg2
                (fp #b0 #b111011111011 #b1110010110)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111100010110 #b1001100000)
                expect
                (fp #b0 #b111010101110 #b0001101101)))
(assert (fp.leq (fp #b0 #b111010101110 #b0001101101)
                expect
                (fp #b0 #b111110011100 #b1101110010)))

(assert (not (= expect result)))

