(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11111100000101 #b0)
                arg1
                (fp #b1 #b01100000100111 #b1)))
(assert (fp.leq (fp #b1 #b01100000100111 #b1)
                arg1
                (fp #b0 #b10110000111010 #b0)))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b01100011100111 #b1)
                expect
                (fp #b1 #b01000001010000 #b0)))
(assert (fp.leq (fp #b1 #b01000001010000 #b0)
                expect
                (fp #b0 #b11111111110110 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
