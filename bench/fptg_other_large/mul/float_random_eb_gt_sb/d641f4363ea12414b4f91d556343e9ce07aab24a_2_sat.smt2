(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b001010010 #b1000100)
                arg1
                (fp #b0 #b110111110 #b0101110)))
(assert (fp.leq (fp #b0 #b110111110 #b0101110)
                arg1
                (fp #b0 #b111000001 #b1001100)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110111110 #b0000011)
                arg2
                (fp #b0 #b000000000 #b1011101)))
(assert (fp.leq (fp #b0 #b000000000 #b1011101)
                arg2
                (fp #b0 #b001011110 #b1011010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100100010 #b1110000)
                expect
                (fp #b0 #b010111111 #b1111101)))
(assert (fp.leq (fp #b0 #b010111111 #b1111101)
                expect
                (fp #b0 #b011101011 #b0100001)))

(assert (= expect result))

(check-sat)
(exit)
