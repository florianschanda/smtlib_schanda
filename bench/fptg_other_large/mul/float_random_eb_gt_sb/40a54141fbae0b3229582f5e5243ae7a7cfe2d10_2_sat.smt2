(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11111100001 #b0100011)
                arg1
                (fp #b1 #b01001000111 #b0100111)))
(assert (fp.leq (fp #b1 #b01001000111 #b0100111)
                arg1
                (fp #b1 #b01000010010 #b0010101)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01100101111 #b0010100)
                arg2
                (fp #b1 #b00000000000 #b0000011)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000011)
                arg2
                (fp #b0 #b00010101000 #b0110111)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11011000110 #b0111000)
                expect
                (fp #b0 #b00000000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000001)
                expect
                (fp #b0 #b10000101010 #b1101001)))

(assert (= expect result))

(check-sat)
(exit)
