(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b01111100101011 #b100100)
                arg1
                (fp #b1 #b01101100001010 #b000110)))
(assert (fp.leq (fp #b1 #b01101100001010 #b000110)
                arg1
                (fp #b0 #b11010001101011 #b101110)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b0 #b01000000000111 #b010001)
                expect
                (fp #b0 #b01011000010101 #b001100)))
(assert (fp.leq (fp #b0 #b01011000010101 #b001100)
                expect
                (fp #b0 #b11000010011001 #b101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
