; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111001000 #b1110101)
                arg1
                (fp #b1 #b1110111011 #b1111110)))
(assert (fp.leq (fp #b1 #b1110111011 #b1111110)
                arg1
                (fp #b1 #b0101000011 #b1101010)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101001010 #b0111011)
                arg2
                (fp #b0 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b0000000)
                arg2
                (fp #b0 #b1011000101 #b1011110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111011 #b0101001)
                expect
                (fp #b1 #b1111000011 #b1111110)))
(assert (fp.leq (fp #b1 #b1111000011 #b1111110)
                expect
                (fp #b0 #b0101111010 #b0111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
