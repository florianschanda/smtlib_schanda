(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01010110011111 #b1011)
                arg1
                (fp #b1 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0001)
                arg1
                (fp #b0 #b10111011100101 #b1110)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10001001001011 #b1011)
                arg2
                (fp #b1 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0001)
                arg2
                (fp #b0 #b01101111011100 #b1011)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00101000111111 #b1011)
                expect
                (fp #b0 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0001)
                expect
                (fp #b0 #b00000111010101 #b1101)))

(assert (not (= expect result)))

(check-sat)
(exit)
