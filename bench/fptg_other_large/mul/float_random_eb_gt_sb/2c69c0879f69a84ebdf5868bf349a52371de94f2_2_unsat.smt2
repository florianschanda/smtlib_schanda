; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0011100111000010 #b01010101111)
                arg1
                (fp #b0 #b0000000000000000 #b11111111111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b11111111111)
                arg1
                (fp #b0 #b1110011010010100 #b00100100111)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1110010001111011 #b00111011110)
                arg2
                (fp #b1 #b1100010001101001 #b00111110111)))
(assert (fp.leq (fp #b1 #b1100010001101001 #b00111110111)
                arg2
                (fp #b0 #b0010101000011110 #b11100010011)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1100000010011110 #b10011111110)
                expect
                (fp #b1 #b0100010001101011 #b00111110110)))
(assert (fp.leq (fp #b1 #b0100010001101011 #b00111110110)
                expect
                (fp #b0 #b1111100101110111 #b01010000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
