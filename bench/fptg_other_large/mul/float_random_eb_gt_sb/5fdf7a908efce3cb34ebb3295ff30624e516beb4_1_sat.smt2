(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11001110111101100 #b100)
                arg1
                (fp #b0 #b10000011101101100 #b011)))
(assert (fp.leq (fp #b0 #b10000011101101100 #b011)
                arg1
                (fp #b0 #b10101101111100101 #b101)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11010000001100000 #b100)
                expect
                (fp #b1 #b10000111011011001 #b111)))
(assert (fp.leq (fp #b1 #b10000111011011001 #b111)
                expect
                (fp #b0 #b00001000110110100 #b000)))

(assert (= expect result))

(check-sat)
(exit)
