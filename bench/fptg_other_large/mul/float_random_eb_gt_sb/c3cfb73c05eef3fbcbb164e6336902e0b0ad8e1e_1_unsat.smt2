                arg2
                (fp #b0 #b101110011 #b100011)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110111100 #b001000)
                expect
                (fp #b0 #b001111111 #b100000)))
(assert (fp.leq (fp #b0 #b001111111 #b100000)
                expect
                (fp #b0 #b101111100 #b101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
