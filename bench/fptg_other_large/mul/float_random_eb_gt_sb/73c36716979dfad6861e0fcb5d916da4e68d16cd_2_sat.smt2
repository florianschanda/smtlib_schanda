(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01101101110 #b1101)
                arg1
                (fp #b1 #b00000000000 #b1111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111)
                arg1
                (fp #b0 #b00111110101 #b1111)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00001100111 #b0001)
                arg2
                (fp #b0 #b01111111111 #b1101)))
(assert (fp.leq (fp #b0 #b01111111111 #b1101)
                arg2
                (fp #b0 #b11111110010 #b1110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00000110010 #b1110)
                expect
                (fp #b1 #b00000000001 #b1100)))
(assert (fp.leq (fp #b1 #b00000000001 #b1100)
                expect
                (fp #b0 #b01001100100 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
