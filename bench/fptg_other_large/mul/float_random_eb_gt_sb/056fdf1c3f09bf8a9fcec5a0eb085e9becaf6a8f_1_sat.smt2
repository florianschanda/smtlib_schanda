; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1010000011001111 #b1100010)
                arg1
                (fp #b1 #b1000000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000000000111 #b0000000)
                arg1
                (fp #b0 #b1001000000101101 #b0110110)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1000101111001100 #b1010011)
                arg2
                (fp #b0 #b0000000000000000 #b1011101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b1011101)
                arg2
                (fp #b0 #b1000101000100111 #b0011011)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1101001100111100 #b0111000)
                expect
                (fp #b1 #b0000000000001000 #b0111010)))
(assert (fp.leq (fp #b1 #b0000000000001000 #b0111010)
                expect
                (fp #b0 #b1011101111101001 #b1010011)))

(assert (= expect result))

(check-sat)
(exit)
