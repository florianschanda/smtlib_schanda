(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111010110 #b111)
                arg1
                (fp #b0 #b001001111 #b110)))
(assert (fp.leq (fp #b0 #b001001111 #b110)
                arg1
                (fp #b0 #b001111101 #b111)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101100011 #b010)
                arg2
                (fp #b1 #b010000000 #b000)))
(assert (fp.leq (fp #b1 #b010000000 #b000)
                arg2
                (fp #b0 #b111110000 #b010)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011001101 #b001)
                expect
                (fp #b1 #b000000000 #b001)))
(assert (fp.leq (fp #b1 #b000000000 #b001)
                expect
                (fp #b0 #b110001110 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
