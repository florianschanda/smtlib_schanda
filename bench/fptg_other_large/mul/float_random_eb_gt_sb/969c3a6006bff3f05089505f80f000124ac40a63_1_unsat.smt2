; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110010111 #b100)
                arg1
                (fp #b0 #b010000000 #b000)))
(assert (fp.leq (fp #b0 #b010000000 #b000)
                arg1
                (fp #b0 #b111100000 #b110)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111110001 #b101)
                arg2
                (fp #b0 #b011000111 #b100)))
(assert (fp.leq (fp #b0 #b011000111 #b100)
                arg2
                (fp #b0 #b100111110 #b010)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010011100 #b011)
                expect
                (fp #b0 #b001001000 #b100)))
(assert (fp.leq (fp #b0 #b001001000 #b100)
                expect
                (fp #b0 #b111011111 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
