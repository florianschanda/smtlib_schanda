(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1110000111000 #b1001101)
                arg1
                (fp #b1 #b0000000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b0000000000000 #b1111010)
                arg1
                (fp #b0 #b1101010010001 #b1110100)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111100100010 #b0000010)
                arg2
                (fp #b1 #b1111010011011 #b0001110)))
(assert (fp.leq (fp #b1 #b1111010011011 #b0001110)
                arg2
                (fp #b0 #b1010010100010 #b1111011)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0111000011011 #b1011011)
                expect
                (fp #b0 #b0111010011101 #b0001000)))
(assert (fp.leq (fp #b0 #b0111010011101 #b0001000)
                expect
                (fp #b0 #b1110111011010 #b1000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
