(assert (fp.leq (fp #b1 #b00111111111111010 #b01101010000)
                arg2
                (fp #b0 #b11110010100011001 #b10101000100)))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10101010110011011 #b11110001101)
                expect
                (fp #b1 #b00000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b00000000000)
                expect
                (fp #b0 #b00110011011110101 #b11000010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
