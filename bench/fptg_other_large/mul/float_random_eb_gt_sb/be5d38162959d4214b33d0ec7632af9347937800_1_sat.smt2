(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1000010001 #b0011)
                arg1
                (fp #b1 #b1000000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000000100 #b0000)
                arg1
                (fp #b0 #b1001101010 #b0010)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001011111 #b0000)
                arg2
                (fp #b1 #b1000000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000000100 #b0000)
                arg2
                (fp #b0 #b1101101101 #b0110)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0111001001 #b0111)
                expect
                (fp #b0 #b1000001001 #b0000)))
(assert (fp.leq (fp #b0 #b1000001001 #b0000)
                expect
                (fp #b0 #b1000001111 #b1110)))

(assert (= expect result))

(check-sat)
(exit)
