(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01110101101101 #b1100)
                arg1
                (fp #b1 #b00000000000000 #b0011)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0011)
                arg1
                (fp #b0 #b00101000101010 #b1011)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10000101001000 #b0110)
                arg2
                (fp #b1 #b00000000000000 #b0111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111)
                arg2
                (fp #b0 #b11100001100111 #b1111)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11101011110111 #b1110)
                expect
                (fp #b0 #b00000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000)
                expect
                (fp #b0 #b01001110011010 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
