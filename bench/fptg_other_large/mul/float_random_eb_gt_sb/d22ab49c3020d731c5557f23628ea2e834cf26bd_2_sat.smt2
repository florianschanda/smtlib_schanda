                arg2
                (fp #b0 #b001111111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b001111111111111101 #b000000)
                arg2
                (fp #b0 #b111001011101101101 #b010100)))

(declare-const result (_ FloatingPoint 18 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b010000101001100010 #b000011)
                expect
                (fp #b0 #b000000000000000000 #b000001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b000001)
                expect
                (fp #b0 #b000111001101000111 #b110011)))

(assert (= expect result))

(check-sat)
(exit)
