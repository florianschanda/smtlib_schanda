                arg2
                (fp #b0 #b00000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000001)
                arg2
                (fp #b0 #b10001101011 #b011010000)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10011001000 #b100010000)
                expect
                (fp #b1 #b00111110111 #b111111111)))
(assert (fp.leq (fp #b1 #b00111110111 #b111111111)
                expect
                (fp #b0 #b01010101111 #b000110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
