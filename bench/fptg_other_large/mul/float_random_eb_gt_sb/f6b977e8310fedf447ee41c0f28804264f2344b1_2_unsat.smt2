; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b101110110000010 #b00101100)
                arg1
                (fp #b0 #b010000101001111 #b01001000)))
(assert (fp.leq (fp #b0 #b010000101001111 #b01001000)
                arg1
                (fp #b0 #b110010100110000 #b01011100)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b110101100001100 #b01110010)
                arg2
                (fp #b0 #b101111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b101111111111110 #b11111111)
                arg2
                (fp #b0 #b110111111000100 #b00101111)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b111111101011101 #b01001001)
                expect
                (fp #b0 #b100000101001111 #b01001000)))
(assert (fp.leq (fp #b0 #b100000101001111 #b01001000)
                expect
                (fp #b0 #b101100000011000 #b11101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
