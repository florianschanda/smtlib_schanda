; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10111011011 #b001100110)
                arg1
                (fp #b1 #b10000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b10000001001 #b000000000)
                arg1
                (fp #b0 #b00100011010 #b000000001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00001110101 #b101001111)
                arg2
                (fp #b0 #b01110011100 #b001001110)))
(assert (fp.leq (fp #b0 #b01110011100 #b001001110)
                arg2
                (fp #b0 #b10011110010 #b001011000)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10000101100 #b000010110)
                expect
                (fp #b1 #b01110100110 #b001001110)))
(assert (fp.leq (fp #b1 #b01110100110 #b001001110)
                expect
                (fp #b0 #b00010010001 #b011110011)))

(assert (= expect result))

(check-sat)
(exit)
