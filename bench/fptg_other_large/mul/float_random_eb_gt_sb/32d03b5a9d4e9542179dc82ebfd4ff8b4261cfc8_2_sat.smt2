(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000110010 #b11010)
                arg1
                (fp #b0 #b0000000000 #b11101)))
(assert (fp.leq (fp #b0 #b0000000000 #b11101)
                arg1
                (fp #b0 #b0110011000 #b11011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0001001110 #b10101)
                arg2
                (fp #b0 #b1000001101 #b11010)))
(assert (fp.leq (fp #b0 #b1000001101 #b11010)
                arg2
                (fp #b0 #b1100110110 #b10011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0111101111 #b01001)
                expect
                (fp #b0 #b0000001111 #b10101)))
(assert (fp.leq (fp #b0 #b0000001111 #b10101)
                expect
                (fp #b0 #b1001101010 #b10000)))

(assert (= expect result))

(check-sat)
(exit)
