(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b00001111100 #b001111)
                arg1
                (fp #b0 #b01111111111 #b000100)))
(assert (fp.leq (fp #b0 #b01111111111 #b000100)
                arg1
                (fp #b0 #b10111100100 #b000101)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11101010000 #b101001)
                arg2
                (fp #b1 #b10111110101 #b100111)))
(assert (fp.leq (fp #b1 #b10111110101 #b100111)
                arg2
                (fp #b0 #b11111101100 #b100110)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11001100011 #b011111)
                expect
                (fp #b1 #b10111110101 #b101110)))
(assert (fp.leq (fp #b1 #b10111110101 #b101110)
                expect
                (fp #b0 #b10001001100 #b111000)))

(assert (= expect result))

(check-sat)
(exit)
