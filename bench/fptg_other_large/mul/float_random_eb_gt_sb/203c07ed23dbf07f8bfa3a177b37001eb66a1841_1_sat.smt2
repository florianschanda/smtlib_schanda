                arg2
                (fp #b1 #b000000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000000001)
                arg2
                (fp #b0 #b000101100000 #b0010001110)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100010101111 #b1100100100)
                expect
                (fp #b1 #b011111110101 #b0000000000)))
(assert (fp.leq (fp #b1 #b011111110101 #b0000000000)
                expect
                (fp #b0 #b111100001110 #b1001000100)))

(assert (= expect result))

(check-sat)
(exit)
