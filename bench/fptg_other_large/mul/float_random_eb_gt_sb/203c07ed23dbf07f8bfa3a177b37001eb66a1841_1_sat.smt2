(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b010100100110 #b1111101101)
                arg1
                (fp #b0 #b111111111101 #b0000000000)))
