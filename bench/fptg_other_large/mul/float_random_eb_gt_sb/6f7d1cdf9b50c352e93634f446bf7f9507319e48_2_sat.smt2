                arg2
                (fp #b1 #b0000000000000 #b111110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b111110)
                arg2
                (fp #b0 #b0110111001101 #b000100)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1010010101011 #b011110)
                expect
                (fp #b1 #b0000000000000 #b000001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000001)
                expect
                (fp #b0 #b0100011010101 #b001000)))

(assert (= expect result))

(check-sat)
(exit)
