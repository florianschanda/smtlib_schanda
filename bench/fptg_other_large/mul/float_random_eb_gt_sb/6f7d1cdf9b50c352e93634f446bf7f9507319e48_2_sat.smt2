;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1110100000111 #b010001)
                arg1
                (fp #b0 #b0000000000000 #b010000)))
