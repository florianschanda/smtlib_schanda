; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b100111111001 #b1)
                arg1
                (fp #b0 #b000000000000 #b0)))
(assert (fp.leq (fp #b0 #b000000000000 #b0)
                arg1
                (fp #b0 #b000001110101 #b1)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b100101011000 #b1)
                arg2
                (fp #b0 #b100000000001 #b0)))
(assert (fp.leq (fp #b0 #b100000000001 #b0)
                arg2
                (fp #b0 #b110100000100 #b1)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101000100001 #b0)
                expect
                (fp #b0 #b000000000000 #b0)))
(assert (fp.leq (fp #b0 #b000000000000 #b0)
                expect
                (fp #b0 #b000101111101 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
