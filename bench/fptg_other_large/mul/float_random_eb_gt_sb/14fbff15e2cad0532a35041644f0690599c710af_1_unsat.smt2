                arg2
                (fp #b0 #b01001101100001 #b001101111)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10001001101111 #b001100000)
                expect
                (fp #b1 #b00010011001111 #b110110001)))
(assert (fp.leq (fp #b1 #b00010011001111 #b110110001)
                expect
                (fp #b0 #b00011000111010 #b001111001)))

(assert (not (= expect result)))

