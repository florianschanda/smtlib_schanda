                arg2
                (fp #b1 #b111111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000)
                arg2
                (fp #b1 #b000011010011 #b01000110)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001000100111 #b00110100)
                expect
                (fp #b0 #b111011110100 #b01001000)))
(assert (fp.leq (fp #b0 #b111011110100 #b01001000)
                expect
                (fp #b0 #b111111010010 #b11000000)))

(assert (= expect result))

(check-sat)
(exit)
