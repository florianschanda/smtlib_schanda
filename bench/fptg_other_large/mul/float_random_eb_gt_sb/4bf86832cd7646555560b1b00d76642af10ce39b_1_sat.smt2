; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11110010000011 #b10)
                arg1
                (fp #b1 #b10000000000001 #b00)))
(assert (fp.leq (fp #b1 #b10000000000001 #b00)
                arg1
                (fp #b0 #b01010010010001 #b10)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11101011010000 #b10)
                arg2
                (fp #b1 #b11011000010001 #b10)))
(assert (fp.leq (fp #b1 #b11011000010001 #b10)
                arg2
                (fp #b0 #b11000001010000 #b00)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b00101100010011 #b01)
                expect
                (fp #b0 #b11011000010011 #b10)))
(assert (fp.leq (fp #b0 #b11011000010011 #b10)
                expect
                (fp #b0 #b11011011000100 #b10)))

(assert (= expect result))

(check-sat)
(exit)
