; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11011101010010100 #b101100001101001)
                arg1
                (fp #b0 #b01111111111111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b010001110000010)
                arg1
                (fp #b0 #b11111111111000001 #b001000110010001)))

(declare-const arg2 (_ FloatingPoint 17 16))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11100000011011101 #b000001101110111)
                expect
                (fp #b0 #b01111111111111111 #b101000011011101)))
(assert (fp.leq (fp #b0 #b01111111111111111 #b101000011011101)
                expect
                (fp #b0 #b10001101100111111 #b010101110111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
