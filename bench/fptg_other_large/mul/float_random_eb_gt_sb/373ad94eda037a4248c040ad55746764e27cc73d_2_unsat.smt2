(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00000000001110 #b0000)
                arg1
                (fp #b1 #b00000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100)
                arg1
                (fp #b0 #b11010111001000 #b0101)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00101010001101 #b0100)
                arg2
                (fp #b1 #b00000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100)
                arg2
                (fp #b0 #b10111100110011 #b1100)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10110101010000 #b1011)
                expect
                (fp #b0 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0001)
                expect
                (fp #b0 #b10010000001001 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
