                arg2
                (fp #b1 #b010000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b00000000)
                arg2
                (fp #b0 #b011111100100 #b00111001)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010110010111 #b10100001)
                expect
                (fp #b1 #b010000000000 #b11001001)))
(assert (fp.leq (fp #b1 #b010000000000 #b11001001)
                expect
                (fp #b0 #b010110101010 #b01101111)))

(assert (= expect result))

(check-sat)
(exit)
