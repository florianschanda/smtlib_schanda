(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b100010010111001 #b0111011011011)
                arg1
                (fp #b1 #b000000000000000 #b1000011100010)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1000011100010)
                arg1
                (fp #b0 #b101100001010100 #b0111001011000)))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b010101111010010 #b1011000100101)
                arg2
                (fp #b1 #b000000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0111000000111)
                arg2
                (fp #b0 #b000011010110010 #b1101110100000)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000010000011101 #b1010111001101)
                expect
                (fp #b0 #b000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000000000)
                expect
                (fp #b0 #b000010101111000 #b0111100001110)))

(assert (= expect result))

(check-sat)
(exit)
