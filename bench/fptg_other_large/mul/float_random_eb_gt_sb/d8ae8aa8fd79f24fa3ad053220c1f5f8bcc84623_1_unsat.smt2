(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111100110111 #b0)
                arg1
                (fp #b1 #b1000000000000 #b1)))
(assert (fp.leq (fp #b1 #b1000000000000 #b1)
                arg1
                (fp #b0 #b1011001111001 #b1)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1110011111100 #b0)
                arg2
                (fp #b1 #b0111111111111 #b1)))
(assert (fp.leq (fp #b1 #b0111111111111 #b1)
                arg2
                (fp #b1 #b0110000101010 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b0 #b0111000000000 #b0)
                expect
                (fp #b0 #b1000000000001 #b0)))
(assert (fp.leq (fp #b0 #b1000000000001 #b0)
                expect
                (fp #b0 #b1100100000010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
