(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1000100110111 #b0)
                arg1
                (fp #b0 #b0000111101000 #b1)))
(assert (fp.leq (fp #b0 #b0000111101000 #b1)
                arg1
                (fp #b0 #b0001001100100 #b1)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1001001000111 #b1)
                arg2
                (fp #b0 #b0111111111111 #b1)))
(assert (fp.leq (fp #b0 #b0111111111111 #b1)
                arg2
                (fp #b0 #b1100100111001 #b0)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b0 #b0000100001000 #b0)
                expect
                (fp #b0 #b0000111101001 #b1)))
(assert (fp.leq (fp #b0 #b0000111101001 #b1)
                expect
                (fp #b0 #b0011100000101 #b0)))

(assert (= expect result))

(check-sat)
(exit)
