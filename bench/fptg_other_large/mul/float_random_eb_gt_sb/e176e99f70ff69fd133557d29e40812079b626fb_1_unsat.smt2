(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01001011111 #b111010110)
                arg1
                (fp #b1 #b00000000000 #b111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b111111111)
                arg1
                (fp #b0 #b01011110101 #b000101001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10111110110 #b101100011)
                arg2
                (fp #b1 #b00000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000001)
                arg2
                (fp #b0 #b01010001100 #b101000110)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01111110011 #b010000101)
                expect
                (fp #b0 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000000)
                expect
                (fp #b0 #b10101001010 #b000100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
