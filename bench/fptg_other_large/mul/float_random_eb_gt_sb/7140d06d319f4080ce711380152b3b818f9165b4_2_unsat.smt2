(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0000101101110101 #b1)
                arg1
                (fp #b0 #b0011111111111111 #b1)))
(assert (fp.leq (fp #b0 #b0011111111111111 #b1)
                arg1
                (fp #b0 #b0111111100110100 #b1)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0100110011010111 #b1)
                arg2
                (fp #b0 #b1000000000000000 #b1)))
(assert (fp.leq (fp #b0 #b1000000000000000 #b1)
                arg2
                (fp #b0 #b1101010101011100 #b0)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0001110111111001 #b1)
                expect
                (fp #b0 #b0100000000000001 #b1)))
(assert (fp.leq (fp #b0 #b0100000000000001 #b1)
                expect
                (fp #b0 #b1000011110000011 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
