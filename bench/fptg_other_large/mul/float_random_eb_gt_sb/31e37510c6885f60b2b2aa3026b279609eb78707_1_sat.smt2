                arg2
                (fp #b1 #b0100000011 #b01110)))
(assert (fp.leq (fp #b1 #b0100000011 #b01110)
                arg2
                (fp #b0 #b1100111101 #b00001)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0100110011 #b00010)
                expect
                (fp #b1 #b0100001001 #b01110)))
(assert (fp.leq (fp #b1 #b0100001001 #b01110)
                expect
                (fp #b1 #b0000101100 #b01001)))

(assert (= expect result))

(check-sat)
(exit)
