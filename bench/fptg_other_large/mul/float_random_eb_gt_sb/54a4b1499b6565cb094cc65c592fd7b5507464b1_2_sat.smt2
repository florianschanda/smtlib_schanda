(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10000111111 #b01)
                arg1
                (fp #b0 #b00000000000 #b11)))
(assert (fp.leq (fp #b0 #b00000000000 #b11)
                arg1
                (fp #b0 #b00101101101 #b01)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01111100111 #b10)
                arg2
                (fp #b1 #b00000000000 #b10)))
(assert (fp.leq (fp #b1 #b00000000000 #b10)
                arg2
                (fp #b0 #b00100111000 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10101001111 #b10)
                expect
                (fp #b1 #b00000000000 #b01)))
(assert (fp.leq (fp #b1 #b00000000000 #b01)
                expect
                (fp #b0 #b10111011001 #b00)))

(assert (= expect result))

(check-sat)
(exit)
