(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b001101110100 #b0111010)
                arg1
                (fp #b0 #b000000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b000000000000 #b1011100)
                arg1
                (fp #b0 #b101111000111 #b0101110)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000011000100 #b0100011)
                expect
                (fp #b1 #b000000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b0000001)
                expect
                (fp #b0 #b111101100110 #b0000010)))

(assert (= expect result))

(check-sat)
(exit)
