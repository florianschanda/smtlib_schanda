; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b011011011001 #b1001000000)
                arg1
                (fp #b0 #b011111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b011111111111 #b1001100100)
                arg1
                (fp #b0 #b100000101010 #b0100111011)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101001000110 #b0111000011)
                arg2
                (fp #b1 #b011111111111 #b0000100111)))
(assert (fp.leq (fp #b1 #b011111111111 #b0000100111)
                arg2
                (fp #b1 #b011100101011 #b1100010011)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100100111110 #b0110011001)
                expect
                (fp #b1 #b011111111111 #b1010100010)))
(assert (fp.leq (fp #b1 #b011111111111 #b1010100010)
                expect
                (fp #b0 #b100110001110 #b1101010110)))

(assert (= expect result))

(check-sat)
(exit)
