                (fp #b1 #b00000000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b01000000)
                arg2
                (fp #b0 #b01001001000100 #b11101111)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11000100101101 #b10111010)
                expect
                (fp #b1 #b01111111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b01111111111101 #b00000000)
                expect
                (fp #b0 #b00110001001110 #b01101110)))

(assert (= expect result))

(check-sat)
(exit)
