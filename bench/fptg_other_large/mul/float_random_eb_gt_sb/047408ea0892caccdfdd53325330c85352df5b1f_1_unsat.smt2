; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b0 #b10000100100110010 #b0)
                arg1
                (fp #b0 #b10100010010101000 #b1)))
(assert (fp.leq (fp #b0 #b10100010010101000 #b1)
                arg1
                (fp #b0 #b10110000000101100 #b1)))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b10000100111010011 #b0)
                arg2
                (fp #b0 #b00111111111111111 #b1)))
(assert (fp.leq (fp #b0 #b00111111111111111 #b1)
                arg2
                (fp #b0 #b11011101010001010 #b1)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b00001000101000000 #b0)
                expect
                (fp #b0 #b01100010010101001 #b0)))
(assert (fp.leq (fp #b0 #b01100010010101001 #b0)
                expect
                (fp #b0 #b11101000011001010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
