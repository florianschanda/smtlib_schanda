(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1010100011000001 #b00)
                arg1
                (fp #b1 #b0000000000000000 #b11)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b11)
                arg1
                (fp #b0 #b1111011001010111 #b10)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1001001110111011 #b00)
                arg2
                (fp #b1 #b0011111111111111 #b00)))
(assert (fp.leq (fp #b1 #b0011111111111111 #b00)
                arg2
                (fp #b0 #b0101100001001000 #b10)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0111010011000000 #b11)
                expect
                (fp #b0 #b0000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01)
                expect
                (fp #b0 #b1110001100001001 #b01)))

(assert (= expect result))

(check-sat)
(exit)
