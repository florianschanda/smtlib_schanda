(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0011111111000 #b1101001)
                arg1
                (fp #b0 #b0001000110001 #b1010011)))
(assert (fp.leq (fp #b0 #b0001000110001 #b1010011)
                arg1
                (fp #b0 #b0101110101011 #b0110001)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0000001001000 #b0011010)
                arg2
                (fp #b0 #b0000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0100000)
                arg2
                (fp #b0 #b0110010000000 #b0010000)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1001011001011 #b1111110)
                expect
                (fp #b0 #b0000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0000000)
                expect
                (fp #b0 #b0111010010001 #b1110011)))

(assert (= expect result))

(check-sat)
(exit)
