(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111111111111111 #b0000)
                arg1
                (fp #b1 #b111111111111110 #b1111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b1111)
                arg1
                (fp #b0 #b110100001100010 #b1001)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b100011101101011 #b0010)
                arg2
                (fp #b0 #b101111101011010 #b0000)))
(assert (fp.leq (fp #b0 #b101111101011010 #b0000)
                arg2
                (fp #b0 #b111111110000101 #b0111)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
