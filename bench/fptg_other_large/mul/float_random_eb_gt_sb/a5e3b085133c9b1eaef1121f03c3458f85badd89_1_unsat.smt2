(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111100000 #b011001)
                arg1
                (fp #b1 #b010111110 #b111110)))
(assert (fp.leq (fp #b1 #b010111110 #b111110)
                arg1
                (fp #b0 #b011001101 #b100011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b010001000 #b111111)
                arg2
                (fp #b0 #b000000000 #b011111)))
(assert (fp.leq (fp #b0 #b000000000 #b011111)
                arg2
                (fp #b0 #b111100011 #b011001)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011000111 #b000000)
                expect
                (fp #b1 #b000000000 #b000000)))
(assert (fp.leq (fp #b1 #b000000000 #b000000)
                expect
                (fp #b0 #b110001101 #b010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
