                arg2
                (fp #b1 #b10111110101 #b100111)))
(assert (fp.leq (fp #b1 #b10111110101 #b100111)
                arg2
                (fp #b0 #b11110111110 #b011010)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10000011101 #b011000)
                expect
                (fp #b0 #b10111111100 #b100111)))
(assert (fp.leq (fp #b0 #b10111111100 #b100111)
                expect
                (fp #b0 #b11010000100 #b010011)))

(assert (= expect result))

(check-sat)
(exit)
