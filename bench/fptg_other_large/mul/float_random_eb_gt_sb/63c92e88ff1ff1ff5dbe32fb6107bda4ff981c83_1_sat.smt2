(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11000010110 #b011010)
                arg1
                (fp #b1 #b10000000110 #b000000)))
(assert (fp.leq (fp #b1 #b10000000110 #b000000)
