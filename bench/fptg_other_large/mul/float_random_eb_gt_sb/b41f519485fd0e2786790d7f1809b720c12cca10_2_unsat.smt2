(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0000010101 #b0111000)
                arg1
                (fp #b0 #b0111111010 #b1101111)))
(assert (fp.leq (fp #b0 #b0111111010 #b1101111)
                arg1
                (fp #b0 #b1000111000 #b1001001)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011100010 #b0011001)
                arg2
                (fp #b1 #b0000000000 #b1111111)))
(assert (fp.leq (fp #b1 #b0000000000 #b1111111)
                arg2
                (fp #b0 #b1000001110 #b1101110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101000011 #b1111010)
                expect
                (fp #b1 #b0000000000 #b0001000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0001000)
                expect
                (fp #b0 #b0010110101 #b1001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
