(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b0 #b001010010000001 #b11100)
                arg1
                (fp #b0 #b011111111111111 #b00111)))
(assert (fp.leq (fp #b0 #b011111111111111 #b00111)
                arg1
                (fp #b0 #b110110010111011 #b00110)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111010101110000 #b11100)
                arg2
                (fp #b1 #b000000000000000 #b11111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b11111)
                arg2
                (fp #b0 #b011011111010000 #b11010)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b000110111101001 #b00100)
                expect
                (fp #b1 #b000000000000001 #b00101)))
(assert (fp.leq (fp #b1 #b000000000000001 #b00101)
                expect
                (fp #b0 #b010010111100001 #b00100)))

(assert (= expect result))

(check-sat)
(exit)
