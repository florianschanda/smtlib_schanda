(assert (fp.leq (fp #b1 #b01111111111111 #b00110001010)
                arg2
                (fp #b1 #b00100010111100 #b01101101001)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b01111010110011 #b01001001110)
                expect
                (fp #b0 #b00000000000000 #b01001100011)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01001100011)
                expect
                (fp #b0 #b11100000110100 #b10110011111)))

(assert (= expect result))

(check-sat)
