; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10010100110 #b10001011)
                arg1
                (fp #b0 #b10000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b10000000010 #b00100000)
                arg1
                (fp #b0 #b10110011100 #b10011101)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00011000100 #b11110011)
                arg2
                (fp #b0 #b01111111111 #b11100111)))
(assert (fp.leq (fp #b0 #b01111111111 #b11100111)
                arg2
                (fp #b0 #b10010000011 #b10100100)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11100001000 #b11001001)
                expect
                (fp #b0 #b10000000011 #b00010010)))
(assert (fp.leq (fp #b0 #b10000000011 #b00010010)
                expect
                (fp #b0 #b11010000001 #b10001111)))

(assert (= expect result))

(check-sat)
(exit)
