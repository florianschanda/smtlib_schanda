(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b111101010101011 #b1)
                arg1
                (fp #b1 #b001111111111111 #b1)))
(assert (fp.leq (fp #b1 #b001111111111111 #b1)
                arg1
                (fp #b0 #b001111001001111 #b0)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b101111110110111 #b0)
                arg2
                (fp #b1 #b100000000000000 #b1)))
(assert (fp.leq (fp #b1 #b100000000000000 #b1)
                arg2
                (fp #b0 #b011111011100010 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b011011111000101 #b1)
                expect
                (fp #b0 #b010000000000001 #b0)))
(assert (fp.leq (fp #b0 #b010000000000001 #b0)
                expect
                (fp #b0 #b101111011100010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
