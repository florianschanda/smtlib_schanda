(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1001001010011 #b00110)
                arg1
                (fp #b1 #b0011111010101 #b01100)))
(assert (fp.leq (fp #b1 #b0011111010101 #b01100)
                arg1
                (fp #b0 #b0111101001011 #b11001)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1011110001011 #b01001)
                expect
                (fp #b0 #b0000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000)
                expect
                (fp #b0 #b1001000001000 #b01001)))

(assert (= expect result))

(check-sat)
(exit)
