; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b00011001110 #b110101)
                arg1
                (fp #b1 #b00000000000 #b011011)))
(assert (fp.leq (fp #b1 #b00000000000 #b011011)
                arg1
                (fp #b0 #b01111101010 #b111001)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11010110001 #b010110)
                arg2
                (fp #b1 #b10111111110 #b111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b111111)
                arg2
                (fp #b1 #b01001110010 #b000111)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10101001011 #b110001)
                expect
                (fp #b0 #b00111111111 #b101011)))
(assert (fp.leq (fp #b0 #b00111111111 #b101011)
                expect
                (fp #b0 #b11000000011 #b001010)))

(assert (= expect result))

(check-sat)
(exit)
