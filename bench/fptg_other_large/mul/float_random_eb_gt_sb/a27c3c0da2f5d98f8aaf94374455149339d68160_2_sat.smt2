(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1110001110011 #b00011)
                arg1
                (fp #b1 #b1000010000001 #b00101)))
(assert (fp.leq (fp #b1 #b1000010000001 #b00101)
                arg1
                (fp #b1 #b0101111100000 #b11110)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1101111101110 #b10001)
                arg2
                (fp #b1 #b0111111111111 #b00110)))
(assert (fp.leq (fp #b1 #b0111111111111 #b00110)
                arg2
                (fp #b0 #b1000110001001 #b01011)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b0 #b0011011001111 #b11011)
                expect
                (fp #b0 #b1000010000001 #b01100)))
(assert (fp.leq (fp #b0 #b1000010000001 #b01100)
                expect
                (fp #b0 #b1000100100101 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
