; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b11111111111111101 #b00101100)
                arg1
                (fp #b1 #b11111111111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b00000000)
                arg1
                (fp #b0 #b01010011000101111 #b00101011)))

(declare-const arg2 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b00001010100110000 #b01111010)
                arg2
                (fp #b0 #b10000000000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b10000000000001000 #b00000000)
                arg2
                (fp #b0 #b11110011101010110 #b01011010)))

(declare-const result (_ FloatingPoint 17 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b11111111111111111 #b00000000)
                expect
                (fp #b1 #b11111111111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b11111111111111110 #b11111111)
                expect
                (fp #b0 #b10111000010010010 #b01111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
