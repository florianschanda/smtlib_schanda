; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1101110010011110 #b1)
                arg1
                (fp #b0 #b1000000000000001 #b0)))
(assert (fp.leq (fp #b0 #b1000000000000001 #b0)
                arg1
                (fp #b0 #b1010111000011010 #b1)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1100011111101111 #b0)
                arg2
                (fp #b0 #b1011010110010010 #b1)))
(assert (fp.leq (fp #b0 #b1011010110010010 #b1)
                arg2
                (fp #b0 #b1101111011001000 #b1)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b0 #b0101100010111000 #b0)
                expect
                (fp #b0 #b1011010110010100 #b1)))
(assert (fp.leq (fp #b0 #b1011010110010100 #b1)
                expect
                (fp #b0 #b1100001100001110 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
