(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b0 #b010010010011001 #b111101)
                arg1
                (fp #b0 #b100000000000011 #b011000)))
(assert (fp.leq (fp #b0 #b100000000000011 #b011000)
                arg1
                (fp #b0 #b110111011010111 #b100110)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b001111000010001 #b010100)
                arg2
                (fp #b0 #b111111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b000000)
                arg2
                (fp #b0 #b111111111111110 #b011011)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b0 #b110101011001010 #b101101)
                expect
                (fp #b0 #b111111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b111111)
                expect
                (fp #b0 #b111111111111111 #b000000)))

(assert (= expect result))

(check-sat)
(exit)
