(assert (fp.leq (fp #b0 #b00000000000000000 #b11111111111)
                arg2
                (fp #b0 #b01010101101110010 #b00101010011)))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01000001011001011 #b11111011011)
                expect
                (fp #b0 #b00000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00000000000)
                expect
                (fp #b0 #b11111010101101110 #b11111111100)))

(assert (not (= expect result)))

(check-sat)
