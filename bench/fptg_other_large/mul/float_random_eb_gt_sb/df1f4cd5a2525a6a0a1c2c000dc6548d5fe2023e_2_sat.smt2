                arg2
                (fp #b1 #b110001110001101100 #b100001101100001)))
(assert (fp.leq (fp #b1 #b110001110001101100 #b100001101100001)
                arg2
                (fp #b0 #b111111100111001000 #b000111101001001)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b000011100110111001 #b100000010001111)
                expect
                (fp #b0 #b110001110001101101 #b010110110011000)))
(assert (fp.leq (fp #b0 #b110001110001101101 #b010110110011000)
                expect
                (fp #b0 #b111100010011011011 #b001000110101000)))

(assert (= expect result))

(check-sat)
(exit)
