(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b10101001110000000 #b000110)
                arg1
                (fp #b0 #b01000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b01000000000000000 #b000000)
                arg1
                (fp #b0 #b01101100011001001 #b100111)))

(declare-const arg2 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b10010110101011001 #b001001)
                arg2
                (fp #b0 #b00000000000000000 #b000001)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b000001)
                arg2
                (fp #b0 #b11100001101011010 #b011011)))

(declare-const result (_ FloatingPoint 17 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b11010011101100010 #b101110)
                expect
                (fp #b0 #b00000000000000000 #b000001)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b000001)
                expect
                (fp #b0 #b11010000011101010 #b111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
