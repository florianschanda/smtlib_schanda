(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b000010010 #b1)
                arg1
                (fp #b0 #b101111110 #b1)))
(assert (fp.leq (fp #b0 #b101111110 #b1)
                arg1
                (fp #b0 #b110001110 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111011010 #b1)
                arg2
                (fp #b1 #b100000000 #b1)))
(assert (fp.leq (fp #b1 #b100000000 #b1)
                arg2
                (fp #b1 #b010101101 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111000000 #b0)
                expect
                (fp #b1 #b110000000 #b0)))
(assert (fp.leq (fp #b1 #b110000000 #b0)
                expect
                (fp #b1 #b000111001 #b0)))

(assert (= expect result))

(check-sat)
(exit)
