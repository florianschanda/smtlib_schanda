; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b0 #b1001111011011 #b00010)
                arg1
                (fp #b0 #b1111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11111)
                arg1
                (fp #b0 #b1111111111111 #b00000)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1010110101000 #b11000)
                arg2
                (fp #b0 #b0000000000000 #b11111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b11111)
                arg2
                (fp #b0 #b1111111010001 #b11010)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b0 #b0010111010110 #b11000)
                expect
                (fp #b0 #b1000000000000 #b11110)))
(assert (fp.leq (fp #b0 #b1000000000000 #b11110)
                expect
                (fp #b0 #b1011110001011 #b10110)))

(assert (not (= expect result)))

(check-sat)
(exit)
