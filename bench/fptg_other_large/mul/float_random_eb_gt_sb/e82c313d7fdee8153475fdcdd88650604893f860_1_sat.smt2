(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100100 #b01011)
                arg1
                (fp #b0 #b100000101 #b00010)))
(assert (fp.leq (fp #b0 #b100000101 #b00010)
                arg1
                (fp #b0 #b110100110 #b01111)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111000001 #b00111)
                arg2
                (fp #b1 #b001111101 #b01101)))
(assert (fp.leq (fp #b1 #b001111101 #b01101)
                arg2
                (fp #b0 #b001000111 #b10111)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011011111 #b11000)
                expect
                (fp #b1 #b010000011 #b01111)))
(assert (fp.leq (fp #b1 #b010000011 #b01111)
                expect
                (fp #b1 #b001101100 #b11100)))

(assert (= expect result))

(check-sat)
(exit)
