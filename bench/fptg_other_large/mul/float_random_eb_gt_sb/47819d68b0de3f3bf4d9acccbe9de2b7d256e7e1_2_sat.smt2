(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b0 #b0011010010111000 #b1000100011001)
                arg1
                (fp #b0 #b0111111111111111 #b0111011011110)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b0111011011110)
                arg1
                (fp #b0 #b1011101011111010 #b0111100111100)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b0100110000010101 #b1011000011011)
                arg2
                (fp #b0 #b0000000000000000 #b0010100010010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0010100010010)
                arg2
                (fp #b0 #b0100011111110100 #b0101000110110)))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b0100001101100100 #b1110011101000)
                expect
                (fp #b0 #b0000000000000000 #b0011101101110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0011101101110)
                expect
                (fp #b0 #b0110011011000101 #b1001110001101)))

(assert (= expect result))

(check-sat)
(exit)
