(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b010101011 #b0)
                arg1
                (fp #b1 #b010000000 #b0)))
(assert (fp.leq (fp #b1 #b010000000 #b0)
                arg1
                (fp #b0 #b000001001 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b000101000 #b1)
                arg2
                (fp #b1 #b000000001 #b0)))
(assert (fp.leq (fp #b1 #b000000001 #b0)
                arg2
                (fp #b0 #b110000010 #b0)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b100111101 #b0)
                expect
                (fp #b0 #b000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000 #b1)
                expect
                (fp #b0 #b001000011 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
