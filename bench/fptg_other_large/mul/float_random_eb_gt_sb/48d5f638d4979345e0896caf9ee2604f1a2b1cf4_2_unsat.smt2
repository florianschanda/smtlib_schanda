(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10000011010 #b011001001)
                arg1
                (fp #b1 #b01001001101 #b101001011)))
(assert (fp.leq (fp #b1 #b01001001101 #b101001011)
                arg1
                (fp #b0 #b01010110111 #b011100111)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111111111 #b000000000)
                arg2
                (fp #b1 #b11111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b111111111)
                arg2
                (fp #b1 #b01000111111 #b000000101)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10100011111 #b001111010)
                expect
                (fp #b0 #b11001001101 #b101001011)))
(assert (fp.leq (fp #b0 #b11001001101 #b101001011)
                expect
                (fp #b0 #b11111011001 #b011101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
