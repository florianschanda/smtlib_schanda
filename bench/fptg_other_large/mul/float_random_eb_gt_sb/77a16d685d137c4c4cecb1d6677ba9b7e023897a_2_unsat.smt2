(assert (fp.leq (fp #b0 #b10111111111110 #b11111111111)
                arg2
                (fp #b0 #b11011010100101 #b00101001001)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b0 #b01001010101011 #b01011101110)
                expect
                (fp #b0 #b11001110010001 #b01000001010)))
(assert (fp.leq (fp #b0 #b11001110010001 #b01000001010)
                expect
                (fp #b0 #b11110011111100 #b11100101100)))

(assert (not (= expect result)))

(check-sat)
