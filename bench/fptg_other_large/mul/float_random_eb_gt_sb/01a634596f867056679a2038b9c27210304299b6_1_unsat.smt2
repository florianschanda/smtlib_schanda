(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111000010 #b010)
                arg1
                (fp #b1 #b110100111 #b010)))
(assert (fp.leq (fp #b1 #b110100111 #b010)
                arg1
                (fp #b1 #b101000011 #b111)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000011000 #b001)
                arg2
                (fp #b0 #b000000000 #b111)))
(assert (fp.leq (fp #b0 #b000000000 #b111)
                arg2
                (fp #b0 #b010100100 #b111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011100000 #b010)
                expect
                (fp #b1 #b010101001 #b000)))
(assert (fp.leq (fp #b1 #b010101001 #b000)
                expect
                (fp #b0 #b101010000 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
