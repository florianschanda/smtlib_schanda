(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1100010011010 #b11)
                arg1
                (fp #b1 #b0000000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00)
                arg1
                (fp #b0 #b0000011001101 #b00)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1101010110010 #b00)
                arg2
                (fp #b0 #b0111111111111 #b11)))
(assert (fp.leq (fp #b0 #b0111111111111 #b11)
                arg2
                (fp #b0 #b1010001111001 #b10)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111110100100 #b10)
                expect
                (fp #b1 #b0000000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00)
                expect
                (fp #b0 #b0111110110110 #b00)))

(assert (= expect result))

(check-sat)
(exit)
