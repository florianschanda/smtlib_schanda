(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100110010 #b111)
                arg2
                (fp #b1 #b000101100 #b111)))
(assert (fp.leq (fp #b1 #b000101100 #b111)
                arg2
                (fp #b0 #b010100010 #b110)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
