(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b011000010 #b10)
                arg1
                (fp #b0 #b101111110 #b11)))
(assert (fp.leq (fp #b0 #b101111110 #b11)
                arg1
                (fp #b0 #b110101101 #b11)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011100110 #b11)
                arg2
                (fp #b1 #b001110011 #b01)))
(assert (fp.leq (fp #b1 #b001110011 #b01)
                arg2
                (fp #b0 #b111010111 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111011 #b11)
                expect
                (fp #b1 #b011110011 #b01)))
(assert (fp.leq (fp #b1 #b011110011 #b01)
                expect
                (fp #b1 #b010100101 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
