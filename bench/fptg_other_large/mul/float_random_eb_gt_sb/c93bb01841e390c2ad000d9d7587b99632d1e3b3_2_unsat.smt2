; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010100011 #b1110111)
                arg1
                (fp #b0 #b100110110 #b0100010)))
(assert (fp.leq (fp #b0 #b100110110 #b0100010)
                arg1
                (fp #b0 #b110100000 #b1000011)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110001110 #b0100000)
                arg2
                (fp #b1 #b000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b000000000 #b1101110)
                arg2
                (fp #b0 #b011111111 #b0110001)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101000100 #b1100011)
                expect
                (fp #b1 #b000111000 #b0001100)))
(assert (fp.leq (fp #b1 #b000111000 #b0001100)
                expect
                (fp #b1 #b000100000 #b0010000)))

(assert (not (= expect result)))

(check-sat)
(exit)
