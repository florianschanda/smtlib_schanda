(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0111010001011001 #b0000111000)
                arg1
                (fp #b0 #b1111010000111011 #b1000000000)))
(assert (fp.leq (fp #b0 #b1111010000111011 #b1000000000)
                arg1
                (fp #b0 #b1111100100111101 #b1001010010)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1101111100111011 #b0100100010)
                arg2
                (fp #b1 #b1100110001000101 #b1110000011)))
(assert (fp.leq (fp #b1 #b1100110001000101 #b1110000011)
                arg2
                (fp #b0 #b1011111000101000 #b0000101100)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
