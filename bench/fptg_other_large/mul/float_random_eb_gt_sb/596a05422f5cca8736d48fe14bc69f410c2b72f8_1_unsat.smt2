; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0000001000110001 #b00101001001)
                arg1
                (fp #b1 #b0000000000000000 #b11011000100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b11011000100)
                arg1
                (fp #b0 #b1101000110111111 #b00100010001)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1101010000001000 #b01111001001)
                arg2
                (fp #b0 #b0000000000000001 #b00000000000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b00000000000)
                arg2
                (fp #b0 #b1111111000000011 #b11100001110)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0000110010100111 #b10110111110)
                expect
                (fp #b1 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000000)
                expect
                (fp #b0 #b1011101111001011 #b00011101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
