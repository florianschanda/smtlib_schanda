(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b010000100 #b1011)
                arg1
                (fp #b0 #b000101011 #b0110)))
(assert (fp.leq (fp #b0 #b000101011 #b0110)
                arg1
                (fp #b0 #b011101010 #b1010)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000110111 #b1000)
                arg2
                (fp #b0 #b000000000 #b0111)))
(assert (fp.leq (fp #b0 #b000000000 #b0111)
                arg2
                (fp #b0 #b111001110 #b1011)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001010100 #b0010)
                expect
                (fp #b0 #b000000000 #b0001)))
(assert (fp.leq (fp #b0 #b000000000 #b0001)
                expect
                (fp #b0 #b100001110 #b0101)))

(assert (not (= expect result)))

(check-sat)
(exit)
