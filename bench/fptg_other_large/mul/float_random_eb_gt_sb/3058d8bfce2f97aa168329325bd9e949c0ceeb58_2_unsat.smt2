(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b000001011110011 #b10)
                arg1
                (fp #b1 #b000000000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000000000 #b10)
                arg1
                (fp #b0 #b011110011011010 #b10)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b101011101110011 #b10)
                arg2
                (fp #b1 #b001100101000010 #b00)))
(assert (fp.leq (fp #b1 #b001100101000010 #b00)
                arg2
                (fp #b0 #b101010101001000 #b01)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b001101011101011 #b11)
                expect
                (fp #b0 #b000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000000 #b01)
                expect
                (fp #b0 #b111001010001000 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
