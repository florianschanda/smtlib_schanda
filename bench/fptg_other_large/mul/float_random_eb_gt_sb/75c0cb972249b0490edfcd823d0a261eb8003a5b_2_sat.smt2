(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100011011 #b10)
                arg1
                (fp #b1 #b000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000 #b01)
                arg1
                (fp #b0 #b111001010 #b11)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100101101 #b11)
                arg2
                (fp #b1 #b000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000 #b01)
                arg2
                (fp #b0 #b001011110 #b11)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b001001011 #b00)
                expect
                (fp #b0 #b000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000 #b01)
                expect
                (fp #b0 #b000011011 #b00)))

(assert (= expect result))

(check-sat)
(exit)
