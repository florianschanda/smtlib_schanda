(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -INFINITY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b001100011011011 #b10111)
                arg1
                (fp #b0 #b000000000000000 #b11111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111)
                arg1
                (fp #b0 #b111101011111010 #b11111)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
