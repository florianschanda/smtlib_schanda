(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b001111010011 #b0101011110)
                arg2
                (fp #b0 #b101111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b1111111111)
                arg2
                (fp #b0 #b111011001100 #b0101111100)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
