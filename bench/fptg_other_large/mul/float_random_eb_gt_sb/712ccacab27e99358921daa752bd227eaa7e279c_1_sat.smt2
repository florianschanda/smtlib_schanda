(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0010100010101000 #b111000010)
                arg1
                (fp #b1 #b0000000000000001 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000000001 #b000000000)
                arg1
                (fp #b0 #b0100010011000001 #b001000100)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b0010011111100101 #b001000011)
                arg2
                (fp #b0 #b0000000000000000 #b100001010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b100001010)
                arg2
                (fp #b0 #b0110010110101110 #b111110100)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0000100001111011 #b001010101)
                expect
                (fp #b1 #b0000000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000)
                expect
                (fp #b0 #b0100001101100101 #b000111000)))

(assert (= expect result))

(check-sat)
(exit)
