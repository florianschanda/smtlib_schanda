; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0000011010 #b010110)
                arg1
                (fp #b0 #b1010001001 #b110110)))
(assert (fp.leq (fp #b0 #b1010001001 #b110110)
                arg1
                (fp #b0 #b1101100001 #b111010)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1001110100 #b100101)
                arg2
                (fp #b1 #b1000000000 #b100000)))
(assert (fp.leq (fp #b1 #b1000000000 #b100000)
                arg2
                (fp #b0 #b1110011011 #b010111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111011010 #b111011)
                expect
                (fp #b1 #b1010001011 #b011000)))
(assert (fp.leq (fp #b1 #b1010001011 #b011000)
                expect
                (fp #b1 #b1000110111 #b100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
