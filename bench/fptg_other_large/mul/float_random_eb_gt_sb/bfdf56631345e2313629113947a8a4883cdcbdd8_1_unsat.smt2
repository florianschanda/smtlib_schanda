(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1001100000 #b111001)
                arg1
                (fp #b1 #b0011111101 #b000000)))
(assert (fp.leq (fp #b1 #b0011111101 #b000000)
                arg1
                (fp #b0 #b1100110101 #b111111)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1110001011 #b101101)
                arg2
                (fp #b1 #b1000000101 #b010001)))
(assert (fp.leq (fp #b1 #b1000000101 #b010001)
                arg2
                (fp #b0 #b1011111110 #b110110)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101011001 #b000110)
                expect
                (fp #b0 #b0100000011 #b010001)))
(assert (fp.leq (fp #b0 #b0100000011 #b010001)
                expect
                (fp #b0 #b1010100100 #b001111)))

(assert (not (= expect result)))

(check-sat)
(exit)
