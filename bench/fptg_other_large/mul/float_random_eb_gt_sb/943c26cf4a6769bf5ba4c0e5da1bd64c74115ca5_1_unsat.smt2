(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0010111001100100 #b1000001)
                arg1
                (fp #b1 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000)
                arg1
                (fp #b0 #b0100100010000011 #b0100001)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0011010000011110 #b1000100)
                arg2
                (fp #b0 #b0000000000000001 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000000001 #b0000000)
                arg2
                (fp #b0 #b0000110110100100 #b1111011)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111001001101010 #b0110111)
                expect
                (fp #b1 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000)
                expect
                (fp #b0 #b1101111000010011 #b1100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
