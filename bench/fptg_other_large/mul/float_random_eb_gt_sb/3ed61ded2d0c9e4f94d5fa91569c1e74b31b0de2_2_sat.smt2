                (fp #b0 #b0000000000000 #b111111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b111111)
                arg2
                (fp #b0 #b0101000001011 #b100101)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1101111111011 #b111011)
                expect
                (fp #b0 #b0000000000101 #b010111)))
(assert (fp.leq (fp #b0 #b0000000000101 #b010111)
                expect
                (fp #b0 #b1110000101000 #b011101)))

(assert (= expect result))

(check-sat)
