(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111001101110 #b01)
                arg1
                (fp #b1 #b0000000000001 #b00)))
(assert (fp.leq (fp #b1 #b0000000000001 #b00)
                arg1
                (fp #b0 #b0010101111000 #b10)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0110000011001 #b01)
                arg2
                (fp #b0 #b0110000111001 #b10)))
(assert (fp.leq (fp #b0 #b0110000111001 #b10)
                arg2
                (fp #b0 #b0111101000100 #b01)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1110001010011 #b11)
                expect
                (fp #b1 #b0000000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00)
                expect
                (fp #b0 #b0000100000110 #b10)))

(assert (= expect result))

(check-sat)
(exit)
