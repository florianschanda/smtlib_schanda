(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1000101010001100 #b0101011010)
                arg1
                (fp #b1 #b1000000000001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b1000000000001000 #b1101001010)
                arg1
                (fp #b1 #b0101011101110100 #b0011111100)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1011101100100111 #b1100110100)
                expect
                (fp #b0 #b1000000000010010 #b1010100101)))
(assert (fp.leq (fp #b0 #b1000000000010010 #b1010100101)
                expect
                (fp #b0 #b1001100101110101 #b0111100001)))

(assert (= expect result))

(check-sat)
(exit)
