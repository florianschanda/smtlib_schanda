(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1011011100100011 #b00010)
                arg1
                (fp #b0 #b0000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000)
                arg1
                (fp #b0 #b0110100000100010 #b11111)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0101101100000000 #b10110)
                arg2
                (fp #b1 #b0011111111111101 #b01101)))
(assert (fp.leq (fp #b1 #b0011111111111101 #b01101)
                arg2
                (fp #b0 #b1011100100001000 #b00000)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1100010011000010 #b11010)
                expect
                (fp #b1 #b0000000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000)
                expect
                (fp #b0 #b0001011010101000 #b10011)))

(assert (not (= expect result)))

(check-sat)
(exit)
