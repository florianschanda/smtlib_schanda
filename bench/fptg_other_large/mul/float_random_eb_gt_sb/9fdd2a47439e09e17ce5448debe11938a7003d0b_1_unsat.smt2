(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10111111011 #b00111)
                arg1
                (fp #b1 #b10000000100 #b10101)))
(assert (fp.leq (fp #b1 #b10000000100 #b10101)
                arg1
                (fp #b0 #b00011100100 #b01101)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111110 #b01000)
                arg2
                (fp #b1 #b11111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000)
                arg2
                (fp #b1 #b01000010100 #b01100)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11001000111 #b01000)
                expect
                (fp #b0 #b11111111110 #b11111)))
(assert (fp.leq (fp #b0 #b11111111110 #b11111)
                expect
                (fp #b0 #b11111111111 #b00000)))

(assert (not (= expect result)))

(check-sat)
(exit)
