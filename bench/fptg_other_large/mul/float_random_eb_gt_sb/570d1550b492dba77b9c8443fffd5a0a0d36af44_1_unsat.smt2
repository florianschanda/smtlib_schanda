                arg2
                (fp #b0 #b111111111111111111 #b0)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0)
                expect
                (fp #b1 #b111111111111111110 #b1)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1)
                expect
                (fp #b1 #b011100101111101100 #b1)))

(assert (not (= expect result)))

(check-sat)
