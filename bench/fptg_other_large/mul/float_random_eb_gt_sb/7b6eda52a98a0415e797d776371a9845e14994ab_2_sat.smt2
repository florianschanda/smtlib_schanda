; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1001011110010000 #b01110111011111)
                arg1
                (fp #b0 #b1001111011111000 #b10000010010100)))
(assert (fp.leq (fp #b0 #b1001111011111000 #b10000010010100)
                arg1
                (fp #b0 #b1101111110011101 #b11000011100000)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1001011110011011 #b00110111000100)
                arg2
                (fp #b0 #b0000000000000000 #b00011110110011)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00011110110011)
                arg2
                (fp #b0 #b1100000001000011 #b00110110000111)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0010110010011100 #b01001111111011)
                expect
                (fp #b0 #b0001111011110111 #b01110011110011)))
(assert (fp.leq (fp #b0 #b0001111011110111 #b01110011110011)
                expect
                (fp #b0 #b1100111111101011 #b10010001000110)))

(assert (= expect result))

(check-sat)
(exit)
