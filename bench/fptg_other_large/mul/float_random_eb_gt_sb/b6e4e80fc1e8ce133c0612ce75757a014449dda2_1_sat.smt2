; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b00111100101000 #b0010111)
                arg1
                (fp #b0 #b00000000000000 #b0000001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000001)
                arg1
                (fp #b0 #b01001011101101 #b0011111)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01011110000111 #b0010011)
                arg2
                (fp #b1 #b00000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000)
                arg2
                (fp #b0 #b10100101001010 #b0011101)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10001001111010 #b0110000)
                expect
                (fp #b1 #b00000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000)
                expect
                (fp #b0 #b10010011001101 #b1001100)))

(assert (= expect result))

(check-sat)
(exit)
