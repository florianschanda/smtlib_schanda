(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 12))
(assert (fp.leq (fp #b0 #b001100100110011100 #b00011100000)
                arg1
                (fp #b0 #b111111100111110110 #b00110100101)))
(assert (fp.leq (fp #b0 #b111111100111110110 #b00110100101)
                arg1
                (fp #b0 #b111111111101011010 #b10101010111)))

(declare-const arg2 (_ FloatingPoint 18 12))
(assert (fp.leq (fp #b1 #b111010000110110001 #b01010111010)
                arg2
                (fp #b1 #b100100001001110001 #b00111001101)))
(assert (fp.leq (fp #b1 #b100100001001110001 #b00111001101)
                arg2
                (fp #b1 #b000111011101001000 #b11110101100)))

(declare-const result (_ FloatingPoint 18 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
