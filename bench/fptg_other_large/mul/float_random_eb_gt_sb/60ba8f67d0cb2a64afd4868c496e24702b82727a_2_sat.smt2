(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1011101010011 #b001011110)
                arg1
                (fp #b1 #b1000000001000 #b011100001)))
(assert (fp.leq (fp #b1 #b1000000001000 #b011100001)
                arg1
                (fp #b1 #b0001011100000 #b101001010)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1100111110101 #b110101010)
                arg2
                (fp #b1 #b1000100000011 #b111110101)))
(assert (fp.leq (fp #b1 #b1000100000011 #b111110101)
                arg2
                (fp #b1 #b0000111101010 #b000101111)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0011011101011 #b001100011)
                expect
                (fp #b0 #b1000100001101 #b011011010)))
(assert (fp.leq (fp #b0 #b1000100001101 #b011011010)
                expect
                (fp #b0 #b1011010010001 #b010100011)))

(assert (= expect result))

(check-sat)
(exit)
