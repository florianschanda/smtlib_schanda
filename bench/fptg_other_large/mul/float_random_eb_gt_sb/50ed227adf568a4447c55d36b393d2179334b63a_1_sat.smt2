;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b0 #b0101101001101111 #b00000001110001)
                arg1
                (fp #b0 #b1010011010011111 #b10010110011101)))
(assert (fp.leq (fp #b0 #b1010011010011111 #b10010110011101)
                arg1
