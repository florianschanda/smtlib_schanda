                arg2
                (fp #b1 #b1000000000001100 #b01110100100110)))
(assert (fp.leq (fp #b1 #b1000000000001100 #b01110100100110)
                arg2
                (fp #b0 #b1101001000011101 #b10000100001111)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1011101110110101 #b00101111000100)
                expect
                (fp #b1 #b1010011010101101 #b00100111110010)))
(assert (fp.leq (fp #b1 #b1010011010101101 #b00100111110010)
                expect
                (fp #b0 #b0010000001101000 #b10010010110011)))

(assert (= expect result))

(check-sat)
(exit)
