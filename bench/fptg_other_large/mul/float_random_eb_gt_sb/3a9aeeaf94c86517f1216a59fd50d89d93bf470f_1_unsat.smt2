; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b010000010100 #b0011110)
                arg1
                (fp #b0 #b111001011100 #b0010000)))
(assert (fp.leq (fp #b0 #b111001011100 #b0010000)
                arg1
                (fp #b0 #b111100010000 #b0111110)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b001010000100 #b1111001)
                arg2
                (fp #b1 #b000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b0000000)
                arg2
                (fp #b0 #b001001011100 #b0100101)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110110010010 #b1110010)
                expect
                (fp #b1 #b011001011110 #b0010000)))
(assert (fp.leq (fp #b1 #b011001011110 #b0010000)
                expect
                (fp #b1 #b010011110110 #b0111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
