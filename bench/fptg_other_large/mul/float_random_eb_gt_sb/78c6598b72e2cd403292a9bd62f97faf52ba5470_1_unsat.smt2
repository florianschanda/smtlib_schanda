; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b0001001001101001 #b010010001111)
                arg1
                (fp #b0 #b0000000000000000 #b111111111111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111111111111)
                arg1
                (fp #b0 #b0111001110110101 #b001101111111)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1000011100011101 #b111111001011)
                arg2
                (fp #b0 #b1111111111111110 #b111111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000000)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b0 #b0001010101111010 #b101110101000)
                expect
                (fp #b0 #b1000000000000000 #b111111111101)))
(assert (fp.leq (fp #b0 #b1000000000000000 #b111111111101)
                expect
                (fp #b0 #b1010101101010011 #b100001100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
