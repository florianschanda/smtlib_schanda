(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111111111111 #b00)
                arg1
                (fp #b1 #b11111111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11)
                arg1
                (fp #b0 #b11010001000101 #b10)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11010111110001 #b00)
                arg2
                (fp #b1 #b01111001100111 #b10)))
(assert (fp.leq (fp #b1 #b01111001100111 #b10)
                arg2
                (fp #b0 #b00111010010111 #b01)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10010010011001 #b01)
                expect
                (fp #b0 #b11111001100111 #b10)))
(assert (fp.leq (fp #b0 #b11111001100111 #b10)
                expect
                (fp #b0 #b11111100100001 #b10)))

(assert (= expect result))

(check-sat)
(exit)
