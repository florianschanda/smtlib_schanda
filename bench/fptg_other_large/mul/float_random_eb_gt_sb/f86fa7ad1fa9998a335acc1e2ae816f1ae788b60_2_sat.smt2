(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1101110110000 #b10111101111)
                arg1
                (fp #b1 #b0010010010110 #b11100011010)))
(assert (fp.leq (fp #b1 #b0010010010110 #b11100011010)
                arg1
                (fp #b0 #b0010001000000 #b00000100101)))

(declare-const arg2 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1110101111111 #b01001000010)
                arg2
                (fp #b1 #b0000000000000 #b01000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b01000000000)
                arg2
                (fp #b0 #b1110011100010 #b01110111011)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1000010101100 #b00111000101)
                expect
                (fp #b0 #b0000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000000001)
                expect
                (fp #b0 #b1001010100000 #b11101000010)))

(assert (= expect result))

(check-sat)
(exit)
