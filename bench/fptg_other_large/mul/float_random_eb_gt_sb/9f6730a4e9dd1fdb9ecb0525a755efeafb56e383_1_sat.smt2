(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1100101011110 #b000)
                arg1
                (fp #b1 #b1011111111110 #b111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b111)
                arg1
                (fp #b0 #b1100100000001 #b101)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0110110110100 #b110)
                arg2
                (fp #b0 #b1111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b000)
                arg2
                (fp #b0 #b1111111111101 #b110)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111111111111 #b000)
                expect
                (fp #b1 #b1111111111110 #b111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b111)
                expect
                (fp #b1 #b1000001101101 #b000)))

(assert (= expect result))

(check-sat)
(exit)
