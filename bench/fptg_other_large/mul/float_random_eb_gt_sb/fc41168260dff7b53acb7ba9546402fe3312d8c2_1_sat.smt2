; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11011000011011 #b000110110)
                arg1
                (fp #b0 #b00111111111011 #b011010100)))
(assert (fp.leq (fp #b0 #b00111111111011 #b011010100)
                arg1
                (fp #b0 #b01100010000000 #b000101111)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10101100000101 #b011111010)
                arg2
                (fp #b1 #b01000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b01000000000000 #b000000000)
                arg2
                (fp #b0 #b10101011000011 #b011100001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00011011101100 #b100100110)
                expect
                (fp #b1 #b00000000000000 #b000010110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b000010110)
                expect
                (fp #b0 #b00111000110100 #b011100011)))

(assert (= expect result))

(check-sat)
(exit)
