(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01001100101 #b110)
                arg1
                (fp #b0 #b10000101111 #b111)))
(assert (fp.leq (fp #b0 #b10000101111 #b111)
                arg1
                (fp #b0 #b10110010010 #b000)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10000011110 #b001)
                arg2
                (fp #b0 #b10000000000 #b100)))
(assert (fp.leq (fp #b0 #b10000000000 #b100)
                arg2
                (fp #b0 #b10101111010 #b000)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b00010100010 #b111)
                expect
                (fp #b0 #b10000110001 #b100)))
(assert (fp.leq (fp #b0 #b10000110001 #b100)
                expect
                (fp #b0 #b10100010101 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
