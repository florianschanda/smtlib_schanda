; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1000100111 #b001100)
                arg1
                (fp #b1 #b0111001110 #b000010)))
(assert (fp.leq (fp #b1 #b0111001110 #b000010)
                arg1
                (fp #b0 #b0001110100 #b000110)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0110111100 #b100001)
                arg2
                (fp #b0 #b1000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000110 #b000000)
                arg2
                (fp #b0 #b1000111111 #b100110)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111101101 #b011110)
                expect
                (fp #b1 #b0111010101 #b000010)))
(assert (fp.leq (fp #b1 #b0111010101 #b000010)
                expect
                (fp #b0 #b1011010000 #b111011)))

(assert (= expect result))

(check-sat)
(exit)
