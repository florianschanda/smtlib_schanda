(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01011111010 #b11110)
                arg1
                (fp #b1 #b00111111101 #b01101)))
(assert (fp.leq (fp #b1 #b00111111101 #b01101)
                arg1
                (fp #b1 #b00001110001 #b01000)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01001010000 #b00010)
                arg2
                (fp #b1 #b00100000011 #b11010)))
(assert (fp.leq (fp #b1 #b00100000011 #b11010)
                arg2
                (fp #b0 #b01010111000 #b10000)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111101010 #b01000)
                expect
                (fp #b0 #b00000000000 #b00001)))
(assert (fp.leq (fp #b0 #b00000000000 #b00001)
                expect
                (fp #b0 #b10010001110 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
