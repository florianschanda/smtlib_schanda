; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111111111111110 #b01100100001)
                arg1
                (fp #b1 #b1111111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b00000000000)
                arg1
                (fp #b1 #b1000111101000000 #b01000111110)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1010011110010000 #b11111011110)
                arg2
                (fp #b0 #b1011111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b1011111111111110 #b11111111111)
                arg2
                (fp #b0 #b1100101011011110 #b10101011110)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000000000)
                expect
                (fp #b1 #b1111111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111111111)
                expect
                (fp #b1 #b1111011100010110 #b11110000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
