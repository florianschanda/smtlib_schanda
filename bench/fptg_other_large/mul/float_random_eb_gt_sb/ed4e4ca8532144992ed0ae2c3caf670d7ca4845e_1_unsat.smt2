(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010001111010 #b010)
                arg1
                (fp #b0 #b010000000000 #b000)))
(assert (fp.leq (fp #b0 #b010000000000 #b000)
                arg1
                (fp #b0 #b100100101111 #b000)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011111100011 #b011)
                arg2
                (fp #b0 #b000000000000 #b011)))
(assert (fp.leq (fp #b0 #b000000000000 #b011)
                arg2
                (fp #b0 #b111111000110 #b100)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010011000101 #b000)
                expect
                (fp #b0 #b000000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000)
                expect
                (fp #b0 #b100000010000 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
