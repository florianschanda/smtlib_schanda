(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0111010011011 #b11111000)
                arg1
                (fp #b1 #b0000000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00010010)
                arg1
                (fp #b0 #b0101100011101 #b00000010)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1010100100001 #b00001000)
                expect
                (fp #b0 #b0000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000001)
                expect
                (fp #b0 #b1011101000011 #b00010101)))

(assert (not (= expect result)))

(check-sat)
(exit)
