(assert (fp.leq (fp #b1 #b000000000000000000 #b0011111001000)
                arg2
                (fp #b0 #b011000011110111111 #b1101000001100)))

(declare-const result (_ FloatingPoint 18 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b010010001010111111 #b0011000000011)
                expect
                (fp #b0 #b000000000000000000 #b0000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0000000000001)
                expect
                (fp #b0 #b001000010100110001 #b1101100101111)))

(assert (not (= expect result)))

(check-sat)
