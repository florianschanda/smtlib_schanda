(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1101100111 #b10000100)
                arg1
                (fp #b1 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000000)
                arg1
                (fp #b0 #b1001100010 #b11101000)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111110111 #b00001110)
                arg2
                (fp #b1 #b0111111111 #b10011100)))
(assert (fp.leq (fp #b1 #b0111111111 #b10011100)
                arg2
                (fp #b0 #b1010010010 #b10101000)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1001001110 #b10111010)
                expect
                (fp #b0 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000000)
                expect
                (fp #b0 #b1100101110 #b01111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
