; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00110110110 #b000010010)
                arg1
                (fp #b0 #b00000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000001)
                arg1
                (fp #b0 #b01010000100 #b101100011)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111111111 #b000000000)
                arg2
                (fp #b1 #b11111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b111111111)
                arg2
                (fp #b0 #b00001000100 #b010101101)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11101101100 #b110010010)
                expect
                (fp #b1 #b01111110111 #b111111111)))
(assert (fp.leq (fp #b1 #b01111110111 #b111111111)
                expect
                (fp #b1 #b01101001101 #b000000011)))

(assert (= expect result))

(check-sat)
(exit)
