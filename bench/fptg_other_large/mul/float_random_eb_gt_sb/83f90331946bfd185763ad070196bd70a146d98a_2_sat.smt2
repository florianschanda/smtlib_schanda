; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111101011001 #b1000000110)
                arg1
                (fp #b1 #b101111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b101111111110 #b1111111111)
                arg1
                (fp #b1 #b011000001010 #b1101110011)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b001100011101 #b1111000110)
                arg2
                (fp #b0 #b011111111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b011111111111 #b0010110101)
                arg2
                (fp #b0 #b101100010001 #b1101110101)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110001100000 #b1111100010)
                expect
                (fp #b1 #b101111111111 #b0010110101)))
(assert (fp.leq (fp #b1 #b101111111111 #b0010110101)
                expect
                (fp #b0 #b000100101010 #b1110001111)))

(assert (= expect result))

(check-sat)
(exit)
