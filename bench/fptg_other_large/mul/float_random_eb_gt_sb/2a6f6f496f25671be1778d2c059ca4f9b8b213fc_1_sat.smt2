; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111111111110 #b0010)
                arg1
                (fp #b1 #b11111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000)
                arg1
                (fp #b1 #b11101101001110 #b1101)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00110010111000 #b1010)
                arg2
                (fp #b0 #b00000000000000 #b1110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1110)
                arg2
                (fp #b0 #b00011101101110 #b1010)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10000101100100 #b0101)
                expect
                (fp #b1 #b01111111111110 #b1100)))
(assert (fp.leq (fp #b1 #b01111111111110 #b1100)
                expect
                (fp #b0 #b01101000010000 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
