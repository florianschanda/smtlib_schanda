; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 13))
(assert (fp.leq (fp #b1 #b001010111100110001 #b111001001100)
                arg1
                (fp #b0 #b100000000000001011 #b010101111110)))
(assert (fp.leq (fp #b0 #b100000000000001011 #b010101111110)
                arg1
                (fp #b0 #b100110001010100100 #b000111011100)))

(declare-const arg2 (_ FloatingPoint 18 13))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 18 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 13))
(assert (fp.leq (fp #b1 #b111111111100100000 #b010010101110)
                expect
                (fp #b1 #b100000000000010111 #b110011011110)))
(assert (fp.leq (fp #b1 #b100000000000010111 #b110011011110)
                expect
                (fp #b0 #b010100110100111000 #b011110001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
