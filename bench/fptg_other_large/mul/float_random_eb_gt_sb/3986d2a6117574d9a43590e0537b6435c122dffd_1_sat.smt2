; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110010011011 #b00100000)
                arg1
                (fp #b1 #b110000111101 #b10101101)))
(assert (fp.leq (fp #b1 #b110000111101 #b10101101)
                arg1
                (fp #b0 #b001010000000 #b10001111)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100001000111 #b11000111)
                arg2
                (fp #b1 #b100000000111 #b10010100)))
(assert (fp.leq (fp #b1 #b100000000111 #b10010100)
                arg2
                (fp #b0 #b110010010110 #b01011001)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001000100101 #b11111101)
                expect
                (fp #b0 #b110001000110 #b01010010)))
(assert (fp.leq (fp #b0 #b110001000110 #b01010010)
                expect
                (fp #b0 #b111000001000 #b00000111)))

(assert (= expect result))

(check-sat)
(exit)
