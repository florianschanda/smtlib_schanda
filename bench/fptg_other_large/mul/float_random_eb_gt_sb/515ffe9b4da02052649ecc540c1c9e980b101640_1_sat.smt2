(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b001010101111000 #b01111001000)
                arg1
                (fp #b0 #b000000000000000 #b11111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111111111)
                arg1
                (fp #b0 #b011010010111001 #b11100011111)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b010100110101111 #b01101101011)
                arg2
                (fp #b0 #b011000010010011 #b11101010101)))
(assert (fp.leq (fp #b0 #b011000010010011 #b11101010101)
                arg2
                (fp #b0 #b100111111010111 #b10110111011)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000001110111000 #b00001000101)
                expect
                (fp #b0 #b000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000)
                expect
                (fp #b0 #b010101110011000 #b10110001010)))

(assert (= expect result))

(check-sat)
(exit)
