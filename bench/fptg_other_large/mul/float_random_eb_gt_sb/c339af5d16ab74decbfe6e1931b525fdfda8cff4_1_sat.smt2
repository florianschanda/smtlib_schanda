(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1000001110001 #b1101100)
                arg1
                (fp #b0 #b0001000110001 #b1010011)))
(assert (fp.leq (fp #b0 #b0001000110001 #b1010011)
                arg1
                (fp #b0 #b0111110101001 #b0111010)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
