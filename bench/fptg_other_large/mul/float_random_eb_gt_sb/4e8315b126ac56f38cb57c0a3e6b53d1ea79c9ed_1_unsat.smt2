(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010010010 #b1001110)
                arg1
                (fp #b1 #b001111100 #b0110101)))
(assert (fp.leq (fp #b1 #b001111100 #b0110101)
                arg1
                (fp #b0 #b011001110 #b0100001)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101000101 #b1010010)
                arg2
                (fp #b1 #b000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000001 #b0000000)
                arg2
                (fp #b0 #b001100000 #b0111100)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111000001 #b1010110)
                expect
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                expect
                (fp #b0 #b011010111 #b0010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
