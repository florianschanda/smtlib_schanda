(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111101001101 #b10110)
                arg1
                (fp #b1 #b011111111111 #b10110)))
(assert (fp.leq (fp #b1 #b011111111111 #b10110)
                arg1
                (fp #b0 #b000000011111 #b01000)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b010010111110 #b10111)
                arg2
                (fp #b1 #b001111111101 #b01101)))
(assert (fp.leq (fp #b1 #b001111111101 #b01101)
                arg2
                (fp #b0 #b000100101110 #b11101)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b000001110100 #b00010)
                expect
                (fp #b0 #b001111111110 #b00110)))
(assert (fp.leq (fp #b0 #b001111111110 #b00110)
                expect
                (fp #b0 #b110011010111 #b10111)))

(assert (not (= expect result)))

(check-sat)
(exit)
