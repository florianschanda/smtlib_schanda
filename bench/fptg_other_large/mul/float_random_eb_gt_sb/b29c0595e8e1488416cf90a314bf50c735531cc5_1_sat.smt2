                (fp #b1 #b1000001101100 #b10000101)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1111111110100 #b11101110)
                arg2
                (fp #b1 #b1111110111100 #b00010001)))
(assert (fp.leq (fp #b1 #b1111110111100 #b00010001)
                arg2
                (fp #b1 #b1101001001101 #b10011010)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b0 #b0010110101010 #b01110011)
                expect
                (fp #b0 #b1111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11111111)
                expect
                (fp #b0 #b1111111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
