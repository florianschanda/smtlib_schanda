(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11100000000 #b00011)
                arg1
                (fp #b0 #b00111111101 #b01101)))
(assert (fp.leq (fp #b0 #b00111111101 #b01101)
                arg1
                (fp #b0 #b01001110001 #b01001)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11001011011 #b01011)
                arg2
                (fp #b1 #b00000000000 #b11111)))
(assert (fp.leq (fp #b1 #b00000000000 #b11111)
                arg2
                (fp #b0 #b01101110110 #b01110)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10010010001 #b10011)
                expect
                (fp #b1 #b00000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000)
                expect
                (fp #b0 #b10111100110 #b01000)))

(assert (= expect result))

(check-sat)
(exit)
