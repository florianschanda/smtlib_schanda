                arg2
                (fp #b0 #b0111111111111111 #b0000000)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b0000000)
                arg2
                (fp #b0 #b1101111001001111 #b0110111)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0011100001011101 #b1010101)
                expect
                (fp #b1 #b0000000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0100000)
                expect
                (fp #b0 #b1101100101100000 #b1110000)))

(assert (= expect result))

(check-sat)
(exit)
