(assert (fp.leq (fp #b0 #b1100011001000011 #b01101011110)
                arg2
                (fp #b0 #b1101111001010100 #b11001101001)))
(assert (fp.leq (fp #b0 #b1101111001010100 #b11001101001)
                arg2
                (fp #b0 #b1110101101111010 #b11011111011)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0110010101000001 #b01001111010)
                expect
                (fp #b1 #b0101111001010110 #b00011000100)))
(assert (fp.leq (fp #b1 #b0101111001010110 #b00011000100)
                expect
                (fp #b0 #b1011110001111001 #b00011101010)))

(assert (= expect result))

(check-sat)
(exit)
