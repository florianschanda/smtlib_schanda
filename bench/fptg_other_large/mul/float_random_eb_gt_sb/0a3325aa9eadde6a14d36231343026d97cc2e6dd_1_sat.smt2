;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0011011001110001 #b01001000010)
