(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110001001 #b1101000)
                arg1
                (fp #b1 #b011111111 #b0100111)))
(assert (fp.leq (fp #b1 #b011111111 #b0100111)
                arg1
                (fp #b0 #b010111000 #b0101110)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b001011011 #b0101000)
                arg2
                (fp #b0 #b011110001 #b1010100)))
(assert (fp.leq (fp #b0 #b011110001 #b1010100)
                arg2
                (fp #b0 #b110011010 #b1011011)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b110010100 #b1110110)
                expect
                (fp #b1 #b011110010 #b0001011)))
(assert (fp.leq (fp #b1 #b011110010 #b0001011)
                expect
                (fp #b0 #b110000011 #b0011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
