(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b00011100001110 #b01)
                arg1
                (fp #b0 #b00000000000000 #b10)))
(assert (fp.leq (fp #b0 #b00000000000000 #b10)
                arg1
                (fp #b0 #b01101001001011 #b00)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11111001010100 #b00)
                arg2
                (fp #b0 #b00000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01)
                arg2
                (fp #b0 #b10010110110010 #b10)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10000100011001 #b10)
                expect
                (fp #b0 #b00000000000000 #b00)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00)
                expect
                (fp #b0 #b11110000010111 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
