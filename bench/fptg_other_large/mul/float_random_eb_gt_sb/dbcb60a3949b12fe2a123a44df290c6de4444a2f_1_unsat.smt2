(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110110111010111 #b011)
                arg1
                (fp #b1 #b000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000000 #b010)
                arg1
                (fp #b0 #b011110101010100 #b110)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b011101110110011 #b110)
                arg2
                (fp #b0 #b001011000110111 #b101)))
(assert (fp.leq (fp #b0 #b001011000110111 #b101)
                arg2
                (fp #b0 #b011101000011001 #b011)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101101001000001 #b110)
                expect
                (fp #b1 #b000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b000)
                expect
                (fp #b0 #b001100110001110 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
