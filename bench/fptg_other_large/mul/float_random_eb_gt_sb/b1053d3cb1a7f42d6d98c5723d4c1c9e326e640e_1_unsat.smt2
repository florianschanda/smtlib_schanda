; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000001101 #b0111)
                arg1
                (fp #b0 #b100000011 #b0110)))
(assert (fp.leq (fp #b0 #b100000011 #b0110)
                arg1
                (fp #b0 #b100010111 #b1101)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100110110 #b1011)
                arg2
                (fp #b1 #b100000011 #b0001)))
(assert (fp.leq (fp #b1 #b100000011 #b0001)
                arg2
                (fp #b0 #b101000110 #b0000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111101010 #b1111)
                expect
                (fp #b1 #b100000111 #b0111)))
(assert (fp.leq (fp #b1 #b100000111 #b0111)
                expect
                (fp #b0 #b011111001 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
