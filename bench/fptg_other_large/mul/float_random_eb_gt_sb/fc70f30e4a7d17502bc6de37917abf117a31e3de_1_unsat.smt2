(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b10011001010 #b1100)
                arg1
                (fp #b0 #b11111111110 #b1111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111)
                arg1
                (fp #b0 #b11111111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10001010001 #b0100)
                arg2
                (fp #b1 #b10000000011 #b1110)))
(assert (fp.leq (fp #b1 #b10000000011 #b1110)
                arg2
                (fp #b0 #b10101101101 #b0110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111111 #b0000)
                expect
                (fp #b1 #b11111111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111)
                expect
                (fp #b1 #b00001110000 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
