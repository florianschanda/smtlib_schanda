(assert (fp.leq (fp #b0 #b10111111111110 #b1)
                arg2
                (fp #b0 #b11111000100100 #b0)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b10011111101111 #b1)
                expect
                (fp #b0 #b00111111111111 #b1)))
(assert (fp.leq (fp #b0 #b00111111111111 #b1)
                expect
                (fp #b0 #b11010011000101 #b0)))

(assert (= expect result))

(check-sat)
(exit)
