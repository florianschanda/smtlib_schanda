(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011101101 #b001111)
                arg1
                (fp #b0 #b000000000 #b111111)))
(assert (fp.leq (fp #b0 #b000000000 #b111111)
                arg1
                (fp #b0 #b111111010 #b101111)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b010011000 #b001111)
                arg2
                (fp #b1 #b000000000 #b010000)))
(assert (fp.leq (fp #b1 #b000000000 #b010000)
                arg2
                (fp #b0 #b000011100 #b001000)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b111111110 #b110010)
                expect
                (fp #b1 #b000000000 #b000000)))
(assert (fp.leq (fp #b1 #b000000000 #b000000)
                expect
                (fp #b0 #b101100100 #b001110)))

(assert (= expect result))

(check-sat)
(exit)
