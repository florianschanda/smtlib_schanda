(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01001011100 #b1)
                arg1
                (fp #b0 #b10000000000 #b1)))
(assert (fp.leq (fp #b0 #b10000000000 #b1)
                arg1
                (fp #b0 #b11111101001 #b0)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10010011001 #b0)
                expect
                (fp #b1 #b10000000010 #b0)))
(assert (fp.leq (fp #b1 #b10000000010 #b0)
                expect
                (fp #b0 #b01101101000 #b0)))

(assert (= expect result))

(check-sat)
(exit)
