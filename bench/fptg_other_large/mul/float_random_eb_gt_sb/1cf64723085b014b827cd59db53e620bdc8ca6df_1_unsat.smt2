(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b001010100001100 #b110)
                arg1
                (fp #b1 #b000000000000001 #b000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b000)
                arg1
                (fp #b0 #b100011101001100 #b100)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b100111011111010 #b101)
                arg2
                (fp #b0 #b000000000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000)
                arg2
                (fp #b0 #b010000110000001 #b101)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b101010100011101 #b110)
                expect
                (fp #b1 #b000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b000)
                expect
                (fp #b0 #b100100101001100 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
