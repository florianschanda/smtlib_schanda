(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b011010000001101 #b001)
                arg1
                (fp #b1 #b000000000000000 #b111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b111)
                arg1
                (fp #b0 #b111101111100101 #b001)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100001000100000 #b110)
                arg2
                (fp #b1 #b000000000000000 #b101)))
(assert (fp.leq (fp #b1 #b000000000000000 #b101)
                arg2
                (fp #b0 #b100010001111001 #b101)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b001010001100101 #b100)
                expect
                (fp #b0 #b000000000000000 #b001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b001)
                expect
                (fp #b0 #b100000001101101 #b100)))

(assert (= expect result))

(check-sat)
(exit)
