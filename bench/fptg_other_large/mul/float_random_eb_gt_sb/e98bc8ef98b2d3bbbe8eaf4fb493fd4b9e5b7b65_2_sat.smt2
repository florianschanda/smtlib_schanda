(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110001000 #b10000)
                arg1
                (fp #b0 #b000000001 #b00000)))
(assert (fp.leq (fp #b0 #b000000001 #b00000)
                arg1
                (fp #b0 #b111011011 #b10111)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b001000010 #b01011)
                arg2
                (fp #b0 #b000000001 #b00000)))
(assert (fp.leq (fp #b0 #b000000001 #b00000)
                arg2
                (fp #b0 #b001010001 #b10010)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b001001111 #b11010)
                expect
                (fp #b0 #b000000000 #b00001)))
(assert (fp.leq (fp #b0 #b000000000 #b00001)
                expect
                (fp #b0 #b011001000 #b10010)))

(assert (= expect result))

(check-sat)
(exit)
