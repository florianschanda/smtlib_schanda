(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11111101001 #b1100011)
                arg1
                (fp #b1 #b00111111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111111100 #b0110101)
                arg1
                (fp #b0 #b01111001101 #b1001001)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11101111011 #b0101101)
                arg2
                (fp #b1 #b00110011111 #b1100110)))
(assert (fp.leq (fp #b1 #b00110011111 #b1100110)
                arg2
                (fp #b0 #b00110100011 #b1001001)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b00100000101 #b0101010)
                expect
                (fp #b0 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000)
                expect
                (fp #b0 #b00011010111 #b1111000)))

(assert (= expect result))

(check-sat)
(exit)
