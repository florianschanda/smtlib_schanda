(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111100110111001 #b100000)
                arg1
                (fp #b0 #b101111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b101111111111110 #b111111)
                arg1
                (fp #b0 #b110001001010001 #b101011)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b0 #b100110100101001 #b010011)
                arg2
                (fp #b0 #b111111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b111111)
                arg2
                (fp #b0 #b111111111111111 #b000000)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
