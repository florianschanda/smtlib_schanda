; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b0 #b001001000000011000 #b0011010001101)
                arg1
                (fp #b0 #b010001010000100100 #b0000100101100)))
(assert (fp.leq (fp #b0 #b010001010000100100 #b0000100101100)
                arg1
                (fp #b0 #b100001011101111101 #b0101111111101)))

(declare-const arg2 (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b001110010101110000 #b1110101110110)
                arg2
                (fp #b0 #b101111111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b101111111111111110 #b1111111111111)
                arg2
                (fp #b0 #b110011101011001110 #b0010100011000)))

(declare-const result (_ FloatingPoint 18 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b011001011110011011 #b1010110000001)
                expect
                (fp #b0 #b100001010000100100 #b0000100101011)))
(assert (fp.leq (fp #b0 #b100001010000100100 #b0000100101011)
                expect
                (fp #b0 #b101101011011110100 #b1100100001000)))

(assert (= expect result))

(check-sat)
(exit)
