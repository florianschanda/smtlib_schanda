(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b011110011 #b010000)
                arg1
                (fp #b0 #b100110110 #b111011)))
(assert (fp.leq (fp #b0 #b100110110 #b111011)
                arg1
                (fp #b0 #b110011000 #b000011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b001100001 #b100101)
                arg2
                (fp #b0 #b010101111 #b111110)))
(assert (fp.leq (fp #b0 #b010101111 #b111110)
                arg2
                (fp #b0 #b011010011 #b000001)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b000110011 #b001000)
                expect
                (fp #b0 #b011100111 #b111010)))
(assert (fp.leq (fp #b0 #b011100111 #b111010)
                expect
                (fp #b0 #b011111000 #b000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
