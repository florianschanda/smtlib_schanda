(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1100111001 #b1)
                arg1
                (fp #b0 #b1010001000 #b0)))
(assert (fp.leq (fp #b0 #b1010001000 #b0)
                arg1
                (fp #b0 #b1111001000 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b1000100011 #b0)
                expect
                (fp #b0 #b1100010001 #b0)))
(assert (fp.leq (fp #b0 #b1100010001 #b0)
                expect
                (fp #b0 #b1111111100 #b0)))

(assert (= expect result))

(check-sat)
(exit)
