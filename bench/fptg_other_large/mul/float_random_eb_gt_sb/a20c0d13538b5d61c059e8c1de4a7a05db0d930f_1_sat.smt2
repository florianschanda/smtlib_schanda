(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1100111001111101 #b101110)
                arg1
                (fp #b1 #b0100101010111001 #b101110)))
(assert (fp.leq (fp #b1 #b0100101010111001 #b101110)
                arg1
                (fp #b0 #b1100010110101111 #b001111)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0101100010101101 #b101111)
                arg2
                (fp #b1 #b0000000000000000 #b010000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010000)
                arg2
                (fp #b0 #b1001111010101101 #b101001)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0011101100011011 #b011100)
                expect
                (fp #b0 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000)
                expect
                (fp #b0 #b0001010001100111 #b101111)))

(assert (= expect result))

(check-sat)
(exit)
