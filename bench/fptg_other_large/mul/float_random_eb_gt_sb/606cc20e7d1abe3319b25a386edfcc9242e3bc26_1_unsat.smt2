(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b010101001 #b11)
                arg1
                (fp #b0 #b011010011 #b10)))
(assert (fp.leq (fp #b0 #b011010011 #b10)
                arg1
                (fp #b0 #b111001001 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110111001 #b11)
                arg2
                (fp #b1 #b011111111 #b11)))
(assert (fp.leq (fp #b1 #b011111111 #b11)
                arg2
                (fp #b0 #b110001011 #b11)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111010011 #b10)
                expect
                (fp #b1 #b011010100 #b01)))
(assert (fp.leq (fp #b1 #b011010100 #b01)
                expect
                (fp #b1 #b010111001 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
