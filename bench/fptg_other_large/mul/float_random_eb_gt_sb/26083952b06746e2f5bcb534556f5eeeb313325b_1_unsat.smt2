(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101101010011 #b0110101101)
                arg1
                (fp #b1 #b100010110011 #b1100100001)))
(assert (fp.leq (fp #b1 #b100010110011 #b1100100001)
                arg1
                (fp #b0 #b011111100011 #b1110011110)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101001110101 #b0110100110)
                expect
                (fp #b1 #b100101101000 #b1001011010)))
(assert (fp.leq (fp #b1 #b100101101000 #b1001011010)
                expect
                (fp #b1 #b010000000001 #b1001001011)))

(assert (not (= expect result)))

(check-sat)
(exit)
