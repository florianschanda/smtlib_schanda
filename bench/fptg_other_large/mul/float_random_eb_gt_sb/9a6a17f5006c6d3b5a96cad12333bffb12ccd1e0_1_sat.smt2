; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0001011001001 #b011)
                arg1
                (fp #b0 #b0000000000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000000000 #b110)
                arg1
                (fp #b0 #b0100111100000 #b010)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111011000110 #b100)
                arg2
                (fp #b1 #b1110100011010 #b111)))
(assert (fp.leq (fp #b1 #b1110100011010 #b111)
                arg2
                (fp #b0 #b1110000011000 #b010)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110101000010 #b011)
                expect
                (fp #b1 #b0110100011100 #b011)))
(assert (fp.leq (fp #b1 #b0110100011100 #b011)
                expect
                (fp #b1 #b0000111010101 #b001)))

(assert (= expect result))

(check-sat)
(exit)
