(assert (fp.leq (fp #b1 #b01000000000000 #b00)
                arg2
                (fp #b0 #b10100001101111 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10101110001011 #b10)
                expect
                (fp #b1 #b10101001100000 #b10)))
(assert (fp.leq (fp #b1 #b10101001100000 #b10)
                expect
                (fp #b0 #b11011000001101 #b11)))

(assert (not (= expect result)))

(check-sat)
