; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111011110011111010 #b100000101)
                arg1
                (fp #b1 #b101000101001101111 #b010010001)))
(assert (fp.leq (fp #b1 #b101000101001101111 #b010010001)
                arg1
                (fp #b1 #b010000000110010011 #b101111110)))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b101010011011011001 #b001101010)
                arg2
                (fp #b1 #b100000000000000111 #b001100100)))
(assert (fp.leq (fp #b1 #b100000000000000111 #b001100100)
                arg2
                (fp #b1 #b001101001100110111 #b000010101)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b000101110110001101 #b101011110)
                expect
                (fp #b0 #b101000101001110111 #b100010010)))
(assert (fp.leq (fp #b0 #b101000101001110111 #b100010010)
                expect
                (fp #b0 #b110001111001000100 #b110010110)))

(assert (= expect result))

(check-sat)
(exit)
