(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b010110110 #b10)
                arg1
                (fp #b0 #b000000000 #b11)))
(assert (fp.leq (fp #b0 #b000000000 #b11)
                arg1
                (fp #b0 #b110011110 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b010110010 #b01)
                arg2
                (fp #b0 #b000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000 #b10)
                arg2
                (fp #b0 #b000010011 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110110100 #b10)
                expect
                (fp #b0 #b000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000 #b00)
                expect
                (fp #b0 #b001001110 #b11)))

(assert (= expect result))

(check-sat)
(exit)
