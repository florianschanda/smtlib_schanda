(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1001001110 #b11)
                arg1
                (fp #b1 #b1000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000010 #b00)
                arg1
                (fp #b0 #b1110110101 #b01)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111100111 #b01)
                arg2
                (fp #b1 #b0001000100 #b01)))
(assert (fp.leq (fp #b1 #b0001000100 #b01)
                arg2
                (fp #b0 #b1000100111 #b10)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0011111010 #b01)
                expect
                (fp #b0 #b0001000111 #b01)))
(assert (fp.leq (fp #b0 #b0001000111 #b01)
                expect
                (fp #b0 #b0111010000 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
