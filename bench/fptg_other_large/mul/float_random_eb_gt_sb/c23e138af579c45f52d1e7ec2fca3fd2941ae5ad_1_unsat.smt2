(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10111001110011 #b00010110100)
                arg1
                (fp #b1 #b10101001000100 #b00011101100)))
(assert (fp.leq (fp #b1 #b10101001000100 #b00011101100)
                arg1
                (fp #b0 #b11010111010100 #b01101110101)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10100001101111 #b11100011110)
                arg2
                (fp #b1 #b10011011010110 #b01111111011)))
(assert (fp.leq (fp #b1 #b10011011010110 #b01111111011)
                arg2
                (fp #b0 #b00100010001101 #b11111100101)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b0 #b10011110111100 #b00100001010)
                expect
                (fp #b0 #b11000100011011 #b10101011100)))
(assert (fp.leq (fp #b0 #b11000100011011 #b10101011100)
                expect
                (fp #b0 #b11101101101001 #b01101101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
