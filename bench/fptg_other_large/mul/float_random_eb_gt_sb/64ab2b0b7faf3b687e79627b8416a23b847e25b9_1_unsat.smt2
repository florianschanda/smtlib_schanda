; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b0 #b1011010001010 #b11011110001)
                arg1
                (fp #b0 #b1111111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b00000000000)
                arg1
                (fp #b0 #b1111111111110 #b01100110000)))

(declare-const arg2 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1000010110010 #b01110001010)
                arg2
                (fp #b1 #b1000000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b1000000001011 #b00000000000)
                arg2
                (fp #b0 #b1000111100000 #b01110010011)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1111111111111 #b00000000000)
                expect
                (fp #b1 #b1111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b11111111111)
                expect
                (fp #b0 #b0010101000010 #b01110100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
