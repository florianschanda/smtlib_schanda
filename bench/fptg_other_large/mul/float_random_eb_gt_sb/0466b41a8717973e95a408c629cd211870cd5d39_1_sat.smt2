(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b001000101001011 #b11110010)
                arg1
                (fp #b0 #b100000000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b100000000000010 #b00100000)
                arg1
                (fp #b0 #b100000010010110 #b01000000)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b110111101010101 #b11000101)
                arg2
                (fp #b0 #b000000000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111111)
                arg2
                (fp #b0 #b101001101000011 #b01111000)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b010011110010110 #b00110011)
                expect
                (fp #b0 #b000000000000100 #b00011110)))
(assert (fp.leq (fp #b0 #b000000000000100 #b00011110)
                expect
                (fp #b0 #b010101000100101 #b01111010)))

(assert (= expect result))

(check-sat)
(exit)
