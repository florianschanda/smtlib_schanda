(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1101001100101 #b11001)
                arg1
                (fp #b1 #b0011111010101 #b01100)))
(assert (fp.leq (fp #b1 #b0011111010101 #b01100)
                arg1
                (fp #b1 #b0011011100011 #b10101)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
