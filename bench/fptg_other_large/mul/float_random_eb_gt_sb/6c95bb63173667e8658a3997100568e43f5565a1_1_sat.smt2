; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10101011100 #b111110011)
                arg1
                (fp #b1 #b01000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b000000000)
                arg1
                (fp #b0 #b01001100011 #b011100100)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01011000010 #b000101101)
                arg2
                (fp #b1 #b01000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b000000000)
                arg2
                (fp #b0 #b10001100110 #b100101100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00101101011 #b100111101)
                expect
                (fp #b0 #b00000000001 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b000000000)
                expect
                (fp #b0 #b01010001101 #b011010000)))

(assert (= expect result))

(check-sat)
(exit)
