(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111100001010011000 #b110000100)
                arg1
                (fp #b1 #b100001101010110101 #b010110000)))
(assert (fp.leq (fp #b1 #b100001101010110101 #b010110000)
                arg1
                (fp #b0 #b110110000101010010 #b101101011)))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b110101010000100001 #b110000110)
                expect
                (fp #b1 #b100011010101101011 #b110011100)))
(assert (fp.leq (fp #b1 #b100011010101101011 #b110011100)
                expect
                (fp #b0 #b111001001010101101 #b010000111)))

(assert (= expect result))

(check-sat)
(exit)
