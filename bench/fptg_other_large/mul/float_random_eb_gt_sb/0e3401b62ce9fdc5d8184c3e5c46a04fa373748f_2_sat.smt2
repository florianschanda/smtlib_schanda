(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000111000001 #b00)
                arg1
                (fp #b0 #b000000000001 #b00)))
(assert (fp.leq (fp #b0 #b000000000001 #b00)
                arg1
                (fp #b0 #b100001011101 #b10)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b011111101010 #b01)
                arg2
                (fp #b1 #b001111111111 #b00)))
(assert (fp.leq (fp #b1 #b001111111111 #b00)
                arg2
                (fp #b0 #b100100000111 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b110011001010 #b00)
                expect
                (fp #b1 #b000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000 #b01)
                expect
                (fp #b0 #b011001010100 #b10)))

(assert (= expect result))

(check-sat)
(exit)
