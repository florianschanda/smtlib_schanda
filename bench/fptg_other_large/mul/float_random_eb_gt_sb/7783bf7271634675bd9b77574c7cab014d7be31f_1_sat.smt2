(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000111101011 #b00001001)
                arg1
                (fp #b1 #b000000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b000000000000 #b11111111)
                arg1
                (fp #b0 #b111000101110 #b10010010)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111001010100 #b10101111)
                arg2
                (fp #b1 #b001010010010 #b00110111)))
(assert (fp.leq (fp #b1 #b001010010010 #b00110111)
                arg2
                (fp #b1 #b000010100101 #b11101000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111010000000 #b10110000)
                expect
                (fp #b0 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000)
                expect
                (fp #b0 #b001101010001 #b11101010)))

(assert (= expect result))

(check-sat)
(exit)
