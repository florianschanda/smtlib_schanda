;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1000110101010 #b100100100)
                arg1
                (fp #b1 #b0111000001111 #b100101110)))
(assert (fp.leq (fp #b1 #b0111000001111 #b100101110)
                arg1
                (fp #b1 #b0011010111101 #b111011001)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b0 #b0110010001011 #b010010111)
                arg2
                (fp #b0 #b0111111111111 #b000000101)))
(assert (fp.leq (fp #b0 #b0111111111111 #b000000101)
                arg2
                (fp #b0 #b1000101111010 #b110110000)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1011110000011 #b111011000)
                expect
                (fp #b1 #b0111000001111 #b100110110)))
(assert (fp.leq (fp #b1 #b0111000001111 #b100110110)
                expect
                (fp #b0 #b1011000110000 #b001000100)))

(assert (not (= expect result)))

(check-sat)
(exit)
