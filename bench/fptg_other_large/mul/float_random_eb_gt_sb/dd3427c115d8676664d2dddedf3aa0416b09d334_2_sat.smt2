(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010010011 #b1000010)
                arg1
                (fp #b1 #b1000000110 #b0000110)))
(assert (fp.leq (fp #b1 #b1000000110 #b0000110)
                arg1
                (fp #b0 #b1100000011 #b1100010)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1000101011 #b1110000)
                arg2
                (fp #b0 #b0001100110 #b0100011)))
(assert (fp.leq (fp #b0 #b0001100110 #b0100011)
                arg2
                (fp #b0 #b1011001110 #b1100110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110101010 #b1010110)
                expect
                (fp #b1 #b0001101101 #b0101011)))
(assert (fp.leq (fp #b1 #b0001101101 #b0101011)
                expect
                (fp #b0 #b0100000100 #b1101100)))

(assert (= expect result))

(check-sat)
(exit)
