; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b001101011001000101 #b001110)
                arg1
                (fp #b1 #b000100110011111101 #b011010)))
(assert (fp.leq (fp #b1 #b000100110011111101 #b011010)
                arg1
                (fp #b0 #b010100011100000100 #b000000)))

(declare-const arg2 (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b111011101010100110 #b010111)
                arg2
                (fp #b1 #b000000000000000000 #b010000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b010000)
                arg2
                (fp #b0 #b011100101010001000 #b011011)))

(declare-const result (_ FloatingPoint 18 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101110010101100110 #b110111)
                expect
                (fp #b0 #b000000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b000000)
                expect
                (fp #b0 #b100010000011111111 #b100000)))

(assert (= expect result))

(check-sat)
(exit)
