(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101100010 #b1010100)
                arg1
                (fp #b0 #b0000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b0000000000 #b1011100)
                arg1
                (fp #b0 #b0001010110 #b1100001)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1011111010 #b1001100)
                arg2
                (fp #b1 #b0100000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0100000000 #b0000000)
                arg2
                (fp #b0 #b1001101101 #b1000111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0001111001 #b1101001)
                expect
                (fp #b1 #b0000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000001)
                expect
                (fp #b0 #b1011111010 #b0011000)))

(assert (= expect result))

(check-sat)
(exit)
