(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101111101111 #b001111)
                arg1
                (fp #b0 #b000000000000 #b000110)))
(assert (fp.leq (fp #b0 #b000000000000 #b000110)
                arg1
                (fp #b0 #b100010011110 #b100011)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b010010101001 #b010110)
                arg2
                (fp #b0 #b001011000100 #b000011)))
(assert (fp.leq (fp #b0 #b001011000100 #b000011)
                arg2
                (fp #b0 #b011000000100 #b110110)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011011111110 #b101000)
                expect
                (fp #b0 #b000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000000)
                expect
                (fp #b0 #b111001000010 #b110111)))

(assert (not (= expect result)))

(check-sat)
(exit)
