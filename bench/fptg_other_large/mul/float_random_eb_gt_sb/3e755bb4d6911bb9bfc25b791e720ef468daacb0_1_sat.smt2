(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11100100111 #b01110)
                arg1
                (fp #b1 #b00111111101 #b01101)))
(assert (fp.leq (fp #b1 #b00111111101 #b01101)
                arg1
                (fp #b0 #b10011001011 #b00011)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10100101101 #b10010)
                arg2
                (fp #b0 #b01111111111 #b11010)))
(assert (fp.leq (fp #b0 #b01111111111 #b11010)
                arg2
                (fp #b0 #b11110111110 #b10111)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10011100110 #b01100)
                expect
                (fp #b1 #b00111111110 #b01000)))
(assert (fp.leq (fp #b1 #b00111111110 #b01000)
                expect
                (fp #b0 #b11001010101 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
