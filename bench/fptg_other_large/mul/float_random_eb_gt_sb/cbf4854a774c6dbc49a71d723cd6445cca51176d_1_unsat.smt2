(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00011110000011 #b011)
                arg1
                (fp #b0 #b00000000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010)
                arg1
                (fp #b0 #b11111010011101 #b100)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00010001110000 #b101)
                arg2
                (fp #b0 #b01111111111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111111111 #b101)
                arg2
                (fp #b0 #b11100101110101 #b101)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10101101100000 #b101)
                expect
                (fp #b0 #b00000000000000 #b011)))
(assert (fp.leq (fp #b0 #b00000000000000 #b011)
                expect
                (fp #b0 #b11100101010100 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
