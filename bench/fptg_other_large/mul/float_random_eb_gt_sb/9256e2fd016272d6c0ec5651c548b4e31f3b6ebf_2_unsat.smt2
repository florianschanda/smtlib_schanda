                arg2
                (fp #b0 #b10000000000111 #b1011011100)))
(assert (fp.leq (fp #b0 #b10000000000111 #b1011011100)
                arg2
                (fp #b0 #b10010010100101 #b1111101101)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b01111110011111 #b0010001110)
                expect
                (fp #b0 #b11001100001101 #b0111101111)))
(assert (fp.leq (fp #b0 #b11001100001101 #b0111101111)
                expect
                (fp #b0 #b11011010010000 #b1111110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
