;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b0 #b10101101001001 #b0111010111)
                arg1
                (fp #b0 #b11001100000100 #b1011101011)))
(assert (fp.leq (fp #b0 #b11001100000100 #b1011101011)
                arg1
                (fp #b0 #b11100111100000 #b1001000101)))

