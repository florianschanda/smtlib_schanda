(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111111 #b00000000)
                arg1
                (fp #b1 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111111)
                arg1
                (fp #b1 #b1011010001 #b01101000)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0110100110 #b01001001)
                arg2
                (fp #b0 #b1011111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1011111110 #b11111111)
                arg2
                (fp #b0 #b1111000110 #b01101010)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
