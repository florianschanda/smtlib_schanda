(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11111000101011 #b11010010111)
                arg1
                (fp #b1 #b10101001000100 #b00011101100)))
(assert (fp.leq (fp #b1 #b10101001000100 #b00011101100)
                arg1
                (fp #b0 #b01010010101011 #b10110111110)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b01110000101111 #b00000011001)
                arg2
                (fp #b1 #b00000000000000 #b01101101001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b01101101001)
                arg2
                (fp #b0 #b00000010100000 #b01111101101)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11110100010000 #b01000111111)
                expect
                (fp #b0 #b00101001000100 #b11100110110)))
(assert (fp.leq (fp #b0 #b00101001000100 #b11100110110)
                expect
                (fp #b0 #b11111111100010 #b01101111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
