(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101101100100 #b1110001000)
                arg1
                (fp #b1 #b100000001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b100000001000 #b1101001010)
                arg1
                (fp #b0 #b101101100100 #b1101000110)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100110011010 #b0010001011)
                arg2
                (fp #b0 #b011111111111 #b0000000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b0000000000)
                arg2
                (fp #b0 #b101101011101 #b1100100101)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101011010110 #b1100100001)
                expect
                (fp #b1 #b100000001000 #b1101001010)))
(assert (fp.leq (fp #b1 #b100000001000 #b1101001010)
                expect
                (fp #b0 #b001110010110 #b0010001000)))

(assert (= expect result))

(check-sat)
(exit)
