; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01100011110 #b0011111)
                arg1
                (fp #b0 #b10000000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000000011 #b1110000)
                arg1
                (fp #b0 #b10101010000 #b1001011)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01101100011 #b0101000)
                arg2
                (fp #b1 #b00111111100 #b0110101)))
(assert (fp.leq (fp #b1 #b00111111100 #b0110101)
                arg2
                (fp #b0 #b01001011001 #b0111001)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10101101000 #b0011010)
                expect
                (fp #b1 #b01000000001 #b0101001)))
(assert (fp.leq (fp #b1 #b01000000001 #b0101001)
                expect
                (fp #b0 #b11101100001 #b0101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
