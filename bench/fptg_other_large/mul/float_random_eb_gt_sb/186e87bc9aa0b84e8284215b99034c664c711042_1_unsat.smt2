(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b101100000010 #b1111)
                arg1
                (fp #b1 #b000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000000000 #b0100)
                arg1
                (fp #b0 #b011100010110 #b0110)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b000110101000 #b1000)
                arg2
                (fp #b1 #b000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b000000000000 #b0100)
                arg2
                (fp #b0 #b000111111011 #b1101)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b000111001011 #b0100)
                expect
                (fp #b0 #b000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000)
                expect
                (fp #b0 #b001110001010 #b0100)))

(assert (not (= expect result)))

(check-sat)
(exit)
