; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10110011011111 #b1110)
                arg1
                (fp #b0 #b10001110000011 #b0100)))
(assert (fp.leq (fp #b0 #b10001110000011 #b0100)
                arg1
                (fp #b0 #b11010001111000 #b0100)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111010011011 #b1011)
                arg2
                (fp #b0 #b00000000000000 #b1111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1111)
                arg2
                (fp #b0 #b00001011110110 #b1010)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00010110101000 #b1111)
                expect
                (fp #b0 #b00001110000101 #b0010)))
(assert (fp.leq (fp #b0 #b00001110000101 #b0010)
                expect
                (fp #b0 #b11111101000010 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
