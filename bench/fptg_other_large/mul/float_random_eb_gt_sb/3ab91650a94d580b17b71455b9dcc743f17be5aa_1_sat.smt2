(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b000001000101 #b0110)
                arg1
                (fp #b1 #b000000000000 #b1111)))
(assert (fp.leq (fp #b1 #b000000000000 #b1111)
                arg1
                (fp #b0 #b011100011010 #b0000)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b101101100110 #b0110)
                arg2
                (fp #b1 #b001111111110 #b0000)))
(assert (fp.leq (fp #b1 #b001111111110 #b0000)
                arg2
                (fp #b0 #b100000100100 #b1000)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001100011111 #b1010)
                expect
                (fp #b0 #b000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000)
                expect
                (fp #b0 #b101111011001 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
