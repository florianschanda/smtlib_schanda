(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101101001 #b011111)
                arg1
                (fp #b0 #b1000000101 #b000111)))
(assert (fp.leq (fp #b0 #b1000000101 #b000111)
                arg1
                (fp #b0 #b1010000000 #b010011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1011000010 #b011011)
                arg2
                (fp #b0 #b1000000001 #b100000)))
(assert (fp.leq (fp #b0 #b1000000001 #b100000)
                arg2
                (fp #b0 #b1011110010 #b110111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0101100100 #b110001)
                expect
                (fp #b0 #b1000000111 #b101011)))
(assert (fp.leq (fp #b0 #b1000000111 #b101011)
                expect
                (fp #b0 #b1000101011 #b101101)))

(assert (= expect result))

(check-sat)
(exit)
