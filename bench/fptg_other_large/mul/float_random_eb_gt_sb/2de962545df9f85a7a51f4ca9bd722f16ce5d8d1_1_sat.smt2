; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111111101 #b101)
                arg1
                (fp #b1 #b11111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111101 #b000)
                arg1
                (fp #b1 #b10011100110 #b010)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b00100111010 #b101)
                arg2
                (fp #b0 #b00111111110 #b011)))
(assert (fp.leq (fp #b0 #b00111111110 #b011)
                arg2
                (fp #b0 #b11001000100 #b101)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111000011 #b001)
                expect
                (fp #b1 #b10111111100 #b011)))
(assert (fp.leq (fp #b1 #b10111111100 #b011)
                expect
                (fp #b1 #b10000001100 #b111)))

(assert (= expect result))

(check-sat)
(exit)
