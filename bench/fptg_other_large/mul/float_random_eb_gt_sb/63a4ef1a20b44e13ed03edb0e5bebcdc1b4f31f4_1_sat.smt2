; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111101110010000 #b0010)
                arg1
                (fp #b1 #b1000000000000011 #b1110)))
(assert (fp.leq (fp #b1 #b1000000000000011 #b1110)
                arg1
                (fp #b1 #b0110101101010110 #b1111)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111111111100111 #b0100)
                arg2
                (fp #b1 #b0111111111111111 #b0010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b0010)
                arg2
                (fp #b1 #b0011001100110001 #b1100)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b0 #b0110111100001101 #b0101)
                expect
                (fp #b0 #b1000000000000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000000000000100 #b0000)
                expect
                (fp #b0 #b1101000000111011 #b1110)))

(assert (= expect result))

(check-sat)
(exit)
