(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1001001100111 #b0)
                arg1
                (fp #b0 #b1011101101101 #b1)))
(assert (fp.leq (fp #b0 #b1011101101101 #b1)
                arg1
                (fp #b0 #b1111010101010 #b1)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1110110101110 #b1)
                arg2
                (fp #b1 #b1011111111110 #b1)))
(assert (fp.leq (fp #b1 #b1011111111110 #b1)
                arg2
                (fp #b0 #b1011001100111 #b1)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111111110110 #b0)
                expect
                (fp #b1 #b1111101101101 #b1)))
(assert (fp.leq (fp #b1 #b1111101101101 #b1)
                expect
                (fp #b1 #b0001101100000 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
