; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10111100001001010 #b101)
                arg1
                (fp #b0 #b11111111111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b111)
                arg1
                (fp #b0 #b11111111111111111 #b000)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11010110010000111 #b101)
                arg2
                (fp #b1 #b00111111111111110 #b011)))
(assert (fp.leq (fp #b1 #b00111111111111110 #b011)
                arg2
                (fp #b0 #b01101011000010000 #b101)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11000111001111000 #b100)
                expect
                (fp #b1 #b10111111111111110 #b011)))
(assert (fp.leq (fp #b1 #b10111111111111110 #b011)
                expect
                (fp #b0 #b01010011000000110 #b010)))

(assert (= expect result))

(check-sat)
(exit)
