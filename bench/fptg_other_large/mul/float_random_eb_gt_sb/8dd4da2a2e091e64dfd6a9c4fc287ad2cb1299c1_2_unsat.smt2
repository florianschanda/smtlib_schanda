(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1000101100100 #b100011100)
                arg1
                (fp #b1 #b0000000000000 #b110111001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b110111001)
                arg1
                (fp #b0 #b1000010110110 #b001010110)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1100001110000 #b000001110)
                arg2
                (fp #b1 #b1011111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b111111111)
                arg2
                (fp #b1 #b0011010010010 #b110100000)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b0011000000011 #b110001100)
                expect
                (fp #b0 #b0100000000000 #b101110010)))
(assert (fp.leq (fp #b0 #b0100000000000 #b101110010)
                expect
                (fp #b0 #b1011010101011 #b100000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
