; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110110000011 #b1001011110)
                arg1
                (fp #b1 #b000000000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b000000000000 #b1110100001)
                arg1
                (fp #b0 #b101110000000 #b0100001111)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b011111110110 #b0000110001)
                arg2
                (fp #b0 #b101111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b1111111111)
                arg2
                (fp #b0 #b111111010001 #b1001011011)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b101000001101 #b1100000101)
                expect
                (fp #b1 #b010000000000 #b1101000010)))
(assert (fp.leq (fp #b1 #b010000000000 #b1101000010)
                expect
                (fp #b0 #b001100100100 #b0101101110)))

(assert (not (= expect result)))

(check-sat)
(exit)
