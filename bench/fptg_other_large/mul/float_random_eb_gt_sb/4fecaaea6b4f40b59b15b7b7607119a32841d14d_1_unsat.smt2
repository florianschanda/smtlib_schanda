;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0110101110 #b0111)
                arg1
                (fp #b0 #b1100100111 #b1000)))
(assert (fp.leq (fp #b0 #b1100100111 #b1000)
                arg1
                (fp #b0 #b1101000101 #b1111)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0100101100 #b0111)
                arg2
                (fp #b0 #b0000000000 #b1110)))
(assert (fp.leq (fp #b0 #b0000000000 #b1110)
                arg2
                (fp #b0 #b1010101110 #b1111)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0001101111 #b0010)
                expect
                (fp #b0 #b0100101001 #b0101)))
(assert (fp.leq (fp #b0 #b0100101001 #b0101)
                expect
                (fp #b0 #b0111011010 #b1010)))

(assert (not (= expect result)))

(check-sat)
(exit)
