(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0100100000101 #b110)
                arg1
                (fp #b1 #b0000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000)
                arg1
                (fp #b0 #b0111100100001 #b001)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110001010011 #b101)
                arg2
                (fp #b0 #b0100000000000 #b000)))
(assert (fp.leq (fp #b0 #b0100000000000 #b000)
                arg2
                (fp #b0 #b0111111101010 #b011)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0000101001001 #b101)
                expect
                (fp #b1 #b0000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b000)
                expect
                (fp #b0 #b1101011010111 #b101)))

(assert (= expect result))

(check-sat)
(exit)
