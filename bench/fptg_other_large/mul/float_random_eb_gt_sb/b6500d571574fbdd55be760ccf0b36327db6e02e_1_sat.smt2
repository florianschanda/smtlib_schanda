(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1101111000111 #b1001)
                arg1
                (fp #b1 #b1011111111110 #b1111)))
(assert (fp.leq (fp #b1 #b1011111111110 #b1111)
                arg1
                (fp #b1 #b0110000100111 #b0010)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0000010111110 #b1010)
                arg2
                (fp #b0 #b0111000111011 #b0010)))
(assert (fp.leq (fp #b0 #b0111000111011 #b0010)
                arg2
                (fp #b0 #b1110101000101 #b1001)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1101010011110 #b0100)
                expect
                (fp #b1 #b1011000111011 #b0001)))
(assert (fp.leq (fp #b1 #b1011000111011 #b0001)
                expect
                (fp #b0 #b1110111001110 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
