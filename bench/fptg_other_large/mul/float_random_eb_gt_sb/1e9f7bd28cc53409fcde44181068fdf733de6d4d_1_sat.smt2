(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111101010100 #b101000)
                arg1
                (fp #b0 #b101100001101 #b111011)))
(assert (fp.leq (fp #b0 #b101100001101 #b111011)
                arg1
                (fp #b0 #b111010011111 #b100000)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111010001000 #b001011)
                arg2
                (fp #b0 #b100000000101 #b101000)))
(assert (fp.leq (fp #b0 #b100000000101 #b101000)
                arg2
                (fp #b0 #b101101001011 #b101011)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b011101101010 #b001000)
                expect
                (fp #b0 #b101100010100 #b100011)))
(assert (fp.leq (fp #b0 #b101100010100 #b100011)
                expect
                (fp #b0 #b111101000010 #b110110)))

(assert (= expect result))

(check-sat)
(exit)
