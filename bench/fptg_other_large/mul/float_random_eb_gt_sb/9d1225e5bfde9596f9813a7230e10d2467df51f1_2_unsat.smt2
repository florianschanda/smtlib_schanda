(assert (fp.leq (fp #b1 #b1000000000000111 #b0011100100)
                arg2
                (fp #b1 #b0010010100111001 #b1011011010)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0101100000000110 #b1101001111)
                expect
                (fp #b0 #b1100000000000111 #b0011100100)))
(assert (fp.leq (fp #b0 #b1100000000000111 #b0011100100)
                expect
                (fp #b0 #b1111000010111110 #b1011100011)))

(assert (not (= expect result)))

(check-sat)
(exit)
