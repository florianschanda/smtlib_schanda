(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11010101010101 #b11011110000)
                arg1
                (fp #b0 #b00000000000000 #b11111111111)))
(assert (fp.leq (fp #b0 #b00000000000000 #b11111111111)
