(assert (fp.leq (fp #b1 #b11111111111101 #b00000000000)
                arg2
                (fp #b1 #b10010101000001 #b10100101100)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10011011110001 #b10010110011)
                expect
                (fp #b1 #b01111111111110 #b11111111110)))
(assert (fp.leq (fp #b1 #b01111111111110 #b11111111110)
                expect
                (fp #b1 #b00001010001001 #b10110101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
