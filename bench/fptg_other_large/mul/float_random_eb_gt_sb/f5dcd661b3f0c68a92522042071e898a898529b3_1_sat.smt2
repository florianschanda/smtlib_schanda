(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b101100110 #b1)
                arg1
                (fp #b0 #b000000001 #b0)))
(assert (fp.leq (fp #b0 #b000000001 #b0)
                arg1
                (fp #b0 #b000111101 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b000100111 #b0)
                arg2
                (fp #b0 #b111111110 #b0)))
(assert (fp.leq (fp #b0 #b111111110 #b0)
                arg2
                (fp #b0 #b111111110 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b010110001 #b1)
                expect
                (fp #b0 #b100000000 #b0)))
(assert (fp.leq (fp #b0 #b100000000 #b0)
                expect
                (fp #b0 #b110000001 #b0)))

(assert (= expect result))

(check-sat)
(exit)
