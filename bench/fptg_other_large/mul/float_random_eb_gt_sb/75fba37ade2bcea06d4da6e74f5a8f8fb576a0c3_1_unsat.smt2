(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 5))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 17 5))
(assert (fp.leq (fp #b1 #b11111110010111111 #b1011)
                arg2
                (fp #b1 #b00000000000000000 #b0001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0001)
                arg2
                (fp #b0 #b10001000111110111 #b1100)))

(declare-const result (_ FloatingPoint 17 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 5))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
