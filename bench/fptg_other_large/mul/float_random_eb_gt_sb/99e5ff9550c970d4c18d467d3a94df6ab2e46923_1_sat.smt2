(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b011101000101000000 #b1110000)
                arg1
                (fp #b0 #b111111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b1111111)
                arg1
                (fp #b0 #b111111111111111111 #b0000000)))

(declare-const arg2 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b101111001011100011 #b1001100)
                arg2
                (fp #b1 #b100010001011111100 #b0100001)))
(assert (fp.leq (fp #b1 #b100010001011111100 #b0100001)
                arg2
                (fp #b0 #b100011000000110111 #b1010011)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0000000)
                expect
                (fp #b1 #b111111111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1111111)
                expect
                (fp #b1 #b010101010101010101 #b0100001)))

(assert (= expect result))

(check-sat)
(exit)
