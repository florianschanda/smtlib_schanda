; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1100100011010 #b101100000)
                arg1
                (fp #b0 #b0000000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b0000000000000 #b111111111)
                arg1
                (fp #b0 #b1110110000110 #b000110111)))

(declare-const arg2 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1001111001011 #b011111001)
                arg2
                (fp #b1 #b1000000001000 #b100111000)))
(assert (fp.leq (fp #b1 #b1000000001000 #b100111000)
                arg2
                (fp #b1 #b0010101011000 #b110111101)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1101101011000 #b111010011)
                expect
                (fp #b1 #b0000000001010 #b100110110)))
(assert (fp.leq (fp #b1 #b0000000001010 #b100110110)
                expect
                (fp #b0 #b1101011110000 #b110011100)))

(assert (= expect result))

(check-sat)
(exit)
