(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1101100011100 #b0)
                arg1
                (fp #b1 #b1011111111110 #b1)))
(assert (fp.leq (fp #b1 #b1011111111110 #b1)
                arg1
                (fp #b0 #b0010101111101 #b1)))

(declare-const arg2 (_ FloatingPoint 13 2))
(assert (fp.leq (fp #b1 #b1111111111110 #b1)
                arg2
                (fp #b1 #b1111111111110 #b0)))
(assert (fp.leq (fp #b1 #b1111111111110 #b0)
                arg2
                (fp #b0 #b1000111000111 #b0)))

(declare-const result (_ FloatingPoint 13 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
