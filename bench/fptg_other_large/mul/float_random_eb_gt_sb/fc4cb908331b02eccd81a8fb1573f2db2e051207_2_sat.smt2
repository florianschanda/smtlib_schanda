(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b0 #b0011010011010 #b1100100)
                arg1
                (fp #b0 #b0111111111111 #b0101011)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0101011)
                arg1
                (fp #b0 #b1110010000011 #b0100111)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1000000001011 #b0001101)
                arg2
                (fp #b0 #b0001001001011 #b0011100)))
(assert (fp.leq (fp #b0 #b0001001001011 #b0011100)
                arg2
                (fp #b0 #b0011000110011 #b1000110)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1001000011001 #b0111110)
                expect
                (fp #b0 #b0001001001011 #b1010001)))
(assert (fp.leq (fp #b0 #b0001001001011 #b1010001)
                expect
                (fp #b0 #b0110101111011 #b0100010)))

(assert (= expect result))

(check-sat)
(exit)
