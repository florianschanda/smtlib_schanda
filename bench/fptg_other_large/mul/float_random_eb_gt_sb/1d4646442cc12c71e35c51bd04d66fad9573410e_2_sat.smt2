(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b110011011101 #b110000)
                arg1
                (fp #b1 #b011111111111 #b111101)))
(assert (fp.leq (fp #b1 #b011111111111 #b111101)
                arg1
                (fp #b0 #b000011101010 #b110101)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111110011101 #b101010)
                arg2
                (fp #b0 #b011111111111 #b000110)))
(assert (fp.leq (fp #b0 #b011111111111 #b000110)
                arg2
                (fp #b0 #b110000011010 #b100111)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101001001001 #b101100)
                expect
                (fp #b1 #b100000000000 #b000101)))
(assert (fp.leq (fp #b1 #b100000000000 #b000101)
                expect
                (fp #b1 #b010111000001 #b011100)))

(assert (= expect result))

(check-sat)
(exit)
