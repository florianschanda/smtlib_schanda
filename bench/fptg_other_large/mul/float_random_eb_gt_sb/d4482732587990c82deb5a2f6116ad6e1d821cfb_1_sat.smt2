                arg2
                (fp #b0 #b11101111110011 #b11111000)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11100110101010 #b10001000)
