(assert (fp.leq (fp #b0 #b10111100001000100 #b001)
                arg2
                (fp #b0 #b11000011110100111 #b010)))
(assert (fp.leq (fp #b0 #b11000011110100111 #b010)
                arg2
                (fp #b0 #b11000110011101001 #b111)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11111110011100101 #b110)
                expect
                (fp #b1 #b01000011110101001 #b001)))
(assert (fp.leq (fp #b1 #b01000011110101001 #b001)
                expect
                (fp #b0 #b01100111110000100 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
