;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b00011100000011001 #b110)
                arg1
                (fp #b1 #b00000000000000000 #b111)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b111)
                arg1
                (fp #b0 #b10011001100100101 #b100)))

