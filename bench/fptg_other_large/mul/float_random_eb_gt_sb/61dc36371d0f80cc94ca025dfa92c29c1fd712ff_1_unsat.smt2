(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111101101111 #b0011001)
                arg1
                (fp #b0 #b011111111111 #b0101011)))
(assert (fp.leq (fp #b0 #b011111111111 #b0101011)
                arg1
                (fp #b0 #b111001100010 #b0101110)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111101101011 #b1001010)
                arg2
                (fp #b1 #b010000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b010000000000 #b0000000)
                arg2
                (fp #b0 #b001011101111 #b1110100)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b010101011001 #b0001111)
                expect
                (fp #b1 #b010000000000 #b0101011)))
(assert (fp.leq (fp #b1 #b010000000000 #b0101011)
                expect
                (fp #b0 #b110011011110 #b0101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
