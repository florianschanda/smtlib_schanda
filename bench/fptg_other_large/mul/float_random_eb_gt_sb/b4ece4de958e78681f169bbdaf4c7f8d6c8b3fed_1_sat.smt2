; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b011110100001000 #b00)
                arg1
                (fp #b1 #b010000000000000 #b00)))
(assert (fp.leq (fp #b1 #b010000000000000 #b00)
                arg1
                (fp #b0 #b011101011110111 #b01)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b000110011010001 #b01)
                arg2
                (fp #b0 #b100100000110010 #b10)))
(assert (fp.leq (fp #b0 #b100100000110010 #b10)
                arg2
                (fp #b0 #b111101001100001 #b01)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b101000101110100 #b01)
                expect
                (fp #b1 #b010100000110011 #b10)))
(assert (fp.leq (fp #b1 #b010100000110011 #b10)
                expect
                (fp #b0 #b000110100011001 #b10)))

(assert (= expect result))

(check-sat)
(exit)
