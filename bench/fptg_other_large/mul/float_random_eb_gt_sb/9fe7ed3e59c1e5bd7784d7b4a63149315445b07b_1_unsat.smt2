(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11000101101010 #b110000101)
                arg1
                (fp #b0 #b10010011001111 #b110110001)))
(assert (fp.leq (fp #b0 #b10010011001111 #b110110001)
                arg1
                (fp #b0 #b10110110011100 #b001101010)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11110111110011 #b010010110)
                expect
                (fp #b1 #b10100110100000 #b101101000)))
(assert (fp.leq (fp #b1 #b10100110100000 #b101101000)
                expect
                (fp #b1 #b01000010111010 #b101111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
