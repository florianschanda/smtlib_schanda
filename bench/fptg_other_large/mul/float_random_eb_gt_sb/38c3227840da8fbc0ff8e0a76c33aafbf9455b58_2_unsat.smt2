(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11000010101 #b1110)
                arg1
                (fp #b1 #b01111111111 #b0111)))
(assert (fp.leq (fp #b1 #b01111111111 #b0111)
                arg1
                (fp #b0 #b10010101110 #b0100)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00000100100 #b0001)
                arg2
                (fp #b0 #b00000000000 #b1110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1110)
                arg2
                (fp #b0 #b01110000110 #b0110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11100000110 #b0000)
                expect
                (fp #b1 #b00000000001 #b0101)))
(assert (fp.leq (fp #b1 #b00000000001 #b0101)
                expect
                (fp #b0 #b00100000101 #b1100)))

(assert (not (= expect result)))

(check-sat)
(exit)
