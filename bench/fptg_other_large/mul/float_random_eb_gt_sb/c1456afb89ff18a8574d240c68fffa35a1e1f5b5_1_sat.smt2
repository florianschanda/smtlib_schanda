(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b101101000 #b10)
                arg1
                (fp #b1 #b000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000 #b00)
                arg1
                (fp #b0 #b110011111 #b11)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111001111 #b01)
                arg2
                (fp #b1 #b100000001 #b10)))
(assert (fp.leq (fp #b1 #b100000001 #b10)
                arg2
                (fp #b1 #b000100011 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101100100 #b01)
                expect
                (fp #b0 #b000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000 #b00)
                expect
                (fp #b0 #b010100000 #b10)))

(assert (= expect result))

(check-sat)
(exit)
