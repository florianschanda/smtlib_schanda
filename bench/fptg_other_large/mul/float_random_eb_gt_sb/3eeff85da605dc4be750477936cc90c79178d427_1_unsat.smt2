(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1010010101101 #b01111010011)
                arg1
                (fp #b1 #b0111111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b0111111111111 #b01100111111)
                arg1
                (fp #b0 #b1101011000011 #b01111111010)))

(declare-const arg2 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1100101100001 #b00111101001)
                arg2
                (fp #b0 #b0000000000000 #b01000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b01000000000)
                arg2
                (fp #b0 #b1011010011110 #b10101000010)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1001111000100 #b00111010010)
                expect
                (fp #b1 #b0000000000000 #b01011001111)))
(assert (fp.leq (fp #b1 #b0000000000000 #b01011001111)
                expect
                (fp #b0 #b0100000111100 #b01001011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
