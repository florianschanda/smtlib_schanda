; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11011001100110 #b10101100)
                arg1
                (fp #b1 #b11010101000011 #b00000111)))
(assert (fp.leq (fp #b1 #b11010101000011 #b00000111)
                arg1
                (fp #b1 #b00000110010110 #b01001111)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10011101011110 #b10011001)
                arg2
                (fp #b0 #b10000000000111 #b01000010)))
(assert (fp.leq (fp #b0 #b10000000000111 #b01000010)
                arg2
                (fp #b0 #b10001111111001 #b00010001)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11110111001011 #b11111101)
                expect
                (fp #b1 #b11010101001011 #b01001010)))
(assert (fp.leq (fp #b1 #b11010101001011 #b01001010)
                expect
                (fp #b1 #b10101110000100 #b11100001)))

(assert (= expect result))

(check-sat)
(exit)
