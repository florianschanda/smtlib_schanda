(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b100001110 #b111110)
                arg1
                (fp #b0 #b111011100 #b100101)))
(assert (fp.leq (fp #b0 #b111011100 #b100101)
                arg1
                (fp #b0 #b111011110 #b001101)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100011100 #b101011)
                arg2
                (fp #b0 #b010101111 #b111110)))
(assert (fp.leq (fp #b0 #b010101111 #b111110)
                arg2
                (fp #b0 #b010111011 #b110110)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b001100001 #b100111)
                expect
                (fp #b0 #b110001101 #b100011)))
(assert (fp.leq (fp #b0 #b110001101 #b100011)
                expect
                (fp #b0 #b111110001 #b000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
