(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b110010101101101100 #b111010)
                arg1
                (fp #b1 #b101111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b101111111111111110 #b111111)
                arg1
                (fp #b0 #b111011001100111011 #b000111)))

(declare-const arg2 (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b011001010000101101 #b000011)
                arg2
                (fp #b1 #b000000000000000000 #b101100)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b101100)
                arg2
                (fp #b0 #b110011110011101011 #b110010)))

(declare-const result (_ FloatingPoint 18 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 7))
(assert (fp.leq (fp #b1 #b100111011101001101 #b011101)
                expect
                (fp #b0 #b010000000000000000 #b011000)))
(assert (fp.leq (fp #b0 #b010000000000000000 #b011000)
                expect
                (fp #b0 #b011010110000001110 #b010011)))

(assert (= expect result))

(check-sat)
(exit)
