; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b0011110101001110 #b001)
                arg1
                (fp #b0 #b0100000000000000 #b000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b000)
                arg1
                (fp #b0 #b0101111010100101 #b011)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1000100000101000 #b010)
                arg2
                (fp #b1 #b0101010010100000 #b110)))
(assert (fp.leq (fp #b1 #b0101010010100000 #b110)
                arg2
                (fp #b0 #b0101001010110001 #b110)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1110000011100111 #b001)
                expect
                (fp #b1 #b0001010010100001 #b110)))
(assert (fp.leq (fp #b1 #b0001010010100001 #b110)
                expect
                (fp #b0 #b1100111110100001 #b000)))

(assert (= expect result))

(check-sat)
(exit)
