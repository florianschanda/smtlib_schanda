; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11111001001 #b001000000)
                arg1
                (fp #b1 #b10111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b10111111110 #b111111111)
                arg1
                (fp #b1 #b00111000010 #b111001011)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01000011011 #b110010111)
                arg2
                (fp #b0 #b01110011100 #b001001110)))
(assert (fp.leq (fp #b0 #b01110011100 #b001001110)
                arg2
                (fp #b0 #b11011110000 #b010001010)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11000111000 #b000100110)
                expect
                (fp #b1 #b10110011100 #b001001110)))
(assert (fp.leq (fp #b1 #b10110011100 #b001001110)
                expect
                (fp #b1 #b01001010010 #b011011110)))

(assert (= expect result))

(check-sat)
(exit)
