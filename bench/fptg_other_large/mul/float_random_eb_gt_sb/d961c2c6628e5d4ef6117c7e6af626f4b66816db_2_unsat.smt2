(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b100101110000011 #b10001001000)
                arg1
                (fp #b1 #b011111111111111 #b11001010001)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11001010001)
                arg1
                (fp #b0 #b001010111001010 #b11110100011)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b0 #b010000100100111 #b10100010110)
                expect
                (fp #b0 #b100000000000000 #b10011010000)))
(assert (fp.leq (fp #b0 #b100000000000000 #b10011010000)
                expect
                (fp #b0 #b111010010001101 #b11000001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
