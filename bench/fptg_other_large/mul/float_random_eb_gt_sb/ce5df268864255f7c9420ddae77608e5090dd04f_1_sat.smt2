(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1001010100110 #b1110001)
                arg1
                (fp #b1 #b1000000000110 #b0000110)))
(assert (fp.leq (fp #b1 #b1000000000110 #b0000110)
                arg1
                (fp #b0 #b0001110010000 #b1101000)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111111111111 #b0000000)
                arg2
                (fp #b1 #b1111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b1111111)
                arg2
                (fp #b1 #b1000001011101 #b1001110)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b0 #b0010001000010 #b0110001)
                expect
                (fp #b0 #b1111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b1111111)
                expect
                (fp #b0 #b1111111111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
