(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100110110111 #b0000)
                arg1
                (fp #b0 #b000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000000 #b0100)
                arg1
                (fp #b0 #b001111011001 #b0000)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110110100001 #b0011)
                arg2
                (fp #b1 #b011111111111 #b0110)))
(assert (fp.leq (fp #b1 #b011111111111 #b0110)
                arg2
                (fp #b1 #b010011101000 #b0001)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b010111000001 #b1100)
                expect
                (fp #b1 #b000000000000 #b0101)))
(assert (fp.leq (fp #b1 #b000000000000 #b0101)
                expect
                (fp #b0 #b110101101010 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
