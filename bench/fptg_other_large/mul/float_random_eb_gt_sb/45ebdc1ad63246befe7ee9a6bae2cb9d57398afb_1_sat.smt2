(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b01000001110 #b000101101)
                arg1
                (fp #b0 #b01111111111 #b101000010)))
(assert (fp.leq (fp #b0 #b01111111111 #b101000010)
                arg1
                (fp #b0 #b11111100111 #b100000010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b01001101000 #b011111010)
                expect
                (fp #b0 #b10000000000 #b010100111)))
(assert (fp.leq (fp #b0 #b10000000000 #b010100111)
                expect
                (fp #b0 #b10100100001 #b111010101)))

(assert (= expect result))

(check-sat)
(exit)
