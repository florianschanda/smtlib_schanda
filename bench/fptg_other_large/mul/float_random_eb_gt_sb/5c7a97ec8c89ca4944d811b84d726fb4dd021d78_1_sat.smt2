(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b00001100011100 #b000000)
                arg1
                (fp #b1 #b00000000000001 #b000000)))
(assert (fp.leq (fp #b1 #b00000000000001 #b000000)
                arg1
                (fp #b0 #b00100001110010 #b010111)))

(declare-const arg2 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b01111000001111 #b110110)
                arg2
                (fp #b1 #b00000000000001 #b000000)))
(assert (fp.leq (fp #b1 #b00000000000001 #b000000)
                arg2
                (fp #b0 #b10000100111100 #b011000)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11111101011111 #b011001)
                expect
                (fp #b0 #b00000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000000)
                expect
                (fp #b0 #b11100100011010 #b000111)))

(assert (= expect result))

(check-sat)
(exit)
