(assert (fp.leq (fp #b0 #b1011111111111110 #b111111111)
                arg2
                (fp #b0 #b1111101000100010 #b100000001)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b0100111000011100 #b000110000)
                expect
                (fp #b0 #b1011111111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b1011111111111111 #b111111100)
                expect
                (fp #b0 #b1111100101001001 #b110010000)))

(assert (not (= expect result)))

(check-sat)
