(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b000001110001110 #b01111)
                arg1
                (fp #b1 #b000000000000001 #b00000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b00000)
                arg1
                (fp #b0 #b100111000111011 #b00100)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b110010001110100 #b00010)
                arg2
                (fp #b1 #b001111111111101 #b01101)))
(assert (fp.leq (fp #b1 #b001111111111101 #b01101)
                arg2
                (fp #b0 #b001001001110101 #b10110)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001010110000110 #b01001)
                expect
                (fp #b0 #b000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000)
                expect
                (fp #b0 #b100111100100101 #b00000)))

(assert (not (= expect result)))

(check-sat)
(exit)
