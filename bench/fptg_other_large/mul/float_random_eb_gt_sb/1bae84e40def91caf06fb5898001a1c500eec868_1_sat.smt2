(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b001001010011011011 #b001000001101001)
                arg1
                (fp #b1 #b000000000000000001 #b000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000001 #b000000000000000)
                arg1
                (fp #b0 #b110111110111011010 #b000011011010011)))

(declare-const arg2 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b111111100101000110 #b101010011001000)
                arg2
                (fp #b1 #b000000000000000000 #b010000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b010000000000000)
                arg2
                (fp #b0 #b100101001001101000 #b101000000100001)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b001110011010101111 #b001000011000000)
                expect
                (fp #b0 #b000000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b000000000000000)
                expect
                (fp #b0 #b111011010011110101 #b101100001110011)))

(assert (= expect result))

(check-sat)
(exit)
