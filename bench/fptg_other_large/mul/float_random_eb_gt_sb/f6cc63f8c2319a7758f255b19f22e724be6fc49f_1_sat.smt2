(assert (fp.leq (fp #b0 #b11000111011001 #b000100)
                arg2
                (fp #b0 #b11111100001110 #b000000)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11101101011011 #b011001)
                expect
                (fp #b1 #b11000111011010 #b000010)))
(assert (fp.leq (fp #b1 #b11000111011010 #b000010)
                expect
                (fp #b1 #b01110101101000 #b111101)))

(assert (= expect result))

(check-sat)
