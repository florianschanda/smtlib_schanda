; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11011011101 #b101011101)
                arg1
                (fp #b0 #b00000000000 #b111100110)))
(assert (fp.leq (fp #b0 #b00000000000 #b111100110)
                arg1
                (fp #b0 #b01000000000 #b110101010)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11100111010 #b111101111)
                arg2
                (fp #b1 #b10001101010 #b001001000)))
(assert (fp.leq (fp #b1 #b10001101010 #b001001000)
                arg2
                (fp #b0 #b01010111000 #b101110111)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00101000111 #b000110100)
                expect
                (fp #b1 #b00001101100 #b000101011)))
(assert (fp.leq (fp #b1 #b00001101100 #b000101011)
                expect
                (fp #b0 #b01100110101 #b110010001)))

(assert (not (= expect result)))

(check-sat)
(exit)
