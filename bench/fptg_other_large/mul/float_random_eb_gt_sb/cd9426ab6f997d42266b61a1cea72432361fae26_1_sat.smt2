(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111111111111 #b000000)
                arg1
                (fp #b1 #b111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b111111)
                arg1
                (fp #b0 #b000010100101 #b000001)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b011110111110 #b100101)
                arg2
                (fp #b1 #b001111001000 #b001010)))
(assert (fp.leq (fp #b1 #b001111001000 #b001010)
                arg2
                (fp #b0 #b111001010111 #b011111)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b001110111001 #b000110)
                expect
                (fp #b0 #b101111001000 #b001001)))
(assert (fp.leq (fp #b0 #b101111001000 #b001001)
                expect
                (fp #b0 #b111001111101 #b100100)))

(assert (= expect result))

(check-sat)
(exit)
