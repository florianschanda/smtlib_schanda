(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b0001011011000 #b01101111110)
                arg1
                (fp #b1 #b0000000000000 #b10011011110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b10011011110)
                arg1
                (fp #b0 #b1000001000010 #b11011110011)))

(declare-const arg2 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1110101000111 #b01110101111)
                arg2
                (fp #b1 #b0000000000000 #b11111111111)))
(assert (fp.leq (fp #b1 #b0000000000000 #b11111111111)
                arg2
                (fp #b0 #b0100101011101 #b11010000000)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b0010001111000 #b10011110001)
                expect
                (fp #b0 #b0000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000000001)
                expect
                (fp #b0 #b0000110100110 #b00010101001)))

(assert (= expect result))

(check-sat)
(exit)
