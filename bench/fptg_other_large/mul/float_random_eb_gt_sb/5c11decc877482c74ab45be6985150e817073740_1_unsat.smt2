; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b011011010010011100 #b00101010)
                arg1
                (fp #b0 #b010000000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b010000000000000000 #b00000000)
                arg1
                (fp #b0 #b110001111000100110 #b01111011)))

(declare-const arg2 (_ FloatingPoint 18 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
