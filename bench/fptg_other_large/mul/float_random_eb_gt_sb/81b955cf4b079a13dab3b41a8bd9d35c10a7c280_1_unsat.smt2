; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00011101110 #b101)
                arg1
                (fp #b0 #b00000000000 #b111)))
(assert (fp.leq (fp #b0 #b00000000000 #b111)
                arg1
                (fp #b0 #b01110100110 #b110)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11110111011 #b000)
                arg2
                (fp #b0 #b00000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000)
                arg2
                (fp #b0 #b01011010101 #b101)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11110111011 #b010)
                expect
                (fp #b0 #b00000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000)
                expect
                (fp #b0 #b10100000100 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
