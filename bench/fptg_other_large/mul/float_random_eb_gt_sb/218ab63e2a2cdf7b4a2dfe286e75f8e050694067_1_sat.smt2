(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b11000001100010100 #b0101001)
                arg1
                (fp #b1 #b01111111111111111 #b0101111)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0101111)
                arg1
                (fp #b0 #b10011110101010100 #b0001111)))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b11111111001110100 #b0101110)
                expect
                (fp #b1 #b01111111111111111 #b1101111)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1101111)
                expect
                (fp #b0 #b01101011100011101 #b1000101)))

(assert (= expect result))

(check-sat)
(exit)
