                arg2
                (fp #b1 #b11010110110101 #b11110100)))
(assert (fp.leq (fp #b1 #b11010110110101 #b11110100)
                arg2
                (fp #b0 #b11100101010011 #b01011111)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11101110111101 #b10010101)
                expect
                (fp #b1 #b01110001000010 #b00111000)))
(assert (fp.leq (fp #b1 #b01110001000010 #b00111000)
                expect
                (fp #b1 #b00111000101000 #b10101110)))

(assert (= expect result))

(check-sat)
(exit)
