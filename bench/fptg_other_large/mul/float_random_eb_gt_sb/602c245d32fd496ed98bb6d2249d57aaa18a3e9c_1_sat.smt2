(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001001001 #b1110)
                arg1
                (fp #b0 #b110010110 #b1001)))
(assert (fp.leq (fp #b0 #b110010110 #b1001)
                arg1
                (fp #b0 #b111010100 #b1001)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111000010 #b1010)
                arg2
                (fp #b0 #b000000000 #b0111)))
(assert (fp.leq (fp #b0 #b000000000 #b0111)
                arg2
                (fp #b0 #b001101111 #b0100)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110100111 #b0010)
                expect
                (fp #b0 #b010010111 #b0101)))
(assert (fp.leq (fp #b0 #b010010111 #b0101)
                expect
                (fp #b0 #b011101101 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
