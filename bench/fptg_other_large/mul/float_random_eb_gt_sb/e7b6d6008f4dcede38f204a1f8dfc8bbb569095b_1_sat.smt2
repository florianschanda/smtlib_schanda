(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101111011 #b100101)
                arg1
                (fp #b1 #b010000110 #b010111)))
(assert (fp.leq (fp #b1 #b010000110 #b010111)
                arg1
                (fp #b0 #b010111101 #b010111)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101011001 #b001010)
                arg2
                (fp #b0 #b100111111 #b100010)))
(assert (fp.leq (fp #b0 #b100111111 #b100010)
                arg2
                (fp #b0 #b111010001 #b011110)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111000001 #b010001)
                expect
                (fp #b1 #b011000111 #b000010)))
(assert (fp.leq (fp #b1 #b011000111 #b000010)
                expect
                (fp #b0 #b010010010 #b011011)))

(assert (= expect result))

(check-sat)
(exit)
