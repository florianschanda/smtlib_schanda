(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000000101 #b110)
                arg1
                (fp #b1 #b000000000 #b110)))
(assert (fp.leq (fp #b1 #b000000000 #b110)
                arg1
                (fp #b0 #b010010100 #b000)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111000010 #b010)
                arg2
                (fp #b0 #b000000000 #b010)))
(assert (fp.leq (fp #b0 #b000000000 #b010)
                arg2
                (fp #b0 #b010101110 #b001)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010000100 #b000)
                expect
                (fp #b1 #b000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000 #b000)
                expect
                (fp #b0 #b101000111 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
