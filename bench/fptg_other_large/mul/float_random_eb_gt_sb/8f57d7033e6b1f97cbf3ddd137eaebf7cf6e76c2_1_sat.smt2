(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b10001011110001000 #b110100100)
                arg1
                (fp #b0 #b10000000000001000 #b110100101)))
(assert (fp.leq (fp #b0 #b10000000000001000 #b110100101)
                arg1
                (fp #b0 #b10000110001001100 #b101011111)))

(declare-const arg2 (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b00110000001101010 #b001000110)
                arg2
                (fp #b1 #b00000000000000000 #b000001001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b000001001)
                arg2
                (fp #b0 #b01010000001101000 #b111101010)))

(declare-const result (_ FloatingPoint 17 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 10))
(assert (fp.leq (fp #b1 #b11100010110001111 #b110001110)
                expect
                (fp #b1 #b00000000000000101 #b000001100)))
(assert (fp.leq (fp #b1 #b00000000000000101 #b000001100)
                expect
                (fp #b0 #b10101111101010001 #b100001111)))

(assert (= expect result))

(check-sat)
(exit)
