(assert (fp.leq (fp #b0 #b100000000011 #b00110)
                arg2
                (fp #b0 #b111010111010 #b11011)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b000101100011 #b01100)
                expect
                (fp #b0 #b100000001000 #b10100)))
(assert (fp.leq (fp #b0 #b100000001000 #b10100)
                expect
                (fp #b0 #b100101000010 #b10111)))

(assert (not (= expect result)))

(check-sat)
