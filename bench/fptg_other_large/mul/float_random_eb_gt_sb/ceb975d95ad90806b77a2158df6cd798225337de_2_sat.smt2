(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1101010101000011 #b00011000101011)
                arg1
                (fp #b1 #b1000000000001101 #b11110010010110)))
(assert (fp.leq (fp #b1 #b1000000000001101 #b11110010010110)
                arg1
                (fp #b0 #b1100001000000101 #b00111001100001)))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b0111111011100000 #b10101011110101)
                arg2
                (fp #b1 #b0000000000000000 #b11011101111011)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b11011101111011)
                arg2
                (fp #b0 #b1111100100100000 #b11000101110101)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1010010000100100 #b11110001011011)
                expect
                (fp #b0 #b0000000000001111 #b10110000000001)))
(assert (fp.leq (fp #b0 #b0000000000001111 #b10110000000001)
                expect
                (fp #b0 #b1100011011100110 #b00001001110001)))

(assert (= expect result))

(check-sat)
(exit)
