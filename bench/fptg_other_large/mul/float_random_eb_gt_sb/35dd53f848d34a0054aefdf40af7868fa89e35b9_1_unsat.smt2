; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b101110110000100000 #b001)
                arg1
                (fp #b0 #b001001000010111011 #b100)))
(assert (fp.leq (fp #b0 #b001001000010111011 #b100)
                arg1
                (fp #b0 #b010111011010111110 #b001)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b001011000011001101 #b111)
                arg2
                (fp #b0 #b100010100110101001 #b101)))
(assert (fp.leq (fp #b0 #b100010100110101001 #b101)
                arg2
                (fp #b0 #b111111110000011110 #b011)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b010011101011101000 #b001)
                expect
                (fp #b0 #b001011101001100110 #b001)))
(assert (fp.leq (fp #b0 #b001011101001100110 #b001)
                expect
                (fp #b0 #b110111111110011001 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
