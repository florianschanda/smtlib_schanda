(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10100100111 #b1)
                arg1
                (fp #b1 #b00100001001 #b0)))
(assert (fp.leq (fp #b1 #b00100001001 #b0)
                arg1
                (fp #b0 #b01011101010 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11110011110 #b1)
                arg2
                (fp #b1 #b11100110111 #b1)))
(assert (fp.leq (fp #b1 #b11100110111 #b1)
                arg2
                (fp #b0 #b00111101100 #b1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b01000101010 #b1)
                expect
                (fp #b0 #b10001000001 #b1)))
(assert (fp.leq (fp #b0 #b10001000001 #b1)
                expect
                (fp #b0 #b11110100000 #b1)))

(assert (= expect result))

(check-sat)
(exit)
