(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011110010001 #b101)
                arg1
                (fp #b0 #b000000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000)
                arg1
                (fp #b0 #b110001010100 #b110)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111101011111 #b101)
                arg2
                (fp #b1 #b101111111110 #b111)))
(assert (fp.leq (fp #b1 #b101111111110 #b111)
                arg2
                (fp #b1 #b000011011011 #b111)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000010000100 #b011)
                expect
                (fp #b1 #b000000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000000 #b000)
                expect
                (fp #b0 #b000100110111 #b110)))

(assert (= expect result))

(check-sat)
(exit)
