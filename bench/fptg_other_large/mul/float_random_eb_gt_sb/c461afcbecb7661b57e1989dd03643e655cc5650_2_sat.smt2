(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b00111100110100111 #b1111100)
                arg1
                (fp #b1 #b00000000000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0000001)
                arg1
                (fp #b0 #b11111110100100100 #b1101001)))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b0 #b00011110000011100 #b1111100)
                arg2
                (fp #b0 #b01000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b01000000000000000 #b0000000)
                arg2
                (fp #b0 #b10110100100001000 #b0111001)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b10000111111111001 #b1100110)
                expect
                (fp #b1 #b00000000000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0000001)
                expect
                (fp #b0 #b01111010000110100 #b1000101)))

(assert (= expect result))

(check-sat)
(exit)
