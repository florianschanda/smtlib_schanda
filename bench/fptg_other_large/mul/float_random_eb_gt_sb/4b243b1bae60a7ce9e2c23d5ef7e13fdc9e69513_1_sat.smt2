(assert (fp.leq (fp #b1 #b00101000010101 #b110001)
                arg2
                (fp #b0 #b10010101111000 #b001000)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11111101010101 #b101001)
                expect
                (fp #b1 #b00101000011011 #b111101)))
(assert (fp.leq (fp #b1 #b00101000011011 #b111101)
                expect
                (fp #b0 #b11000110000111 #b000110)))

(assert (= expect result))

(check-sat)
