(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10010110011100101 #b100)
                arg1
                (fp #b0 #b11111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b11111111111111101 #b000)
                arg1
                (fp #b0 #b11111111111111101 #b101)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10000001000101111 #b011)
                arg2
                (fp #b1 #b10000000000000010 #b001)))
(assert (fp.leq (fp #b1 #b10000000000000010 #b001)
                arg2
                (fp #b0 #b10101101000100111 #b010)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
