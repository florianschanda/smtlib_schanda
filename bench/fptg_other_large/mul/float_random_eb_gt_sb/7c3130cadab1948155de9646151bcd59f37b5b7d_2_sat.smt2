; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL
; Arg2: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b01000001100110100 #b11001101)
                arg1
                (fp #b1 #b00000000000000000 #b11111111)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b11111111)
                arg1
                (fp #b0 #b01011001101011010 #b10010010)))

(declare-const arg2 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b11100111000010110 #b01010101)
                arg2
                (fp #b0 #b10000000000000111 #b01101001)))
(assert (fp.leq (fp #b0 #b10000000000000111 #b01101001)
                arg2
                (fp #b0 #b11010011111000101 #b01101011)))

(declare-const result (_ FloatingPoint 17 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b00010101110100011 #b10110110)
                expect
                (fp #b1 #b00000000000001001 #b01101000)))
(assert (fp.leq (fp #b1 #b00000000000001001 #b01101000)
                expect
                (fp #b0 #b00100010110001011 #b11110001)))

(assert (= expect result))

(check-sat)
(exit)
