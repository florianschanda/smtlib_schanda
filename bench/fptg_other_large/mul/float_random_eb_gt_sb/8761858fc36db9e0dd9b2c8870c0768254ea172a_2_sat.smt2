; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b10000100010011001 #b0110011)
                arg1
                (fp #b1 #b01010001111111111 #b0101000)))
(assert (fp.leq (fp #b1 #b01010001111111111 #b0101000)
                arg1
                (fp #b0 #b10100011100010011 #b1001101)))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b0 #b00000001011100000 #b0100100)
                arg2
                (fp #b0 #b01111111100010110 #b0011011)))
(assert (fp.leq (fp #b0 #b01111111100010110 #b0011011)
                arg2
                (fp #b0 #b11001101110001101 #b0001000)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b10010011000100010 #b1010101)
                expect
                (fp #b1 #b01010001100010110 #b1001100)))
(assert (fp.leq (fp #b1 #b01010001100010110 #b1001100)
                expect
                (fp #b0 #b00110001001001000 #b1101010)))

(assert (= expect result))

(check-sat)
(exit)
