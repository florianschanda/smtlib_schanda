; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RNE)))
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b0 #b0111000000010011 #b11111101)
                arg1
                (fp #b0 #b1000000000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b1000000000000010 #b00100000)
                arg1
                (fp #b0 #b1010101011101010 #b01100011)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1100111000001010 #b01000010)
                arg2
                (fp #b1 #b1000000000000111 #b10010100)))
(assert (fp.leq (fp #b1 #b1000000000000111 #b10010100)
                arg2
                (fp #b0 #b0001111110101010 #b01101000)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1100110001001010 #b11001100)
                expect
                (fp #b1 #b1000000000001010 #b11000111)))
(assert (fp.leq (fp #b1 #b1000000000001010 #b11000111)
                expect
                (fp #b0 #b1011110111110000 #b11011101)))

(assert (= expect result))

(check-sat)
(exit)
