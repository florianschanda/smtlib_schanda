(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b111001100 #b1010)
                arg1
                (fp #b0 #b000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000)
                arg1
                (fp #b0 #b010110010 #b1101)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b011101110 #b0000)
                arg2
                (fp #b1 #b000000011 #b0101)))
(assert (fp.leq (fp #b1 #b000000011 #b0101)
                arg2
                (fp #b0 #b011110011 #b1011)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010101011 #b1110)
                expect
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                expect
                (fp #b0 #b011011111 #b1010)))

(assert (not (= expect result)))

(check-sat)
(exit)
