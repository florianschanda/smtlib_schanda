(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011011010101 #b01001100)
                arg1
                (fp #b0 #b000000000000 #b10100110)))
(assert (fp.leq (fp #b0 #b000000000000 #b10100110)
                arg1
                (fp #b0 #b011101010000 #b01011111)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011010101011 #b11101100)
                arg2
                (fp #b1 #b010101001111 #b10100110)))
(assert (fp.leq (fp #b1 #b010101001111 #b10100110)
                arg2
                (fp #b0 #b010010011001 #b00111011)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000001110110 #b10100010)
                expect
                (fp #b1 #b000000000000 #b00000001)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000001)
                expect
                (fp #b0 #b010100000100 #b10111101)))

(assert (= expect result))

(check-sat)
(exit)
