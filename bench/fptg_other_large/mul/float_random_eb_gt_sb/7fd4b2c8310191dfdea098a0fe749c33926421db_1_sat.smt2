(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100001101110 #b010110)
                arg1
                (fp #b0 #b101111111110 #b111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b111111)
                arg1
                (fp #b0 #b111110101100 #b110100)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111111111110 #b011000)
                arg2
                (fp #b1 #b111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b000000)
                arg2
                (fp #b1 #b111001111001 #b110000)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111111111111 #b000000)
                expect
                (fp #b1 #b111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b111111)
                expect
                (fp #b0 #b100111100000 #b001000)))

(assert (= expect result))

(check-sat)
(exit)
