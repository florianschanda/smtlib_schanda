(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0101011110000000 #b11000)
                arg1
                (fp #b1 #b0000000000000000 #b00001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00001)
                arg1
                (fp #b0 #b1100110111101111 #b01110)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1011111011111010 #b00101)
                arg2
                (fp #b1 #b0111111111111111 #b00110)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b00110)
                arg2
                (fp #b0 #b0010100011110001 #b11011)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1001011010110010 #b10110)
                expect
                (fp #b0 #b0000000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00001)
                expect
                (fp #b0 #b1111011000010101 #b00101)))

(assert (not (= expect result)))

(check-sat)
(exit)
