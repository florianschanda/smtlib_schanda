; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111010100000010 #b00101)
                arg1
                (fp #b0 #b000000000000000 #b11001)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11001)
                arg1
                (fp #b0 #b110101010110011 #b00011)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111100000110011 #b01000)
                arg2
                (fp #b1 #b000000000000001 #b00000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b00000)
                arg2
                (fp #b0 #b010001100110010 #b10000)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000101111010000 #b01100)
                expect
                (fp #b1 #b000000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000)
                expect
                (fp #b0 #b101010011100110 #b10010)))

(assert (not (= expect result)))

(check-sat)
(exit)
