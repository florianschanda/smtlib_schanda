(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11101001001111 #b10010)
                arg1
                (fp #b0 #b00000000000000 #b11001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b11001)
                arg1
                (fp #b0 #b00110111111111 #b00101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11011101001101 #b00100)
                arg2
                (fp #b0 #b10111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b11111)
                arg2
                (fp #b0 #b11001110011110 #b01100)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11001001000011 #b10100)
                expect
                (fp #b0 #b01000000000000 #b10010)))
(assert (fp.leq (fp #b0 #b01000000000000 #b10010)
                expect
                (fp #b0 #b01101011000010 #b00100)))

(assert (not (= expect result)))

(check-sat)
(exit)
