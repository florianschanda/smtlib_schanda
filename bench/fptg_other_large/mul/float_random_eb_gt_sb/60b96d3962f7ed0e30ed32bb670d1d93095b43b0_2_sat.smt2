(assert (fp.leq (fp #b1 #b000000000000000000 #b01000000000)
                arg2
                (fp #b0 #b111101111010011010 #b01000101011)))

(declare-const result (_ FloatingPoint 18 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 12))
(assert (fp.leq (fp #b1 #b100000001100000000 #b01011110100)
                expect
                (fp #b0 #b000000000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b00000000001)
                expect
                (fp #b0 #b100101100001000100 #b01101001111)))

(assert (= expect result))

(check-sat)
(exit)
