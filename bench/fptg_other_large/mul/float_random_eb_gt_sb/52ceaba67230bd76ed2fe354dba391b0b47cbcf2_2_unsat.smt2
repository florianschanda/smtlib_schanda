;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00111010000000 #b011110110)
                arg1
                (fp #b0 #b01000111110010 #b001001000)))
(assert (fp.leq (fp #b0 #b01000111110010 #b001001000)
                arg1
                (fp #b0 #b11011101000101 #b101010101)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10101001010001 #b000100100)
                arg2
                (fp #b1 #b01111111111111 #b010001010)))
(assert (fp.leq (fp #b1 #b01111111111111 #b010001010)
                arg2
                (fp #b1 #b00001110100101 #b011010001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b01011001000001 #b100111001)
                expect
                (fp #b1 #b01000111110010 #b011100110)))
(assert (fp.leq (fp #b1 #b01000111110010 #b011100110)
                expect
                (fp #b0 #b00111100110111 #b000111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
