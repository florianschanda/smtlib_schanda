(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b110011100101010 #b0111010100110)
                arg1
                (fp #b1 #b011001010011111 #b1001010000110)))
(assert (fp.leq (fp #b1 #b011001010011111 #b1001010000110)
                arg1
                (fp #b0 #b111110101110001 #b0001010000000)))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b111011110010001 #b1110011010101)
                arg2
                (fp #b1 #b000000000000000 #b1111111111111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1111111111111)
                arg2
                (fp #b0 #b100111100111000 #b0100111010010)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b100000101011111 #b0000010101000)
                expect
                (fp #b0 #b000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000000000)
                expect
                (fp #b0 #b100000111101100 #b0000000101010)))

(assert (= expect result))

(check-sat)
(exit)
