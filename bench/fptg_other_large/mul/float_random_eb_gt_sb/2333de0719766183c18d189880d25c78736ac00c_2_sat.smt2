;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1011000101001 #b0010001100)
                arg1
                (fp #b1 #b1000000000111 #b0000100000)))
(assert (fp.leq (fp #b1 #b1000000000111 #b0000100000)
                arg1
                (fp #b0 #b1001000011100 #b0011111110)))

