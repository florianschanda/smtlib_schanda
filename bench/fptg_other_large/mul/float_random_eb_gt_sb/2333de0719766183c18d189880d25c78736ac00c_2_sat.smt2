(assert (fp.leq (fp #b0 #b0001101011111 #b0010110101)
                arg2
                (fp #b0 #b0111111111111 #b0010110101)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0010110101)
                arg2
                (fp #b0 #b1101010101010 #b1110000001)))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1010001001000 #b1001010010)
                expect
                (fp #b1 #b1000000000111 #b0011011011)))
(assert (fp.leq (fp #b1 #b1000000000111 #b0011011011)
                expect
                (fp #b0 #b0001100010100 #b1100011000)))

(assert (= expect result))

(check-sat)
(exit)
