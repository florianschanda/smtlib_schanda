; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b0110100111100 #b11)
                arg1
                (fp #b0 #b0111111111111 #b11)))
(assert (fp.leq (fp #b0 #b0111111111111 #b11)
                arg1
                (fp #b0 #b1101001010001 #b10)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1001010110001 #b11)
                arg2
                (fp #b0 #b0000000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000000 #b01)
                arg2
                (fp #b0 #b0000111001111 #b01)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1001001100110 #b10)
                expect
                (fp #b0 #b0000000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000000 #b10)
                expect
                (fp #b0 #b0000100001000 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
