(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110101110 #b011)
                arg1
                (fp #b1 #b1000000010 #b110)))
(assert (fp.leq (fp #b1 #b1000000010 #b110)
                arg1
                (fp #b0 #b1110000100 #b001)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1101011011 #b000)
                arg2
                (fp #b0 #b0000000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000000 #b110)
                arg2
                (fp #b0 #b0001001101 #b100)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010001001 #b000)
                expect
                (fp #b1 #b0000000100 #b010)))
(assert (fp.leq (fp #b1 #b0000000100 #b010)
                expect
                (fp #b0 #b0011011011 #b011)))

(assert (= expect result))

(check-sat)
(exit)
