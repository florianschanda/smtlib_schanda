(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b101101101010101 #b0111000110)
                arg1
                (fp #b1 #b101000001101100 #b0011101100)))
(assert (fp.leq (fp #b1 #b101000001101100 #b0011101100)
                arg1
                (fp #b1 #b000010110111100 #b1101011110)))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b000010100011101 #b1101001000)
                arg2
                (fp #b1 #b000000000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1000101100)
                arg2
                (fp #b0 #b111001101110000 #b1100110001)))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b1 #b110010111100110 #b1000111100)
                expect
                (fp #b0 #b001000001101101 #b0101011001)))
(assert (fp.leq (fp #b0 #b001000001101101 #b0101011001)
                expect
                (fp #b0 #b110110101101111 #b0111000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
