(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b01001101010 #b001011101)
                arg1
                (fp #b0 #b10000011111 #b110011111)))
(assert (fp.leq (fp #b0 #b10000011111 #b110011111)
                arg1
                (fp #b0 #b11010111001 #b011100000)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11001101001 #b000001000)
                arg2
                (fp #b0 #b00000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b00000000000 #b100101010)
                arg2
                (fp #b0 #b10000001100 #b101011000)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10101000000 #b000010001)
                expect
                (fp #b0 #b00000100001 #b000011100)))
(assert (fp.leq (fp #b0 #b00000100001 #b000011100)
                expect
                (fp #b0 #b11110000001 #b000101000)))

(assert (= expect result))

(check-sat)
(exit)
