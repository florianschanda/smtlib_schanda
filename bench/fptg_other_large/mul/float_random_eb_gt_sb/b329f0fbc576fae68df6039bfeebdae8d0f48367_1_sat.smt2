                arg2
                (fp #b1 #b000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b0000000)
                arg2
                (fp #b0 #b011001000001 #b1000000)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111110000001 #b1110000)
                expect
                (fp #b1 #b000000001001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000001001 #b0000000)
                expect
                (fp #b0 #b001111111110 #b0110001)))

(assert (= expect result))

(check-sat)
(exit)
