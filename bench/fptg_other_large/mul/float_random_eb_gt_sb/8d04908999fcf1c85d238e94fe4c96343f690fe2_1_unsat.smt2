; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1010001011001 #b01)
                arg1
                (fp #b0 #b0000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00)
                arg1
                (fp #b0 #b1001000110101 #b11)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1101011110010 #b01)
                arg2
                (fp #b1 #b1100101111010 #b10)))
(assert (fp.leq (fp #b1 #b1100101111010 #b10)
                arg2
                (fp #b1 #b0001100000011 #b00)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1000111001111 #b01)
                expect
                (fp #b1 #b0000000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00)
                expect
                (fp #b0 #b0011000100111 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
