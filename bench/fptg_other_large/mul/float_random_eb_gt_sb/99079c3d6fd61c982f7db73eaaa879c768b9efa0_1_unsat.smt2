; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111111111 #b000000)
                arg1
                (fp #b1 #b111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111110 #b111111)
                arg1
                (fp #b0 #b000000110 #b011011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b110110000 #b101111)
                arg2
                (fp #b1 #b101111010 #b011000)))
(assert (fp.leq (fp #b1 #b101111010 #b011000)
                arg2
                (fp #b1 #b010111100 #b011111)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001100010 #b001000)
                expect
                (fp #b0 #b111111110 #b111111)))
(assert (fp.leq (fp #b0 #b111111110 #b111111)
                expect
                (fp #b0 #b111111111 #b000000)))

(assert (not (= expect result)))

(check-sat)
(exit)
