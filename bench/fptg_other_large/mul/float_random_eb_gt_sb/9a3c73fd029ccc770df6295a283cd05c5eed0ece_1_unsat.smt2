; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b01110001100101 #b01011)
                arg1
                (fp #b0 #b00111111111101 #b01101)))
(assert (fp.leq (fp #b0 #b00111111111101 #b01101)
                arg1
                (fp #b0 #b01010110010011 #b10000)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11001000001111 #b01001)
                arg2
                (fp #b1 #b00000000000000 #b10110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b10110)
                arg2
                (fp #b0 #b11110100010110 #b00101)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01011001101111 #b01100)
                expect
                (fp #b1 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000)
                expect
                (fp #b0 #b01100111011011 #b01100)))

(assert (not (= expect result)))

(check-sat)
(exit)
