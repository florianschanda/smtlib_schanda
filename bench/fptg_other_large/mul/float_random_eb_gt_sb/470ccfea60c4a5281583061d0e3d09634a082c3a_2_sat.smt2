(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101010100000 #b010)
                arg1
                (fp #b0 #b000000000000 #b110)))
(assert (fp.leq (fp #b0 #b000000000000 #b110)
                arg1
                (fp #b0 #b000111001110 #b010)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b001110010100 #b010)
                arg2
                (fp #b0 #b000000000000 #b111)))
(assert (fp.leq (fp #b0 #b000000000000 #b111)
                arg2
                (fp #b0 #b010100010101 #b111)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100011000000 #b100)
                expect
                (fp #b0 #b000000000000 #b001)))
(assert (fp.leq (fp #b0 #b000000000000 #b001)
                expect
                (fp #b0 #b100100011111 #b100)))

(assert (= expect result))

(check-sat)
(exit)
