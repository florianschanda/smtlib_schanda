(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b101011011111001 #b10001011)
                arg1
                (fp #b0 #b111111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b11111111)
                arg1
                (fp #b0 #b111111111111111 #b00000000)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b001011110010100 #b01110110)
                arg2
                (fp #b0 #b000000000000000 #b11111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111111)
                arg2
                (fp #b0 #b011101101000000 #b01111111)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b100111001010111 #b10100101)
                expect
                (fp #b0 #b100000000000000 #b11111110)))
(assert (fp.leq (fp #b0 #b100000000000000 #b11111110)
                expect
                (fp #b0 #b111110000110000 #b10011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
