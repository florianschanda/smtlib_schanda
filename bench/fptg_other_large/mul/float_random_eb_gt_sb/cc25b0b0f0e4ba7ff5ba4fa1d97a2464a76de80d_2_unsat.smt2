(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110110110100 #b0010101)
                arg1
                (fp #b1 #b100011001000 #b0111101)))
(assert (fp.leq (fp #b1 #b100011001000 #b0111101)
                arg1
                (fp #b1 #b011100100101 #b0110011)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000000100110 #b1011110)
                arg2
                (fp #b0 #b000000000000 #b1100000)))
(assert (fp.leq (fp #b0 #b000000000000 #b1100000)
                arg2
                (fp #b0 #b110110000010 #b0011101)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b001010011010 #b0011001)
                expect
                (fp #b1 #b000011001010 #b0001110)))
(assert (fp.leq (fp #b1 #b000011001010 #b0001110)
                expect
                (fp #b0 #b100101010101 #b1011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
