; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11000111101011 #b1111111010)
                arg1
                (fp #b1 #b00000000000000 #b1110100001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1110100001)
                arg1
                (fp #b0 #b11001011110111 #b0000101101)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b10001110100101 #b1010101000)
                arg2
                (fp #b1 #b10000000001000 #b0100001100)))
(assert (fp.leq (fp #b1 #b10000000001000 #b0100001100)
                arg2
                (fp #b0 #b01111010110000 #b1010001001)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11101100101100 #b0101100000)
                expect
                (fp #b0 #b00000000001010 #b0010010100)))
(assert (fp.leq (fp #b0 #b00000000001010 #b0010010100)
                expect
                (fp #b0 #b11110100001100 #b0000100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
