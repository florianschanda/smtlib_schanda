(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10111111011100 #b101100100)
                arg1
                (fp #b1 #b00000000000000 #b000000001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b000000001)
                arg1
                (fp #b0 #b01100101111111 #b100010101)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b01000011000010 #b001011111)
                arg2
                (fp #b1 #b00000000000000 #b000001001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b000001001)
                arg2
                (fp #b0 #b01101000101110 #b110101010)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10101110111010 #b101100000)
                expect
                (fp #b0 #b00000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000000000)
                expect
                (fp #b0 #b00000110010011 #b001011001)))

(assert (not (= expect result)))

(check-sat)
(exit)
