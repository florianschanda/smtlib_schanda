(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1100110111 #b00010110)
                arg1
                (fp #b1 #b1100100100 #b10000101)))
(assert (fp.leq (fp #b1 #b1100100100 #b10000101)
                arg1
                (fp #b0 #b1111011101 #b00000101)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1011011000 #b10110000)
                arg2
                (fp #b1 #b0000000000 #b00100111)))
(assert (fp.leq (fp #b1 #b0000000000 #b00100111)
                arg2
                (fp #b0 #b1111011010 #b00101110)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111100001 #b01111110)
                expect
                (fp #b0 #b0100100011 #b11011010)))
(assert (fp.leq (fp #b0 #b0100100011 #b11011010)
                expect
                (fp #b0 #b1101110100 #b10100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
