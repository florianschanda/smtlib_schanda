; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111011101011000 #b0111)
                arg1
                (fp #b1 #b1110111101001100 #b0010)))
(assert (fp.leq (fp #b1 #b1110111101001100 #b0010)
                arg1
                (fp #b0 #b0101001111000100 #b0101)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1101110100010001 #b0100)
                arg2
                (fp #b0 #b1000000000000001 #b1000)))
(assert (fp.leq (fp #b0 #b1000000000000001 #b1000)
                arg2
                (fp #b0 #b1000110001000111 #b0110)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111110111110001 #b1111)
                expect
                (fp #b1 #b1110111101001110 #b1011)))
(assert (fp.leq (fp #b1 #b1110111101001110 #b1011)
                expect
                (fp #b1 #b1011001110100100 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
