(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b10000100110010 #b00011)
                arg1
                (fp #b0 #b10110100001101 #b00100)))
(assert (fp.leq (fp #b0 #b10110100001101 #b00100)
                arg1
                (fp #b0 #b11011111110101 #b01111)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b01110111101011 #b00110)
                arg2
                (fp #b0 #b10000101001011 #b10001)))
(assert (fp.leq (fp #b0 #b10000101001011 #b10001)
                arg2
                (fp #b0 #b10111100100110 #b11110)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b00001011111010 #b01001)
                expect
                (fp #b0 #b10111001011001 #b10111)))
(assert (fp.leq (fp #b0 #b10111001011001 #b10111)
                expect
                (fp #b0 #b11111000001100 #b11101)))

(assert (= expect result))

(check-sat)
(exit)
