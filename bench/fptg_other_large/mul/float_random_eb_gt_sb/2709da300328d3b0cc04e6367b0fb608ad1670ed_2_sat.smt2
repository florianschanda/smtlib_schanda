(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111000111 #b100101)
                arg1
                (fp #b0 #b0000000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000001)
                arg1
                (fp #b0 #b1001100010 #b100100)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1110111100 #b111001)
                arg2
                (fp #b1 #b0000000000 #b000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000001)
                arg2
                (fp #b0 #b0011100111 #b101010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0101011001 #b110101)
                expect
                (fp #b1 #b0000000000 #b000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000001)
                expect
                (fp #b0 #b1111010010 #b111110)))

(assert (= expect result))

(check-sat)
(exit)
