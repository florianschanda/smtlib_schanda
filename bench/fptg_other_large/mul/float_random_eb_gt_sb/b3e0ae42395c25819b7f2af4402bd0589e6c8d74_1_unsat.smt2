; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1000110000000001 #b01100101000)
                arg1
                (fp #b0 #b0000000000000000 #b00000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000001)
                arg1
                (fp #b0 #b0101000001100100 #b01010000010)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b0010000000111011 #b10000110001)
                arg2
                (fp #b0 #b0011111111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b0011111111111010 #b01101010000)
                arg2
                (fp #b0 #b0110000001110010 #b11010101111)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0010101001000100 #b10111101110)
                expect
                (fp #b0 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000000)
                expect
                (fp #b0 #b0111000100111010 #b11110110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
