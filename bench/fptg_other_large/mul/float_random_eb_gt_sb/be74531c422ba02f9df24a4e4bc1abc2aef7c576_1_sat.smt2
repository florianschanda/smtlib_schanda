(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100101000 #b000100)
                arg1
                (fp #b1 #b010000110 #b010111)))
(assert (fp.leq (fp #b1 #b010000110 #b010111)
                arg1
                (fp #b0 #b101010101 #b101011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011000100 #b001100)
                arg2
                (fp #b1 #b000000000 #b000001)))
(assert (fp.leq (fp #b1 #b000000000 #b000001)
                arg2
                (fp #b0 #b011010111 #b101011)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111001100 #b001101)
                expect
                (fp #b0 #b000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000)
                expect
                (fp #b0 #b001000111 #b100000)))

(assert (= expect result))

(check-sat)
(exit)
