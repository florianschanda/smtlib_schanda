(assert (fp.leq (fp #b1 #b011111111111111111 #b0001101)
                arg2
                (fp #b0 #b101010111101101101 #b1010000)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b101100110000111101 #b0101111)
                expect
                (fp #b0 #b010000000000000000 #b0001101)))
(assert (fp.leq (fp #b0 #b010000000000000000 #b0001101)
                expect
                (fp #b0 #b010111000110001000 #b1010110)))

(assert (= expect result))

(check-sat)
(exit)
