(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: -LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b0 #b010000111011100111 #b11)
                arg1
                (fp #b0 #b100000000000000001 #b11)))
(assert (fp.leq (fp #b0 #b100000000000000001 #b11)
                arg1
                (fp #b0 #b101100001000000101 #b01)))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b101100000010100010 #b01)
                arg2
                (fp #b1 #b000000000000000000 #b11)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b11)
                arg2
                (fp #b0 #b100010000001111010 #b10)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b000101010100001100 #b01)
                expect
                (fp #b1 #b000000000000000011 #b01)))
(assert (fp.leq (fp #b1 #b000000000000000011 #b01)
                expect
                (fp #b0 #b011101010000010000 #b11)))

(assert (= expect result))

(check-sat)
(exit)
