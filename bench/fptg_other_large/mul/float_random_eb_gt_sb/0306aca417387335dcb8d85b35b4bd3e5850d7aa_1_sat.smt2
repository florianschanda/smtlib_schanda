(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b100001010110001111 #b011)
                arg1
                (fp #b1 #b100000000000000010 #b110)))
(assert (fp.leq (fp #b1 #b100000000000000010 #b110)
                arg1
                (fp #b0 #b111001011000010001 #b100)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b111110000001001110 #b000)
                expect
                (fp #b1 #b100000000000000110 #b100)))
(assert (fp.leq (fp #b1 #b100000000000000110 #b100)
                expect
                (fp #b1 #b001111011001000011 #b010)))

(assert (= expect result))

(check-sat)
(exit)
