(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: -NAN

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100111000110 #b1000)
                arg1
                (fp #b1 #b000000000001 #b0000)))
(assert (fp.leq (fp #b1 #b000000000001 #b0000)
                arg1
                (fp #b0 #b011111010001 #b0101)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
