(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b10000000010100 #b0)
                arg1
                (fp #b1 #b01100000100111 #b1)))
(assert (fp.leq (fp #b1 #b01100000100111 #b1)
                arg1
                (fp #b0 #b10000110000010 #b1)))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b01101101111001 #b1)
                arg2
                (fp #b0 #b00000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0)
                arg2
                (fp #b0 #b01110011010011 #b1)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10110010111011 #b1)
                expect
                (fp #b1 #b00000000000000 #b0)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0)
                expect
                (fp #b0 #b11111101101000 #b0)))

(assert (= expect result))

(check-sat)
(exit)
