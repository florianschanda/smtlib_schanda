; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RNE) (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b001110101011000110 #b01001)
                arg1
                (fp #b0 #b100000000000000100 #b01100)))
(assert (fp.leq (fp #b0 #b100000000000000100 #b01100)
                arg1
                (fp #b0 #b111001011110010000 #b10001)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b0 #b001011011110000011 #b00110)
                expect
                (fp #b0 #b100000000000001001 #b11100)))
(assert (fp.leq (fp #b0 #b100000000000001001 #b11100)
                expect
                (fp #b0 #b110001001011001000 #b10101)))

(assert (not (= expect result)))

(check-sat)
(exit)
