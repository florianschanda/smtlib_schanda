(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11111111111111 #b000000000)
                arg1
                (fp #b1 #b11111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111111111)
                arg1
                (fp #b1 #b10101000001010 #b100110110)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11000011001000 #b110101011)
                arg2
                (fp #b1 #b00000000000000 #b010000100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000100)
                arg2
                (fp #b0 #b00110110010010 #b000011111)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b0 #b00010010011110 #b010010011)
                expect
                (fp #b0 #b01111111111111 #b000010000)))
(assert (fp.leq (fp #b0 #b01111111111111 #b000010000)
                expect
                (fp #b0 #b11111001011100 #b010001110)))

(assert (= expect result))

(check-sat)
(exit)
