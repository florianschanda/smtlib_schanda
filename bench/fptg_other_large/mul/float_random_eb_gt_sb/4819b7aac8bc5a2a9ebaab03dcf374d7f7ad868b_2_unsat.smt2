(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +REFERENCE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0001001000 #b1111001)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b0010100000 #b1101100)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0010001011 #b0011010)
                expect
                (fp #b0 #b0000000000 #b0000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000001)
                expect
                (fp #b0 #b0001001100 #b1111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
