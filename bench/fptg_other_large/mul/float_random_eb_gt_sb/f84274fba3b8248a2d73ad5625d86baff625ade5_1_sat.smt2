(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b101000110 #b1)
                arg1
                (fp #b1 #b011111111 #b1)))
(assert (fp.leq (fp #b1 #b011111111 #b1)
                arg1
                (fp #b0 #b001010110 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b010000111 #b0)
                arg2
                (fp #b1 #b001010000 #b0)))
(assert (fp.leq (fp #b1 #b001010000 #b0)
                arg2
                (fp #b0 #b111110110 #b0)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111000011 #b1)
                expect
                (fp #b0 #b001010000 #b1)))
(assert (fp.leq (fp #b0 #b001010000 #b1)
                expect
                (fp #b0 #b001111011 #b1)))

(assert (= expect result))

(check-sat)
(exit)
