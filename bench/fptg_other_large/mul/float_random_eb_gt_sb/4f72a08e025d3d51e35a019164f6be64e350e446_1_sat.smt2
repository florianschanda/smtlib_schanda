(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b111101011 #b1100)
                arg1
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg1
                (fp #b0 #b010010000 #b0010)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111111100 #b1001)
                arg2
                (fp #b1 #b111101011 #b0101)))
(assert (fp.leq (fp #b1 #b111101011 #b0101)
                arg2
                (fp #b1 #b010001000 #b1000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101111011 #b0101)
                expect
                (fp #b0 #b000000000 #b0000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000)
                expect
                (fp #b0 #b001010101 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
