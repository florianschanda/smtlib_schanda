; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b0001101110101001 #b1101111111011)
                arg1
                (fp #b0 #b1100110100100110 #b0010110100010)))
(assert (fp.leq (fp #b0 #b1100110100100110 #b0010110100010)
                arg1
                (fp #b0 #b1111111110110011 #b1011111100100)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b0 #b0001001010100010 #b1100010010011)
                arg2
                (fp #b0 #b0011111111111001 #b0110101000001)))
(assert (fp.leq (fp #b0 #b0011111111111001 #b0110101000001)
                arg2
                (fp #b0 #b1110100110001101 #b0011011010001)))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b0 #b0000100010010010 #b0011011010101)
                expect
                (fp #b0 #b1000110100100000 #b1010100111000)))
(assert (fp.leq (fp #b0 #b1000110100100000 #b1010100111000)
                expect
                (fp #b0 #b1111110010111000 #b1001011011001)))

(assert (= expect result))

(check-sat)
(exit)
