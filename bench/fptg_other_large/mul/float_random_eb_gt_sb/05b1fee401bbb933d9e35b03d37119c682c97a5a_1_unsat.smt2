;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b001110011 #b10)
                arg1
                (fp #b0 #b111111110 #b11)))
(assert (fp.leq (fp #b0 #b111111110 #b11)
                arg1
                (fp #b0 #b111111111 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111110001 #b10)
                arg2
                (fp #b0 #b011111111 #b00)))
(assert (fp.leq (fp #b0 #b011111111 #b00)
                arg2
                (fp #b0 #b111101100 #b00)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b0 #b111000100 #b00)
                expect
                (fp #b0 #b111111110 #b11)))
(assert (fp.leq (fp #b0 #b111111110 #b11)
                expect
                (fp #b0 #b111111111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
