; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b01111010010001001 #b10000001000)
                arg1
                (fp #b0 #b11111111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b11111111111)
                arg1
                (fp #b0 #b11111111111111111 #b00000000000)))

(declare-const arg2 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b01100101010101101 #b10110101010)
                arg2
                (fp #b0 #b00000000000000000 #b10101111011)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b10101111011)
                arg2
                (fp #b0 #b00100101111000100 #b00101001011)))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b0 #b00010010011010010 #b01111101101)
                expect
                (fp #b0 #b10000000000000000 #b01011110110)))
(assert (fp.leq (fp #b0 #b10000000000000000 #b01011110110)
                expect
                (fp #b0 #b11100010111110100 #b11111010010)))

(assert (not (= expect result)))

(check-sat)
(exit)
