(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1001000100100101 #b001)
                arg1
                (fp #b1 #b1000000000000010 #b110)))
(assert (fp.leq (fp #b1 #b1000000000000010 #b110)
                arg1
                (fp #b0 #b1001000011011011 #b001)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0110111110011100 #b011)
                arg2
                (fp #b0 #b0000000000000000 #b111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b111)
                arg2
                (fp #b0 #b0000011101110111 #b000)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1001000010111111 #b010)
                expect
                (fp #b1 #b0000000000000100 #b101)))
(assert (fp.leq (fp #b1 #b0000000000000100 #b101)
                expect
                (fp #b0 #b1110111000000011 #b110)))

(assert (= expect result))

(check-sat)
(exit)
