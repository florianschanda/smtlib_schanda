(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b0 #b0000011111100111 #b11)
                arg1
                (fp #b0 #b0111111111111111 #b11)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b11)
                arg1
                (fp #b0 #b1001111011111100 #b01)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1011111011000110 #b00)
                arg2
                (fp #b1 #b0111111111111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b11)
                arg2
                (fp #b1 #b0011101100010111 #b01)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1111000000111110 #b10)
                expect
                (fp #b1 #b1000000000000000 #b11)))
(assert (fp.leq (fp #b1 #b1000000000000000 #b11)
                expect
                (fp #b0 #b1101000111100110 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
