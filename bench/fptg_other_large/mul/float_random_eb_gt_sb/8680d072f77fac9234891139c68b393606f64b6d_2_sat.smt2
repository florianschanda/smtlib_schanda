(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL
; Arg2: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10010101010 #b1)
                arg1
                (fp #b1 #b00111111111 #b1)))
(assert (fp.leq (fp #b1 #b00111111111 #b1)
                arg1
                (fp #b0 #b10010110011 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10111110011 #b0)
                arg2
                (fp #b1 #b00000000000 #b1)))
(assert (fp.leq (fp #b1 #b00000000000 #b1)
                arg2
                (fp #b0 #b01001011110 #b0)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b00010110101 #b0)
                expect
                (fp #b0 #b00000000000 #b1)))
(assert (fp.leq (fp #b0 #b00000000000 #b1)
                expect
                (fp #b0 #b01001011000 #b0)))

(assert (= expect result))

(check-sat)
(exit)
