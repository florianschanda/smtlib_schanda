(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b001111111110111 #b100)
                arg1
                (fp #b0 #b011111111111111 #b100)))
(assert (fp.leq (fp #b0 #b011111111111111 #b100)
                arg1
                (fp #b0 #b111111100011100 #b111)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b101111001010101 #b000)
                arg2
                (fp #b0 #b001111111111110 #b011)))
(assert (fp.leq (fp #b0 #b001111111111110 #b011)
                arg2
                (fp #b0 #b010011010011010 #b011)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b011001111110010 #b011)
                expect
                (fp #b0 #b001111111111111 #b000)))
(assert (fp.leq (fp #b0 #b001111111111111 #b000)
                expect
                (fp #b0 #b110110111111011 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
