(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b011010111100 #b11111)
                arg1
                (fp #b1 #b000000000001 #b00000)))
(assert (fp.leq (fp #b1 #b000000000001 #b00000)
                arg1
                (fp #b0 #b011000100111 #b00011)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b011101001000 #b00100)
                arg2
                (fp #b0 #b001111111101 #b01101)))
(assert (fp.leq (fp #b0 #b001111111101 #b01101)
                arg2
                (fp #b0 #b011100010111 #b00001)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b101111000001 #b11111)
                expect
                (fp #b1 #b000000000000 #b00001)))
(assert (fp.leq (fp #b1 #b000000000000 #b00001)
                expect
                (fp #b0 #b111010011011 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
