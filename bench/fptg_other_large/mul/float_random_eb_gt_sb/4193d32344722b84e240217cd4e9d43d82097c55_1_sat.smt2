(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100101000111 #b100100)
                arg1
                (fp #b1 #b011111111111 #b111101)))
(assert (fp.leq (fp #b1 #b011111111111 #b111101)
                arg1
                (fp #b0 #b111001101001 #b100011)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101111001101 #b000111)
                arg2
                (fp #b0 #b111000010010 #b110011)))
(assert (fp.leq (fp #b0 #b111000010010 #b110011)
                arg2
                (fp #b0 #b111010011111 #b110010)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111010111111 #b110110)
                expect
                (fp #b1 #b111000010011 #b110000)))
(assert (fp.leq (fp #b1 #b111000010011 #b110000)
                expect
                (fp #b1 #b101000000001 #b001111)))

(assert (= expect result))

(check-sat)
(exit)
