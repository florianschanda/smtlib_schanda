(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111010101 #b110001)
                arg1
                (fp #b1 #b1011111110 #b111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b111111)
                arg1
                (fp #b1 #b0011101101 #b011100)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101111001 #b101111)
                arg2
                (fp #b0 #b0000000000 #b011111)))
(assert (fp.leq (fp #b0 #b0000000000 #b011111)
                arg2
                (fp #b0 #b0110101010 #b010111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1011010011 #b010010)
                expect
                (fp #b1 #b0011111111 #b111011)))
(assert (fp.leq (fp #b1 #b0011111111 #b111011)
                expect
                (fp #b0 #b0001001101 #b000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
