; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(2)
; Arg2: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b0 #b0101110001000 #b11101000)
                arg1
                (fp #b0 #b0111111111111 #b00010011)))
(assert (fp.leq (fp #b0 #b0111111111111 #b00010011)
                arg1
                (fp #b0 #b1101001000100 #b01001001)))

(declare-const arg2 (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b1110000111111 #b11010110)
                arg2
                (fp #b0 #b0000000000000 #b00000001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000001)
                arg2
                (fp #b0 #b0000101110011 #b10100011)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.leq (fp #b1 #b0101001001100 #b11010000)
                expect
                (fp #b0 #b0000000000000 #b00000010)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00000010)
                expect
                (fp #b0 #b0011000011111 #b01000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
