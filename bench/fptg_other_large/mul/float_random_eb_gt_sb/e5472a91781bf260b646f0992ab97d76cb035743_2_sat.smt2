(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10100111010 #b10100)
                arg1
                (fp #b0 #b00111111101 #b01101)))
(assert (fp.leq (fp #b0 #b00111111101 #b01101)
                arg1
                (fp #b0 #b01111001010 #b00101)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01111101101 #b11110)
                arg2
                (fp #b0 #b11111111110 #b11111)))
(assert (fp.leq (fp #b0 #b11111111110 #b11111)
                arg2
                (fp #b0 #b11111111111 #b00000)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01011101010 #b11010)
                expect
                (fp #b0 #b10111111101 #b01101)))
(assert (fp.leq (fp #b0 #b10111111101 #b01101)
                expect
                (fp #b0 #b11011011000 #b10110)))

(assert (= expect result))

(check-sat)
(exit)
