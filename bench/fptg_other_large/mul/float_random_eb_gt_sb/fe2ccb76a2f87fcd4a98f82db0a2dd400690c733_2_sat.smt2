; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1111011101001011 #b110101111001)
                arg1
                (fp #b1 #b1111011011110011 #b000011111111)))
(assert (fp.leq (fp #b1 #b1111011011110011 #b000011111111)
                arg1
                (fp #b0 #b1101010110011110 #b110011000101)))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1010101100101110 #b010110011100)
                arg2
                (fp #b1 #b1010001001010111 #b000111011011)))
(assert (fp.leq (fp #b1 #b1010001001010111 #b000111011011)
                arg2
                (fp #b1 #b0011001100100111 #b110100110101)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
