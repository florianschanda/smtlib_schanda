(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b110101111111 #b111010)
                arg1
                (fp #b1 #b110100110010 #b101101)))
(assert (fp.leq (fp #b1 #b110100110010 #b101101)
                arg1
                (fp #b0 #b101110000110 #b110010)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b100011010001 #b100001)
                arg2
                (fp #b1 #b011111111111 #b100001)))
(assert (fp.leq (fp #b1 #b011111111111 #b100001)
                arg2
                (fp #b0 #b100110000010 #b111110)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b101001001110 #b111101)
                expect
                (fp #b0 #b110100110011 #b010010)))
(assert (fp.leq (fp #b0 #b110100110011 #b010010)
                expect
                (fp #b0 #b111000110100 #b001011)))

(assert (= expect result))

(check-sat)
(exit)
