(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: +ZERO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b1001011100 #b0001000)
                arg1
                (fp #b0 #b1011101101 #b0101100)))
(assert (fp.leq (fp #b0 #b1011101101 #b0101100)
                arg1
                (fp #b0 #b1110111001 #b1010111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1110101111 #b1101101)
                arg2
                (fp #b0 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000)
                arg2
                (fp #b0 #b0001001110 #b0010110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b0001111011 #b1100011)
                expect
                (fp #b0 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000)
                expect
                (fp #b0 #b0001111100 #b1100011)))

(assert (= expect result))

(check-sat)
(exit)
