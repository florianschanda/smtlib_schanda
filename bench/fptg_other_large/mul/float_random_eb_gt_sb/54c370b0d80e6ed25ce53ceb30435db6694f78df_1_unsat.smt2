(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b01101111010 #b10100011)
                arg1
                (fp #b0 #b10000000010 #b00100000)))
(assert (fp.leq (fp #b0 #b10000000010 #b00100000)
                arg1
                (fp #b0 #b11011111100 #b00001001)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b00111000101 #b00000000)
                arg2
                (fp #b0 #b00000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b00000000000 #b00111011)
                arg2
                (fp #b0 #b01100111001 #b00000010)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11001001000 #b10110001)
                expect
                (fp #b0 #b00000000010 #b00001001)))
(assert (fp.leq (fp #b0 #b00000000010 #b00001001)
                expect
                (fp #b0 #b00001101011 #b11111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
