(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101111110 #b0100000)
                arg1
                (fp #b0 #b1000000011 #b1110000)))
(assert (fp.leq (fp #b0 #b1000000011 #b1110000)
                arg1
                (fp #b0 #b1010111110 #b1011011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001111111 #b1000100)
                arg2
                (fp #b0 #b0000010101 #b1000010)))
(assert (fp.leq (fp #b0 #b0000010101 #b1000010)
                arg2
                (fp #b0 #b0110001000 #b1010111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001111011 #b1100001)
                expect
                (fp #b0 #b0000011010 #b0110101)))
(assert (fp.leq (fp #b0 #b0000011010 #b0110101)
                expect
                (fp #b0 #b0101000111 #b0000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
