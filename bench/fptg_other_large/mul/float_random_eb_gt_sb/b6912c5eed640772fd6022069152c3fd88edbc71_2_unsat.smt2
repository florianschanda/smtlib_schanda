(assert (fp.leq (fp #b0 #b1111111111110 #b111111111)
                arg2
                (fp #b0 #b1111111111111 #b000000000)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1111111001100 #b100000000)
                expect
                (fp #b1 #b1111000001111 #b100101110)))
(assert (fp.leq (fp #b1 #b1111000001111 #b100101110)
                expect
                (fp #b0 #b1011101111011 #b011001111)))

(assert (not (= expect result)))

(check-sat)
