; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000111010 #b111)
                arg1
                (fp #b0 #b1010110001 #b101)))
(assert (fp.leq (fp #b0 #b1010110001 #b101)
                arg1
                (fp #b0 #b1111101001 #b010)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b1001010110 #b011)
                arg2
                (fp #b0 #b1111001111 #b110)))
(assert (fp.leq (fp #b0 #b1111001111 #b110)
                arg2
                (fp #b0 #b1111011011 #b000)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
