                arg2
                (fp #b0 #b01111111111 #b0000001)))
(assert (fp.leq (fp #b0 #b01111111111 #b0000001)
                arg2
                (fp #b0 #b10100001001 #b1110011)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11101010110 #b0100011)
                expect
                (fp #b1 #b01001000111 #b0101000)))
(assert (fp.leq (fp #b1 #b01001000111 #b0101000)
                expect
                (fp #b0 #b10101101111 #b1101010)))

(assert (not (= expect result)))

(check-sat)
(exit)
