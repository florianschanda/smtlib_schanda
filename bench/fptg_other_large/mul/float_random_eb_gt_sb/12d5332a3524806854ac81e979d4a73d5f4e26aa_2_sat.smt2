;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b0 #b0000000000011000 #b0110100110)
                arg1
                (fp #b0 #b0100000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b0000000000)
                arg1
                (fp #b0 #b1010011100000101 #b1001101010)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1101100001001010 #b1101110000)
                arg2
                (fp #b1 #b0000000000000000 #b1000101100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b1000101100)
                arg2
                (fp #b0 #b1011000110011111 #b0100010111)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0101000101000000 #b0100011011)
                expect
                (fp #b1 #b0000000000000000 #b0000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000001)
                expect
                (fp #b0 #b0010111111100010 #b0101010111)))

(assert (= expect result))

(check-sat)
(exit)
