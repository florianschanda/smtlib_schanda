; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11001001100101 #b10)
                arg1
                (fp #b0 #b00000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01)
                arg1
                (fp #b0 #b00101000001101 #b10)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b00000111110010 #b00)
                arg2
                (fp #b0 #b11111111111101 #b00)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00)
                arg2
                (fp #b0 #b11111111111110 #b01)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11000101010001 #b10)
                expect
                (fp #b0 #b01111111111101 #b00)))
(assert (fp.leq (fp #b0 #b01111111111101 #b00)
                expect
                (fp #b0 #b10110001010011 #b01)))

(assert (= expect result))

(check-sat)
(exit)
