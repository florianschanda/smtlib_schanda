; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b010100001000110010 #b100000010101101)
                arg1
                (fp #b0 #b010100101001111011 #b111000111111011)))
(assert (fp.leq (fp #b0 #b010100101001111011 #b111000111111011)
                arg1
                (fp #b0 #b011100010101101001 #b011101101011011)))

(declare-const arg2 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b111101010101011111 #b001100100001111)
                arg2
                (fp #b0 #b100110011101011110 #b111101011010111)))
(assert (fp.leq (fp #b0 #b100110011101011110 #b111101011010111)
                arg2
                (fp #b0 #b111011101110100010 #b100100010101011)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b111110110110100110 #b101100001011100)
                expect
                (fp #b0 #b011011000111011011 #b110110100011010)))
(assert (fp.leq (fp #b0 #b011011000111011011 #b110110100011010)
                expect
                (fp #b0 #b011011101011100011 #b110000010110000)))

(assert (= expect result))

(check-sat)
(exit)
