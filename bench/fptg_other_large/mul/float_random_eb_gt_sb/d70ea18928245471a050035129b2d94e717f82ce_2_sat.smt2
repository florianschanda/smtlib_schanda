(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001011001 #b01000111)
                arg1
                (fp #b1 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b1000001000 #b00000000)
                arg1
                (fp #b0 #b1010000011 #b11000110)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111101 #b00111100)
                arg2
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                arg2
                (fp #b0 #b1000110100 #b00111000)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
