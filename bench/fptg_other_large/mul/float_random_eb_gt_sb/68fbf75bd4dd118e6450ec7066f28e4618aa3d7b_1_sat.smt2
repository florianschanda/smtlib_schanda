(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)
; Arg2: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110110001101 #b11000011)
                arg1
                (fp #b1 #b011011110110 #b01001000)))
(assert (fp.leq (fp #b1 #b011011110110 #b01001000)
                arg1
                (fp #b0 #b001111100110 #b11110011)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111001001011 #b11001011)
                arg2
                (fp #b1 #b000000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000001 #b00000000)
                arg2
                (fp #b0 #b000101011110 #b10000000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b010000000100 #b11010111)
                expect
                (fp #b0 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000)
                expect
                (fp #b0 #b100001001100 #b01111001)))

(assert (= expect result))

(check-sat)
(exit)
