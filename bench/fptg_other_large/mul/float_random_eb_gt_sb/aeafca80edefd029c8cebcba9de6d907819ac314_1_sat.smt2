(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b0 #b0010010001001010 #b1010011)
                arg1
                (fp #b0 #b1011100010000111 #b0111110)))
(assert (fp.leq (fp #b0 #b1011100010000111 #b0111110)
                arg1
                (fp #b0 #b1101011001000001 #b1101000)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1100010111100111 #b0011100)
                arg2
                (fp #b1 #b1001010010010010 #b0010001)))
(assert (fp.leq (fp #b1 #b1001010010010010 #b0010001)
                arg2
                (fp #b0 #b0100011010000000 #b0111001)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1111101111100111 #b1100000)
                expect
                (fp #b1 #b1100110100011010 #b1010111)))
(assert (fp.leq (fp #b1 #b1100110100011010 #b1010111)
                expect
                (fp #b1 #b1011111011110011 #b1011100)))

(assert (= expect result))

(check-sat)
(exit)
