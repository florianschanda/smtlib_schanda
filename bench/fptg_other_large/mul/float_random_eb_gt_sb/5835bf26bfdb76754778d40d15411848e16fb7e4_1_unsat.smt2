; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_SUBNORMAL
; Arg2: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b001010011000001 #b00010101010)
                arg1
                (fp #b0 #b000000000000000 #b11111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111111111)
                arg1
                (fp #b0 #b111100101100001 #b10010111110)))

(declare-const arg2 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b011101011011111 #b00101110111)
                arg2
                (fp #b0 #b001111111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111111010 #b01101010000)
                arg2
                (fp #b0 #b011100100010011 #b01000100101)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111010000011000 #b11000101001)
                expect
                (fp #b0 #b000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000)
                expect
                (fp #b0 #b011101100001001 #b10111101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
