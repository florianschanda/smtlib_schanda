; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1011010111 #b011010)
                arg1
                (fp #b0 #b0000000000 #b000110)))
(assert (fp.leq (fp #b0 #b0000000000 #b000110)
                arg1
                (fp #b0 #b0000010101 #b000010)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1000110110 #b100100)
                arg2
                (fp #b1 #b0011011111 #b011011)))
(assert (fp.leq (fp #b1 #b0011011111 #b011011)
                arg2
                (fp #b0 #b1111010111 #b000010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0000010011 #b101110)
                expect
                (fp #b1 #b0000000000 #b000001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000001)
                expect
                (fp #b0 #b1011011100 #b011111)))

(assert (not (= expect result)))

(check-sat)
(exit)
