(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10011001101110 #b01)
                arg1
                (fp #b0 #b00000000000000 #b01)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01)
                arg1
                (fp #b0 #b11110010111110 #b01)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11100100011000 #b01)
                arg2
                (fp #b0 #b01111111111111 #b11)))
(assert (fp.leq (fp #b0 #b01111111111111 #b11)
                arg2
                (fp #b0 #b11011010111011 #b01)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10011110001110 #b10)
                expect
                (fp #b0 #b00000000000000 #b10)))
(assert (fp.leq (fp #b0 #b00000000000000 #b10)
                expect
                (fp #b0 #b01110101011001 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
