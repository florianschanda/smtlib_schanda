(assert (fp.leq (fp #b0 #b011111111111111 #b0010111001100)
                arg2
                (fp #b0 #b110110010001001 #b0000000001001)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b111001000101001 #b0000001000100)
                expect
                (fp #b1 #b100000000000000 #b0000100111011)))
(assert (fp.leq (fp #b1 #b100000000000000 #b0000100111011)
                expect
                (fp #b0 #b110001010011011 #b0101110101011)))

(assert (not (= expect result)))

