                (fp #b1 #b00000000000000 #b101100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b101100)
                arg2
                (fp #b0 #b01111111000011 #b110111)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11101011001111 #b100000)
                expect
                (fp #b1 #b01101101101100 #b101011)))
(assert (fp.leq (fp #b1 #b01101101101100 #b101011)
                expect
                (fp #b0 #b10101101110001 #b111010)))

(assert (not (= expect result)))

(check-sat)
