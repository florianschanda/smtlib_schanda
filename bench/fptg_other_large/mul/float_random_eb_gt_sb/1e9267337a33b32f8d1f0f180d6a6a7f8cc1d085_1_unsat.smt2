(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b110100110110110 #b01)
                arg1
                (fp #b0 #b101100000101110 #b00)))
(assert (fp.leq (fp #b0 #b101100000101110 #b00)
                arg1
                (fp #b0 #b111101010010100 #b10)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b100010101110001 #b10)
                arg2
                (fp #b1 #b001111111111111 #b00)))
(assert (fp.leq (fp #b1 #b001111111111111 #b00)
                arg2
                (fp #b0 #b000100000001011 #b01)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b101011001010000 #b10)
                expect
                (fp #b1 #b011100000101110 #b00)))
(assert (fp.leq (fp #b1 #b011100000101110 #b00)
                expect
                (fp #b1 #b000011111011111 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
