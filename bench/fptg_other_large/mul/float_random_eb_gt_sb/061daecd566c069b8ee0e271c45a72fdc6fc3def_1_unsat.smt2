                (fp #b0 #b000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000)
                arg2
                (fp #b0 #b100001110011 #b10100)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101010111011 #b10101)
                expect
                (fp #b0 #b000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000)
                expect
                (fp #b0 #b000011100011 #b01110)))

(assert (not (= expect result)))

(check-sat)
