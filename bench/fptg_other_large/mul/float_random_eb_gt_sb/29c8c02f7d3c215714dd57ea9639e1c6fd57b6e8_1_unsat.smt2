(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b111111101110011 #b11001011)
                arg1
                (fp #b1 #b010000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b00000000)
