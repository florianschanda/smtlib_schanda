(assert (fp.leq (fp #b1 #b110101010010001 #b01100011)
                arg2
                (fp #b1 #b100000000000111 #b11010011)))
(assert (fp.leq (fp #b1 #b100000000000111 #b11010011)
                arg2
                (fp #b0 #b000101001000101 #b11101011)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b010111100100011 #b00101101)
                expect
                (fp #b0 #b010000000001000 #b11010011)))
(assert (fp.leq (fp #b0 #b010000000001000 #b11010011)
                expect
                (fp #b0 #b011000111110111 #b11011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
