(assert (fp.leq (fp #b1 #b000000000000000001 #b0000000000000)
                arg2
                (fp #b0 #b110101100110111101 #b0011001110101)))

(declare-const result (_ FloatingPoint 18 14))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 14))
(assert (fp.leq (fp #b1 #b000100011011100111 #b1110011110100)
                expect
                (fp #b0 #b000000000000000000 #b0000000000001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0000000000001)
                expect
                (fp #b0 #b000101000010110010 #b1010110001010)))

(assert (= expect result))

(check-sat)
