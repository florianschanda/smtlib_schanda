(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b001111100 #b11)
                arg1
                (fp #b0 #b100001001 #b10)))
(assert (fp.leq (fp #b0 #b100001001 #b10)
                arg1
                (fp #b0 #b101100001 #b11)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110110000 #b01)
                arg2
                (fp #b1 #b100101001 #b01)))
(assert (fp.leq (fp #b1 #b100101001 #b01)
                arg2
                (fp #b0 #b110110100 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110101110 #b10)
                expect
                (fp #b1 #b100110011 #b11)))
(assert (fp.leq (fp #b1 #b100110011 #b11)
                expect
                (fp #b1 #b011010001 #b00)))

(assert (= expect result))

(check-sat)
(exit)
