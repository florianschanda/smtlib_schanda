(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1110001111 #b00110001)
                arg1
                (fp #b1 #b1100100100 #b10000101)))
(assert (fp.leq (fp #b1 #b1100100100 #b10000101)
                arg1
                (fp #b0 #b1010001100 #b11111001)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111000001 #b11010111)
                arg2
                (fp #b1 #b1011111110 #b11111111)))
(assert (fp.leq (fp #b1 #b1011111110 #b11111111)
                arg2
                (fp #b0 #b0111100010 #b10110011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0100001001 #b00001101)
                expect
                (fp #b0 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111111)
                expect
                (fp #b0 #b1111111111 #b00000000)))

(assert (= expect result))

(check-sat)
(exit)
