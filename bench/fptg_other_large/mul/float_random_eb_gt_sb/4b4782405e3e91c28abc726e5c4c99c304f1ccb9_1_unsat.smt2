(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +LARGEST_NORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b10000100111000001 #b0100000)
                arg2
                (fp #b0 #b11111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b1111111)
                arg2
                (fp #b0 #b11111111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
