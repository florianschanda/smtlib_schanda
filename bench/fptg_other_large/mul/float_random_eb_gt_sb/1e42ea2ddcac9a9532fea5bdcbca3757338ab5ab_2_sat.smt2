(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1101100110001 #b00101)
                arg1
                (fp #b1 #b0100000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0100000000000 #b00000)
                arg1
                (fp #b0 #b1100000010110 #b00110)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1100100010111 #b10100)
                arg2
                (fp #b1 #b0011100111100 #b11010)))
(assert (fp.leq (fp #b1 #b0011100111100 #b11010)
                arg2
                (fp #b0 #b1110110110111 #b00001)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0101010111001 #b00101)
                expect
                (fp #b0 #b0000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00001)
                expect
                (fp #b0 #b1011111000101 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
