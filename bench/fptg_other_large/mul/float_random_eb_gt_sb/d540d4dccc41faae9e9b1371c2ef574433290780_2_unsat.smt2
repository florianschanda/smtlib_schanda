; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b001111001101100111 #b1000000)
                arg1
                (fp #b0 #b000000000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0100000)
                arg1
                (fp #b0 #b001100101011001011 #b1110110)))

(declare-const arg2 (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b001000010001011000 #b1001100)
                arg2
                (fp #b0 #b000000000000000000 #b1100000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b1100000)
                arg2
                (fp #b0 #b111111111010010011 #b1010011)))

(declare-const result (_ FloatingPoint 18 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 8))
(assert (fp.leq (fp #b1 #b110111100011100011 #b0101101)
                expect
                (fp #b0 #b000000000000000000 #b0000001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0000001)
                expect
                (fp #b0 #b110000101010011110 #b1110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
