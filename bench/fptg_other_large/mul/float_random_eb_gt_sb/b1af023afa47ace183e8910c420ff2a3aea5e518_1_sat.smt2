(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: MUL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11111111101 #b1010011)
                arg1
                (fp #b1 #b11111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000)
                arg1
                (fp #b1 #b00011100111 #b0010101)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10100000100 #b1101101)
                arg2
                (fp #b1 #b10000000101 #b1100000)))
(assert (fp.leq (fp #b1 #b10000000101 #b1100000)
                arg2
                (fp #b0 #b01100110110 #b0101101)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.mul rm arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b10001100101 #b0001001)
                expect
                (fp #b0 #b11111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111)
                expect
                (fp #b0 #b11111111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
