(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 10 47))
(assert (fp.leq (fp #b0 #b0011010111 #b0001010111111101100011101010001110011001111000)
                arg
                (fp #b0 #b0100000000 #b0000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b0100000000 #b0000000000000000000000000000000000000000000000)
                arg
                (fp #b0 #b1110110110 #b0100110101000000001001101110101000101000110110)))

(declare-const result (_ BitVec 1))
