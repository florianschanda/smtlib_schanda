(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv64
; Arg1: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 4 27))
(assert (fp.leq (fp #b1 #b0101 #b01000110010101110010010000)
                arg
                (fp #b1 #b0001 #b00000100101010111000000000)))
(assert (fp.leq (fp #b1 #b0001 #b00000100101010111000000000)
                arg
                (fp #b0 #b1001 #b10001111101010010001110101)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111111111111111111110)))

(assert (= expect result))

(check-sat)
(exit)
