; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv32
; Arg1: -SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 4 36))
(assert (fp.leq (fp #b1 #b1100 #b10010000001101011010011000000011111)
                arg
                (fp #b1 #b1010 #b11111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b1010 #b11111111111111111111111111111111111)
                arg
                (fp #b0 #b1010 #b11100100100011010101111010100001011)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111111111111111101111)))
(assert (not (bvule #b11111111111111111111111111110001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
