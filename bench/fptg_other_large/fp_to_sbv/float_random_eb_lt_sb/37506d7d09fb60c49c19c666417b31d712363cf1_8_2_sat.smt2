(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 9 22))
(assert (fp.leq (fp #b1 #b011000011 #b001101111101100011011)
                arg
                (fp #b0 #b010001001 #b101011010010001110000)))
(assert (fp.leq (fp #b0 #b010001001 #b101011010010001110000)
                arg
                (fp #b0 #b100110111 #b001111010011011001101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
