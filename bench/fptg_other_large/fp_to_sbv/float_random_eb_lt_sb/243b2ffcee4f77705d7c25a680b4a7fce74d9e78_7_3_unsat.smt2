(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv7
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 13 14))
(assert (fp.leq (fp #b1 #b1011111100111 #b1100001000111)
                arg
                (fp #b0 #b0010001000110 #b0000100111101)))
(assert (fp.leq (fp #b0 #b0010001000110 #b0000100111101)
                arg
                (fp #b0 #b1001010010011 #b1001011001001)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b0000000)))
(assert (not (bvule #b0000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
