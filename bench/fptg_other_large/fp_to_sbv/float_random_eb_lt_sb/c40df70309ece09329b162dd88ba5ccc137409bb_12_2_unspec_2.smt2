; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv12
; Arg1: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 3 45))
(assert (fp.isPositive arg))
(assert (fp.isInfinite arg))

(declare-const result (_ BitVec 12))
(assert (= result ((_ fp.to_sbv 12) rm arg)))

(declare-const expect (_ BitVec 12))
(assert (not (bvule expect #b111111000110)))
(assert (not (bvule #b111111001000 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
