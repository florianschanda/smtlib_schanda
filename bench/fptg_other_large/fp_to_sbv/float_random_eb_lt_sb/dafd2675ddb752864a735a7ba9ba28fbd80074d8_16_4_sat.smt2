(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 13 48))
(assert (fp.leq (fp #b1 #b0011100100111 #b01110010010101010010001001010111010101100101011)
                arg
                (fp #b1 #b0000000000000 #b00000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00000000000000000000000000000000000000000000001)
                arg
                (fp #b0 #b1001010000000 #b01111000011110001100111000011100010011101110101)))

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_sbv 16) rm arg)))

(declare-const expect (_ BitVec 16))
