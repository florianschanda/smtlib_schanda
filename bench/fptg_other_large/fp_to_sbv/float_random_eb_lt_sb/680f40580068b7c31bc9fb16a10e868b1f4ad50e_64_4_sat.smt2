; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv64
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 9 25))
(assert (fp.leq (fp #b1 #b101000110 #b011001010010101011011101)
                arg
                (fp #b1 #b100001011 #b101001010111010110101101)))
(assert (fp.leq (fp #b1 #b100001011 #b101001010111010110101101)
                arg
                (fp #b0 #b100010100 #b111011011100110000001100)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111111110010110101000)))
(assert (not (bvule #b1111111111111111111111111111111111111111111111111110010110101010 expect)))

(assert (= expect result))

(check-sat)
(exit)
