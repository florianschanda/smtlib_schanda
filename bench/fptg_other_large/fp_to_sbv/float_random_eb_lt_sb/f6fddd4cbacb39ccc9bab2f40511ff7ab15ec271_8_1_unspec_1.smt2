;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 12 31))
(assert (fp.leq (fp #b1 #b001000000001 #b111110011110111101100100001101)
                arg
                (fp #b0 #b111111111110 #b111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111111111111111111111111111111)
                arg
                (fp #b0 #b111111111111 #b000000000000000000000000000000)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00010011)))
(assert (not (bvule #b00010101 expect)))

(assert (not (= expect result)))
