(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv4
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 15 28))
(assert (fp.leq (fp #b1 #b101111001101101 #b001011101001000001011000011)
                arg
                (fp #b1 #b011111111111111 #b101101101101110110101011110)))
(assert (fp.leq (fp #b1 #b011111111111111 #b101101101101110110101011110)
                arg
                (fp #b0 #b110011110101101 #b101101100001010010110010000)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b1110)))

(assert (= expect result))

(check-sat)
(exit)
