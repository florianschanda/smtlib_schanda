; Format: FLOAT_RANDOM_EB_LT_SB
; Target: bv8
; Arg1: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 20))
(assert (fp.leq (fp #b1 #b01101011001 #b0010001001111001001)
                arg
                (fp #b0 #b11111111101 #b0000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000)
                arg
                (fp #b0 #b11111111101 #b1010010001101110101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00101101)))
(assert (not (bvule #b00101111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
