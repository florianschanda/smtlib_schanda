(assert (fp.isPositive arg))
(assert (fp.leq (fp #b1 #b11000010110001010 #b1)
                arg
                (fp #b0 #b00000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0)
                arg
                (fp #b0 #b00101111100100001 #b0)))

(declare-const result (_ BitVec 42))
(assert (= result ((_ fp.to_sbv 42) rm arg)))

(declare-const expect (_ BitVec 42))
(assert (= expect #b000000000000000000000000000000000000000000))

(assert (= expect result))

(check-sat)
(exit)
