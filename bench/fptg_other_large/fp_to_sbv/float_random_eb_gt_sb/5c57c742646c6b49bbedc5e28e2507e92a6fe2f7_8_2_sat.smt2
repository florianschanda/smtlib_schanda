(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110101100010100 #b101010011)
                arg
                (fp #b1 #b0111111111111111 #b011010011)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b011010011)
                arg
                (fp #b1 #b0101111101001110 #b111010110)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11111101)))
(assert (not (bvule #b11111111 expect)))

(assert (= expect result))

(check-sat)
(exit)
