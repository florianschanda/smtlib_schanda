; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv1
; Arg1: -SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b011101000001010 #b1011101101101)
                arg
                (fp #b1 #b000000000000001 #b0000000000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0000000000000)
                arg
                (fp #b0 #b110001110001110 #b0001001100010)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule #b1 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
