; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv4
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1001001000101011 #b001110)
                arg
                (fp #b1 #b0100110001101000 #b000010)))
(assert (fp.leq (fp #b1 #b0100110001101000 #b000010)
                arg
                (fp #b1 #b0100010101110001 #b000011)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (= expect #b1111))

(assert (not (= expect result)))

(check-sat)
(exit)
