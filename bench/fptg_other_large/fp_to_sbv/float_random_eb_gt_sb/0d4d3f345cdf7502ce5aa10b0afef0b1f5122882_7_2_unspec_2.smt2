(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100100111 #b010011)
                arg
                (fp #b0 #b111110110 #b101101)))
(assert (fp.leq (fp #b0 #b111110110 #b101101)
                arg
                (fp #b0 #b111111110 #b101001)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b1110111)))
(assert (not (bvule #b1111001 expect)))

(assert (= expect result))
