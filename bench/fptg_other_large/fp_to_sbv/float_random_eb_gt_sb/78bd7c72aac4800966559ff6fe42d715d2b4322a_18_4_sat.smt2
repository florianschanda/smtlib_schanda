(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011101110 #b1111011)
                arg
                (fp #b1 #b010000000 #b0000000)))
(assert (fp.leq (fp #b1 #b010000000 #b0000000)
                arg
                (fp #b1 #b000010001 #b1011001)))

(declare-const result (_ BitVec 18))
(assert (= result ((_ fp.to_sbv 18) rm arg)))

(declare-const expect (_ BitVec 18))
(assert (= expect #b111111111111111111))

(assert (= expect result))

