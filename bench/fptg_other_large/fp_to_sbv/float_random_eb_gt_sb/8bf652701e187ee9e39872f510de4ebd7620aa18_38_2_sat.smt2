(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv38
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b100010011000101 #b100)
                arg
                (fp #b1 #b010000000000000 #b000)))
(assert (fp.leq (fp #b1 #b010000000000000 #b000)
                arg
                (fp #b0 #b010111111001101 #b000)))

(declare-const result (_ BitVec 38))
(assert (= result ((_ fp.to_sbv 38) rm arg)))

(declare-const expect (_ BitVec 38))
(assert (not (bvule #b00000000000000000000000000000000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
