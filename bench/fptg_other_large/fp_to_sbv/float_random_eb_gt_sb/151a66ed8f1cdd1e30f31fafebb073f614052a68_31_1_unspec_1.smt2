; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv31
; Arg1: -INFINITY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 15 2))
(assert (fp.isNegative arg))
(assert (fp.isInfinite arg))

(declare-const result (_ BitVec 31))
(assert (= result ((_ fp.to_sbv 31) rm arg)))

(declare-const expect (_ BitVec 31))
(assert (not (bvule expect #b0101011000111010111101001101011)))
(assert (not (bvule #b0101011000111010111101001101101 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
