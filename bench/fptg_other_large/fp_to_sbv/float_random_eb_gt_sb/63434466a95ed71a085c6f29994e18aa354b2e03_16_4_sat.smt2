(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv16
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0100010010100 #b00110)
                arg
                (fp #b1 #b0001001001010 #b01010)))
(assert (fp.leq (fp #b1 #b0001001001010 #b01010)
                arg
                (fp #b0 #b0111010001100 #b11010)))

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_sbv 16) rm arg)))

(declare-const expect (_ BitVec 16))
(assert (= expect #b1111111111111111))

(assert (= expect result))

(check-sat)
(exit)
