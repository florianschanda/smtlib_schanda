; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv1
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101001011 #b0100)
                arg
                (fp #b1 #b000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000 #b0001)
                arg
                (fp #b0 #b000010000 #b1100)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b1))

(assert (= expect result))

(check-sat)
(exit)
