; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11101001010010 #b110)
                arg
                (fp #b1 #b10000000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000000011 #b000)
                arg
                (fp #b1 #b00110111011000 #b100)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11101111)))
(assert (not (bvule #b11110001 expect)))

(assert (= expect result))

(check-sat)
(exit)
