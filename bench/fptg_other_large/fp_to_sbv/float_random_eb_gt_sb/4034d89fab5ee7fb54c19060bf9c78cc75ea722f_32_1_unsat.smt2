; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0011111110 #b1101)
                arg
                (fp #b1 #b0011111110 #b0000)))
(assert (fp.leq (fp #b1 #b0011111110 #b0000)
                arg
                (fp #b0 #b1001111100 #b1010)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000000))

(assert (not (= expect result)))

(check-sat)
(exit)
