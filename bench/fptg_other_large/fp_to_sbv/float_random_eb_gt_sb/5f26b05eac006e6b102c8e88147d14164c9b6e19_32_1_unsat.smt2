; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110010100 #b10)
                arg
                (fp #b1 #b100010001 #b11)))
(assert (fp.leq (fp #b1 #b100010001 #b11)
                arg
                (fp #b0 #b010000111 #b11)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111110001111111111111111)))
(assert (not (bvule #b11111111111110010000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
