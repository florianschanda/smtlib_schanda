; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101100010011 #b10000010)
                arg
                (fp #b1 #b000000000000 #b00010010)))
(assert (fp.leq (fp #b1 #b000000000000 #b00010010)
                arg
                (fp #b0 #b000110111111 #b00011011)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b11111111))

(assert (not (= expect result)))

(check-sat)
(exit)
