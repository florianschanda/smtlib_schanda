; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111101010010 #b100000)
                arg
                (fp #b1 #b1111010111000 #b001010)))
(assert (fp.leq (fp #b1 #b1111010111000 #b001010)
                arg
                (fp #b1 #b0111101001101 #b110011)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_sbv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule expect #b01)))
(assert (not (bvule #b11 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
