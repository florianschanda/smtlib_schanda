; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000100110 #b00010001)
                arg
                (fp #b0 #b1101011101 #b11111010)))
(assert (fp.leq (fp #b0 #b1101011101 #b11111010)
                arg
                (fp #b0 #b1111111110 #b11010000)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b10111011)))
(assert (not (bvule #b10111101 expect)))

(assert (not (= expect result)))
