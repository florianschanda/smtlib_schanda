; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 13 5))
(assert (fp.isNegative arg))
(assert (fp.leq (fp #b1 #b0010001111011 #b0111)
                arg
                (fp #b1 #b0000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0000)
                arg
                (fp #b0 #b1011101011100 #b0111)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000000))

(assert (not (= expect result)))

(check-sat)
(exit)
