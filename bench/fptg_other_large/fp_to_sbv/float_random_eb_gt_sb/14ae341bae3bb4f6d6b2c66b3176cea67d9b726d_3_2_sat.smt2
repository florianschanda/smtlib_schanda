(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv3
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000011010111 #b10000)
                arg
                (fp #b0 #b0011000011100 #b10000)))
(assert (fp.leq (fp #b0 #b0011000011100 #b10000)
                arg
                (fp #b0 #b1010110011000 #b01100)))

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_sbv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (= expect #b000))

(assert (= expect result))

(check-sat)
(exit)
