(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000001001011001 #b11)
                arg
                (fp #b0 #b011111111111111 #b11)))
(assert (fp.leq (fp #b0 #b011111111111111 #b11)
                arg
                (fp #b0 #b100001001001011 #b10)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000001)))
(assert (not (bvule #b00000011 expect)))

(assert (= expect result))

(check-sat)
(exit)
