; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv57
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10110011100 #b00011)
                arg
                (fp #b1 #b10000000011 #b10110)))
(assert (fp.leq (fp #b1 #b10000000011 #b10110)
                arg
                (fp #b0 #b00101001000 #b01101)))

(declare-const result (_ BitVec 57))
(assert (= result ((_ fp.to_sbv 57) rm arg)))

(declare-const expect (_ BitVec 57))
(assert (not (bvule expect #b111111111111111111111111111111111111111111111111111100100)))
(assert (not (bvule #b111111111111111111111111111111111111111111111111111100110 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
