(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv16
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000110111 #b11101)
                arg
                (fp #b1 #b1000000011 #b10110)))
(assert (fp.leq (fp #b1 #b1000000011 #b10110)
                arg
                (fp #b1 #b0101000000 #b10111)))

(declare-const result (_ BitVec 16))
(assert (= result ((_ fp.to_sbv 16) rm arg)))

(declare-const expect (_ BitVec 16))
(assert (not (bvule expect #b1111111111100100)))
(assert (not (bvule #b1111111111100110 expect)))

(assert (= expect result))

(check-sat)
(exit)
