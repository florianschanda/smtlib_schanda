; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv54
; Arg1: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10011101111 #b11110010)
                arg
                (fp #b0 #b00000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b01000000)
                arg
                (fp #b0 #b11110010001 #b00110100)))

(declare-const result (_ BitVec 54))
(assert (= result ((_ fp.to_sbv 54) rm arg)))

(declare-const expect (_ BitVec 54))
(assert (not (bvule expect #b000000000000000000000000000000000000000000000000000000)))
(assert (not (bvule #b000000000000000000000000000000000000000000000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
