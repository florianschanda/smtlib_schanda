(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b1 #b11111001110110001 #b1111000100)
                arg
                (fp #b1 #b01111111111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0011010000)
                arg
                (fp #b0 #b10000011011101011 #b1010111100)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11111101)))
(assert (not (bvule #b11111111 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
