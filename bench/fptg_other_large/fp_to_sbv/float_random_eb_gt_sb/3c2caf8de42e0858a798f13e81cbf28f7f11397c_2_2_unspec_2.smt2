; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11101110000111 #b0101)
                arg
                (fp #b1 #b10000000000001 #b1000)))
(assert (fp.leq (fp #b1 #b10000000000001 #b1000)
                arg
                (fp #b0 #b00011000101011 #b1011)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_sbv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule expect #b01)))
(assert (not (bvule #b11 expect)))

(assert (= expect result))
