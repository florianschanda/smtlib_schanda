; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv53
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011001011 #b10)
                arg
                (fp #b1 #b0111111111 #b11)))
(assert (fp.leq (fp #b1 #b0111111111 #b11)
                arg
                (fp #b1 #b0110100011 #b11)))

(declare-const result (_ BitVec 53))
(assert (= result ((_ fp.to_sbv 53) rm arg)))

(declare-const expect (_ BitVec 53))
(assert (not (bvule expect #b11111111111111111111111111111111111111111111111111101)))
(assert (not (bvule #b11111111111111111111111111111111111111111111111111111 expect)))

(assert (= expect result))

(check-sat)
(exit)
