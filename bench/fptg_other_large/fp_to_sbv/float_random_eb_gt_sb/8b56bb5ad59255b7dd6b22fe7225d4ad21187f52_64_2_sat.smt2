; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11011001111 #b0010000)
                arg
                (fp #b1 #b10000000110 #b0011010)))
(assert (fp.leq (fp #b1 #b10000000110 #b0011010)
                arg
                (fp #b1 #b00000001011 #b0111111)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111111111111101100101)))
(assert (not (bvule #b1111111111111111111111111111111111111111111111111111111101100111 expect)))

(assert (= expect result))

(check-sat)
(exit)
