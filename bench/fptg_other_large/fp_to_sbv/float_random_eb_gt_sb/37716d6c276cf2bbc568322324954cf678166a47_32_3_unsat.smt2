; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1011101111001 #b00111)
                arg
                (fp #b1 #b0111111111111 #b11001)))
(assert (fp.leq (fp #b1 #b0111111111111 #b11001)
                arg
                (fp #b0 #b0000000110001 #b10100)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111111111111111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
