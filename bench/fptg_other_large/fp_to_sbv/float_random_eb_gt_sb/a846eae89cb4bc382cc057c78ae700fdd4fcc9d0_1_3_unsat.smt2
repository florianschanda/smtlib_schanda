(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111000001110 #b111)
                arg
                (fp #b1 #b010000101100 #b100)))
(assert (fp.leq (fp #b1 #b010000101100 #b100)
                arg
                (fp #b0 #b110100111111 #b010)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
