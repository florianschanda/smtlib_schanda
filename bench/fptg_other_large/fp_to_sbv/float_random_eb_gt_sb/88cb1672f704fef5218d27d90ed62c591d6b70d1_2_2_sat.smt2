(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011101110 #b0000100)
                arg
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg
                (fp #b0 #b1101110010 #b1001110)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_sbv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (not (bvule #b01 expect)))

(assert (= expect result))

(check-sat)
(exit)
