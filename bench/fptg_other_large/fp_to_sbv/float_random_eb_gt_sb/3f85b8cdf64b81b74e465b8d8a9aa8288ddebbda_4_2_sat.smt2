(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv4
; Arg1: +ONE

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0010111000110 #b1101110)
                arg
                (fp #b0 #b0111111111111 #b0000000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0000000)
                arg
                (fp #b0 #b1100001000100 #b1001000)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b0000)))
(assert (not (bvule #b0010 expect)))

(assert (= expect result))

(check-sat)
(exit)
