; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100111000001 #b011)
                arg
                (fp #b1 #b100000000001 #b010)))
(assert (fp.leq (fp #b1 #b100000000001 #b010)
                arg
                (fp #b0 #b101100111011 #b101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11111010)))
(assert (not (bvule #b11111100 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
