; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv3
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01111100110110 #b1101)
                arg
                (fp #b0 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0001)
                arg
                (fp #b0 #b10100000111100 #b0101)))

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_sbv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (= expect #b000))

(assert (= expect result))

(check-sat)
(exit)
