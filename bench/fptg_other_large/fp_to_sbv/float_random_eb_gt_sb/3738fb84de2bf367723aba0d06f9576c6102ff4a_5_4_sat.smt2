(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1101100001011 #b0010100001)
                arg
                (fp #b1 #b0111111111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b0111111111111 #b1111110100)
                arg
                (fp #b1 #b0001111000010 #b0000010000)))

