; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b100000010001100111 #b11)
                arg
                (fp #b1 #b100000000000000000 #b10)))
(assert (fp.leq (fp #b1 #b100000000000000000 #b10)
                arg
                (fp #b0 #b111010011001000100 #b11)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111111111111111111100)))
(assert (not (bvule #b11111111111111111111111111111110 expect)))

(assert (= expect result))

(check-sat)
(exit)
