; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv3
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b10111011000111101 #b10001000001011)
                arg
                (fp #b1 #b00101100101001000 #b01001001111101)))
(assert (fp.leq (fp #b1 #b00101100101001000 #b01001001111101)
                arg
                (fp #b0 #b11101101011100010 #b00111101000111)))

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_sbv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule #b001 expect)))

(assert (= expect result))

(check-sat)
(exit)
