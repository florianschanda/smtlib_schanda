; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv2
; Arg1: -RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111000011001 #b11)
                arg
                (fp #b1 #b0111110100101 #b11)))
(assert (fp.leq (fp #b1 #b0111110100101 #b11)
                arg
                (fp #b1 #b0000000011001 #b10)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_sbv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (= expect #b00))

(assert (= expect result))

(check-sat)
(exit)
