(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b00010001011 #b1)
                arg
                (fp #b0 #b11111111101 #b0)))
(assert (fp.leq (fp #b0 #b11111111101 #b0)
                arg
                (fp #b0 #b11111111111 #b0)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b00010000110110010101111001111110)))
(assert (not (bvule #b00010000110110010101111010000000 expect)))

(assert (not (= expect result)))
