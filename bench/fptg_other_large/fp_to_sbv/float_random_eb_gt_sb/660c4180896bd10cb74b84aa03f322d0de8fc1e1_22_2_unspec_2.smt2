(assert (fp.leq (fp #b1 #b101001001011 #b111101100)
                arg
                (fp #b1 #b100101110100 #b101010110)))
(assert (fp.leq (fp #b1 #b100101110100 #b101010110)
                arg
                (fp #b0 #b011101001001 #b011100111)))

