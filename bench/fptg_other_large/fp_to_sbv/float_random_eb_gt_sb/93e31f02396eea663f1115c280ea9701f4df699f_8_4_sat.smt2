(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 18 13))
(assert (fp.leq (fp #b1 #b011101110011100101 #b110010101111)
                arg
                (fp #b0 #b000000000000000000 #b110011110001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b110011110001)
                arg
                (fp #b0 #b111010001100000110 #b100010010110)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
