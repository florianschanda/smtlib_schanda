(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv32
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1000110011000 #b110010)
                arg
                (fp #b1 #b0000000000000 #b011100)))
(assert (fp.leq (fp #b1 #b0000000000000 #b011100)
                arg
                (fp #b0 #b0101111111001 #b010001)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000000))

(assert (= expect result))

(check-sat)
(exit)
