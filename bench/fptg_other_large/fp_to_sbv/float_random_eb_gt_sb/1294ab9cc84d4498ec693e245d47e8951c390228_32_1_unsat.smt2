;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111001100101011 #b1111001)
                arg
                (fp #b1 #b010101101111100 #b1000010)))
(assert (fp.leq (fp #b1 #b010101101111100 #b1000010)
                arg
                (fp #b0 #b100000100010100 #b0111111)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000000))

(assert (not (= expect result)))

(check-sat)
(exit)
