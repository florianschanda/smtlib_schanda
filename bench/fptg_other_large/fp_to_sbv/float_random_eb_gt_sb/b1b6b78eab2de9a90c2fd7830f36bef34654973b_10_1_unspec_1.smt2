;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10010001010 #b101)
                arg
                (fp #b0 #b11010111011 #b010)))
(assert (fp.leq (fp #b0 #b11010111011 #b010)
                arg
                (fp #b0 #b11100011011 #b011)))

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_sbv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (not (bvule expect #b0111111010)))
(assert (not (bvule #b0111111100 expect)))

(assert (not (= expect result)))
