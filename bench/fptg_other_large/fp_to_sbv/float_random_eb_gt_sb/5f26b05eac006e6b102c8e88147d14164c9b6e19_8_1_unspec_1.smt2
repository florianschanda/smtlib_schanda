; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv8
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110010100 #b10)
                arg
                (fp #b1 #b100010001 #b11)))
(assert (fp.leq (fp #b1 #b100010001 #b11)
                arg
                (fp #b0 #b010000111 #b11)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b01111000)))
(assert (not (bvule #b01111010 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
