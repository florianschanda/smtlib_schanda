; Format: FLOAT_RANDOM_EB_GT_SB
; Target: bv4
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10110011100 #b00011)
                arg
                (fp #b1 #b10000000011 #b10110)))
(assert (fp.leq (fp #b1 #b10000000011 #b10110)
                arg
                (fp #b0 #b00101001000 #b01101)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b0000)))
(assert (not (bvule #b0010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
