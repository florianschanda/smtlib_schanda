;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011000010 #b00010111)
                arg
                (fp #b0 #b000111110 #b11111110)))
(assert (fp.leq (fp #b0 #b000111110 #b11111110)
                arg
                (fp #b0 #b111111010 #b11001100)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b0))

(assert (= expect result))

(check-sat)
(exit)
