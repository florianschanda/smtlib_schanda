(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv1
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101000001100100 #b000110001010011)
                arg
                (fp #b0 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000000000001)
                arg
                (fp #b0 #b1011110101100000 #b011001001101010)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b1))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
