(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv3
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01000011111 #b0110100110)
                arg
                (fp #b0 #b01011100011 #b0001110111)))
(assert (fp.leq (fp #b0 #b01011100011 #b0001110111)
                arg
                (fp #b0 #b01011111011 #b0100001001)))

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_sbv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b000)))
(assert (not (bvule #b010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
