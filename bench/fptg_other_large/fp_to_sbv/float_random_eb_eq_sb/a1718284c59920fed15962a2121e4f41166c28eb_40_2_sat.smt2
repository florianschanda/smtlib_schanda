; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv40
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000110 #b011010000)
                arg
                (fp #b1 #b1000000111 #b001010110)))
(assert (fp.leq (fp #b1 #b1000000111 #b001010110)
                arg
                (fp #b0 #b1101111001 #b001000010)))

(declare-const result (_ BitVec 40))
(assert (= result ((_ fp.to_sbv 40) rm arg)))

(declare-const expect (_ BitVec 40))
(assert (not (bvule expect #b1111111111111111111111111111111011010100)))
(assert (not (bvule #b1111111111111111111111111111111011010110 expect)))

(assert (= expect result))

(check-sat)
(exit)
