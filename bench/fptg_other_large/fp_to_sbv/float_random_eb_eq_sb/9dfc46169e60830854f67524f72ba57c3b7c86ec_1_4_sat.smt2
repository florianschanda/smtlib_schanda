(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111000101 #b11100001)
                arg
                (fp #b1 #b011100101 #b11011111)))
(assert (fp.leq (fp #b1 #b011100101 #b11011111)
                arg
                (fp #b0 #b111100111 #b10011111)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule expect #b0)))

(assert (= expect result))

(check-sat)
(exit)
