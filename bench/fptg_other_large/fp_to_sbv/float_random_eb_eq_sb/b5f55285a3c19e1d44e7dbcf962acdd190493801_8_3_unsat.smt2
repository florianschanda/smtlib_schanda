; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 17 17))
(assert (fp.leq (fp #b1 #b10000100110000010 #b1100000101100110)
                arg
                (fp #b1 #b01111111111111111 #b1101010111010100)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b1101010111010100)
                arg
                (fp #b0 #b10000000001100101 #b0001011000010101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b11111111))

(assert (not (= expect result)))

(check-sat)
(exit)
