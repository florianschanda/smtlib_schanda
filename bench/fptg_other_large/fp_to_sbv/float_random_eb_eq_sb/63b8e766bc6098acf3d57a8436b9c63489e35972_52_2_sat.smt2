(assert (fp.leq (fp #b1 #b10111110100 #b1001000001)
                arg
                (fp #b1 #b10000001001 #b0000110001)))
(assert (fp.leq (fp #b1 #b10000001001 #b0000110001)
                arg
                (fp #b1 #b01101010000 #b1111001101)))

