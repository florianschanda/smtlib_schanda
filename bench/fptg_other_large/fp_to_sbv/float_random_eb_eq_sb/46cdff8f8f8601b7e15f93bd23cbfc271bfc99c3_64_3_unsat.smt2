;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110000100000 #b11100110001)
                arg
                (fp #b1 #b011111111111 #b11001010001)))
(assert (fp.leq (fp #b1 #b011111111111 #b11001010001)
                arg
                (fp #b1 #b011000111111 #b11001111010)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (= expect #b1111111111111111111111111111111111111111111111111111111111111111))

(assert (not (= expect result)))

(check-sat)
(exit)
