(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv12
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01010101110 #b0101100100)
                arg
                (fp #b0 #b01101110000 #b1101101101)))
(assert (fp.leq (fp #b0 #b01101110000 #b1101101101)
                arg
                (fp #b0 #b11000000010 #b1000100000)))

(declare-const result (_ BitVec 12))
(assert (= result ((_ fp.to_sbv 12) rm arg)))

(declare-const expect (_ BitVec 12))
(assert (not (bvule expect #b000000000000)))
(assert (not (bvule #b000000000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
