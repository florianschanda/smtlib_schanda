(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b1 #b1010111011101 #b100011111100)
                arg
                (fp #b1 #b0111111111111 #b100011001000)))
(assert (fp.leq (fp #b1 #b0111111111111 #b100011001000)
                arg
                (fp #b0 #b0011000010011 #b001000011110)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_sbv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (= expect #b10))

(assert (= expect result))

(check-sat)
(exit)
