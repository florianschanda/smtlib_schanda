; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv4
; Arg1: +INT_BOUNDARY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010100000010 #b00010011000)
                arg
                (fp #b0 #b100000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b100000001011 #b00000000000)
                arg
                (fp #b0 #b100000010010 #b01111101011)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b0010)))
(assert (not (bvule #b0100 expect)))

(assert (not (= expect result)))
