; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001100101011 #b00111000001)
                arg
                (fp #b0 #b100000001000 #b10111110100)))
(assert (fp.leq (fp #b0 #b100000001000 #b10111110100)
                arg
                (fp #b0 #b101001011000 #b01000110101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11110100)))
(assert (not (bvule #b11110110 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
