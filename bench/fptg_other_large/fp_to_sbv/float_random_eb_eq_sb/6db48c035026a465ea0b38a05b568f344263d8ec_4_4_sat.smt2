(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv4
; Arg1: -RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001011111101 #b01110001000)
                arg
                (fp #b1 #b000000000000 #b11010001010)))
(assert (fp.leq (fp #b1 #b000000000000 #b11010001010)
                arg
                (fp #b0 #b010111011110 #b00100101010)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule expect #b1110)))

(assert (= expect result))

(check-sat)
(exit)
