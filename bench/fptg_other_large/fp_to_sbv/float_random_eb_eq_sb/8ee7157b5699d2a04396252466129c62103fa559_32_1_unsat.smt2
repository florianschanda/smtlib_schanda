; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111100001000 #b1101010000110)
                arg
                (fp #b1 #b01111111111111 #b0111101101000)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0111101101000)
                arg
                (fp #b1 #b00010100110111 #b1110010110100)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111111111111111111101)))
(assert (not (bvule #b11111111111111111111111111111111 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
