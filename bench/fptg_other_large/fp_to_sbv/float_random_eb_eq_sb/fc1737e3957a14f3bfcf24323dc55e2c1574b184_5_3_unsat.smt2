; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv5
; Arg1: +RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00111011010000 #b1001011001100)
                arg
                (fp #b0 #b00000000000000 #b0000010110010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000010110010)
                arg
                (fp #b0 #b10110001110001 #b1100011000010)))

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_sbv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b00000)))
(assert (not (bvule #b00010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
