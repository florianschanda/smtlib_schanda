; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv10
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111000000 #b0001101010)
                arg
                (fp #b1 #b10000001001 #b0110110001)))
(assert (fp.leq (fp #b1 #b10000001001 #b0110110001)
                arg
                (fp #b1 #b01101111110 #b0100100100)))

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_sbv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (not (bvule expect #b0001011101)))
(assert (not (bvule #b0001011111 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
