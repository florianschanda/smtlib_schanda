; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv7
; Arg1: +INFINITY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 16 16))
(assert (fp.isPositive arg))
(assert (fp.isInfinite arg))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b1110000)))
(assert (not (bvule #b1110010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
