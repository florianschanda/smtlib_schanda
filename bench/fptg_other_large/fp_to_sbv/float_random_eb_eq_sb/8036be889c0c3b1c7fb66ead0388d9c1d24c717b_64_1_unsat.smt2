; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv64
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b100111101100 #b01000010101)
                arg
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg
                (fp #b0 #b011001111100 #b11100001101)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111110100101101001111111111111111111111)))
(assert (not (bvule #b1111111111111111111111111111110100101101010000000000000000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
