(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv11
; Arg1: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101100011100 #b10010000111)
                arg
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                arg
                (fp #b0 #b011001001111 #b10011011011)))

(declare-const result (_ BitVec 11))
(assert (= result ((_ fp.to_sbv 11) rm arg)))

(declare-const expect (_ BitVec 11))
(assert (not (bvule expect #b11111111110)))

(assert (= expect result))

(check-sat)
(exit)
