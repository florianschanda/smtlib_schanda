(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv3
; Arg1: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b110111100111100011 #b10111111000111010)
                arg
                (fp #b0 #b000000000000000000 #b10000010011110001)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b10000010011110001)
                arg
                (fp #b0 #b110010100001111111 #b10110111001110001)))

(declare-const result (_ BitVec 3))
(assert (= result ((_ fp.to_sbv 3) rm arg)))

(declare-const expect (_ BitVec 3))
(assert (not (bvule expect #b000)))
(assert (not (bvule #b010 expect)))

(assert (= expect result))

(check-sat)
(exit)
