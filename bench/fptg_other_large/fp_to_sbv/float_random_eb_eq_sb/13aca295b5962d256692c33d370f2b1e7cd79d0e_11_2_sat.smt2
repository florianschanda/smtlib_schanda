; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv11
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000101101011 #b10111001000)
                arg
                (fp #b0 #b000110100001 #b00110110110)))
(assert (fp.leq (fp #b0 #b000110100001 #b00110110110)
                arg
                (fp #b0 #b100011100101 #b10101000110)))

(declare-const result (_ BitVec 11))
(assert (= result ((_ fp.to_sbv 11) rm arg)))

(declare-const expect (_ BitVec 11))
(assert (not (bvule #b00000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
