; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv9
; Arg1: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110110011 #b10100000)
                arg
                (fp #b1 #b001111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111100 #b00000000)
                arg
                (fp #b0 #b101010011 #b01011011)))

(declare-const result (_ BitVec 9))
(assert (= result ((_ fp.to_sbv 9) rm arg)))

(declare-const expect (_ BitVec 9))
(assert (not (bvule #b000000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
