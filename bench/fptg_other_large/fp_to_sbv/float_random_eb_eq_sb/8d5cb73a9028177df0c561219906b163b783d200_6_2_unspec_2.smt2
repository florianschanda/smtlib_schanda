;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00011111110001 #b0111010011110)
                arg
                (fp #b0 #b10010101010100 #b0100011011111)))
(assert (fp.leq (fp #b0 #b10010101010100 #b0100011011111)
                arg
                (fp #b0 #b11111101110000 #b0110010010111)))

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b001100)))
(assert (not (bvule #b001110 expect)))

(assert (= expect result))
