(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv4
; Arg1: +LARGEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101100110100 #b01100100010100)
                arg
                (fp #b0 #b000000000000000 #b11111111111111)))
(assert (fp.leq (fp #b0 #b000000000000000 #b11111111111111)
                arg
                (fp #b0 #b101101110100010 #b01110001001110)))

(declare-const result (_ BitVec 4))
(assert (= result ((_ fp.to_sbv 4) rm arg)))

(declare-const expect (_ BitVec 4))
(assert (not (bvule #b0001 expect)))

(assert (= expect result))

(check-sat)
(exit)
