(assert (fp.leq (fp #b1 #b01001101011 #b1010010110)
                arg
                (fp #b0 #b01111111111 #b1001100100)))
(assert (fp.leq (fp #b0 #b01111111111 #b1001100100)
                arg
                (fp #b0 #b11110101111 #b1111000001)))

(declare-const result (_ BitVec 1))
