; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv2
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110111000011 #b1000110011010)
                arg
                (fp #b1 #b01111111111111 #b1100001000110)))
(assert (fp.leq (fp #b1 #b01111111111111 #b1100001000110)
                arg
                (fp #b0 #b00010000111100 #b0000011110011)))

(declare-const result (_ BitVec 2))
(assert (= result ((_ fp.to_sbv 2) rm arg)))

(declare-const expect (_ BitVec 2))
(assert (= expect #b10))

(assert (not (= expect result)))

(check-sat)
(exit)
