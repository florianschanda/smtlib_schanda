; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv1
; Arg1: -RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b00111001010001 #b0101100011100)
                arg
                (fp #b1 #b00000101110111 #b1011000011110)))
(assert (fp.leq (fp #b1 #b00000101110111 #b1011000011110)
                arg
                (fp #b0 #b01001010110110 #b1000011000011)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (not (bvule #b1 expect)))

(assert (= expect result))

(check-sat)
(exit)
