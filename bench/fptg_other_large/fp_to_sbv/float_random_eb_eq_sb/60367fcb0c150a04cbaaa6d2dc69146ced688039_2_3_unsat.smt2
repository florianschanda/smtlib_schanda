(assert (not (= rm RTN)))

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100011000 #b10011001)
                arg
                (fp #b1 #b011111111 #b01111011)))
(assert (fp.leq (fp #b1 #b011111111 #b01111011)
                arg
                (fp #b0 #b100100001 #b01011010)))

