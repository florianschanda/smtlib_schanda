(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b101001000000010101 #b11111011111001010)
                arg
                (fp #b0 #b100000000000001110 #b11110100010011100)))
(assert (fp.leq (fp #b0 #b100000000000001110 #b11110100010011100)
                arg
                (fp #b0 #b101001011000101100 #b00111010111001110)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11111100)))
(assert (not (bvule #b11111110 expect)))

(assert (= expect result))
