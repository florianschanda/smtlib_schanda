(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001001110 #b100011100)
                arg
                (fp #b0 #b0111111111 #b000000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b000000000)
                arg
                (fp #b0 #b1100000010 #b010111101)))

(declare-const result (_ BitVec 18))
(assert (= result ((_ fp.to_sbv 18) rm arg)))

(declare-const expect (_ BitVec 18))
