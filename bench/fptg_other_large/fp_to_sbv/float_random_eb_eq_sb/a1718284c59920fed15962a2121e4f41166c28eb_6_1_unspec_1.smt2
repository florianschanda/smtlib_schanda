; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv6
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110000110 #b011010000)
                arg
                (fp #b1 #b1000000111 #b001010110)))
(assert (fp.leq (fp #b1 #b1000000111 #b001010110)
                arg
                (fp #b0 #b1101111001 #b001000010)))

(declare-const result (_ BitVec 6))
(assert (= result ((_ fp.to_sbv 6) rm arg)))

(declare-const expect (_ BitVec 6))
(assert (not (bvule expect #b110001)))
(assert (not (bvule #b110011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
