; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv5
; Arg1: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b111111110 #b10001111)
                arg
                (fp #b1 #b111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000000)
                arg
                (fp #b0 #b101011000 #b01000100)))

(declare-const result (_ BitVec 5))
(assert (= result ((_ fp.to_sbv 5) rm arg)))

(declare-const expect (_ BitVec 5))
(assert (not (bvule expect #b10001)))
(assert (not (bvule #b10011 expect)))

(assert (not (= expect result)))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
