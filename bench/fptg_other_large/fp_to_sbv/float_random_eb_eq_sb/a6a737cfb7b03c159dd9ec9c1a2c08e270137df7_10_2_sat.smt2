; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv10
; Arg1: +RANDOM_SUBNORMAL(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111111011011 #b1001100000001)
                arg
                (fp #b0 #b00000000000000 #b1000101001110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1000101001110)
                arg
                (fp #b0 #b00000010000001 #b0100001011111)))

(declare-const result (_ BitVec 10))
(assert (= result ((_ fp.to_sbv 10) rm arg)))

(declare-const expect (_ BitVec 10))
(assert (not (bvule #b0000000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
