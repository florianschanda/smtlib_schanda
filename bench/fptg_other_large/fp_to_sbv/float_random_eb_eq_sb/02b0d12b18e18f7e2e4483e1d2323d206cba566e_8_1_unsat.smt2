(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv8
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111100101110101 #b00110001111000)
                arg
                (fp #b1 #b011111111111111 #b11101110010001)))
(assert (fp.leq (fp #b1 #b011111111111111 #b11101110010001)
                arg
                (fp #b0 #b000111000010101 #b01011010110000)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b11111101)))
(assert (not (bvule #b11111111 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
