; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv1
; Arg1: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010111001111110 #b010010010111011)
                arg
                (fp #b1 #b0000000000000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010010100000101)
                arg
                (fp #b0 #b1110101010010111 #b111000100000001)))

(declare-const result (_ BitVec 1))
(assert (= result ((_ fp.to_sbv 1) rm arg)))

(declare-const expect (_ BitVec 1))
(assert (= expect #b1))

(assert (not (= expect result)))

(check-sat)
(exit)
