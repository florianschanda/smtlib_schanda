; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv32
; Arg1: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010000000 #b110110100)
                arg
                (fp #b0 #b0111111111 #b111111100)))
(assert (fp.leq (fp #b0 #b0111111111 #b111111100)
                arg
                (fp #b0 #b1010001001 #b100010100)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000001))

(assert (= expect result))

(check-sat)
(exit)
