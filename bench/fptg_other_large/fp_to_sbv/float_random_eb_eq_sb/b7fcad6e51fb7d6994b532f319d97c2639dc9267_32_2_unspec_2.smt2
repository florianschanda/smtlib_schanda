(declare-const rm RoundingMode)

(declare-const arg (_ FloatingPoint 13 13))
(assert (fp.leq (fp #b0 #b1011000010010 #b011110111100)
                arg
                (fp #b0 #b1110111000100 #b001001101000)))
(assert (fp.leq (fp #b0 #b1110111000100 #b001001101000)
                arg
                (fp #b0 #b1111001001101 #b000100110000)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b01111101011001000010001101101111)))
(assert (not (bvule #b01111101011001000010001101110001 expect)))

(assert (= expect result))
