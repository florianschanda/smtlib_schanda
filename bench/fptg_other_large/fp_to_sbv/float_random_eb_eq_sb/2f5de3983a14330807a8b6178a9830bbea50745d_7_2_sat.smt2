; Format: FLOAT_RANDOM_EB_EQ_SB
; Target: bv7
; Arg1: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111101 #b10000001110)
                arg
                (fp #b0 #b001111111010 #b01101010000)))
(assert (fp.leq (fp #b0 #b001111111010 #b01101010000)
                arg
                (fp #b0 #b110001001101 #b00101011001)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule #b0000001 expect)))

(assert (= expect result))

(check-sat)
(exit)
