(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT128
; Target: bv40
; Arg1: +INFINITY

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float128)
(assert (fp.isPositive arg))
(assert (fp.isInfinite arg))

(declare-const result (_ BitVec 40))
(assert (= result ((_ fp.to_sbv 40) rm arg)))

(declare-const expect (_ BitVec 40))
(assert (not (bvule expect #b1111000001110101010011011111011101100000)))
(assert (not (bvule #b1111000001110101010011011111011101100010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
