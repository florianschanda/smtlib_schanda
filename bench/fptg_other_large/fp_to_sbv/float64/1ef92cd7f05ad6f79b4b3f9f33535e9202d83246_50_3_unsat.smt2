(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b00101100011 #b0100111110001000110110111000101010111100010010001111)
                arg
                (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)))
(assert (fp.leq (fp #b0 #b00000000000 #b1101111111010100101110100010000101100101011000001111)
                arg
                (fp #b0 #b00011101010 #b0101110001000001110101000000001001011110010001100110)))

(declare-const result (_ BitVec 50))
(assert (= result ((_ fp.to_sbv 50) rm arg)))

(declare-const expect (_ BitVec 50))
(assert (not (bvule expect #b00000000000000000000000000000000000000000000000000)))
(assert (not (bvule #b00000000000000000000000000000000000000000000000010 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
