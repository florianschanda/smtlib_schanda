(declare-const rm RoundingMode)

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b11100010111 #b1101000000101110001011101101000111000101010011011110)
                arg
                (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)))
(assert (fp.leq (fp #b1 #b10101111000 #b1110000100001110110100100100110000010010100010001011)
                arg
                (fp #b1 #b01010000011 #b0100001010100101100111001010011110010100000011111101)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b1101110)))
(assert (not (bvule #b1110000 expect)))

(assert (not (= expect result)))
