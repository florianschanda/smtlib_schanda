; Format: FLOAT64
; Target: bv8
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b10111011101 #b1011001111101001000101101110101010100010011000101011)
                arg
                (fp #b1 #b10010111010 #b0011100100110110000011001000010010010010111001001100)))
(assert (fp.leq (fp #b1 #b10010111010 #b0011100100110110000011001000010010010010111001001100)
                arg
                (fp #b0 #b01110111110 #b1100011010100100000010101110100010100110000111000000)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00001000)))
(assert (not (bvule #b00001010 expect)))

(assert (not (= expect result)))
