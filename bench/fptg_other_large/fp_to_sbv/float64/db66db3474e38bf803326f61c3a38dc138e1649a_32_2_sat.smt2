; Format: FLOAT64
; Target: bv32
; Arg1: -ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float64)
(assert (fp.isNegative arg))
(assert (fp.leq (fp #b1 #b01101011110 #b0101010110010110001011010011110110111100011110101101)
                arg
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg
                (fp #b0 #b11101110110 #b0010001110100001100000001101110011010011000011101101)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (= expect #b00000000000000000000000000000000))

(assert (= expect result))

(check-sat)
(exit)
