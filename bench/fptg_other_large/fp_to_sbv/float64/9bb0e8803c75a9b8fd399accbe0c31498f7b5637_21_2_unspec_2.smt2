; Format: FLOAT64
; Target: bv21
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL

(declare-const rm RoundingMode)

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)
                arg
                (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111111111111111111111111111111111111111111111111111)
                arg
                (fp #b0 #b10001011000 #b0001011110010000010010000111111110110011101101010110)))

(declare-const result (_ BitVec 21))
(assert (= result ((_ fp.to_sbv 21) rm arg)))

(declare-const expect (_ BitVec 21))
(assert (not (bvule expect #b010011110110000100000)))
(assert (not (bvule #b010011110110000100010 expect)))

(assert (= expect result))
; this benchmark exploits unspecified behaviour

(check-sat)
(exit)
