; Format: FLOAT64
; Target: bv32
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b11101001011 #b1001101001110110100001100110101110001101110010001011)
                arg
                (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0110101101101100110110101110101101010000101000011100)
                arg
                (fp #b0 #b00010000010 #b1000010110101010010000001110010010100111001011000111)))

(declare-const result (_ BitVec 32))
(assert (= result ((_ fp.to_sbv 32) rm arg)))

(declare-const expect (_ BitVec 32))
(assert (not (bvule expect #b11111111111111111111111111111110)))

(assert (= expect result))

(check-sat)
(exit)
