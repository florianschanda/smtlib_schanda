; Format: FLOAT64
; Target: bv8
; Arg1: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b11110001001 #b0010110111110110001001110010011000010100101101100001)
                arg
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg
                (fp #b0 #b11010100111 #b0011010101001010110111010111111000110100000010011100)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule #b00000001 expect)))

(assert (not (= expect result)))

(check-sat)
(exit)
