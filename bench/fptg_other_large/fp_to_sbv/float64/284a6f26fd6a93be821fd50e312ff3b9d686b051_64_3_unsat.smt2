(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b10001001110 #b0000110000111010110001100001000101100001100000110010)
                arg
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg
                (fp #b0 #b01011010110 #b0001000111011011111100011100101010000010101100011000)))

(declare-const result (_ BitVec 64))
(assert (= result ((_ fp.to_sbv 64) rm arg)))

(declare-const expect (_ BitVec 64))
(assert (not (bvule expect #b1111111111111111111111111111111111111111111111111111111111111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
