; Format: FLOAT64
; Target: bv8
; Arg1: +ZERO

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg Float64)
(assert (fp.isPositive arg))
(assert (fp.leq (fp #b1 #b11100000011 #b0101010110111100000001110001111000001111011100001100)
                arg
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg
                (fp #b0 #b00000011000 #b0100001001101001011110101011101110101101011101101100)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (= expect #b00000000))

(assert (not (= expect result)))

(check-sat)
(exit)
