; Format: FLOAT64
; Target: bv8
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b00101110100 #b1010001000000101100110010010111101101011101100111111)
                arg
                (fp #b0 #b01111111111 #b0100010000101010010100110110010000011010000110110111)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100010000101010010100110110010000011010000110110111)
                arg
                (fp #b0 #b11111110000 #b1001011010101110111111111101111001111110110100001101)))

(declare-const result (_ BitVec 8))
(assert (= result ((_ fp.to_sbv 8) rm arg)))

(declare-const expect (_ BitVec 8))
(assert (not (bvule expect #b00000000)))
(assert (not (bvule #b00000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
