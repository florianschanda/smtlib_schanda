(set-info :smt-lib-version 2.6)
(set-logic QF_BVFP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Target: bv7
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FP_TO_SBV
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: NONE
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg Float64)
(assert (fp.leq (fp #b1 #b00000001011 #b1110000101110111110110101010010000000101000111000110)
                arg
                (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg
                (fp #b0 #b01100101010 #b1111111000100000011000010000110001001011000000011100)))

(declare-const result (_ BitVec 7))
(assert (= result ((_ fp.to_sbv 7) rm arg)))

(declare-const expect (_ BitVec 7))
(assert (not (bvule expect #b0000000)))
(assert (not (bvule #b0000010 expect)))

(assert (= expect result))

(check-sat)
(exit)
