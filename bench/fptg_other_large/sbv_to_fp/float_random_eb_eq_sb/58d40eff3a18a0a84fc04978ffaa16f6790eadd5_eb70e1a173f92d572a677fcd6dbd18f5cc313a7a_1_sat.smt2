(assert (not (bvule #b110000000000 arg1)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result ((_ to_fp 10 10) rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011101111 #b001101010)
                expect
                (fp #b1 #b1000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000001001 #b000000000)
                expect
                (fp #b1 #b0100110110 #b101000001)))

(assert (= expect result))

(check-sat)
(exit)
