(assert (fp.leq (fp #b1 #b10011100011 #b101011110)
                expect
                (fp #b1 #b10000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b10000001001 #b000000000)
                expect
                (fp #b0 #b11101111010 #b111001111)))

(assert (= expect result))

(check-sat)
(exit)
