(assert (not (bvule #b10000000000000010 arg1)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result ((_ to_fp 11 10) rm arg1)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11001111100 #b011100110)
                expect
                (fp #b1 #b10000001111 #b000000000)))
(assert (fp.leq (fp #b1 #b10000001111 #b000000000)
                expect
                (fp #b1 #b01001100110 #b000001100)))

(assert (= expect result))

(check-sat)
(exit)
