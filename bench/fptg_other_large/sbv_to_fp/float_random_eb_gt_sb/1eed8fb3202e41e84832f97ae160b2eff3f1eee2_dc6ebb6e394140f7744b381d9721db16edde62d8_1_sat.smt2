; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -80

; Redundancy: False
; Validation for: SBV_TO_FP
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 8))
(assert (not (bvule arg1 #b10101111)))
(assert (not (bvule #b10110001 arg1)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result ((_ to_fp 13 8) rm arg1)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1111110000010 #b0010111)
                expect
                (fp #b1 #b1000000000101 #b0100000)))
(assert (fp.leq (fp #b1 #b1000000000101 #b0100000)
                expect
                (fp #b1 #b0000110110101 #b1010000)))

(assert (= expect result))

(check-sat)
(exit)
