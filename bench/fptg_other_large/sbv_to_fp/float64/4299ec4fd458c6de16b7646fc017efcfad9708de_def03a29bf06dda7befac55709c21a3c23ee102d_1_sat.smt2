;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ BitVec 3))
(assert (not (bvule arg1 #b100)))
(assert (not (bvule #b110 arg1)))

(declare-const result Float64)
(assert (= result ((_ to_fp 11 53) rm arg1)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100011010 #b0000000001101101000101001001101101000000100110010010)
                expect
                (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000000 #b1000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10001001001 #b1001110011011000110001111110011110001000000110100101)))

(assert (= expect result))

(check-sat)
(exit)
