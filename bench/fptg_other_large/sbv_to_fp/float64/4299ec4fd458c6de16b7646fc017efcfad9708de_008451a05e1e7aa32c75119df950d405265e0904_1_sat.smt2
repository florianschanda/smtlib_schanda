(assert (fp.leq (fp #b1 #b01000100001 #b0101100110110011000110100010110100110011100101001111)
                expect
                (fp #b0 #b10000000101 #b1111110000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000000101 #b1111110000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10111000101 #b1101101100011010011111000101001011001011100111110101)))

(assert (= expect result))

(check-sat)
(exit)
