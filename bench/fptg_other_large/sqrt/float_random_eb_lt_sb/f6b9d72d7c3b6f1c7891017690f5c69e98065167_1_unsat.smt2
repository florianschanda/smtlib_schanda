(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 64))
(assert (fp.leq (fp #b1 #b11010101010000 #b010101101111011010011011011000110001010100101001000100110011001)
                arg1
                (fp #b1 #b10111111111110 #b111111111111111111111111111111111111111111111111111111111111111)))
