; Format: FLOAT64
; Arg1: -INT_BOUNDARY

; Redundancy: True
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: PARTIAL
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010100001 #b1010111101000010011010001001010101101111000010010001)
                arg1
                (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01111110010 #b0110101001011100111000110111000101000101100010101010)))

(declare-const result Float64)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
