;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11010111010 #b1111000010101111110010010011101000111101010010000111)
                arg1
                (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)))
(assert (fp.leq (fp #b1 #b10000110011 #b0100010001010000010110000100101100001110011110011111)
                arg1
                (fp #b0 #b00111100111 #b1011001011110111100111000011100011001001000110101100)))

(declare-const result Float64)
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect Float64)
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
