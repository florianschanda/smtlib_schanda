; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100111100 #b100110)
                arg1
                (fp #b0 #b011110111 #b111110)))
(assert (fp.leq (fp #b0 #b011110111 #b111110)
                arg1
                (fp #b0 #b101001010 #b110100)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001011101 #b110111)
                expect
                (fp #b0 #b011111011 #b011010)))
(assert (fp.leq (fp #b0 #b011111011 #b011010)
                expect
                (fp #b0 #b101001001 #b111001)))

(assert (= expect result))

(check-sat)
(exit)
