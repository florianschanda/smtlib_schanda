(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1110101100010100 #b101010011)
                arg1
                (fp #b1 #b0111111111111111 #b011010011)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b011010011)
                arg1
                (fp #b1 #b0101111101001110 #b111010110)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
