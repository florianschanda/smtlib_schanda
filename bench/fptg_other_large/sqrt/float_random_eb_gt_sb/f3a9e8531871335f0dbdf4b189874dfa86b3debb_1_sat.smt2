; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0011110011001010 #b01100)
                arg1
                (fp #b0 #b1011100100111110 #b00011)))
(assert (fp.leq (fp #b0 #b1011100100111110 #b00011)
                arg1
                (fp #b0 #b1110011000010111 #b11110)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b0 #b0101001011011101 #b00101)
                expect
                (fp #b0 #b1001110010011110 #b01111)))
(assert (fp.leq (fp #b0 #b1001110010011110 #b01111)
                expect
                (fp #b0 #b1100100101011111 #b11010)))

(assert (= expect result))

(check-sat)
(exit)
