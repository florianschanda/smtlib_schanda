(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b010001100 #b00011)
                arg1
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg1
                (fp #b0 #b100111000 #b00011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b001001101 #b00001)
                expect
                (fp #b0 #b100000010 #b00000)))
(assert (fp.leq (fp #b0 #b100000010 #b00000)
                expect
                (fp #b0 #b110101100 #b10010)))

(assert (= expect result))

(check-sat)
(exit)
