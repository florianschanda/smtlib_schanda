(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b01111110100011 #b1110110)
                arg1
                (fp #b0 #b10000000000011 #b1110000)))
(assert (fp.leq (fp #b0 #b10000000000011 #b1110000)
                arg1
                (fp #b0 #b10000011111101 #b0010100)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10101010001001 #b1011111)
                expect
                (fp #b0 #b10000000000001 #b0101111)))
(assert (fp.leq (fp #b0 #b10000000000001 #b0101111)
                expect
                (fp #b0 #b11010001111111 #b0010000)))

(assert (= expect result))

(check-sat)
(exit)
