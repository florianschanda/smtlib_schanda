(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001101010 #b11000001)
                expect
                (fp #b0 #b1010101110 #b01101000)))
(assert (fp.leq (fp #b0 #b1010101110 #b01101000)
                expect
                (fp #b0 #b1110100011 #b10110100)))

(assert (not (= expect result)))

(check-sat)
(exit)
