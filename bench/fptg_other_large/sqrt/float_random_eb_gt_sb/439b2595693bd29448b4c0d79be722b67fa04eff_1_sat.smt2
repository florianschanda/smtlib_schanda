(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b11010101001 #b01101111)
                arg1
                (fp #b0 #b10000000111 #b11000011)))
(assert (fp.leq (fp #b0 #b10000000111 #b11000011)
                arg1
                (fp #b0 #b11111000100 #b01000100)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01011110100 #b01010001)
                expect
                (fp #b0 #b10000000011 #b01010011)))
(assert (fp.leq (fp #b0 #b10000000011 #b01010011)
                expect
                (fp #b0 #b11011110110 #b11000000)))

(assert (= expect result))

(check-sat)
(exit)
