(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000000011000 #b01110100)
                arg1
                (fp #b0 #b000110111011 #b01101011)))
(assert (fp.leq (fp #b0 #b000110111011 #b01101011)
                arg1
                (fp #b0 #b010111011011 #b01100110)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b000001000000 #b11011111)
                expect
                (fp #b0 #b010011011101 #b00110001)))
(assert (fp.leq (fp #b0 #b010011011101 #b00110001)
                expect
                (fp #b0 #b100010011000 #b00110000)))

(assert (= expect result))

(check-sat)
(exit)
