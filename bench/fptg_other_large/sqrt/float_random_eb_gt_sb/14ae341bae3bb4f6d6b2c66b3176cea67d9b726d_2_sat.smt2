(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000011010111 #b10000)
                arg1
                (fp #b0 #b0011000011100 #b10000)))
(assert (fp.leq (fp #b0 #b0011000011100 #b10000)
                arg1
                (fp #b0 #b1010110011000 #b01100)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000100000101 #b00100)
                expect
                (fp #b0 #b0101100001101 #b11000)))
(assert (fp.leq (fp #b0 #b0101100001101 #b11000)
                expect
                (fp #b0 #b1011100100000 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
