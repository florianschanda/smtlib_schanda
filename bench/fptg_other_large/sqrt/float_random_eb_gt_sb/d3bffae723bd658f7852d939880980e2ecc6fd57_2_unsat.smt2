                expect
                (fp #b0 #b100100110000 #b01)))
(assert (fp.leq (fp #b0 #b100100110000 #b01)
                expect
                (fp #b0 #b100110111001 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
