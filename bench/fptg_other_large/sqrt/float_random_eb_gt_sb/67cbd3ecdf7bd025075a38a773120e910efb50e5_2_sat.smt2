(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0110010101001 #b010)
                arg1
                (fp #b0 #b0111011101010 #b101)))
(assert (fp.leq (fp #b0 #b0111011101010 #b101)
                arg1
                (fp #b0 #b1111010001010 #b100)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0010010011000 #b000)
                expect
                (fp #b0 #b0111101110100 #b111)))
(assert (fp.leq (fp #b0 #b0111101110100 #b111)
                expect
                (fp #b0 #b1001011011011 #b100)))

(assert (= expect result))

(check-sat)
(exit)
