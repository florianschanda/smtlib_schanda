; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b01010000110 #b1101010)
                arg1
                (fp #b0 #b01100100000 #b0010000)))
(assert (fp.leq (fp #b0 #b01100100000 #b0010000)
                arg1
                (fp #b0 #b01101110001 #b1111100)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01011110011 #b1000000)
                expect
                (fp #b0 #b01110001111 #b1000000)))
(assert (fp.leq (fp #b0 #b01110001111 #b1000000)
                expect
                (fp #b0 #b01111100110 #b1010110)))

(assert (= expect result))

(check-sat)
(exit)
