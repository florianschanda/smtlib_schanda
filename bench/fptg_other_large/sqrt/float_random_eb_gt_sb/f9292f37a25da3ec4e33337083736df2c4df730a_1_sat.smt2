(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011010101001 #b11100000)
                arg1
                (fp #b0 #b101001101100 #b00101000)))
(assert (fp.leq (fp #b0 #b101001101100 #b00101000)
                arg1
                (fp #b0 #b101011101001 #b11100011)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b000100010101 #b10111000)
                expect
                (fp #b0 #b100100110101 #b10000101)))
(assert (fp.leq (fp #b0 #b100100110101 #b10000101)
                expect
                (fp #b0 #b100101011101 #b00001111)))

(assert (= expect result))

(check-sat)
(exit)
