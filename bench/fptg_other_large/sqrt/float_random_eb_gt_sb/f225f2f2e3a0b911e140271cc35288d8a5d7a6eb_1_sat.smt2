(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b00101111011001 #b00101)
                arg1
                (fp #b0 #b01000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b00000)
                arg1
                (fp #b0 #b01110000000111 #b01010)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11000101001101 #b00010)
                expect
                (fp #b0 #b01011111111111 #b01101)))
(assert (fp.leq (fp #b0 #b01011111111111 #b01101)
                expect
                (fp #b0 #b11001111110111 #b00101)))

(assert (= expect result))

(check-sat)
(exit)
