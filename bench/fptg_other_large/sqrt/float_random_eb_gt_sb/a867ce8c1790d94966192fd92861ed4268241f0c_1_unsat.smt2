; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b0 #b00110100110101011 #b01)
                arg1
                (fp #b0 #b10001010101010111 #b01)))
(assert (fp.leq (fp #b0 #b10001010101010111 #b01)
                arg1
                (fp #b0 #b11100110010110000 #b10)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b01000001111100110 #b10)
                expect
                (fp #b0 #b10000101010101011 #b00)))
(assert (fp.leq (fp #b0 #b10000101010101011 #b00)
                expect
                (fp #b0 #b11100111001111010 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
