(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101001001011 #b111101100)
                arg1
                (fp #b1 #b100101110100 #b101010110)))
(assert (fp.leq (fp #b1 #b100101110100 #b101010110)
                arg1
                (fp #b0 #b011101001001 #b011100111)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
