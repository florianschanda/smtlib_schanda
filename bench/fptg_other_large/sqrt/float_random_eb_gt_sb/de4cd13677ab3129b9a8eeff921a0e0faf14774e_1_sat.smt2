;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b1 #b11010110001011000 #b100000)
                arg1
                (fp #b1 #b00100100000000010 #b010101)))
(assert (fp.leq (fp #b1 #b00100100000000010 #b010101)
                arg1
