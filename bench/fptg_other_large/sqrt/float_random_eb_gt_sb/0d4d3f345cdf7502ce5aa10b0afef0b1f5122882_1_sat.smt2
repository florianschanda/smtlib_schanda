(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100100111 #b010011)
                arg1
                (fp #b0 #b111110110 #b101101)))
(assert (fp.leq (fp #b0 #b111110110 #b101101)
                arg1
                (fp #b0 #b111111110 #b101001)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b011001000 #b000010)
                expect
                (fp #b0 #b101111010 #b110110)))
(assert (fp.leq (fp #b0 #b101111010 #b110110)
                expect
                (fp #b0 #b111011000 #b010111)))

(assert (= expect result))

(check-sat)
(exit)
