; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111111 #b00000)
                arg1
                (fp #b1 #b1111111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111)
                arg1
                (fp #b1 #b1010000001 #b00011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
