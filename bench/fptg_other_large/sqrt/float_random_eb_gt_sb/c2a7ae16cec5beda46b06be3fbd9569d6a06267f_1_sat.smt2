(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b011011110 #b01010)
                arg1
                (fp #b0 #b100000100 #b10000)))
(assert (fp.leq (fp #b0 #b100000100 #b10000)
                arg1
                (fp #b0 #b111011101 #b01111)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b000101000 #b01101)
                expect
                (fp #b0 #b100000001 #b10111)))
(assert (fp.leq (fp #b0 #b100000001 #b10111)
                expect
                (fp #b0 #b100110111 #b00011)))

(assert (= expect result))

(check-sat)
(exit)
