(assert (fp.leq (fp #b0 #b000100010001 #b01101101)
                expect
                (fp #b0 #b100100110101 #b10000110)))
(assert (fp.leq (fp #b0 #b100100110101 #b10000110)
                expect
                (fp #b0 #b100101111001 #b00101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
