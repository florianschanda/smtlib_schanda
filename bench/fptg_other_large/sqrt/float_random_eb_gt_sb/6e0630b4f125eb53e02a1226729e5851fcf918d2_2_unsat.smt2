; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b0 #b100100000011100 #b0)
                arg1
                (fp #b0 #b101011110101011 #b1)))
(assert (fp.leq (fp #b0 #b101011110101011 #b1)
                arg1
                (fp #b0 #b110000111001100 #b1)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b001110110000001 #b1)
                expect
                (fp #b0 #b100101111010101 #b1)))
(assert (fp.leq (fp #b0 #b100101111010101 #b1)
                expect
                (fp #b0 #b111101111110010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
