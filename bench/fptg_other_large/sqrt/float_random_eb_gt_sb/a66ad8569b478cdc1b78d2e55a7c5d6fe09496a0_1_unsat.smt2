(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b111011111 #b0010)
                arg1
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg1
                (fp #b0 #b001110101 #b0111)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010110000 #b0111)
                expect
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                expect
                (fp #b0 #b111000011 #b1101)))

(assert (not (= expect result)))

(check-sat)
(exit)
