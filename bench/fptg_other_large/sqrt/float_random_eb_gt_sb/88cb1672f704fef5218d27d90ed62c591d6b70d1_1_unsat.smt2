; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0011101110 #b0000100)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b1101110010 #b1001110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0100001011 #b0101110)
                expect
                (fp #b0 #b0011111111 #b1100011)))
(assert (fp.leq (fp #b0 #b0011111111 #b1100011)
                expect
                (fp #b0 #b1011100001 #b1000110)))

(assert (not (= expect result)))

(check-sat)
(exit)
