                expect
                (fp #b0 #b001111111111110 #b001111)))
(assert (fp.leq (fp #b0 #b001111111111110 #b001111)
                expect
                (fp #b0 #b010011011010000 #b000111)))

(assert (not (= expect result)))

(check-sat)
