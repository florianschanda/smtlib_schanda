; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111001100100 #b100)
                arg1
                (fp #b0 #b00000000000001 #b000)))
(assert (fp.leq (fp #b0 #b00000000000001 #b000)
                arg1
                (fp #b0 #b00101000101011 #b001)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b00000100000010 #b100)
                expect
                (fp #b0 #b01000000000000 #b000)))
(assert (fp.leq (fp #b0 #b01000000000000 #b000)
                expect
                (fp #b0 #b10010000010110 #b001)))

(assert (= expect result))

(check-sat)
(exit)
