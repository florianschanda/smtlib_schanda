(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10110011100 #b00011)
                arg1
                (fp #b1 #b10000000011 #b10110)))
(assert (fp.leq (fp #b1 #b10000000011 #b10110)
                arg1
                (fp #b0 #b00101001000 #b01101)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
