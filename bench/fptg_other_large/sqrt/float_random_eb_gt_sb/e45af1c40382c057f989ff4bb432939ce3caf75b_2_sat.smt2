(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b010010001 #b1)
                arg1
                (fp #b0 #b000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000 #b1)
                arg1
                (fp #b0 #b110100000 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b0 #b001000010 #b1)
                expect
                (fp #b0 #b001111111 #b1)))
(assert (fp.leq (fp #b0 #b001111111 #b1)
                expect
                (fp #b0 #b110000010 #b0)))

(assert (= expect result))

(check-sat)
(exit)
