(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000001001011001 #b11)
                arg1
                (fp #b0 #b011111111111111 #b11)))
(assert (fp.leq (fp #b0 #b011111111111111 #b11)
                arg1
                (fp #b0 #b100001001001011 #b10)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000001010010100 #b11)
                expect
                (fp #b0 #b011111111111111 #b10)))
(assert (fp.leq (fp #b0 #b011111111111111 #b10)
                expect
                (fp #b0 #b111010111100100 #b00)))

(assert (= expect result))

(check-sat)
(exit)
