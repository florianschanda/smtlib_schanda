(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b1011010000 #b01011001)
                arg1
                (fp #b0 #b1110100101 #b00110001)))
(assert (fp.leq (fp #b0 #b1110100101 #b00110001)
                arg1
                (fp #b0 #b1110110101 #b11110010)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0100001110 #b01101011)
                expect
                (fp #b0 #b1011010010 #b00011000)))
(assert (fp.leq (fp #b0 #b1011010010 #b00011000)
                expect
                (fp #b0 #b1110001100 #b11110001)))

(assert (= expect result))

(check-sat)
(exit)
