; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b01101001011 #b0111)
                arg1
                (fp #b0 #b00000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000 #b0001)
                arg1
                (fp #b0 #b10011111001 #b0010)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00101111001 #b1000)
                expect
                (fp #b0 #b00111111110 #b0000)))
(assert (fp.leq (fp #b0 #b00111111110 #b0000)
                expect
                (fp #b0 #b01011110111 #b1111)))

(assert (not (= expect result)))

(check-sat)
(exit)
