(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100100011000 #b10101000)
                arg1
                (fp #b0 #b011111111111 #b11001001)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001001)
                arg1
                (fp #b0 #b110000100011 #b01110011)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101001100011 #b00111010)
                expect
                (fp #b0 #b011111111111 #b01010110)))
(assert (fp.leq (fp #b0 #b011111111111 #b01010110)
                expect
                (fp #b0 #b101100100001 #b10100010)))

(assert (not (= expect result)))

(check-sat)
(exit)
