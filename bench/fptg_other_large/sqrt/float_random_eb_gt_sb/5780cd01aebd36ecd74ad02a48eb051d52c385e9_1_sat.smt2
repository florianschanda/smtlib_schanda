(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
