(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01100101100 #b1001001)
                arg1
                (fp #b0 #b01100111011 #b1011000)))
(assert (fp.leq (fp #b0 #b01100111011 #b1011000)
                arg1
                (fp #b0 #b11111010000 #b0000110)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00011100001 #b0010101)
                expect
                (fp #b0 #b01110011101 #b0100111)))
(assert (fp.leq (fp #b0 #b01110011101 #b0100111)
                expect
                (fp #b0 #b10000110000 #b1111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
