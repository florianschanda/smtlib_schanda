(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01000111010 #b10101)
                arg1
                (fp #b0 #b01111111111 #b10111)))
(assert (fp.leq (fp #b0 #b01111111111 #b10111)
                arg1
                (fp #b0 #b10000111001 #b01011)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00010010101 #b00010)
                expect
                (fp #b0 #b01111111111 #b01001)))
(assert (fp.leq (fp #b0 #b01111111111 #b01001)
                expect
                (fp #b0 #b10110011101 #b11010)))

(assert (= expect result))

(check-sat)
(exit)
