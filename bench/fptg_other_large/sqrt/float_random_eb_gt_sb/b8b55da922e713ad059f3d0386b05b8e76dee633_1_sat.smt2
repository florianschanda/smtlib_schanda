(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000100110 #b00010001)
                arg1
                (fp #b0 #b1101011101 #b11111010)))
(assert (fp.leq (fp #b0 #b1101011101 #b11111010)
                arg1
                (fp #b0 #b1111111110 #b11010000)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001100110 #b11001100)
                expect
                (fp #b0 #b1010101110 #b01100111)))
(assert (fp.leq (fp #b0 #b1010101110 #b01100111)
                expect
                (fp #b0 #b1101010011 #b11110100)))

(assert (= expect result))

(check-sat)
(exit)
