; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100010111101 #b00111)
                arg1
                (fp #b0 #b011111111111 #b10100)))
(assert (fp.leq (fp #b0 #b011111111111 #b10100)
                arg1
                (fp #b0 #b111101100110 #b00101)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b011100011011 #b11010)
                expect
                (fp #b0 #b011111111111 #b01001)))
(assert (fp.leq (fp #b0 #b011111111111 #b01001)
                expect
                (fp #b0 #b111111010010 #b10101)))

(assert (not (= expect result)))

(check-sat)
(exit)
