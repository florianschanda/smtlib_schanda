(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011011011010 #b0110)
                arg1
                (fp #b0 #b001111111110 #b0000)))
(assert (fp.leq (fp #b0 #b001111111110 #b0000)
                arg1
                (fp #b0 #b111001011100 #b1100)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011101010100 #b0101)
                expect
                (fp #b0 #b010111111110 #b0111)))
(assert (fp.leq (fp #b0 #b010111111110 #b0111)
                expect
                (fp #b0 #b100101000110 #b1011)))

(assert (not (= expect result)))

(check-sat)
(exit)
