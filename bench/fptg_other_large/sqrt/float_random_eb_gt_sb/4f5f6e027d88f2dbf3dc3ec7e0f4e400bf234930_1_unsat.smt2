(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0101001001011 #b01001)
                arg1
                (fp #b0 #b0000000000000 #b00001)))
(assert (fp.leq (fp #b0 #b0000000000000 #b00001)
                arg1
                (fp #b0 #b1000000110100 #b11010)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1100101010100 #b11010)
                expect
                (fp #b0 #b0011111111101 #b01101)))
(assert (fp.leq (fp #b0 #b0011111111101 #b01101)
                expect
                (fp #b0 #b1010111011011 #b11111)))

(assert (not (= expect result)))

(check-sat)
(exit)
