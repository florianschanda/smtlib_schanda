(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b001100000 #b1)
                arg1
                (fp #b0 #b011111111 #b1)))
(assert (fp.leq (fp #b0 #b011111111 #b1)
                arg1
                (fp #b0 #b101011110 #b1)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b000101001 #b1)
                expect
                (fp #b0 #b011111111 #b0)))
(assert (fp.leq (fp #b0 #b011111111 #b0)
                expect
                (fp #b0 #b101001000 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
