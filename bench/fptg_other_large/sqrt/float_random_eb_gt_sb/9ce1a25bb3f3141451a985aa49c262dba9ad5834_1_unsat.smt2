;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0110101011101001 #b01111)
                arg1
                (fp #b0 #b0000000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000)
                arg1
                (fp #b0 #b1011111001110101 #b00011)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1001001000110111 #b10110)
                expect
                (fp #b0 #b0011111111111111 #b00000)))
(assert (fp.leq (fp #b0 #b0011111111111111 #b00000)
                expect
                (fp #b0 #b1101001100111000 #b11100)))

(assert (not (= expect result)))

(check-sat)
(exit)
