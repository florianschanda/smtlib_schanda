(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01100101101 #b100)
                arg1
                (fp #b0 #b11100011011 #b001)))
(assert (fp.leq (fp #b0 #b11100011011 #b001)
                arg1
                (fp #b0 #b11111111110 #b000)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b00110011111 #b100)
                expect
                (fp #b0 #b10110001101 #b001)))
(assert (fp.leq (fp #b0 #b10110001101 #b001)
                expect
                (fp #b0 #b11111010101 #b111)))

(assert (= expect result))

(check-sat)
(exit)
