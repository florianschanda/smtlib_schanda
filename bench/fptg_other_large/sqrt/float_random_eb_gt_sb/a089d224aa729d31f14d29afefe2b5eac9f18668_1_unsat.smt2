(assert (fp.leq (fp #b0 #b0010110110011 #b1011)
                expect
                (fp #b0 #b0111111111111 #b0010)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0010)
                expect
                (fp #b0 #b1000001100111 #b0101)))

(assert (not (= expect result)))

(check-sat)
(exit)
