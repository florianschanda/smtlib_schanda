(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100110011101 #b0011100)
                arg1
                (fp #b0 #b101100000101 #b0010011)))
(assert (fp.leq (fp #b0 #b101100000101 #b0010011)
                arg1
                (fp #b0 #b110110100001 #b0000110)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b011101001010 #b0101000)
                expect
                (fp #b0 #b100110000010 #b0001001)))
(assert (fp.leq (fp #b0 #b100110000010 #b0001001)
                expect
                (fp #b0 #b101110101001 #b1001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
