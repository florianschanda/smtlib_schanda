(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001101010 #b0000001)
                arg1
                (fp #b1 #b0000000000 #b1101100)))
(assert (fp.leq (fp #b1 #b0000000000 #b1101100)
                arg1
                (fp #b0 #b1101000111 #b1011010)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
