; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0100010010100 #b00110)
                arg1
                (fp #b1 #b0001001001010 #b01010)))
(assert (fp.leq (fp #b1 #b0001001001010 #b01010)
                arg1
                (fp #b0 #b0111010001100 #b11010)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
