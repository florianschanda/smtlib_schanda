(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b100111001010 #b10)
                arg1
                (fp #b0 #b110010000111 #b10)))
(assert (fp.leq (fp #b0 #b110010000111 #b10)
                arg1
                (fp #b0 #b110011101110 #b00)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000000000101 #b01)
                expect
                (fp #b0 #b101001000011 #b00)))
(assert (fp.leq (fp #b0 #b101001000011 #b00)
                expect
                (fp #b0 #b110111010111 #b01)))

(assert (= expect result))

(check-sat)
(exit)
