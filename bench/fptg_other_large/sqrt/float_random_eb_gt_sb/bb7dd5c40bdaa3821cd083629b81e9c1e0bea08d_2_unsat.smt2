; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b01111100110010101 #b100)
                arg1
                (fp #b0 #b00111111111111110 #b011)))
(assert (fp.leq (fp #b0 #b00111111111111110 #b011)
                arg1
                (fp #b0 #b10110011000010011 #b010)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11001000110001111 #b100)
                expect
                (fp #b0 #b01011111111111110 #b110)))
(assert (fp.leq (fp #b0 #b01011111111111110 #b110)
                expect
                (fp #b0 #b10101000000011000 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
