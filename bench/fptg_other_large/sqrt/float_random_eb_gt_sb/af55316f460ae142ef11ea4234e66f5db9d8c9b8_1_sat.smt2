(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11011100111001 #b110)
                arg1
                (fp #b0 #b01111111111111 #b101)))
(assert (fp.leq (fp #b0 #b01111111111111 #b101)
                arg1
                (fp #b0 #b11011111110010 #b000)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b01010000010000 #b110)
                expect
                (fp #b0 #b01111111111111 #b010)))
(assert (fp.leq (fp #b0 #b01111111111111 #b010)
                expect
                (fp #b0 #b11010011101001 #b111)))

(assert (= expect result))

(check-sat)
(exit)
