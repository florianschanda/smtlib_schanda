; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b000100011001111100 #b110)
                arg1
                (fp #b0 #b100000000000000010 #b000)))
(assert (fp.leq (fp #b0 #b100000000000000010 #b000)
                arg1
                (fp #b0 #b100011100010100101 #b001)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b111100101101110111 #b000)
                expect
                (fp #b0 #b100000000000000000 #b100)))
(assert (fp.leq (fp #b0 #b100000000000000000 #b100)
                expect
                (fp #b0 #b101010011110011000 #b010)))

(assert (= expect result))

(check-sat)
(exit)
