(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1001110100100100 #b10100001000)
                arg1
                (fp #b1 #b1000101001110111 #b00100011101)))
(assert (fp.leq (fp #b1 #b1000101001110111 #b00100011101)
                arg1
                (fp #b1 #b0011111010101000 #b11110110011)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
