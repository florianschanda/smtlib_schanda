;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000011010111 #b10000)
                arg1
                (fp #b0 #b0011000011100 #b10000)))
(assert (fp.leq (fp #b0 #b0011000011100 #b10000)
                arg1
                (fp #b0 #b1010110011000 #b01100)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1000011110110 #b00010)
                expect
                (fp #b0 #b0101100001101 #b10111)))
(assert (fp.leq (fp #b0 #b0101100001101 #b10111)
                expect
                (fp #b0 #b1010011001000 #b01101)))

(assert (not (= expect result)))

(check-sat)
(exit)
