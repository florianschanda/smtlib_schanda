(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001100001 #b0110)
                arg1
                (fp #b0 #b1000000010 #b0010)))
(assert (fp.leq (fp #b0 #b1000000010 #b0010)
                arg1
                (fp #b0 #b1000000011 #b0000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111110 #b1110)
                expect
                (fp #b0 #b1000000000 #b1000)))
(assert (fp.leq (fp #b0 #b1000000000 #b1000)
                expect
                (fp #b0 #b1100110011 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
