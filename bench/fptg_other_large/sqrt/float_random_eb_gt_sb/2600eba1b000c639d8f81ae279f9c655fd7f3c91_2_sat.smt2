(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0001100110011011 #b100001)
                arg1
                (fp #b0 #b0000000000000000 #b110101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110101)
                arg1
                (fp #b0 #b1010000001101011 #b010111)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0101100110111011 #b010110)
                expect
                (fp #b0 #b0011111111111111 #b110101)))
(assert (fp.leq (fp #b0 #b0011111111111111 #b110101)
                expect
                (fp #b0 #b1011110001010100 #b010101)))

(assert (= expect result))

(check-sat)
(exit)
