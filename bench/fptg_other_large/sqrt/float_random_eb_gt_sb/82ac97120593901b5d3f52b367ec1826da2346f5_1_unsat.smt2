; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1011110111010101 #b00)
                arg1
                (fp #b0 #b0100000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0100000000000000 #b00)
                arg1
                (fp #b0 #b0111101111110000 #b10)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0101000011110110 #b01)
                expect
                (fp #b0 #b0101111111111111 #b01)))
(assert (fp.leq (fp #b0 #b0101111111111111 #b01)
                expect
                (fp #b0 #b1111011010010001 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
