(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101100000111 #b101)
                arg1
                (fp #b0 #b100000000010 #b100)))
(assert (fp.leq (fp #b0 #b100000000010 #b100)
                arg1
                (fp #b0 #b111110000000 #b010)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b000101110110 #b011)
                expect
                (fp #b0 #b100000000000 #b101)))
(assert (fp.leq (fp #b0 #b100000000000 #b101)
                expect
                (fp #b0 #b101100110011 #b110)))

(assert (= expect result))

(check-sat)
(exit)
