(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01010101101 #b00001)
                arg1
                (fp #b0 #b11010111000 #b11101)))
(assert (fp.leq (fp #b0 #b11010111000 #b11101)
                arg1
                (fp #b0 #b11100000001 #b01111)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01100100011 #b10101)
                expect
                (fp #b0 #b10101011011 #b11110)))
(assert (fp.leq (fp #b0 #b10101011011 #b11110)
                expect
                (fp #b0 #b11101011001 #b00100)))

(assert (not (= expect result)))

(check-sat)
(exit)
