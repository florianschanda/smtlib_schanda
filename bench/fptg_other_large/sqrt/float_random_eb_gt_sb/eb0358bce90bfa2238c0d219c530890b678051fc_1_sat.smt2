(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00000010101100 #b0110100011)
                arg1
                (fp #b1 #b00000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000)
                arg1
                (fp #b0 #b01011011000101 #b1001101110)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01000100010101 #b0011111111)
                expect
                (fp #b1 #b00000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000)
                expect
                (fp #b0 #b11101101001001 #b0010011011)))

(assert (= expect result))

(check-sat)
(exit)
