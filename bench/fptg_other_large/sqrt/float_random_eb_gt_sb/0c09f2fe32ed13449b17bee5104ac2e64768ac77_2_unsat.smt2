; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b01010101111 #b0001)
                arg1
                (fp #b0 #b11100100110 #b0111)))
(assert (fp.leq (fp #b0 #b11100100110 #b0111)
                arg1
                (fp #b0 #b11111001010 #b0100)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111001011 #b0111)
                expect
                (fp #b0 #b10110010010 #b1100)))
(assert (fp.leq (fp #b0 #b10110010010 #b1100)
                expect
                (fp #b0 #b10111101011 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
