(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b1011011111010 #b1110101001)
                expect
                (fp #b0 #b1001111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b1001111111110 #b1111111111)
                expect
                (fp #b0 #b1010110111101 #b0101001010)))

(assert (= expect result))

(check-sat)
(exit)
