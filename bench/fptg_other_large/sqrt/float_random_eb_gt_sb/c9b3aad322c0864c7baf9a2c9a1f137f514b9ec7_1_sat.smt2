;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b1 #b0000010100110 #b0101101100)
                arg1
                (fp #b0 #b1011111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b1011111111110 #b1111111111)
                arg1
