(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0101001100 #b11001)
                arg1
                (fp #b0 #b1001111101 #b01111)))
(assert (fp.leq (fp #b0 #b1001111101 #b01111)
                arg1
                (fp #b0 #b1101111111 #b11001)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101011110 #b11100)
                expect
                (fp #b0 #b1000111110 #b00111)))
(assert (fp.leq (fp #b0 #b1000111110 #b00111)
                expect
                (fp #b0 #b1110111101 #b00010)))

(assert (= expect result))

(check-sat)
(exit)
