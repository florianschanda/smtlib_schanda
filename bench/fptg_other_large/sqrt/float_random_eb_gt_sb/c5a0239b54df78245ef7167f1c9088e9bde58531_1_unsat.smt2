; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11001100111100 #b00)
                arg1
                (fp #b1 #b10000000000000 #b10)))
(assert (fp.leq (fp #b1 #b10000000000000 #b10)
                arg1
                (fp #b0 #b00011110100101 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
