(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1011101111001 #b00111)
                arg1
                (fp #b1 #b0111111111111 #b11001)))
(assert (fp.leq (fp #b1 #b0111111111111 #b11001)
                arg1
                (fp #b0 #b0000000110001 #b10100)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
