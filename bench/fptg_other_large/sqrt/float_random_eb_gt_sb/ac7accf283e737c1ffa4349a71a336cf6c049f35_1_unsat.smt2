(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10000000100 #b0100)
                arg1
                (fp #b0 #b01010001101 #b0011)))
(assert (fp.leq (fp #b0 #b01010001101 #b0011)
                arg1
                (fp #b0 #b01111010101 #b0011)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11011011000 #b1010)
                expect
                (fp #b0 #b01101000110 #b0001)))
(assert (fp.leq (fp #b0 #b01101000110 #b0001)
                expect
                (fp #b0 #b01110001000 #b1010)))

(assert (not (= expect result)))

(check-sat)
(exit)
