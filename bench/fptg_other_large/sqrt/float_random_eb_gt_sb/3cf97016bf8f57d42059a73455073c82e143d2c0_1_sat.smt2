(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11011010011 #b0110011)
                arg1
                (fp #b0 #b11101110100 #b0011010)))
(assert (fp.leq (fp #b0 #b11101110100 #b0011010)
                arg1
                (fp #b0 #b11111101000 #b0101110)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10010111001 #b0001001)
                expect
                (fp #b0 #b10110111001 #b1000110)))
(assert (fp.leq (fp #b0 #b10110111001 #b1000110)
                expect
                (fp #b0 #b11100100010 #b1110100)))

(assert (= expect result))

(check-sat)
(exit)
