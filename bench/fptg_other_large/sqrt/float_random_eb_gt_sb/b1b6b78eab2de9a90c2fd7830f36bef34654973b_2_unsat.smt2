(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10010001010 #b101)
                arg1
                (fp #b0 #b11010111011 #b010)))
(assert (fp.leq (fp #b0 #b11010111011 #b010)
                arg1
                (fp #b0 #b11100011011 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b01001110111 #b000)
                expect
                (fp #b0 #b10101011101 #b001)))
(assert (fp.leq (fp #b0 #b10101011101 #b001)
                expect
                (fp #b0 #b11101001000 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
