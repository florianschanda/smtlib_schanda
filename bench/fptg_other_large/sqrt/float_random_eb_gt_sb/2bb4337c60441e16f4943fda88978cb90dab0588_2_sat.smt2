; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b100010100111011001 #b100)
                arg1
                (fp #b0 #b011110001000010111 #b111)))
(assert (fp.leq (fp #b0 #b011110001000010111 #b111)
                arg1
                (fp #b0 #b110100011111001001 #b000)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b101001101000101100 #b001)
                expect
                (fp #b0 #b011111000100001011 #b011)))
(assert (fp.leq (fp #b0 #b011111000100001011 #b011)
                expect
                (fp #b0 #b100101111110110011 #b001)))

(assert (= expect result))

(check-sat)
(exit)
