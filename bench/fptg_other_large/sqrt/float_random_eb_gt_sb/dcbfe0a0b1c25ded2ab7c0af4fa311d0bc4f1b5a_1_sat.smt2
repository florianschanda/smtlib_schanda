(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10111000001000 #b0111)
                arg1
                (fp #b1 #b00000000000000 #b1000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1000)
                arg1
                (fp #b0 #b01111100010010 #b1010)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
