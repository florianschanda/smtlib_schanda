(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11111100101 #b0001001)
                arg1
                (fp #b0 #b11111001111 #b1010011)))
(assert (fp.leq (fp #b0 #b11111001111 #b1010011)
                arg1
                (fp #b0 #b11111110000 #b0110010)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10111001001 #b0100010)
                expect
                (fp #b0 #b10111100111 #b0100100)))
(assert (fp.leq (fp #b0 #b10111100111 #b0100100)
                expect
                (fp #b0 #b11011110101 #b0100000)))

(assert (= expect result))

(check-sat)
(exit)
