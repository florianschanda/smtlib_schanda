; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110010011110 #b0110001000)
                arg1
                (fp #b0 #b010000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b010000000000 #b0000000000)
                arg1
                (fp #b0 #b011010110110 #b0000100101)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b110011100011 #b1101111101)
                expect
                (fp #b0 #b010111111111 #b0110101000)))
(assert (fp.leq (fp #b0 #b010111111111 #b0110101000)
                expect
                (fp #b0 #b100001100110 #b1100101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
