; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111001100101011 #b1111001)
                arg1
                (fp #b1 #b010101101111100 #b1000010)))
(assert (fp.leq (fp #b1 #b010101101111100 #b1000010)
                arg1
                (fp #b0 #b100000100010100 #b0111111)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
