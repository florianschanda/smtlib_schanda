; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101100100 #b1111100)
                arg1
                (fp #b1 #b100000110 #b0011101)))
(assert (fp.leq (fp #b1 #b100000110 #b0011101)
                arg1
                (fp #b0 #b001100001 #b1000011)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
