(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01110100101 #b11011)
                arg1
                (fp #b0 #b10000000100 #b11101)))
(assert (fp.leq (fp #b0 #b10000000100 #b11101)
                arg1
                (fp #b0 #b10010001011 #b10001)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b01111100000 #b11101)
                expect
                (fp #b0 #b10000000001 #b11110)))
(assert (fp.leq (fp #b0 #b10000000001 #b11110)
                expect
                (fp #b0 #b11000100101 #b11100)))

(assert (= expect result))

(check-sat)
(exit)
