; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b1 #b11111001110110001 #b1111000100)
                arg1
                (fp #b1 #b01111111111111111 #b0011010000)))
(assert (fp.leq (fp #b1 #b01111111111111111 #b0011010000)
                arg1
                (fp #b0 #b10000011011101011 #b1010111100)))

(declare-const result (_ FloatingPoint 17 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 17 11))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
