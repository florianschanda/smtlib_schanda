; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01111100110110 #b1101)
                arg1
                (fp #b0 #b00000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0001)
                arg1
                (fp #b0 #b10100000111100 #b0101)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01101110010010 #b1111)
                expect
                (fp #b0 #b00111111111110 #b0000)))
(assert (fp.leq (fp #b0 #b00111111111110 #b0000)
                expect
                (fp #b0 #b10101001010111 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
