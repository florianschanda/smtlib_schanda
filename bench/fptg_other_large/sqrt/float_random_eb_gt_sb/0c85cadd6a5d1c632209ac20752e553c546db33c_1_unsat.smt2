; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000011001 #b10001001)
                arg1
                (fp #b1 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000000)
                arg1
                (fp #b0 #b0110100011 #b10010111)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
