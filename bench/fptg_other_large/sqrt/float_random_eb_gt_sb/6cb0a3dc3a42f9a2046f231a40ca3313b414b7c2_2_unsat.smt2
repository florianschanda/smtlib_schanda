(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0010111110010 #b1001)
                arg1
                (fp #b0 #b0110101001100 #b0100)))
(assert (fp.leq (fp #b0 #b0110101001100 #b0100)
                arg1
                (fp #b0 #b1101011000000 #b0110)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b0000111011001 #b1000)
                expect
                (fp #b0 #b0111010100101 #b1010)))
(assert (fp.leq (fp #b0 #b0111010100101 #b1010)
                expect
                (fp #b0 #b1011100001010 #b0101)))

(assert (not (= expect result)))

(check-sat)
(exit)
