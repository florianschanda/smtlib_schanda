(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b00010010101 #b11100111)
                arg1
                (fp #b0 #b11010101101 #b10010001)))
(assert (fp.leq (fp #b0 #b11010101101 #b10010001)
                arg1
                (fp #b0 #b11011100000 #b10000101)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b01011011010 #b01011110)
                expect
                (fp #b0 #b10101010110 #b01000001)))
(assert (fp.leq (fp #b0 #b10101010110 #b01000001)
                expect
                (fp #b0 #b10101101111 #b00001110)))

(assert (= expect result))

(check-sat)
(exit)
