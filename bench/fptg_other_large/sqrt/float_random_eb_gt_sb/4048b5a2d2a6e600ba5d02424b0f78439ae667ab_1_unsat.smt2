(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1000110000100001 #b0110011)
                arg1
                (fp #b1 #b0100000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b0000000)
                arg1
                (fp #b0 #b0010110101001100 #b0000110)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
