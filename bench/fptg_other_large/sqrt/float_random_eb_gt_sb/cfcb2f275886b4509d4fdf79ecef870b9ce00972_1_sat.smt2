(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b100111000001 #b011)
                arg1
                (fp #b1 #b100000000001 #b010)))
(assert (fp.leq (fp #b1 #b100000000001 #b010)
                arg1
                (fp #b0 #b101100111011 #b101)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
