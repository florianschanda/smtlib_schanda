(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100101001 #b010)
                arg1
                (fp #b0 #b1011110101 #b000)))
(assert (fp.leq (fp #b0 #b1011110101 #b000)
                arg1
                (fp #b0 #b1111011010 #b100)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111010110 #b010)
                expect
                (fp #b0 #b1001111010 #b000)))
(assert (fp.leq (fp #b0 #b1001111010 #b000)
                expect
                (fp #b0 #b1110010110 #b100)))

(assert (= expect result))

(check-sat)
(exit)
