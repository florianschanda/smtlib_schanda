; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0001000010100 #b1100000)
                arg1
                (fp #b0 #b0000000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000000 #b1100101)
                arg1
                (fp #b0 #b0101000111100 #b0111000)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1100000010010 #b0010110)
                expect
                (fp #b0 #b0011111111111 #b1100011)))
(assert (fp.leq (fp #b0 #b0011111111111 #b1100011)
                expect
                (fp #b0 #b1001110000100 #b1011101)))

(assert (= expect result))

(check-sat)
(exit)
