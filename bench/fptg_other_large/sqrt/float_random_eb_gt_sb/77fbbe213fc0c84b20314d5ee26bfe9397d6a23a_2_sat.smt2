; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b00001100110 #b01100000)
                arg1
                (fp #b0 #b10111110111 #b10100111)))
(assert (fp.leq (fp #b0 #b10111110111 #b10100111)
                arg1
                (fp #b0 #b11000110001 #b10110001)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b0 #b01101011001 #b10001101)
                expect
                (fp #b0 #b10011111011 #b01001010)))
(assert (fp.leq (fp #b0 #b10011111011 #b01001010)
                expect
                (fp #b0 #b11100111010 #b01010110)))

(assert (= expect result))

(check-sat)
(exit)
