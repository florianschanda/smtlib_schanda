(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111100100 #b0100111)
                arg1
                (fp #b0 #b000000000 #b1011100)))
(assert (fp.leq (fp #b0 #b000000000 #b1011100)
                arg1
                (fp #b0 #b101011101 #b1100111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b010011110 #b0010110)
                expect
                (fp #b0 #b001111111 #b1011010)))
(assert (fp.leq (fp #b0 #b001111111 #b1011010)
                expect
                (fp #b0 #b111111011 #b0111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
