; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111001010000000 #b10100100111001)
                arg1
                (fp #b1 #b011111111111111 #b01101011001011)))
(assert (fp.leq (fp #b1 #b011111111111111 #b01101011001011)
                arg1
                (fp #b0 #b100110101111101 #b11001001101101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
