(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000010000 #b001000011)
                arg1
                (fp #b0 #b0000000000 #b000000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000001)
                arg1
                (fp #b0 #b0111110011 #b011100111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001011100 #b111010001)
                expect
                (fp #b0 #b0011111011 #b011010100)))
(assert (fp.leq (fp #b0 #b0011111011 #b011010100)
                expect
                (fp #b0 #b1001001111 #b010001110)))

(assert (= expect result))

(check-sat)
(exit)
