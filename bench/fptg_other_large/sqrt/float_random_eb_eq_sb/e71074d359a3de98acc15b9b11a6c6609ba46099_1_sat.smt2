(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b0 #b0000101011010100 #b001111100010111)
                expect
                (fp #b0 #b1000000000000110 #b011110110101010)))
(assert (fp.leq (fp #b0 #b1000000000000110 #b011110110101010)
                expect
                (fp #b0 #b1011110000110010 #b000111110010001)))

(assert (= expect result))

(check-sat)
(exit)
