;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10000011101011 #b1100100000110)
                arg1
                (fp #b1 #b10000000001100 #b1111100010101)))
(assert (fp.leq (fp #b1 #b10000000001100 #b1111100010101)
                arg1
                (fp #b1 #b01111101000110 #b0010110010000)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
