(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110100 #b01011011)
                arg1
                (fp #b0 #b010001111 #b10110101)))
(assert (fp.leq (fp #b0 #b010001111 #b10110101)
                arg1
                (fp #b0 #b011000011 #b10101011)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100110001 #b00101101)
                expect
                (fp #b0 #b011000111 #b01001110)))
(assert (fp.leq (fp #b0 #b011000111 #b01001110)
                expect
                (fp #b0 #b011110000 #b00010001)))

(assert (= expect result))

(check-sat)
(exit)
