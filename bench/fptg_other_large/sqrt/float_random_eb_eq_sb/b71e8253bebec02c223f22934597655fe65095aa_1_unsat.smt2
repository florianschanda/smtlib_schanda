; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100010010010111 #b10010010111111)
                arg1
                (fp #b1 #b100000000001101 #b11110010010110)))
(assert (fp.leq (fp #b1 #b100000000001101 #b11110010010110)
                arg1
                (fp #b0 #b010101001011100 #b11111011000101)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
