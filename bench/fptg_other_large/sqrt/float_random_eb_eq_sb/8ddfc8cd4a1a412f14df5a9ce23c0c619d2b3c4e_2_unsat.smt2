                expect
                (fp #b0 #b10000000100 #b0100011101)))
(assert (fp.leq (fp #b0 #b10000000100 #b0100011101)
                expect
                (fp #b0 #b10110101001 #b0011001010)))

(assert (not (= expect result)))

(check-sat)
