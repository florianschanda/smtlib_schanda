;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000101100 #b000000010)
                arg1
                (fp #b0 #b0111111111 #b110010111)))
(assert (fp.leq (fp #b0 #b0111111111 #b110010111)
                arg1
                (fp #b0 #b1101011101 #b111101010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110110001 #b011000001)
                expect
                (fp #b0 #b0111111111 #b010101101)))
(assert (fp.leq (fp #b0 #b0111111111 #b010101101)
                expect
                (fp #b0 #b1010110100 #b001010101)))

(assert (= expect result))

(check-sat)
(exit)
