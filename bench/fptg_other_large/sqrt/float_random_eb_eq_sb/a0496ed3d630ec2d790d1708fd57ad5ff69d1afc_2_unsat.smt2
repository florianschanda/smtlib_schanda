(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011001 #b111000000)
                arg1
                (fp #b0 #b0011100110 #b101001010)))
(assert (fp.leq (fp #b0 #b0011100110 #b101001010)
                arg1
