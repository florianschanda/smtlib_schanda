(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1000000111 #b100100101)
                expect
                (fp #b0 #b0101110010 #b110100001)))
(assert (fp.leq (fp #b0 #b0101110010 #b110100001)
                expect
                (fp #b0 #b1010110100 #b000101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
