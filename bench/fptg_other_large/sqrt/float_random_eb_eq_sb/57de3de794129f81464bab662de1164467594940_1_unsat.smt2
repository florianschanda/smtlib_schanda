; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1110101011 #b001011111)
                arg1
                (fp #b1 #b1110000000 #b111101111)))
(assert (fp.leq (fp #b1 #b1110000000 #b111101111)
                arg1
                (fp #b1 #b0111000010 #b100100110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
