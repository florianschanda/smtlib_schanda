                expect
                (fp #b0 #b01111111111 #b0100001110)))
(assert (fp.leq (fp #b0 #b01111111111 #b0100001110)
                expect
                (fp #b0 #b10111000010 #b0111111101)))

(assert (not (= expect result)))

(check-sat)
