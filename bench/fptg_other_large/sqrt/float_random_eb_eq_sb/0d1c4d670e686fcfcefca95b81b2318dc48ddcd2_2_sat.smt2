(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110001000 #b00000100101)
                arg1
                (fp #b0 #b101111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b101111111110 #b11111111111)
                arg1
                (fp #b0 #b110001000001 #b10011100001)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b001110110110 #b00101101100)
                expect
                (fp #b0 #b100111111111 #b00000000000)))
(assert (fp.leq (fp #b0 #b100111111111 #b00000000000)
                expect
                (fp #b0 #b110110100101 #b10000011110)))

(assert (= expect result))

(check-sat)
(exit)
