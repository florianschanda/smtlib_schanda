                expect
                (fp #b0 #b010111111100 #b10101110101)))
(assert (fp.leq (fp #b0 #b010111111100 #b10101110101)
                expect
                (fp #b0 #b101001111100 #b10111010011)))

(assert (not (= expect result)))

(check-sat)
