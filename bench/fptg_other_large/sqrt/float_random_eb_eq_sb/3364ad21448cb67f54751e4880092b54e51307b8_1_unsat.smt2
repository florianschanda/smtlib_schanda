(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00001101001 #b1101100101)
                expect
                (fp #b0 #b01100000011 #b1100000101)))
(assert (fp.leq (fp #b0 #b01100000011 #b1100000101)
                expect
                (fp #b0 #b10101001011 #b1000010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
