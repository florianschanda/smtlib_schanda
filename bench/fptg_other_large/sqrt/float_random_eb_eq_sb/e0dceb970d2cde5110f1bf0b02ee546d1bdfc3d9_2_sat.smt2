(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0011001111 #b100101100)
                arg1
                (fp #b0 #b1010111011 #b011110001)))
(assert (fp.leq (fp #b0 #b1010111011 #b011110001)
                arg1
                (fp #b0 #b1100011011 #b000000111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0110111111 #b010000000)
                expect
                (fp #b0 #b1001011101 #b001101101)))
(assert (fp.leq (fp #b0 #b1001011101 #b001101101)
                expect
                (fp #b0 #b1111101011 #b110101011)))

(assert (= expect result))

(check-sat)
(exit)
