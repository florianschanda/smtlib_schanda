(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011000100 #b10011101)
                arg1
                (fp #b0 #b100101101 #b00110100)))
(assert (fp.leq (fp #b0 #b100101101 #b00110100)
                arg1
                (fp #b0 #b101011010 #b11111010)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b100000000 #b00010101)
                expect
                (fp #b0 #b100010110 #b00011001)))
(assert (fp.leq (fp #b0 #b100010110 #b00011001)
                expect
                (fp #b0 #b111110111 #b11000101)))

(assert (= expect result))

(check-sat)
(exit)
