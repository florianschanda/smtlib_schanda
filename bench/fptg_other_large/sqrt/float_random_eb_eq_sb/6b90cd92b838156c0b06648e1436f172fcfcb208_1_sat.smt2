; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0010111001111110 #b010010010111011)
                arg1
                (fp #b1 #b0000000000000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b010010100000101)
                arg1
                (fp #b0 #b1110101010010111 #b111000100000001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
