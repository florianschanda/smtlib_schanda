(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10000010110 #b0110111000)
                expect
                (fp #b0 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b01010101100 #b1010101000)))

(assert (not (= expect result)))

(check-sat)
(exit)
