;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11010101011 #b1110000100)
                arg1
                (fp #b1 #b01111111111 #b0001011101)))
(assert (fp.leq (fp #b1 #b01111111111 #b0001011101)
                arg1
                (fp #b1 #b01010001001 #b1001011111)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
