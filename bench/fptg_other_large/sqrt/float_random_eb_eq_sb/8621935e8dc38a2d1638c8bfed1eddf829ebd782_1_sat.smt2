; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111101001 #b0000101011)
                arg1
                (fp #b1 #b10010100001 #b0000011110)))
(assert (fp.leq (fp #b1 #b10010100001 #b0000011110)
                arg1
                (fp #b0 #b10011110110 #b0101001010)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
