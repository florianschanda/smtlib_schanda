(assert (fp.leq (fp #b0 #b0100001100111111 #b011001000011110)
                expect
                (fp #b0 #b1010100100010100 #b101100101111100)))
(assert (fp.leq (fp #b0 #b1010100100010100 #b101100101111100)
                expect
                (fp #b0 #b1100000001110001 #b010101111011000)))

(assert (= expect result))

(check-sat)
(exit)
