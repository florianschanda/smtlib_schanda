(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b011011010010 #b10011011101)
                expect
                (fp #b0 #b000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000)
                expect
                (fp #b0 #b110101101001 #b10000100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
