(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000101011111100 #b110110000111000)
                arg1
                (fp #b1 #b0100000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0100000000000000 #b000000000000000)
                arg1
                (fp #b0 #b0010001001101100 #b011111100111100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
