;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1000001000010101 #b101011101000111)
                arg1
                (fp #b1 #b0000000000000000 #b000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000001)
                arg1
                (fp #b0 #b1000011011101011 #b110001000011011)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
