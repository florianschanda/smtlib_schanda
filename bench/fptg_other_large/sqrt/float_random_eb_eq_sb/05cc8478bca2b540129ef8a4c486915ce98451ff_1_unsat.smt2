(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011010111 #b10110100)
                expect
                (fp #b0 #b001111111 #b00000000)))
(assert (fp.leq (fp #b0 #b001111111 #b00000000)
                expect
                (fp #b0 #b100000110 #b11001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
