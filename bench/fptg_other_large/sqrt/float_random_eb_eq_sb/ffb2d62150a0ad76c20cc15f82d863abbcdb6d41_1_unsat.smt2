;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11001101100111 #b0110101111101)
                arg1
                (fp #b1 #b10101011110001 #b1000100010111)))
(assert (fp.leq (fp #b1 #b10101011110001 #b1000100010111)
                arg1
                (fp #b1 #b00011011111111 #b0001110000010)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
