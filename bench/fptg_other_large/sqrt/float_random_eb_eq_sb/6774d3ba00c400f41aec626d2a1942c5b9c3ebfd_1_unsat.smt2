(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001011111 #b001110111)
                expect
                (fp #b0 #b1000000011 #b000000001)))
(assert (fp.leq (fp #b0 #b1000000011 #b000000001)
                expect
                (fp #b0 #b1000010110 #b110110110)))

(assert (not (= expect result)))

(check-sat)
(exit)
