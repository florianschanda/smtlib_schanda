(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b0 #b0001111110 #b000101101)
                arg1
                (fp #b0 #b1000000111 #b000000100)))
(assert (fp.leq (fp #b0 #b1000000111 #b000000100)
                arg1
