(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111110001001 #b00111100011)
                arg1
                (fp #b1 #b111000110101 #b11001110101)))
(assert (fp.leq (fp #b1 #b111000110101 #b11001110101)
                arg1
                (fp #b0 #b001111010001 #b01000100011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
