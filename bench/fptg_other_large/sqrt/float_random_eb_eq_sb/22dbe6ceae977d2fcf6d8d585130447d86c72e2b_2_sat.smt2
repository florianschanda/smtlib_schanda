; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100000101 #b100100111)
                arg1
                (fp #b0 #b1000000111 #b000111000)))
(assert (fp.leq (fp #b0 #b1000000111 #b000111000)
                arg1
                (fp #b0 #b1101110101 #b001100011)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101100010 #b000001110)
                expect
                (fp #b0 #b1000000011 #b000011100)))
(assert (fp.leq (fp #b0 #b1000000011 #b000011100)
                expect
                (fp #b0 #b1101101001 #b000010101)))

(assert (= expect result))

(check-sat)
(exit)
