; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INT_BOUNDARY

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110111101 #b10011000)
                arg1
                (fp #b0 #b100001000 #b00000000)))
(assert (fp.leq (fp #b0 #b100001000 #b00000000)
                arg1
                (fp #b0 #b100111100 #b10000000)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b010001000 #b11100000)
                expect
                (fp #b0 #b100000011 #b01101011)))
(assert (fp.leq (fp #b0 #b100000011 #b01101011)
                expect
                (fp #b0 #b100111100 #b01001001)))

(assert (not (= expect result)))

(check-sat)
(exit)
