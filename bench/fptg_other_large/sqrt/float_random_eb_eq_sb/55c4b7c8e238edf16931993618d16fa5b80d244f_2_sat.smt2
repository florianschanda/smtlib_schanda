;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1101011100 #b011111010)
                arg1
                (fp #b0 #b0110000111 #b111010101)))
(assert (fp.leq (fp #b0 #b0110000111 #b111010101)
                arg1
                (fp #b0 #b1110110100 #b000110101)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0011010111 #b011011110)
                expect
                (fp #b0 #b0111000011 #b011000101)))
(assert (fp.leq (fp #b0 #b0111000011 #b011000101)
                expect
                (fp #b0 #b1100111111 #b000001100)))

(assert (= expect result))

(check-sat)
(exit)
