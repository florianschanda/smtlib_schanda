                expect
                (fp #b0 #b100111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b100111111110 #b11111111111)
                expect
                (fp #b0 #b110110100101 #b00110001001)))

(assert (not (= expect result)))

