; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100001001011101 #b11010111001100)
                arg1
                (fp #b1 #b010010001010110 #b11000010000100)))
(assert (fp.leq (fp #b1 #b010010001010110 #b11000010000100)
                arg1
                (fp #b0 #b011111111000101 #b00000100101000)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
