; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b010011011010 #b01110100001)
                arg1
                (fp #b0 #b011111111111 #b11001111101)))
(assert (fp.leq (fp #b0 #b011111111111 #b11001111101)
                arg1
                (fp #b0 #b111111101111 #b00111100011)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000000101 #b00010101001)
                expect
                (fp #b0 #b011111111111 #b01011000100)))
(assert (fp.leq (fp #b0 #b011111111111 #b01011000100)
                expect
                (fp #b0 #b101110001110 #b00001110110)))

(assert (= expect result))

(check-sat)
(exit)
