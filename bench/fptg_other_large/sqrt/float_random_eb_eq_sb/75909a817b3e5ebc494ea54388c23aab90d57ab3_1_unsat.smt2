; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b110011010 #b01000011)
                arg1
                (fp #b0 #b000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b000000000 #b01010111)
                arg1
                (fp #b0 #b110011101 #b00100100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b000111011 #b01011101)
                expect
                (fp #b0 #b001111111 #b00101010)))
(assert (fp.leq (fp #b0 #b001111111 #b00101010)
                expect
                (fp #b0 #b101000110 #b01111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
