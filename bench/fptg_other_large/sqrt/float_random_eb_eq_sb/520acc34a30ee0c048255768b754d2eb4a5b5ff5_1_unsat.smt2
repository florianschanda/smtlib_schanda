;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110100100000110 #b01101000011010)
                arg1
                (fp #b1 #b000000001011101 #b10111000000011)))
(assert (fp.leq (fp #b1 #b000000001011101 #b10111000000011)
                arg1
                (fp #b0 #b101100010011100 #b10110100011011)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
