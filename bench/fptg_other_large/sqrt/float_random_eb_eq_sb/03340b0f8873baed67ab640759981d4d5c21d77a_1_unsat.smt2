;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b100101011010011 #b10110111010000)
                arg1
                (fp #b1 #b100000000001010 #b00010011100000)))
(assert (fp.leq (fp #b1 #b100000000001010 #b00010011100000)
                arg1
                (fp #b0 #b111000000101000 #b01000000100111)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
