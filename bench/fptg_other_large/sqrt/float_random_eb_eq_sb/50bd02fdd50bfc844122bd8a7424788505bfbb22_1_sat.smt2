(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(5)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b01010101110 #b0101100100)
                arg1
                (fp #b0 #b01101110000 #b1101101101)))
(assert (fp.leq (fp #b0 #b01101110000 #b1101101101)
                arg1
                (fp #b0 #b11000000010 #b1000100000)))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b0 #b00110100010 #b1011110110)
                expect
                (fp #b0 #b01110110111 #b1110110101)))
(assert (fp.leq (fp #b0 #b01110110111 #b1110110101)
                expect
                (fp #b0 #b10011001111 #b0100101010)))

(assert (= expect result))

(check-sat)
(exit)
