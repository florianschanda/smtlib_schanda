(assert (fp.leq (fp #b0 #b0110110101 #b101001100)
                expect
                (fp #b0 #b1001110001 #b010001110)))
(assert (fp.leq (fp #b0 #b1001110001 #b010001110)
                expect
                (fp #b0 #b1110101010 #b101010011)))

(assert (= expect result))

(check-sat)
(exit)
