; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(3)

; Redundancy: False
; Validation for: SQRT
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 18))
(assert (fp.leq (fp #b1 #b111110100101100010 #b01000011001100111)
                arg1
                (fp #b1 #b011111111111111111 #b11001011100101100)))
(assert (fp.leq (fp #b1 #b011111111111111111 #b11001011100101100)
                arg1
                (fp #b0 #b100001100001010101 #b10011011100100100)))

(declare-const result (_ FloatingPoint 18 18))
(assert (= result (fp.sqrt rm arg1)))

(declare-const expect (_ FloatingPoint 18 18))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
