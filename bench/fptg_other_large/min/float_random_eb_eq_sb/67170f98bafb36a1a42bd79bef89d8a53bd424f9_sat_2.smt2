(declare-const arg2 (_ FloatingPoint 14 14))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11111011001010 #b0000010111010)
                expect
                (fp #b1 #b11111010101101 #b1000111001100)))
(assert (fp.leq (fp #b1 #b11111010101101 #b1000111001100)
                expect
                (fp #b0 #b01001011101101 #b1101011011010)))

(assert (= expect result))

(check-sat)
(exit)
