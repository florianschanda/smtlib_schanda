(assert (fp.leq (fp #b0 #b0101110111000001 #b100011010001001)
                expect
                (fp #b0 #b0111111111111111 #b010001110000010)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b010001110000010)
                expect
                (fp #b0 #b1101010110011111 #b000001110110100)))

(assert (= expect result))

(check-sat)
