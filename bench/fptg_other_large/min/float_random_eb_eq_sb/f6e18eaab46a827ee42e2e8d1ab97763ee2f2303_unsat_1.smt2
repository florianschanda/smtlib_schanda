(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0001101101 #b110001000)
                arg2
                (fp #b1 #b0000000000 #b000001001)))
(assert (fp.leq (fp #b1 #b0000000000 #b000001001)
                arg2
                (fp #b0 #b0110010111 #b100110010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
