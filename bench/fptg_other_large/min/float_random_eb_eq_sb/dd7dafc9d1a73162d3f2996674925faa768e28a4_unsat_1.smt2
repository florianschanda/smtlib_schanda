(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b011111111111 #b11111111100)
                expect
                (fp #b1 #b011011010111 #b00000111010)))
(assert (fp.leq (fp #b1 #b011011010111 #b00000111010)
                expect
                (fp #b0 #b010111001001 #b00011100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
