(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b100101011 #b11110000)
                arg2
                (fp #b0 #b110100101 #b00101110)))
(assert (fp.leq (fp #b0 #b110100101 #b00101110)
                arg2
                (fp #b0 #b110101110 #b00010101)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b011100011 #b01011011)
                expect
                (fp #b0 #b110100101 #b00101110)))
(assert (fp.leq (fp #b0 #b110100101 #b00101110)
                expect
                (fp #b0 #b110111111 #b00100000)))

(assert (not (= expect result)))

(check-sat)
(exit)
