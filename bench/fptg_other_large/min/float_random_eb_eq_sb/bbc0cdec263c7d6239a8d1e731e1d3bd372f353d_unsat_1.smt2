(assert (fp.leq (fp #b0 #b10100111101 #b0011110010)
                expect
                (fp #b0 #b11010100000 #b0100011001)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011001)
                expect
                (fp #b0 #b11011010010 #b1111111000)))

(assert (not (= expect result)))

(check-sat)
