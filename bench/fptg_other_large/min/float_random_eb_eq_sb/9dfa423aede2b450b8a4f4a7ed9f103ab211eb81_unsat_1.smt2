; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011111000000 #b1011010111011)
                arg2
                (fp #b1 #b01111111111111 #b0100110110011)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0100110110011)
                arg2
                (fp #b0 #b10100110000000 #b0100011010110)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10110110111111 #b0111001101000)
                expect
                (fp #b1 #b01111111111111 #b0100110110011)))
(assert (fp.leq (fp #b1 #b01111111111111 #b0100110110011)
                expect
                (fp #b0 #b11011010111011 #b0101001110010)))

(assert (not (= expect result)))

(check-sat)
(exit)
