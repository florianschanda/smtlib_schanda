; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111001100101 #b10001011011)
                arg1
                (fp #b1 #b110110011100 #b00111011110)))
(assert (fp.leq (fp #b1 #b110110011100 #b00111011110)
                arg1
                (fp #b0 #b001010010000 #b10010111110)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000100001 #b01011010010)
                expect
                (fp #b1 #b110110011100 #b00111011110)))
(assert (fp.leq (fp #b1 #b110110011100 #b00111011110)
                expect
                (fp #b1 #b101011000110 #b00111100110)))

(assert (= expect result))

(check-sat)
(exit)
