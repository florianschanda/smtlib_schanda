;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b001010011 #b10011101)
                arg2
                (fp #b0 #b000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b000000000 #b00111011)
                arg2
                (fp #b0 #b010101110 #b10111100)))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100000011 #b11101100)
                expect
                (fp #b0 #b000000000 #b00111011)))
(assert (fp.leq (fp #b0 #b000000000 #b00111011)
                expect
                (fp #b0 #b010110100 #b00101001)))

(assert (not (= expect result)))

(check-sat)
(exit)
