; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0111101010 #b000001011)
                arg1
                (fp #b0 #b1111001111 #b110100110)))
(assert (fp.leq (fp #b0 #b1111001111 #b110100110)
                arg1
                (fp #b0 #b1111110011 #b101010011)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0000000011 #b101101100)
                expect
                (fp #b0 #b1111001111 #b110100110)))
(assert (fp.leq (fp #b0 #b1111001111 #b110100110)
                expect
                (fp #b0 #b1111011110 #b000101011)))

(assert (= expect result))

(check-sat)
(exit)
