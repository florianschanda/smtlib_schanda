; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0001010101011001 #b000011101010001)
                arg2
                (fp #b0 #b0011001100000010 #b101011011101100)))
(assert (fp.leq (fp #b0 #b0011001100000010 #b101011011101100)
                arg2
                (fp #b0 #b1001100111111100 #b001011110100100)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111000110111001 #b010111011111010)
                expect
                (fp #b0 #b0011001100000010 #b101011011101100)))
(assert (fp.leq (fp #b0 #b0011001100000010 #b101011011101100)
                expect
                (fp #b0 #b1011010110011111 #b101011001000000)))

(assert (= expect result))

(check-sat)
(exit)
