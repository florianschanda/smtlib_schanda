; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0010001110 #b011001010)
                arg1
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                arg1
                (fp #b0 #b0010110010 #b110100000)))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100100101 #b111110011)
                arg2
                (fp #b1 #b0111001011 #b101101101)))
(assert (fp.leq (fp #b1 #b0111001011 #b101101101)
                arg2
                (fp #b1 #b0010000010 #b101110010)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1001011111 #b101000100)
                expect
                (fp #b1 #b0111001011 #b101101101)))
(assert (fp.leq (fp #b1 #b0111001011 #b101101101)
                expect
                (fp #b1 #b0100110010 #b100011010)))

(assert (= expect result))

(check-sat)
(exit)
