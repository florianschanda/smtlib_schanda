; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b10100100011110 #b1110010011010)
                arg2
                (fp #b1 #b00000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111000000111)
                arg2
                (fp #b0 #b10110010011001 #b1011110011111)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b01010000100111 #b0010000110101)
                expect
                (fp #b1 #b00000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0111000000111)
                expect
                (fp #b0 #b00001111111111 #b0111101000011)))

(assert (= expect result))

(check-sat)
(exit)
