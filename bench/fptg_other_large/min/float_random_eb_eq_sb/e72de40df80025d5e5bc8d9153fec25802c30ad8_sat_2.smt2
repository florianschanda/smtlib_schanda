(assert (fp.leq (fp #b1 #b0111111111111111 #b010100010011001)
                arg2
                (fp #b0 #b0110010011111110 #b011110001010001)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010111001010110 #b100011010110000)
                expect
                (fp #b1 #b0111111111111111 #b010100010011001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b010100010011001)
                expect
                (fp #b0 #b0111001001111001 #b100111100110101)))

(assert (= expect result))

(check-sat)
