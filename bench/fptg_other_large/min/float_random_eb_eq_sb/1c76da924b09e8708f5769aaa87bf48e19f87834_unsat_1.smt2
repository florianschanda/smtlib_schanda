; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111000000000 #b10101110101)
                arg2
                (fp #b1 #b110001100101 #b10101001100)))
(assert (fp.leq (fp #b1 #b110001100101 #b10101001100)
                arg2
                (fp #b1 #b011000000101 #b00000000100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110010110000 #b10011000101)
                expect
                (fp #b1 #b110001100101 #b10101001100)))
(assert (fp.leq (fp #b1 #b110001100101 #b10101001100)
                expect
                (fp #b0 #b110100011000 #b11001111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
