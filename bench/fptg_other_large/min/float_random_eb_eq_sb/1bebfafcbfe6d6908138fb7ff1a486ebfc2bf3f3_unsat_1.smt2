(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111111111110 #b11101001000)
                arg1
                (fp #b1 #b111111111101 #b00000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b00000000000)
                arg1
                (fp #b1 #b010110011001 #b10110001101)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
