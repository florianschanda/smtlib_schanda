(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +INFINITY
; Arg2: +LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0010001101 #b010100101)
                arg2
                (fp #b0 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111111)
                arg2
                (fp #b0 #b0101111000 #b010111111)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1010110001 #b000110100)
                expect
                (fp #b0 #b0000000000 #b111111111)))
(assert (fp.leq (fp #b0 #b0000000000 #b111111111)
                expect
                (fp #b0 #b1111011001 #b100010100)))

(assert (= expect result))

(check-sat)
(exit)
