; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100010100 #b00011010)
                arg1
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                arg1
                (fp #b1 #b001110010 #b01110001)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b011110101 #b00111110)
                expect
                (fp #b1 #b010101010 #b00101111)))
(assert (fp.leq (fp #b1 #b010101010 #b00101111)
                expect
                (fp #b0 #b101010101 #b10101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
