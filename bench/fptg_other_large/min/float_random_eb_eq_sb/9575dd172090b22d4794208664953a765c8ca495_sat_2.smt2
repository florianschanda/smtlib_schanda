; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b111101110101001 #b10001011010010)
                arg1
                (fp #b1 #b110010010001001 #b11010010000110)))
(assert (fp.leq (fp #b1 #b110010010001001 #b11010010000110)
                arg1
                (fp #b0 #b101101001001111 #b11111110001011)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b110100111100101 #b01000000011111)
                expect
                (fp #b1 #b110010010001001 #b11010010000110)))
(assert (fp.leq (fp #b1 #b110010010001001 #b11010010000110)
                expect
                (fp #b0 #b001011000001111 #b00011100011101)))

(assert (= expect result))

(check-sat)
(exit)
