                (fp #b0 #b10011101111111 #b1111011011000)))
(assert (fp.leq (fp #b0 #b10011101111111 #b1111011011000)
                expect
                (fp #b0 #b10101101101001 #b0100100100010)))

(assert (not (= expect result)))

