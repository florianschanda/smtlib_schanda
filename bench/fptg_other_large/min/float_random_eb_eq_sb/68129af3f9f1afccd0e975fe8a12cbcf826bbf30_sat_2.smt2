(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110001001100 #b10000100010)
                arg1
                (fp #b1 #b011111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b011111111111 #b01100111111)
                arg1
                (fp #b0 #b100011001011 #b10000010000)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110100011110 #b10110010100)
                expect
                (fp #b1 #b011111111111 #b01100111111)))
(assert (fp.leq (fp #b1 #b011111111111 #b01100111111)
                expect
                (fp #b1 #b011010101000 #b01100001010)))

(assert (= expect result))

(check-sat)
(exit)
