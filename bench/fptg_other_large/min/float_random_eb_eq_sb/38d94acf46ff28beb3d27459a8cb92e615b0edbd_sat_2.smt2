; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RANDOM_GT_INT_BOUNDARY
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b10111101110 #b0011010101)
                arg1
                (fp #b0 #b11010100000 #b0100011001)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011001)
                arg1
                (fp #b0 #b11100111110 #b1000101000)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11101101010 #b1011011011)
                expect
                (fp #b0 #b11010100000 #b0100011001)))
(assert (fp.leq (fp #b0 #b11010100000 #b0100011001)
                expect
                (fp #b0 #b11110110100 #b1011001110)))

(assert (= expect result))

(check-sat)
(exit)
