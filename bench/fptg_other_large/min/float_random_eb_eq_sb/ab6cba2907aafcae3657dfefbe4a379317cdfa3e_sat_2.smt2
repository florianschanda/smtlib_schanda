; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0101101001 #b011101111)
                arg2
                (fp #b0 #b0011101101 #b011110011)))
(assert (fp.leq (fp #b0 #b0011101101 #b011110011)
                arg2
                (fp #b0 #b0110111101 #b100011100)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b0100011010 #b111111111)
                expect
                (fp #b0 #b0011101101 #b011110011)))
(assert (fp.leq (fp #b0 #b0011101101 #b011110011)
                expect
                (fp #b0 #b1011100100 #b110100001)))

(assert (= expect result))

(check-sat)
(exit)
