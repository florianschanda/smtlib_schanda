(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1011110011 #b101111001)
                expect
                (fp #b1 #b1001110111 #b101110111)))
(assert (fp.leq (fp #b1 #b1001110111 #b101110111)
                expect
                (fp #b1 #b0010110100 #b000110101)))

(assert (not (= expect result)))

(check-sat)
(exit)
