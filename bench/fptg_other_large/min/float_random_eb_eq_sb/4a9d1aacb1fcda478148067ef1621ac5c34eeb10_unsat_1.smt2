; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b0 #b000100111010 #b11000010100)
                arg2
                (fp #b0 #b011111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b011111111111 #b01111100000)
                arg2
                (fp #b0 #b100010000111 #b01101110100)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b101001100101 #b01011001010)
                expect
                (fp #b0 #b011111111111 #b01111100000)))
(assert (fp.leq (fp #b0 #b011111111111 #b01111100000)
                expect
                (fp #b0 #b100100101100 #b00101101011)))

(assert (not (= expect result)))

(check-sat)
(exit)
