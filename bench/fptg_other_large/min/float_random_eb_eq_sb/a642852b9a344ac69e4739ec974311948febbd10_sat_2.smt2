; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 14))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11010010000010 #b0110010001000)
                arg2
                (fp #b1 #b11000001100001 #b0001111011101)))
(assert (fp.leq (fp #b1 #b11000001100001 #b0001111011101)
                arg2
                (fp #b0 #b01111100001111 #b1101000100001)))

(declare-const result (_ FloatingPoint 14 14))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 14))
(assert (fp.leq (fp #b1 #b11011011110101 #b0111111100101)
                expect
                (fp #b1 #b11000001100001 #b0001111011101)))
(assert (fp.leq (fp #b1 #b11000001100001 #b0001111011101)
                expect
                (fp #b1 #b01111111110110 #b0000010000100)))

(assert (= expect result))

(check-sat)
(exit)
