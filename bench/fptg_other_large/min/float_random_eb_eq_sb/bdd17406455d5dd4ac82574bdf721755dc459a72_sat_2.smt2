; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: +SQRT_LARGEST_NORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b0 #b001000010 #b00000011)
                arg1
                (fp #b0 #b101111110 #b11111111)))
(assert (fp.leq (fp #b0 #b101111110 #b11111111)
                arg1
                (fp #b0 #b111110111 #b01100101)))

(declare-const arg2 (_ FloatingPoint 9 9))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 9 9))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 9))
(assert (fp.leq (fp #b1 #b100001010 #b01001100)
                expect
                (fp #b0 #b101111110 #b11111111)))
(assert (fp.leq (fp #b0 #b101111110 #b11111111)
                expect
                (fp #b0 #b111000001 #b00000100)))

(assert (= expect result))

(check-sat)
(exit)
