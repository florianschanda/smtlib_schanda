(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111100000001 #b11001101110)
                arg1
                (fp #b1 #b100000100000 #b01101001011)))
(assert (fp.leq (fp #b1 #b100000100000 #b01101001011)
                arg1
                (fp #b0 #b110100111110 #b00001110001)))

(declare-const arg2 (_ FloatingPoint 12 12))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
