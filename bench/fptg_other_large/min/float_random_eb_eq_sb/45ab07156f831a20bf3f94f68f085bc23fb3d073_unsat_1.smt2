; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 15))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001011111100111 #b01101011111100)
                arg1
                (fp #b1 #b000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000000000)
                arg1
                (fp #b0 #b000010000110001 #b00000001111000)))

(declare-const arg2 (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000110011011010 #b01001110000001)
                arg2
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b101110001111001 #b01010100110010)))

(declare-const result (_ FloatingPoint 15 15))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 15))
(assert (fp.leq (fp #b1 #b000001010011101 #b00101101001110)
                expect
                (fp #b1 #b000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01110111010011)
                expect
                (fp #b0 #b101000011110000 #b00010101011000)))

(assert (not (= expect result)))

(check-sat)
(exit)
