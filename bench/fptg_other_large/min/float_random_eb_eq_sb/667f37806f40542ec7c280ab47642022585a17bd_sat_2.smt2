;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111110110 #b1010011110)
                arg1
                (fp #b1 #b01111111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1111110100)
                arg1
                (fp #b0 #b01000011011 #b1101001100)))

(declare-const arg2 (_ FloatingPoint 11 11))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b11111011011 #b1101111101)
                expect
                (fp #b1 #b01111111111 #b1111110100)))
(assert (fp.leq (fp #b1 #b01111111111 #b1111110100)
                expect
                (fp #b0 #b00010111001 #b1010011011)))

(assert (= expect result))

(check-sat)
(exit)
