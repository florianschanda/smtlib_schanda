;   * SOFTFLOAT: NONE

(declare-const arg1 Float128)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float128)
(assert (fp.leq (fp #b1 #b101011111110010 #b0101001101100001111001111000100001011001010100111011011001100001000111101100100011101011000010100100100111001111)
                arg2
                (fp #b1 #b011111111111111 #b1010100110010010001001001011011100000010001101110100010000011011101001110011000110011111011110111111001010101011)))
(assert (fp.leq (fp #b1 #b011111111111111 #b1010100110010010001001001011011100000010001101110100010000011011101001110011000110011111011110111111001010101011)
                arg2
                (fp #b0 #b101011001101000 #b1000000111111110011001111101010110100000001001111100001000111010110011111111101011110111100101011111100010001100)))

(declare-const result Float128)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float128)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
