(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100000010 #b1011100011101110001110000000110111100110001001110101)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b10110111011 #b1010010001010011101011011101110010100111011010000010)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11000100010 #b1101110011110111111010100010100001001101001001101110)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                expect
                (fp #b0 #b01110000010 #b1010000100100001000111100111011111111011010111000101)))

(assert (= expect result))

(check-sat)
(exit)
