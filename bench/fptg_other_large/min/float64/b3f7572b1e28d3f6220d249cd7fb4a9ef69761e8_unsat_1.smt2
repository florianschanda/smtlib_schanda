(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000100110 #b0000110111010000110001100110011101101101111001011011)
                expect
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10010110110 #b0010110100011110010011010010001111000111100010110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
