(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -ONE
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10000000010 #b1110000010010010101010111010110011010011010001101000)
                arg1
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10000111110 #b1101111000101111111101101010001111010000100011100011)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000011000 #b1010000100001010010000101100001110100110001101101111)
                expect
                (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000010110 #b0101110011100001001001011101010001011110100100001101)))

(assert (= expect result))

(check-sat)
(exit)
