; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01101100110 #b1000111000011000010110100111111100111101000111001101)
                arg2
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11100011000 #b0011100010001110110000111100100000000011010000010001)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011111000 #b1110111110110010110000000110111010010001010010101011)
                expect
                (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11010100011 #b0011101011101000001001101011100010001101101111001110)))

(assert (= expect result))

(check-sat)
(exit)
