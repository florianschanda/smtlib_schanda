; Format: FLOAT64
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
