;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b11110011100 #b1010100010001000111110110100101001110111100111101110)
                arg1
                (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)))
(assert (fp.leq (fp #b1 #b00000000000 #b1100010010101010101011011100100001001011100000001100)
                arg1
                (fp #b0 #b10011110101 #b1000111110001101001111111010001110101010010101001111)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b10110101000 #b0110011101110111010001100100110000011100100000000010)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b1 #b00011101011 #b0011100110010000001111110111011100111111100001011110)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110011110 #b1010010010101000111010000000001101110110011000011100)
                expect
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                expect
                (fp #b0 #b01100101110 #b0110101001010011111000100101001000111011110010001111)))

(assert (= expect result))

(check-sat)
(exit)
