;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00101100011 #b0001011110011001000001111011011001111111000110101011)
                arg1
                (fp #b0 #b10011100100 #b0011001000001001001011101011000100110011001001000101)))
