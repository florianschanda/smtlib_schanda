; Format: FLOAT64
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10001110010 #b0011011100110110100111000011010110010001010101010011)
                arg1
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                arg1
                (fp #b0 #b11111001011 #b1111001101101001010011011010010100001111111011000100)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001000010 #b1001000101010111101010100001000101100101001111010100)
                expect
                (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)))
(assert (fp.leq (fp #b1 #b10000101010 #b1100100111100000111101011011101011001000111000000000)
                expect
                (fp #b0 #b10010010010 #b0101100100010110101001001111011110111110111110000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
