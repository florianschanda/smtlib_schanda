(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01011100001 #b0010001001110101100000011000010101100001011011101011)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11101111001 #b1011000010111000000010010100010100110001111101111101)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01110000100 #b0010000110111111001011010100110001010010100110100100)
                arg2
                (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)))
(assert (fp.leq (fp #b0 #b10011010000 #b1011100111101011010100110100010000101101001101001111)
                arg2
                (fp #b0 #b10100010100 #b0100011110010011010001100111000000000011010110001000)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00000101001 #b1111011011001001000001101100011011110010101011011000)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11101010111 #b1010110101001111110011101100011101010110101000011110)))

(assert (= expect result))

(check-sat)
(exit)
