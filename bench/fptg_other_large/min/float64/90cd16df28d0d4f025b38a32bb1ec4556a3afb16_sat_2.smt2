; Format: FLOAT64
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10110011111 #b0010010000110111110001001001001001111001011000101011)
                arg1
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00101000110 #b0100100010111001001101110010010011001101100101111100)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11100001101 #b1000110001100001111110001011111110011001011111111101)
                arg2
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                arg2
                (fp #b0 #b11111111011 #b1001010110100101110001010110000100001001011101000100)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11011010011 #b1010101110110101101011010011010110001001100111111010)
                expect
                (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)))
(assert (fp.leq (fp #b1 #b01001100100 #b1001000011101000110011011000111100000110101101010101)
                expect
                (fp #b0 #b00111010100 #b0110000011100000011100010000001000101101110100001001)))

(assert (= expect result))

(check-sat)
(exit)
