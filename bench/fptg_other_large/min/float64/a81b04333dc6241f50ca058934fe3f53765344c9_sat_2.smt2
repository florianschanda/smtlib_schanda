(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00111011101 #b0111010100010111001001010111001110100100010101010001)
                arg2
                (fp #b0 #b01011001110 #b1110111010110111010000100110100111101011000001011001)))
