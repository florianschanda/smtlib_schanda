                arg2
                (fp #b0 #b10110011101 #b1111011011100011100110011111010111110100011111111101)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00000011001 #b0010111110100100000001010100110111110101100000101100)
                expect
                (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b00000000000 #b1111111111111111111111111111111111111111111111111111)
                expect
                (fp #b0 #b10001111101 #b0100000010011100100000110001001000101001001101010100)))

(assert (= expect result))

