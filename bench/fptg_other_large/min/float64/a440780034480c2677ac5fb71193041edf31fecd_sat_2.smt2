                arg2
                (fp #b0 #b11011010010 #b1111001111010100001000110000111000111100100011111110)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110011011 #b0111001010000011110111100110111010001010001001001010)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
