(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b01001111111 #b0100001001100101000001110101100010111000100001000011)
                arg2
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)
                arg2
                (fp #b0 #b11011010000 #b0111100001010000010011100110011111110000000011111110)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b01001010011 #b1101110100111101111011001100110010100100111101111100)
                expect
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)
                expect
                (fp #b0 #b11010011110 #b1000100101101101101111111110110110100010010001001010)))

(assert (= expect result))

(check-sat)
(exit)
