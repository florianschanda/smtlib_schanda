(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -INFINITY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01100010011 #b1100101001010011011010100100101000101110000110001011)
                arg2
                (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b10111111110 #b1111111111111111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b11111010111 #b1101101101011110010100101011011011100010101011110100)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
