; Format: FLOAT64
; Arg1: +RANDOM_INTEGRAL_GT_TWO
; Arg2: +NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b00000001011 #b1101000001011101011001110010011101110011111111100101)
                arg1
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                arg1
                (fp #b0 #b10001100111 #b0101110110101011011100011000000100000010100010000000)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10111101100 #b1001101001101111110110001101011011101001111100000011)
                expect
                (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)))
(assert (fp.leq (fp #b0 #b10000110011 #b0000010000110011001001010110110101100011111110100000)
                expect
                (fp #b0 #b10010100001 #b0101001010101001110110011011111100001100101011110010)))

(assert (= expect result))

(check-sat)
(exit)
