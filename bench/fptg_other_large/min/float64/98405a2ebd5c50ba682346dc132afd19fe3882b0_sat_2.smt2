(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111111010 #b1100000101101101111100000000101001001010110000010000)
                expect
                (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)))
(assert (fp.leq (fp #b0 #b11010000100 #b0101010010010010001010001101101100110111010110110100)
                expect
                (fp #b0 #b11101100010 #b0001010001001011001100000000001001110011011011110011)))

(assert (= expect result))

(check-sat)
(exit)
