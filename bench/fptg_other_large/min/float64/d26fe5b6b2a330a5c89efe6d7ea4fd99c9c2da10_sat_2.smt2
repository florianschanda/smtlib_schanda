                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b01110110011 #b0010101111100101111010001100110001101001010011001101)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001011101 #b1100101100100111000111111001001101101110011011010011)
                expect
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                expect
                (fp #b0 #b01110110000 #b1100110010100101110111110000010001101111010110111101)))

(assert (= expect result))

(check-sat)
(exit)
