; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111011001 #b1101111110011101110110111110101001011010101111010011)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01101010010 #b0101011011101110101110100011110000101110001011001011)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11010000111 #b0000111100111001001101111100000010100110111101111000)
                expect
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10110111010 #b1111010100111110110000101001100000000110000000111011)))

(assert (not (= expect result)))

(check-sat)
(exit)
