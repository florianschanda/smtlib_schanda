; Format: FLOAT64
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b01101010010 #b1001100000100001011011010101000011001100100101000101)
                arg1
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b01000000101 #b1111000111001000001010011000110100010111011010010000)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00001110110 #b1001100111000100101011110100101000111001110101101000)
                arg2
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                arg2
                (fp #b0 #b11000000011 #b1111110011010101111000011001000000111001001010011001)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01101101011 #b0000110000001100010101110111100110000001100001100111)
                expect
                (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)))
(assert (fp.leq (fp #b1 #b00000000000 #b1000001010000000110100000001010100010100111100001000)
                expect
                (fp #b0 #b10100010001 #b0101100000000101000111111101101101110000101100011011)))

(assert (not (= expect result)))

(check-sat)
(exit)
