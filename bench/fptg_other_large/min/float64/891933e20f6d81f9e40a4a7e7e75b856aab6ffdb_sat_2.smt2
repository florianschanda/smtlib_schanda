; Format: FLOAT64
; Arg1: +SMALLEST_NORMAL
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10100010011 #b1001011100001100001111001101110011010100101111101111)
                arg1
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b10011110101 #b0011101100111000101110110100010010001100010000001010)))

(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11110101101 #b0010011010011001111101000110100000000100100011011111)
                expect
                (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11000000000 #b1101101010000100100111001010111001000011010010000111)))

(assert (= expect result))

(check-sat)
(exit)
