(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00100000001 #b0001111100110010000111101111100011111010001001101101)
                expect
                (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)))
(assert (fp.leq (fp #b0 #b10011111111 #b1111010100011001100100010111000110110110111011011000)
                expect
                (fp #b0 #b10110110111 #b1010101111010001100000111010100000001101100110001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
