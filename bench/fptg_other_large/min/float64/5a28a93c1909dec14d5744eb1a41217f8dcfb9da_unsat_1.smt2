(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b0 #b00110100001 #b0011000001100011111011010010110110001100001011010010)
                expect
                (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)))
(assert (fp.leq (fp #b0 #b10000110011 #b1011001011000100000010110100000111000010011011000000)
                expect
                (fp #b0 #b11100010110 #b1001100010010101111011010001100101011111111010111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
