                arg2
                (fp #b0 #b00101001010 #b1110110101001110110001100000001010101001100000111111)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10110110110 #b1100000101111110110011101111001111000100100010010111)
                expect
                (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)))
(assert (fp.leq (fp #b1 #b10000110001 #b1011001110000111100110000001000000010101101000110000)
                expect
                (fp #b1 #b01011101010 #b0101011100101011001011000100100010110011010001001100)))

(assert (not (= expect result)))

(check-sat)
(exit)
