(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00001010000 #b1000000110110011110111001010101011100110110001001000)
                arg2
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                arg2
                (fp #b0 #b11010000000 #b0110100010001011011000110000110000010111100000101011)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10010010001 #b1111011010001111100100011000001001110000011011000000)
                expect
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                expect
                (fp #b0 #b11111000011 #b0101000111100110111001111100011100110010110010000010)))

(assert (= expect result))

(check-sat)
(exit)
