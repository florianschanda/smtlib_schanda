(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10000101110 #b0101111100000001010001110100010010111101001101001001)
                expect
                (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)))
(assert (fp.leq (fp #b1 #b01111111111 #b0010100110010101011001111101111001110101011010110000)
                expect
                (fp #b0 #b01001110011 #b1001000010101001010110001100101010010100110101000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
