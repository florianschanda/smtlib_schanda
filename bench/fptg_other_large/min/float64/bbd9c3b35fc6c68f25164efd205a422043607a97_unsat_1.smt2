(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00110110111 #b1101001100010100001000100001001101001111101110011001)
                arg2
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                arg2
                (fp #b0 #b11101011010 #b0110011110110010001000010010010100110100110011001000)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001010110 #b0111000000000101110001000111100011010011111001111101)
                expect
                (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000001)
                expect
                (fp #b0 #b11000000101 #b1001011111110111111111100010011010100111110110100111)))

(assert (not (= expect result)))

(check-sat)
(exit)
