(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01111101111 #b0111110010011000000001000110001101011001110001101100)
                arg2
                (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)))
(assert (fp.leq (fp #b0 #b10100100011 #b0001001011100110011011111011010000011110111000111110)
                arg2
                (fp #b0 #b11011011110 #b0001010010011100111110000000000111111000010010100100)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11111010100 #b1010001000100100011000111101100011000000100101101010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00111111111 #b1111011100111010111011000111100000111101011111101001)))

(assert (= expect result))

(check-sat)
(exit)
