(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +INFINITY
; Arg2: +RCP_SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b11111010000 #b1111000000011101010000011101101010001100001110100101)
                arg2
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b11111111110 #b1111111010100111010110101101011110000011001000100100)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01011100011 #b0111010011010001011111010101011110011011100000100010)
                expect
                (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11111111101 #b0011110101010010100111010111000001001011111101101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
