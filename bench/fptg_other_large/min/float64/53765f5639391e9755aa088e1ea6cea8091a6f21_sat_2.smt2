                arg2
                (fp #b0 #b10101010010 #b0111111110001101101010111110100110101111010110000010)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00011100011 #b1101110010101001101010110110101001110010101111110000)
                expect
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)
                expect
                (fp #b0 #b11100111010 #b0110010011110111010110101110011100111100111011100001)))

(assert (= expect result))

(check-sat)
(exit)
