; Format: FLOAT64
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b00101010110 #b1010101000011100101110101110001011011010001010101000)
                arg2
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
