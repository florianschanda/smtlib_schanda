; Format: FLOAT64
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11110000110 #b1110110111111001011001110001010100011110011101100111)
                arg2
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                arg2
                (fp #b1 #b01110000111 #b1111100000001111001010000011101111100001111110100111)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10001011101 #b0010101110000101000110010110110011010100111100001111)
                expect
                (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)))
(assert (fp.leq (fp #b1 #b01111111111 #b0100101011010010001101011100011011111110011011100100)
                expect
                (fp #b0 #b11011101101 #b1000101010101010110101110100011111000010101000000101)))

(assert (= expect result))

(check-sat)
(exit)
