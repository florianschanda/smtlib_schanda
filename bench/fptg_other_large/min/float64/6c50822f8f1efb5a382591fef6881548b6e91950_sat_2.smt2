                (fp #b1 #b01101100110 #b1001111010001110000011001101001010110000011101101111)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100000010 #b1001110000011010110011110100010011110001100010001101)
