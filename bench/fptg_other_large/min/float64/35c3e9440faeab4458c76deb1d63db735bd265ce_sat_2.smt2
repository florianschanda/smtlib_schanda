(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b01001111010 #b0100111000110101111000111100001010000101000100110001)
                arg2
                (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)))
(assert (fp.leq (fp #b0 #b01111111111 #b1100000100110111010111010100011111011101101011011001)
                arg2
                (fp #b0 #b11010011111 #b0111100101100001111110100011011101010110000111000011)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111011000 #b1100010001001111001011000010111111111100101111010011)
                expect
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01111100010 #b0101000010010101111000001101000101011101010011000101)))

(assert (= expect result))

(check-sat)
(exit)
