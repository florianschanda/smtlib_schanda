(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111110 #b1101111101010011110011110110010000000101101000000101)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b11011010110 #b1111011010110110111001001000000110011011011001011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
