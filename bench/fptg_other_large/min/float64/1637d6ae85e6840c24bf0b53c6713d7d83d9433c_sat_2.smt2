(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11100100111 #b0011010111110101011110000010110110111111000000001000)
                expect
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00111110010 #b0100011001000110111110111101011000101101100000011100)))

(assert (= expect result))

(check-sat)
(exit)
