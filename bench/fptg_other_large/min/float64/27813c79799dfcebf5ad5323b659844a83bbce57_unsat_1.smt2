(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT64
; Arg1: +ZERO
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01110100000 #b0111010010101000100111000100010100001100101000111010)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11011110000 #b0001110001011000010100101011000001111101010110101101)))

(declare-const arg2 Float64)
(assert (fp.isNaN arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b11010001110 #b1000010000111001101111011001111011000011101010101010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00111100001 #b0111111110101100101001000010111000000100000010101111)))

(assert (not (= expect result)))

(check-sat)
(exit)
