(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b01100101000 #b1011010011100001001000000000101111000100101111100101)
                expect
                (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b00011100011 #b0110101001010011001110101101000000110110111010110110)))

(assert (= expect result))

(check-sat)
(exit)
