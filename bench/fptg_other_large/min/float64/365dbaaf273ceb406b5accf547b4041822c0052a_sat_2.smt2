(declare-const arg2 Float64)
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11111111101 #b0111101100011111010000110001101111110011111111111010)
                expect
                (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b1 #b10011011100 #b1011010101011001111100000101100111010110011001110000)))

(assert (= expect result))

(check-sat)
(exit)
