(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b11001100110 #b1111001010101010001000001101011110010010001011110010)
                arg2
                (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)))
(assert (fp.leq (fp #b0 #b11001101001 #b1011001010111001100101110010100110100001001000111100)
                arg2
                (fp #b0 #b11001101101 #b1110010011001100101101001000110110101100101100111001)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b10100101010 #b1010111010100001001001100101001011010110100011111011)
                expect
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b01110100001 #b1010111000101011101000010010101101101001110101001111)))

(assert (= expect result))

(check-sat)
(exit)
