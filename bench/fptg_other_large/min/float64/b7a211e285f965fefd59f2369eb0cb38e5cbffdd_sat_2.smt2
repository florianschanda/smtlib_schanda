                arg2
                (fp #b0 #b01000001011 #b1100010011101001101100010111000010010001000111101011)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b00111010001 #b1110101101110000000001000010010011010100010011100100)
                expect
                (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b11001111010 #b1111001101001001101101011101001000111011101011101100)))

(assert (= expect result))

