; Format: FLOAT64
; Arg1: -SMALLEST_NORMAL
; Arg2: -RANDOM_INTEGRAL_GT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.leq (fp #b1 #b10111001001 #b1001001011011011011111010001010101011011111101001110)
                arg1
                (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000001 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b11111000111 #b1111001110000010111001011001010000011111100000000110)))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b1 #b11001011101 #b1101111000110100100101101101101010010100110000010100)
                arg2
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                arg2
                (fp #b0 #b10000001111 #b0010110110111010001110011110111101001100011001111010)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11101000111 #b0110101111000010000001111100000101010110101001001011)
                expect
                (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)))
(assert (fp.leq (fp #b1 #b10000110011 #b1010110010000100101011101010011000100101110101110111)
                expect
                (fp #b1 #b00111111100 #b1110000111110001100110111001101111010010110110100100)))

(assert (= expect result))

(check-sat)
(exit)
