(set-info :category "random")
(set-info :status sat)

; Format: FLOAT64
; Arg1: -NAN
; Arg2: +INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 Float64)
(assert (fp.isNaN arg1))

(declare-const arg2 Float64)
(assert (fp.leq (fp #b0 #b00100110100 #b0101111100111011111001000110011111010000111101100010)
                arg2
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10001001011 #b1011001110001110011100101000000111101000110110101011)))

(declare-const result Float64)
(assert (= result (fp.min arg1 arg2)))

(declare-const expect Float64)
(assert (fp.leq (fp #b1 #b11001001011 #b0010000111101000000110111000001011111101101101001100)
                expect
                (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10000110100 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10110111110 #b1110111010110110100000011101000000101110010000010110)))

(assert (= expect result))

(check-sat)
(exit)
