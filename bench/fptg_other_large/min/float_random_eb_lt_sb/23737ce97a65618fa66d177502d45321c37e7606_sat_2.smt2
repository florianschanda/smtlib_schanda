;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 20))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 20))
(assert (fp.leq (fp #b1 #b0000001001010010 #b1010010000010010111)
                arg2
                (fp #b1 #b0000000000000000 #b0000000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000000000000001)
                arg2
                (fp #b0 #b0001001101001001 #b1011010010011110111)))

(declare-const result (_ FloatingPoint 16 20))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 20))
(assert (fp.leq (fp #b1 #b1011011010101111 #b0010110010010001001)
                expect
                (fp #b1 #b0000000000000000 #b0000000000000000001)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000000000000001)
                expect
                (fp #b0 #b0101010101100000 #b1001110100000101000)))

(assert (= expect result))

(check-sat)
(exit)
