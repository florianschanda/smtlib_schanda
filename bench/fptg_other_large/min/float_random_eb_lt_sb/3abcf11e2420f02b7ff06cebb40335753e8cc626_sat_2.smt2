;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 17))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 17))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0010111001 #b1110000001110111)
                arg2
                (fp #b1 #b0000000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000000000000)
                arg2
                (fp #b0 #b0101100110 #b0011101001000000)))

(declare-const result (_ FloatingPoint 10 17))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 17))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0011010101 #b0001001101000010)
                expect
                (fp #b1 #b0000000000 #b0000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000000000000)
                expect
                (fp #b0 #b0001110010 #b0000010100101110)))

(assert (= expect result))

(check-sat)
(exit)
