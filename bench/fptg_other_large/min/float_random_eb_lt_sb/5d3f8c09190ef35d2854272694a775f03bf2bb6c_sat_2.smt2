                arg2
                (fp #b0 #b1001001101 #b011011001111111001111010100010011101010)))

(declare-const result (_ FloatingPoint 10 40))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 40))
(assert (fp.leq (fp #b1 #b0111111110 #b111101010111110110001111101001101010110)
                expect
                (fp #b1 #b0011101100 #b011010100000100111100110011001111111010)))
(assert (fp.leq (fp #b1 #b0011101100 #b011010100000100111100110011001111111010)
                expect
                (fp #b0 #b1001001000 #b101100110011101100111000111100001100000)))

(assert (= expect result))

(check-sat)
(exit)
