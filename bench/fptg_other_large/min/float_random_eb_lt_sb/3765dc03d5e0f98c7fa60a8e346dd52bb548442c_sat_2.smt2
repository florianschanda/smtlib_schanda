;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 36))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 36))
(assert (fp.leq (fp #b0 #b010110111 #b00101000111000100000001000100101111)
                arg2
                (fp #b0 #b011111111 #b10110000010011011101011011111110010)))
(assert (fp.leq (fp #b0 #b011111111 #b10110000010011011101011011111110010)
                arg2
                (fp #b0 #b110101101 #b01100001100101000000000000100110100)))

(declare-const result (_ FloatingPoint 9 36))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 36))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
