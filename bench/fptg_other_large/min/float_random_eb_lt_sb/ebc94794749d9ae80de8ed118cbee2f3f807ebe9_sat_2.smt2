(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 2 36))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 2 36))
(assert (fp.leq (fp #b1 #b01 #b11001111100110101101111111101110000)
                arg2
                (fp #b0 #b10 #b11010110011110101101010110101110110)))
(assert (fp.leq (fp #b0 #b10 #b11010110011110101101010110101110110)
                arg2
                (fp #b0 #b10 #b11111111110111011001000100111011010)))

(declare-const result (_ FloatingPoint 2 36))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 2 36))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
