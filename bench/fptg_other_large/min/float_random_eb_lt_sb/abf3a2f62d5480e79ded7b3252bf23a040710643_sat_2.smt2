(assert (fp.leq (fp #b1 #b1101100010 #b01100001110)
                expect
                (fp #b1 #b0011111111 #b11111100110)))
(assert (fp.leq (fp #b1 #b0011111111 #b11111100110)
                expect
                (fp #b0 #b1100010111 #b11010010100)))

(assert (= expect result))

(check-sat)
(exit)
