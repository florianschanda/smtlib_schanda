(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 32))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 32))
(assert (fp.leq (fp #b1 #b1100101001 #b0010110111111110110011001100110)
                arg2
                (fp #b1 #b0100110011 #b1100100001110100011001101101001)))
(assert (fp.leq (fp #b1 #b0100110011 #b1100100001110100011001101101001)
                arg2
                (fp #b0 #b0111011110 #b1111000010010011001000000111011)))

(declare-const result (_ FloatingPoint 10 32))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 32))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
