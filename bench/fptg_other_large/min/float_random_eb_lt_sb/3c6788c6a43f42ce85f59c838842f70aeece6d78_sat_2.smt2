; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: +ZERO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 11))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1000010101 #b0110110101)
                arg2
                (fp #b0 #b0000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000000)
                arg2
                (fp #b0 #b0110000011 #b0110100000)))

(declare-const result (_ FloatingPoint 10 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 11))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1000111101 #b1000001011)
                expect
                (fp #b0 #b0000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000000)
                expect
                (fp #b0 #b1100011100 #b0001010001)))

(assert (= expect result))

(check-sat)
(exit)
