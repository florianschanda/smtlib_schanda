(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 13))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b100110110111001 #b101110000100)
                arg2
                (fp #b0 #b110110100001011 #b101011001011)))
(assert (fp.leq (fp #b0 #b110110100001011 #b101011001011)
                arg2
                (fp #b0 #b111000101011010 #b001101100011)))

(declare-const result (_ FloatingPoint 15 13))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 13))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
