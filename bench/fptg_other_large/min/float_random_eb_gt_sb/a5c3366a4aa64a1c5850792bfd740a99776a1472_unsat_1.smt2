(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO(2)
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11010010101 #b001110)
                arg1
                (fp #b1 #b10111001101 #b101101)))
(assert (fp.leq (fp #b1 #b10111001101 #b101101)
                arg1
                (fp #b0 #b10101110111 #b100101)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
