; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0011101010 #b1011)
                arg2
                (fp #b0 #b1000111011 #b1010)))
(assert (fp.leq (fp #b0 #b1000111011 #b1010)
                arg2
                (fp #b0 #b1101110001 #b1100)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110000001 #b1110)
                expect
                (fp #b0 #b1000111011 #b1010)))
(assert (fp.leq (fp #b0 #b1000111011 #b1010)
                expect
                (fp #b0 #b1101000011 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
