; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +SQRT_LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11111011010000 #b01100010)
                arg2
                (fp #b0 #b10111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b11111111)
                arg2
                (fp #b0 #b11110101111011 #b10110011)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b0 #b01011011110111 #b11000110)
                expect
                (fp #b0 #b10111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b10111111111110 #b11111111)
                expect
                (fp #b0 #b11010100001000 #b01111101)))

(assert (= expect result))

(check-sat)
(exit)
