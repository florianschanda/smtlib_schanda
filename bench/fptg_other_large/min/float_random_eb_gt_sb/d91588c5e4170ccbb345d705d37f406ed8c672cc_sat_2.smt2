(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_INTEGRAL_GT_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11110110101 #b100110)
                arg2
                (fp #b1 #b10000000101 #b010001)))
(assert (fp.leq (fp #b1 #b10000000101 #b010001)
                arg2
                (fp #b0 #b01101101101 #b011011)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10011110101 #b010100)
                expect
                (fp #b1 #b10000000101 #b010001)))
(assert (fp.leq (fp #b1 #b10000000101 #b010001)
                expect
                (fp #b1 #b01010011010 #b011111)))

(assert (= expect result))

(check-sat)
(exit)
