(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b00010001011 #b01)
                arg1
                (fp #b0 #b10110101100 #b10)))
(assert (fp.leq (fp #b0 #b10110101100 #b10)
                arg1
                (fp #b0 #b11111011110 #b01)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b00000101010 #b10)
                expect
                (fp #b0 #b10110101100 #b10)))
(assert (fp.leq (fp #b0 #b10110101100 #b10)
                expect
                (fp #b0 #b11111010100 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
