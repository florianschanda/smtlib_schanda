                arg2
                (fp #b0 #b1000111100 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1100011001 #b1)
                expect
                (fp #b1 #b0111111111 #b1)))
(assert (fp.leq (fp #b1 #b0111111111 #b1)
                expect
                (fp #b0 #b0011110110 #b1)))

(assert (= expect result))

(check-sat)
(exit)
