(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110111111 #b111)
                arg1
                (fp #b1 #b011111111 #b101)))
(assert (fp.leq (fp #b1 #b011111111 #b101)
                arg1
                (fp #b0 #b111111001 #b010)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (= arg2 arg1))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110001000 #b100)
                expect
                (fp #b1 #b011111111 #b101)))
(assert (fp.leq (fp #b1 #b011111111 #b101)
                expect
                (fp #b0 #b011001110 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
