; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111110011 #b0010100)
                arg2
                (fp #b0 #b000000000 #b1011101)))
(assert (fp.leq (fp #b0 #b000000000 #b1011101)
                arg2
                (fp #b0 #b000011001 #b0110111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000110111 #b1011100)
                expect
                (fp #b0 #b000000000 #b1011101)))
(assert (fp.leq (fp #b0 #b000000000 #b1011101)
                expect
                (fp #b0 #b011110001 #b0100001)))

(assert (not (= expect result)))

(check-sat)
(exit)
