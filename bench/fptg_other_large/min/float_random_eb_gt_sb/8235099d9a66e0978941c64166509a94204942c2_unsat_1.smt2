(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +SMALLEST_SUBNORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1001010101 #b111010)
                arg1
                (fp #b0 #b0000000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000001)
                arg1
                (fp #b0 #b1100111111 #b001001)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0110110011 #b001101)
                expect
                (fp #b0 #b0000000000 #b000001)))
(assert (fp.leq (fp #b0 #b0000000000 #b000001)
                expect
                (fp #b0 #b0001000000 #b010100)))

(assert (not (= expect result)))

(check-sat)
(exit)
