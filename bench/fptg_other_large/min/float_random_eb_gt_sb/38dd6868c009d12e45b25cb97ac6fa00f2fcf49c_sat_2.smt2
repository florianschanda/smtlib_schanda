(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10000010111 #b11011001)
                arg1
                (fp #b1 #b10000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b10000001000 #b00000000)
                arg1
                (fp #b0 #b11000001000 #b00001100)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10011011000 #b11001110)
                expect
                (fp #b1 #b10000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b10000001000 #b00000000)
                expect
                (fp #b0 #b00000101111 #b10100010)))

(assert (= expect result))

(check-sat)
(exit)
