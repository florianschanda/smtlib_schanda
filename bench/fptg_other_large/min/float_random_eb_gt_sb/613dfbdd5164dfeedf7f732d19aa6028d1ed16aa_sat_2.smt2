; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0000101011101 #b101)
                arg1
                (fp #b0 #b0111111111111 #b111)))
(assert (fp.leq (fp #b0 #b0111111111111 #b111)
                arg1
                (fp #b0 #b1000000010010 #b100)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1100101110100 #b111)
                expect
                (fp #b1 #b0111111111111 #b111)))
(assert (fp.leq (fp #b1 #b0111111111111 #b111)
                expect
                (fp #b1 #b0101011000001 #b101)))

(assert (= expect result))

(check-sat)
(exit)
