(assert (fp.leq (fp #b1 #b001011000100110001 #b001100)
                expect
                (fp #b0 #b000000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b000000)
                expect
                (fp #b0 #b001001100010000010 #b110000)))

(assert (= expect result))

(check-sat)
(exit)
