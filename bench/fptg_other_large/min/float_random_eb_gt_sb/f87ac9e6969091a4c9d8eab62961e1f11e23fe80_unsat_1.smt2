; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11111111111111110 #b010100111000011)
                arg1
                (fp #b1 #b11111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b1 #b11111111111111101 #b000000000000000)
                arg1
                (fp #b1 #b00011010000111100 #b100001100000000)))

(declare-const arg2 (_ FloatingPoint 17 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
