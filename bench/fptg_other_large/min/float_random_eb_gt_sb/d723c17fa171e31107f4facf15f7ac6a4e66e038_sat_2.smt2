(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b101100011010110011 #b00)
                arg2
                (fp #b1 #b001100000010110101 #b00)))
(assert (fp.leq (fp #b1 #b001100000010110101 #b00)
                arg2
                (fp #b0 #b010010011011011001 #b10)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b010100000001001100 #b01)
                expect
                (fp #b1 #b001100000010110101 #b00)))
(assert (fp.leq (fp #b1 #b001100000010110101 #b00)
                expect
                (fp #b0 #b101111110111101101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
