(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1000001010011 #b100100)
                arg2
                (fp #b1 #b0000000000000 #b111110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b111110)
                arg2
                (fp #b0 #b0111000100101 #b010100)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b0010101110000 #b000011)
                expect
                (fp #b1 #b0000000000000 #b111110)))
(assert (fp.leq (fp #b1 #b0000000000000 #b111110)
                expect
                (fp #b0 #b1000010101101 #b101011)))

(assert (= expect result))

(check-sat)
(exit)
