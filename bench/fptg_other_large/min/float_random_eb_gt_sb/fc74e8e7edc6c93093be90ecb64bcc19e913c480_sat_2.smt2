; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0101000100010011 #b10011101000)
                arg2
                (fp #b0 #b1101111001010100 #b11001101001)))
(assert (fp.leq (fp #b0 #b1101111001010100 #b11001101001)
                arg2
                (fp #b0 #b1111011100111001 #b01110001110)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0101011000100011 #b00010100101)
                expect
                (fp #b0 #b1101111001010100 #b11001101001)))
(assert (fp.leq (fp #b0 #b1101111001010100 #b11001101001)
                expect
                (fp #b0 #b1111001111101001 #b10010001101)))

(assert (= expect result))

(check-sat)
(exit)
