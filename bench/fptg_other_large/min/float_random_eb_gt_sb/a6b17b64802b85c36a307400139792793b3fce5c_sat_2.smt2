; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10110000111110 #b00111)
                arg2
                (fp #b0 #b00000111000101 #b11000)))
(assert (fp.leq (fp #b0 #b00000111000101 #b11000)
                arg2
                (fp #b0 #b01111101001010 #b10110)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00001101111100 #b01010)
                expect
                (fp #b0 #b00000111000101 #b11000)))
(assert (fp.leq (fp #b0 #b00000111000101 #b11000)
                expect
                (fp #b0 #b01100000101010 #b01001)))

(assert (= expect result))

(check-sat)
(exit)
