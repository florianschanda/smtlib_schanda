(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101000100 #b111010)
                arg2
                (fp #b1 #b0101110001 #b011011)))
(assert (fp.leq (fp #b1 #b0101110001 #b011011)
                arg2
                (fp #b1 #b0100100011 #b001100)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1010000100 #b101001)
                expect
                (fp #b1 #b0101110001 #b011011)))
(assert (fp.leq (fp #b1 #b0101110001 #b011011)
                expect
                (fp #b1 #b0011000001 #b111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
