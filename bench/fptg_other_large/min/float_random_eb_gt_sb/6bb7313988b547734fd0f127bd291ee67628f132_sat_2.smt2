(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11011111011101 #b0000000)
                arg2
                (fp #b1 #b10000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000000111 #b0000000)
                arg2
                (fp #b0 #b10000100110101 #b1001011)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11010111001100 #b1011001)
                expect
                (fp #b1 #b10000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000000111 #b0000000)
                expect
                (fp #b0 #b01100011001001 #b0100111)))

(assert (= expect result))

(check-sat)
(exit)
