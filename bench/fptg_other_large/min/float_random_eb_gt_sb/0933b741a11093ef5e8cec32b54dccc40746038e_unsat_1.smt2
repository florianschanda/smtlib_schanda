; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10111111101 #b100011)
                arg2
                (fp #b1 #b00011011001 #b110011)))
(assert (fp.leq (fp #b1 #b00011011001 #b110011)
                arg2
                (fp #b0 #b11010000011 #b011000)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11011001010 #b100110)
                expect
                (fp #b1 #b00011011001 #b110011)))
(assert (fp.leq (fp #b1 #b00011011001 #b110011)
                expect
                (fp #b1 #b00000101111 #b100110)))

(assert (not (= expect result)))

(check-sat)
(exit)
