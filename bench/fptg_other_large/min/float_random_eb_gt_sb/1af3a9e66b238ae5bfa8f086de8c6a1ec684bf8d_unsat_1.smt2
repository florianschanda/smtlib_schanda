; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)
; Arg2: -INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b11000110110011011 #b10001101101)
                arg1
                (fp #b0 #b00101001111101100 #b00100001000)))
(assert (fp.leq (fp #b0 #b00101001111101100 #b00100001000)
                arg1
                (fp #b0 #b11001010101111000 #b00100101111)))

(declare-const arg2 (_ FloatingPoint 17 12))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
