(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -ZERO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00101110110010 #b10)
                arg2
                (fp #b1 #b00000000000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00)
                arg2
                (fp #b0 #b00001011110010 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00101111011111 #b00)
                expect
                (fp #b1 #b00000000000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00)
                expect
                (fp #b0 #b10101100011010 #b01)))

(assert (= expect result))

(check-sat)
(exit)
