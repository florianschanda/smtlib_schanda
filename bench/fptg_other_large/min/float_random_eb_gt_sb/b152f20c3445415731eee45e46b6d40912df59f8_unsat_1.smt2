(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -ZERO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 11))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11010001100111100 #b0000000001)
                arg2
                (fp #b1 #b00000000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0000000000)
                arg2
                (fp #b0 #b00111000011111001 #b1000001101)))

(declare-const result (_ FloatingPoint 17 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
