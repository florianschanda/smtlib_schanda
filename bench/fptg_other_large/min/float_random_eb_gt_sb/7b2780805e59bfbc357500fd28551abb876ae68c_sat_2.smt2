(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b1010100011011111 #b110)
                arg2
                (fp #b0 #b1100100010000010 #b100)))
(assert (fp.leq (fp #b0 #b1100100010000010 #b100)
                arg2
                (fp #b0 #b1100111101110010 #b110)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1110001000101010 #b100)
                expect
                (fp #b0 #b1100100010000010 #b100)))
(assert (fp.leq (fp #b0 #b1100100010000010 #b100)
                expect
                (fp #b0 #b1101000011000111 #b101)))

(assert (= expect result))

(check-sat)
(exit)
