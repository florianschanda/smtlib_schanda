(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b00111111101011 #b1)
                expect
                (fp #b1 #b00100100100010 #b0)))
(assert (fp.leq (fp #b1 #b00100100100010 #b0)
                expect
                (fp #b0 #b00001000111110 #b1)))

(assert (not (= expect result)))

(check-sat)
