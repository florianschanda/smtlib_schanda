(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b110011110001111 #b110)
                arg2
                (fp #b0 #b011111111111111 #b110)))
(assert (fp.leq (fp #b0 #b011111111111111 #b110)
                arg2
                (fp #b0 #b110010111101011 #b100)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b010110101100100 #b011)
                expect
                (fp #b0 #b011111111111111 #b110)))
(assert (fp.leq (fp #b0 #b011111111111111 #b110)
                expect
                (fp #b0 #b111111001110011 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
