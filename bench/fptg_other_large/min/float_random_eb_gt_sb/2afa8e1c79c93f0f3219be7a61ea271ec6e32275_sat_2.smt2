(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b111111111111111111 #b00)
                arg2
                (fp #b1 #b111111111111111110 #b11)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b11)
                arg2
                (fp #b1 #b111101001101111110 #b01)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
