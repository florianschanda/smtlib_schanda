(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ONE
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000001111100 #b1111101)
                arg1
                (fp #b0 #b011111111111 #b0000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b0000000)
                arg1
                (fp #b0 #b111011011010 #b1010100)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000100110110 #b0011000)
                expect
                (fp #b0 #b011111111111 #b0000000)))
(assert (fp.leq (fp #b0 #b011111111111 #b0000000)
                expect
                (fp #b0 #b101110101010 #b0001001)))

(assert (= expect result))

(check-sat)
(exit)
