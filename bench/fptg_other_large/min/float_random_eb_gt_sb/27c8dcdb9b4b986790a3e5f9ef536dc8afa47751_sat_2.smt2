(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011000010 #b11011)
                arg2
                (fp #b1 #b0000000000 #b10110)))
(assert (fp.leq (fp #b1 #b0000000000 #b10110)
                arg2
                (fp #b0 #b0001010101 #b10010)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0011001111 #b11100)
                expect
                (fp #b1 #b0000000000 #b10110)))
(assert (fp.leq (fp #b1 #b0000000000 #b10110)
                expect
                (fp #b0 #b1010010001 #b10011)))

(assert (= expect result))

(check-sat)
(exit)
