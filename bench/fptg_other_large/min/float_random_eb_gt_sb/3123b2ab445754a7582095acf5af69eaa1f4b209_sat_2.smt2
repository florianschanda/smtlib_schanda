(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1110110110000110 #b10)
                arg2
                (fp #b0 #b0000000000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b10)
                arg2
                (fp #b0 #b1111110000010100 #b01)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0000101101001100 #b10)
                expect
                (fp #b0 #b0000000000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b10)
                expect
                (fp #b0 #b1111100011001010 #b00)))

(assert (= expect result))

(check-sat)
(exit)
