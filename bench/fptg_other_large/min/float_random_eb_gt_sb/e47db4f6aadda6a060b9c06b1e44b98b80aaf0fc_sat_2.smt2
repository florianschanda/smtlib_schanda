(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 11))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 11))
(assert (fp.leq (fp #b1 #b01011100110011011 #b1111010110)
                arg2
                (fp #b1 #b00000000000000000 #b0101011111)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0101011111)
                arg2
                (fp #b0 #b10011011001101010 #b0001000111)))

(declare-const result (_ FloatingPoint 17 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
