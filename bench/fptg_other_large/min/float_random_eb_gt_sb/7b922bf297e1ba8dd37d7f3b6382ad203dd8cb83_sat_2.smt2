(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b000100001101100 #b1111110)
                arg1
                (fp #b1 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000)
                arg1
                (fp #b0 #b000111110101100 #b1110010)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101100011101011 #b1011101)
                arg2
                (fp #b1 #b000000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0000000)
                arg2
                (fp #b0 #b110100101010110 #b1011101)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b110010001110100 #b1100110)
                expect
                (fp #b1 #b000000000000001 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000001 #b0000000)
                expect
                (fp #b0 #b000011001011001 #b0110010)))

(assert (= expect result))

(check-sat)
(exit)
