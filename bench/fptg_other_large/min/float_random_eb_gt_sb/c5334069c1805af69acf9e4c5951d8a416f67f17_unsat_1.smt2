(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100100111111 #b11)
                expect
                (fp #b0 #b100100110100 #b01)))
(assert (fp.leq (fp #b0 #b100100110100 #b01)
                expect
                (fp #b0 #b100110001110 #b11)))

(assert (not (= expect result)))

(check-sat)
