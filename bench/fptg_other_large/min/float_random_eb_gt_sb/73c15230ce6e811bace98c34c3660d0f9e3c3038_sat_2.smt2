;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100000111 #b1111010)
                arg1
                (fp #b0 #b100110110 #b0100010)))
(assert (fp.leq (fp #b0 #b100110110 #b0100010)
                arg1
                (fp #b0 #b111010000 #b0000011)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101011010 #b1100000)
                expect
                (fp #b1 #b100110110 #b0100010)))
(assert (fp.leq (fp #b1 #b100110110 #b0100010)
                expect
                (fp #b0 #b010110000 #b1001111)))

(assert (= expect result))

(check-sat)
(exit)
