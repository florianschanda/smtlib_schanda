(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -ONE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1101100010101111 #b00011110010110)
                arg2
                (fp #b1 #b0111111111111111 #b00000000000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b00000000000000)
                arg2
                (fp #b0 #b0000100110100111 #b11000011010111)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
