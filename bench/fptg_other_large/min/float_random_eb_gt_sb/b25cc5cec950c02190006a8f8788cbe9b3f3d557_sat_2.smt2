; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b001001001 #b111010)
                arg2
                (fp #b0 #b011111111 #b000110)))
(assert (fp.leq (fp #b0 #b011111111 #b000110)
                arg2
                (fp #b0 #b100101100 #b110100)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b000000011 #b010111)
                expect
                (fp #b0 #b011111111 #b000110)))
(assert (fp.leq (fp #b0 #b011111111 #b000110)
                expect
                (fp #b0 #b110011111 #b100101)))

(assert (= expect result))

(check-sat)
(exit)
