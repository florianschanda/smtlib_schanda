; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1101011010110101 #b11110100000)
                arg2
                (fp #b1 #b1100000101001000 #b01111011101)))
(assert (fp.leq (fp #b1 #b1100000101001000 #b01111011101)
                arg2
                (fp #b0 #b1000101101101100 #b01110110100)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1100010100110001 #b11001111011)
                expect
                (fp #b1 #b1100000101001000 #b01111011101)))
(assert (fp.leq (fp #b1 #b1100000101001000 #b01111011101)
                expect
                (fp #b1 #b0010010111110110 #b10111110000)))

(assert (not (= expect result)))

(check-sat)
(exit)
