(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1001110010100110 #b00110110)
                arg2
                (fp #b1 #b1000000000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b1000000000001000 #b00000000)
                arg2
                (fp #b1 #b0111010001000001 #b01100110)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1101011111010111 #b00001100)
                expect
                (fp #b1 #b1000000000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b1000000000001000 #b00000000)
                expect
                (fp #b0 #b1011101010000010 #b10000111)))

(assert (= expect result))

(check-sat)
(exit)
