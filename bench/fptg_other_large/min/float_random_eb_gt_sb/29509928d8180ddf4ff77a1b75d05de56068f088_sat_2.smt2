; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b1011100000111 #b01)
                arg1
                (fp #b0 #b1111111111101 #b00)))
(assert (fp.leq (fp #b0 #b1111111111101 #b00)
                arg1
                (fp #b0 #b1111111111111 #b00)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b0 #b0010110011001 #b10)
                expect
                (fp #b0 #b1111111111101 #b00)))
(assert (fp.leq (fp #b0 #b1111111111101 #b00)
                expect
                (fp #b0 #b1111111111101 #b11)))

(assert (= expect result))

(check-sat)
(exit)
