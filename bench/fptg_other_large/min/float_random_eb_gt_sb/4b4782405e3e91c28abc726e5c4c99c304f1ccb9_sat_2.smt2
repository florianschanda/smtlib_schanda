(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +LARGEST_NORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b10000100111000001 #b0100000)
                arg2
                (fp #b0 #b11111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b1111111)
                arg2
                (fp #b0 #b11111111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b0 #b01000001010011000 #b1011101)
                expect
                (fp #b0 #b11111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b1111111)
                expect
                (fp #b0 #b11111111111111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
