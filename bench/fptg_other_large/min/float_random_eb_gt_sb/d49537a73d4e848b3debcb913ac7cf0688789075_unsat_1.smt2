; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO(2)
; Arg2: +INFINITY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11010110010100 #b01000)
                arg1
                (fp #b1 #b10000000000100 #b10101)))
(assert (fp.leq (fp #b1 #b10000000000100 #b10101)
                arg1
                (fp #b0 #b01001101001111 #b11001)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10011010011010 #b01010)
                expect
                (fp #b1 #b10000000000100 #b10101)))
(assert (fp.leq (fp #b1 #b10000000000100 #b10101)
                expect
                (fp #b1 #b01110100101010 #b01011)))

(assert (not (= expect result)))

(check-sat)
(exit)
