(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_INTEGRAL_GT_TWO
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1101111001010110 #b00)
                arg1
                (fp #b1 #b1000000000000001 #b00)))
(assert (fp.leq (fp #b1 #b1000000000000001 #b00)
                arg1
                (fp #b0 #b0010100011011010 #b01)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1010011100111001 #b11)
                expect
                (fp #b1 #b1000000000000001 #b00)))
(assert (fp.leq (fp #b1 #b1000000000000001 #b00)
                expect
                (fp #b0 #b0111100000101100 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
