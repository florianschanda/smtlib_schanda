(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10001110100 #b0)
                arg2
                (fp #b0 #b11111111110 #b0)))
(assert (fp.leq (fp #b0 #b11111111110 #b0)
                arg2
                (fp #b0 #b11111111110 #b1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01001000011 #b0)
                expect
                (fp #b0 #b11111111110 #b0)))
(assert (fp.leq (fp #b0 #b11111111110 #b0)
                expect
                (fp #b0 #b11111111110 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
