; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11000110111 #b1001)
                arg1
                (fp #b0 #b00000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000)
                arg1
                (fp #b0 #b10111011011 #b0000)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10111001111 #b0100)
                expect
                (fp #b0 #b00000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000)
                expect
                (fp #b0 #b01110100100 #b0000)))

(assert (not (= expect result)))

(check-sat)
(exit)
