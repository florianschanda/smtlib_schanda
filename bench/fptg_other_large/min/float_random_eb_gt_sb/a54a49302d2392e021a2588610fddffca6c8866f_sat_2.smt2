(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001000000 #b111010)
                expect
                (fp #b1 #b000000000 #b100100)))
(assert (fp.leq (fp #b1 #b000000000 #b100100)
                expect
                (fp #b0 #b011011101 #b100101)))

(assert (= expect result))

(check-sat)
(exit)
