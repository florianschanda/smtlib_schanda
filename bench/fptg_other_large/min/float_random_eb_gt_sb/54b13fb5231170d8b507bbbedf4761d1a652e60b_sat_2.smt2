(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO
; Arg2: +RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100001010 #b110)
                arg1
                (fp #b1 #b011111111 #b101)))
(assert (fp.leq (fp #b1 #b011111111 #b101)
                arg1
                (fp #b1 #b010001001 #b111)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101000100 #b101)
                expect
                (fp #b1 #b011111111 #b101)))
(assert (fp.leq (fp #b1 #b011111111 #b101)
                expect
                (fp #b0 #b100100111 #b010)))

(assert (= expect result))

(check-sat)
(exit)
