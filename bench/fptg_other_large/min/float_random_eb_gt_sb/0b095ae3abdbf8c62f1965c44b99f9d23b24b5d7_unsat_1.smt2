; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b100010001101 #b00110000)
                arg1
                (fp #b1 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000)
                arg1
                (fp #b0 #b111101100101 #b11010011)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b101000000110 #b11101010)
                arg2
                (fp #b1 #b001111111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111111100 #b00000000)
                arg2
                (fp #b0 #b110101011111 #b10001001)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b010000011100 #b11001110)
                expect
                (fp #b1 #b001111111100 #b00000000)))
(assert (fp.leq (fp #b1 #b001111111100 #b00000000)
                expect
                (fp #b0 #b000000000110 #b11111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
