; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0000110010011 #b0000111)
                arg1
                (fp #b1 #b0000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0100000)
                arg1
                (fp #b0 #b0111110001110 #b0101101)))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
