; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0001000000111111 #b01110110111)
                arg1
                (fp #b0 #b0111111111111111 #b10010001101)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b10010001101)
                arg1
                (fp #b0 #b1101110111110010 #b01100111001)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b0001011010010110 #b01011001111)
                expect
                (fp #b0 #b0111111111111111 #b10010001101)))
(assert (fp.leq (fp #b0 #b0111111111111111 #b10010001101)
                expect
                (fp #b0 #b1001101101000011 #b00010100110)))

(assert (= expect result))

(check-sat)
(exit)
