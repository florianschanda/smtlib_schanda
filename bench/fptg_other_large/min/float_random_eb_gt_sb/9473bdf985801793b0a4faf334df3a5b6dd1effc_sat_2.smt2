; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1011011111010 #b01)
                arg1
                (fp #b1 #b1000000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000000010 #b00)
                arg1
                (fp #b0 #b1010101101000 #b01)))

(declare-const arg2 (_ FloatingPoint 13 3))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1000111111010 #b10)
                expect
                (fp #b1 #b1000000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000000010 #b00)
                expect
                (fp #b0 #b0010000011000 #b01)))

(assert (= expect result))

(check-sat)
(exit)
