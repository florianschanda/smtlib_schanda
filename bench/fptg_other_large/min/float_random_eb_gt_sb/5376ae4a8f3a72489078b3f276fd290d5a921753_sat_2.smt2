; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_GT_INT_BOUNDARY
; Arg2: -NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1111000100101010 #b001000100)
                arg1
                (fp #b1 #b1000110000011101 #b010111100)))
(assert (fp.leq (fp #b1 #b1000110000011101 #b010111100)
                arg1
                (fp #b0 #b0010101000110111 #b000011100)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1011010011001001 #b010001110)
                expect
                (fp #b1 #b1000110000011101 #b010111100)))
(assert (fp.leq (fp #b1 #b1000110000011101 #b010111100)
                expect
                (fp #b1 #b0101101001100100 #b000001001)))

(assert (= expect result))

(check-sat)
(exit)
