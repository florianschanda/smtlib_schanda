                expect
                (fp #b0 #b00000000000000 #b010000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010000)
                expect
                (fp #b0 #b00011111011001 #b001111)))

(assert (not (= expect result)))

(check-sat)
