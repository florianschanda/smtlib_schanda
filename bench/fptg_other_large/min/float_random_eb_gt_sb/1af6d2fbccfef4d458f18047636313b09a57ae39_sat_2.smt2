(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 13))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 13))
(assert (fp.leq (fp #b1 #b111101010011111 #b000011111011)
                arg2
                (fp #b1 #b001111111111010 #b000000000000)))
(assert (fp.leq (fp #b1 #b001111111111010 #b000000000000)
                arg2
                (fp #b0 #b000010010011110 #b000100000100)))

(declare-const result (_ FloatingPoint 15 13))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 13))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
