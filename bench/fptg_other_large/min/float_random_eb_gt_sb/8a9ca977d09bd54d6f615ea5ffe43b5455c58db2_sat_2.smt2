; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10010100111 #b00010)
                arg1
                (fp #b1 #b01111111111 #b10100)))
(assert (fp.leq (fp #b1 #b01111111111 #b10100)
                arg1
                (fp #b0 #b10001100100 #b10100)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11001100010 #b00110)
                expect
                (fp #b1 #b01111111111 #b10100)))
(assert (fp.leq (fp #b1 #b01111111111 #b10100)
                expect
                (fp #b0 #b10010110110 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
