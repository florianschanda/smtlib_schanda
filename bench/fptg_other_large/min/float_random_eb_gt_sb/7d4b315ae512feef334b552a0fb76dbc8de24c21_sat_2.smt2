(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11111100000101 #b0)
                arg1
                (fp #b1 #b01100000100111 #b1)))
(assert (fp.leq (fp #b1 #b01100000100111 #b1)
                arg1
                (fp #b0 #b10110000111010 #b0)))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (= arg2 (fp.neg arg1)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11100000000001 #b0)
                expect
                (fp #b1 #b01100000100111 #b1)))
(assert (fp.leq (fp #b1 #b01100000100111 #b1)
                expect
                (fp #b1 #b01010001000001 #b0)))

(assert (= expect result))

(check-sat)
(exit)
