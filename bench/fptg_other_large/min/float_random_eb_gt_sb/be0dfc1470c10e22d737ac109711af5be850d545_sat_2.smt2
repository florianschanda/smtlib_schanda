(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO
; Arg2: -RCP_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b0 #b000100000000111 #b1001001010101)
                arg1
                (fp #b0 #b011111111111111 #b0111011011110)))
(assert (fp.leq (fp #b0 #b011111111111111 #b0111011011110)
                arg1
                (fp #b0 #b110011100110111 #b0100100110000)))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
