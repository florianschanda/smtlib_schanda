; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_GT_INT_BOUNDARY

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0111110110110111 #b1101000100)
                arg1
                (fp #b0 #b0000000000000000 #b0000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000000000)
                arg1
                (fp #b0 #b0000110100000011 #b1111110011)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1010111000000101 #b0111011000)
                arg2
                (fp #b1 #b1000100001100001 #b1000110000)))
(assert (fp.leq (fp #b1 #b1000100001100001 #b1000110000)
                arg2
                (fp #b0 #b1000000111010100 #b1100111110)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1001000000110001 #b1000111001)
                expect
                (fp #b1 #b1000100001100001 #b1000110000)))
(assert (fp.leq (fp #b1 #b1000100001100001 #b1000110000)
                expect
                (fp #b0 #b0011110110110011 #b0110011000)))

(assert (= expect result))

(check-sat)
(exit)
