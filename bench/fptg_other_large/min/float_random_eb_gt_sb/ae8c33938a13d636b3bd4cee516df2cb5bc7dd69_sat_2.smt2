(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL
; Arg2: +NAN

; Redundancy: True
; Validation for: MIN
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b001001010 #b11)
                arg1
                (fp #b1 #b000000001 #b00)))
(assert (fp.leq (fp #b1 #b000000001 #b00)
                arg1
                (fp #b0 #b101001110 #b01)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.isNaN arg2))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101010011 #b11)
                expect
                (fp #b1 #b000000001 #b00)))
(assert (fp.leq (fp #b1 #b000000001 #b00)
                expect
                (fp #b0 #b011000100 #b11)))

(assert (= expect result))

(check-sat)
(exit)
