                arg2
                (fp #b1 #b11100011100011 #b1)))
(assert (fp.leq (fp #b1 #b11100011100011 #b1)
                arg2
                (fp #b0 #b11111011010101 #b0)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.min arg1 arg2)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11110111000010 #b1)
                expect
                (fp #b1 #b11100011100011 #b1)))
(assert (fp.leq (fp #b1 #b11100011100011 #b1)
                expect
                (fp #b0 #b11011000101001 #b0)))

(assert (= expect result))

(check-sat)
(exit)
