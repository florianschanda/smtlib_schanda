(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b00101010101010 #b0)
                arg1
                (fp #b0 #b00000000000000 #b0)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0)
