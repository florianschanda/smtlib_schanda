; Format: FLOAT64
; Arg1: +ZERO

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: FULL
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: FULL

(declare-const rm RoundingMode)

(declare-const arg1 Float64)
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b11100000011 #b0101010110111100000001110001111000001111011100001100)
                arg1
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                arg1
                (fp #b0 #b00000011000 #b0100001001101001011110101011101110101101011101101100)))

(declare-const result Float64)
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect Float64)
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b01001001111 #b1010011111101010001110100100001111010100000100100010)
                expect
                (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000000)
                expect
                (fp #b0 #b10001111011 #b0110000100111100101011100001010011011111101111110011)))

(assert (= expect result))

(check-sat)
(exit)
