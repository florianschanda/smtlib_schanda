(assert (fp.leq (fp #b1 #b100010111 #b100100)
                expect
                (fp #b0 #b011111111 #b000000)))
(assert (fp.leq (fp #b0 #b011111111 #b000000)
                expect
                (fp #b0 #b100101010 #b110001)))

(assert (= expect result))

(check-sat)
(exit)
