                expect
                (fp #b1 #b011111111111111 #b00000)))
(assert (fp.leq (fp #b1 #b011111111111111 #b00000)
                expect
                (fp #b0 #b100101010111000 #b00001)))

(assert (= expect result))

(check-sat)
