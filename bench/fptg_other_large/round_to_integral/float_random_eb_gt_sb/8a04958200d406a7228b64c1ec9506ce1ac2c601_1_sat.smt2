(assert (fp.leq (fp #b1 #b1111100110001 #b11)
                expect
                (fp #b1 #b0000000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00)
                expect
                (fp #b0 #b1110001010011 #b10)))

(assert (= expect result))

