; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110110110 #b11)
                arg1
                (fp #b0 #b0000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000 #b01)
                arg1
                (fp #b0 #b1110111011 #b01)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111110010 #b01)
                expect
                (fp #b0 #b0111111111 #b00)))
(assert (fp.leq (fp #b0 #b0111111111 #b00)
                expect
                (fp #b0 #b1101011011 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
