(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b100010100111011001 #b100)
                arg1
                (fp #b0 #b011110001000010111 #b111)))
(assert (fp.leq (fp #b0 #b011110001000010111 #b111)
                arg1
                (fp #b0 #b110100011111001001 #b000)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b111110010010000111 #b001)
                expect
                (fp #b0 #b000000000000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b000)
                expect
                (fp #b0 #b110100000111110110 #b011)))

(assert (= expect result))

(check-sat)
(exit)
