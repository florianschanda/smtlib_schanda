(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b10101001010100101 #b0111101)
                expect
                (fp #b0 #b00000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b0000000)
                expect
                (fp #b0 #b11011101010011110 #b0101000)))

(assert (= expect result))

(check-sat)
(exit)
