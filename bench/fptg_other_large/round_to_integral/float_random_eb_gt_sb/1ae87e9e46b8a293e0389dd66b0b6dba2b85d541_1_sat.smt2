; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0010001011100011 #b000011)
                arg1
                (fp #b1 #b0000000000000000 #b011011)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b011011)
                arg1
                (fp #b0 #b1010111001101110 #b000100)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1111100110011111 #b100110)
                expect
                (fp #b1 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000)
                expect
                (fp #b0 #b1011110101101101 #b111101)))

(assert (= expect result))

(check-sat)
(exit)
