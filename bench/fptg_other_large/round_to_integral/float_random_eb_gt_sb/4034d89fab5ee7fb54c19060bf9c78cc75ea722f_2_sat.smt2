; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0011111110 #b1101)
                arg1
                (fp #b1 #b0011111110 #b0000)))
(assert (fp.leq (fp #b1 #b0011111110 #b0000)
                arg1
                (fp #b0 #b1001111100 #b1010)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110110100 #b1110)
                expect
                (fp #b1 #b0111111111 #b0000)))
(assert (fp.leq (fp #b1 #b0111111111 #b0000)
                expect
                (fp #b1 #b0000000111 #b0101)))

(assert (= expect result))

(check-sat)
(exit)
