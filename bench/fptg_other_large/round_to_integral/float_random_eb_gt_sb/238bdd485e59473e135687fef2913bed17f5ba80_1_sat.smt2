(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1001101011000100 #b101101101)
                expect
                (fp #b1 #b0111111111111111 #b000000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b000000000)
                expect
                (fp #b0 #b1111101111100101 #b100100110)))

(assert (= expect result))

(check-sat)
(exit)
