(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101001011 #b0100)
                arg1
                (fp #b1 #b000000000 #b0001)))
(assert (fp.leq (fp #b1 #b000000000 #b0001)
                arg1
                (fp #b0 #b000010000 #b1100)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000001101 #b0110)
                expect
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                expect
                (fp #b0 #b100100001 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
