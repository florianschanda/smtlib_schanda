; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110010010100 #b000)
                arg1
                (fp #b1 #b101111101100 #b010)))
(assert (fp.leq (fp #b1 #b101111101100 #b010)
                arg1
                (fp #b1 #b100001001111 #b101)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110111101100 #b011)
                expect
                (fp #b1 #b101111101100 #b010)))
(assert (fp.leq (fp #b1 #b101111101100 #b010)
                expect
                (fp #b0 #b110010011001 #b010)))

(assert (= expect result))

(check-sat)
(exit)
