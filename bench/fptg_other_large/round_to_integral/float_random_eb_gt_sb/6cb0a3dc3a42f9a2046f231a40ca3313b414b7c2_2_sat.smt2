(assert (fp.leq (fp #b1 #b1011011110001 #b0000)
                expect
                (fp #b0 #b0111111111111 #b0000)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0000)
                expect
                (fp #b0 #b1011111101010 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
