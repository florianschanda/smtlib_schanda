(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_SUBNORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00001111111 #b1100111)
                arg1
                (fp #b1 #b00000000000 #b0000001)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000001)
                arg1
                (fp #b0 #b01111101010 #b1100101)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b01111100100 #b0000010)
                expect
                (fp #b1 #b00000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000)
                expect
                (fp #b0 #b10001101011 #b0100010)))

(assert (= expect result))

(check-sat)
(exit)
