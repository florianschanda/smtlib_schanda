(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SQRT_SMALLEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011101110 #b1111011)
                arg1
                (fp #b1 #b010000000 #b0000000)))
(assert (fp.leq (fp #b1 #b010000000 #b0000000)
                arg1
                (fp #b1 #b000010001 #b1011001)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100010000 #b0110111)
                expect
                (fp #b1 #b011111111 #b0000000)))
(assert (fp.leq (fp #b1 #b011111111 #b0000000)
                expect
                (fp #b1 #b010001010 #b1100110)))

(assert (= expect result))

(check-sat)
(exit)
