(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000100100 #b10111001)
                arg1
                (fp #b1 #b0000000001 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000001 #b00000000)
                arg1
                (fp #b0 #b0011111101 #b01100111)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101111101 #b10011000)
                expect
                (fp #b1 #b0000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000000)
                expect
                (fp #b0 #b1000110011 #b01010011)))

(assert (= expect result))

(check-sat)
(exit)
