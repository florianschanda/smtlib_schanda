; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -SMALLEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b001010100 #b100)
                arg1
                (fp #b1 #b000000001 #b000)))
(assert (fp.leq (fp #b1 #b000000001 #b000)
                arg1
                (fp #b0 #b001110010 #b100)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100101111 #b001)
                expect
                (fp #b1 #b011111111 #b000)))
(assert (fp.leq (fp #b1 #b011111111 #b000)
                expect
                (fp #b1 #b000101011 #b011)))

(assert (not (= expect result)))

(check-sat)
(exit)
