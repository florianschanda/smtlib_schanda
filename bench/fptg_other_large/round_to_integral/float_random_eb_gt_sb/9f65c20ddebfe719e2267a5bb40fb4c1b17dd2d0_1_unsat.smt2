(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110110111 #b11101)
                expect
                (fp #b1 #b000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000)
                expect
                (fp #b0 #b000110011 #b01001)))

(assert (not (= expect result)))

(check-sat)
(exit)
