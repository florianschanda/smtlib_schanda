(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100000100 #b01000)
                arg1
                (fp #b1 #b000000000 #b00101)))
(assert (fp.leq (fp #b1 #b000000000 #b00101)
                arg1
                (fp #b0 #b001101100 #b01011)))

(declare-const result (_ FloatingPoint 9 6))
