(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_SUBNORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111011011 #b01)
                arg1
                (fp #b1 #b000000000 #b11)))
(assert (fp.leq (fp #b1 #b000000000 #b11)
                arg1
                (fp #b0 #b111111010 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b110000010 #b00)
                expect
                (fp #b1 #b000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000 #b00)
                expect
                (fp #b0 #b111010100 #b11)))

(assert (= expect result))

(check-sat)
(exit)
