; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b011101101 #b01)
                arg1
                (fp #b1 #b000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000 #b01)
                arg1
                (fp #b0 #b001100110 #b11)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111001010 #b10)
                expect
                (fp #b1 #b011111111 #b00)))
(assert (fp.leq (fp #b1 #b011111111 #b00)
                expect
                (fp #b0 #b010001101 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
