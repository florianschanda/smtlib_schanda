(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(2)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b100001100111 #b000010010)
                arg1
                (fp #b1 #b001101111000 #b111100010)))
(assert (fp.leq (fp #b1 #b001101111000 #b111100010)
                arg1
                (fp #b0 #b000101000011 #b011101001)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b010000000110 #b010010010)
                expect
                (fp #b1 #b000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b000000000)
                expect
                (fp #b0 #b101111100001 #b011101111)))

(assert (= expect result))

(check-sat)
(exit)
