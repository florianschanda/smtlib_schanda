(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(4)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011100111 #b011)
                arg1
                (fp #b1 #b000000000 #b100)))
(assert (fp.leq (fp #b1 #b000000000 #b100)
                arg1
                (fp #b0 #b111101010 #b011)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b011110001 #b110)
                expect
                (fp #b1 #b000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000 #b000)
                expect
                (fp #b0 #b000100100 #b011)))

(assert (= expect result))

(check-sat)
(exit)
