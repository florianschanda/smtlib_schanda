(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100111100 #b100110)
                arg1
                (fp #b0 #b011110111 #b111110)))
(assert (fp.leq (fp #b0 #b011110111 #b111110)
                arg1
                (fp #b0 #b101001010 #b110100)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101011000 #b111101)
                expect
                (fp #b0 #b000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000)
                expect
                (fp #b0 #b010011101 #b110001)))

(assert (= expect result))

(check-sat)
(exit)
