;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b00010001011 #b1)
                arg1
                (fp #b0 #b11111111101 #b0)))
(assert (fp.leq (fp #b0 #b11111111101 #b0)
                arg1
                (fp #b0 #b11111111111 #b0)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10001001001 #b1)
                expect
                (fp #b0 #b11111111101 #b0)))
(assert (fp.leq (fp #b0 #b11111111101 #b0)
                expect
                (fp #b0 #b11111111111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
