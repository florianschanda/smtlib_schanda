(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b0 #b00101101110 #b0)
                expect
                (fp #b0 #b01111111111 #b0)))
(assert (fp.leq (fp #b0 #b01111111111 #b0)
                expect
                (fp #b0 #b10000100110 #b0)))

(assert (= expect result))

(check-sat)
(exit)
