;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01101000111 #b0)
                arg1
                (fp #b0 #b00010001001 #b1)))
(assert (fp.leq (fp #b0 #b00010001001 #b1)
                arg1
