; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE(3)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100000010 #b0000001)
                arg1
                (fp #b0 #b0111010000 #b0010000)))
(assert (fp.leq (fp #b0 #b0111010000 #b0010000)
                arg1
                (fp #b0 #b1110100001 #b0000010)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0110000111 #b0110111)
                expect
                (fp #b0 #b0111111111 #b0000000)))
(assert (fp.leq (fp #b0 #b0111111111 #b0000000)
                expect
                (fp #b0 #b1111100111 #b1111110)))

(assert (not (= expect result)))

(check-sat)
(exit)
