; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1011110100100 #b0000)
                arg1
                (fp #b0 #b0111111111111 #b0110)))
(assert (fp.leq (fp #b0 #b0111111111111 #b0110)
                arg1
                (fp #b0 #b1000101111010 #b1101)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1010011100101 #b1000)
                expect
                (fp #b0 #b1000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b1000000000000 #b0000)
                expect
                (fp #b0 #b1110001011110 #b1011)))

(assert (= expect result))

(check-sat)
(exit)
