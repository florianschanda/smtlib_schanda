; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(4)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111101001 #b111)
                arg1
                (fp #b1 #b011111111 #b001)))
(assert (fp.leq (fp #b1 #b011111111 #b001)
                arg1
                (fp #b1 #b010100000 #b110)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100100100 #b000)
                expect
                (fp #b1 #b011111111 #b000)))
(assert (fp.leq (fp #b1 #b011111111 #b000)
                expect
                (fp #b0 #b001010011 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
