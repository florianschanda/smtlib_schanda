;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1010011010000 #b10)
                arg1
                (fp #b1 #b0000000000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000000000 #b10)
                arg1
                (fp #b0 #b1011011101010 #b10)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111000111110 #b00)
                expect
                (fp #b1 #b0111111111111 #b00)))
(assert (fp.leq (fp #b1 #b0111111111111 #b00)
                expect
                (fp #b0 #b0101100100100 #b11)))

(assert (= expect result))

(check-sat)
(exit)
