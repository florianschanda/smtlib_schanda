; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE(5)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1001001000101011 #b001110)
                arg1
                (fp #b1 #b0100110001101000 #b000010)))
(assert (fp.leq (fp #b1 #b0100110001101000 #b000010)
                arg1
                (fp #b1 #b0100010101110001 #b000011)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111110100000101 #b110011)
                expect
                (fp #b1 #b0111111111111111 #b000000)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b000000)
                expect
                (fp #b0 #b1010100000101111 #b001010)))

(assert (= expect result))

(check-sat)
(exit)
