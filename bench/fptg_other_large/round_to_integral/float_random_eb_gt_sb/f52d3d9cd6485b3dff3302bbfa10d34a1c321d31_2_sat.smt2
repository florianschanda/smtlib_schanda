(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_TWO(4)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b011011111001 #b110)
                arg1
                (fp #b0 #b011111111111 #b101)))
(assert (fp.leq (fp #b0 #b011111111111 #b101)
                arg1
                (fp #b0 #b110101100101 #b001)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b000110110001 #b010)
                expect
                (fp #b0 #b100000000000 #b000)))
(assert (fp.leq (fp #b0 #b100000000000 #b000)
                expect
                (fp #b0 #b110110110010 #b110)))

(assert (= expect result))

(check-sat)
(exit)
