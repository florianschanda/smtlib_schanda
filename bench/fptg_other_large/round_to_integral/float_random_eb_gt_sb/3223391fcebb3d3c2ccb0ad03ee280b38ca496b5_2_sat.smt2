; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL(4)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110010001 #b0010)
                arg1
                (fp #b1 #b0000000000 #b1100)))
(assert (fp.leq (fp #b1 #b0000000000 #b1100)
                arg1
                (fp #b0 #b0100101001 #b1010)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111010110 #b1111)
                expect
                (fp #b1 #b0111111111 #b0000)))
(assert (fp.leq (fp #b1 #b0111111111 #b0000)
                expect
                (fp #b0 #b1111011101 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
