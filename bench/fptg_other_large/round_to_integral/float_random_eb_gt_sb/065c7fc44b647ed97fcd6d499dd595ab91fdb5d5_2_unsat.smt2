(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_TWO

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111101000 #b10101)
                arg1
                (fp #b1 #b011111111 #b10110)))
(assert (fp.leq (fp #b1 #b011111111 #b10110)
                arg1
                (fp #b1 #b001100101 #b10011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100000 #b11111)
                expect
                (fp #b1 #b100000000 #b00000)))
(assert (fp.leq (fp #b1 #b100000000 #b00000)
                expect
                (fp #b0 #b100100011 #b00110)))

(assert (not (= expect result)))

(check-sat)
(exit)
