;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 10))
(assert (fp.leq (fp #b1 #b1100011001 #b111000000)
                arg1
                (fp #b0 #b0011100110 #b101001010)))
(assert (fp.leq (fp #b0 #b0011100110 #b101001010)
                arg1
                (fp #b0 #b0100000010 #b001110110)))

(declare-const result (_ FloatingPoint 10 10))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 10 10))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b1001010110 #b101000001)
                expect
                (fp #b0 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0110110011 #b011100011)))

(assert (= expect result))

(check-sat)
(exit)
