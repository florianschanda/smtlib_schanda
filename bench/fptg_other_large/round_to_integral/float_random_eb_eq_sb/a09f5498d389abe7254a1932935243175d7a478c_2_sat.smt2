(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1110110011101100 #b000011001000010)
                arg1
                (fp #b1 #b0111111111111111 #b110100000111010)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b110100000111010)
                arg1
                (fp #b0 #b1011011011000010 #b111100010100110)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1010101111001100 #b000000000001001)
                expect
                (fp #b1 #b1000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000000000 #b000000000000000)
                expect
                (fp #b1 #b0101111000010111 #b011001010100101)))

(assert (= expect result))

(check-sat)
(exit)
