(assert (fp.leq (fp #b0 #b000011110 #b01010110)
                expect
                (fp #b0 #b011111111 #b00000000)))
(assert (fp.leq (fp #b0 #b011111111 #b00000000)
                expect
                (fp #b0 #b110000110 #b11001100)))

(assert (= expect result))

(check-sat)
(exit)
