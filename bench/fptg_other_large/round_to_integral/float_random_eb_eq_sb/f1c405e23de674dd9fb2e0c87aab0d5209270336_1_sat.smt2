(assert (fp.leq (fp #b1 #b00011000010 #b1000011111)
                expect
                (fp #b1 #b00000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0000000000)
                expect
                (fp #b0 #b00100101100 #b0110101000)))

(assert (= expect result))

(check-sat)
