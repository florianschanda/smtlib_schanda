(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 11))
(assert (fp.leq (fp #b1 #b01101011011 #b1001110001)
                arg1
                (fp #b1 #b00000000000 #b1111111111)))
