; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(5)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1101001010001011 #b111111000101100)
                arg1
                (fp #b1 #b0111111111111111 #b100111100100001)))
(assert (fp.leq (fp #b1 #b0111111111111111 #b100111100100001)
                arg1
                (fp #b0 #b0110010001001010 #b101010011011000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b1111110011110111 #b011110000100000)
                expect
                (fp #b1 #b1000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000000000 #b000000000000000)
                expect
                (fp #b0 #b0001010011000101 #b100011111101010)))

(assert (= expect result))

(check-sat)
(exit)
