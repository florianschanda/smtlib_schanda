(assert (fp.leq (fp #b1 #b0101010101 #b011100111)
                expect
                (fp #b1 #b0000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000000)
                expect
                (fp #b0 #b0101111100 #b111011100)))

(assert (not (= expect result)))

