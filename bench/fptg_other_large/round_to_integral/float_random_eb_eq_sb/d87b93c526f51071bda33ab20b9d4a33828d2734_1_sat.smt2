(assert (fp.leq (fp #b1 #b0011010110101001 #b010011110001010)
                expect
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b0010011100100000 #b010101101011011)))

(assert (= expect result))

(check-sat)
(exit)
