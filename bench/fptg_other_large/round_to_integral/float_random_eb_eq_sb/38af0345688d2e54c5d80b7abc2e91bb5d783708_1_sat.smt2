;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 16))
(assert (fp.leq (fp #b1 #b0101001011011001 #b010011000001100)
                arg1
                (fp #b1 #b0100100001011010 #b001011000010101)))
(assert (fp.leq (fp #b1 #b0100100001011010 #b001011000010101)
                arg1
                (fp #b0 #b1001101011001110 #b000001011011000)))

(declare-const result (_ FloatingPoint 16 16))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 16 16))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0000111100101100 #b101101000000011)
                expect
                (fp #b1 #b0000000000000000 #b000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000000000000000)
                expect
                (fp #b0 #b1000111000010100 #b110001011011001)))

(assert (= expect result))

(check-sat)
(exit)
