; Format: FLOAT_RANDOM_EB_EQ_SB
; Arg1: -RANDOM_NORMAL_LT_TWO(2)

; Redundancy: True
; Validation for: ROUND_TO_INTEGRAL
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: FULL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b110000100000 #b11100110001)
                arg1
                (fp #b1 #b011111111111 #b11001010001)))
(assert (fp.leq (fp #b1 #b011111111111 #b11001010001)
                arg1
                (fp #b1 #b011000111111 #b11001111010)))

(declare-const result (_ FloatingPoint 12 12))
(assert (= result (fp.roundToIntegral rm arg1)))

(declare-const expect (_ FloatingPoint 12 12))
(assert (fp.leq (fp #b1 #b111011001001 #b10111110111)
                expect
                (fp #b1 #b100000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b100000000000 #b00000000000)
                expect
                (fp #b0 #b110011010101 #b11001001000)))

(assert (= expect result))

(check-sat)
(exit)
