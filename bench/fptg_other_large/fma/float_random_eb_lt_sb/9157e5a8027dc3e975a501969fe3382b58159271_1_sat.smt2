(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 25))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 25))
(assert (fp.leq (fp #b1 #b111100000011110 #b010010101000100101001110)
                arg2
                (fp #b0 #b101101011010000 #b010110101011010111110101)))
(assert (fp.leq (fp #b0 #b101101011010000 #b010110101011010111110101)
                arg2
                (fp #b0 #b110100111100001 #b000001110101000001001011)))

(declare-const arg3 (_ FloatingPoint 15 25))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 25))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 25))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
