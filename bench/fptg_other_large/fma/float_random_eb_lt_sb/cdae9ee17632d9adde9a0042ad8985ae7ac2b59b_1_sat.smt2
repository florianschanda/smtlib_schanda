(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 32))
(assert (fp.leq (fp #b1 #b100 #b0100011010100100111001100000001)
                arg1
                (fp #b1 #b000 #b0100000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000 #b0100000000000000000000000000000)
                arg1
                (fp #b0 #b110 #b1010000000001100000110011110011)))

(declare-const arg2 (_ FloatingPoint 3 32))
(assert (fp.leq (fp #b0 #b000 #b1001001101000011001001011010100)
                arg2
                (fp #b0 #b000 #b1010101000100010100101010110100)))
(assert (fp.leq (fp #b0 #b000 #b1010101000100010100101010110100)
                arg2
                (fp #b0 #b010 #b1101001101110010111101011010011)))

(declare-const arg3 (_ FloatingPoint 3 32))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 3 32))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 32))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
