                (fp #b1 #b010011000011100 #b0000111010001100101000101101001)))
(assert (fp.leq (fp #b1 #b010011000011100 #b0000111010001100101000101101001)
                arg2
                (fp #b1 #b001101000000011 #b1111101011110110110111110111010)))

(declare-const arg3 (_ FloatingPoint 15 32))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 15 32))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 32))
