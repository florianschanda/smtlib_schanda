(assert (fp.leq (fp #b1 #b01100010100 #b11001000100110101000100)
                arg3
                (fp #b0 #b01000011101 #b11110010000100100101101)))
(assert (fp.leq (fp #b0 #b01000011101 #b11110010000100100101101)
                arg3
                (fp #b0 #b10110101100 #b10001010100110111110010)))

(declare-const result (_ FloatingPoint 11 24))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 24))
(assert (fp.leq (fp #b1 #b00001000101 #b00111101001100010011100)
                expect
                (fp #b0 #b01000011101 #b11110010000100100101101)))
(assert (fp.leq (fp #b0 #b01000011101 #b11110010000100100101101)
                expect
                (fp #b0 #b01011000111 #b11001011110110011000000)))

(assert (= expect result))

(check-sat)
(exit)
