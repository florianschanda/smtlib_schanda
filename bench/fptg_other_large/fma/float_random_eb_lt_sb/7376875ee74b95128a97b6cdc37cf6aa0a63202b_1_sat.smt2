(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 26))
(assert (fp.leq (fp #b1 #b11100100001010 #b0101111011010101111011101)
                arg1
                (fp #b1 #b00010000000111 #b1010101101111110010010010)))
(assert (fp.leq (fp #b1 #b00010000000111 #b1010101101111110010010010)
                arg1
                (fp #b0 #b01101101101101 #b1010001110011100101010011)))

(declare-const arg2 (_ FloatingPoint 14 26))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 14 26))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 14 26))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 26))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
