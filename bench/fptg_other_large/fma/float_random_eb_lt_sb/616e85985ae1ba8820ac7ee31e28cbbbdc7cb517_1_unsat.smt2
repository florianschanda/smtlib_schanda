; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 18))
(assert (fp.leq (fp #b1 #b0101101010 #b10010101001000000)
                arg1
                (fp #b1 #b0001010010 #b01010111000011110)))
(assert (fp.leq (fp #b1 #b0001010010 #b01010111000011110)
                arg1
                (fp #b0 #b0101110111 #b11110000110111110)))

(declare-const arg2 (_ FloatingPoint 10 18))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 18))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 18))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
