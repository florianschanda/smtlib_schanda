                (fp #b0 #b1101011110 #b1110101101010111010)))
(assert (fp.leq (fp #b0 #b1101011110 #b1110101101010111010)
                arg2
                (fp #b0 #b1111101110 #b1010010110101110110)))

(declare-const arg3 (_ FloatingPoint 10 20))
(assert (fp.leq (fp #b1 #b1111111001 #b0011000001011010011)
                arg3
                (fp #b0 #b0010000100 #b1100100001001010111)))
(assert (fp.leq (fp #b0 #b0010000100 #b1100100001001010111)
                arg3
                (fp #b0 #b0011101010 #b0001000001101001110)))

(declare-const result (_ FloatingPoint 10 20))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 20))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
