; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: -INFINITY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 15))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 15))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 15))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b011011100101 #b00010010110010)
                arg3
                (fp #b1 #b000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000000000)
                arg3
                (fp #b0 #b010100111100 #b01010110001110)))

(declare-const result (_ FloatingPoint 12 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
