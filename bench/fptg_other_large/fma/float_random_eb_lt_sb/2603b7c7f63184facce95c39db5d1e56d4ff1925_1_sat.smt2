(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 40))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 2 40))
(assert (fp.leq (fp #b1 #b01 #b010010100110010000001111101100010110101)
                arg2
                (fp #b1 #b01 #b000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b01 #b000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b00 #b011000000100010111111011101011101000111)))

(declare-const arg3 (_ FloatingPoint 2 40))
(assert (fp.leq (fp #b0 #b10 #b010110111111010111000110011001110001011)
                arg3
                (fp #b0 #b10 #b100000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10 #b100000000000000000000000000000000000000)
                arg3
                (fp #b0 #b10 #b100100000001100111010011100000110000111)))

(declare-const result (_ FloatingPoint 2 40))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 40))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
