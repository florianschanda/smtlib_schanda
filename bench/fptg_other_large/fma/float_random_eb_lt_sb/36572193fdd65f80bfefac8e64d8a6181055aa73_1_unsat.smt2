(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 28))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 28))
(assert (fp.leq (fp #b0 #b0001111001111111 #b101010001111111000111011110)
                arg2
                (fp #b0 #b0111010001110101 #b110100111011100001110111011)))
(assert (fp.leq (fp #b0 #b0111010001110101 #b110100111011100001110111011)
                arg2
                (fp #b0 #b1111110001000101 #b100111111101001100010000010)))

(declare-const arg3 (_ FloatingPoint 16 28))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 28))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 28))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
