(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 28))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 28))
(assert (fp.leq (fp #b1 #b01001101100 #b011001010010011111111000010)
                arg2
                (fp #b0 #b10110101101 #b111101011010101101011110101)))
(assert (fp.leq (fp #b0 #b10110101101 #b111101011010101101011110101)
                arg2
                (fp #b0 #b11111001000 #b100101011101101111011101010)))

(declare-const arg3 (_ FloatingPoint 11 28))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 11 28))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 28))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
