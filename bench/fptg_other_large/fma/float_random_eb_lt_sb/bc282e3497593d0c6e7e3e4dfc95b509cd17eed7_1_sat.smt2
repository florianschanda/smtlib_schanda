(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 4 56))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 4 56))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 56))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
