; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 48))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 3 48))
(assert (fp.leq (fp #b1 #b110 #b11101001000011010011010111100110011111001010110)
                arg2
                (fp #b1 #b110 #b11100000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b110 #b11100000000000000000000000000000000000000000000)
                arg2
                (fp #b1 #b100 #b11111101101110110100110100000010011010011000001)))

(declare-const arg3 (_ FloatingPoint 3 48))
(assert (fp.leq (fp #b1 #b101 #b10101101001000101100110010000011101111010101100)
                arg3
                (fp #b1 #b001 #b01000010110001011100101010110110001001010110010)))
(assert (fp.leq (fp #b1 #b001 #b01000010110001011100101010110110001001010110010)
                arg3
                (fp #b0 #b101 #b11001101011111010111101111100010000110100000111)))

(declare-const result (_ FloatingPoint 3 48))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 48))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
