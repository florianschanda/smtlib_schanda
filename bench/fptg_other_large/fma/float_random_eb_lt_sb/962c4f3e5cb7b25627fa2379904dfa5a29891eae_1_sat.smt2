                arg3
                (fp #b0 #b110011 #b1000000101101111111101000010100001011011)))

(declare-const result (_ FloatingPoint 6 41))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 41))
