(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 30))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 7 30))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 7 30))
(assert (fp.leq (fp #b1 #b1010011 #b00110000001101001001110110001)
                arg3
                (fp #b0 #b0000000 #b01000001010110111011010100110)))
(assert (fp.leq (fp #b0 #b0000000 #b01000001010110111011010100110)
                arg3
                (fp #b0 #b0110010 #b00000000100101000000101010111)))

(declare-const result (_ FloatingPoint 7 30))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 30))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
