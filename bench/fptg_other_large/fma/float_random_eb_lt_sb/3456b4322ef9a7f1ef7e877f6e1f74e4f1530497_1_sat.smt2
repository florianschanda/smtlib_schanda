;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 40))
(assert (fp.leq (fp #b1 #b110100101001 #b000110001111000110100011110110001100011)
                arg1
                (fp #b1 #b000100000100 #b001010101101111110011110110101010010010)))
(assert (fp.leq (fp #b1 #b000100000100 #b001010101101111110011110110101010010010)
                arg1
                (fp #b0 #b011110000101 #b000001011000110010101100011011010100011)))

(declare-const arg2 (_ FloatingPoint 12 40))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 40))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b101100111100 #b001100001110010100111110011001100111001)
                arg3
                (fp #b0 #b000000000000 #b000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000000000000000000000000000000000000000)
                arg3
                (fp #b0 #b101011000111 #b101100000010100011011000100011101100111)))

(declare-const result (_ FloatingPoint 12 40))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 40))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
