; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +NAN
; Arg2: +ZERO
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 48))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 48))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b11101111011100 #b11100011100110000111000110101001100100100000110)
                arg2
                (fp #b0 #b00000000000000 #b00000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b01101111110111 #b10110101111011000010001010110101110101001001001)))

(declare-const arg3 (_ FloatingPoint 14 48))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 48))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 48))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
