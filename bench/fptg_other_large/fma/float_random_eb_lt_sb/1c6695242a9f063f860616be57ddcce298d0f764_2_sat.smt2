(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 15))
(assert (fp.leq (fp #b1 #b101100111011 #b11101110101101)
                arg1
                (fp #b1 #b000000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000000000000)
                arg1
                (fp #b0 #b001111100000 #b01010111101010)))

(declare-const arg2 (_ FloatingPoint 12 15))
(assert (fp.leq (fp #b1 #b111011101100 #b11010000111111)
                arg2
                (fp #b1 #b000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b000000000000 #b01110111010011)
                arg2
                (fp #b0 #b000111111101 #b00001010000111)))

(declare-const arg3 (_ FloatingPoint 12 15))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b100010110010 #b01010100010010)
                arg3
                (fp #b0 #b000000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000000)
                arg3
                (fp #b0 #b000100010011 #b01000110111111)))

(declare-const result (_ FloatingPoint 12 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 15))
(assert (fp.leq (fp #b1 #b111111000100 #b01001011000100)
                expect
                (fp #b0 #b000000000000 #b00000000000001)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000000001)
                expect
                (fp #b0 #b101011101010 #b01001111101100)))

(assert (= expect result))

(check-sat)
(exit)
