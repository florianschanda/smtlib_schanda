; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 48))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 48))
(assert (fp.leq (fp #b1 #b10000100001111 #b10111011011011001010111100100100001111010110001)
                arg2
                (fp #b1 #b10000000101111 #b00000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b10000000101111 #b00000000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b10100101111100 #b00010111110011001100011010010110001110111010011)))

(declare-const arg3 (_ FloatingPoint 14 48))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b11010000100010 #b10100011001011101100001101111001010010000101010)
                arg3
                (fp #b1 #b00000000000000 #b00000000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000000000000000000000000000000000000000000000)
                arg3
                (fp #b0 #b11000111000110 #b01111111110100010101110011111010001001010011010)))

(declare-const result (_ FloatingPoint 14 48))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 48))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
