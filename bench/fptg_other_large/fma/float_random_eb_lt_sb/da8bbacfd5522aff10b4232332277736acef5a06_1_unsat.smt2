(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 10 32))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 32))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

