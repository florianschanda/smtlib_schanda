                arg3
                (fp #b1 #b100000000010010 #b000000000000000000)))
(assert (fp.leq (fp #b1 #b100000000010010 #b000000000000000000)
                arg3
                (fp #b0 #b100010110001100 #b010111011000101101)))

(declare-const result (_ FloatingPoint 15 19))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 19))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
