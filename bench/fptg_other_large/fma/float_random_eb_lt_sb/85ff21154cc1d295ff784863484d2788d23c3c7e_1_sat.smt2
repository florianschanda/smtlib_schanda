                arg3
                (fp #b0 #b101000100011 #b0001010010111000001000000001101011110000001100111111)))

(declare-const result (_ FloatingPoint 12 53))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 53))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
