(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 32))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 3 32))
(assert (fp.leq (fp #b1 #b100 #b0011011100101000011000010010000)
