                (fp #b1 #b000 #b0100000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000 #b0100000000000000000000000000000)
                arg2
                (fp #b0 #b110 #b0100010010110101001111110110100)))

(declare-const arg3 (_ FloatingPoint 3 32))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b101 #b0110110111111101011000100111001)
                arg3
                (fp #b0 #b000 #b0000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000 #b0000000000000000000000000000000)
                arg3
                (fp #b0 #b101 #b0010000011001111100101010100101)))

(declare-const result (_ FloatingPoint 3 32))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 32))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
