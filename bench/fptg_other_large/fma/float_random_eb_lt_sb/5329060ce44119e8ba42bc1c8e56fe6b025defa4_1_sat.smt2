(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +NAN
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 7 25))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 7 25))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 7 25))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1000000 #b001110001101101011001110)
                arg3
                (fp #b1 #b0000000 #b000000000000000000000000)))
(assert (fp.leq (fp #b1 #b0000000 #b000000000000000000000000)
                arg3
                (fp #b0 #b1111100 #b111101110101111111010011)))

(declare-const result (_ FloatingPoint 7 25))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 7 25))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
