; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 36))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 6 36))
(assert (fp.leq (fp #b1 #b010111 #b10101110011000111000101011111110001)
                arg2
                (fp #b1 #b000000 #b01101101010011101001101110111000110)))
(assert (fp.leq (fp #b1 #b000000 #b01101101010011101001101110111000110)
                arg2
                (fp #b0 #b101010 #b10101011001001000010101100001011000)))

(declare-const arg3 (_ FloatingPoint 6 36))
(assert (fp.leq (fp #b1 #b111111 #b00000000000000000000000000000000000)
                arg3
                (fp #b1 #b111110 #b11111111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b111110 #b11111111111111111111111111111111111)
                arg3
                (fp #b1 #b010011 #b11110111110000100011011100100010101)))

(declare-const result (_ FloatingPoint 6 36))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 36))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
