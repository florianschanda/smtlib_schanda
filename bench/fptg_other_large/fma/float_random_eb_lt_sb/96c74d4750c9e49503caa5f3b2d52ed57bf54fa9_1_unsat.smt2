                arg3
                (fp #b0 #b000000000 #b0101000001010110111011010010101000100111001011011)))
(assert (fp.leq (fp #b0 #b000000000 #b0101000001010110111011010010101000100111001011011)
                arg3
                (fp #b0 #b001101100 #b1011011101100101101111010110111001111110100100011)))

(declare-const result (_ FloatingPoint 9 50))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

