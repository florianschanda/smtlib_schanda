;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 36))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 8 36))
(assert (fp.leq (fp #b1 #b11010001 #b00101111111111101100110101111111111)
                arg2
                (fp #b1 #b01001111 #b00110010000111010001100100101101001)))
(assert (fp.leq (fp #b1 #b01001111 #b00110010000111010001100100101101001)
                arg2
                (fp #b0 #b01100110 #b10111011011101010111001011000101010)))

(declare-const arg3 (_ FloatingPoint 8 36))
(assert (fp.leq (fp #b1 #b01010000 #b11110011101010101001010000100010100)
                arg3
                (fp #b1 #b01001001 #b01011000101110010101011001010110001)))
(assert (fp.leq (fp #b1 #b01001001 #b01011000101110010101011001010110001)
                arg3
                (fp #b0 #b01010111 #b00010111110011100000100101101001011)))

(declare-const result (_ FloatingPoint 8 36))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 36))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
