(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 47))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 2 47))
(assert (fp.leq (fp #b1 #b10 #b1000010100011011111101001110111101110000001001)
                arg2
                (fp #b0 #b00 #b0100000000000000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00 #b0100000000000000000000000000000000000000000000)
                arg2
                (fp #b0 #b00 #b1010011111100100101101001010101101100111000011)))

(declare-const arg3 (_ FloatingPoint 2 47))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 2 47))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 47))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
