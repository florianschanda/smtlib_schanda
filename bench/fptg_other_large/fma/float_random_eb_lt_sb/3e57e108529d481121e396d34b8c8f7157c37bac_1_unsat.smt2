(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 32))
(assert (fp.leq (fp #b1 #b101101111010100010 #b1011110000000110001101111100001)
                arg2
                (fp #b0 #b000000000000000000 #b1010101000100010100101010110100)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b1010101000100010100101010110100)
                arg2
                (fp #b0 #b111111000101000000 #b1000001000011100111001000011011)))

(declare-const arg3 (_ FloatingPoint 18 32))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 18 32))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 32))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
