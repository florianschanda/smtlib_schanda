; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 18))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 18))
(assert (fp.leq (fp #b1 #b0010100000111 #b00001000000111010)
                arg2
                (fp #b0 #b1110101101001 #b10101101010110111)))
(assert (fp.leq (fp #b0 #b1110101101001 #b10101101010110111)
                arg2
                (fp #b0 #b1111001000011 #b11001001011100100)))

(declare-const arg3 (_ FloatingPoint 13 18))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 18))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 18))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
