                arg3
                (fp #b0 #b011 #b1001000010100101100001111000100101010010)))

(declare-const result (_ FloatingPoint 3 41))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 41))
