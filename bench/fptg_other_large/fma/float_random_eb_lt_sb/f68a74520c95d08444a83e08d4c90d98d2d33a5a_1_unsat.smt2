                arg2
                (fp #b1 #b01100001111101 #b001110100100110)))
(assert (fp.leq (fp #b1 #b01100001111101 #b001110100100110)
                arg2
                (fp #b0 #b01011111101000 #b000001101111100)))

(declare-const arg3 (_ FloatingPoint 14 16))
(assert (fp.leq (fp #b1 #b00011011011100 #b000011011011101)
                arg3
                (fp #b0 #b11111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b000000000000000)
                arg3
                (fp #b0 #b11111111111110 #b000010110110011)))

(declare-const result (_ FloatingPoint 14 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
