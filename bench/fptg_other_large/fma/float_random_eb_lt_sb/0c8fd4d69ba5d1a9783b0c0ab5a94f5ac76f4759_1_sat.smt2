(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 10))
(assert (fp.leq (fp #b1 #b110101100 #b101010000)
                arg1
                (fp #b1 #b000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b000000000 #b010000000)
                arg1
                (fp #b0 #b100001100 #b011110110)))

(declare-const arg2 (_ FloatingPoint 9 10))
(assert (fp.leq (fp #b1 #b011001101 #b001111001)
                arg2
                (fp #b0 #b000000000 #b100101010)))
(assert (fp.leq (fp #b0 #b000000000 #b100101010)
                arg2
                (fp #b0 #b110101010 #b110000100)))

(declare-const arg3 (_ FloatingPoint 9 10))
(assert (fp.leq (fp #b1 #b011001001 #b111110111)
                arg3
                (fp #b1 #b001011001 #b111001100)))
(assert (fp.leq (fp #b1 #b001011001 #b111001100)
                arg3
                (fp #b0 #b000000001 #b100110101)))

(declare-const result (_ FloatingPoint 9 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 10))
(assert (fp.leq (fp #b1 #b100100111 #b101001010)
                expect
                (fp #b1 #b001011001 #b111001100)))
(assert (fp.leq (fp #b1 #b001011001 #b111001100)
                expect
                (fp #b0 #b100000110 #b110001111)))

(assert (= expect result))

(check-sat)
(exit)
