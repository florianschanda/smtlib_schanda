; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 4 48))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 4 48))
(assert (fp.leq (fp #b1 #b0110 #b10101010111100110011011010111011100011111000000)
                arg2
                (fp #b0 #b0010 #b01000111010011010011101110001000010101110111100)))
(assert (fp.leq (fp #b0 #b0010 #b01000111010011010011101110001000010101110111100)
                arg2
                (fp #b0 #b0011 #b00010110011111110111111000101111110110110000011)))

(declare-const arg3 (_ FloatingPoint 4 48))
(assert (fp.leq (fp #b0 #b0101 #b01100101001010000110011010110111111111000000010)
                arg3
                (fp #b0 #b1110 #b11111111111111111111111111111111111111111111111)))
(assert (fp.leq (fp #b0 #b1110 #b11111111111111111111111111111111111111111111111)
                arg3
                (fp #b0 #b1111 #b00000000000000000000000000000000000000000000000)))

(declare-const result (_ FloatingPoint 4 48))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 48))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
