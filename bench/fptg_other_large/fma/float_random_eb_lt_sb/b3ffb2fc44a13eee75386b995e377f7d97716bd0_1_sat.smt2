                arg2
                (fp #b1 #b1101 #b00000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b1101 #b00000000000000000000000000000000000)
                arg2
                (fp #b1 #b0000 #b10001111100111100110011100011111111)))

(declare-const arg3 (_ FloatingPoint 4 36))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0011 #b01100100111001010110010111110100000)
                arg3
                (fp #b1 #b0000 #b00000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b0000 #b00000000000000000000000000000000000)
                arg3
                (fp #b0 #b1001 #b01101001111010111011100110011001001)))

(declare-const result (_ FloatingPoint 4 36))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 36))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
