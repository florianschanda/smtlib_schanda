(assert (fp.leq (fp #b1 #b10 #b1111111111111111111111111111111111111111)
                arg2
                (fp #b0 #b10 #b0011111100001100100011111110100110111111)))

(declare-const arg3 (_ FloatingPoint 2 41))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 2 41))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 41))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
