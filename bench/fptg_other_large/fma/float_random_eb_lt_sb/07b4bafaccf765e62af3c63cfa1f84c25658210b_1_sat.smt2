(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 38))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 38))
(assert (fp.leq (fp #b1 #b101010000010111 #b0100100011101101111111110000011110101)
                arg2
                (fp #b1 #b000000000000000 #b0100000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0100000000000000000000000000000000000)
                arg2
                (fp #b0 #b011000101000101 #b1100101010100010100001100111110000101)))

(declare-const arg3 (_ FloatingPoint 15 38))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 15 38))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 38))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
