; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: -INFINITY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
