(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 38))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 38))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 38))
(assert (fp.leq (fp #b1 #b0011110000010010 #b1101101001100000001111000111001011010)
                arg3
                (fp #b0 #b0100001101100001 #b0100001001001010111111000100011001101)))
(assert (fp.leq (fp #b0 #b0100001101100001 #b0100001001001010111111000100011001101)
                arg3
                (fp #b0 #b0101011111010111 #b0101010111101011000101000110111000011)))

(declare-const result (_ FloatingPoint 16 38))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 38))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
