(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 5 52))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 5 52))
(assert (fp.leq (fp #b1 #b01111 #b101111100101110110011001001110111001110001110100000)
                arg2
                (fp #b1 #b01100 #b100001100100001110100011001011111010101000101101001)))
(assert (fp.leq (fp #b1 #b01100 #b100001100100001110100011001011111010101000101101001)
                arg2
                (fp #b0 #b01011 #b111001101011101010010101100111011000110001110110001)))

(declare-const arg3 (_ FloatingPoint 5 52))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 5 52))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 5 52))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
