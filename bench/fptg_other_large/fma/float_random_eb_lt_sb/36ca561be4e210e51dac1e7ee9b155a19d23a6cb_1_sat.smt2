; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 4 30))
(assert (fp.leq (fp #b1 #b1101 #b00000001101010111101111000101)
                arg1
                (fp #b1 #b0100 #b00000001001010101101111110100)))
(assert (fp.leq (fp #b1 #b0100 #b00000001001010101101111110100)
                arg1
                (fp #b0 #b1010 #b11100000010110001000010110100)))

(declare-const arg2 (_ FloatingPoint 4 30))
(assert (fp.leq (fp #b1 #b0011 #b01011000000001101111000110101)
                arg2
                (fp #b0 #b0010 #b01000111010011010011101110010)))
(assert (fp.leq (fp #b0 #b0010 #b01000111010011010011101110010)
                arg2
                (fp #b0 #b0110 #b10101100010111001111001111111)))

(declare-const arg3 (_ FloatingPoint 4 30))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 4 30))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 30))
(assert (fp.leq (fp #b1 #b1011 #b00001010100000101111011001011)
                expect
                (fp #b1 #b0010 #b01110000011001101010011010111)))
(assert (fp.leq (fp #b1 #b0010 #b01110000011001101010011010111)
                expect
                (fp #b0 #b1010 #b11010000010010111111011111000)))

(assert (= expect result))

(check-sat)
(exit)
