                arg2
                (fp #b1 #b111111110 #b111111111111111111111111111111)))
(assert (fp.leq (fp #b1 #b111111110 #b111111111111111111111111111111)
                arg2
                (fp #b0 #b111101000 #b010101110010111111001000001100)))

(declare-const arg3 (_ FloatingPoint 9 31))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 31))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 31))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
