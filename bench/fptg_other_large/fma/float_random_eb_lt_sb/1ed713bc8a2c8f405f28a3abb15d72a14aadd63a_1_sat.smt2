; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 6 37))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 6 37))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 6 37))
(assert (fp.leq (fp #b1 #b110100 #b110001100001000101011010000001101110)
                arg3
                (fp #b1 #b100111 #b010100001101010000111011000011111100)))
(assert (fp.leq (fp #b1 #b100111 #b010100001101010000111011000011111100)
                arg3
                (fp #b1 #b010001 #b000000001000001110100110111000001000)))

(declare-const result (_ FloatingPoint 6 37))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 6 37))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
