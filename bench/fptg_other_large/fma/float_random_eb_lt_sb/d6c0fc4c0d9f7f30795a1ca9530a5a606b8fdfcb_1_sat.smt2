(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +ZERO
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 35))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 3 35))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b100 #b1110011111110100101000100110110001)
                arg2
                (fp #b0 #b000 #b0000000000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b000 #b0000000000000000000000000000000000)
                arg2
                (fp #b0 #b000 #b1100000011000110111010111100100010)))

(declare-const arg3 (_ FloatingPoint 3 35))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 3 35))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 35))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
