                (fp #b0 #b111111111110 #b111111111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111111111111111)
                arg3
                (fp #b0 #b111111111111 #b000000000000000)))

(declare-const result (_ FloatingPoint 12 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 16))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
