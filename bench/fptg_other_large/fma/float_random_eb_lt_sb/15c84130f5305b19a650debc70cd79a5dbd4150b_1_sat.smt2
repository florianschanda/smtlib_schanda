(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +NAN
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 30))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 8 30))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 8 30))
(assert (fp.leq (fp #b1 #b10000000 #b00010101111000110111101000101)
                arg3
                (fp #b0 #b00000000 #b01000000000000000000000000000)))
(assert (fp.leq (fp #b0 #b00000000 #b01000000000000000000000000000)
                arg3
                (fp #b0 #b00001000 #b10110111001111100111000101111)))

(declare-const result (_ FloatingPoint 8 30))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 30))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
