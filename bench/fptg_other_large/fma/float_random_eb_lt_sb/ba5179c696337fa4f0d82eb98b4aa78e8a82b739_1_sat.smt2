(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 4 33))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 4 33))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 4 33))
(assert (fp.leq (fp #b1 #b0100 #b10011111011101111011101001010010)
                expect
                (fp #b1 #b0000 #b11000010010011100101011010011110)))
(assert (fp.leq (fp #b1 #b0000 #b11000010010011100101011010011110)
                expect
                (fp #b0 #b1000 #b00100001011011000001010000001011)))

(assert (= expect result))

(check-sat)
(exit)
