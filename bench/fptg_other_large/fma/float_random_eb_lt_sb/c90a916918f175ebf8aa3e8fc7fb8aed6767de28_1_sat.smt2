                arg3
                (fp #b1 #b011010101100 #b100111100111)))
(assert (fp.leq (fp #b1 #b011010101100 #b100111100111)
                arg3
                (fp #b0 #b011100001111 #b000000110110)))

(declare-const result (_ FloatingPoint 12 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 13))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
