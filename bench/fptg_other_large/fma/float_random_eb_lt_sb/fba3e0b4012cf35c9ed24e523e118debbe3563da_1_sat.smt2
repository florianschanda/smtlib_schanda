(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -INFINITY
; Arg2: +NAN
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 8 32))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 8 32))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 8 32))
(assert (fp.leq (fp #b1 #b10111000 #b1110110110011001111011000100110)
                arg3
                (fp #b0 #b11110100 #b1100100110010111100000001111001)))
(assert (fp.leq (fp #b0 #b11110100 #b1100100110010111100000001111001)
                arg3
                (fp #b0 #b11111100 #b1110101011001000101111100001000)))

(declare-const result (_ FloatingPoint 8 32))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 8 32))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
