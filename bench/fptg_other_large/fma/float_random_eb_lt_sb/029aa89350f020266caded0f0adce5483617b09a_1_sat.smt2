(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 2 37))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 2 37))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

