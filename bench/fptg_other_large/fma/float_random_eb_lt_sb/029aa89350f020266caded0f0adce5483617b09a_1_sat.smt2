(assert (fp.leq (fp #b1 #b01 #b000011100001011101111001111000111111)
                arg3
                (fp #b1 #b00 #b000001100000011000110110000111001100)))
(assert (fp.leq (fp #b1 #b00 #b000001100000011000110110000111001100)
                arg3
                (fp #b0 #b00 #b010101011110001010101001101010010100)))

(declare-const result (_ FloatingPoint 2 37))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 37))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
