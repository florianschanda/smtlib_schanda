(assert (fp.leq (fp #b1 #b00 #b10101110010001110001011100101100011101110000111000101101110)
                arg2
                (fp #b0 #b10 #b11010110011110101101010110101101101001110100001101101000100)))
(assert (fp.leq (fp #b0 #b10 #b11010110011110101101010110101101101001110100001101101000100)
                arg2
                (fp #b0 #b10 #b11011100110011000110100100011100111101011010010001110111011)))

(declare-const arg3 (_ FloatingPoint 2 60))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 2 60))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 60))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
