                arg3
                (fp #b1 #b1000100100 #b000000000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b1000100100 #b000000000000000000000000000000000000)
                arg3
                (fp #b0 #b0011011110 #b000110110111000001110100001110111000)))

(declare-const result (_ FloatingPoint 10 37))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 37))
(assert (fp.leq (fp #b1 #b1000100110 #b010010000111110110011001001010001111)
                expect
