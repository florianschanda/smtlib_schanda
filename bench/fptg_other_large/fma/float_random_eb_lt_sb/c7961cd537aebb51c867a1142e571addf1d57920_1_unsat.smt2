(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 27))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 9 27))
(assert (fp.leq (fp #b1 #b100100011 #b01001000010110110101010000)
                arg2
                (fp #b1 #b000000000 #b01000000000000000000000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000000000000000000000)
                arg2
                (fp #b0 #b101110111 #b00100111110111110010011000)))

(declare-const arg3 (_ FloatingPoint 9 27))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 27))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 27))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
