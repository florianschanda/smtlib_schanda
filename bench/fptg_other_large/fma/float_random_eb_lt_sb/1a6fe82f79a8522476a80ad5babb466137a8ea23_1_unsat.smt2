                arg2
                (fp #b0 #b11111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b000000000000000)
                arg2
                (fp #b0 #b11111111101 #b000111000110110)))

(declare-const arg3 (_ FloatingPoint 11 16))
(assert (fp.leq (fp #b0 #b00011101001 #b000110101010010)
                arg3
                (fp #b0 #b10000001111 #b000000000000000)))
(assert (fp.leq (fp #b0 #b10000001111 #b000000000000000)
                arg3
                (fp #b0 #b10110011010 #b001010011100000)))

(declare-const result (_ FloatingPoint 11 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
