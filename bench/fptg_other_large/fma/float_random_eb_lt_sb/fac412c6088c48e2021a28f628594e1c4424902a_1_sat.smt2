                arg3
                (fp #b0 #b110110101 #b0110011101)))

(declare-const result (_ FloatingPoint 9 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 11))
