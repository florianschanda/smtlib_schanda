; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 21))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 21))
(assert (fp.leq (fp #b1 #b0000110100001100 #b00110110011111011101)
                arg2
                (fp #b1 #b0000000000000000 #b01000000000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01000000000000000000)
                arg2
                (fp #b0 #b0111001111110101 #b00011011111010000110)))

(declare-const arg3 (_ FloatingPoint 16 21))
(assert (fp.leq (fp #b1 #b1101010010001011 #b10111100111100010000)
                arg3
                (fp #b1 #b1000000000010100 #b00000000000000000000)))
(assert (fp.leq (fp #b1 #b1000000000010100 #b00000000000000000000)
                arg3
                (fp #b0 #b0100000010011010 #b01000100111010111011)))

(declare-const result (_ FloatingPoint 16 21))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 21))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
