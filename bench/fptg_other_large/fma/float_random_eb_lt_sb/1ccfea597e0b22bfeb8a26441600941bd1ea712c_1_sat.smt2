;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 34))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 34))
(assert (fp.leq (fp #b0 #b0011010001011 #b010110011000100001010110011111010)
                arg2
                (fp #b0 #b0111010001111 #b100110100111011100010101110111011)))
(assert (fp.leq (fp #b0 #b0111010001111 #b100110100111011100010101110111011)
                arg2
                (fp #b0 #b1101110010010 #b111110000011000100010000011001000)))

(declare-const arg3 (_ FloatingPoint 13 34))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 13 34))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 34))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
