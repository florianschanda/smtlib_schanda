                arg1
                (fp #b0 #b110001101 #b0001101100)))

(declare-const arg2 (_ FloatingPoint 9 11))
(assert (fp.leq (fp #b1 #b111111111 #b0000000000)
                arg2
                (fp #b1 #b111111110 #b1111111111)))
(assert (fp.leq (fp #b1 #b111111110 #b1111111111)
                arg2
                (fp #b1 #b010110000 #b0110110011)))

(declare-const arg3 (_ FloatingPoint 9 11))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
