(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 32))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 32))
(assert (fp.leq (fp #b1 #b00000110010 #b1100111001111110000101100001000)
                arg2
                (fp #b0 #b00000000000 #b1010101000100010100101010110100)))
(assert (fp.leq (fp #b0 #b00000000000 #b1010101000100010100101010110100)
                arg2
                (fp #b0 #b00011000001 #b0000100011111010111001011011110)))

(declare-const arg3 (_ FloatingPoint 11 32))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 32))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 32))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
