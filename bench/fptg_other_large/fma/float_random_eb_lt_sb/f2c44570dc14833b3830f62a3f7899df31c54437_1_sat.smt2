; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 25))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 25))
(assert (fp.leq (fp #b1 #b11101010011 #b000110000110110111010111)
                arg2
                (fp #b0 #b00000000000 #b000100010100101110110011)))
(assert (fp.leq (fp #b0 #b00000000000 #b000100010100101110110011)
                arg2
                (fp #b0 #b10111110110 #b110111111111001111000111)))

(declare-const arg3 (_ FloatingPoint 11 25))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 25))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 25))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
