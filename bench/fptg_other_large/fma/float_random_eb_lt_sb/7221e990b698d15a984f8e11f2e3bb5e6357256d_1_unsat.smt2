(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 22))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 22))
(assert (fp.leq (fp #b1 #b0101110111 #b001100101001000101111)
                arg2
                (fp #b1 #b0001101000 #b100100001110100011101)))
(assert (fp.leq (fp #b1 #b0001101000 #b100100001110100011101)
                arg2
                (fp #b0 #b1100000100 #b100110101010001100000)))

(declare-const arg3 (_ FloatingPoint 10 22))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 10 22))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 22))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
