; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 20))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 20))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000000000000000000)
                arg2
                (fp #b1 #b11111111111110 #b1111111111111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111111111111111111)
                arg2
                (fp #b0 #b10011111001100 #b0001001000100100111)))

(declare-const arg3 (_ FloatingPoint 14 20))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00010110110111 #b1100100001101101001)
                arg3
                (fp #b1 #b00000000000000 #b0000000000000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000000000000000)
                arg3
                (fp #b0 #b00001011010001 #b0010011110000101111)))

(declare-const result (_ FloatingPoint 14 20))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 20))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
