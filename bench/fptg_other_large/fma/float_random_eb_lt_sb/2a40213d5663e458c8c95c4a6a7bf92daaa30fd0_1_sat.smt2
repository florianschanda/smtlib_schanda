(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 15))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b000011101 #b00001011011001)
                arg1
                (fp #b0 #b000000000 #b00000000000000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000000000000)
                arg1
                (fp #b0 #b111010011 #b00000011101011)))

(declare-const arg2 (_ FloatingPoint 9 15))
(assert (fp.leq (fp #b1 #b001101000 #b00111001001001)
                arg2
                (fp #b1 #b000000000 #b01000000000000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000000000000)
                arg2
                (fp #b0 #b001011110 #b11100011101000)))

(declare-const arg3 (_ FloatingPoint 9 15))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
