                arg2
                (fp #b0 #b0010101001110111 #b00001101110101100100100011000000010011110)))

(declare-const arg3 (_ FloatingPoint 16 42))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 42))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 42))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
