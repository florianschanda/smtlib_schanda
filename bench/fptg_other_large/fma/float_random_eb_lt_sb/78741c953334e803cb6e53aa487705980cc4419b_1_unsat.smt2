(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 3 31))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 3 31))
(assert (fp.leq (fp #b1 #b101 #b110010101110101100101000000110)
                arg2
                (fp #b1 #b101 #b000000000000000000000000000000)))
(assert (fp.leq (fp #b1 #b101 #b000000000000000000000000000000)
                arg2
                (fp #b0 #b110 #b111111100001101110101110010011)))

(declare-const arg3 (_ FloatingPoint 3 31))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 3 31))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 3 31))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
