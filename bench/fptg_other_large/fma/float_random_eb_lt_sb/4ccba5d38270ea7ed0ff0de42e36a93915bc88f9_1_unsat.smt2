(assert (fp.leq (fp #b0 #b10010110001000 #b10001011101011011100111111100)
                arg2
                (fp #b0 #b10110101101000 #b10101101010110101110011110101)))
(assert (fp.leq (fp #b0 #b10110101101000 #b10101101010110101110011110101)
                arg2
                (fp #b0 #b11101001011011 #b00000001100110010100001110011)))

(declare-const arg3 (_ FloatingPoint 14 30))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 30))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 30))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
