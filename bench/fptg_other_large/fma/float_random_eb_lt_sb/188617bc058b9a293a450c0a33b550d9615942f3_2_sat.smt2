(assert (fp.leq (fp #b0 #b01 #b100100101000011101101100011)
                arg3
                (fp #b0 #b10 #b100000000000000000000000000)))
(assert (fp.leq (fp #b0 #b10 #b100000000000000000000000000)
                arg3
                (fp #b0 #b10 #b100000100110001101000000010)))

(declare-const result (_ FloatingPoint 2 28))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 2 28))
(assert (fp.leq (fp #b0 #b01 #b000110001000010111100001000)
                expect
                (fp #b0 #b10 #b000000101011000010110000110)))
(assert (fp.leq (fp #b0 #b10 #b000000101011000010110000110)
                expect
                (fp #b0 #b10 #b111000000001101100010000000)))

(assert (= expect result))

(check-sat)
(exit)
