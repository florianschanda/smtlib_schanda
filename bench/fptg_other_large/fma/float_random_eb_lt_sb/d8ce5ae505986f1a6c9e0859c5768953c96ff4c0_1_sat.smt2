; Format: FLOAT_RANDOM_EB_LT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 33))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 33))
(assert (fp.leq (fp #b1 #b001000111000100 #b01011101000111101111100100111100)
                arg2
                (fp #b0 #b101101011010000 #b01011010101101011100110011110101)))
(assert (fp.leq (fp #b0 #b101101011010000 #b01011010101101011100110011110101)
                arg2
                (fp #b0 #b101110011010110 #b11001001011111101001000111110101)))

(declare-const arg3 (_ FloatingPoint 15 33))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 33))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 33))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
