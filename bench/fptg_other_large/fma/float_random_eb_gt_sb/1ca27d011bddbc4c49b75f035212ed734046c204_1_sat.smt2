(assert (fp.leq (fp #b1 #b010101001111 #b10100110)
                arg2
                (fp #b1 #b010000010000 #b10000011)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011010100001 #b00101110)
                arg3
                (fp #b1 #b000000000000 #b11001101)))
(assert (fp.leq (fp #b1 #b000000000000 #b11001101)
                arg3
                (fp #b0 #b101100001010 #b01110101)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111110011110 #b11100001)
                expect
                (fp #b1 #b110101001101 #b10100110)))
(assert (fp.leq (fp #b1 #b110101001101 #b10100110)
                expect
                (fp #b0 #b001110110101 #b11100001)))

(assert (= expect result))

(check-sat)
(exit)
