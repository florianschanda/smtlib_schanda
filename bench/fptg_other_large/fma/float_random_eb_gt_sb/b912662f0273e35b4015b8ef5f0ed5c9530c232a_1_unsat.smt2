(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0111101100101001 #b1011)
                arg2
                (fp #b0 #b1111111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111)
                arg2
                (fp #b0 #b1111111111111111 #b0000)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1110001111110010 #b0110)
                arg3
                (fp #b1 #b1011010100101100 #b1010)))
(assert (fp.leq (fp #b1 #b1011010100101100 #b1010)
                arg3
                (fp #b1 #b1001001000101110 #b1010)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
