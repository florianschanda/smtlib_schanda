(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1100101101100011 #b00000010010001)
                arg2
                (fp #b1 #b0000000000000000 #b01110111010011)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01110111010011)
                arg2
                (fp #b0 #b1011111100010001 #b01011000010110)))

(declare-const arg3 (_ FloatingPoint 16 15))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0110010011110010 #b00010111111101)
                arg3
                (fp #b1 #b0000000000000000 #b00000000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000000000)
                arg3
                (fp #b0 #b0011111001101001 #b10001100100010)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
