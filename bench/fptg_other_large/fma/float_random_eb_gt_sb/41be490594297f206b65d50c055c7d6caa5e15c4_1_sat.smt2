(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1010110111100100 #b1001)
                arg1
                (fp #b0 #b1111111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111)
                arg1
                (fp #b0 #b1111111111111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0100100000011000 #b1001)
                arg2
                (fp #b1 #b0000000000000000 #b1110)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b1110)
                arg2
                (fp #b0 #b1110010111001101 #b0010)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0100000010011110 #b0100)
                arg3
                (fp #b1 #b0000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000)
                arg3
                (fp #b0 #b1011010101110010 #b0100)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1100001100111000 #b0100)
                expect
                (fp #b1 #b1000000000000000 #b1011)))
(assert (fp.leq (fp #b1 #b1000000000000000 #b1011)
                expect
                (fp #b0 #b1110101111101011 #b1101)))

(assert (= expect result))

(check-sat)
(exit)
