; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -INFINITY
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b1111110000001000 #b00110)
                arg1
                (fp #b1 #b1111101001001001 #b00011)))
(assert (fp.leq (fp #b1 #b1111101001001001 #b00011)
                arg1
                (fp #b0 #b1001100011110011 #b00000)))

(declare-const arg2 (_ FloatingPoint 16 6))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 6))
(assert (fp.leq (fp #b1 #b0111100001000110 #b10111)
                arg3
                (fp #b0 #b0000000000000000 #b10111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b10111)
                arg3
                (fp #b0 #b0000000011000000 #b00101)))

(declare-const result (_ FloatingPoint 16 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
