(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b1110010000111111 #b0101001011)
                arg1
                (fp #b0 #b0010000100111011 #b0100111101)))
(assert (fp.leq (fp #b0 #b0010000100111011 #b0100111101)
                arg1
                (fp #b0 #b1011111100101010 #b1100111000)))

(declare-const arg2 (_ FloatingPoint 16 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b0 #b1100011001111000 #b0011010100)
                arg3
                (fp #b0 #b1111111111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b0000000000)
                arg3
                (fp #b0 #b1111111111111101 #b1001011100)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.leq (fp #b1 #b0100110101001010 #b0011101000)
                expect
                (fp #b0 #b1111111111111101 #b0000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b0000000000)
                expect
                (fp #b0 #b1111111111111110 #b1010111010)))

(assert (= expect result))

(check-sat)
(exit)
