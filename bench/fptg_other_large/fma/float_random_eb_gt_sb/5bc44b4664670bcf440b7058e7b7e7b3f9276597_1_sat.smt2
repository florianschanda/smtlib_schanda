(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b010011011100010110 #b01)
                arg2
                (fp #b1 #b001100000010110101 #b00)))
(assert (fp.leq (fp #b1 #b001100000010110101 #b00)
                arg2
                (fp #b0 #b111111011111111101 #b00)))

(declare-const arg3 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b000100110110110101 #b00)
                arg3
                (fp #b1 #b000000000000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b10)
                arg3
                (fp #b0 #b101100000011100110 #b00)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
