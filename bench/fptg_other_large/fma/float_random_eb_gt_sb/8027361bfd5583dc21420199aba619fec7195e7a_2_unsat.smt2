; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -LARGEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b011000101101000 #b000)
                arg1
                (fp #b0 #b101111100011001 #b010)))
(assert (fp.leq (fp #b0 #b101111100011001 #b010)
                arg1
                (fp #b0 #b111000000111110 #b011)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111111111111111 #b000)
                arg2
                (fp #b1 #b111111111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111)
                arg2
                (fp #b0 #b110101000001010 #b011)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111111111111111 #b000)
                arg3
                (fp #b1 #b111111111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111)
                arg3
                (fp #b1 #b000110110110011 #b100)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
