(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b000111011 #b1011)
                arg1
                (fp #b0 #b111111110 #b1111)))
(assert (fp.leq (fp #b0 #b111111110 #b1111)
                arg1
                (fp #b0 #b111111111 #b0000)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101010111 #b1011)
                arg2
                (fp #b1 #b000000011 #b0101)))
(assert (fp.leq (fp #b1 #b000000011 #b0101)
                arg2
                (fp #b0 #b011001010 #b1111)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100101110 #b1101)
                expect
                (fp #b1 #b100000011 #b0100)))
(assert (fp.leq (fp #b1 #b100000011 #b0100)
                expect
                (fp #b0 #b000100100 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
