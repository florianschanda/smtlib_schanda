;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b110010000 #b100001)
                arg1
                (fp #b0 #b111011100 #b100101)))
(assert (fp.leq (fp #b0 #b111011100 #b100101)
                arg1
                (fp #b0 #b111011101 #b100011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101011010 #b100011)
                arg3
                (fp #b1 #b100000110 #b000000)))
(assert (fp.leq (fp #b1 #b100000110 #b000000)
                arg3
                (fp #b0 #b001100101 #b001111)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111111111 #b000000)
                expect
                (fp #b1 #b111111110 #b111111)))
(assert (fp.leq (fp #b1 #b111111110 #b111111)
                expect
                (fp #b0 #b010111100 #b001000)))

(assert (not (= expect result)))

(check-sat)
(exit)
