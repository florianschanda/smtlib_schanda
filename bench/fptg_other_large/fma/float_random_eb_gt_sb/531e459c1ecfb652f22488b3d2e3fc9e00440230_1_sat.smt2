(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -ZERO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b10000100000 #b01011)
                arg1
                (fp #b0 #b11111111110 #b11111)))
(assert (fp.leq (fp #b0 #b11111111110 #b11111)
                arg1
                (fp #b0 #b11111111111 #b00000)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b00011011101 #b00011)
                arg2
                (fp #b1 #b00000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000)
                arg2
                (fp #b0 #b00011010010 #b10111)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
