(assert (fp.leq (fp #b1 #b011010010 #b11101)
                arg3
                (fp #b0 #b101110000 #b00000)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111101 #b11110)
                expect
                (fp #b1 #b011010010 #b11101)))
(assert (fp.leq (fp #b1 #b011010010 #b11101)
                expect
                (fp #b0 #b110100001 #b11000)))

(assert (= expect result))

