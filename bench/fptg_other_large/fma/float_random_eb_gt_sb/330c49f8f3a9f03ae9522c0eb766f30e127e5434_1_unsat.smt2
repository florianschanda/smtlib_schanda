; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111101001 #b11110)
                arg1
                (fp #b1 #b00000000000 #b01000)))
(assert (fp.leq (fp #b1 #b00000000000 #b01000)
                arg1
                (fp #b0 #b10010100011 #b01101)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b00110111011 #b10011)
                arg2
                (fp #b0 #b11001010001 #b00010)))
(assert (fp.leq (fp #b0 #b11001010001 #b00010)
                arg2
                (fp #b0 #b11110011111 #b00111)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
