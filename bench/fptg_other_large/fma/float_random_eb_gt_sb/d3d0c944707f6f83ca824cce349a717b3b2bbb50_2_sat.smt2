(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b0 #b011110000001000000 #b01101)
                arg1
                (fp #b0 #b100000000000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000000000101 #b00000)
                arg1
                (fp #b0 #b100110100110101010 #b00100)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b101101001110001101 #b10101)
                arg2
                (fp #b0 #b100000000000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000000000101 #b00000)
                arg2
                (fp #b0 #b101101101110110000 #b01101)))

(declare-const arg3 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111111111111111110 #b01000)
                arg3
                (fp #b1 #b111111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b00000)
                arg3
                (fp #b1 #b001000011011101101 #b01101)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111111111111111110 #b10010)
                expect
                (fp #b1 #b111111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b00000)
                expect
                (fp #b0 #b011010110101100111 #b01100)))

(assert (= expect result))

(check-sat)
(exit)
