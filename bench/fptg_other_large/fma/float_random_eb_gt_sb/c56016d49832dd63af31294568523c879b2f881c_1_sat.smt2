(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00100111000 #b0010)
                arg1
                (fp #b0 #b11111111101 #b0000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000)
                arg1
                (fp #b0 #b11111111110 #b0001)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10110110101 #b1011)
                arg2
                (fp #b1 #b10000000100 #b0000)))
(assert (fp.leq (fp #b1 #b10000000100 #b0000)
                arg2
                (fp #b1 #b01000101000 #b1111)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11010110111 #b0011)
                arg3
                (fp #b1 #b00110100101 #b1111)))
(assert (fp.leq (fp #b1 #b00110100101 #b1111)
                arg3
                (fp #b0 #b11011000000 #b0110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111111 #b0000)
                expect
                (fp #b1 #b11111111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111)
                expect
                (fp #b1 #b00101101101 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
