(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b01111011010110 #b10)
                arg1
                (fp #b0 #b11101111111111 #b11)))
(assert (fp.leq (fp #b0 #b11101111111111 #b11)
                arg1
                (fp #b0 #b11110100011110 #b11)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b10000000111111 #b10)
                arg2
                (fp #b1 #b01111001100111 #b10)))
(assert (fp.leq (fp #b1 #b01111001100111 #b10)
                arg2
                (fp #b0 #b11010100111011 #b11)))

(declare-const arg3 (_ FloatingPoint 14 3))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11101100011111 #b10)
                expect
                (fp #b1 #b11101001101000 #b01)))
(assert (fp.leq (fp #b1 #b11101001101000 #b01)
                expect
                (fp #b1 #b11011101011000 #b11)))

(assert (= expect result))

(check-sat)
(exit)
