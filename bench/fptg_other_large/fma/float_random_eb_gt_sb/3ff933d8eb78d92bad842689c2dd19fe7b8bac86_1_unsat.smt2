                (fp #b0 #b100000000010 #b00)))
(assert (fp.leq (fp #b0 #b100000000010 #b00)
                arg2
                (fp #b0 #b111010110111 #b10)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111110110001 #b11)
                arg3
                (fp #b0 #b000100010010 #b01)))
(assert (fp.leq (fp #b0 #b000100010010 #b01)
                arg3
                (fp #b0 #b110001001100 #b01)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111110000111 #b01)
                expect
                (fp #b1 #b111101110110 #b01)))
(assert (fp.leq (fp #b1 #b111101110110 #b01)
                expect
                (fp #b0 #b110111010011 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
