(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b0 #b0100010111100111 #b01)
                arg1
                (fp #b0 #b1000000000000010 #b00)))
(assert (fp.leq (fp #b0 #b1000000000000010 #b00)
                arg1
                (fp #b0 #b1001111001000001 #b00)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00)
                arg2
                (fp #b1 #b1111111111111110 #b11)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11)
                arg2
                (fp #b0 #b1000001110101000 #b11)))

(declare-const arg3 (_ FloatingPoint 16 3))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0000001000010101 #b10)
                arg3
                (fp #b0 #b0000000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00)
                arg3
                (fp #b0 #b0000101000110100 #b00)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00)
                expect
                (fp #b1 #b1111111111111110 #b11)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11)
                expect
                (fp #b1 #b1110111011010001 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
