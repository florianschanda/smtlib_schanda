(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b00011111010 #b001010)
                arg1
                (fp #b1 #b00000000000 #b011011)))
(assert (fp.leq (fp #b1 #b00000000000 #b011011)
                arg1
                (fp #b0 #b11011100010 #b110011)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b01001110101 #b010011)
                arg2
                (fp #b0 #b01010000000 #b101000)))
(assert (fp.leq (fp #b0 #b01010000000 #b101000)
                arg2
                (fp #b0 #b10110000111 #b110101)))

(declare-const arg3 (_ FloatingPoint 11 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
