(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +ZERO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 17 6))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b10110101000000100 #b11111)
                arg2
                (fp #b0 #b00000000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00000)
                arg2
                (fp #b0 #b11110101110110010 #b01100)))

(declare-const arg3 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b11011010011111111 #b00011)
                arg3
                (fp #b1 #b00000000000000000 #b10000)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b10000)
                arg3
                (fp #b0 #b10011001001100100 #b00000)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
