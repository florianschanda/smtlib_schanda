(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101110000 #b000)
                arg1
                (fp #b1 #b100000011 #b000)))
(assert (fp.leq (fp #b1 #b100000011 #b000)
                arg1
                (fp #b1 #b011000111 #b010)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b100010010 #b110)
                arg2
                (fp #b0 #b111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111101 #b000)
                arg2
                (fp #b0 #b111111101 #b101)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100111001 #b011)
                arg3
                (fp #b0 #b000000000 #b010)))
(assert (fp.leq (fp #b0 #b000000000 #b010)
                arg3
                (fp #b0 #b110111101 #b011)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
