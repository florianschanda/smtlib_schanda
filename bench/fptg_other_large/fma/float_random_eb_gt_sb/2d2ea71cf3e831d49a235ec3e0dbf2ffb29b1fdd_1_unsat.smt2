(assert (fp.leq (fp #b0 #b1000000001001 #b000000000)
                arg3
                (fp #b0 #b1010011001110 #b110101000)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
