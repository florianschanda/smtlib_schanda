(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11101011000 #b1100)
                arg1
                (fp #b1 #b00111011111 #b1110)))
(assert (fp.leq (fp #b1 #b00111011111 #b1110)
                arg1
