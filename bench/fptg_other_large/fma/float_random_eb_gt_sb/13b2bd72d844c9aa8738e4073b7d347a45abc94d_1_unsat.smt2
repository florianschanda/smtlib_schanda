                arg2
                (fp #b0 #b10000000011 #b0011)))
(assert (fp.leq (fp #b0 #b10000000011 #b0011)
                arg2
                (fp #b0 #b11101011010 #b0000)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10011110101 #b0100)
                arg3
                (fp #b0 #b00000000000 #b0010)))
(assert (fp.leq (fp #b0 #b00000000000 #b0010)
                arg3
                (fp #b0 #b11111100111 #b1000)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11011011010 #b1010)
                expect
                (fp #b1 #b00111100100 #b0001)))
(assert (fp.leq (fp #b1 #b00111100100 #b0001)
                expect
                (fp #b0 #b00001001110 #b0100)))

(assert (not (= expect result)))

(check-sat)
(exit)
