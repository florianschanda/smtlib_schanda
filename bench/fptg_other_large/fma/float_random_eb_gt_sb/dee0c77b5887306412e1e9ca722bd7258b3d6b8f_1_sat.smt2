; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +ZERO
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100111111 #b1010100)
                arg1
                (fp #b1 #b001111001 #b1100110)))
(assert (fp.leq (fp #b1 #b001111001 #b1100110)
                arg1
                (fp #b0 #b010000101 #b0010010)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b101100010 #b1010100)
                arg2
                (fp #b0 #b000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000 #b0000000)
                arg2
                (fp #b0 #b011010010 #b1111101)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100011000 #b1101001)
                arg3
                (fp #b0 #b000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000 #b0100000)
                arg3
                (fp #b0 #b000111100 #b1011000)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011001110 #b0011100)
                expect
                (fp #b0 #b000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000 #b0100000)
                expect
                (fp #b0 #b101001110 #b0110110)))

(assert (= expect result))

(check-sat)
(exit)
