(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1000000110 #b00110)
                arg1
                (fp #b1 #b1000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000101 #b00000)
                arg1
                (fp #b1 #b0100111000 #b11011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0000101001 #b01001)
                arg2
                (fp #b1 #b0000000000 #b10001)))
(assert (fp.leq (fp #b1 #b0000000000 #b10001)
                arg2
                (fp #b0 #b0010110011 #b00001)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101010001 #b10110)
                expect
                (fp #b0 #b0000000110 #b00010)))
(assert (fp.leq (fp #b0 #b0000000110 #b00010)
                expect
                (fp #b0 #b0100110110 #b01111)))

(assert (not (= expect result)))

(check-sat)
(exit)
