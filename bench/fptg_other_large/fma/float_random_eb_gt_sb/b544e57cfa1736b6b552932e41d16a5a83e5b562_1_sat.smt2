(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b00100101111110111 #b00000101)
                arg1
                (fp #b1 #b00001001111001111 #b10001010)))
(assert (fp.leq (fp #b1 #b00001001111001111 #b10001010)
                arg1
                (fp #b1 #b00000000010001101 #b11111111)))

(declare-const arg2 (_ FloatingPoint 17 9))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b00110110001000101 #b10001011)
                arg3
                (fp #b0 #b10000000000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b10000000000001000 #b00000000)
                arg3
                (fp #b0 #b10100000010010101 #b01110111)))

(declare-const result (_ FloatingPoint 17 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b10100000100011101 #b01010111)
                expect
                (fp #b0 #b10000000000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b10000000000001000 #b00000000)
                expect
                (fp #b0 #b10010011100011110 #b00100000)))

(assert (= expect result))

(check-sat)
(exit)
