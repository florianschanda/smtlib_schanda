(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -LARGEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011000110 #b10111)
                arg1
                (fp #b1 #b0010110001 #b10000)))
(assert (fp.leq (fp #b1 #b0010110001 #b10000)
                arg1
                (fp #b0 #b0111000110 #b11101)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111111 #b00000)
                arg2
                (fp #b1 #b1111111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111)
                arg2
                (fp #b1 #b1010000111 #b00100)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1010111111 #b00011)
                arg3
                (fp #b0 #b0000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000)
                arg3
                (fp #b0 #b0011111100 #b00011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011100101 #b11110)
                expect
                (fp #b0 #b1010110001 #b10000)))
(assert (fp.leq (fp #b0 #b1010110001 #b10000)
                expect
                (fp #b0 #b1100011110 #b10001)))

(assert (= expect result))

(check-sat)
(exit)
