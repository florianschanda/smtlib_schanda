; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b0 #b0000111000010 #b10000)
                arg1
                (fp #b0 #b1111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11111)
                arg1
