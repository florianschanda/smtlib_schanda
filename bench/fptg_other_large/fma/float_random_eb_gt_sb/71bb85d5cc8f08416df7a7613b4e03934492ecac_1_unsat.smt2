                (fp #b0 #b0000000000000 #b10101)))
(assert (fp.leq (fp #b0 #b0000000000000 #b10101)
                arg2
                (fp #b0 #b0010011011001 #b00101)))

(declare-const arg3 (_ FloatingPoint 13 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0111010100110 #b10001)
                arg3
                (fp #b1 #b0000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00000)
                arg3
                (fp #b0 #b1011111111111 #b00110)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b0111010011001 #b01111)
                expect
                (fp #b0 #b1000000000000 #b01001)))
(assert (fp.leq (fp #b0 #b1000000000000 #b01001)
                expect
                (fp #b0 #b1010101111101 #b01101)))

(assert (not (= expect result)))

(check-sat)
(exit)
