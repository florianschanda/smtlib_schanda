(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b10000111001 #b1001111)
                arg1
                (fp #b0 #b11111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111111)
                arg1
                (fp #b0 #b11111111111 #b0000000)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10100101110 #b0110011)
                arg2
                (fp #b1 #b10010101000 #b1011000)))
(assert (fp.leq (fp #b1 #b10010101000 #b1011000)
                arg2
                (fp #b0 #b10101110000 #b1010011)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11101110101 #b0100110)
                arg3
                (fp #b0 #b00000000000 #b1000110)))
(assert (fp.leq (fp #b0 #b00000000000 #b1000110)
                arg3
                (fp #b0 #b01101011100 #b1011011)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
