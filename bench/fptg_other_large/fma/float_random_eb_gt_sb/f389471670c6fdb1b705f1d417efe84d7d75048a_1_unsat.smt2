(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b111100010100110 #b0011)
                arg1
                (fp #b1 #b000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000)
                arg1
                (fp #b0 #b111111011011110 #b0100)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b101011011001110 #b1100)
                arg2
                (fp #b0 #b000100101001010 #b0111)))
(assert (fp.leq (fp #b0 #b000100101001010 #b0111)
                arg2
                (fp #b0 #b011111111001010 #b1011)))

(declare-const arg3 (_ FloatingPoint 15 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b100000101100111 #b0000)
                expect
                (fp #b1 #b000100101001010 #b0111)))
(assert (fp.leq (fp #b1 #b000100101001010 #b0111)
                expect
                (fp #b0 #b110000111000010 #b0110)))

(assert (not (= expect result)))

(check-sat)
(exit)
