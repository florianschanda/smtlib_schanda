(assert (fp.leq (fp #b1 #b0110101010100001 #b1001010)
                arg2
                (fp #b0 #b1111110010110010 #b0101001)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1111001000000100 #b0100100)
                arg3
                (fp #b1 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000)
                arg3
                (fp #b0 #b0111100001011110 #b0011111)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0110001010010101 #b1010100)
                expect
                (fp #b1 #b0000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000000)
                expect
                (fp #b0 #b1110111010000000 #b0100100)))

(assert (= expect result))

(check-sat)
(exit)
