(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b111011001001111 #b100000)
                arg1
                (fp #b1 #b100000111100000 #b100100)))
(assert (fp.leq (fp #b1 #b100000111100000 #b100100)
                arg1
                (fp #b0 #b100100001010010 #b001001)))

(declare-const arg2 (_ FloatingPoint 15 7))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 15 7))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b101111010001010 #b111010)
                arg3
                (fp #b0 #b000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000000)
                arg3
                (fp #b0 #b101100100011001 #b001010)))

(declare-const result (_ FloatingPoint 15 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 7))
(assert (fp.leq (fp #b1 #b011101101100001 #b001100)
                expect
                (fp #b0 #b100001111000010 #b001110)))
(assert (fp.leq (fp #b0 #b100001111000010 #b001110)
                expect
                (fp #b0 #b110001100000011 #b101100)))

(assert (not (= expect result)))

(check-sat)
(exit)
