(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b100100010100 #b0011010100)
                arg1
                (fp #b1 #b000000000000 #b1010010101)))
(assert (fp.leq (fp #b1 #b000000000000 #b1010010101)
                arg1
                (fp #b0 #b000110000100 #b0100010101)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b010101101001 #b0101001011)
                arg2
                (fp #b0 #b010001111110 #b1101011101)))
(assert (fp.leq (fp #b0 #b010001111110 #b1101011101)
                arg2
                (fp #b0 #b100100011110 #b1100000001)))

(declare-const arg3 (_ FloatingPoint 12 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b011100101000 #b0110100110)
                expect
                (fp #b0 #b010001111110 #b1101011101)))
(assert (fp.leq (fp #b0 #b010001111110 #b1101011101)
                expect
                (fp #b0 #b101001100011 #b1010010011)))

(assert (not (= expect result)))

(check-sat)
(exit)
