(declare-const arg3 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b01001101001100000 #b0111111)
                arg3
                (fp #b1 #b00000000000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0111011)
                arg3
                (fp #b0 #b00100010001001001 #b1001101)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b11010011111011100 #b1000001)
                expect
                (fp #b1 #b00000000000000000 #b0111100)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0111100)
                expect
                (fp #b0 #b00110000000010100 #b0101011)))

(assert (= expect result))

(check-sat)
(exit)
