(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b01110110101110000 #b0110100)
                arg1
                (fp #b1 #b00000000000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b1111010)
                arg1
