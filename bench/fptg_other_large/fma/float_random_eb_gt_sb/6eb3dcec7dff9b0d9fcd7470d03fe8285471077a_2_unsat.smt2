                (fp #b0 #b11111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111111111)
                arg2
                (fp #b0 #b11111111111111 #b000000000)))

(declare-const arg3 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11100011111010 #b010110111)
                arg3
                (fp #b1 #b11001111110111 #b110011000)))
(assert (fp.leq (fp #b1 #b11001111110111 #b110011000)
                arg3
                (fp #b0 #b10101000111110 #b001100011)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
