(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b10110111110100 #b0111)
                arg1
                (fp #b0 #b10001110000011 #b0100)))
(assert (fp.leq (fp #b0 #b10001110000011 #b0100)
                arg1
                (fp #b0 #b10011100011000 #b0101)))

(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b0 #b11000111100011 #b1011)
                arg2
                (fp #b0 #b11111111111101 #b0000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000)
                arg2
                (fp #b0 #b11111111111110 #b1000)))

(declare-const arg3 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b00111011110001 #b1000)
                arg3
                (fp #b0 #b10000000000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000000000100 #b0000)
                arg3
                (fp #b0 #b10100101010100 #b1001)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
