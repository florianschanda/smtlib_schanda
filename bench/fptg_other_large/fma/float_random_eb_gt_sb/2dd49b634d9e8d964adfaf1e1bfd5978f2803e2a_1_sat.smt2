                (fp #b0 #b01011100101100101 #b111)))
(assert (fp.leq (fp #b0 #b01011100101100101 #b111)
                arg2
                (fp #b0 #b01100010101100011 #b100)))

(declare-const arg3 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11101011101001100 #b111)
                arg3
                (fp #b1 #b10101000101000101 #b010)))
(assert (fp.leq (fp #b1 #b10101000101000101 #b010)
                arg3
                (fp #b0 #b10110110101110110 #b110)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11110110010001100 #b110)
                expect
                (fp #b1 #b10101000101000101 #b001)))
(assert (fp.leq (fp #b1 #b10101000101000101 #b001)
                expect
                (fp #b0 #b10001001111100000 #b111)))

(assert (= expect result))

(check-sat)
(exit)
