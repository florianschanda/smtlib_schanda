(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10001101101 #b10)
                arg1
                (fp #b1 #b10000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000010 #b00)
                arg1
                (fp #b0 #b00001110111 #b01)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b00010100110 #b10)
                arg2
                (fp #b0 #b10100011000 #b01)))
(assert (fp.leq (fp #b0 #b10100011000 #b01)
                arg2
                (fp #b0 #b10111111011 #b10)))

(declare-const arg3 (_ FloatingPoint 11 3))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11110000011 #b10)
                expect
                (fp #b1 #b10100011011 #b00)))
(assert (fp.leq (fp #b1 #b10100011011 #b00)
                expect
                (fp #b0 #b00101001110 #b10)))

(assert (= expect result))

(check-sat)
(exit)
