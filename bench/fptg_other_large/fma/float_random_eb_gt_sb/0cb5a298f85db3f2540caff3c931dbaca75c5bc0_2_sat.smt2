                arg2
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                arg2
                (fp #b1 #b1010111100 #b01011011)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b1110110101 #b00000001)
                arg3
                (fp #b0 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000000)
                arg3
                (fp #b0 #b1111111110 #b10001111)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0110001000 #b10100011)
                expect
                (fp #b0 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000000)
                expect
                (fp #b0 #b1111111110 #b10011011)))

(assert (= expect result))

(check-sat)
(exit)
