; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b010110011100 #b1110000)
                arg1
                (fp #b0 #b000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0000000)
                arg1
                (fp #b0 #b110000110010 #b1111010)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b0 #b100010100111 #b0101001)
                arg2
                (fp #b0 #b111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b0000000)
                arg2
                (fp #b0 #b111111111101 #b1110001)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b100101010001 #b1101111)
                arg3
                (fp #b1 #b010111001011 #b1110001)))
(assert (fp.leq (fp #b1 #b010111001011 #b1110001)
                arg3
                (fp #b0 #b110000000000 #b0100110)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110000000111 #b1110001)
                expect
                (fp #b1 #b010111001011 #b1110001)))
(assert (fp.leq (fp #b1 #b010111001011 #b1110001)
                expect
                (fp #b0 #b101010000010 #b1111100)))

(assert (= expect result))

(check-sat)
(exit)
