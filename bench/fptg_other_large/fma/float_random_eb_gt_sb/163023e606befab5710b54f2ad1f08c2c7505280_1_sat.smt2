                arg2
                (fp #b0 #b1111111111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b00000000000)
                arg2
                (fp #b0 #b1111111111111101 #b00100100101)))

(declare-const arg3 (_ FloatingPoint 16 12))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1100111100001101 #b10010010111)
                arg3
                (fp #b0 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000000)
                arg3
                (fp #b0 #b1011111111000011 #b11111001000)))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1111111111111111 #b00000000000)
                expect
                (fp #b1 #b1111111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b11111111111)
                expect
                (fp #b0 #b0110110100111000 #b11011111110)))

(assert (= expect result))

(check-sat)
(exit)
