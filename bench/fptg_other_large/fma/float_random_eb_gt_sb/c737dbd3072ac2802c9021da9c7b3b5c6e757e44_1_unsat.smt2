; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100100110 #b11)
                arg1
                (fp #b1 #b000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000 #b10)
                arg1
                (fp #b0 #b010000001 #b10)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111111 #b00)
                arg2
                (fp #b1 #b111111110 #b11)))
(assert (fp.leq (fp #b1 #b111111110 #b11)
                arg2
                (fp #b1 #b101100111 #b00)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
