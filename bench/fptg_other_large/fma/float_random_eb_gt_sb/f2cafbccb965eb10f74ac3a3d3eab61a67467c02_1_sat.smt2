; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -INFINITY
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1000001100001011 #b1011)
                arg1
                (fp #b1 #b0101000000000100 #b1100)))
(assert (fp.leq (fp #b1 #b0101000000000100 #b1100)
                arg1
                (fp #b0 #b1001100011100110 #b1010)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0101110110001110 #b1110)
                arg3
                (fp #b0 #b0000000000000000 #b0010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0010)
                arg3
                (fp #b0 #b0100111110001110 #b1001)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
