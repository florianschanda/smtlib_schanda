(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111110 #b0011)
                arg1
                (fp #b1 #b1111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111101 #b0000)
                arg1
                (fp #b1 #b1111111011 #b0110)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111100110 #b0100)
                arg2
                (fp #b1 #b0000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100)
                arg2
                (fp #b0 #b0001101010 #b1101)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1000000101 #b1001)
                arg3
                (fp #b1 #b0000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100)
                arg3
                (fp #b0 #b0010000010 #b1000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0001001011 #b0011)
                expect
                (fp #b0 #b0111111100 #b1111)))
(assert (fp.leq (fp #b0 #b0111111100 #b1111)
                expect
                (fp #b0 #b1111001000 #b1001)))

(assert (not (= expect result)))

(check-sat)
(exit)
