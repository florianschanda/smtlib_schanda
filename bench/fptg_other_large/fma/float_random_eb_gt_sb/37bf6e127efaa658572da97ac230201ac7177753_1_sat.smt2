(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +INFINITY
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100001111 #b1110)
                arg1
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg1
                (fp #b0 #b101000001 #b0011)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111010001 #b1111)
                arg3
                (fp #b1 #b100000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000100 #b0000)
                arg3
                (fp #b0 #b011101110 #b0001)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
