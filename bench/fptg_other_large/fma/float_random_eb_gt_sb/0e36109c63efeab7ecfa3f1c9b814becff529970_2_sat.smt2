(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0000010101 #b00)
                arg1
                (fp #b0 #b1111111101 #b00)))
(assert (fp.leq (fp #b0 #b1111111101 #b00)
                arg1
                (fp #b0 #b1111111110 #b01)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0111001010 #b01)
                arg2
                (fp #b0 #b0000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000 #b01)
                arg2
                (fp #b0 #b0111010111 #b11)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0010000001 #b00)
                arg3
                (fp #b1 #b0000000000 #b01)))
(assert (fp.leq (fp #b1 #b0000000000 #b01)
                arg3
                (fp #b0 #b1000111010 #b00)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0011011100 #b10)
                expect
                (fp #b0 #b0111111101 #b00)))
(assert (fp.leq (fp #b0 #b0111111101 #b00)
                expect
                (fp #b0 #b1010010111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
