(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b010100000110100 #b111010110)
                arg1
                (fp #b1 #b000000000000000 #b100100111)))
(assert (fp.leq (fp #b1 #b000000000000000 #b100100111)
                arg1
                (fp #b0 #b000110100100000 #b110100010)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b111111111111110 #b010001001)
                arg3
                (fp #b1 #b111111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000000000)
                arg3
                (fp #b1 #b111010111111101 #b100010011)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b111111111111101 #b101001110)
                expect
                (fp #b1 #b111111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b000000000)
                expect
                (fp #b1 #b100001110110000 #b110111001)))

(assert (= expect result))

(check-sat)
(exit)
