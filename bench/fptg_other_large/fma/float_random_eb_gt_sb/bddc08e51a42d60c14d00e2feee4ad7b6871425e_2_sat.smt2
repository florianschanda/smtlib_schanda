(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b0 #b0111000001000 #b1000)
                arg1
                (fp #b0 #b1000111110100 #b0110)))
(assert (fp.leq (fp #b0 #b1000111110100 #b0110)
                arg1
                (fp #b0 #b1101001010110 #b1100)))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 13 5))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1010011110000 #b0011)
                expect
                (fp #b1 #b1001111101001 #b1111)))
(assert (fp.leq (fp #b1 #b1001111101001 #b1111)
                expect
                (fp #b1 #b1001000011000 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
