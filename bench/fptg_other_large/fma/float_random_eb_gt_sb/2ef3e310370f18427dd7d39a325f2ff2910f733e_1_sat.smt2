(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0011101001010 #b111)
                arg1
                (fp #b0 #b1111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111101 #b000)
                arg1
                (fp #b0 #b1111111111110 #b011)))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111111111111 #b000)
                arg2
                (fp #b1 #b1111111111110 #b111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b111)
                arg2
                (fp #b1 #b0011110011000 #b111)))

(declare-const arg3 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0001110001000 #b111)
                arg3
                (fp #b0 #b0000000000000 #b101)))
(assert (fp.leq (fp #b0 #b0000000000000 #b101)
                arg3
                (fp #b0 #b1001100100100 #b001)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1111111111111 #b000)
                expect
                (fp #b1 #b1111111111110 #b111)))
(assert (fp.leq (fp #b1 #b1111111111110 #b111)
                expect
                (fp #b1 #b0100010011011 #b010)))

(assert (= expect result))

(check-sat)
(exit)
