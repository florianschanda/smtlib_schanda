(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1000101101111011 #b0110000001101)
                arg1
                (fp #b1 #b1000000000001101 #b0000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001101 #b0000000000000)
                arg1
                (fp #b0 #b0001111001100001 #b1100111101111)))

(declare-const arg2 (_ FloatingPoint 16 14))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 14))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
