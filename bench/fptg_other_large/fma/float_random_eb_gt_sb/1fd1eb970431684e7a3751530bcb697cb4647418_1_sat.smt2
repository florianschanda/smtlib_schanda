(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110011111000 #b0000110)
                arg1
                (fp #b1 #b101001001101 #b1001101)))
(assert (fp.leq (fp #b1 #b101001001101 #b1001101)
                arg1
                (fp #b0 #b010000001000 #b0001011)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111101001011 #b0000010)
                arg2
                (fp #b1 #b001011010011 #b0110011)))
(assert (fp.leq (fp #b1 #b001011010011 #b0110011)
                arg2
                (fp #b0 #b011111011100 #b1011101)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000000101110 #b0100100)
                arg3
                (fp #b1 #b000000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b000000000000 #b0111011)
                arg3
                (fp #b0 #b000101100000 #b1100100)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b000100100011 #b0111100)
                expect
                (fp #b0 #b010100100010 #b0001111)))
(assert (fp.leq (fp #b0 #b010100100010 #b0001111)
                expect
                (fp #b0 #b011100011010 #b0101001)))

(assert (= expect result))

(check-sat)
(exit)
