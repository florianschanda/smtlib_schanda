(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111110111111111 #b100)
                arg1
                (fp #b1 #b010111011010111 #b101)))
(assert (fp.leq (fp #b1 #b010111011010111 #b101)
                arg1
                (fp #b1 #b010010101000110 #b111)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b000110110111101 #b111)
                arg2
                (fp #b1 #b000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000000 #b010)
                arg2
                (fp #b0 #b010110010100110 #b010)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b100111110010010 #b010)
                arg3
                (fp #b0 #b111111111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b111)
                arg3
                (fp #b0 #b111111111111111 #b000)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b0 #b111111010111010 #b011)
                expect
                (fp #b0 #b111111111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b111)
                expect
                (fp #b0 #b111111111111111 #b000)))

(assert (= expect result))

(check-sat)
(exit)
