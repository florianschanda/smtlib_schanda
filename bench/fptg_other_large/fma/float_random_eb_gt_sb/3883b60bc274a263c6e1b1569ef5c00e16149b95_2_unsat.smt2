; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11011011110100 #b000)
                arg1
                (fp #b1 #b10110001111111 #b000)))
(assert (fp.leq (fp #b1 #b10110001111111 #b000)
                arg1
                (fp #b0 #b00001001001011 #b010)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01001010101011 #b010)
                arg2
                (fp #b0 #b00000000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010)
                arg2
                (fp #b0 #b01111101101000 #b011)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111110 #b011)
                arg3
                (fp #b1 #b11111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000)
                arg3
                (fp #b1 #b11100001000000 #b110)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111101 #b100)
                expect
                (fp #b1 #b11111111111101 #b001)))
(assert (fp.leq (fp #b1 #b11111111111101 #b001)
                expect
                (fp #b0 #b11100001110010 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
