(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10100000101000 #b1101010)
                arg1
                (fp #b0 #b00000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0100000)
                arg1
                (fp #b0 #b10001010010010 #b1111000)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000000)
                arg3
                (fp #b1 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111111)
                arg3
                (fp #b1 #b10111100110110 #b0000111)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
