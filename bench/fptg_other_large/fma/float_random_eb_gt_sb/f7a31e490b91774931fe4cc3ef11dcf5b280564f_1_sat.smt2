(declare-const arg3 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b0 #b001111111111010 #b01101101010)
                arg3
                (fp #b0 #b010110010001011 #b01010101100)))
(assert (fp.leq (fp #b0 #b010110010001011 #b01010101100)
                arg3
                (fp #b0 #b111101101100100 #b00100100000)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b110111100001111 #b01001101101)
                expect
                (fp #b0 #b010110010001011 #b01010101100)))
(assert (fp.leq (fp #b0 #b010110010001011 #b01010101100)
                expect
                (fp #b0 #b111101111011001 #b10101101010)))

(assert (= expect result))

(check-sat)
(exit)
