(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 12))
(assert (fp.leq (fp #b1 #b010111010101100 #b01111001001)
                arg1
                (fp #b0 #b001000010101111 #b00100111101)))
(assert (fp.leq (fp #b0 #b001000010101111 #b00100111101)
                arg1
