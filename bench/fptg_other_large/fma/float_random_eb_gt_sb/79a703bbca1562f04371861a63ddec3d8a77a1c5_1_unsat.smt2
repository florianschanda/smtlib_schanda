; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01011000100101 #b1011100)
                arg2
                (fp #b0 #b01100001000101 #b0000000)))
(assert (fp.leq (fp #b0 #b01100001000101 #b0000000)
                arg2
                (fp #b0 #b11000111000100 #b1100111)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10110100000101 #b0110001)
                arg3
                (fp #b0 #b10000000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000000000111 #b0000000)
                arg3
                (fp #b0 #b10110100011111 #b0101111)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
