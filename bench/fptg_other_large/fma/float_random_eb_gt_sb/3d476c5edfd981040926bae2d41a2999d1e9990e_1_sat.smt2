(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11111111111111 #b0)
                arg1
                (fp #b1 #b11111111111110 #b1)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1)
                arg1
                (fp #b0 #b01001011110100 #b0)))

(declare-const arg2 (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b0 #b00000111110001 #b0)
                arg2
                (fp #b0 #b11111111111110 #b1)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1)
                arg2
                (fp #b0 #b11111111111111 #b0)))

(declare-const arg3 (_ FloatingPoint 14 2))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10101000001101 #b0)
                arg3
                (fp #b1 #b00000000000000 #b0)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0)
                arg3
                (fp #b0 #b10110100010100 #b1)))

(declare-const result (_ FloatingPoint 14 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 2))
(assert (fp.leq (fp #b1 #b11111111111111 #b0)
                expect
                (fp #b1 #b11111111111110 #b1)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1)
                expect
                (fp #b1 #b10100001100110 #b1)))

(assert (= expect result))

(check-sat)
(exit)
