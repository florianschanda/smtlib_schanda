(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10111011010 #b110)
                arg1
                (fp #b1 #b00000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000 #b010)
                arg1
                (fp #b0 #b11001010111 #b011)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111010001 #b101)
                arg2
                (fp #b0 #b01001010110 #b111)))
(assert (fp.leq (fp #b0 #b01001010110 #b111)
                arg2
                (fp #b0 #b10010000000 #b000)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b10111000100 #b000)
                arg3
                (fp #b0 #b11111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111)
                arg3
                (fp #b0 #b11111111111 #b000)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01111101011 #b000)
                expect
                (fp #b0 #b11111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111)
                expect
                (fp #b0 #b11111111111 #b000)))

(assert (= expect result))

(check-sat)
(exit)
