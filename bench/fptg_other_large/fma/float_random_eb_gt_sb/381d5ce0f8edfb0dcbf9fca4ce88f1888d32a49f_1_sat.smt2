(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001010001 #b111011)
                arg1
                (fp #b1 #b000000000 #b000000)))
(assert (fp.leq (fp #b1 #b000000000 #b000000)
                arg1
                (fp #b0 #b100101100 #b111011)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100101111 #b111100)
                arg2
                (fp #b1 #b100101001 #b111110)))
(assert (fp.leq (fp #b1 #b100101001 #b111110)
                arg2
                (fp #b0 #b110010110 #b011010)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101000010 #b100100)
                arg3
                (fp #b0 #b100000110 #b000000)))
(assert (fp.leq (fp #b0 #b100000110 #b000000)
                arg3
                (fp #b0 #b101100111 #b001001)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111001001 #b001101)
                expect
                (fp #b0 #b100000110 #b000000)))
(assert (fp.leq (fp #b0 #b100000110 #b000000)
                expect
                (fp #b0 #b100001100 #b110111)))

(assert (= expect result))

(check-sat)
(exit)
