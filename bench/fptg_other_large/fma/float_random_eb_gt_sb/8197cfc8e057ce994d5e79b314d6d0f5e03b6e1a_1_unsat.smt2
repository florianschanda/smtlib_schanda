; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101101101 #b0101)
                arg1
                (fp #b1 #b0110110000 #b1000)))
(assert (fp.leq (fp #b1 #b0110110000 #b1000)
                arg1
                (fp #b0 #b0100111100 #b1111)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1110011100 #b1101)
                arg3
                (fp #b1 #b1101110000 #b1001)))
(assert (fp.leq (fp #b1 #b1101110000 #b1001)
                arg3
                (fp #b0 #b0101001001 #b0111)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
