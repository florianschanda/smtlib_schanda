(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0101011100000000 #b0001)
                arg1
                (fp #b1 #b0000000000000000 #b0011)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0011)
                arg1
                (fp #b0 #b1101110100001100 #b1101)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0100001110010110 #b0010)
                arg2
                (fp #b0 #b1000000110111010 #b1111)))
(assert (fp.leq (fp #b0 #b1000000110111010 #b1111)
                arg2
                (fp #b0 #b1011111110110011 #b1010)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1011110111000101 #b0110)
                expect
                (fp #b1 #b1000000110111011 #b0000)))
(assert (fp.leq (fp #b1 #b1000000110111011 #b0000)
                expect
                (fp #b0 #b1001111110010011 #b0111)))

(assert (= expect result))

(check-sat)
(exit)
