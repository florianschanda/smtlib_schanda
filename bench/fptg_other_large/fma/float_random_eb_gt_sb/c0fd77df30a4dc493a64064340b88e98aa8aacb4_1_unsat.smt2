(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0000000011 #b000)
                arg1
                (fp #b0 #b0000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000)
                arg1
                (fp #b0 #b0111001101 #b011)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0001011100 #b101)
                arg2
                (fp #b0 #b1111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000)
                arg2
                (fp #b0 #b1111111110 #b010)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1101000000 #b100)
                arg3
                (fp #b0 #b0000000000 #b101)))
(assert (fp.leq (fp #b0 #b0000000000 #b101)
                arg3
                (fp #b0 #b0110101000 #b000)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0100110110 #b110)
                expect
                (fp #b0 #b0000000000 #b101)))
(assert (fp.leq (fp #b0 #b0000000000 #b101)
                expect
                (fp #b0 #b0111011011 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
