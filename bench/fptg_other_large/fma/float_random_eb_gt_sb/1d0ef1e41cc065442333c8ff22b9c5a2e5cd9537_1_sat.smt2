; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b111001100101101 #b1101001)
                arg1
                (fp #b0 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0000000)
                arg1
                (fp #b0 #b001000001011000 #b0001110)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101000000111100 #b1010111)
                arg2
                (fp #b1 #b000000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1101110)
                arg2
                (fp #b0 #b010101110101110 #b0010101)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b000100010011001 #b0101111)
                arg3
                (fp #b1 #b000000000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0111011)
                arg3
                (fp #b0 #b010101001001111 #b0001100)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111010000001100 #b0111101)
                expect
                (fp #b1 #b000000000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0111011)
                expect
                (fp #b0 #b001010111100101 #b0010101)))

(assert (= expect result))

(check-sat)
(exit)
