(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +ZERO
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0101001011001100 #b00)
                arg2
                (fp #b0 #b0000000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00)
                arg2
                (fp #b0 #b1001100010000011 #b00)))

(declare-const arg3 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b0 #b0101110001001110 #b00)
                arg3
                (fp #b0 #b1111111111111110 #b11)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11)
                arg3
                (fp #b0 #b1111111111111111 #b00)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
