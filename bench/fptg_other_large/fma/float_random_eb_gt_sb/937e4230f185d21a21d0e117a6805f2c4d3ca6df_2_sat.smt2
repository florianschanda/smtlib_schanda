(assert (fp.leq (fp #b1 #b0000000000000000 #b0111011)
                arg3
                (fp #b0 #b1010010101101001 #b0010100)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1010110111000010 #b0111001)
                expect
