; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +INFINITY
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101011110 #b11100)
                arg1
                (fp #b1 #b0000000000 #b00111)))
(assert (fp.leq (fp #b1 #b0000000000 #b00111)
                arg1
                (fp #b0 #b1000111011 #b01111)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0111110111 #b11011)
                arg3
                (fp #b0 #b0000000000 #b10111)))
(assert (fp.leq (fp #b0 #b0000000000 #b10111)
                arg3
                (fp #b0 #b0101001100 #b10111)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
