(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0100100001 #b000001)
                arg2
                (fp #b0 #b1000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000110 #b000000)
                arg2
                (fp #b0 #b1100000000 #b010110)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0000010101 #b010011)
                arg3
                (fp #b0 #b0110111001 #b010010)))
(assert (fp.leq (fp #b0 #b0110111001 #b010010)
                arg3
                (fp #b0 #b0111010011 #b100100)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
