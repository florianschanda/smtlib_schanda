                (fp #b1 #b0001011001110111 #b0101111011)))
(assert (fp.leq (fp #b1 #b0001011001110111 #b0101111011)
                arg3
                (fp #b0 #b1100111001111111 #b1101111101)))

(declare-const result (_ FloatingPoint 16 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

