(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111100100 #b0010100)
                arg1
                (fp #b1 #b0111000100 #b0011101)))
(assert (fp.leq (fp #b1 #b0111000100 #b0011101)
                arg1
                (fp #b0 #b0000100110 #b1001111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0000011101 #b0101010)
                arg2
                (fp #b1 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100000)
                arg2
                (fp #b0 #b1011110101 #b1110010)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0111011000 #b1001100)
                arg3
                (fp #b0 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0100000)
                arg3
                (fp #b0 #b0101001110 #b0110010)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010000110 #b0101101)
                expect
                (fp #b0 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0100000)
                expect
                (fp #b0 #b0100010011 #b0011101)))

(assert (not (= expect result)))

(check-sat)
(exit)
