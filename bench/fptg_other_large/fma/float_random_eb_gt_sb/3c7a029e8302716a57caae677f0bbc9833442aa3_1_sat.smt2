(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011011100 #b1001)
                arg1
                (fp #b0 #b1000000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000000100 #b0000)
                arg1
                (fp #b0 #b1011011111 #b0101)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0001000100 #b0110)
                arg2
                (fp #b0 #b0000000000 #b0111)))
(assert (fp.leq (fp #b0 #b0000000000 #b0111)
                arg2
                (fp #b0 #b0101010011 #b0110)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0000100011 #b1001)
                arg3
                (fp #b1 #b0000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100)
                arg3
                (fp #b0 #b1010010100 #b1000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0111011100 #b0001)
                expect
                (fp #b0 #b0000000100 #b1011)))
(assert (fp.leq (fp #b0 #b0000000100 #b1011)
                expect
                (fp #b0 #b1101010101 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
