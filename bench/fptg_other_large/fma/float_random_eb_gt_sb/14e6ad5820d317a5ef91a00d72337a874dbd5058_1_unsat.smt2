                (fp #b0 #b000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000 #b0100000)
                arg2
                (fp #b0 #b101111100 #b0011100)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111011111 #b1101110)
                arg3
                (fp #b1 #b000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b000000000 #b0100000)
                arg3
                (fp #b0 #b101100101 #b0010111)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111110101 #b1011111)
                expect
                (fp #b1 #b000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b000000000 #b0100000)
                expect
                (fp #b0 #b000111110 #b1111001)))

(assert (not (= expect result)))

(check-sat)
(exit)
