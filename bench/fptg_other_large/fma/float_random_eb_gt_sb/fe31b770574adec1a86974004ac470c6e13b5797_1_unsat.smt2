(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111111 #b000)
                arg1
                (fp #b1 #b111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111110 #b111)
                arg1
                (fp #b0 #b110111111 #b100)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111101111 #b011)
                arg2
                (fp #b1 #b111011100 #b011)))
(assert (fp.leq (fp #b1 #b111011100 #b011)
                arg2
                (fp #b0 #b110110111 #b001)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101111110 #b010)
                expect
                (fp #b0 #b111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111110 #b111)
                expect
                (fp #b0 #b111111111 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
