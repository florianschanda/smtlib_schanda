(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +INFINITY
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b111111110 #b011111)
                arg1
                (fp #b1 #b111111101 #b000000)))
(assert (fp.leq (fp #b1 #b111111101 #b000000)
                arg1
                (fp #b0 #b000101110 #b010000)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
