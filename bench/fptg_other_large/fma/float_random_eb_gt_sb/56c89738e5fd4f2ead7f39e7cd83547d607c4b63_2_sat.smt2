(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1111011110101000 #b10010110)
                arg1
                (fp #b1 #b1110111101000000 #b00011011)))
(assert (fp.leq (fp #b1 #b1110111101000000 #b00011011)
                arg1
                (fp #b0 #b0111111100010101 #b00010010)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b0 #b1111010010011000 #b11001111)
                arg2
                (fp #b0 #b1111111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111)
                arg2
                (fp #b0 #b1111111111111111 #b00000000)))

(declare-const arg3 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0000101101000010 #b01101111)
                arg3
                (fp #b0 #b0110000101010000 #b11010001)))
(assert (fp.leq (fp #b0 #b0110000101010000 #b11010001)
                arg3
                (fp #b0 #b0110001110010001 #b11000010)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
