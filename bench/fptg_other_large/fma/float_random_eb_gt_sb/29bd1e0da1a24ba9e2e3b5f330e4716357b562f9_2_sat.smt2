                arg2
                (fp #b0 #b000000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b01)
                arg2
                (fp #b0 #b011001011010110001 #b10)))

(declare-const arg3 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b100110111011110101 #b00)
                arg3
                (fp #b1 #b100000000000000010 #b00)))
(assert (fp.leq (fp #b1 #b100000000000000010 #b00)
                arg3
                (fp #b1 #b000100010011111001 #b00)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b111011001010001100 #b00)
                expect
                (fp #b1 #b100000000000000010 #b00)))
(assert (fp.leq (fp #b1 #b100000000000000010 #b00)
                expect
                (fp #b0 #b101101110000100011 #b10)))

(assert (= expect result))

(check-sat)
(exit)
