(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000000)
                arg1
                (fp #b1 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111111)
                arg1
                (fp #b0 #b11111000101101 #b1000111)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01110010011010 #b1000100)
                arg2
                (fp #b1 #b00000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1101110)
                arg2
                (fp #b0 #b00100110111011 #b0111010)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
