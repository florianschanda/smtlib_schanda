(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001000101 #b010)
                arg1
                (fp #b0 #b0000000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000000 #b110)
                arg1
                (fp #b0 #b1001011001 #b011)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000110110 #b011)
                arg3
                (fp #b1 #b1000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000011 #b000)
                arg3
                (fp #b1 #b0100110011 #b110)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1011110000 #b110)
                expect
                (fp #b1 #b1000000010 #b111)))
(assert (fp.leq (fp #b1 #b1000000010 #b111)
                expect
                (fp #b0 #b0101110010 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
