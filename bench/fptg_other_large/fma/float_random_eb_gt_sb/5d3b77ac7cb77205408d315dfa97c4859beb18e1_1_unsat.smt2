; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111110 #b11001)
                arg1
                (fp #b1 #b11111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000)
                arg1
                (fp #b0 #b01000010101 #b01100)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10010011110 #b11100)
                arg2
                (fp #b1 #b00000000000 #b10001)))
(assert (fp.leq (fp #b1 #b00000000000 #b10001)
                arg2
                (fp #b0 #b01000110000 #b01111)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11001010111 #b10000)
                expect
                (fp #b0 #b01111111110 #b00001)))
(assert (fp.leq (fp #b0 #b01111111110 #b00001)
                expect
                (fp #b0 #b11011101011 #b10011)))

(assert (not (= expect result)))

(check-sat)
(exit)
