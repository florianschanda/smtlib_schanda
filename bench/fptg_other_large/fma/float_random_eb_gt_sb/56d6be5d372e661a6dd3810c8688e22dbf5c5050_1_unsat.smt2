(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +NAN
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 13))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 13))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 15 13))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b010100110001100 #b101100111000)
                arg3
                (fp #b0 #b000000000000000 #b000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b000000000000)
                arg3
                (fp #b0 #b010011000000101 #b010010111100)))

(declare-const result (_ FloatingPoint 15 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 13))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
