(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110111100101010 #b101001000)
                arg1
                (fp #b1 #b000000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b000000000)
                arg1
                (fp #b0 #b100011100100101 #b100001111)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b001010010111111 #b111110111)
                arg2
                (fp #b0 #b000000000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b010000000)
                arg2
                (fp #b0 #b000010100000100 #b001001110)))

(declare-const arg3 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b010100001100001 #b010011100)
                arg3
                (fp #b0 #b000000000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b000000000000000 #b001100101)
                arg3
                (fp #b0 #b001011011001110 #b101111110)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b010011011101010 #b111000111)
                expect
                (fp #b0 #b000000000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b000000000000000 #b001100101)
                expect
                (fp #b0 #b010010101101001 #b001110010)))

(assert (= expect result))

(check-sat)
(exit)
