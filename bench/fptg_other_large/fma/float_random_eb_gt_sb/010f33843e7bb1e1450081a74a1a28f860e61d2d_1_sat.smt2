; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b010010001111000111 #b101)
                arg1
                (fp #b1 #b000000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b010)
                arg1
                (fp #b0 #b111111101000000101 #b111)))

(declare-const arg2 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b111100101011101100 #b110)
                arg2
                (fp #b1 #b110011101000111101 #b001)))
(assert (fp.leq (fp #b1 #b110011101000111101 #b001)
                arg2
                (fp #b1 #b001111100100011111 #b010)))

(declare-const arg3 (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b1 #b001011011000010100 #b101)
                arg3
                (fp #b0 #b111111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b000)
                arg3
                (fp #b0 #b111111111111111111 #b000)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b100111001010001000 #b111)
                expect
                (fp #b0 #b111111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b000)
                expect
                (fp #b0 #b111111111111111110 #b010)))

(assert (= expect result))

(check-sat)
(exit)
