(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11010110110 #b0011)
                arg1
                (fp #b0 #b01101101001 #b0100)))
(assert (fp.leq (fp #b0 #b01101101001 #b0100)
                arg1
                (fp #b0 #b11100110100 #b1101)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111111 #b0000)
                arg3
                (fp #b1 #b11111111110 #b1111)))
(assert (fp.leq (fp #b1 #b11111111110 #b1111)
                arg3
                (fp #b0 #b10000010111 #b0000)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111111 #b0000)
                expect
                (fp #b1 #b11111111110 #b1110)))
(assert (fp.leq (fp #b1 #b11111111110 #b1110)
                expect
                (fp #b1 #b11111101111 #b0010)))

(assert (not (= expect result)))

(check-sat)
(exit)
