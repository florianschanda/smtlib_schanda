(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000111111 #b011)
                arg1
                (fp #b0 #b101011111 #b101)))
(assert (fp.leq (fp #b0 #b101011111 #b101)
                arg1
                (fp #b0 #b110000010 #b101)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010011110 #b001)
                arg2
                (fp #b1 #b000101100 #b111)))
(assert (fp.leq (fp #b1 #b000101100 #b111)
                arg2
                (fp #b0 #b001110101 #b110)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
