; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b1 #b11101001101101001 #b0110110)
                arg2
                (fp #b1 #b00110011101101110 #b0110010)))
(assert (fp.leq (fp #b1 #b00110011101101110 #b0110010)
                arg2
                (fp #b0 #b01000001111110000 #b1100110)))

(declare-const arg3 (_ FloatingPoint 17 8))
(assert (fp.leq (fp #b0 #b11110110000000000 #b1110010)
                arg3
                (fp #b0 #b11111111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111111111111101 #b0000000)
                arg3
                (fp #b0 #b11111111111111101 #b0001101)))

(declare-const result (_ FloatingPoint 17 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
