(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00000110110 #b111110001)
                arg1
                (fp #b1 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000000)
                arg1
                (fp #b0 #b10011001101 #b100100111)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00111010101 #b101111001)
                arg2
                (fp #b0 #b11111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111111111)
                arg2
                (fp #b0 #b11111111111 #b000000000)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b0 #b00110001010 #b110001100)
                arg3
                (fp #b0 #b10110011001 #b011100100)))
(assert (fp.leq (fp #b0 #b10110011001 #b011100100)
                arg3
                (fp #b0 #b11111000011 #b100110011)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b00000110000 #b001011101)
                expect
                (fp #b0 #b10110011001 #b011100100)))
(assert (fp.leq (fp #b0 #b10110011001 #b011100100)
                expect
                (fp #b0 #b11011100000 #b101100011)))

(assert (= expect result))

(check-sat)
(exit)
