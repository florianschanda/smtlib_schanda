(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00010001000 #b1011)
                arg1
                (fp #b0 #b10000000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000000100 #b0000)
                arg1
                (fp #b0 #b10010010100 #b0100)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11000111100 #b0100)
                arg2
                (fp #b1 #b00111010101 #b1000)))
(assert (fp.leq (fp #b1 #b00111010101 #b1000)
                arg2
                (fp #b0 #b10010000000 #b0111)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111110 #b1000)
                arg3
                (fp #b1 #b11111111101 #b0000)))
(assert (fp.leq (fp #b1 #b11111111101 #b0000)
                arg3
                (fp #b0 #b11000010000 #b1110)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11111111101 #b1101)
                expect
                (fp #b1 #b11111111101 #b0001)))
(assert (fp.leq (fp #b1 #b11111111101 #b0001)
                expect
                (fp #b1 #b10100001010 #b0011)))

(assert (= expect result))

(check-sat)
(exit)
