(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b00100111110101 #b101)
                arg1
                (fp #b1 #b00011111111011 #b110)))
(assert (fp.leq (fp #b1 #b00011111111011 #b110)
                arg1
                (fp #b0 #b01011011011110 #b100)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111111 #b000)
                arg2
                (fp #b1 #b11111111111110 #b111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111)
                arg2
                (fp #b1 #b01010111010110 #b100)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b10011111111010 #b011)
                arg3
                (fp #b0 #b11000110000010 #b101)))
(assert (fp.leq (fp #b0 #b11000110000010 #b101)
                arg3
                (fp #b0 #b11111110101101 #b101)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11110000011100 #b011)
                expect
                (fp #b0 #b11000110000010 #b101)))
(assert (fp.leq (fp #b0 #b11000110000010 #b101)
                expect
                (fp #b0 #b11011110010110 #b000)))

(assert (= expect result))

(check-sat)
(exit)
