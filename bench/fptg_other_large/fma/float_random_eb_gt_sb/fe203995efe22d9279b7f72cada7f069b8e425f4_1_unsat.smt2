(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000)
                arg1
                (fp #b1 #b1111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111)
                arg1
                (fp #b0 #b1101101101011110 #b110001)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b0 #b1100001100111111 #b011011)
                arg3
                (fp #b0 #b1111111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000)
                arg3
                (fp #b0 #b1111111111111110 #b000111)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
