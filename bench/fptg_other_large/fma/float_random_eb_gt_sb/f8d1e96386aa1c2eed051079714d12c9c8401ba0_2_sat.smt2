;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10101011011 #b00100)
                arg1
                (fp #b0 #b00000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000)
                arg1
                (fp #b0 #b10110100100 #b10010)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00111011010 #b00100)
                arg2
                (fp #b1 #b00000011011 #b01110)))
(assert (fp.leq (fp #b1 #b00000011011 #b01110)
                arg2
                (fp #b0 #b10100110110 #b11101)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b11100001111 #b01000)
                arg3
                (fp #b0 #b00000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000 #b00000)
                arg3
                (fp #b0 #b00110000111 #b10110)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b00101001111 #b11101)
                expect
                (fp #b1 #b00000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000)
                expect
                (fp #b0 #b01110000010 #b10101)))

(assert (= expect result))

(check-sat)
(exit)
