(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111000 #b10001)
                arg1
                (fp #b1 #b1000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000101 #b00000)
                arg1
                (fp #b0 #b1010101001 #b11011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011100100 #b10011)
                arg2
                (fp #b1 #b0000000000 #b01000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000)
                arg2
                (fp #b0 #b0011111001 #b01110)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111110 #b10111)
                arg3
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                arg3
                (fp #b0 #b1011000111 #b01110)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111101 #b00001)
                expect
                (fp #b1 #b1111111101 #b00000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000)
                expect
                (fp #b0 #b0100010101 #b00101)))

(assert (not (= expect result)))

(check-sat)
(exit)
