(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b001100111110000 #b110)
                arg1
                (fp #b1 #b000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000000000 #b010)
                arg1
                (fp #b0 #b010001111100111 #b111)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b011100011111100 #b011)
                arg2
                (fp #b1 #b001110010011111 #b110)))
(assert (fp.leq (fp #b1 #b001110010011111 #b110)
                arg2
                (fp #b0 #b111111111100001 #b001)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b000010101000110 #b110)
                expect
                (fp #b0 #b001110010011111 #b110)))
(assert (fp.leq (fp #b0 #b001110010011111 #b110)
                expect
                (fp #b0 #b111000110000101 #b010)))

(assert (= expect result))

(check-sat)
(exit)
