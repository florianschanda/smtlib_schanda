; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011111111 #b01101)
                arg1
                (fp #b1 #b001011001 #b00111)))
(assert (fp.leq (fp #b1 #b001011001 #b00111)
                arg1
                (fp #b1 #b001010011 #b01001)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100001011 #b10111)
                arg2
                (fp #b1 #b000000000 #b10001)))
(assert (fp.leq (fp #b1 #b000000000 #b10001)
                arg2
                (fp #b0 #b000110101 #b01011)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111101 #b10011)
                arg3
                (fp #b1 #b111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000)
                arg3
                (fp #b0 #b101100001 #b01011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111101 #b00001)
                expect
                (fp #b1 #b111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000)
                expect
                (fp #b1 #b110110011 #b00100)))

(assert (not (= expect result)))

(check-sat)
(exit)
