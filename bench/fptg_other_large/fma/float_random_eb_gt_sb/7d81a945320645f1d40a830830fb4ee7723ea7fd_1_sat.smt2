(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11001111000000 #b0001111)
                arg2
                (fp #b0 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111)
                arg2
                (fp #b0 #b11111111111111 #b0000000)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b00001001111100 #b1110101)
                arg3
                (fp #b0 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111)
                arg3
                (fp #b0 #b11111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
