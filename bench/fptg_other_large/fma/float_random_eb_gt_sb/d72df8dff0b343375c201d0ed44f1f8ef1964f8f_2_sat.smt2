(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                arg1
                (fp #b1 #b111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111)
                arg1
                (fp #b0 #b110011011 #b00011)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100000010 #b00000)
                arg2
                (fp #b0 #b000000000 #b10101)))
(assert (fp.leq (fp #b0 #b000000000 #b10101)
                arg2
                (fp #b0 #b010101101 #b11110)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b011101001 #b11001)
                arg3
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg3
                (fp #b0 #b101011011 #b00011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b010110011 #b11001)
                expect
                (fp #b0 #b100000100 #b11110)))
(assert (fp.leq (fp #b0 #b100000100 #b11110)
                expect
                (fp #b0 #b101011010 #b11111)))

(assert (= expect result))

(check-sat)
(exit)
