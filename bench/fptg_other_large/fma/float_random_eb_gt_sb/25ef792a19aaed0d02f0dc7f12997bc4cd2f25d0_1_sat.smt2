(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0000100110 #b0001)
                arg1
                (fp #b0 #b0111100111 #b1100)))
(assert (fp.leq (fp #b0 #b0111100111 #b1100)
                arg1
                (fp #b0 #b1111011110 #b1100)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0000100110 #b1001)
                arg3
                (fp #b0 #b1111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111)
                arg3
                (fp #b0 #b1111111111 #b0000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1101010011 #b1110)
                expect
                (fp #b0 #b1111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111)
                expect
                (fp #b0 #b1111111111 #b0000)))

(assert (= expect result))

(check-sat)
(exit)
