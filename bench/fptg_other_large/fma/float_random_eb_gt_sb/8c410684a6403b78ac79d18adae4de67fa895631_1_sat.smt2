(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000)
                arg2
                (fp #b1 #b1111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111)
                arg2
                (fp #b1 #b1000111010110001 #b110110)))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0000011101101011 #b001100)
                arg3
                (fp #b0 #b0000010101011000 #b100110)))
(assert (fp.leq (fp #b0 #b0000010101011000 #b100110)
                arg3
                (fp #b0 #b0001010010001010 #b111111)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
