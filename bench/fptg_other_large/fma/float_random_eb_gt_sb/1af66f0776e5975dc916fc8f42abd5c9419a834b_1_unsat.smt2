; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b101101101101 #b0110110)
                arg1
                (fp #b0 #b111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b1111111)
                arg1
                (fp #b0 #b111111111111 #b0000000)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b0 #b010110110010 #b1101010)
                arg2
                (fp #b0 #b110110011000 #b1101011)))
(assert (fp.leq (fp #b0 #b110110011000 #b1101011)
                arg2
                (fp #b0 #b111101001011 #b0100111)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
