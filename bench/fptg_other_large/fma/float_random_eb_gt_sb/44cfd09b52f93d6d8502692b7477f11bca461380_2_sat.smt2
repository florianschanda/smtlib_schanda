(declare-const arg3 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1100011000100 #b10)
                arg3
                (fp #b1 #b1000000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000000010 #b00)
                arg3
                (fp #b1 #b0010100101100 #b11)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1011100011011 #b00)
                expect
                (fp #b1 #b1000000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000000010 #b00)
                expect
                (fp #b0 #b0111011101111 #b10)))

(assert (= expect result))

(check-sat)
(exit)
