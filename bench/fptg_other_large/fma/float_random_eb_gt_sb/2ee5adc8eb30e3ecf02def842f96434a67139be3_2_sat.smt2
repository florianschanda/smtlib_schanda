(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000000011 #b011)
                arg1
                (fp #b1 #b1000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000011 #b000)
                arg1
                (fp #b0 #b0000100101 #b010)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110001101 #b101)
                arg2
                (fp #b1 #b1000000011 #b000)))
(assert (fp.leq (fp #b1 #b1000000011 #b000)
                arg2
                (fp #b1 #b0000011101 #b100)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1111011101 #b100)
                arg3
                (fp #b0 #b0000000000 #b101)))
(assert (fp.leq (fp #b0 #b0000000000 #b101)
                arg3
                (fp #b0 #b0111011010 #b000)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0111011000 #b100)
                expect
                (fp #b0 #b1000000111 #b001)))
(assert (fp.leq (fp #b0 #b1000000111 #b001)
                expect
                (fp #b0 #b1111100000 #b000)))

(assert (= expect result))

(check-sat)
(exit)
