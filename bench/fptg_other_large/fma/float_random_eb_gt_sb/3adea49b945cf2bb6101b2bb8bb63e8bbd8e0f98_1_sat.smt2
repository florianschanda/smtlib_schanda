; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1001101100 #b111011)
                arg1
                (fp #b1 #b1000000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000)
                arg1
                (fp #b0 #b0101000011 #b010011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111101 #b101001)
                arg2
                (fp #b1 #b1111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000)
                arg2
                (fp #b0 #b1001100011 #b100100)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
