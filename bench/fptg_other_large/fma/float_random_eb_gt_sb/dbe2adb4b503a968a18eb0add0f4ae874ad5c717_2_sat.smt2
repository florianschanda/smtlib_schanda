(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b001101001110101 #b1)
                arg1
                (fp #b0 #b001110100110010 #b1)))
(assert (fp.leq (fp #b0 #b001110100110010 #b1)
                arg1
                (fp #b0 #b010011100001010 #b0)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b100000001111001 #b0)
                arg2
                (fp #b1 #b100000000000001 #b0)))
(assert (fp.leq (fp #b1 #b100000000000001 #b0)
                arg2
                (fp #b0 #b110111100000011 #b0)))

(declare-const arg3 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b111111111111111 #b0)
                arg3
                (fp #b1 #b111111111111101 #b0)))
(assert (fp.leq (fp #b1 #b111111111111101 #b0)
                arg3
                (fp #b0 #b001101010110100 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b111111111111111 #b0)
                expect
                (fp #b1 #b111111111111101 #b1)))
(assert (fp.leq (fp #b1 #b111111111111101 #b1)
                expect
                (fp #b1 #b000101110111111 #b1)))

(assert (= expect result))

(check-sat)
(exit)
