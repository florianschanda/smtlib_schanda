                arg3
                (fp #b0 #b101011001010 #b00001)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111011010 #b10110)
                expect
                (fp #b0 #b100000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000101 #b00000)
                expect
                (fp #b0 #b110010000010 #b10101)))

(assert (not (= expect result)))

