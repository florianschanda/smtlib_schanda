; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +NAN
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b111000000 #b00011)
                arg1
                (fp #b1 #b000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000)
                arg1
                (fp #b0 #b101001101 #b00100)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101101001 #b11010)
                arg3
                (fp #b0 #b100001011 #b10100)))
(assert (fp.leq (fp #b0 #b100001011 #b10100)
                arg3
                (fp #b0 #b111011000 #b11011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
