(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10100111111 #b1111110)
                arg1
                (fp #b1 #b00000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000)
                arg1
                (fp #b0 #b11100001111 #b1101001)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b01001100111 #b0000101)
                arg2
                (fp #b0 #b01011001011 #b0010000)))
(assert (fp.leq (fp #b0 #b01011001011 #b0010000)
                arg2
                (fp #b0 #b11010001111 #b1001100)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
