(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0111001111 #b001000)
                arg1
                (fp #b0 #b0000000000 #b010111)))
(assert (fp.leq (fp #b0 #b0000000000 #b010111)
                arg1
                (fp #b0 #b0110111001 #b001011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1010111111 #b110100)
                arg2
                (fp #b0 #b1111111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111)
                arg2
                (fp #b0 #b1111111111 #b000000)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0101011111 #b100010)
                arg3
                (fp #b1 #b0000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000)
                arg3
                (fp #b0 #b0000100101 #b011101)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1100010011 #b111100)
                expect
                (fp #b0 #b0111111111 #b011100)))
(assert (fp.leq (fp #b0 #b0111111111 #b011100)
                expect
                (fp #b0 #b1101110110 #b100011)))

(assert (= expect result))

(check-sat)
(exit)
