(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 15))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1110001010001011 #b10110111111111)
                arg2
                (fp #b0 #b1000000000001110 #b00000000000000)))
(assert (fp.leq (fp #b0 #b1000000000001110 #b00000000000000)
                arg2
                (fp #b0 #b1101000101101001 #b10001101000101)))

(declare-const arg3 (_ FloatingPoint 16 15))
(assert (fp.leq (fp #b1 #b1100110011100011 #b10110101100000)
                arg3
                (fp #b1 #b1010001010001100 #b10100001111100)))
(assert (fp.leq (fp #b1 #b1010001010001100 #b10100001111100)
                arg3
                (fp #b1 #b0101111011110101 #b01100000111011)))

(declare-const result (_ FloatingPoint 16 15))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 15))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
