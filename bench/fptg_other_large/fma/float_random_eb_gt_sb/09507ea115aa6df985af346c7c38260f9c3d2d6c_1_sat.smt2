(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b10000101001011101 #b11000001)
                arg1
                (fp #b1 #b10000000000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b10000000000001000 #b00000000)
                arg1
                (fp #b0 #b01101001001010000 #b00110100)))

(declare-const arg2 (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b00110100101001010 #b10011001)
                arg2
                (fp #b0 #b00111010110111101 #b00101101)))
(assert (fp.leq (fp #b0 #b00111010110111101 #b00101101)
                arg2
                (fp #b0 #b11111010111110001 #b01000000)))

(declare-const arg3 (_ FloatingPoint 17 9))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 17 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 9))
(assert (fp.leq (fp #b1 #b11011111000101011 #b01111011)
                expect
                (fp #b1 #b00111010111000110 #b00101100)))
(assert (fp.leq (fp #b1 #b00111010111000110 #b00101100)
                expect
                (fp #b0 #b00000101100100101 #b10101000)))

(assert (= expect result))

(check-sat)
(exit)
