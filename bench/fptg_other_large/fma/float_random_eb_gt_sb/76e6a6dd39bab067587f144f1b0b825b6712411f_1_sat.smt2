; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b011011110110 #b111100010)
                arg1
                (fp #b1 #b000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b000000000)
                arg1
                (fp #b0 #b110110011101 #b100111000)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b001001110101 #b101011110)
                arg2
                (fp #b0 #b000000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b010000000)
                arg2
                (fp #b0 #b100101010110 #b000101101)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110010101101 #b111011001)
                arg3
                (fp #b0 #b100000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b100000001001 #b000000000)
                arg3
                (fp #b0 #b101101111111 #b000010100)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b0 #b001010100101 #b111010110)
                expect
                (fp #b0 #b100000001001 #b000000000)))
(assert (fp.leq (fp #b0 #b100000001001 #b000000000)
                expect
                (fp #b0 #b110101101100 #b100101010)))

(assert (= expect result))

(check-sat)
(exit)
