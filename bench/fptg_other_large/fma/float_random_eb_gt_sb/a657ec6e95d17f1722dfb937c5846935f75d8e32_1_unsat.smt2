                (fp #b0 #b111111101 #b00000)))
(assert (fp.leq (fp #b0 #b111111101 #b00000)
                arg2
                (fp #b0 #b111111101 #b01001)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b001011101 #b01110)
                arg3
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                arg3
                (fp #b0 #b111010000 #b01001)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111101111 #b11100)
                expect
                (fp #b0 #b100000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000101 #b00000)
                expect
                (fp #b0 #b101101101 #b11011)))

(assert (not (= expect result)))

(check-sat)
(exit)
