(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1101100111110100 #b1)
                arg1
                (fp #b1 #b1000000000000001 #b0)))
(assert (fp.leq (fp #b1 #b1000000000000001 #b0)
                arg1
                (fp #b0 #b1100110101010000 #b0)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1111111111111111 #b0)
                arg2
                (fp #b1 #b1111111111111101 #b0)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b0)
                arg2
                (fp #b0 #b1111100101101011 #b1)))

(declare-const arg3 (_ FloatingPoint 16 2))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1111010110011010 #b1)
                arg3
                (fp #b0 #b0000000000000000 #b0)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0)
                arg3
                (fp #b0 #b1110100011111000 #b0)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
