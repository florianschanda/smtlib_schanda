;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01010001101010 #b11000)
                arg1
                (fp #b0 #b01010010010001 #b01101)))
(assert (fp.leq (fp #b0 #b01010010010001 #b01101)
                arg1
                (fp #b0 #b11101110001110 #b10111)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b10100110001011 #b11100)
                arg2
                (fp #b1 #b10001001000101 #b01100)))
(assert (fp.leq (fp #b1 #b10001001000101 #b01100)
                arg2
                (fp #b0 #b10010111111000 #b00101)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b01001110011101 #b00010)
                arg3
                (fp #b0 #b11111111111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00000)
                arg3
                (fp #b0 #b11111111111110 #b00101)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b01101100000010 #b11101)
                expect
                (fp #b0 #b11111111111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00000)
                expect
                (fp #b0 #b11111111111101 #b00101)))

(assert (= expect result))

(check-sat)
(exit)
