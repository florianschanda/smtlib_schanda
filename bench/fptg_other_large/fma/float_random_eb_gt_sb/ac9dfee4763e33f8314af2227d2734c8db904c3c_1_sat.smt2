(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111101 #b101)
                arg1
                (fp #b1 #b11111111111101 #b000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b000)
                arg1
                (fp #b0 #b10110100111000 #b001)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10110111111000 #b010)
                arg2
                (fp #b0 #b00000000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010)
                arg2
                (fp #b0 #b10101110001111 #b100)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
