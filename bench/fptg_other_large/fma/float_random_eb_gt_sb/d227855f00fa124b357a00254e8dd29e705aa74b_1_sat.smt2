(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -INT_BOUNDARY
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0011111111 #b101000)
                arg1
                (fp #b0 #b0000000000 #b010000)))
(assert (fp.leq (fp #b0 #b0000000000 #b010000)
                arg1
                (fp #b0 #b0111011100 #b110110)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1110000110 #b101100)
                arg2
                (fp #b1 #b1000000110 #b000000)))
(assert (fp.leq (fp #b1 #b1000000110 #b000000)
                arg2
                (fp #b1 #b0110010110 #b011010)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111111 #b000000)
                arg3
                (fp #b1 #b1111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111)
                arg3
                (fp #b1 #b0111111101 #b101010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111111 #b000000)
                expect
                (fp #b1 #b1111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111)
                expect
                (fp #b0 #b0010110011 #b011111)))

(assert (= expect result))

(check-sat)
(exit)
