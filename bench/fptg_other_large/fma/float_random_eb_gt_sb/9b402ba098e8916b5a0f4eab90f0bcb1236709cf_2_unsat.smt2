                arg2
                (fp #b0 #b011111101 #b1111001)))
(assert (fp.leq (fp #b0 #b011111101 #b1111001)
                arg2
                (fp #b0 #b101010100 #b1001100)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111110 #b0011000)
                arg3
                (fp #b1 #b111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111101 #b0000000)
                arg3
                (fp #b1 #b110111011 #b0000010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b111111110 #b0000110)
                expect
                (fp #b1 #b111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111101 #b0000000)
                expect
                (fp #b1 #b001001011 #b0111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
