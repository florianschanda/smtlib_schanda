(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b111000011010111110 #b10101110)
                arg1
                (fp #b1 #b110110111001011100 #b00111000)))
(assert (fp.leq (fp #b1 #b110110111001011100 #b00111000)
                arg1
                (fp #b1 #b000010111111111110 #b00101110)))

(declare-const arg2 (_ FloatingPoint 18 9))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b111111111111111101 #b00001000)
                arg3
                (fp #b1 #b111111111111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b00000000)
                arg3
                (fp #b0 #b000000100010001001 #b01101001)))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
