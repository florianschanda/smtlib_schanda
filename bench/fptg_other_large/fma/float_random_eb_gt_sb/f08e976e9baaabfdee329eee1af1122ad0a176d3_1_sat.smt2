(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111111111 #b00)
                arg1
                (fp #b1 #b1111111110 #b11)))
(assert (fp.leq (fp #b1 #b1111111110 #b11)
                arg1
                (fp #b0 #b1111010011 #b01)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111111110 #b11)
                arg2
                (fp #b1 #b1111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111101 #b00)
                arg2
                (fp #b0 #b0111111111 #b10)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011011100 #b00)
                arg3
                (fp #b1 #b0000000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000000 #b10)
                arg3
                (fp #b0 #b1011111110 #b11)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0110110001 #b11)
                expect
                (fp #b0 #b1111111110 #b11)))
(assert (fp.leq (fp #b0 #b1111111110 #b11)
                expect
                (fp #b0 #b1111111111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
