(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11110011001010 #b11111110100)
                arg1
                (fp #b1 #b00000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000000000)
                arg1
                (fp #b0 #b11010101000100 #b10011101110)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11110000000101 #b10100101101)
                arg2
                (fp #b1 #b00011111011100 #b10111100110)))
(assert (fp.leq (fp #b1 #b00011111011100 #b10111100110)
                arg2
                (fp #b0 #b10100111001101 #b10001010011)))

(declare-const arg3 (_ FloatingPoint 14 12))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11000010110100 #b10010101010)
                expect
                (fp #b1 #b00011111011100 #b10111100110)))
(assert (fp.leq (fp #b1 #b00011111011100 #b10111100110)
                expect
                (fp #b0 #b10100011000100 #b10100111111)))

(assert (not (= expect result)))

(check-sat)
(exit)
