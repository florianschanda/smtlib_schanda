; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1000100000 #b0000100)
                arg2
                (fp #b1 #b0111010011 #b0011001)))
(assert (fp.leq (fp #b1 #b0111010011 #b0011001)
                arg2
                (fp #b1 #b0010001011 #b0101010)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101110001 #b1100101)
                arg3
                (fp #b1 #b0000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b0000000000 #b0111011)
                arg3
                (fp #b0 #b0110101110 #b0111000)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
