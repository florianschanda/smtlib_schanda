; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b1000001111 #b01011110)
                arg1
                (fp #b0 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000000)
                arg1
                (fp #b0 #b1111111101 #b01001101)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000001000 #b00010011)
                arg3
                (fp #b0 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000000)
                arg3
                (fp #b0 #b1001110110 #b00000011)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
