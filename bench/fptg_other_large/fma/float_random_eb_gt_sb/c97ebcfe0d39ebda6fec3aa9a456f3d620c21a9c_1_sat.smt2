(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1101111010100010 #b0111)
                arg3
                (fp #b1 #b1000000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000000000000100 #b0000)
                arg3
                (fp #b1 #b0101100011111010 #b1000)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1110010110100101 #b0101)
                expect
                (fp #b1 #b1101011001110101 #b0000)))
(assert (fp.leq (fp #b1 #b1101011001110101 #b0000)
                expect
                (fp #b0 #b0000110010110010 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
