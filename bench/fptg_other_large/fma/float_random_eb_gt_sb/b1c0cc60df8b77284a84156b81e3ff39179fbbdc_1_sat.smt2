                arg2
                (fp #b0 #b111111111111110 #b1111111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111111111)
                arg2
                (fp #b0 #b111111111111111 #b0000000000)))

(declare-const arg3 (_ FloatingPoint 15 11))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
