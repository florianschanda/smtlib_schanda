;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111111 #b00000)
                arg2
                (fp #b1 #b11111111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111111110 #b11111)
                arg2
                (fp #b1 #b11100000100 #b01110)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00010111100 #b10101)
                arg3
                (fp #b1 #b00001001001 #b10010)))
(assert (fp.leq (fp #b1 #b00001001001 #b10010)
                arg3
                (fp #b0 #b10000111011 #b11100)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
