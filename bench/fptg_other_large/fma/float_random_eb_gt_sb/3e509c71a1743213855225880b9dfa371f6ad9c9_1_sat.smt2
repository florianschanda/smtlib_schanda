(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001100010 #b0111)
                arg1
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg1
                (fp #b0 #b111011011 #b0010)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111100110 #b1010)
                arg2
                (fp #b1 #b110101111 #b1011)))
(assert (fp.leq (fp #b1 #b110101111 #b1011)
                arg2
                (fp #b0 #b111110010 #b1011)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000101000 #b0110)
                arg3
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg3
                (fp #b0 #b111010000 #b1111)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111110 #b1001)
                expect
                (fp #b1 #b010101111 #b1010)))
(assert (fp.leq (fp #b1 #b010101111 #b1010)
                expect
                (fp #b0 #b010101000 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
