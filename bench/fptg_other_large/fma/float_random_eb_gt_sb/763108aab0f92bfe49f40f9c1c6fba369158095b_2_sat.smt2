; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110101100100101 #b1110)
                arg1
                (fp #b0 #b000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0100)
                arg1
                (fp #b0 #b111100111100101 #b0001)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b001101111110110 #b0111)
                arg2
                (fp #b0 #b000100101001010 #b0111)))
(assert (fp.leq (fp #b0 #b000100101001010 #b0111)
                arg2
                (fp #b0 #b000111110111011 #b0111)))

(declare-const arg3 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111011111001011 #b0111)
                arg3
                (fp #b0 #b000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0100)
                arg3
                (fp #b0 #b011110000001011 #b0011)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b010100111100001 #b1110)
                expect
                (fp #b0 #b000000000000000 #b0101)))
(assert (fp.leq (fp #b0 #b000000000000000 #b0101)
                expect
                (fp #b0 #b101110101001001 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
