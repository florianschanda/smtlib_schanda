                (fp #b0 #b001100110110 #b100111)))

(declare-const arg3 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b0 #b001110000001 #b010000)
                arg3
                (fp #b0 #b100000000110 #b000000)))
(assert (fp.leq (fp #b0 #b100000000110 #b000000)
                arg3
                (fp #b0 #b110111000111 #b010101)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b001000110100 #b111100)
                expect
                (fp #b0 #b110100111001 #b101110)))
(assert (fp.leq (fp #b0 #b110100111001 #b101110)
                expect
                (fp #b0 #b110101010001 #b000011)))

(assert (not (= expect result)))

(check-sat)
(exit)
