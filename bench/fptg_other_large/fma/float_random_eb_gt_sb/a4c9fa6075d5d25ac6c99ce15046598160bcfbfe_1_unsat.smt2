; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -NAN
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b101010110000111 #b1010010000001)
                arg3
                (fp #b1 #b100010100100110 #b0100010001111)))
(assert (fp.leq (fp #b1 #b100010100100110 #b0100010001111)
                arg3
                (fp #b1 #b000001100101010 #b0001000100001)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
