(assert (fp.leq (fp #b1 #b000000000 #b0100)
                arg2
                (fp #b0 #b100111001 #b1000)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b010010000 #b0001)
                arg3
                (fp #b1 #b000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000 #b0000)
                arg3
                (fp #b0 #b010100101 #b1000)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b101011011 #b1000)
                expect
                (fp #b1 #b011111101 #b0000)))
(assert (fp.leq (fp #b1 #b011111101 #b0000)
                expect
                (fp #b0 #b110111110 #b0101)))

(assert (not (= expect result)))

(check-sat)
(exit)
