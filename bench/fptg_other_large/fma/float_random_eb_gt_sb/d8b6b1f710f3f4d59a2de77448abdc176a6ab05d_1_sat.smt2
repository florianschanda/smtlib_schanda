(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0111000110 #b0101010)
                arg1
                (fp #b1 #b0111000100 #b0011101)))
(assert (fp.leq (fp #b1 #b0111000100 #b0011101)
                arg1
                (fp #b1 #b0000101100 #b0000111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0000101000 #b1111111)
                arg3
                (fp #b1 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100000)
                arg3
                (fp #b0 #b0001001110 #b1111111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111001001 #b1010100)
                expect
                (fp #b0 #b0110001001 #b1000000)))
(assert (fp.leq (fp #b0 #b0110001001 #b1000000)
                expect
                (fp #b0 #b1011011100 #b1011110)))

(assert (= expect result))

(check-sat)
(exit)
