(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b110111100110010101 #b1)
                arg1
                (fp #b1 #b110100000100111111 #b0)))
(assert (fp.leq (fp #b1 #b110100000100111111 #b0)
                arg1
                (fp #b1 #b100011101110100101 #b1)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b0 #b001111000110010111 #b1)
                arg3
                (fp #b0 #b111111111111111110 #b0)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b0)
                arg3
                (fp #b0 #b111111111111111110 #b1)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b111111111111111111 #b0)
                expect
                (fp #b1 #b111111111111111110 #b1)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b1)
                expect
                (fp #b1 #b100001101011110101 #b1)))

(assert (= expect result))

(check-sat)
(exit)
