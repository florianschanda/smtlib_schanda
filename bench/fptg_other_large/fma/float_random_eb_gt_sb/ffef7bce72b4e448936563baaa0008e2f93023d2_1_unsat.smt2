(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b001100000101 #b10)
                arg1
                (fp #b1 #b000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000 #b01)
                arg1
                (fp #b0 #b110010100000 #b10)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b000110101001 #b10)
                arg2
                (fp #b0 #b111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111101 #b00)
                arg2
                (fp #b0 #b111111111110 #b10)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b101010011011 #b11)
                arg3
                (fp #b1 #b011000000000 #b11)))
(assert (fp.leq (fp #b1 #b011000000000 #b11)
                arg3
                (fp #b1 #b010001001111 #b01)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100100011010 #b00)
                expect
                (fp #b1 #b011111111101 #b00)))
(assert (fp.leq (fp #b1 #b011111111101 #b00)
                expect
                (fp #b1 #b001000000010 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
