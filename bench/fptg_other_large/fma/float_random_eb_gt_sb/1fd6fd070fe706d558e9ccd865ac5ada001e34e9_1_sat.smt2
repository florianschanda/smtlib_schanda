(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 9))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001111001010011 #b11111000)
                arg1
                (fp #b1 #b000000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00000000)
                arg1
                (fp #b0 #b001011010011011 #b10110011)))

(declare-const arg2 (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b1 #b011101000010111 #b01100101)
                arg2
                (fp #b1 #b011100010000001 #b01001010)))
(assert (fp.leq (fp #b1 #b011100010000001 #b01001010)
                arg2
                (fp #b1 #b001000101111010 #b01111011)))

(declare-const arg3 (_ FloatingPoint 15 9))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 9))
(assert (fp.leq (fp #b0 #b000010101011001 #b11001110)
                expect
                (fp #b0 #b011100010000001 #b01001010)))
(assert (fp.leq (fp #b0 #b011100010000001 #b01001010)
                expect
                (fp #b0 #b100000010000011 #b11111000)))

(assert (= expect result))

(check-sat)
(exit)
