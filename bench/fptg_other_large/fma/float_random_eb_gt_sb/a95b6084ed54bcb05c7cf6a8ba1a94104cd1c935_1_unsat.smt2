(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b001001011010 #b0)
                arg2
                (fp #b0 #b000000000000 #b1)))
(assert (fp.leq (fp #b0 #b000000000000 #b1)
                arg2
                (fp #b0 #b101101100110 #b1)))

(declare-const arg3 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b111111111111 #b0)
                arg3
                (fp #b1 #b111111111110 #b1)))
(assert (fp.leq (fp #b1 #b111111111110 #b1)
                arg3
                (fp #b0 #b011001010100 #b0)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
