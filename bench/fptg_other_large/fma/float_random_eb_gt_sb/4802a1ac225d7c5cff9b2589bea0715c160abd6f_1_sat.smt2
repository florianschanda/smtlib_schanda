; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001111000 #b001)
                arg1
                (fp #b0 #b0000000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000000 #b110)
                arg1
                (fp #b0 #b0001000001 #b010)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1001010010 #b111)
                arg3
                (fp #b0 #b0001111101 #b110)))
(assert (fp.leq (fp #b0 #b0001111101 #b110)
                arg3
                (fp #b0 #b0101001100 #b100)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
