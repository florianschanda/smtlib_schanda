; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b001010100101 #b11)
                arg1
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg1
                (fp #b0 #b001000011110 #b11)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111010110111 #b00)
                arg2
                (fp #b1 #b110111010010 #b00)))
(assert (fp.leq (fp #b1 #b110111010010 #b00)
                arg2
                (fp #b1 #b011010001001 #b11)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b011110011011 #b01)
                arg3
                (fp #b1 #b000000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000000 #b00)
                arg3
                (fp #b0 #b100010011111 #b10)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b011110010100 #b00)
                expect
                (fp #b1 #b010111010010 #b00)))
(assert (fp.leq (fp #b1 #b010111010010 #b00)
                expect
                (fp #b1 #b010000101110 #b01)))

(assert (= expect result))

(check-sat)
(exit)
