(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0100011111 #b01)
                arg1
                (fp #b0 #b0000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000 #b10)
                arg1
                (fp #b0 #b1010110010 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111111110 #b11)
                arg2
                (fp #b1 #b1111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111101 #b00)
                arg2
                (fp #b0 #b1000010111 #b11)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1010100110 #b00)
                arg3
                (fp #b1 #b1000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000010 #b00)
                arg3
                (fp #b0 #b1101000000 #b00)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1110101000 #b01)
                expect
                (fp #b1 #b1000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000010 #b00)
                expect
                (fp #b1 #b0100101001 #b01)))

(assert (= expect result))

(check-sat)
(exit)
