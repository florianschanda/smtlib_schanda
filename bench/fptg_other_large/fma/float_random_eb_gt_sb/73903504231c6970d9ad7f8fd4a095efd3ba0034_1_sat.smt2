(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111111111111 #b00000)
                arg1
                (fp #b1 #b11111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11111)
                arg1
                (fp #b0 #b11001100110101 #b11101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11010000001111 #b01011)
                arg2
                (fp #b0 #b00000111000101 #b11000)))
(assert (fp.leq (fp #b0 #b00000111000101 #b11000)
                arg2
                (fp #b0 #b11110011000111 #b10000)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b01100011101001 #b11010)
                arg3
                (fp #b1 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000)
                arg3
                (fp #b0 #b01000010000111 #b01010)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11010001001000 #b11001)
                expect
                (fp #b1 #b10000111000101 #b10111)))
(assert (fp.leq (fp #b1 #b10000111000101 #b10111)
                expect
                (fp #b1 #b00101100001010 #b11010)))

(assert (= expect result))

(check-sat)
(exit)
