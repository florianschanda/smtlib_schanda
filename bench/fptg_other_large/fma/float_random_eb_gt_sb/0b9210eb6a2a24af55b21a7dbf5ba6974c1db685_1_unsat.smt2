(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11011101110010 #b00)
                arg1
                (fp #b1 #b10000000000010 #b00)))
(assert (fp.leq (fp #b1 #b10000000000010 #b00)
                arg1
                (fp #b1 #b00000010001001 #b11)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b00101001100101 #b11)
                arg2
                (fp #b1 #b00000000000000 #b10)))
(assert (fp.leq (fp #b1 #b00000000000000 #b10)
                arg2
                (fp #b0 #b00011101001100 #b10)))

(declare-const arg3 (_ FloatingPoint 14 3))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
