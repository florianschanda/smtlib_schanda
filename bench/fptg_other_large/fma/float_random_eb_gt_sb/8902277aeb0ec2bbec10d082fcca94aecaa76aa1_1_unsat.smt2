;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111010101010001 #b000)
                arg1
                (fp #b0 #b0000000000000000 #b110)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b110)
                arg1
                (fp #b0 #b1000000000100101 #b000)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1110111100101011 #b110)
                arg3
                (fp #b1 #b0011110110011010 #b101)))
(assert (fp.leq (fp #b1 #b0011110110011010 #b101)
                arg3
                (fp #b1 #b0000110101000111 #b001)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0111000001000001 #b101)
                expect
                (fp #b1 #b0011110110011010 #b101)))
(assert (fp.leq (fp #b1 #b0011110110011010 #b101)
                expect
                (fp #b0 #b0110001001010011 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
