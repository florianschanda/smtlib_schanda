; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0010100111 #b11)
                arg1
                (fp #b0 #b1000000010 #b00)))
(assert (fp.leq (fp #b0 #b1000000010 #b00)
                arg1
                (fp #b0 #b1001100100 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1001010001 #b01)
                arg3
                (fp #b0 #b0000000000 #b10)))
(assert (fp.leq (fp #b0 #b0000000000 #b10)
                arg3
                (fp #b0 #b0001101001 #b01)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
