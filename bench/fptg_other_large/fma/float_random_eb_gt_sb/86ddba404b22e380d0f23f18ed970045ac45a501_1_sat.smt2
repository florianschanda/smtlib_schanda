; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1010101100100 #b00011111100)
                arg2
                (fp #b1 #b0100101110100 #b11010110010)))
(assert (fp.leq (fp #b1 #b0100101110100 #b11010110010)
                arg2
                (fp #b0 #b1000100010100 #b00000001100)))

(declare-const arg3 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b0 #b0011010001001 #b11000010011)
                arg3
                (fp #b0 #b1000000001011 #b00000000000)))
(assert (fp.leq (fp #b0 #b1000000001011 #b00000000000)
                arg3
                (fp #b0 #b1110101000100 #b11111110110)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
