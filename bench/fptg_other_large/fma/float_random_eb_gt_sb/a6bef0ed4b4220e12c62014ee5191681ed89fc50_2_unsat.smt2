(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0001001001 #b011010)
                arg1
                (fp #b0 #b1000111010 #b001011)))
(assert (fp.leq (fp #b0 #b1000111010 #b001011)
                arg1
                (fp #b0 #b1101000111 #b111011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0101100011 #b101111)
                arg3
                (fp #b1 #b0000000000 #b100111)))
(assert (fp.leq (fp #b1 #b0000000000 #b100111)
                arg3
                (fp #b0 #b0101000100 #b011010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111000100 #b100001)
                expect
                (fp #b0 #b1001110101 #b011000)))
(assert (fp.leq (fp #b0 #b1001110101 #b011000)
                expect
                (fp #b0 #b1111011101 #b111000)))

(assert (not (= expect result)))

(check-sat)
(exit)
