(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b010010100101011011 #b11)
                arg2
                (fp #b0 #b000000000000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b10)
                arg2
                (fp #b0 #b101100011010010110 #b11)))

(declare-const arg3 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b111111111111111101 #b10)
                arg3
                (fp #b1 #b111111111111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b00)
                arg3
                (fp #b0 #b100101010101010110 #b10)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
