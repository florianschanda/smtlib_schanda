(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101110001 #b11)
                arg1
                (fp #b0 #b0001111111 #b00)))
(assert (fp.leq (fp #b0 #b0001111111 #b00)
                arg1
                (fp #b0 #b1011110100 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101100110 #b10)
                arg2
                (fp #b1 #b0000000000 #b01)))
(assert (fp.leq (fp #b1 #b0000000000 #b01)
                arg2
                (fp #b0 #b1111001000 #b01)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1001011010 #b10)
                arg3
                (fp #b1 #b0000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000 #b00)
                arg3
                (fp #b0 #b0111111001 #b11)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b1101101010 #b00)
                expect
                (fp #b1 #b0000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000 #b00)
                expect
                (fp #b0 #b0001111101 #b10)))

(assert (= expect result))

(check-sat)
(exit)
