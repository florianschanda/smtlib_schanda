(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -INFINITY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b10001000011011 #b100)
                arg1
                (fp #b0 #b10000000000011 #b000)))
(assert (fp.leq (fp #b0 #b10000000000011 #b000)
                arg1
                (fp #b0 #b10000111100111 #b001)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11110010011101 #b001)
                arg3
                (fp #b1 #b11011011001011 #b110)))
(assert (fp.leq (fp #b1 #b11011011001011 #b110)
                arg3
                (fp #b1 #b01100101111010 #b110)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
