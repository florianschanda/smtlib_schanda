(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -NAN
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110110100101 #b0111)
                arg3
                (fp #b1 #b100000000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000000100 #b0000)
                arg3
                (fp #b0 #b000001010111 #b1000)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
