(assert (fp.leq (fp #b1 #b0100101110 #b10001101)
                arg2
                (fp #b0 #b1100000110 #b00110011)))
(assert (fp.leq (fp #b0 #b1100000110 #b00110011)
                arg2
                (fp #b0 #b1100000110 #b11100010)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1000100110 #b11100001)
                arg3
                (fp #b1 #b0101111110 #b10100111)))
(assert (fp.leq (fp #b1 #b0101111110 #b10100111)
                arg3
                (fp #b0 #b1010111010 #b10111010)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
