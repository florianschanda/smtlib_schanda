; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 12))
(assert (fp.leq (fp #b1 #b101011010101101111 #b01001110011)
                arg2
                (fp #b1 #b100100000100111001 #b01111001110)))
(assert (fp.leq (fp #b1 #b100100000100111001 #b01111001110)
                arg2
                (fp #b0 #b110011010011001011 #b10111110111)))

(declare-const arg3 (_ FloatingPoint 18 12))
(assert (fp.leq (fp #b1 #b111111111111111111 #b00000000000)
                arg3
                (fp #b1 #b111111111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b111111111111111110 #b11111111111)
                arg3
                (fp #b1 #b110111110111000111 #b00101001101)))

(declare-const result (_ FloatingPoint 18 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
