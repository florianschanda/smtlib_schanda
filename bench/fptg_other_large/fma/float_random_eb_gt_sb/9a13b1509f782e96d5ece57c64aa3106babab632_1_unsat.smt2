(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111111111111110 #b0001100)
                arg1
                (fp #b1 #b111111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b0000000)
                arg1
                (fp #b1 #b100011011101100 #b0010100)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101010000001001 #b1011010)
                arg2
                (fp #b0 #b111111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b0000000)
                arg2
                (fp #b0 #b111111111111101 #b0011001)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b100101011101101 #b0011101)
                arg3
                (fp #b1 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000)
                arg3
                (fp #b0 #b011001011010001 #b1011101)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b111111111111111 #b0000000)
                expect
                (fp #b1 #b111111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b1111111)
                expect
                (fp #b1 #b111111110000110 #b1111100)))

(assert (not (= expect result)))

(check-sat)
(exit)
