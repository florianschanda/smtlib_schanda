(declare-const arg3 (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111111111110 #b10)
                arg3
                (fp #b1 #b1111111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111111101 #b00)
                arg3
                (fp #b1 #b0100001101110 #b00)))

(declare-const result (_ FloatingPoint 13 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 3))
(assert (fp.leq (fp #b1 #b1111111111101 #b11)
                expect
                (fp #b1 #b1111111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111111101 #b00)
                expect
                (fp #b0 #b0001010001100 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
