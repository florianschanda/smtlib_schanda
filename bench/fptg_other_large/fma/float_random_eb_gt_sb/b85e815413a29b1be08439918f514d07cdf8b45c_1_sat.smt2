(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b00100000001 #b0000100)
                arg1
                (fp #b0 #b00000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b00000000000 #b1100101)
                arg1
                (fp #b0 #b11100011100 #b1111110)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10010101011 #b1111100)
                arg3
                (fp #b1 #b01000111000 #b0010101)))
(assert (fp.leq (fp #b1 #b01000111000 #b0010101)
                arg3
                (fp #b0 #b10001100000 #b0011110)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11000000001 #b0001000)
                expect
                (fp #b1 #b01000111000 #b0010100)))
(assert (fp.leq (fp #b1 #b01000111000 #b0010100)
                expect
                (fp #b0 #b10011011000 #b0000100)))

(assert (= expect result))

(check-sat)
(exit)
