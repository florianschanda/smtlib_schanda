                (fp #b0 #b10110010000111000 #b01)))

(declare-const arg3 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11110110011000000 #b10)
                arg3
                (fp #b1 #b11010100011001111 #b10)))
(assert (fp.leq (fp #b1 #b11010100011001111 #b10)
                arg3
                (fp #b0 #b01100111101011111 #b01)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b11110110101011100 #b10)
                expect
                (fp #b1 #b11010100011001111 #b10)))
(assert (fp.leq (fp #b1 #b11010100011001111 #b10)
                expect
                (fp #b1 #b10010000000011111 #b01)))

(assert (= expect result))

(check-sat)
(exit)
