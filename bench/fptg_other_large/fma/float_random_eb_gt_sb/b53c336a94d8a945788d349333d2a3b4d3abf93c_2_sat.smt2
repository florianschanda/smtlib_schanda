                (fp #b0 #b100011011011 #b0111111)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110100001011 #b0100011)
                arg3
                (fp #b1 #b000000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b000000000000 #b0111011)
                arg3
                (fp #b0 #b011000010011 #b0000011)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b110011000100 #b0000001)
                expect
                (fp #b1 #b100000001111 #b0000001)))
(assert (fp.leq (fp #b1 #b100000001111 #b0000001)
                expect
                (fp #b0 #b111000101010 #b1001111)))

(assert (= expect result))

(check-sat)
(exit)
