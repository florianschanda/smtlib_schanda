; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101100011 #b1110011)
                arg1
                (fp #b0 #b0001010110 #b1010011)))
(assert (fp.leq (fp #b0 #b0001010110 #b1010011)
                arg1
                (fp #b0 #b0100001101 #b0110100)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0001011101 #b0111110)
                arg2
                (fp #b0 #b0000000000 #b1100000)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100000)
                arg2
                (fp #b0 #b0101001100 #b1000101)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111111 #b0000000)
                arg3
                (fp #b1 #b1111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111111)
                arg3
                (fp #b1 #b1001101111 #b1100111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111110 #b1111111)
                expect
                (fp #b1 #b1111111110 #b1111110)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111110)
                expect
                (fp #b1 #b0111010100 #b1000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
