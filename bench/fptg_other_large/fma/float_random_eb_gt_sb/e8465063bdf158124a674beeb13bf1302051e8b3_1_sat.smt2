                arg2
                (fp #b1 #b00000000000000 #b101100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b101100)
                arg2
                (fp #b0 #b11110110111001 #b001110)))

(declare-const arg3 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b11001110000110 #b001011)
                arg3
                (fp #b1 #b01010100100000 #b100010)))
(assert (fp.leq (fp #b1 #b01010100100000 #b100010)
                arg3
                (fp #b0 #b01101111101011 #b100110)))

(declare-const result (_ FloatingPoint 14 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b10001110110101 #b110100)
                expect
                (fp #b1 #b01010100100000 #b100001)))
(assert (fp.leq (fp #b1 #b01010100100000 #b100001)
                expect
                (fp #b0 #b00010010100110 #b010101)))

(assert (= expect result))

(check-sat)
(exit)
