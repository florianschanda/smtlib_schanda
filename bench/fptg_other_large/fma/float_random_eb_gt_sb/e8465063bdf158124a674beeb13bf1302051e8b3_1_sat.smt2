(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 7))
(assert (fp.leq (fp #b1 #b01001110100111 #b100001)
                arg1
                (fp #b1 #b00000000000000 #b010000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000)
