;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11010100011100010 #b011)
                arg1
                (fp #b1 #b00111110000000100 #b100)))
(assert (fp.leq (fp #b1 #b00111110000000100 #b100)
                arg1
                (fp #b1 #b00100010101000111 #b110)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b0 #b00011001001011111 #b001)
                arg2
                (fp #b0 #b11111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b11111111111111101 #b000)
                arg2
                (fp #b0 #b11111111111111101 #b101)))

(declare-const arg3 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10000011100100100 #b100)
                arg3
                (fp #b1 #b00000000000000000 #b100)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b100)
                arg3
                (fp #b0 #b10010000001000011 #b000)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11111011110000001 #b101)
                expect
                (fp #b1 #b10111110000000010 #b100)))
(assert (fp.leq (fp #b1 #b10111110000000010 #b100)
                expect
                (fp #b0 #b01110111010011100 #b101)))

(assert (= expect result))

(check-sat)
(exit)
