(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111110 #b01001)
                arg1
                (fp #b1 #b111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111101 #b00000)
                arg1
                (fp #b1 #b001010100 #b01110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110110100 #b01101)
                arg2
                (fp #b1 #b110101001 #b11101)))
(assert (fp.leq (fp #b1 #b110101001 #b11101)
                arg2
                (fp #b0 #b101110010 #b10000)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100101 #b11100)
                arg3
                (fp #b1 #b100000101 #b00000)))
(assert (fp.leq (fp #b1 #b100000101 #b00000)
                arg3
                (fp #b1 #b000101000 #b11011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b010100000 #b01100)
                expect
                (fp #b0 #b111111110 #b11111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111)
                expect
                (fp #b0 #b111111111 #b00000)))

(assert (= expect result))

(check-sat)
(exit)
