(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000010001 #b1100100)
                arg1
                (fp #b0 #b000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b000000000 #b1100101)
                arg1
                (fp #b0 #b011110010 #b0000011)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b101011110 #b0000010)
                arg2
                (fp #b1 #b010101110 #b0111000)))
(assert (fp.leq (fp #b1 #b010101110 #b0111000)
                arg2
                (fp #b0 #b110010010 #b1010011)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011101110 #b0101000)
                arg3
                (fp #b0 #b000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000 #b0100000)
                arg3
                (fp #b0 #b001101111 #b0100010)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b000111000 #b1101011)
                expect
                (fp #b0 #b000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000 #b0100000)
                expect
                (fp #b0 #b101000000 #b1101000)))

(assert (= expect result))

(check-sat)
(exit)
