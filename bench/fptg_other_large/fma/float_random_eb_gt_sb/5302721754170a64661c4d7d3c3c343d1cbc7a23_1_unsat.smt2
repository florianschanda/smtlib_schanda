; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01100000011011 #b1111000)
                arg1
                (fp #b0 #b00000000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000000)
                arg1
                (fp #b0 #b11010100101010 #b0011010)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000000)
                arg2
                (fp #b1 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111111)
                arg2
                (fp #b0 #b11000010110101 #b1011100)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
