; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b00110100011 #b0001010)
                arg1
                (fp #b0 #b10000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000000111 #b0000000)
                arg1
                (fp #b0 #b11100001000 #b0110100)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b01010000000 #b1110111)
                arg2
                (fp #b0 #b10000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b10000000111 #b0000000)
                arg2
                (fp #b0 #b11001110000 #b1101010)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10011010000 #b0100000)
                arg3
                (fp #b1 #b10010000011 #b1100000)))
(assert (fp.leq (fp #b1 #b10010000011 #b1100000)
                arg3
                (fp #b0 #b01000011111 #b0011011)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10111000011 #b1100111)
                expect
                (fp #b1 #b10010000011 #b1011111)))
(assert (fp.leq (fp #b1 #b10010000011 #b1011111)
                expect
                (fp #b0 #b11000001011 #b1011010)))

(assert (= expect result))

(check-sat)
(exit)
