(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b000001011000 #b11001)
                arg1
                (fp #b0 #b100000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000101 #b00000)
                arg1
                (fp #b0 #b100111010111 #b10111)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b010100111011 #b00011)
                arg3
                (fp #b0 #b000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000000000 #b01000)
                arg3
                (fp #b0 #b000001000001 #b10110)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
