(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100110010 #b11001)
                arg1
                (fp #b0 #b0000000000 #b11001)))
(assert (fp.leq (fp #b0 #b0000000000 #b11001)
                arg1
                (fp #b0 #b0111101101 #b00101)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011001110 #b11011)
                arg3
                (fp #b0 #b1000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000101 #b00000)
                arg3
                (fp #b0 #b1101100111 #b01101)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0111101111 #b11110)
                expect
                (fp #b0 #b1000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000101 #b00000)
                expect
                (fp #b0 #b1111010100 #b10110)))

(assert (= expect result))

(check-sat)
(exit)
