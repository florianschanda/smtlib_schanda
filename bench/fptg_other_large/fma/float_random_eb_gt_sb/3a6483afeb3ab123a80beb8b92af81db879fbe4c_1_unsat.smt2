(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101011000 #b0100101)
                arg2
                (fp #b0 #b0001100110 #b0100011)))
(assert (fp.leq (fp #b0 #b0001100110 #b0100011)
                arg2
                (fp #b0 #b1111011011 #b1011111)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0011000100 #b0011001)
                arg3
                (fp #b0 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b0000000)
                arg3
                (fp #b0 #b1110100110 #b0011010)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
