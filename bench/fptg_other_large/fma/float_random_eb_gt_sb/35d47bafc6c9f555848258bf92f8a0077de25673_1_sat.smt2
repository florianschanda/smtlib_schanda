(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b110111110010001001 #b111000110011010)
                arg1
                (fp #b1 #b101011101101110010 #b100001110110111)))
(assert (fp.leq (fp #b1 #b101011101101110010 #b100001110110111)
                arg1
                (fp #b0 #b110010100100100110 #b100010100101011)))

(declare-const arg2 (_ FloatingPoint 18 16))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 18 16))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
