; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b0 #b010000000101110 #b0110)
                arg2
                (fp #b0 #b111111111111101 #b0000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b0000)
                arg2
                (fp #b0 #b111111111111110 #b1110)))

(declare-const arg3 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111111111111101 #b1100)
                arg3
                (fp #b1 #b111111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b0000)
                arg3
                (fp #b0 #b001000100000000 #b0110)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
