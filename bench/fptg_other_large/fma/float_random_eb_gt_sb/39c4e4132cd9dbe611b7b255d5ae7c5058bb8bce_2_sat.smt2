;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b001110010111010 #b01)
                arg1
                (fp #b1 #b000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01)
                arg1
                (fp #b0 #b011100111010101 #b11)))

(declare-const arg2 (_ FloatingPoint 15 3))
