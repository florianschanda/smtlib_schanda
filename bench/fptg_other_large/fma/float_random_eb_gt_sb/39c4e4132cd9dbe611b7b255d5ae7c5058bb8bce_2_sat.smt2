                arg2
                (fp #b1 #b100000000000010 #b00)))
(assert (fp.leq (fp #b1 #b100000000000010 #b00)
                arg2
                (fp #b1 #b011001111000000 #b00)))

(declare-const arg3 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111011011001000 #b01)
                arg3
                (fp #b1 #b110010011101011 #b11)))
(assert (fp.leq (fp #b1 #b110010011101011 #b11)
                arg3
                (fp #b1 #b000110001101010 #b01)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111011100010001 #b11)
                expect
                (fp #b1 #b110010011101011 #b11)))
(assert (fp.leq (fp #b1 #b110010011101011 #b11)
                expect
                (fp #b1 #b011001001110000 #b11)))

(assert (= expect result))

(check-sat)
(exit)
