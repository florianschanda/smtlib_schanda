; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11101110000 #b00011)
                arg2
                (fp #b1 #b11001111101 #b00110)))
(assert (fp.leq (fp #b1 #b11001111101 #b00110)
                arg2
                (fp #b0 #b01110101010 #b10111)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b11100011000 #b01101)
                arg3
                (fp #b0 #b11111111101 #b00000)))
(assert (fp.leq (fp #b0 #b11111111101 #b00000)
                arg3
                (fp #b0 #b11111111110 #b01011)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
