(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0100001101 #b1010110)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b0111111100 #b0111110)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b1000101011 #b1111110)
                arg2
                (fp #b0 #b1001101000 #b0110010)))
(assert (fp.leq (fp #b0 #b1001101000 #b0110010)
                arg2
                (fp #b0 #b1010110001 #b1111101)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
