; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b1 #b111111111110 #b0010111111)
                arg1
                (fp #b1 #b111111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b0000000000)
                arg1
                (fp #b0 #b010100010111 #b0101111011)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b110101111100 #b1101110110)
                arg2
                (fp #b0 #b111010101101 #b0110001011)))
(assert (fp.leq (fp #b0 #b111010101101 #b0110001011)
                arg2
                (fp #b0 #b111011100001 #b1101110011)))

(declare-const arg3 (_ FloatingPoint 12 11))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
