; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b101110001011001010 #b011111111)
                arg2
                (fp #b1 #b100000000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b100000000000001001 #b000000000)
                arg2
                (fp #b0 #b010010110010000100 #b111000100)))

(declare-const arg3 (_ FloatingPoint 18 10))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b000111110010101111 #b011110000)
                arg3
                (fp #b1 #b000000000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b000000000)
                arg3
                (fp #b0 #b010110100111110000 #b000010111)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
