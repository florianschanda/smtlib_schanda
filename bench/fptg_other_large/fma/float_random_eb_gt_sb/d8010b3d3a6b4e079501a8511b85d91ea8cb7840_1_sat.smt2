; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +INFINITY
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10110101000 #b10001011)
                arg1
                (fp #b0 #b00110110100 #b11010001)))
(assert (fp.leq (fp #b0 #b00110110100 #b11010001)
                arg1
                (fp #b0 #b10110000101 #b00111110)))

(declare-const arg2 (_ FloatingPoint 11 9))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 11 9))
(assert (fp.leq (fp #b1 #b10100001010 #b00110000)
                arg3
                (fp #b1 #b10000001000 #b00000000)))
(assert (fp.leq (fp #b1 #b10000001000 #b00000000)
                arg3
                (fp #b0 #b00010000011 #b11111101)))

(declare-const result (_ FloatingPoint 11 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
