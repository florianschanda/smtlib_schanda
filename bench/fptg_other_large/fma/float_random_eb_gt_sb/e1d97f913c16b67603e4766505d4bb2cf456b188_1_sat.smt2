(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111111 #b00000)
                arg1
                (fp #b1 #b1111111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111)
                arg1
                (fp #b0 #b0000001110 #b11011)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101011100 #b00000)
                arg2
                (fp #b1 #b0000000000 #b10001)))
(assert (fp.leq (fp #b1 #b0000000000 #b10001)
                arg2
                (fp #b0 #b1110101110 #b00101)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111100110 #b00010)
                arg3
                (fp #b1 #b0000000000 #b10000)))
(assert (fp.leq (fp #b1 #b0000000000 #b10000)
                arg3
                (fp #b0 #b1001000111 #b11100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0010101000 #b01001)
                expect
                (fp #b0 #b1000000000 #b00001)))
(assert (fp.leq (fp #b0 #b1000000000 #b00001)
                expect
                (fp #b0 #b1010000111 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
