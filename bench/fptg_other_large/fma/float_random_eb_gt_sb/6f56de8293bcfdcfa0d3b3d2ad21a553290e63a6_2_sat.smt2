(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b001101111 #b000)
                arg1
                (fp #b0 #b101011111 #b101)))
(assert (fp.leq (fp #b0 #b101011111 #b101)
                arg1
                (fp #b0 #b110000000 #b111)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101101001 #b000)
                arg2
                (fp #b0 #b000000000 #b010)))
(assert (fp.leq (fp #b0 #b000000000 #b010)
                arg2
                (fp #b0 #b001111100 #b011)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110110010 #b010)
                arg3
                (fp #b1 #b110101011 #b001)))
(assert (fp.leq (fp #b1 #b110101011 #b001)
                arg3
                (fp #b1 #b001101000 #b110)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110101101 #b101)
                expect
                (fp #b1 #b110101011 #b001)))
(assert (fp.leq (fp #b1 #b110101011 #b001)
                expect
                (fp #b1 #b001100000 #b110)))

(assert (= expect result))

(check-sat)
(exit)
