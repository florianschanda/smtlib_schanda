(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -NAN
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1001100100 #b01001)
                arg1
                (fp #b0 #b0000000000 #b00000)))
(assert (fp.leq (fp #b0 #b0000000000 #b00000)
                arg1
                (fp #b0 #b1100011111 #b11000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0100101011 #b11100)
                arg3
                (fp #b0 #b0000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000)
                arg3
                (fp #b0 #b0110010011 #b11011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
