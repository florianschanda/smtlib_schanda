                (fp #b0 #b1111111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000)))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0000000000001100 #b000000)
                arg3
                (fp #b0 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000)
                arg3
                (fp #b0 #b1100000100011100 #b110001)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
