(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110000000010011 #b0011100)
                arg1
                (fp #b1 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000)
                arg1
                (fp #b0 #b000101000010000 #b1110001)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b0 #b010011110001000 #b0011111)
                arg3
                (fp #b0 #b111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111111)
                arg3
                (fp #b0 #b111111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
