(assert (fp.leq (fp #b0 #b101010101011110111 #b110)
                arg3
                (fp #b0 #b110010010100010010 #b100)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

