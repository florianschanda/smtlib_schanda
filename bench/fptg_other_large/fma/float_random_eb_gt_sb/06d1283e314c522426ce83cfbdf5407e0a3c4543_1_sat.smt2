                (fp #b1 #b000000000000000000 #b0111000000111)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0111000000111)
                arg2
                (fp #b0 #b001110110011000001 #b1000010111100)))

(declare-const arg3 (_ FloatingPoint 18 14))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b011001111111010001 #b1011011110000)
                arg3
                (fp #b0 #b000000000000000000 #b0000000000000)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b0000000000000)
                arg3
                (fp #b0 #b111000110100010011 #b0110001001001)))

(declare-const result (_ FloatingPoint 18 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 14))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
