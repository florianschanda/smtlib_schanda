(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00010010011 #b11100)
                arg1
                (fp #b1 #b00000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000)
                arg1
                (fp #b0 #b10000110110 #b11001)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10011100101 #b11100)
                arg2
                (fp #b0 #b00000000000 #b10101)))
(assert (fp.leq (fp #b0 #b00000000000 #b10101)
                arg2
                (fp #b0 #b11011110110 #b01000)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01100111000 #b10000)
                arg3
                (fp #b0 #b10000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000101 #b00000)
                arg3
                (fp #b0 #b10111100001 #b00111)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b00100010010 #b01001)
                expect
                (fp #b0 #b10000000101 #b00000)))
(assert (fp.leq (fp #b0 #b10000000101 #b00000)
                expect
                (fp #b0 #b11011101110 #b01110)))

(assert (= expect result))

(check-sat)
(exit)
