(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b111111111111111 #b000000000)
                arg2
                (fp #b1 #b111111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111111111)
                arg2
                (fp #b1 #b000101101100001 #b100010001)))

(declare-const arg3 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b000010001011001 #b111001010)
                arg3
                (fp #b0 #b000000000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b000000000000000 #b001100101)
                arg3
                (fp #b0 #b000010010001011 #b000111111)))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
