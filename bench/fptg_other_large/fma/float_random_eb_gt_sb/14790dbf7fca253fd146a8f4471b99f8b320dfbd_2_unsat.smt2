; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11111110000 #b1)
                arg1
                (fp #b1 #b11111000010 #b0)))
(assert (fp.leq (fp #b1 #b11111000010 #b0)
                arg1
                (fp #b0 #b01000110000 #b0)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b00010100100 #b0)
                arg2
                (fp #b0 #b10000000001 #b0)))
(assert (fp.leq (fp #b0 #b10000000001 #b0)
                arg2
                (fp #b0 #b10011011100 #b1)))

(declare-const arg3 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11101001100 #b0)
                arg3
                (fp #b1 #b00000000000 #b1)))
(assert (fp.leq (fp #b1 #b00000000000 #b1)
                arg3
                (fp #b0 #b11010000011 #b1)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11111111001 #b1)
                expect
                (fp #b1 #b11111000100 #b1)))
(assert (fp.leq (fp #b1 #b11111000100 #b1)
                expect
                (fp #b1 #b11110010001 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
