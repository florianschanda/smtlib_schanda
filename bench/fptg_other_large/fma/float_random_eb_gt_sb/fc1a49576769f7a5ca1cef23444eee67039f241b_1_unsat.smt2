(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111110111011111 #b100)
                arg3
                (fp #b1 #b1110110101111011 #b110)))
(assert (fp.leq (fp #b1 #b1110110101111011 #b110)
                arg3
                (fp #b0 #b0100100011011000 #b101)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000)
                expect
                (fp #b1 #b1111111111111110 #b111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111)
                expect
                (fp #b0 #b1100001001000101 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
