(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b111001000111 #b001)
                arg1
                (fp #b0 #b000000000000 #b000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000)
                arg1
                (fp #b0 #b111101001100 #b000)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b001100101111 #b110)
                arg2
                (fp #b0 #b000000000000 #b110)))
(assert (fp.leq (fp #b0 #b000000000000 #b110)
                arg2
                (fp #b0 #b100101110110 #b001)))

(declare-const arg3 (_ FloatingPoint 12 4))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b101111111101 #b110)
                expect
                (fp #b0 #b000000000000 #b110)))
(assert (fp.leq (fp #b0 #b000000000000 #b110)
                expect
                (fp #b0 #b000011100101 #b111)))

(assert (not (= expect result)))

(check-sat)
(exit)
