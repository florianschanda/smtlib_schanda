(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11010011111 #b10)
                arg1
                (fp #b1 #b00110001011 #b00)))
(assert (fp.leq (fp #b1 #b00110001011 #b00)
                arg1
                (fp #b0 #b11101001100 #b11)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111100111 #b10)
                arg2
                (fp #b1 #b11110110011 #b01)))
(assert (fp.leq (fp #b1 #b11110110011 #b01)
                arg2
                (fp #b1 #b10110000000 #b11)))

(declare-const arg3 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b00101110011 #b01)
                arg3
                (fp #b0 #b00101010001 #b01)))
(assert (fp.leq (fp #b0 #b00101010001 #b01)
                arg3
                (fp #b0 #b10000011110 #b00)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11001110000 #b00)
                expect
                (fp #b0 #b10100111111 #b10)))
(assert (fp.leq (fp #b0 #b10100111111 #b10)
                expect
                (fp #b0 #b11001011101 #b00)))

(assert (= expect result))

(check-sat)
(exit)
