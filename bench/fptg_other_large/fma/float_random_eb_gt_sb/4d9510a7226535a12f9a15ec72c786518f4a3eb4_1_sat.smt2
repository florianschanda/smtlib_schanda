(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110010101110001 #b10)
                arg1
                (fp #b1 #b000000000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000000000 #b00)
                arg1
                (fp #b0 #b001100011010000 #b01)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b000001001000111 #b10)
                arg2
                (fp #b1 #b000000000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000000000 #b10)
                arg2
                (fp #b0 #b100000100000111 #b11)))

(declare-const arg3 (_ FloatingPoint 15 3))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b101001101011101 #b11)
                expect
                (fp #b0 #b000000000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000000000 #b10)
                expect
                (fp #b0 #b110110010100111 #b01)))

(assert (= expect result))

(check-sat)
(exit)
