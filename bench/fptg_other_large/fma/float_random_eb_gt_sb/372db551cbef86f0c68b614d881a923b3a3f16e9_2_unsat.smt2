; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b00110011011100010 #b110)
                arg1
                (fp #b1 #b00000000000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b010)
                arg1
                (fp #b0 #b10111011011110011 #b010)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11111111111111111 #b000)
                arg2
                (fp #b1 #b11111111111111110 #b111)))
(assert (fp.leq (fp #b1 #b11111111111111110 #b111)
                arg2
                (fp #b1 #b00011001100000000 #b100)))

(declare-const arg3 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b0 #b01110110110010100 #b011)
                arg3
                (fp #b0 #b11111111111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111111111110 #b111)
                arg3
                (fp #b0 #b11111111111111111 #b000)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
