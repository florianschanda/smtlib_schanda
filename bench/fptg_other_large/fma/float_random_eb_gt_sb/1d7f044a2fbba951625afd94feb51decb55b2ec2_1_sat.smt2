(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b0 #b01000100110 #b000)
                arg2
                (fp #b0 #b10110000110 #b100)))
(assert (fp.leq (fp #b0 #b10110000110 #b100)
                arg2
                (fp #b0 #b10110010111 #b111)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11010011110 #b110)
                arg3
                (fp #b1 #b10010111001 #b111)))
(assert (fp.leq (fp #b1 #b10010111001 #b111)
                arg3
                (fp #b0 #b00001100100 #b010)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
