(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +NAN
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 7))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 7))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 17 7))
(assert (fp.leq (fp #b0 #b11001101010001101 #b100110)
                arg3
                (fp #b0 #b11111111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b11111111111111101 #b000000)
                arg3
                (fp #b0 #b11111111111111101 #b010000)))

(declare-const result (_ FloatingPoint 17 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 7))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
