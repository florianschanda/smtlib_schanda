(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11111111101 #b1)
                arg1
                (fp #b1 #b11111111101 #b0)))
(assert (fp.leq (fp #b1 #b11111111101 #b0)
                arg1
                (fp #b1 #b11111010010 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b11010101111 #b0)
                arg2
                (fp #b0 #b10000000001 #b0)))
(assert (fp.leq (fp #b0 #b10000000001 #b0)
                arg2
                (fp #b0 #b11011001011 #b0)))

(declare-const arg3 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b00100100101 #b1)
                arg3
                (fp #b0 #b10000000001 #b0)))
(assert (fp.leq (fp #b0 #b10000000001 #b0)
                arg3
                (fp #b0 #b11110111100 #b0)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
