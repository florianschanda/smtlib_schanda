                (fp #b0 #b10000000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b10000000001000 #b00000000)
                arg2
                (fp #b0 #b11000010011010 #b01100001)))

(declare-const arg3 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10110011011110 #b01011110)
                arg3
                (fp #b0 #b00000000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01000000)
                arg3
                (fp #b0 #b01010010001011 #b01001101)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
