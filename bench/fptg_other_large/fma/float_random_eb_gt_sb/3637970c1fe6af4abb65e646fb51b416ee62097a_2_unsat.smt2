; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0010110011101110 #b0010)
                arg1
                (fp #b0 #b0000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100)
                arg1
                (fp #b0 #b1101101000011101 #b0010)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1001011100111011 #b1001)
                arg2
                (fp #b0 #b0000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100)
                arg2
                (fp #b0 #b1110110111100011 #b0101)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1010001100101100 #b0001)
                arg3
                (fp #b0 #b0000000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0000)
                arg3
                (fp #b0 #b0101101111001001 #b1001)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0010111111110101 #b0001)
                expect
                (fp #b0 #b0000000000000000 #b0001)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0001)
                expect
                (fp #b0 #b0010110000111101 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
