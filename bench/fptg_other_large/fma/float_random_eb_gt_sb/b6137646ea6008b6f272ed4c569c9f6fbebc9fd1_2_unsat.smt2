(assert (fp.leq (fp #b1 #b0000001100111 #b00000)
                arg2
                (fp #b0 #b0011001101110 #b11011)))

(declare-const arg3 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b0 #b1001111011001 #b11011)
                arg3
                (fp #b0 #b1111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b11111)
                arg3
                (fp #b0 #b1111111111111 #b00000)))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
