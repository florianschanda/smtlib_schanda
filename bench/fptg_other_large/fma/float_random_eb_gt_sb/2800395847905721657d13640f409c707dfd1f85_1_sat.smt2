                arg3
                (fp #b0 #b00000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b00000000000 #b001100101)
                arg3
                (fp #b0 #b10011111110 #b110000000)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
