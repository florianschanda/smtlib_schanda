(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b010100010 #b10010)
                arg1
                (fp #b0 #b000000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000)
                arg1
                (fp #b0 #b010111000 #b10011)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011110110 #b01010)
                arg2
                (fp #b0 #b000101011 #b10011)))
(assert (fp.leq (fp #b0 #b000101011 #b10011)
                arg2
                (fp #b0 #b100011000 #b11000)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b011010110 #b00010)
                arg3
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                arg3
                (fp #b0 #b111111001 #b00011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110111010 #b11000)
                expect
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                expect
                (fp #b0 #b010000111 #b11111)))

(assert (= expect result))

(check-sat)
(exit)
