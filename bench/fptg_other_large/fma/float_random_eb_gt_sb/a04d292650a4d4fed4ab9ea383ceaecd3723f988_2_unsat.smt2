; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b10010111001011000 #b10)
                arg1
                (fp #b0 #b10001010101010111 #b01)))
(assert (fp.leq (fp #b0 #b10001010101010111 #b01)
                arg1
                (fp #b0 #b11101001010110000 #b11)))

(declare-const arg2 (_ FloatingPoint 17 3))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b1 #b01110100110110010 #b01)
                arg3
                (fp #b1 #b00101011100001000 #b01)))
(assert (fp.leq (fp #b1 #b00101011100001000 #b01)
                arg3
                (fp #b1 #b00000100100011100 #b01)))

(declare-const result (_ FloatingPoint 17 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 3))
(assert (fp.leq (fp #b0 #b01101011111001101 #b10)
                expect
                (fp #b0 #b10010101010101111 #b11)))
(assert (fp.leq (fp #b0 #b10010101010101111 #b11)
                expect
                (fp #b0 #b10100000111111000 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
