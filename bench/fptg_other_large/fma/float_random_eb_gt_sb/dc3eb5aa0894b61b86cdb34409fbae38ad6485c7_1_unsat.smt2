(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01110010011101111 #b000)
                arg1
                (fp #b0 #b00000000000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b000)
                arg1
                (fp #b0 #b00001001010110011 #b001)))

(declare-const arg2 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11000011011000101 #b111)
                arg2
                (fp #b0 #b10000000000000011 #b000)))
(assert (fp.leq (fp #b0 #b10000000000000011 #b000)
                arg2
                (fp #b0 #b11010101011111011 #b011)))

(declare-const arg3 (_ FloatingPoint 17 4))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
