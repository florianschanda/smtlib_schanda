(assert (fp.leq (fp #b1 #b111111111111110 #b11111111111)
                arg2
                (fp #b0 #b111101001100000 #b11010111100)))

(declare-const arg3 (_ FloatingPoint 15 12))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b000001001010101 #b01010111110)
                arg3
                (fp #b0 #b000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b000000000000000 #b00000000000)
                arg3
                (fp #b0 #b011101101000001 #b01101010011)))

(declare-const result (_ FloatingPoint 15 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 12))
