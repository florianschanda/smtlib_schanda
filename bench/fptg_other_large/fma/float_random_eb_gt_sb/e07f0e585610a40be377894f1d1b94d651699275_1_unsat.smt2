(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011000110 #b001)
                arg1
                (fp #b0 #b000000000 #b110)))
(assert (fp.leq (fp #b0 #b000000000 #b110)
                arg1
                (fp #b0 #b000100110 #b001)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b0 #b110000010 #b001)
                arg2
                (fp #b0 #b111101100 #b011)))
(assert (fp.leq (fp #b0 #b111101100 #b011)
                arg2
                (fp #b0 #b111110010 #b000)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111110 #b000)
                arg3
                (fp #b1 #b111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111101 #b000)
                arg3
                (fp #b1 #b010010110 #b100)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111110 #b101)
                expect
                (fp #b1 #b111111100 #b111)))
(assert (fp.leq (fp #b1 #b111111100 #b111)
                expect
                (fp #b0 #b001110110 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
