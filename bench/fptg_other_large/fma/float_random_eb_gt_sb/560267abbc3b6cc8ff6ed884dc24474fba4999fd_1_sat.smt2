(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b000011010101101000 #b100100000111010)
                arg1
                (fp #b0 #b111111111111111101 #b000000000000000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b000000000000000)
                arg1
