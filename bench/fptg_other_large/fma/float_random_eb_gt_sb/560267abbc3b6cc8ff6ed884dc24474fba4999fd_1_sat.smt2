(assert (fp.leq (fp #b1 #b111010001011001101 #b011110011110000)
                arg2
                (fp #b1 #b010011000011001011 #b011101000110101)))
(assert (fp.leq (fp #b1 #b010011000011001011 #b011101000110101)
                arg2
                (fp #b0 #b100001101101011101 #b010010111111010)))

(declare-const arg3 (_ FloatingPoint 18 16))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
