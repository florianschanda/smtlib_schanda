(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1110001100101100 #b0001110)
                arg1
                (fp #b0 #b0000000000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b1100101)
                arg1
                (fp #b0 #b1000011000010111 #b1001000)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b0 #b0011000101010000 #b0111000)
                arg2
                (fp #b0 #b1111111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111111)
                arg2
                (fp #b0 #b1111111111111111 #b0000000)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
