                (fp #b1 #b00011011001 #b110011)))
(assert (fp.leq (fp #b1 #b00011011001 #b110011)
                arg2
                (fp #b1 #b00000101111 #b111100)))

(declare-const arg3 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b01010111010 #b001101)
                arg3
                (fp #b0 #b10000000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000000110 #b000000)
                arg3
                (fp #b0 #b11000011001 #b111010)))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11010000100 #b010001)
                expect
                (fp #b0 #b10000000110 #b000000)))
(assert (fp.leq (fp #b0 #b10000000110 #b000000)
                expect
                (fp #b0 #b10100111101 #b111001)))

(assert (= expect result))

(check-sat)
(exit)
