; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b110101100111100 #b011100110)
                arg1
                (fp #b1 #b100000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b100000000001001 #b000000000)
                arg1
                (fp #b0 #b110011111010000 #b001011000)))

(declare-const arg2 (_ FloatingPoint 15 10))
(assert (fp.leq (fp #b1 #b110100011001101 #b000010100)
                arg2
                (fp #b1 #b000000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b010000000)
                arg2
                (fp #b0 #b011010001011011 #b100101010)))

(declare-const arg3 (_ FloatingPoint 15 10))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 15 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
