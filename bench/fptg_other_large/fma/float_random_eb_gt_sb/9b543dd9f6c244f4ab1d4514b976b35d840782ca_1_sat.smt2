; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 13))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b0101001111001101 #b010100001010)
                arg2
                (fp #b0 #b0100011101101010 #b001111000111)))
(assert (fp.leq (fp #b0 #b0100011101101010 #b001111000111)
                arg2
                (fp #b0 #b1101101010001010 #b010000001101)))

(declare-const arg3 (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b0 #b0000100101110111 #b001010011010)
                arg3
                (fp #b0 #b1000000000001100 #b000000000000)))
(assert (fp.leq (fp #b0 #b1000000000001100 #b000000000000)
                arg3
                (fp #b0 #b1110000000101101 #b101101000110)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
