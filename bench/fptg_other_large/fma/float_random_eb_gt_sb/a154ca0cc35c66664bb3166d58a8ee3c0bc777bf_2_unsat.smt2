                arg3
                (fp #b0 #b000000000 #b10111)))
(assert (fp.leq (fp #b0 #b000000000 #b10111)
                arg3
                (fp #b0 #b011000101 #b10111)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011000101 #b10011)
                expect
                (fp #b1 #b000001100 #b00000)))
(assert (fp.leq (fp #b1 #b000001100 #b00000)
                expect
                (fp #b0 #b001010010 #b01100)))

(assert (not (= expect result)))

(check-sat)
(exit)
