(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1001011010110000 #b0)
                arg1
                (fp #b1 #b0011111100110010 #b1)))
(assert (fp.leq (fp #b1 #b0011111100110010 #b1)
                arg1
                (fp #b0 #b0110111111001010 #b0)))

(declare-const arg2 (_ FloatingPoint 16 2))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b0011011001101010 #b1)
                arg3
                (fp #b1 #b0001000110001101 #b1)))
(assert (fp.leq (fp #b1 #b0001000110001101 #b1)
                arg3
                (fp #b0 #b0011011001010100 #b0)))

(declare-const result (_ FloatingPoint 16 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 2))
(assert (fp.leq (fp #b1 #b1100110011100110 #b0)
                expect
                (fp #b1 #b0001000110001110 #b0)))
(assert (fp.leq (fp #b1 #b0001000110001110 #b0)
                expect
                (fp #b0 #b0010101011111010 #b0)))

(assert (= expect result))

(check-sat)
(exit)
