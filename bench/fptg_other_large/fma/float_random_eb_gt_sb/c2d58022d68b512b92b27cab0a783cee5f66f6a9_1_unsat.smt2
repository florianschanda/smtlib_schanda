(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10111001001 #b10)
                arg1
                (fp #b1 #b00000000000 #b01)))
(assert (fp.leq (fp #b1 #b00000000000 #b01)
                arg1
                (fp #b0 #b11101111011 #b01)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b01110001000 #b10)
                arg2
                (fp #b0 #b10000000010 #b00)))
(assert (fp.leq (fp #b0 #b10000000010 #b00)
                arg2
                (fp #b0 #b11101111000 #b01)))

(declare-const arg3 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111110 #b00)
                arg3
                (fp #b1 #b11111111101 #b00)))
(assert (fp.leq (fp #b1 #b11111111101 #b00)
                arg3
                (fp #b0 #b11011011111 #b01)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111101 #b11)
                expect
                (fp #b1 #b11111111101 #b00)))
(assert (fp.leq (fp #b1 #b11111111101 #b00)
                expect
                (fp #b1 #b11010111010 #b11)))

(assert (not (= expect result)))

(check-sat)
(exit)
