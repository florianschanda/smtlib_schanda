(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111011111111 #b01011)
                arg1
                (fp #b1 #b11011110010010 #b01001)))
(assert (fp.leq (fp #b1 #b11011110010010 #b01001)
                arg1
                (fp #b1 #b00010000100100 #b01001)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b01000110001000 #b01000)
                arg3
                (fp #b0 #b00000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01000)
                arg3
                (fp #b0 #b00001011001101 #b10011)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111111111111 #b00000)
                expect
                (fp #b1 #b11111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11111)
                expect
                (fp #b0 #b01100110010100 #b11100)))

(assert (= expect result))

(check-sat)
(exit)
