; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111111111111111 #b000)
                arg1
                (fp #b1 #b111111111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111)
                arg1
                (fp #b1 #b101110000100011 #b101)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b010010010001011 #b111)
                arg2
                (fp #b0 #b111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b000)
                arg2
                (fp #b0 #b111111111111101 #b111)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b010011011110001 #b011)
                arg3
                (fp #b1 #b010010000001011 #b100)))
(assert (fp.leq (fp #b1 #b010010000001011 #b100)
                arg3
                (fp #b0 #b001100110110111 #b110)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
