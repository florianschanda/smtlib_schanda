; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 16))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11000011100001000 #b011110101110001)
                arg2
                (fp #b1 #b01001100001100111 #b001110100011011)))
(assert (fp.leq (fp #b1 #b01001100001100111 #b001110100011011)
                arg2
                (fp #b0 #b01111011001101101 #b000011111100001)))

(declare-const arg3 (_ FloatingPoint 17 16))
(assert (fp.leq (fp #b1 #b11101101010100011 #b000100001010010)
                arg3
                (fp #b1 #b10010001010001001 #b101000011110000)))
(assert (fp.leq (fp #b1 #b10010001010001001 #b101000011110000)
                arg3
                (fp #b1 #b00101101000101100 #b110101110001010)))

(declare-const result (_ FloatingPoint 17 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 16))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
