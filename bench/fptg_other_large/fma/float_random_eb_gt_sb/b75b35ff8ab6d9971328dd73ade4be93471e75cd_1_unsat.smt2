; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b011001110110 #b001011)
                arg2
                (fp #b0 #b111111111101 #b000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b000000)
                arg2
                (fp #b0 #b111111111101 #b101101)))

(declare-const arg3 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b010011010010 #b011011)
                arg3
                (fp #b0 #b000000000000 #b010001)))
(assert (fp.leq (fp #b0 #b000000000000 #b010001)
                arg3
                (fp #b0 #b010000000000 #b111000)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
