(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b101000010110011 #b1)
                arg1
                (fp #b1 #b100111011001011 #b0)))
(assert (fp.leq (fp #b1 #b100111011001011 #b0)
                arg1
                (fp #b1 #b100010101001000 #b1)))

(declare-const arg2 (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b101100000011001 #b1)
                arg2
                (fp #b1 #b100100000000111 #b0)))
(assert (fp.leq (fp #b1 #b100100000000111 #b0)
                arg2
                (fp #b0 #b110011011000001 #b0)))

(declare-const arg3 (_ FloatingPoint 15 2))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b110100111111100 #b1)
                expect
                (fp #b0 #b101011011010011 #b0)))
(assert (fp.leq (fp #b0 #b101011011010011 #b0)
                expect
                (fp #b0 #b111110101110011 #b0)))

(assert (= expect result))

(check-sat)
(exit)
