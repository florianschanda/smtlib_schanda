(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11001110111001 #b000)
                arg3
                (fp #b1 #b10000000000011 #b000)))
(assert (fp.leq (fp #b1 #b10000000000011 #b000)
                arg3
                (fp #b0 #b00010101000000 #b100)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11111111111111 #b000)
                expect
                (fp #b1 #b11111111111110 #b111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b111)
                expect
                (fp #b1 #b01001011011101 #b110)))

(assert (not (= expect result)))

