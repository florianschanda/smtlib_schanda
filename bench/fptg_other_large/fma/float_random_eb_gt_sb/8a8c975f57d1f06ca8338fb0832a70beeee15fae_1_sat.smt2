; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 9))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b1 #b111100011010010001 #b00110110)
                arg2
                (fp #b1 #b000000000000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b01111101)
                arg2
                (fp #b0 #b000111011110100101 #b10111010)))

(declare-const arg3 (_ FloatingPoint 18 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b100110000010011011 #b11101100)
                arg3
                (fp #b1 #b000000000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b00000000)
                arg3
                (fp #b0 #b001111010010111000 #b00100110)))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
