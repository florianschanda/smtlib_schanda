(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110110010011 #b111010000)
                arg1
                (fp #b1 #b100010000101 #b001100101)))
(assert (fp.leq (fp #b1 #b100010000101 #b001100101)
                arg1
                (fp #b1 #b000111010001 #b100001001)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111000010111 #b001111011)
                arg3
                (fp #b1 #b100000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b100000001001 #b000000000)
                arg3
                (fp #b0 #b101110010010 #b010000000)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110010000110 #b000111010)
                expect
                (fp #b1 #b100100001011 #b011011101)))
(assert (fp.leq (fp #b1 #b100100001011 #b011011101)
                expect
                (fp #b1 #b000011011011 #b010011010)))

(assert (not (= expect result)))

(check-sat)
(exit)
