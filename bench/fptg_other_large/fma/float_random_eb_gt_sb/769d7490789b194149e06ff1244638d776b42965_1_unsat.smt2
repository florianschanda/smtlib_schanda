; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b11010000000001 #b11001001)
                arg1
                (fp #b0 #b00011010001011 #b01000000)))
(assert (fp.leq (fp #b0 #b00011010001011 #b01000000)
                arg1
                (fp #b0 #b00101101001010 #b00110111)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 14 9))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b00111101000000 #b00100010)
                arg3
                (fp #b1 #b00000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000000)
                arg3
                (fp #b0 #b11110101100001 #b01000000)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b10100000011100 #b10101000)
                expect
                (fp #b1 #b00000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00000000)
                expect
                (fp #b0 #b01010010010110 #b10000001)))

(assert (not (= expect result)))

(check-sat)
(exit)
