(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b00100100111001 #b1101111)
                arg1
                (fp #b0 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111)
                arg1
                (fp #b0 #b11111111111111 #b0000000)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01101111101110 #b1100111)
                arg2
                (fp #b1 #b00000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1101110)
                arg2
                (fp #b0 #b11010001001101 #b1110011)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b00011001010010 #b0100100)
                arg3
                (fp #b0 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111)
                arg3
                (fp #b0 #b11111111111111 #b0000000)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b00101110000001 #b0011001)
                expect
                (fp #b0 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b1111111)
                expect
                (fp #b0 #b11111111111111 #b0000000)))

(assert (= expect result))

(check-sat)
(exit)
