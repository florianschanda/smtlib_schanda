(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110110001 #b1001101)
                arg1
                (fp #b1 #b1100001011 #b0100111)))
(assert (fp.leq (fp #b1 #b1100001011 #b0100111)
                arg1
                (fp #b0 #b0110001100 #b0100011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001100101 #b0110101)
                arg2
                (fp #b1 #b0111010011 #b0011001)))
(assert (fp.leq (fp #b1 #b0111010011 #b0011001)
                arg2
                (fp #b0 #b1011011100 #b0111001)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0010100000 #b0100010)
                arg3
                (fp #b0 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b0000000)
                arg3
                (fp #b0 #b1011111010 #b0000000)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0110111110 #b0000111)
                expect
                (fp #b0 #b1011011111 #b1001000)))
(assert (fp.leq (fp #b0 #b1011011111 #b1001000)
                expect
                (fp #b0 #b1101001101 #b0100111)))

(assert (= expect result))

(check-sat)
(exit)
