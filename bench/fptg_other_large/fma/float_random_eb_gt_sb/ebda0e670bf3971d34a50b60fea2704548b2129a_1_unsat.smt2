(assert (fp.leq (fp #b1 #b11101011100 #b010)
                arg3
                (fp #b0 #b00001110100 #b101)))
(assert (fp.leq (fp #b0 #b00001110100 #b101)
                arg3
                (fp #b0 #b10110110110 #b000)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111111111 #b000)
                expect
                (fp #b1 #b11111111110 #b111)))
(assert (fp.leq (fp #b1 #b11111111110 #b111)
                expect
                (fp #b0 #b10110010100 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
