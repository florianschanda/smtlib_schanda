(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0100111100 #b00)
                arg1
                (fp #b0 #b0001111111 #b00)))
(assert (fp.leq (fp #b0 #b0001111111 #b00)
                arg1
                (fp #b0 #b0010011101 #b01)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b1000110101 #b00)
                arg2
                (fp #b0 #b1111111101 #b00)))
(assert (fp.leq (fp #b0 #b1111111101 #b00)
                arg2
                (fp #b0 #b1111111110 #b01)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1011011011 #b11)
                arg3
                (fp #b1 #b1000000010 #b00)))
(assert (fp.leq (fp #b1 #b1000000010 #b00)
                arg3
                (fp #b0 #b0101000001 #b01)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1000010001 #b00)
                expect
                (fp #b0 #b1001111100 #b11)))
(assert (fp.leq (fp #b0 #b1001111100 #b11)
                expect
                (fp #b0 #b1101100111 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
