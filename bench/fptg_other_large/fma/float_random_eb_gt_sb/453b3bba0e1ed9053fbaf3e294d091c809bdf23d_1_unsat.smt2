;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111110011 #b01010)
                arg1
                (fp #b0 #b111101001 #b01100)))
(assert (fp.leq (fp #b0 #b111101001 #b01100)
                arg1
                (fp #b0 #b111110010 #b10000)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110001010 #b01010)
                arg2
                (fp #b0 #b000000000 #b01000)))
(assert (fp.leq (fp #b0 #b000000000 #b01000)
                arg2
                (fp #b0 #b011101010 #b10010)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b100101011 #b10000)
                arg3
                (fp #b1 #b100000101 #b00000)))
(assert (fp.leq (fp #b1 #b100000101 #b00000)
                arg3
                (fp #b0 #b101110100 #b10001)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111010011 #b11101)
                expect
                (fp #b1 #b100000100 #b11111)))
(assert (fp.leq (fp #b1 #b100000100 #b11111)
                expect
                (fp #b0 #b111010101 #b01101)))

(assert (not (= expect result)))

(check-sat)
(exit)
