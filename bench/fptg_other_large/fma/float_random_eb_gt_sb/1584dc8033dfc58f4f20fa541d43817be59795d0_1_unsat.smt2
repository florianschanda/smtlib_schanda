(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b001011110111 #b00)
                arg1
                (fp #b0 #b000000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000000 #b10)
                arg1
                (fp #b0 #b101110001000 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b100111001111 #b10)
                arg2
                (fp #b0 #b000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000 #b01)
                arg2
                (fp #b0 #b000111101001 #b00)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b100100010010 #b00)
                arg3
                (fp #b1 #b000000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000000 #b00)
                arg3
                (fp #b0 #b101110100101 #b11)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b101110010011 #b01)
                expect
                (fp #b0 #b000000000000 #b00)))
(assert (fp.leq (fp #b0 #b000000000000 #b00)
                expect
                (fp #b0 #b100000100010 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
