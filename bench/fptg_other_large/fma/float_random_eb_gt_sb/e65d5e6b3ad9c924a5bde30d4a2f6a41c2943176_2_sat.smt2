(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11011010100 #b11101)
                arg1
                (fp #b1 #b10000000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000000101 #b00000)
                arg1
                (fp #b0 #b10110010100 #b11110)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111111 #b00000)
                arg2
                (fp #b1 #b11111111110 #b11111)))
(assert (fp.leq (fp #b1 #b11111111110 #b11111)
                arg2
                (fp #b0 #b11111010110 #b11101)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111110110 #b01101)
                arg3
                (fp #b1 #b11101111011 #b00000)))
(assert (fp.leq (fp #b1 #b11101111011 #b00000)
                arg3
                (fp #b1 #b11000110101 #b11001)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
