(assert (fp.leq (fp #b1 #b11110110011 #b01)
                arg2
                (fp #b0 #b11101010011 #b10)))

(declare-const arg3 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b0 #b00101001110 #b00)
                arg3
                (fp #b0 #b00101010001 #b01)))
(assert (fp.leq (fp #b0 #b00101010001 #b01)
                arg3
                (fp #b0 #b10100111111 #b10)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11010011110 #b01)
                expect
                (fp #b0 #b11110110110 #b10)))
(assert (fp.leq (fp #b0 #b11110110110 #b10)
                expect
                (fp #b0 #b11110111011 #b01)))

(assert (not (= expect result)))

(check-sat)
(exit)
