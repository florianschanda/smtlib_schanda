;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b001111100001 #b1000)
                arg1
                (fp #b0 #b100000000100 #b0000)))
(assert (fp.leq (fp #b0 #b100000000100 #b0000)
                arg1
                (fp #b0 #b110101011010 #b0100)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b110001111010 #b1101)
                arg2
                (fp #b1 #b000000000000 #b1110)))
(assert (fp.leq (fp #b1 #b000000000000 #b1110)
                arg2
                (fp #b0 #b001011101111 #b1000)))

(declare-const arg3 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111111111110 #b1010)
                arg3
                (fp #b1 #b111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111111101 #b0000)
                arg3
                (fp #b0 #b011001100000 #b0111)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111111111101 #b1000)
                expect
                (fp #b1 #b111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b111111111101 #b0000)
                expect
                (fp #b0 #b110010010010 #b1000)))

(assert (not (= expect result)))

(check-sat)
(exit)
