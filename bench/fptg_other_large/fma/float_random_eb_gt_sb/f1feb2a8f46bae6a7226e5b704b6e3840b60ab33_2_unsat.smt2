(assert (fp.leq (fp #b1 #b1110000110 #b101111)
                arg2
                (fp #b1 #b0011000100 #b100000)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1010100111 #b111101)
                arg3
                (fp #b1 #b0000000000 #b010000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000)
                arg3
                (fp #b0 #b0011100011 #b001011)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
