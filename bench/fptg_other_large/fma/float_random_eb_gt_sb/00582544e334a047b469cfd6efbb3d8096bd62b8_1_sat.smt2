; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +ZERO
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b011000100111 #b1)
                arg1
                (fp #b0 #b000000000000 #b0)))
(assert (fp.leq (fp #b0 #b000000000000 #b0)
                arg1
                (fp #b0 #b101001110111 #b1)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b000110011001 #b0)
                arg2
                (fp #b0 #b000000000000 #b0)))
(assert (fp.leq (fp #b0 #b000000000000 #b0)
                arg2
                (fp #b0 #b111100101010 #b0)))

(declare-const arg3 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b011111110110 #b0)
                arg3
                (fp #b1 #b000000000000 #b1)))
(assert (fp.leq (fp #b1 #b000000000000 #b1)
                arg3
                (fp #b0 #b110011010010 #b0)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b101001100110 #b0)
                expect
                (fp #b1 #b000000000000 #b1)))
(assert (fp.leq (fp #b1 #b000000000000 #b1)
                expect
                (fp #b0 #b010100000100 #b0)))

(assert (= expect result))

(check-sat)
(exit)
