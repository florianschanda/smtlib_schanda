;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111101001 #b10010)
                arg1
                (fp #b1 #b01111100100 #b10001)))
(assert (fp.leq (fp #b1 #b01111100100 #b10001)
                arg1
                (fp #b0 #b01000101001 #b10011)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b00000111110 #b11000)
                arg2
                (fp #b0 #b00010101001 #b11001)))
(assert (fp.leq (fp #b0 #b00010101001 #b11001)
                arg2
                (fp #b0 #b11011001100 #b01010)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111110 #b01111)
                arg3
                (fp #b1 #b11111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000)
                arg3
                (fp #b1 #b10001010010 #b01100)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111111101 #b10111)
                expect
                (fp #b1 #b11111111101 #b00000)))
(assert (fp.leq (fp #b1 #b11111111101 #b00000)
                expect
                (fp #b1 #b00001011100 #b11101)))

(assert (= expect result))

(check-sat)
(exit)
