(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000110011 #b0001)
                arg1
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg1
                (fp #b0 #b101000110 #b0100)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110010100 #b0000)
                arg2
                (fp #b0 #b000000000 #b0111)))
(assert (fp.leq (fp #b0 #b000000000 #b0111)
                arg2
                (fp #b0 #b011001001 #b1101)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b101110010 #b1100)
                arg3
                (fp #b0 #b110001111 #b0101)))
(assert (fp.leq (fp #b0 #b110001111 #b0101)
                arg3
                (fp #b0 #b110111101 #b1101)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100000000 #b1101)
                expect
                (fp #b0 #b110001111 #b0101)))
(assert (fp.leq (fp #b0 #b110001111 #b0101)
                expect
                (fp #b0 #b110011100 #b1000)))

(assert (= expect result))

(check-sat)
(exit)
