; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -INFINITY
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b001010101100 #b01010111)
                arg1
                (fp #b0 #b000000000000 #b01000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b01000000)
                arg1
                (fp #b0 #b011111110000 #b11110111)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b0 #b000111101101 #b01100010)
                arg3
                (fp #b0 #b111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000000)
                arg3
                (fp #b0 #b111111111101 #b11111000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
