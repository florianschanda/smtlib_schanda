(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010101010111 #b011)
                arg2
                (fp #b0 #b111111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111)
                arg2
                (fp #b0 #b111111111111 #b000)))

(declare-const arg3 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b010100101000 #b101)
                arg3
                (fp #b0 #b100000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000011 #b000)
                arg3
                (fp #b0 #b110011100100 #b100)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
