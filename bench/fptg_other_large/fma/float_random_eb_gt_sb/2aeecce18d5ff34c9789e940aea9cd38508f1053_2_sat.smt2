(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10010010101 #b1)
                arg1
                (fp #b1 #b10000000001 #b0)))
(assert (fp.leq (fp #b1 #b10000000001 #b0)
                arg1
                (fp #b0 #b10010010101 #b1)))

(declare-const arg2 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b01100110111 #b1)
                arg2
                (fp #b0 #b11111111110 #b0)))
(assert (fp.leq (fp #b0 #b11111111110 #b0)
                arg2
                (fp #b0 #b11111111111 #b0)))

(declare-const arg3 (_ FloatingPoint 11 2))
(assert (fp.leq (fp #b1 #b10000010111 #b0)
                arg3
                (fp #b1 #b00000000000 #b1)))
(assert (fp.leq (fp #b1 #b00000000000 #b1)
                arg3
                (fp #b0 #b01010100000 #b0)))

(declare-const result (_ FloatingPoint 11 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
