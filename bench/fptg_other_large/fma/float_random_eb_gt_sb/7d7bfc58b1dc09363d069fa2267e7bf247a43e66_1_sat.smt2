(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10110001011011 #b0101001)
                arg2
                (fp #b0 #b01100001000101 #b0000000)))
(assert (fp.leq (fp #b0 #b01100001000101 #b0000000)
                arg2
                (fp #b0 #b11010101000110 #b0100100)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01111011001111 #b1000001)
                arg3
                (fp #b0 #b00000000000000 #b1000110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1000110)
                arg3
                (fp #b0 #b10100010101101 #b0010101)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
