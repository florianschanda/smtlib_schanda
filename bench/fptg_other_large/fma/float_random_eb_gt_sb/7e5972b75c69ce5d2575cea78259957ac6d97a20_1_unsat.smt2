;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 4))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b0 #b0011111001101 #b101)
                arg2
                (fp #b0 #b1000000000011 #b000)))
(assert (fp.leq (fp #b0 #b1000000000011 #b000)
                arg2
                (fp #b0 #b1101101001011 #b010)))

(declare-const arg3 (_ FloatingPoint 13 4))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
