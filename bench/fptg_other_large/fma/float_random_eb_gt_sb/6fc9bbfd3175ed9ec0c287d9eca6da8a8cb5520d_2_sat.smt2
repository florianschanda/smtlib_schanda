; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b010011010011 #b1110)
                arg1
                (fp #b0 #b010010011001 #b0110)))
(assert (fp.leq (fp #b0 #b010010011001 #b0110)
                arg1
                (fp #b0 #b100111011001 #b0000)))

(declare-const arg2 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b100101001101 #b0100)
                arg2
                (fp #b1 #b100000000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000000100 #b0000)
                arg2
                (fp #b0 #b000111001111 #b1101)))

(declare-const arg3 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111100110111 #b1011)
                arg3
                (fp #b0 #b001011011001 #b1100)))
(assert (fp.leq (fp #b0 #b001011011001 #b1100)
                arg3
                (fp #b0 #b100001111000 #b1110)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b011110111001 #b1001)
                expect
                (fp #b1 #b010010011110 #b0110)))
(assert (fp.leq (fp #b1 #b010010011110 #b0110)
                expect
                (fp #b0 #b110011100110 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
