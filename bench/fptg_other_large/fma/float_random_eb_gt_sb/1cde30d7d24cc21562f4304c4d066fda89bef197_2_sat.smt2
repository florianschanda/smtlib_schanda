(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b010110000001101 #b11111)
                arg1
                (fp #b0 #b101010101010110 #b10011)))
(assert (fp.leq (fp #b0 #b101010101010110 #b10011)
                arg1
                (fp #b0 #b111011001111111 #b01010)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111111111111110 #b01001)
                arg2
                (fp #b1 #b111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00000)
                arg2
                (fp #b0 #b101111001001011 #b00001)))

(declare-const arg3 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111111111111101 #b10011)
                arg3
                (fp #b1 #b111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111111101 #b00000)
                arg3
                (fp #b0 #b010100111011101 #b00110)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
