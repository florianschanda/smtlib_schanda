(assert (fp.leq (fp #b1 #b00000000000 #b0111011)
                arg3
                (fp #b0 #b11111110000 #b1101101)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10111010101 #b1011111)
                expect
                (fp #b1 #b00000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b00000000000 #b0111011)
                expect
                (fp #b0 #b11011010110 #b0101000)))

(assert (= expect result))

(check-sat)
(exit)
