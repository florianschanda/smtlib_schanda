; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10100111100 #b101101)
                arg1
                (fp #b1 #b00000000000 #b010000)))
(assert (fp.leq (fp #b1 #b00000000000 #b010000)
                arg1
                (fp #b0 #b01001011100 #b101010)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b01011011001 #b111010)
                arg2
                (fp #b0 #b11111111110 #b111111)))
(assert (fp.leq (fp #b0 #b11111111110 #b111111)
                arg2
                (fp #b0 #b11111111111 #b000000)))

(declare-const arg3 (_ FloatingPoint 11 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
