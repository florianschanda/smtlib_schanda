(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 11))
(assert (fp.leq (fp #b0 #b0111001110001 #b1011110101)
                arg1
                (fp #b0 #b1011100010100 #b0011011000)))
(assert (fp.leq (fp #b0 #b1011100010100 #b0011011000)
                arg1
                (fp #b0 #b1110011100100 #b1110000111)))

(declare-const arg2 (_ FloatingPoint 13 11))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 13 11))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 13 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 11))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
