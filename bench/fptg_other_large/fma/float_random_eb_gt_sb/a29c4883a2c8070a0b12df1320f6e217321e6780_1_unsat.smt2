                (fp #b0 #b111111101 #b0101)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b001101100 #b1100)
                expect
                (fp #b0 #b111111101 #b0000)))
(assert (fp.leq (fp #b0 #b111111101 #b0000)
                expect
