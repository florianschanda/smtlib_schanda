; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0011111010 #b01)
                arg1
                (fp #b1 #b0000000000 #b01)))
(assert (fp.leq (fp #b1 #b0000000000 #b01)
                arg1
                (fp #b0 #b1111000011 #b11)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1111111101 #b11)
                arg2
                (fp #b1 #b1111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111101 #b00)
                arg2
                (fp #b0 #b0101100001 #b11)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1011011000 #b00)
                arg3
                (fp #b0 #b0000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000 #b00)
                arg3
                (fp #b0 #b1101000110 #b00)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b0 #b0001000100 #b00)
                expect
                (fp #b0 #b0111111101 #b00)))
(assert (fp.leq (fp #b0 #b0111111101 #b00)
                expect
                (fp #b0 #b1011000101 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
