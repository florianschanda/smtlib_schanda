; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b011000000100110 #b0100100)
                arg1
                (fp #b1 #b000000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000)
                arg1
                (fp #b0 #b110011101010001 #b0010111)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101010111010111 #b1111001)
                arg2
                (fp #b1 #b100000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b100000000000111 #b0000000)
                arg2
                (fp #b0 #b001110000001111 #b1001001)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
