(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -ZERO
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b010001101 #b001101)
                arg1
                (fp #b1 #b010000110 #b010111)))
(assert (fp.leq (fp #b1 #b010000110 #b010111)
                arg1
                (fp #b0 #b001000100 #b100111)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b001100110 #b111001)
                arg2
                (fp #b1 #b000000000 #b000000)))
(assert (fp.leq (fp #b1 #b000000000 #b000000)
                arg2
                (fp #b0 #b000111100 #b011110)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
