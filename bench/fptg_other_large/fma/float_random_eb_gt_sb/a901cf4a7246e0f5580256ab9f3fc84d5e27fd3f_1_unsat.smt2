(declare-const expect (_ FloatingPoint 17 15))
(assert (fp.leq (fp #b1 #b10100001000100110 #b11011000011100)
                expect
                (fp #b1 #b01000101000010010 #b10000100101100)))
(assert (fp.leq (fp #b1 #b01000101000010010 #b10000100101100)
                expect
                (fp #b1 #b00001100110011111 #b10101110110111)))

(assert (not (= expect result)))

(check-sat)
