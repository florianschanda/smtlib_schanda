(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b010000111 #b100101)
                arg1
                (fp #b1 #b010000110 #b010111)))
(assert (fp.leq (fp #b1 #b010000110 #b010111)
                arg1
                (fp #b0 #b100101010 #b000110)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101100101 #b111000)
                arg2
                (fp #b0 #b000000000 #b011111)))
(assert (fp.leq (fp #b0 #b000000000 #b011111)
                arg2
                (fp #b0 #b011010110 #b110001)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b100000111 #b111000)
                arg3
                (fp #b0 #b000000000 #b000000)))
(assert (fp.leq (fp #b0 #b000000000 #b000000)
                arg3
                (fp #b0 #b111100110 #b001010)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b001101111 #b000100)
                expect
                (fp #b1 #b000000000 #b000001)))
(assert (fp.leq (fp #b1 #b000000000 #b000001)
                expect
                (fp #b0 #b001100100 #b100111)))

(assert (= expect result))

(check-sat)
(exit)
