(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111000010111010 #b010000)
                arg1
                (fp #b0 #b0001001110110010 #b000000)))
(assert (fp.leq (fp #b0 #b0001001110110010 #b000000)
                arg1
                (fp #b0 #b1001110110111111 #b101110)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111101 #b001110)
                arg3
                (fp #b1 #b1111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000000)
                arg3
                (fp #b0 #b0011110100000011 #b100000)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111101 #b101001)
                expect
                (fp #b1 #b1111111111111100 #b111111)))
(assert (fp.leq (fp #b1 #b1111111111111100 #b111111)
                expect
                (fp #b0 #b0111000111010111 #b111010)))

(assert (not (= expect result)))

(check-sat)
(exit)
