; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b011011000 #b1110011)
                arg1
                (fp #b0 #b100000111 #b0000000)))
(assert (fp.leq (fp #b0 #b100000111 #b0000000)
                arg1
                (fp #b0 #b101001100 #b0111101)))

(declare-const arg2 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b010100011 #b0000101)
                arg2
                (fp #b0 #b011111101 #b1111001)))
(assert (fp.leq (fp #b0 #b011111101 #b1111001)
                arg2
                (fp #b0 #b110100010 #b0010101)))

(declare-const arg3 (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b1 #b100110000 #b0000100)
                arg3
                (fp #b1 #b000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b000000000 #b0111011)
                arg3
                (fp #b0 #b011101110 #b0111110)))

(declare-const result (_ FloatingPoint 9 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 8))
(assert (fp.leq (fp #b0 #b000000011 #b0010100)
                expect
                (fp #b0 #b100000101 #b1111000)))
(assert (fp.leq (fp #b0 #b100000101 #b1111000)
                expect
                (fp #b0 #b110000110 #b1001111)))

(assert (= expect result))

(check-sat)
(exit)
