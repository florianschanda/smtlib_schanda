(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111111111 #b00000)
                arg1
                (fp #b1 #b1111111110 #b11111)))
(assert (fp.leq (fp #b1 #b1111111110 #b11111)
                arg1
                (fp #b1 #b0110101001 #b10000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100001101 #b01000)
                arg2
                (fp #b0 #b1000000101 #b00000)))
(assert (fp.leq (fp #b0 #b1000000101 #b00000)
                arg2
                (fp #b0 #b1001011101 #b00011)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1001000000 #b01100)
                arg3
                (fp #b1 #b0000000000 #b00000)))
(assert (fp.leq (fp #b1 #b0000000000 #b00000)
                arg3
                (fp #b0 #b0111101001 #b10011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
