(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0100000100 #b01100)
                arg1
                (fp #b0 #b1111111110 #b11111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111)
                arg1
                (fp #b0 #b1111111111 #b00000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1100011100 #b01101)
                arg2
                (fp #b1 #b0010011100 #b00011)))
(assert (fp.leq (fp #b1 #b0010011100 #b00011)
                arg2
                (fp #b0 #b0010110101 #b10111)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011011111 #b01111)
                expect
                (fp #b1 #b1010011100 #b00010)))
(assert (fp.leq (fp #b1 #b1010011100 #b00010)
                expect
                (fp #b0 #b1110110110 #b11000)))

(assert (= expect result))

(check-sat)
(exit)
