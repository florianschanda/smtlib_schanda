(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11101111001011 #b11101)
                arg1
                (fp #b1 #b10000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000000000101 #b00000)
                arg1
                (fp #b0 #b10000110111101 #b10000)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11111000000011 #b00000)
                arg2
                (fp #b0 #b00000111000101 #b11000)))
(assert (fp.leq (fp #b0 #b00000111000101 #b11000)
                arg2
                (fp #b0 #b11111100101000 #b00001)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
