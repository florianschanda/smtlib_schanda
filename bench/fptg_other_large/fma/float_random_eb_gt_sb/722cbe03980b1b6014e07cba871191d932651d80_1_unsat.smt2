                arg3
                (fp #b0 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000111 #b0000000)
                arg3
                (fp #b0 #b1100000111 #b0110111)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101100010 #b1000011)
                expect
                (fp #b1 #b1000101101 #b1011010)))
(assert (fp.leq (fp #b1 #b1000101101 #b1011010)
                expect
                (fp #b1 #b0101010101 #b1011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
