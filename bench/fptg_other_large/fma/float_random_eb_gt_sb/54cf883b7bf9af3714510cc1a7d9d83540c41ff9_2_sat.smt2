                arg3
                (fp #b1 #b1000000000001100 #b000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001100 #b000000000000)
                arg3
                (fp #b1 #b0110110010001110 #b110100011111)))

(declare-const result (_ FloatingPoint 16 13))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 13))
(assert (fp.leq (fp #b1 #b1111110010011010 #b111110001010)
                expect
                (fp #b1 #b1000000000001100 #b000000000000)))
(assert (fp.leq (fp #b1 #b1000000000001100 #b000000000000)
                expect
                (fp #b0 #b0111110110110111 #b010111101111)))

(assert (= expect result))

(check-sat)
(exit)
