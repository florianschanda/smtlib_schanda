(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b001110011010000 #b00)
                arg1
                (fp #b0 #b100000000000010 #b00)))
(assert (fp.leq (fp #b0 #b100000000000010 #b00)
                arg1
                (fp #b0 #b110010001000001 #b01)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b110101101111010 #b10)
                arg2
                (fp #b1 #b000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01)
                arg2
                (fp #b0 #b110000001101101 #b01)))

(declare-const arg3 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b010101110111010 #b11)
                arg3
                (fp #b0 #b110101000010011 #b01)))
(assert (fp.leq (fp #b0 #b110101000010011 #b01)
                arg3
                (fp #b0 #b110101000100001 #b01)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000101111110111 #b10)
                expect
                (fp #b0 #b110101000010011 #b00)))
(assert (fp.leq (fp #b0 #b110101000010011 #b00)
                expect
                (fp #b0 #b111010100110110 #b00)))

(assert (= expect result))

(check-sat)
(exit)
