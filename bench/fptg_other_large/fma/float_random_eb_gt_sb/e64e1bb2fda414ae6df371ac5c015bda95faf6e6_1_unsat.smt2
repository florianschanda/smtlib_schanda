                arg3
                (fp #b0 #b000000000000000000 #b101)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b101)
                arg3
                (fp #b0 #b101001101000110000 #b001)))

(declare-const result (_ FloatingPoint 18 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 4))
(assert (fp.leq (fp #b0 #b001111000111101110 #b000)
                expect
                (fp #b0 #b111111111111111110 #b111)))
(assert (fp.leq (fp #b0 #b111111111111111110 #b111)
                expect
                (fp #b0 #b111111111111111111 #b000)))

(assert (not (= expect result)))

