; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b0 #b10011101101 #b0000)
                arg1
                (fp #b0 #b11111111101 #b0000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000)
                arg1
                (fp #b0 #b11111111101 #b0001)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00000110001 #b0011)
                arg2
                (fp #b0 #b10000000100 #b0000)))
(assert (fp.leq (fp #b0 #b10000000100 #b0000)
                arg2
                (fp #b0 #b10001001011 #b1100)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b00010001000 #b0000)
                arg3
                (fp #b0 #b11111111110 #b1111)))
(assert (fp.leq (fp #b0 #b11111111110 #b1111)
                arg3
                (fp #b0 #b11111111111 #b0000)))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
