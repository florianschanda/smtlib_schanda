(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b00010100000 #b101)
                arg1
                (fp #b1 #b00000000000 #b000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000)
                arg1
                (fp #b0 #b11011100111 #b010)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11011011110 #b000)
                arg2
                (fp #b1 #b00000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000 #b010)
                arg2
                (fp #b0 #b10000011101 #b100)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b01110110101 #b000)
                arg3
                (fp #b1 #b00000000000 #b100)))
(assert (fp.leq (fp #b1 #b00000000000 #b100)
                arg3
                (fp #b0 #b01000101001 #b010)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11100101011 #b001)
                expect
                (fp #b1 #b00000000000 #b100)))
(assert (fp.leq (fp #b1 #b00000000000 #b100)
                expect
                (fp #b0 #b11011111101 #b111)))

(assert (= expect result))

(check-sat)
(exit)
