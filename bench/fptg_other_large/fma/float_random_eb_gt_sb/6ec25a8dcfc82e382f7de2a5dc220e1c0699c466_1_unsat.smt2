; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111110001110 #b111000)
                arg2
                (fp #b1 #b000000000000 #b101100)))
(assert (fp.leq (fp #b1 #b000000000000 #b101100)
                arg2
                (fp #b0 #b101101011001 #b001101)))

(declare-const arg3 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b110000111010 #b000010)
                arg3
                (fp #b0 #b100000000110 #b000000)))
(assert (fp.leq (fp #b0 #b100000000110 #b000000)
                arg3
                (fp #b0 #b100110000011 #b010110)))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
