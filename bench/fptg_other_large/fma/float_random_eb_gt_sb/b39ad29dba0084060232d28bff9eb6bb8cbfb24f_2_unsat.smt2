(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b000110001 #b0)
                arg1
                (fp #b0 #b111111101 #b0)))
(assert (fp.leq (fp #b0 #b111111101 #b0)
                arg1
                (fp #b0 #b111111101 #b1)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111111110 #b1)
                arg2
                (fp #b1 #b111111110 #b0)))
(assert (fp.leq (fp #b1 #b111111110 #b0)
                arg2
                (fp #b1 #b000000001 #b0)))

(declare-const arg3 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b111111111 #b0)
                arg3
                (fp #b1 #b111111101 #b0)))
(assert (fp.leq (fp #b1 #b111111101 #b0)
                arg3
                (fp #b1 #b001100111 #b0)))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
