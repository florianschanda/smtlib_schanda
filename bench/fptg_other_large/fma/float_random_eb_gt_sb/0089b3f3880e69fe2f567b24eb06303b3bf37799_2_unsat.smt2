                arg2
                (fp #b1 #b1111111111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b00)
                arg2
                (fp #b1 #b0011000111010101 #b00)))

(declare-const arg3 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1011100000001011 #b10)
                arg3
                (fp #b0 #b1000000000000010 #b00)))
(assert (fp.leq (fp #b0 #b1000000000000010 #b00)
                arg3
                (fp #b0 #b1110010110111110 #b00)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
