(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0010100001 #b1100010)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b1001100001 #b1100111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101101110 #b0011110)
                arg2
                (fp #b1 #b1000011110 #b1111100)))
(assert (fp.leq (fp #b1 #b1000011110 #b1111100)
                arg2
                (fp #b1 #b0011000101 #b0011111)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0101001011 #b1001011)
                expect
                (fp #b0 #b1000011110 #b1111100)))
(assert (fp.leq (fp #b0 #b1000011110 #b1111100)
                expect
                (fp #b0 #b1100111010 #b1001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
