(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0000010010 #b001)
                arg1
                (fp #b0 #b1111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000)
                arg1
                (fp #b0 #b1111111110 #b110)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110101111 #b101)
                arg2
                (fp #b1 #b0000000000 #b101)))
(assert (fp.leq (fp #b1 #b0000000000 #b101)
                arg2
                (fp #b0 #b0110001101 #b101)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1100111001 #b000)
                arg3
                (fp #b0 #b0000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000)
                arg3
                (fp #b0 #b0110000111 #b000)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010011111 #b010)
                expect
                (fp #b1 #b0111111110 #b010)))
(assert (fp.leq (fp #b1 #b0111111110 #b010)
                expect
                (fp #b0 #b0010111010 #b110)))

(assert (= expect result))

(check-sat)
(exit)
