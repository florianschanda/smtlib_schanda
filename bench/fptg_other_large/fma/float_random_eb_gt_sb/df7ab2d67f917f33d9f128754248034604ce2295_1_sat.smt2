(assert (fp.leq (fp #b1 #b1111111111101 #b0000)
                arg2
                (fp #b0 #b1000001111110 #b0101)))

(declare-const arg3 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b0111100101011 #b0001)
                arg3
                (fp #b0 #b0000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0100)
                arg3
                (fp #b0 #b0011101011111 #b1111)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b0101101111111 #b0100)
                expect
                (fp #b0 #b0000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000 #b0100)
                expect
                (fp #b0 #b0011001011100 #b0100)))

(assert (= expect result))

(check-sat)
(exit)
