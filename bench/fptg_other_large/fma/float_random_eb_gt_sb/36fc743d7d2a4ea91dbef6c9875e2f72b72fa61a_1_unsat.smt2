; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0110111111 #b010)
                arg1
                (fp #b1 #b0010100101 #b000)))
(assert (fp.leq (fp #b1 #b0010100101 #b000)
                arg1
                (fp #b0 #b0001110000 #b111)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1100111001 #b101)
                arg2
                (fp #b0 #b1111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111)
                arg2
                (fp #b0 #b1111111111 #b000)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0001101010 #b000)
                arg3
                (fp #b0 #b0000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000)
                arg3
                (fp #b0 #b0111111011 #b100)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1011010011 #b101)
                expect
                (fp #b1 #b1010100100 #b111)))
(assert (fp.leq (fp #b1 #b1010100100 #b111)
                expect
                (fp #b0 #b1010101101 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
