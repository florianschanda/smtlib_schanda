(declare-const arg3 (_ FloatingPoint 13 10))
(assert (fp.leq (fp #b1 #b1110011101001 #b001000000)
                arg3
                (fp #b1 #b1000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b1000000001001 #b000000000)
                arg3
                (fp #b1 #b0011110010000 #b110110100)))

(declare-const result (_ FloatingPoint 13 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
