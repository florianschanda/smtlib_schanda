; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b011011000110111010 #b10)
                arg1
                (fp #b0 #b010010001000000000 #b00)))
(assert (fp.leq (fp #b0 #b010010001000000000 #b00)
                arg1
                (fp #b0 #b100010111101111010 #b00)))

(declare-const arg2 (_ FloatingPoint 18 3))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b100101001111001101 #b10)
                arg3
                (fp #b1 #b100000000000000010 #b00)))
(assert (fp.leq (fp #b1 #b100000000000000010 #b00)
                arg3
                (fp #b1 #b000010001101001110 #b10)))

(declare-const result (_ FloatingPoint 18 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 3))
(assert (fp.leq (fp #b1 #b101010101111011110 #b01)
                expect
                (fp #b1 #b100000000000000010 #b00)))
(assert (fp.leq (fp #b1 #b100000000000000010 #b00)
                expect
                (fp #b0 #b100111000111001000 #b10)))

(assert (not (= expect result)))

(check-sat)
(exit)
