                (fp #b0 #b000000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b000000000000 #b0100000)
                arg2
                (fp #b0 #b010110111110 #b0110111)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111110 #b1000000)
                arg3
                (fp #b1 #b111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b0000000)
                arg3
                (fp #b1 #b101100100011 #b0011111)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111101 #b1110010)
                expect
                (fp #b1 #b111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b0000000)
                expect
                (fp #b1 #b101101000011 #b0001101)))

(assert (= expect result))

(check-sat)
(exit)
