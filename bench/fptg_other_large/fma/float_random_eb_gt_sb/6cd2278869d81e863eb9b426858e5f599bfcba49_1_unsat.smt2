(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111000011 #b10110100)
                arg1
                (fp #b1 #b1000111001 #b11001010)))
(assert (fp.leq (fp #b1 #b1000111001 #b11001010)
                arg1
                (fp #b0 #b1101011100 #b01011000)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0100111010 #b11111010)
                arg2
                (fp #b0 #b0000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000011)
                arg2
                (fp #b0 #b0111000011 #b10101011)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
