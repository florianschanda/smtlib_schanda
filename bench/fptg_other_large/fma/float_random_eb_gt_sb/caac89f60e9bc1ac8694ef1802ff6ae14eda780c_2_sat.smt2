(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -REFERENCE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 17 14))
(assert (fp.leq (fp #b1 #b11100001111111010 #b1110110101101)
                arg1
                (fp #b1 #b11011101101110100 #b1000011110001)))
(assert (fp.leq (fp #b1 #b11011101101110100 #b1000011110001)
                arg1
                (fp #b1 #b01101110111000010 #b0011101100000)))

(declare-const arg2 (_ FloatingPoint 17 14))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 17 14))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 17 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
