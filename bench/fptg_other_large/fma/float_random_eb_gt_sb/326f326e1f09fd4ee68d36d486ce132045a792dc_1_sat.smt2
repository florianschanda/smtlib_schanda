(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10100100010100 #b10011011100)
                arg2
                (fp #b1 #b10000000001011 #b00000000000)))
(assert (fp.leq (fp #b1 #b10000000001011 #b00000000000)
                arg2
                (fp #b0 #b11100110001101 #b10010100011)))

(declare-const arg3 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10100010000001 #b11010001111)
                arg3
                (fp #b1 #b00000000000000 #b10010100101)))
(assert (fp.leq (fp #b1 #b00000000000000 #b10010100101)
                arg3
                (fp #b0 #b10100101110000 #b10010110001)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
