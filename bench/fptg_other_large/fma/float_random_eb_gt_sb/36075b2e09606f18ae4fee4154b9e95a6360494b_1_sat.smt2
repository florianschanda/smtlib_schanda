(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 11))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 18 11))
(assert (fp.leq (fp #b1 #b101011000011010001 #b1110100010)
                arg2
                (fp #b1 #b101000001001110010 #b1111010011)))
(assert (fp.leq (fp #b1 #b101000001001110010 #b1111010011)
                arg2
                (fp #b0 #b001100011101001100 #b1110111110)))

(declare-const arg3 (_ FloatingPoint 18 11))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 18 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 11))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
