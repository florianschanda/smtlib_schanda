(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: -RCP_SMALLEST_NORMAL
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1010010010110110 #b011011)
                arg1
                (fp #b0 #b0000000000000000 #b000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000000)
                arg1
                (fp #b0 #b1000111111001111 #b010110)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111110 #b000000)
                arg2
                (fp #b1 #b1111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000000)
                arg2
                (fp #b0 #b1111111110001110 #b110011)))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
