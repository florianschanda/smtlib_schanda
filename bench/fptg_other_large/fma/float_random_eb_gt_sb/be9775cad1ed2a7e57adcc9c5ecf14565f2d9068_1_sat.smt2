; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100010000 #b1010)
                arg1
                (fp #b1 #b100000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000100 #b0000)
                arg1
                (fp #b0 #b110011001 #b1111)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000100011 #b1001)
                arg2
                (fp #b1 #b000000000 #b1110)))
(assert (fp.leq (fp #b1 #b000000000 #b1110)
                arg2
                (fp #b0 #b101011110 #b0011)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
