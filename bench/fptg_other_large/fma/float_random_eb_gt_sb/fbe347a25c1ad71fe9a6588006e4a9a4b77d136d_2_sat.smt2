(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000011101 #b0101)
                arg1
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg1
                (fp #b0 #b001010101 #b0000)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b100101010 #b0111)
                arg2
                (fp #b1 #b000000000 #b1110)))
(assert (fp.leq (fp #b1 #b000000000 #b1110)
                arg2
                (fp #b0 #b011111101 #b0100)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b110111110 #b0011)
                arg3
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                arg3
                (fp #b0 #b111001001 #b1101)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b000001001 #b0000)
                expect
                (fp #b0 #b000000000 #b0100)))
(assert (fp.leq (fp #b0 #b000000000 #b0100)
                expect
                (fp #b0 #b011000111 #b0110)))

(assert (= expect result))

(check-sat)
(exit)
