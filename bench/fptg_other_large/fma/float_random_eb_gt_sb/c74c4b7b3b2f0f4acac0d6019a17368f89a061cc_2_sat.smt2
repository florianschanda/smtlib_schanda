; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101111000 #b000111)
                arg1
                (fp #b1 #b100000110 #b000000)))
(assert (fp.leq (fp #b1 #b100000110 #b000000)
                arg1
                (fp #b1 #b011000000 #b110000)))

(declare-const arg2 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101110011 #b110011)
                arg2
                (fp #b0 #b010101111 #b111110)))
(assert (fp.leq (fp #b0 #b010101111 #b111110)
                arg2
                (fp #b0 #b100101010 #b011110)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100010111 #b000111)
                arg3
                (fp #b0 #b000000000 #b010001)))
(assert (fp.leq (fp #b0 #b000000000 #b010001)
                arg3
                (fp #b0 #b101100001 #b101101)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b100010011 #b011001)
                expect
                (fp #b1 #b010110110 #b111110)))
(assert (fp.leq (fp #b1 #b010110110 #b111110)
                expect
                (fp #b0 #b100000100 #b101011)))

(assert (= expect result))

(check-sat)
(exit)
