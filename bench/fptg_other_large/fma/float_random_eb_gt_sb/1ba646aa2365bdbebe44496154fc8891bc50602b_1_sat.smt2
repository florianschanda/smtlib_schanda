(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +INT_BOUNDARY
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111111 #b0000)
                arg1
                (fp #b1 #b1111111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111)
                arg1
                (fp #b1 #b0000011100 #b1000)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0111110111 #b0111)
                arg2
                (fp #b0 #b1000000100 #b0000)))
(assert (fp.leq (fp #b0 #b1000000100 #b0000)
                arg2
                (fp #b0 #b1001000101 #b0110)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b1001110011 #b0100)
                arg3
                (fp #b0 #b1111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111)
                arg3
                (fp #b0 #b1111111111 #b0000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111111 #b0000)
                expect
                (fp #b1 #b1111111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111)
                expect
                (fp #b0 #b0110101110 #b0010)))

(assert (= expect result))

(check-sat)
(exit)
