                arg3
                (fp #b1 #b1000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000000111 #b0000000)
                arg3
                (fp #b1 #b0100110000111 #b1100100)))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b1000111110110 #b1010001)
                expect
                (fp #b1 #b1000000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000000111 #b0000000)
                expect
                (fp #b1 #b0010111111100 #b1011110)))

(assert (not (= expect result)))

(check-sat)
(exit)
