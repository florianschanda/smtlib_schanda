(assert (fp.leq (fp #b1 #b010100111100111100 #b00010011)
                arg3
                (fp #b0 #b101110010101001000 #b00111100)))
(assert (fp.leq (fp #b0 #b101110010101001000 #b00111100)
                arg3
                (fp #b0 #b111100001110010101 #b10011101)))

(declare-const result (_ FloatingPoint 18 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 9))
(assert (fp.leq (fp #b0 #b100111110001100000 #b00001111)
                expect
                (fp #b0 #b101110010101001000 #b00111101)))
(assert (fp.leq (fp #b0 #b101110010101001000 #b00111101)
                expect
                (fp #b0 #b110111110010010000 #b01010000)))

(assert (= expect result))

(check-sat)
(exit)
