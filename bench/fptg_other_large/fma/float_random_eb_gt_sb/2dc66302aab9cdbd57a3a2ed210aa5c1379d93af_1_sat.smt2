                (fp #b0 #b111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111111)
                arg2
                (fp #b0 #b111111111111 #b00000000)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b110101000010 #b00011110)
                arg3
                (fp #b1 #b101011011000 #b10001101)))
(assert (fp.leq (fp #b1 #b101011011000 #b10001101)
                arg3
                (fp #b1 #b011100001101 #b00010110)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111100110111 #b11011011)
                expect
                (fp #b1 #b101011011000 #b10001101)))
(assert (fp.leq (fp #b1 #b101011011000 #b10001101)
                expect
                (fp #b0 #b000011111001 #b00110111)))

(assert (= expect result))

(check-sat)
(exit)
