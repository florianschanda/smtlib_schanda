(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111111 #b0000)
                arg1
                (fp #b1 #b1111111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111)
                arg1
                (fp #b0 #b0011101011 #b0100)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1011111001 #b0110)
                arg2
                (fp #b1 #b0010101101 #b0110)))
(assert (fp.leq (fp #b1 #b0010101101 #b0110)
                arg2
                (fp #b0 #b0000111111 #b1100)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1000000000 #b1101)
                arg3
                (fp #b1 #b0000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100)
                arg3
                (fp #b0 #b1001000011 #b1110)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1001001011 #b0110)
                expect
                (fp #b0 #b1010101101 #b0101)))
(assert (fp.leq (fp #b0 #b1010101101 #b0101)
                expect
                (fp #b0 #b1100111110 #b1110)))

(assert (not (= expect result)))

(check-sat)
(exit)
