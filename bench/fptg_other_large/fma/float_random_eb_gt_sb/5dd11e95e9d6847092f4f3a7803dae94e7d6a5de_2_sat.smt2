(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b001010100 #b010)
                arg1
                (fp #b1 #b000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000 #b010)
                arg1
                (fp #b0 #b010010011 #b010)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010101010 #b110)
                arg3
                (fp #b0 #b000000000 #b010)))
(assert (fp.leq (fp #b0 #b000000000 #b010)
                arg3
                (fp #b0 #b000110001 #b111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b000110111 #b100)
                expect
                (fp #b0 #b000000000 #b010)))
(assert (fp.leq (fp #b0 #b000000000 #b010)
                expect
                (fp #b0 #b101001010 #b011)))

(assert (= expect result))

(check-sat)
(exit)
