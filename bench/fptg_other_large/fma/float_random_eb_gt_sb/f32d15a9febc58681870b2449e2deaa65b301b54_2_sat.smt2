(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b000010001 #b01)
                arg1
                (fp #b1 #b000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000 #b01)
                arg1
                (fp #b0 #b100110001 #b00)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b010110000 #b01)
                arg2
                (fp #b0 #b000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000 #b01)
                arg2
                (fp #b0 #b000010101 #b11)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b101011000 #b11)
                arg3
                (fp #b1 #b100000010 #b00)))
(assert (fp.leq (fp #b1 #b100000010 #b00)
                arg3
                (fp #b0 #b001011011 #b01)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b110101100 #b01)
                expect
                (fp #b1 #b100000010 #b01)))
(assert (fp.leq (fp #b1 #b100000010 #b01)
                expect
                (fp #b0 #b101011001 #b00)))

(assert (= expect result))

(check-sat)
(exit)
