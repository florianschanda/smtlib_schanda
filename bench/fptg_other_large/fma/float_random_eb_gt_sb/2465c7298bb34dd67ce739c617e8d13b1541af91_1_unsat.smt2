(assert (fp.leq (fp #b0 #b000000000000000 #b1110000100010)
                arg3
                (fp #b0 #b000101111011101 #b1101101001101)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

