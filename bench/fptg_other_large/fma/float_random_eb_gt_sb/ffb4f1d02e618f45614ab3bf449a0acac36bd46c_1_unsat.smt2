(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b0 #b00101010110101 #b011010011)
                arg1
                (fp #b0 #b11111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111111111)
                arg1
                (fp #b0 #b11111111111111 #b000000000)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00111000100110 #b011101111)
                arg3
                (fp #b0 #b00000000000000 #b010000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b010000000)
                arg3
                (fp #b0 #b10111000000010 #b110000000)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
