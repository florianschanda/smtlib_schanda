(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111111 #b0000000)
                arg1
                (fp #b1 #b111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b1111111)
                arg1
                (fp #b1 #b100110101101 #b0100101)))

(declare-const arg2 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b001001000000 #b0100111)
                arg2
                (fp #b0 #b110110011000 #b1101011)))
(assert (fp.leq (fp #b0 #b110110011000 #b1101011)
                arg2
                (fp #b0 #b111000011011 #b0011001)))

(declare-const arg3 (_ FloatingPoint 12 8))
(assert (fp.leq (fp #b1 #b111111111110 #b0101100)
                arg3
                (fp #b1 #b111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b111111111101 #b0000000)
                arg3
                (fp #b1 #b000000011001 #b1110111)))

(declare-const result (_ FloatingPoint 12 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
