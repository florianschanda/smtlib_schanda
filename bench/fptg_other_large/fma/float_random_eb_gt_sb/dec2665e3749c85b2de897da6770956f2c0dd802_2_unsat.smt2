(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0001010001 #b0100011)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b0110110111 #b0011100)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110010011 #b0101011)
                arg2
                (fp #b0 #b1111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111111)
                arg2
                (fp #b0 #b1111111111 #b0000000)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0001011101 #b1001000)
                arg3
                (fp #b0 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000000)
                arg3
                (fp #b0 #b0011011001 #b1111000)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0000010100 #b0111011)
                expect
                (fp #b0 #b1000000000 #b1001010)))
(assert (fp.leq (fp #b0 #b1000000000 #b1001010)
                expect
                (fp #b0 #b1000000111 #b0000101)))

(assert (not (= expect result)))

(check-sat)
(exit)
