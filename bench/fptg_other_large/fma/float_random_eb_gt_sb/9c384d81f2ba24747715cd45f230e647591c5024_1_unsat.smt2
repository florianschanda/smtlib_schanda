(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0000110101 #b001)
                arg1
                (fp #b0 #b0010011110 #b111)))
(assert (fp.leq (fp #b0 #b0010011110 #b111)
                arg1
                (fp #b0 #b1111100010 #b111)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010111001 #b010)
                arg2
                (fp #b1 #b0100111010 #b001)))
(assert (fp.leq (fp #b1 #b0100111010 #b001)
                arg2
                (fp #b0 #b0001000011 #b111)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0101010011 #b100)
                expect
                (fp #b0 #b0100111010 #b000)))
(assert (fp.leq (fp #b0 #b0100111010 #b000)
                expect
                (fp #b0 #b1011010000 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
