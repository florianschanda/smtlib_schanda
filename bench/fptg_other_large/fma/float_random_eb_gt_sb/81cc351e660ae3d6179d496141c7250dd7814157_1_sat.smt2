(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011111111 #b01100)
                arg1
                (fp #b0 #b1101111110 #b00011)))
(assert (fp.leq (fp #b0 #b1101111110 #b00011)
                arg1
                (fp #b0 #b1110011010 #b01000)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1010101000 #b00011)
                arg2
                (fp #b1 #b1000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000101 #b00000)
                arg2
                (fp #b0 #b0111101110 #b00110)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101001110 #b01000)
                arg3
                (fp #b1 #b1010001001 #b11011)))
(assert (fp.leq (fp #b1 #b1010001001 #b11011)
                arg3
                (fp #b1 #b0110000110 #b00100)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111100101 #b00000)
                expect
                (fp #b1 #b1110000100 #b00011)))
(assert (fp.leq (fp #b1 #b1110000100 #b00011)
                expect
                (fp #b0 #b0000100111 #b01000)))

(assert (= expect result))

(check-sat)
(exit)
