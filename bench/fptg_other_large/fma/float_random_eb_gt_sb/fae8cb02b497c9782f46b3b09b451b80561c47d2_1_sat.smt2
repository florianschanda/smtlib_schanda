(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111101 #b110001)
                arg1
                (fp #b1 #b1111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b000000)
                arg1
                (fp #b0 #b1011010011 #b010101)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0000011111 #b001001)
                arg2
                (fp #b0 #b1111111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111)
                arg2
                (fp #b0 #b1111111111 #b000000)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0100000110 #b100001)
                arg3
                (fp #b1 #b0000000000 #b010000)))
(assert (fp.leq (fp #b1 #b0000000000 #b010000)
                arg3
                (fp #b0 #b1101000111 #b011011)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1111111111 #b000000)
                expect
                (fp #b1 #b1111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b111111)
                expect
                (fp #b0 #b0000100101 #b010100)))

(assert (= expect result))

(check-sat)
(exit)
