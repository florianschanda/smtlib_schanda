                arg3
                (fp #b1 #b0000000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b01000000)
                arg3
                (fp #b0 #b0100011100110 #b11011010)))

(declare-const result (_ FloatingPoint 13 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 9))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
