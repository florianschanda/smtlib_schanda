(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1001001011 #b1)
                arg1
                (fp #b1 #b0000000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000000 #b0)
                arg1
                (fp #b0 #b1100100110 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1000011001 #b1)
                arg2
                (fp #b1 #b1000000001 #b0)))
(assert (fp.leq (fp #b1 #b1000000001 #b0)
                arg2
                (fp #b1 #b0111101110 #b1)))

(declare-const arg3 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1100110001 #b0)
                arg3
                (fp #b1 #b0011101011 #b1)))
(assert (fp.leq (fp #b1 #b0011101011 #b1)
                arg3
                (fp #b0 #b0000111110 #b1)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0100000010 #b0)
                expect
                (fp #b1 #b0011101011 #b1)))
(assert (fp.leq (fp #b1 #b0011101011 #b1)
                expect
                (fp #b1 #b0010000010 #b0)))

(assert (not (= expect result)))

(check-sat)
(exit)
