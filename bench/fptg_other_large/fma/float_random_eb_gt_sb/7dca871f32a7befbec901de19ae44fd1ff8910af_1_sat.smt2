(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 5))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b0101110110111 #b1010)
                arg2
                (fp #b1 #b0000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000000 #b0100)
                arg2
                (fp #b0 #b1101100110111 #b0100)))

(declare-const arg3 (_ FloatingPoint 13 5))
(assert (fp.leq (fp #b1 #b1111111111110 #b0010)
                arg3
                (fp #b1 #b1111111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b0000)
                arg3
                (fp #b1 #b0011011101001 #b0010)))

(declare-const result (_ FloatingPoint 13 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
