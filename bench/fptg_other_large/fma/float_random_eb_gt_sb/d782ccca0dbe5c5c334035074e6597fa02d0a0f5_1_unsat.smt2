(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INFINITY
; Arg2: +ZERO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b1001100010 #b101)
                arg2
                (fp #b0 #b0000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000)
                arg2
                (fp #b0 #b1000011011 #b000)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0110011000 #b101)
                arg3
                (fp #b1 #b0000000000 #b100)))
(assert (fp.leq (fp #b1 #b0000000000 #b100)
                arg3
                (fp #b0 #b1101001101 #b010)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
