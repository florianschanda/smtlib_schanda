; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1101001111 #b110110)
                arg2
                (fp #b1 #b0000000000 #b101100)))
(assert (fp.leq (fp #b1 #b0000000000 #b101100)
                arg2
                (fp #b0 #b1111000001 #b010111)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b1110100011 #b101101)
                arg3
                (fp #b0 #b1111000000 #b000110)))
(assert (fp.leq (fp #b0 #b1111000000 #b000110)
                arg3
                (fp #b0 #b1111100000 #b001010)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
