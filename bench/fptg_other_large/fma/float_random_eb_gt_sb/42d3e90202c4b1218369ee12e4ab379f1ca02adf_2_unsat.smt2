(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b0 #b0000010001100001 #b11001010101)
                arg1
                (fp #b0 #b1111111111111110 #b11111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b11111111111)
                arg1
                (fp #b0 #b1111111111111111 #b00000000000)))

(declare-const arg2 (_ FloatingPoint 16 12))
(assert (fp.leq (fp #b1 #b1101110000111111 #b01010000100)
                arg2
                (fp #b1 #b1100000101001000 #b01111011101)))
(assert (fp.leq (fp #b1 #b1100000101001000 #b01111011101)
                arg2
                (fp #b1 #b1011101011001111 #b11101111010)))

(declare-const arg3 (_ FloatingPoint 16 12))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
