;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0111101001 #b01100111)
                arg1
                (fp #b0 #b0100011001 #b01111111)))
(assert (fp.leq (fp #b0 #b0100011001 #b01111111)
                arg1
                (fp #b0 #b1010011110 #b11100111)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0011101010 #b01011000)
                arg2
                (fp #b1 #b0000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b01000000)
                arg2
                (fp #b0 #b1101111001 #b10100011)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b1101011011 #b01010100)
                arg3
                (fp #b0 #b1111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111111)
                arg3
                (fp #b0 #b1111111111 #b00000000)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0111001001 #b01010100)
                expect
                (fp #b0 #b1111111110 #b11111110)))
(assert (fp.leq (fp #b0 #b1111111110 #b11111110)
                expect
                (fp #b0 #b1111111110 #b11111111)))

(assert (= expect result))

(check-sat)
(exit)
