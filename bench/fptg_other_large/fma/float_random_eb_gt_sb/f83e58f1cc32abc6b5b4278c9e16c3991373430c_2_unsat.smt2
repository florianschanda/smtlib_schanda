;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b010101111111 #b10101)
                arg1
                (fp #b1 #b000000000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000)
                arg1
                (fp #b0 #b011101110111 #b11001)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b101100001100 #b00101)
                arg2
                (fp #b0 #b000000000000 #b10101)))
(assert (fp.leq (fp #b0 #b000000000000 #b10101)
                arg2
                (fp #b0 #b001111011001 #b11101)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b010010111001 #b00111)
                arg3
                (fp #b0 #b100000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000101 #b00000)
                arg3
                (fp #b0 #b100000011111 #b01000)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b011101001100 #b10001)
                expect
                (fp #b0 #b100000000101 #b00000)))
(assert (fp.leq (fp #b0 #b100000000101 #b00000)
                expect
                (fp #b0 #b111111000011 #b10001)))

(assert (not (= expect result)))

(check-sat)
(exit)
