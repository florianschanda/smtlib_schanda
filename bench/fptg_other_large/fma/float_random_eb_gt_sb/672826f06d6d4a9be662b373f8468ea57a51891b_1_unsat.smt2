(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111010110100 #b10101)
                arg1
                (fp #b1 #b110011000100 #b01110)))
(assert (fp.leq (fp #b1 #b110011000100 #b01110)
                arg1
                (fp #b1 #b000110101000 #b01001)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
