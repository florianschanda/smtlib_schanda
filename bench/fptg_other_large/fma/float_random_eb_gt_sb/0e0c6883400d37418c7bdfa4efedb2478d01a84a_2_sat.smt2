(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001010110 #b0010001)
                arg1
                (fp #b1 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000111 #b0000000)
                arg1
                (fp #b0 #b1100101010 #b0101111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1000110000 #b0011101)
                arg2
                (fp #b1 #b0111010011 #b0011001)))
(assert (fp.leq (fp #b1 #b0111010011 #b0011001)
                arg2
                (fp #b0 #b1011101000 #b1011001)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1011101101 #b0010101)
                arg3
                (fp #b1 #b0000000000 #b0111011)))
(assert (fp.leq (fp #b1 #b0000000000 #b0111011)
                arg3
                (fp #b0 #b0101101101 #b0001001)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0110110000 #b1000100)
                expect
                (fp #b0 #b0111011011 #b0011001)))
(assert (fp.leq (fp #b0 #b0111011011 #b0011001)
                expect
                (fp #b0 #b1101001001 #b0000001)))

(assert (= expect result))

(check-sat)
(exit)
