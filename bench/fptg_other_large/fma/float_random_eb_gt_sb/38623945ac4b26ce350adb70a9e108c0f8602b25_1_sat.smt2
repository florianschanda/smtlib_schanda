; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111111111111111110 #b00000)
                arg1
                (fp #b1 #b111111111111111101 #b00000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b00000)
                arg1
                (fp #b0 #b101100000101000110 #b11001)))

(declare-const arg2 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b100101010000001111 #b11100)
                arg2
                (fp #b0 #b000000000000000000 #b10101)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b10101)
                arg2
                (fp #b0 #b100000101000011000 #b10010)))

(declare-const arg3 (_ FloatingPoint 18 6))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
