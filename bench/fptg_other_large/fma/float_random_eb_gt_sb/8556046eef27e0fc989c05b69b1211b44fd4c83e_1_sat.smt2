(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +INT_BOUNDARY
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111001011 #b10)
                arg1
                (fp #b1 #b100000010 #b00)))
(assert (fp.leq (fp #b1 #b100000010 #b00)
                arg1
                (fp #b0 #b011000110 #b11)))

(declare-const arg2 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b001000101 #b00)
                arg2
                (fp #b0 #b100000010 #b00)))
(assert (fp.leq (fp #b0 #b100000010 #b00)
                arg2
                (fp #b0 #b111011110 #b01)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111110 #b11)
                arg3
                (fp #b1 #b111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111101 #b00)
                arg3
                (fp #b0 #b101010110 #b10)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111111101 #b10)
                expect
                (fp #b1 #b111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111101 #b00)
                expect
                (fp #b0 #b010100101 #b00)))

(assert (= expect result))

(check-sat)
(exit)
