(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0110011111101111 #b1010101)
                arg1
                (fp #b0 #b1000000000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000000000111 #b0000000)
                arg1
                (fp #b0 #b1111010001010001 #b0011101)))

(declare-const arg2 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1101110110100000 #b1011001)
                arg2
                (fp #b0 #b0000000000000000 #b1100000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b1100000)
                arg2
                (fp #b0 #b1001001001101000 #b0111001)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b0010110001011100 #b0100100)
                expect
                (fp #b0 #b0000000000001000 #b1000000)))
(assert (fp.leq (fp #b0 #b0000000000001000 #b1000000)
                expect
                (fp #b0 #b1111111111100011 #b1010100)))

(assert (= expect result))

(check-sat)
(exit)
