;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1110100011001100 #b001100)
                arg1
                (fp #b1 #b1011110100010001 #b101000)))
(assert (fp.leq (fp #b1 #b1011110100010001 #b101000)
                arg1
                (fp #b0 #b0110001110010001 #b100010)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0110010001001000 #b110001)
                arg2
                (fp #b1 #b0000000000000000 #b101100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b101100)
                arg2
                (fp #b0 #b0110011001001010 #b101110)))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111101 #b010100)
                arg3
                (fp #b1 #b1111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000000)
                arg3
                (fp #b1 #b0010011101100011 #b000110)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111101 #b100001)
                expect
                (fp #b1 #b1111111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b000000)
                expect
                (fp #b0 #b0110101001010101 #b010001)))

(assert (= expect result))

(check-sat)
(exit)
