; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b01100011101011 #b10101111)
                arg1
                (fp #b1 #b00000000000000 #b01000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b01000000)
                arg1
                (fp #b0 #b01011100001010 #b11111111)))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b0 #b00000010110111 #b10000000)
                arg2
                (fp #b0 #b11111111111101 #b00000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00000000)
                arg2
                (fp #b0 #b11111111111110 #b11011010)))

(declare-const arg3 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b01001011110111 #b10011011)
                arg3
                (fp #b0 #b11111111111110 #b11111111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b11111111)
                arg3
                (fp #b0 #b11111111111111 #b00000000)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b0 #b11010011010111 #b10101101)
                expect
                (fp #b0 #b11111111111110 #b11111110)))
(assert (fp.leq (fp #b0 #b11111111111110 #b11111110)
                expect
                (fp #b0 #b11111111111110 #b11111111)))

(assert (= expect result))

(check-sat)
(exit)
