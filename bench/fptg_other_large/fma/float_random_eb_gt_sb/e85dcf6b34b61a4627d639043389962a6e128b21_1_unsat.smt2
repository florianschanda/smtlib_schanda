; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1000101001010110 #b000)
                arg1
                (fp #b0 #b1000000000000011 #b000)))
(assert (fp.leq (fp #b0 #b1000000000000011 #b000)
                arg1
                (fp #b0 #b1010000100110011 #b101)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111001010111111 #b001)
                arg2
                (fp #b1 #b1100101110001011 #b011)))
(assert (fp.leq (fp #b1 #b1100101110001011 #b011)
                arg2
                (fp #b0 #b1101110100111110 #b011)))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
