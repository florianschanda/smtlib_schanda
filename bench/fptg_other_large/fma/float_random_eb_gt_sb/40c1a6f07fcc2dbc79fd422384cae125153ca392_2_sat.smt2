(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +ZERO
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b111111111111 #b00000000)
                arg1
                (fp #b1 #b111111111110 #b11111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b11111111)
                arg1
                (fp #b0 #b011000000011 #b10000001)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b011000111010 #b01010000)
                arg2
                (fp #b0 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000)
                arg2
                (fp #b0 #b100010000001 #b11100010)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b001001101101 #b01111111)
                arg3
                (fp #b0 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b00000000)
                arg3
                (fp #b0 #b011011101100 #b01000000)))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b000100000010 #b11110111)
                expect
                (fp #b1 #b000000000000 #b00000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b00000000)
                expect
                (fp #b0 #b110100100010 #b00100001)))

(assert (= expect result))

(check-sat)
(exit)
