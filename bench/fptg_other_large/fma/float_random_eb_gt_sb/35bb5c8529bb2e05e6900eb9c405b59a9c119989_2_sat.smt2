;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1010000100 #b11101011)
                arg1
                (fp #b1 #b0110011001 #b01001011)))
(assert (fp.leq (fp #b1 #b0110011001 #b01001011)
                arg1
                (fp #b1 #b0100111101 #b01111000)))

(declare-const arg2 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1001101001 #b10110110)
                arg2
                (fp #b1 #b0110000010 #b10011001)))
(assert (fp.leq (fp #b1 #b0110000010 #b10011001)
                arg2
                (fp #b0 #b1010110101 #b00110100)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111110 #b11110110)
                arg3
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                arg3
                (fp #b0 #b0110010010 #b01011110)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b1111111110 #b11110101)
                expect
                (fp #b1 #b1111111101 #b00000000)))
(assert (fp.leq (fp #b1 #b1111111101 #b00000000)
                expect
                (fp #b1 #b0100111100 #b00010001)))

(assert (= expect result))

(check-sat)
(exit)
