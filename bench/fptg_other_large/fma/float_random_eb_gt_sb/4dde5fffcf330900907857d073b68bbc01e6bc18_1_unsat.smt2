(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010111001 #b001)
                arg1
                (fp #b0 #b0000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000 #b010)
                arg1
                (fp #b0 #b1110000101 #b101)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0100111110 #b110)
                arg2
                (fp #b0 #b1111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111101 #b000)
                arg2
                (fp #b0 #b1111111101 #b110)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1110000100 #b001)
                arg3
                (fp #b0 #b1111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111)
                arg3
                (fp #b0 #b1111111111 #b000)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0101000100 #b100)
                expect
                (fp #b0 #b1111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111)
                expect
                (fp #b0 #b1111111111 #b000)))

(assert (not (= expect result)))

(check-sat)
(exit)
