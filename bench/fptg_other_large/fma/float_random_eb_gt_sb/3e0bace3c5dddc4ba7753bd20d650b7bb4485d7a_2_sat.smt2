; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1010100011010000 #b111011)
                arg1
                (fp #b0 #b1000000000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000000000110 #b000000)
                arg1
                (fp #b0 #b1001011010101001 #b111110)))

(declare-const arg2 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b1111111111111111 #b000000)
                arg2
                (fp #b1 #b1111111111111110 #b111111)))
(assert (fp.leq (fp #b1 #b1111111111111110 #b111111)
                arg2
                (fp #b1 #b0001100100111111 #b001000)))

(declare-const arg3 (_ FloatingPoint 16 7))
(assert (fp.leq (fp #b1 #b0001011100001101 #b101110)
                arg3
                (fp #b0 #b1001101100010101 #b000111)))
(assert (fp.leq (fp #b0 #b1001101100010101 #b000111)
                arg3
                (fp #b0 #b1110101001100000 #b001010)))

(declare-const result (_ FloatingPoint 16 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
