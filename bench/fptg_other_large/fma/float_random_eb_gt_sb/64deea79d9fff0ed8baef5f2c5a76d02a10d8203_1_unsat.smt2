(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1000110100100111 #b111)
                arg1
                (fp #b1 #b0000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000)
                arg1
                (fp #b0 #b0101011000010001 #b110)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1011111010010011 #b010)
                arg2
                (fp #b0 #b1111111111111101 #b000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000)
                arg2
                (fp #b0 #b1111111111111101 #b001)))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1101001011010100 #b000)
                arg3
                (fp #b1 #b0000000000000000 #b100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b100)
                arg3
                (fp #b0 #b0001100011011111 #b110)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0011111101010110 #b111)
                expect
                (fp #b1 #b0000000000000000 #b100)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b100)
                expect
                (fp #b0 #b1011000101001111 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
