(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111111111111111 #b00000)
                arg1
                (fp #b1 #b111111111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b11111)
                arg1
                (fp #b1 #b101010110100010 #b01011)))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b0 #b010010000001111 #b11101)
                arg2
                (fp #b0 #b111111111111101 #b00000)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00000)
                arg2
                (fp #b0 #b111111111111101 #b11101)))

(declare-const arg3 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b111101000011100 #b00000)
                arg3
                (fp #b1 #b000000000000000 #b10000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b10000)
                arg3
                (fp #b0 #b010010001000000 #b00110)))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
