                arg2
                (fp #b0 #b0111011111001 #b00110)))

(declare-const arg3 (_ FloatingPoint 13 6))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 6))
