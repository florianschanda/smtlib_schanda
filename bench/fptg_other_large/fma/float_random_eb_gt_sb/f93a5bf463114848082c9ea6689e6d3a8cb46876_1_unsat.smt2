(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01111010001101 #b100)
                arg2
                (fp #b1 #b00000000000000 #b101)))
(assert (fp.leq (fp #b1 #b00000000000000 #b101)
                arg2
                (fp #b0 #b10000110010100 #b001)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01001011000100 #b111)
                arg3
                (fp #b0 #b11111111111110 #b111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b111)
                arg3
                (fp #b0 #b11111111111111 #b000)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
