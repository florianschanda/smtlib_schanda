;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b0010110001100010 #b11)
                arg1
                (fp #b0 #b0000000000000000 #b00)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00)
                arg1
                (fp #b0 #b1111000001101111 #b00)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1111111111111101 #b10)
                arg2
                (fp #b1 #b1111111111111101 #b00)))
(assert (fp.leq (fp #b1 #b1111111111111101 #b00)
                arg2
                (fp #b0 #b1100010010011100 #b10)))

(declare-const arg3 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1100110111100101 #b00)
                arg3
                (fp #b1 #b0111111110111001 #b11)))
(assert (fp.leq (fp #b1 #b0111111110111001 #b11)
                arg3
                (fp #b0 #b1010001010110110 #b10)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1001010101110110 #b10)
                expect
                (fp #b1 #b0111111110111001 #b11)))
(assert (fp.leq (fp #b1 #b0111111110111001 #b11)
                expect
                (fp #b1 #b0110101110110011 #b01)))

(assert (= expect result))

(check-sat)
(exit)
