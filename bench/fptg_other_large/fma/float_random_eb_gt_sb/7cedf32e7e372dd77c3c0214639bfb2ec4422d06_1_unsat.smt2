(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0001111010 #b1)
                arg1
                (fp #b0 #b1111111110 #b0)))
(assert (fp.leq (fp #b0 #b1111111110 #b0)
                arg1
                (fp #b0 #b1111111111 #b0)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0001111111 #b0)
                arg2
                (fp #b0 #b0001001111 #b0)))
(assert (fp.leq (fp #b0 #b0001001111 #b0)
                arg2
                (fp #b0 #b1110100110 #b1)))

(declare-const arg3 (_ FloatingPoint 10 2))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0111001110 #b1)
                expect
                (fp #b0 #b1001001110 #b0)))
(assert (fp.leq (fp #b0 #b1001001110 #b0)
                expect
                (fp #b0 #b1001010110 #b1)))

(assert (not (= expect result)))

(check-sat)
(exit)
