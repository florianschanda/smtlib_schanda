(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11111111111111 #b00000000000)
                arg1
                (fp #b1 #b11111111111110 #b11111111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b11111111111)
                arg1
                (fp #b0 #b11000101000101 #b10110101101)))

(declare-const arg2 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b11110111101110 #b00101010010)
                arg2
                (fp #b0 #b11101001000101 #b01100001111)))
(assert (fp.leq (fp #b0 #b11101001000101 #b01100001111)
                arg2
                (fp #b0 #b11111001100101 #b10100011111)))

(declare-const arg3 (_ FloatingPoint 14 12))
(assert (fp.leq (fp #b1 #b10001001010100 #b10011000110)
                arg3
                (fp #b0 #b11111111111101 #b00000000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00000000000)
                arg3
                (fp #b0 #b11111111111101 #b11011101011)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
