;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110100100 #b10001)
                arg1
                (fp #b0 #b1111111101 #b00000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000)
                arg1
                (fp #b0 #b1111111101 #b00010)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1001110001 #b11101)
                arg2
                (fp #b1 #b0000000000 #b10001)))
(assert (fp.leq (fp #b1 #b0000000000 #b10001)
                arg2
                (fp #b0 #b0101101000 #b11111)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1111011010 #b10010)
                arg3
                (fp #b1 #b1010001001 #b11011)))
(assert (fp.leq (fp #b1 #b1010001001 #b11011)
                arg3
                (fp #b0 #b0101110011 #b10001)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101010000 #b11101)
                expect
                (fp #b1 #b1010001001 #b11100)))
(assert (fp.leq (fp #b1 #b1010001001 #b11100)
                expect
                (fp #b1 #b0101110011 #b00010)))

(assert (= expect result))

(check-sat)
(exit)
