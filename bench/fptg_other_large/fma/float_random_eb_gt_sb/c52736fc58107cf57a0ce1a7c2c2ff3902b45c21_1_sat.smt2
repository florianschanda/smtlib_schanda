(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b101101110000001 #b100)
                arg1
                (fp #b0 #b000000000000000 #b110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b110)
                arg1
                (fp #b0 #b000101100100010 #b000)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b111111111111111 #b000)
                arg2
                (fp #b1 #b111111111111110 #b111)))
(assert (fp.leq (fp #b1 #b111111111111110 #b111)
                arg2
                (fp #b1 #b000101001011010 #b111)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b000001111110010 #b011)
                arg3
                (fp #b0 #b110010101111010 #b100)))
(assert (fp.leq (fp #b0 #b110010101111010 #b100)
                arg3
                (fp #b0 #b111101110011111 #b110)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b011001111001111 #b101)
                expect
                (fp #b0 #b110010101111010 #b011)))
(assert (fp.leq (fp #b0 #b110010101111010 #b011)
                expect
                (fp #b0 #b110111011101011 #b000)))

(assert (= expect result))

(check-sat)
(exit)
