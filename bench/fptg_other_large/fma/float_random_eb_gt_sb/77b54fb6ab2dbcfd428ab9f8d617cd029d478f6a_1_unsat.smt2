(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 11))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b001111101001000 #b0101100111)
                arg1
                (fp #b1 #b000000000000000 #b0000000000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000000000)
                arg1
                (fp #b0 #b011111101110110 #b0011011000)))

(declare-const arg2 (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b0 #b011000101101100 #b0101111111)
                arg2
                (fp #b0 #b111010000110000 #b1100001111)))
(assert (fp.leq (fp #b0 #b111010000110000 #b1100001111)
                arg2
                (fp #b0 #b111110110010100 #b0111101110)))

(declare-const arg3 (_ FloatingPoint 15 11))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 11))
(assert (fp.leq (fp #b0 #b110010000100010 #b1001110111)
                expect
                (fp #b0 #b111010000110000 #b1100001111)))
(assert (fp.leq (fp #b0 #b111010000110000 #b1100001111)
                expect
                (fp #b0 #b111111011111101 #b1101111101)))

(assert (not (= expect result)))

(check-sat)
(exit)
