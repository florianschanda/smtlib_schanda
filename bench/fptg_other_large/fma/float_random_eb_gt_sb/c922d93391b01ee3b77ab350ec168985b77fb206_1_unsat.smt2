(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101001001110110 #b1101110)
                arg1
                (fp #b1 #b010111001100101 #b1111010)))
(assert (fp.leq (fp #b1 #b010111001100101 #b1111010)
                arg1
                (fp #b1 #b000000101011100 #b0101101)))

(declare-const arg2 (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b100011111010100 #b0101111)
                arg2
                (fp #b1 #b000000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b000000000000000 #b1101110)
                arg2
                (fp #b0 #b111001000100001 #b1010010)))

(declare-const arg3 (_ FloatingPoint 15 8))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 8))
(assert (fp.leq (fp #b1 #b101111100110101 #b1101111)
                expect
                (fp #b0 #b000000000000000 #b1101110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b1101110)
                expect
                (fp #b0 #b010001100100010 #b0000010)))

(assert (not (= expect result)))

(check-sat)
(exit)
