                arg2
                (fp #b0 #b01011100101100101 #b111)))
(assert (fp.leq (fp #b0 #b01011100101100101 #b111)
                arg2
                (fp #b0 #b10110011001001100 #b110)))

(declare-const arg3 (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b10011011001111001 #b101)
                arg3
                (fp #b0 #b01111110000101101 #b110)))
(assert (fp.leq (fp #b0 #b01111110000101101 #b110)
                arg3
                (fp #b0 #b11111110011110000 #b010)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
