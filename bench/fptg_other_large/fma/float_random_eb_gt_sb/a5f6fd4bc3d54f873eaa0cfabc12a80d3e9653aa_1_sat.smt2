; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +NAN
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010110001 #b1011001)
                arg1
                (fp #b1 #b0111000100 #b0011101)))
(assert (fp.leq (fp #b1 #b0111000100 #b0011101)
                arg1
                (fp #b1 #b0011101100 #b0011100)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1111111111 #b0000000)
                arg3
                (fp #b1 #b1111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111111)
                arg3
                (fp #b0 #b0000100100 #b1010000)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
