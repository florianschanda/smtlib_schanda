(assert (fp.leq (fp #b1 #b0010110010010011 #b11000000010)
                arg2
                (fp #b1 #b0000000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b00000000000)
                arg2
                (fp #b0 #b0001011010000010 #b11111010111)))

(declare-const arg3 (_ FloatingPoint 16 12))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 16 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 12))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
