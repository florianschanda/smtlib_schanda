(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011011000 #b11000)
                arg1
                (fp #b1 #b1001101111 #b11110)))
(assert (fp.leq (fp #b1 #b1001101111 #b11110)
                arg1
                (fp #b0 #b1000110110 #b11100)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b0100110101 #b00110)
                arg3
                (fp #b0 #b0000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000)
                arg3
                (fp #b0 #b1101110111 #b11011)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1101000011 #b01100)
                expect
                (fp #b0 #b1011100000 #b11100)))
(assert (fp.leq (fp #b0 #b1011100000 #b11100)
                expect
                (fp #b0 #b1101100100 #b01100)))

(assert (not (= expect result)))

(check-sat)
(exit)
