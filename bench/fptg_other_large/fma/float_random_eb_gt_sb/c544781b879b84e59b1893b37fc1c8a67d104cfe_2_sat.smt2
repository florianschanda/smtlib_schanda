(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b0 #b01100001000 #b00101)
                arg1
                (fp #b0 #b01110001001 #b10111)))
(assert (fp.leq (fp #b0 #b01110001001 #b10111)
                arg1
                (fp #b0 #b10111110100 #b11111)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11111000001 #b00110)
                arg2
                (fp #b1 #b11001111101 #b00110)))
(assert (fp.leq (fp #b1 #b11001111101 #b00110)
                arg2
                (fp #b1 #b00000010110 #b10000)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b10010111100 #b11010)
                arg3
                (fp #b1 #b10000000101 #b00000)))
(assert (fp.leq (fp #b1 #b10000000101 #b00000)
                arg3
                (fp #b0 #b11011011010 #b01000)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11010110110 #b00001)
                expect
                (fp #b1 #b11000001000 #b00001)))
(assert (fp.leq (fp #b1 #b11000001000 #b00001)
                expect
                (fp #b1 #b01111001111 #b11001)))

(assert (= expect result))

(check-sat)
(exit)
