(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: -INT_BOUNDARY
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1111111111 #b0)
                arg1
                (fp #b1 #b1111111110 #b0)))
(assert (fp.leq (fp #b1 #b1111111110 #b0)
                arg1
                (fp #b0 #b0000111010 #b0)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1100100001 #b1)
                arg2
                (fp #b1 #b1000000001 #b0)))
(assert (fp.leq (fp #b1 #b1000000001 #b0)
                arg2
                (fp #b0 #b0100011110 #b0)))

(declare-const arg3 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1000010101 #b1)
                arg3
                (fp #b0 #b0101101111 #b1)))
(assert (fp.leq (fp #b0 #b0101101111 #b1)
                arg3
                (fp #b0 #b1001110001 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
