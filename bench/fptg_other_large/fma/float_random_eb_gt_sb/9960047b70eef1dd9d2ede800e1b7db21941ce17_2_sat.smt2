(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b011111011101 #b10100)
                arg1
                (fp #b0 #b111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b111111111110 #b11111)
                arg1
                (fp #b0 #b111111111111 #b00000)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b101101110011 #b11101)
                arg2
                (fp #b1 #b000000000000 #b10001)))
(assert (fp.leq (fp #b1 #b000000000000 #b10001)
                arg2
                (fp #b0 #b111100100100 #b11101)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111111110011 #b11011)
                expect
                (fp #b1 #b100000000000 #b00010)))
(assert (fp.leq (fp #b1 #b100000000000 #b00010)
                expect
                (fp #b0 #b011101100101 #b01000)))

(assert (= expect result))

(check-sat)
(exit)
