; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b011111011010 #b00110000)
                arg1
                (fp #b0 #b010100001000 #b01111101)))
(assert (fp.leq (fp #b0 #b010100001000 #b01111101)
                arg1
                (fp #b0 #b010101111001 #b10100001)))

(declare-const arg2 (_ FloatingPoint 12 9))
(assert (fp.leq (fp #b1 #b100001101001 #b10000000)
                arg2
                (fp #b0 #b101011000001 #b00010000)))
(assert (fp.leq (fp #b0 #b101011000001 #b00010000)
                arg2
                (fp #b0 #b110011011111 #b11001101)))

(declare-const arg3 (_ FloatingPoint 12 9))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 12 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
