; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -ZERO
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b11100110001 #b10011)
                arg1
                (fp #b0 #b00000000000 #b01000)))
(assert (fp.leq (fp #b0 #b00000000000 #b01000)
                arg1
                (fp #b0 #b10111110110 #b00001)))

(declare-const arg2 (_ FloatingPoint 11 6))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b11001101110 #b01001)
                arg2
                (fp #b1 #b00000000000 #b00000)))
(assert (fp.leq (fp #b1 #b00000000000 #b00000)
                arg2
                (fp #b0 #b01111111000 #b00100)))

(declare-const arg3 (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00010011110 #b00110)
                arg3
                (fp #b1 #b00000000000 #b10000)))
(assert (fp.leq (fp #b1 #b00000000000 #b10000)
                arg3
                (fp #b0 #b11111111101 #b00011)))

(declare-const result (_ FloatingPoint 11 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 6))
(assert (fp.leq (fp #b1 #b00011110000 #b00011)
                expect
                (fp #b1 #b00000000000 #b10000)))
(assert (fp.leq (fp #b1 #b00000000000 #b10000)
                expect
                (fp #b0 #b10110000011 #b01001)))

(assert (= expect result))

(check-sat)
(exit)
