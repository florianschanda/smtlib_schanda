; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b11001100010011 #b111110111)
                arg1
                (fp #b0 #b10101011101001 #b011011000)))
(assert (fp.leq (fp #b0 #b10101011101001 #b011011000)
                arg1
                (fp #b0 #b11011100101100 #b100011000)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10110011101001 #b110111001)
                arg2
                (fp #b1 #b01111101110001 #b001001010)))
(assert (fp.leq (fp #b1 #b01111101110001 #b001001010)
                arg2
                (fp #b1 #b01000111011101 #b101101000)))

(declare-const arg3 (_ FloatingPoint 14 10))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
