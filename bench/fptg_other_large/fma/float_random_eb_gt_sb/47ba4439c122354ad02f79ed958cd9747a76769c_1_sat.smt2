                (fp #b1 #b10000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000000)
                arg2
                (fp #b0 #b11001001111 #b1100000)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11000001100 #b0010110)
                arg3
                (fp #b1 #b10000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b10000000111 #b0000000)
                arg3
                (fp #b0 #b11100001100 #b0000001)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10101000001 #b1000010)
                expect
                (fp #b0 #b10010001011 #b0110110)))
(assert (fp.leq (fp #b0 #b10010001011 #b0110110)
                expect
                (fp #b0 #b11001110111 #b0111001)))

(assert (= expect result))

(check-sat)
(exit)
