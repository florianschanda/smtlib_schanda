; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b0110000100 #b010001)
                arg1
                (fp #b1 #b0000000000 #b000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b000000)
                arg1
                (fp #b0 #b1000111101 #b000111)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0110111010 #b001010)
                arg2
                (fp #b0 #b0010100001 #b001110)))
(assert (fp.leq (fp #b0 #b0010100001 #b001110)
                arg2
                (fp #b0 #b0101010001 #b111011)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
