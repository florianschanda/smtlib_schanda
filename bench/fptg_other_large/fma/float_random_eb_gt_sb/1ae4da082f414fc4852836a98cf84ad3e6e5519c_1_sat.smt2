                arg2
                (fp #b0 #b1100100110000 #b010)))

(declare-const arg3 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0011110110101 #b000)
                arg3
                (fp #b0 #b0000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000 #b010)
                arg3
                (fp #b0 #b1110011011101 #b010)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0010011100101 #b011)
                expect
                (fp #b0 #b0000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000 #b010)
                expect
                (fp #b0 #b0011111101011 #b100)))

(assert (= expect result))

(check-sat)
(exit)
