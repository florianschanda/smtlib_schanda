(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -INT_BOUNDARY
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111100000011 #b111101)
                arg1
                (fp #b0 #b010001010110 #b110010)))
(assert (fp.leq (fp #b0 #b010001010110 #b110010)
                arg1
                (fp #b0 #b101111000000 #b011111)))

(declare-const arg2 (_ FloatingPoint 12 7))
(assert (fp.leq (fp #b1 #b111001011010 #b101001)
                arg2
                (fp #b1 #b100000000110 #b000000)))
(assert (fp.leq (fp #b1 #b100000000110 #b000000)
                arg2
                (fp #b1 #b001111110010 #b011101)))

(declare-const arg3 (_ FloatingPoint 12 7))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 12 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 7))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
