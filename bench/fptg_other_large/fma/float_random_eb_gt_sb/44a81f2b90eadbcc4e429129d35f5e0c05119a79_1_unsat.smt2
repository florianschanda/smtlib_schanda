(assert (fp.leq (fp #b0 #b100000000101 #b00000)
                arg2
                (fp #b0 #b100001000000 #b10000)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b101100011110 #b00000)
                arg3
                (fp #b0 #b000000000000 #b10111)))
(assert (fp.leq (fp #b0 #b000000000000 #b10111)
                arg3
                (fp #b0 #b001011100000 #b10110)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b110000110100 #b11100)
                expect
                (fp #b0 #b000000000000 #b10111)))
(assert (fp.leq (fp #b0 #b000000000000 #b10111)
                expect
                (fp #b0 #b100101111100 #b00011)))

(assert (not (= expect result)))

(check-sat)
(exit)
