; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b00110101000010 #b1011011)
                arg1
                (fp #b1 #b00000000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1111010)
                arg1
                (fp #b0 #b11111100001111 #b1011111)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b0 #b11101011101011 #b0001110)
                arg2
                (fp #b0 #b11111111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b0000000)
                arg2
                (fp #b0 #b11111111111110 #b0000101)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000000)
                arg3
                (fp #b1 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111111)
                arg3
                (fp #b1 #b01010110011100 #b1100110)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
