(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b110111011111 #b10111)
                arg1
                (fp #b0 #b000100111000 #b11001)))
(assert (fp.leq (fp #b0 #b000100111000 #b11001)
                arg1
                (fp #b0 #b010100001111 #b00001)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b0 #b001000011001 #b01101)
                arg2
                (fp #b0 #b111111111101 #b00000)))
(assert (fp.leq (fp #b0 #b111111111101 #b00000)
                arg2
                (fp #b0 #b111111111101 #b10111)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b111011001100 #b00000)
                arg3
                (fp #b0 #b011101001101 #b11010)))
(assert (fp.leq (fp #b0 #b011101001101 #b11010)
                arg3
                (fp #b0 #b110000011000 #b00110)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b0 #b000000111000 #b01101)
                expect
                (fp #b0 #b100100110110 #b11001)))
(assert (fp.leq (fp #b0 #b100100110110 #b11001)
                expect
                (fp #b0 #b111110001000 #b00111)))

(assert (= expect result))

(check-sat)
(exit)
