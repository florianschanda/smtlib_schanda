;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111101111 #b110)
                arg1
                (fp #b1 #b010110101 #b110)))
(assert (fp.leq (fp #b1 #b010110101 #b110)
                arg1
                (fp #b0 #b011011100 #b101)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b100101100 #b110)
                arg2
                (fp #b0 #b011000111 #b100)))
(assert (fp.leq (fp #b0 #b011000111 #b100)
                arg2
                (fp #b0 #b110000011 #b111)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b001110110 #b111)
                arg3
                (fp #b1 #b000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000 #b010)
                arg3
                (fp #b0 #b011011111 #b100)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b010110111 #b001)
                expect
                (fp #b1 #b001111110 #b011)))
(assert (fp.leq (fp #b1 #b001111110 #b011)
                expect
                (fp #b0 #b000000010 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
