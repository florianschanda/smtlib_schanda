(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b0 #b00111100000111 #b00011)
                arg2
                (fp #b0 #b11111111111110 #b11111)))
(assert (fp.leq (fp #b0 #b11111111111110 #b11111)
                arg2
                (fp #b0 #b11111111111111 #b00000)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00000100011000 #b00001)
                arg3
                (fp #b0 #b10011010001010 #b11011)))
(assert (fp.leq (fp #b0 #b10011010001010 #b11011)
                arg3
                (fp #b0 #b11010101001000 #b00100)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
