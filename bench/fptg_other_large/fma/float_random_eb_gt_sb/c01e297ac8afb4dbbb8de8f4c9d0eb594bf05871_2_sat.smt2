(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1110001101 #b00101)
                arg1
                (fp #b0 #b0000000000 #b01000)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000)
                arg1
                (fp #b0 #b0111011100 #b00001)))

(declare-const arg2 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b1011000000 #b01001)
                arg2
                (fp #b0 #b1111111101 #b00000)))
(assert (fp.leq (fp #b0 #b1111111101 #b00000)
                arg2
                (fp #b0 #b1111111110 #b11101)))

(declare-const arg3 (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b1 #b1011011101 #b10011)
                arg3
                (fp #b1 #b0111110010 #b00000)))
(assert (fp.leq (fp #b1 #b0111110010 #b00000)
                arg3
                (fp #b1 #b0101011110 #b01111)))

(declare-const result (_ FloatingPoint 10 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 6))
(assert (fp.leq (fp #b0 #b0101000011 #b01011)
                expect
                (fp #b0 #b0111111101 #b00000)))
(assert (fp.leq (fp #b0 #b0111111101 #b00000)
                expect
                (fp #b0 #b1111010101 #b01010)))

(assert (= expect result))

(check-sat)
(exit)
