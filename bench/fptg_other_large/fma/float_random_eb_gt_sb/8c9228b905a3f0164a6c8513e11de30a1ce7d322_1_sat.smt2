(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RCP_SMALLEST_SUBNORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b10011110011101 #b101001100)
                arg1
                (fp #b1 #b00000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000000)
                arg1
                (fp #b0 #b00001010111011 #b101100001)))

(declare-const arg2 (_ FloatingPoint 14 10))
(assert (fp.isPositive arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 14 10))
(assert (fp.leq (fp #b1 #b00011101111000 #b010111001)
                arg3
                (fp #b1 #b00000000000000 #b010000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010000000)
                arg3
                (fp #b0 #b01110110111000 #b101111001)))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
