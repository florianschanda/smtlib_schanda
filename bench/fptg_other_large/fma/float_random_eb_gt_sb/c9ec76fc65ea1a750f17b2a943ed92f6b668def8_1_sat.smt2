(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b011101111 #b01011)
                arg1
                (fp #b1 #b000000000 #b00111)))
(assert (fp.leq (fp #b1 #b000000000 #b00111)
                arg1
                (fp #b0 #b110101010 #b11010)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101100001 #b01010)
                arg2
                (fp #b1 #b000000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000)
                arg2
                (fp #b0 #b001110101 #b10101)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b011011011 #b11000)
                arg3
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                arg3
                (fp #b0 #b101010110 #b00101)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.isPositive expect))
(assert (fp.leq (fp #b1 #b110100110 #b11111)
                expect
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                expect
                (fp #b0 #b111100110 #b01011)))

(assert (= expect result))

(check-sat)
(exit)
