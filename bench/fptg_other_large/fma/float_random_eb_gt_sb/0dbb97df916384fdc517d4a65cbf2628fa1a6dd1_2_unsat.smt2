(assert (fp.leq (fp #b0 #b000000000000 #b0111)
                arg2
                (fp #b0 #b100000101000 #b0101)))

(declare-const arg3 (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b1 #b111100101001 #b1011)
                arg3
                (fp #b0 #b100000000100 #b0000)))
(assert (fp.leq (fp #b0 #b100000000100 #b0000)
                arg3
                (fp #b0 #b111011111110 #b1100)))

(declare-const result (_ FloatingPoint 12 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 5))
(assert (fp.leq (fp #b0 #b010001001011 #b0101)
                expect
                (fp #b0 #b100000000100 #b0001)))
(assert (fp.leq (fp #b0 #b100000000100 #b0001)
                expect
                (fp #b0 #b101101111111 #b0011)))

(assert (not (= expect result)))

(check-sat)
(exit)
