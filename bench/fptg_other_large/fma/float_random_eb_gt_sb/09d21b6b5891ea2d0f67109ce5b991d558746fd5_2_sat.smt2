(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1101010001000101 #b110)
                arg1
                (fp #b0 #b1010010010100101 #b101)))
(assert (fp.leq (fp #b0 #b1010010010100101 #b101)
                arg1
                (fp #b0 #b1110110111001101 #b000)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0100101100001111 #b001)
                arg3
                (fp #b0 #b0000000000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000)
                arg3
                (fp #b0 #b0000101001111110 #b011)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b0 #b0101000100101000 #b010)
                expect
                (fp #b0 #b1100100101001100 #b011)))
(assert (fp.leq (fp #b0 #b1100100101001100 #b011)
                expect
                (fp #b0 #b1111011111100101 #b000)))

(assert (= expect result))

(check-sat)
(exit)
