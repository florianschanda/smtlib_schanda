; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b110100001010101011 #b001111110)
                arg1
                (fp #b1 #b100000000000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b100000000000001001 #b000000000)
                arg1
                (fp #b1 #b001101010011010100 #b010101010)))

(declare-const arg2 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b001010011011011011 #b100011001)
                arg2
                (fp #b0 #b111111111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b000000000)
                arg2
                (fp #b0 #b111111111111111110 #b111110100)))

(declare-const arg3 (_ FloatingPoint 18 10))
(assert (fp.leq (fp #b1 #b111111111111111101 #b001001001)
                arg3
                (fp #b1 #b111111111111111101 #b000000000)))
(assert (fp.leq (fp #b1 #b111111111111111101 #b000000000)
                arg3
                (fp #b1 #b001110111100100011 #b100101111)))

(declare-const result (_ FloatingPoint 18 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 10))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
