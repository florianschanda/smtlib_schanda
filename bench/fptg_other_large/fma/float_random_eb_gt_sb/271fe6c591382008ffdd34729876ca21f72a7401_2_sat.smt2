(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b100000101011110 #b00)
                arg1
                (fp #b0 #b000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b000000000000000 #b01)
                arg1
                (fp #b0 #b101010100110000 #b01)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b010011110110010 #b10)
                arg2
                (fp #b1 #b000000000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000000000 #b10)
                arg2
                (fp #b0 #b010011010000110 #b00)))

(declare-const arg3 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b111110101011001 #b10)
                arg3
                (fp #b1 #b000000000000000 #b01)))
(assert (fp.leq (fp #b1 #b000000000000000 #b01)
                arg3
                (fp #b0 #b101011101100001 #b00)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b000010110010001 #b11)
                expect
                (fp #b1 #b000000000000000 #b10)))
(assert (fp.leq (fp #b1 #b000000000000000 #b10)
                expect
                (fp #b0 #b110111101111000 #b11)))

(assert (= expect result))

(check-sat)
(exit)
