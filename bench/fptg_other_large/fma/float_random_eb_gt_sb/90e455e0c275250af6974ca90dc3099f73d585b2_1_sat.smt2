; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111111111101 #b011111)
                arg1
                (fp #b1 #b1111111111101 #b000000)))
(assert (fp.leq (fp #b1 #b1111111111101 #b000000)
                arg1
                (fp #b0 #b0011100100011 #b000001)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111101010100 #b001100)
                arg2
                (fp #b1 #b1101101100100 #b001100)))
(assert (fp.leq (fp #b1 #b1101101100100 #b001100)
                arg2
                (fp #b1 #b0001010010010 #b010010)))

(declare-const arg3 (_ FloatingPoint 13 7))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1011010111100 #b111010)
                expect
                (fp #b0 #b1111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111111)
                expect
                (fp #b0 #b1111111111111 #b000000)))

(assert (= expect result))

(check-sat)
(exit)
