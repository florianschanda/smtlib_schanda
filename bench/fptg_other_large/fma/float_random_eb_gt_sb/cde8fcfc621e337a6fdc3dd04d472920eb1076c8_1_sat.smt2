(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b0 #b0011111101010 #b00001)
                arg1
                (fp #b0 #b1010110111010 #b00111)))
(assert (fp.leq (fp #b0 #b1010110111010 #b00111)
                arg1
                (fp #b0 #b1100010000100 #b00010)))

(declare-const arg2 (_ FloatingPoint 13 6))
(assert (fp.leq (fp #b1 #b1100110111010 #b10100)
                arg2
                (fp #b1 #b1000000000101 #b00000)))
(assert (fp.leq (fp #b1 #b1000000000101 #b00000)
                arg2
                (fp #b1 #b0000110101001 #b10000)))

(declare-const arg3 (_ FloatingPoint 13 6))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 13 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
