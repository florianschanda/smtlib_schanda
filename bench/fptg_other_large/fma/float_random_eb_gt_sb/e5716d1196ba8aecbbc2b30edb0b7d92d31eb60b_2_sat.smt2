                (fp #b0 #b001011000 #b00)))
(assert (fp.leq (fp #b0 #b001011000 #b00)
                arg2
                (fp #b0 #b010101010 #b00)))

(declare-const arg3 (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b111100010 #b11)
                arg3
                (fp #b1 #b010011101 #b11)))
(assert (fp.leq (fp #b1 #b010011101 #b11)
                arg3
                (fp #b1 #b001100110 #b01)))

(declare-const result (_ FloatingPoint 9 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 3))
(assert (fp.leq (fp #b1 #b100010110 #b10)
                expect
                (fp #b1 #b010011110 #b00)))
(assert (fp.leq (fp #b1 #b010011110 #b00)
                expect
                (fp #b1 #b000010010 #b11)))

(assert (= expect result))

(check-sat)
(exit)
