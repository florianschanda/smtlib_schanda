(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111111110 #b111)
                arg1
                (fp #b0 #b101011111 #b101)))
(assert (fp.leq (fp #b0 #b101011111 #b101)
                arg1
                (fp #b0 #b110001111 #b000)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b101000100 #b101)
                arg2
                (fp #b1 #b100000011 #b000)))
(assert (fp.leq (fp #b1 #b100000011 #b000)
                arg2
                (fp #b0 #b110010110 #b010)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b001011001 #b000)
                arg3
                (fp #b1 #b000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000 #b000)
                arg3
                (fp #b0 #b101011010 #b001)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110101100 #b100)
                expect
                (fp #b1 #b101100011 #b101)))
(assert (fp.leq (fp #b1 #b101100011 #b101)
                expect
                (fp #b0 #b100111010 #b110)))

(assert (= expect result))

(check-sat)
(exit)
