; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0111010111000011 #b011)
                arg1
                (fp #b1 #b0010001001001010 #b111)))
(assert (fp.leq (fp #b1 #b0010001001001010 #b111)
                arg1
                (fp #b0 #b0000111110111001 #b101)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1010101011010111 #b000)
                arg2
                (fp #b0 #b0000000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010)
                arg2
                (fp #b0 #b1110100001100011 #b100)))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0111100110011101 #b011)
                arg3
                (fp #b1 #b0000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000)
                arg3
                (fp #b0 #b0010001100001111 #b111)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.isNegative expect))
(assert (fp.leq (fp #b1 #b0111111111011001 #b000)
                expect
                (fp #b1 #b0000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b000)
                expect
                (fp #b0 #b0000111010101100 #b010)))

(assert (not (= expect result)))

(check-sat)
(exit)
