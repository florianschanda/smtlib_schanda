; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INFINITY
; Arg2: -INT_BOUNDARY
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11111101101011 #b0100000001)
                arg2
                (fp #b1 #b10000000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000000001010 #b0000000000)
                arg2
                (fp #b0 #b11111000001010 #b0001011000)))

(declare-const arg3 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11011000010010 #b0111110010)
                arg3
                (fp #b1 #b10100111111011 #b1000000111)))
(assert (fp.leq (fp #b1 #b10100111111011 #b1000000111)
                arg3
                (fp #b0 #b10011000010101 #b0010110111)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
