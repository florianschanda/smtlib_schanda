(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b1000110111 #b00)
                arg1
                (fp #b1 #b0000000000 #b00)))
(assert (fp.leq (fp #b1 #b0000000000 #b00)
                arg1
                (fp #b0 #b0101000100 #b10)))

(declare-const arg2 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b0000000000 #b00)
                arg2
                (fp #b0 #b0011001100 #b10)))
(assert (fp.leq (fp #b0 #b0011001100 #b10)
                arg2
                (fp #b0 #b0100010100 #b10)))

(declare-const arg3 (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1101110010 #b00)
                arg3
                (fp #b1 #b0000000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000000 #b10)
                arg3
                (fp #b0 #b0011010000 #b00)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1010101001 #b00)
                expect
                (fp #b1 #b0000000000 #b10)))
(assert (fp.leq (fp #b1 #b0000000000 #b10)
                expect
                (fp #b0 #b1111000110 #b00)))

(assert (not (= expect result)))

(check-sat)
(exit)
