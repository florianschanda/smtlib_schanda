(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b000101000 #b11100)
                arg1
                (fp #b0 #b001101101 #b00100)))
(assert (fp.leq (fp #b0 #b001101101 #b00100)
                arg1
                (fp #b0 #b100011100 #b11111)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111111 #b00000)
                arg2
                (fp #b1 #b111111110 #b11111)))
(assert (fp.leq (fp #b1 #b111111110 #b11111)
                arg2
                (fp #b1 #b011101100 #b11110)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b100001111 #b10101)
                arg3
                (fp #b1 #b000000000 #b00000)))
(assert (fp.leq (fp #b1 #b000000000 #b00000)
                arg3
                (fp #b0 #b101000101 #b11011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111100001 #b11010)
                expect
                (fp #b1 #b101101101 #b00011)))
(assert (fp.leq (fp #b1 #b101101101 #b00011)
                expect
                (fp #b1 #b000001100 #b00010)))

(assert (= expect result))

(check-sat)
(exit)
