(assert (fp.leq (fp #b1 #b1000000000000111 #b0000000)
                arg2
                (fp #b0 #b1000011100000110 #b1111101)))

(declare-const arg3 (_ FloatingPoint 16 8))
(assert (fp.leq (fp #b1 #b1100111011011100 #b1001010)
                arg3
                (fp #b0 #b1000000000000111 #b0000000)))
(assert (fp.leq (fp #b0 #b1000000000000111 #b0000000)
                arg3
                (fp #b0 #b1110001110110011 #b1000001)))

(declare-const result (_ FloatingPoint 16 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 8))
