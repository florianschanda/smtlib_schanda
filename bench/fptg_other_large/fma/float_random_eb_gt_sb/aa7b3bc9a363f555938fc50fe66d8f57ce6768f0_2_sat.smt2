(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b001100011010 #b00101)
                arg1
                (fp #b1 #b001001100000 #b10001)))
(assert (fp.leq (fp #b1 #b001001100000 #b10001)
                arg1
                (fp #b0 #b101001100111 #b10000)))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b101010100110 #b01001)
                expect
                (fp #b0 #b001001100000 #b10010)))
(assert (fp.leq (fp #b0 #b001001100000 #b10010)
                expect
                (fp #b0 #b010101110011 #b01001)))

(assert (= expect result))

(check-sat)
(exit)
