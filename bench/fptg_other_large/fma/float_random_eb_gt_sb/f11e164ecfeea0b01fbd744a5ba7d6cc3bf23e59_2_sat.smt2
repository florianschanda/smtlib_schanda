(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +REFERENCE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11100111110 #b010)
                arg1
                (fp #b0 #b00000101001 #b010)))
(assert (fp.leq (fp #b0 #b00000101001 #b010)
                arg1
                (fp #b0 #b10101001111 #b101)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11100001101 #b000)
                arg3
                (fp #b1 #b10010111001 #b111)))
(assert (fp.leq (fp #b1 #b10010111001 #b111)
                arg3
                (fp #b0 #b11100000110 #b101)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11001010010 #b000)
                expect
                (fp #b1 #b10010111001 #b111)))
(assert (fp.leq (fp #b1 #b10010111001 #b111)
                expect
                (fp #b0 #b01111011010 #b011)))

(assert (= expect result))

(check-sat)
(exit)
