(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 15 6))
(assert (fp.leq (fp #b1 #b011011100011101 #b00101)
                arg2
                (fp #b0 #b000010000110001 #b01000)))
(assert (fp.leq (fp #b0 #b000010000110001 #b01000)
                arg2
                (fp #b0 #b110001110000010 #b01011)))

(declare-const arg3 (_ FloatingPoint 15 6))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 15 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
