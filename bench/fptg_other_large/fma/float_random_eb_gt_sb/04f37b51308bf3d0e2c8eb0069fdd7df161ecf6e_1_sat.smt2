(assert (fp.leq (fp #b0 #b00000000000000 #b01000000000)
                arg3
                (fp #b0 #b11100000011000 #b10000100110)))

(declare-const result (_ FloatingPoint 14 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 12))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
