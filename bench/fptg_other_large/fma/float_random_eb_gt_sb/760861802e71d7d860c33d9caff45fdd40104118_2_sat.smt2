(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10101010001 #b0110111)
                arg1
                (fp #b1 #b10010000011 #b0110111)))
(assert (fp.leq (fp #b1 #b10010000011 #b0110111)
                arg1
                (fp #b0 #b00110111001 #b0110011)))

(declare-const arg2 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b11111110111 #b1110000)
                arg2
                (fp #b1 #b00000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000000 #b0100000)
                arg2
                (fp #b0 #b11011100001 #b0011001)))

(declare-const arg3 (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b1 #b10101001100 #b0100010)
                arg3
                (fp #b0 #b11111111101 #b0000000)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000000)
                arg3
                (fp #b0 #b11111111110 #b0100011)))

(declare-const result (_ FloatingPoint 11 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 8))
(assert (fp.leq (fp #b0 #b00010000101 #b1101100)
                expect
                (fp #b0 #b11111111101 #b0000001)))
(assert (fp.leq (fp #b0 #b11111111101 #b0000001)
                expect
                (fp #b0 #b11111111110 #b1010001)))

(assert (= expect result))

(check-sat)
(exit)
