                arg2
                (fp #b0 #b000100000000 #b100000010)))
(assert (fp.leq (fp #b0 #b000100000000 #b100000010)
                arg2
                (fp #b0 #b001111001010 #b000100001)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b111110100010 #b001100000)
                arg3
                (fp #b0 #b000000000000 #b000000000)))
(assert (fp.leq (fp #b0 #b000000000000 #b000000000)
                arg3
                (fp #b0 #b001010111100 #b001100000)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b110110111110 #b001111101)
                expect
                (fp #b1 #b100100000000 #b100000001)))
(assert (fp.leq (fp #b1 #b100100000000 #b100000001)
                expect
                (fp #b1 #b010001010001 #b110101101)))

(assert (not (= expect result)))

(check-sat)
(exit)
