; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: -ZERO
; Arg3: +RANDOM_NORMAL_LT_ONE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b0001100010 #b1)
                arg1
                (fp #b0 #b1000000001 #b0)))
(assert (fp.leq (fp #b0 #b1000000001 #b0)
                arg1
                (fp #b0 #b1110110011 #b1)))

(declare-const arg2 (_ FloatingPoint 10 2))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b1100100001 #b1)
                arg2
                (fp #b1 #b0000000000 #b0)))
(assert (fp.leq (fp #b1 #b0000000000 #b0)
                arg2
                (fp #b0 #b1100100011 #b0)))

(declare-const arg3 (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b0 #b0101100000 #b0)
                arg3
                (fp #b0 #b0101101111 #b1)))
(assert (fp.leq (fp #b0 #b0101101111 #b1)
                arg3
                (fp #b0 #b1110101110 #b0)))

(declare-const result (_ FloatingPoint 10 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 2))
(assert (fp.leq (fp #b1 #b1111000010 #b0)
                expect
                (fp #b0 #b0101101111 #b1)))
(assert (fp.leq (fp #b0 #b0101101111 #b1)
                expect
                (fp #b0 #b1110100001 #b1)))

(assert (= expect result))

(check-sat)
(exit)
