                (fp #b1 #b1111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111101 #b0000)
                arg3
                (fp #b1 #b1110101010 #b0001)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111110 #b1000)
                expect
                (fp #b1 #b1111111101 #b0000)))
(assert (fp.leq (fp #b1 #b1111111101 #b0000)
                expect
                (fp #b0 #b0111101001 #b0000)))

(assert (not (= expect result)))

