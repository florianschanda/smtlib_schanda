; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -INFINITY
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110100111100000 #b1110)
                arg1
                (fp #b1 #b100000000000100 #b0000)))
(assert (fp.leq (fp #b1 #b100000000000100 #b0000)
                arg1
                (fp #b0 #b010111010000010 #b0011)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b110011010011000 #b1000)
                arg3
                (fp #b0 #b100111011011001 #b1010)))
(assert (fp.leq (fp #b0 #b100111011011001 #b1010)
                arg3
                (fp #b0 #b110000001010001 #b0111)))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
