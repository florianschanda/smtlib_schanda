; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b0100011110 #b111101)
                arg1
                (fp #b0 #b1000000110 #b000000)))
(assert (fp.leq (fp #b0 #b1000000110 #b000000)
                arg1
                (fp #b0 #b1100001011 #b010011)))

(declare-const arg2 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b0010010001 #b010010)
                arg2
                (fp #b0 #b1111111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111)
                arg2
                (fp #b0 #b1111111111 #b000000)))

(declare-const arg3 (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b0 #b1110100011 #b110110)
                arg3
                (fp #b0 #b1111000000 #b000110)))
(assert (fp.leq (fp #b0 #b1111000000 #b000110)
                arg3
                (fp #b0 #b1111001101 #b101111)))

(declare-const result (_ FloatingPoint 10 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 7))
(assert (fp.leq (fp #b1 #b1100111011 #b111100)
                expect
                (fp #b0 #b1111111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111111)
                expect
                (fp #b0 #b1111111111 #b000000)))

(assert (= expect result))

(check-sat)
(exit)
