(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b001011011110011000 #b000011111101000)
                arg1
                (fp #b1 #b000000000000000000 #b010010100000101)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b010010100000101)
                arg1
                (fp #b0 #b111000010110000011 #b111001000001110)))

(declare-const arg2 (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b011100010111101001 #b000000111101110)
                arg2
                (fp #b1 #b000000000000000000 #b001010111010001)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b001010111010001)
                arg2
                (fp #b0 #b000101011101111101 #b101111101101111)))

(declare-const arg3 (_ FloatingPoint 18 16))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 18 16))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 16))
(assert (fp.leq (fp #b1 #b111101100111110000 #b111000001110010)
                expect
                (fp #b0 #b000000000000000000 #b001010111010010)))
(assert (fp.leq (fp #b0 #b000000000000000000 #b001010111010010)
                expect
                (fp #b0 #b001011100001110010 #b111011011110000)))

(assert (= expect result))

(check-sat)
(exit)
