(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10011110000 #b000001101)
                arg1
                (fp #b0 #b01011010111 #b101111110)))
(assert (fp.leq (fp #b0 #b01011010111 #b101111110)
                arg1
                (fp #b0 #b10111101110 #b000010101)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11000111101 #b000101000)
                arg3
                (fp #b1 #b10111111010 #b110010000)))
(assert (fp.leq (fp #b1 #b10111111010 #b110010000)
                arg3
                (fp #b0 #b00000101011 #b101111100)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11101111111 #b011000100)
                expect
                (fp #b1 #b10111111010 #b110010000)))
(assert (fp.leq (fp #b1 #b10111111010 #b110010000)
                expect
                (fp #b0 #b00101000111 #b010110110)))

(assert (= expect result))

(check-sat)
(exit)
