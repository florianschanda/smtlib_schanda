(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_LT_ONE
; Arg2: -NAN
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 2))
(assert (fp.leq (fp #b1 #b000110110 #b1)
                arg1
                (fp #b1 #b000000010 #b1)))
(assert (fp.leq (fp #b1 #b000000010 #b1)
                arg1
                (fp #b0 #b011000100 #b0)))

(declare-const arg2 (_ FloatingPoint 9 2))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 9 2))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 9 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 2))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
