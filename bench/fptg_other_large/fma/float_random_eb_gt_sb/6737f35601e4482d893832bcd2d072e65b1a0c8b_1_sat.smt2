                arg3
                (fp #b0 #b00110000101 #b01)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

