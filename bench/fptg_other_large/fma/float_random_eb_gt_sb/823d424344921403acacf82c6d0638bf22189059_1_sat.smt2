(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 8))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 8))
(assert (fp.leq (fp #b1 #b0100111011100 #b1011000)
                arg2
                (fp #b0 #b0011011100101 #b1001001)))
(assert (fp.leq (fp #b0 #b0011011100101 #b1001001)
                arg2
                (fp #b0 #b1010011101100 #b0010000)))

(declare-const arg3 (_ FloatingPoint 13 8))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 13 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 8))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
