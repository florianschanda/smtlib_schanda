;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11011101100100 #b0110)
                arg1
                (fp #b1 #b00000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000)
                arg1
