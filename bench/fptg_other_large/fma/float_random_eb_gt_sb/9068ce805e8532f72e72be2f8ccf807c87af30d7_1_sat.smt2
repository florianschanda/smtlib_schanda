(declare-const arg2 (_ FloatingPoint 14 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00001011101011 #b1011)
                arg2
                (fp #b0 #b00000000000000 #b0000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b0000)
                arg2
                (fp #b0 #b00011100001010 #b0011)))

(declare-const arg3 (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11101101100100 #b1101)
                arg3
                (fp #b1 #b01011000110101 #b0101)))
(assert (fp.leq (fp #b1 #b01011000110101 #b0101)
                arg3
                (fp #b0 #b10100001111011 #b1000)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b11111100011011 #b1101)
                expect
                (fp #b1 #b01011000110101 #b0101)))
(assert (fp.leq (fp #b1 #b01011000110101 #b0101)
                expect
                (fp #b0 #b00011100100011 #b1111)))

(assert (= expect result))

(check-sat)
(exit)
