; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: -RCP_SMALLEST_SUBNORMAL
; Arg3: +INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b001100000010 #b0111000000)
                arg1
                (fp #b0 #b101001010101 #b0000011000)))
(assert (fp.leq (fp #b0 #b101001010101 #b0000011000)
                arg1
                (fp #b0 #b110100001100 #b1011111000)))

(declare-const arg2 (_ FloatingPoint 12 11))
(assert (fp.isNegative arg2))
(assert (fp.isInfinite arg2))

(declare-const arg3 (_ FloatingPoint 12 11))
(assert (fp.leq (fp #b0 #b010110100001 #b1000000000)
                arg3
                (fp #b0 #b100000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b100000001010 #b0000000000)
                arg3
                (fp #b0 #b110011001001 #b0000110111)))

(declare-const result (_ FloatingPoint 12 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 11))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
