                arg3
                (fp #b0 #b0100101011 #b11)))
(assert (fp.leq (fp #b0 #b0100101011 #b11)
                arg3
                (fp #b0 #b1010011010 #b10)))

(declare-const result (_ FloatingPoint 10 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 3))
(assert (fp.leq (fp #b1 #b1100111100 #b00)
                expect
                (fp #b0 #b0100101011 #b11)))
(assert (fp.leq (fp #b0 #b0100101011 #b11)
                expect
                (fp #b0 #b1001110000 #b11)))

(assert (not (= expect result)))

