                arg3
                (fp #b0 #b00000000000000000 #b101)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b101)
                arg3
                (fp #b0 #b11010111110011110 #b011)))

(declare-const result (_ FloatingPoint 17 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 4))
(assert (fp.leq (fp #b1 #b11101011001001100 #b101)
                expect
