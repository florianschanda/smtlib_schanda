                arg2
                (fp #b0 #b1101010100000 #b01101101010)))
(assert (fp.leq (fp #b0 #b1101010100000 #b01101101010)
                arg2
                (fp #b0 #b1111010000001 #b11000101001)))

(declare-const arg3 (_ FloatingPoint 13 12))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
