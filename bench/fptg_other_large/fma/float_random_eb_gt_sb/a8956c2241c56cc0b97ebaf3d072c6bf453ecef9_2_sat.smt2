(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b0 #b00001101010001 #b01)
                arg1
                (fp #b0 #b11111111111101 #b00)))
(assert (fp.leq (fp #b0 #b11111111111101 #b00)
                arg1
                (fp #b0 #b11111111111110 #b10)))

(declare-const arg2 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11100001100010 #b00)
                arg2
                (fp #b1 #b11011000010001 #b10)))
(assert (fp.leq (fp #b1 #b11011000010001 #b10)
                arg2
                (fp #b1 #b11001101011110 #b00)))

(declare-const arg3 (_ FloatingPoint 14 3))
(assert (fp.leq (fp #b1 #b11010111100001 #b10)
                arg3
                (fp #b0 #b00000000000000 #b10)))
(assert (fp.leq (fp #b0 #b00000000000000 #b10)
                arg3
                (fp #b0 #b11001001110010 #b11)))

(declare-const result (_ FloatingPoint 14 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
