(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +LARGEST_NORMAL
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1111110000100010 #b1011)
                arg1
                (fp #b1 #b1111010100101010 #b1010)))
(assert (fp.leq (fp #b1 #b1111010100101010 #b1010)
                arg1
                (fp #b1 #b0100000101101111 #b0001)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b0111101101110100 #b1010)
                arg2
                (fp #b0 #b1111111111111110 #b1111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b1111)
                arg2
                (fp #b0 #b1111111111111111 #b0000)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b0010011110111100 #b0011)
                arg3
                (fp #b1 #b0000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b0000)
                arg3
                (fp #b0 #b0010011010110100 #b0001)))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
