(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b1 #b111111111101 #b01)
                arg1
                (fp #b1 #b111111111101 #b00)))
(assert (fp.leq (fp #b1 #b111111111101 #b00)
                arg1
                (fp #b1 #b010001001011 #b01)))

(declare-const arg2 (_ FloatingPoint 12 3))
(assert (fp.leq (fp #b0 #b100011010110 #b10)
                arg2
                (fp #b0 #b101101010100 #b01)))
(assert (fp.leq (fp #b0 #b101101010100 #b01)
                arg2
                (fp #b0 #b110100011110 #b11)))

(declare-const arg3 (_ FloatingPoint 12 3))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b110100111000 #b10)
                arg3
                (fp #b1 #b000000000000 #b00)))
(assert (fp.leq (fp #b1 #b000000000000 #b00)
                arg3
                (fp #b0 #b111011011000 #b11)))

(declare-const result (_ FloatingPoint 12 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 3))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
