; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: +INFINITY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111111111101 #b100)
                arg1
                (fp #b1 #b111111111101 #b000)))
(assert (fp.leq (fp #b1 #b111111111101 #b000)
                arg1
                (fp #b1 #b010011100001 #b110)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b010111111011 #b101)
                arg2
                (fp #b1 #b010100011010 #b011)))
(assert (fp.leq (fp #b1 #b010100011010 #b011)
                arg2
                (fp #b0 #b011000001110 #b011)))

(declare-const arg3 (_ FloatingPoint 12 4))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
