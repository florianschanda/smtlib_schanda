(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1011101110 #b0110001)
                arg1
                (fp #b1 #b0000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b0000000000 #b1111010)
                arg1
                (fp #b0 #b0001100111 #b1110111)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100111010 #b0011110)
                arg2
                (fp #b1 #b0111010011 #b0011001)))
(assert (fp.leq (fp #b1 #b0111010011 #b0011001)
                arg2
                (fp #b0 #b0101101011 #b1000111)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1100000001 #b1010011)
                expect
                (fp #b0 #b0111010011 #b0011001)))
(assert (fp.leq (fp #b0 #b0111010011 #b0011001)
                expect
                (fp #b0 #b1111111011 #b1001010)))

(assert (not (= expect result)))

(check-sat)
(exit)
