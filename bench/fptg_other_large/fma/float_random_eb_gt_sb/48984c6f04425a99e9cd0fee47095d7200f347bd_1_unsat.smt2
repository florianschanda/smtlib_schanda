(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b011000101 #b100)
                arg1
                (fp #b1 #b000000000 #b010)))
(assert (fp.leq (fp #b1 #b000000000 #b010)
                arg1
                (fp #b0 #b001111111 #b100)))

(declare-const arg2 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b110010100 #b111)
                arg2
                (fp #b1 #b000000000 #b101)))
(assert (fp.leq (fp #b1 #b000000000 #b101)
                arg2
                (fp #b0 #b101000010 #b100)))

(declare-const arg3 (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111001001 #b100)
                arg3
                (fp #b1 #b110101011 #b001)))
(assert (fp.leq (fp #b1 #b110101011 #b001)
                arg3
                (fp #b0 #b111010110 #b111)))

(declare-const result (_ FloatingPoint 9 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 4))
(assert (fp.leq (fp #b1 #b111010110 #b011)
                expect
                (fp #b1 #b110101011 #b000)))
(assert (fp.leq (fp #b1 #b110101011 #b000)
                expect
                (fp #b0 #b101100001 #b101)))

(assert (not (= expect result)))

(check-sat)
(exit)
