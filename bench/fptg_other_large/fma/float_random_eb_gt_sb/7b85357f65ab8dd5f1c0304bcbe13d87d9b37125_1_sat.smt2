(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b001011011 #b10100)
                arg1
                (fp #b0 #b001101101 #b00100)))
(assert (fp.leq (fp #b0 #b001101101 #b00100)
                arg1
                (fp #b0 #b100001001 #b11110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111111101 #b01111)
                arg2
                (fp #b1 #b000000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000000 #b01000)
                arg2
                (fp #b0 #b010001100 #b00000)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101111110 #b00101)
                arg3
                (fp #b1 #b100101011 #b00001)))
(assert (fp.leq (fp #b1 #b100101011 #b00001)
                arg3
                (fp #b0 #b001100101 #b00011)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b110111110 #b00000)
                expect
                (fp #b1 #b100101011 #b00001)))
(assert (fp.leq (fp #b1 #b100101011 #b00001)
                expect
                (fp #b0 #b100100000 #b01111)))

(assert (= expect result))

(check-sat)
(exit)
