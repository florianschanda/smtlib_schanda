; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_SUBNORMAL
; Arg2: -ZERO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.isPositive arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b011011010100 #b010100000)
                arg2
                (fp #b1 #b000000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b000000000000 #b000000000)
                arg2
                (fp #b0 #b000011001011 #b101110000)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b010010001110 #b110100110)
                arg3
                (fp #b0 #b000000000000 #b001100101)))
(assert (fp.leq (fp #b0 #b000000000000 #b001100101)
                arg3
                (fp #b0 #b000000010001 #b000111001)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
