                (fp #b0 #b001101100100011 #b0001001100011)))
(assert (fp.leq (fp #b0 #b001101100100011 #b0001001100011)
                arg3
                (fp #b0 #b110001110101100 #b1111001101010)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 14))
