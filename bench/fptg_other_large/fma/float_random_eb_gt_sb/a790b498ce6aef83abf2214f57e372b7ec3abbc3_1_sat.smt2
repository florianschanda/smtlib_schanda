                arg2
                (fp #b1 #b10100111111000010 #b11001)))
(assert (fp.leq (fp #b1 #b10100111111000010 #b11001)
                arg2
                (fp #b0 #b00010110001001110 #b00100)))

(declare-const arg3 (_ FloatingPoint 17 6))
(assert (fp.leq (fp #b1 #b01000111000011111 #b11011)
                arg3
                (fp #b0 #b00000000000000000 #b01000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b01000)
                arg3
                (fp #b0 #b01100111111001010 #b01010)))

(declare-const result (_ FloatingPoint 17 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 6))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
