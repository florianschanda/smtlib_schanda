(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 4))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110100101001011 #b010)
                arg1
                (fp #b1 #b000000000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b000)
                arg1
                (fp #b0 #b100010100111101 #b101)))

(declare-const arg2 (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b001001101100100 #b110)
                arg2
                (fp #b0 #b000000000000000 #b110)))
(assert (fp.leq (fp #b0 #b000000000000000 #b110)
                arg2
                (fp #b0 #b101011011110111 #b011)))

(declare-const arg3 (_ FloatingPoint 15 4))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 15 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 4))
(assert (fp.leq (fp #b1 #b101001111010011 #b101)
                expect
                (fp #b1 #b000000000000000 #b110)))
(assert (fp.leq (fp #b1 #b000000000000000 #b110)
                expect
                (fp #b0 #b100011011111111 #b101)))

(assert (= expect result))

(check-sat)
(exit)
