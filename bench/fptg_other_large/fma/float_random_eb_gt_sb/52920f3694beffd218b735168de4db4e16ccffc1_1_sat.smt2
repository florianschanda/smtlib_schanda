; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RCP_SMALLEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b100110011110 #b011100111)
                arg1
                (fp #b1 #b100000001001 #b000000000)))
(assert (fp.leq (fp #b1 #b100000001001 #b000000000)
                arg1
                (fp #b0 #b011100001000 #b001010100)))

(declare-const arg2 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b0 #b110111001101 #b101010010)
                arg2
                (fp #b0 #b111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b111111111101 #b000000000)
                arg2
                (fp #b0 #b111111111101 #b111000101)))

(declare-const arg3 (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b101111000110 #b010010011)
                arg3
                (fp #b0 #b111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b111111111110 #b111111111)
                arg3
                (fp #b0 #b111111111111 #b000000000)))

(declare-const result (_ FloatingPoint 12 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 10))
(assert (fp.leq (fp #b1 #b111111111111 #b000000000)
                expect
                (fp #b1 #b111111111110 #b111111111)))
(assert (fp.leq (fp #b1 #b111111111110 #b111111111)
                expect
                (fp #b1 #b100001111101 #b001001111)))

(assert (= expect result))

(check-sat)
(exit)
