(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +INT_BOUNDARY
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b111010001011 #b011)
                arg1
                (fp #b1 #b101111101100 #b010)))
(assert (fp.leq (fp #b1 #b101111101100 #b010)
                arg1
                (fp #b0 #b100100101100 #b100)))

(declare-const arg2 (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b0 #b011101000101 #b010)
                arg2
                (fp #b0 #b100000000011 #b000)))
(assert (fp.leq (fp #b0 #b100000000011 #b000)
                arg2
                (fp #b0 #b110011001110 #b000)))

(declare-const arg3 (_ FloatingPoint 12 4))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b010001100010 #b111)
                arg3
                (fp #b1 #b000000000000 #b000)))
(assert (fp.leq (fp #b1 #b000000000000 #b000)
                arg3
                (fp #b0 #b001001101000 #b001)))

(declare-const result (_ FloatingPoint 12 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 4))
(assert (fp.leq (fp #b1 #b110111111100 #b000)
                expect
                (fp #b1 #b101111110000 #b010)))
(assert (fp.leq (fp #b1 #b101111110000 #b010)
                expect
                (fp #b0 #b010101111010 #b101)))

(assert (= expect result))

(check-sat)
(exit)
