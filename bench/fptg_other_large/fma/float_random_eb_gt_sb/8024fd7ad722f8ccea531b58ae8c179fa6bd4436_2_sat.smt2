(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_NORMAL_LT_ONE
; Arg3: -INT_BOUNDARY

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b0 #b111110100111 #b0)
                arg1
                (fp #b0 #b111111111110 #b1)))
(assert (fp.leq (fp #b0 #b111111111110 #b1)
                arg1
                (fp #b0 #b111111111111 #b0)))

(declare-const arg2 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b110001010000 #b1)
                arg2
                (fp #b1 #b000001011110 #b0)))
(assert (fp.leq (fp #b1 #b000001011110 #b0)
                arg2
                (fp #b0 #b001010101011 #b1)))

(declare-const arg3 (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b110001110001 #b1)
                arg3
                (fp #b1 #b100000000001 #b0)))
(assert (fp.leq (fp #b1 #b100000000001 #b0)
                arg3
                (fp #b0 #b011010110001 #b0)))

(declare-const result (_ FloatingPoint 12 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 2))
(assert (fp.leq (fp #b1 #b110000000100 #b1)
                expect
                (fp #b1 #b100001011110 #b0)))
(assert (fp.leq (fp #b1 #b100001011110 #b0)
                expect
                (fp #b0 #b010001010101 #b1)))

(assert (= expect result))

(check-sat)
(exit)
