(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b11001110111111 #b011)
                arg1
                (fp #b1 #b00000000000000 #b010)))
(assert (fp.leq (fp #b1 #b00000000000000 #b010)
                arg1
                (fp #b0 #b00100010101010 #b100)))

(declare-const arg2 (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b0 #b00100101011000 #b111)
                arg2
                (fp #b0 #b01000111111111 #b101)))
(assert (fp.leq (fp #b0 #b01000111111111 #b101)
                arg2
                (fp #b0 #b10001110100000 #b111)))

(declare-const arg3 (_ FloatingPoint 14 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b10010001111111 #b000)
                arg3
                (fp #b0 #b00000000000000 #b000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b000)
                arg3
                (fp #b0 #b00110110001001 #b011)))

(declare-const result (_ FloatingPoint 14 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 4))
(assert (fp.leq (fp #b1 #b01011010110110 #b101)
                expect
                (fp #b1 #b00000000000000 #b001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b001)
                expect
                (fp #b0 #b11010011010111 #b001)))

(assert (not (= expect result)))

(check-sat)
(exit)
