; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_SMALLEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b011010111100010 #b00)
                arg1
                (fp #b0 #b111111111111101 #b00)))
(assert (fp.leq (fp #b0 #b111111111111101 #b00)
                arg1
                (fp #b0 #b111111111111111 #b00)))

(declare-const arg2 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b000011101111011 #b11)
                arg2
                (fp #b0 #b100100000110010 #b10)))
(assert (fp.leq (fp #b0 #b100100000110010 #b10)
                arg2
                (fp #b0 #b110110110110100 #b01)))

(declare-const arg3 (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b1 #b010101101100011 #b01)
                arg3
                (fp #b0 #b000000000000000 #b10)))
(assert (fp.leq (fp #b0 #b000000000000000 #b10)
                arg3
                (fp #b0 #b100010000010101 #b01)))

(declare-const result (_ FloatingPoint 15 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 3))
(assert (fp.leq (fp #b0 #b110011100111100 #b10)
                expect
                (fp #b0 #b111111111111110 #b11)))
(assert (fp.leq (fp #b0 #b111111111111110 #b11)
                expect
                (fp #b0 #b111111111111111 #b00)))

(assert (= expect result))

(check-sat)
(exit)
