                arg2
                (fp #b0 #b11111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b11111111111101 #b000000000)
                arg2
                (fp #b0 #b11111111111101 #b000100011)))

(declare-const arg3 (_ FloatingPoint 14 10))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 14 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 10))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
