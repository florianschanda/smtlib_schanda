(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTN) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b1010100100 #b101)
                arg1
                (fp #b0 #b1111111110 #b111)))
(assert (fp.leq (fp #b0 #b1111111110 #b111)
                arg1
                (fp #b0 #b1111111111 #b000)))

(declare-const arg2 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b0100110100 #b010)
                arg2
                (fp #b1 #b0000000000 #b101)))
(assert (fp.leq (fp #b1 #b0000000000 #b101)
                arg2
                (fp #b0 #b1100011011 #b001)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1000100010 #b101)
                arg3
                (fp #b0 #b1101101011 #b001)))
(assert (fp.leq (fp #b0 #b1101101011 #b001)
                arg3
                (fp #b0 #b1110000000 #b011)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b0 #b0010000010 #b100)
                expect
                (fp #b0 #b1101101011 #b000)))
(assert (fp.leq (fp #b0 #b1101101011 #b000)
                expect
                (fp #b0 #b1110001101 #b110)))

(assert (not (= expect result)))

(check-sat)
(exit)
