(assert (fp.leq (fp #b1 #b1111101100000101 #b000)
                arg3
                (fp #b1 #b1110110101111011 #b110)))
(assert (fp.leq (fp #b1 #b1110110101111011 #b110)
                arg3
                (fp #b0 #b0111010000100101 #b100)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b1111010000010111 #b110)
                expect
                (fp #b1 #b1110110101111011 #b110)))
(assert (fp.leq (fp #b1 #b1110110101111011 #b110)
                expect
                (fp #b1 #b1011111111110010 #b111)))

(assert (= expect result))

(check-sat)
(exit)
