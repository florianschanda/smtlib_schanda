(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: +REFERENCE
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11010100100 #b101000101)
                arg1
                (fp #b1 #b00000000000 #b100100111)))
(assert (fp.leq (fp #b1 #b00000000000 #b100100111)
                arg1
                (fp #b0 #b10001110110 #b101101001)))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b10100010100 #b110100100)
                expect
                (fp #b0 #b00000000000 #b100101000)))
(assert (fp.leq (fp #b0 #b00000000000 #b100101000)
                expect
                (fp #b0 #b11001101000 #b101110010)))

(assert (= expect result))

(check-sat)
(exit)
