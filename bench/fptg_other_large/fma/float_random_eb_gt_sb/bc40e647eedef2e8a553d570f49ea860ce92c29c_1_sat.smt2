(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: +INT_BOUNDARY
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 5))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b000110110000100 #b0000)
                arg1
                (fp #b1 #b000000000000000 #b0000)))
(assert (fp.leq (fp #b1 #b000000000000000 #b0000)
                arg1
                (fp #b0 #b001100111101001 #b0000)))

(declare-const arg2 (_ FloatingPoint 15 5))
(assert (fp.leq (fp #b1 #b111001100000000 #b1010)
                arg2
                (fp #b0 #b100000000000100 #b0000)))
(assert (fp.leq (fp #b0 #b100000000000100 #b0000)
                arg2
                (fp #b0 #b110101001110110 #b0011)))

(declare-const arg3 (_ FloatingPoint 15 5))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 15 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 5))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
