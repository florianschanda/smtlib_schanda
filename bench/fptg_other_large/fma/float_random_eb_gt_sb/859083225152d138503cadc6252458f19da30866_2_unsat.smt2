                arg2
                (fp #b0 #b0000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b0000000000 #b01000011)
                arg2
                (fp #b0 #b1111001010 #b11111111)))

(declare-const arg3 (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b1 #b0110101011 #b11000010)
                arg3
                (fp #b0 #b1000001000 #b00000000)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000000)
                arg3
                (fp #b0 #b1100010110 #b11100010)))

(declare-const result (_ FloatingPoint 10 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 9))
(assert (fp.leq (fp #b0 #b0010001111 #b11010101)
                expect
                (fp #b0 #b1000001000 #b00000001)))
(assert (fp.leq (fp #b0 #b1000001000 #b00000001)
                expect
                (fp #b0 #b1100101100 #b00010111)))

(assert (not (= expect result)))

(check-sat)
(exit)
