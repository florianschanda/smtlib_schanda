; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_SUBNORMAL
; Arg2: -REFERENCE
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b00011101110101 #b1110111)
                arg1
                (fp #b1 #b00000000000000 #b1111010)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1111010)
                arg1
                (fp #b0 #b10111000001100 #b1100100)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (= arg2 (fp.neg arg1)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11110110111110 #b1010110)
                arg3
                (fp #b1 #b10111111110100 #b0000000)))
(assert (fp.leq (fp #b1 #b10111111110100 #b0000000)
                arg3
                (fp #b1 #b10111111010010 #b1010101)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11110111000101 #b1110100)
                expect
                (fp #b1 #b10111111110100 #b0000000)))
(assert (fp.leq (fp #b1 #b10111111110100 #b0000000)
                expect
                (fp #b1 #b10000111100011 #b0000100)))

(assert (= expect result))

(check-sat)
(exit)
