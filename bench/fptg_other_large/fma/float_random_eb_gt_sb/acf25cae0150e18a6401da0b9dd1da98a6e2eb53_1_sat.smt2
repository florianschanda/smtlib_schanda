(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0011000000111111 #b00111111)
                arg1
                (fp #b0 #b0000000000000000 #b01010111)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01010111)
                arg1
                (fp #b0 #b0100011010111010 #b10000011)))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1001001001100001 #b11100110)
                arg2
                (fp #b0 #b0000000000000000 #b01000011)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01000011)
                arg2
                (fp #b0 #b1010100111001101 #b00010011)))

(declare-const arg3 (_ FloatingPoint 16 9))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b1011110001110011 #b11000100)
                expect
                (fp #b1 #b0000000000000000 #b01000010)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01000010)
                expect
                (fp #b0 #b1101011000001010 #b11010100)))

(assert (= expect result))

(check-sat)
(exit)
