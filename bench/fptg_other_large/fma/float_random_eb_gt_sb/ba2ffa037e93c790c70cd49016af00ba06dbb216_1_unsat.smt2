(assert (fp.leq (fp #b1 #b110111000101101 #b0)
                arg3
                (fp #b1 #b101001011111011 #b0)))

(declare-const result (_ FloatingPoint 15 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 2))
(assert (fp.leq (fp #b1 #b111001000100111 #b1)
                expect
