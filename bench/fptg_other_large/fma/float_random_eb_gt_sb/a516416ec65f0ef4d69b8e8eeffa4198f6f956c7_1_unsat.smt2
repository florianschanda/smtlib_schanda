(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 10))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 11 10))
(assert (fp.leq (fp #b1 #b11011110100 #b001000011)
                arg2
                (fp #b0 #b11100001111 #b000010001)))
(assert (fp.leq (fp #b0 #b11100001111 #b000010001)
                arg2
                (fp #b0 #b11100101011 #b111010000)))

(declare-const arg3 (_ FloatingPoint 11 10))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b11111000111 #b000011001)
                arg3
                (fp #b1 #b00000000000 #b000000000)))
(assert (fp.leq (fp #b1 #b00000000000 #b000000000)
                arg3
                (fp #b0 #b01110101100 #b001111000)))

(declare-const result (_ FloatingPoint 11 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 10))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
