(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b000111101 #b1100)
                arg1
                (fp #b0 #b001100011 #b1110)))
(assert (fp.leq (fp #b0 #b001100011 #b1110)
                arg1
                (fp #b0 #b011001011 #b0111)))

(declare-const arg2 (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b0 #b010101010 #b1000)
                arg2
                (fp #b0 #b111011110 #b1000)))
(assert (fp.leq (fp #b0 #b111011110 #b1000)
                arg2
                (fp #b0 #b111110000 #b1101)))

(declare-const arg3 (_ FloatingPoint 9 5))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 9 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 5))
(assert (fp.leq (fp #b1 #b111110110 #b0011)
                expect
                (fp #b1 #b111011110 #b0111)))
(assert (fp.leq (fp #b1 #b111011110 #b0111)
                expect
                (fp #b1 #b110011101 #b1101)))

(assert (not (= expect result)))

(check-sat)
(exit)
