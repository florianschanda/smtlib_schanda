(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b00011110110 #b100)
                arg1
                (fp #b0 #b00000000000 #b010)))
(assert (fp.leq (fp #b0 #b00000000000 #b010)
                arg1
                (fp #b0 #b00000110110 #b010)))

(declare-const arg2 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b10100111100 #b000)
                arg2
                (fp #b0 #b01001010110 #b111)))
(assert (fp.leq (fp #b0 #b01001010110 #b111)
                arg2
                (fp #b0 #b11100111010 #b001)))

(declare-const arg3 (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11011110001 #b110)
                arg3
                (fp #b1 #b00000000000 #b100)))
(assert (fp.leq (fp #b1 #b00000000000 #b100)
                arg3
                (fp #b0 #b10100010101 #b011)))

(declare-const result (_ FloatingPoint 11 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 4))
(assert (fp.leq (fp #b1 #b11111011100 #b000)
                expect
                (fp #b1 #b00000000000 #b011)))
(assert (fp.leq (fp #b1 #b00000000000 #b011)
                expect
                (fp #b0 #b10111110000 #b001)))

(assert (= expect result))

(check-sat)
(exit)
