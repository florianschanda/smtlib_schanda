; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b10001011010001 #b0001011000)
                arg1
                (fp #b0 #b10000000001010 #b0000000000)))
(assert (fp.leq (fp #b0 #b10000000001010 #b0000000000)
                arg1
                (fp #b0 #b10011101001110 #b0000111111)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b10011111100011 #b1111101001)
                arg2
                (fp #b0 #b11010010001011 #b1101101010)))
(assert (fp.leq (fp #b0 #b11010010001011 #b1101101010)
                arg2
                (fp #b0 #b11010011010111 #b1011010011)))

(declare-const arg3 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11111111111110 #b0010100110)
                arg3
                (fp #b1 #b11111111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000)
                arg3
                (fp #b1 #b01111110100111 #b0011110101)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11111111111101 #b1100111000)
                expect
                (fp #b1 #b11111111111101 #b0000000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000000)
                expect
                (fp #b0 #b10001000001011 #b0010100001)))

(assert (= expect result))

(check-sat)
(exit)
