(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010000110 #b0111100)
                arg1
                (fp #b1 #b1000000111 #b0000000)))
(assert (fp.leq (fp #b1 #b1000000111 #b0000000)
                arg1
                (fp #b0 #b1011011110 #b1100011)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1010010110 #b1111110)
                arg2
                (fp #b1 #b0000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b0000000000 #b1101110)
                arg2
                (fp #b0 #b1001011010 #b1000000)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1110100100 #b0011000)
                arg3
                (fp #b0 #b0000000000 #b1000110)))
(assert (fp.leq (fp #b0 #b0000000000 #b1000110)
                arg3
                (fp #b0 #b0100010011 #b1111001)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0000000110 #b1100110)
                expect
                (fp #b0 #b0000001000 #b1011101)))
(assert (fp.leq (fp #b0 #b0000001000 #b1011101)
                expect
                (fp #b0 #b1011100101 #b0111101)))

(assert (= expect result))

(check-sat)
(exit)
