(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1001111000 #b0100011)
                arg1
                (fp #b0 #b0000000000 #b1100101)))
(assert (fp.leq (fp #b0 #b0000000000 #b1100101)
                arg1
                (fp #b0 #b1101011100 #b0110101)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b0010011111 #b1010001)
                arg2
                (fp #b0 #b1001101000 #b0110010)))
(assert (fp.leq (fp #b0 #b1001101000 #b0110010)
                arg2
                (fp #b0 #b1101110001 #b1000000)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b1011010001 #b1111110)
                arg3
                (fp #b1 #b0000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b0000000000 #b0000000)
                arg3
                (fp #b0 #b1010001100 #b0111110)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1101000000 #b0010010)
                expect
                (fp #b0 #b0001101010 #b0001101)))
(assert (fp.leq (fp #b0 #b0001101010 #b0001101)
                expect
                (fp #b0 #b0001110010 #b1000111)))

(assert (not (= expect result)))

(check-sat)
(exit)
