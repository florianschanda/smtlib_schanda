                arg3
                (fp #b1 #b00000000000000 #b0100)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100)
                arg3
                (fp #b0 #b01100100011110 #b0101)))

(declare-const result (_ FloatingPoint 14 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 5))
(assert (fp.leq (fp #b1 #b01010000111000 #b0011)
                expect
                (fp #b1 #b00000000000000 #b0011)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0011)
                expect
                (fp #b0 #b01100111001100 #b1100)))

(assert (= expect result))

(check-sat)
(exit)
