(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status unsat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11010111010 #b0000)
                arg1
                (fp #b1 #b10101001101 #b0110)))
(assert (fp.leq (fp #b1 #b10101001101 #b0110)
                arg1
                (fp #b1 #b10100100110 #b0111)))

(declare-const arg2 (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b11001111110 #b1010)
                arg2
                (fp #b0 #b00000000000 #b0111)))
(assert (fp.leq (fp #b0 #b00000000000 #b0111)
                arg2
                (fp #b0 #b11100000100 #b0110)))

(declare-const arg3 (_ FloatingPoint 11 5))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 5))
(assert (fp.leq (fp #b1 #b10001100000 #b0011)
                expect
                (fp #b1 #b00101001110 #b0100)))
(assert (fp.leq (fp #b1 #b00101001110 #b0100)
                expect
                (fp #b0 #b00010101110 #b0100)))

(assert (not (= expect result)))

(check-sat)
(exit)
