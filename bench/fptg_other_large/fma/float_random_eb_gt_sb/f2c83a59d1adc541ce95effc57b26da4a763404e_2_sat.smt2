(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_SUBNORMAL
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTN))

(declare-const arg1 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b01001100001101 #b11111)
                arg1
                (fp #b0 #b00000000000000 #b11001)))
(assert (fp.leq (fp #b0 #b00000000000000 #b11001)
                arg1
                (fp #b0 #b11001011001010 #b01101)))

(declare-const arg2 (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b11001101000000 #b10110)
                arg2
                (fp #b1 #b00000000000000 #b01000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b01000)
                arg2
                (fp #b0 #b11001111010101 #b10100)))

(declare-const arg3 (_ FloatingPoint 14 6))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b10101001001001 #b10000)
                arg3
                (fp #b0 #b00000000000000 #b00000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000)
                arg3
                (fp #b0 #b10101111111111 #b10111)))

(declare-const result (_ FloatingPoint 14 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 6))
(assert (fp.leq (fp #b1 #b00111011010110 #b11100)
                expect
                (fp #b1 #b00000000000000 #b00001)))
(assert (fp.leq (fp #b1 #b00000000000000 #b00001)
                expect
                (fp #b0 #b11000101011001 #b01100)))

(assert (= expect result))

(check-sat)
(exit)
