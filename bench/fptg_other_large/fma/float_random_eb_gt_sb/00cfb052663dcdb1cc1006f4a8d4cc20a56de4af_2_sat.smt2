; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b0 #b1001011111110 #b000110)
                arg1
                (fp #b0 #b1111111111110 #b111111)))
(assert (fp.leq (fp #b0 #b1111111111110 #b111111)
                arg1
                (fp #b0 #b1111111111111 #b000000)))

(declare-const arg2 (_ FloatingPoint 13 7))
(assert (fp.leq (fp #b1 #b1111111010111 #b100100)
                arg2
                (fp #b0 #b1010001111010 #b101010)))
(assert (fp.leq (fp #b0 #b1010001111010 #b101010)
                arg2
                (fp #b0 #b1101100100110 #b111000)))

(declare-const arg3 (_ FloatingPoint 13 7))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 13 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
