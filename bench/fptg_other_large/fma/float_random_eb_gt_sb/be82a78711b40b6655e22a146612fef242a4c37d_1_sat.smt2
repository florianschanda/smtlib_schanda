(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -ZERO
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 13 12))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 13 12))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b0000000111010 #b01001000111)
                arg2
                (fp #b1 #b0000000000000 #b00000000000)))
(assert (fp.leq (fp #b1 #b0000000000000 #b00000000000)
                arg2
                (fp #b0 #b0110101100010 #b01001010001)))

(declare-const arg3 (_ FloatingPoint 13 12))
(assert (fp.leq (fp #b1 #b1010000101000 #b10110000000)
                arg3
                (fp #b0 #b0000000000000 #b01000000000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b01000000000)
                arg3
                (fp #b0 #b1101110100001 #b10011000001)))

(declare-const result (_ FloatingPoint 13 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 12))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
