(assert (fp.leq (fp #b1 #b1010010010 #b110)
                arg2
                (fp #b0 #b0000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000 #b000)
                arg2
                (fp #b0 #b1101001101 #b000)))

(declare-const arg3 (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010001111 #b010)
                arg3
                (fp #b1 #b1001100000 #b010)))
(assert (fp.leq (fp #b1 #b1001100000 #b010)
                arg3
                (fp #b0 #b1011011001 #b011)))

(declare-const result (_ FloatingPoint 10 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 4))
(assert (fp.leq (fp #b1 #b1010110100 #b100)
                expect
                (fp #b1 #b1001100000 #b010)))
(assert (fp.leq (fp #b1 #b1001100000 #b010)
                expect
                (fp #b1 #b1000010010 #b100)))

(assert (not (= expect result)))

(check-sat)
(exit)
