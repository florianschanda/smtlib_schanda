(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b00101101111101 #b1100111)
                arg1
                (fp #b1 #b00000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100000)
                arg1
                (fp #b0 #b11100111001111 #b1100011)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b10111100101100 #b1110001)
                arg2
                (fp #b1 #b00000000000000 #b1101110)))
(assert (fp.leq (fp #b1 #b00000000000000 #b1101110)
                arg2
                (fp #b0 #b01110101010000 #b1110000)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11000100111100 #b0001111)
                arg3
                (fp #b0 #b00000000000000 #b1000110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1000110)
                arg3
                (fp #b0 #b10011010101001 #b1101000)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111100 #b0001110)
                expect
                (fp #b0 #b00000000000000 #b1000110)))
(assert (fp.leq (fp #b0 #b00000000000000 #b1000110)
                expect
                (fp #b0 #b10100011110111 #b0101001)))

(assert (= expect result))

(check-sat)
(exit)
