(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0010110101010110 #b10)
                arg1
                (fp #b0 #b0011111100100000 #b10)))
(assert (fp.leq (fp #b0 #b0011111100100000 #b10)
                arg1
                (fp #b0 #b0110110000010000 #b01)))

(declare-const arg2 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b1001111111110111 #b11)
                arg2
                (fp #b0 #b1000111101101111 #b01)))
(assert (fp.leq (fp #b0 #b1000111101101111 #b01)
                arg2
                (fp #b0 #b1010101000110101 #b10)))

(declare-const arg3 (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0010001101011111 #b11)
                arg3
                (fp #b0 #b0000000000000000 #b01)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b01)
                arg3
                (fp #b0 #b1011011010011100 #b11)))

(declare-const result (_ FloatingPoint 16 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 3))
(assert (fp.leq (fp #b1 #b0110111011110011 #b00)
                expect
                (fp #b0 #b0100111010010001 #b00)))
(assert (fp.leq (fp #b0 #b0100111010010001 #b00)
                expect
                (fp #b0 #b1100100110110000 #b10)))

(assert (= expect result))

(check-sat)
(exit)
