(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111101000001 #b1010001)
                arg1
                (fp #b1 #b00000000000000 #b0100000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0100000)
                arg1
                (fp #b0 #b01001011010000 #b1010000)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b01100111100000 #b0110111)
                arg2
                (fp #b0 #b01100001000101 #b0000000)))
(assert (fp.leq (fp #b0 #b01100001000101 #b0000000)
                arg2
                (fp #b0 #b10011111111001 #b1011000)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111101 #b1111011)
                arg3
                (fp #b1 #b11111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000)
                arg3
                (fp #b1 #b00001100110111 #b0011111)))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111110 #b1101111)
                expect
                (fp #b1 #b11111111111101 #b0000000)))
(assert (fp.leq (fp #b1 #b11111111111101 #b0000000)
                expect
                (fp #b1 #b10000110010111 #b0010000)))

(assert (= expect result))

(check-sat)
(exit)
