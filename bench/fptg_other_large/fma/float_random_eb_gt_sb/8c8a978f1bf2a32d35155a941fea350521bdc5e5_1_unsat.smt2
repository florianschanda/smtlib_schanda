; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: -ZERO
; Arg3: +NAN

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 8))
(assert (fp.leq (fp #b1 #b11111111111111 #b0000000)
                arg1
                (fp #b1 #b11111111111110 #b1111111)))
(assert (fp.leq (fp #b1 #b11111111111110 #b1111111)
                arg1
                (fp #b0 #b01011110010011 #b1100000)))

(declare-const arg2 (_ FloatingPoint 14 8))
(assert (fp.isNegative arg2))
(assert (fp.leq (fp #b1 #b01001111111110 #b1011100)
                arg2
                (fp #b1 #b00000000000000 #b0000000)))
(assert (fp.leq (fp #b1 #b00000000000000 #b0000000)
                arg2
                (fp #b0 #b10111101110011 #b1110101)))

(declare-const arg3 (_ FloatingPoint 14 8))
(assert (fp.isNaN arg3))

(declare-const result (_ FloatingPoint 14 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 8))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
