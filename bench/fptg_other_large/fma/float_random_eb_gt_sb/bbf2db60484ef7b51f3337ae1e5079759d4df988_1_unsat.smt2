; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RCP_LARGEST_NORMAL
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b1 #b1010111110011010 #b1111)
                arg1
                (fp #b0 #b0000000000000000 #b0100)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b0100)
                arg1
                (fp #b0 #b1000001001100000 #b0111)))

(declare-const arg2 (_ FloatingPoint 16 5))
(assert (fp.leq (fp #b0 #b0101111010010001 #b1001)
                arg2
                (fp #b0 #b0110101101000001 #b0111)))
(assert (fp.leq (fp #b0 #b0110101101000001 #b0111)
                arg2
                (fp #b0 #b0111000101010001 #b1101)))

(declare-const arg3 (_ FloatingPoint 16 5))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 5))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
