; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +REFERENCE
; Arg3: +REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))
(assert (not (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b10000010110 #b011000)
                arg1
                (fp #b0 #b10010001010 #b011101)))
(assert (fp.leq (fp #b0 #b10010001010 #b011101)
                arg1
                (fp #b0 #b11110110000 #b000000)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (= arg2 arg1))

(declare-const arg3 (_ FloatingPoint 11 7))
(assert (= arg3 arg2))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b0 #b10000011010 #b100011)
                expect
                (fp #b0 #b10100010110 #b000100)))
(assert (fp.leq (fp #b0 #b10100010110 #b000100)
                expect
                (fp #b0 #b10101100010 #b011010)))

(assert (= expect result))

(check-sat)
(exit)
