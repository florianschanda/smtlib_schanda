(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -RCP_SMALLEST_SUBNORMAL
; Arg2: +LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 15 14))
(assert (fp.isNegative arg1))
(assert (fp.isInfinite arg1))

(declare-const arg2 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b011101100011001 #b0111011110011)
                arg2
                (fp #b0 #b111111111111110 #b1111111111111)))
(assert (fp.leq (fp #b0 #b111111111111110 #b1111111111111)
                arg2
                (fp #b0 #b111111111111111 #b0000000000000)))

(declare-const arg3 (_ FloatingPoint 15 14))
(assert (fp.leq (fp #b1 #b100011110101000 #b0111110101111)
                arg3
                (fp #b1 #b100010100100110 #b0100010001111)))
(assert (fp.leq (fp #b1 #b100010100100110 #b0100010001111)
                arg3
                (fp #b1 #b001001010011110 #b1001111011000)))

(declare-const result (_ FloatingPoint 15 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 15 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
