(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RANDOM_NORMAL_LT_ONE
; Arg3: -ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b11101101101101101 #b1)
                arg1
                (fp #b0 #b10100010010101000 #b1)))
(assert (fp.leq (fp #b0 #b10100010010101000 #b1)
                arg1
                (fp #b0 #b11101111010011000 #b0)))

(declare-const arg2 (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b1 #b01101110011111101 #b1)
                arg2
                (fp #b0 #b01111101101101110 #b1)))
(assert (fp.leq (fp #b0 #b01111101101101110 #b1)
                arg2
                (fp #b0 #b10111101001110010 #b1)))

(declare-const arg3 (_ FloatingPoint 17 2))
(assert (fp.isNegative arg3))
(assert (fp.leq (fp #b1 #b10000000101111000 #b1)
                arg3
                (fp #b1 #b00000000000000000 #b0)))
(assert (fp.leq (fp #b1 #b00000000000000000 #b0)
                arg3
                (fp #b0 #b10011011001111001 #b1)))

(declare-const result (_ FloatingPoint 17 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 2))
(assert (fp.leq (fp #b0 #b00010111000001000 #b1)
                expect
                (fp #b0 #b10100000000011000 #b0)))
(assert (fp.leq (fp #b0 #b10100000000011000 #b0)
                expect
                (fp #b0 #b11110100010110101 #b0)))

(assert (= expect result))

(check-sat)
(exit)
