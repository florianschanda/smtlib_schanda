(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +LARGEST_NORMAL
; Arg3: -RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 9 6))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b000010000 #b11001)
                arg1
                (fp #b0 #b000000000 #b00000)))
(assert (fp.leq (fp #b0 #b000000000 #b00000)
                arg1
                (fp #b0 #b011000111 #b11110)))

(declare-const arg2 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b0 #b100010001 #b11000)
                arg2
                (fp #b0 #b111111110 #b11111)))
(assert (fp.leq (fp #b0 #b111111110 #b11111)
                arg2
                (fp #b0 #b111111111 #b00000)))

(declare-const arg3 (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b101001011 #b00010)
                arg3
                (fp #b1 #b100101011 #b00001)))
(assert (fp.leq (fp #b1 #b100101011 #b00001)
                arg3
                (fp #b1 #b000000010 #b11110)))

(declare-const result (_ FloatingPoint 9 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 6))
(assert (fp.leq (fp #b1 #b111001101 #b01000)
                expect
                (fp #b1 #b100101011 #b00001)))
(assert (fp.leq (fp #b1 #b100101011 #b00001)
                expect
                (fp #b0 #b000100100 #b01011)))

(assert (= expect result))

(check-sat)
(exit)
