(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b0001011000 #b0001)
                arg2
                (fp #b1 #b0000000000 #b0100)))
(assert (fp.leq (fp #b1 #b0000000000 #b0100)
                arg2
                (fp #b0 #b0011101111 #b1100)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1000011001 #b1110)
                arg3
                (fp #b1 #b1000000100 #b0000)))
(assert (fp.leq (fp #b1 #b1000000100 #b0000)
                arg3
                (fp #b0 #b0101011001 #b1000)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
