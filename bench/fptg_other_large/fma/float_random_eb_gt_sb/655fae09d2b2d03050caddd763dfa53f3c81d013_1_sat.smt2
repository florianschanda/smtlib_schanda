(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_LT_ONE
; Arg2: +LARGEST_NORMAL
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTP)))

(declare-const arg1 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b0011010011101100 #b010000100)
                arg1
                (fp #b0 #b0100001001110101 #b101001110)))
(assert (fp.leq (fp #b0 #b0100001001110101 #b101001110)
                arg1
                (fp #b0 #b1110000000010010 #b001100110)))

(declare-const arg2 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1010011101011010 #b101011100)
                arg2
                (fp #b0 #b1111111111111110 #b111111111)))
(assert (fp.leq (fp #b0 #b1111111111111110 #b111111111)
                arg2
                (fp #b0 #b1111111111111111 #b000000000)))

(declare-const arg3 (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b1 #b1001110100101110 #b111011001)
                arg3
                (fp #b0 #b1111111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000)
                arg3
                (fp #b0 #b1111111111111110 #b110010010)))

(declare-const result (_ FloatingPoint 16 10))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 10))
(assert (fp.leq (fp #b0 #b1001010111111111 #b100001000)
                expect
                (fp #b0 #b1111111111111101 #b000000000)))
(assert (fp.leq (fp #b0 #b1111111111111101 #b000000000)
                expect
                (fp #b0 #b1111111111111101 #b111101110)))

(assert (= expect result))

(check-sat)
(exit)
