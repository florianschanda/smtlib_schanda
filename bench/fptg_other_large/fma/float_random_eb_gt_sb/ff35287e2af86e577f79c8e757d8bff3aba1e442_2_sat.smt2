                (fp #b0 #b0000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000 #b010)
                arg2
                (fp #b0 #b0101111011011 #b010)))

(declare-const arg3 (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b0100010010000 #b001)
                arg3
                (fp #b0 #b1000000000011 #b000)))
(assert (fp.leq (fp #b0 #b1000000000011 #b000)
                arg3
                (fp #b0 #b1100011111000 #b110)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1001000101100 #b000)
                expect
                (fp #b0 #b1000000000011 #b001)))
(assert (fp.leq (fp #b0 #b1000000000011 #b001)
                expect
                (fp #b0 #b1001110100011 #b010)))

(assert (= expect result))

(check-sat)
(exit)
