; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -RANDOM_NORMAL_GE_TWO
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 18 2))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b110011001100010001 #b0)
                arg1
                (fp #b1 #b000000000000000000 #b0)))
(assert (fp.leq (fp #b1 #b000000000000000000 #b0)
                arg1
                (fp #b0 #b000101010101111001 #b0)))

(declare-const arg2 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b110011000010010101 #b0)
                arg2
                (fp #b1 #b101111000010100111 #b1)))
(assert (fp.leq (fp #b1 #b101111000010100111 #b1)
                arg2
                (fp #b0 #b110000101110110110 #b0)))

(declare-const arg3 (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b0 #b011001101010000010 #b1)
                arg3
                (fp #b0 #b111111111111111101 #b0)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0)
                arg3
                (fp #b0 #b111111111111111110 #b1)))

(declare-const result (_ FloatingPoint 18 2))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 2))
(assert (fp.leq (fp #b1 #b010110000101100110 #b0)
                expect
                (fp #b0 #b111111111111111101 #b0)))
(assert (fp.leq (fp #b0 #b111111111111111101 #b0)
                expect
                (fp #b0 #b111111111111111111 #b0)))

(assert (= expect result))

(check-sat)
(exit)
