(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -ZERO
; Arg2: -LARGEST_NORMAL
; Arg3: +RANDOM_NORMAL_GE_TWO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 3))
(assert (fp.isNegative arg1))
(assert (fp.leq (fp #b1 #b11001000010 #b00)
                arg1
                (fp #b1 #b00000000000 #b00)))
(assert (fp.leq (fp #b1 #b00000000000 #b00)
                arg1
                (fp #b0 #b11100000110 #b11)))

(declare-const arg2 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b11111111111 #b00)
                arg2
                (fp #b1 #b11111111110 #b11)))
(assert (fp.leq (fp #b1 #b11111111110 #b11)
                arg2
                (fp #b1 #b00011110000 #b10)))

(declare-const arg3 (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10011010000 #b01)
                arg3
                (fp #b0 #b11011100100 #b10)))
(assert (fp.leq (fp #b0 #b11011100100 #b10)
                arg3
                (fp #b0 #b11011101101 #b00)))

(declare-const result (_ FloatingPoint 11 3))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 3))
(assert (fp.leq (fp #b1 #b10101011010 #b10)
                expect
                (fp #b0 #b11011100100 #b10)))
(assert (fp.leq (fp #b0 #b11011100100 #b10)
                expect
                (fp #b0 #b11101001000 #b01)))

(assert (= expect result))

(check-sat)
(exit)
