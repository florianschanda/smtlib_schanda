(declare-const arg3 (_ FloatingPoint 13 4))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b1101001110100 #b111)
                arg3
                (fp #b0 #b0000000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000000 #b000)
                arg3
                (fp #b0 #b1011001111101 #b010)))

(declare-const result (_ FloatingPoint 13 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 13 4))
(assert (fp.leq (fp #b1 #b1110001011000 #b001)
                expect
                (fp #b1 #b0111111111110 #b111)))
(assert (fp.leq (fp #b1 #b0111111111110 #b111)
                expect
                (fp #b1 #b0001000010101 #b100)))

(assert (= expect result))

(check-sat)
(exit)
