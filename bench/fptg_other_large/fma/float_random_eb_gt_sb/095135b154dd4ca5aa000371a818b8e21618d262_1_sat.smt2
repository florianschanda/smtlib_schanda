;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 11 7))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b10011111010 #b011100)
                arg1
                (fp #b0 #b00000000000 #b000000)))
(assert (fp.leq (fp #b0 #b00000000000 #b000000)
                arg1
                (fp #b0 #b01101110110 #b101100)))

(declare-const arg2 (_ FloatingPoint 11 7))
(assert (fp.leq (fp #b1 #b11100101000 #b100010)
                arg2
                (fp #b1 #b10111110101 #b100111)))
(assert (fp.leq (fp #b1 #b10111110101 #b100111)
                arg2
                (fp #b1 #b10110010001 #b110111)))

(declare-const arg3 (_ FloatingPoint 11 7))
(assert (fp.isPositive arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 11 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 11 7))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
