; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +NAN
; Arg3: +RCP_LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 4))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b1011101111101110 #b001)
                arg1
                (fp #b0 #b0000000000000000 #b000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b000)
                arg1
                (fp #b0 #b1000100101011110 #b101)))

(declare-const arg2 (_ FloatingPoint 16 4))
(assert (fp.isNaN arg2))

(declare-const arg3 (_ FloatingPoint 16 4))
(assert (fp.leq (fp #b1 #b0101010100001000 #b101)
                arg3
                (fp #b0 #b0000000000000000 #b010)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b010)
                arg3
                (fp #b0 #b1110110111110010 #b111)))

(declare-const result (_ FloatingPoint 16 4))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 4))
(assert (fp.isNaN expect))

(assert (not (= expect result)))

(check-sat)
(exit)
