(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -LARGEST_NORMAL
; Arg2: +ZERO
; Arg3: +RCP_SMALLEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b1 #b1111111111 #b0000)
                arg1
                (fp #b1 #b1111111110 #b1111)))
(assert (fp.leq (fp #b1 #b1111111110 #b1111)
                arg1
                (fp #b0 #b0110101100 #b0001)))

(declare-const arg2 (_ FloatingPoint 10 5))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b0110000010 #b1000)
                arg2
                (fp #b0 #b0000000000 #b0000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0000)
                arg2
                (fp #b0 #b1111101101 #b1101)))

(declare-const arg3 (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b1100000011 #b0011)
                arg3
                (fp #b0 #b1111111101 #b0000)))
(assert (fp.leq (fp #b0 #b1111111101 #b0000)
                arg3
                (fp #b0 #b1111111110 #b0100)))

(declare-const result (_ FloatingPoint 10 5))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 5))
(assert (fp.leq (fp #b0 #b0011011110 #b0010)
                expect
                (fp #b0 #b1111111101 #b0000)))
(assert (fp.leq (fp #b0 #b1111111101 #b0000)
                expect
                (fp #b0 #b1111111110 #b1010)))

(assert (= expect result))

(check-sat)
(exit)
