; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +RANDOM_NORMAL_GE_TWO
; Arg2: +RCP_LARGEST_NORMAL
; Arg3: +LARGEST_NORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0011000100 #b1111001)
                arg1
                (fp #b0 #b1001111011 #b1010001)))
(assert (fp.leq (fp #b0 #b1001111011 #b1010001)
                arg1
                (fp #b0 #b1111100000 #b0011100)))

(declare-const arg2 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b1 #b1011010011 #b1111101)
                arg2
                (fp #b0 #b0000000000 #b0100000)))
(assert (fp.leq (fp #b0 #b0000000000 #b0100000)
                arg2
                (fp #b0 #b0001010111 #b1110011)))

(declare-const arg3 (_ FloatingPoint 10 8))
(assert (fp.leq (fp #b0 #b0001110001 #b1000100)
                arg3
                (fp #b0 #b1111111110 #b1111111)))
(assert (fp.leq (fp #b0 #b1111111110 #b1111111)
                arg3
                (fp #b0 #b1111111111 #b0000000)))

(declare-const result (_ FloatingPoint 10 8))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 10 8))
(assert (fp.isPositive expect))
(assert (fp.isInfinite expect))

(assert (not (= expect result)))

(check-sat)
(exit)
