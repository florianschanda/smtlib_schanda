                arg2
                (fp #b0 #b111111101 #b000000)))
(assert (fp.leq (fp #b0 #b111111101 #b000000)
                arg2
                (fp #b0 #b111111101 #b110011)))

(declare-const arg3 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b0 #b011001111 #b001010)
                arg3
                (fp #b0 #b100000110 #b000000)))
(assert (fp.leq (fp #b0 #b100000110 #b000000)
                arg3
                (fp #b0 #b111001111 #b111100)))

(declare-const result (_ FloatingPoint 9 7))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101110011 #b011101)
                expect
                (fp #b0 #b100000110 #b000001)))
(assert (fp.leq (fp #b0 #b100000110 #b000001)
                expect
                (fp #b0 #b110011110 #b100010)))

(assert (= expect result))

(check-sat)
(exit)
