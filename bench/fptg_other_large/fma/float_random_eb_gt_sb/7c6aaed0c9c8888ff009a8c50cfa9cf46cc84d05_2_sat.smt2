;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (= rm RTP))

(declare-const arg1 (_ FloatingPoint 9 7))
(assert (fp.leq (fp #b1 #b101100011 #b010010)
                arg1
                (fp #b0 #b000000000 #b010111)))
(assert (fp.leq (fp #b0 #b000000000 #b010111)
                arg1
                (fp #b0 #b001100001 #b000001)))

(declare-const arg2 (_ FloatingPoint 9 7))
