(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -NAN
; Arg2: -RANDOM_SUBNORMAL
; Arg3: +ZERO

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 16 9))
(assert (fp.leq (fp #b1 #b0101110101000011 #b10010110)
                arg2
                (fp #b1 #b0000000000000000 #b01111101)))
(assert (fp.leq (fp #b1 #b0000000000000000 #b01111101)
                arg2
                (fp #b0 #b0111111011111111 #b10100000)))

(declare-const arg3 (_ FloatingPoint 16 9))
(assert (fp.isPositive arg3))
(assert (fp.leq (fp #b1 #b0110010101010101 #b00010001)
                arg3
                (fp #b0 #b0000000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b0000000000000000 #b00000000)
                arg3
                (fp #b0 #b1001110001100100 #b10101000)))

(declare-const result (_ FloatingPoint 16 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
