;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (not (= rm RTN)))

(declare-const arg1 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b101011001101100100 #b10100)
                arg1
                (fp #b1 #b001001101000000010 #b11010)))
(assert (fp.leq (fp #b1 #b001001101000000010 #b11010)
                arg1
                (fp #b0 #b011011010101011000 #b10110)))

(declare-const arg2 (_ FloatingPoint 18 6))
