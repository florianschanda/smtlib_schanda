(declare-const arg3 (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111001011000101010 #b01011)
                arg3
                (fp #b1 #b110001000001111110 #b11000)))
(assert (fp.leq (fp #b1 #b110001000001111110 #b11000)
                arg3
                (fp #b0 #b101110001111011010 #b00101)))

(declare-const result (_ FloatingPoint 18 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 18 6))
(assert (fp.leq (fp #b1 #b111100001100011000 #b01100)
                expect
                (fp #b1 #b110001000001111110 #b11000)))
(assert (fp.leq (fp #b1 #b110001000001111110 #b11000)
                expect
                (fp #b0 #b110100111011010111 #b01101)))

(assert (= expect result))

(check-sat)
(exit)
