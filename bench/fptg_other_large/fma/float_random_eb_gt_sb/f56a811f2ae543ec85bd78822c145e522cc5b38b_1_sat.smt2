(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 16 14))
(assert (fp.leq (fp #b1 #b1011111001110100 #b1011001110100)
                arg1
                (fp #b1 #b1011101101111001 #b1000011110110)))
