                arg2
                (fp #b0 #b1000000000001101 #b0000000000000)))
(assert (fp.leq (fp #b0 #b1000000000001101 #b0000000000000)
                arg2
                (fp #b0 #b1111110100101000 #b1101001011111)))

(declare-const arg3 (_ FloatingPoint 16 14))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 16 14))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 16 14))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
