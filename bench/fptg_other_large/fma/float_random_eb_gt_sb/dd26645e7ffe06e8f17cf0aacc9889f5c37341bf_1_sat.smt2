(set-info :smt-lib-version 2.6)
(set-logic QF_FP)
(set-info :source |Generated by FPTG and PyMPF|)
(set-info :license |https://www.gnu.org/licenses/gpl-3.0.html|)
(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: -INT_BOUNDARY
; Arg2: +RANDOM_NORMAL_GE_TWO
; Arg3: -REFERENCE

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)
(assert (or (= rm RTP) (= rm RTZ)))

(declare-const arg1 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b10010000100010 #b1001000100)
                arg1
                (fp #b1 #b10000000001010 #b0000000000)))
(assert (fp.leq (fp #b1 #b10000000001010 #b0000000000)
                arg1
                (fp #b0 #b11101111111001 #b0000000110)))

(declare-const arg2 (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11010001110101 #b0001001010)
                arg2
                (fp #b0 #b11010010001011 #b1101101010)))
(assert (fp.leq (fp #b0 #b11010010001011 #b1101101010)
                arg2
                (fp #b0 #b11100000100001 #b0000001000)))

(declare-const arg3 (_ FloatingPoint 14 11))
(assert (= arg3 (fp.neg arg2)))

(declare-const result (_ FloatingPoint 14 11))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 11))
(assert (fp.leq (fp #b1 #b11111110001010 #b1010110100)
                expect
                (fp #b1 #b11010010010110 #b1101101010)))
(assert (fp.leq (fp #b1 #b11010010010110 #b1101101010)
                expect
                (fp #b1 #b00101101000011 #b0011010010)))

(assert (= expect result))

(check-sat)
(exit)
