; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: -RCP_LARGEST_NORMAL
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 12 6))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b000000110011 #b01110)
                arg2
                (fp #b1 #b000000000000 #b01000)))
(assert (fp.leq (fp #b1 #b000000000000 #b01000)
                arg2
                (fp #b0 #b101100010101 #b01010)))

(declare-const arg3 (_ FloatingPoint 12 6))
(assert (fp.leq (fp #b1 #b100110000011 #b00110)
                arg3
                (fp #b0 #b000000000000 #b10111)))
(assert (fp.leq (fp #b0 #b000000000000 #b10111)
                arg3
                (fp #b0 #b100101111110 #b01011)))

(declare-const result (_ FloatingPoint 12 6))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 12 6))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
