(set-info :category "random")
(set-info :status sat)

; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +NAN
; Arg2: +ZERO
; Arg3: +RANDOM_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 14 9))
(assert (fp.isNaN arg1))

(declare-const arg2 (_ FloatingPoint 14 9))
(assert (fp.isPositive arg2))
(assert (fp.leq (fp #b1 #b00011010011111 #b10000100)
                arg2
                (fp #b0 #b00000000000000 #b00000000)))
(assert (fp.leq (fp #b0 #b00000000000000 #b00000000)
                arg2
                (fp #b0 #b01101000111111 #b11101011)))

(declare-const arg3 (_ FloatingPoint 14 9))
(assert (fp.leq (fp #b1 #b10100010101101 #b00101001)
                arg3
                (fp #b0 #b00000000000000 #b01110011)))
(assert (fp.leq (fp #b0 #b00000000000000 #b01110011)
                arg3
                (fp #b0 #b01000010101010 #b10100101)))

(declare-const result (_ FloatingPoint 14 9))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 14 9))
(assert (fp.isNaN expect))

(assert (= expect result))

(check-sat)
(exit)
