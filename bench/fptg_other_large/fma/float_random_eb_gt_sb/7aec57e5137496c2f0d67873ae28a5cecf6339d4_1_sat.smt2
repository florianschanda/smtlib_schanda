; Format: FLOAT_RANDOM_EB_GT_SB
; Arg1: +ZERO
; Arg2: +RANDOM_SUBNORMAL
; Arg3: -RCP_SMALLEST_SUBNORMAL

; Redundancy: False
; Validation for: FMA
;   * PYMPF: FULL
;   * NATIVE_SSE: NONE
;   * NATIVE_X87: NONE
;   * MPFR: PARTIAL
;   * SOFTFLOAT: NONE

(declare-const rm RoundingMode)

(declare-const arg1 (_ FloatingPoint 17 12))
(assert (fp.isPositive arg1))
(assert (fp.leq (fp #b1 #b01011101101010110 #b10101111100)
                arg1
                (fp #b0 #b00000000000000000 #b00000000000)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b00000000000)
                arg1
                (fp #b0 #b00110100100010101 #b00100001100)))

(declare-const arg2 (_ FloatingPoint 17 12))
(assert (fp.leq (fp #b1 #b11001110001010101 #b01000000011)
                arg2
                (fp #b0 #b00000000000000000 #b10100101001)))
(assert (fp.leq (fp #b0 #b00000000000000000 #b10100101001)
                arg2
                (fp #b0 #b01111100110001001 #b00111110001)))

(declare-const arg3 (_ FloatingPoint 17 12))
(assert (fp.isNegative arg3))
(assert (fp.isInfinite arg3))

(declare-const result (_ FloatingPoint 17 12))
(assert (= result (fp.fma rm arg1 arg2 arg3)))

(declare-const expect (_ FloatingPoint 17 12))
(assert (fp.isNegative expect))
(assert (fp.isInfinite expect))

(assert (= expect result))

(check-sat)
(exit)
